+// Lets the app follow glides: their start, every applied frame and the end.
+struct SmoothWheelHooks {
+	Fn<void(not_null<QWidget*>)> started;
+	Fn<void(not_null<QWidget*>)> frame;
+	Fn<void(not_null<QWidget*>)> finished;
+};
+void SetSmoothWheelHooks(SmoothWheelHooks hooks);
+
 // Eases mouse wheel notches like the profile does, touchpads stay as is.
 class SmoothWheel final {
 public:
 	SmoothWheel();
+	~SmoothWheel();
+
