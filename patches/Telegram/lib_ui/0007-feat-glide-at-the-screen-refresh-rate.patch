+void SmoothWheel::step() {
 	if (const auto before = _current(); before != _lastApplied) {
 		follow(before - _lastApplied);
 	}
+	const auto elapsed = std::chrono::duration<float64, std::milli>(
+		std::chrono::steady_clock::now() - _started);
 	const auto progress = std::clamp(
-		(now - _started) / float64(kStepTime),
+		elapsed.count() / float64(kStepTime.count()),
 		0.,
 		1.);
 	const auto value = anim::interpolate(
@@ -100,6 +146,9 @@ void SmoothWheel::step(crl::time now) {
 	const auto max = _max();
 	const auto clamped = std::clamp(value, 0, max);
 	_apply(clamped);
+	if (_widget && Hooks.frame) {
+		Hooks.frame(_widget);
+	}
 	const auto actual = _current();
 	if (actual != clamped) {
 		follow(actual - clamped);
