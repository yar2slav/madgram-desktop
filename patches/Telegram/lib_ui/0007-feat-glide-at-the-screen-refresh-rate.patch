 #include <QtGui/QWheelEvent>
+#include <QtWidgets/QWidget>
 
 namespace Ui {
 namespace {
 
-constexpr auto kStepTime = crl::time(260);
+constexpr auto kStepTime = std::chrono::milliseconds(260);
 constexpr auto kNotch = 120;
 
 bool Enabled = false;
+SmoothWheelHooks Hooks;
 
 } // namespace
 
@@ -28,12 +32,50 @@ bool SmoothWheelScroll() {
 	return Enabled;
 }
 
+void SetSmoothWheelHooks(SmoothWheelHooks hooks) {
+	Hooks = std::move(hooks);
+}
+
 SmoothWheel::SmoothWheel() {
-	_animation.init([=](crl::time now) {
-		step(now);
+	_animation.init([=] {
+		step();
 	});
 }
 
+SmoothWheel::~SmoothWheel() {
+	// The owner is being destroyed, so no hook is called with it.
+	if (base::take(_gliding)) {
+		Animations::Manager::ClearHighRate(&_animation);
+	}
+}
+
+void SmoothWheel::setWidget(not_null<QWidget*> widget) {
+	_widget = widget;
+}
+
+void SmoothWheel::setGliding(bool gliding) {
+	if (_gliding == gliding) {
+		return;
+	}
+	_gliding = gliding;
+	if (gliding) {
+		const auto screen = _widget
+			? _widget->screen()
+			: QGuiApplication::primaryScreen();
+		Animations::Manager::SetHighRate(
+			&_animation,
+			screen ? screen->refreshRate() : 0.);
+		if (_widget && Hooks.started) {
+			Hooks.started(_widget);
+		}
+	} else {
+		Animations::Manager::ClearHighRate(&_animation);
+		if (_widget && Hooks.finished) {
+			Hooks.finished(_widget);
+		}
+	}
+}
+
 bool SmoothWheel::handle(
 		not_null<QWheelEvent*> e,
 		int pixels,
@@ -65,10 +107,11 @@ bool SmoothWheel::handle(
 	const auto base = animating ? _target : from;
 	_target = std::clamp(base + pixels, 0, _max());
 	_from = from;
-	_started = crl::now();
+	_started = std::chrono::steady_clock::now();
 	_lastApplied = from;
 	if (!animating) {
 		_animation.start();
+		setGliding(true);
 	}
 	return true;
 }
@@ -76,6 +119,7 @@ bool SmoothWheel::handle(
 void SmoothWheel::stop() {
 	_animation.stop();
 	_lastApplied = -1;
+	setGliding(false);
 }
 
