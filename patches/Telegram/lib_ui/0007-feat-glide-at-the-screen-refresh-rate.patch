diff --git a/ui/effects/animations.cpp b/ui/effects/animations.cpp
index bb268d6a0ff6ab3c2109c852603315854aba3b8d..b60b959ef868dac9023a7bfbf5d4bb2d383cfd98 100644
--- a/ui/effects/animations.cpp
+++ b/ui/effects/animations.cpp
@@ -18,6 +18,9 @@
 #include <range/v3/algorithm/remove_if.hpp>
 #include <range/v3/algorithm/remove.hpp>
 #include <range/v3/algorithm/find.hpp>
+#include <range/v3/algorithm/any_of.hpp>
+
+#include <cmath>
 
 namespace Ui {
 namespace Animations {
@@ -28,6 +31,29 @@ constexpr auto kIgnoreUpdatesTimeout = crl::time(4);
 
 Manager *ManagerInstance = nullptr;
 bool ScheduleWithInvokeQueued = false;
+struct HighRate {
+	const Basic *animation = nullptr;
+	float64 tick = 0.;
+};
+std::vector<HighRate> HighRates;
+float64 HighRateNext = 0.;
+crl::time NormalLast = 0;
+
+[[nodiscard]] float64 HighRateTick() {
+	auto result = 0.;
+	for (const auto &entry : HighRates) {
+		if (result == 0. || entry.tick < result) {
+			result = entry.tick;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool IsHighRate(const Basic *animation) {
+	return ranges::any_of(HighRates, [&](const HighRate &entry) {
+		return (entry.animation == animation);
+	});
+}
 
 } // namespace
 
@@ -130,6 +156,25 @@ void Manager::update() {
 	if (_forceImmediateUpdate) {
 		_forceImmediateUpdate = false;
 	}
+	const auto high = HighRateTick();
+	// Others step on the high tick nearest to their usual one.
+	const auto all = (high == 0.)
+		|| (now - NormalLast >= float64(kAnimationTick) - high / 2.);
+	if (all) {
+		NormalLast = now;
+	}
+	// High rate animations step only on their own ticks, so updates
+	// requested by repaints don't make their frames uneven.
+	const auto highDue = (high > 0.)
+		&& (float64(now) + 0.5 >= HighRateNext);
+	if (highDue) {
+		// The next tick keeps the phase: after a late tick it comes at the
+		// first boundary after now, not a whole tick after the late one.
+		const auto behind = float64(now) - HighRateNext;
+		HighRateNext += (behind >= 0.)
+			? ((std::floor(behind / high) + 1.) * high)
+			: high;
+	}
 	schedule();
 
 	_updating = true;
@@ -137,6 +182,10 @@ void Manager::update() {
 
 	_lastUpdateTime = now;
 	const auto isFinished = [&](const ActiveBasicPointer &element) {
+		if (high > 0.
+			&& !(IsHighRate(element.get()) ? highDue : all)) {
+			return false;
+		}
 		return !element.call(now);
 	};
 	_active.erase(ranges::remove_if(_active, isFinished), end(_active));
@@ -183,6 +232,15 @@ void Manager::schedule() {
 		if (_forceImmediateUpdate) {
 			_forceImmediateUpdate = false;
 			updateQueued();
+		} else if (HighRateTick() > 0.) {
+			const auto wait = HighRateNext - float64(crl::now());
+			if (wait >= 0.5) {
+				_timerId = startTimer(
+					crl::time(wait + 0.5),
+					Qt::PreciseTimer);
+			} else {
+				updateQueued();
+			}
 		} else {
 			const auto next = _lastUpdateTime + kAnimationTick;
 			const auto now = crl::now();
@@ -218,5 +276,23 @@ void Manager::SetScheduleWithInvokeQueued(bool value) {
 	ScheduleWithInvokeQueued = value;
 }
 
+void Manager::SetHighRate(not_null<const Basic*> animation, float64 rate) {
+	ClearHighRate(animation);
+	if (rate <= 0.) {
+		return;
+	}
+	const auto tick = 1000. / rate;
+	if (tick < float64(kAnimationTick)) {
+		HighRates.push_back({ .animation = animation.get(), .tick = tick });
+	}
+}
+
+void Manager::ClearHighRate(not_null<const Basic*> animation) {
+	HighRates.erase(ranges::remove(
+		HighRates,
+		animation.get(),
+		&HighRate::animation), end(HighRates));
+}
+
 } // namespace Animations
 } // namespace Ui
