index 0000000000000000000000000000000000000000..75d73fd7932cc09bc0bec3e08f08d78b79ed26a6
--- /dev/null
+++ b/ui/widgets/smooth_wheel.cpp
@@ -0,0 +1,113 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+#include "ui/widgets/smooth_wheel.h"
+
+#include "ui/effects/animation_value.h"
+
+#include <QtGui/QWheelEvent>
+
+namespace Ui {
+namespace {
+
+constexpr auto kStepTime = crl::time(260);
+constexpr auto kNotch = 120;
+
+bool Enabled = false;
+
+} // namespace
+
+void SetSmoothWheelScroll(bool enabled) {
+	Enabled = enabled;
+}
+
+bool SmoothWheelScroll() {
+	return Enabled;
+}
+
+SmoothWheel::SmoothWheel() {
+	_animation.init([=](crl::time now) {
+		step(now);
+	});
+}
+
+bool SmoothWheel::handle(
+		not_null<QWheelEvent*> e,
+		int pixels,
+		Fn<int()> current,
+		Fn<int()> max,
+		Fn<void(int)> apply) {
+	const auto delta = e->angleDelta();
+	const auto notch = Enabled
+		&& !anim::Disabled()
+		&& (e->phase() == Qt::NoScrollPhase)
+		&& e->pixelDelta().isNull()
+		&& !delta.x()
+		&& delta.y()
+		&& !(delta.y() % kNotch)
+		&& !(e->modifiers() & (Qt::ControlModifier | Qt::ShiftModifier))
+		&& (max() > 0);
+	if (!notch) {
+		stop();
+		return false;
+	}
+	_current = std::move(current);
+	_max = std::move(max);
+	_apply = std::move(apply);
+	const auto animating = _animation.animating();
+	const auto from = _current();
+	if (animating && from != _lastApplied) {
+		follow(from - _lastApplied);
+	}
+	const auto base = animating ? _target : from;
+	_target = std::clamp(base + pixels, 0, _max());
+	_from = from;
+	_started = crl::now();
+	_lastApplied = from;
+	if (!animating) {
+		_animation.start();
+	}
+	return true;
+}
+
+void SmoothWheel::stop() {
+	_animation.stop();
+	_lastApplied = -1;
+}
+
+void SmoothWheel::follow(int shift) {
+	// The content moved under the glide, like older messages loaded above
+	// with the list keeping its place, so keep gliding over the same content.
+	_from += shift;
+	_target += shift;
+}
+
+void SmoothWheel::step(crl::time now) {
+	if (const auto before = _current(); before != _lastApplied) {
+		follow(before - _lastApplied);
+	}
+	const auto progress = std::clamp(
+		(now - _started) / float64(kStepTime),
+		0.,
+		1.);
+	const auto value = anim::interpolate(
+		_from,
+		_target,
+		anim::easeOutQuint(1., progress));
+	const auto max = _max();
+	const auto clamped = std::clamp(value, 0, max);
+	_apply(clamped);
+	const auto actual = _current();
+	if (actual != clamped) {
+		follow(actual - clamped);
+	}
+	_lastApplied = actual;
+	if (progress >= 1. || clamped != value) {
+		stop();
+	}
+}
+
+} // namespace Ui
