diff --git a/Telegram/SourceFiles/tele/tele_translate_out.cpp b/Telegram/SourceFiles/tele/tele_translate_out.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..371c09fad85e4be9309c572bd68bb1357b3768f8
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_translate_out.cpp
@@ -0,0 +1,194 @@
+#include "tele/tele_translate_out.h"
+
+#include "api/api_text_entities.h"
+#include "chat_helpers/compose/compose_show.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "menu/menu_send_details.h"
+#include "mtproto/mtproto_response.h"
+#include "mtproto/sender.h"
+#include "spellcheck/spellcheck_types.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/choose_language_box.h"
+#include "ui/layers/generic_box.h"
+#include "ui/text/text_entity.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtWidgets/QMenu>
+
+namespace Tele {
+namespace {
+
+class Translator final : public QObject {
+public:
+	Translator(
+		not_null<Ui::InputField*> field,
+		std::shared_ptr<ChatHelpers::Show> show);
+
+	[[nodiscard]] bool available() const;
+	void choose();
+
+private:
+	void translate(LanguageId to);
+	void apply(const QString &original, TextWithEntities result);
+	void fail(const QString &original);
+
+	const not_null<Ui::InputField*> _field;
+	const std::shared_ptr<ChatHelpers::Show> _show;
+	MTP::Sender _api;
+	mtpRequestId _requestId = 0;
+
+};
+
+Translator::Translator(
+	not_null<Ui::InputField*> field,
+	std::shared_ptr<ChatHelpers::Show> show)
+: QObject(field)
+, _field(field)
+, _show(std::move(show))
+, _api(&_show->session().mtp()) {
+}
+
+bool Translator::available() const {
+	return !_field->getLastText().trimmed().isEmpty();
+}
+
+void Translator::choose() {
+	const auto saved = LanguageId::FromName(TranslateOutTo());
+	auto selected = std::vector<LanguageId>();
+	if (saved) {
+		selected.push_back(saved);
+	}
+	const auto weak = QPointer<Translator>(this);
+	_show->showBox(Box(
+		Ui::ChooseLanguageBox,
+		tr::lng_translate_menu_to() | rpl::map(Lower),
+		[=](std::vector<LanguageId> ids) {
+			if (ids.empty()) {
+				return;
+			}
+			SetTranslateOutTo(ids.front().name());
+			if (weak) {
+				weak->translate(ids.front());
+			}
+		},
+		std::move(selected),
+		false,
+		nullptr));
+}
+
+void Translator::translate(LanguageId to) {
+	using Flag = MTPmessages_TranslateText::Flag;
+	if (!available()) {
+		return;
+	}
+	const auto original = _field->getLastText();
+	const auto text = _field->getTextWithAppliedMarkdown();
+	const auto session = &_show->session();
+	_api.request(base::take(_requestId)).cancel();
+	_requestId = _api.request(MTPmessages_TranslateText(
+		MTP_flags(Flag::f_text),
+		MTP_inputPeerEmpty(),
+		MTPVector<MTPint>(),
+		MTP_vector<MTPTextWithEntities>(1, MTP_textWithEntities(
+			MTP_string(text.text),
+			Api::EntitiesToMTP(
+				session,
+				TextUtilities::ConvertTextTagsToEntities(text.tags),
+				Api::ConvertOption::SkipLocal))),
+		MTP_string(to.twoLetterCode()),
+		MTPstring()
+	)).done([=](const MTPmessages_TranslatedText &result) {
+		_requestId = 0;
+		const auto &list = result.data().vresult().v;
+		if (list.isEmpty()) {
+			fail(original);
+			return;
+		}
+		apply(original, Api::ParseTextWithEntities(session, list.front()));
+	}).fail([=](const MTP::Error &error) {
+		_requestId = 0;
+		if (!MTP::IgnoreError(error)) {
+			fail(original);
+		}
+	}).send();
+}
+
+void Translator::apply(const QString &original, TextWithEntities result) {
+	if (_field->getLastText() != original) {
+		return;
+	} else if (result.text.trimmed().isEmpty()) {
+		fail(original);
+		return;
+	}
+	_field->setTextWithTags({
+		result.text,
+		TextUtilities::ConvertEntitiesToTextTags(result.entities),
+	}, Ui::InputField::HistoryAction::NewEntry);
+	_field->setCursorPosition(_field->getLastText().size());
+	_field->setFocus();
+}
+
+void Translator::fail(const QString &original) {
+	if (_field->getLastText() == original) {
+		_show->showToast(Lower(tr::lng_translate_box_error(tr::now)));
+	}
+}
+
+[[nodiscard]] Translator *FindTranslator(not_null<Ui::InputField*> field) {
+	for (const auto child : field->children()) {
+		if (const auto translator = dynamic_cast<Translator*>(child)) {
+			return translator;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] QString MenuText() {
+	return Lower(u"Translate\u2026"_q);
+}
+
+} // namespace
+
+void SetupTranslateOut(
+		not_null<Ui::InputField*> field,
+		std::shared_ptr<ChatHelpers::Show> show) {
+	const auto translator = new Translator(field, std::move(show));
+	field->addContextMenuHook([=](Ui::InputField::ContextMenuRequest request) {
+		if (!translator->available()) {
+			return;
+		}
+		request.menu->addSeparator();
+		const auto action = request.menu->addAction(MenuText());
+		QObject::connect(action, &QAction::triggered, translator, [=] {
+			translator->choose();
+		});
+	});
+}
+
+void TranslateOutMenu(
+		not_null<Ui::InputField*> field,
+		SendMenu::Details &details) {
+	const auto translator = FindTranslator(field);
+	if (!translator || !translator->available()) {
+		return;
+	}
+	const auto weak = QPointer<Translator>(translator);
+	const auto previous = details.teleMenu;
+	details.teleMenu = [=](not_null<Ui::PopupMenu*> menu) {
+		if (previous) {
+			previous(menu);
+		}
+		if (weak) {
+			menu->addAction(
+				MenuText(),
+				crl::guard(weak.data(), [=] { weak->choose(); }),
+				&st::menuIconTranslate);
+		}
+	};
+}
+
+} // namespace Tele
