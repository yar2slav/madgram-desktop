new file mode 100644
index 0000000000000000000000000000000000000000..2168260a7e7ccb61a7e70c238d4607810bffb626
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_collectible_price.cpp
@@ -0,0 +1,201 @@
+#include "tele/tele_collectible_price.h"
+
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/collectible_info_box.h"
+#include "ui/text/format_values.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QDateTime>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QRegularExpression>
+#include <QtCore/QTimer>
+#include <QtCore/QUrlQuery>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele {
+namespace {
+
+constexpr auto kTimeout = 5 * 1000;
+constexpr auto kMaxSize = qint64(64 * 1024);
+constexpr auto kNanoDigits = 9;
+constexpr auto kCentsDigits = 2;
+constexpr auto kMaxCentsDigits = 18;
+constexpr auto kUrl = "https://gram.rin.ms/v1/ton/price";
+constexpr auto kMaxAge = "86400";
+constexpr auto kUserAgent = "GramPricesClient/1.0";
+
+[[nodiscard]] QNetworkAccessManager *Manager() {
+	static const auto result = new QNetworkAccessManager(
+		QCoreApplication::instance());
+	return result;
+}
+
+[[nodiscard]] base::flat_map<TimeId, QString> &Cache() {
+	static auto result = base::flat_map<TimeId, QString>();
+	return result;
+}
+
+[[nodiscard]] QString Moment(TimeId date) {
+	return QDateTime::fromSecsSinceEpoch(date, Qt::UTC).toString(
+		u"yyyy-MM-dd'T'HH:mm:ss'Z'"_q);
+}
+
+[[nodiscard]] QUrl PriceUrl(TimeId date) {
+	auto query = QUrlQuery();
+	query.addQueryItem(u"at"_q, Moment(date));
+	query.addQueryItem(u"max_age_seconds"_q, QString::fromLatin1(kMaxAge));
+	auto result = QUrl(QString::fromLatin1(kUrl));
+	result.setQuery(query);
+	return result;
+}
+
+[[nodiscard]] std::vector<int> Digits(const QString &text) {
+	auto result = std::vector<int>();
+	result.reserve(text.size());
+	for (auto i = text.size(); i != 0;) {
+		result.push_back(text[--i].unicode() - '0');
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<int64> Cents(
+		uint64 nano,
+		const QString &price) {
+	static const auto kPrice = QRegularExpression(
+		u"^(\\d{1,12})(?:\\.(\\d{1,18}))?$"_q);
+	const auto match = kPrice.match(price);
+	if (!match.hasMatch()) {
+		return std::nullopt;
+	}
+	const auto fraction = match.captured(2);
+	const auto left = Digits(QString::number(nano));
+	const auto right = Digits(match.captured(1) + fraction);
+	auto product = std::vector<int>(left.size() + right.size(), 0);
+	for (auto i = 0; i != int(left.size()); ++i) {
+		auto carry = 0;
+		for (auto j = 0; j != int(right.size()); ++j) {
+			const auto value = product[i + j] + left[i] * right[j] + carry;
+			product[i + j] = value % 10;
+			carry = value / 10;
+		}
+		for (auto k = i + int(right.size()); carry; ++k) {
+			const auto value = product[k] + carry;
+			product[k] = value % 10;
+			carry = value / 10;
+		}
+	}
+	const auto shift = kNanoDigits - kCentsDigits + int(fraction.size());
+	if (int(product.size()) <= shift) {
+		product.resize(shift + 1, 0);
+	}
+	while (int(product.size()) > shift + 1 && !product.back()) {
+		product.pop_back();
+	}
+	if (int(product.size()) - shift > kMaxCentsDigits) {
+		return std::nullopt;
+	}
+	auto result = int64(0);
+	for (auto i = int(product.size()); i > shift;) {
+		result = result * 10 + product[--i];
+	}
+	if (product[shift - 1] >= 5) {
+		++result;
+	}
+	return result;
+}
+
+[[nodiscard]] QString Parse(const QByteArray &data) {
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(data, &error);
+	if (error.error != QJsonParseError::NoError || !document.isObject()) {
+		return QString();
+	}
+	const auto object = document.object().value(u"data"_q).toObject();
+	const auto currency = object.value(u"quote_currency"_q).toString();
+	if (currency != u"USD"_q && currency != u"USDT"_q) {
+		return QString();
+	}
+	return object.value(u"price"_q).toString();
+}
+
+[[nodiscard]] QString Problem(const QByteArray &data) {
+	const auto object = QJsonDocument::fromJson(data).object();
+	const auto code = object.value(u"code"_q).toString();
+	return code.isEmpty() ? u"malformed response"_q : code;
+}
+
+void Request(TimeId date, Fn<void(QString)> done) {
+	auto request = QNetworkRequest(PriceUrl(date));
+	request.setRawHeader("Accept", "application/json");
+	request.setRawHeader("User-Agent", kUserAgent);
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTimeout));
+	const auto reply = Manager()->get(request);
+	QTimer::singleShot(kTimeout, reply, [=] {
+		reply->abort();
+	});
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 ready,
+			qint64 total) {
+		if (ready > kMaxSize || total > kMaxSize) {
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		const auto data = reply->readAll();
+		const auto price = (status == 200) ? Parse(data) : QString();
+		if (price.isEmpty()) {
+			LOG(("Tele Collectible Price Error: %1").arg(status
+				? (QString::number(status) + ' ' + Problem(data))
+				: reply->errorString()));
+			return;
+		}
+		Cache().emplace(date, price);
+		done(price);
+	});
+}
+
+} // namespace
+
+rpl::producer<QString> CollectibleFiatValue(
+		const Ui::CollectibleInfo &info) {
+	const auto fallback = Ui::FillAmountAndCurrency(
+		info.amount,
+		info.currency);
+	if (!NftPurchasePrice()
+		|| info.cryptoCurrency != u"TON"_q
+		|| info.date <= 0
+		|| OfflineForLaunch()) {
+		return rpl::single(fallback);
+	}
+	const auto nano = info.cryptoAmount;
+	const auto format = [=](const QString &price) {
+		const auto cents = Cents(nano, price);
+		return cents
+			? Ui::FillAmountAndCurrency(*cents, u"USD"_q)
+			: fallback;
+	};
+	const auto date = info.date;
+	const auto i = Cache().find(date);
+	if (i != end(Cache())) {
+		return rpl::single(format(i->second));
+	}
+	return rpl::single(fallback) | rpl::then(
+		rpl::make_producer<QString>([=](const auto &consumer) {
+			Request(date, [=](QString price) {
+				consumer.put_next(format(price));
+			});
+			return rpl::lifetime();
+		}));
+}
+
+} // namespace Tele
