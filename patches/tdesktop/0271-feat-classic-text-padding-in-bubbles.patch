diff --git a/Telegram/SourceFiles/tele/tele_bubble_padding.cpp b/Telegram/SourceFiles/tele/tele_bubble_padding.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..749bcd76b0734e6a4efc0f5ff947f289dee1f5b5
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_bubble_padding.cpp
@@ -0,0 +1,21 @@
+#include "tele/tele_bubble_padding.h"
+
+#include "tele/tele_options.h"
+#include "ui/style/style_core_scale.h"
+#include "styles/style_chat.h"
+
+namespace Tele {
+
+void ApplyBubblePadding() {
+	if (!BubblePadding()) {
+		return;
+	}
+	// the style object behind st::msgPadding is mutable, only the reference is const
+	const_cast<style::margins&>(st::msgPadding) = style::margins(
+		style::ConvertScale(13),
+		style::ConvertScale(7),
+		style::ConvertScale(13),
+		style::ConvertScale(8));
+}
+
+} // namespace Tele
