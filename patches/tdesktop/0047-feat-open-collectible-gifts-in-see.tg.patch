diff --git a/Telegram/SourceFiles/tele/tele_gifts.cpp b/Telegram/SourceFiles/tele/tele_gifts.cpp
index a50ec73cbc1059b1eb9d91b22f4c112bf6685de9..a7879ec3e8c3b6a8bb39ab82c9d00cda551b09a3 100644
--- a/Telegram/SourceFiles/tele/tele_gifts.cpp
+++ b/Telegram/SourceFiles/tele/tele_gifts.cpp
@@ -1,15 +1,24 @@
 #include "tele/tele_gifts.h"
 
+#include "base/qthelp_url.h"
 #include "chat_helpers/compose/compose_show.h"
+#include "core/click_handler_types.h"
 #include "data/data_star_gift.h"
+#include "lang/lang_text_entity.h"
 #include "tele/tele_lowercase.h"
 #include "tele/tele_options.h"
+#include "ui/basic_click_handlers.h"
 #include "ui/controls/table_rows.h"
+#include "ui/layers/generic_box.h"
 #include "ui/text/text_utilities.h"
 #include "ui/toast/toast.h"
+#include "ui/vertical_list.h"
 #include "ui/widgets/labels.h"
 #include "ui/wrap/table_layout.h"
+#include "window/window_session_controller.h"
+#include "styles/style_chat.h"
 #include "styles/style_chat_helpers.h"
+#include "styles/style_credits.h"
 #include "styles/style_widgets.h"
 
 namespace Tele {
@@ -38,4 +47,31 @@ void AddGiftIdRow(
 	Ui::AddTableRow(table, rpl::single(Lower(u"Gift ID"_q)), std::move(label));
 }
 
+void AddSeeTgButton(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<Ui::GenericBox*> box,
+		const Data::UniqueGift *gift) {
+	if (!gift || gift->slug.isEmpty() || !SeeTgButton()) {
+		return;
+	}
+	const auto url = u"https://t.me/seetgbot/nft?startapp="_q
+		+ qthelp::url_encode(gift->slug);
+	Ui::AddSkip(box->verticalLayout());
+	const auto label = box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(tr::link(TextWithEntities{
+				Lower(u"Open in see.tg "_q),
+			}.append(Ui::Text::IconEmoji(&st::textMoreIconEmoji)))),
+			st::creditsBoxAboutDivider),
+		style::al_top);
+	label->setClickHandlerFilter([=](const auto &...) {
+		UrlClickHandler::Open(url, QVariant::fromValue(ClickHandlerContext{
+			.sessionWindow = base::make_weak(show->resolveWindow()),
+			.show = show,
+		}));
+		return false;
+	});
+}
+
 } // namespace Tele
