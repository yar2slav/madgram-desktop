From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 03:11:13 +0300
Subject: [PATCH] feat: move chats instantly in the chat list

---
 .../SourceFiles/dialogs/dialogs_inner_widget.cpp     |  3 ++-
 Telegram/SourceFiles/settings/settings_tele.cpp      |  1 +
 Telegram/SourceFiles/tele/tele_options.cpp           | 12 ++++++++++++
 Telegram/SourceFiles/tele/tele_options.h             |  2 ++
 4 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/dialogs/dialogs_inner_widget.cpp b/Telegram/SourceFiles/dialogs/dialogs_inner_widget.cpp
index bd9b2431c6c26c88a39a922372106168cb8142ec..df87b79341c643d1758355bc22f586ae3ceab451 100644
--- a/Telegram/SourceFiles/dialogs/dialogs_inner_widget.cpp
+++ b/Telegram/SourceFiles/dialogs/dialogs_inner_widget.cpp
@@ -2124,7 +2124,8 @@ void InnerWidget::mouseMoveEvent(QMouseEvent *e) {
 }
 
 bool InnerWidget::skipChatsListFreeze() const {
-	return _dragging != nullptr;
+	return (_dragging != nullptr)
+		|| (!_pressed && ::Tele::ChatListNoReorderAnimation());
 }
 
 void InnerWidget::unfreezeShownList(bool updateIfWasFrozen) {
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 6084d6709179fd96df5ca2a0ec4b662744897574..024a39523d1841cc4e74489f2ba7b3bc59a930da 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1456,6 +1456,7 @@ void FillInterface(SectionBuilder &builder) {
 	AddGroupTitle(builder, u"Chat list"_q);
 	AddOptionToggle(builder, ::Tele::kOptionHideAllChats);
 	AddOptionToggle(builder, ::Tele::kOptionStaticUserpicsList);
+	AddOptionToggle(builder, ::Tele::kOptionChatListNoReorderAnimation);
 	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Chats and profiles"_q);
 	AddOptionToggle(builder, ::Tele::kOptionBubbleBadges);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 8e40a2637f0d1cedf5b6bda6de458f2061430f90..929b396734f0034ec3a092bc6b018664efa25680 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -35,6 +35,7 @@ const char kOptionCleanSentLinks[] = "tele-clean-sent-links";
 const char kOptionHideAllChats[] = "tele-hide-all-chats";
 const char kOptionJumpToFirst[] = "tele-jump-to-first";
 const char kOptionStaticUserpicsList[] = "tele-static-userpics-list";
+const char kOptionChatListNoReorderAnimation[] = "tele-chat-list-no-reorder-animation";
 const char kOptionStaticUserpicsChats[] = "tele-static-userpics-chats";
 const char kOptionHideMentionsButton[] = "tele-hide-mentions-button";
 const char kOptionHideReactionsButton[] = "tele-hide-reactions-button";
@@ -279,6 +280,13 @@ base::options::toggle StaticUserpicsListOption({
 	.description = "Also in folders and search results.",
 });
 
+base::options::toggle ChatListNoReorderAnimationOption({
+	.id = kOptionChatListNoReorderAnimation,
+	.name = "Move chats instantly in the list",
+	.description = "No two-second pause in reordering while the mouse moves "
+		"over the list. Still held while a chat is pressed.",
+});
+
 base::options::toggle StaticUserpicsChatsOption({
 	.id = kOptionStaticUserpicsChats,
 	.name = "Static userpics in chats and profiles",
@@ -759,6 +767,10 @@ rpl::producer<> StaticUserpicsListChanges() {
 	return StaticUserpicsListOption.changes();
 }
 
+bool ChatListNoReorderAnimation() {
+	return ChatListNoReorderAnimationOption.value();
+}
+
 bool StaticUserpicsChats() {
 	return StaticUserpicsChatsOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 9cc22d713288257d41beb39d3ac49371f43ca8d8..a51752df3dc7844b9b909ced14a03a8fe95030f8 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -31,6 +31,7 @@ extern const char kOptionCleanSentLinks[];
 extern const char kOptionHideAllChats[];
 extern const char kOptionJumpToFirst[];
 extern const char kOptionStaticUserpicsList[];
+extern const char kOptionChatListNoReorderAnimation[];
 extern const char kOptionGhostInMenu[];
 extern const char kOptionStaticUserpicsChats[];
 extern const char kOptionHideMentionsButton[];
@@ -116,6 +117,7 @@ void SetGroupCallButton(const QString &value);
 [[nodiscard]] bool GhostInMenu();
 [[nodiscard]] bool StaticUserpicsList();
 [[nodiscard]] rpl::producer<> StaticUserpicsListChanges();
+[[nodiscard]] bool ChatListNoReorderAnimation();
 [[nodiscard]] bool StaticUserpicsChats();
 [[nodiscard]] rpl::producer<> StaticUserpicsChatsChanges();
 [[nodiscard]] bool HideMentionsButton();
