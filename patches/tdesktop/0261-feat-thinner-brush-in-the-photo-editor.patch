diff --git a/Telegram/SourceFiles/tele/tele_editor_brush.cpp b/Telegram/SourceFiles/tele/tele_editor_brush.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5091602b4c64a9ac56b9fc497d899996d2f9534e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_editor_brush.cpp
@@ -0,0 +1,17 @@
+#include "tele/tele_editor_brush.h"
+
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+// the smallest ratio the photo editor still saves (it drops 0)
+constexpr auto kThinBrushRatio = 1.5 / 100000;
+
+} // namespace
+
+float64 MinBrushRatio(float64 ratio) {
+	return ThinBrush() ? kThinBrushRatio : ratio;
+}
+
+} // namespace Tele
