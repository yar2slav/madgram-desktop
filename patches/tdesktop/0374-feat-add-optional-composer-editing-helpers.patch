diff --git a/Telegram/SourceFiles/tele/tele_composer_editing.cpp b/Telegram/SourceFiles/tele/tele_composer_editing.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a61d7c48019f0c33c77eb80ab570bf40cb93d00a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_composer_editing.cpp
@@ -0,0 +1,496 @@
+#include "tele/tele_composer_editing.h"
+
+#include "base/options.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/fields/input_field.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QPointer>
+#include <QtGui/QInputMethodEvent>
+#include <QtGui/QKeyEvent>
+#include <QtGui/QTextDocument>
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool IsNewline(QChar ch) {
+	return ch == QChar('\n')
+		|| ch == QChar::LineSeparator
+		|| ch == QChar::ParagraphSeparator;
+}
+
+[[nodiscard]] bool IsIndent(QChar ch) {
+	return ch == QChar(' ') || ch == QChar('\t');
+}
+
+[[nodiscard]] QChar Closer(QChar ch) {
+	switch (ch.unicode()) {
+	case '(': return QChar(')');
+	case '[': return QChar(']');
+	case '{': return QChar('}');
+	case '<': return QChar('>');
+	}
+	return QChar();
+}
+
+class ComposerEditing final : public QObject {
+public:
+	explicit ComposerEditing(not_null<Ui::InputField*> field);
+
+private:
+	struct Pair {
+		int open = 0;
+		int close = 0;
+		QChar opening;
+		QChar closing;
+		bool untouched = true;
+	};
+
+	bool eventFilter(QObject *object, QEvent *event) override;
+	bool keyPress(not_null<QKeyEvent*> e);
+	void wrap(QChar opening, QChar closing);
+	void insertPair(QChar opening, QChar closing);
+	void convertAngles(Pair pair);
+	bool completeFence();
+	bool angleBoundary(int position) const;
+	bool forwardKey(not_null<QKeyEvent*> e, bool indent = false);
+	void contentsChange(int position, int removed, int added);
+	void validatePairs();
+
+	const not_null<Ui::InputField*> _field;
+	const not_null<QTextEdit*> _edit;
+	const not_null<QTextDocument*> _document;
+	std::vector<Pair> _pairs;
+	bool _handling = false;
+	bool _preedit = false;
+	bool _submitted = false;
+	rpl::lifetime _lifetime;
+};
+
+ComposerEditing::ComposerEditing(not_null<Ui::InputField*> field)
+: QObject(field)
+, _field(field)
+, _edit(field->rawTextEdit())
+, _document(field->document()) {
+	_edit->installEventFilter(this);
+	_edit->viewport()->installEventFilter(this);
+	connect(_edit, &QTextEdit::cursorPositionChanged, this, [=] {
+		if (!_handling) {
+			_pairs.clear();
+		}
+	});
+	connect(_edit, &QTextEdit::selectionChanged, this, [=] {
+		if (!_handling) {
+			_pairs.clear();
+		}
+	});
+	connect(_document, &QTextDocument::contentsChange, this, [=](
+			int position,
+			int removed,
+			int added) {
+		contentsChange(position, removed, added);
+	});
+	base::options::details::Lookup(kOptionAutoCloseBrackets).changes(
+	) | rpl::on_next([=] {
+		_pairs.clear();
+	}, _lifetime);
+	_field->submits() | rpl::on_next([=] {
+		_submitted = true;
+	}, _lifetime);
+}
+
+bool ComposerEditing::eventFilter(QObject *object, QEvent *event) {
+	if (_handling) {
+		return false;
+	}
+	switch (event->type()) {
+	case QEvent::InputMethod:
+		_preedit = !static_cast<QInputMethodEvent*>(event)
+			->preeditString().isEmpty();
+		_pairs.clear();
+		break;
+	case QEvent::FocusOut:
+		_preedit = false;
+		_pairs.clear();
+		break;
+	case QEvent::MouseButtonPress:
+	case QEvent::MouseButtonDblClick:
+	case QEvent::ContextMenu:
+		_pairs.clear();
+		break;
+	case QEvent::KeyPress:
+		if (object == _edit) {
+			return keyPress(static_cast<QKeyEvent*>(event));
+		}
+		break;
+	default:
+		break;
+	}
+	return false;
+}
+
+bool ComposerEditing::keyPress(not_null<QKeyEvent*> e) {
+	const auto wrapEnabled = WrapSelectedText();
+	const auto pairsEnabled = AutoCloseBrackets();
+	const auto indentEnabled = KeepIndentation();
+	if (!pairsEnabled) {
+		_pairs.clear();
+	}
+	if (_preedit || (!wrapEnabled && !pairsEnabled && !indentEnabled)) {
+		return false;
+	}
+	if (e->key() == Qt::Key_Shift
+		|| e->key() == Qt::Key_Control
+		|| e->key() == Qt::Key_Alt
+		|| e->key() == Qt::Key_Meta
+		|| e->key() == Qt::Key_AltGr) {
+		return false;
+	}
+	const auto cursor = _field->textCursor();
+	const auto position = cursor.position();
+	const auto modifiers = e->modifiers();
+	const auto altGr = modifiers.testFlag(Qt::ControlModifier)
+		&& modifiers.testFlag(Qt::AltModifier)
+		&& !modifiers.testFlag(Qt::MetaModifier);
+	const auto plain = altGr || !(modifiers
+		& ~(Qt::ShiftModifier | Qt::KeypadModifier | Qt::GroupSwitchModifier));
+	const auto text = e->text();
+	const auto ch = (plain && text.size() == 1) ? text.front() : QChar();
+	const auto closer = Closer(ch);
+
+	if (wrapEnabled && cursor.hasSelection()
+		&& (!closer.isNull() || ch == QChar('"')
+			|| ch == QChar('`') || ch == QChar('*'))) {
+		if (pairsEnabled && ch == QChar('<') && !_pairs.empty()) {
+			const auto pair = _pairs.back();
+			if (pair.opening == QChar('<') && pair.closing == QChar('>')
+				&& cursor.selectionStart() == pair.open + 1
+				&& cursor.selectionEnd() == pair.close) {
+				convertAngles(pair);
+				e->accept();
+				return true;
+			}
+		}
+		const auto from = cursor.selectionStart();
+		const auto till = cursor.selectionEnd();
+		wrap(ch, closer.isNull() ? ch : closer);
+		if (pairsEnabled && ch == QChar('<')) {
+			_pairs.push_back({
+				from,
+				till + 1,
+				ch,
+				closer,
+				false,
+			});
+		}
+		e->accept();
+		return true;
+	}
+	if (pairsEnabled && !cursor.hasSelection()) {
+		validatePairs();
+		for (auto i = int(_pairs.size()); i > 0; --i) {
+			const auto pair = _pairs[i - 1];
+			if (position != pair.close) {
+				continue;
+			}
+			if (ch == QChar('<') && pair.opening == QChar('<')
+				&& pair.untouched && pair.close == pair.open + 1) {
+				convertAngles(pair);
+				e->accept();
+				return true;
+			} else if (ch == QChar('>') && pair.closing == QChar(0xBB)
+				&& position > pair.open + 1
+				&& _document->characterAt(position - 1) == QChar('>')) {
+				_pairs.erase(_pairs.begin() + i - 1);
+				_handling = true;
+				auto edit = cursor;
+				edit.beginEditBlock();
+				edit.setPosition(position - 1);
+				edit.setPosition(position, QTextCursor::KeepAnchor);
+				edit.removeSelectedText();
+				edit.setPosition(position);
+				edit.endEditBlock();
+				_field->setTextCursor(edit);
+				_handling = false;
+				e->accept();
+				return true;
+			}
+			if (ch == pair.closing) {
+				_pairs.erase(_pairs.begin() + i - 1);
+				_handling = true;
+				_field->setCursorPosition(position + 1);
+				_handling = false;
+				e->accept();
+				return true;
+			} else if (e->key() == Qt::Key_Backspace
+				&& modifiers == Qt::NoModifier
+				&& pair.untouched && pair.close == pair.open + 1) {
+				_handling = true;
+				auto edit = cursor;
+				edit.beginEditBlock();
+				edit.setPosition(pair.open);
+				edit.setPosition(pair.close + 1, QTextCursor::KeepAnchor);
+				edit.removeSelectedText();
+				edit.endEditBlock();
+				_field->setTextCursor(edit);
+				_handling = false;
+				e->accept();
+				return true;
+			}
+		}
+		if (!closer.isNull()
+			&& (ch != QChar('<') || angleBoundary(position))) {
+			insertPair(ch, closer);
+			e->accept();
+			return true;
+		}
+		if (ch == QChar('`') && completeFence()) {
+			e->accept();
+			return true;
+		}
+	}
+
+	const auto enter = e->key() == Qt::Key_Return
+		|| e->key() == Qt::Key_Enter;
+	if (indentEnabled && enter && !cursor.hasSelection()) {
+		return forwardKey(e, true);
+	}
+	if (!_pairs.empty() && !cursor.hasSelection()
+		&& ((!ch.isNull() && ch.isPrint())
+			|| (e->key() == Qt::Key_Backspace && modifiers == Qt::NoModifier))) {
+		return forwardKey(e);
+	}
+	// Navigation, paste, shortcuts and undo/redo use the unmodified field path.
+	_pairs.clear();
+	return false;
+}
+
+void ComposerEditing::wrap(QChar opening, QChar closing) {
+	_pairs.clear();
+	_handling = true;
+	auto cursor = _field->textCursor();
+	const auto from = cursor.selectionStart();
+	const auto till = cursor.selectionEnd();
+	const auto reverse = cursor.position() < cursor.anchor();
+	cursor.beginEditBlock();
+	cursor.setPosition(till);
+	cursor.insertText(QString(closing), QTextCharFormat());
+	cursor.setPosition(from);
+	cursor.insertText(QString(opening), QTextCharFormat());
+	cursor.endEditBlock();
+	// Insert at the edges, never serialize the selection: object formats,
+	// links and custom emoji remain exactly where the user put them.
+	cursor.setPosition(reverse ? till + 1 : from + 1);
+	cursor.setPosition(reverse ? from + 1 : till + 1, QTextCursor::KeepAnchor);
+	_field->setTextCursor(cursor);
+	_handling = false;
+}
+
+void ComposerEditing::insertPair(QChar opening, QChar closing) {
+	_handling = true;
+	auto cursor = _field->textCursor();
+	const auto position = cursor.position();
+	cursor.beginEditBlock();
+	cursor.insertText(QString(opening) + closing, QTextCharFormat());
+	cursor.endEditBlock();
+	_pairs.push_back({ position, position + 1, opening, closing });
+	cursor.setPosition(position + 1);
+	_field->setTextCursor(cursor);
+	_handling = false;
+}
+
+void ComposerEditing::convertAngles(Pair pair) {
+	_handling = true;
+	auto cursor = _field->textCursor();
+	const auto anchor = cursor.anchor();
+	const auto position = cursor.position();
+	cursor.beginEditBlock();
+	cursor.setPosition(pair.close);
+	cursor.setPosition(pair.close + 1, QTextCursor::KeepAnchor);
+	cursor.insertText(QString(QChar(0xBB)), QTextCharFormat());
+	cursor.setPosition(pair.open);
+	cursor.setPosition(pair.open + 1, QTextCursor::KeepAnchor);
+	cursor.insertText(QString(QChar(0xAB)), QTextCharFormat());
+	cursor.endEditBlock();
+	_pairs.push_back({
+		pair.open,
+		pair.close,
+		QChar(0xAB),
+		QChar(0xBB),
+		pair.untouched,
+	});
+	cursor.setPosition(anchor);
+	cursor.setPosition(position, QTextCursor::KeepAnchor);
+	_field->setTextCursor(cursor);
+	_handling = false;
+}
+
+bool ComposerEditing::angleBoundary(int position) const {
+	const auto next = _document->characterAt(position);
+	if (!next.isSpace() && !IsNewline(next) && !next.isNull()
+		&& next != QChar(')') && next != QChar(']') && next != QChar('}')) {
+		return false;
+	}
+	auto previous = position - 1;
+	while (previous >= 0 && IsIndent(_document->characterAt(previous))) {
+		--previous;
+	}
+	if (previous < 0 || IsNewline(_document->characterAt(previous))) {
+		return true;
+	}
+	const auto ch = _document->characterAt(previous);
+	return ch == QChar('(') || ch == QChar('[') || ch == QChar('{')
+		|| ch == QChar('=') || ch == QChar(':') || ch == QChar(',');
+}
+
+bool ComposerEditing::completeFence() {
+	auto cursor = _field->textCursor();
+	const auto position = cursor.position();
+	if (position < 2
+		|| _document->characterAt(position - 1) != QChar('`')
+		|| _document->characterAt(position - 2) != QChar('`')
+		|| (position > 2 && _document->characterAt(position - 3) == QChar('`'))
+		|| (position > 2 && _document->characterAt(position - 3) == QChar('\\'))
+		|| !IsNewline(_document->characterAt(position))
+		|| _field->isMarkdownTagActive(Ui::InputField::kTagPre)
+		|| _field->isMarkdownTagActive(Ui::InputField::kTagCode)) {
+		return false;
+	}
+	// A third backtick inside an existing fence is its closer, not an opener.
+	auto inside = false;
+	for (auto i = 0; i < position - 2; ++i) {
+		if (_document->characterAt(i) != QChar('`')
+			|| _document->characterAt(i + 1) != QChar('`')
+			|| _document->characterAt(i + 2) != QChar('`')
+			|| (i && _document->characterAt(i - 1) == QChar('\\'))
+			|| !_field->getTextWithTagsPart(i, i + 3).tags.empty()) {
+			continue;
+		}
+		inside = !inside;
+		while (i + 1 < position - 2
+			&& _document->characterAt(i + 1) == QChar('`')) {
+			++i;
+		}
+	}
+	if (inside) {
+		return false;
+	}
+	_pairs.clear();
+	_handling = true;
+	cursor.beginEditBlock();
+	cursor.insertText(u"`\n\n```"_q, QTextCharFormat());
+	cursor.endEditBlock();
+	cursor.setPosition(position + 2);
+	_field->setTextCursor(cursor);
+	_handling = false;
+	return true;
+}
+
+bool ComposerEditing::forwardKey(not_null<QKeyEvent*> e, bool indent) {
+	const auto cursor = _field->textCursor();
+	const auto position = cursor.position();
+	const auto count = _document->characterCount();
+	auto from = position;
+	while (indent && from > 0 && !IsNewline(_document->characterAt(from - 1))) {
+		--from;
+	}
+	auto leading = from;
+	while (indent && leading < position && IsIndent(_document->characterAt(leading))) {
+		++leading;
+	}
+	const auto indentation = (indent && leading > from)
+		? [&] {
+			auto part = cursor;
+			part.setPosition(from);
+			part.setPosition(leading, QTextCursor::KeepAnchor);
+			return part.selectedText();
+		}()
+		: QString();
+	auto emptyLine = (leading == position);
+	for (auto i = position; indent && emptyLine; ++i) {
+		const auto ch = _document->characterAt(i);
+		if (IsNewline(ch) || ch.isNull()) {
+			break;
+		} else if (!IsIndent(ch)) {
+			emptyLine = false;
+		}
+	}
+	const auto guard = QPointer<ComposerEditing>(this);
+	_submitted = false;
+	_handling = true;
+	QCoreApplication::sendEvent(_edit, e);
+	if (!guard) {
+		return true;
+	}
+	// Let InputField choose whether Enter sends, exits a quote, or inserts a
+	// newline. Only extend a verified ordinary newline; never replace submit.
+	if (indent && !_submitted && !indentation.isEmpty()
+		&& _document->characterCount() == count + 1
+		&& _field->textCursor().position() == position + 1
+		&& IsNewline(_document->characterAt(position))) {
+		auto edit = _field->textCursor();
+		edit.joinPreviousEditBlock();
+		if (emptyLine) {
+			edit.setPosition(from);
+			edit.setPosition(position, QTextCursor::KeepAnchor);
+			edit.removeSelectedText();
+			edit.setPosition(from + 1);
+		} else {
+			edit.insertText(indentation);
+		}
+		edit.endEditBlock();
+		_field->setTextCursor(edit);
+	}
+	validatePairs();
+	_handling = false;
+	return true;
+}
+
+void ComposerEditing::contentsChange(int position, int removed, int added) {
+	if (_pairs.empty()) {
+		return;
+	} else if (!_handling) {
+		_pairs.clear();
+		return;
+	}
+	const auto end = position + removed;
+	std::erase_if(_pairs, [&](Pair &pair) {
+		if ((removed && position <= pair.open && pair.open < end)
+			|| (removed && position <= pair.close && pair.close < end)) {
+			return true;
+		}
+		if (position > pair.open && position <= pair.close) {
+			pair.untouched = false;
+		}
+		if (pair.open >= end) {
+			pair.open += added - removed;
+		}
+		if (pair.close >= end) {
+			pair.close += added - removed;
+		}
+		return false;
+	});
+}
+
+void ComposerEditing::validatePairs() {
+	const auto cursor = _field->textCursor();
+	std::erase_if(_pairs, [&](const Pair &pair) {
+		return cursor.hasSelection()
+			|| cursor.position() <= pair.open || cursor.position() > pair.close
+			|| _document->characterAt(pair.open) != pair.opening
+			|| _document->characterAt(pair.close) != pair.closing;
+	});
+}
+
+} // namespace
+
+void SetupComposerEditing(not_null<Ui::InputField*> field) {
+	// GIF/sticker caption boxes also use InitMessageField.
+	if (!field->property("teleComposerEditing").toBool()) {
+		field->setProperty("teleComposerEditing", true);
+		new ComposerEditing(field);
+	}
+}
+
+} // namespace Tele
