+[[nodiscard]] Ui::Toast::Config AliasCopiedToast() {
+	return {
+		.text = { Lower(u"Alias copied to clipboard."_q) },
+		.iconLottie = u"toast/copy"_q,
+		.iconLottieSize = st::toastLottieIconSize,
+	};
+}
+
+[[nodiscard]] QString AliasDeletedText(const QString &alias) {
+	return '@' + alias + Lower(u" deleted."_q);
+}
+
 void ShowReplacedToast(
 		not_null<History*> history,
 		const std::vector<std::pair<QString, QString>> &replaced) {
@@ -583,22 +596,48 @@ void SetupPeerAliasesLabel(
 		not_null<Ui::FlatLabel*> label,
 		not_null<PeerData*> peer,
 		not_null<Window::SessionController*> controller) {
+	using Links = std::vector<std::pair<ClickHandlerPtr, QString>>;
 	const auto weak = base::make_weak(controller);
+	const auto session = &peer->session();
+	const auto links = label->lifetime().make_state<Links>();
+	const auto copy = [=](const QString &alias) {
+		TextUtilities::SetClipboardText({ alias });
+		if (const auto strong = weak.get()) {
+			strong->showToast(AliasCopiedToast());
+		}
+	};
 	PeerAliasesValue(peer) | rpl::on_next([=](const QStringList &list) {
+		links->clear();
 		for (auto i = 0; i != int(list.size()); ++i) {
 			const auto alias = list[i];
-			label->setLink(i + 1, std::make_shared<LambdaClickHandler>([=] {
-				TextUtilities::SetClipboardText({ alias });
-				if (const auto strong = weak.get()) {
-					strong->showToast({
-						.text = { Lower(u"Alias copied to clipboard."_q) },
-						.iconLottie = u"toast/copy"_q,
-						.iconLottieSize = st::toastLottieIconSize,
-					});
-				}
-			}));
+			const auto link = std::make_shared<LambdaClickHandler>([=] {
+				copy(alias);
+			});
+			links->emplace_back(link, alias);
+			label->setLink(i + 1, link);
 		}
 	}, label->lifetime());
+	label->setContextMenuHook([=](
+			Ui::FlatLabel::ContextMenuRequest request) {
+		const auto i = ranges::find(
+			*links,
+			request.link,
+			&Links::value_type::first);
+		if (!request.selection.empty() || i == end(*links)) {
+			label->fillContextMenu(request);
+			return;
+		}
+		const auto alias = i->second;
+		request.menu->addAction(Lower(u"Copy alias"_q), [=] {
+			copy(alias);
+		});
+		request.menu->addAction(Lower(u"Delete alias"_q), [=] {
+			RemoveUsernameAlias(session, alias.mid(1));
+			if (const auto strong = weak.get()) {
+				strong->showToast(AliasDeletedText(alias.mid(1)));
+			}
+		});
+	});
 }
 
 rpl::producer<int> UsernameAliasesCountValue(
@@ -692,6 +731,41 @@ void AddOpenRealUsernameAction(
 	}, &st::menuIconUsername);
 }
 
+void AddAliasMentionActions(
+		not_null<Ui::PopupMenu*> menu,
+		const std::shared_ptr<Main::SessionShow> &show,
+		const std::shared_ptr<ClickHandler> &link) {
+	if (!link || !show || !AliasMenu()) {
+		return;
+	}
+	const auto session = &show->session();
+	const auto alias = LinkUsername(link).toLower();
+	const auto id = alias.isEmpty() ? PeerId() : AliasPeerId(session, alias);
+	if (!id) {
+		return;
+	}
+	TagMenuAction(menu->addAction(Lower(u"Copy alias"_q), [=] {
+		TextUtilities::SetClipboardText({ '@' + alias });
+		show->showToast(AliasCopiedToast());
+	}, &st::menuIconCopy), u"alias_copy"_q);
+	if (LoadedPeer(session, id)) {
+		const auto weak = base::make_weak(session->tryResolveWindow());
+		TagMenuAction(menu->addAction(Lower(u"Open profile"_q), [=] {
+			const auto strong = weak.get();
+			const auto peer = strong
+				? LoadedPeer(&strong->session(), id)
+				: nullptr;
+			if (peer) {
+				strong->showPeerInfo(peer);
+			}
+		}, &st::menuIconProfile), u"alias_open"_q);
+	}
+	TagMenuAction(menu->addAction(Lower(u"Delete alias"_q), [=] {
+		RemoveUsernameAlias(&show->session(), alias);
+		show->showToast(AliasDeletedText(alias));
+	}, &st::menuIconDelete), u"alias_delete"_q);
+}
+
 std::vector<UsernameAliasMention> UsernameAliasMentions(
 		not_null<Main::Session*> session,
 		const QString &filter) {
