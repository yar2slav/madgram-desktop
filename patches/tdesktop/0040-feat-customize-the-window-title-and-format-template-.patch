+	const auto text = PreviewWindowTitleText(window, source);
+	return text.isEmpty() ? u" "_q : text;
+}
+
+rpl::producer<> WindowTitleChanges(not_null<Window::Controller*> window) {
+	return WindowTitleTemplateValue(
+	) | rpl::map([](const QString &source) {
+		return source.isEmpty();
+	}) | rpl::distinct_until_changed(
+	) | rpl::map([=](bool empty) -> rpl::producer<> {
+		if (empty) {
+			return rpl::single(rpl::empty);
+		}
+		return LiveText(window, Target::Window) | rpl::to_empty;
+	}) | rpl::flatten_latest();
+}
+
 } // namespace Tele
