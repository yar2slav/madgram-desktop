diff --git a/Telegram/SourceFiles/tele/tele_title_template.cpp b/Telegram/SourceFiles/tele/tele_title_template.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ed23deaa5a6c490a29bf984ef247a78ddbe473e0
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_title_template.cpp
@@ -0,0 +1,521 @@
+#include "tele/tele_title_template.h"
+
+#include "tele/tele_lowercase.h"
+
+namespace Tele::Titles {
+namespace {
+
+enum class Arity {
+	None,
+	Number,
+	Text,
+};
+
+struct ModifierResult {
+	std::optional<Modifier> modifier;
+	QString error;
+};
+
+[[nodiscard]] bool Known(const QString &name) {
+	static const auto list = QStringList{
+		u"build"_q,
+		u"version"_q,
+		u"time"_q,
+		u"date"_q,
+		u"weekday"_q,
+		u"day"_q,
+		u"month"_q,
+		u"name"_q,
+		u"username"_q,
+		u"id"_q,
+		u"accounts"_q,
+		u"unread"_q,
+		u"chat"_q,
+		u"chat_unread"_q,
+		u"status"_q,
+		u"label"_q,
+	};
+	return list.contains(name);
+}
+
+[[nodiscard]] bool Formatted(const QString &name) {
+	return (name == u"time"_q) || (name == u"date"_q);
+}
+
+[[nodiscard]] std::optional<Arity> ModifierArity(const QString &name) {
+	if (name == u"lower"_q
+		|| name == u"upper"_q
+		|| name == u"title"_q
+		|| name == u"cap"_q
+		|| name == u"short"_q
+		|| name == u"first"_q
+		|| name == u"last"_q
+		|| name == u"k"_q) {
+		return Arity::None;
+	} else if (name == u"max"_q || name == u"pad"_q) {
+		return Arity::Number;
+	} else if (name == u"default"_q) {
+		return Arity::Text;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QString Quoted(const QString &text) {
+	return QChar(0x201C) + text + QChar(0x201D);
+}
+
+[[nodiscard]] ModifierResult ParseModifier(const QString &segment) {
+	const auto colon = segment.indexOf(':');
+	const auto name = segment.mid(0, colon).trimmed();
+	const auto argument = (colon < 0) ? QString() : segment.mid(colon + 1);
+	if (name.isEmpty()) {
+		return { .error = Lower(u"empty modifier"_q) };
+	}
+	const auto arity = ModifierArity(name);
+	if (!arity) {
+		return { .error = Lower(u"unknown modifier "_q) + Quoted(name) };
+	} else if (*arity == Arity::None) {
+		if (colon >= 0) {
+			return { .error = Quoted(name) + Lower(u" takes no value"_q) };
+		}
+		return { .modifier = Modifier{ .name = name } };
+	} else if (*arity == Arity::Number) {
+		const auto limit = (name == u"max"_q) ? 1000 : 64;
+		auto ok = false;
+		const auto number = argument.trimmed().toInt(&ok);
+		if (colon < 0 || !ok || number < 1 || number > limit) {
+			return {
+				.error = Quoted(name)
+					+ Lower(u" needs a number from 1 to %1, like "_q.arg(
+						limit))
+					+ name
+					+ u":%1"_q.arg((name == u"max"_q) ? 20 : 2),
+			};
+		}
+		return { .modifier = Modifier{ .name = name, .number = number } };
+	} else if (colon < 0) {
+		return {
+			.error = Quoted(name)
+				+ Lower(u" needs a value, like "_q)
+				+ name
+				+ u":none"_q,
+		};
+	}
+	return { .modifier = Modifier{ .name = name, .argument = argument } };
+}
+
+[[nodiscard]] std::vector<int> Pipes(const QString &text) {
+	auto result = std::vector<int>();
+	auto quoted = false;
+	for (auto i = 0, size = int(text.size()); i != size; ++i) {
+		if (text[i] == '\'') {
+			quoted = !quoted;
+		} else if (text[i] == '|' && !quoted) {
+			result.push_back(i);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<std::vector<Modifier>> ParseModifiers(
+		const QString &tail,
+		QString *error) {
+	auto result = std::vector<Modifier>();
+	for (const auto &segment : tail.split('|')) {
+		auto parsed = ParseModifier(segment);
+		if (!parsed.modifier) {
+			if (error) {
+				*error = parsed.error;
+			}
+			return std::nullopt;
+		}
+		result.push_back(std::move(*parsed.modifier));
+	}
+	return result;
+}
+
+[[nodiscard]] Token ParseVariable(
+		const QString &source,
+		int from,
+		int till,
+		bool window,
+		Template &out) {
+	auto token = Token{
+		.text = source.mid(from, till - from),
+		.variable = true,
+	};
+	const auto body = source.mid(from + 1, till - from - 2);
+	const auto size = int(body.size());
+	auto end = 0;
+	while (end < size && body[end] != ':' && body[end] != '|') {
+		++end;
+	}
+	token.name = body.mid(0, end).trimmed();
+	auto tail = std::optional<QString>();
+	if (end < size && body[end] == ':') {
+		const auto rest = body.mid(end + 1);
+		if (Formatted(token.name)) {
+			const auto pipes = Pipes(rest);
+			auto split = -1;
+			for (const auto pipe : pipes) {
+				if (ParseModifiers(rest.mid(pipe + 1), nullptr)) {
+					split = pipe;
+					break;
+				}
+			}
+			if (split >= 0) {
+				token.format = rest.mid(0, split);
+				tail = rest.mid(split + 1);
+			} else {
+				token.format = rest;
+				if (!pipes.empty()) {
+					const auto first = rest.mid(pipes.front() + 1).section(
+						'|',
+						0,
+						0).section(':', 0, 0).trimmed();
+					out.errors.push_back(token.text
+						+ u": "_q
+						+ Quoted(first)
+						+ Lower(u" isn't a modifier, so it stays in the "
+							"format"_q));
+				}
+			}
+		} else {
+			const auto pipe = rest.indexOf('|');
+			token.format = rest.mid(0, pipe);
+			if (pipe >= 0) {
+				tail = rest.mid(pipe + 1);
+			}
+		}
+	} else if (end < size) {
+		tail = body.mid(end + 1);
+	}
+	auto invalid = false;
+	if (tail) {
+		auto error = QString();
+		if (auto modifiers = ParseModifiers(*tail, &error)) {
+			token.modifiers = std::move(*modifiers);
+			token.brief = ranges::any_of(token.modifiers, [](
+					const Modifier &modifier) {
+				return (modifier.name == u"short"_q);
+			});
+		} else {
+			token.broken = true;
+			invalid = true;
+			out.errors.push_back(token.text + u": "_q + error);
+		}
+	}
+	if (!Known(token.name)) {
+		invalid = true;
+		out.errors.push_back(token.text + Lower(u": unknown variable"_q));
+	} else if (token.name == u"label"_q && !window) {
+		invalid = true;
+		out.errors.push_back(token.text
+			+ Lower(u": only works in the window title"_q));
+	}
+	out.spans.push_back({
+		.from = from,
+		.till = till,
+		.type = invalid ? SpanType::Invalid : SpanType::Variable,
+	});
+	return token;
+}
+
+[[nodiscard]] QString Unmatched(QChar ch) {
+	return Lower(u"Unmatched "_q)
+		+ ch
+		+ Lower(u", use "_q)
+		+ ch
+		+ ch
+		+ Lower(u" for a literal one"_q);
+}
+
+[[nodiscard]] std::vector<Token> ParseTokens(
+		const QString &source,
+		int &position,
+		bool nested,
+		bool &closed,
+		bool window,
+		Template &out) {
+	auto result = std::vector<Token>();
+	auto literal = QString();
+	const auto flush = [&] {
+		if (!literal.isEmpty()) {
+			result.push_back({ .text = base::take(literal) });
+		}
+	};
+	const auto invalid = [&](int at, QChar ch) {
+		out.spans.push_back({
+			.from = at,
+			.till = at + 1,
+			.type = SpanType::Invalid,
+		});
+		out.errors.push_back(Unmatched(ch));
+	};
+	const auto size = int(source.size());
+	while (position < size) {
+		const auto ch = source[position];
+		const auto doubled = (position + 1 < size)
+			&& (source[position + 1] == ch);
+		if (doubled
+			&& (ch == '{' || ch == '}' || ch == '[' || ch == ']')) {
+			literal += ch;
+			position += 2;
+		} else if (ch == '{') {
+			const auto end = source.indexOf('}', position + 1);
+			if (end < 0) {
+				invalid(position, ch);
+				literal += source.mid(position);
+				position = size;
+				break;
+			}
+			flush();
+			result.push_back(
+				ParseVariable(source, position, end + 1, window, out));
+			position = end + 1;
+		} else if (ch == '[') {
+			const auto open = position;
+			auto inner = position + 1;
+			auto innerClosed = false;
+			auto group = ParseTokens(
+				source,
+				inner,
+				true,
+				innerClosed,
+				window,
+				out);
+			if (!innerClosed) {
+				invalid(open, ch);
+				literal += ch;
+				flush();
+				for (auto &token : group) {
+					result.push_back(std::move(token));
+				}
+				position = inner;
+				break;
+			}
+			out.spans.push_back({
+				.from = open,
+				.till = open + 1,
+				.type = SpanType::Bracket,
+			});
+			out.spans.push_back({
+				.from = inner - 1,
+				.till = inner,
+				.type = SpanType::Bracket,
+			});
+			flush();
+			result.push_back({ .group = std::move(group), .optional = true });
+			position = inner;
+		} else if (ch == ']' && nested) {
+			++position;
+			flush();
+			closed = true;
+			return result;
+		} else {
+			if (ch == ']' || ch == '}') {
+				invalid(position, ch);
+			}
+			literal += ch;
+			++position;
+		}
+	}
+	flush();
+	closed = false;
+	return result;
+}
+
+[[nodiscard]] Tick TickFor(const std::vector<Token> &tokens) {
+	auto result = Tick::None;
+	for (const auto &token : tokens) {
+		auto tick = Tick::None;
+		if (token.optional) {
+			tick = TickFor(token.group);
+		} else if (!token.variable) {
+			continue;
+		} else if (token.name == u"status"_q
+			|| token.name == u"chat_unread"_q) {
+			tick = Tick::Second;
+		} else if (token.name == u"time"_q || token.name == u"date"_q) {
+			tick = (token.format.contains('s') || token.format.contains('z'))
+				? Tick::Second
+				: Tick::Minute;
+		} else if (token.name == u"weekday"_q
+			|| token.name == u"day"_q
+			|| token.name == u"month"_q) {
+			tick = Tick::Minute;
+		}
+		result = std::max(result, tick);
+	}
+	return result;
+}
+
+[[nodiscard]] bool UsesLabel(const std::vector<Token> &tokens) {
+	return ranges::any_of(tokens, [](const Token &token) {
+		return token.optional
+			? UsesLabel(token.group)
+			: (token.variable && token.name == u"label"_q);
+	});
+}
+
+[[nodiscard]] bool Empty(const QString &value) {
+	return value.isEmpty() || (value == u"0"_q);
+}
+
+[[nodiscard]] bool Digits(const QString &value) {
+	return !value.isEmpty() && ranges::all_of(value, [](QChar ch) {
+		return (ch >= '0') && (ch <= '9');
+	});
+}
+
+[[nodiscard]] QString Word(const QString &text, bool first) {
+	const auto words = text.simplified().split(' ', Qt::SkipEmptyParts);
+	return words.isEmpty()
+		? QString()
+		: first
+		? words.front()
+		: words.back();
+}
+
+[[nodiscard]] QString Titled(QString text) {
+	auto start = true;
+	for (auto &ch : text) {
+		if (ch.isSpace()) {
+			start = true;
+		} else {
+			if (start) {
+				ch = ch.toUpper();
+			}
+			start = false;
+		}
+	}
+	return text;
+}
+
+[[nodiscard]] QString Capitalized(QString text) {
+	for (auto &ch : text) {
+		if (!ch.isSpace()) {
+			ch = ch.toUpper();
+			break;
+		}
+	}
+	return text;
+}
+
+[[nodiscard]] QString Elided(const QString &text, int limit) {
+	if (text.size() <= limit) {
+		return text;
+	}
+	auto cut = limit - 1;
+	if (cut > 0 && text[cut - 1].isHighSurrogate()) {
+		--cut;
+	}
+	while (cut > 0 && text[cut - 1].isSpace()) {
+		--cut;
+	}
+	return text.mid(0, cut) + QChar(0x2026);
+}
+
+[[nodiscard]] QString Padded(const QString &text, int width) {
+	const auto size = int(text.size());
+	return (size >= width)
+		? text
+		: QString(width - size, Digits(text) ? QChar('0') : QChar(' ')) + text;
+}
+
+void Apply(const Modifier &modifier, QString &text, bool &filled) {
+	const auto &name = modifier.name;
+	if (name == u"lower"_q) {
+		text = text.toLower();
+	} else if (name == u"upper"_q) {
+		text = text.toUpper();
+	} else if (name == u"title"_q) {
+		text = Titled(text);
+	} else if (name == u"cap"_q) {
+		text = Capitalized(text);
+	} else if (name == u"first"_q) {
+		text = Word(text, true);
+	} else if (name == u"last"_q) {
+		text = Word(text, false);
+	} else if (name == u"k"_q) {
+		text = Compact(text);
+	} else if (name == u"max"_q) {
+		text = Elided(text, modifier.number);
+	} else if (name == u"pad"_q) {
+		text = Padded(text, modifier.number);
+	} else if (name == u"default"_q && Empty(text)) {
+		text = modifier.argument;
+		filled = true;
+	}
+}
+
+} // namespace
+
+Template Parse(const QString &source, bool window) {
+	auto result = Template();
+	auto position = 0;
+	auto closed = false;
+	result.tokens = ParseTokens(
+		source,
+		position,
+		false,
+		closed,
+		window,
+		result);
+	result.tick = TickFor(result.tokens);
+	result.label = UsesLabel(result.tokens);
+	ranges::sort(result.spans, ranges::less(), &Span::from);
+	result.errors.removeDuplicates();
+	return result;
+}
+
+std::optional<QString> Render(
+		const std::vector<Token> &tokens,
+		const Resolver &resolve,
+		bool optional) {
+	auto result = QString();
+	for (const auto &token : tokens) {
+		if (token.optional) {
+			result += Render(token.group, resolve, true).value_or(QString());
+		} else if (!token.variable || token.broken) {
+			result += token.text;
+		} else if (const auto value = resolve(token)) {
+			auto text = *value;
+			const auto empty = Empty(text);
+			auto filled = false;
+			for (const auto &modifier : token.modifiers) {
+				Apply(modifier, text, filled);
+			}
+			if (optional && empty && !filled) {
+				return std::nullopt;
+			}
+			result += text;
+		} else {
+			result += token.text;
+		}
+	}
+	return result;
+}
+
+QString Compact(const QString &number) {
+	if (!Digits(number) || number.size() > 15) {
+		return number;
+	}
+	const auto value = number.toLongLong();
+	const auto format = [&](qint64 unit, QChar suffix) {
+		const auto whole = value / unit;
+		const auto tenth = (whole < 10) ? ((value % unit) * 10 / unit) : 0;
+		return QString::number(whole)
+			+ (tenth ? (u"."_q + QString::number(tenth)) : QString())
+			+ suffix;
+	};
+	return (value < 1000)
+		? number
+		: (value < 1000000)
+		? format(1000, 'k')
+		: (value < 1000000000)
+		? format(1000000, 'm')
+		: format(1000000000, 'b');
+}
+
+} // namespace Tele::Titles
diff --git a/Telegram/SourceFiles/tele/tele_title_template.h b/Telegram/SourceFiles/tele/tele_title_template.h
new file mode 100644
index 0000000000000000000000000000000000000000..b226ba5e1026ac14a8561a293e9ddbdbabf405e6
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_title_template.h
@@ -0,0 +1,58 @@
+#pragma once
+
+namespace Tele::Titles {
+
+enum class Tick {
+	None,
+	Minute,
+	Second,
+};
+
+struct Modifier {
+	QString name;
+	QString argument;
+	int number = 0;
+};
+
+struct Token {
+	QString text;
+	QString name;
+	QString format;
+	std::vector<Modifier> modifiers;
+	std::vector<Token> group;
+	bool variable = false;
+	bool optional = false;
+	bool broken = false;
+	bool brief = false;
+};
+
+enum class SpanType {
+	Variable,
+	Invalid,
+	Bracket,
+};
+
+struct Span {
+	int from = 0;
+	int till = 0;
+	SpanType type = SpanType::Variable;
+};
+
+struct Template {
+	std::vector<Token> tokens;
+	std::vector<Span> spans;
+	QStringList errors;
+	Tick tick = Tick::None;
+	bool label = false;
+};
+
+using Resolver = Fn<std::optional<QString>(const Token &token)>;
+
+[[nodiscard]] Template Parse(const QString &source, bool window = false);
+[[nodiscard]] std::optional<QString> Render(
+	const std::vector<Token> &tokens,
+	const Resolver &resolve,
+	bool optional = false);
+[[nodiscard]] QString Compact(const QString &number);
+
+} // namespace Tele::Titles
