index acee3c14ecd9bdb252103aedb276df20999903cb..dc26bb53596c44be863d69d03aa591f2ee500db3 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -150,6 +150,7 @@ extern const char kOptionNoticesMentions[];
 extern const char kOptionSilenceChats[];
 extern const char kOptionMuteFolders[];
 extern const char kOptionVoiceNoFade[];
+extern const char kOptionVoiceQuality[];
 extern const char kOptionConfirmSend[];
 extern const char kOptionConfirmStickers[];
 extern const char kOptionConfirmGifs[];
@@ -446,6 +447,7 @@ void ClearMessageMenuLegacy();
 [[nodiscard]] bool MuteFolders();
 [[nodiscard]] rpl::producer<> MuteFoldersChanges();
 [[nodiscard]] bool VoiceNoFade();
+[[nodiscard]] bool VoiceQuality();
 [[nodiscard]] bool ConfirmStickers();
 [[nodiscard]] bool ConfirmGifs();
 [[nodiscard]] bool ConfirmVoice();
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index 2af5dc78d4673e12493d1b386e09f443d5877667..e26994ee120ed9654ea486370bbd3c16cac0bc04 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
+++ b/Telegram/SourceFiles/tele/tele_settings_io.cpp
@@ -232,6 +232,7 @@ struct Spec {
 		Toggle(kOptionSilenceChats),
 		Toggle(kOptionMuteFolders),
 		Toggle(kOptionVoiceNoFade),
+		Toggle(kOptionVoiceQuality),
 		Toggle(kOptionConfirmSend),
 		Toggle(kOptionConfirmStickers),
 		Toggle(kOptionConfirmGifs),
diff --git a/Telegram/SourceFiles/tele/tele_voice_quality.cpp b/Telegram/SourceFiles/tele/tele_voice_quality.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..65a5cbd228f660b05c6718e8fbbb9f77fb55e03c
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_voice_quality.cpp
@@ -0,0 +1,16 @@
+#include "tele/tele_voice_quality.h"
+
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kHighBitrate = 128000;
+
+} // namespace
+
+int VoiceBitrate(int bitrate) {
+	return VoiceQuality() ? kHighBitrate : bitrate;
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_voice_quality.h b/Telegram/SourceFiles/tele/tele_voice_quality.h
new file mode 100644
index 0000000000000000000000000000000000000000..b069cdc4b91791f9bc110a71c800f9505b638f52
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_voice_quality.h
@@ -0,0 +1,7 @@
+#pragma once
+
+namespace Tele {
+
+[[nodiscard]] int VoiceBitrate(int bitrate);
+
+} // namespace Tele
