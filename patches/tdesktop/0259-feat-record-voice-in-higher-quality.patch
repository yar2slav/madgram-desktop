 Telegram/SourceFiles/tele/tele_settings_io.cpp   |  1 +
 Telegram/SourceFiles/tele/tele_voice_quality.cpp | 16 ++++++++++++++++
 Telegram/SourceFiles/tele/tele_voice_quality.h   |  7 +++++++
 8 files changed, 45 insertions(+), 1 deletion(-)
 create mode 100644 Telegram/SourceFiles/tele/tele_voice_quality.cpp
 create mode 100644 Telegram/SourceFiles/tele/tele_voice_quality.h

diff --git a/Telegram/CMakeLists.txt b/Telegram/CMakeLists.txt
index 3546431f5e3906dedd4ad96ba2e139c4379fa1b2..e2a9403d60ffb2e4b7a6c9fbc4294859d9ade29e 100644
--- a/Telegram/CMakeLists.txt
+++ b/Telegram/CMakeLists.txt
@@ -3010,6 +3010,8 @@ PRIVATE
     tele/tele_view_tl_window.h
     tele/tele_voice_fade.cpp
     tele/tele_voice_fade.h
+    tele/tele_voice_quality.cpp
+    tele/tele_voice_quality.h
     tele/tele_who_reacted.cpp
     tele/tele_who_reacted.h
     tele/tele_who_read.cpp
diff --git a/Telegram/SourceFiles/media/audio/media_audio_capture.cpp b/Telegram/SourceFiles/media/audio/media_audio_capture.cpp
index 72ab6c2e5617622a742d334e40e71b7ab9fb5732..d717833800ae1805b44efc5fa0ca35fe0c3106be 100644
--- a/Telegram/SourceFiles/media/audio/media_audio_capture.cpp
+++ b/Telegram/SourceFiles/media/audio/media_audio_capture.cpp
@@ -13,6 +13,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "ffmpeg/ffmpeg_utility.h"
 #include "base/timer.h"
 #include "tele/tele_voice_fade.h"
+#include "tele/tele_voice_quality.h"
 
 #include <al.h>
 #include <alc.h>
@@ -406,7 +407,7 @@ bool Instance::Inner::initializeFFmpeg() {
 	av_opt_set_int(d->codecContext, "refcounted_frames", 1, 0);
 
 	d->codecContext->sample_fmt = AV_SAMPLE_FMT_FLTP;
-	d->codecContext->bit_rate = 32000;
+	d->codecContext->bit_rate = Tele::VoiceBitrate(32000);
 	d->codecContext->ch_layout = AV_CHANNEL_LAYOUT_MONO;
 	d->channels = d->codecContext->ch_layout.nb_channels;
 	d->codecContext->sample_rate = kCaptureFrequency;
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index f07fce7a830be44e328074f157eab7ff7b7e42ed..bbf81a5a6c343f1776b9bc902ddf3fe2d4620265 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -3209,6 +3209,10 @@ void FillSending(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionVoiceNoFade,
 		{ u"fade"_q, u"record"_q, u"audio"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionVoiceQuality,
+		{ u"bitrate"_q, u"record"_q, u"audio"_q, u"opus"_q });
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionCalcmula,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 1498e98639535c202c83d9be175327b654c63c37..7dcf0039b95bc3fb388a2470b8251e9250f6c503 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -155,6 +155,7 @@ const char kOptionNoticesMentions[] = "tele-notices-mentions";
 const char kOptionSilenceChats[] = "tele-silence-chats";
 const char kOptionMuteFolders[] = "tele-mute-folders";
 const char kOptionVoiceNoFade[] = "tele-voice-no-fade";
+const char kOptionVoiceQuality[] = "tele-voice-quality";
 const char kOptionConfirmSend[] = "tele-confirm-send";
 const char kOptionConfirmStickers[] = "tele-confirm-stickers";
 const char kOptionConfirmGifs[] = "tele-confirm-gifs";
@@ -1149,6 +1150,12 @@ base::options::toggle VoiceNoFadeOption({
 	.description = "Also keeps the first 0.4 seconds, which are cut otherwise.",
 });
 
+base::options::toggle VoiceQualityOption({
+	.id = kOptionVoiceQuality,
+	.name = "Record voice in higher quality",
+	.description = "128 kbps instead of 32, so voice messages are 4 times bigger.",
+});
+
 base::options::toggle ConfirmSendOption({
 	.id = kOptionConfirmSend,
 	.name = "Confirm before sending",
@@ -2711,6 +2718,10 @@ bool VoiceNoFade() {
 	return VoiceNoFadeOption.value();
 }
 
+bool VoiceQuality() {
+	return VoiceQualityOption.value();
+}
+
 bool ConfirmStickers() {
 	return ConfirmSendOption.value() && ConfirmStickersOption.value();
 }
