diff --git a/Telegram/SourceFiles/tele/tele_notices_mentions.cpp b/Telegram/SourceFiles/tele/tele_notices_mentions.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d9d144505d13fe3d1b44fd04a8515e5d119fd617
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_notices_mentions.cpp
@@ -0,0 +1,330 @@
+#include "tele/tele_notices_mentions.h"
+
+#include "apiwrap.h"
+#include "base/unixtime.h"
+#include "data/data_changes.h"
+#include "data/data_forum_topic.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "history/view/history_view_item_preview.h"
+#include "main/main_session.h"
+#include "tele/tele_ignored.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_notices.h"
+#include "tele/tele_options.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kEditWindow = TimeId(120);
+
+struct State {
+	base::flat_set<FullMsgId> logged;
+};
+
+struct Target {
+	not_null<PeerData*> chat;
+	MsgId msg = 0;
+	MsgId topic = 0;
+	PeerData *from = nullptr;
+	QString name;
+};
+
+[[nodiscard]] bool Enabled() {
+	return NoticesCentre() && NoticesMentions();
+}
+
+[[nodiscard]] QString Key(FullMsgId id) {
+	return u"mention:%1:%2"_q.arg(id.peer.value).arg(id.msg.bare);
+}
+
+[[nodiscard]] PeerId PeerFromNotice(uint64 value) {
+	return PeerId(PeerIdHelper(value));
+}
+
+[[nodiscard]] bool GroupPeer(not_null<PeerData*> peer) {
+	return peer->isChat() || (peer->isMegagroup() && !peer->isMonoforum());
+}
+
+[[nodiscard]] bool RepliesToSelf(not_null<HistoryItem*> item) {
+	const auto reply = item->Get<HistoryMessageReply>();
+	const auto to = reply ? reply->resolvedMessage.get() : nullptr;
+	if (!to
+		|| (item->history()->isForum() && to->id == item->topicRootId())) {
+		return false;
+	}
+	return to->out() || to->from()->isSelf();
+}
+
+[[nodiscard]] bool TextMentionsSelf(not_null<HistoryItem*> item) {
+	const auto self = item->history()->session().user();
+	const auto &text = item->originalText();
+	for (const auto &entity : text.entities) {
+		if (entity.type() == EntityType::MentionName) {
+			const auto fields = TextUtilities::MentionNameDataToFields(
+				entity.data());
+			if (fields.userId == peerToUser(self->id).bare) {
+				return true;
+			}
+		} else if (entity.type() == EntityType::Mention
+			&& entity.length() > 1) {
+			const auto name = QStringView(text.text).mid(
+				entity.offset() + 1,
+				entity.length() - 1);
+			for (const auto &username : self->usernames()) {
+				if (!name.compare(username, Qt::CaseInsensitive)) {
+					return true;
+				}
+			}
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] std::optional<Target> TargetOf(not_null<HistoryItem*> item) {
+	if (item->out()
+		|| item->isService()
+		|| item->isSponsored()
+		|| !item->isRegular()) {
+		return std::nullopt;
+	}
+	const auto history = item->history();
+	const auto peer = history->peer;
+	if (peer->isRepliesChat()) {
+		const auto forwarded = item->Get<HistoryMessageForwarded>();
+		if (!forwarded
+			|| !forwarded->savedFromPeer
+			|| !forwarded->savedFromMsgId) {
+			return std::nullopt;
+		}
+		const auto from = forwarded->originalSender;
+		const auto info = forwarded->originalHiddenSenderInfo.get();
+		if (from && (from->isSelf() || IsIgnored(from))) {
+			return std::nullopt;
+		}
+		return Target{
+			.chat = forwarded->savedFromPeer,
+			.msg = forwarded->savedFromMsgId,
+			.from = from,
+			.name = from ? from->name() : info ? info->name : QString(),
+		};
+	} else if (!GroupPeer(peer)) {
+		return std::nullopt;
+	}
+	const auto from = item->from();
+	if (from->isSelf()) {
+		return std::nullopt;
+	}
+	return Target{
+		.chat = peer,
+		.msg = item->id,
+		.topic = history->isForum() ? item->topicRootId() : MsgId(),
+		.from = from,
+		.name = from->name(),
+	};
+}
+
+[[nodiscard]] bool Qualifies(not_null<HistoryItem*> item) {
+	return !IgnoredItem(item)
+		&& (item->history()->peer->isRepliesChat()
+			|| item->mentionsMe()
+			|| RepliesToSelf(item)
+			|| TextMentionsSelf(item));
+}
+
+[[nodiscard]] TextWithEntities Preview(not_null<HistoryItem*> item) {
+	return item->toPreview({
+		.hideSender = true,
+		.generateImages = false,
+	}).text;
+}
+
+[[nodiscard]] QString Title(const Target &target) {
+	auto chat = target.chat->name();
+	if (target.topic) {
+		if (const auto topic = target.chat->forumTopicFor(target.topic)) {
+			chat += u" \u203A "_q + topic->title();
+		}
+	}
+	return target.name.isEmpty()
+		? chat
+		: Lower(u"%1 in %2"_q).arg(target.name, chat);
+}
+
+[[nodiscard]] bool ItemRead(not_null<HistoryItem*> item) {
+	if (item->mentionsMe() && !item->isUnreadMention()) {
+		return true;
+	} else if (const auto topic = item->topic()) {
+		return !item->unread(topic);
+	}
+	return !item->unread(item->history());
+}
+
+void CheckRead(not_null<Main::Session*> session, PeerId peer) {
+	auto read = std::vector<uint64>();
+	const auto history = session->data().historyLoaded(peer);
+	for (const auto &notice : Notices(session)) {
+		if (notice.kind != NoticeKind::Mention || !notice.unread) {
+			continue;
+		}
+		const auto source = notice.source ? notice.source : notice.peer;
+		if (PeerFromNotice(source) != peer) {
+			continue;
+		}
+		const auto msg = MsgId(notice.source ? notice.sourceMsg : notice.msg);
+		if (const auto item = session->data().message(peer, msg)) {
+			if (ItemRead(item)) {
+				read.push_back(notice.id);
+			}
+		} else if (history
+			&& !history->isForum()
+			&& history->inboxReadTillKnown()
+			&& history->inboxReadTillId() >= msg) {
+			read.push_back(notice.id);
+		}
+	}
+	for (const auto id : read) {
+		MarkNoticeRead(session, id);
+	}
+}
+
+void Log(
+		not_null<Main::Session*> session,
+		not_null<State*> state,
+		not_null<HistoryItem*> item,
+		TimeId date) {
+	const auto target = TargetOf(item);
+	if (!target || !Qualifies(item)) {
+		return;
+	}
+	const auto id = FullMsgId(target->chat->id, target->msg);
+	const auto key = Key(id);
+	if (!state->logged.emplace(id).second || FindNotice(session, key)) {
+		return;
+	}
+	const auto source = item->history()->peer;
+	const auto external = (source != target->chat);
+	Notify(session, {
+		.kind = NoticeKind::Mention,
+		.date = date,
+		.key = key,
+		.title = Title(*target),
+		.text = Preview(item),
+		.peer = target->chat->id.value,
+		.from = target->from ? target->from->id.value : 0,
+		.msg = target->msg.bare,
+		.topic = target->topic.bare,
+		.source = external ? source->id.value : 0,
+		.sourceMsg = external ? item->id.bare : 0,
+	});
+	CheckRead(session, source->id);
+}
+
+void Edited(
+		not_null<Main::Session*> session,
+		not_null<State*> state,
+		not_null<HistoryItem*> item) {
+	const auto target = TargetOf(item);
+	if (!target) {
+		return;
+	}
+	const auto id = FullMsgId(target->chat->id, target->msg);
+	if (const auto notice = FindNotice(session, Key(id))) {
+		SetNoticeText(session, notice->id, Preview(item));
+		return;
+	}
+	const auto edited = item->Get<HistoryMessageEdited>();
+	if (!edited
+		|| edited->date < base::unixtime::now() - kEditWindow
+		|| state->logged.contains(id)) {
+		return;
+	}
+	Log(session, state, item, edited->date);
+}
+
+} // namespace
+
+void SetupNoticeMentions(not_null<Main::Session*> session) {
+	const auto state = session->lifetime().make_state<State>();
+	session->data().newItemAdded(
+	) | rpl::filter([](const auto &) {
+		return Enabled();
+	}) | rpl::on_next([=](not_null<HistoryItem*> item) {
+		Log(session, state, item, item->date());
+	}, session->lifetime());
+
+	session->changes().messageUpdates(
+		Data::MessageUpdate::Flag::Edited
+	) | rpl::filter([](const auto &) {
+		return Enabled();
+	}) | rpl::on_next([=](const Data::MessageUpdate &update) {
+		Edited(session, state, update.item);
+	}, session->lifetime());
+
+	using HistoryFlag = Data::HistoryUpdate::Flag;
+	session->changes().historyUpdates(
+		HistoryFlag::UnreadView | HistoryFlag::UnreadMentions
+	) | rpl::filter([](const auto &) {
+		return Enabled();
+	}) | rpl::on_next([=](const Data::HistoryUpdate &update) {
+		CheckRead(session, update.history->peer->id);
+	}, session->lifetime());
+
+	using TopicFlag = Data::TopicUpdate::Flag;
+	session->changes().topicUpdates(
+		TopicFlag::UnreadView | TopicFlag::UnreadMentions
+	) | rpl::filter([](const auto &) {
+		return Enabled();
+	}) | rpl::on_next([=](const Data::TopicUpdate &update) {
+		CheckRead(session, update.topic->peer()->id);
+	}, session->lifetime());
+}
+
+void ShowMentionNotice(
+		not_null<Window::SessionController*> controller,
+		const Notice &notice) {
+	const auto session = &controller->session();
+	const auto peer = session->data().peer(PeerFromNotice(notice.peer));
+	const auto msg = MsgId(notice.msg);
+	const auto root = MsgId(notice.topic);
+	const auto external = (notice.source != 0);
+	const auto show = [=](not_null<Window::SessionController*> controller) {
+		const auto way = Window::SectionShow::Way::Forward;
+		const auto item = session->data().message(peer, msg);
+		const auto thread = (external && item) ? item->replyToTop() : 0;
+		if (item && item->topic()) {
+			controller->showMessage(item, way);
+		} else if (const auto topic = root
+				? peer->forumTopicFor(root)
+				: nullptr) {
+			controller->showTopic(topic, msg, way);
+		} else if (thread) {
+			controller->showRepliesForMessage(
+				item->history(),
+				thread,
+				msg,
+				way);
+		} else if (item) {
+			controller->showMessage(item, way);
+		} else {
+			controller->showPeerHistory(peer->id, way, msg);
+		}
+	};
+	if (external && !session->data().message(peer, msg)) {
+		const auto weak = base::make_weak(controller);
+		session->api().requestMessageData(peer, msg, [=] {
+			if (const auto strong = weak.get()) {
+				show(strong);
+			}
+		});
+	} else {
+		show(controller);
+	}
+}
+
+} // namespace Tele
