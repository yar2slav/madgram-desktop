+	LogTeleToast(TeleToastSessionOf(target), QString(), text, where);
+	if constexpr (requires { target->showToast(std::move(text), duration); }) {
+		return target->showToast(std::move(text), duration);
+	} else {
+		return Ui::Toast::Show(target, Ui::Toast::Config{
+			.text = std::move(text),
+			.duration = duration ? duration : Ui::Toast::kDefaultDuration,
+		});
