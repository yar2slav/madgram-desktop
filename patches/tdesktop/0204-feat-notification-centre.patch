@@ -0,0 +1,478 @@
+#include "tele/tele_rate_limits.h"
+
+#include "base/timer.h"
+#include "base/unixtime.h"
+#include "dialogs/suggestions/suggestion.h"
+#include "dialogs/ui/dialogs_top_bar_suggestion_content.h"
