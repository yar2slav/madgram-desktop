+#include "tele/tele_options.h"
+#include "ui/toast/toast.h"
+#include "ui/widgets/labels.h"
+#include "window/window_session_controller.h"
+
+#include <QtCore/QRegularExpression>
+
+namespace Tele {
+namespace {
+
+constexpr auto kToastFrom = 5;
+constexpr auto kBarFrom = 60;
+constexpr auto kExpiryToastFrom = 30;
+constexpr auto kToastDuration = 10 * crl::time(1000);
+constexpr auto kEpisodeGap = 60 * crl::time(1000);
+constexpr auto kResendSlack = crl::time(1000);
+constexpr auto kTick = crl::time(250);
+
+enum class Action : uchar {
+	Send,
+	React,
+	Join,
+	Search,
+	Contacts,
+	Payment,
+	Other,
+};
+
+struct Limit {
+	QString key;
+	Action action = Action::Other;
+	QString episode;
+	crl::time started = 0;
+	crl::time deadline = 0;
+	base::flat_set<mtpRequestId> requests;
+	base::weak_ptr<Ui::Toast::Instance> toast;
+	QPointer<Ui::FlatLabel> label;
+	QString shown;
+	bool dismissed = false;
+};
+
+struct Ended {
+	QString episode;
+	crl::time at = 0;
+};
+
+struct BarState {
+	QString title;
+	QString text;
+};
+
+[[nodiscard]] Action Classify(mtpTypeId request) {
+	switch (request) {
+	case mtpc_messages_sendMessage:
+	case mtpc_messages_sendMedia:
+	case mtpc_messages_sendMultiMedia:
+	case mtpc_messages_forwardMessages:
+	case mtpc_messages_sendInlineBotResult:
+		return Action::Send;
+	case mtpc_messages_sendReaction:
+	case mtpc_messages_sendPaidReaction:
+	case mtpc_stories_sendReaction:
+		return Action::React;
+	case mtpc_channels_joinChannel:
+	case mtpc_messages_importChatInvite:
+		return Action::Join;
+	case mtpc_contacts_search:
+	case mtpc_messages_search:
+	case mtpc_messages_searchGlobal:
+	case mtpc_contacts_resolveUsername:
+		return Action::Search;
+	case mtpc_contacts_importContacts:
+	case mtpc_contacts_addContact:
+		return Action::Contacts;
+	case mtpc_payments_getPaymentForm:
+	case mtpc_payments_sendPaymentForm:
+	case mtpc_payments_sendStarsForm:
+		return Action::Payment;
+	}
+	return Action::Other;
+}
+
+[[nodiscard]] QString Duration(int seconds) {
+	if (seconds >= 3600) {
+		const auto minutes = (seconds % 3600) / 60;
+		return minutes
+			? Lower(u"%1 h %2 m"_q).arg(seconds / 3600).arg(minutes)
+			: Lower(u"%1 h"_q).arg(seconds / 3600);
+	} else if (seconds >= 60) {
+		const auto rest = seconds % 60;
+		return rest
+			? Lower(u"%1 m %2 s"_q).arg(seconds / 60).arg(rest)
+			: Lower(u"%1 m"_q).arg(seconds / 60);
+	}
+	return Lower(u"%1 s"_q).arg(seconds);
+}
+
+[[nodiscard]] int Seconds(crl::time ms) {
+	return int((std::max(ms, crl::time()) + 999) / 1000);
+}
+
+[[nodiscard]] QString Limited(const Limit &limit) {
+	switch (limit.action) {
+	case Action::Send: return Lower(u"Sending is limited"_q);
+	case Action::React: return Lower(u"Reacting is limited"_q);
+	case Action::Join: return Lower(u"Joining chats is limited"_q);
+	case Action::Search: return Lower(u"Search is limited"_q);
+	case Action::Contacts: return Lower(u"Importing contacts is limited"_q);
+	case Action::Payment: return Lower(u"Payments are limited"_q);
+	case Action::Other: break;
+	}
+	Unexpected("Action in Tele::Limited.");
+}
+
+[[nodiscard]] QString Again(const Limit &limit) {
+	switch (limit.action) {
+	case Action::Send: return Lower(u"You can send again"_q);
+	case Action::React: return Lower(u"You can react again"_q);
+	case Action::Join: return Lower(u"You can join chats again"_q);
+	case Action::Search: return Lower(u"You can search again"_q);
+	case Action::Contacts: return Lower(u"You can import contacts again"_q);
+	case Action::Payment: return Lower(u"You can pay again"_q);
+	case Action::Other: break;
+	}
+	Unexpected("Action in Tele::Again.");
+}
+
+[[nodiscard]] QString Countdown(const Limit &limit, crl::time now) {
+	return Lower(u"%1 for %2"_q).arg(
+		Limited(limit),
+		Duration(Seconds(limit.deadline - now)));
+}
+
+[[nodiscard]] Ui::FlatLabel *FindLabel(not_null<QWidget*> widget) {
+	for (const auto child : widget->children()) {
+		if (const auto label = dynamic_cast<Ui::FlatLabel*>(child)) {
+			return label;
+		} else if (const auto inner = qobject_cast<QWidget*>(child)) {
+			if (const auto result = FindLabel(inner)) {
+				return result;
+			}
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] bool Enabled() {
+	return NoticesCentre() && NoticesLimits();
+}
+
+class RateLimits final {
+public:
+	explicit RateLimits(not_null<Main::Session*> session);
+	~RateLimits();
+
+	[[nodiscard]] static RateLimits *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] rpl::producer<> barChanges() const;
+	[[nodiscard]] std::optional<BarState> bar() const;
+	[[nodiscard]] rpl::producer<std::optional<BarState>> barValue() const;
+	void dismissBar();
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<RateLimits*>> &Registry();
+
+	void wait(const FloodWait &event);
+	void resent(const FloodWait &event);
+	void tick();
+	void finish(const Limit &limit);
+	void log(const Limit &limit);
+	void toast(Limit &limit, crl::time now);
+
+	const not_null<Main::Session*> _session;
+	std::vector<Limit> _limits;
+	base::flat_map<QString, Ended> _ended;
+	base::Timer _timer;
+	rpl::event_stream<> _barChanges;
+	rpl::event_stream<> _barTicks;
+	rpl::lifetime _lifetime;
+
+};
+
+RateLimits::RateLimits(not_null<Main::Session*> session)
+: _session(session)
+, _timer([=] { tick(); }) {
+	Registry().emplace(session, this);
+	session->mtp().teleFloodWaits(
+	) | rpl::on_next([=](const FloodWait &event) {
+		if (event.resent) {
+			resent(event);
+		} else {
+			wait(event);
+		}
+	}, _lifetime);
+}
+
+RateLimits::~RateLimits() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<RateLimits*>> &RateLimits::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<RateLimits*>>();
+	return result;
+}
+
+RateLimits *RateLimits::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+rpl::producer<> RateLimits::barChanges() const {
+	return _barChanges.events();
+}
+
+std::optional<BarState> RateLimits::bar() const {
+	if (!Enabled()) {
+		return std::nullopt;
+	}
+	const auto now = crl::now();
+	const Limit *best = nullptr;
+	for (const auto &limit : _limits) {
+		if (limit.dismissed
+			|| limit.deadline <= now
+			|| limit.deadline - limit.started < kBarFrom * crl::time(1000)) {
+			continue;
+		} else if (!best || limit.deadline > best->deadline) {
+			best = &limit;
+		}
+	}
+	if (!best) {
+		return std::nullopt;
+	}
+	return BarState{
+		.title = Limited(*best),
+		.text = Lower(u"%1 left"_q).arg(
+			Duration(Seconds(best->deadline - now))),
+	};
+}
+
+rpl::producer<std::optional<BarState>> RateLimits::barValue() const {
+	return rpl::single(rpl::empty) | rpl::then(
+		rpl::merge(_barTicks.events(), _barChanges.events())
+	) | rpl::map([=] {
+		return bar();
+	});
+}
+
+void RateLimits::dismissBar() {
+	for (auto &limit : _limits) {
+		limit.dismissed = true;
+	}
+	_barChanges.fire({});
+}
+
+void RateLimits::wait(const FloodWait &event) {
+	if (!Enabled() || event.seconds <= 0) {
+		return;
+	}
+	const auto action = Classify(event.request);
+	if (action == Action::Other) {
+		return;
+	}
+	const auto key = QString::number(int(action));
+	const auto now = crl::now();
+	const auto deadline = now + event.seconds * crl::time(1000);
+	auto i = ranges::find(_limits, key, &Limit::key);
+	if (i == end(_limits)) {
+		const auto ended = _ended.find(key);
+		const auto recent = (ended != end(_ended))
+			&& (now - ended->second.at < kEpisodeGap);
+		_limits.push_back({
+			.key = key,
+			.action = action,
+			.episode = (recent
+				? ended->second.episode
+				: QString::number(base::unixtime::now())),
+			.started = now,
+			.deadline = deadline,
+		});
+		if (ended != end(_ended)) {
+			_ended.erase(ended);
+		}
+		i = end(_limits) - 1;
+	} else if (deadline > i->deadline) {
+		i->deadline = deadline;
+	}
+	if (event.requestId) {
+		i->requests.emplace(event.requestId);
+	}
+	log(*i);
+	const auto wait = i->deadline - i->started;
+	if (wait >= kToastFrom * crl::time(1000)) {
+		toast(*i, now);
+	}
+	if (wait >= kBarFrom * crl::time(1000)) {
+		_barChanges.fire({});
+	}
+	if (!_timer.isActive()) {
+		_timer.callEach(kTick);
+	}
+}
+
+void RateLimits::resent(const FloodWait &event) {
+	const auto i = ranges::find_if(_limits, [&](const Limit &limit) {
+		return limit.requests.contains(event.requestId);
+	});
+	if (i == end(_limits)) {
+		return;
+	}
+	i->requests.remove(event.requestId);
+	if (crl::now() + kResendSlack >= i->deadline) {
+		const auto limit = std::move(*i);
+		_limits.erase(i);
+		finish(limit);
+	}
+}
+
+void RateLimits::tick() {
+	const auto now = crl::now();
+	auto finished = std::vector<Limit>();
+	for (auto i = begin(_limits); i != end(_limits);) {
+		if (now >= i->deadline) {
+			finished.push_back(std::move(*i));
+			i = _limits.erase(i);
+			continue;
+		}
+		if (i->label && i->toast.get()) {
+			auto text = Countdown(*i, now);
+			if (i->shown != text) {
+				i->shown = std::move(text);
+				i->label->setText(i->shown);
+			}
+		}
+		++i;
+	}
+	for (const auto &limit : finished) {
+		finish(limit);
+	}
+	if (_limits.empty()) {
+		_timer.cancel();
+	}
+	_barTicks.fire({});
+}
+
+void RateLimits::finish(const Limit &limit) {
+	const auto now = crl::now();
+	_ended[limit.key] = Ended{ .episode = limit.episode, .at = now };
+	if (const auto strong = limit.toast.get()) {
+		strong->hideAnimated();
+	}
+	_barChanges.fire({});
+	if (!Enabled()) {
+		return;
+	}
+	const auto total = Seconds(limit.deadline - limit.started);
+	Notify(_session, {
+		.kind = NoticeKind::Limit,
+		.key = u"limit-end:"_q + limit.episode + ':' + limit.key,
+		.title = Again(limit),
+		.text = { Lower(u"After %1"_q).arg(Duration(total)) },
+	});
+	if (total >= kExpiryToastFrom) {
+		if (const auto window = _session->tryResolveWindow()) {
+			window->showToast(Again(limit));
+		}
+	}
+}
+
+void RateLimits::log(const Limit &limit) {
+	Notify(_session, {
+		.kind = NoticeKind::Limit,
+		.key = u"limit:"_q + limit.episode + ':' + limit.key,
+		.title = Limited(limit),
+		.text = { Lower(u"For %1"_q).arg(
+			Duration(Seconds(limit.deadline - limit.started))) },
+	});
+}
+
+void RateLimits::toast(Limit &limit, crl::time now) {
+	if (limit.toast.get()) {
+		return;
+	}
+	const auto window = _session->tryResolveWindow();
+	if (!window) {
+		return;
+	}
+	limit.shown = Countdown(limit, now);
+	limit.toast = window->showToast(Ui::Toast::Config{
+		.text = { limit.shown },
+		.duration = std::min(limit.deadline - now, kToastDuration),
+	});
+	if (const auto strong = limit.toast.get()) {
+		limit.label = FindLabel(strong->widget());
+	}
+}
+
+} // namespace
+
+int FloodWaitSeconds(const QString &error) {
+	static const auto expression = QRegularExpression(
+		u"^(?:FLOOD_WAIT|FLOOD_PREMIUM_WAIT|SLOWMODE_WAIT)_(\\d+)$"_q);
+	const auto match = expression.match(error);
+	return match.hasMatch() ? match.captured(1).toInt() : -1;
+}
+
+void SetupRateLimits(not_null<Main::Session*> session) {
+	session->lifetime().make_state<RateLimits>(session);
+}
+
+rpl::producer<> RateLimitBarChanges(not_null<Main::Session*> session) {
+	const auto limits = RateLimits::Find(session);
+	return limits ? limits->barChanges() : rpl::never<>();
+}
+
+Dialogs::TopBarSuggestions::Spec MakeRateLimitSpec() {
+	using namespace Dialogs::TopBarSuggestions;
+	using RightIcon = Dialogs::TopBarSuggestionContent::RightIcon;
+	return {
+		.priority = Priority(int(Priority::UnreviewedAuth) + 1),
+		.available = [](const Context &context) {
+			const auto limits = RateLimits::Find(context.session);
+			return limits && limits->bar().has_value();
+		},
+		.activate = [](ActivateArgs args) {
+			const auto session = args.context.session;
+			const auto limits = RateLimits::Find(session);
+			if (!limits) {
+				return;
+			}
+			const auto content = args.context.ensureContent();
+			const auto findController = args.context.findController;
+			const auto recompute = args.recompute;
+			content->setRightIcon(RightIcon::Close);
+			content->setLeadingWidget(nullptr);
+			content->setClickedCallback([=] {
+				ShowNotices(findController());
+			});
+			content->setHideCallback([=] {
+				if (const auto limits = RateLimits::Find(session)) {
+					limits->dismissBar();
+				}
+				recompute();
+			});
+			limits->barValue(
+			) | rpl::on_next([=](const std::optional<BarState> &state) {
+				if (!state) {
+					recompute();
+					return;
+				}
+				content->setContent({ state->title }, { state->text });
+			}, *args.lifetime);
+			args.done(content, [content] {
+				content->prepareCollapseSnapshot();
+			});
+		},
+	};
+}
+
+} // namespace Tele
