+constexpr auto kRefreshTimeAgo = 30 * crl::time(1000);
+constexpr auto kPhotoMaxHeight = 240;
+constexpr auto kIconSize = 36;
+constexpr auto kButtonSkip = 6;
+
+enum class Filter : uchar {
+	All,
+	Limits,
+	Server,
+	Tele,
+};
+
+[[nodiscard]] QString FilterId(Filter filter) {
+	switch (filter) {
+	case Filter::All: return u"all"_q;
+	case Filter::Limits: return u"limits"_q;
+	case Filter::Server: return u"server"_q;
+	case Filter::Tele: return u"tele"_q;
+	}
+	Unexpected("Filter in Tele::FilterId.");
+}
+
+[[nodiscard]] Filter FilterFromId(const QString &id) {
+	for (const auto filter : {
+			Filter::All,
+			Filter::Limits,
+			Filter::Server,
+			Filter::Tele }) {
+		if (FilterId(filter) == id) {
+			return filter;
+		}
+	}
+	return Filter::All;
+}
+
+[[nodiscard]] bool Matches(Filter filter, NoticeKind kind) {
+	switch (filter) {
+	case Filter::All: return true;
+	case Filter::Limits: return (kind == NoticeKind::Limit);
+	case Filter::Server: return (kind == NoticeKind::Server);
+	case Filter::Tele: return (kind != NoticeKind::Limit)
+		&& (kind != NoticeKind::Server);
+	}
+	Unexpected("Filter in Tele::Matches.");
+}
+
+[[nodiscard]] const style::icon &KindIcon(NoticeKind kind) {
+	switch (kind) {
+	case NoticeKind::Limit: return st::menuIconTimer;
+	case NoticeKind::Server: return st::menuIconInfo;
+	case NoticeKind::Tele: return st::menuIconNotifications;
+	case NoticeKind::Update: return st::menuIconDownload;
+	case NoticeKind::Crash: return st::menuIconReport;
+	case NoticeKind::Online: return st::menuIconUserShow;
+	}
+	Unexpected("Kind in Tele::KindIcon.");
+}
+
+[[nodiscard]] const style::color &KindColor(const Notice &notice) {
+	switch (notice.tone) {
+	case NoticeTone::Info: return st::settingsIconBg4;
+	case NoticeTone::Success: return st::settingsIconBg2;
+	case NoticeTone::Warning: return st::settingsIconBg3;
+	case NoticeTone::Critical: return st::settingsIconBg1;
+	case NoticeTone::None: break;
+	}
+	switch (notice.kind) {
+	case NoticeKind::Limit: return st::settingsIconBg8;
+	case NoticeKind::Server: return st::settingsIconBg4;
+	case NoticeKind::Tele: return st::settingsIconBg5;
+	case NoticeKind::Update: return st::settingsIconBg2;
+	case NoticeKind::Crash: return st::settingsIconBg1;
+	case NoticeKind::Online: return st::settingsIconBg6;
+	}
+	Unexpected("Kind in Tele::KindColor.");
+}
+
+[[nodiscard]] QString TimeAgo(TimeId date) {
+	const auto now = base::unixtime::now();
+	const auto seconds = std::max(now - date, 0);
+	if (seconds < 60) {
+		return Lower(u"Just now"_q);
+	} else if (seconds < 3600) {
+		return Lower(u"%1 m ago"_q).arg(seconds / 60);
+	} else if (seconds < 86400) {
+		return Lower(u"%1 h ago"_q).arg(seconds / 3600);
+	}
+	const auto parsed = base::unixtime::parse(date);
+	return QLocale().toString(parsed.date(), QLocale::ShortFormat);
+}
+
+[[nodiscard]] TextWithEntities FullText(const Notice &notice) {
+	auto result = TextWithEntities{ notice.title };
+	if (!notice.text.text.isEmpty()) {
+		if (!result.text.isEmpty()) {
+			result.append('\n');
+		}
+		result.append(notice.text);
+	}
+	return result;
+}
+
+[[nodiscard]] QVariant LinkContext(
+		not_null<Window::SessionController*> controller) {
+	return QVariant::fromValue(ClickHandlerContext{
+		.sessionWindow = base::make_weak(controller),
+	});
+}
+
+class Entry final : public Ui::AbstractButton {
+public:
+	Entry(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller,
+		const Notice &notice,
+		bool fresh);
+
+	void refreshTime();
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+	int resizeGetHeight(int newWidth) override;
+	void contextMenuEvent(QContextMenuEvent *e) override;
+
+private:
+	[[nodiscard]] int left() const;
+	[[nodiscard]] int right() const;
+	void showMenu(Ui::PopupMenu *menu, QPoint globalPosition);
+	void fillMenu(not_null<Ui::PopupMenu*> menu);
+	void activate();
+
+	const not_null<Window::SessionController*> _controller;
+	const Notice _notice;
+	const bool _fresh = false;
+	Ui::Text::String _title;
+	QString _time;
+	int _timeWidth = 0;
+	object_ptr<Ui::FlatLabel> _text = { nullptr };
+	QImage _photo;
+	QImage _photoCache;
+	QRect _photoRect;
+	std::vector<not_null<Ui::RoundButton*>> _buttons;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+
+};
+
+Entry::Entry(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller,
+	const Notice &notice,
+	bool fresh)
+: AbstractButton(parent)
+, _controller(controller)
+, _notice(notice)
+, _fresh(fresh) {
+	const auto session = &controller->session();
+	_title.setText(st::semiboldTextStyle, _notice.title);
+	if (!_notice.text.text.isEmpty()) {
+		_text.create(this, st::defaultFlatLabel, st::popupMenuWithIcons);
+		_text->setMarkedText(
+			_notice.text,
+			Core::TextContext({ .session = session }));
+		_text->setClickHandlerFilter([=](
+				const ClickHandlerPtr &handler,
+				Qt::MouseButton button) {
+			ActivateClickHandler(_text.data(), handler, ClickContext{
+				.button = button,
+				.other = LinkContext(_controller),
+			});
+			return false;
+		});
+		_text->setContextMenuHook([=](Ui::FlatLabel::ContextMenuRequest r) {
+			if (r.link) {
+				_text->fillContextMenu(r);
+				r.menu->addSeparator();
+			}
+			fillMenu(r.menu);
+		});
+	}
+	if (!_notice.photo.isEmpty()) {
+		_photo = NoticePhoto(session, _notice.photo);
+	}
+	for (const auto &button : _notice.buttons) {
+		const auto raw = Ui::CreateChild<Ui::RoundButton>(
+			this,
+			rpl::single(button.text),
+			st::defaultLightButton);
+		raw->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+		const auto url = button.url;
+		raw->setClickedCallback([=] {
+			UrlClickHandler::Open(url, LinkContext(_controller));
+		});
+		_buttons.push_back(raw);
+	}
+	if (_notice.peer
+		|| (_notice.kind == NoticeKind::Update && !_buttons.empty())) {
+		setCursor(style::cur_pointer);
+	}
+	setClickedCallback([=] {
+		activate();
+	});
+	refreshTime();
+}
+
+void Entry::refreshTime() {
+	const auto time = TimeAgo(_notice.date);
+	if (_time != time) {
+		_time = time;
+		_timeWidth = st::normalFont->width(_time);
+		if (_notice.title.isEmpty() && width() > 0) {
+			resizeToWidth(width());
+		}
+		update();
+	}
+}
+
+int Entry::left() const {
+	return st::boxRowPadding.left()
+		+ style::ConvertScale(kIconSize)
+		+ st::boxRowPadding.left();
+}
+
+int Entry::right() const {
+	return st::boxRowPadding.right();
+}
+
+int Entry::resizeGetHeight(int newWidth) {
+	const auto padding = st::boxRowPadding.left() / 2;
+	const auto available = std::max(newWidth - left() - right(), 1);
+	auto top = padding;
+	if (!_notice.title.isEmpty()) {
+		top += st::semiboldFont->height;
+	}
+	if (_text) {
+		const auto skip = _notice.title.isEmpty()
+			? (_timeWidth + st::boxRowPadding.right() / 2)
+			: 0;
+		_text->resizeToWidth(std::max(available - skip, 1));
+		_text->moveToLeft(left(), top, newWidth);
+		top += _text->height();
+	}
+	_photoRect = QRect();
+	if (!_photo.isNull()) {
+		top += padding;
+		const auto maxHeight = style::ConvertScale(kPhotoMaxHeight);
+		const auto size = _photo.size().scaled(
+			available,
+			maxHeight,
+			Qt::KeepAspectRatio);
+		_photoRect = QRect(left(), top, size.width(), size.height());
+		top += size.height();
+	}
+	if (!_buttons.empty()) {
+		top += padding / 2;
+		const auto skip = style::ConvertScale(kButtonSkip);
+		auto x = left() - st::defaultLightButton.padding.left();
+		auto height = 0;
+		for (const auto button : _buttons) {
+			button->moveToLeft(x, top, newWidth);
+			x += button->width() + skip;
+			height = std::max(height, button->height());
+		}
+		top += height;
+	}
+	return std::max(
+		top + padding,
+		padding * 2 + style::ConvertScale(kIconSize));
+}
+
+void Entry::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	if (_fresh) {
+		p.fillRect(rect(), st::windowBgOver);
+	}
+	const auto padding = st::boxRowPadding.left() / 2;
+	const auto size = style::ConvertScale(kIconSize);
+	const auto iconLeft = st::boxRowPadding.left();
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(KindColor(_notice));
+		p.drawEllipse(iconLeft, padding, size, size);
+	}
+	const auto &icon = KindIcon(_notice.kind);
+	icon.paint(
+		p,
+		iconLeft + (size - icon.width()) / 2,
+		padding + (size - icon.height()) / 2,
+		width(),
+		st::settingsIconFg->c);
+
+	const auto available = width() - left() - right();
+	const auto titleWidth = std::max(
+		available - _timeWidth - st::boxRowPadding.right() / 2,
+		0);
+	p.setPen(st::windowBoldFg);
+	_title.draw(p, {
+		.position = { left(), padding },
+		.outerWidth = width(),
+		.availableWidth = titleWidth,
+		.elisionLines = 1,
+	});
+	const auto timeTop = _notice.title.isEmpty()
+		? padding
+		: (padding
+			+ (st::semiboldFont->height - st::normalFont->height) / 2);
+	p.setPen(st::windowSubTextFg);
+	p.setFont(st::normalFont);
+	p.drawTextLeft(
+		width() - right() - _timeWidth,
+		timeTop,
+		width(),
+		_time,
+		_timeWidth);
+
+	if (!_photoRect.isEmpty()) {
+		const auto ratio = style::DevicePixelRatio();
+		if (_photoCache.size() != _photoRect.size() * ratio) {
+			_photoCache = _photo.scaled(
+				_photoRect.size() * ratio,
+				Qt::IgnoreAspectRatio,
+				Qt::SmoothTransformation);
+			_photoCache.setDevicePixelRatio(ratio);
+		}
+		auto hq = PainterHighQualityEnabler(p);
+		auto path = QPainterPath();
+		path.addRoundedRect(
+			_photoRect,
+			st::roundRadiusLarge,
+			st::roundRadiusLarge);
+		p.setClipPath(path);
+		p.drawImage(_photoRect, _photoCache);
+		p.setClipping(false);
+	}
+}
+
+void Entry::contextMenuEvent(QContextMenuEvent *e) {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	fillMenu(_menu.get());
+	_menu->popup(e->globalPos());
+}
+
+void Entry::fillMenu(not_null<Ui::PopupMenu*> menu) {
+	const auto text = FullText(_notice);
+	menu->addAction(Lower(u"Copy"_q), [=] {
+		TextUtilities::SetClipboardText(TextForMimeData::Rich(
+			base::duplicate(text)));
+	}, &st::menuIconCopy);
+	const auto session = &_controller->session();
+	const auto id = _notice.id;
+	menu->addAction(Lower(u"Delete"_q), [=] {
+		crl::on_main(session, [=] {
+			RemoveNotice(session, id);
+		});
+	}, &st::menuIconDelete);
+}
+
+void Entry::activate() {
+	if (_notice.peer) {
+		_controller->showPeerHistory(
+			PeerId(PeerIdHelper(_notice.peer)),
+			Window::SectionShow::Way::Forward);
+	} else if (_notice.kind == NoticeKind::Update && !_buttons.empty()) {
+		UrlClickHandler::Open(
+			_notice.buttons.front().url,
+			LinkContext(_controller));
+	}
+}
+
+class NoticesSection final
+	: public ::Settings::Section<NoticesSection> {
+public:
+	NoticesSection(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller);
+
+	[[nodiscard]] rpl::producer<QString> title() override;
+	void fillTopBarMenu(const Ui::Menu::MenuCallback &addAction) override;
+	base::weak_qptr<Ui::RpWidget> createPinnedToTop(
+		not_null<QWidget*> parent) override;
+
+private:
+	void changed();
+	void rebuild();
+
+	const not_null<Main::Session*> _session;
+	const not_null<Ui::VerticalLayout*> _content;
+	Filter _filter = Filter::All;
+	base::flat_set<uint64> _fresh;
+	std::vector<uint64> _shown;
+	std::vector<QPointer<Entry>> _entries;
+	base::Timer _timer;
+	bool _built = false;
+
+};
+
+NoticesSection::NoticesSection(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: ::Settings::Section<NoticesSection>(parent, controller)
+, _session(&controller->session())
+, _content(Ui::CreateChild<Ui::VerticalLayout>(this))
+, _timer([=] {
+	for (const auto &entry : _entries) {
+		if (entry) {
+			entry->refreshTime();
+		}
+	}
+}) {
+	Ui::ResizeFitChild(this, _content);
+	_timer.callEach(kRefreshTimeAgo);
+	NoticesChanges(
+		_session
+	) | rpl::on_next([=] {
+		changed();
+	}, lifetime());
+	changed();
+}
+
+rpl::producer<QString> NoticesSection::title() {
+	return rpl::single(Lower(u"Notifications"_q));
+}
+
+void NoticesSection::fillTopBarMenu(
+		const Ui::Menu::MenuCallback &addAction) {
+	if (Notices(_session).empty()) {
+		return;
+	}
+	const auto session = _session;
+	const auto window = controller();
+	addAction({
+		.text = Lower(u"Clear all"_q),
+		.handler = [=] {
+			window->show(Ui::MakeConfirmBox({
+				.text = Lower(u"Clear all notifications?"_q),
+				.confirmed = [=](Fn<void()> close) {
+					ClearNotices(session);
+					close();
+				},
+				.confirmText = Lower(u"Clear"_q),
+				.confirmStyle = &st::attentionBoxButton,
+			}));
+		},
+		.icon = &st::menuIconDeleteAttention,
+		.isAttention = true,
+	});
+}
+
+base::weak_qptr<Ui::RpWidget> NoticesSection::createPinnedToTop(
+		not_null<QWidget*> parent) {
+	const auto wrap = Ui::CreateChild<Ui::VerticalLayout>(parent.get());
+	auto tabs = std::vector<Ui::SubTabs::Tab>();
+	for (const auto &[filter, name] : {
+			std::pair{ Filter::All, u"All"_q },
+			std::pair{ Filter::Limits, u"Limits"_q },
+			std::pair{ Filter::Server, u"Server"_q },
+			std::pair{ Filter::Tele, u"tele"_q } }) {
+		tabs.push_back({
+			.id = FilterId(filter),
+			.text = { Lower(name) },
+		});
+	}
+	const auto subtabs = wrap->add(
+		object_ptr<Ui::SubTabs>(
+			wrap,
+			st::defaultSubTabs,
+			Ui::SubTabs::Options{
+				.selected = FilterId(_filter),
+				.centered = true,
+			},
+			std::move(tabs)),
+		QMargins(0, st::boxRowPadding.left() / 2, 0, 0));
+	subtabs->activated(
+	) | rpl::on_next([=](const QString &id) {
+		subtabs->setActiveTab(id);
+		const auto filter = FilterFromId(id);
+		if (_filter != filter) {
+			_filter = filter;
+			rebuild();
+		}
+	}, subtabs->lifetime());
+	wrap->paintRequest(
+	) | rpl::on_next([=](QRect clip) {
+		QPainter(wrap).fillRect(clip, st::windowBg);
+	}, wrap->lifetime());
+	return base::make_weak(static_cast<Ui::RpWidget*>(wrap));
+}
+
+void NoticesSection::changed() {
+	auto unread = false;
+	auto shown = std::vector<uint64>();
+	for (const auto &notice : Notices(_session)) {
+		if (notice.unread) {
+			_fresh.emplace(notice.id);
+			unread = true;
+		}
+		if (Matches(_filter, notice.kind)) {
+			shown.push_back(notice.id);
+		}
+	}
+	if (!_built || shown != _shown) {
+		rebuild();
+	}
+	if (unread) {
+		crl::on_main(this, [=] {
+			MarkNoticesRead(_session);
+		});
+	}
+}
+
+void NoticesSection::rebuild() {
+	_built = true;
+	_shown.clear();
+	_entries.clear();
+	_content->clear();
+	const auto &list = Notices(_session);
+	for (const auto &notice : list) {
+		if (!Matches(_filter, notice.kind)) {
+			continue;
+		}
+		_shown.push_back(notice.id);
+		_entries.push_back(_content->add(object_ptr<Entry>(
+			_content,
+			controller(),
+			notice,
+			_fresh.contains(notice.id))));
+	}
+	if (_shown.empty()) {
+		_content->add(
+			object_ptr<Ui::FlatLabel>(
+				_content,
+				Lower(list.empty()
+					? u"No notifications yet."_q
+					: u"Nothing here."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding + QMargins(
+				0,
+				st::boxRowPadding.left(),
+				0,
+				st::boxRowPadding.left()),
+			style::al_top);
+	}
+	_content->resizeToWidth(width());
+}
+
+} // namespace
+
+void ShowNotices(not_null<Window::SessionController*> controller) {
+	controller->showSettings(NoticesSection::Id());
+}
+
+} // namespace Tele
