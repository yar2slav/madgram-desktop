+	LogTeleToast(
+		TeleToastSessionOf(target),
+		config.title,
+		config.text,
+		where);
+	if constexpr (requires { target->showToast(std::move(config)); }) {
+		return target->showToast(std::move(config));
+	} else {
+		return Ui::Toast::Show(target, std::move(config));
+	}
