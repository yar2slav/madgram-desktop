 	return _frozenErrorReceived.events();
 }
 
+rpl::producer<Tele::FloodWait> Instance::Private::teleFloodWaits() const {
+	return _teleFloodWaits.events();
+}
+
+void Instance::Private::teleFloodEvent(
+		mtpRequestId requestId,
+		int seconds,
+		bool resent) {
+	if (!requestId || seconds < 0) {
+		return;
+	}
+	auto request = mtpTypeId(0);
+	{
+		QReadLocker locker(&_requestMapLock);
+		const auto i = _requestMap.find(requestId);
+		if (i != _requestMap.cend()
+			&& i->second
+			&& (i->second->size()
+				> SerializedRequest::kMessageBodyPosition)) {
+			request = mtpTypeId((*i->second)[
+				SerializedRequest::kMessageBodyPosition]);
+		}
+	}
+	_teleFloodWaits.fire({
+		.requestId = requestId,
+		.request = request,
+		.seconds = seconds,
+		.resent = resent,
+	});
+}
+
 void Instance::Private::requestConfigIfOld() {
 	const auto timeout = _config->values().blockedMode
 		? kConfigBecomesOldForBlockedIn
@@ -1011,6 +1045,7 @@ void Instance::Private::checkDelayedRequests() {
 		}
 		const auto session = getSession(std::abs(dcWithShift));
 		session->sendPrepared(request);
+		teleFloodEvent(requestId, 0, true);
 	}
 
 	if (!_delayedRequests.empty()) {
@@ -1233,6 +1268,10 @@ bool Instance::Private::rpcErrorOccured(
 		const Response &response,
 		const FailHandler &onFail,
 		const Error &error) { // return true if need to clean request data
+	teleFloodEvent(
+		response.requestId,
+		Tele::FloodWaitSeconds(error.type()),
+		false);
 	if (IsDefaultHandledError(error)) {
 		const auto guard = QPointer<Instance>(_instance);
 		if (onFail && onFail(error, response)) {
@@ -2026,6 +2065,10 @@ rpl::producer<> Instance::frozenErrorReceived() const {
 	return _private->frozenErrorReceived();
 }
 
