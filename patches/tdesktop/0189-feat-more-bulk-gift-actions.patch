+void ShowBatchResult(
+		std::shared_ptr<ChatHelpers::Show> show,
+		int done,
+		int total,
+		const QString &success) {
+	show->showToast((done == total)
+		? success
+		: Lower(u"Stopped after %1 of %2."_q)
+			.arg(done)
+			.arg(GiftsCount(total)));
+}
+
+void RunBatch(
+		not_null<State*> state,
+		QString title,
+		int total,
+		Fn<void(int, Fn<void(bool)>)> step,
+		Fn<void(int)> finished) {
+	state->busy = true;
+	const auto weak = base::make_weak(state->list);
+	const auto progress = std::make_shared<rpl::variable<int>>(0);
+	const auto cancelled = std::make_shared<bool>(false);
+	auto progressBox = base::weak_qptr<Ui::GenericBox>();
+	if (!title.isEmpty()) {
+		auto box = Box([=](not_null<Ui::GenericBox*> box) {
+			box->setTitle(rpl::single(title));
+			box->setCloseByOutsideClick(false);
+			box->addRow(object_ptr<Ui::FlatLabel>(
+				box,
+				progress->value() | rpl::map([=](int done) {
+					return Lower(u"%1 of %2"_q).arg(done + 1).arg(total);
+				}),
+				st::boxLabel));
+			box->addButton(tr::lng_cancel(), [=] {
+				*cancelled = true;
+				box->closeBox();
+			});
+		});
+		progressBox = base::make_weak(box.data());
+		state->window->show(std::move(box));
+	}
+	const auto next = std::make_shared<Fn<void(int)>>();
+	const auto finish = [=](int done) {
+		if (const auto strong = progressBox.get()) {
+			strong->closeBox();
+		}
+		finished(done);
+		FinishFor(weak);
+		*next = nullptr;
+	};
+	*next = [=](int index) {
+		if (index == total || *cancelled) {
+			finish(index);
+			return;
+		}
+		*progress = index;
+		step(index, [=](bool ok) {
+			if (!ok) {
+				finish(index);
+			} else if (const auto onstack = *next) {
+				onstack(index + 1);
+			}
+		});
+	};
+	(*next)(0);
+}
