+ActionButton::ActionButton(QWidget *parent, QString text)
+: RippleButton(parent, st::defaultLightButton.ripple)
+, _text(std::move(text)) {
+	resize(naturalWidth(), st::defaultLightButton.height);
+}
+
+void ActionButton::setReason(QString reason) {
+	if (_reason == reason) {
+		return;
+	}
+	_reason = std::move(reason);
+	setPointerCursor(_reason.isEmpty());
+	if (!_reason.isEmpty()) {
+		finishAnimating();
+	}
+	update();
+}
+
+const QString &ActionButton::reason() const {
+	return _reason;
+}
+
+int ActionButton::naturalWidth() const {
+	return st::semiboldFont->width(_text) + 2 * st::boxPadding.left();
+}
+
+QString ActionButton::tooltipText() const {
+	return _reason;
+}
+
+QPoint ActionButton::tooltipPos() const {
+	return QCursor::pos();
+}
+
+bool ActionButton::tooltipWindowActive() const {
+	return Ui::AppInFocus() && Ui::InFocusChain(window());
+}
+
+void ActionButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto enabled = _reason.isEmpty();
+	if (enabled) {
+		if (isOver() || isDown()) {
+			auto hq = PainterHighQualityEnabler(p);
+			p.setPen(Qt::NoPen);
+			p.setBrush(st::lightButtonBgOver);
+			p.drawRoundedRect(rect(), st::buttonRadius, st::buttonRadius);
+		}
+		paintRipple(p, 0, 0);
+	}
+	p.setFont(st::semiboldFont);
+	p.setPen(enabled ? st::lightButtonFg : st::windowSubTextFg);
+	p.drawText(
+		rect(),
+		st::semiboldFont->elided(_text, width()),
+		style::al_center);
+}
+
+void ActionButton::onStateChanged(State was, StateChangeSource source) {
+	RippleButton::onStateChanged(was, source);
+	const auto wasOver = static_cast<bool>(was & StateFlag::Over);
+	if (wasOver == isOver()) {
+		return;
+	} else if (isOver() && !_reason.isEmpty()) {
+		Ui::Tooltip::Show(300, this);
+	} else if (!isOver()) {
+		Ui::Tooltip::Hide();
+	}
+}
+
+QImage ActionButton::prepareRippleMask() const {
+	return Ui::RippleAnimation::RoundRectMask(size(), st::buttonRadius);
+}
+
+QPoint ActionButton::prepareRippleStartPosition() const {
+	return _reason.isEmpty()
+		? mapFromGlobal(QCursor::pos())
+		: DisabledRippleStartPosition();
+}
