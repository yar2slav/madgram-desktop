+
+void Convert(not_null<State*> state) {
+	const auto gifts = state->selected;
+	const auto weak = base::make_weak(state->list);
+	const auto show = state->window->uiShow();
+	auto stars = int64();
+	for (const auto &gift : gifts) {
+		stars += gift.starsConverted;
+	}
+	const auto total = int(gifts.size());
+	state->window->show(Ui::MakeConfirmBox({
+		.text = Lower(u"Convert %1 to %2 stars? This can't be undone."_q)
+			.arg(GiftsCount(total))
+			.arg(Lang::FormatCountDecimal(stars)),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			StartFor(weak, LocalPasswordAction::ConvertGifts, [=](
+					not_null<State*> state) {
+				RunBatch(state, Lower(u"Converting gifts"_q), total, [=](
+						int index,
+						Fn<void(bool)> done) {
+					const auto &gift = gifts[index];
+					Settings::ConvertSavedStarGift(
+						show,
+						gift.manageId,
+						int(gift.starsConverted),
+						done);
+				}, [=](int done) {
+					ShowBatchResult(
+						show,
+						done,
+						total,
+						Lower(u"%1 converted to %2 stars"_q)
+							.arg(GiftsCount(total))
+							.arg(Lang::FormatCountDecimal(stars)));
+				});
+			});
+		},
+		.confirmText = tr::lng_gift_convert_sure(),
+		.title = Lower(u"Convert to stars"_q),
+	}));
+}
+
+void AddToCollection(
+		not_null<State*> state,
+		int collectionId,
+		QString title) {
+	auto ids = std::vector<Data::SavedStarGiftId>();
+	for (const auto &gift : state->selected) {
+		if (!ranges::contains(gift.collectionIds, collectionId)) {
+			ids.push_back(gift.manageId);
+		}
+	}
+	if (ids.empty()) {
+		return;
+	}
+	state->busy = true;
+	const auto show = state->window->uiShow();
+	const auto session = &state->window->session();
+	const auto peer = state->peer;
+	const auto weak = base::make_weak(state->list);
+	const auto changed = state->collectionChanged;
+	auto inputs = QVector<MTPInputSavedStarGift>();
+	inputs.reserve(ids.size());
+	for (const auto &id : ids) {
+		inputs.push_back(Api::InputSavedStarGiftId(id));
+	}
+	using Flag = MTPpayments_UpdateStarGiftCollection::Flag;
+	session->api().request(MTPpayments_UpdateStarGiftCollection(
+		MTP_flags(Flag::f_add_stargift),
+		peer->input(),
+		MTP_int(collectionId),
+		MTPstring(),
+		MTPVector<MTPInputSavedStarGift>(),
+		MTP_vector<MTPInputSavedStarGift>(std::move(inputs)),
+		MTPVector<MTPInputSavedStarGift>()
+	)).done([=] {
+		session->data().notifyGiftsUpdate({
+			.peer = peer,
+			.collectionId = collectionId,
+			.added = ids,
+		});
+		show->showToast(Lower(u"%1 added to %2"_q)
+			.arg(GiftsCount(int(ids.size())))
+			.arg(title));
+		FinishFor(weak);
+		if (weak.get() && changed) {
+			changed(collectionId);
+		}
+	}).fail([=](const MTP::Error &error) {
+		ShowError(show, error);
+		FinishFor(weak);
+	}).send();
+}
