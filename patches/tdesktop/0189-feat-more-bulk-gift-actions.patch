+enum class Action {
+	Show,
+	Hide,
+	Pin,
+	Unpin,
+	Transfer,
+	Sell,
+	Unlist,
+	Convert,
+	Collection,
+};
+
+constexpr auto kActions = std::array{
+	Action::Show,
+	Action::Hide,
+	Action::Pin,
+	Action::Unpin,
+	Action::Transfer,
+	Action::Sell,
+	Action::Unlist,
+	Action::Convert,
+	Action::Collection,
+};
+
+using Gift = Data::SavedStarGift;
+
+[[nodiscard]] QString ActionName(Action action) {
+	switch (action) {
+	case Action::Show: return Lower(u"Show"_q);
+	case Action::Hide: return Lower(u"Hide"_q);
+	case Action::Pin: return Lower(u"Pin"_q);
+	case Action::Unpin: return Lower(u"Unpin"_q);
+	case Action::Transfer: return tr::lng_gift_transfer_button(tr::now);
+	case Action::Sell: return tr::lng_gift_transfer_sell(tr::now);
+	case Action::Unlist: return Lower(u"Remove from sale"_q);
+	case Action::Convert: return Lower(u"Convert to stars"_q);
+	case Action::Collection: return tr::lng_gift_collection_add_to(tr::now);
+	}
+	Unexpected("Action in ActionName.");
+}
+
+[[nodiscard]] bool CanTransfer(const Gift &gift) {
 	const auto unique = gift.info.unique.get();
-	if (!unique
-		|| !unique->ownerId
-		|| (unique->starsForTransfer < 0)
-		|| (unique->canTransferAt > base::unixtime::now())) {
+	if (!unique || !unique->ownerId || (unique->starsForTransfer < 0)) {
 		return false;
 	}
 	const auto chat = gift.manageId.chat();
 	return chat ? chat->canTransferGifts() : gift.mine;
 }
 
+[[nodiscard]] bool CanSell(const Gift &gift, PeerId self) {
+	const auto unique = gift.info.unique.get();
+	if (!unique || gift.manageId.chat() || !gift.mine) {
+		return false;
+	}
+	const auto host = unique->hostId ? unique->hostId : unique->ownerId;
+	return (unique->ownerId == self) && (host == self);
+}
+
+[[nodiscard]] bool OnSale(const Gift &gift) {
+	const auto unique = gift.info.unique.get();
+	return unique && (unique->starsForResale > 0);
+}
+
+[[nodiscard]] bool CanConvert(const Gift &gift) {
+	if (gift.info.unique || (gift.starsConverted <= 0) || !gift.fromId) {
+		return false;
+	}
+	const auto chat = gift.manageId.chat();
+	return chat ? chat->canTransferGifts() : gift.mine;
+}
+
+[[nodiscard]] QString Problem(
+		const std::vector<Gift> &gifts,
+		Fn<bool(const Gift&)> bad,
+		const QString &one,
+		const QString &many) {
+	const auto count = int(ranges::count_if(gifts, bad));
+	return !count
+		? QString()
+		: (count == 1)
+		? Lower(one)
+		: Lower(many).arg(count);
+}
+
+[[nodiscard]] QString Reason(not_null<State*> state, Action action) {
+	const auto &gifts = state->selected;
+	if (gifts.empty()) {
+		return Lower(u"No gifts selected"_q);
+	}
+	const auto now = base::unixtime::now();
+	const auto session = &state->peer->session();
+	const auto self = session->userPeerId();
+	const auto notUnique = [](const Gift &gift) {
+		return !gift.info.unique;
+	};
+	const auto notCollectible = [&] {
+		return Problem(
+			gifts,
+			notUnique,
+			u"1 gift isn't a collectible"_q,
+			u"%1 gifts aren't collectibles"_q);
+	};
+	auto result = QString();
+	switch (action) {
+	case Action::Show:
+		return ranges::any_of(gifts, &Gift::hidden)
+			? QString()
+			: Lower(u"Selected gifts are already shown"_q);
+	case Action::Hide:
+		return ranges::all_of(gifts, &Gift::hidden)
+			? Lower(u"Selected gifts are already hidden"_q)
+			: QString();
+	case Action::Pin:
+		result = notCollectible();
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				&Gift::hidden,
+				u"1 gift is hidden"_q,
+				u"%1 gifts are hidden"_q);
+		}
+		if (result.isEmpty() && ranges::all_of(gifts, &Gift::pinned)) {
+			result = Lower(u"Selected gifts are already pinned"_q);
+		}
+		return result;
+	case Action::Unpin:
+		return ranges::any_of(gifts, &Gift::pinned)
+			? QString()
+			: Lower(u"No pinned gifts selected"_q);
+	case Action::Transfer:
+		result = notCollectible();
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[](const Gift &gift) { return !CanTransfer(gift); },
+				u"1 gift can't be transferred"_q,
+				u"%1 gifts can't be transferred"_q);
+		}
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[&](const Gift &gift) {
+					return gift.info.unique->canTransferAt > now;
+				},
+				u"1 gift can't be transferred yet"_q,
+				u"%1 gifts can't be transferred yet"_q);
+		}
+		return result;
+	case Action::Sell:
+		result = notCollectible();
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[&](const Gift &gift) { return !CanSell(gift, self); },
+				u"1 gift can't be sold"_q,
+				u"%1 gifts can't be sold"_q);
+		}
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[&](const Gift &gift) {
+					return gift.info.unique->canResellAt > now;
+				},
+				u"1 gift can't be sold yet"_q,
+				u"%1 gifts can't be sold yet"_q);
+		}
+		return result;
+	case Action::Unlist:
+		result = notCollectible();
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[](const Gift &gift) { return !OnSale(gift); },
+				u"1 gift isn't on sale"_q,
+				u"%1 gifts aren't on sale"_q);
+		}
+		return result;
+	case Action::Convert: {
+		const auto period = session->appConfig().stargiftConvertPeriodMax();
+		result = Problem(
+			gifts,
+			[](const Gift &gift) { return gift.info.unique != nullptr; },
+			u"1 gift is a collectible"_q,
+			u"%1 gifts are collectibles"_q);
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[](const Gift &gift) { return !CanConvert(gift); },
+				u"1 gift can't be converted"_q,
+				u"%1 gifts can't be converted"_q);
+		}
+		if (result.isEmpty()) {
+			result = Problem(
+				gifts,
+				[&](const Gift &gift) {
+					return int64(gift.date) + period <= int64(now);
+				},
+				u"1 gift can't be converted anymore"_q,
+				u"%1 gifts can't be converted anymore"_q);
+		}
+		return result;
+	}
+	case Action::Collection:
+		return (state->collections && !state->collections().empty())
+			? QString()
+			: Lower(u"No collections yet"_q);
+	}
+	return result;
+}
