+void FullPreviewWidget::setupTopBar() {
+	using Section = Dialogs::EntryState::Section;
+	_topBar->setActiveChat(
+		TopBarWidget::ActiveChat{
+			.key = Dialogs::Key(_thread),
+			.section = (_sublist
+				? Section::SavedSublist
+				: _replies
+				? Section::Replies
+				: Section::History),
+		},
+		_thread->sendActionPainter());
+	_topBar->move(0, 0);
+	_topBar->resizeToWidth(width());
+	_topBar->show();
+
+	_topBar->searchRequest(
+	) | rpl::on_next([=] {
+		controller()->searchInChat(Dialogs::Key(_thread));
+	}, _topBar->lifetime());
+}
