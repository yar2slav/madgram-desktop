+
+void FullPreviewWidget::updateControlsGeometry() {
+	const auto contentWidth = width();
+
+	const auto newScrollTop = _scroll->isHidden()
+		? std::nullopt
+		: base::make_optional(_scroll->scrollTop() + takeTopDelta());
+	_topBar->resizeToWidth(contentWidth);
+	_topBarShadow->resize(contentWidth, st::lineWidth);
+
+	const auto top = _topBar->height();
+	const auto barHeight = _bar->height();
+	_bar->setGeometry(0, height() - barHeight, contentWidth, barHeight);
+	const auto scrollSize = QSize(
+		contentWidth,
+		std::max(height() - top - barHeight, 0));
+	if (_scroll->size() != scrollSize) {
+		_skipScrollEvent = true;
+		_scroll->resize(scrollSize);
+		_inner->resizeToWidth(scrollSize.width(), _scroll->height());
+		_skipScrollEvent = false;
+	}
+	_scroll->move(0, top);
+	if (!_scroll->isHidden()) {
+		if (newScrollTop) {
+			_scroll->scrollToY(*newScrollTop);
+		}
+		updateInnerVisibleArea();
+	}
+	_cornerButtons->updatePositions();
+}
+
+void FullPreviewWidget::paintEvent(QPaintEvent *e) {
+	if (animatingShow()) {
+		SectionWidget::paintEvent(e);
+		return;
+	} else if (controller()->contentOverlapped(this, e)) {
+		return;
+	}
+	const auto aboveHeight = _topBar->height();
+	const auto bg = e->rect().intersected(QRect(
+		0,
+		aboveHeight,
+		width(),
+		height() - aboveHeight - _bar->height()));
+	SectionWidget::PaintBackground(controller(), _theme.get(), this, bg);
+}
+
+void FullPreviewWidget::onScroll() {
+	if (_skipScrollEvent) {
+		return;
+	}
+	updateInnerVisibleArea();
+}
+
+void FullPreviewWidget::updateInnerVisibleArea() {
+	const auto scrollTop = _scroll->scrollTop();
+	_inner->setVisibleTopBottom(scrollTop, scrollTop + _scroll->height());
+	_cornerButtons->updateJumpDownVisibility();
+}
