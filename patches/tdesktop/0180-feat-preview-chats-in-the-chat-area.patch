+void FullPreviewWidget::setupClickBlocker() {
+	base::install_event_filter(_inner.data(), [=](not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type != QEvent::MouseButtonPress
+			&& type != QEvent::MouseButtonDblClick) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto position = static_cast<QMouseEvent*>(e.get())->pos();
+		return blocksClick(position)
+			? base::EventFilterResult::Cancel
+			: base::EventFilterResult::Continue;
+	});
+}
+
+bool FullPreviewWidget::blocksClick(QPoint position) const {
+	const auto link = ClickHandler::getActive();
+	if (!link) {
+		return false;
+	}
+	const auto reaction = link->property(
+		kSendReactionEmojiProperty).value<Data::ReactionId>();
+	if (!Reactions::ReactionIdOfLink(link).empty()
+		|| !reaction.empty()
+		|| !link->property(kPollOptionProperty).toByteArray().isEmpty()
+		|| link->property(kTodoListItemIdProperty).toInt()
+		|| link->property(kFastShareProperty).toBool()) {
+		return true;
+	} else if (const auto markup = dynamic_cast<ReplyMarkupClickHandler*>(
+			link.get())) {
+		const auto button = markup->getButton();
+		return !button
+			|| (button->type != HistoryMessageMarkupButton::Type::Url);
+	}
+	const auto view = _inner->lookupItemByY(position.y());
+	return view
+		&& view->history()->peer->isUser()
+		&& CanPlayEmojiInteraction(view);
+}
