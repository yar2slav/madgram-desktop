+void FullPreviewWidget::setupBar() {
+	_open = Ui::CreateChild<Ui::FlatButton>(
+		_bar.data(),
+		Lower(u"Open chat"_q),
+		st::historyComposeButton);
+	_open->setClickedCallback([=] {
+		openChat();
+	});
+	_close = Ui::CreateChild<Ui::IconButton>(
+		_bar.data(),
+		st::historyReplyCancel);
+	_close->setClickedCallback([=] {
+		close();
+	});
+
+	const auto text = Lower(u"Preview "_q
+		+ QChar(0x00B7)
+		+ u" messages stay unread"_q);
+	_bar->resize(width(), st::historyComposeButton.height);
+	_bar->widthValue() | rpl::on_next([=](int outer) {
+		const auto height = _bar->height();
+		_close->moveToRight(0, (height - _close->height()) / 2, outer);
+		_open->moveToRight(_close->width(), 0, outer);
+	}, _bar->lifetime());
+
+	_bar->paintRequest() | rpl::on_next([=](QRect clip) {
+		auto p = QPainter(_bar.data());
+		p.fillRect(clip, st::historyComposeAreaBg);
+		p.fillRect(0, 0, _bar->width(), st::lineWidth, st::shadowFg);
+		const auto &font = st::normalFont;
+		const auto left = st::boxRowPadding.left();
+		const auto available = _open->x() - 2 * left;
+		if (available <= 0) {
+			return;
+		}
+		p.setFont(font->f);
+		p.setPen(st::windowSubTextFg);
+		p.drawText(
+			left,
+			(_bar->height() - font->height) / 2 + font->ascent,
+			font->elided(text, available));
+	}, _bar->lifetime());
+	_bar->show();
+}
