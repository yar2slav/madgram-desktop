+void FullPreviewWidget::showMenu(not_null<QContextMenuEvent*> e) {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	const auto menu = _menu.get();
+	const auto link = ClickHandler::getActive();
+	const auto view = _inner->lookupItemByY(
+		_inner->mapFromGlobal(e->globalPos()).y());
+	const auto item = view ? view->data().get() : nullptr;
+	const auto owner = &_history->owner();
+	const auto list = _inner;
+
+	if (!_inner->getSelectedText().empty()
+		&& !_inner->hasCopyRestrictionForSelected()) {
+		const auto items = !_inner->getSelectedIds().empty();
+		menu->addAction((items
+			? tr::lng_context_copy_selected_items
+			: tr::lng_context_copy_selected)(tr::now), [=] {
+			if (list) {
+				list->copySelectedText();
+			}
+		}, &st::menuIconCopy);
+	} else if (item
+		&& !link
+		&& view->hasVisibleText()
+		&& !_inner->hasCopyRestriction(item)) {
+		const auto itemId = item->fullId();
+		menu->addAction(tr::lng_context_copy_text(tr::now), [=] {
+			const auto item = owner->message(itemId);
+			if (!item || !list || list->showCopyRestriction(item)) {
+				return;
+			} else if (const auto group = owner->groups().find(item)) {
+				TextUtilities::SetClipboardText(HistoryGroupText(group));
+			} else {
+				TextUtilities::SetClipboardText(HistoryItemText(item));
+			}
+		}, &st::menuIconCopy);
+	}
+	if (link) {
+		const auto label = link->copyToClipboardContextItemText();
+		const auto text = link->copyToClipboardText();
+		if (!label.isEmpty() && !text.isEmpty()) {
+			menu->addAction(label, [=] {
+				QGuiApplication::clipboard()->setText(text);
+			}, &st::menuIconCopy);
+		}
+	}
+	if (item && item->isRegular()) {
+		const auto itemId = item->fullId();
+		const auto window = controller();
+		menu->addAction(tr::lng_context_to_msg(tr::now), crl::guard(this, [=] {
+			if (const auto item = owner->message(itemId)) {
+				window->showMessage(
+					item,
+					Window::SectionShow::Way::ClearStack);
+			}
+		}), &st::menuIconShowInChat);
+	}
+	if (menu->empty()) {
+		_menu = nullptr;
+		return;
+	}
+	menu->popup(e->globalPos());
+}
