+bool ShowFullChatPreview(
+		not_null<Window::SessionController*> controller,
+		Data::Thread *thread,
+		Fn<void(bool shown)> callback) {
+	if (!FullChatPreview() || !thread) {
+		return false;
+	}
+	if (callback) {
+		callback(true);
+		callback(false);
+	}
+	if (controller->activeChatCurrent().thread() != thread) {
+		auto params = Window::SectionShow(
+			Window::SectionShow::Way::Forward);
+		params.dropSameFromStack = true;
+		controller->showSection(
+			std::make_shared<FullPreviewMemento>(thread),
+			params);
+	}
+	return true;
+}
+
+bool FullPreviewMenu(
+		not_null<HistoryView::ListWidget*> list,
+		not_null<QContextMenuEvent*> e) {
+	const auto widget = dynamic_cast<FullPreviewWidget*>(
+		list->delegate().get());
+	if (!widget) {
+		return false;
+	}
+	widget->showMenu(e);
+	return true;
+}
