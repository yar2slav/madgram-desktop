 	Ui::AddDividerText(
 		content,
 		rpl::single(u"Telegram Desktop %1 with tele patches, build %2."_q.arg(
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..335ebec14f07215103e5c57caa960ef681dd8175
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -0,0 +1,26 @@
+#include "tele/tele_options.h"
+
+#include "base/options.h"
+
+namespace Tele {
+
+const char kOptionHideStories[] = "tele-hide-stories";
+
+namespace {
+
+base::options::toggle HideStoriesOption({
+	.id = kOptionHideStories,
+	.name = "Hide stories",
+	.description = "No stories anywhere: no stories bar, no rings around "
+		"userpics, no stories in profiles, story messages show "
+		"as expired and story links don't open.",
+	.restartRequired = true,
+});
+
+} // namespace
+
+bool HideStories() {
+	return HideStoriesOption.value();
+}
+
+} // namespace Tele
