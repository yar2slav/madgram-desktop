+namespace {
+
+constexpr auto kPerPage = 100;
+constexpr auto kPause = crl::time(300);
+constexpr auto kPauseJitter = 200;
+constexpr auto kWaitJitter = 1000;
+constexpr auto kAnnounceWait = 10;
+
+using Key = std::pair<PeerId, MsgId>;
+
+[[nodiscard]] DeleteTracker &Tracker() {
+	static auto result = DeleteTracker();
+	return result;
+}
+
+[[nodiscard]] crl::time Pause() {
+	return kPause + base::RandomIndex(kPauseJitter);
+}
+
+[[nodiscard]] int FloodWait(const QString &type) {
+	static const auto expression = QRegularExpression(
+		u"^FLOOD(?:_PREMIUM)?_WAIT_(\\d+)$"_q);
+	const auto match = expression.match(type);
+	return match.hasMatch() ? std::max(match.captured(1).toInt(), 1) : 0;
+}
+
+[[nodiscard]] QString RemovedText(int count) {
+	return (count == 1)
+		? Lower(u"Removed 1 message."_q)
+		: Lower(u"Removed %1 messages."_q).arg(count);
+}
+
+[[nodiscard]] MTPmessages_Search SearchRequest(
+		not_null<PeerData*> peer,
+		MsgId topicRootId,
+		MsgId offsetId,
+		int limit) {
+	using Flag = MTPmessages_Search::Flag;
+	return MTPmessages_Search(
+		MTP_flags(Flag::f_from_id
+			| (topicRootId ? Flag::f_top_msg_id : Flag(0))),
+		peer->input(),
+		MTP_string(),
+		MTP_inputPeerSelf(),
+		MTPInputPeer(),
+		MTPVector<MTPReaction>(),
+		MTP_int(int(topicRootId.bare)),
+		MTP_inputMessagesFilterEmpty(),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(int(offsetId.bare)),
+		MTP_int(0),
+		MTP_int(limit),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_long(0));
+}
+
+[[nodiscard]] int CountOf(const MTPmessages_Messages &result) {
+	return result.match([](const MTPDmessages_messages &data) {
+		return int(data.vmessages().v.size());
+	}, [](const MTPDmessages_messagesSlice &data) {
+		return data.vcount().v;
+	}, [](const MTPDmessages_channelMessages &data) {
+		return data.vcount().v;
+	}, [](const MTPDmessages_messagesNotModified &data) {
+		return data.vcount().v;
+	});
+}
+
+[[nodiscard]] bool Eligible(Data::Thread *thread) {
+	if (!thread) {
+		return false;
+	}
+	const auto topic = thread->asTopic();
+	if (!topic && !thread->asHistory()) {
+		return false;
+	} else if (topic && topic->creating()) {
+		return false;
+	}
+	const auto peer = thread->peer();
+	if (peer->isSelf()
+		|| peer->isRepliesChat()
+		|| peer->isVerifyCodes()
+		|| peer->isServiceUser()
+		|| IsChangelogPeer(peer)
+		|| Secret::IsSecretPeer(peer)) {
+		return false;
+	} else if (const auto user = peer->asUser()) {
+		return !user->isBot();
+	} else if (const auto chat = peer->asChat()) {
+		return chat->amIn();
+	} else if (const auto channel = peer->asChannel()) {
+		return channel->isMegagroup()
+			&& !channel->isMonoforum()
+			&& channel->amIn();
+	}
+	return false;
+}
+
+[[nodiscard]] Key KeyOf(not_null<Data::Thread*> thread) {
+	const auto topic = thread->asTopic();
+	return { thread->peer()->id, topic ? topic->rootId() : MsgId() };
+}
+
+class Run final : public base::has_weak_ptr {
+public:
+	Run(not_null<PeerData*> peer, MsgId topicRootId);
+
+	void start();
+	void stop();
+	[[nodiscard]] bool finished() const;
+
+private:
+	void requestPage();
+	void pageReceived(const MTPmessages_Messages &result);
+	void pageFailed(const MTP::Error &error);
+	void deleteNext();
+	void deleted(const MTP::Error *error);
+	void advance();
+	void passFinished();
+	void schedule(crl::time delay, void (Run::*method)());
+	void finish(const QString &text);
+	void toast(const QString &text) const;
+
+	const not_null<PeerData*> _peer;
+	const MsgId _topicRootId;
+	ChatData * const _migrated = nullptr;
+	not_null<PeerData*> _target;
+	MTP::Sender _api;
+	base::Timer _timer;
+	void (Run::*_scheduled)() = nullptr;
+	base::flat_set<MsgId> _skip;
+	base::flat_set<MsgId> _done;
+	std::vector<std::vector<MsgId>> _chunks;
+	std::vector<MsgId> _chunk;
+	MsgId _offsetId = 0;
+	MsgId _nextOffsetId = 0;
+	int _chunkLimit = kPerPage;
+	int _removed = 0;
+	bool _finished = false;
+
+};
+
+[[nodiscard]] auto Sessions()
+-> base::flat_map<
+		not_null<Main::Session*>,
+		base::flat_map<Key, std::unique_ptr<Run>>> & {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		base::flat_map<Key, std::unique_ptr<Run>>>();
+	return result;
+}
+
+[[nodiscard]] Run *FindRun(not_null<Main::Session*> session, Key key) {
+	const auto i = Sessions().find(session);
+	if (i == end(Sessions())) {
+		return nullptr;
+	}
+	const auto j = i->second.find(key);
+	return (j != end(i->second) && !j->second->finished())
+		? j->second.get()
+		: nullptr;
+}
+
+void EraseRun(
+		not_null<Main::Session*> session,
+		Key key,
+		not_null<Run*> run) {
+	const auto i = Sessions().find(session);
+	if (i == end(Sessions())) {
+		return;
+	}
+	const auto j = i->second.find(key);
+	if (j != end(i->second) && j->second.get() == run.get()) {
+		i->second.erase(j);
+	}
+}
+
+Run::Run(not_null<PeerData*> peer, MsgId topicRootId)
+: _peer(peer)
+, _topicRootId(topicRootId)
+, _migrated(topicRootId ? nullptr : peer->migrateFrom())
+, _target(peer)
+, _api(&peer->session().mtp())
+, _timer([=] {
+	if (const auto method = base::take(_scheduled)) {
+		(this->*method)();
+	}
+}) {
+}
+
+void Run::start() {
+	toast(Lower(u"Removing your messages"_q) + QChar(0x2026));
+	requestPage();
+}
+
+void Run::stop() {
+	finish(Lower(u"Stopped. "_q) + RemovedText(_removed));
+}
+
+bool Run::finished() const {
+	return _finished;
+}
+
+void Run::requestPage() {
+	if (_finished) {
+		return;
+	}
+	_api.request(SearchRequest(
+		_target,
+		_topicRootId,
+		_offsetId,
+		kPerPage
+	)).done([=](const MTPmessages_Messages &result) {
+		pageReceived(result);
+	}).fail([=](const MTP::Error &error) {
+		pageFailed(error);
+	}).handleFloodErrors().send();
+}
+
+void Run::pageReceived(const MTPmessages_Messages &result) {
+	if (_finished) {
+		return;
+	}
+	auto &owner = _peer->owner();
+	const auto messages = result.match([](
+			const MTPDmessages_messagesNotModified &) {
+		return QVector<MTPMessage>();
+	}, [&](const auto &data) {
+		owner.processUsers(data.vusers());
+		owner.processChats(data.vchats());
+		return QVector<MTPMessage>(data.vmessages().v);
+	});
+	if (messages.isEmpty()) {
+		passFinished();
+		return;
+	}
+	auto ids = std::vector<MsgId>();
+	ids.reserve(messages.size());
+	auto minId = MsgId();
+	for (const auto &message : messages) {
+		const auto id = IdFromMessage(message);
+		if (!minId || id < minId) {
+			minId = id;
+		}
+		if (_done.contains(id) || _skip.contains(id)) {
+			continue;
+		} else if (PeerFromMessage(message) != _target->id
+			|| !DateFromMessage(message)) {
+			_skip.emplace(id);
+			continue;
+		}
+		const auto item = owner.addNewMessage(
+			message,
+			MessageFlags(),
+			NewMessageType::Existing);
+		if (!item
+			|| !item->out()
+			|| !item->canDelete()
+			|| IsKeptDeleted(item)) {
+			_skip.emplace(id);
+			continue;
+		}
+		ids.push_back(id);
+	}
+	_nextOffsetId = minId;
+	if (ids.empty()) {
+		advance();
+		return;
+	}
+	ranges::sort(ids, std::greater<>());
+	_chunks.clear();
+	for (auto i = 0; i < int(ids.size()); i += _chunkLimit) {
+		const auto till = std::min(i + _chunkLimit, int(ids.size()));
+		_chunks.emplace_back(begin(ids) + i, begin(ids) + till);
+	}
+	deleteNext();
+}
+
+void Run::pageFailed(const MTP::Error &error) {
+	if (_finished) {
+		return;
+	}
+	if (const auto wait = FloodWait(error.type())) {
+		if (wait >= kAnnounceWait) {
+			toast(Lower(u"Rate limited, going on in %1 s."_q).arg(wait));
+		}
+		schedule(
+			wait * crl::time(1000) + base::RandomIndex(kWaitJitter),
+			&Run::requestPage);
+		return;
+	}
+	finish(Lower(u"Couldn't remove messages: "_q) + error.type());
+}
+
+void Run::deleteNext() {
+	if (_finished) {
+		return;
+	}
+	auto &owner = _peer->owner();
+	while (!_chunks.empty()) {
+		auto list = MessageIdsList();
+		_chunk.clear();
+		for (const auto id : _chunks.front()) {
+			if (const auto item = owner.message(_target->id, id)) {
+				_chunk.push_back(id);
+				list.push_back(item->fullId());
+			}
+		}
+		_chunks.erase(begin(_chunks));
+		if (list.empty()) {
+			continue;
+		}
+		const auto weak = base::make_weak(this);
+		Tracker() = [=](const MTP::Error *error) {
+			if (const auto strong = weak.get()) {
+				strong->deleted(error);
+			}
+		};
+		owner.histories().deleteMessages(list, true);
+		if (!base::take(Tracker())) {
+			return;
+		}
+		for (const auto id : base::take(_chunk)) {
+			_skip.emplace(id);
+		}
+	}
+	advance();
+}
+
+void Run::deleted(const MTP::Error *error) {
+	if (_finished) {
+		return;
+	} else if (!error) {
+		_removed += int(_chunk.size());
+		for (const auto id : base::take(_chunk)) {
+			_done.emplace(id);
+		}
+		schedule(Pause(), &Run::deleteNext);
+		return;
+	}
+	const auto &type = error->type();
+	if (type == u"MESSAGE_DELETE_FORBIDDEN"_q
+		|| type == u"MESSAGE_ID_INVALID"_q) {
+		if (_chunk.size() == 1) {
+			_skip.emplace(_chunk.front());
+			_chunk.clear();
+			schedule(Pause(), &Run::deleteNext);
+			return;
+		}
+		_chunkLimit = std::max(int(_chunk.size()) / 2, 1);
+		_chunk.clear();
+		_chunks.clear();
+		schedule(Pause(), &Run::requestPage);
+		return;
+	}
+	finish(Lower(u"Couldn't remove messages: "_q) + type);
+}
+
+void Run::advance() {
+	if (!_nextOffsetId || (_offsetId && _nextOffsetId >= _offsetId)) {
+		passFinished();
+		return;
+	}
+	_offsetId = _nextOffsetId;
+	_chunkLimit = kPerPage;
+	schedule(Pause(), &Run::requestPage);
+}
+
+void Run::passFinished() {
+	if (!_migrated || _target != _peer) {
+		finish(RemovedText(_removed));
+		return;
+	}
+	_target = _migrated;
+	_skip.clear();
+	_done.clear();
+	_chunks.clear();
+	_chunk.clear();
+	_offsetId = _nextOffsetId = MsgId();
+	_chunkLimit = kPerPage;
+	schedule(Pause(), &Run::requestPage);
+}
+
+void Run::schedule(crl::time delay, void (Run::*method)()) {
+	_scheduled = method;
+	_timer.callOnce(delay);
+}
+
+void Run::finish(const QString &text) {
+	if (_finished) {
+		return;
+	}
+	_finished = true;
+	_scheduled = nullptr;
+	_timer.cancel();
+	toast(text);
+	const auto session = &_peer->session();
+	const auto key = Key{ _peer->id, _topicRootId };
+	crl::on_main(this, [=] {
+		EraseRun(session, key, this);
+	});
+}
+
+void Run::toast(const QString &text) const {
+	if (const auto window = _peer->session().tryResolveWindow(_peer)) {
+		ShowTeleToast(window, text);
+	}
+}
+
+void Start(not_null<Data::Thread*> thread) {
+	if (!Eligible(thread)) {
+		return;
+	}
+	const auto peer = thread->peer();
+	const auto session = not_null<Main::Session*>(&peer->session());
+	const auto key = KeyOf(thread);
+	if (FindRun(session, key)) {
+		return;
+	}
+	auto &sessions = Sessions();
+	if (!sessions.contains(session)) {
+		session->lifetime().add([=] {
+			Sessions().remove(session);
+		});
+	}
+	auto &runs = sessions[session];
+	runs.remove(key);
+	const auto run = runs.emplace(
+		key,
+		std::make_unique<Run>(peer, key.second)).first->second.get();
+	run->start();
+}
+
+void Confirm(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread,
+		int count) {
+	const auto peer = thread->peer();
+	const auto topic = thread->asTopic();
+	const auto name = topic ? topic->title() : peer->name();
+	const auto text = (peer->isUser()
+		? Lower(u"Remove %1 of your messages from %2 for both of you? "
+			"This can't be undone."_q)
+		: Lower(u"Remove %1 of your messages from %2 for everyone? "
+			"This can't be undone."_q)).arg(count).arg(name);
+	const auto weak = base::make_weak(thread);
+	controller->show(Ui::MakeConfirmBox({
+		.text = text,
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			if (const auto strong = weak.get()) {
+				Start(strong);
+			}
+		},
+		.confirmText = Lower(u"Remove"_q),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+void Count(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread) {
+	const auto peer = thread->peer();
+	const auto key = KeyOf(thread);
+	const auto migrated = key.second ? nullptr : peer->migrateFrom();
+	const auto weak = base::make_weak(controller);
+	const auto weakThread = base::make_weak(thread);
+	const auto api = &peer->session().api();
+	const auto fail = [=](const MTP::Error &error) {
+		if (const auto strong = weak.get()) {
+			ShowTeleToast(
+				strong,
+				Lower(u"Couldn't count your messages: "_q) + error.type());
+		}
+	};
+	const auto counted = [=](int count) {
+		const auto strong = weak.get();
+		const auto strongThread = weakThread.get();
+		if (!strong || !strongThread) {
+			return;
+		} else if (count <= 0) {
+			ShowTeleToast(strong, Lower(u"You have no messages here."_q));
+			return;
+		}
+		Confirm(strong, strongThread, count);
+	};
+	api->request(SearchRequest(
+		peer,
+		key.second,
+		MsgId(),
+		1
+	)).done([=](const MTPmessages_Messages &result) {
+		const auto count = std::max(CountOf(result), 0);
+		if (!migrated) {
+			counted(count);
+			return;
+		}
+		api->request(SearchRequest(
+			migrated,
+			MsgId(),
+			MsgId(),
+			1
+		)).done([=](const MTPmessages_Messages &result) {
+			counted(count + std::max(CountOf(result), 0));
+		}).fail(fail).send();
+	}).fail(fail).send();
+}
+
+} // namespace
+
+void AddRemoveMyMessagesAction(
+		not_null<Window::SessionController*> controller,
+		Data::Thread *thread,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!Eligible(thread)) {
+		return;
+	}
+	const auto session = not_null<Main::Session*>(&thread->session());
+	const auto key = KeyOf(thread);
+	if (FindRun(session, key)) {
+		const auto weak = base::make_weak(session);
+		TagMenuAction(addAction({
+			.text = Lower(u"Stop removing my messages"_q),
+			.handler = [=] {
+				if (const auto strong = weak.get()) {
+					if (const auto run = FindRun(strong, key)) {
+						run->stop();
+					}
+				}
+			},
+			.icon = &st::menuIconCancel,
+		}), u"remove_mine"_q);
+		return;
+	} else if (!RemoveMyMessages()) {
+		return;
+	}
+	const auto weak = base::make_weak(controller);
+	const auto weakThread = base::make_weak(thread);
+	TagMenuAction(addAction({
+		.text = Lower(u"Remove my messages"_q),
+		.handler = [=] {
+			const auto strong = weak.get();
+			const auto strongThread = weakThread.get();
+			if (strong && strongThread) {
+				Count(strong, strongThread);
+			}
+		},
+		.icon = &st::menuIconDelete,
+	}), u"remove_mine"_q);
+}
+
+DeleteTracker TakeDeleteTracker() {
+	return base::take(Tracker());
+}
