+++ b/Telegram/SourceFiles/tele/tele_counters.cpp
@@ -0,0 +1,124 @@
+#include "tele/tele_counters.h"
+
+#include "data/data_folder.h"
+#include "data/data_session.h"
+#include "dialogs/dialogs_common.h"
+#include "dialogs/dialogs_key.h"
+#include "main/main_account.h"
+#include "main/main_session.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/menu/menu_toggle.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] base::flat_set<uint64> ParseAccounts(const QString &value) {
+	auto result = base::flat_set<uint64>();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto ok = false;
+		const auto id = part.trimmed().toULongLong(&ok);
+		if (ok && id) {
+			result.emplace(id);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString SerializeAccounts(const base::flat_set<uint64> &ids) {
+	auto parts = QStringList();
+	parts.reserve(ids.size());
+	for (const auto id : ids) {
+		parts.push_back(QString::number(id));
+	}
+	return parts.join(QChar(','));
+}
+
+[[nodiscard]] bool Uncounted(not_null<Main::Session*> session) {
+	const auto value = UncountedAccounts();
+	return !value.isEmpty() && ParseAccounts(value).contains(
+		session->uniqueId());
+}
+
+void SetUncounted(not_null<Main::Session*> session, bool uncounted) {
+	auto ids = ParseAccounts(UncountedAccounts());
+	if (uncounted) {
+		ids.emplace(session->uniqueId());
+	} else {
+		ids.remove(session->uniqueId());
+	}
+	SetUncountedAccounts(SerializeAccounts(ids));
+}
+
+[[nodiscard]] Data::Folder *SkippedArchive(not_null<Data::Session*> data) {
+	return CounterSkipArchive()
+		? data->folderLoaded(Data::Folder::kId)
+		: nullptr;
+}
+
+} // namespace
+
+rpl::producer<Dialogs::UnreadState> FolderTabUnreadState(
+		rpl::producer<Dialogs::UnreadState> state) {
+	auto hidden = rpl::single(rpl::empty) | rpl::then(
+		CountersChanges()
+	) | rpl::map([] {
+		return HideFolderCounters();
+	}) | rpl::distinct_until_changed();
+	return rpl::combine(
+		std::move(state),
+		std::move(hidden)
+	) | rpl::map([](const Dialogs::UnreadState &state, bool hidden) {
+		return hidden ? Dialogs::UnreadState() : state;
+	});
+}
+
+int AppUnreadBadge(int badge) {
+	return HideAppCounter() ? 0 : badge;
+}
+
+rpl::producer<> AppUnreadBadgeChanges() {
+	return rpl::merge(CountersChanges(), UncountedAccountsChanges());
+}
+
+Main::Session *CountedSession(not_null<Main::Account*> account) {
+	const auto session = account->maybeSession();
+	return (session && !Uncounted(session)) ? session : nullptr;
+}
+
+int UnreadBadge(not_null<Data::Session*> data) {
+	if (const auto archive = SkippedArchive(data)) {
+		return data->unreadBadgeIgnoreOne(archive);
+	}
+	return data->unreadBadge();
+}
+
+bool UnreadBadgeMuted(not_null<Data::Session*> data) {
+	if (const auto archive = SkippedArchive(data)) {
+		return data->unreadBadgeMutedIgnoreOne(archive);
+	}
+	return data->unreadBadgeMuted();
+}
+
+void AddAccountCounterAction(
+		not_null<Main::Session*> session,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto uncounted = Uncounted(session);
+	addAction({ .make = [=](not_null<Ui::PopupMenu*> menu) {
+		auto result = base::make_unique_q<Ui::Menu::Toggle>(
+			menu->menu(),
+			menu->st().menu,
+			Lower(u"Don't count this account"_q),
+			[=] { SetUncounted(session, !uncounted); },
+			&st::menuIconMarkUnread,
+			&st::menuIconMarkUnread);
+		result->action()->setCheckable(true);
+		result->action()->setChecked(uncounted);
+		return base::unique_qptr<Ui::Menu::ItemBase>(std::move(result));
+	} });
+}
+
+} // namespace Tele
