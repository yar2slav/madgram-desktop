+namespace Tele {
+namespace {
+
+using Processor = HistoryView::Controls::WebpageProcessor;
+
+enum class Mode {
+	All,
+	NotPasted,
+	OnlyAdded,
+};
+
+struct FieldPaste {
+	not_null<Ui::InputField*> field;
+	QString text;
+	bool finished = false;
+};
+
+struct ProcessorState {
+	not_null<Ui::InputField*> field;
+	std::optional<QStringList> before;
+	bool pasted = false;
+};
+
+[[nodiscard]] rpl::event_stream<FieldPaste> &FieldPastes() {
+	static auto result = rpl::event_stream<FieldPaste>();
+	return result;
+}
+
+[[nodiscard]] base::flat_map<const Processor*, ProcessorState*> &States() {
+	static auto result = base::flat_map<const Processor*, ProcessorState*>();
+	return result;
+}
+
+[[nodiscard]] ProcessorState *StateFor(not_null<const Processor*> processor) {
+	const auto i = States().find(processor.get());
+	return (i != end(States())) ? i->second : nullptr;
+}
+
+[[nodiscard]] Mode CurrentMode() {
+	const auto value = LinkPreviews();
+	return (value == u"pasted"_q)
+		? Mode::NotPasted
+		: (value == u"added"_q)
+		? Mode::OnlyAdded
+		: Mode::All;
+}
+
+[[nodiscard]] bool HasServerLink(const QString &text) {
+	static const auto Link = QRegularExpression(
+		u"(?:[a-z][a-z0-9+.\\-]*://\\S+)"
+		"|(?<![\\p{L}\\p{N}_@.\\-])"
+		"(?:[\\p{L}\\p{N}](?:[\\p{L}\\p{N}\\-]*[\\p{L}\\p{N}])?\\.)+"
+		"\\p{L}{2,}(?![\\p{L}\\p{N}_@\\-])"
+		"|(?<![\\d.])\\d{1,3}(?:\\.\\d{1,3}){3}(?![\\d.])"_q,
+		(QRegularExpression::CaseInsensitiveOption
+			| QRegularExpression::UseUnicodePropertiesOption));
+	return !text.isEmpty() && Link.match(text).hasMatch();
+}
+
+[[nodiscard]] QString LinkAt(
+		const QString &text,
+		const MessageLinkRange &range) {
+	return range.custom.isEmpty()
+		? text.mid(range.start, range.length)
+		: range.custom;
+}
+
+[[nodiscard]] QStringList CurrentLinks(
+		not_null<Ui::InputField*> field,
+		not_null<Processor*> processor) {
+	processor->checkNow(false);
+	const auto &text = field->getTextWithTags().text;
+	auto result = QStringList();
+	for (const auto &range : processor->links()) {
+		result.push_back(LinkAt(text, range));
+	}
+	return result;
+}
+
+[[nodiscard]] QString FirstLink(
+		not_null<Ui::InputField*> field,
+		not_null<Processor*> processor) {
+	const auto links = CurrentLinks(field, processor);
+	return links.isEmpty() ? QString() : links.front();
+}
+
+[[nodiscard]] Data::WebPageDraft RawDraft(
+		not_null<ProcessorState*> state,
+		not_null<Processor*> processor) {
+	const auto was = std::exchange(state->pasted, false);
+	auto result = processor->draft();
+	state->pasted = was;
+	return result;
+}
+
+[[nodiscard]] bool IsCustomLink(
+		const QString &text,
+		const std::vector<MessageLinkRange> &links,
+		const QString &link,
+		const Data::WebPageDraft &webpage) {
+	if (!webpage.manual || webpage.removed || webpage.url.isEmpty()) {
+		return false;
+	}
+	const auto used = link.isEmpty() ? webpage.url : link;
+	for (const auto &range : links) {
+		if (LinkAt(text, range) == used) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString NormalizeCustomLink(const QString &value) {
+	const auto trimmed = value.trimmed();
+	if (trimmed.isEmpty()) {
+		return QString();
+	}
+	return qthelp::validate_url(trimmed.contains(u"://"_q)
+		? trimmed
+		: (u"https://"_q + trimmed));
+}
+
+void ShowCustomLinkBox(
+		std::shared_ptr<Ui::Show> show,
+		QString current,
+		Fn<void(QString)> done) {
+	show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Lower(u"Use another link"_q)));
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(Lower(u"Link"_q)),
+			current));
+		const auto submit = [=] {
+			const auto link = NormalizeCustomLink(field->getLastText());
+			if (link.isEmpty()) {
+				field->showError();
+				return;
+			}
+			box->closeBox();
+			done(link);
+		};
+		field->submits(
+		) | rpl::on_next([=](Qt::KeyboardModifiers) {
+			submit();
+		}, field->lifetime());
+		box->setFocusCallback([=] {
+			field->selectAll();
+			field->setFocusFast();
+		});
+		box->addButton(tr::lng_settings_save(), submit);
+		box->addButton(tr::lng_cancel(), [=] {
+			box->closeBox();
+		});
+	}));
+}
+
+void AddLinkPreview(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<HistoryView::Controls::WebpageProcessor*> processor,
+		const QString &link) {
+	const auto apply = [=](WebPageData *page) {
+		const auto now = base::unixtime::now();
+		if (!page
+			|| page->failed
+			|| (page->pendingTill > 0 && page->pendingTill < now)) {
+			show->showToast(tr::lng_preview_cant(tr::now));
+			return;
+		}
+		processor->apply({
+			.id = page->id,
+			.url = page->url,
+			.manual = true,
+		});
+	};
+	const auto resolver = processor->resolver();
+	if (const auto value = resolver->lookup(link)) {
+		apply(*value);
+		return;
+	} else if (OfflineForLaunch()) {
+		apply(nullptr);
+		return;
+	}
+	resolver->resolved(
+	) | rpl::filter([=](const QString &resolved) {
+		return (resolved == link);
+	}) | rpl::take(1) | rpl::on_next([=] {
+		apply(resolver->lookup(link).value_or(nullptr));
+	}, processor->lifetime());
+	resolver->request(link);
+}
+
+} // namespace
+
+void NotifyFieldPaste(not_null<Ui::InputField*> field, QString text) {
+	if (CurrentMode() != Mode::NotPasted) {
+		return;
+	}
+	FieldPastes().fire({ .field = field });
+	crl::on_main(field.get(), [=] {
+		FieldPastes().fire({
+			.field = field,
+			.text = text,
+			.finished = true,
+		});
+	});
+}
+
+void SetupLinkPreviews(
+		not_null<Ui::InputField*> field,
+		not_null<Processor*> processor) {
+	const auto state = processor->lifetime().make_state<ProcessorState>(
+		ProcessorState{ .field = field });
+	const auto raw = processor.get();
+	States()[raw] = state;
+	processor->lifetime().add([=] {
+		States().remove(raw);
+	});
+	FieldPastes().events(
+	) | rpl::filter([=](const FieldPaste &paste) {
+		return (paste.field == field);
+	}) | rpl::on_next([=](const FieldPaste &paste) {
+		if (!paste.finished) {
+			state->before = CurrentLinks(field, processor);
+			return;
+		} else if (!state->before) {
+			return;
+		}
+		const auto was = *base::take(state->before);
+		const auto manual = RawDraft(state, processor).manual;
+		auto added = false;
+		for (const auto &link : CurrentLinks(field, processor)) {
+			if (!was.contains(link)) {
+				added = true;
+				break;
+			}
+		}
+		if (added || HasServerLink(paste.text)) {
+			state->pasted = true;
+		}
+		if (added && !manual) {
+			processor->apply({ .removed = true });
+		}
+	}, processor->lifetime());
+	field->changes(
+	) | rpl::filter([=] {
+		return state->pasted && field->getLastText().isEmpty();
+	}) | rpl::on_next([=] {
+		state->pasted = false;
+	}, processor->lifetime());
+	LinkPreviewsValue(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		processor->checkNow(false);
+	}, processor->lifetime());
+}
+
+void ApplyLinkPreviewDraft(
+		not_null<const Processor*> processor,
+		Data::WebPageDraft &draft,
+		Data::WebPageDraft &current) {
+	if (draft.manual
+		&& !draft.removed
+		&& !draft.id
+		&& draft.url.isEmpty()) {
+		draft = {};
+		current = {};
+	}
+	const auto mode = CurrentMode();
+	if (mode == Mode::OnlyAdded) {
+		if (!draft.removed && !draft.url.isEmpty()) {
+			draft.manual = true;
+		}
+	} else if (mode == Mode::NotPasted && draft.removed) {
+		if (const auto state = StateFor(processor)) {
+			if (HasServerLink(state->field->getLastText())) {
+				state->pasted = true;
+			}
+		}
+	}
+}
+
+Data::WebPageDraft LinkPreviewDraft(
+		not_null<const Processor*> processor,
+		Data::WebPageDraft draft) {
+	if (draft.manual || draft.removed) {
+		return draft;
+	}
+	const auto mode = CurrentMode();
+	if (mode == Mode::OnlyAdded) {
+		return { .removed = true };
+	} else if (mode == Mode::NotPasted) {
+		const auto state = StateFor(processor);
+		if (state && state->pasted) {
+			if (draft.url.isEmpty()) {
+				return { .removed = true };
+			}
+			draft.manual = true;
+		}
+	}
+	return draft;
+}
+
+bool SkipAutoLinkPreview(not_null<Processor*> processor) {
+	if (CurrentMode() != Mode::OnlyAdded) {
+		return false;
+	}
+	processor->apply({ .removed = true });
+	return true;
+}
+
+void AddCustomLinkPreviewButtons(
+		not_null<Ui::VerticalLayout*> container,
+		CustomLinkPreviewArgs &&args) {
+	const auto custom = args.links && IsCustomLink(
+		args.text,
+		*args.links,
+		args.link,
+		args.webpage);
+	const auto hasTextLinks = args.links && !args.links->empty();
+	const auto show = args.show;
+	const auto resolver = args.resolver;
+	const auto performSwitch = args.performSwitch;
+	const auto requestAndSwitch = args.requestAndSwitch;
+	const auto current = custom
+		? (args.link.isEmpty() ? args.webpage.url : args.link)
+		: QString();
+	const auto choose = crl::guard(container, [=](QString link) {
+		if (const auto value = resolver->lookup(link)) {
+			performSwitch(link, *value);
+		} else {
+			requestAndSwitch(link, false);
+		}
+	});
+	Settings::AddButtonWithIcon(
+		container,
+		rpl::single(Lower(u"Use another link…"_q)),
+		st::settingsButton,
+		{ &st::menuIconLink }
+	)->setClickedCallback([=] {
+		ShowCustomLinkBox(show, current, choose);
+	});
+	if (custom && hasTextLinks) {
+		const auto finish = args.finish;
+		const auto first = LinkAt(args.text, args.links->front());
+		Settings::AddButtonWithIcon(
+			container,
+			rpl::single(Lower(u"Use link from the text"_q)),
+			st::settingsButton,
+			{ &st::menuIconRestore }
+		)->setClickedCallback([=] {
+			if (CurrentMode() == Mode::OnlyAdded) {
+				choose(first);
+			} else {
+				finish({ .manual = true });
+			}
+		});
+	}
+}
+
+void SetupAddLinkPreview(AddLinkPreviewArgs &&args) {
+	const auto field = args.field;
+	const auto show = args.show;
+	const auto processor = std::move(args.processor);
+	const auto editing = std::move(args.editing);
+	const auto available = [=]() -> Processor* {
+		const auto result = processor();
+		if (!result || field->getLastText().trimmed().isEmpty()) {
+			return nullptr;
+		}
+		const auto draft = result->draft();
+		if (!draft.removed && !draft.url.isEmpty()) {
+			return nullptr;
+		}
+		if (const auto id = editing()) {
+			const auto item = show->session().data().message(id);
+			const auto media = item ? item->media() : nullptr;
+			if (!item || (media && !media->webpage())) {
+				return nullptr;
+			}
+		}
+		return result;
+	};
+	field->addContextMenuHook([=](Ui::InputField::ContextMenuRequest request) {
+		if (!available()) {
+			return;
+		}
+		request.menu->addSeparator();
+		const auto action = request.menu->addAction(
+			Lower(u"Add a link preview…"_q));
+		QObject::connect(action, &QAction::triggered, field, [=] {
+			const auto now = available();
+			const auto first = now ? FirstLink(field, now) : QString();
+			ShowCustomLinkBox(show, first, [=](QString link) {
+				if (const auto now = available()) {
+					AddLinkPreview(show, now, link);
+				}
+			});
+		});
+	});
+}
+
+} // namespace Tele
