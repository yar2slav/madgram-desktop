 [[nodiscard]] TgsReport CheckTgsSticker(const QByteArray &file);
 [[nodiscard]] bool PassesTgsServerChecks(const QByteArray &file);
+bool RepairTgsHeader(QByteArray &file);
 
 } // namespace Tele
