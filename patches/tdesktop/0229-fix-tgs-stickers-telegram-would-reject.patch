diff --git a/Telegram/SourceFiles/tele/tele_gift_studio_export.cpp b/Telegram/SourceFiles/tele/tele_gift_studio_export.cpp
index 134e0db6881d3acc04944b24dc772d702cf35104..d4123d6ef07eb9ceed316226cb1bd3445f4b207a 100644
