-	const auto bytes = Lottie::ReadContent(content, filepath);
+	auto bytes = Lottie::ReadContent(content, filepath);
+	RepairTgsHeader(bytes);
 	const auto bundled = filepath.startsWith(u":/"_q);
 	auto result = (!bytes.isEmpty()
 		&& (bundled
@@ -42,6 +44,23 @@ QImage ReadStickerThumbnail(
 	return result;
 }
 
+void RepairTgsUpload(const QString &filepath, QByteArray &content) {
+	if (!filepath.endsWith(u".tgs"_q, Qt::CaseInsensitive)) {
+		return;
+	} else if (!content.isEmpty()) {
+		RepairTgsHeader(content);
+		return;
+	}
+	auto file = QFile(filepath);
+	if (file.size() > kMaxTgsBytes || !file.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	auto bytes = file.readAll();
+	if (RepairTgsHeader(bytes)) {
+		content = std::move(bytes);
+	}
+}
+
 bool LacksStickerAttribute(
