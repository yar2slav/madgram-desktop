diff --git a/Telegram/SourceFiles/tele/tele_tgs_rules.cpp b/Telegram/SourceFiles/tele/tele_tgs_rules.cpp
index d0a0433f0078434c74abcf5e3840b6d864ecc364..5024f0729c1a28c12c21b3d834db70c6af963435 100644
--- a/Telegram/SourceFiles/tele/tele_tgs_rules.cpp
+++ b/Telegram/SourceFiles/tele/tele_tgs_rules.cpp
@@ -11,6 +11,9 @@ namespace Tele {
 namespace {
 
 constexpr auto kMaxDepth = 256;
+constexpr auto kGzipTops20 = 10;
+constexpr auto kGzipUnix = 3;
+constexpr auto kGzipHeaderCrc = 0x02;
 
 struct Found {
 	int expressions = 0;
@@ -117,6 +120,11 @@ TgsReport CheckTgsSticker(const QByteArray &file) {
 		result.errors.push_back(Lower(u"it isn't gzip-compressed"_q));
 		return result;
 	}
+	if (file.size() > 9 && uchar(file[9]) == kGzipTops20) {
+		result.errors.push_back(
+			Lower(u"its gzip header names TOPS-20 as the OS, which Telegram "
+				"rejects"_q));
+	}
 	auto error = QJsonParseError();
 	const auto document = QJsonDocument::fromJson(
 		Images::UnpackGzip(file),
@@ -185,4 +193,16 @@ bool PassesTgsServerChecks(const QByteArray &file) {
 	return CheckTgsSticker(file).errors.isEmpty();
 }
 
+bool RepairTgsHeader(QByteArray &file) {
+	if (file.size() <= 9
+		|| uchar(file[0]) != 0x1F
+		|| uchar(file[1]) != 0x8B
+		|| (uchar(file[3]) & kGzipHeaderCrc)
+		|| uchar(file[9]) != kGzipTops20) {
+		return false;
+	}
+	file[9] = char(kGzipUnix);
+	return true;
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_tgs_rules.h b/Telegram/SourceFiles/tele/tele_tgs_rules.h
