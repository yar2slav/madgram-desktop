 }
 
+constexpr auto kGzipUnix = 3;
+
 [[nodiscard]] QByteArray Gzip(const QByteArray &bytes) {
 	auto stream = z_stream();
 	if (deflateInit2(
@@ -1675,6 +1677,12 @@ constexpr auto kMarkVertices = (kMarkBits * kMarkCopies) / 6;
 			Z_DEFAULT_STRATEGY) != Z_OK) {
 		return QByteArray();
 	}
+	auto header = gz_header();
+	header.os = kGzipUnix;
+	if (deflateSetHeader(&stream, &header) != Z_OK) {
+		deflateEnd(&stream);
+		return QByteArray();
+	}
 	auto result = QByteArray(
 		int(deflateBound(&stream, uLong(bytes.size()))),
 		Qt::Uninitialized);
