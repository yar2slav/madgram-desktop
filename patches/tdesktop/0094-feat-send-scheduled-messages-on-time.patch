+#include "window/window_session_controller.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxWait = crl::time(60000);
+constexpr auto kWakeGap = TimeId(30);
+constexpr auto kWakeHold = crl::time(5000);
+constexpr auto kResweepGap = TimeId(1800);
+constexpr auto kSweepDelay = crl::time(15000);
+constexpr auto kSweepFastCount = 100;
+constexpr auto kSweepFastInterval = crl::time(1000);
+constexpr auto kSweepSlowInterval = crl::time(3000);
+constexpr auto kMaxRetries = 5;
+constexpr auto kRetryDelays = std::array{
+	crl::time(5000),
+	crl::time(15000),
+	crl::time(60000),
+	crl::time(300000),
+	crl::time(900000),
+};
+
+[[nodiscard]] std::optional<crl::time> RetryDelay(
+		const MTP::Error &error,
+		int failures) {
+	const auto &type = error.type();
+	if (MTP::IsFloodError(type) || type.startsWith(u"SLOWMODE_WAIT_"_q)) {
+		const auto seconds = type.mid(type.lastIndexOf('_') + 1).toInt();
+		return crl::time(std::max(seconds, 1) + 1) * 1000;
+	} else if (error.code() < 0
+		|| error.code() >= 500
+		|| type == u"TIMEOUT"_q) {
+		const auto index = std::clamp(
+			failures - 1,
+			0,
+			int(kRetryDelays.size()) - 1);
+		return kRetryDelays[index];
+	}
+	return std::nullopt;
+}
+
+void Load(not_null<History*> history) {
+	(void)history->session().scheduledMessages().updates(history);
+}
+
+class Punctual final {
+public:
+	explicit Punctual(not_null<Main::Session*> session);
+
+private:
+	struct Attempt {
+		TimeId date = 0;
+		crl::time retryAt = 0;
+		int failures = 0;
+	};
+
+	void refresh();
+	void check();
+	void woke(TimeId gap);
+	void send(
+		not_null<History*> history,
+		std::vector<not_null<HistoryItem*>> items);
+	void request(
+		not_null<PeerData*> peer,
+		QVector<MTPint> ids,
+		std::vector<FullMsgId> items,
+		bool split);
+	void failed(
+		not_null<PeerData*> peer,
+		const std::vector<FullMsgId> &items,
+		const MTP::Error &error);
+	void notifyFailed(
+		not_null<PeerData*> peer,
+		FullMsgId id,
+		const QString &reason);
+	[[nodiscard]] History *pickToSweep(
+		not_null<Dialogs::MainList*> list);
+	void sweep();
+	void scheduleSweep(crl::time delay);
+	[[nodiscard]] History *nextToSweep();
+	[[nodiscard]] bool eligible(not_null<HistoryItem*> item) const;
+
+	const not_null<Main::Session*> _session;
+	MTP::Sender _api;
+	base::Timer _timer;
+	base::Timer _sweepTimer;
+	base::flat_set<PeerId> _tracked;
+	base::flat_set<PeerId> _swept;
+	base::flat_map<FullMsgId, Attempt> _attempted;
+	TimeId _expected = 0;
+	TimeId _sweepStarted = 0;
+	crl::time _holdUntil = 0;
+	bool _enabled = false;
+	rpl::lifetime _lifetime;
+
+};
+
+Punctual::Punctual(not_null<Main::Session*> session)
+: _session(session)
+, _api(&session->mtp())
+, _timer([=] { check(); })
+, _sweepTimer([=] { sweep(); }) {
+	_session->scheduledMessages().allUpdates(
+	) | rpl::on_next([=](not_null<History*> history) {
+		_tracked.emplace(history->peer->id);
+		if (_enabled) {
+			_timer.callOnce(0);
+		}
+	}, _lifetime);
+
+	rpl::merge(
+		_session->data().chatsListChanges() | rpl::to_empty,
+		_session->data().chatsListLoadedEvents() | rpl::to_empty
+	) | rpl::filter([=] {
+		return _enabled && _sweepStarted && !_sweepTimer.isActive();
+	}) | rpl::on_next([=] {
+		scheduleSweep(kSweepFastInterval);
+	}, _lifetime);
+
+	PunctualScheduledChanges(
+	) | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+	refresh();
+}
+
+void Punctual::refresh() {
+	_enabled = PunctualScheduled();
+	_expected = 0;
+	if (!_enabled) {
+		_timer.cancel();
+		_sweepTimer.cancel();
+		return;
+	}
+	if (!_sweepStarted) {
+		_sweepStarted = base::unixtime::now();
+		scheduleSweep(kSweepDelay);
+	} else {
+		scheduleSweep(kSweepFastInterval);
+	}
+	check();
+}
+
+void Punctual::check() {
+	if (!_enabled) {
+		return;
+	}
+	const auto now = base::unixtime::now();
+	if (_expected && now - _expected > kWakeGap) {
+		woke(now - _expected);
+	}
+	const auto hold = _holdUntil - crl::now();
+	if (hold > 0) {
+		_expected = now + TimeId(hold / 1000) + 1;
+		_timer.callOnce(hold);
+		return;
+	}
+	auto &scheduled = _session->scheduledMessages();
+	auto &owner = _session->data();
+	auto due = base::flat_map<
+		not_null<History*>,
+		std::vector<not_null<HistoryItem*>>>();
+	auto earliest = TimeId(0);
+	for (auto i = begin(_tracked); i != end(_tracked);) {
+		const auto history = owner.historyLoaded(*i);
+		if (!history || !scheduled.count(history)) {
+			i = _tracked.erase(i);
+			continue;
+		}
+		for (const auto &id : scheduled.list(history).ids) {
+			const auto item = owner.message(id);
+			if (!item || !eligible(item)) {
+				continue;
+			}
+			const auto date = item->date();
+			if (date <= now) {
+				due[history].push_back(item);
+			} else if (!earliest || date < earliest) {
+				earliest = date;
+			}
+		}
+		++i;
+	}
+	const auto ms = crl::now();
+	auto retry = crl::time(0);
+	for (auto i = begin(_attempted); i != end(_attempted);) {
+		if (!owner.message(i->first)) {
+			i = _attempted.erase(i);
+			continue;
+		} else if (i->second.retryAt > ms
+			&& (!retry || i->second.retryAt < retry)) {
+			retry = i->second.retryAt;
+		}
+		++i;
+	}
+	for (auto &[history, items] : due) {
+		send(history, std::move(items));
+	}
+	auto wait = earliest
+		? std::min(crl::time(earliest - now) * 1000, kMaxWait)
+		: kMaxWait;
+	if (retry) {
+		wait = std::min(wait, retry - ms);
+	}
+	_expected = now + TimeId(wait / 1000);
+	_timer.callOnce(wait);
+}
+
+void Punctual::woke(TimeId gap) {
+	DEBUG_LOG(("Tele Punctual: woke after %1 seconds.").arg(gap));
+	for (const auto &peerId : _tracked) {
+		if (const auto history = _session->data().historyLoaded(peerId)) {
+			Load(history);
+		}
+	}
+	_holdUntil = crl::now() + kWakeHold;
+	const auto now = base::unixtime::now();
+	if (gap >= kResweepGap && now - _sweepStarted >= kResweepGap) {
+		_swept.clear();
+		_sweepStarted = now;
+		scheduleSweep(kWakeHold);
+	}
+}
+
+bool Punctual::eligible(not_null<HistoryItem*> item) const {
+	if (!item->allowsSendNow()
+		|| item->isUploading()
+		|| item->awaitingVideoProcessing()
+		|| item->scheduleRepeatPeriod()
+		|| item->Get<HistoryMessageSuggestion>()
+		|| item->date() == Api::kScheduledUntilOnlineTimestamp) {
+		return false;
+	}
+	const auto i = _attempted.find(item->fullId());
+	return (i == end(_attempted))
+		|| (i->second.date != item->date())
+		|| (i->second.retryAt && i->second.retryAt <= crl::now());
+}
+
+void Punctual::send(
+		not_null<History*> history,
+		std::vector<not_null<HistoryItem*>> items) {
+	ranges::sort(items, ranges::less(), &HistoryItem::date);
+	auto &scheduled = _session->scheduledMessages();
+	auto ids = QVector<MTPint>();
+	auto full = std::vector<FullMsgId>();
+	ids.reserve(items.size());
+	full.reserve(items.size());
+	for (const auto &item : items) {
+		auto &attempt = _attempted[item->fullId()];
+		if (attempt.date != item->date()) {
+			attempt = Attempt{ .date = item->date() };
+		}
+		attempt.retryAt = 0;
+		ids.push_back(MTP_int(scheduled.lookupId(item)));
+		full.push_back(item->fullId());
+	}
+	request(history->peer, std::move(ids), std::move(full), true);
+}
+
+void Punctual::request(
+		not_null<PeerData*> peer,
+		QVector<MTPint> ids,
+		std::vector<FullMsgId> items,
+		bool split) {
+	_api.request(MTPmessages_SendScheduledMessages(
+		peer->input(),
+		MTP_vector<MTPint>(ids)
+	)).done([=](const MTPUpdates &result) {
+		_session->api().applyUpdates(result);
+	}).fail([=](const MTP::Error &error) {
+		LOG(("Tele Punctual: could not send %1 scheduled to %2: %3."
+			).arg(ids.size()
+			).arg(peer->id.value
+			).arg(error.type()));
+		if (split
+			&& ids.size() > 1
+			&& !RetryDelay(error, 1).has_value()) {
+			for (auto i = 0; i != ids.size(); ++i) {
+				request(peer, { ids[i] }, { items[i] }, false);
+			}
+		} else {
+			failed(peer, items, error);
+		}
+	}).send();
+}
+
+void Punctual::failed(
+		not_null<PeerData*> peer,
+		const std::vector<FullMsgId> &items,
+		const MTP::Error &error) {
+	const auto ms = crl::now();
+	auto retry = crl::time(0);
+	for (const auto &id : items) {
+		const auto i = _attempted.find(id);
+		if (i == end(_attempted) || !_session->data().message(id)) {
+			continue;
+		}
+		const auto failures = ++i->second.failures;
+		const auto delay = RetryDelay(error, failures);
+		if (delay && failures <= kMaxRetries) {
+			i->second.retryAt = ms + *delay;
+			if (!retry || i->second.retryAt < retry) {
+				retry = i->second.retryAt;
+			}
+		} else {
+			i->second.retryAt = 0;
+			notifyFailed(peer, id, error.type());
+		}
+	}
+	if (retry && _enabled) {
+		const auto wait = retry - ms;
+		if (!_timer.isActive() || _timer.remainingTime() > wait) {
+			_expected = base::unixtime::now() + TimeId(wait / 1000);
+			_timer.callOnce(wait);
+		}
+	}
+}
+
+void Punctual::notifyFailed(
+		not_null<PeerData*> peer,
+		FullMsgId id,
+		const QString &reason) {
+	const auto text = Lower(u"Couldn't send a scheduled message on time: %1"_q
+	).arg(reason);
+	Notify(_session, {
+		.kind = NoticeKind::Tele,
+		.tone = NoticeTone::Warning,
+		.key = u"punctual:%1:%2"_q.arg(peer->id.value).arg(id.msg.bare),
+		.title = peer->name(),
+		.text = { text },
+		.peer = peer->id.value,
+	});
+	if (const auto window = _session->tryResolveWindow(peer)) {
+		window->showToast(Ui::Toast::Config{
+			.title = peer->name(),
+			.text = { text },
+		});
+	}
+}
+
+void Punctual::scheduleSweep(crl::time delay) {
+	if (!_sweepTimer.isActive() || _sweepTimer.remainingTime() > delay) {
+		_sweepTimer.callOnce(delay);
+	}
+}
+
+History *Punctual::nextToSweep() {
+	auto &owner = _session->data();
+	const auto self = owner.history(_session->userPeerId());
+	if (!_swept.contains(self->peer->id)) {
+		return self;
+	} else if (const auto result = pickToSweep(owner.chatsList())) {
+		return result;
+	}
+	const auto folder = owner.folderLoaded(Data::Folder::kId);
+	if (!folder) {
+		return nullptr;
+	} else if (const auto result = pickToSweep(folder->chatsList())) {
+		return result;
+	} else if (!folder->chatsList()->loaded()) {
+		_session->api().requestDialogs(folder);
+	}
+	return nullptr;
+}
+
+History *Punctual::pickToSweep(not_null<Dialogs::MainList*> list) {
+	const auto &scheduled = _session->scheduledMessages();
+	for (const auto &row : *list->indexed()) {
+		const auto history = row->history();
+		if (!history || _swept.contains(history->peer->id)) {
+			continue;
+		} else if (scheduled.count(history)
+			|| !Data::CanSendAnything(history->peer, false)) {
+			_swept.emplace(history->peer->id);
+			continue;
+		}
+		return history;
+	}
+	return nullptr;
+}
+
+void Punctual::sweep() {
+	if (!_enabled) {
+		return;
+	}
+	const auto history = nextToSweep();
+	if (!history) {
+		return;
+	}
+	_swept.emplace(history->peer->id);
+	Load(history);
+	_sweepTimer.callOnce((int(_swept.size()) < kSweepFastCount)
+		? kSweepFastInterval
+		: kSweepSlowInterval);
+}
+
+} // namespace
+
+void SetupPunctualScheduled(not_null<Main::Session*> session) {
+	session->lifetime().make_state<Punctual>(session);
+}
+
+} // namespace Tele
