+namespace Tele {
+namespace {
+
+constexpr auto kMarkLifetime = TimeId(600);
+constexpr auto kHandoverTimeout = crl::time(10000);
+constexpr auto kHandoverCheck = crl::time(500);
+
+struct Entry {
+	not_null<HistoryItem*> scheduled;
+	FullMsgId fake;
+	MsgId sentId = 0;
+	bool cancel = false;
+};
+
+struct Handover {
+	FullMsgId fake;
+	FullMsgId real;
+	crl::time till = 0;
+};
+
+[[nodiscard]] bool Same(
+		not_null<HistoryItem*> scheduled,
+		not_null<HistoryItem*> item) {
+	const auto a = scheduled->media();
+	const auto b = item->media();
+	return (scheduled->originalText().text == item->originalText().text)
+		&& (!a == !b)
+		&& (!a
+			|| ((a->photo() == b->photo())
+				&& (a->document() == b->document())));
+}
+
+[[nodiscard]] MTPMessageMedia WebPageMedia(not_null<Data::Media*> media) {
+	using PageFlag = MTPDmessageMediaWebPage::Flag;
+	using PendingFlag = MTPDwebPagePending::Flag;
+	const auto page = media->webpage();
+	const auto flags = media->webpageFlags();
+	return MTP_messageMediaWebPage(
+		MTP_flags(PageFlag()
+			| ((flags & MediaWebPageFlag::Manual)
+				? PageFlag::f_manual
+				: PageFlag())
+			| ((flags & MediaWebPageFlag::ForceLargeMedia)
+				? PageFlag::f_force_large_media
+				: PageFlag())
+			| ((flags & MediaWebPageFlag::ForceSmallMedia)
+				? PageFlag::f_force_small_media
+				: PageFlag())),
+		MTP_webPagePending(
+			MTP_flags(PendingFlag::f_url),
+			MTP_long(page->id),
+			MTP_string(page->url),
+			MTP_int(page->pendingTill)));
+}
+
+class Pending final : public base::has_weak_ptr {
+public:
+	explicit Pending(not_null<Main::Session*> session);
+
+	void mark(not_null<History*> history, TimeId date);
+	[[nodiscard]] std::vector<not_null<HistoryItem*>> group(
+		FullMsgId fake) const;
+	void sendNow(FullMsgId fake);
+	void cancel(FullMsgId fake);
+
+private:
+	[[nodiscard]] Entry *find(not_null<const HistoryItem*> scheduled);
+	[[nodiscard]] Entry *findByFake(FullMsgId fake);
+	[[nodiscard]] uint64 fakeGroup(MessageGroupId id);
+	void queue(not_null<History*> history);
+	void refresh(not_null<History*> history);
+	void create(not_null<HistoryItem*> scheduled);
+	void destroyFake(FullMsgId id);
+	void clear();
+	void removed(not_null<const HistoryItem*> item);
+	void aboutToDestroy(const std::vector<not_null<HistoryItem*>> &items);
+	void added(not_null<HistoryItem*> item);
+	void syncFailed();
+	void processCancels();
+	void checkHandovers();
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<not_null<History*>, base::flat_set<TimeId>> _marks;
+	std::vector<Entry> _entries;
+	std::vector<Handover> _handovers;
+	base::flat_map<uint64, uint64> _groups;
+	base::flat_set<not_null<History*>> _queued;
+	base::Timer _timer;
+	bool _cleared = false;
+	rpl::lifetime _lifetime;
+
+};
+
+Pending::Pending(not_null<Main::Session*> session)
+: _session(session)
+, _timer([=] { checkHandovers(); }) {
+	const auto owner = &session->data();
+
+	session->scheduledMessages().allUpdates(
+	) | rpl::on_next([=](not_null<History*> history) {
+		queue(history);
+	}, _lifetime);
+
+	owner->sentFromScheduled(
+	) | rpl::on_next([=](const Data::SentFromScheduled &value) {
+		if (const auto entry = find(value.item)) {
+			entry->sentId = value.sentId;
+		}
+	}, _lifetime);
+
+	owner->itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		removed(item);
+	}, _lifetime);
+
+	owner->itemsAboutToBeDestroyed(
+	) | rpl::on_next([=](const std::vector<not_null<HistoryItem*>> &items) {
+		aboutToDestroy(items);
+	}, _lifetime);
+
+	owner->newItemAdded(
+	) | rpl::on_next([=](not_null<HistoryItem*> item) {
+		added(item);
+	}, _lifetime);
+
+	session->changes().historyUpdates(
+		Data::HistoryUpdate::Flag::ClientSideMessages
+	) | rpl::filter([=] {
+		return !_entries.empty();
+	}) | rpl::on_next([=] {
+		crl::on_main(this, [=] { syncFailed(); });
+	}, _lifetime);
+
+	owner->sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		_cleared = true;
+		_timer.cancel();
+		_entries.clear();
+		_handovers.clear();
+		_marks.clear();
+		_queued.clear();
+	}, _lifetime);
+
+	GhostSchedulePendingChanges(
+	) | rpl::on_next([=](bool enabled) {
+		if (!enabled) {
+			clear();
+			return;
+		}
+		for (const auto &[history, dates] : _marks) {
+			queue(history);
+		}
+	}, _lifetime);
+}
+
+void Pending::mark(not_null<History*> history, TimeId date) {
+	if (_cleared) {
+		return;
+	}
+	const auto old = base::unixtime::now() - kMarkLifetime;
+	for (auto i = begin(_marks); i != end(_marks);) {
+		auto &dates = i->second;
+		dates.erase(begin(dates), dates.lower_bound(old));
+		if (dates.empty()) {
+			i = _marks.erase(i);
+		} else {
+			++i;
+		}
+	}
+	_marks[history].emplace(date);
+}
+
+Entry *Pending::find(not_null<const HistoryItem*> scheduled) {
+	const auto i = ranges::find_if(_entries, [&](const Entry &entry) {
+		return (entry.scheduled.get() == scheduled.get());
+	});
+	return (i != end(_entries)) ? &*i : nullptr;
+}
+
+Entry *Pending::findByFake(FullMsgId fake) {
+	if (!fake) {
+		return nullptr;
+	}
+	const auto i = ranges::find(_entries, fake, &Entry::fake);
+	return (i != end(_entries)) ? &*i : nullptr;
+}
+
+std::vector<not_null<HistoryItem*>> Pending::group(FullMsgId fake) const {
+	if (!fake) {
+		return {};
+	}
+	const auto i = ranges::find(_entries, fake, &Entry::fake);
+	if (i == end(_entries)) {
+		return {};
+	}
+	const auto groupId = i->scheduled->groupId();
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &entry : _entries) {
+		if (entry.fake
+			&& ((entry.scheduled == i->scheduled)
+				|| (groupId && entry.scheduled->groupId() == groupId))) {
+			result.push_back(entry.scheduled);
+		}
+	}
+	return result;
+}
+
+uint64 Pending::fakeGroup(MessageGroupId id) {
+	if (!id) {
+		return 0;
+	}
+	auto &result = _groups[id.raw()];
+	if (!result) {
+		result = base::RandomValue<uint64>();
+	}
+	return result;
+}
+
+void Pending::queue(not_null<History*> history) {
+	if (_cleared || !_queued.emplace(history).second) {
+		return;
+	}
+	crl::on_main(this, [=] {
+		_queued.remove(history);
+		refresh(history);
+	});
+}
+
+void Pending::refresh(not_null<History*> history) {
+	if (_cleared || !GhostSchedulePending()) {
+		return;
+	}
+	const auto i = _marks.find(history);
+	if (i != end(_marks)) {
+		const auto dates = i->second;
+		const auto &owner = _session->data();
+		const auto list = _session->scheduledMessages().list(history);
+		for (const auto &id : list.ids) {
+			const auto item = owner.message(id);
+			if (item
+				&& item->out()
+				&& dates.contains(item->date())
+				&& !find(item)) {
+				create(item);
+			}
+		}
+	}
+	syncFailed();
+	processCancels();
+}
+
+void Pending::create(not_null<HistoryItem*> scheduled) {
+	const auto history = scheduled->history();
+	const auto from = scheduled->from();
+	const auto replyTo = scheduled->replyTo();
+	const auto media = scheduled->media();
+	const auto forwarded = scheduled->Has<HistoryMessageForwarded>();
+	auto flags = MessageFlags(MessageFlag::BeingSent);
+	if (scheduled->out()) {
+		flags |= MessageFlag::Outgoing;
+	}
+	if (from != history->peer) {
+		flags |= MessageFlag::HasFromId;
+	}
+	if (scheduled->isPost()) {
+		flags |= MessageFlag::Post;
+	}
+	if (scheduled->invertMedia()) {
+		flags |= MessageFlag::InvertMedia;
+	}
+	if (replyTo) {
+		flags |= MessageFlag::HasReplyInfo;
+	}
+	auto fields = HistoryItemCommonFields{
+		.id = _session->data().nextLocalMessageId(),
+		.flags = flags,
+		.from = from->id,
+		.replyTo = replyTo,
+		.date = base::unixtime::now(),
+		.groupedId = fakeGroup(scheduled->groupId()),
+		.ignoreForwardFrom = !forwarded,
+		.mediaSpoiler = (media && media->hasSpoiler()),
+	};
+	const auto &text = scheduled->originalText();
+	const auto fake = [&]() -> not_null<HistoryItem*> {
+		if (forwarded) {
+			return history->addNewLocalMessage(std::move(fields), scheduled);
+		} else if (!media) {
+			return history->addNewLocalMessage(
+				std::move(fields),
+				text,
+				MTP_messageMediaEmpty());
+		} else if (media->webpage()) {
+			return history->addNewLocalMessage(
+				std::move(fields),
+				text,
+				WebPageMedia(media));
+		} else if (const auto photo = media->photo()) {
+			return history->addNewLocalMessage(
+				std::move(fields),
+				photo,
+				text);
+		} else if (const auto document = media->document()) {
+			return history->addNewLocalMessage(
+				std::move(fields),
+				document,
+				text);
+		}
+		return history->addNewLocalMessage(std::move(fields), scheduled);
+	}();
+	_entries.push_back({ .scheduled = scheduled, .fake = fake->fullId() });
+	if (scheduled->hasFailed() && fake->isSending()) {
+		fake->sendFailed();
+	}
+}
+
+void Pending::destroyFake(FullMsgId id) {
+	const auto fake = id ? _session->data().message(id) : nullptr;
+	if (!fake) {
+		return;
+	}
+	const auto history = fake->history();
+	const auto wasLast = (history->lastMessage() == fake);
+	const auto wasInChats = (history->chatListMessage() == fake);
+	fake->destroy();
+	if (wasLast || wasInChats) {
+		history->requestChatListMessage();
+	}
+}
+
+void Pending::clear() {
+	auto fakes = std::vector<FullMsgId>();
+	for (auto &entry : _entries) {
+		if (entry.fake) {
+			fakes.push_back(base::take(entry.fake));
+		}
+	}
+	for (const auto &handover : base::take(_handovers)) {
+		fakes.push_back(handover.fake);
+	}
+	_entries.clear();
+	_groups.clear();
+	_timer.cancel();
+	for (const auto &id : fakes) {
+		destroyFake(id);
+	}
+}
+
+void Pending::removed(not_null<const HistoryItem*> item) {
+	if (_entries.empty() && _handovers.empty()) {
+		return;
+	}
+	const auto id = item->fullId();
+	if (const auto entry = findByFake(id)) {
+		entry->fake = FullMsgId();
+	}
+	_handovers.erase(
+		ranges::remove(_handovers, id, &Handover::fake),
+		end(_handovers));
+	const auto i = ranges::find_if(_entries, [&](const Entry &entry) {
+		return (entry.scheduled.get() == item.get());
+	});
+	if (i == end(_entries)) {
+		return;
+	}
+	const auto entry = *i;
+	_entries.erase(i);
+	if (_entries.empty()) {
+		_groups.clear();
+	}
+	if (!entry.fake) {
+		return;
+	}
+	const auto history = item->history();
+	if (entry.sentId) {
+		_handovers.push_back({
+			.fake = entry.fake,
+			.real = FullMsgId(history->peer->id, entry.sentId),
+			.till = crl::now() + kHandoverTimeout,
+		});
+		if (!_timer.isActive()) {
+			_timer.callEach(kHandoverCheck);
+		}
+	} else {
+		_handovers.push_back({ .fake = entry.fake });
+		queue(history);
+	}
+	crl::on_main(this, [=] { checkHandovers(); });
+}
+
+void Pending::aboutToDestroy(
+		const std::vector<not_null<HistoryItem*>> &items) {
+	if (_entries.empty()) {
+		return;
+	}
+	auto cancelled = false;
+	for (const auto &item : items) {
+		if (const auto entry = findByFake(item->fullId())) {
+			entry->fake = FullMsgId();
+			entry->cancel = true;
+			cancelled = true;
+		}
+	}
+	if (cancelled) {
+		crl::on_main(this, [=] { processCancels(); });
+	}
+}
+
+void Pending::added(not_null<HistoryItem*> item) {
+	if (_entries.empty() && _handovers.empty()) {
+		return;
+	}
+	const auto id = item->fullId();
+	auto ready = std::vector<FullMsgId>();
+	for (auto i = begin(_handovers); i != end(_handovers);) {
+		if (i->real == id) {
+			ready.push_back(i->fake);
+			i = _handovers.erase(i);
+		} else {
+			++i;
+		}
+	}
+	if (item->isFromScheduled() && item->isRegular()) {
+		for (auto &entry : _entries) {
+			if (entry.fake
+				&& !entry.sentId
+				&& entry.scheduled->history() == item->history()
+				&& Same(entry.scheduled, item)) {
+				ready.push_back(base::take(entry.fake));
+				break;
+			}
+		}
+	}
+	if (!ready.empty()) {
+		crl::on_main(this, [=] {
+			for (const auto &fake : ready) {
+				destroyFake(fake);
+			}
+		});
+	}
+}
+
+void Pending::syncFailed() {
+	const auto &owner = _session->data();
+	for (const auto &entry : _entries) {
+		if (!entry.fake || !entry.scheduled->hasFailed()) {
+			continue;
+		} else if (const auto fake = owner.message(entry.fake)) {
+			if (fake->isSending()) {
+				fake->sendFailed();
+			}
+		}
+	}
+}
+
+void Pending::processCancels() {
+	auto ids = MessageIdsList();
+	for (auto &entry : _entries) {
+		const auto item = entry.scheduled;
+		if (!entry.cancel || (item->isSending() && !item->isUploading())) {
+			continue;
+		}
+		entry.cancel = false;
+		ids.push_back(item->fullId());
+	}
+	if (!ids.empty()) {
+		_session->data().histories().deleteMessages(ids, true);
+	}
+}
+
+void Pending::checkHandovers() {
+	const auto now = crl::now();
+	const auto &owner = _session->data();
+	auto ready = std::vector<FullMsgId>();
+	for (auto i = begin(_handovers); i != end(_handovers);) {
+		if (!i->real || i->till <= now || owner.message(i->real)) {
+			ready.push_back(i->fake);
+			i = _handovers.erase(i);
+		} else {
+			++i;
+		}
+	}
+	if (_handovers.empty()) {
+		_timer.cancel();
+	}
+	for (const auto &fake : ready) {
+		destroyFake(fake);
+	}
+}
+
+void Pending::sendNow(FullMsgId fake) {
+	const auto list = group(fake);
+	if (list.empty()) {
+		return;
+	}
+	auto ids = QVector<MTPint>();
+	for (const auto &item : list) {
+		if (!item->allowsSendNow()) {
+			return;
+		}
+		ids.push_back(MTP_int(_session->scheduledMessages().lookupId(item)));
+	}
+	const auto session = _session;
+	const auto peer = list.front()->history()->peer;
+	session->api().request(MTPmessages_SendScheduledMessages(
+		peer->input(),
+		MTP_vector<MTPint>(ids)
+	)).done([=](const MTPUpdates &result) {
+		session->api().applyUpdates(result);
+		OfflineAfterSend(session);
+	}).fail([=](const MTP::Error &error) {
+		session->api().sendMessageFail(error, peer);
+	}).send();
+}
+
+void Pending::cancel(FullMsgId fake) {
+	for (const auto &item : group(fake)) {
+		if (const auto entry = find(item)) {
+			const auto id = base::take(entry->fake);
+			entry->cancel = true;
+			destroyFake(id);
+		}
+	}
+	processCancels();
+}
+
+[[nodiscard]] auto Sessions()
+-> base::flat_map<not_null<Main::Session*>, std::unique_ptr<Pending>> & {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Pending>>();
+	return result;
+}
+
+[[nodiscard]] Pending *Lookup(not_null<Main::Session*> session) {
+	const auto &sessions = Sessions();
+	const auto i = sessions.find(session);
+	return (i != end(sessions)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] not_null<Pending*> Resolve(not_null<Main::Session*> session) {
+	auto &sessions = Sessions();
+	auto i = sessions.find(session);
+	if (i == end(sessions)) {
+		i = sessions.emplace(
+			session,
+			std::make_unique<Pending>(session)).first;
+		session->lifetime().add([=] {
+			Sessions().remove(session);
+		});
+	}
+	return i->second.get();
+}
+
+} // namespace
+
+void MarkGhostScheduled(not_null<History*> history, TimeId date) {
+	Resolve(&history->session())->mark(history, date);
+}
+
+void AddGhostPendingActions(
+		not_null<Ui::PopupMenu*> menu,
+		HistoryItem *item) {
+	if (!item || !GhostSchedulePending()) {
+		return;
+	}
+	const auto pending = Lookup(&item->history()->session());
+	if (!pending) {
+		return;
+	}
+	const auto list = pending->group(item->fullId());
+	if (list.empty()) {
+		return;
+	}
+	const auto id = item->fullId();
+	const auto weak = base::make_weak(pending);
+	const auto ready = ranges::all_of(list, [](
+			not_null<HistoryItem*> scheduled) {
+		return scheduled->allowsSendNow();
+	});
+	if (ready) {
+		menu->addAction(tr::lng_context_send_now_msg(tr::now), [=] {
+			if (const auto strong = weak.get()) {
+				strong->sendNow(id);
+			}
+		}, &st::menuIconSend);
+	}
+	menu->addAction(Lower(u"Cancel sending"_q), [=] {
+		if (const auto strong = weak.get()) {
+			strong->cancel(id);
+		}
+	}, &st::menuIconCancel);
+}
+
+} // namespace Tele
