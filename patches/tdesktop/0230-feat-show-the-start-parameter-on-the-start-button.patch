+++ b/Telegram/SourceFiles/tele/tele_start_param.cpp
@@ -0,0 +1,148 @@
+#include "tele/tele_start_param.h"
+
+#include "base/event_filter.h"
+#include "data/data_user.h"
+#include "tele/tele_options.h"
+#include "ui/text/text_entity.h"
+#include "ui/ui_utility.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/tooltip.h"
+#include "styles/style_chat_helpers.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kTooltipDelay = crl::time(500);
+
+class ParamWatcher final
+	: public QObject
+	, public Ui::AbstractTooltipShower {
+public:
+	explicit ParamWatcher(not_null<Ui::FlatButton*> button);
+
+	void apply(const QString &param);
+
+	QString tooltipText() const override;
+	QPoint tooltipPos() const override;
+	bool tooltipWindowActive() const override;
+
+private:
+	[[nodiscard]] bool shown() const;
+	void refresh();
+
+	const not_null<Ui::FlatButton*> _button;
+	QString _param;
+	QString _base;
+	QString _set;
+	bool _applied = false;
+	rpl::lifetime _lifetime;
+
+};
+
+ParamWatcher::ParamWatcher(not_null<Ui::FlatButton*> button)
+: QObject(button.get())
+, _button(button) {
+	base::install_event_filter(this, _button, [=](not_null<QEvent*> e) {
+		switch (e->type()) {
+		case QEvent::Resize:
+			refresh();
+			break;
+		case QEvent::Enter:
+			if (shown()) {
+				Ui::Tooltip::Show(kTooltipDelay, this);
+			}
+			break;
+		case QEvent::Leave:
+		case QEvent::Hide:
+		case QEvent::MouseButtonPress:
+			if (shown()) {
+				Ui::Tooltip::Hide();
+			}
+			break;
+		default:
+			break;
+		}
+		return base::EventFilterResult::Continue;
+	});
+	ShowStartParamChanges(
+	) | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+}
+
+void ParamWatcher::apply(const QString &param) {
+	_param = param;
+	refresh();
+}
+
+bool ParamWatcher::shown() const {
+	return ShowStartParam() && !_param.isEmpty();
+}
+
+void ParamWatcher::refresh() {
+	const auto current = _button->accessibilityName();
+	if (!_applied || current != _set) {
+		_base = current;
+	}
+	_applied = shown();
+	if (!_applied) {
+		_set = QString();
+		if (current != _base) {
+			_button->setText(_base);
+		}
+		return;
+	}
+	const auto &st = st::historyComposeButton;
+	const auto available = std::max(_button->width() - std::abs(st.width), 0);
+	_set = st.font->elided(
+		_base + u" \u00B7 "_q + TextUtilities::SingleLine(_param),
+		available);
+	if (current != _set) {
+		_button->setText(_set);
+	}
+}
+
+QString ParamWatcher::tooltipText() const {
+	return shown() ? _param : QString();
+}
+
+QPoint ParamWatcher::tooltipPos() const {
+	return QCursor::pos();
+}
+
+bool ParamWatcher::tooltipWindowActive() const {
+	return Ui::AppInFocus() && Ui::InFocusChain(_button->window());
+}
+
+[[nodiscard]] not_null<ParamWatcher*> Watcher(
+		not_null<Ui::FlatButton*> button) {
+	for (const auto child : button->children()) {
+		if (const auto watcher = dynamic_cast<ParamWatcher*>(child)) {
+			return watcher;
+		}
+	}
+	return new ParamWatcher(button);
+}
+
+[[nodiscard]] QString StartToken(PeerData *peer) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	const auto info = user ? user->botInfo.get() : nullptr;
+	return info ? info->startToken : QString();
+}
+
+} // namespace
+
+void RefreshBotStartParam(not_null<Ui::FlatButton*> button, PeerData *peer) {
+	Watcher(button)->apply(StartToken(peer));
+}
+
+void RefreshBotRestartParam(
+		not_null<Ui::FlatButton*> button,
+		PeerData *peer) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	Watcher(button)->apply((user && !user->isSupport())
+		? StartToken(peer)
+		: QString());
+}
+
+} // namespace Tele
