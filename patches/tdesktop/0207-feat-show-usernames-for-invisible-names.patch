+State &Get();
+
+void Refresh(not_null<PeerData*> peer) {
+	auto &state = Get();
+	const auto i = state.peers.find(peer);
+	if (i == end(state.peers)) {
+		return;
+	}
+	const auto real = i->second.real;
+	if (const auto user = peer->asUser()) {
+		user->setName(
+			user->firstName,
+			user->lastName,
+			user->nameOrPhone,
+			user->editableUsername());
+	} else if (const auto chat = peer->asChat()) {
+		chat->setName(real);
+	} else if (const auto channel = peer->asChannel()) {
+		channel->setName(real, channel->editableUsername());
+	}
+}
+
+void RefreshAll() {
+	auto list = std::vector<not_null<PeerData*>>();
+	list.reserve(Get().peers.size());
+	for (const auto &[peer, entry] : Get().peers) {
+		list.push_back(peer);
+	}
+	for (const auto peer : list) {
+		Refresh(peer);
+	}
+}
+
+State::State() {
+	rpl::merge(
+		InvisibleNamesValue() | rpl::skip(1) | rpl::to_empty,
+		InvisibleNamesFallbackValue() | rpl::skip(1) | rpl::to_empty,
+		InvisibleNamesPhraseValue() | rpl::skip(1) | rpl::to_empty,
+		base::options::details::Lookup(kOptionBotApiPeerIds).changes(),
+		base::options::details::Lookup(
+			kOptionPeerIdsWithoutSpaces).changes()
+	) | rpl::on_next([] {
+		RefreshAll();
+	}, lifetime);
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+void Track(not_null<Main::Session*> session) {
+	if (!Get().sessions.emplace(session).second) {
+		return;
+	}
+	using Flag = Data::PeerUpdate::Flag;
+	session->changes().peerUpdates(
+		Flag::Username | Flag::Usernames
+	) | rpl::filter([](const Data::PeerUpdate &update) {
+		return InvisibleNames() && Get().peers.contains(update.peer);
+	}) | rpl::on_next([](const Data::PeerUpdate &update) {
+		Refresh(update.peer);
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		auto &state = Get();
+		state.sessions.remove(session);
+		for (auto i = begin(state.peers); i != end(state.peers);) {
+			if (i->second.session == session) {
+				i = state.peers.erase(i);
+			} else {
+				++i;
+			}
+		}
+	});
+}
+
+[[nodiscard]] bool IsBlankName(const QString &name) {
+	return name.isEmpty() || IsInvisibleText(name);
+}
+
+[[nodiscard]] QString Phrase() {
+	const auto phrase = InvisibleNamesPhrase();
+	return phrase.isEmpty() ? DefaultInvisibleNamesPhrase() : phrase;
+}
+
+[[nodiscard]] QString Replacement(
+		not_null<PeerData*> peer,
+		const QString &username) {
+	const auto &usernames = peer->usernames();
+	const auto value = !usernames.empty()
+		? usernames.front()
+		: !username.isEmpty()
+		? username
+		: peer->username();
+	if (!value.isEmpty()) {
+		return '@' + value;
+	} else if (InvisibleNamesFallback() == u"id"_q) {
+		return Lower(u"ID %1"_q).arg(FormatPeerId(peer));
+	}
+	return Phrase();
+}
+
+[[nodiscard]] bool IsShownReplacement(const QString &name) {
+	if (name.isEmpty() || !InvisibleNames()) {
+		return false;
+	}
+	for (const auto &[peer, entry] : Get().peers) {
+		if (entry.shown == name) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] Ui::Text::MarkedContext NameContext(
+		const style::TextStyle &st) {
+	return {
+		.customEmojiFactory = [st = &st](
+				QStringView data,
+				const Ui::Text::MarkedContext &context) {
+			return MakeNameObject(data, *st);
+		},
+	};
+}
+
+[[nodiscard]] bool IsCombining(char32_t ch) {
+	const auto category = QChar::category(ch);
+	return (category == QChar::Mark_NonSpacing)
+		|| (category == QChar::Mark_SpacingCombining)
+		|| (category == QChar::Mark_Enclosing);
+}
+
+} // namespace
+
+bool IsInvisibleChar(char32_t ch) {
+	if (QChar::isSpace(ch)) {
+		return true;
+	}
+	switch (ch) {
+	case 0x00AD:
+	case 0x034F:
+	case 0x061C:
+	case 0x115F:
+	case 0x1160:
+	case 0x17B4:
+	case 0x17B5:
+	case 0x2800:
+	case 0x3164:
+	case 0xFEFF:
+	case 0xFFA0:
+	case 0x1D159:
+		return true;
+	}
+	return (ch >= 0x180B && ch <= 0x180F)
+		|| (ch >= 0x200B && ch <= 0x200F)
+		|| (ch >= 0x2028 && ch <= 0x202E)
+		|| (ch >= 0x2060 && ch <= 0x2064)
+		|| (ch >= 0x2066 && ch <= 0x206F)
+		|| (ch >= 0xFE00 && ch <= 0xFE0F)
+		|| (ch >= 0x1D173 && ch <= 0x1D17A)
+		|| (ch >= 0xE0000 && ch <= 0xE007F)
+		|| (ch >= 0xE0100 && ch <= 0xE01EF);
+}
+
+bool IsInvisibleText(const QString &text) {
+	return !text.isEmpty()
+		&& EnumerateCodePoints(text, [](int, int, char32_t code) {
+			return IsInvisibleChar(code);
+		});
+}
+
+QString InvisibleCharName(char32_t ch) {
+	const auto name = [&] {
+		if (ch >= 0xFE00 && ch <= 0xFE0F) {
+			return u"Variation selector-%1"_q.arg(int(ch - 0xFE00 + 1));
+		} else if (ch >= 0xE0100 && ch <= 0xE01EF) {
+			return u"Variation selector-%1"_q.arg(int(ch - 0xE0100 + 17));
+		}
+		for (const auto &entry : kNames) {
+			if (entry.code == ch) {
+				return QString::fromLatin1(entry.name);
+			}
+		}
+		return (ch >= 0xE0000 && ch <= 0xE007F)
+			? TagName(ch)
+			: QString();
+	}();
+	return name.isEmpty() ? (u"U+"_q + HexCode(ch)) : Lower(name);
+}
+
+QString ApplyInvisibleName(
+		not_null<PeerData*> peer,
+		const QString &name,
+		const QString &username) {
+	auto &state = Get();
+	const auto i = state.peers.find(peer);
+	const auto real = (i != end(state.peers)
+		&& !i->second.shown.isEmpty()
+		&& name == i->second.shown)
+		? i->second.real
+		: name;
+	if (peer->isSelf() || !IsBlankName(real)) {
+		if (i != end(state.peers)) {
+			state.peers.erase(i);
+		}
+		return real;
+	}
+	const auto session = &peer->session();
+	Track(session);
+	auto shown = InvisibleNames() ? Replacement(peer, username) : QString();
+	const auto result = shown.isEmpty() ? real : shown;
+	if (i != end(state.peers)) {
+		i->second.real = real;
+		i->second.shown = std::move(shown);
+	} else {
+		state.peers.emplace(peer, Entry{
+			.session = session,
+			.real = real,
+			.shown = std::move(shown),
+		});
+	}
+	return result;
+}
+
+bool InvisibleShortName(not_null<const UserData*> user) {
+	return InvisibleNames()
+		&& !user->isSelf()
+		&& IsBlankName(user->firstName.isEmpty()
+			? user->lastName
+			: user->firstName);
+}
+
+QString NormalizeInvisibleNamesPhrase(const QString &value) {
+	return TextUtilities::SingleLine(value).trimmed().left(kMaxPhraseLength);
+}
+
+QString DefaultInvisibleNamesPhrase() {
+	return Lower(u"Unknown name"_q);
+}
+
+TextWithEntities InvisibleNameMarked(const QString &name) {
+	auto result = TextWithEntities{ name };
+	if (!IsShownReplacement(name)) {
+		return result;
+	}
+	const auto prefix = NamePrefix();
+	auto chunkStart = -1;
+	auto chunkEnd = 0;
+	const auto flush = [&] {
+		if (chunkStart < 0) {
+			return;
+		}
+		const auto length = chunkEnd - chunkStart;
+		result.entities.push_back({
+			EntityType::CustomEmoji,
+			chunkStart,
+			length,
+			prefix + name.mid(chunkStart, length),
+		});
+	};
+	EnumerateCodePoints(name, [&](int offset, int length, char32_t code) {
+		if (chunkStart < 0 || !IsCombining(code)) {
+			flush();
+			chunkStart = offset;
+		}
+		chunkEnd = offset + length;
+		return true;
+	});
+	flush();
+	return result;
+}
+
+std::unique_ptr<Ui::Text::CustomEmoji> MakeNameObject(
+		QStringView data,
+		const style::TextStyle &st) {
+	const auto prefix = NamePrefix();
+	if (!data.startsWith(prefix) || data.size() == prefix.size()) {
+		return nullptr;
+	}
+	return std::make_unique<NameObject>(
+		data.toString(),
+		data.mid(prefix.size()).toString(),
+		st.font->italic());
+}
+
+void SetNameText(
+		Ui::Text::String &text,
+		const style::TextStyle &st,
+		const QString &name,
+		const TextParseOptions &options) {
+	if (!IsShownReplacement(name)) {
+		text.setText(st, name, options);
+		return;
+	}
+	text.setMarkedText(st, InvisibleNameMarked(name), options, NameContext(st));
+}
+
+void SetProfileNameText(
+		Ui::Text::String &text,
+		const style::TextStyle &st,
+		const QString &name,
+		const TextParseOptions &options) {
+	SetNameText(text, st, name, options);
+}
+
+} // namespace Tele
