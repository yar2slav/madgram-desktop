+void InvisibleNamesPhraseBox(not_null<Ui::GenericBox*> box) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionInvisibleNamesPhrase);
+	box->setTitle(rpl::single(::Tele::Lower(option.name())));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(::Tele::DefaultInvisibleNamesPhrase()),
+		::Tele::InvisibleNamesPhrase()));
+	const auto save = [=] {
+		const auto phrase = ::Tele::NormalizeInvisibleNamesPhrase(
+			field->getLastText());
+		if (phrase.isEmpty()) {
+			field->showError();
+			return;
+		}
+		::Tele::SetInvisibleNamesPhrase(phrase);
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+		field->selectAll();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(::Tele::Lower(u"Reset"_q)), [=] {
+		::Tele::SetInvisibleNamesPhrase(QString());
+		box->closeBox();
+	});
+}
+
+void AddInvisibleNamesPhrase(SectionBuilder &builder) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionInvisibleNamesPhrase);
+	const auto controller = builder.controller();
+	const auto name = ::Tele::Lower(option.name());
+	WithParent(builder, option.id(), name, {
+		::Tele::kOptionInvisibleNames,
+		Off(::Tele::kOptionInvisibleNamesFallback),
+	}, [&] {
+		const auto button = AddButton(builder, {
+			.id = option.id(),
+			.title = rpl::single(name),
+			.st = &st::settingsButtonNoIcon,
+			.label = ::Tele::InvisibleNamesPhraseValue(
+			) | rpl::map([](const QString &phrase) {
+				return phrase.isEmpty()
+					? ::Tele::DefaultInvisibleNamesPhrase()
+					: phrase;
+			}),
+			.onClick = [=] {
+				controller->show(Box(InvisibleNamesPhraseBox));
+			},
+			.keywords = { u"unknown name"_q, u"placeholder"_q },
+		});
+		if (button) {
+			SetupLink(button, option.id());
+		}
+	});
+}
