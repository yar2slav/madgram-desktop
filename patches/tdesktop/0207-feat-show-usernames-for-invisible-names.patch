+template <typename Callback>
+bool EnumerateCodePoints(const QString &text, Callback &&callback) {
+	const auto size = int(text.size());
+	for (auto i = 0; i != size;) {
+		const auto ch = text[i];
+		if (ch.isHighSurrogate()) {
+			if (i + 1 == size || !text[i + 1].isLowSurrogate()) {
+				return false;
+			}
+			const auto code = char32_t(QChar::surrogateToUcs4(
+				ch,
+				text[i + 1]));
+			if (!callback(i, 2, code)) {
+				return false;
+			}
+			i += 2;
+		} else if (ch.isLowSurrogate()) {
+			return false;
+		} else {
+			if (!callback(i, 1, char32_t(ch.unicode()))) {
+				return false;
+			}
+			++i;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString HexCode(char32_t ch) {
+	return QString::number(uint(ch), 16).toUpper().rightJustified(
+		4,
+		QChar('0'));
+}
+
+[[nodiscard]] QString TagName(char32_t ch) {
+	const auto c = char32_t(ch - 0xE0000);
+	if (c >= U'a' && c <= U'z') {
+		return u"Tag latin small letter "_q + QChar(char16_t(c));
+	} else if (c >= U'A' && c <= U'Z') {
+		return u"Tag latin capital letter "_q
+			+ QChar(char16_t(c - U'A' + U'a'));
+	} else if (c >= U'0' && c <= U'9') {
+		return u"Tag digit "_q + QString::fromLatin1(kDigits[c - U'0']);
+	}
+	for (const auto &entry : kTagPunctuation) {
+		if (entry.code == c) {
+			return u"Tag "_q + QString::fromLatin1(entry.name);
+		}
+	}
+	return QString();
+}
