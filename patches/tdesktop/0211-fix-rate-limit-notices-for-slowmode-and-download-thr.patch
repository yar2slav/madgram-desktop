@@ -7,6 +7,7 @@ struct FloodWait {
 	mtpTypeId request = 0;
 	int seconds = 0;
 	bool resent = false;
+	QString error;
 };
 
 [[nodiscard]] int FloodWaitSeconds(const QString &error);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 01ab97025d3edb399815c0f018149e1e4de6181e..04e00df593eea6d5fb148706c253432146857a6e 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -136,6 +136,7 @@ const char kOptionSilentPerChat[] = "tele-silent-per-chat";
 const char kOptionOnlineNotify[] = "tele-online-notify";
 const char kOptionNotices[] = "tele-notices";
 const char kOptionNoticesLimits[] = "tele-notices-limits";
+const char kOptionNoticesLogLimits[] = "tele-notices-log-limits";
 const char kOptionNoticesTeleToasts[] = "tele-notices-tele-toasts";
 const char kOptionSilenceChats[] = "tele-silence-chats";
 const char kOptionMuteFolders[] = "tele-mute-folders";
@@ -1007,6 +1008,12 @@ base::options::toggle NoticesLimitsOption({
 	.defaultValue = false,
 });
 
+base::options::toggle NoticesLogLimitsOption({
+	.id = kOptionNoticesLogLimits,
+	.name = "Log rate limits",
+	.defaultValue = true,
+});
+
 base::options::toggle NoticesTeleToastsOption({
 	.id = kOptionNoticesTeleToasts,
 	.name = "Log tele toasts",
@@ -2422,6 +2429,10 @@ bool NoticesLimits() {
 	return NoticesLimitsOption.value();
 }
 
+bool NoticesLogLimits() {
+	return NoticesLogLimitsOption.value();
+}
+
 bool NoticesTeleToasts() {
 	return NoticesTeleToastsOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index cff6c4b2c05556f52dd22e66aaffc5e5cc6b2698..a9dbf34c6111c59502bf03e7c9995fef682b55fa 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -131,6 +131,7 @@ extern const char kOptionSilentPerChat[];
 extern const char kOptionOnlineNotify[];
 extern const char kOptionNotices[];
 extern const char kOptionNoticesLimits[];
+extern const char kOptionNoticesLogLimits[];
 extern const char kOptionNoticesTeleToasts[];
 extern const char kOptionSilenceChats[];
 extern const char kOptionMuteFolders[];
@@ -397,6 +398,7 @@ void ClearMessageMenuLegacy();
 [[nodiscard]] bool NoticesCentre();
 [[nodiscard]] rpl::producer<bool> NoticesCentreValue();
 [[nodiscard]] bool NoticesLimits();
+[[nodiscard]] bool NoticesLogLimits();
 [[nodiscard]] bool NoticesTeleToasts();
 [[nodiscard]] bool SilenceChats();
 [[nodiscard]] bool MuteFolders();
diff --git a/Telegram/SourceFiles/tele/tele_rate_limits.cpp b/Telegram/SourceFiles/tele/tele_rate_limits.cpp
index c77abaea159bb771a164495f5a4f46816a8da3c8..f2a1f08775d42348876d2996754d0fff5ed2b237 100644
--- a/Telegram/SourceFiles/tele/tele_rate_limits.cpp
+++ b/Telegram/SourceFiles/tele/tele_rate_limits.cpp
@@ -92,6 +92,30 @@ struct BarState {
 	return Action::Other;
 }
 
+[[nodiscard]] bool Transfer(mtpTypeId request) {
+	switch (request) {
+	case mtpc_upload_getFile:
+	case mtpc_upload_getWebFile:
+	case mtpc_upload_getCdnFile:
+	case mtpc_upload_getFileHashes:
+	case mtpc_upload_getCdnFileHashes:
+	case mtpc_upload_reuploadCdnFile:
+	case mtpc_upload_saveFilePart:
+	case mtpc_upload_saveBigFilePart:
+		return true;
+	}
+	return false;
+}
+
+[[nodiscard]] bool Tracked(const FloodWait &event) {
+	if (event.error.startsWith(u"SLOWMODE_WAIT_"_q)) {
+		return false;
+	} else if (event.error.startsWith(u"FLOOD_PREMIUM_WAIT_"_q)) {
+		return !Transfer(event.request);
+	}
+	return true;
+}
+
 [[nodiscard]] QString Duration(int seconds) {
 	if (seconds >= 3600) {
 		const auto minutes = (seconds % 3600) / 60;
@@ -156,8 +180,12 @@ struct BarState {
 	return nullptr;
 }
 
-[[nodiscard]] bool Enabled() {
-	return NoticesCentre() && NoticesLimits();
+[[nodiscard]] bool Shown() {
+	return NoticesLimits();
+}
+
+[[nodiscard]] bool Logged() {
+	return NoticesCentre() && NoticesLogLimits();
 }
 
 class RateLimits final {
@@ -232,7 +260,7 @@ rpl::producer<> RateLimits::barChanges() const {
 }
 
 std::optional<BarState> RateLimits::bar() const {
-	if (!Enabled()) {
+	if (!Shown()) {
 		return std::nullopt;
 	}
 	const auto now = crl::now();
@@ -272,7 +300,9 @@ void RateLimits::dismissBar() {
 }
 
 void RateLimits::wait(const FloodWait &event) {
-	if (!Enabled() || event.seconds <= 0) {
+	if ((!Shown() && !Logged())
+		|| event.seconds <= 0
+		|| !Tracked(event)) {
 		return;
 	}
 	const auto action = Classify(event.request);
@@ -306,12 +336,14 @@ void RateLimits::wait(const FloodWait &event) {
 	if (event.requestId) {
 		i->requests.emplace(event.requestId);
 	}
-	log(*i);
+	if (Logged()) {
+		log(*i);
+	}
 	const auto wait = i->deadline - i->started;
-	if (wait >= kToastFrom * crl::time(1000)) {
+	if (Shown() && wait >= kToastFrom * crl::time(1000)) {
 		toast(*i, now);
 	}
-	if (wait >= kBarFrom * crl::time(1000)) {
+	if (Shown() && wait >= kBarFrom * crl::time(1000)) {
 		_barChanges.fire({});
 	}
 	if (!_timer.isActive()) {
@@ -368,17 +400,16 @@ void RateLimits::finish(const Limit &limit) {
 		strong->hideAnimated();
 	}
 	_barChanges.fire({});
-	if (!Enabled()) {
-		return;
-	}
 	const auto total = Seconds(limit.deadline - limit.started);
-	Notify(_session, {
-		.kind = NoticeKind::Limit,
-		.key = u"limit-end:"_q + limit.episode + ':' + limit.key,
-		.title = Again(limit),
-		.text = { Lower(u"After %1"_q).arg(Duration(total)) },
-	});
-	if (total >= kExpiryToastFrom) {
+	if (Logged()) {
+		Notify(_session, {
+			.kind = NoticeKind::Limit,
+			.key = u"limit-end:"_q + limit.episode + ':' + limit.key,
+			.title = Again(limit),
+			.text = { Lower(u"After %1"_q).arg(Duration(total)) },
+		});
+	}
+	if (Shown() && total >= kExpiryToastFrom) {
 		if (const auto window = _session->tryResolveWindow()) {
 			window->showToast(Again(limit));
 		}
