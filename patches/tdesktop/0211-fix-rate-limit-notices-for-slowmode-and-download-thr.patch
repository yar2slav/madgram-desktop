From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 4 Oct 2026 11:21:01 +0300
Subject: [PATCH] fix: rate limit notices for slowmode and download throttling

---
 Telegram/SourceFiles/mtproto/mtp_instance.cpp | 13 +++-
 .../SourceFiles/settings/settings_tele.cpp    | 10 ++-
 Telegram/SourceFiles/tele/tele_flood_wait.h   |  1 +
 Telegram/SourceFiles/tele/tele_options.cpp    | 11 ++++
 Telegram/SourceFiles/tele/tele_options.h      |  2 +
 .../SourceFiles/tele/tele_rate_limits.cpp     | 65 ++++++++++++++-----
 .../SourceFiles/tele/tele_settings_io.cpp     |  1 +
 7 files changed, 81 insertions(+), 22 deletions(-)

diff --git a/Telegram/SourceFiles/mtproto/mtp_instance.cpp b/Telegram/SourceFiles/mtproto/mtp_instance.cpp
index 847a0d9ed5f2098aafb9e4685d02aaac421614c4..efd8741e79467c0381834b6257ae9a763793a850 100644
--- a/Telegram/SourceFiles/mtproto/mtp_instance.cpp
+++ b/Telegram/SourceFiles/mtproto/mtp_instance.cpp
@@ -196,7 +196,11 @@ private:
 	void failOverAuthImports(ShiftedDcId shiftedDcId);
 	void restartAuthImport(DcId dcId, mtpRequestId requestId);
 	bool onErrorDefault(const Error &error, const Response &response);
-	void teleFloodEvent(mtpRequestId requestId, int seconds, bool resent);
+	void teleFloodEvent(
+		mtpRequestId requestId,
+		int seconds,
+		bool resent,
+		const QString &error = QString());
 
 	void unpaused();
 
@@ -585,7 +589,8 @@ rpl::producer<Tele::FloodWait> Instance::Private::teleFloodWaits() const {
 void Instance::Private::teleFloodEvent(
 		mtpRequestId requestId,
 		int seconds,
-		bool resent) {
+		bool resent,
+		const QString &error) {
 	if (!requestId || seconds < 0) {
 		return;
 	}
@@ -606,6 +611,7 @@ void Instance::Private::teleFloodEvent(
 		.request = request,
 		.seconds = seconds,
 		.resent = resent,
+		.error = error,
 	});
 }
 
@@ -1271,7 +1277,8 @@ bool Instance::Private::rpcErrorOccured(
 	teleFloodEvent(
 		response.requestId,
 		Tele::FloodWaitSeconds(error.type()),
-		false);
+		false,
+		error.type());
 	if (IsDefaultHandledError(error)) {
 		const auto guard = QPointer<Instance>(_instance);
 		if (onFail && onFail(error, response)) {
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index c7284505cc3f35b2269ce22369d5b02ad97656ec..695486ae709c6b1f1f11492cc6dcb4efe77c8bb8 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -3108,8 +3108,8 @@ void FillNotifications(SectionBuilder &builder) {
 		[&] {
 			AddOptionToggle(
 				builder,
-				::Tele::kOptionNoticesLimits,
-				{ u"flood"_q, u"wait"_q, u"slow mode"_q, u"countdown"_q },
+				::Tele::kOptionNoticesLogLimits,
+				{ u"flood"_q, u"wait"_q, u"history"_q },
 				::Tele::kOptionNotices);
 			AddOptionToggle(
 				builder,
@@ -3118,6 +3118,12 @@ void FillNotifications(SectionBuilder &builder) {
 				::Tele::kOptionNotices);
 		});
 	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Rate limits"_q);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionNoticesLimits,
+		{ u"flood"_q, u"wait"_q, u"countdown"_q });
+	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Unread counters"_q);
 	AddOptionToggle(
 		builder,
diff --git a/Telegram/SourceFiles/tele/tele_flood_wait.h b/Telegram/SourceFiles/tele/tele_flood_wait.h
index 3c0151706e60d19760b371726ad70ba0c26f0fcc..c7a69a8a262f4f26464230c69d8f56a8fb1bc3c5 100644
