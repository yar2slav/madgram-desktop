@@ -213,6 +213,7 @@ struct Spec {
 		Toggle(kOptionOnlineNotify),
 		Toggle(kOptionNotices),
 		Toggle(kOptionNoticesLimits),
+		Toggle(kOptionNoticesLogLimits),
 		Toggle(kOptionNoticesTeleToasts),
 		Toggle(kOptionSilenceChats),
 		Toggle(kOptionMuteFolders),
