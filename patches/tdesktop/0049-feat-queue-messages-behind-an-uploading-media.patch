+[[nodiscard]] mtpBuffer Serialize(const auto &request) {
+	auto result = mtpBuffer();
+	request.write(result);
+	return result;
+}
+
+[[nodiscard]] std::vector<uint64> ForwardRandomIds(
+		const MTPmessages_ForwardMessages &request) {
+	const auto buffer = Serialize(request);
+	auto from = buffer.constData();
+	const auto end = from + buffer.size();
+	auto type = MTPint();
+	auto flags = MTPint();
+	auto peer = MTPInputPeer();
+	auto ids = MTPVector<MTPint>();
+	auto randomIds = MTPVector<MTPlong>();
+	if (!type.read(from, end)
+		|| !flags.read(from, end)
+		|| !peer.read(from, end)
+		|| !ids.read(from, end)
+		|| !randomIds.read(from, end)) {
+		return {};
+	}
+	auto result = std::vector<uint64>();
+	result.reserve(randomIds.v.size());
+	for (const auto &randomId : randomIds.v) {
+		result.push_back(randomId.v);
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<uint64> AlbumRandomIds(
+		const MTPmessages_SendMultiMedia &request) {
+	using Flag = MTPmessages_sendMultiMedia::Flag;
+	const auto buffer = Serialize(request);
+	auto from = buffer.constData();
+	const auto end = from + buffer.size();
+	auto type = MTPint();
+	auto flags = MTPint();
+	auto peer = MTPInputPeer();
+	auto replyTo = MTPInputReplyTo();
+	auto media = MTPVector<MTPInputSingleMedia>();
+	if (!type.read(from, end)
+		|| !flags.read(from, end)
+		|| !peer.read(from, end)
+		|| ((uint32(flags.v) & uint32(Flag::f_reply_to))
+			&& !replyTo.read(from, end))
+		|| !media.read(from, end)) {
+		return {};
+	}
+	auto result = std::vector<uint64>();
+	result.reserve(media.v.size());
+	for (const auto &single : media.v) {
+		result.push_back(single.data().vrandom_id().v);
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<uint64> RandomIds(
+		uint64 randomId,
+		const Data::Histories::PreparedMessage &message) {
+	if (randomId) {
+		return { randomId };
+	}
+	return v::match(message, [](const MTPmessages_ForwardMessages &request) {
+		return ForwardRandomIds(request);
+	}, [](const MTPmessages_SendMultiMedia &request) {
+		return AlbumRandomIds(request);
+	}, [](const auto &) {
+		return std::vector<uint64>();
+	});
+}
+
+struct Held {
+	not_null<History*> history;
+	std::vector<FullMsgId> ids;
+	Fn<void()> send;
+};
+
+struct Queue {
+	std::vector<Held> held;
+	base::flat_set<FullMsgId> failed;
+	bool scheduled = false;
+};
+
+struct QueueState {
+	QueueState();
+
+	base::flat_map<not_null<Main::Session*>, Queue> sessions;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] QueueState &Queues() {
+	static QueueState state;
+	return state;
+}
+
+void Check(not_null<Main::Session*> session);
+
+void Schedule(not_null<Main::Session*> session) {
+	auto &sessions = Queues().sessions;
+	const auto i = sessions.find(session);
+	if (i == end(sessions) || i->second.scheduled) {
+		return;
+	}
+	i->second.scheduled = true;
+	crl::on_main(session, [=] {
+		Check(session);
+	});
+}
+
+QueueState::QueueState() {
+	QueueBehindMediaChanges(
+	) | rpl::on_next([] {
+		for (const auto &[session, queue] : Queues().sessions) {
+			Schedule(session);
+		}
+	}, lifetime);
+}
+
+void MarkFailed(not_null<Main::Session*> session, FullMsgId id) {
+	auto &sessions = Queues().sessions;
+	const auto i = sessions.find(session);
+	if (i != end(sessions)) {
+		i->second.failed.emplace(id);
+		Schedule(session);
+	}
+}
+
+[[nodiscard]] Queue &SessionQueue(not_null<Main::Session*> session) {
+	auto &sessions = Queues().sessions;
+	if (const auto i = sessions.find(session); i != end(sessions)) {
+		return i->second;
+	}
+	session->changes().historyUpdates(
+		Data::HistoryUpdate::Flag::ClientSideMessages
+	) | rpl::on_next([=] {
+		Schedule(session);
+	}, session->lifetime());
+	rpl::merge(
+		session->uploader().photoFailed(),
+		session->uploader().documentFailed()
+	) | rpl::on_next([=](FullMsgId id) {
+		MarkFailed(session, id);
+	}, session->lifetime());
+	session->data().sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		Queues().sessions.remove(session);
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		Queues().sessions.remove(session);
+	});
+	return sessions[session];
+}
+
+[[nodiscard]] bool IsHeld(const Queue *queue, FullMsgId id) {
+	if (!queue) {
+		return false;
+	}
+	for (const auto &entry : queue->held) {
+		if (ranges::contains(entry.ids, id)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] bool IsSendingMedia(
+		const Queue *queue,
+		not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	return media
+		&& !media->webpage()
+		&& (media->photo() || media->document())
+		&& !(queue && queue->failed.contains(item->fullId()));
+}
+
+[[nodiscard]] bool Blocked(
+		not_null<History*> history,
+		const std::vector<FullMsgId> &ids,
+		const Queue *queue) {
+	const auto &owner = history->owner();
+	auto first = (HistoryItem*)nullptr;
+	for (const auto &id : ids) {
+		const auto item = owner.message(id);
+		if (item && (!first || item->id < first->id)) {
+			first = item;
+		}
+	}
+	if (!first) {
+		return false;
+	}
+	const auto topicRootId = first->topicRootId();
+	const auto sublistPeerId = first->sublistPeerId();
+	for (const auto &item : history->clientSideMessages()) {
+		if (item->id >= first->id
+			|| !item->isSending()
+			|| ranges::contains(ids, item->fullId())
+			|| item->topicRootId() != topicRootId
+			|| item->sublistPeerId() != sublistPeerId) {
+			continue;
+		} else if (IsHeld(queue, item->fullId())
+			|| IsSendingMedia(queue, item)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] bool AnyAlive(const Held &entry) {
+	const auto &owner = entry.history->owner();
+	return ranges::any_of(entry.ids, [&](FullMsgId id) {
+		return owner.message(id) != nullptr;
+	});
+}
+
+void Check(not_null<Main::Session*> session) {
+	auto &sessions = Queues().sessions;
+	auto i = sessions.find(session);
+	if (i == end(sessions)) {
+		return;
+	}
+	i->second.scheduled = false;
+	const auto &owner = session->data();
+	for (auto j = begin(i->second.failed); j != end(i->second.failed);) {
+		if (owner.message(*j)) {
+			++j;
+		} else {
+			j = i->second.failed.erase(j);
+		}
+	}
+	const auto enabled = QueueBehindMedia();
+	auto index = 0;
+	while (true) {
+		i = sessions.find(session);
+		if (i == end(sessions) || index >= int(i->second.held.size())) {
+			return;
+		}
+		auto &queue = i->second;
+		const auto &entry = queue.held[index];
+		if (enabled
+			&& AnyAlive(entry)
+			&& Blocked(entry.history, entry.ids, &queue)) {
+			++index;
+			continue;
+		}
+		auto taken = std::move(queue.held[index]);
+		queue.held.erase(begin(queue.held) + index);
+		if (AnyAlive(taken)) {
+			taken.send();
+		}
+	}
+}
+
 } // namespace
 
 void MoveSentToBottom(not_null<HistoryItem*> item) {
@@ -90,4 +348,43 @@ void MoveSentToBottom(not_null<HistoryItem*> item) {
 	history->owner().notifyHistoryChangeDelayed(history);
 }
 
+bool HoldBehindMedia(
+		not_null<History*> history,
+		uint64 randomId,
+		const Data::Histories::PreparedMessage &message,
+		Fn<void()> send) {
+	if (!QueueBehindMedia()) {
+		return false;
+	}
+	const auto session = &history->session();
+	const auto &owner = history->owner();
+	auto ids = std::vector<FullMsgId>();
+	for (const auto id : RandomIds(randomId, message)) {
+		const auto itemId = owner.messageIdByRandomId(id);
+		const auto item = itemId ? owner.message(itemId) : nullptr;
+		if (item
+			&& item->history() == history
+			&& item->isHistoryEntry()
+			&& item->isSending()
+			&& IsClientMsgId(item->id)) {
+			ids.push_back(itemId);
+		}
+	}
+	if (ids.empty()) {
+		return false;
+	}
+	const auto &sessions = Queues().sessions;
+	const auto i = sessions.find(session);
+	const auto queue = (i != end(sessions)) ? &i->second : nullptr;
+	if (!Blocked(history, ids, queue)) {
+		return false;
+	}
+	SessionQueue(session).held.push_back({
+		.history = history,
+		.ids = std::move(ids),
+		.send = std::move(send),
+	});
+	return true;
+}
+
 } // namespace Tele
