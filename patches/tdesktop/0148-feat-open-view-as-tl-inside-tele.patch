+[[nodiscard]] QString TlTitle(const QByteArray &bytes) {
+	if (bytes.size() < int(sizeof(mtpPrime))) {
+		return ViewTlText();
+	}
+	auto from = reinterpret_cast<const mtpPrime*>(bytes.constData());
+	const auto end = from + 1;
+	MTP::details::DumpToTextBuffer to;
+	[[maybe_unused]] const auto dumped = MTP::details::DumpToTextType(
+		to,
+		from,
+		end);
+	const auto text = QLatin1String(to.p, to.size);
+	const auto prefix = QLatin1String("{ ");
+	if (!text.startsWith(prefix)) {
+		return ViewTlText();
+	}
+	auto length = 0;
+	for (auto i = prefix.size(); i != text.size(); ++i, ++length) {
+		const auto ch = QChar(text[i]);
+		if (!ch.isLetterOrNumber() && ch != '_') {
+			break;
+		}
+	}
+	return length
+		? QString(text.mid(prefix.size(), length)).replace('_', '.')
+		: ViewTlText();
+}
+
 } // namespace
 
