diff --git a/Telegram/SourceFiles/tele/tele_view_tl_window.cpp b/Telegram/SourceFiles/tele/tele_view_tl_window.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..add634f10b2b347a0aa33074c8b8f1476eeddc1b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_view_tl_window.cpp
@@ -0,0 +1,194 @@
+#include "tele/tele_view_tl_window.h"
+
+#include "base/invoke_queued.h"
+#include "main/main_session.h"
+#include "storage/storage_account.h"
+#include "ui/basic_click_handlers.h"
+#include "ui/widgets/separate_panel.h"
+#include "webview/webview_embed.h"
+#include "webview/webview_interface.h"
+#include "styles/palette.h"
+
+#include <QtCore/QUrl>
+#include <QtGui/QPainter>
+
+namespace Tele {
+namespace {
+
+constexpr auto kSchemaPrefix = "https://schema.jppgr.am/";
+
+[[nodiscard]] bool IsSchemaUrl(const QString &url) {
+	return url.startsWith(QString::fromLatin1(kSchemaPrefix));
+}
+
+class Viewer final {
+public:
+	explicit Viewer(not_null<Main::Session*> session);
+	~Viewer();
+
+	[[nodiscard]] not_null<Main::Session*> session() const;
+	[[nodiscard]] bool valid() const;
+	void open(const QString &url, const QString &title);
+
+private:
+	[[nodiscard]] bool createWebview();
+
+	const not_null<Main::Session*> _session;
+	std::unique_ptr<Ui::SeparatePanel> _panel;
+	Ui::RpWidget *_container = nullptr;
+	std::unique_ptr<Webview::Window> _webview;
+
+};
+
+std::unique_ptr<Viewer> Instance;
+
+void RequestClose(not_null<Viewer*> viewer) {
+	crl::on_main([=] {
+		if (Instance.get() == viewer) {
+			Instance = nullptr;
+		}
+	});
+}
+
+Viewer::Viewer(not_null<Main::Session*> session)
+: _session(session)
+, _panel(std::make_unique<Ui::SeparatePanel>()) {
+	_panel->setWindowFlag(Qt::WindowStaysOnTopHint, false);
+	_panel->setInnerSize(
+		QSize(style::ConvertScale(720), style::ConvertScale(800)),
+		true);
+	_panel->closeRequests(
+	) | rpl::on_next([=] {
+		RequestClose(this);
+	}, _panel->lifetime());
+
+	auto inner = base::make_unique_q<Ui::RpWidget>(_panel.get());
+	_container = inner.get();
+	_panel->showInner(std::move(inner));
+	_container->paintRequest() | rpl::on_next([=](QRect clip) {
+		QPainter(_container).fillRect(clip, st::windowBg);
+	}, _container->lifetime());
+	_container->show();
+
+	if (!createWebview()) {
+		_webview = nullptr;
+	}
+}
+
+Viewer::~Viewer() {
+	if (_panel) {
+		_panel->hide();
+	}
+	base::take(_webview);
+	_container = nullptr;
+	base::take(_panel);
+}
+
+not_null<Main::Session*> Viewer::session() const {
+	return _session;
+}
+
+bool Viewer::valid() const {
+	return _webview && _webview->widget();
+}
+
+void Viewer::open(const QString &url, const QString &title) {
+	_panel->setTitle(rpl::single(title));
+	_webview->navigate(url);
+	_panel->showAndActivate();
+	if (const auto widget = _webview->widget()) {
+		InvokeQueued(widget, [=] {
+			if (widget->isVisible() && _webview) {
+				_webview->focus();
+			}
+		});
+	}
+}
+
+bool Viewer::createWebview() {
+	_webview = std::make_unique<Webview::Window>(
+		_container,
+		Webview::WindowConfig{
+			.opaqueBg = st::windowBg->c,
+			.storageId = _session->local().resolveStorageIdOther(),
+			.safe = true,
+		});
+	const auto raw = _webview.get();
+	const auto widget = raw->widget();
+	if (!widget) {
+		return false;
+	}
+	widget->show();
+	_container->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		if (const auto widget = raw->widget()) {
+			widget->setGeometry(QRect(QPoint(), size));
+		}
+	}, raw->lifetime());
+	QObject::connect(widget, &QObject::destroyed, [=] {
+		if (_webview.get() == raw) {
+			RequestClose(this);
+		}
+	});
+
+	raw->setNavigationPolicyHandler([=](const QString &uri, bool newWindow) {
+		if (IsSchemaUrl(uri)) {
+			if (!newWindow) {
+				return true;
+			}
+			crl::on_main(_panel.get(), [=] {
+				if (_webview.get() == raw) {
+					raw->navigate(uri);
+				}
+			});
+			return false;
+		} else if (uri == u"about:blank"_q) {
+			return true;
+		}
+		const auto scheme = QUrl(uri).scheme().toLower();
+		if (scheme == u"https"_q || scheme == u"http"_q) {
+			crl::on_main([=] {
+				UrlClickHandler::Open(uri);
+			});
+		}
+		return false;
+	});
+	raw->setNavigationDoneHandler([](bool) {
+	});
+
+	raw->init(R"()");
+	return true;
+}
+
+} // namespace
+
+bool ShowTlWindow(
+		not_null<Main::Session*> session,
+		const QString &url,
+		const QString &title) {
+	if (Instance
+		&& (Instance->session() != session || !Instance->valid())) {
+		Instance = nullptr;
+	}
+	if (!Instance) {
+		const auto available = Webview::Availability();
+		if (available.error != Webview::Available::Error::None) {
+			return false;
+		}
+		auto viewer = std::make_unique<Viewer>(session);
+		if (!viewer->valid()) {
+			return false;
+		}
+		Instance = std::move(viewer);
+		const auto raw = Instance.get();
+		session->lifetime().add([=] {
+			if (Instance.get() == raw) {
+				Instance = nullptr;
+			}
+		});
+	}
+	Instance->open(url, title);
+	return true;
+}
+
+} // namespace Tele
