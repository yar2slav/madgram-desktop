+[[nodiscard]] QString Label(const Known &known) {
+	return known.label
+		? known.label()
+		: known.phrases.front().text(1);
+}
+
+[[nodiscard]] std::vector<Entry> ResolveLayout(const QString &value) {
+	const auto &registry = Registry();
+	const auto count = int(registry.size());
+	auto result = std::vector<Entry>();
+	auto seen = std::vector<char>(count, 0);
+	for (const auto &part : value.split(',', Qt::SkipEmptyParts)) {
+		const auto trimmed = part.trimmed();
+		const auto hidden = trimmed.startsWith('-');
+		const auto key = hidden ? trimmed.mid(1) : trimmed;
+		const auto i = ranges::find(registry, key, &Known::key);
+		if (i == end(registry)) {
+			continue;
+		}
+		const auto index = int(i - begin(registry));
+		if (!seen[index]) {
+			seen[index] = 1;
+			result.push_back({ .index = index, .hidden = hidden });
+		}
+	}
+	for (auto index = 0; index != count; ++index) {
+		if (seen[index]) {
+			continue;
+		}
+		const auto after = index
+			? ranges::find(result, index - 1, &Entry::index)
+			: end(result);
+		result.insert(
+			(after != end(result)) ? (after + 1) : begin(result),
+			Entry{ .index = index });
+	}
+	return result;
+}
+
+[[nodiscard]] QString SerializeLayout(const std::vector<Entry> &entries) {
+	const auto &registry = Registry();
+	auto parts = QStringList();
+	auto changed = false;
+	for (auto i = 0; i != int(entries.size()); ++i) {
+		const auto &entry = entries[i];
+		if (entry.hidden || entry.index != i) {
+			changed = true;
+		}
+		parts.push_back((entry.hidden ? u"-"_q : QString())
+			+ registry[entry.index].key);
+	}
+	return changed ? parts.join(',') : QString();
+}
+
+[[nodiscard]] std::vector<Matcher> CollectMatchers() {
+	const auto &registry = Registry();
+	auto result = std::vector<Matcher>();
+	for (auto index = 0; index != int(registry.size()); ++index) {
+		for (const auto &phrase : registry[index].phrases) {
+			if (!phrase.counted) {
+				result.push_back({
+					.text = phrase.text(0),
+					.index = index,
+					.icon = phrase.icon,
+				});
+				continue;
+			}
+			for (const auto count : { 1, 2, 5 }) {
+				const auto sample = phrase.text(count);
+				const auto number = QString::number(count);
+				const auto position = sample.indexOf(number);
+				if (position < 0) {
+					continue;
+				}
+				result.push_back({
+					.prefix = sample.left(position),
+					.suffix = sample.mid(position + number.size()),
+					.counted = true,
+					.index = index,
+					.icon = phrase.icon,
+				});
+			}
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool Matches(const Matcher &matcher, const QString &text) {
+	if (!matcher.counted) {
+		return (text == matcher.text);
+	}
+	const auto from = int(matcher.prefix.size());
+	const auto till = int(text.size() - matcher.suffix.size());
+	return (till > from)
+		&& text.startsWith(matcher.prefix)
+		&& text.endsWith(matcher.suffix)
+		&& text[from].isDigit();
+}
+
+[[nodiscard]] std::optional<Found> Identify(
+		not_null<Ui::Menu::Menu*> menu,
+		not_null<QAction*> action,
+		const std::vector<Matcher> &matchers) {
+	if (action->isSeparator() || action->menu()) {
+		return std::nullopt;
+	}
+	const auto item = menu->itemForAction(action);
+	if (!item || typeid(*item) != typeid(Ui::Menu::Action)) {
+		return std::nullopt;
+	}
+	const auto text = action->text();
+	for (const auto &matcher : matchers) {
+		if (Matches(matcher, text)) {
+			return Found{
+				.action = action,
+				.st = &static_cast<Ui::Menu::Action*>(item)->st(),
+				.icon = matcher.icon,
+				.index = matcher.index,
+			};
+		}
+	}
+	return std::nullopt;
+}
+
+void NormalizeSeparators(not_null<Ui::PopupMenu*> menu) {
+	const auto &actions = menu->actions();
+	auto previous = true;
+	for (auto i = 0; i < int(actions.size());) {
+		const auto separator = actions[i]->isSeparator();
+		if (separator && previous) {
+			menu->removeAction(i);
+		} else {
+			previous = separator;
+			++i;
+		}
+	}
+	if (!actions.empty() && actions.back()->isSeparator()) {
+		menu->removeAction(int(actions.size()) - 1);
+	}
+}
