From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Fri, 16 Oct 2026 08:43:09 +0300
Subject: [PATCH] fix: listing accounts from a script no longer crashes tele at
 startup

---
 .../SourceFiles/tele/scripting/tele_script_instance.cpp    | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_instance.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_instance.cpp
index f3ccdfeeabf697a21f96c7968b671e016f44bcbe..5bd2a2da2979373c9a613367d77fe4e68f21be95 100644
--- a/Telegram/SourceFiles/tele/scripting/tele_script_instance.cpp
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_instance.cpp
@@ -6062,7 +6062,12 @@ JSValue Instance::NativeSystem(
 		auto result = JS_NewArray(ctx);
 		auto index = uint32_t();
 		auto &domain = Core::App().domain();
-		const auto active = domain.started() ? &domain.active() : nullptr;
+		auto active = (Main::Account*)nullptr;
+		auto activeLifetime = rpl::lifetime();
+		domain.activeValue(
+		) | rpl::take(1) | rpl::on_next([&](Main::Account *account) {
+			active = account;
+		}, activeLifetime);
 		auto accounts = domain.orderedAccounts();
 		if (accounts.empty()) {
 			for (const auto &[index, owned] : domain.accounts()) {
