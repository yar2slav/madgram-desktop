diff --git a/Telegram/SourceFiles/tele/tele_round_videos.cpp b/Telegram/SourceFiles/tele/tele_round_videos.cpp
index 3a733d2e92b7197f2122d21a448138a13f600614..e8eec73c43a961d16ef46b4ba061768ee00b9ea7 100644
--- a/Telegram/SourceFiles/tele/tele_round_videos.cpp
+++ b/Telegram/SourceFiles/tele/tele_round_videos.cpp
@@ -26,6 +26,7 @@ using namespace HistoryView;
 constexpr auto kDuration = crl::time(200);
 constexpr auto kPlayingSize = 400;
 constexpr auto kMinGain = 40;
+constexpr auto kSeekCenter = 0.2;
 
 struct Entry {
 	Ui::Animations::Simple animation;
@@ -276,4 +277,16 @@ QSize RoundVideoSource(
 	return size.scaled(maxSize, maxSize, Qt::KeepAspectRatio);
 }
 
+bool RoundSeekDragGrab(QRect rthumb, QPoint point) {
+	if (!RoundSeekAnywhere()) {
+		return false;
+	}
+	const auto radius = rthumb.width() / 2.;
+	const auto center = rthumb.center();
+	const auto dx = float64(point.x() - center.x());
+	const auto dy = float64(point.y() - center.y());
+	const auto distance = std::sqrt(dx * dx + dy * dy);
+	return (distance >= radius * kSeekCenter) && (distance <= radius);
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_round_videos.h b/Telegram/SourceFiles/tele/tele_round_videos.h
