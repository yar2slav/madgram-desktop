--- a/Telegram/SourceFiles/tele/tele_round_videos.h
+++ b/Telegram/SourceFiles/tele/tele_round_videos.h
@@ -25,5 +25,6 @@ namespace Tele {
 	not_null<const HistoryView::Media*> media,
 	QSize size,
 	int maxSize);
+[[nodiscard]] bool RoundSeekDragGrab(QRect rthumb, QPoint point);
 
 } // namespace Tele
