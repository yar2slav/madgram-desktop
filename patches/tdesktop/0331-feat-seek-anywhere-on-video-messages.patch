 	.name = "Forward protected messages as copies",
@@ -2900,6 +2906,10 @@ rpl::producer<bool> BiggerRoundVideosValue() {
 	});
 }
 
+bool RoundSeekAnywhere() {
+	return RoundSeekAnywhereOption.value();
+}
