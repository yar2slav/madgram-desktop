+EditHistoryWidget::EditHistoryWidget(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller,
+	not_null<History*> history,
+	FullMsgId itemId)
+: Window::SectionWidget(parent, controller, history->peer)
+, HistoryView::WindowListDelegate(controller)
+, _history(history)
+, _itemId(itemId)
+, _topBar(this, history->peer, [=] { controller->showBackFromStack(); })
+, _topBarShadow(this)
+, _scroll(std::make_unique<Ui::ElasticScroll>(
+	this,
+	controller->chatStyle()->value(lifetime(), st::historyScroll))) {
+	controller->chatStyle()->paletteChanged(
+	) | rpl::on_next([=] {
+		_scroll->updateBars();
+	}, _scroll->lifetime());
+
+	Window::ChatThemeValueFromPeer(
+		controller,
+		history->peer
+	) | rpl::on_next([=](std::shared_ptr<Ui::ChatTheme> &&theme) {
+		_theme = std::move(theme);
+		controller->setChatStyleTheme(_theme);
+	}, lifetime());
+
+	_topBar->move(0, 0);
+	_topBar->resizeToWidth(width());
+	_topBar->show();
+
+	_topBarShadow->raise();
+	controller->adaptive().value(
+	) | rpl::on_next([=] {
+		updateAdaptiveLayout();
+	}, lifetime());
+
+	_scroll->setHandleTouch(false);
+	_inner = _scroll->setOwnedWidget(object_ptr<ListWidget>(
+		this,
+		&controller->session(),
+		static_cast<ListDelegate*>(this)));
+	_inner->lower();
+	_scroll->move(0, _topBar->height());
+	_scroll->show();
+	_scroll->setOverscrollBg(QColor(0, 0, 0, 0));
+	_scroll->setOverscrollEdges([=] {
+		return _inner->loadedAtTopKnown() && _inner->loadedAtTop();
+	}, [=] {
+		return _inner->loadedAtBottomKnown() && _inner->loadedAtBottom();
+	});
+	_scroll->scrolls(
+	) | rpl::on_next([=] {
+		onScroll();
+	}, lifetime());
+
+	_inner->scrollKeyEvents(
+	) | rpl::on_next([=](not_null<QKeyEvent*> e) {
+		_scroll->keyPressEvent(e);
+	}, lifetime());
+
+	if (const auto item = history->owner().message(itemId)) {
+		EditVersionsChanges(
+			item
+		) | rpl::on_next([=] {
+			scheduleRebuild();
+		}, lifetime());
+	}
+	history->owner().itemRemoved(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return (item->fullId() == _itemId);
+	}) | rpl::on_next([=] {
+		scheduleRebuild();
+	}, lifetime());
+
+	if (!build()) {
+		scheduleRebuild();
+	}
+
+	Window::SetupSwipeBackSection(this, _scroll.get(), _inner);
+}
+
+EditHistoryWidget::~EditHistoryWidget() {
+	DestroyItems(_history, base::take(_ids));
+}
+
+bool EditHistoryWidget::build() {
+	const auto item = _history->owner().message(_itemId);
+	const auto versions = item
+		? EditVersions(item)
+		: std::vector<EditVersion>();
+	if (versions.empty()) {
+		return false;
+	}
+	_ids.reserve(versions.size() * 2);
+	for (const auto &version : versions) {
+		_ids.push_back(MakeDivider(_history, version)->fullId());
+		_ids.push_back(
+			MakeEditVersionCopy(version.item, version.date)->fullId());
+	}
+	return true;
+}
+
+void EditHistoryWidget::scheduleRebuild() {
+	if (_rebuildScheduled) {
+		return;
+	}
+	_rebuildScheduled = true;
+	crl::on_main(this, [=] {
+		_rebuildScheduled = false;
+		rebuild();
+	});
+}
+
+void EditHistoryWidget::rebuild() {
+	const auto old = base::take(_ids);
+	const auto built = build();
+	_refreshes.fire({});
+	DestroyItems(_history, old);
+	if (!built) {
+		controller()->showBackFromStack();
+	}
+}
+
+Data::MessagesSlice EditHistoryWidget::buildSlice() const {
+	auto result = Data::MessagesSlice();
+	result.ids = _ids;
+	result.fullCount = int(_ids.size());
+	result.skippedBefore = result.skippedAfter = 0;
+	if (!_ids.empty()) {
+		result.nearestToAround = _ids.back();
+	}
+	return result;
+}
