+
+not_null<HistoryItem*> MakeEditVersionCopy(
+		not_null<HistoryItem*> source,
+		TimeId date) {
+	const auto history = source->history();
+	const auto from = source->from();
+	auto flags = MessageFlags(MessageFlag::FakeHistoryItem);
+	if (source->out()) {
+		flags |= MessageFlag::Outgoing;
+	}
+	if (source->isPost()) {
+		flags |= MessageFlag::Post;
+	}
+	if (from != history->peer) {
+		flags |= MessageFlag::HasFromId;
+	}
+	const auto result = history->makeMessage({
+		.id = history->nextNonHistoryEntryId(),
+		.flags = flags,
+		.from = from->id,
+		.date = date,
+		.ignoreForwardFrom = true,
+	}, source);
+	const auto &text = source->originalText();
+	if (!source->richPage()
+		&& !text.empty()
+		&& result->originalText() != text) {
+		result->setText(text);
+	}
+	return result;
+}
+
+std::vector<EditVersion> EditVersions(not_null<HistoryItem*> item) {
+	const auto record = Versions(item);
+	if (!record) {
+		return {};
+	}
+	auto &owner = item->history()->owner();
+	auto result = std::vector<EditVersion>();
+	result.reserve(record->versions.size() + 1);
+	for (const auto &version : record->versions) {
+		if (const auto snapshot = owner.message(version.snapshot)) {
+			result.push_back({
+				.item = snapshot,
+				.date = version.date,
+				.original = version.original,
+			});
+		}
+	}
+	if (result.empty()) {
+		return {};
+	}
+	result.push_back({
+		.item = item,
+		.date = record->since,
+		.original = record->original,
+		.current = true,
+	});
+	return result;
+}
+
+rpl::producer<> EditVersionsChanges(not_null<HistoryItem*> item) {
+	const auto raw = item.get();
+	return Sessions(
+		&item->history()->session()
+	).changes.events(
+	) | rpl::filter([=](not_null<const HistoryItem*> changed) {
+		return (changed.get() == raw);
+	}) | rpl::to_empty;
 }
 
