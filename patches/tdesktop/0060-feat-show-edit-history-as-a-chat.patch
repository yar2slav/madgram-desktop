+[[nodiscard]] QString FormatDate(TimeId date) {
+	const auto parsed = base::unixtime::parse(date);
+	const auto time = FormatMessageTime(parsed.time());
+	return (parsed.date() == QDate::currentDate())
+		? time
+		: (QLocale().toString(parsed.date(), QLocale::ShortFormat)
+			+ QChar(' ')
+			+ time);
+}
+
+[[nodiscard]] QString Label(const EditVersion &version) {
+	const auto date = FormatDate(version.date);
+	return (version.current
+		? (version.original
+			? Lower(u"Current version, sent %1"_q)
+			: Lower(u"Current version, edited %1"_q))
+		: (version.original
+			? Lower(u"Original, sent %1"_q)
+			: Lower(u"Edited %1"_q))).arg(date);
+}
+
+[[nodiscard]] not_null<HistoryItem*> MakeDivider(
+		not_null<History*> history,
+		const EditVersion &version) {
+	return history->makeMessage({
+		.id = history->nextNonHistoryEntryId(),
+		.flags = MessageFlag::FakeHistoryItem,
+		.date = version.date,
+	}, PreparedServiceText{ { .text = Label(version) } });
+}
+
+void DestroyItems(
+		not_null<History*> history,
+		const std::vector<FullMsgId> &ids) {
+	for (const auto &id : ids) {
+		if (const auto item = history->owner().message(id)) {
+			item->destroy();
+		}
+	}
+}
