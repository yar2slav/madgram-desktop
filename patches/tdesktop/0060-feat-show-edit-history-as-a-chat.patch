+[[nodiscard]] std::vector<FullMsgId> SnapshotIds(const Record &record) {
+	auto result = std::vector<FullMsgId>();
+	result.reserve(record.versions.size());
+	for (const auto &version : record.versions) {
+		result.push_back(version.snapshot);
+	}
+	return result;
