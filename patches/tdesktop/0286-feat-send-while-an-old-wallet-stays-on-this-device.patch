diff --git a/Telegram/SourceFiles/wallet/wallet_session.cpp b/Telegram/SourceFiles/wallet/wallet_session.cpp
index 656083a56bd32d239891cab8e5ce30a847421576..bb3b75e3fc42e788fad9d2c595afa05f67c19db1 100644
--- a/Telegram/SourceFiles/wallet/wallet_session.cpp
+++ b/Telegram/SourceFiles/wallet/wallet_session.cpp
@@ -565,6 +565,18 @@ struct MergedHead {
 		|| record.unresolved(servedKey);
 }
 
+[[nodiscard]] bool OnlyOtherWalletsBesidesCurrent(
+		const CustodyStore &store,
+		const QString &canonicalAddress,
+		const QByteArray &servedKey) {
+	const auto current = store.current(canonicalAddress, servedKey);
+	return current && ranges::none_of(store.records, [&](
+			const CustodyRecord &record) {
+		return (&record != current)
+			&& (CanonicalAddress(record.address) == canonicalAddress);
+	});
+}
+
 // WHY: a parked record at the served address is an older key of this
 // same account, so its balance is the one the card already shows.
 [[nodiscard]] QString CheckableParkedAddress(
@@ -3238,20 +3250,31 @@ bool Session::commentAccessReady() const {
 
 bool Session::commentAccessAvailable() const {
 	const auto identity = transferWalletIdentity();
+	const auto onlyCurrent = [&] {
+		return (_custody->records.size() <= 1)
+			&& !ranges::any_of(_custody->records, [&](
+					const CustodyRecord &record) {
+				return &record != _custody->current(
+					identity->address,
+					identity->publicKey);
+			});
+	};
+	const auto keptOld = [&] {
+		return Tele::WalletKeepOld()
+			&& OnlyOtherWalletsBesidesCurrent(
+				*_custody,
+				identity->address,
+				identity->publicKey);
+	};
 	return identity.has_value()
 		&& _custody.has_value()
 		&& !_custodyReadFailed
-		&& _custody->records.size() <= 1
 		&& !_custody->pendingRotation
 		&& !(_clientStopping && !_clientRecordId.isEmpty())
 		&& !_pending
 		&& !_sendUnresolved
 		&& _sendState.current() == SendState::Idle
-		&& !ranges::any_of(_custody->records, [&](const CustodyRecord &record) {
-			return &record != _custody->current(
-				identity->address,
-				identity->publicKey);
-		});
+		&& (onlyCurrent() || keptOld());
 }
 
 bool Session::commentScopeCurrent(
@@ -5392,6 +5415,31 @@ DeviceCustodyState Session::deviceCustodyState() const {
 	return _deviceCustody.current();
 }
 
+bool Session::oldWalletKept() const {
+	if (!Tele::WalletKeepOld()
+		|| !_custody
+		|| _custodyReadFailed
+		|| _clientStopping
+		|| _presence.current() != Presence::Ready
+		|| _deviceCustody.current().mode != DeviceMode::Full) {
+		return false;
+	}
+	const auto identity = transferWalletIdentity();
+	if (!identity) {
+		return false;
+	}
+	const auto current = _custody->current(
+		identity->address,
+		identity->publicKey);
+	return current
+		&& !current->recordId.isEmpty()
+		&& (current->recordId == _clientRecordId)
+		&& OnlyOtherWalletsBesidesCurrent(
+			*_custody,
+			identity->address,
+			identity->publicKey);
+}
+
 auto Session::deviceCustodyStateValue() const
 -> rpl::producer<DeviceCustodyState> {
 	return _deviceCustody.value();
