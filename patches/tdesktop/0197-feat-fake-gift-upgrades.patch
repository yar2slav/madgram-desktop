diff --git a/Telegram/SourceFiles/tele/tele_gift_studio_roll.cpp b/Telegram/SourceFiles/tele/tele_gift_studio_roll.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ca94763b750441be7eef6977dadb6601af2c8d6a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_studio_roll.cpp
@@ -0,0 +1,157 @@
+#include "tele/tele_gift_studio_roll.h"
+
+#include "data/data_star_gift.h"
+#include "lang/lang_tag.h"
+#include "main/main_session.h"
+#include "settings/settings_common.h"
+#include "tele/tele_gift_fake_upgrade.h"
+#include "tele/tele_gift_studio_render.h"
+#include "tele/tele_lowercase.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/vertical_layout.h"
+#include "window/window_session_controller.h"
+#include "styles/style_layers.h"
+#include "styles/style_settings.h"
+#include "styles/style_widgets.h"
+
+namespace Tele::GiftStudio {
+namespace {
+
+struct RollState {
+	explicit RollState(RollArgs &&args) : args(std::move(args)) {
+	}
+
+	RollArgs args;
+	Ui::VerticalLayout *history = nullptr;
+	bool opening = false;
+};
+
+void RefreshHistory(not_null<RollState*> state) {
+	const auto history = state->history;
+	history->clear();
+	const auto list = FakeUpgrades(&state->args.controller->session());
+	if (list.empty()) {
+		history->add(
+			object_ptr<Ui::FlatLabel>(
+				history,
+				Lower(u"Upgrades show up here."_q),
+				st::boxDividerLabel),
+			style::margins(0, 0, 0, st::boxRowPadding.left() / 4));
+	}
+	for (const auto &gift : list) {
+		const auto title = gift->title
+			+ u" #"_q
+			+ Lang::FormatCountDecimal(gift->number)
+			+ u" \u00B7 "_q
+			+ gift->model.name;
+		const auto odds = RarityOdds(
+			gift->model.rarityPermille(),
+			gift->backdrop.rarityPermille());
+		const auto button = Settings::AddButtonWithLabel(
+			history,
+			rpl::single(title),
+			rpl::single(odds),
+			st::settingsButtonNoIcon);
+		const auto combo = Combo{
+			.collection = gift->title,
+			.model = gift->model.name,
+			.backdrop = gift->backdrop.name,
+			.symbol = gift->pattern.name,
+			.title = gift->title,
+			.number = QString::number(gift->number),
+		};
+		const auto open = state->args.open;
+		button->setClickedCallback([=] {
+			open(combo);
+		});
+	}
+	if (!list.empty()) {
+		const auto session = &state->args.controller->session();
+		Settings::AddButtonWithIcon(
+			history,
+			rpl::single(Lower(u"Clear history"_q)),
+			st::settingsAttentionButton
+		)->setClickedCallback(crl::guard(history, [=] {
+			crl::on_main(history, [=] {
+				ClearFakeUpgrades(session);
+			});
+		}));
+	}
+	history->resizeToWidth(state->args.width);
+}
+
+void Roll(not_null<RollState*> state) {
+	if (state->opening) {
+		return;
+	}
+	const auto controller = state->args.controller;
+	const auto collection = state->args.collection();
+	if (collection.isEmpty()) {
+		controller->showToast(Lower(u"Pick a collection first."_q));
+		return;
+	}
+	state->opening = true;
+	ShowFakeUpgrade(
+		controller,
+		collection,
+		crl::guard(state->history, [=](bool) {
+			state->opening = false;
+		}));
+}
+
+} // namespace
+
+Fn<void()> SetupRoll(
+		not_null<Ui::VerticalLayout*> container,
+		RollArgs &&args) {
+	const auto state = container->lifetime().make_state<RollState>(
+		std::move(args));
+	const auto width = state->args.width;
+	const auto line = st::boxRowPadding.left() / 4;
+	container->add(
+		object_ptr<Ui::FlatLabel>(
+			container,
+			Lower(u"Pick a collection on the left and press upgrade."_q),
+			st::boxDividerLabel),
+		style::margins(0, line, 0, line));
+	const auto upgrade = container->add(
+		object_ptr<Ui::RoundButton>(
+			container,
+			rpl::single(Lower(u"Upgrade"_q)),
+			st::defaultActiveButton),
+		style::margins(0, line, 0, line));
+	upgrade->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	upgrade->setFullWidth(width);
+	upgrade->setClickedCallback([=] {
+		Roll(state);
+	});
+	container->add(
+		object_ptr<Ui::FlatLabel>(
+			container,
+			Lower(u"Space or Enter opens it again. Nothing is bought: "
+				"rarity decides the result."_q),
+			st::boxDividerLabel),
+		style::margins(0, 0, 0, line));
+	Ui::AddSkip(container);
+	container->add(
+		object_ptr<Ui::FlatLabel>(
+			container,
+			Lower(u"History"_q),
+			st::defaultSubsectionTitle),
+		style::margins(0, 0, 0, line));
+	state->history = container->add(
+		object_ptr<Ui::VerticalLayout>(container));
+	RefreshHistory(state);
+	FakeUpgradesChanged(
+		&state->args.controller->session()
+	) | rpl::on_next([=] {
+		RefreshHistory(state);
+	}, state->history->lifetime());
+	return [=] {
+		Roll(state);
+	};
+}
+
+} // namespace Tele::GiftStudio
