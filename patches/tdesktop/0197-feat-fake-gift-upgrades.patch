@@ -0,0 +1,466 @@
+#include "tele/tele_gift_fake_upgrade.h"
+
+#include "api/api_premium.h"
+#include "apiwrap.h"
+#include "base/call_delayed.h"
+#include "base/random.h"
+#include "base/unixtime.h"
+#include "boxes/star_gift_box.h"
+#include "chat_helpers/compose/compose_show.h"
+#include "data/components/gift_auctions.h"
+#include "data/data_credits.h"
+#include "data/data_document.h"
+#include "data/data_session.h"
+#include "data/data_star_gift.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/window_session_controller.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kHistoryLimit = 50;
+constexpr auto kUpgradeDelay = crl::time(600);
+constexpr auto kFakeBase = int64(1) << 40;
+
+struct BoxFlags {
+	int cost = 0;
+	bool canAddSender = false;
+	bool canAddComment = false;
+	bool canAddMyComment = false;
+	bool addDetailsDefault = false;
+};
+
+struct Issued {
+	int issued = 0;
+	int total = 0;
+};
+
+struct FakeState {
+	base::flat_map<int64, Data::StarGift> boxes;
+	base::flat_map<uint64, Issued> issued;
+	base::flat_map<uint64, int> rolled;
+	base::flat_map<uint64, std::vector<Fn<void()>>> issuedWaiters;
+	std::vector<Data::StarGift> catalog;
+	std::vector<Fn<void()>> catalogWaiters;
+	std::vector<std::shared_ptr<Data::UniqueGift>> history;
+	rpl::event_stream<> changed;
+	int64 counter = 0;
+	bool catalogLoaded = false;
+};
+
+[[nodiscard]] auto &States() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<FakeState>>();
+	return result;
+}
+
+[[nodiscard]] FakeState *Lookup(not_null<Main::Session*> session) {
+	auto &states = States();
+	const auto i = states.find(session);
+	return (i != end(states)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] FakeState &StateFor(not_null<Main::Session*> session) {
+	if (const auto state = Lookup(session)) {
+		return *state;
+	}
+	session->lifetime().add([=] {
+		auto &states = States();
+		const auto i = states.find(session);
+		if (i != end(states)) {
+			states.erase(i);
+		}
+	});
+	return *States().emplace(
+		session,
+		std::make_unique<FakeState>()).first->second;
+}
+
+[[nodiscard]] QString SlugPrefix(const QString &title) {
+	auto result = QString();
+	auto upper = false;
+	for (const auto ch : title) {
+		if (ch.isLetterOrNumber() && ch.unicode() < 128) {
+			result.append(upper ? ch.toUpper() : ch);
+			upper = false;
+		} else if (ch.isSpace()
+			|| ch.category() == QChar::Punctuation_Dash) {
+			upper = true;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString NameKey(const QString &name) {
+	const auto text = name.normalized(QString::NormalizationForm_KC);
+	auto result = QString();
+	result.reserve(text.size());
+	for (const auto ch : text) {
+		if (ch.isLetterOrNumber()) {
+			result.append(ch.toLower());
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool SameCollection(
+		const Data::StarGift &gift,
+		const QString &key) {
+	return !key.isEmpty()
+		&& ((NameKey(gift.resellTitle) == key)
+			|| (NameKey(SlugPrefix(gift.resellTitle)) == key));
+}
+
+template <typename Attribute>
+[[nodiscard]] const Attribute &PickWeighted(
+		const std::vector<Attribute> &list) {
+	auto total = int64();
+	for (const auto &item : list) {
+		total += item.rarityPermille();
+	}
+	if (total <= 0) {
+		return list[base::RandomIndex(int(list.size()))];
+	}
+	auto left = int64(base::RandomIndex(int(total)));
+	for (const auto &item : list) {
+		left -= item.rarityPermille();
+		if (left < 0) {
+			return item;
+		}
+	}
+	return list.back();
+}
+
+void RequestCatalog(
+		not_null<Main::Session*> session,
+		Fn<void()> done) {
+	auto &state = StateFor(session);
+	if (state.catalogLoaded) {
+		done();
+		return;
+	}
+	state.catalogWaiters.push_back(std::move(done));
+	if (state.catalogWaiters.size() > 1) {
+		return;
+	}
+	const auto finish = [=] {
+		for (const auto &waiter : base::take(
+				StateFor(session).catalogWaiters)) {
+			waiter();
+		}
+	};
+	session->api().request(MTPpayments_GetStarGifts(
+		MTP_int(0)
+	)).done([=](const MTPpayments_StarGifts &result) {
+		result.match([&](const MTPDpayments_starGifts &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			auto &state = StateFor(session);
+			state.catalog.clear();
+			for (const auto &gift : data.vgifts().v) {
+				if (auto parsed = Api::FromTL(session, gift)) {
+					state.catalog.push_back(std::move(*parsed));
+				}
+			}
+			state.catalogLoaded = true;
+		}, [](const MTPDpayments_starGiftsNotModified &) {
+		});
+		finish();
+	}).fail([=] {
+		finish();
+	}).send();
+}
+
+[[nodiscard]] const Data::StarGift *FindInCatalog(
+		not_null<Main::Session*> session,
+		Fn<bool(const Data::StarGift&)> match) {
+	const auto &catalog = StateFor(session).catalog;
+	const Data::StarGift *result = nullptr;
+	for (const auto &gift : catalog) {
+		if (!match(gift)) {
+			continue;
+		} else if (gift.upgradable) {
+			return &gift;
+		} else if (!result) {
+			result = &gift;
+		}
+	}
+	return result;
+}
+
+void RequestIssued(
+		not_null<Main::Session*> session,
+		const Data::StarGift &gift,
+		Fn<void()> done) {
+	auto &state = StateFor(session);
+	const auto id = gift.id;
+	if (state.issued.contains(id)) {
+		done();
+		return;
+	}
+	auto &waiters = state.issuedWaiters[id];
+	waiters.push_back(std::move(done));
+	if (waiters.size() > 1) {
+		return;
+	}
+	const auto finish = [=](Issued issued) {
+		auto &state = StateFor(session);
+		state.issued[id] = issued;
+		for (const auto &waiter : base::take(state.issuedWaiters[id])) {
+			waiter();
+		}
+	};
+	const auto slug = SlugPrefix(gift.resellTitle) + u"-1"_q;
+	session->api().request(MTPpayments_GetUniqueStarGift(
+		MTP_string(slug)
+	)).done([=](const MTPpayments_UniqueStarGift &result) {
+		auto issued = Issued();
+		result.data().vgift().match([&](const MTPDstarGiftUnique &data) {
+			if (uint64(data.vgift_id().v) == id) {
+				issued.issued = data.vavailability_issued().v;
+				issued.total = data.vavailability_total().v;
+			}
+		}, [](const auto &) {
+		});
+		finish(issued);
+	}).fail([=] {
+		finish(Issued());
+	}).send();
+}
+
+[[nodiscard]] std::shared_ptr<Data::UniqueGift> MakeUnique(
+		not_null<Main::Session*> session,
+		const Data::StarGift &gift,
+		const Data::UniqueGiftAttributes &attributes,
+		int number) {
+	return std::make_shared<Data::UniqueGift>(Data::UniqueGift{
+		.id = base::RandomValue<CollectibleId>(),
+		.initialGiftId = gift.id,
+		.slug = SlugPrefix(gift.resellTitle) + '-' + QString::number(number),
+		.title = gift.resellTitle,
+		.ownerId = session->userPeerId(),
+		.releasedBy = gift.releasedBy,
+		.number = number,
+		.model = PickWeighted(attributes.models),
+		.pattern = PickWeighted(attributes.patterns),
+		.backdrop = PickWeighted(attributes.backdrops),
+	});
+}
+
+void ShowFakeBox(
+		not_null<Window::SessionController*> controller,
+		const Data::StarGift &gift,
+		BoxFlags flags,
+		Fn<void(bool)> ready) {
+	const auto session = &controller->session();
+	auto &state = StateFor(session);
+	const auto key = -(kFakeBase + (++state.counter));
+	state.boxes.emplace(key, gift);
+	Ui::ShowStarGiftUpgradeBox({
+		.controller = controller,
+		.stargift = gift,
+		.ready = std::move(ready),
+		.peer = session->user(),
+		.savedId = Data::SavedStarGiftId::User(MsgId(key)),
+		.cost = flags.cost,
+		.canAddSender = flags.canAddSender,
+		.canAddComment = flags.canAddComment,
+		.canAddMyComment = flags.canAddMyComment,
+		.addDetailsDefault = flags.addDetailsDefault,
+	});
+}
+
+[[nodiscard]] int UpgradeCost(const Data::StarGift &gift) {
+	return (gift.starsToUpgrade > 0)
+		? int(gift.starsToUpgrade)
+		: std::numeric_limits<int>::max();
+}
+
+} // namespace
+
+void ShowFakeUpgrade(
+		not_null<Window::SessionController*> controller,
+		const QString &collection,
+		Fn<void(bool)> ready) {
+	const auto finish = [=](bool shown) {
+		if (ready) {
+			ready(shown);
+		}
+	};
+	if (OfflineForLaunch() || collection.isEmpty()) {
+		finish(false);
+		return;
+	}
+	const auto session = &controller->session();
+	const auto key = NameKey(collection);
+	RequestCatalog(session, crl::guard(controller, [=] {
+		const auto gift = FindInCatalog(session, [&](
+				const Data::StarGift &gift) {
+			return SameCollection(gift, key);
+		});
+		if (!gift) {
+			controller->showToast(
+				Lower(u"Couldn't find %1 among the gifts."_q).arg(collection));
+			finish(false);
+			return;
+		}
+		ShowFakeBox(controller, *gift, {
+			.cost = UpgradeCost(*gift),
+			.addDetailsDefault = true,
+		}, finish);
+	}));
+}
+
+void AddFakeUpgradeAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<ChatHelpers::Show> show,
+		const Data::CreditsHistoryEntry &e) {
+	if (!GiftFakeUpgrade()
+		|| OfflineForLaunch()
+		|| e.uniqueGift
+		|| !e.stargift
+		|| !e.stargiftId
+		|| !e.bareGiftStickerId
+		|| (!e.canUpgradeGift && e.starsToUpgrade <= 0)) {
+		return;
+	}
+	const auto session = &show->session();
+	const auto selfId = session->userPeerId().value;
+	const auto giftToSelf = (e.barePeerId == selfId)
+		&& (e.in || e.bareGiftOwnerId == selfId);
+	const auto prepaid = (e.starsUpgradedBySender > 0);
+	const auto flags = BoxFlags{
+		.cost = prepaid ? 0 : e.starsToUpgrade,
+		.canAddSender = !giftToSelf && !e.anonymous,
+		.canAddComment = !giftToSelf && !e.anonymous && e.hasGiftComment,
+		.canAddMyComment = giftToSelf && e.hasGiftComment,
+		.addDetailsDefault = giftToSelf
+			|| (prepaid && !e.giftUpgradeSeparate && !e.anonymous),
+	};
+	const auto fallback = Data::StarGift{
+		.id = e.stargiftId,
+		.stars = e.credits.ton() ? 0 : e.credits.whole(),
+		.starsToUpgrade = e.starsToUpgrade,
+		.document = session->data().document(e.bareGiftStickerId),
+		.resellTitle = e.giftTitle,
+		.limitedLeft = e.limitedLeft,
+		.limitedCount = e.limitedCount,
+		.upgradable = true,
+	};
+	menu->addAction(Lower(u"Fake upgrade"_q), [=] {
+		const auto window = show->resolveWindow();
+		if (!window) {
+			return;
+		}
+		RequestCatalog(session, crl::guard(window, [=] {
+			const auto found = FindInCatalog(session, [&](
+					const Data::StarGift &gift) {
+				return (gift.id == fallback.id);
+			});
+			auto gift = found ? *found : fallback;
+			auto copy = flags;
+			if (!prepaid && copy.cost <= 0) {
+				copy.cost = UpgradeCost(gift);
+			}
+			ShowFakeBox(window, gift, copy, nullptr);
+		}));
+	}, &st::menuIconUnique);
+}
+
+bool InterceptFakeUpgrade(
+		not_null<Window::SessionController*> window,
+		const Data::SavedStarGiftId &savedId,
+		Fn<void(bool, std::shared_ptr<Data::GiftUpgradeResult>)> done) {
+	const auto session = &window->session();
+	const auto state = Lookup(session);
+	if (!state || !savedId.isUser()) {
+		return false;
+	}
+	const auto i = state->boxes.find(savedId.userMessageId().bare);
+	if (i == end(state->boxes)) {
+		return false;
+	}
+	const auto gift = i->second;
+	const auto auctions = &session->giftAuctions();
+	const auto proceed = [=] {
+		const auto attributes = auctions->attributes(gift.id);
+		if (!attributes
+			|| attributes->models.empty()
+			|| attributes->patterns.empty()
+			|| attributes->backdrops.empty()) {
+			done(false, nullptr);
+			return;
+		}
+		auto &state = StateFor(session);
+		const auto issued = state.issued[gift.id];
+		const auto number = issued.issued + (++state.rolled[gift.id]);
+		const auto total = (issued.total > 0)
+			? issued.total
+			: gift.limitedCount;
+		auto result = std::make_shared<Data::GiftUpgradeResult>(
+			Data::GiftUpgradeResult{
+				.info = gift,
+				.manageId = savedId,
+				.date = base::unixtime::now(),
+				.saved = true,
+			});
+		if (total > 0) {
+			result->info.limitedCount = std::max(total, number);
+			result->info.limitedLeft = result->info.limitedCount - number;
+		}
+		result->info.unique = MakeUnique(
+			session,
+			gift,
+			*attributes,
+			number);
+		state.history.insert(begin(state.history), result->info.unique);
+		if (int(state.history.size()) > kHistoryLimit) {
+			state.history.resize(kHistoryLimit);
+		}
+		state.changed.fire({});
+		base::call_delayed(kUpgradeDelay, window, [=] {
+			done(true, result);
+		});
+	};
+	const auto left = std::make_shared<int>(2);
+	const auto ready = [=] {
+		if (!--*left) {
+			proceed();
+		}
+	};
+	RequestIssued(session, gift, ready);
+	if (auctions->attributes(gift.id)) {
+		ready();
+	} else {
+		auctions->requestAttributes(gift.id, ready);
+	}
+	return true;
+}
+
+std::vector<std::shared_ptr<Data::UniqueGift>> FakeUpgrades(
+		not_null<Main::Session*> session) {
+	const auto state = Lookup(session);
+	return state ? state->history : std::vector<
+		std::shared_ptr<Data::UniqueGift>>();
+}
+
+rpl::producer<> FakeUpgradesChanged(not_null<Main::Session*> session) {
+	return StateFor(session).changed.events();
+}
+
+void ClearFakeUpgrades(not_null<Main::Session*> session) {
+	if (const auto state = Lookup(session)) {
+		state->history.clear();
+		state->rolled.clear();
+		state->changed.fire({});
+	}
+}
+
+} // namespace Tele
