 #include "ui/text/text_utilities.h"
 #include "ui/toast/toast.h"
 #include "ui/widgets/labels.h"
@@ -16,10 +20,10 @@ namespace {
 constexpr auto kLinkIndex = uint16(1);
 constexpr auto kChannelShift = int64(1000000000000LL);
 
-class PeerIdClickHandler final : public ClickHandler {
+class CopyClickHandler final : public ClickHandler {
 public:
-	PeerIdClickHandler(QString id, Fn<void()> copy)
-	: _id(std::move(id))
+	CopyClickHandler(QString text, Fn<void()> copy)
+	: _text(std::move(text))
 	, _copy(std::move(copy)) {
 	}
 
@@ -29,11 +33,11 @@ public:
 		}
 	}
 	QString dragText() const override {
-		return _id;
+		return _text;
 	}
 
 private:
-	const QString _id;
+	const QString _text;
 	const Fn<void()> _copy;
 
 };
@@ -48,6 +52,38 @@ private:
 	});
 }
 
+[[nodiscard]] int PeerDc(not_null<PeerData*> peer) {
+	if (peer->isSelf()) {
+		return peer->session().mtp().mainDcId();
+	}
+	const auto &data = peer->userpicLocation().file().data;
+	const auto file = std::get_if<StorageFileLocation>(&data);
+	return file ? file->dcId() : 0;
+}
+
+[[nodiscard]] QString DcLocation(not_null<PeerData*> peer, int dc) {
+	if (peer->session().isTestMode()) {
+		return QString();
+	}
+	switch (dc) {
+	case 1:
+	case 3: return u"Miami"_q;
+	case 2:
+	case 4: return u"Amsterdam"_q;
+	case 5: return u"Singapore"_q;
+	}
+	return QString();
+}
+
+[[nodiscard]] rpl::producer<int> PeerDcValue(not_null<PeerData*> peer) {
+	return peer->session().changes().peerFlagsValue(
+		peer,
+		Data::PeerUpdate::Flag::Photo
+	) | rpl::map([=](const Data::PeerUpdate &) {
+		return PeerDc(peer);
+	}) | rpl::distinct_until_changed();
+}
+
 } // namespace
 
 QString FormatPeerId(not_null<PeerData*> peer) {
@@ -88,7 +124,7 @@ void SetupPeerIdLabel(
 	PeerIdValue(peer) | rpl::on_next([=](const QString &id) {
 		label->setLink(
 			kLinkIndex,
-			std::make_shared<PeerIdClickHandler>(id, copy));
+			std::make_shared<CopyClickHandler>(id, copy));
 	}, label->lifetime());
 	label->setContextMenuHook([=](
 			Ui::FlatLabel::ContextMenuRequest request) {
@@ -100,4 +136,48 @@ void SetupPeerIdLabel(
 	});
 }
 
+rpl::producer<TextWithEntities> PeerDcTextValue(not_null<PeerData*> peer) {
+	return PeerDcValue(peer) | rpl::map([=](int dc) {
+		if (!dc) {
+			return TextWithEntities();
+		}
+		const auto location = DcLocation(peer, dc);
+		return Ui::Text::Link(
+			(location.isEmpty()
+				? QString::number(dc)
+				: u"%1, %2"_q.arg(dc).arg(location)),
+			kLinkIndex);
+	});
+}
+
+void SetupPeerDcLabel(
+		not_null<Ui::FlatLabel*> label,
+		not_null<PeerData*> peer,
+		not_null<Window::SessionController*> controller) {
+	const auto weak = base::make_weak(controller);
+	const auto copy = [=] {
+		TextUtilities::SetClipboardText({ QString::number(PeerDc(peer)) });
+		if (const auto strong = weak.get()) {
+			strong->showToast({
+				.text = { u"DC copied to clipboard."_q },
+				.iconLottie = u"toast/copy"_q,
+				.iconLottieSize = st::toastLottieIconSize,
+			});
+		}
+	};
+	PeerDcValue(peer) | rpl::on_next([=](int dc) {
+		label->setLink(
+			kLinkIndex,
+			std::make_shared<CopyClickHandler>(QString::number(dc), copy));
+	}, label->lifetime());
+	label->setContextMenuHook([=](
+			Ui::FlatLabel::ContextMenuRequest request) {
+		if (request.selection.empty()) {
+			request.menu->addAction(u"Copy DC"_q, copy);
+		} else {
+			label->fillContextMenu(request);
+		}
+	});
+}
+
 } // namespace Tele
