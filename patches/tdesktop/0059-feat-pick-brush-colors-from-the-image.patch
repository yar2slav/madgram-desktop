+
+class EyedropperButton final : public Ui::AbstractButton {
+public:
+	using Ui::AbstractButton::AbstractButton;
+
+private:
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		auto hq = PainterHighQualityEnabler(p);
+
+		const auto u = float64(st::photoEditorColorPalettePlusLine);
+		const auto fg = st::photoEditorColorPalettePlusFg->c;
+		p.translate(QRectF(rect()).center());
+		p.rotate(-45.);
+		p.translate(-0.125 * u, 0.);
+
+		auto pen = QPen(fg, u * 0.75);
+		pen.setCapStyle(Qt::RoundCap);
+		p.setPen(pen);
+		p.drawLine(QPointF(-3.75 * u, 0.), QPointF(-1.75 * u, 0.));
+
+		p.setPen(Qt::NoPen);
+		p.setBrush(fg);
+		p.drawRoundedRect(
+			QRectF(-1.75 * u, -0.75 * u, 3.5 * u, 1.5 * u),
+			0.3 * u,
+			0.3 * u);
+
+		pen.setWidthF(u);
+		p.setPen(pen);
+		p.drawLine(QPointF(2. * u, -1.5 * u), QPointF(2. * u, 1.5 * u));
+
+		p.setPen(Qt::NoPen);
+		p.drawRoundedRect(
+			QRectF(2.5 * u, -u, 1.5 * u, 2. * u),
+			0.75 * u,
+			0.75 * u);
+	}
+
+};
+
+class Eyedropper final : public Ui::RpWidget {
+public:
+	Eyedropper(
+		not_null<Ui::RpWidget*> parent,
+		Fn<std::optional<QColor>(QPoint)> sample,
+		QPointer<QWidget> wheelTarget,
+		Fn<void(QColor)> done);
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void wheelEvent(QWheelEvent *e) override;
+	void keyPressEvent(QKeyEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+
+	void updateSample(QPoint point);
+	void updatePreview();
+	void finish(std::optional<QColor> color);
+	[[nodiscard]] QRect previewRect() const;
+
+	const Fn<std::optional<QColor>(QPoint)> _sample;
+	const QPointer<QWidget> _wheelTarget;
+	const Fn<void(QColor)> _done;
+	const QPointer<QWidget> _focused;
+	std::optional<QColor> _color;
+	QPoint _point;
+	Qt::MouseButton _pressed = Qt::NoButton;
+	bool _finished = false;
+
+};
+
+Eyedropper::Eyedropper(
+	not_null<Ui::RpWidget*> parent,
+	Fn<std::optional<QColor>(QPoint)> sample,
+	QPointer<QWidget> wheelTarget,
+	Fn<void(QColor)> done)
+: RpWidget(parent)
+, _sample(std::move(sample))
+, _wheelTarget(std::move(wheelTarget))
+, _done(std::move(done))
+, _focused(QApplication::focusWidget()) {
+	setMouseTracking(true);
+	setFocusPolicy(Qt::StrongFocus);
+	setContextMenuPolicy(Qt::PreventContextMenu);
+	parent->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		setGeometry(QRect(QPoint(), size));
+	}, lifetime());
+	show();
+	raise();
+	setFocus();
+	updateSample(mapFromGlobal(QCursor::pos()));
+}
+
+QRect Eyedropper::previewRect() const {
+	const auto size = st::photoEditorColorPaletteItemSize * 2;
+	const auto skip = st::photoEditorColorPaletteItemSize / 2;
+	auto left = _point.x() + skip;
+	auto top = _point.y() - skip - size;
+	if (left + size > width()) {
+		left = _point.x() - skip - size;
+	}
+	if (top < 0) {
+		top = _point.y() + skip;
+	}
+	return QRect(left, top, size, size);
+}
+
+void Eyedropper::updatePreview() {
+	if (_color) {
+		update(previewRect());
+	}
+}
+
+void Eyedropper::updateSample(QPoint point) {
+	updatePreview();
+	_point = point;
+	_color = _sample(mapToGlobal(point));
+	setCursor(_color ? style::cur_cross : style::cur_default);
+	updatePreview();
+}
+
+void Eyedropper::finish(std::optional<QColor> color) {
+	if (_finished) {
+		return;
+	}
+	_finished = true;
+	hide();
+	if (_focused) {
+		_focused->setFocus();
+	}
+	if (color) {
+		_done(*color);
+	}
+	deleteLater();
+}
+
+void Eyedropper::paintEvent(QPaintEvent *e) {
+	if (!_color) {
+		return;
+	}
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto border = float64(st::photoEditorColorPaletteSelectionWidth);
+	const auto outer = QRectF(previewRect());
+	const auto ring = outer.marginsRemoved(QMarginsF(1., 1., 1., 1.));
+	p.setPen(Qt::NoPen);
+	p.setBrush(QColor(0, 0, 0, 64));
+	p.drawEllipse(outer);
+	p.setBrush(QColor(255, 255, 255));
+	p.drawEllipse(ring);
+	p.setBrush(*_color);
+	p.drawEllipse(ring.marginsRemoved(
+		QMarginsF(border, border, border, border)));
+}
+
+void Eyedropper::mouseMoveEvent(QMouseEvent *e) {
+	updateSample(e->pos());
+}
+
+void Eyedropper::mousePressEvent(QMouseEvent *e) {
+	if (_pressed == Qt::NoButton) {
+		_pressed = e->button();
+	}
+	updateSample(e->pos());
+}
+
+void Eyedropper::mouseReleaseEvent(QMouseEvent *e) {
+	if (e->button() != _pressed) {
+		return;
+	}
+	_pressed = Qt::NoButton;
+	if (e->button() == Qt::LeftButton) {
+		updateSample(e->pos());
+		finish(_color);
+	} else if (e->button() == Qt::RightButton) {
+		finish(std::nullopt);
+	}
+}
+
+void Eyedropper::wheelEvent(QWheelEvent *e) {
+	e->accept();
+	const auto target = _wheelTarget.data();
+	if (!target) {
+		return;
+	}
+	const auto global = e->globalPosition();
+	const auto local = target->mapFromGlobal(global.toPoint());
+	if (!target->rect().contains(local)) {
+		return;
+	}
+	auto forwarded = QWheelEvent(
+		QPointF(local),
+		global,
+		e->pixelDelta(),
+		e->angleDelta(),
+		e->buttons(),
+		e->modifiers(),
+		e->phase(),
+		e->inverted());
+	QCoreApplication::sendEvent(target, &forwarded);
+	updateSample(_point);
+}
+
+void Eyedropper::keyPressEvent(QKeyEvent *e) {
+	e->accept();
+	if (e->key() == Qt::Key_Escape) {
+		finish(std::nullopt);
+	}
+}
+
+void Eyedropper::leaveEventHook(QEvent *e) {
+	updatePreview();
+	_color = std::nullopt;
+}
+
+[[nodiscard]] std::optional<QColor> SampleScene(
+		not_null<QGraphicsView*> view,
+		const QImage &image,
+		QPoint point) {
+	const auto scene = view->scene();
+	if (!scene
+		|| image.isNull()
+		|| !view->viewport()->rect().contains(point)) {
+		return std::nullopt;
+	}
+	const auto bounds = scene->sceneRect();
+	const auto mapped = view->viewportTransform().inverted().map(
+		QPointF(point) + QPointF(0.5, 0.5));
+	if (bounds.isEmpty() || !bounds.contains(mapped)) {
+		return std::nullopt;
+	}
+	const auto scaleX = image.width() / bounds.width();
+	const auto scaleY = image.height() / bounds.height();
+	const auto x = std::clamp(
+		int(std::floor((mapped.x() - bounds.x()) * scaleX)),
+		0,
+		image.width() - 1);
+	const auto y = std::clamp(
+		int(std::floor((mapped.y() - bounds.y()) * scaleY)),
+		0,
+		image.height() - 1);
+	const auto source = QRectF(
+		bounds.x() + x / scaleX,
+		bounds.y() + y / scaleY,
+		1. / scaleX,
+		1. / scaleY);
+
+	auto result = QImage(1, 1, QImage::Format_ARGB32_Premultiplied);
+	result.fill(image.pixelColor(x, y));
+	const auto selected = scene->selectedItems();
+	{
+		const auto blocker = QSignalBlocker(scene);
+		for (const auto item : selected) {
+			item->setSelected(false);
+		}
+		{
+			auto p = QPainter(&result);
+			auto hq = PainterHighQualityEnabler(p);
+			scene->render(
+				&p,
+				QRectF(0., 0., 1., 1.),
+				source,
+				Qt::IgnoreAspectRatio);
+		}
+		for (const auto item : selected) {
+			item->setSelected(true);
+		}
+	}
+	auto color = result.pixelColor(0, 0);
+	if (!color.alpha()) {
+		return std::nullopt;
+	}
+	color.setAlpha(255);
+	return color;
+}
+
+} // namespace
+
+base::unique_qptr<Ui::AbstractButton> MakeEditorEyedropperButton(
+		not_null<QWidget*> parent,
+		Fn<void()> clicked) {
+	auto result = base::make_unique_q<EyedropperButton>(parent);
+	result->setClickedCallback(std::move(clicked));
+	result->show();
+	return result;
+}
+
+void SetupEditorEyedropper(
+		not_null<Ui::RpWidget*> editor,
+		not_null<QWidget*> content,
+		std::shared_ptr<Image> photo,
+		not_null<Editor::ColorPicker*> picker) {
+	const auto active = editor->lifetime().make_state<
+		QPointer<Eyedropper>
+	>();
+	const auto weakContent = QPointer<QWidget>(content.get());
+	picker->eyedropperRequests(
+	) | rpl::on_next([=] {
+		if (*active || !weakContent) {
+			return;
+		}
+		const auto view = weakContent->findChild<QGraphicsView*>();
+		if (!view || !view->scene()) {
+			return;
+		}
+		const auto weakView = QPointer<QGraphicsView>(view);
+		const auto image = photo->original();
+		auto sample = [=](QPoint global) -> std::optional<QColor> {
+			if (!weakContent || !weakView) {
+				return std::nullopt;
+			}
+			const auto local = weakContent->mapFromGlobal(global);
+			if (!weakContent->rect().contains(local)) {
+				return std::nullopt;
+			}
+			return SampleScene(
+				weakView.data(),
+				image,
+				weakView->viewport()->mapFromGlobal(global));
+		};
+		*active = Ui::CreateChild<Eyedropper>(
+			editor.get(),
+			std::move(sample),
+			QPointer<QWidget>(view->viewport()),
+			[=](QColor color) { picker->applyColor(color); });
+	}, editor->lifetime());
+}
+
+} // namespace Tele
