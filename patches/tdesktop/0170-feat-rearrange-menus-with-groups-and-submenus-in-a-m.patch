+[[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeItem(
+		not_null<Ui::Menu::Menu*> parent,
+		const style::Menu &topSt,
+		const Element &element) {
+	const auto &st = (element.st && element.st != &topSt)
+		? *element.st
+		: parent->st();
+	if (element.kind == ElementKind::Toggle) {
+		const auto weak = QPointer<QAction>(element.action.get());
+		auto result = base::make_unique_q<Ui::Menu::Toggle>(
+			parent,
+			st,
+			element.text,
+			[=] {
+				if (const auto strong = weak.data()) {
+					strong->trigger();
+				}
+			},
+			element.icon,
+			element.icon);
+		result->action()->setCheckable(element.checkable);
+		result->action()->setChecked(element.checked);
+		result->action()->setEnabled(element.action->isEnabled());
+		QObject::connect(result->action(), &QObject::destroyed, [=] {
+			if (const auto strong = weak.data()) {
+				strong->deleteLater();
+			}
+		});
+		FitMenuToggle(result.get());
+		return base::unique_qptr<Ui::Menu::ItemBase>(std::move(result));
+	}
+	return base::make_unique_q<Ui::Menu::Action>(
+		parent,
+		st,
+		element.action,
+		element.icon,
+		element.icon);
+}
+
+[[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeSeparator(
+		not_null<Ui::Menu::Menu*> parent,
+		const style::MenuSeparator *separator) {
+	const auto action = new QAction(parent);
+	action->setSeparator(true);
+	return base::make_unique_q<Ui::Menu::Separator>(
+		parent,
+		parent->st(),
+		separator ? *separator : parent->st().separator,
+		action);
+}
+
+[[nodiscard]] not_null<QAction*> MakeSubmenuAction(
+		not_null<Ui::Menu::Menu*> parent,
+		const QString &title) {
+	const auto action = new QAction(Lower(title), parent);
+	action->setMenu(Ui::CreateChild<QMenu>(parent.get()));
+	return action;
+}
