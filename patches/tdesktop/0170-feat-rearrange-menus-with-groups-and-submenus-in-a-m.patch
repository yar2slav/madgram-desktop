+#include "tele/tele_menu_layout.h"
+
+#include "tele/tele_menu_registry.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+enum class Missing : uchar {
+	Fresh,
+	Visible,
+	Hidden,
+};
+
+[[nodiscard]] bool KeyChar(QChar ch) {
+	return (ch >= 'a' && ch <= 'z')
+		|| (ch >= '0' && ch <= '9')
+		|| (ch == '_')
+		|| (ch == '.');
+}
+
+[[nodiscard]] bool Special(QChar ch) {
+	return (ch == '\\')
+		|| (ch == ',')
+		|| (ch == ':')
+		|| (ch == '[')
+		|| (ch == ']')
+		|| (ch == '#')
+		|| (ch == '|');
+}
+
+class Parser final {
+public:
+	explicit Parser(const QString &text) : _text(text) {
+	}
+
+	[[nodiscard]] std::optional<MenuLayout> parse() {
+		auto result = MenuLayout();
+		if (!parseList(result, false)) {
+			return std::nullopt;
+		}
+		skipSpaces();
+		if (!atEnd()) {
+			return std::nullopt;
+		}
+		return result;
+	}
+
+private:
+	[[nodiscard]] bool atEnd() const {
+		return (_index >= _text.size());
+	}
+	[[nodiscard]] QChar peek() const {
+		return atEnd() ? QChar() : _text[_index];
+	}
+	void skipSpaces() {
+		while (!atEnd() && peek().isSpace()) {
+			++_index;
+		}
+	}
+
+	[[nodiscard]] bool parseList(MenuLayout &out, bool nested) {
+		skipSpaces();
+		if (atEnd() || (nested && peek() == ']')) {
+			return true;
+		}
+		while (true) {
+			auto entry = MenuEntry();
+			if (!parseEntry(entry, nested)) {
+				return false;
+			}
+			out.push_back(std::move(entry));
+			skipSpaces();
+			if (atEnd() || (nested && peek() == ']')) {
+				return true;
+			} else if (peek() != ',') {
+				return false;
+			}
+			++_index;
+			skipSpaces();
+		}
+	}
+
+	[[nodiscard]] bool parseEntry(MenuEntry &entry, bool nested) {
+		if (peek() == '|') {
+			++_index;
+			entry.type = MenuEntry::Type::Separator;
+			if (peek() == '-') {
+				++_index;
+				entry.separator = MenuSeparatorStyle::Thin;
+			} else if (peek() == '=') {
+				++_index;
+				entry.separator = MenuSeparatorStyle::Thick;
+			}
+			return true;
+		} else if (peek() == '-') {
+			++_index;
+			entry.hidden = true;
+		}
+		if (peek() == '[') {
+			++_index;
+			entry.type = MenuEntry::Type::Submenu;
+			return parseSubmenu(entry);
+		}
+		while (!atEnd() && KeyChar(peek())) {
+			entry.key.append(peek());
+			++_index;
+		}
+		return !entry.key.isEmpty();
+	}
+
+	[[nodiscard]] bool parseSubmenu(MenuEntry &entry) {
+		while (!atEnd() && peek() != ':' && peek() != '#') {
+			if (peek() == '\\') {
+				++_index;
+				if (atEnd()) {
+					return false;
+				}
+			} else if (Special(peek())) {
+				return false;
+			}
+			entry.title.append(peek());
+			++_index;
+		}
+		entry.title = entry.title.trimmed();
+		if (peek() == '#') {
+			++_index;
+			while (!atEnd() && KeyChar(peek())) {
+				entry.icon.append(peek());
+				++_index;
+			}
+		}
+		if (peek() != ':') {
+			return false;
+		}
+		++_index;
+		if (!parseList(entry.entries, true) || peek() != ']') {
+			return false;
+		}
+		++_index;
+		return true;
+	}
+
+	const QString &_text;
+	int _index = 0;
+
+};
+
+[[nodiscard]] QString EscapeTitle(const QString &title) {
+	auto result = QString();
+	result.reserve(title.size());
+	for (const auto ch : title) {
+		if (ch == '\n' || ch == '\r') {
+			continue;
+		} else if (Special(ch)) {
+			result.append('\\');
+		}
+		result.append(ch);
+	}
+	return result;
+}
+
+void Serialize(const MenuLayout &layout, QString &out) {
+	auto first = true;
+	for (const auto &entry : layout) {
+		if (!first) {
+			out.append(',');
+		}
+		first = false;
+		if (entry.type == MenuEntry::Type::Separator) {
+			out.append('|');
+			if (entry.separator == MenuSeparatorStyle::Thin) {
+				out.append('-');
+			} else if (entry.separator == MenuSeparatorStyle::Thick) {
+				out.append('=');
+			}
+			continue;
+		} else if (entry.hidden) {
+			out.append('-');
+		}
+		if (entry.type == MenuEntry::Type::Item) {
+			out.append(entry.key);
+			continue;
+		}
+		out.append('[');
+		out.append(EscapeTitle(entry.title));
+		if (!entry.icon.isEmpty()) {
+			out.append('#');
+			out.append(entry.icon);
+		}
+		out.append(':');
+		Serialize(entry.entries, out);
+		out.append(']');
+	}
+}
+
+struct Location {
+	MenuLayout *list = nullptr;
+	int index = 0;
+};
+
+[[nodiscard]] std::optional<Location> Locate(
+		MenuLayout &layout,
+		const QString &key) {
+	for (auto i = 0; i != int(layout.size()); ++i) {
+		auto &entry = layout[i];
+		if (entry.type == MenuEntry::Type::Item && entry.key == key) {
+			return Location{ &layout, i };
+		} else if (entry.type == MenuEntry::Type::Submenu) {
+			if (const auto found = Locate(entry.entries, key)) {
+				return found;
+			}
+		}
+	}
+	return std::nullopt;
+}
+
+void Flatten(const MenuLayout &layout, std::vector<QString> &keys) {
+	for (const auto &entry : layout) {
+		if (entry.type == MenuEntry::Type::Item) {
+			keys.push_back(entry.key);
+		} else if (entry.type == MenuEntry::Type::Submenu) {
+			Flatten(entry.entries, keys);
+		}
+	}
+}
+
+void Clean(
+		MenuKind kind,
+		MenuLayout &layout,
+		base::flat_set<QString> &seen) {
+	for (auto i = layout.begin(); i != layout.end();) {
+		auto &entry = *i;
+		auto keep = true;
+		if (entry.type == MenuEntry::Type::Separator) {
+			entry.hidden = false;
+		} else if (entry.type == MenuEntry::Type::Item) {
+			keep = LookupMenuItem(kind, entry.key)
+				&& !seen.contains(entry.key);
+			if (keep) {
+				seen.emplace(entry.key);
+			}
+		} else {
+			Clean(kind, entry.entries, seen);
+			keep = ranges::any_of(entry.entries, [](const MenuEntry &e) {
+				return (e.type != MenuEntry::Type::Separator);
+			});
+		}
+		if (keep) {
+			entry.fresh = false;
+			++i;
+		} else {
+			i = layout.erase(i);
+		}
+	}
+}
+
+void InsertMissing(
+		MenuLayout &layout,
+		const std::vector<QString> &order,
+		int index,
+		MenuEntry entry) {
+	for (auto j = index - 1; j >= 0; --j) {
+		if (const auto found = Locate(layout, order[j])) {
+			auto &list = *found->list;
+			auto position = found->index + 1;
+			while (position < int(list.size())
+				&& list[position].type != MenuEntry::Type::Separator) {
+				++position;
+			}
+			list.insert(list.begin() + position, std::move(entry));
+			return;
+		}
+	}
+	for (auto j = index + 1; j < int(order.size()); ++j) {
+		if (const auto found = Locate(layout, order[j])) {
+			auto &list = *found->list;
+			list.insert(list.begin() + found->index, std::move(entry));
+			return;
+		}
+	}
+	layout.push_back(std::move(entry));
+}
+
+[[nodiscard]] MenuLayout ParseOrEmpty(const QString &text) {
+	auto parsed = ParseMenuLayout(text);
+	return parsed ? std::move(*parsed) : MenuLayout();
+}
+
+[[nodiscard]] MenuLayout Resolve(
+		MenuKind kind,
+		MenuLayout layout,
+		Missing missing) {
+	const auto &info = LookupMenu(kind);
+	auto seen = base::flat_set<QString>();
+	Clean(kind, layout, seen);
+
+	auto order = std::vector<QString>();
+	Flatten(ParseOrEmpty(info.defaults), order);
+	for (const auto &item : info.items) {
+		if (!ranges::contains(order, item.key)) {
+			order.push_back(item.key);
+		}
+	}
+	for (auto i = 0; i != int(order.size()); ++i) {
+		const auto &key = order[i];
+		if (seen.contains(key) || !LookupMenuItem(kind, key)) {
+			continue;
+		}
+		seen.emplace(key);
+		InsertMissing(layout, order, i, MenuEntry{
+			.key = key,
+			.hidden = (missing == Missing::Hidden),
+			.fresh = (missing == Missing::Fresh),
+		});
+	}
+	return layout;
+}
+
+[[nodiscard]] QString LineId(const QString &line) {
+	const auto position = line.indexOf('=');
+	return (position > 0) ? line.left(position).trimmed() : QString();
+}
+
+[[nodiscard]] QString LineText(const QString &line) {
+	const auto position = line.indexOf('=');
+	return (position > 0) ? line.mid(position + 1).trimmed() : QString();
+}
+
+void HideKeys(MenuLayout &layout, const base::flat_set<QString> &keys) {
+	for (auto &entry : layout) {
+		if (entry.type == MenuEntry::Type::Item && keys.contains(entry.key)) {
+			entry.hidden = true;
+		} else if (entry.type == MenuEntry::Type::Submenu) {
+			HideKeys(entry.entries, keys);
+		}
+	}
+}
+
+[[nodiscard]] QString MigrateLegacy(const QString &legacy) {
+	auto hidden = base::flat_set<QString>();
+	for (const auto &part : legacy.split(',', Qt::SkipEmptyParts)) {
+		const auto trimmed = part.trimmed();
+		if (trimmed.startsWith('-')
+			&& LookupMenuItem(MenuKind::Message, trimmed.mid(1))) {
+			hidden.emplace(trimmed.mid(1));
+		}
+	}
+	if (hidden.empty()) {
+		return QString();
+	}
+	auto layout = MenuPresetLayout(MenuKind::Message, MenuPreset::Default);
+	HideKeys(layout, hidden);
+	return SerializeMenuLayout(layout);
+}
+
+[[nodiscard]] QStringList StoredLines() {
+	if (const auto legacy = MessageMenuLegacy(); !legacy.isEmpty()) {
+		ClearMessageMenuLegacy();
+		const auto migrated = MigrateLegacy(legacy);
+		if (!migrated.isEmpty()) {
+			const auto id = LookupMenu(MenuKind::Message).id;
+			auto lines = MenuLayouts().split('\n', Qt::SkipEmptyParts);
+			const auto exists = ranges::any_of(lines, [&](const QString &l) {
+				return (LineId(l) == id);
+			});
+			if (!exists) {
+				lines.push_back(id + '=' + migrated);
+				SetMenuLayouts(lines.join('\n'));
+			}
+		}
+	}
+	return MenuLayouts().split('\n', Qt::SkipEmptyParts);
+}
+
+[[nodiscard]] QString StoredText(MenuKind kind) {
+	const auto id = LookupMenu(kind).id;
+	for (const auto &line : StoredLines()) {
+		if (LineId(line) == id) {
+			return LineText(line);
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] bool HasKnownItem(MenuKind kind, const MenuLayout &layout) {
+	for (const auto &entry : layout) {
+		if (entry.type == MenuEntry::Type::Item
+			&& LookupMenuItem(kind, entry.key)) {
+			return true;
+		} else if (entry.type == MenuEntry::Type::Submenu
+			&& HasKnownItem(kind, entry.entries)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void ExplicitSeparators(MenuKind kind, MenuLayout &layout, bool top) {
+	for (auto i = 0; i != int(layout.size()); ++i) {
+		auto &entry = layout[i];
+		if (entry.type == MenuEntry::Type::Submenu) {
+			ExplicitSeparators(kind, entry.entries, false);
+			continue;
+		} else if (entry.type != MenuEntry::Type::Separator
+			|| entry.separator != MenuSeparatorStyle::Auto) {
+			continue;
+		}
+		auto expanded = false;
+		for (auto j = i + 1; j != int(layout.size()); ++j) {
+			const auto &next = layout[j];
+			if (next.type == MenuEntry::Type::Separator) {
+				continue;
+			} else if (next.type == MenuEntry::Type::Item) {
+				const auto item = LookupMenuItem(kind, next.key);
+				expanded = item && (item->flags & MenuItemFlag::Expanded);
+			}
+			break;
+		}
+		entry.separator = (top && expanded)
+			? MenuSeparatorStyle::Thick
+			: MenuSeparatorStyle::Thin;
+	}
+}
+
+} // namespace
+
+std::optional<MenuLayout> ParseMenuLayout(const QString &text) {
+	return Parser(text).parse();
+}
+
+QString SerializeMenuLayout(const MenuLayout &layout) {
+	auto result = QString();
+	Serialize(layout, result);
+	return result;
+}
+
+MenuLayout MenuPresetLayout(MenuKind kind, MenuPreset preset) {
+	const auto &info = LookupMenu(kind);
+	const auto styled = [&](MenuLayout layout) {
+		ExplicitSeparators(kind, layout, true);
+		return layout;
+	};
+	switch (preset) {
+	case MenuPreset::Default:
+		return styled(Resolve(
+			kind,
+			ParseOrEmpty(info.defaults),
+			Missing::Visible));
+	case MenuPreset::Upstream:
+		return Resolve(kind, ParseOrEmpty(info.upstream), Missing::Visible);
+	case MenuPreset::Minimal:
+		return styled(Resolve(
+			kind,
+			ParseOrEmpty(info.minimal),
+			Missing::Hidden));
+	case MenuPreset::Power:
+		return styled(Resolve(
+			kind,
+			ParseOrEmpty(info.power),
+			Missing::Visible));
+	}
+	Unexpected("Preset in Tele::MenuPresetLayout.");
+}
+
+MenuLayout ResolveMenuLayout(MenuKind kind, MenuLayout layout) {
+	return Resolve(kind, std::move(layout), Missing::Fresh);
+}
+
+MenuLayout CurrentMenuLayout(MenuKind kind) {
+	const auto text = StoredText(kind);
+	if (text.isEmpty()) {
+		return MenuPresetLayout(kind, MenuPreset::Default);
+	}
+	auto parsed = ParseMenuLayout(text);
+	if (!parsed || !HasKnownItem(kind, *parsed)) {
+		return MenuPresetLayout(kind, MenuPreset::Default);
+	}
+	return ResolveMenuLayout(kind, std::move(*parsed));
+}
+
+bool MenuLayoutCustom(MenuKind kind) {
+	return !StoredText(kind).isEmpty();
+}
+
+rpl::producer<bool> MenuLayoutCustomValue(MenuKind kind) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		MenuLayoutsChanges()
+	) | rpl::map([=] {
+		return MenuLayoutCustom(kind);
+	}) | rpl::distinct_until_changed();
+}
+
+void SaveMenuLayout(MenuKind kind, const MenuLayout &layout) {
+	const auto id = LookupMenu(kind).id;
+	const auto text = SerializeMenuLayout(
+		Resolve(kind, layout, Missing::Visible));
+	const auto defaults = SerializeMenuLayout(
+		MenuPresetLayout(kind, MenuPreset::Default));
+	auto lines = StoredLines();
+	lines.erase(ranges::remove_if(lines, [&](const QString &line) {
+		return (LineId(line) == id);
+	}), lines.end());
+	if (text != defaults) {
+		lines.push_back(id + '=' + text);
+	}
+	SetMenuLayouts(lines.join('\n'));
+}
+
+QString MenuLayoutClipboardText(MenuKind kind, const MenuLayout &layout) {
+	return LookupMenu(kind).id + '=' + SerializeMenuLayout(layout);
+}
+
+std::optional<MenuLayout> ParseMenuLayoutClipboard(
+		MenuKind kind,
+		const QString &text) {
+	const auto trimmed = text.trimmed();
+	const auto id = LineId(trimmed);
+	auto body = trimmed;
+	if (!id.isEmpty() && LookupMenu(id)) {
+		if (id != LookupMenu(kind).id) {
+			return std::nullopt;
+		}
+		body = LineText(trimmed);
+	}
+	auto parsed = ParseMenuLayout(body);
+	if (!parsed || !HasKnownItem(kind, *parsed)) {
+		return std::nullopt;
+	}
+	return ResolveMenuLayout(kind, std::move(*parsed));
+}
+
+std::optional<QString> NormalizeMenuLayouts(const QString &value) {
+	auto lines = QStringList();
+	auto ids = base::flat_set<QString>();
+	for (const auto &line : value.split('\n', Qt::SkipEmptyParts)) {
+		const auto info = LookupMenu(LineId(line));
+		if (!info || ids.contains(info->id)) {
+			continue;
+		}
+		const auto parsed = ParseMenuLayout(LineText(line));
+		if (!parsed || !HasKnownItem(info->kind, *parsed)) {
+			continue;
+		}
+		ids.emplace(info->id);
+		lines.push_back(info->id + '=' + SerializeMenuLayout(
+			Resolve(info->kind, *parsed, Missing::Visible)));
+	}
+	if (lines.isEmpty() && !value.trimmed().isEmpty()) {
+		return std::nullopt;
+	}
+	return lines.join('\n');
+}
+
+} // namespace Tele
