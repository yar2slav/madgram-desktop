-[[nodiscard]] Ui::ScrollArea *FindScroll(not_null<QWidget*> widget) {
-	for (auto parent = widget->parentWidget()
-		; parent
-		; parent = parent->parentWidget()) {
-		if (const auto scroll = dynamic_cast<Ui::ScrollArea*>(parent)) {
-			return scroll;
-		}
-	}
-	return nullptr;
-}
