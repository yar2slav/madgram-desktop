+[[nodiscard]] QString MenuRowId(const QString &menu) {
+	return u"tele-menu-"_q + menu;
+}
+
+[[nodiscard]] QString CurrentControlId(const QString &id) {
+	return (id == QString::fromLatin1(::Tele::kOptionMessageMenuLegacy))
+		? MenuRowId(u"message"_q)
+		: id;
+}
+
 void AddMessageMenu(SectionBuilder &builder) {
-	const auto &option = base::options::lookup<QString>(
-		::Tele::kOptionMessageMenuLayout);
 	const auto controller = builder.controller();
-	const auto description = ::Tele::Lower(option.description());
-	const auto button = AddButton(builder, {
-		.id = option.id(),
-		.title = rpl::single(::Tele::Lower(option.name())),
-		.st = &st::settingsButtonNoIcon,
-		.label = ::Tele::MessageMenuLayoutValue(
-		) | rpl::map([](const QString &layout) {
-			return ::Tele::Lower(layout.isEmpty()
-				? u"Default"_q
-				: u"Custom"_q);
-		}),
-		.onClick = [=] {
-			controller->show(Box(::Tele::MessageMenuBox));
-		},
-		.keywords = { description, u"context"_q, u"right-click"_q },
-	});
-	if (button) {
-		SetupLink(button, option.id());
+	if (controller) {
+		const auto was = controller->highlightControlId();
+		if (const auto now = CurrentControlId(was); now != was) {
+			controller->setHighlightControlId(now);
+		}
+	}
+	for (const auto kind : ::Tele::MenuKinds()) {
+		const auto &info = ::Tele::LookupMenu(kind);
+		const auto id = MenuRowId(info.id);
+		const auto button = AddButton(builder, {
+			.id = id,
+			.title = rpl::single(info.name()),
+			.st = &st::settingsButtonNoIcon,
+			.label = ::Tele::MenuLayoutCustomValue(
+				kind
+			) | rpl::map([](bool custom) {
+				return ::Tele::Lower(custom ? u"Custom"_q : u"Default"_q);
+			}),
+			.onClick = [=] {
+				controller->show(Box(::Tele::MenuEditorBox, kind, -1));
+			},
+			.keywords = {
+				u"context"_q,
+				u"right-click"_q,
+				u"reorder"_q,
+				u"submenu"_q,
+			},
+		}, ::Tele::kOptionMenuLayouts);
+		if (button) {
+			SetupLink(button, id);
+		}
 	}
-	AddAbout(builder, option.id(), description);
 }
 
