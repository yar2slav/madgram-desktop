+
+Preview::Widths Preview::NaturalWidths(not_null<State*> state) {
+	const auto &popup = PreviewStyle(state->kind);
+	const auto menu = base::make_unique_q<Ui::Menu::Menu>(
+		nullptr,
+		popup.menu);
+	for (const auto &item : LookupMenu(state->kind).items) {
+		if (!Listed(item)) {
+			continue;
+		}
+		const auto icon = MenuItemIcon(item);
+		const auto action = menu->addAction(
+			MenuItemLabel(item),
+			[] {},
+			icon,
+			icon);
+		if (item.flags & MenuItemFlag::Submenu) {
+			action->setMenu(Ui::CreateChild<QMenu>(menu.get()));
+		}
+	}
+	auto submenus = std::vector<Path>();
+	auto prefix = Path();
+	CollectSubmenus(state->layout, prefix, submenus);
+	auto titles = std::vector<QString>{ DefaultTitle() };
+	for (const auto &path : submenus) {
+		titles.push_back(EntryTitle(state->kind, At(state->layout, path)));
+	}
+	for (const auto &title : titles) {
+		const auto action = menu->addAction(title, [] {});
+		action->setMenu(Ui::CreateChild<QMenu>(menu.get()));
+	}
+	const auto column = menu->width()
+		+ popup.scrollPadding.left()
+		+ popup.scrollPadding.right();
+	const auto extend = Ui::BoxShadow::ExtendFor(popup.shadow);
+	const auto skip = st::boxRowPadding.left() / 2;
+	const auto margins = std::max(extend.left(), skip)
+		+ std::max(extend.right(), skip);
+	return {
+		.single = margins + column,
+		.full = margins + column + skip + column,
+	};
+}
+
+void Preview::setScroll(not_null<Ui::ScrollArea*> scroll) {
+	_scroll = scroll;
+	scroll->sizeValue() | rpl::skip(1) | rpl::on_next([=] {
+		place();
+	}, lifetime());
+}
+
+void Preview::setPaneWidth(int width) {
+	_paneWidth = width;
+	place();
+}
+
+int Preview::outerLeft() const {
+	return std::max(
+		_shadow.extend().left(),
+		st::boxRowPadding.left() / 2);
+}
+
+QRect Preview::stripRect() const {
+	if (!_strip) {
+		return QRect();
+	}
+	const auto padding = _popup.scrollPadding;
+	return QRect(
+		outerLeft(),
+		_shadow.extend().top(),
+		std::max(
+			_main->width() + padding.left() + padding.right(),
+			st::normalFont->height * 8),
+		st::normalFont->height * 2 + padding.top() + padding.bottom());
+}
+
+bool Preview::enabled(const MenuEntry &entry) const {
+	if (entry.type != Type::Item) {
+		return true;
+	}
+	const auto item = LookupMenuItem(_state->kind, entry.key);
+	return item && FeatureOn(*item) && Applies(*item, _state->context);
+}
+
+void Preview::lifted(
+		const MenuLayout &list,
+		const Path &prefix,
+		std::vector<Shown> &result) const {
+	for (auto i = 0; i != int(list.size()); ++i) {
+		const auto &entry = list[i];
+		auto path = prefix;
+		path.push_back(i);
+		if (entry.hidden) {
+			continue;
+		} else if (entry.type == Type::Submenu) {
+			lifted(entry.entries, path, result);
+		} else if (entry.type == Type::Item) {
+			const auto item = LookupMenuItem(_state->kind, entry.key);
+			if (item
+				&& TopLevelOnly(*item)
+				&& !(item->flags & MenuItemFlag::Strip)) {
+				result.push_back({ &entry, path });
+			}
+		}
+	}
+}
+
+std::vector<Preview::Shown> Preview::visible(
+		const MenuLayout &list,
+		const Path &prefix,
+		bool top) const {
+	auto result = std::vector<Shown>();
+	for (auto i = 0; i != int(list.size()); ++i) {
+		const auto &entry = list[i];
+		auto path = prefix;
+		path.push_back(i);
+		if (entry.hidden) {
+			continue;
+		} else if (entry.type == Type::Separator) {
+			if (!result.empty()) {
+				result.push_back({ &entry, path });
+			}
+			continue;
+		} else if (entry.type == Type::Submenu) {
+			if (top) {
+				lifted(entry.entries, path, result);
+			}
+			if (visible(entry.entries, path, false).empty()) {
+				continue;
+			}
+		} else if (const auto item = LookupMenuItem(_state->kind, entry.key)
+			; !item
+			|| (item->flags & MenuItemFlag::Strip)
+			|| (!top && TopLevelOnly(*item))) {
+			continue;
+		}
+		result.push_back({ &entry, path });
+	}
+	while (!result.empty() && result.back().entry->type == Type::Separator) {
+		result.pop_back();
+	}
+	return result;
+}
+
+void Preview::fill(
+		not_null<Ui::Menu::Menu*> menu,
+		const MenuLayout &list,
+		const Path &prefix,
+		base::flat_map<QAction*, Path> &paths,
+		bool top) {
+	const auto shown = visible(list, prefix, top);
+	auto thickest = (const style::MenuSeparator*)nullptr;
+	for (auto i = 0; i != int(shown.size()); ++i) {
+		const auto &[entry, path] = shown[i];
+		if (entry->type == Type::Separator) {
+			auto j = i + 1;
+			while (shown[j].entry->type == Type::Separator) {
+				++j;
+			}
+			const auto &next = *shown[j].entry;
+			const auto item = (next.type == Type::Item)
+				? LookupMenuItem(_state->kind, next.key)
+				: nullptr;
+			const auto expanded = item
+				&& (item->flags & MenuItemFlag::Expanded);
+			const auto &resolved = MenuSeparatorFor(
+				_st,
+				entry->separator,
+				expanded,
+				top);
+			if (!thickest || resolved.width > thickest->width) {
+				thickest = &resolved;
+			}
+			if (j == i + 1) {
+				menu->addSeparator(base::take(thickest));
+			}
+			continue;
+		}
+		const auto icon = EntryIcon(_state->kind, *entry);
+		const auto action = menu->addAction(
+			EntryTitle(_state->kind, *entry),
+			[] {},
+			icon,
+			icon);
+		if (entry->type == Type::Submenu) {
+			action->setMenu(Ui::CreateChild<QMenu>(menu.get()));
+			paths.emplace(action.get(), path);
+		} else {
+			const auto item = LookupMenuItem(_state->kind, entry->key);
+			action->setEnabled(enabled(*entry));
+			if (item && (item->flags & MenuItemFlag::Submenu)) {
+				action->setMenu(Ui::CreateChild<QMenu>(menu.get()));
+			}
+		}
+	}
+}
+
+Ui::Menu::Menu *Preview::levelMenu(int level) const {
+	return (level < 0)
+		? _main.get()
+		: (level < int(_levels.size()))
+		? _levels[level].menu
+		: nullptr;
+}
+
+const base::flat_map<QAction*, Path> *Preview::levelPaths(int level) const {
+	return (level < 0)
+		? &_mainPaths
+		: (level < int(_levels.size()))
+		? &_levels[level].paths
+		: nullptr;
+}
+
+void Preview::setupMenu(not_null<Ui::Menu::Menu*> menu, int level) {
+	menu->setTriggeredCallback([=](const Ui::Menu::CallbackData &data) {
+		clicked(level, data.action);
+	});
+	menu->setMousePressDelegate([=](QPoint) {
+		clicked(level, nullptr);
+	});
+}
+
+void Preview::clicked(int level, QAction *action) {
+	if (_pending) {
+		return;
+	}
+	auto path = std::optional<Path>();
+	if (const auto paths = levelPaths(level); paths && action) {
+		if (const auto i = paths->find(action); i != paths->end()) {
+			path = i->second;
+		}
+	}
+	_pending = true;
+	crl::on_main(this, [=] {
+		_pending = false;
+		if (!path) {
+			closeFrom(0);
+			return;
+		}
+		const auto child = level + 1;
+		if (child < int(_levels.size()) && _levels[child].path == *path) {
+			closeFrom(child);
+		} else {
+			open(level, *path);
+		}
+	});
+}
+
+void Preview::open(int level, const Path &path) {
+	const auto parent = levelMenu(level);
+	const auto paths = levelPaths(level);
+	if (!parent || !paths || !IsSubmenu(_state->layout, path)) {
+		return;
+	}
+	auto action = (QAction*)nullptr;
+	for (const auto &[key, value] : *paths) {
+		if (value == path) {
+			action = key;
+		}
+	}
+	if (!action) {
+		return;
+	}
+	const auto &actions = parent->actions();
+	const auto i = ranges::find(actions, not_null<QAction*>(action));
+	const auto item = parent->itemForAction(not_null<QAction*>(action));
+	if (i == end(actions) || !item) {
+		return;
+	}
+	const auto index = int(i - begin(actions));
+	const auto top = item->mapTo(this, QPoint()).y();
+	closeFrom(level + 1);
+	parent->setMouseSelectionFrozen(true);
+	parent->setChildShownAction(action);
+	parent->setSelected(index, true);
+
+	auto frame = base::make_unique_q<MenuFrame>(this, _popup);
+	const auto menu = frame->menu();
+	auto children = base::flat_map<QAction*, Path>();
+	fill(menu, At(_state->layout, path).entries, path, children, false);
+	setupMenu(menu, level + 1);
+	frame->show();
+	const auto raw = frame.get();
+	_levels.push_back({
+		.frame = std::move(frame),
+		.menu = menu,
+		.paths = std::move(children),
+		.path = path,
+		.top = top,
+	});
+	place();
+	if (_scroll && !_restoring && !raw->isHidden()) {
+		const auto rect = raw->frame();
+		_scroll->scrollToY(rect.y(), rect.y() + rect.height());
+		_scroll->scrollToX(rect.x(), rect.x() + rect.width());
+	}
+}
+
+void Preview::closeFrom(int level) {
+	level = std::max(level, 0);
+	if (level > int(_levels.size())) {
+		return;
+	}
+	while (int(_levels.size()) > level) {
+		auto last = base::take(_levels.back().frame);
+		_levels.pop_back();
+		if (last) {
+			last->hide();
+			crl::on_main(this, [owned = std::move(last)]() mutable {
+				owned = nullptr;
+			});
+		}
+	}
+	if (const auto parent = levelMenu(level - 1)) {
+		parent->setChildShownAction(nullptr);
+		parent->setMouseSelectionFrozen(false);
+		parent->clearSelection();
+	}
+	place();
+}
+
+bool Preview::closeSubmenus() {
+	if (_levels.empty()) {
+		return false;
+	}
+	closeFrom(0);
+	return true;
+}
+
+void Preview::refresh() {
+	const auto scrollTop = _scroll ? _scroll->scrollTop() : 0;
+	const auto scrollLeft = _scroll ? _scroll->scrollLeft() : 0;
+	_restoring = true;
+	auto chain = std::vector<Path>();
+	for (const auto &level : _levels) {
+		chain.push_back(level.path);
+	}
+	closeFrom(0);
+	_main->clearActions();
+	_mainPaths.clear();
+	_strip = (_state->kind == MenuKind::Message)
+		&& StripShown(_state->layout).value_or(false);
+	fill(_main, _state->layout, {}, _mainPaths, true);
+	for (auto i = 0; i != int(chain.size()); ++i) {
+		const auto was = _levels.size();
+		open(i - 1, chain[i]);
+		if (_levels.size() == was) {
+			break;
+		}
+	}
+	place();
+	_restoring = false;
+	if (_scroll) {
+		_scroll->scrollToY(scrollTop);
+		_scroll->scrollToX(scrollLeft);
+	}
+}
+
+void Preview::place() {
+	const auto skip = st::boxRowPadding.left() / 2;
+	const auto extend = _shadow.extend();
+	const auto left = outerLeft();
+	const auto right = std::max(extend.right(), skip);
+	const auto strip = stripRect();
+	const auto top = strip.isEmpty()
+		? extend.top()
+		: (strip.y()
+			+ strip.height()
+			+ std::max(skip, extend.bottom() + extend.top() / 2));
+	_mainFrame->sync();
+	_mainFrame->moveFrameTo(left, top);
+	const auto mainRect = _mainFrame->frame();
+	const auto viewport = (_scroll && _scroll->width() > 0)
+		? _scroll->width()
+		: _paneWidth;
+	const auto viewLeft = _scroll ? _scroll->scrollLeft() : 0;
+	const auto minX = viewLeft + left;
+	auto paneWidth = std::max(
+		viewport,
+		mainRect.x() + mainRect.width() + right);
+	auto bottom = mainRect.y() + mainRect.height();
+	auto parentRect = mainRect;
+	for (const auto &level : _levels) {
+		level.frame->sync();
+		level.frame->show();
+	}
+	for (auto i = 0; i != int(_levels.size()); ++i) {
+		const auto frame = _levels[i].frame.get();
+		const auto width = frame->frame().width();
+		const auto maxX = std::max(minX, viewLeft + viewport - right - width);
+		auto x = parentRect.x() + parentRect.width() + skip;
+		if (x > maxX && i > 0) {
+			const auto previous = _levels[i - 1].frame.get();
+			x = previous->frame().x();
+			previous->hide();
+		}
+		x = std::clamp(x, minX, maxX);
+		frame->moveFrameTo(x, _levels[i].top - _popup.scrollPadding.top());
+		frame->raise();
+		parentRect = frame->frame();
+	}
+	for (const auto &level : _levels) {
+		if (!level.frame->isHidden()) {
+			const auto rect = level.frame->frame();
+			bottom = std::max(bottom, rect.y() + rect.height());
+			paneWidth = std::max(paneWidth, rect.x() + rect.width() + right);
+		}
+	}
+	resize(paneWidth, bottom + std::max(extend.bottom(), skip));
+	update();
+}
+
+int Preview::resizeGetHeight(int newWidth) {
+	return height();
+}
+
+void Preview::mousePressEvent(QMouseEvent *e) {
+	closeSubmenus();
+}
+
+void Preview::paintEvent(QPaintEvent *e) {
+	if (!_strip) {
+		return;
+	}
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto skip = st::boxRowPadding.left() / 2;
+	const auto radius = _popup.radius;
+	const auto strip = stripRect();
+	_shadow.paint(p, strip, radius);
+	p.setPen(Qt::NoPen);
+	p.setBrush(_st.itemBg);
+	p.drawRoundedRect(strip, radius, radius);
+	const auto &icon = st::menuIconReactions;
+	icon.paint(
+		p,
+		strip.x() + skip,
+		strip.y() + (strip.height() - icon.height()) / 2,
+		width());
+	p.setFont(st::normalFont);
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		strip.marginsRemoved({ skip * 2 + icon.width(), 0, 0, 0 }),
+		Lower(u"Reactions"_q),
+		style::al_left);
+}
+
+[[nodiscard]] int PreselectContext(const MenuInfo &info, int context) {
+	return (context >= 0 && context < int(info.contexts.size()))
+		? context
+		: 0;
+}
