+void Fill(
+		not_null<Ui::PopupMenu*> menu,
+		const std::vector<Node> &nodes,
+		const style::Menu &topSt,
+		const std::vector<Element> &elements);
+
+void FillSubmenu(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<QAction*> action,
+		const Node &node,
+		const style::Menu &topSt,
+		const std::vector<Element> &elements) {
+	const auto submenu = menu->ensureSubmenu(action, menu->st());
+	Fill(submenu, node.children, topSt, elements);
+}
+
+void Fill(
+		not_null<Ui::PopupMenu*> menu,
+		const std::vector<Node> &nodes,
+		const style::Menu &topSt,
+		const std::vector<Element> &elements) {
+	const auto raw = menu->menu();
+	for (const auto &node : nodes) {
+		if (node.type == Node::Type::Separator) {
+			menu->addSeparator(node.separator);
+		} else if (node.type == Node::Type::Submenu) {
+			const auto action = MakeSubmenuAction(raw, node.title);
+			menu->addAction(base::make_unique_q<Ui::Menu::Action>(
+				raw,
+				raw->st(),
+				action,
+				node.icon,
+				node.icon));
+			FillSubmenu(menu, action, node, topSt, elements);
+		} else {
+			const auto &element = elements[node.element];
+			menu->addAction(MakeItem(raw, topSt, element));
+			if (element.submenu && element.fill) {
+				element.fill(menu->ensureSubmenu(element.action, menu->st()));
+			}
+		}
+	}
+}
+
+void Realize(
+		not_null<Ui::PopupMenu*> menu,
+		const std::vector<Node> &top,
+		std::vector<Element> &elements) {
+	const auto raw = menu->menu();
+	const auto &topSt = raw->st();
+	auto keep = base::flat_set<not_null<QAction*>>();
+	auto moved = base::flat_set<not_null<QAction*>>();
+	for (auto &element : elements) {
+		if (element.kind == ElementKind::Fixed && !element.hidden) {
+			keep.emplace(element.action);
+			continue;
+		}
+		QObject::disconnect(
+			element.action.get(),
+			&QAction::changed,
+			nullptr,
+			nullptr);
+		if (element.hidden) {
+			continue;
+		}
+		moved.emplace(element.action);
+		if (element.action->parent() != raw.get()) {
+			continue;
+		} else if (element.kind == ElementKind::Toggle) {
+			element.action->setParent(nullptr);
+		} else {
+			element.action->setParent(menu.get());
+		}
+	}
+	for (auto i = int(raw->actions().size()); i != 0;) {
+		const auto action = raw->actions()[--i];
+		if (moved.contains(action)) {
+			raw->removeAction(i);
+		} else if (!keep.contains(action)) {
+			menu->removeAction(i);
+		}
+	}
+	auto position = 0;
+	for (const auto &node : top) {
+		if (node.type == Node::Type::Separator) {
+			raw->insertAction(
+				position++,
+				MakeSeparator(raw, node.separator));
+		} else if (node.type == Node::Type::Submenu) {
+			const auto action = MakeSubmenuAction(raw, node.title);
+			raw->insertAction(
+				position++,
+				base::make_unique_q<Ui::Menu::Action>(
+					raw,
+					topSt,
+					action,
+					node.icon,
+					node.icon));
+			FillSubmenu(menu, action, node, topSt, elements);
+		} else {
+			const auto &element = elements[node.element];
+			if (element.kind == ElementKind::Fixed) {
+				++position;
+			} else {
+				raw->insertAction(position++, MakeItem(raw, topSt, element));
+			}
+		}
+	}
+	const auto &actions = raw->actions();
+	for (auto i = 0; i != int(actions.size()); ++i) {
+		if (const auto item = raw->itemForAction(actions[i])) {
+			item->setIndex(i);
+		}
+	}
+}
+
+[[nodiscard]] std::optional<bool> LayoutHides(
+		const MenuLayout &layout,
+		const QString &key) {
+	for (const auto &entry : layout) {
+		if (entry.type == MenuEntry::Type::Item && entry.key == key) {
+			return entry.hidden;
+		} else if (entry.type == MenuEntry::Type::Submenu) {
+			if (const auto hidden = LayoutHides(entry.entries, key)) {
+				return entry.hidden || *hidden;
+			}
+		}
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] Ui::PopupMenu *FindPopup(not_null<QAction*> action) {
+	for (auto object = action->parent(); object; object = object->parent()) {
+		if (const auto popup = dynamic_cast<Ui::PopupMenu*>(object)) {
+			return popup;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] int PeerMenuContext(const Dialogs::EntryState &request) {
+	if (request.key.topic()) {
+		return 4;
+	}
+	const auto peer = request.key.peer();
+	if (!peer) {
+		return -1;
+	} else if (const auto user = peer->asUser()) {
+		return user->isBot() ? 3 : 0;
+	}
+	return peer->isBroadcast() ? 2 : 1;
+}
+
+[[nodiscard]] int RefineContext(
+		const MenuApplyArgs &args,
+		const MenuInfo &info,
+		const std::vector<Element> &elements) {
+	const auto find = [&](const QString &key) -> const Element* {
+		const auto i = ranges::find_if(elements, [&](const Element &e) {
+			return (e.item >= 0) && (info.items[e.item].key == key);
+		});
+		return (i != end(elements)) ? &*i : nullptr;
+	};
+	switch (args.kind) {
+	case MenuKind::Message:
+		return find(u"clear_selection"_q) ? 5 : args.context;
+	case MenuKind::Send:
+		return find(u"draft_send"_q) ? 2 : args.context;
+	case MenuKind::Field: {
+		const auto all = find(u"select_all"_q);
+		return (all && all->action->isEnabled()) ? 0 : 1;
+	}
+	default: return args.context;
+	}
+}
+
+[[nodiscard]] std::vector<not_null<Ui::PopupMenu*>> OpenSubmenus(
+		not_null<Ui::PopupMenu*> menu) {
+	auto result = std::vector<not_null<Ui::PopupMenu*>>();
+	for (const auto child : menu->children()) {
+		const auto popup = dynamic_cast<Ui::PopupMenu*>(child);
+		if (popup && popup->isVisible()) {
+			result.push_back(popup);
+		}
+	}
+	return result;
+}
+
+void CloseSubmenus(not_null<Ui::PopupMenu*> menu) {
+	if (OpenSubmenus(menu).empty()) {
+		return;
+	}
+	const auto raw = menu->menu();
+	raw->setMouseSelectionFrozen(false);
+	raw->setChildShownAction(nullptr);
+	const auto &actions = raw->actions();
+	for (auto i = 0; i != int(actions.size()); ++i) {
+		const auto action = actions[i];
+		const auto item = raw->itemForAction(action);
+		if (item
+			&& item->isEnabled()
+			&& !action->isSeparator()
+			&& !action->menu()) {
+			raw->setSelected(i, true);
+			break;
+		}
+	}
+	raw->clearSelection();
+	for (const auto child : OpenSubmenus(menu)) {
+		child->hideMenu(true);
+	}
+}
+
+void CloseSubmenusOutsideItems(not_null<Ui::PopupMenu*> menu) {
+	const auto weak = QPointer<Ui::PopupMenu>(menu.get());
+	menu->menu()->setMouseMoveDelegate([=](QPoint global) {
+		const auto strong = weak.data();
+		if (!strong) {
+			return;
+		}
+		const auto inner = strong->inner();
+		const auto top = strong->mapToGlobal(inner.topLeft()).y();
+		const auto window = QRect(
+			strong->mapToGlobal(QPoint()),
+			strong->size());
+		if (window.contains(global)
+			&& (global.y() < top || global.y() >= top + inner.height())) {
+			CloseSubmenus(strong);
+		}
+	});
+}
+
+void OpenEditorOnShow(
+		not_null<Ui::PopupMenu*> menu,
+		MenuKind kind,
+		int context) {
+	const auto weak = QPointer<Ui::PopupMenu>(menu.get());
+	const auto anchor = QPointer<QWidget>(menu->parentWidget());
+	const auto done = std::make_shared<bool>(false);
+	base::install_event_filter(menu, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::Show || *done) {
+			return base::EventFilterResult::Continue;
+		}
+		*done = true;
+		if (const auto strong = weak.data()) {
+			strong->setAttribute(Qt::WA_DontShowOnScreen);
+		}
+		crl::on_main([=] {
+			if (const auto strong = weak.data()) {
+				strong->hideMenu(true);
+			}
+			if (const auto strong = anchor.data()) {
+				ShowMenuEditor(strong, kind, context);
+			}
+		});
+		return base::EventFilterResult::Continue;
+	});
+}
+
+[[nodiscard]] std::optional<MenuKind> PeerMenuKind(
+		const Dialogs::EntryState &request) {
+	using Section = Dialogs::EntryState::Section;
+	if (request.key.folder() || request.key.sublist()) {
+		return std::nullopt;
+	}
+	switch (request.section) {
+	case Section::History:
+	case Section::Replies: return MenuKind::Chat;
+	case Section::Profile: return MenuKind::Profile;
+	case Section::ContextMenu: return MenuKind::ChatRow;
+	default: return std::nullopt;
+	}
+}
+
+} // namespace
+
+struct MenuScope::State {
+	std::optional<MenuKind> kind;
+	int context = -1;
+	QPointer<QAction> last;
+};
+
+const style::MenuSeparator &MenuSeparatorFor(
+		const style::Menu &st,
+		MenuSeparatorStyle style,
+		bool expandedNext,
+		bool top) {
+	const auto &thick = st::expandedMenuSeparator;
+	switch (style) {
+	case MenuSeparatorStyle::Thick: return thick;
+	case MenuSeparatorStyle::Thin:
+		return (st.separator.width >= thick.width)
+			? st::defaultMenuSeparator
+			: st.separator;
+	case MenuSeparatorStyle::Auto: break;
+	}
+	return (top && expandedNext) ? thick : st.separator;
+}
+
+void FitMenuToggle(not_null<Ui::Menu::Toggle*> item) {
+	QObject::connect(item->action(), &QAction::changed, item, [=] {
+		FitToggleNow(item);
+	});
+	FitToggleNow(item);
+}
+
+QAction *TagMenuAction(
+		QAction *action,
+		const QString &key,
+		const style::icon *icon) {
+	if (action) {
+		const auto tag = EnsureTag(action);
+		tag->key = key;
+		if (icon) {
+			tag->icon = icon;
+			tag->hasIcon = true;
+		}
+	}
+	return action;
+}
+
+QAction *TagMenuSubmenu(
+		QAction *action,
+		const QString &key,
+		Fn<void(not_null<Ui::PopupMenu*>)> fill) {
+	if (action) {
+		const auto tag = EnsureTag(action);
+		tag->key = key;
+		tag->fill = std::move(fill);
+	}
+	return action;
+}
+
+void TagLastMenuAction(not_null<Ui::PopupMenu*> menu, const QString &key) {
+	const auto &actions = menu->actions();
+	if (!actions.empty()) {
+		TagMenuAction(actions.back(), key);
+	}
+}
+
+void ApplyMenuLayout(not_null<Ui::PopupMenu*> menu, MenuApplyArgs args) {
+	const auto raw = menu->menu();
+	if (raw->empty()) {
+		return;
+	} else if (args.kind == MenuKind::Message) {
+		CloseSubmenusOutsideItems(menu);
+	}
+	const auto &info = LookupMenu(args.kind);
+	auto elements = CollectElements(raw, info, args.icons);
+	if (ranges::none_of(elements, [](const Element &e) {
+		return (e.item >= 0);
+	})) {
+		return;
+	} else if (base::IsAltPressed()) {
+		OpenEditorOnShow(
+			menu,
+			args.kind,
+			RefineContext(args, info, elements));
+	}
+	auto context = Context{
+		.info = info,
+		.st = raw->st(),
+		.elements = elements,
+	};
+	for (auto i = 0; i != int(elements.size()); ++i) {
+		if (elements[i].item >= 0) {
+			context.byKey[info.items[elements[i].item].key].push_back(i);
+		}
+	}
+	auto top = std::vector<Node>();
+	Emit(CurrentMenuLayout(args.kind), top, context);
+	Lift(top, elements);
+	PlaceUnknown(top, elements);
+	Collapse(top, context, true);
+	KeepFixedOrder(top, elements);
+	Realize(menu, top, elements);
+}
+
+MenuScope::MenuScope(
+	const Dialogs::EntryState &request,
+	const Ui::Menu::MenuCallback &callback)
+: _state(std::make_shared<State>())
+, _callback([state = _state, callback](
+		Ui::Menu::MenuCallback::Args &&args) -> QAction* {
+	const auto plain = !args.isSeparator
+		&& !args.separatorSt
+		&& !args.make
+		&& !args.addTopShift;
+	const auto icon = args.icon;
+	const auto result = callback(std::move(args));
+	if (result) {
+		state->last = result;
+		if (plain) {
+			const auto tag = EnsureTag(result);
+			if (!tag->hasIcon) {
+				tag->icon = icon;
+				tag->hasIcon = true;
+			}
+		}
+	}
+	return result;
+}) {
+	_state->kind = PeerMenuKind(request);
+	_state->context = PeerMenuContext(request);
+}
+
+const Ui::Menu::MenuCallback &MenuScope::callback() const {
+	return _callback;
+}
+
+void MenuScope::apply() const {
+	const auto last = _state->last.data();
+	if (!_state->kind || !last) {
+		return;
+	}
+	const auto popup = FindPopup(last);
+	if (!popup
+		|| !ranges::contains(popup->actions(), not_null<QAction*>(last))) {
+		return;
+	}
+	ApplyMenuLayout(popup, {
+		.kind = *_state->kind,
+		.context = _state->context,
+	});
+}
+
+void ApplyFolderMenuLayout(not_null<Ui::PopupMenu*> menu, int32 filterId) {
+	ApplyMenuLayout(menu, {
+		.kind = MenuKind::FolderTab,
+		.context = filterId ? 0 : 1,
+	});
+}
+
+void ApplySendMenuLayout(
+		not_null<Ui::PopupMenu*> menu,
+		const SendMenu::Details &details,
+		const style::ComposeIcons &icons) {
+	using namespace SendMenu;
+	const auto media = (details.spoiler != SpoilerState::None)
+		|| (details.caption != CaptionState::None)
+		|| (details.photoQuality != PhotoQualityState::None)
+		|| (details.cover != CoverState::None)
+		|| details.price.has_value();
+	ApplyMenuLayout(menu, {
+		.kind = MenuKind::Send,
+		.context = media ? 1 : 0,
+		.icons = &icons,
+	});
+}
+
+void SetupFieldMenuLayout(not_null<Ui::InputField*> field) {
+	field->addContextMenuHook([](Ui::InputField::ContextMenuRequest request) {
+		request.customizePopupMenu([](not_null<Ui::PopupMenu*> menu) {
+			ApplyMenuLayout(menu, { .kind = MenuKind::Field });
+		});
+	});
+}
+
+bool MenuLayoutHides(MenuKind kind, const QString &key) {
+	return LayoutHides(CurrentMenuLayout(kind), key).value_or(false);
+}
+
+} // namespace Tele
