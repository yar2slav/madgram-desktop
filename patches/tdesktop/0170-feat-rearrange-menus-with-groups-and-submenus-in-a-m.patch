+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+
+private:
+	[[nodiscard]] int chipAt(QPoint point) const;
+
+	std::vector<QString> _labels;
+	std::vector<QRect> _rects;
+	rpl::variable<int> _selected;
+
+};
+
+Chips::Chips(QWidget *parent, std::vector<QString> labels, int selected)
+: RpWidget(parent)
+, _labels(std::move(labels))
+, _selected(selected) {
+	setMouseTracking(true);
+}
+
+rpl::producer<int> Chips::selectedValue() const {
+	return _selected.value();
+}
+
+int Chips::resizeGetHeight(int newWidth) {
+	const auto &font = st::normalFont;
+	const auto height = font->height * 2;
+	const auto padding = font->height;
+	const auto skip = font->height / 2;
+	_rects.clear();
+	auto x = 0;
+	auto y = 0;
+	for (const auto &label : _labels) {
+		const auto width = font->width(label) + padding * 2;
+		if (x > 0 && x + width > newWidth) {
+			x = 0;
+			y += height + skip;
+		}
+		_rects.emplace_back(x, y, width, height);
+		x += width + skip;
+	}
+	return _rects.empty() ? 0 : (y + height);
+}
+
+void Chips::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setFont(st::normalFont);
+	const auto selected = _selected.current();
+	for (auto i = 0; i != int(_rects.size()); ++i) {
+		const auto &rect = _rects[i];
+		const auto radius = rect.height() / 2.;
+		p.setPen(Qt::NoPen);
+		p.setBrush((i == selected) ? st::activeButtonBg : st::windowBgOver);
+		p.drawRoundedRect(rect, radius, radius);
+		p.setPen((i == selected) ? st::activeButtonFg : st::windowFg);
+		p.drawText(rect, _labels[i], style::al_center);
+	}
+}
+
+int Chips::chipAt(QPoint point) const {
+	for (auto i = 0; i != int(_rects.size()); ++i) {
+		if (_rects[i].contains(point)) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+void Chips::mousePressEvent(QMouseEvent *e) {
+	if (const auto index = chipAt(e->pos()); index >= 0) {
+		_selected = index;
+		update();
+	}
+}
+
+void Chips::mouseMoveEvent(QMouseEvent *e) {
+	setCursor((chipAt(e->pos()) >= 0)
+		? style::cur_pointer
+		: style::cur_default);
+}
