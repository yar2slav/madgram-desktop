-void ApplyMessageMenuLayout(not_null<Ui::PopupMenu*> menu) {
-	const auto value = MessageMenuLayout();
-	if (value.isEmpty() || menu->empty()) {
-		return;
-	}
-	const auto layout = ResolveLayout(value);
-	auto rank = std::vector<int>(layout.size());
-	auto hidden = std::vector<char>(layout.size());
-	for (auto i = 0; i != int(layout.size()); ++i) {
-		rank[layout[i].index] = i;
-		hidden[layout[i].index] = layout[i].hidden ? 1 : 0;
-	}
-	const auto matchers = CollectMatchers();
-	const auto raw = menu->menu();
-	const auto &actions = raw->actions();
-
-	auto removed = false;
-	for (auto i = int(actions.size()); i != 0;) {
-		const auto found = Identify(raw, actions[--i], matchers);
-		if (found && hidden[found->index]) {
-			menu->removeAction(i);
-			removed = true;
-		}
-	}
-
-	auto positions = std::vector<int>();
-	auto current = std::vector<Found>();
-	for (auto i = 0; i != int(actions.size()); ++i) {
-		if (const auto found = Identify(raw, actions[i], matchers)) {
-			positions.push_back(i);
-			current.push_back(*found);
-		}
-	}
-	auto target = current;
-	ranges::stable_sort(target, ranges::less(), [&](const Found &found) {
-		return rank[found.index];
-	});
-	auto misplaced = std::vector<std::pair<int, QObject*>>();
-	for (auto i = 0; i != int(current.size()); ++i) {
-		const auto action = current[i].action;
-		if (action != target[i].action) {
-			misplaced.emplace_back(i, action->parent());
-			action->setParent(menu.get());
-		}
-	}
-	for (const auto &[i, parent] : misplaced) {
-		menu->removeAction(positions[i]);
-		menu->insertAction(
-			positions[i],
-			base::make_unique_q<Ui::Menu::Action>(
-				raw,
-				*target[i].st,
-				target[i].action,
-				target[i].icon,
-				target[i].icon));
-	}
-	for (const auto &[i, parent] : misplaced) {
-		current[i].action->setParent(parent);
-	}
-	const auto moved = !misplaced.empty();
-
-	if (removed) {
-		NormalizeSeparators(menu);
-	}
-	if (removed || moved) {
-		for (auto i = 0; i != int(actions.size()); ++i) {
-			if (const auto item = raw->itemForAction(actions[i])) {
-				item->setIndex(i);
-			}
-		}
-	}
-}
