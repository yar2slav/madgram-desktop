-		Lower(u"Items not listed here keep their place."_q),
-		st::boxDividerLabel));
-	const auto inner = box->addRow(
-		object_ptr<Ui::VerticalLayout>(box),
-		style::margins());
-
-	const auto rebuildReorder = [=] {
-		state->reorder = nullptr;
-		auto handles = std::vector<not_null<Ui::RpWidget*>>();
-		for (auto i = 0; i != inner->count(); ++i) {
-			const auto widget = inner->widgetAt(i);
-			const auto row = ranges::find(
-				state->rows,
-				widget.get(),
-				[](const Row &row) {
-					return static_cast<Ui::RpWidget*>(row.button.get());
-				});
-			handles.push_back(row->handle);
-		}
-		state->reorder = state->scroll
-			? std::make_unique<Ui::VerticalLayoutReorder>(
-				inner,
-				state->scroll)
-			: std::make_unique<Ui::VerticalLayoutReorder>(inner);
-		state->reorder->setMouseEventProxy([=](int i) {
-			return handles[i];
-		});
-		state->reorder->start();
-	};
-	const auto fill = [=](const std::vector<Entry> &entries) {
-		state->reorder = nullptr;
-		state->rows.clear();
-		inner->clear();
-		for (const auto &entry : entries) {
-			const auto &known = registry[entry.index];
-			const auto button = inner->add(Settings::CreateButtonWithIcon(
-				inner,
-				rpl::single(Label(known)),
-				state->st,
-				{ known.phrases.front().icon }));
-			button->toggleOn(rpl::single(!entry.hidden));
-			const auto handle = Ui::CreateChild<Handle>(button);
-			button->sizeValue(
-			) | rpl::on_next([=](QSize size) {
-				handle->setGeometry(
-					size.width() - skip / 2 - handleWidth,
-					0,
-					handleWidth,
-					size.height());
-			}, handle->lifetime());
-			handle->show();
-			state->rows.push_back({
-				.button = button,
-				.handle = handle,
-				.index = entry.index,
-			});
-		}
-		rebuildReorder();
-	};
-	fill(ResolveLayout(MessageMenuLayout()));
-	crl::on_main(box.get(), [=] {
-		state->scroll = FindScroll(inner);
-		rebuildReorder();
-	});
-
-	box->addButton(tr::lng_settings_save(), [=] {
-		auto entries = std::vector<Entry>();
-		for (auto i = 0; i != inner->count(); ++i) {
-			const auto widget = inner->widgetAt(i);
-			for (const auto &row : state->rows) {
-				if (row.button.get() == widget.get()) {
-					entries.push_back({
-						.index = row.index,
-						.hidden = !row.button->toggled(),
-					});
-				}
-			}
-		}
-		SetMessageMenuLayout(SerializeLayout(entries));
-		box->closeBox();
-	});
-	box->addButton(tr::lng_cancel(), [=] {
-		box->closeBox();
-	});
-	box->addLeftButton(rpl::single(Lower(u"Reset"_q)), [=] {
-		fill(ResolveLayout(QString()));
-	});
