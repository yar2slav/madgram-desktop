+#pragma once
+
+#include "base/flags.h"
+#include "tele/tele_menu_layout.h"
+
+namespace style {
+struct ComposeIcons;
+} // namespace style
+
+namespace Tele {
+
+struct MenuPhrase {
+	QString (*text)(int count) = nullptr;
+	const style::icon *icon = nullptr;
+	const style::icon *(*compose)(const style::ComposeIcons &icons) = nullptr;
+	const char *name = nullptr;
+	bool counted = false;
+	bool prefix = false;
+};
+
+enum class MenuItemFlag : uchar {
+	Fixed = (1 << 0),
+	Expanded = (1 << 1),
+	Strip = (1 << 2),
+	Submenu = (1 << 3),
+	TopLevel = (1 << 4),
+	SupportOnly = (1 << 5),
+};
+inline constexpr bool is_flag_type(MenuItemFlag) { return true; }
+using MenuItemFlags = base::flags<MenuItemFlag>;
+
+struct MenuItemInfo {
+	QString key;
+	QString (*label)() = nullptr;
+	const style::icon *icon = nullptr;
+	std::vector<MenuPhrase> phrases;
+	uint32 contexts = 0;
+	const char *gate = nullptr;
+	MenuItemFlags flags;
+};
+
+struct MenuInfo {
+	MenuKind kind = MenuKind::Message;
+	QString id;
+	QString (*name)() = nullptr;
+	std::vector<QString (*)()> contexts;
+	std::vector<MenuItemInfo> items;
+	QString defaults;
+	QString upstream;
+	QString minimal;
+	QString power;
+};
+
+[[nodiscard]] const std::vector<MenuKind> &MenuKinds();
+[[nodiscard]] const MenuInfo &LookupMenu(MenuKind kind);
+[[nodiscard]] const MenuInfo *LookupMenu(const QString &id);
+[[nodiscard]] const MenuItemInfo *LookupMenuItem(
+	MenuKind kind,
+	const QString &key);
+[[nodiscard]] QString MenuItemLabel(const MenuItemInfo &item);
+[[nodiscard]] const style::icon *MenuItemIcon(const MenuItemInfo &item);
+[[nodiscard]] const style::icon *MenuSubmenuIcon(const QString &name);
+
+} // namespace Tele
