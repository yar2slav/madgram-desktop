+		{ .key = u"translate"_q, .phrases = {
+			{ .text = [](int) { return Lower(u"Translate\u2026"_q); } },
+		}, .contexts = kFieldText, .gate = kOptionTranslateOut },
+		{ .key = u"link_preview"_q, .phrases = {
+			{ .text = [](int) { return Lower(u"Add a link preview…"_q); } },
+		}, .contexts = kFieldText, .gate = kOptionLinkPreviewMenu },
+	};
+	result.defaults = u""
+		"undo,redo,|,"
+		"cut,copy,paste,delete,|,"
+		"select_all,|,"
+		"formatting,|,"
+		"translate,link_preview"_q;
+	result.upstream = u""
+		"undo,redo,|,"
+		"cut,copy,paste,delete,|,"
+		"select_all,|,"
+		"formatting,|,"
+		"translate,|,"
+		"link_preview"_q;
+	result.minimal = u""
+		"undo,redo,|,"
+		"cut,copy,paste,delete,|,"
+		"select_all,|,"
+		"formatting"_q;
+	result.power = result.defaults;
+	return result;
+}
+
+[[nodiscard]] const std::vector<MenuInfo> &Menus() {
+	static const auto result = std::vector<MenuInfo>{
+		MessageMenu(),
+		ChatMenu(),
+		ChatRowMenu(),
+		FolderMenu(),
+		ProfileMenu(),
+		SendMenu(),
+		FieldMenu(),
+	};
+	return result;
+}
+
+} // namespace
+
+const std::vector<MenuKind> &MenuKinds() {
+	static const auto result = std::vector<MenuKind>{
+		MenuKind::Message,
+		MenuKind::Chat,
+		MenuKind::ChatRow,
+		MenuKind::FolderTab,
+		MenuKind::Profile,
+		MenuKind::Send,
+		MenuKind::Field,
+	};
+	return result;
+}
+
+const MenuInfo &LookupMenu(MenuKind kind) {
+	const auto &menus = Menus();
+	const auto i = ranges::find(menus, kind, &MenuInfo::kind);
+	Assert(i != end(menus));
+	return *i;
+}
+
+const MenuInfo *LookupMenu(const QString &id) {
+	const auto &menus = Menus();
+	const auto i = ranges::find(menus, id, &MenuInfo::id);
+	return (i != end(menus)) ? &*i : nullptr;
+}
+
+const MenuItemInfo *LookupMenuItem(MenuKind kind, const QString &key) {
+	const auto &items = LookupMenu(kind).items;
+	const auto i = ranges::find(items, key, &MenuItemInfo::key);
+	return (i != end(items)) ? &*i : nullptr;
+}
+
+QString MenuItemLabel(const MenuItemInfo &item) {
+	if (item.label) {
+		return item.label();
+	} else if (!item.phrases.empty() && item.phrases.front().text) {
+		return item.phrases.front().text(1);
+	}
+	return item.key;
+}
+
+const style::icon *MenuItemIcon(const MenuItemInfo &item) {
+	if (item.icon) {
+		return item.icon;
+	}
+	return item.phrases.empty() ? nullptr : item.phrases.front().icon;
+}
+
+const style::icon *MenuSubmenuIcon(const QString &name) {
+	if (name == u"copy"_q) {
+		return &st::menuIconCopy;
+	} else if (name == u"tele"_q) {
+		return &st::menuIconExperimental;
+	} else if (name == u"tools"_q) {
+		return &st::menuIconSettings;
+	} else if (name == u"forme"_q) {
+		return &st::menuIconPersonal;
+	} else if (name == u"drafts"_q) {
+		return &st::menuIconArchiveOpen;
+	} else if (name == u"bookmark"_q) {
+		return &st::menuIconSavedMessages;
+	}
+	return nullptr;
+}
+
+} // namespace Tele
