+
+void MenuEditorBox(
+		not_null<Ui::GenericBox*> box,
+		MenuKind kind,
+		int context) {
+	const auto &info = LookupMenu(kind);
+	const auto state = box->lifetime().make_state<State>(State{
+		.kind = kind,
+		.layout = WithListed(kind, CurrentMenuLayout(kind)),
+		.context = PreselectContext(info, context),
+	});
+	const auto skip = st::boxRowPadding.left();
+	const auto widths = Preview::NaturalWidths(state);
+	const auto natural = st::boxWideWidth + skip + widths.full;
+	const auto window = box->window();
+	const auto available = (window && window != box.get())
+		? std::max(window->width() - skip * 2, st::boxWidth)
+		: natural;
+	const auto width = std::min(natural, available);
+	const auto &font = st::normalFont;
+	const auto pill = font->height * 2;
+	const auto margin = st::boxRowPadding.left() / 2;
+	const auto presetsText = Lower(u"Presets"_q)
+		+ QString::fromUtf8(" \xe2\x96\xbe");
+	const auto listMin = margin * 3
+		+ (font->width(u"+ "_q + Lower(u"Separator"_q)) + pill)
+		+ (font->width(presetsText) + pill)
+		+ margin / 2
+		+ pill;
+	const auto listWidth = std::clamp(
+		width - skip - widths.single,
+		std::min(listMin, width / 2),
+		int(st::boxWideWidth));
+	const auto height = st::boxMaxListHeight;
+	box->setWidth(width);
+	box->setTitle(rpl::single(info.name()));
+
+	const auto content = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		style::margins());
+	content->resize(width, height);
+
+	const auto listScroll = Ui::CreateChild<Ui::ScrollArea>(
+		content,
+		st::boxScroll);
+	const auto list = listScroll->setOwnedWidget(
+		object_ptr<LayoutList>(listScroll, state));
+	list->setScroll(listScroll);
+
+	const auto chip = Ui::CreateChild<SeparatorChip>(content, list);
+	const auto toolbar = chip->height();
+	const auto presets = Ui::CreateChild<Pill>(
+		content,
+		Lower(u"Presets"_q) + QString::fromUtf8(" \xe2\x96\xbe"),
+		nullptr,
+		toolbar);
+	const auto more = Ui::CreateChild<Pill>(
+		content,
+		QString(),
+		&st::menuToggleIcon,
+		toolbar);
+
+	auto labels = std::vector<QString>();
+	for (const auto &label : info.contexts) {
+		labels.push_back(label());
+	}
+	const auto chips = Ui::CreateChild<Chips>(
+		content,
+		std::move(labels),
+		state->context);
+	const auto previewScroll = Ui::CreateChild<Ui::ScrollArea>(
+		content,
+		st::boxScroll);
+	const auto preview = previewScroll->setOwnedWidget(
+		object_ptr<Preview>(previewScroll, state));
+	preview->setScroll(previewScroll);
+
+	const auto left = st::boxRowPadding.left() / 2;
+	const auto gap = left / 2;
+	chip->moveToLeft(left, 0);
+	more->moveToLeft(listWidth - left - more->width(), 0);
+	presets->moveToLeft(more->x() - gap - presets->width(), 0);
+	const auto listTop = toolbar + st::boxLittleSkip;
+	listScroll->setGeometry(0, listTop, listWidth, height - listTop);
+	list->resizeToWidth(listWidth);
+
+	const auto previewLeft = listWidth + skip;
+	const auto previewWidth = width - previewLeft;
+	chips->resizeToWidth(previewWidth);
+	chips->moveToLeft(previewLeft, 0);
+	chips->heightValue() | rpl::on_next([=](int chipsHeight) {
+		const auto top = chipsHeight + st::boxLittleSkip;
+		previewScroll->setGeometry(
+			previewLeft,
+			top,
+			previewWidth,
+			height - top);
+		preview->setPaneWidth(previewWidth);
+		preview->refresh();
+	}, content->lifetime());
+
+	chips->selectedValue() | rpl::on_next([=](int selected) {
+		state->context = selected;
+		preview->refresh();
+	}, content->lifetime());
+
+	state->changes.events() | rpl::on_next([=] {
+		preview->refresh();
+	}, content->lifetime());
+
+	const auto apply = [=](MenuLayout layout) {
+		state->layout = WithListed(kind, std::move(layout));
+		list->refresh();
+		preview->refresh();
+	};
+	const auto presetsMenu = content->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	const auto popupBelow = [=](not_null<QWidget*> anchor) {
+		const auto menu = presetsMenu->get();
+		const auto extend = Ui::BoxShadow::ExtendFor(menu->st().shadow);
+		menu->popup(anchor->mapToGlobal(QPoint(
+			-extend.left(),
+			anchor->height() - extend.top())));
+	};
+	presets->setClickedCallback([=] {
+		*presetsMenu = base::make_unique_q<Ui::PopupMenu>(
+			presets,
+			st::defaultPopupMenu);
+		const auto add = [&](const QString &text, MenuPreset preset) {
+			(*presetsMenu)->addAction(text, [=] {
+				apply(MenuPresetLayout(kind, preset));
+			});
+		};
+		add(Lower(u"Default"_q), MenuPreset::Default);
+		add(Lower(u"Upstream order"_q), MenuPreset::Upstream);
+		add(Lower(u"Minimal"_q), MenuPreset::Minimal);
+		add(Lower(u"Power user"_q), MenuPreset::Power);
+		popupBelow(presets);
+	});
+	const auto copy = [=] {
+		QGuiApplication::clipboard()->setText(
+			MenuLayoutClipboardText(kind, state->layout));
+		box->showToast(Lower(u"Layout copied to clipboard."_q));
+	};
+	const auto paste = [=] {
+		const auto text = QGuiApplication::clipboard()->text();
+		if (auto layout = ParseMenuLayoutClipboard(kind, text)) {
+			apply(std::move(*layout));
+		} else {
+			box->showToast(
+				Lower(u"The clipboard has no layout for this menu."_q));
+		}
+	};
+	more->setClickedCallback([=] {
+		*presetsMenu = base::make_unique_q<Ui::PopupMenu>(
+			more,
+			st::popupMenuWithIcons);
+		(*presetsMenu)->addAction(
+			Lower(u"Copy layout"_q),
+			copy,
+			&st::menuIconCopy);
+		(*presetsMenu)->addAction(
+			Lower(u"Paste layout"_q),
+			paste,
+			&st::menuIconImportTheme);
+		popupBelow(more);
+	});
+
+	Shortcuts::Requests(
+	) | rpl::filter([=] {
+		return box->isVisible() && box->window()->isActiveWindow();
+	}) | rpl::on_next([=](not_null<Shortcuts::Request*> request) {
+		request->check(Shortcuts::Command::Search, 1)
+			&& request->handle([] { return true; });
+	}, box->lifetime());
+
+	box->setFocusCallback([=] {
+		list->setFocus();
+	});
+	const auto swallowed = [](not_null<QKeyEvent*> key) {
+		if (key->matches(QKeySequence::Find)
+			|| key->key() == Qt::Key_Search) {
+			return true;
+		}
+		const auto modifiers = key->modifiers()
+			& ~(Qt::ShiftModifier | Qt::KeypadModifier);
+		const auto text = key->text();
+		return !modifiers && !text.isEmpty() && text[0].isPrint();
+	};
+	base::install_event_filter(box, [=](not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type != QEvent::ShortcutOverride && type != QEvent::KeyPress) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto key = static_cast<QKeyEvent*>(e.get());
+		if (key->key() == Qt::Key_Escape) {
+			if (type == QEvent::KeyPress && preview->closeSubmenus()) {
+				return base::EventFilterResult::Cancel;
+			}
+			return base::EventFilterResult::Continue;
+		} else if (!swallowed(key)) {
+			return base::EventFilterResult::Continue;
+		}
+		key->accept();
+		return base::EventFilterResult::Cancel;
+	});
+
+	box->addButton(tr::lng_settings_save(), [=] {
+		SaveMenuLayout(kind, state->layout);
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Reset"_q)), [=] {
+		apply(MenuPresetLayout(kind, MenuPreset::Default));
+	});
+}
+
+void ShowMenuEditor(not_null<QWidget*> anchor, MenuKind kind, int context) {
+	const auto window = Core::App().findWindow(anchor);
+	const auto target = window ? window : Core::App().activeWindow();
+	if (target) {
+		target->show(Box(MenuEditorBox, kind, context));
+	}
+}
