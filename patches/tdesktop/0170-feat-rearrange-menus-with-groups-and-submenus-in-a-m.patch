+struct Matcher {
+	QString text;
+	QString suffix;
+	const char *name = nullptr;
+	const style::icon *icon = nullptr;
+	int item = 0;
+	bool counted = false;
+	bool prefix = false;
+};
+
+enum class ElementKind : uchar {
+	Plain,
+	Toggle,
+	Fixed,
+};
+
+struct Element {
+	not_null<QAction*> action;
+	int index = 0;
+	int item = -1;
+	ElementKind kind = ElementKind::Fixed;
+	const style::icon *icon = nullptr;
+	const style::Menu *st = nullptr;
+	Fn<void(not_null<Ui::PopupMenu*>)> fill;
+	QString text;
+	const style::MenuSeparator *separatorBefore = nullptr;
+	const style::MenuSeparator *separatorAfter = nullptr;
+	bool hasSeparatorBefore = false;
+	bool hasSeparatorAfter = false;
+	bool checkable = false;
+	bool checked = false;
+	bool submenu = false;
+	bool placed = false;
+	bool hidden = false;
+};
+
+struct Node {
+	enum class Type : uchar {
+		Element,
+		Separator,
+		Submenu,
+	};
+	Type type = Type::Element;
+	int element = -1;
+	const style::MenuSeparator *separator = nullptr;
+	MenuSeparatorStyle style = MenuSeparatorStyle::Auto;
+	bool styled = false;
+	QString title;
+	const style::icon *icon = nullptr;
+	std::vector<Node> children;
+};
+
+struct Context {
+	const MenuInfo &info;
+	const style::Menu &st;
+	std::vector<Element> &elements;
+	base::flat_map<QString, std::vector<int>> byKey;
+};
+
+[[nodiscard]] std::vector<Matcher> CollectMatchers(
+		const MenuInfo &info,
+		const style::ComposeIcons *icons) {
+	auto result = std::vector<Matcher>();
+	for (auto item = 0; item != int(info.items.size()); ++item) {
+		for (const auto &phrase : info.items[item].phrases) {
+			const auto icon = (phrase.compose && icons)
+				? phrase.compose(*icons)
+				: phrase.icon;
+			if (phrase.name) {
+				result.push_back({
+					.name = phrase.name,
+					.icon = icon,
+					.item = item,
+				});
+			} else if (!phrase.text) {
+				continue;
+			} else if (phrase.counted) {
+				for (const auto count : { 1, 2, 5 }) {
+					const auto sample = phrase.text(count);
+					const auto number = QString::number(count);
+					const auto position = sample.indexOf(number);
+					if (position < 0) {
+						continue;
+					}
+					result.push_back({
+						.text = sample.left(position),
+						.suffix = sample.mid(position + number.size()),
+						.icon = icon,
+						.item = item,
+						.counted = true,
+					});
+				}
+			} else {
+				result.push_back({
+					.text = phrase.text(0),
+					.icon = icon,
+					.item = item,
+					.prefix = phrase.prefix,
+				});
+			}
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool Matches(
+		const Matcher &matcher,
+		not_null<QAction*> action) {
+	if (matcher.name) {
+		return (action->objectName() == QLatin1String(matcher.name));
+	}
+	const auto text = action->text();
+	if (matcher.counted) {
+		const auto from = int(matcher.text.size());
+		const auto till = int(text.size() - matcher.suffix.size());
+		return (till > from)
+			&& text.startsWith(matcher.text)
+			&& text.endsWith(matcher.suffix)
+			&& text[from].isDigit();
+	} else if (matcher.prefix) {
+		return text.startsWith(matcher.text);
+	}
+	return (text == matcher.text)
+		|| (text.size() > matcher.text.size()
+			&& text.startsWith(matcher.text)
+			&& text[matcher.text.size()] == QChar('\t'));
+}
+
+[[nodiscard]] const style::MenuSeparator *SeparatorStyle(
+		not_null<Ui::Menu::ItemBase*> widget,
+		const style::Menu &st) {
+	const auto height = [](const style::MenuSeparator &separator) {
+		return separator.padding.top()
+			+ separator.width
+			+ separator.padding.bottom();
+	};
+	return (widget->height() == height(st::expandedMenuSeparator))
+		? &st::expandedMenuSeparator
+		: &st.separator;
+}
+
+[[nodiscard]] std::vector<Element> CollectElements(
+		not_null<Ui::Menu::Menu*> raw,
+		const MenuInfo &info,
+		const style::ComposeIcons *icons) {
+	const auto matchers = CollectMatchers(info, icons);
+	const auto &actions = raw->actions();
+	auto result = std::vector<Element>();
+	const style::MenuSeparator *separator = nullptr;
+	auto hasSeparator = false;
+	for (auto i = 0; i != int(actions.size()); ++i) {
+		const auto action = actions[i];
+		const auto widget = raw->itemForAction(action);
+		if (!widget) {
+			continue;
+		} else if (action->isSeparator()) {
+			separator = SeparatorStyle(widget, raw->st());
+			hasSeparator = true;
+			if (!result.empty() && !result.back().hasSeparatorAfter) {
+				result.back().hasSeparatorAfter = true;
+				result.back().separatorAfter = separator;
+			}
+			continue;
+		}
+		auto element = Element{ .action = action, .index = i };
+		element.hasSeparatorBefore = base::take(hasSeparator);
+		element.separatorBefore = base::take(separator);
+		const auto tag = FindTag(action);
+		if (tag && !tag->key.isEmpty()) {
+			const auto &items = info.items;
+			const auto j = ranges::find(items, tag->key, &MenuItemInfo::key);
+			if (j != end(items)) {
+				element.item = int(j - begin(info.items));
+				element.icon = MenuItemIcon(*j);
+			}
+		}
+		if (element.item < 0) {
+			for (const auto &matcher : matchers) {
+				if (Matches(matcher, action)) {
+					element.item = matcher.item;
+					element.icon = matcher.icon;
+					break;
+				}
+			}
+		}
+		if (tag && tag->hasIcon) {
+			element.icon = tag->icon;
+		}
+		if (tag) {
+			element.fill = tag->fill;
+		}
+		const auto known = (element.item >= 0) || (tag && tag->hasIcon);
+		const auto fixed = (element.item >= 0)
+			&& (info.items[element.item].flags & MenuItemFlag::Fixed);
+		const auto &type = typeid(*widget);
+		if (known && !fixed && type == typeid(Ui::Menu::Action)) {
+			element.kind = ElementKind::Plain;
+		} else if (known && !fixed && type == typeid(Ui::Menu::Toggle)) {
+			element.kind = ElementKind::Toggle;
+			element.text = action->text();
+			element.checkable = action->isCheckable();
+			element.checked = action->isChecked();
+		}
+		if (element.kind != ElementKind::Fixed) {
+			element.st = &static_cast<Ui::Menu::Action*>(widget)->st();
+		}
+		element.submenu = (action->menu() != nullptr);
+		result.push_back(std::move(element));
+	}
+	return result;
+}
+
+void HideAll(const MenuLayout &layout, Context &context) {
+	for (const auto &entry : layout) {
+		if (entry.type == MenuEntry::Type::Item) {
+			if (const auto i = context.byKey.find(entry.key)
+				; i != end(context.byKey)) {
+				for (const auto index : i->second) {
+					context.elements[index].hidden = true;
+				}
+			}
+		} else if (entry.type == MenuEntry::Type::Submenu) {
+			HideAll(entry.entries, context);
+		}
+	}
+}
+
+void Emit(
+		const MenuLayout &layout,
+		std::vector<Node> &out,
+		Context &context) {
+	for (const auto &entry : layout) {
+		if (entry.type == MenuEntry::Type::Separator) {
+			out.push_back({
+				.type = Node::Type::Separator,
+				.style = entry.separator,
+			});
+		} else if (entry.type == MenuEntry::Type::Submenu) {
+			if (entry.hidden) {
+				HideAll(entry.entries, context);
+				continue;
+			}
+			auto node = Node{
+				.type = Node::Type::Submenu,
+				.title = entry.title,
+				.icon = MenuSubmenuIcon(entry.icon),
+			};
+			Emit(entry.entries, node.children, context);
+			out.push_back(std::move(node));
+		} else if (const auto i = context.byKey.find(entry.key)
+			; i != end(context.byKey)) {
+			for (const auto index : i->second) {
+				auto &element = context.elements[index];
+				if (entry.hidden) {
+					element.hidden = true;
+				} else {
+					element.placed = true;
+					out.push_back({ .element = index });
+				}
+			}
+		}
+	}
+}
+
+[[nodiscard]] bool Movable(const Element &element) {
+	return (element.kind != ElementKind::Fixed)
+		&& (!element.submenu || element.fill);
+}
+
+void Extract(
+		std::vector<Node> &list,
+		std::vector<Node> &lifted,
+		const std::vector<Element> &elements) {
+	for (auto i = list.begin(); i != list.end();) {
+		if (i->type == Node::Type::Submenu) {
+			Extract(i->children, lifted, elements);
+			++i;
+		} else if (i->type == Node::Type::Element
+			&& !Movable(elements[i->element])) {
+			lifted.push_back(std::move(*i));
+			i = list.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+void Lift(std::vector<Node> &top, const std::vector<Element> &elements) {
+	for (auto i = 0; i < int(top.size()); ++i) {
+		if (top[i].type != Node::Type::Submenu) {
+			continue;
+		}
+		auto lifted = std::vector<Node>();
+		Extract(top[i].children, lifted, elements);
+		const auto count = int(lifted.size());
+		top.insert(
+			top.begin() + i,
+			std::make_move_iterator(lifted.begin()),
+			std::make_move_iterator(lifted.end()));
+		i += count;
+	}
+}
+
+[[nodiscard]] bool Contains(const Node &node, int element) {
+	if (node.type == Node::Type::Element) {
+		return (node.element == element);
+	} else if (node.type == Node::Type::Submenu) {
+		return ranges::any_of(node.children, [&](const Node &child) {
+			return Contains(child, element);
+		});
+	}
+	return false;
+}
+
+void PlaceUnknown(std::vector<Node> &top, std::vector<Element> &elements) {
+	for (auto index = 0; index != int(elements.size()); ++index) {
+		auto &element = elements[index];
+		if (element.placed || element.hidden) {
+			continue;
+		}
+		auto position = 0;
+		for (auto previous = index - 1; previous >= 0; --previous) {
+			if (!elements[previous].placed) {
+				continue;
+			}
+			const auto i = ranges::find_if(top, [&](const Node &node) {
+				return Contains(node, previous);
+			});
+			if (i != end(top)) {
+				position = int(i - begin(top)) + 1;
+				break;
+			}
+		}
+		auto nodes = std::vector<Node>();
+		if (element.hasSeparatorBefore) {
+			nodes.push_back({
+				.type = Node::Type::Separator,
+				.separator = element.separatorBefore,
+				.styled = true,
+			});
+		}
+		nodes.push_back({ .element = index });
+		if (element.hasSeparatorAfter) {
+			nodes.push_back({
+				.type = Node::Type::Separator,
+				.separator = element.separatorAfter,
+				.styled = true,
+			});
+		}
+		top.insert(
+			top.begin() + position,
+			std::make_move_iterator(nodes.begin()),
+			std::make_move_iterator(nodes.end()));
+		element.placed = true;
+	}
+}
+
+[[nodiscard]] bool HasItems(const Node &node) {
+	return ranges::any_of(node.children, [](const Node &child) {
+		return (child.type != Node::Type::Separator);
+	});
+}
+
+[[nodiscard]] bool Redundant(
+		const Node &node,
+		const std::vector<Element> &elements) {
+	if (node.children.size() != 1
+		|| node.children.front().type != Node::Type::Element
+		|| node.title.isEmpty()) {
+		return false;
+	}
+	const auto &element = elements[node.children.front().element];
+	return element.action->text().startsWith(
+		node.title,
+		Qt::CaseInsensitive);
+}
+
+void Collapse(
+		std::vector<Node> &list,
+		const Context &context,
+		bool top) {
+	for (auto i = list.begin(); i != list.end();) {
+		if (i->type == Node::Type::Submenu) {
+			Collapse(i->children, context, false);
+			if (!HasItems(*i)) {
+				i = list.erase(i);
+				continue;
+			} else if (Redundant(*i, context.elements)) {
+				auto child = std::move(i->children.front());
+				*i = std::move(child);
+			}
+		}
+		++i;
+	}
+	const auto resolve = [&](const Node &node, const Node &next) {
+		if (node.styled && node.separator) {
+			return node.separator;
+		}
+		const auto item = (next.type == Node::Type::Element)
+			? context.elements[next.element].item
+			: -1;
+		const auto expanded = (item >= 0)
+			&& (context.info.items[item].flags & MenuItemFlag::Expanded);
+		return &MenuSeparatorFor(context.st, node.style, expanded, top);
+	};
+	auto result = std::vector<Node>();
+	auto run = std::vector<Node>();
+	result.reserve(list.size());
+	for (auto &node : list) {
+		if (node.type == Node::Type::Separator) {
+			run.push_back(std::move(node));
+			continue;
+		} else if (!run.empty() && !result.empty()) {
+			auto thickest = (const style::MenuSeparator*)nullptr;
+			for (const auto &separator : run) {
+				const auto resolved = resolve(separator, node);
+				if (!thickest || resolved->width > thickest->width) {
+					thickest = resolved;
+				}
+			}
+			result.push_back({
+				.type = Node::Type::Separator,
+				.separator = thickest,
+				.styled = true,
+			});
+		}
+		run.clear();
+		result.push_back(std::move(node));
+	}
+	list = std::move(result);
+}
+
+void KeepFixedOrder(
+		std::vector<Node> &top,
+		const std::vector<Element> &elements) {
+	auto positions = std::vector<int>();
+	auto fixed = std::vector<int>();
+	for (auto i = 0; i != int(top.size()); ++i) {
+		const auto &node = top[i];
+		if (node.type == Node::Type::Element
+			&& elements[node.element].kind == ElementKind::Fixed) {
+			positions.push_back(i);
+			fixed.push_back(node.element);
+		}
+	}
+	ranges::sort(fixed);
+	for (auto i = 0; i != int(positions.size()); ++i) {
+		top[positions[i]].element = fixed[i];
+	}
+}
+
+void FitToggleNow(not_null<Ui::Menu::Toggle*> item) {
+	const auto &st = item->st();
+	const auto &toggle = st.itemToggle;
+	const auto text = item->action()->text().split('\t').front();
+	const auto needed = std::clamp(
+		st.itemPadding.left()
+			+ st.itemStyle.font->width(text)
+			+ st.itemRightSkip
+			+ toggle.border * 2
+			+ toggle.diameter
+			+ toggle.width
+			- st.itemToggleShift
+			+ st.itemPadding.right(),
+		st.widthMin,
+		st.widthMax);
+	if (item->minWidth() < needed) {
+		item->setMinWidth(needed);
+	}
+}
