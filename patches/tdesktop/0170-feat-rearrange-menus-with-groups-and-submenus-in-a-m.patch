+#pragma once
+
+namespace Tele {
+
+enum class MenuKind : uchar {
+	Message,
+	Chat,
+	ChatRow,
+	FolderTab,
+	Profile,
+	Send,
+	Field,
+};
+
+enum class MenuSeparatorStyle : uchar {
+	Auto,
+	Thin,
+	Thick,
+};
+
+struct MenuEntry {
+	enum class Type : uchar {
+		Item,
+		Separator,
+		Submenu,
+	};
+	Type type = Type::Item;
+	MenuSeparatorStyle separator = MenuSeparatorStyle::Auto;
+	QString key;
+	QString title;
+	QString icon;
+	std::vector<MenuEntry> entries;
+	bool hidden = false;
+	bool fresh = false;
+};
+
+using MenuLayout = std::vector<MenuEntry>;
+
+enum class MenuPreset : uchar {
+	Default,
+	Upstream,
+	Minimal,
+	Power,
+};
+
+[[nodiscard]] std::optional<MenuLayout> ParseMenuLayout(const QString &text);
+[[nodiscard]] QString SerializeMenuLayout(const MenuLayout &layout);
+
+[[nodiscard]] MenuLayout MenuPresetLayout(MenuKind kind, MenuPreset preset);
+[[nodiscard]] MenuLayout ResolveMenuLayout(MenuKind kind, MenuLayout layout);
+[[nodiscard]] MenuLayout CurrentMenuLayout(MenuKind kind);
+[[nodiscard]] bool MenuLayoutCustom(MenuKind kind);
+[[nodiscard]] rpl::producer<bool> MenuLayoutCustomValue(MenuKind kind);
+void SaveMenuLayout(MenuKind kind, const MenuLayout &layout);
+
+[[nodiscard]] QString MenuLayoutClipboardText(
+	MenuKind kind,
+	const MenuLayout &layout);
+[[nodiscard]] std::optional<MenuLayout> ParseMenuLayoutClipboard(
+	MenuKind kind,
+	const QString &text);
+
+[[nodiscard]] std::optional<QString> NormalizeMenuLayouts(
+	const QString &value);
+
+} // namespace Tele
