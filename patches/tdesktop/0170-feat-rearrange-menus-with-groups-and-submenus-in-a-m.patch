+
+using Path = std::vector<int>;
+using Type = MenuEntry::Type;
+
+struct State {
+	MenuKind kind = MenuKind::Message;
+	MenuLayout layout;
+	int context = 0;
+	rpl::event_stream<> changes;
+};
+
+[[nodiscard]] QString DefaultTitle() {
+	return Lower(u"Submenu"_q);
+}
+
+[[nodiscard]] Path Parent(Path path) {
+	path.pop_back();
+	return path;
+}
+
+[[nodiscard]] bool IsPrefix(const Path &prefix, const Path &path) {
+	return (prefix.size() <= path.size())
+		&& std::equal(prefix.begin(), prefix.end(), path.begin());
+}
+
+[[nodiscard]] MenuLayout &Container(MenuLayout &layout, const Path &parent) {
+	auto result = &layout;
+	for (const auto index : parent) {
+		result = &(*result)[index].entries;
+	}
+	return *result;
+}
+
+[[nodiscard]] MenuEntry &At(MenuLayout &layout, const Path &path) {
+	return Container(layout, Parent(path))[path.back()];
+}
+
+[[nodiscard]] const MenuEntry *Find(
+		const MenuLayout &layout,
+		const Path &path) {
+	auto list = &layout;
+	auto result = (const MenuEntry*)nullptr;
+	for (const auto index : path) {
+		if (!list || index < 0 || index >= int(list->size())) {
+			return nullptr;
+		}
+		result = &(*list)[index];
+		list = (result->type == MenuEntry::Type::Submenu)
+			? &result->entries
+			: nullptr;
+	}
+	return result;
+}
+
+[[nodiscard]] bool IsSubmenu(const MenuLayout &layout, const Path &path) {
+	const auto entry = Find(layout, path);
+	return entry && (entry->type == MenuEntry::Type::Submenu);
+}
+
+void AdjustAfterRemove(const Path &removed, Path &path) {
+	const auto depth = int(removed.size()) - 1;
+	if (int(path.size()) > depth
+		&& std::equal(removed.begin(), removed.begin() + depth, path.begin())
+		&& path[depth] > removed.back()) {
+		--path[depth];
+	}
+}
+
+[[nodiscard]] MenuEntry Take(MenuLayout &layout, const Path &path) {
+	auto &list = Container(layout, Parent(path));
+	auto result = std::move(list[path.back()]);
+	list.erase(list.begin() + path.back());
+	return result;
+}
+
+Path Insert(
+		MenuLayout &layout,
+		Path parent,
+		int index,
+		MenuEntry entry) {
+	auto &list = Container(layout, parent);
+	index = std::clamp(index, 0, int(list.size()));
+	list.insert(list.begin() + index, std::move(entry));
+	parent.push_back(index);
+	return parent;
+}
+
+std::optional<Path> Move(
+		MenuLayout &layout,
+		const Path &from,
+		Path parent,
+		int index) {
+	if (IsPrefix(from, parent)) {
+		return std::nullopt;
+	} else if (Parent(from) == parent && from.back() < index) {
+		--index;
+	}
+	AdjustAfterRemove(from, parent);
+	auto entry = Take(layout, from);
+	return Insert(layout, std::move(parent), index, std::move(entry));
+}
+
+void CollectSubmenus(
+		const MenuLayout &layout,
+		Path &prefix,
+		std::vector<Path> &result) {
+	for (auto i = 0; i != int(layout.size()); ++i) {
+		if (layout[i].type != Type::Submenu) {
+			continue;
+		}
+		prefix.push_back(i);
+		result.push_back(prefix);
+		CollectSubmenus(layout[i].entries, prefix, result);
+		prefix.pop_back();
+	}
+}
+
+[[nodiscard]] const style::PopupMenu &PreviewStyle(MenuKind kind) {
+	switch (kind) {
+	case MenuKind::ChatRow: return st::popupMenuExpandedSeparator;
+	case MenuKind::Field: return st::defaultPopupMenu;
+	default: return st::popupMenuWithIcons;
+	}
+}
+
+[[nodiscard]] bool ExpandedNext(
+		MenuKind kind,
+		const MenuLayout &list,
+		int index) {
+	for (auto j = index + 1; j < int(list.size()); ++j) {
+		const auto &next = list[j];
+		if (next.type == MenuEntry::Type::Separator || next.hidden) {
+			continue;
+		} else if (next.type == MenuEntry::Type::Item) {
+			const auto item = LookupMenuItem(kind, next.key);
+			return item && (item->flags & MenuItemFlag::Expanded);
+		}
+		return false;
+	}
+	return false;
+}
+
+[[nodiscard]] bool SeparatorThick(
+		MenuKind kind,
+		MenuLayout &layout,
+		const Path &path) {
+	const auto &list = Container(layout, Parent(path));
+	const auto &entry = list[path.back()];
+	const auto &resolved = MenuSeparatorFor(
+		PreviewStyle(kind).menu,
+		entry.separator,
+		ExpandedNext(kind, list, path.back()),
+		path.size() == 1);
+	return (resolved.width >= st::expandedMenuSeparator.width);
+}
+
+[[nodiscard]] bool SupportAccount() {
+	const auto &account = Core::App().activeAccount();
+	return account.sessionExists() && account.session().supportMode();
+}
+
+[[nodiscard]] bool Listed(const MenuItemInfo &item) {
+	return !(item.flags & MenuItemFlag::SupportOnly) || SupportAccount();
+}
+
+[[nodiscard]] MenuLayout WithListed(MenuKind kind, MenuLayout layout) {
+	for (auto i = layout.begin(); i != layout.end();) {
+		if (i->type == MenuEntry::Type::Submenu) {
+			i->entries = WithListed(kind, std::move(i->entries));
+		} else if (i->type == MenuEntry::Type::Item) {
+			const auto item = LookupMenuItem(kind, i->key);
+			if (item && !Listed(*item)) {
+				i = layout.erase(i);
+				continue;
+			}
+		}
+		++i;
+	}
+	return layout;
+}
+
+[[nodiscard]] bool FeatureOn(const MenuItemInfo &item) {
+	if (!item.gate) {
+		return true;
+	}
+	const auto &value = base::options::details::Lookup(item.gate).value();
+	return !v::is<bool>(value) || v::get<bool>(value);
+}
+
+[[nodiscard]] QString FeatureHint(const MenuItemInfo &item) {
+	if (FeatureOn(item)) {
+		return QString();
+	}
+	const auto &option = base::options::details::Lookup(item.gate);
+	return Lower(u"Turn on "_q) + Lower(option.name());
+}
+
+[[nodiscard]] const MenuItemInfo *OffItem(
+		MenuKind kind,
+		const MenuEntry &data) {
+	const auto item = (data.type == MenuEntry::Type::Item)
+		? LookupMenuItem(kind, data.key)
+		: nullptr;
+	return (item && !FeatureOn(*item)) ? item : nullptr;
+}
+
+[[nodiscard]] bool TopLevelOnly(const MenuItemInfo &item) {
+	return (item.flags & MenuItemFlag::Fixed)
+		|| (item.flags & MenuItemFlag::TopLevel)
+		|| (item.flags & MenuItemFlag::Strip);
+}
+
+[[nodiscard]] bool Applies(const MenuItemInfo &item, int context) {
+	return !item.contexts
+		|| (context >= 0 && (item.contexts & (uint32(1) << context)));
+}
+
+[[nodiscard]] std::optional<bool> StripShown(const MenuLayout &layout) {
+	for (const auto &entry : layout) {
+		if (entry.type == Type::Item && entry.key == u"reactions"_q) {
+			return !entry.hidden;
+		} else if (entry.type == Type::Submenu) {
+			if (const auto shown = StripShown(entry.entries)) {
+				return *shown && !entry.hidden;
+			}
+		}
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QString EntryTitle(MenuKind kind, const MenuEntry &entry) {
+	if (entry.type == Type::Submenu) {
+		return entry.title.isEmpty() ? DefaultTitle() : Lower(entry.title);
+	} else if (entry.type == Type::Item) {
+		if (const auto item = LookupMenuItem(kind, entry.key)) {
+			return MenuItemLabel(*item);
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] const style::icon *EntryIcon(
+		MenuKind kind,
+		const MenuEntry &entry) {
+	if (entry.type == Type::Submenu) {
+		return MenuSubmenuIcon(entry.icon);
+	} else if (entry.type == Type::Item) {
+		if (const auto item = LookupMenuItem(kind, entry.key)) {
+			return MenuItemIcon(*item);
+		}
+	}
+	return nullptr;
+}
+
+class LayoutList final : public Ui::RpWidget {
+public:
+	LayoutList(QWidget *parent, not_null<State*> state);
+
+	void setScroll(not_null<Ui::ScrollArea*> scroll);
+	void refresh();
+
+	void startSeparatorDrag();
+	void moveSeparatorDrag(QPoint global);
+	void finishSeparatorDrag(QPoint global);
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void contextMenuEvent(QContextMenuEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+
+private:
+	struct Row {
+		Path path;
+		Type type = Type::Item;
+		int depth = 0;
+	};
+	struct Drop {
+		Path parent;
+		int index = -1;
+		std::optional<Path> onto;
+		int line = -1;
+		int lineLeft = 0;
+		int highlight = -1;
+	};
+
+	[[nodiscard]] int rowHeight() const;
+	[[nodiscard]] int indent() const;
+	[[nodiscard]] int handleWidth() const;
+	[[nodiscard]] int rowLeft(const Row &row) const;
+	[[nodiscard]] QRect eyeRect(int index) const;
+	[[nodiscard]] int rowAt(int y) const;
+	[[nodiscard]] MenuEntry &entry(const Row &row) const;
+	[[nodiscard]] std::optional<Drop> computeDrop(QPoint point) const;
+	void updateDrop(QPoint point);
+	void applyDrop();
+	void finishDrag();
+	void changed();
+	void toggleHidden(const Path &path);
+	void setSeparatorStyle(const Path &path, MenuSeparatorStyle style);
+	void moveTo(const Path &from, Path parent, int index);
+	void takeOut(const Path &path);
+	void remove(const Path &path);
+	void startRename(const Path &path);
+	void showPath(const Path &path);
+	void finishRename(bool save);
+	void showRowMenu(int index, QPoint global);
+	void autoscroll();
+	void paintRow(
+		QPainter &p,
+		const Row &row,
+		int top,
+		const QString &accent = QString()) const;
+	void paintFloating(QPainter &p, const Row &row, int top) const;
+	[[nodiscard]] bool draggedAway(int index) const;
+
+	const not_null<State*> _state;
+	std::vector<Row> _rows;
+	Ui::ScrollArea *_scroll = nullptr;
+	int _hovered = -1;
+	int _pressed = -1;
+	QPoint _pressPoint;
+	QPoint _dragPoint;
+	int _grabOffset = 0;
+	bool _dragging = false;
+	bool _separatorDrag = false;
+	std::optional<Drop> _drop;
+	base::Timer _autoscroll;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+	base::unique_qptr<Ui::InputField> _rename;
+	Path _renaming;
+	std::unique_ptr<style::InputField> _renameSt;
+
+};
+
+LayoutList::LayoutList(QWidget *parent, not_null<State*> state)
+: RpWidget(parent)
+, _state(state)
+, _autoscroll([=] { autoscroll(); }) {
+	setMouseTracking(true);
+	setFocusPolicy(Qt::ClickFocus);
+	const auto &menu = st::popupMenuWithIcons.menu;
+	_renameSt = std::make_unique<style::InputField>(st::defaultInputField);
+	const auto frame = st::lineWidth * 4;
+	_renameSt->textMargins = style::margins(
+		0,
+		menu.itemPadding.top() - frame,
+		0,
+		menu.itemPadding.bottom() - frame);
+	_renameSt->placeholderMargins = style::margins();
+	_renameSt->placeholderScale = 0.;
+	_renameSt->placeholderShift = 0;
+	_renameSt->placeholderFont = menu.itemStyle.font;
+	_renameSt->border = 0;
+	_renameSt->borderActive = 0;
+	_renameSt->style = menu.itemStyle;
+	_renameSt->textBg = st::windowBgOver;
+	_renameSt->textBgActive = st::windowBgOver;
+	_renameSt->heightMin = rowHeight() - frame * 2;
+	_renameSt->heightMax = rowHeight() - frame * 2;
+	_renameSt->widthMin = 0;
+	refresh();
+}
+
+void LayoutList::setScroll(not_null<Ui::ScrollArea*> scroll) {
+	_scroll = scroll;
+}
+
+int LayoutList::rowHeight() const {
+	const auto &st = st::popupMenuWithIcons.menu;
+	return st.itemPadding.top()
+		+ st.itemStyle.font->height
+		+ st.itemPadding.bottom();
+}
+
+int LayoutList::indent() const {
+	return st::boxRowPadding.left();
+}
+
+int LayoutList::handleWidth() const {
+	return st::stickersReorderIcon.width() + st::boxRowPadding.left();
+}
+
+int LayoutList::rowLeft(const Row &row) const {
+	return handleWidth() + row.depth * indent();
+}
+
+QRect LayoutList::eyeRect(int index) const {
+	const auto &icon = st::menuIconShowInChat;
+	const auto skip = st::boxRowPadding.right() / 2;
+	return QRect(
+		width() - skip - icon.width(),
+		index * rowHeight() + (rowHeight() - icon.height()) / 2,
+		icon.width(),
+		icon.height());
+}
+
+int LayoutList::rowAt(int y) const {
+	if (y < 0) {
+		return -1;
+	}
+	const auto index = y / rowHeight();
+	return (index < int(_rows.size())) ? index : -1;
+}
+
+MenuEntry &LayoutList::entry(const Row &row) const {
+	return At(_state->layout, row.path);
+}
+
+void LayoutList::refresh() {
+	const auto scrollTop = _scroll ? _scroll->scrollTop() : 0;
+	finishRename(false);
+	if (_dragging) {
+		finishDrag();
+	}
+	_rows.clear();
+	auto prefix = Path();
+	const auto flatten = [&](const auto &self, const MenuLayout &list)
+	-> void {
+		for (auto i = 0; i != int(list.size()); ++i) {
+			prefix.push_back(i);
+			_rows.push_back({
+				.path = prefix,
+				.type = list[i].type,
+				.depth = int(prefix.size()) - 1,
+			});
+			if (list[i].type == Type::Submenu) {
+				self(self, list[i].entries);
+			}
+			prefix.pop_back();
+		}
+	};
+	flatten(flatten, _state->layout);
+	resize(width(), std::max(int(_rows.size()), 1) * rowHeight());
+	if (_scroll && _scroll->scrollTop() != scrollTop) {
+		_scroll->scrollToY(scrollTop);
+	}
+	update();
+}
+
+void LayoutList::showPath(const Path &path) {
+	const auto i = ranges::find(_rows, path, &Row::path);
+	if (!_scroll || i == end(_rows)) {
+		return;
+	}
+	const auto index = int(i - begin(_rows));
+	_scroll->scrollToY(index * rowHeight(), (index + 1) * rowHeight());
+}
+
+void LayoutList::changed() {
+	refresh();
+	_state->changes.fire({});
+}
+
+void LayoutList::paintRow(
+		QPainter &p,
+		const Row &row,
+		int top,
+		const QString &accent) const {
+	const auto &st = st::popupMenuWithIcons.menu;
+	const auto height = rowHeight();
+	const auto &data = entry(row);
+	const auto left = rowLeft(row);
+	const auto skip = st::boxRowPadding.right() / 2;
+	const auto opacity = p.opacity();
+	st::stickersReorderIcon.paint(
+		p,
+		(handleWidth() - st::stickersReorderIcon.width()) / 2,
+		top + (height - st::stickersReorderIcon.height()) / 2,
+		width());
+	if (row.type == Type::Separator) {
+		const auto band = SeparatorThick(_state->kind, _state->layout, row.path)
+			? st::expandedMenuSeparator.width
+			: st::lineWidth;
+		p.fillRect(
+			left,
+			top + (height - band) / 2,
+			width() - left - skip,
+			band,
+			st::menuSeparatorFg);
+		return;
+	}
+	const auto item = (row.type == Type::Item)
+		? LookupMenuItem(_state->kind, data.key)
+		: nullptr;
+	const auto on = !item || FeatureOn(*item);
+	const auto faded = data.hidden || !on;
+	p.setOpacity(opacity * (faded ? 0.5 : 1.));
+	if (const auto icon = EntryIcon(_state->kind, data)) {
+		icon->paint(
+			p,
+			left + st.itemIconPosition.x(),
+			top + st.itemIconPosition.y(),
+			width());
+	}
+	const auto eye = eyeRect(0);
+	const auto textLeft = left + st.itemPadding.left();
+	const auto &font = st.itemStyle.font;
+	auto textRight = eye.x() - skip;
+	const auto hint = !accent.isEmpty()
+		? accent
+		: !item
+		? QString()
+		: !FeatureOn(*item)
+		? FeatureHint(*item)
+		: (row.depth > 0 && TopLevelOnly(*item))
+		? Lower(u"Stays in the main menu"_q)
+		: QString();
+	p.setFont(font);
+	if (!hint.isEmpty()) {
+		const auto &small = st::defaultTextStyle.font;
+		const auto title = EntryTitle(_state->kind, data);
+		const auto dots = data.fresh ? st::boxRowPadding.left() : 0;
+		const auto available = std::max(
+			(textRight - textLeft) / 2,
+			textRight - textLeft - font->width(title) - dots - skip);
+		const auto shown = small->elided(hint, available);
+		const auto hintWidth = small->width(shown);
+		p.setFont(small);
+		p.setPen(accent.isEmpty()
+			? st::windowSubTextFg
+			: st::windowActiveTextFg);
+		p.drawText(
+			textRight - hintWidth,
+			top + (height - small->height) / 2 + small->ascent,
+			shown);
+		textRight -= hintWidth + skip;
+		p.setFont(font);
+	}
+	auto title = EntryTitle(_state->kind, data);
+	if (row.type == Type::Submenu) {
+		title += QString::fromUtf8(" \xe2\x96\xb8");
+	}
+	const auto dot = data.fresh ? st::boxRowPadding.left() / 2 : 0;
+	const auto shown = font->elided(title, textRight - textLeft - dot * 2);
+	p.setPen(on ? st::windowFg : st::windowSubTextFg);
+	p.drawText(
+		textLeft,
+		top + st.itemPadding.top() + font->ascent,
+		shown);
+	if (data.fresh) {
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::activeButtonBg);
+		const auto size = dot;
+		p.drawEllipse(
+			textLeft + font->width(shown) + dot / 2,
+			top + (height - size) / 2,
+			size,
+			size);
+	}
+	p.setOpacity(opacity);
+	(data.hidden ? st::menuIconStealth : st::menuIconShowInChat).paint(
+		p,
+		eye.x(),
+		top + eye.y(),
+		width());
+}
+
+bool LayoutList::draggedAway(int index) const {
+	return _dragging
+		&& !_separatorDrag
+		&& _pressed >= 0
+		&& _pressed < int(_rows.size())
+		&& IsPrefix(_rows[_pressed].path, _rows[index].path);
+}
+
+void LayoutList::paintFloating(QPainter &p, const Row &row, int top) const {
+	const auto height = rowHeight();
+	const auto margin = st::lineWidth * 4;
+	const auto card = QRect(margin, top, width() - margin * 2, height);
+	const auto radius = st::roundRadiusSmall;
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		for (auto i = 3; i != 0; --i) {
+			p.setOpacity(0.08 * (4 - i));
+			p.setBrush(st::shadowFg);
+			const auto spread = i * st::lineWidth * 2;
+			p.drawRoundedRect(
+				card.marginsAdded({ spread, spread, spread, spread * 2 }),
+				radius + spread,
+				radius + spread);
+		}
+		p.setOpacity(1.);
+		p.setBrush(st::windowBg);
+		p.setPen(st::activeButtonBg);
+		p.drawRoundedRect(card, radius, radius);
+	}
+	p.save();
+	p.setClipRect(card.marginsRemoved(
+		{ st::lineWidth, st::lineWidth, st::lineWidth, st::lineWidth }));
+	paintRow(p, row, top);
+	p.restore();
+}
+
+void LayoutList::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto height = rowHeight();
+	const auto clip = e->rect();
+	const auto radius = st::roundRadiusSmall;
+	const auto inset = st::lineWidth * 2;
+	for (auto i = 0; i != int(_rows.size()); ++i) {
+		const auto top = i * height;
+		if (top + height <= clip.y() || top >= clip.y() + clip.height()) {
+			continue;
+		}
+		const auto rect = QRect(0, top, width(), height).marginsRemoved(
+			{ inset, inset, inset, inset });
+		if (draggedAway(i)) {
+			auto hq = PainterHighQualityEnabler(p);
+			p.setPen(Qt::NoPen);
+			p.setBrush(st::windowBgOver);
+			p.drawRoundedRect(rect, radius, radius);
+			continue;
+		}
+		auto accent = QString();
+		const auto renaming = _rename && (_rows[i].path == _renaming);
+		if (renaming || (_drop && _drop->highlight == i)) {
+			auto hq = PainterHighQualityEnabler(p);
+			auto pen = QPen(st::activeButtonBg);
+			pen.setWidth(st::lineWidth * 2);
+			p.setPen(pen);
+			p.setBrush(st::windowBgOver);
+			p.drawRoundedRect(rect, radius, radius);
+			accent = renaming
+				? QString()
+				: (_rows[i].type == Type::Submenu)
+				? Lower(u"Move into"_q)
+				: Lower(u"New submenu"_q);
+		} else if (!_dragging && i == _hovered) {
+			p.fillRect(0, top, width(), height, st::windowBgOver);
+		}
+		paintRow(p, _rows[i], top, accent);
+	}
+	if (_drop && _drop->line >= 0) {
+		const auto thickness = st::lineWidth * 2;
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::activeButtonBg);
+		p.drawRoundedRect(
+			QRect(
+				_drop->lineLeft,
+				_drop->line - thickness / 2,
+				width() - _drop->lineLeft - inset,
+				thickness),
+			thickness / 2.,
+			thickness / 2.);
+		const auto dot = thickness * 3;
+		p.drawEllipse(
+			_drop->lineLeft - dot / 2,
+			_drop->line - dot / 2,
+			dot,
+			dot);
+	}
+	if (_dragging
+		&& !_separatorDrag
+		&& _pressed >= 0
+		&& _pressed < int(_rows.size())) {
+		paintFloating(p, _rows[_pressed], _dragPoint.y() - _grabOffset);
+	}
+}
+
+void LayoutList::mousePressEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	const auto index = rowAt(e->pos().y());
+	if (index < 0) {
+		return;
+	}
+	const auto &row = _rows[index];
+	if (row.type != Type::Separator
+		&& eyeRect(index).marginsAdded(
+			{ st::lineWidth * 4, 0, st::lineWidth * 4, 0 }
+		).contains(e->pos())) {
+		toggleHidden(row.path);
+		return;
+	}
+	_pressed = index;
+	_pressPoint = e->pos();
+}
+
+void LayoutList::mouseMoveEvent(QMouseEvent *e) {
+	const auto index = rowAt(e->pos().y());
+	if (_hovered != index) {
+		_hovered = index;
+		update();
+	}
+	setCursor((_dragging || index >= 0)
+		? style::cur_pointer
+		: style::cur_default);
+	if (_pressed < 0 || _separatorDrag) {
+		return;
+	}
+	if (!_dragging) {
+		const auto distance = (e->pos() - _pressPoint).manhattanLength();
+		if (distance < QApplication::startDragDistance()) {
+			return;
+		}
+		_dragging = true;
+		_grabOffset = std::clamp(
+			_pressPoint.y() - _pressed * rowHeight(),
+			0,
+			rowHeight());
+		_autoscroll.callEach(crl::time(15));
+	}
+	updateDrop(e->pos());
+}
+
+void LayoutList::mouseReleaseEvent(QMouseEvent *e) {
+	if (_separatorDrag || e->button() != Qt::LeftButton) {
+		return;
+	}
+	if (_dragging) {
+		updateDrop(e->pos());
+		applyDrop();
+	}
+	finishDrag();
+}
+
+void LayoutList::leaveEventHook(QEvent *e) {
+	if (_hovered >= 0 && !_dragging) {
+		_hovered = -1;
+		update();
+	}
+}
+
+void LayoutList::contextMenuEvent(QContextMenuEvent *e) {
+	const auto index = rowAt(e->pos().y());
+	if (index >= 0 && !_dragging) {
+		showRowMenu(index, e->globalPos());
+	}
+}
+
+void LayoutList::startSeparatorDrag() {
+	_separatorDrag = true;
+	_dragging = true;
+	_pressed = -1;
+	_autoscroll.callEach(crl::time(15));
+}
+
+void LayoutList::moveSeparatorDrag(QPoint global) {
+	if (_separatorDrag) {
+		updateDrop(mapFromGlobal(global));
+	}
+}
+
+void LayoutList::finishSeparatorDrag(QPoint global) {
+	if (!_separatorDrag) {
+		return;
+	}
+	updateDrop(mapFromGlobal(global));
+	applyDrop();
+	finishDrag();
+}
+
+void LayoutList::finishDrag() {
+	_autoscroll.cancel();
+	_dragging = false;
+	_separatorDrag = false;
+	_pressed = -1;
+	_drop = std::nullopt;
+	update();
+}
+
+std::optional<LayoutList::Drop> LayoutList::computeDrop(
+		QPoint point) const {
+	const auto visible = _scroll
+		? QRect(0, _scroll->scrollTop(), width(), _scroll->height())
+		: rect();
+	if (!visible.marginsAdded({ 0, rowHeight(), 0, rowHeight() }).contains(
+			point)) {
+		return std::nullopt;
+	}
+	const auto height = rowHeight();
+	const auto dragged = (!_separatorDrag
+		&& _pressed >= 0
+		&& _pressed < int(_rows.size()))
+		? &_rows[_pressed]
+		: nullptr;
+	const auto draggedType = dragged ? dragged->type : Type::Separator;
+	const auto index = std::max(point.y(), 0) / height;
+	if (index >= int(_rows.size())) {
+		return Drop{
+			.index = int(_state->layout.size()),
+			.line = int(_rows.size()) * height,
+			.lineLeft = handleWidth(),
+		};
+	}
+	const auto &row = _rows[index];
+	if (dragged && IsPrefix(dragged->path, row.path)) {
+		return std::nullopt;
+	}
+	const auto fraction = (point.y() - index * height) / float64(height);
+	const auto middle = (fraction >= 0.25 && fraction <= 0.75);
+	if (middle
+		&& draggedType != Type::Separator
+		&& row.type != Type::Separator) {
+		if (row.type == Type::Item) {
+			return Drop{ .onto = row.path, .highlight = index };
+		} else if (row.type == Type::Submenu) {
+			return Drop{
+				.parent = row.path,
+				.index = int(entry(row).entries.size()),
+				.highlight = index,
+			};
+		}
+	}
+	if (fraction < 0.5) {
+		return Drop{
+			.parent = Parent(row.path),
+			.index = row.path.back(),
+			.line = index * height,
+			.lineLeft = rowLeft(row),
+		};
+	} else if (row.type == Type::Submenu) {
+		return Drop{
+			.parent = row.path,
+			.index = 0,
+			.line = (index + 1) * height,
+			.lineLeft = rowLeft(row) + indent(),
+		};
+	}
+	return Drop{
+		.parent = Parent(row.path),
+		.index = row.path.back() + 1,
+		.line = (index + 1) * height,
+		.lineLeft = rowLeft(row),
+	};
+}
+
+void LayoutList::updateDrop(QPoint point) {
+	_dragPoint = point;
+	_drop = computeDrop(point);
+	update();
+}
+
+void LayoutList::applyDrop() {
+	if (!_drop) {
+		return;
+	}
+	const auto drop = *_drop;
+	auto &layout = _state->layout;
+	if (_separatorDrag) {
+		const auto inserted = Insert(
+			layout,
+			drop.parent,
+			drop.index,
+			MenuEntry{
+				.type = Type::Separator,
+				.separator = MenuSeparatorStyle::Thin,
+			});
+		changed();
+		showPath(inserted);
+		return;
+	} else if (_pressed < 0 || _pressed >= int(_rows.size())) {
+		return;
+	}
+	const auto from = _rows[_pressed].path;
+	if (!drop.onto) {
+		moveTo(from, drop.parent, drop.index);
+		return;
+	}
+	auto target = *drop.onto;
+	if (target == from || IsPrefix(from, target) || !Find(layout, target)) {
+		return;
+	}
+	AdjustAfterRemove(from, target);
+	auto moved = Take(layout, from);
+	auto &slot = At(layout, target);
+	auto submenu = MenuEntry{ .type = Type::Submenu, .title = u"Submenu"_q };
+	submenu.entries.push_back(std::move(slot));
+	submenu.entries.push_back(std::move(moved));
+	slot = std::move(submenu);
+	changed();
+	startRename(target);
+}
+
+void LayoutList::moveTo(const Path &from, Path parent, int index) {
+	const auto &layout = _state->layout;
+	if (!Find(layout, from)
+		|| (!parent.empty() && !IsSubmenu(layout, parent))) {
+		return;
+	} else if (const auto moved = Move(
+			_state->layout,
+			from,
+			std::move(parent),
+			index)) {
+		changed();
+		showPath(*moved);
+	}
+}
+
+void LayoutList::toggleHidden(const Path &path) {
+	if (!Find(_state->layout, path)) {
+		return;
+	}
+	auto &data = At(_state->layout, path);
+	if (const auto item = OffItem(_state->kind, data)) {
+		base::options::lookup<bool>(item->gate).set(true);
+		data.hidden = false;
+		changed();
+		return;
+	}
+	data.hidden = !data.hidden;
+	changed();
+}
+
+void LayoutList::setSeparatorStyle(
+		const Path &path,
+		MenuSeparatorStyle style) {
+	const auto found = Find(_state->layout, path);
+	if (!found || found->type != Type::Separator) {
+		return;
+	}
+	At(_state->layout, path).separator = style;
+	changed();
+}
+
+void LayoutList::takeOut(const Path &path) {
+	if (path.size() < 2 || !Find(_state->layout, path)) {
+		return;
+	}
+	const auto submenu = Parent(path);
+	moveTo(path, Parent(submenu), submenu.back() + 1);
+}
+
+void LayoutList::remove(const Path &path) {
+	auto &layout = _state->layout;
+	if (!Find(layout, path)) {
+		return;
+	}
+	auto entry = Take(layout, path);
+	if (entry.type == Type::Submenu) {
+		auto &list = Container(layout, Parent(path));
+		list.insert(
+			list.begin() + path.back(),
+			std::make_move_iterator(entry.entries.begin()),
+			std::make_move_iterator(entry.entries.end()));
+	}
+	changed();
+}
+
+void LayoutList::startRename(const Path &path) {
+	finishRename(false);
+	if (!IsSubmenu(_state->layout, path)) {
+		return;
+	}
+	const auto i = ranges::find(_rows, path, &Row::path);
+	if (i == end(_rows)) {
+		return;
+	}
+	const auto index = int(i - begin(_rows));
+	const auto &st = st::popupMenuWithIcons.menu;
+	const auto left = rowLeft(*i) + st.itemPadding.left();
+	_renaming = path;
+	_rename = base::make_unique_q<Ui::InputField>(
+		this,
+		*_renameSt,
+		rpl::single(DefaultTitle()),
+		entry(*i).title);
+	_rename->resizeToWidth(
+		eyeRect(index).x() - st::boxRowPadding.right() / 2 - left);
+	_rename->moveToLeft(left, index * rowHeight() + st::lineWidth * 4);
+	update();
+	base::install_event_filter(_rename.get(), [=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::KeyPress
+			&& static_cast<QKeyEvent*>(e.get())->key() == Qt::Key_Escape) {
+			finishRename(false);
+			return base::EventFilterResult::Cancel;
+		}
+		return base::EventFilterResult::Continue;
+	});
+	_rename->show();
+	_rename->setFocusFast();
+	_rename->selectAll();
+	_rename->submits() | rpl::on_next([=] {
+		finishRename(true);
+	}, _rename->lifetime());
+	_rename->cancelled() | rpl::on_next([=] {
+		finishRename(false);
+	}, _rename->lifetime());
+	_rename->focusedChanges() | rpl::filter([](bool focused) {
+		return !focused;
+	}) | rpl::on_next([=] {
+		finishRename(true);
+	}, _rename->lifetime());
+	if (_scroll) {
+		_scroll->scrollToY(
+			index * rowHeight(),
+			(index + 1) * rowHeight());
+	}
+}
+
+void LayoutList::finishRename(bool save) {
+	if (!_rename) {
+		return;
+	}
+	const auto title = _rename->getLastText().trimmed();
+	const auto path = base::take(_renaming);
+	auto field = base::take(_rename);
+	if (field->hasFocus() || field->isAncestorOf(QApplication::focusWidget())) {
+		setFocus();
+	}
+	field->hide();
+	crl::on_main(this, [owned = std::move(field)]() mutable {
+		owned = nullptr;
+	});
+	update();
+	if (save && IsSubmenu(_state->layout, path)) {
+		auto &data = At(_state->layout, path);
+		data.title = title.isEmpty() ? u"Submenu"_q : title;
+		changed();
+	}
+}
+
+void LayoutList::showRowMenu(int index, QPoint global) {
+	const auto row = _rows[index];
+	const auto &data = entry(row);
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	const auto path = row.path;
+	if (row.type != Type::Separator) {
+		const auto off = OffItem(_state->kind, data);
+		_menu->addAction(
+			(off
+				? FeatureHint(*off)
+				: data.hidden
+				? Lower(u"Show"_q)
+				: Lower(u"Hide"_q)),
+			[=] { toggleHidden(path); },
+			((off || data.hidden)
+				? &st::menuIconShowInChat
+				: &st::menuIconStealth));
+	} else {
+		const auto thick = SeparatorThick(
+			_state->kind,
+			_state->layout,
+			path);
+		const auto check = [](bool checked) {
+			return checked ? &st::mediaPlayerMenuCheck : nullptr;
+		};
+		_menu->addAction(Lower(u"Thin"_q), [=] {
+			setSeparatorStyle(path, MenuSeparatorStyle::Thin);
+		}, check(!thick));
+		_menu->addAction(Lower(u"Thick"_q), [=] {
+			setSeparatorStyle(path, MenuSeparatorStyle::Thick);
+		}, check(thick));
+	}
+	auto submenus = std::vector<Path>();
+	auto prefix = Path();
+	CollectSubmenus(_state->layout, prefix, submenus);
+	submenus.erase(ranges::remove_if(submenus, [&](const Path &submenu) {
+		return IsPrefix(path, submenu) || (submenu == Parent(path));
+	}), submenus.end());
+	if (!submenus.empty()) {
+		const auto titles = ranges::views::all(
+			submenus
+		) | ranges::views::transform([&](const Path &submenu) {
+			return EntryTitle(
+				_state->kind,
+				At(_state->layout, submenu));
+		}) | ranges::to_vector;
+		Ui::Menu::CreateAddActionCallback(_menu.get())({
+			.text = Lower(u"Move to submenu"_q),
+			.handler = nullptr,
+			.icon = &st::menuIconAddToFolder,
+			.fillSubmenu = [=](not_null<Ui::PopupMenu*> menu) {
+				for (auto i = 0; i != int(submenus.size()); ++i) {
+					const auto target = submenus[i];
+					menu->addAction(titles[i], [=] {
+						const auto entry = Find(_state->layout, target);
+						if (entry && entry->type == Type::Submenu) {
+							moveTo(path, target, int(entry->entries.size()));
+						}
+					});
+				}
+			},
+		});
+	}
+	if (path.size() > 1) {
+		_menu->addAction(
+			Lower(u"Take out of submenu"_q),
+			[=] { takeOut(path); },
+			&st::menuIconLeave);
+	}
+	if (row.type == Type::Submenu) {
+		_menu->addAction(
+			Lower(u"Rename"_q),
+			[=] { startRename(path); },
+			&st::menuIconEdit);
+	}
+	if (row.type != Type::Item) {
+		_menu->addAction(
+			Lower(u"Remove"_q),
+			[=] { remove(path); },
+			&st::menuIconDelete);
+	}
+	if (_menu->empty()) {
+		_menu = nullptr;
+		return;
+	}
+	_menu->popup(global);
+}
+
+void LayoutList::autoscroll() {
+	if (!_scroll || !_dragging) {
+		return;
+	}
+	const auto global = QCursor::pos();
+	const auto local = _scroll->mapFromGlobal(global);
+	const auto edge = rowHeight();
+	auto delta = 0;
+	if (local.y() < edge) {
+		delta = -std::max((edge - local.y()) / 3, 1);
+	} else if (local.y() > _scroll->height() - edge) {
+		delta = std::max((local.y() - _scroll->height() + edge) / 3, 1);
+	}
+	if (delta) {
+		_scroll->scrollToY(_scroll->scrollTop() + delta);
+		updateDrop(mapFromGlobal(global));
+	}
+}
