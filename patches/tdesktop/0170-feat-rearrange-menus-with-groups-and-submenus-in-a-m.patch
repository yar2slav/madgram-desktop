-		std::vector<Row> rows;
-		std::unique_ptr<Ui::VerticalLayoutReorder> reorder;
-		Ui::ScrollArea *scroll = nullptr;
-	};
-	const auto &registry = Registry();
-	const auto state = box->lifetime().make_state<State>(State{
-		.st = st::settingsButton,
-	});
-	const auto skip = st::settingsButton.toggleSkip;
-	const auto handleWidth = st::stickersReorderIcon.width() + skip;
-	state->st.toggleSkip += handleWidth;
-
-	box->setWidth(st::boxWideWidth);
-	box->setTitle(rpl::single(Lower(u"Message menu"_q)));
