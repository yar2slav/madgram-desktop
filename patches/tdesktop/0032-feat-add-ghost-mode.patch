+class GhostChatRow final : public PeerListRowWithLink {
+public:
+	explicit GhostChatRow(not_null<PeerData*> peer)
+	: PeerListRowWithLink(peer) {
+	}
+
+	QString generateName() override {
+		return peer()->isMinimalLoaded()
+			? PeerListRowWithLink::generateName()
+			: u"Unknown chat"_q;
+	}
+
+};
+
+class GhostChatsController final : public PeerListController {
+public:
+	explicit GhostChatsController(
+		not_null<Window::SessionController*> window);
+
+	Main::Session &session() const override;
+	void prepare() override;
+	void rowClicked(not_null<PeerListRow*> row) override;
+	void rowRightActionClicked(not_null<PeerListRow*> row) override;
+
+private:
+	void refreshRows();
+
+	const not_null<Window::SessionController*> _window;
+
+};
+
+GhostChatsController::GhostChatsController(
+	not_null<Window::SessionController*> window)
+: _window(window) {
+}
+
+Main::Session &GhostChatsController::session() const {
+	return _window->session();
+}
+
+void GhostChatsController::prepare() {
+	delegate()->peerListSetTitle(rpl::single(u"Ghost mode in chats"_q));
+	::Tele::GhostChatsChanges(
+	) | rpl::on_next([=] {
+		refreshRows();
+	}, lifetime());
+	refreshRows();
+}
+
+void GhostChatsController::refreshRows() {
+	const auto chats = ::Tele::GhostChats(&session());
+	auto keep = base::flat_set<PeerListRowId>();
+	for (const auto &chat : chats) {
+		keep.emplace(chat.id.value);
+	}
+	for (auto i = delegate()->peerListFullRowsCount(); i != 0;) {
+		const auto row = delegate()->peerListRowAt(--i);
+		if (!keep.contains(row->id())) {
+			delegate()->peerListRemoveRow(row);
+		}
+	}
+	for (const auto &chat : chats) {
+		auto row = delegate()->peerListFindRow(chat.id.value);
+		if (!row) {
+			auto created = std::make_unique<GhostChatRow>(
+				session().data().peer(chat.id));
+			created->setActionLink(u"Remove"_q);
+			row = created.get();
+			delegate()->peerListAppendRow(std::move(created));
+		}
+		row->setCustomStatus(
+			(chat.mode == ::Tele::GhostOverride::Always)
+				? u"Always ghost"_q
+				: u"Never ghost"_q);
+	}
+	setDescriptionText(chats.empty()
+		? u"No chats yet. Pick Ghost mode in this chat in a chat's "
+			"menu."_q
+		: QString());
+	delegate()->peerListRefreshRows();
+}
