+#include "ui/widgets/buttons.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/popup_menu.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_media_player.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_window.h"
+
+namespace Tele {
+namespace {
+
+template <typename Callback>
+void EnumerateSessions(Callback &&callback) {
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			callback(not_null<Main::Session*>(session));
+		}
+	}
+}
+
+constexpr auto kTestBit = BareId(1) << 63;
+constexpr auto kChannelShift = int64(1000000000000LL);
+constexpr auto kScheduleDelay = TimeId(12);
+constexpr auto kScheduleProxyDelay = TimeId(15);
+
+using Key = BareId;
+
+struct State {
+	State();
+
+	base::flat_map<Key, GhostOverride> overrides;
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] Key MakeKey(PeerId id, bool test) {
+	return id.value | (test ? kTestBit : Key());
+}
+
+[[nodiscard]] Key PeerKey(not_null<PeerData*> peer) {
+	return MakeKey(peer->id, peer->session().isTestMode());
+}
+
+[[nodiscard]] PeerId KeyPeer(Key key) {
+	return PeerId(key & ~kTestBit);
+}
+
+[[nodiscard]] PeerId ParseBotApiId(const QString &text) {
+	auto ok = false;
+	const auto id = text.toLongLong(&ok);
+	if (!ok || !id) {
+		return PeerId();
+	} else if (id > 0) {
+		return peerFromUser(UserId(uint64(id)));
+	} else if (id > -kChannelShift) {
+		return peerFromChat(ChatId(uint64(-id)));
+	}
+	return peerFromChannel(ChannelId(uint64(-id - kChannelShift)));
+}
+
+[[nodiscard]] QString BotApiId(PeerId id) {
+	const auto bare = int64(id.value & PeerId::kChatTypeMask);
+	return QString::number(peerIsChat(id)
+		? -bare
+		: peerIsChannel(id)
+		? -(kChannelShift + bare)
+		: bare);
+}
+
+[[nodiscard]] base::flat_map<Key, GhostOverride> Parse(
+		const QString &value) {
+	auto result = base::flat_map<Key, GhostOverride>();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto entry = part.trimmed();
+		const auto test = entry.startsWith(u"test:"_q);
+		if (test) {
+			entry = entry.mid(5);
+		}
+		const auto pair = entry.split(QChar('='));
+		if (pair.size() != 2) {
+			continue;
+		}
+		const auto text = pair[1].trimmed();
+		const auto mode = (text == u"always"_q)
+			? GhostOverride::Always
+			: (text == u"never"_q)
+			? GhostOverride::Never
+			: GhostOverride::Default;
+		const auto id = ParseBotApiId(pair[0].trimmed());
+		if (id && mode != GhostOverride::Default) {
+			result[MakeKey(id, test)] = mode;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Serialize(
+		const base::flat_map<Key, GhostOverride> &overrides) {
+	auto list = QStringList();
+	list.reserve(int(overrides.size()));
+	for (const auto &[key, mode] : overrides) {
+		const auto id = BotApiId(KeyPeer(key));
+		const auto text = (mode == GhostOverride::Always)
+			? u"always"_q
+			: u"never"_q;
+		list.push_back(((key & kTestBit) ? u"test:"_q : QString())
+			+ id
+			+ '='
+			+ text);
+	}
+	return list.join(QChar(','));
+}
+
+State::State() {
+	GhostChatsValue(
+	) | rpl::on_next([=](const QString &value) {
+		overrides = Parse(value);
+		changes.fire({});
+	}, lifetime);
+
+	GhostOnlineChanges(
+	) | rpl::on_next([] {
+		EnumerateSessions([](not_null<Main::Session*> session) {
+			session->updates().updateOnline();
+		});
+	}, lifetime);
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+[[nodiscard]] bool Ghosted(not_null<PeerData*> peer) {
+	switch (ChatGhostOverride(peer)) {
+	case GhostOverride::Always: return true;
+	case GhostOverride::Never: return false;
+	case GhostOverride::Default: break;
+	}
+	return Ghost();
+}
+
+void SendRead(
+		not_null<History*> history,
+		MsgId rootId,
+		PeerData *sublistPeer,
+		MsgId tillId) {
+	if (!IsServerMsgId(tillId)) {
+		return;
+	}
+	const auto peer = history->peer;
+	auto &api = peer->session().api();
+	if (rootId) {
+		api.request(MTPmessages_ReadDiscussion(
+			peer->input(),
+			MTP_int(rootId),
+			MTP_int(tillId)
+		)).send();
+	} else if (sublistPeer) {
+		api.request(MTPmessages_ReadSavedHistory(
+			peer->input(),
+			sublistPeer->input(),
+			MTP_int(tillId)
+		)).send();
+	} else if (const auto channel = peer->asChannel()) {
+		api.request(MTPchannels_ReadHistory(
+			channel->inputChannel(),
+			MTP_int(tillId)
+		)).send();
+	} else {
+		api.request(MTPmessages_ReadHistory(
+			peer->input(),
+			MTP_int(tillId)
+		)).done([=](const MTPmessages_AffectedMessages &result) {
+			peer->session().api().applyAffectedMessages(peer, result);
+		}).send();
+	}
+}
+
+void MarkReadTill(not_null<HistoryItem*> item) {
+	const auto history = item->history();
+	if (history->isForum()) {
+		SendRead(history, item->topicRootId(), nullptr, item->id);
+	} else if (history->amMonoforumAdmin()) {
+		if (const auto sublistPeerId = item->sublistPeerId()) {
+			SendRead(
+				history,
+				0,
+				history->owner().peer(sublistPeerId),
+				item->id);
+		}
+	} else {
+		SendRead(history, 0, nullptr, item->id);
+	}
+}
+
+[[nodiscard]] MsgId LastServerId(not_null<History*> history) {
+	if (history->lastServerMessageKnown()) {
+		const auto last = history->lastServerMessage();
+		return last ? last->id : MsgId();
+	}
+	return history->maxMsgId();
+}
+
+[[nodiscard]] TimeId ScheduleDelay() {
+	return Core::App().settings().proxy().isEnabled()
+		? kScheduleProxyDelay
+		: kScheduleDelay;
+}
+
+[[nodiscard]] bool CanGhostSchedule(
+		const Api::SendAction &action,
+		const QString &caption) {
+	const auto peer = action.history->peer;
+	const auto &options = action.options;
+	const auto &replyTo = action.replyTo;
+	return GhostSchedule()
+		&& Ghosted(peer)
+		&& !options.scheduled
+		&& !options.shortcutId
+		&& !options.welcomeTemplate
+		&& !options.suggest
+		&& !options.price
+		&& !options.ttlSeconds
+		&& !options.stakeNanoTon
+		&& !action.replaceMediaOf
+		&& !replyTo.storyId
+		&& !replyTo.monoforumPeerId
+		&& (!replyTo.topicRootId || peer->isForum())
+		&& !peer->isSelf()
+		&& !peer->isBot()
+		&& !peer->starsPerMessageChecked()
+		&& !peer->session().ephemeralMessages().wouldSendMedia(
+			peer,
+			replyTo,
+			caption);
+}
+
+} // namespace
+
+bool HideRead(not_null<PeerData*> peer) {
+	return GhostRead() && Ghosted(peer);
+}
+
+bool HideTyping(not_null<PeerData*> peer) {
+	return GhostTyping() && Ghosted(peer);
+}
+
+bool HideOnline() {
+	Get();
+	return Ghost() && GhostOnline();
+}
+
+bool SkipReadInbox(not_null<History*> history, MsgId tillId) {
+	if (!HideRead(history->peer)) {
+		return false;
+	}
+	crl::on_main(&history->session(), [=] {
+		history->inboxRead(tillId);
+	});
+	return true;
+}
+
+void ReadOnSend(const Api::SendAction &action) {
+	const auto history = action.history;
+	const auto peer = history->peer;
+	if (!GhostReadOnReply() || !HideRead(peer)) {
+		return;
+	}
+	const auto topicRootId = action.replyTo.topicRootId;
+	const auto monoforumPeerId = action.replyTo.monoforumPeerId;
+	const auto topic = topicRootId
+		? peer->forumTopicFor(topicRootId)
+		: nullptr;
+	const auto sublist = monoforumPeerId
+		? peer->monoforumSublistFor(monoforumPeerId)
+		: nullptr;
+	if (topic) {
+		SendRead(
+			history,
+			topicRootId,
+			nullptr,
+			topic->lastKnownServerMessageId());
+	} else if (sublist) {
+		SendRead(
+			history,
+			0,
+			sublist->sublistPeer(),
+			sublist->lastKnownServerMessageId());
+	} else {
+		SendRead(history, 0, nullptr, LastServerId(history));
+	}
+}
+
+void ApplyGhostSchedule(Api::SendAction &action, const QString &caption) {
+	if (CanGhostSchedule(action, caption)) {
+		action.options.scheduled = base::unixtime::now() + ScheduleDelay();
+	}
+}
+
+void ApplyGhostSchedule(
+		Api::SendAction &action,
+		const Ui::PreparedList &list) {
+	for (const auto &file : list.files) {
+		if (file.ttlSeconds || !CanGhostSchedule(action, file.caption.text)) {
+			return;
+		}
+	}
+	ApplyGhostSchedule(action);
+}
+
+Api::SendAction WithGhostSchedule(Api::SendAction action) {
+	ApplyGhostSchedule(action);
+	return action;
+}
+
+bool IsGhostScheduled(const Api::SendAction &action) {
+	const auto scheduled = action.options.scheduled;
+	return scheduled
+		&& GhostSchedule()
+		&& Ghosted(action.history->peer)
+		&& (scheduled <= base::unixtime::now() + kScheduleProxyDelay);
+}
+
+void RefreshGhostSchedule(
+		not_null<PeerData*> peer,
+		Api::SendOptions &options) {
+	if (!options.scheduled || !GhostSchedule() || !Ghosted(peer)) {
+		return;
+	}
+	const auto earliest = base::unixtime::now() + ScheduleDelay();
+	if (options.scheduled < earliest) {
+		options.scheduled = earliest;
+	}
+}
+
+void AddMarkReadAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
+	if (!item
+		|| !item->isRegular()
+		|| !IsServerMsgId(item->id)
+		|| item->history()->peer->isSelf()
+		|| !HideRead(item->history()->peer)) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	const auto itemId = item->fullId();
+	menu->addAction(u"Mark as read up to here"_q, [=] {
+		if (const auto item = session->data().message(itemId)) {
+			MarkReadTill(item);
+		}
+	}, &st::menuIconMarkRead);
+}
+
+void AddGhostMenuToggle(not_null<Ui::VerticalLayout*> container) {
+	const auto button = Settings::AddButtonWithIcon(
+		container,
+		rpl::single(u"Ghost mode"_q),
+		st::mainMenuButton,
+		{ &st::menuIconStealth });
+	button->toggleOn(GhostValue());
+	button->toggledChanges(
+	) | rpl::filter([](bool enabled) {
+		return (enabled != Ghost());
+	}) | rpl::on_next([](bool enabled) {
+		SetGhost(enabled);
+	}, button->lifetime());
+}
+
+GhostOverride ChatGhostOverride(not_null<PeerData*> peer) {
+	const auto &overrides = Get().overrides;
+	if (overrides.empty()) {
+		return GhostOverride::Default;
+	}
+	const auto i = overrides.find(PeerKey(peer));
+	return (i != end(overrides)) ? i->second : GhostOverride::Default;
+}
+
+void SetChatGhostOverride(
+		not_null<PeerData*> peer,
+		GhostOverride mode) {
+	auto overrides = Get().overrides;
+	const auto key = PeerKey(peer);
+	if (mode == GhostOverride::Default) {
+		if (!overrides.remove(key)) {
+			return;
+		}
+	} else if (const auto i = overrides.find(key); i != end(overrides)) {
+		if (i->second == mode) {
+			return;
+		}
+		i->second = mode;
+	} else {
+		overrides.emplace(key, mode);
+	}
+	SetGhostChats(Serialize(overrides));
+}
+
+std::vector<GhostChat> GhostChats(not_null<Main::Session*> session) {
+	const auto test = session->isTestMode();
+	auto result = std::vector<GhostChat>();
+	for (const auto &[key, mode] : Get().overrides) {
+		if (((key & kTestBit) != 0) == test) {
+			result.push_back({ KeyPeer(key), mode });
+		}
+	}
+	return result;
+}
+
+rpl::producer<> GhostChatsChanges() {
+	return Get().changes.events();
+}
+
+rpl::producer<int> GhostChatsCountValue(not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		GhostChatsChanges()
+	) | rpl::map([=] {
+		return int(GhostChats(session).size());
+	});
+}
+
+void AddGhostChatAction(
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer || peer->isSelf()) {
+		return;
+	}
+	const auto now = ChatGhostOverride(peer);
+	addAction({
+		.text = u"Ghost mode in this chat"_q,
+		.handler = nullptr,
+		.icon = &st::menuIconStealth,
+		.fillSubmenu = [=](not_null<Ui::PopupMenu*> menu) {
+			const auto add = [&](const QString &text, GhostOverride value) {
+				menu->addAction(text, [=] {
+					SetChatGhostOverride(peer, value);
+				}, (now == value) ? &st::mediaPlayerMenuCheck : nullptr);
+			};
+			add(
+				(Ghost() ? u"Default (on)"_q : u"Default (off)"_q),
+				GhostOverride::Default);
+			add(u"Always ghost"_q, GhostOverride::Always);
+			add(u"Never ghost"_q, GhostOverride::Never);
+		},
+	});
+}
+
+} // namespace Tele
