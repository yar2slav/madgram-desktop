diff --git a/Telegram/SourceFiles/tele/tele_volumes.cpp b/Telegram/SourceFiles/tele/tele_volumes.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..07388a13dd7d8ca0d9e2122dcdc0a7e756921cba
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_volumes.cpp
@@ -0,0 +1,208 @@
+#include "tele/tele_volumes.h"
+
+#include "base/options.h"
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "data/data_audio_msg_id.h"
+#include "data/data_document.h"
+
+#include <atomic>
+#include <array>
+
+namespace Tele {
+namespace {
+
+constexpr auto kScale = 10000;
+
+base::options::option<int> VoiceVolume({
+	.id = kOptionVoiceVolume,
+	.name = "Voice messages",
+	.defaultValue = -1,
+});
+base::options::option<int> RoundVolume({
+	.id = kOptionRoundVolume,
+	.name = "Round videos",
+	.defaultValue = -1,
+});
+base::options::option<int> RememberedVideoVolume({
+	.id = kOptionRememberedVideoVolume,
+	.defaultValue = -1,
+});
+base::options::option<int> RememberedMusicVolume({
+	.id = kOptionRememberedMusicVolume,
+	.defaultValue = -1,
+});
+base::options::option<int> RememberedVoiceVolume({
+	.id = kOptionRememberedVoiceVolume,
+	.defaultValue = -1,
+});
+base::options::option<int> RememberedRoundVolume({
+	.id = kOptionRememberedRoundVolume,
+	.defaultValue = -1,
+});
+
+struct VolumeState {
+	std::array<std::atomic<int>, 4> cached{};
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+	bool initialized = false;
+	bool migrating = false;
+};
+
+VolumeState &State() {
+	static auto result = VolumeState();
+	return result;
+}
+
+int Encode(double volume) {
+	return int(base::SafeRound(std::clamp(volume, 0., 1.) * kScale));
+}
+
+double Decode(int volume) {
+	return std::clamp(volume, 0, kScale) / double(kScale);
+}
+
+void Migrate() {
+	auto &state = State();
+	if (state.migrating) {
+		return;
+	}
+	state.migrating = true;
+	const auto &settings = Core::App().settings();
+	const auto song = Encode(settings.songVolume());
+	const auto rememberedSong = Encode(settings.rememberedSongVolume());
+	const auto migrate = [](auto &option, int fallback) {
+		if (option.value() < 0) {
+			option.set(fallback);
+		}
+	};
+	migrate(VoiceVolume, song);
+	migrate(RoundVolume, song);
+	migrate(RememberedVideoVolume, settings.videoVolume() > 0.
+		? Encode(settings.videoVolume())
+		: Encode(Core::Settings::kDefaultVolume));
+	migrate(RememberedMusicVolume, song > 0 ? song : rememberedSong);
+	migrate(RememberedVoiceVolume, VoiceVolume.value() > 0
+		? VoiceVolume.value() : rememberedSong);
+	migrate(RememberedRoundVolume, RoundVolume.value() > 0
+		? RoundVolume.value() : rememberedSong);
+	state.migrating = false;
+}
+
+void RefreshCache() {
+	auto &settings = Core::App().settings();
+	const auto values = std::array{
+		Encode(settings.songVolume()),
+		Encode(settings.videoVolume()),
+		std::clamp(VoiceVolume.value(), 0, kScale),
+		std::clamp(RoundVolume.value(), 0, kScale),
+	};
+	const auto memories = std::array{
+		&RememberedMusicVolume,
+		&RememberedVideoVolume,
+		&RememberedVoiceVolume,
+		&RememberedRoundVolume,
+	};
+	for (auto i = 0; i != values.size(); ++i) {
+		State().cached[i].store(values[i], std::memory_order_relaxed);
+		if (values[i] > 0 && memories[i]->value() != values[i]) {
+			memories[i]->set(values[i]);
+		}
+	}
+	if (values[0] > 0) {
+		settings.setRememberedSongVolume(Decode(values[0]));
+	}
+}
+
+double Remembered(PlaybackCategory category) {
+	const auto value = [&] {
+		switch (category) {
+		case PlaybackCategory::Music:
+			return Decode(RememberedMusicVolume.value());
+		case PlaybackCategory::Video: return Decode(RememberedVideoVolume.value());
+		case PlaybackCategory::Voice: return Decode(RememberedVoiceVolume.value());
+		case PlaybackCategory::Round: return Decode(RememberedRoundVolume.value());
+		}
+		Unexpected("Playback category.");
+	}();
+	return (value > 0.) ? value : Core::Settings::kDefaultVolume;
+}
+} // namespace
+
+PlaybackCategory PlaybackCategoryFor(const DocumentData *document) {
+	return document && document->isVideoMessage() ? PlaybackCategory::Round
+		: document && document->isVoiceMessage() ? PlaybackCategory::Voice
+		: document && document->isAudioFile() ? PlaybackCategory::Music
+		: PlaybackCategory::Video;
+}
+
+PlaybackCategory PlaybackCategoryFor(const AudioMsgId &audio) {
+	if (audio.audio()) {
+		return PlaybackCategoryFor(audio.audio());
+	}
+	return (audio.type() == AudioMsgId::Type::Song) ? PlaybackCategory::Music
+		: (audio.type() == AudioMsgId::Type::Voice) ? PlaybackCategory::Voice
+		: PlaybackCategory::Video;
+}
+
+void InitializePlaybackVolumes() {
+	auto &state = State();
+	if (state.initialized) {
+		return;
+	}
+	state.initialized = true;
+	Migrate();
+	RefreshCache();
+	rpl::merge(
+		Core::App().settings().songVolumeChanges() | rpl::to_empty,
+		Core::App().settings().videoVolumeChanges() | rpl::to_empty,
+		VoiceVolume.changes(),
+		RoundVolume.changes()
+	) | rpl::on_next([] {
+		if (State().migrating) {
+			return;
+		}
+		Migrate();
+		RefreshCache();
+		State().changes.fire({});
+	}, state.lifetime);
+}
+
+double AudioPlaybackVolume(PlaybackCategory category) {
+	return Decode(State().cached[int(category)].load(std::memory_order_relaxed));
+}
+
+double PlaybackVolume(PlaybackCategory category) {
+	InitializePlaybackVolumes();
+	return AudioPlaybackVolume(category);
+}
+
+void SetPlaybackVolume(PlaybackCategory category, double volume) {
+	InitializePlaybackVolumes();
+	volume = Decode(Encode(volume));
+	auto &settings = Core::App().settings();
+	switch (category) {
+	case PlaybackCategory::Music: settings.setSongVolume(volume); break;
+	case PlaybackCategory::Video: settings.setVideoVolume(volume); break;
+	case PlaybackCategory::Voice: VoiceVolume.set(Encode(volume)); break;
+	case PlaybackCategory::Round: RoundVolume.set(Encode(volume)); break;
+	}
+	Core::App().saveSettingsDelayed();
+}
+
+void TogglePlaybackVolume(PlaybackCategory category) {
+	SetPlaybackVolume(category, PlaybackVolume(category) > 0. ? 0. : Remembered(category));
+}
+
+rpl::producer<> PlaybackVolumeChanges() {
+	InitializePlaybackVolumes();
+	return State().changes.events();
+}
+
+rpl::producer<double> PlaybackVolumeValue(PlaybackCategory category) {
+	return rpl::single(PlaybackVolume(category)) | rpl::then(
+		PlaybackVolumeChanges() | rpl::map([=] { return PlaybackVolume(category); })
+	) | rpl::distinct_until_changed();
+}
+
+} // namespace Tele
