+#pragma once
+
+#include <rpl/rpl.h>
+
+class AudioMsgId;
+class DocumentData;
+
+namespace Tele {
+
+enum class PlaybackCategory {
+	Music,
+	Video,
+	Voice,
+	Round,
+};
+
+inline constexpr auto kOptionVoiceVolume = "tele-voice-volume";
+inline constexpr auto kOptionRememberedMusicVolume = "tele-remembered-music-volume";
+inline constexpr auto kOptionRoundVolume = "tele-round-volume";
+inline constexpr auto kOptionRememberedVideoVolume = "tele-remembered-video-volume";
+inline constexpr auto kOptionRememberedVoiceVolume = "tele-remembered-voice-volume";
+inline constexpr auto kOptionRememberedRoundVolume = "tele-remembered-round-volume";
+
+// Document identity takes precedence over the playback channel (round videos use Voice).
+[[nodiscard]] PlaybackCategory PlaybackCategoryFor(const DocumentData *document);
+[[nodiscard]] PlaybackCategory PlaybackCategoryFor(const AudioMsgId &audio);
+
+// Main thread, after application settings have been read.
+void InitializePlaybackVolumes();
+[[nodiscard]] double PlaybackVolume(PlaybackCategory category);
+void SetPlaybackVolume(PlaybackCategory category, double volume);
+void TogglePlaybackVolume(PlaybackCategory category);
+[[nodiscard]] rpl::producer<> PlaybackVolumeChanges();
+[[nodiscard]] rpl::producer<double> PlaybackVolumeValue(PlaybackCategory category);
+
+// Audio threads: lock-free cache, initialized before playback starts.
+[[nodiscard]] double AudioPlaybackVolume(PlaybackCategory category);
+
+} // namespace Tele
