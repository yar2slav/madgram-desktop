+
+class ComposeRegexSearch::Impl final {
+public:
+	explicit Impl(ComposeRegexDescriptor &&descriptor);
+
+	[[nodiscard]] bool active() const;
+	void setTopMsgId(MsgId topMsgId);
+	void setPinnedOnly(bool pinnedOnly);
+	[[nodiscard]] auto serverRequests() const
+	-> rpl::producer<Api::MessagesSearch::Request>;
+
+private:
+	void toggle();
+	void search();
+	void refresh();
+	void show(int index);
+	void navigate(int delta);
+	void loadOlder();
+	void updateControls();
+	void updateGeometry();
+	[[nodiscard]] int currentIndex() const;
+	[[nodiscard]] bool canLoadOlder() const;
+	[[nodiscard]] bool handleKey(not_null<QKeyEvent*> e);
+
+	const not_null<Ui::RpWidget*> _bar;
+	const not_null<Ui::RpWidget*> _field;
+	const not_null<History*> _history;
+	const Fn<void(not_null<HistoryItem*>, QString)> _activate;
+	const base::unique_qptr<Ui::RpWidget> _overlay;
+	const not_null<Ui::FlatLabel*> _counter;
+	const not_null<Ui::LinkButton*> _load;
+	const not_null<Ui::IconButton*> _newer;
+	const not_null<Ui::IconButton*> _older;
+	const base::unique_qptr<RegexToggle> _toggle;
+
+	Scope _scope;
+	Api::MessagesSearch::Request _request;
+	std::unique_ptr<Engine> _engine;
+	rpl::lifetime _engineLifetime;
+	FullMsgId _current;
+	bool _checked = false;
+	bool _pendingOlder = false;
+	rpl::event_stream<Api::MessagesSearch::Request> _serverRequests;
+	rpl::lifetime _lifetime;
+
+};
+
+ComposeRegexSearch::Impl::Impl(ComposeRegexDescriptor &&descriptor)
+: _bar(descriptor.bar)
+, _field(descriptor.field)
+, _history(descriptor.history)
+, _activate(std::move(descriptor.activate))
+, _overlay(base::make_unique_q<Ui::RpWidget>(_bar))
+, _counter(Ui::CreateChild<Ui::FlatLabel>(
+	_overlay.get(),
+	st::defaultSettingsRightLabel))
+, _load(Ui::CreateChild<Ui::LinkButton>(
+	_overlay.get(),
+	Lower(u"Load older"_q)))
+, _newer(Ui::CreateChild<Ui::IconButton>(_overlay.get(), st::calendarNext))
+, _older(Ui::CreateChild<Ui::IconButton>(
+	_overlay.get(),
+	st::calendarPrevious))
+, _toggle(base::make_unique_q<RegexToggle>(
+	_bar,
+	QSize(st::dialogsCalendar.width, st::dialogsCalendar.height))) {
+	_request.query = descriptor.query;
+
+	_overlay->hide();
+	_counter->setAttribute(Qt::WA_TransparentForMouseEvents);
+	_overlay->paintRequest(
+	) | rpl::on_next([=](const QRect &r) {
+		QPainter(_overlay.get()).fillRect(r, st::dialogsBg);
+	}, _overlay->lifetime());
+
+	_toggle->show();
+	_toggle->setClickedCallback([=] { toggle(); });
+	_load->setClickedCallback([=] { loadOlder(); });
+	_newer->setClickedCallback([=] { navigate(-1); });
+	_older->setClickedCallback([=] { navigate(1); });
+
+	_bar->sizeValue(
+	) | rpl::on_next([=] {
+		updateGeometry();
+	}, _lifetime);
+
+	std::move(
+		descriptor.requests
+	) | rpl::on_next([=](Api::MessagesSearch::Request request) {
+		_request = request;
+		if (_scope.from != request.from) {
+			_scope.from = request.from;
+		}
+		if (_checked) {
+			search();
+		}
+	}, _lifetime);
+
+	base::install_event_filter(
+		_overlay.get(),
+		QCoreApplication::instance(),
+		[=](not_null<QEvent*> e) {
+			return (e->type() == QEvent::KeyPress
+				&& handleKey(static_cast<QKeyEvent*>(e.get())))
+				? base::EventFilterResult::Cancel
+				: base::EventFilterResult::Continue;
+		});
+}
+
+bool ComposeRegexSearch::Impl::active() const {
+	return _checked;
+}
+
+void ComposeRegexSearch::Impl::setTopMsgId(MsgId topMsgId) {
+	_scope.topicRootId = topMsgId;
+	if (_checked) {
+		search();
+	}
+}
+
+void ComposeRegexSearch::Impl::setPinnedOnly(bool pinnedOnly) {
+	_scope.pinnedOnly = pinnedOnly;
+	if (_checked) {
+		search();
+	}
+}
+
+auto ComposeRegexSearch::Impl::serverRequests() const
+-> rpl::producer<Api::MessagesSearch::Request> {
+	return _serverRequests.events();
+}
+
+void ComposeRegexSearch::Impl::toggle() {
+	_checked = !_checked;
+	_toggle->setChecked(_checked);
+	if (_checked) {
+		_engine = std::make_unique<Engine>(_history);
+		_engine->updates() | rpl::on_next([=] {
+			refresh();
+		}, _engineLifetime);
+		_overlay->show();
+		_toggle->raise();
+		search();
+	} else {
+		_engineLifetime.destroy();
+		_engine = nullptr;
+		_current = FullMsgId();
+		_pendingOlder = false;
+		_toggle->setError(false);
+		_overlay->hide();
+		_serverRequests.fire_copy(_request);
+	}
+}
+
+void ComposeRegexSearch::Impl::search() {
+	_engine->setScope(_scope);
+	_engine->setPattern(_request.query);
+	_current = FullMsgId();
+	_pendingOlder = false;
+	if (!_engine->hits().empty()) {
+		show(0);
+	} else {
+		updateControls();
+	}
+}
+
+void ComposeRegexSearch::Impl::refresh() {
+	const auto index = currentIndex();
+	if (index < 0) {
+		_current = FullMsgId();
+	}
+	if (_pendingOlder) {
+		const auto next = index + 1;
+		if (next < int(_engine->hits().size())) {
+			_pendingOlder = false;
+			show(next);
+			return;
+		} else if (!_engine->loading()) {
+			_pendingOlder = false;
+		}
+	}
+	updateControls();
+}
+
+void ComposeRegexSearch::Impl::show(int index) {
+	const auto &hit = _engine->hits()[index];
+	_current = hit.id;
+	const auto quote = hit.quote;
+	updateControls();
+	if (const auto item = _history->owner().message(_current)) {
+		_activate(item, quote);
+	}
+}
+
+void ComposeRegexSearch::Impl::navigate(int delta) {
+	if (!_engine) {
+		return;
+	}
+	const auto index = currentIndex();
+	const auto size = int(_engine->hits().size());
+	if (delta < 0) {
+		if (index > 0) {
+			show(index - 1);
+		}
+	} else if (index + 1 < size) {
+		show(index + 1);
+	} else if (canLoadOlder()) {
+		_pendingOlder = true;
+		loadOlder();
+	}
+}
+
+void ComposeRegexSearch::Impl::loadOlder() {
+	if (!canLoadOlder()) {
+		return;
+	}
+	_engine->loadOlder();
+	updateControls();
+}
+
+int ComposeRegexSearch::Impl::currentIndex() const {
+	return (_engine && _current) ? _engine->indexOf(_current) : -1;
+}
+
+bool ComposeRegexSearch::Impl::canLoadOlder() const {
+	return _engine
+		&& !_engine->empty()
+		&& _engine->valid()
+		&& !_engine->loading()
+		&& !_engine->loadedAll();
+}
+
+void ComposeRegexSearch::Impl::updateControls() {
+	if (!_engine) {
+		return;
+	}
+	const auto invalid = !_engine->valid();
+	const auto size = int(_engine->hits().size());
+	const auto index = currentIndex();
+	_toggle->setError(invalid);
+	_counter->setTextColorOverride(invalid
+		? std::make_optional(st::boxTextFgError->c)
+		: std::nullopt);
+	_counter->setText(invalid
+		? Lower(u"Invalid regular expression"_q)
+		: _engine->empty()
+		? QString()
+		: !size
+		? tr::lng_search_messages_none(tr::now)
+		: (index >= 0)
+		? tr::lng_search_messages_n_of_amount(
+			tr::now,
+			lt_n,
+			QString::number(index + 1),
+			lt_amount,
+			QString::number(size))
+		: Lower(u"%1 found"_q.arg(size)));
+
+	const auto loading = _engine->loading();
+	_load->setText(Lower(loading ? u"Loading..."_q : u"Load older"_q));
+	_load->setVisible(loading || canLoadOlder());
+
+	const auto newerDisabled = (index <= 0);
+	const auto olderDisabled = (index + 1 >= size) && !canLoadOlder();
+	_newer->setAttribute(Qt::WA_TransparentForMouseEvents, newerDisabled);
+	_older->setAttribute(Qt::WA_TransparentForMouseEvents, olderDisabled);
+	_newer->setIconOverride(newerDisabled
+		? &st::calendarNextDisabled
+		: nullptr);
+	_older->setIconOverride(olderDisabled
+		? &st::calendarPreviousDisabled
+		: nullptr);
+	updateGeometry();
+}
+
+void ComposeRegexSearch::Impl::updateGeometry() {
+	const auto size = _bar->size();
+	const auto height = size.height();
+	_overlay->setGeometry(QRect(QPoint(), size));
+	_newer->moveToRight(0, (height - _newer->height()) / 2);
+	_older->moveToRight(
+		_newer->width(),
+		(height - _older->height()) / 2);
+	const auto arrows = _newer->width() + _older->width();
+	_toggle->moveToRight(arrows, (height - _toggle->height()) / 2);
+	_load->moveToRight(
+		arrows + _toggle->width() + st::topBarActionSkip,
+		(height - _load->height()) / 2);
+	_counter->moveToLeft(
+		st::topBarActionSkip,
+		(height - _counter->height()) / 2);
+}
+
+bool ComposeRegexSearch::Impl::handleKey(not_null<QKeyEvent*> e) {
+	if (!_checked
+		|| (!Ui::InFocusChain(_field) && !Ui::InFocusChain(_bar))) {
+		return false;
+	}
+	const auto modifiers = e->modifiers() & ~Qt::KeypadModifier;
+	const auto key = e->key();
+	const auto plain = (modifiers == Qt::NoModifier);
+	if ((key == Qt::Key_Up && plain) || (key == Qt::Key_F3 && plain)) {
+		navigate(1);
+		return true;
+	} else if ((key == Qt::Key_Down && plain)
+		|| (key == Qt::Key_F3 && modifiers == Qt::ShiftModifier)) {
+		navigate(-1);
+		return true;
+	}
+	return false;
+}
+
+ComposeRegexSearch::ComposeRegexSearch(
+	ComposeRegexDescriptor &&descriptor)
+: _impl(RegexSearchInChats()
+	? std::make_unique<Impl>(std::move(descriptor))
+	: nullptr) {
+}
+
+ComposeRegexSearch::~ComposeRegexSearch() = default;
+
+bool ComposeRegexSearch::active() const {
+	return _impl && _impl->active();
+}
+
+void ComposeRegexSearch::setTopMsgId(MsgId topMsgId) {
+	if (_impl) {
+		_impl->setTopMsgId(topMsgId);
+	}
+}
+
+void ComposeRegexSearch::setPinnedOnly(bool pinnedOnly) {
+	if (_impl) {
+		_impl->setPinnedOnly(pinnedOnly);
+	}
+}
+
+auto ComposeRegexSearch::serverRequests() const
+-> rpl::producer<Api::MessagesSearch::Request> {
+	using Request = Api::MessagesSearch::Request;
+	return _impl ? _impl->serverRequests() : rpl::never<Request>();
+}
