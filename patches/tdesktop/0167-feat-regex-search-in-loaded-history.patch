+class DialogsRegex final {
+public:
+	explicit DialogsRegex(DialogsRegexDescriptor &&descriptor);
+	~DialogsRegex();
+
+	void setState(const Dialogs::SearchState &state);
+	[[nodiscard]] bool search(const Dialogs::SearchState &state);
+	[[nodiscard]] bool searchMore();
+	[[nodiscard]] QWidget *bottom() const;
+	[[nodiscard]] QString quote(FullMsgId id, const QString &query) const;
+
+private:
+	[[nodiscard]] bool eligible() const;
+	[[nodiscard]] bool active() const;
+	void toggle();
+	void refresh();
+	void apply();
+	void loadOlder();
+	void updateToggle();
+	void updateGeometry();
+	void updateMargins();
+	void updateBottom();
+
+	const not_null<QWidget*> _widget;
+	const not_null<Ui::InputField*> _field;
+	const not_null<Ui::FadeWrapScaled<Ui::IconButton>*> _from;
+	const not_null<Ui::FadeWrapScaled<Ui::IconButton>*> _date;
+	const Fn<void(std::vector<not_null<HistoryItem*>>, int)> _apply;
+	const Fn<void()> _rerun;
+	const Fn<void()> _relayout;
+	const base::unique_qptr<RegexToggle> _toggle;
+	const base::unique_qptr<Ui::FlatButton> _bottom;
+
+	History *_history = nullptr;
+	Scope _scope;
+	QString _query;
+	bool _stateEligible = false;
+	bool _checked = false;
+	bool _toggleShown = false;
+	bool _fromShown = false;
+	bool _marginsOverridden = false;
+	std::optional<QMargins> _appliedMargins;
+	bool _bottomShown = false;
+	bool _autoLoad = false;
+	bool _loadRequested = false;
+	int _hitsBeforeLoad = 0;
+	std::unique_ptr<Engine> _engine;
+	rpl::lifetime _engineLifetime;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] base::flat_map<not_null<QWidget*>, DialogsRegex*> &Registry() {
+	static auto result = base::flat_map<not_null<QWidget*>, DialogsRegex*>();
+	return result;
+}
+
+[[nodiscard]] DialogsRegex *Lookup(not_null<QWidget*> widget) {
+	const auto &registry = Registry();
+	const auto i = registry.find(widget);
+	return (i != end(registry)) ? i->second : nullptr;
+}
+
+DialogsRegex::DialogsRegex(DialogsRegexDescriptor &&descriptor)
+: _widget(descriptor.widget)
+, _field(descriptor.field)
+, _from(descriptor.from)
+, _date(descriptor.date)
+, _apply(std::move(descriptor.apply))
+, _rerun(std::move(descriptor.rerun))
+, _relayout(std::move(descriptor.relayout))
+, _toggle(base::make_unique_q<RegexToggle>(
+	_field->parentWidget(),
+	QSize(st::dialogsCalendar.width, st::dialogsCalendar.height)))
+, _bottom(base::make_unique_q<Ui::FlatButton>(
+	_widget,
+	QString(),
+	st::dialogsLoadMoreButton)) {
+	Registry().emplace(_widget, this);
+
+	_toggle->hide();
+	_toggle->setClickedCallback([=] { toggle(); });
+	_bottom->hide();
+	_bottom->setClickedCallback([=] { loadOlder(); });
+
+	rpl::merge(
+		_from->geometryValue() | rpl::to_empty,
+		_from->toggledValue() | rpl::to_empty,
+		_date->geometryValue() | rpl::to_empty,
+		_date->toggledValue() | rpl::to_empty
+	) | rpl::on_next([=] {
+		updateGeometry();
+	}, _lifetime);
+
+	RegexSearchInChatsValue(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		const auto wasActive = active();
+		if (!RegexSearchInChats()) {
+			_checked = false;
+			_engine = nullptr;
+			_engineLifetime.destroy();
+		}
+		updateToggle();
+		updateBottom();
+		if (wasActive != active()) {
+			_rerun();
+		}
+	}, _lifetime);
+}
+
+DialogsRegex::~DialogsRegex() {
+	Registry().remove(_widget);
+}
+
+bool DialogsRegex::eligible() const {
+	return _stateEligible && RegexSearchInChats();
+}
+
+bool DialogsRegex::active() const {
+	return _checked && eligible() && !_query.isEmpty();
+}
+
+void DialogsRegex::setState(const Dialogs::SearchState &state) {
+	using Tab = Dialogs::ChatSearchTab;
+	if (_fromShown != _from->toggled()) {
+		_fromShown = _from->toggled();
+		_marginsOverridden = true;
+	}
+	const auto history = state.inChat.owningHistory();
+	_stateEligible = history
+		&& state.tags.empty()
+		&& ((state.tab == Tab::ThisPeer) || (state.tab == Tab::ThisTopic));
+	if (_history != history) {
+		_history = history;
+		_engine = nullptr;
+		_engineLifetime.destroy();
+	}
+	const auto topic = state.inChat.topic();
+	const auto sublist = state.inChat.sublist();
+	_scope = Scope{
+		.topicRootId = topic ? topic->rootId() : MsgId(),
+		.from = (sublist
+			? sublist->sublistPeer().get()
+			: state.fromPeer),
+	};
+	_query = state.query;
+	updateToggle();
+	if (_marginsOverridden) {
+		updateGeometry();
+	}
+	updateBottom();
+}
+
+bool DialogsRegex::search(const Dialogs::SearchState &state) {
+	setState(state);
+	if (!active()) {
+		return false;
+	}
+	if (!_engine) {
+		_engine = std::make_unique<Engine>(not_null(_history));
+		_engine->updates() | rpl::on_next([=] {
+			refresh();
+		}, _engineLifetime);
+	}
+	_engine->setScope(_scope);
+	_engine->setPattern(_query);
+	_autoLoad = false;
+	_loadRequested = false;
+	apply();
+	updateBottom();
+	return true;
+}
+
+bool DialogsRegex::searchMore() {
+	if (!active()) {
+		return false;
+	} else if (_autoLoad && _engine && !_engine->loading()) {
+		_autoLoad = false;
+		loadOlder();
+	}
+	return true;
+}
+
+QWidget *DialogsRegex::bottom() const {
+	return _bottom.get();
+}
+
+QString DialogsRegex::quote(FullMsgId id, const QString &query) const {
+	if (!active() || !_engine) {
+		return query;
+	}
+	const auto index = _engine->indexOf(id);
+	return (index >= 0) ? _engine->hits()[index].quote : query;
+}
+
+void DialogsRegex::toggle() {
+	_checked = !_checked;
+	if (!_checked) {
+		_engine = nullptr;
+		_engineLifetime.destroy();
+	}
+	updateToggle();
+	updateBottom();
+	_rerun();
+}
+
+void DialogsRegex::refresh() {
+	if (!active() || !_engine) {
+		return;
+	}
+	if (_loadRequested && !_engine->loading()) {
+		_loadRequested = false;
+		_autoLoad = (int(_engine->hits().size()) > _hitsBeforeLoad);
+	}
+	apply();
+	updateBottom();
+}
+
+void DialogsRegex::apply() {
+	auto items = std::vector<not_null<HistoryItem*>>();
+	const auto &owner = _history->owner();
+	for (const auto &hit : _engine->hits()) {
+		if (const auto item = owner.message(hit.id)) {
+			items.push_back(item);
+		}
+	}
+	const auto count = int(items.size());
+	_toggle->setError(!_engine->valid());
+	_apply(std::move(items), count);
+}
+
+void DialogsRegex::loadOlder() {
+	if (!_engine || _engine->loading()) {
+		return;
+	}
+	_hitsBeforeLoad = int(_engine->hits().size());
+	_loadRequested = true;
+	_engine->loadOlder();
+	updateBottom();
+}
+
+void DialogsRegex::updateToggle() {
+	const auto shown = eligible();
+	_toggle->setChecked(_checked);
+	_toggle->setError(active() && _engine && !_engine->valid());
+	if (_toggleShown != shown) {
+		_toggleShown = shown;
+		_toggle->setVisible(shown);
+		updateGeometry();
+	}
+}
+
+void DialogsRegex::updateGeometry() {
+	const auto right = _from->toggled()
+		? _from->x()
+		: _date->toggled()
+		? _date->x()
+		: (_date->x() + _date->width());
+	_toggle->move(
+		right - _toggle->width(),
+		_field->y() + (_field->height() - _toggle->height()) / 2);
+	updateMargins();
+}
+
+void DialogsRegex::updateMargins() {
+	if (!_toggleShown && !_appliedMargins) {
+		return;
+	}
+	auto margins = QMargins();
+	if (_toggleShown) {
+		const auto right = _field->x() + _field->width() - _toggle->x();
+		margins.setRight(
+			std::max(right - _field->st().textMargins.right(), 0));
+	} else if (_from->toggled()) {
+		margins.setRight(_from->width());
+	}
+	const auto applied = _toggleShown
+		? std::make_optional(margins)
+		: std::nullopt;
+	if (!_marginsOverridden && _appliedMargins == applied) {
+		return;
+	}
+	_marginsOverridden = false;
+	_appliedMargins = applied;
+	_field->setAdditionalMargins(margins);
+}
+
+void DialogsRegex::updateBottom() {
+	const auto shown = active()
+		&& _engine
+		&& !_engine->empty()
+		&& (!_engine->valid() || !_engine->loadedAll());
+	if (shown) {
+		const auto invalid = !_engine->valid();
+		const auto loading = _engine->loading();
+		_bottom->setText(Lower(invalid
+			? u"Invalid regular expression"_q
+			: loading
+			? u"Loading..."_q
+			: u"Load older messages"_q));
+		_bottom->setDisabled(invalid || loading);
+	}
+	if (_bottomShown != shown) {
+		_bottomShown = shown;
+		_bottom->setVisible(shown);
+		_relayout();
+	}
+}
+
+} // namespace
+
