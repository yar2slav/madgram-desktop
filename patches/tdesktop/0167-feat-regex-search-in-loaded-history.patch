+class RegexToggle final : public Ui::AbstractButton {
+public:
+	RegexToggle(QWidget *parent, QSize size);
+
+	void setChecked(bool checked);
+	void setError(bool error);
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+	void onStateChanged(State was, StateChangeSource source) override;
+
+private:
+	bool _checked = false;
+	bool _error = false;
+
+};
+
+RegexToggle::RegexToggle(QWidget *parent, QSize size)
+: AbstractButton(parent) {
+	resize(size);
+	setCursor(style::cur_pointer);
+}
+
+void RegexToggle::setChecked(bool checked) {
+	if (_checked != checked) {
+		_checked = checked;
+		update();
+	}
+}
+
+void RegexToggle::setError(bool error) {
+	if (_error != error) {
+		_error = error;
+		update();
+	}
+}
+
+void RegexToggle::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto &font = st::semiboldFont;
+	const auto text = u".*"_q;
+	if (_checked) {
+		auto hq = PainterHighQualityEnabler(p);
+		const auto w = font->width(text) + 2 * font->spacew + 4;
+		const auto h = font->height + 4;
+		const auto rect = QRect(
+			(width() - w) / 2,
+			(height() - h) / 2,
+			w,
+			h);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::lightButtonBgOver);
+		p.drawRoundedRect(rect, h / 3., h / 3.);
+	}
+	p.setFont(font);
+	p.setPen(_error
+		? st::attentionButtonFg
+		: _checked
+		? st::lightButtonFg
+		: isOver()
+		? st::dialogsMenuIconFgOver
+		: st::dialogsMenuIconFg);
+	p.drawText(rect(), text, style::al_center);
+}
+
+void RegexToggle::onStateChanged(State was, StateChangeSource source) {
+	update();
+}
