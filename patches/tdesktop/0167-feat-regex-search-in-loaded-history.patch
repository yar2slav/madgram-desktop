+namespace Tele {
+namespace {
+
+constexpr auto kLoadPages = 4;
+constexpr auto kLoadTimeout = 15 * crl::time(1000);
+constexpr auto kSliceLimit = (1 << 30);
+
+struct Hit {
+	FullMsgId id;
+	QString quote;
+};
+
+struct Scope {
+	MsgId topicRootId = 0;
+	PeerData *from = nullptr;
+	bool pinnedOnly = false;
+
+	friend inline bool operator==(const Scope &, const Scope &) = default;
+};
+
+class Engine final : public base::has_weak_ptr {
+public:
+	explicit Engine(not_null<History*> history);
+
+	[[nodiscard]] not_null<History*> history() const;
+	void setScope(Scope scope);
+	void setPattern(const QString &pattern);
+	void loadOlder();
+
+	[[nodiscard]] bool empty() const;
+	[[nodiscard]] bool valid() const;
+	[[nodiscard]] bool loading() const;
+	[[nodiscard]] bool loadedAll() const;
+	[[nodiscard]] const std::vector<Hit> &hits() const;
+	[[nodiscard]] int indexOf(FullMsgId id) const;
+	[[nodiscard]] rpl::producer<> updates() const;
+
+private:
+	[[nodiscard]] Storage::SparseIdsListResult bottomSlice() const;
+	[[nodiscard]] MsgId bottomMinId() const;
+	[[nodiscard]] bool inScope(not_null<HistoryItem*> item) const;
+	void rescan();
+	void sliceUpdated();
+	void requestPage();
+	void finishLoading();
+
+	const not_null<History*> _history;
+	Scope _scope;
+	QString _pattern;
+	QRegularExpression _regex;
+	bool _valid = true;
+	std::vector<Hit> _hits;
+	int _pages = 0;
+	MsgId _requestedBefore = 0;
+	base::Timer _timeout;
+	rpl::event_stream<> _updates;
+	rpl::lifetime _lifetime;
+
+};
+
+Engine::Engine(not_null<History*> history)
+: _history(history)
+, _timeout([=] { finishLoading(); }) {
+	_history->messages().sliceUpdated(
+	) | rpl::on_next([=] {
+		sliceUpdated();
+	}, _lifetime);
+
+	_history->owner().itemRemoved(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		crl::on_main(this, [=] {
+			rescan();
+			_updates.fire({});
+		});
+	}, _lifetime);
+}
+
+not_null<History*> Engine::history() const {
+	return _history;
+}
+
+void Engine::setScope(Scope scope) {
+	if (_scope == scope) {
+		return;
+	}
+	_scope = scope;
+	rescan();
+}
+
+void Engine::setPattern(const QString &pattern) {
+	_pattern = pattern;
+	_regex = QRegularExpression(
+		pattern,
+		(QRegularExpression::CaseInsensitiveOption
+			| QRegularExpression::UseUnicodePropertiesOption));
+	_valid = pattern.isEmpty() || _regex.isValid();
+	if (_valid && !pattern.isEmpty()) {
+		_regex.optimize();
+	}
+	rescan();
+}
+
+void Engine::loadOlder() {
+	if (loading() || loadedAll() || !_valid) {
+		return;
+	}
+	_pages = kLoadPages;
+	requestPage();
+}
+
+bool Engine::empty() const {
+	return _pattern.isEmpty();
+}
+
+bool Engine::valid() const {
+	return _valid;
+}
+
+bool Engine::loading() const {
+	return (_pages > 0);
+}
+
+bool Engine::loadedAll() const {
+	const auto slice = bottomSlice();
+	return slice.skippedBefore && !*slice.skippedBefore;
+}
+
+const std::vector<Hit> &Engine::hits() const {
+	return _hits;
+}
+
+int Engine::indexOf(FullMsgId id) const {
+	const auto i = ranges::find(_hits, id, &Hit::id);
+	return (i != end(_hits)) ? int(i - begin(_hits)) : -1;
+}
+
+rpl::producer<> Engine::updates() const {
+	return _updates.events();
+}
+
+Storage::SparseIdsListResult Engine::bottomSlice() const {
+	return _history->messages().snapshot({
+		ServerMaxMsgId - 1,
+		kSliceLimit,
+		0,
+	});
+}
+
+MsgId Engine::bottomMinId() const {
+	const auto slice = bottomSlice();
+	return slice.messageIds.empty() ? MsgId() : slice.messageIds.front();
+}
+
+bool Engine::inScope(not_null<HistoryItem*> item) const {
+	if (_scope.topicRootId && !item->inThread(_scope.topicRootId)) {
+		return false;
+	} else if (_scope.pinnedOnly && !item->isPinned()) {
+		return false;
+	} else if (const auto from = _scope.from) {
+		const auto sublist = item->sublistPeerId();
+		if (sublist ? (sublist != from->id) : (item->from() != from)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void Engine::rescan() {
+	_hits.clear();
+	if (_pattern.isEmpty() || !_valid) {
+		return;
+	}
+	auto ids = std::vector<MsgId>();
+	for (const auto &block : _history->blocks) {
+		for (const auto &view : block->messages) {
+			const auto item = view->data();
+			if (item->isRegular()) {
+				ids.push_back(item->id);
+			}
+		}
+	}
+	const auto slice = bottomSlice();
+	ids.insert(end(ids), begin(slice.messageIds), end(slice.messageIds));
+	ranges::sort(ids, ranges::greater());
+	ids.erase(ranges::unique(ids), end(ids));
+
+	const auto &owner = _history->owner();
+	const auto peerId = _history->peer->id;
+	for (const auto id : ids) {
+		const auto item = owner.message(peerId, id);
+		if (!item || item->isService() || !inScope(item)) {
+			continue;
+		}
+		const auto &text = item->originalText().text;
+		if (text.isEmpty()) {
+			continue;
+		}
+		const auto match = _regex.match(text);
+		if (match.hasMatch()) {
+			_hits.push_back({ item->fullId(), match.captured(0) });
+		}
+	}
+}
+
+void Engine::sliceUpdated() {
+	rescan();
+	if (_pages > 0) {
+		const auto min = bottomMinId();
+		if (loadedAll()) {
+			finishLoading();
+			return;
+		} else if (min && min < _requestedBefore) {
+			if (--_pages > 0) {
+				requestPage();
+			} else {
+				finishLoading();
+				return;
+			}
+		}
+	}
+	_updates.fire({});
+}
+
+void Engine::requestPage() {
+	const auto min = bottomMinId();
+	_requestedBefore = min ? min : (ServerMaxMsgId - 1);
+	_timeout.callOnce(kLoadTimeout);
+	_history->session().api().requestHistory(
+		_history,
+		_requestedBefore,
+		Data::LoadDirection::Before);
+}
+
+void Engine::finishLoading() {
+	_pages = 0;
+	_timeout.cancel();
+	_updates.fire({});
+}
