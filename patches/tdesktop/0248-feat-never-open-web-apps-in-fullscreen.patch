diff --git a/Telegram/SourceFiles/tele/tele_links.cpp b/Telegram/SourceFiles/tele/tele_links.cpp
index 572ea9585e80181913cd25ef1e0b49c6693a3ece..3727df8f13189297ef19bddc8b78adfddade2fed 100644
--- a/Telegram/SourceFiles/tele/tele_links.cpp
+++ b/Telegram/SourceFiles/tele/tele_links.cpp
@@ -497,6 +497,24 @@ QString PrepareOpenedLink(const QString &url) {
 	return (CleanOpenedLinks() && !SkipCleaning) ? StripTracking(url) : url;
 }
 
+QString WebAppUrlWithoutFullscreen(const QString &url) {
+	const auto hash = url.indexOf('#');
+	if (hash < 0) {
+		return url;
+	}
+	auto parts = url.mid(hash + 1).split('&');
+	const auto was = parts.size();
+	const auto fullscreen = [](const QString &part) {
+		return (part.section('=', 0, 0) == u"tgWebAppFullscreen"_q);
+	};
+	parts.erase(
+		std::remove_if(parts.begin(), parts.end(), fullscreen),
+		parts.end());
+	return (parts.size() != was)
+		? (url.left(hash + 1) + parts.join('&'))
+		: url;
+}
+
 void AddOpenUncleanedAction(
 		not_null<Ui::PopupMenu*> menu,
 		const std::shared_ptr<ClickHandler> &link) {
