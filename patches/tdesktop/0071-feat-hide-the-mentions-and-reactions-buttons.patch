+	.name = "Hide the reactions button",
+	.description = "No heart button above the input field for unread reactions.",
+});
+
 base::options::toggle ShowGiftIdsOption({
 	.id = kOptionShowGiftIds,
 	.name = "Show gift IDs",
@@ -692,6 +706,22 @@ rpl::producer<> StaticUserpicsChatsChanges() {
 	return StaticUserpicsChatsOption.changes();
 }
 
+bool HideMentionsButton() {
+	return HideMentionsButtonOption.value();
+}
