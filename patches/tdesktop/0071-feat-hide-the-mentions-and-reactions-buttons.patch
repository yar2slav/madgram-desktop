diff --git a/Telegram/SourceFiles/tele/tele_corner_buttons.cpp b/Telegram/SourceFiles/tele/tele_corner_buttons.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a26a8bec8d16b1e9278bd4b266ceea3464754447
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_corner_buttons.cpp
@@ -0,0 +1,23 @@
+#include "tele/tele_corner_buttons.h"
+
+#include "history/view/history_view_corner_buttons.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+bool CornerButtonHidden(HistoryView::CornerButtonType type) {
+	using Type = HistoryView::CornerButtonType;
+	switch (type) {
+	case Type::Mentions: return HideMentionsButton();
+	case Type::Reactions: return HideReactionsButton();
+	default: return false;
+	}
+}
+
+rpl::producer<> CornerButtonsHiddenChanges() {
+	return rpl::merge(
+		HideMentionsButtonChanges(),
+		HideReactionsButtonChanges());
+}
+
+} // namespace Tele
