diff --git a/Telegram/SourceFiles/tele/tele_bot_edited.cpp b/Telegram/SourceFiles/tele/tele_bot_edited.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dc791a6da3a40b5e1f4beeb0b2fccfd26985e159
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_bot_edited.cpp
@@ -0,0 +1,50 @@
+#include "tele/tele_bot_edited.h"
+
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "history/view/history_view_element.h"
+#include "tele/tele_ignored.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+void RefreshViews() {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	EnumerateViews([&](not_null<HistoryView::Element*> view) {
+		const auto item = view->data();
+		if (item->Get<HistoryMessageEdited>()) {
+			items.emplace(item);
+		}
+	});
+	for (const auto item : items) {
+		item->history()->owner().requestItemViewRefresh(item);
+	}
+}
+
+void EnsureWatching() {
+	static const auto lifetime = [] {
+		auto result = std::make_unique<rpl::lifetime>();
+		HideBotEditedChanges() | rpl::on_next([] {
+			RefreshViews();
+		}, *result);
+		return result;
+	}();
+}
+
+} // namespace
+
+bool HidesEditedMark(not_null<const HistoryItem*> item) {
+	EnsureWatching();
+	if (!HideBotEdited()) {
+		return false;
+	}
+	const auto from = item->from();
+	const auto user = from->asUser();
+	return (user && user->isBot()) || item->viaBot();
+}
+
+} // namespace Tele
