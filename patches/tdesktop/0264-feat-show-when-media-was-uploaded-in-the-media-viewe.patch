 #include "ui/widgets/labels.h"
@@ -31,6 +33,7 @@ namespace {
 constexpr auto kLinkIndex = uint16(1);
 constexpr auto kChannelShift = int64(1000000000000LL);
 constexpr auto kPhotoHistoryLimit = 500;
+constexpr auto kUploadDateSkip = TimeId(5 * 60);
 
 struct PeerDcInfo {
 	int dc = 0;
@@ -414,4 +417,25 @@ QString AppendDc(QString text, int dc, const QString &separator) {
 	return text.isEmpty() ? label : (text + separator + label);
 }
 
+QString AppendUploadDate(
+		QString text,
+		const HistoryItem *item,
+		PhotoData *photo,
+		DocumentData *document,
+		const QString &separator) {
+	const auto date = !MediaUploadDate()
+		? TimeId()
+		: photo
+		? photo->date()
+		: document
+		? document->date
+		: TimeId();
+	if (!item || !date || std::abs(date - item->date()) < kUploadDateSkip) {
+		return text;
+	}
+	const auto label = Lower(u"uploaded %1"_q.arg(
+		Ui::FormatDateTime(base::unixtime::parse(date))));
+	return text.isEmpty() ? label : (text + separator + label);
+}
+
 } // namespace Tele
