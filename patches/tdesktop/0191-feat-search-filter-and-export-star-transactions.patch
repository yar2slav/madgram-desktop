+constexpr auto kChannelShift = int64(1000000000000LL);
+constexpr auto kNanoDigits = 9;
+
+enum Category : uint32 {
+	kGifts = (1U << 0),
+	kReactions = (1U << 1),
+	kPaidMedia = (1U << 2),
+	kSubscriptions = (1U << 3),
+	kBots = (1U << 4),
+	kTopUps = (1U << 5),
+	kWithdrawals = (1U << 6),
+	kIncoming = (1U << 7),
+	kOutgoing = (1U << 8),
+};
+constexpr auto kTypeMask = uint32(kIncoming - 1);
+constexpr auto kDirectionMask = uint32(kIncoming | kOutgoing);
+
+struct ChipDescriptor {
+	uint32 flag = 0;
+	QString name;
+	QString key;
+};
+
+struct Chip {
+	uint32 flag = 0;
+	QRect geometry;
+	Ui::Text::String text;
+};
+
+struct Item {
+	const Data::CreditsHistoryEntry *entry = nullptr;
+	uint32 categories = 0;
+	QString text;
+};
+
+struct Totals {
+	CreditsAmount inStars;
+	CreditsAmount outStars;
+	CreditsAmount inTon;
+	CreditsAmount outTon;
+	bool stars = false;
+	bool ton = false;
+	int count = 0;
+};
+
+struct Word {
+	QString text;
+	std::optional<double> number;
+	uint32 direction = 0;
+};
+
+[[nodiscard]] const std::vector<ChipDescriptor> &ChipDescriptors() {
+	static const auto result = std::vector<ChipDescriptor>{
+		{ kGifts, u"Gifts"_q, u"gift"_q },
+		{ kReactions, u"Reactions"_q, u"reaction"_q },
+		{ kPaidMedia, u"Paid media"_q, u"paid_media"_q },
+		{ kSubscriptions, u"Subscriptions"_q, u"subscription"_q },
+		{ kBots, u"Bots/mini apps"_q, u"bot"_q },
+		{ kTopUps, u"Top-ups"_q, u"top_up"_q },
+		{ kWithdrawals, u"Withdrawals/refunds"_q, u"withdrawal"_q },
+		{ kIncoming, u"Incoming"_q, u"in"_q },
+		{ kOutgoing, u"Outgoing"_q, u"out"_q },
+	};
+	return result;
+}
+
+[[nodiscard]] PeerData *RowPeer(not_null<PeerListRow*> row) {
+	return row->special() ? nullptr : row->peer().get();
+}
+
+[[nodiscard]] uint32 Categories(
+		not_null<PeerListRow*> row,
+		const Data::CreditsHistoryEntry &entry) {
+	using PeerType = Data::CreditsHistoryEntry::PeerType;
+	const auto type = entry.peerType;
+	const auto peer = RowPeer(row);
+	const auto user = peer ? peer->asUser() : nullptr;
+	auto result = uint32(entry.in ? kIncoming : kOutgoing);
+	if (entry.stargift
+		|| entry.gift
+		|| entry.giftUpgraded
+		|| entry.giftResale
+		|| entry.giftOffer
+		|| entry.uniqueGift
+		|| entry.bareGiveawayMsgId
+		|| entry.premiumMonthsForStars) {
+		result |= kGifts;
+	}
+	if (entry.reaction) {
+		result |= kReactions;
+	}
+	if (!entry.extended.empty() || entry.paidMessagesCount) {
+		result |= kPaidMedia;
+	}
+	if (!entry.subscriptionUntil.isNull()) {
+		result |= kSubscriptions;
+	}
+	if ((user && user->isBot()) || (type == PeerType::API)) {
+		result |= kBots;
+	}
+	if ((type == PeerType::AppStore)
+		|| (type == PeerType::PlayMarket)
+		|| (type == PeerType::PremiumBot)
+		|| ((type == PeerType::Fragment) && entry.in)) {
+		result |= kTopUps;
+	}
+	if (((type == PeerType::Fragment) && !entry.in) || entry.refunded) {
+		result |= kWithdrawals;
+	}
+	return result;
+}
+
+[[nodiscard]] QString GiftName(const Data::CreditsHistoryEntry &entry) {
+	const auto &unique = entry.uniqueGift;
+	return unique
+		? u"%1 #%2"_q.arg(unique->title).arg(unique->number)
+		: QString();
+}
+
+[[nodiscard]] QString PeerName(
+		not_null<PeerListRow*> row,
+		const Data::CreditsHistoryEntry &entry) {
+	const auto peer = RowPeer(row);
+	return peer ? peer->name() : Ui::GenerateEntryName(entry).text;
+}
+
+[[nodiscard]] QString PeerApiId(not_null<PeerListRow*> row) {
+	const auto peer = RowPeer(row);
+	if (!peer) {
+		return QString();
+	}
+	const auto bare = int64(peer->id.value & PeerId::kChatTypeMask);
+	return QString::number(peer->isChat()
+		? -bare
+		: peer->isChannel()
+		? -(kChannelShift + bare)
+		: bare);
+}
+
+[[nodiscard]] Item MakeItem(
+		not_null<PeerListRow*> row,
+		const Data::CreditsHistoryEntry *entry) {
+	if (!entry || !*entry) {
+		return {};
+	}
+	auto result = Item{ .entry = entry };
+	result.categories = Categories(row, *entry);
+	auto fields = QStringList{
+		row->generateName(),
+		entry->title,
+		entry->description.text,
+		Ui::GenerateEntryName(*entry).text,
+		GiftName(*entry),
+	};
+	if (const auto peer = RowPeer(row)) {
+		fields.push_back(peer->name());
+		fields.push_back(peer->username());
+	}
+	if (const auto &unique = entry->uniqueGift) {
+		fields.push_back(unique->slug);
+	}
+	for (const auto &chip : ChipDescriptors()) {
+		if (result.categories & chip.flag & kTypeMask) {
+			fields.push_back(chip.name);
+		}
+	}
+	fields.removeAll(QString());
+	result.text = fields.join(QChar('\n')).toLower();
+	return result;
+}
+
+[[nodiscard]] Word ParseWord(const QString &word) {
+	auto result = Word{ .text = word };
+	auto digits = word;
+	if (digits.startsWith(QChar('+'))) {
+		result.direction = kIncoming;
+		digits = digits.mid(1);
+	} else if (digits.startsWith(QChar('-'))
+		|| digits.startsWith(QChar(0x2212))) {
+		result.direction = kOutgoing;
+		digits = digits.mid(1);
+	}
+	digits.remove(QChar(','));
+	digits.remove(QChar('\''));
+	if (digits.isEmpty()) {
+		result.direction = 0;
+		return result;
+	}
+	for (const auto ch : digits) {
+		if (!ch.isDigit() && ch != QChar('.')) {
+			result.direction = 0;
+			return result;
+		}
+	}
+	auto ok = false;
+	const auto value = digits.toDouble(&ok);
+	if (ok) {
+		result.number = value;
+	} else {
+		result.direction = 0;
+	}
+	return result;
+}
+
+[[nodiscard]] QString FormatAmount(CreditsAmount amount, bool ton) {
+	return Lang::FormatCreditsAmountDecimal(amount)
+		+ (ton ? u" TON"_q : (u" "_q + QString::fromUtf8("\xe2\xad\x90")));
+}
+
+[[nodiscard]] QString FormatSide(
+		const Totals &totals,
+		bool in) {
+	auto parts = QStringList();
+	const auto sign = in ? QString(QChar('+')) : QString(QChar(0x2212));
+	if (totals.stars || !totals.ton) {
+		parts.push_back(sign
+			+ FormatAmount(in ? totals.inStars : totals.outStars, false));
+	}
+	if (totals.ton) {
+		parts.push_back(sign
+			+ FormatAmount(in ? totals.inTon : totals.outTon, true));
+	}
+	return parts.join(QChar(' '));
+}
+
+[[nodiscard]] QString ExactAmount(CreditsAmount amount) {
+	const auto abs = amount.abs();
+	auto nano = QString::number(abs.nano()).rightJustified(
+		kNanoDigits,
+		QChar('0'));
+	while (nano.endsWith(QChar('0'))) {
+		nano.chop(1);
+	}
+	return QString::number(abs.whole())
+		+ (nano.isEmpty() ? QString() : (QChar('.') + nano));
+}
+
+[[nodiscard]] QString CsvField(QString value, bool text) {
+	if (text
+		&& !value.isEmpty()
+		&& QString(u"=+-@\t\r"_q).contains(value[0])) {
+		value.prepend(QChar('\''));
+	}
+	if (value.contains(QChar('"'))
+		|| value.contains(QChar(','))
+		|| value.contains(QChar('\n'))
+		|| value.contains(QChar('\r'))) {
+		value.replace(u"\""_q, u"\"\""_q);
+		return QChar('"') + value + QChar('"');
+	}
+	return value;
+}
+
+[[nodiscard]] QString CsvLine(
+		not_null<PeerListRow*> row,
+		const Item &item) {
+	const auto &entry = *item.entry;
+	const auto ton = entry.credits.ton();
+	const auto abs = entry.credits.abs();
+	const auto nano = abs.whole() * int64(1000000000) + abs.nano();
+	auto types = QStringList();
+	for (const auto &chip : ChipDescriptors()) {
+		if (item.categories & chip.flag & kTypeMask) {
+			types.push_back(chip.key);
+		}
+	}
+	const auto &unique = entry.uniqueGift;
+	const auto number = [](uint64 value) {
+		return value ? QString::number(value) : QString();
+	};
+	const auto fields = std::vector<std::pair<QString, bool>>{
+		{ entry.id, false },
+		{ entry.date.toUTC().toString(Qt::ISODate), false },
+		{ entry.in ? u"in"_q : u"out"_q, false },
+		{ (entry.in ? QString() : u"-"_q) + ExactAmount(abs), false },
+		{ QString::number(entry.in ? nano : -nano), false },
+		{ ton ? u"ton"_q : u"stars"_q, false },
+		{ PeerName(row, entry), true },
+		{ PeerApiId(row), false },
+		{ types.isEmpty() ? u"other"_q : types.join(QChar(';')), false },
+		{ entry.title, true },
+		{ entry.description.text, true },
+		{ GiftName(entry), true },
+		{ unique ? unique->slug : QString(), true },
+		{ unique ? number(unique->id) : QString(), false },
+		{ number(entry.bareMsgId), false },
+		{ number(entry.bareGiveawayMsgId), false },
+	};
+	auto result = QStringList();
+	for (const auto &[value, text] : fields) {
+		result.push_back(CsvField(value, text));
+	}
+	return result.join(QChar(','));
+}
+
+[[nodiscard]] QString CsvHeader() {
+	return u"id,date,direction,amount,nano,currency,peer,peer_id,type,"
+		"title,description,gift,gift_slug,gift_id,msg_id,"
+		"giveaway_msg_id"_q;
+}
+
+class Bar final : public Ui::RpWidget {
+public:
+	Bar(QWidget *parent, StarsToolsList list);
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+
+private:
+	void queryChanged(const QString &query);
+	void toggleChip(uint32 flag);
+	void selectChip(QPoint position);
+	void used();
+	void startLoading();
+	void cancelLoading();
+	void sliceApplied(bool allLoaded);
+	void apply();
+	void refreshStatus();
+	void relayout();
+	void showMenu();
+	void exportRequested();
+	void exportCsv();
+	[[nodiscard]] bool active() const;
+	[[nodiscard]] bool matches(const Item &item) const;
+	[[nodiscard]] const Item &itemFor(not_null<PeerListRow*> row);
+	[[nodiscard]] int fullCount() const;
+
+	StarsToolsList _list;
+	std::vector<Chip> _chips;
+	std::vector<Word> _words;
+	base::flat_map<PeerListRowId, Item> _items;
+	Totals _totals;
+	uint32 _selected = 0;
+	int _overChip = -1;
+	int _pressedChip = -1;
+	int _chipsTop = 0;
+	int _lastCount = 0;
+	bool _allLoaded = false;
+	bool _loading = false;
+	bool _pendingExport = false;
+	bool _anyTon = false;
+	Ui::MultiSelect *_select = nullptr;
+	Ui::IconButton *_menuToggle = nullptr;
+	Ui::FlatLabel *_status = nullptr;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+
+};
+
+Bar::Bar(QWidget *parent, StarsToolsList list)
+: RpWidget(parent)
+, _list(std::move(list))
+, _select(Ui::CreateChild<Ui::MultiSelect>(
+	this,
+	st::defaultMultiSelect,
+	rpl::single(Lower(u"Search transactions"_q))))
+, _menuToggle(Ui::CreateChild<Ui::IconButton>(
+	this,
+	st::stickerSetBoxMenu))
+, _status(Ui::CreateChild<Ui::FlatLabel>(
+	this,
+	QString(),
+	st::boxDividerLabel)) {
+	for (const auto &descriptor : ChipDescriptors()) {
+		auto chip = Chip{ .flag = descriptor.flag };
+		chip.text.setText(st::giftBoxTabStyle, Lower(descriptor.name));
+		_chips.push_back(std::move(chip));
+	}
+	setMouseTracking(true);
+
+	_select->setQueryChangedCallback([=](const QString &query) {
+		queryChanged(query);
+	});
+	_select->setCancelledCallback([=] {
+		_select->clearQuery();
+	});
+	_menuToggle->setClickedCallback([=] {
+		showMenu();
+	});
+	auto applied = std::move(_list.sliceApplied);
+	std::move(applied) | rpl::on_next([=](bool allLoaded) {
+		sliceApplied(allLoaded);
+	}, lifetime());
+
+	refreshStatus();
+}
+
+int Bar::fullCount() const {
+	const auto delegate = _list.delegate();
+	return delegate ? delegate->peerListFullRowsCount() : 0;
+}
+
+void Bar::queryChanged(const QString &query) {
+	auto words = std::vector<Word>();
+	const auto list = query.simplified().toLower().split(
+		QChar(' '),
+		Qt::SkipEmptyParts);
+	for (const auto &word : list) {
+		words.push_back(ParseWord(word));
+	}
+	const auto same = ranges::equal(words, _words, [](
+			const Word &a,
+			const Word &b) {
+		return a.text == b.text;
+	});
+	if (same) {
+		return;
+	}
+	_words = std::move(words);
+	used();
+}
+
+void Bar::toggleChip(uint32 flag) {
+	_selected ^= flag;
+	update();
+	used();
+}
+
+void Bar::used() {
+	if (active()) {
+		startLoading();
+	}
+	apply();
+}
+
+bool Bar::active() const {
+	return _selected || !_words.empty();
+}
+
+void Bar::startLoading() {
+	if (_loading || _allLoaded) {
+		return;
+	}
+	_loading = true;
+	_lastCount = fullCount();
+	if (!_list.requesting()) {
+		_list.requestNext();
+	}
+	refreshStatus();
+}
+
+void Bar::cancelLoading() {
+	_loading = false;
+	_pendingExport = false;
+	refreshStatus();
+}
+
+void Bar::sliceApplied(bool allLoaded) {
+	_allLoaded = allLoaded;
+	const auto count = fullCount();
+	if (_loading) {
+		if (_allLoaded) {
+			_loading = false;
+		} else if (count <= _lastCount) {
+			_loading = false;
+			_pendingExport = false;
+			_list.show->showToast(
+				Lower(u"Couldn't load all transactions."_q));
+		} else if (!_list.requesting()) {
+			_list.requestNext();
+		}
+	}
+	_lastCount = count;
+	apply();
+	if (!_loading && _pendingExport && _allLoaded) {
+		_pendingExport = false;
+		exportCsv();
+	}
+}
+
+const Item &Bar::itemFor(not_null<PeerListRow*> row) {
+	const auto id = row->id();
+	const auto i = _items.find(id);
+	if (i != end(_items)) {
+		return i->second;
+	}
+	return _items.emplace(id, MakeItem(row, _list.entry(row))).first->second;
+}
+
+bool Bar::matches(const Item &item) const {
+	if (!item.entry) {
+		return false;
+	}
+	const auto types = (_selected & kTypeMask);
+	if (types && !(item.categories & types)) {
+		return false;
+	}
+	const auto directions = (_selected & kDirectionMask);
+	if (directions && !(item.categories & directions)) {
+		return false;
+	}
+	const auto amount = item.entry->credits.abs().value();
+	for (const auto &word : _words) {
+		if (word.number) {
+			const auto same = (std::abs(amount - *word.number) < 1e-9)
+				&& (!word.direction || (item.categories & word.direction));
+			if (!same && (word.direction || !item.text.contains(word.text))) {
+				return false;
+			}
+		} else if (!item.text.contains(word.text)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void Bar::apply() {
+	const auto delegate = _list.delegate();
+	if (!delegate) {
+		return;
+	}
+	const auto filtering = active();
+	const auto count = delegate->peerListFullRowsCount();
+	for (auto i = 0; i != count; ++i) {
+		const auto row = delegate->peerListRowAt(i);
+		const auto &item = itemFor(row);
+		delegate->peerListSetRowHidden(row, filtering && !matches(item));
+	}
+	delegate->peerListRefreshRows();
+
+	_totals = Totals();
+	for (auto i = 0; i != count; ++i) {
+		const auto row = delegate->peerListRowAt(i);
+		const auto &item = itemFor(row);
+		if (row->hidden() || !item.entry) {
+			continue;
+		}
+		const auto &entry = *item.entry;
+		const auto abs = entry.credits.abs();
+		++_totals.count;
+		if (entry.credits.ton()) {
+			_totals.ton = true;
+			(entry.in ? _totals.inTon : _totals.outTon) += abs;
+		} else {
+			_totals.stars = true;
+			(entry.in ? _totals.inStars : _totals.outStars) += abs;
+		}
+		_anyTon = _anyTon || entry.credits.ton();
+	}
+	refreshStatus();
+	_list.container->resizeToWidth(_list.container->width());
+}
+
+void Bar::refreshStatus() {
+	auto text = TextWithEntities();
+	if (_loading) {
+		text.append(Lower(u"Loading transactions... %1 loaded"_q).arg(
+			Lang::FormatCountDecimal(fullCount())));
+		text.append(u" \xb7 "_q);
+		text.append(Ui::Text::Link(Lower(u"Cancel"_q), 1));
+	} else {
+		const auto count = _totals.count;
+		text.append(Lower(u"In"_q) + QChar(' ') + FormatSide(_totals, true));
+		text.append(u" \xb7 "_q);
+		text.append(Lower(u"Out"_q) + QChar(' ') + FormatSide(_totals, false));
+		text.append(u" \xb7 "_q);
+		const auto noun = (count == 1)
+			? u"transaction"_q
+			: u"transactions"_q;
+		text.append(Lang::FormatCountDecimal(count)
+			+ QChar(' ')
+			+ Lower(noun));
+		if (!_allLoaded) {
+			text.append(u" \xb7 "_q);
+			text.append(Ui::Text::Link(Lower(u"Load all"_q), 1));
+		}
+	}
+	_status->setMarkedText(text);
+	_status->setLink(1, std::make_shared<LambdaClickHandler>([=] {
+		if (_loading) {
+			cancelLoading();
+		} else {
+			startLoading();
+		}
+	}));
+	relayout();
+}
+
+void Bar::relayout() {
+	if (width() > 0) {
+		resizeToWidth(width());
+	}
+}
+
+int Bar::resizeGetHeight(int newWidth) {
+	const auto &padding = st::boxRowPadding;
+	const auto toggle = _menuToggle->width();
+	_select->resizeToWidth(std::max(newWidth - toggle, 1));
+	_select->moveToLeft(0, 0, newWidth);
+	const auto selectHeight = _select->height();
+	_menuToggle->moveToLeft(
+		newWidth - toggle,
+		(selectHeight - _menuToggle->height()) / 2,
+		newWidth);
+
+	const auto &tab = st::giftBoxTabPadding;
+	const auto skip = st::giftBoxResaleTabSkip;
+	const auto chipHeight = st::giftBoxTabStyle.font->height
+		+ tab.top()
+		+ tab.bottom();
+	const auto right = newWidth - padding.right();
+	_chipsTop = selectHeight + skip;
+	auto x = padding.left();
+	auto y = _chipsTop;
+	for (auto &chip : _chips) {
+		const auto chipWidth = chip.text.maxWidth() + tab.left() + tab.right();
+		if (x > padding.left() && x + chipWidth > right) {
+			x = padding.left();
+			y += chipHeight + skip;
+		}
+		chip.geometry = QRect(x, y, chipWidth, chipHeight);
+		x += chipWidth + skip;
+	}
+	y += chipHeight + skip;
+
+	_status->resizeToWidth(std::max(
+		newWidth - padding.left() - padding.right(),
+		1));
+	_status->moveToLeft(padding.left(), y, newWidth);
+	return y + _status->height() + skip;
+}
+
+void Bar::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto &tab = st::giftBoxTabPadding;
+	for (auto i = 0, count = int(_chips.size()); i != count; ++i) {
+		const auto &chip = _chips[i];
+		const auto selected = (_selected & chip.flag) != 0;
+		if (selected || i == _overChip) {
+			const auto radius = chip.geometry.height() / 2.;
+			p.setPen(Qt::NoPen);
+			p.setBrush(selected ? st::giftBoxTabBgActive : st::windowBgOver);
+			p.drawRoundedRect(chip.geometry, radius, radius);
+		}
+		p.setPen(selected ? st::giftBoxTabFgActive : st::giftBoxTabFg);
+		chip.text.draw(p, {
+			.position = chip.geometry.marginsRemoved(tab).topLeft(),
+			.availableWidth = chip.text.maxWidth(),
+		});
+	}
+}
+
+void Bar::selectChip(QPoint position) {
+	auto index = -1;
+	for (auto i = 0, count = int(_chips.size()); i != count; ++i) {
+		if (_chips[i].geometry.contains(position)) {
+			index = i;
+			break;
+		}
+	}
+	if (_overChip == index) {
+		return;
+	}
+	setCursor((index >= 0) ? style::cur_pointer : style::cur_default);
+	_overChip = index;
+	update();
+}
+
+void Bar::mouseMoveEvent(QMouseEvent *e) {
+	selectChip(e->pos());
+}
+
+void Bar::mousePressEvent(QMouseEvent *e) {
+	if (e->button() == Qt::LeftButton) {
+		selectChip(e->pos());
+		_pressedChip = _overChip;
+	}
+}
+
+void Bar::mouseReleaseEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	const auto pressed = std::exchange(_pressedChip, -1);
+	if (pressed >= 0 && pressed == _overChip) {
+		toggleChip(_chips[pressed].flag);
+	}
+}
+
+void Bar::leaveEventHook(QEvent *e) {
+	selectChip(QPoint(-1, -1));
+}
+
+void Bar::showMenu() {
+	if (_menu) {
+		return;
+	}
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	_menu->addAction(Lower(u"Export CSV"_q), [=] {
+		exportRequested();
+	}, &st::menuIconExport);
+	_menu->popup(QCursor::pos());
+}
+
+void Bar::exportRequested() {
+	if (_allLoaded) {
+		exportCsv();
+		return;
+	}
+	_pendingExport = true;
+	startLoading();
+}
+
+void Bar::exportCsv() {
+	const auto delegate = _list.delegate();
+	if (!delegate) {
+		return;
+	}
+	auto lines = QStringList{ CsvHeader() };
+	const auto count = delegate->peerListFullRowsCount();
+	for (auto i = 0; i != count; ++i) {
+		const auto row = delegate->peerListRowAt(i);
+		const auto &item = itemFor(row);
+		if (!row->hidden() && item.entry) {
+			lines.push_back(CsvLine(row, item));
+		}
+	}
+	const auto bytes = QByteArray("\xef\xbb\xbf")
+		+ lines.join(u"\r\n"_q).toUtf8()
+		+ QByteArray("\r\n");
+	const auto show = _list.show;
+	const auto name = u"%1-transactions-%2.csv"_q.arg(
+		_anyTon ? u"ton"_q : u"stars"_q,
+		QDate::currentDate().toString(u"yyyy-MM-dd"_q));
+	FileDialog::GetWritePath(
+		this,
+		Lower(u"Export transactions"_q),
+		u"CSV (*.csv);;"_q + FileDialog::AllFilesFilter(),
+		name,
+		crl::guard(this, [=](QString &&path) {
+			auto file = QFile(path);
+			if (!file.open(QIODevice::WriteOnly)
+				|| file.write(bytes) != bytes.size()) {
+				show->showToast(Lower(u"Couldn't write the file."_q));
+				return;
+			}
+			file.close();
+			show->showToast(Lower(u"Saved %1 to %2."_q).arg(
+				Lang::FormatCountDecimal(int(lines.size()) - 1),
+				QFileInfo(path).fileName()));
+		}));
+}
