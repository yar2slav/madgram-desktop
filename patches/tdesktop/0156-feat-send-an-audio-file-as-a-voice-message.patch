+[[nodiscard]] bool IsAudio(const Ui::PreparedFile &file) {
+	using Type = Ui::PreparedFile::Type;
+	if (file.type == Type::Music) {
+		return true;
+	} else if (file.type != Type::File
+		|| (file.path.isEmpty() && file.content.isEmpty())) {
+		return false;
+	}
+	static const auto extensions = {
+		u".mp3"_q,
+		u".m4a"_q,
+		u".ogg"_q,
+		u".oga"_q,
+		u".opus"_q,
+		u".wav"_q,
+		u".flac"_q,
+		u".aac"_q,
+	};
+	const auto name = file.path.isEmpty() ? file.displayName : file.path;
+	for (const auto &extension : extensions) {
+		if (name.endsWith(extension, Qt::CaseInsensitive)) {
+			return true;
+		}
+	}
+	const auto mime = (file.information
+		&& !file.information->filemime.isEmpty())
+		? file.information->filemime
+		: !file.path.isEmpty()
+		? Core::MimeTypeForFile(QFileInfo(file.path)).name()
+		: Core::MimeTypeForData(file.content).name();
+	return mime.startsWith(u"audio/"_q);
+}
+
+[[nodiscard]] const AVCodec *FindEncoder() {
+	const auto result = avcodec_find_encoder_by_name("libopus");
+	return result ? result : avcodec_find_encoder(AV_CODEC_ID_OPUS);
+}
+
+[[nodiscard]] bool EncodeAndWrite(
+		AVCodecContext *encoder,
+		AVStream *stream,
+		AVFormatContext *format,
+		AVFrame *frame) {
+	const auto sent = AvErrorWrap(avcodec_send_frame(encoder, frame));
+	if (sent) {
+		LogError(u"avcodec_send_frame"_q, sent);
+		return false;
+	}
+	auto packet = av_packet_alloc();
+	const auto guard = gsl::finally([&] { av_packet_free(&packet); });
+	while (true) {
+		const auto received = AvErrorWrap(avcodec_receive_packet(
+			encoder,
+			packet));
+		if (received.code() == AVERROR(EAGAIN)
+			|| received.code() == AVERROR_EOF) {
+			return true;
+		} else if (received) {
+			LogError(u"avcodec_receive_packet"_q, received);
+			return false;
+		}
+		packet->stream_index = stream->index;
+		av_packet_rescale_ts(packet, encoder->time_base, stream->time_base);
+		const auto written = AvErrorWrap(av_interleaved_write_frame(
+			format,
+			packet));
+		if (written) {
+			LogError(u"av_interleaved_write_frame"_q, written);
+			return false;
+		}
+	}
+}
+
+class Transcoder final {
+public:
+	[[nodiscard]] bool init(
+		not_null<AVFormatContext*> output,
+		not_null<AVStream*> input);
+	[[nodiscard]] bool process(
+		not_null<AVFormatContext*> output,
+		AVPacket *packet);
+	[[nodiscard]] bool finish(not_null<AVFormatContext*> output);
+	[[nodiscard]] int64 samples() const;
+	[[nodiscard]] VoiceWaveform waveform() const;
+
+private:
+	[[nodiscard]] bool drain(not_null<AVFormatContext*> output);
+	[[nodiscard]] bool resample(AVFrame *frame);
+	[[nodiscard]] bool encode(
+		not_null<AVFormatContext*> output,
+		bool flushing);
+
+	CodecPointer _decoder;
+	CodecPointer _encoder;
+	SwresamplePointer _swr;
+	FifoPointer _fifo;
+	FramePointer _decoded;
+	FramePointer _frame;
+	AVStream *_stream = nullptr;
+	int _frameSize = 0;
+	int64 _pts = 0;
+	int64 _samples = 0;
+	std::vector<uint16> _levels;
+	uint16 _level = 0;
+	int _levelSamples = 0;
+
+};
+
+bool Transcoder::init(
+		not_null<AVFormatContext*> output,
+		not_null<AVStream*> input) {
+	_decoder = MakeCodecPointer({ .stream = input });
+	if (!_decoder) {
+		return false;
+	}
+	const auto codec = FindEncoder();
+	if (!codec) {
+		LogError(u"avcodec_find_encoder"_q, u"opus"_q);
+		return false;
+	}
+	_stream = avformat_new_stream(output, codec);
+	if (!_stream) {
+		LogError(u"avformat_new_stream"_q, u"opus"_q);
+		return false;
+	}
+	_encoder = CodecPointer(avcodec_alloc_context3(codec));
+	if (!_encoder) {
+		LogError(u"avcodec_alloc_context3"_q, u"opus"_q);
+		return false;
+	}
+	av_channel_layout_default(&_encoder->ch_layout, 1);
+	_encoder->codec_type = AVMEDIA_TYPE_AUDIO;
+	_encoder->sample_fmt = AV_SAMPLE_FMT_FLTP;
+	_encoder->sample_rate = kFrequency;
+	_encoder->time_base = AVRational{ 1, kFrequency };
+	_encoder->bit_rate = kBitrate;
+	if (output->oformat->flags & AVFMT_GLOBALHEADER) {
+		_encoder->flags |= AV_CODEC_FLAG_GLOBAL_HEADER;
+	}
+	auto error = AvErrorWrap(avcodec_open2(_encoder.get(), codec, nullptr));
+	if (error) {
+		LogError(u"avcodec_open2"_q, error, u"opus"_q);
+		return false;
+	}
+	error = AvErrorWrap(avcodec_parameters_from_context(
+		_stream->codecpar,
+		_encoder.get()));
+	if (error) {
+		LogError(u"avcodec_parameters_from_context"_q, error, u"opus"_q);
+		return false;
+	}
+	_stream->time_base = _encoder->time_base;
+	_frameSize = (_encoder->frame_size > 0)
+		? _encoder->frame_size
+		: kFallbackFrameSize;
+	_fifo = FifoPointer(av_audio_fifo_alloc(
+		_encoder->sample_fmt,
+		_encoder->ch_layout.nb_channels,
+		_frameSize * 4));
+	_decoded = MakeFramePointer();
+	_frame = MakeFramePointer();
+	return _fifo && _decoded && _frame;
+}
+
+bool Transcoder::process(
+		not_null<AVFormatContext*> output,
+		AVPacket *packet) {
+	const auto sent = AvErrorWrap(avcodec_send_packet(
+		_decoder.get(),
+		packet));
+	if (sent) {
+		LogError(u"avcodec_send_packet"_q, sent);
+		return (sent.code() == AVERROR_INVALIDDATA);
+	}
+	return drain(output);
+}
+
+bool Transcoder::drain(not_null<AVFormatContext*> output) {
+	while (true) {
+		const auto got = AvErrorWrap(avcodec_receive_frame(
+			_decoder.get(),
+			_decoded.get()));
+		if (got.code() == AVERROR(EAGAIN) || got.code() == AVERROR_EOF) {
+			return true;
+		} else if (got) {
+			LogError(u"avcodec_receive_frame"_q, got);
+			return (got.code() == AVERROR_INVALIDDATA);
+		}
+		auto layout = AVChannelLayout();
+		const auto guard = gsl::finally([&] {
+			av_channel_layout_uninit(&layout);
+		});
+		if (_decoded->ch_layout.order == AV_CHANNEL_ORDER_UNSPEC) {
+			av_channel_layout_default(
+				&layout,
+				_decoded->ch_layout.nb_channels);
+		} else if (av_channel_layout_copy(&layout, &_decoded->ch_layout)) {
+			return false;
+		}
+		_swr = MakeSwresamplePointer(
+			&layout,
+			AVSampleFormat(_decoded->format),
+			_decoded->sample_rate,
+			&_encoder->ch_layout,
+			_encoder->sample_fmt,
+			_encoder->sample_rate,
+			&_swr);
+		if (!_swr || !resample(_decoded.get()) || !encode(output, false)) {
+			return false;
+		}
+	}
+}
+
+bool Transcoder::resample(AVFrame *frame) {
+	const auto in = frame ? frame->nb_samples : 0;
+	const auto upper = int(swr_get_out_samples(_swr.get(), in));
+	if (upper <= 0) {
+		return true;
+	}
+	auto converted = MakeFramePointer();
+	if (!converted) {
+		return false;
+	}
+	converted->nb_samples = upper;
+	converted->format = _encoder->sample_fmt;
+	converted->sample_rate = _encoder->sample_rate;
+	av_channel_layout_copy(&converted->ch_layout, &_encoder->ch_layout);
+	const auto error = AvErrorWrap(av_frame_get_buffer(converted.get(), 0));
+	if (error) {
+		LogError(u"av_frame_get_buffer"_q, error);
+		return false;
+	}
+	const auto samples = swr_convert(
+		_swr.get(),
+		converted->extended_data,
+		upper,
+		frame ? const_cast<const uint8_t**>(frame->extended_data) : nullptr,
+		in);
+	if (samples < 0) {
+		LogError(u"swr_convert"_q, AvErrorWrap(samples));
+		return false;
+	} else if (!samples) {
+		return true;
+	}
+	const auto data = reinterpret_cast<const float*>(
+		converted->extended_data[0]);
+	for (auto i = 0; i != samples; ++i) {
+		const auto value = std::min(std::abs(data[i]), 1.f);
+		_level = std::max(_level, uint16(value * 32767));
+		if (++_levelSamples == kLevelSamples) {
+			_levels.push_back(base::take(_level));
+			_levelSamples = 0;
+		}
+	}
+	const auto written = av_audio_fifo_write(
+		_fifo.get(),
+		reinterpret_cast<void**>(converted->extended_data),
+		samples);
+	if (written < samples) {
+		LogError(u"av_audio_fifo_write"_q);
+		return false;
+	}
+	return true;
+}
+
+bool Transcoder::encode(not_null<AVFormatContext*> output, bool flushing) {
+	while (true) {
+		const auto available = av_audio_fifo_size(_fifo.get());
+		if (available <= 0 || (!flushing && available < _frameSize)) {
+			return true;
+		}
+		const auto take = std::min(available, _frameSize);
+		av_frame_unref(_frame.get());
+		_frame->nb_samples = _frameSize;
+		_frame->format = _encoder->sample_fmt;
+		_frame->sample_rate = _encoder->sample_rate;
+		av_channel_layout_copy(&_frame->ch_layout, &_encoder->ch_layout);
+		const auto error = AvErrorWrap(av_frame_get_buffer(_frame.get(), 0));
+		if (error) {
+			LogError(u"av_frame_get_buffer"_q, error);
+			return false;
+		}
+		const auto read = av_audio_fifo_read(
+			_fifo.get(),
+			reinterpret_cast<void**>(_frame->extended_data),
+			take);
+		if (read < take) {
+			LogError(u"av_audio_fifo_read"_q);
+			return false;
+		}
+		if (take < _frameSize) {
+			av_samples_set_silence(
+				_frame->extended_data,
+				take,
+				_frameSize - take,
+				_encoder->ch_layout.nb_channels,
+				_encoder->sample_fmt);
+		}
+		_frame->pts = _pts;
+		_pts += _frameSize;
+		_samples += take;
+		if (!EncodeAndWrite(
+				_encoder.get(),
+				_stream,
+				output,
+				_frame.get())) {
+			return false;
+		}
+	}
+}
+
+bool Transcoder::finish(not_null<AVFormatContext*> output) {
+	const auto sent = AvErrorWrap(avcodec_send_packet(
+		_decoder.get(),
+		nullptr));
+	if (!sent && !drain(output)) {
+		return false;
+	} else if (_swr && !resample(nullptr)) {
+		return false;
+	} else if (!encode(output, true)) {
+		return false;
+	}
+	if (_levelSamples) {
+		_levels.push_back(base::take(_level));
+		_levelSamples = 0;
+	}
+	return EncodeAndWrite(_encoder.get(), _stream, output, nullptr);
+}
+
+int64 Transcoder::samples() const {
+	return _samples;
+}
+
+VoiceWaveform Transcoder::waveform() const {
+	constexpr auto kCount = Media::Player::kWaveformSamplesCount;
+	const auto count = int64(_levels.size());
+	if (count < kCount) {
+		return {};
+	}
+	auto peaks = std::vector<uint16>();
+	peaks.reserve(kCount);
+	auto peak = uint16(0);
+	auto sum = int64(0);
+	for (const auto level : _levels) {
+		peak = std::max(peak, level);
+		sum += kCount;
+		if (sum >= count) {
+			sum -= count;
+			peaks.push_back(base::take(peak));
+		}
+	}
+	const auto total = std::accumulate(begin(peaks), end(peaks), int64());
+	const auto norm = std::max(int64(total * 1.8 / peaks.size()), int64(2500));
+	auto result = VoiceWaveform();
+	result.reserve(peaks.size());
+	for (const auto value : peaks) {
+		result.push_back(char(std::min(int64(value), norm) * 31 / norm));
+	}
+	return result;
+}
