+[[nodiscard]] Converted Convert(
+		const QString &path,
+		const QByteArray &content) {
+	auto fileWrap = ReadFileWrap();
+	auto bytesWrap = ReadBytesWrap{
+		.size = content.size(),
+		.data = reinterpret_cast<const uchar*>(content.constData()),
+	};
+	auto input = FormatPointer();
+	if (!content.isEmpty()) {
+		input = MakeFormatPointer(
+			&bytesWrap,
+			&ReadBytesWrap::Read,
+			nullptr,
+			&ReadBytesWrap::Seek);
+	} else {
+		fileWrap.file.setFileName(path);
+		if (!fileWrap.file.open(QIODevice::ReadOnly)) {
+			return {};
+		}
+		input = MakeFormatPointer(
+			&fileWrap,
+			&ReadFileWrap::Read,
+			nullptr,
+			&ReadFileWrap::Seek);
+	}
+	if (!input) {
+		return {};
+	}
+	auto error = AvErrorWrap(avformat_find_stream_info(input.get(), nullptr));
+	if (error) {
+		LogError(u"avformat_find_stream_info"_q, error);
+		return {};
+	}
+	const auto streamId = av_find_best_stream(
+		input.get(),
+		AVMEDIA_TYPE_AUDIO,
+		-1,
+		-1,
+		nullptr,
+		0);
+	if (streamId < 0) {
+		LogError(u"av_find_best_stream"_q, AvErrorWrap(streamId));
+		return {};
+	}
+	auto outputWrap = WriteBytesWrap();
+	auto output = MakeWriteFormatPointer(
+		static_cast<void*>(&outputWrap),
+		nullptr,
+		&WriteBytesWrap::Write,
+		&WriteBytesWrap::Seek,
+		"opus"_q);
+	if (!output) {
+		return {};
+	}
+	auto transcoder = Transcoder();
+	if (!transcoder.init(output.get(), input->streams[streamId])) {
+		return {};
+	}
+	error = AvErrorWrap(avformat_write_header(output.get(), nullptr));
+	if (error) {
+		LogError(u"avformat_write_header"_q, error);
+		return {};
+	}
+	auto packet = av_packet_alloc();
+	const auto guard = gsl::finally([&] { av_packet_free(&packet); });
+	while (true) {
+		error = AvErrorWrap(av_read_frame(input.get(), packet));
+		if (error.code() == AVERROR_EOF) {
+			break;
+		} else if (error) {
+			LogError(u"av_read_frame"_q, error);
+			return {};
+		}
+		const auto unref = gsl::finally([&] { av_packet_unref(packet); });
+		if (packet->stream_index == streamId
+			&& !transcoder.process(output.get(), packet)) {
+			return {};
+		}
+	}
+	if (!transcoder.finish(output.get()) || !transcoder.samples()) {
+		return {};
+	}
+	error = AvErrorWrap(av_write_trailer(output.get()));
+	if (error) {
+		LogError(u"av_write_trailer"_q, error);
+		return {};
+	}
+	auto result = Converted();
+	result.content = std::move(outputWrap.content);
+	result.waveform = transcoder.waveform();
+	result.duration = (transcoder.samples() * 1000 + kFrequency - 1)
+		/ kFrequency;
+	return result;
+}
+
+void ConvertAsync(
+		std::shared_ptr<ChatHelpers::Show> show,
+		QString path,
+		QByteArray content,
+		Fn<void(Converted&&)> done) {
+	struct State {
+		bool finished = false;
+		base::weak_ptr<Ui::Toast::Instance> toast;
+	};
+	const auto session = &show->session();
+	const auto weak = base::make_weak(session);
+	const auto state = std::make_shared<State>();
+	base::call_delayed(kToastDelay, session, [=] {
+		if (!state->finished && show->valid()) {
+			state->toast = show->showToast({
+				.text = { Lower(u"Converting…"_q) },
+				.infinite = true,
+			});
+		}
+	});
+	auto finish = Fn<void(Converted&&)>([=](Converted &&result) {
+		state->finished = true;
+		if (const auto toast = state->toast.get()) {
+			toast->hideAnimated();
+		}
+		if (!weak.get()) {
+			return;
+		} else if (result.content.isEmpty()) {
+			if (show->valid()) {
+				show->showToast(
+					Lower(u"Couldn't convert this file to a voice message."_q));
+			}
+			return;
+		}
+		done(std::move(result));
+	});
+	crl::async([
+			path = std::move(path),
+			content = std::move(content),
+			finish = std::move(finish)]() mutable {
+		auto result = Convert(path, content);
+		crl::on_main([
+				finish = std::move(finish),
+				result = std::move(result)]() mutable {
+			finish(std::move(result));
+		});
+	});
+}
+
+[[nodiscard]] Data::Thread *ResolveThread(
+		not_null<PeerData*> peer,
+		const FullReplyTo &replyTo) {
+	const auto history = peer->owner().history(peer);
+	const auto thread = history->threadFor(
+		replyTo.topicRootId,
+		replyTo.monoforumPeerId);
+	return thread ? thread : history.get();
+}
+
+void SendConverted(
+		not_null<Data::Thread*> thread,
+		const FullReplyTo &replyTo,
+		Api::SendOptions options,
+		Converted &&converted) {
+	const auto peer = thread->peer();
+	auto &session = thread->session();
+	if (session.sendAsPeers().chosen(peer)) {
+		options.sendAs = session.sendAsPeers().resolveChosen(peer);
+	}
+	auto action = Api::SendAction(thread, options);
+	action.clearDraft = false;
+	auto reply = replyTo;
+	reply.topicRootId = thread->topicRootId();
+	reply.monoforumPeerId = thread->monoforumPeerId();
+	if (!reply.replying()) {
+		reply.messageId = action.replyTo.messageId;
+	}
+	action.replyTo = reply;
+	session.api().sendVoiceMessage(
+		std::move(converted.content),
+		std::move(converted.waveform),
+		converted.duration,
+		false,
+		action);
+}
+
+void ConvertAndSend(
+		std::shared_ptr<ChatHelpers::Show> show,
+		base::weak_ptr<Data::Thread> weak,
+		FullReplyTo replyTo,
+		QString path,
+		QByteArray content,
+		Api::SendOptions options,
+		Fn<void()> sent) {
+	const auto thread = weak.get();
+	if (!thread) {
+		return;
+	}
+	const auto payment = std::make_shared<SendPaymentHelper>();
+	const auto resend = [=](int approved) {
+		payment->clear();
+		auto copy = options;
+		copy.starsApproved = approved;
+		ConvertAndSend(show, weak, replyTo, path, content, copy, sent);
+	};
+	if (!payment->check(show, thread->peer(), options, 1, resend)) {
+		return;
+	}
+	ConvertAsync(show, path, content, [=](Converted &&converted) {
+		if (const auto strong = weak.get()) {
+			SendConverted(strong, replyTo, options, std::move(converted));
+			sent();
+		}
+	});
+}
+
+} // namespace
+
+void SendFilesVoiceAccess::AddAction(
+		not_null<SendFilesBox*> box,
+		not_null<Ui::PopupMenu*> menu,
+		int index) {
+	auto &file = box->_list.files[index];
+	if (!IsAudio(file)
+		|| !box->_confirmedCallback
+		|| box->property("teleDraftsSave").toBool()) {
+		return;
+	}
+	const auto replyTo = box->_replyTo;
+	const auto thread = ResolveThread(box->_toPeer, replyTo);
+	if (!Data::CanSend(thread, ChatRestriction::SendVoiceMessages)) {
+		return;
+	}
+	while (!file.id) {
+		file.id = base::RandomValue<int64>();
+	}
+	const auto id = file.id;
+	const auto path = file.path;
+	const auto content = file.content;
+	const auto show = box->_show;
+	const auto weak = base::make_weak(thread);
+	const auto guard = QPointer<SendFilesBox>(box.get());
+	const auto details = box->_sendMenuDetails;
+	const auto scheduled = (box->_sendType == Api::SendType::Scheduled)
+		|| (box->_sendType == Api::SendType::ScheduledToUser);
+	const auto send = [=](Api::SendOptions options) {
+		ConvertAndSend(show, weak, replyTo, path, content, options, [=] {
+			if (const auto strong = guard.data()) {
+				Remove(strong, id);
+			}
+		});
+	};
+	menu->addAction(Lower(u"Send as voice message"_q), [=] {
+		if (scheduled) {
+			SendMenu::DefaultCallback(show, send)(
+				{ .type = SendMenu::ActionType::Schedule },
+				details ? details() : SendMenu::Details());
+		} else {
+			send({});
+		}
+	}, &st::menuIconVideoChat);
+}
+
+void SendFilesVoiceAccess::Remove(not_null<SendFilesBox*> box, int64 id) {
+	if (box->_removingIndex) {
+		crl::on_main(box.get(), [=] { Remove(box, id); });
+		return;
+	}
+	box->applyBlockChanges();
+	auto &files = box->_list.files;
+	const auto i = ranges::find(files, id, &Ui::PreparedFile::id);
+	if (i == end(files)) {
+		return;
+	} else if (files.size() == 1) {
+		box->requestToTakeTextWithTags();
+		box->closeBox();
+		return;
+	}
+	const auto index = int(i - begin(files));
+	box->refreshAllAfterChanges(index, [&] {
+		files.erase(files.begin() + index);
+		if (index == files.size()) {
+			auto &last = files.back();
+			const auto was = base::take(last.caption);
+			if (box->fieldText().empty() && !last.isSticker()) {
+				box->_caption->setTextWithTags(was);
+			}
+		}
+	});
+}
+
+void AddSendAsVoiceAction(
+		not_null<SendFilesBox*> box,
+		not_null<Ui::PopupMenu*> menu,
+		int index) {
+	SendFilesVoiceAccess::AddAction(box, menu, index);
+}
+
+void AddDockedVoiceAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<QWidget*> tray,
+		Fn<Data::Thread*()> thread,
+		const Ui::PreparedFile &file,
+		Fn<void()> sent) {
+	const auto current = thread();
+	if (!current
+		|| !IsAudio(file)
+		|| !Data::CanSend(current, ChatRestriction::SendVoiceMessages)) {
+		return;
+	}
+	const auto path = file.path;
+	const auto content = file.content;
+	const auto weak = base::make_weak(current);
+	const auto guard = QPointer<QWidget>(tray.get());
+	menu->addAction(Lower(u"Send as voice message"_q), [=] {
+		ConvertAsync(show, path, content, [=](Converted &&converted) {
+			const auto strong = guard.data();
+			const auto target = weak.get();
+			if (!strong || !target || thread() != target) {
+				if (show->valid()) {
+					show->showToast(Lower(
+						u"The chat changed, the voice message wasn't sent."_q));
+				}
+				return;
+			}
+			DockedVoices().fire({
+				.parent = strong->parentWidget(),
+				.data = {
+					.bytes = std::move(converted.content),
+					.waveform = std::move(converted.waveform),
+					.duration = converted.duration,
+				},
+			});
+			sent();
+		});
+	}, &st::menuIconVideoChat);
+}
+
+auto DockedVoiceRequests(not_null<QWidget*> parent)
+-> rpl::producer<VoiceToSend> {
+	return DockedVoices().events(
+	) | rpl::filter([=](const DockedVoice &voice) {
+		return (voice.parent == parent.get());
+	}) | rpl::map([](const DockedVoice &voice) {
+		return voice.data;
+	});
+}
+
