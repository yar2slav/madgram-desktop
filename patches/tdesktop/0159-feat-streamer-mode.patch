index 0000000000000000000000000000000000000000..55b3f516a2b0fbccbdfb2cf5b2fa5381f80cc734
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_streamer_mode.cpp
@@ -0,0 +1,57 @@
+#include "tele/tele_streamer_mode.h"
+
+#include "lang/lang_keys.h"
+#include "settings/settings_common.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/buttons.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_window.h"
+
+namespace Tele {
+
+rpl::producer<TextWithEntities> StreamerPhoneValue(
+		rpl::producer<TextWithEntities> phone) {
+	return rpl::combine(
+		std::move(phone),
+		StreamerModeValue()
+	) | rpl::map([](const TextWithEntities &phone, bool hidden) {
+		return hidden
+			? tr::marked(tr::lng_info_mobile_hidden(tr::now))
+			: phone;
+	});
+}
+
+rpl::producer<QString> StreamerPhoneValue(rpl::producer<QString> phone) {
+	return rpl::combine(
+		std::move(phone),
+		StreamerModeValue()
+	) | rpl::map([](const QString &phone, bool hidden) {
+		return hidden ? tr::lng_info_mobile_hidden(tr::now) : phone;
+	});
+}
+
+QString StreamerPhone(const QString &phone) {
+	return StreamerMode() ? QString() : phone;
+}
+
+void AddStreamerMenuToggle(not_null<Ui::VerticalLayout*> container) {
+	if (!StreamerModeInMenu()) {
+		return;
+	}
+	const auto button = Settings::AddButtonWithIcon(
+		container,
+		rpl::single(Lower(u"Streamer mode"_q)),
+		st::mainMenuButton,
+		{ &st::menuIconStartStream });
+	button->toggleOn(StreamerModeValue());
+	button->toggledChanges(
+	) | rpl::filter([](bool enabled) {
+		return (enabled != StreamerMode());
+	}) | rpl::on_next([](bool enabled) {
+		SetStreamerMode(enabled);
+	}, button->lifetime());
+}
+
+} // namespace Tele
