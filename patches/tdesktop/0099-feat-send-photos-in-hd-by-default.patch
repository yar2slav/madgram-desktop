+base::options::toggle HdPhotosOption({
+	.id = kOptionHdPhotos,
+	.name = "Send photos in HD by default",
+	.description = "Every send box starts with HD quality on, whatever was "
+		"picked last time.",
+	.defaultValue = true,
+});
+
