 	.id = kOptionChatBackgrounds,
 	.name = "Chat backgrounds",
@@ -1182,6 +1191,10 @@ bool PunctualScheduled() {
 	return PunctualScheduledOption.value();
 }
 
+bool HdPhotos() {
+	return HdPhotosOption.value();
+}
+
 rpl::producer<> PunctualScheduledChanges() {
 	return PunctualScheduledOption.changes();
 }
