+
+std::vector<Data::SavedStarGift> GiftListDates::found(
+		const Info::PeerGifts::Descriptor &descriptor) {
+	const auto state = _state.get();
+	if (!state->descriptor || *state->descriptor != descriptor) {
+		state->reset();
+		state->descriptor = descriptor;
+	}
+	state->load();
+	return state->items;
+}
+
+void GiftListDates::filter(std::vector<Data::SavedStarGift> &list) const {
+	const auto range = _state->range;
+	if (range.empty()) {
+		return;
+	}
+	list.erase(ranges::remove_if(list, [&](const Data::SavedStarGift &gift) {
+		return !range.contains(gift.date);
+	}), end(list));
+}
