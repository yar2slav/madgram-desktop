+
+namespace Ui::Menu {
+struct MenuCallback;
+} // namespace Ui::Menu
+
+namespace Window {
+class SessionController;
+} // namespace Window
+
+namespace Tele {
+
+class ListDatesDelegate final : public PeerListContentDelegateShow {
+public:
+	using PeerListContentDelegateShow::PeerListContentDelegateShow;
+
+	void peerListSetRowHidden(
+		not_null<PeerListRow*> row,
+		bool hidden) override;
+	void peerListRefreshRows() override;
+
+	void setDatesFilter(
+		Fn<bool(not_null<PeerListRow*>)> hides,
+		Fn<void(bool)> sliceDone);
+	void sliceStarted(bool allLoaded);
+
+private:
+	base::flat_set<PeerListRowId> _hiddenByOthers;
+	Fn<bool(not_null<PeerListRow*>)> _hides;
+	Fn<void(bool)> _sliceDone;
+	std::optional<bool> _slicePending;
+
+};
+
+struct CreditsDatesDescriptor {
+	not_null<Ui::VerticalLayout*> container;
+	not_null<ListDatesDelegate*> delegate;
+	std::shared_ptr<Main::SessionShow> show;
+	Fn<QDateTime(not_null<PeerListRow*>)> date;
+	Fn<bool()> skipRequest;
+	Fn<void()> requestNext;
+	bool allLoaded = false;
+};
+
+void SetupCreditsDates(CreditsDatesDescriptor &&descriptor);
+void CreditsSliceStarted(
+	not_null<PeerListDelegate*> delegate,
+	bool allLoaded);
+
+class GiftListDates final {
+public:
+	GiftListDates(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		Fn<void()> changed);
+	~GiftListDates();
+
+	[[nodiscard]] bool active() const;
+	[[nodiscard]] int resizeGetHeight(int width, int top);
+	[[nodiscard]] std::vector<Data::SavedStarGift> found(
+		const Info::PeerGifts::Descriptor &descriptor);
+	void filter(std::vector<Data::SavedStarGift> &list) const;
+	void fillMenu(const Ui::Menu::MenuCallback &addAction);
+	[[nodiscard]] std::unique_ptr<Ui::RpWidget> createAbout(
+		not_null<Ui::RpWidget*> parent,
+		bool empty) const;
+
+private:
+	struct State;
+	const std::unique_ptr<State> _state;
+
+};
+
+[[nodiscard]] std::unique_ptr<GiftListDates> MakeGiftListDates(
+	not_null<Ui::RpWidget*> parent,
+	not_null<Window::SessionController*> window,
+	not_null<PeerData*> peer,
+	Fn<void()> changed);
+
+[[nodiscard]] std::pair<TimeId, TimeId> SharedMediaDates(
+	not_null<PeerData*> peer,
+	MsgId topicRootId,
+	PeerId monoforumPeerId,
+	Storage::SharedMediaType type);
+[[nodiscard]] rpl::producer<> SharedMediaDatesChanges(
+	not_null<Info::AbstractController*> controller);
+void SetupSharedMediaDates(
+	not_null<Ui::RpWidget*> widget,
+	not_null<Info::AbstractController*> controller);
+void FillSharedMediaDatesMenu(
+	not_null<Ui::RpWidget*> widget,
+	not_null<Info::AbstractController*> controller,
+	const Ui::Menu::MenuCallback &addAction);
+
+} // namespace Tele
