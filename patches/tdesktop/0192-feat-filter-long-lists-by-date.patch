+void SetupCreditsDates(CreditsDatesDescriptor &&descriptor) {
+	if (!ListDates()) {
+		return;
+	}
+	struct State {
+		DateRange range;
+		bool loading = false;
+		bool allLoaded = false;
+	};
+	const auto container = descriptor.container;
+	const auto delegate = descriptor.delegate;
+	const auto show = descriptor.show;
+	const auto date = descriptor.date;
+	const auto skipRequest = descriptor.skipRequest;
+	const auto requestNext = descriptor.requestNext;
+	const auto state = container->lifetime().make_state<State>();
+	state->allLoaded = descriptor.allLoaded;
+
+	const auto bar = container->insert(
+		std::max(container->count() - 2, 0),
+		object_ptr<DatesBar>(container, true));
+	const auto rowDate = [=](not_null<PeerListRow*> row) {
+		return base::unixtime::serialize(date(row));
+	};
+	const auto step = [=] {
+		if (!state->loading) {
+			return;
+		}
+		const auto count = delegate->peerListFullRowsCount();
+		const auto oldest = count
+			? rowDate(delegate->peerListRowAt(count - 1))
+			: TimeId();
+		if (state->allLoaded
+			|| (count && oldest < state->range.start())) {
+			state->loading = false;
+			bar->setActive(state->range);
+			return;
+		}
+		bar->setLoading(count, oldest);
+		if (!skipRequest()) {
+			requestNext();
+		}
+	};
+	const auto apply = [=](DateRange range) {
+		state->range = range;
+		state->loading = !range.empty();
+		delegate->peerListRefreshRows();
+		if (range.empty()) {
+			bar->setIdle();
+		} else {
+			step();
+		}
+	};
+	delegate->setDatesFilter([=](not_null<PeerListRow*> row) {
+		return !state->range.empty() && !state->range.contains(rowDate(row));
+	}, [=](bool allLoaded) {
+		state->allLoaded = allLoaded;
+		step();
+	});
+	bar->choose = [=] {
+		ChooseDateRange(show, state->range, crl::guard(bar, apply));
+	};
+	bar->cancel = bar->clear = [=] {
+		apply({});
+	};
+}
+
+void CreditsSliceStarted(
+		not_null<PeerListDelegate*> delegate,
+		bool allLoaded) {
+	if (const auto dated = dynamic_cast<ListDatesDelegate*>(delegate.get())) {
+		dated->sliceStarted(allLoaded);
+	}
+}
