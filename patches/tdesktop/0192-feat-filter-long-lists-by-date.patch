+void ListDatesDelegate::peerListSetRowHidden(
+		not_null<PeerListRow*> row,
+		bool hidden) {
+	if (hidden) {
+		_hiddenByOthers.emplace(row->id());
+	} else {
+		_hiddenByOthers.remove(row->id());
+	}
+	PeerListContentDelegateShow::peerListSetRowHidden(
+		row,
+		hidden || (_hides && _hides(row)));
+}
+
+void ListDatesDelegate::peerListRefreshRows() {
+	if (_hides) {
+		const auto count = peerListFullRowsCount();
+		for (auto i = 0; i != count; ++i) {
+			const auto row = peerListRowAt(i);
+			const auto hidden = _hiddenByOthers.contains(row->id())
+				|| _hides(row);
+			if (row->hidden() != hidden) {
+				PeerListContentDelegateShow::peerListSetRowHidden(
+					row,
+					hidden);
+			}
+		}
+	}
+	PeerListContentDelegateShow::peerListRefreshRows();
+	if (const auto pending = base::take(_slicePending)) {
+		if (_sliceDone) {
+			_sliceDone(*pending);
+		}
+	}
+}
