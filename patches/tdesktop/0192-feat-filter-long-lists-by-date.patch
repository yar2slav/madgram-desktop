+struct GiftListDates::State {
+	State(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		Fn<void()> changed);
+
+	void choose();
+	void apply(DateRange value);
+	void reset();
+	void load();
+	void done(const MTPpayments_SavedStarGifts &result);
+	void applyUpdate(const Data::GiftUpdate &update);
+	void applyUpdate(const Data::GiftsUpdate &update);
+
+	const not_null<Window::SessionController*> window;
+	const not_null<PeerData*> peer;
+	const Fn<void()> changed;
+	MTP::Sender api;
+	DateRange range;
+	std::optional<Info::PeerGifts::Descriptor> descriptor;
+	std::vector<Data::SavedStarGift> items;
+	QString offset;
+	TimeId oldest = 0;
+	mtpRequestId requestId = 0;
+	bool loaded = false;
+	base::unique_qptr<DatesBar> bar;
+	rpl::lifetime lifetime;
+};
+
+GiftListDates::State::State(
+	not_null<Ui::RpWidget*> parent,
+	not_null<Window::SessionController*> window,
+	not_null<PeerData*> peer,
+	Fn<void()> changed)
+: window(window)
+, peer(peer)
+, changed(std::move(changed))
+, api(&peer->session().mtp())
+, bar(base::make_unique_q<DatesBar>(parent, false)) {
+	bar->choose = [=] {
+		choose();
+	};
+	bar->cancel = bar->clear = [=] {
+		apply({});
+	};
+	peer->owner().giftUpdates(
+	) | rpl::on_next([=](const Data::GiftUpdate &update) {
+		applyUpdate(update);
+	}, lifetime);
+	peer->owner().giftsUpdates(
+	) | rpl::on_next([=](const Data::GiftsUpdate &update) {
+		applyUpdate(update);
+	}, lifetime);
+}
+
+void GiftListDates::State::choose() {
+	ChooseDateRange(
+		window->uiShow(),
+		range,
+		crl::guard(bar.get(), [=](DateRange value) { apply(value); }));
+}
+
+void GiftListDates::State::apply(DateRange value) {
+	range = value;
+	reset();
+	if (range.empty()) {
+		bar->setIdle();
+	} else {
+		bar->setActive(range);
+	}
+	changed();
+}
+
+void GiftListDates::State::reset() {
+	api.request(base::take(requestId)).cancel();
+	items.clear();
+	offset = QString();
+	oldest = 0;
+	loaded = false;
+}
+
+void GiftListDates::State::load() {
+	if (requestId || loaded || range.empty() || !descriptor) {
+		return;
+	}
+	const auto filter = descriptor->filter;
+	const auto collectionId = descriptor->collectionId;
+	using Flag = MTPpayments_GetSavedStarGifts::Flag;
+	requestId = api.request(MTPpayments_GetSavedStarGifts(
+		MTP_flags((filter.sortByValue ? Flag::f_sort_by_value : Flag())
+			| (filter.skipLimited ? Flag::f_exclude_unupgradable : Flag())
+			| (filter.skipUpgradable ? Flag::f_exclude_upgradable : Flag())
+			| (filter.skipUnlimited ? Flag::f_exclude_unlimited : Flag())
+			| (filter.skipUnique ? Flag::f_exclude_unique : Flag())
+			| (filter.skipSaved ? Flag::f_exclude_saved : Flag())
+			| (filter.skipUnsaved ? Flag::f_exclude_unsaved : Flag())
+			| (collectionId ? Flag::f_collection_id : Flag())),
+		peer->input(),
+		MTP_int(collectionId),
+		MTP_string(offset),
+		MTP_int(kGiftsPerPage)
+	)).done([=](const MTPpayments_SavedStarGifts &result) {
+		requestId = 0;
+		done(result);
+	}).fail([=] {
+		requestId = 0;
+		loaded = true;
+		bar->setActive(range);
+		changed();
+	}).send();
+	bar->setLoading(int(items.size()), oldest);
+}
+
+void GiftListDates::State::done(const MTPpayments_SavedStarGifts &result) {
+	const auto &data = result.data();
+	const auto owner = &peer->owner();
+	owner->processUsers(data.vusers());
+	owner->processChats(data.vchats());
+
+	const auto &list = data.vgifts().v;
+	auto pageOldest = TimeId();
+	for (const auto &gift : list) {
+		auto parsed = Api::FromTL(peer, gift);
+		if (!parsed) {
+			continue;
+		}
+		if (!parsed->pinned
+			&& parsed->date
+			&& (!pageOldest || parsed->date < pageOldest)) {
+			pageOldest = parsed->date;
+		}
+		items.push_back(std::move(*parsed));
+	}
+	if (pageOldest) {
+		oldest = pageOldest;
+	}
+	const auto next = data.vnext_offset()
+		? qs(*data.vnext_offset())
+		: QString();
+	if (next.isEmpty() || list.isEmpty()) {
+		loaded = true;
+	} else {
+		offset = next;
+		if (!descriptor->filter.sortByValue
+			&& pageOldest
+			&& pageOldest < range.start()) {
+			loaded = true;
+		}
+	}
+	if (loaded) {
+		bar->setActive(range);
+	}
+	changed();
+}
+
+void GiftListDates::State::applyUpdate(const Data::GiftUpdate &update) {
+	const auto i = ranges::find_if(items, [&](const Data::SavedStarGift &gift) {
+		return update.id
+			? (gift.manageId == update.id)
+			: (gift.info.unique && gift.info.unique->slug == update.slug);
+	});
+	if (i == end(items)) {
+		return;
+	}
+	using Action = Data::GiftUpdate::Action;
+	switch (update.action) {
+	case Action::Convert:
+	case Action::Transfer:
+	case Action::Delete: items.erase(i); break;
+	case Action::Save: i->hidden = false; break;
+	case Action::Unsave: i->hidden = true; break;
+	case Action::Pin: i->pinned = true; break;
+	case Action::Unpin: i->pinned = false; break;
+	default: return;
+	}
+	if (!range.empty()) {
+		changed();
+	}
+}
+
+void GiftListDates::State::applyUpdate(const Data::GiftsUpdate &update) {
+	if (update.peer != peer) {
+		return;
+	}
+	const auto id = update.collectionId;
+	for (auto &gift : items) {
+		auto &list = gift.collectionIds;
+		if (ranges::contains(update.added, gift.manageId)) {
+			if (!ranges::contains(list, id)) {
+				list.push_back(id);
+			}
+		} else if (ranges::contains(update.removed, gift.manageId)) {
+			list.erase(ranges::remove(list, id), end(list));
+		}
+	}
+}
