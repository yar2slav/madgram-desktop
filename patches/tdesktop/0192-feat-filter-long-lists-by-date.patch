+std::pair<TimeId, TimeId> SharedMediaDates(
+		not_null<PeerData*> peer,
+		MsgId topicRootId,
+		PeerId monoforumPeerId,
+		Storage::SharedMediaType type) {
+	if (MediaRanges().empty()) {
+		return {};
+	}
+	const auto range = LookupMedia({
+		.session = &peer->session(),
+		.peerId = peer->id,
+		.topicRootId = topicRootId,
+		.monoforumPeerId = monoforumPeerId,
+		.type = type,
+	});
+	return range.empty()
+		? std::pair<TimeId, TimeId>()
+		: std::pair<TimeId, TimeId>(range.start(), range.end() - 1);
+}
+
+rpl::producer<> SharedMediaDatesChanges(
+		not_null<Info::AbstractController*> controller) {
+	const auto key = MediaKeyFor(controller);
+	if (!key) {
+		return rpl::never<>();
+	}
+	return MediaChanges().events(
+	) | rpl::filter([=](const MediaKey &changed) {
+		return (changed == *key);
+	}) | rpl::to_empty;
+}
+
+void SetupSharedMediaDates(
+		not_null<Ui::RpWidget*> widget,
+		not_null<Info::AbstractController*> controller) {
+	if (!ListDates()) {
+		return;
+	}
+	const auto key = MediaKeyFor(controller);
+	if (!key) {
+		return;
+	}
+	const auto bar = Ui::CreateChild<DatesBar>(widget.get(), false);
+	const auto place = [=] {
+		const auto range = LookupMedia(*key);
+		if (range.empty()) {
+			bar->setIdle();
+			return;
+		}
+		bar->setActive(range);
+		const auto width = std::min(bar->naturalWidth(), widget->width());
+		bar->resizeToWidth(width);
+		bar->moveToLeft(
+			(widget->width() - width) / 2,
+			widget->height() - bar->height());
+		bar->raise();
+	};
+	widget->sizeValue(
+	) | rpl::on_next(place, bar->lifetime());
+	MediaChanges().events(
+	) | rpl::filter([=](const MediaKey &changed) {
+		return (changed == *key);
+	}) | rpl::on_next(place, bar->lifetime());
+
+	bar->choose = [=] {
+		ChooseMediaRange(widget, controller, *key);
+	};
+	const auto migratedId = controller->migratedPeerId();
+	bar->clear = [=] {
+		SetMediaRange(*key, migratedId, {});
+	};
+	widget->lifetime().add([
+			key = *key,
+			migratedId,
+			weak = base::make_weak(key->session)] {
+		crl::on_main([=] {
+			if (weak && !LookupMedia(key).empty()) {
+				SetMediaRange(key, migratedId, {});
+			}
+		});
+	});
+}
+
+void FillSharedMediaDatesMenu(
+		not_null<Ui::RpWidget*> widget,
+		not_null<Info::AbstractController*> controller,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!ListDates()) {
+		return;
+	}
+	const auto key = MediaKeyFor(controller);
+	if (!key) {
+		return;
+	}
+	addAction(Lower(u"Date range"_q), [=] {
+		ChooseMediaRange(widget, controller, *key);
+	}, &st::menuIconSchedule);
+}
