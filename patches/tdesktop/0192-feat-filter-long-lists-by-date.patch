+
+DatesBar::DatesBar(QWidget *parent, bool idleShown)
+: RpWidget(parent)
+, _idleShown(idleShown)
+, _cross(QString::fromUtf8("\xe2\x9c\x95")) {
+	setMouseTracking(true);
+	setIdle();
+}
+
+void DatesBar::setIdle() {
+	_mode = Mode::Idle;
+	_text = Lower(u"Filter by date"_q);
+	_link = QString();
+	refresh();
+}
+
+void DatesBar::setLoading(int count, TimeId oldest) {
+	_mode = Mode::Loading;
+	_text = oldest
+		? Lower(u"Loaded %1 \u00b7 now at %2"_q.arg(
+			Lang::FormatCountDecimal(count),
+			FormatDay(base::unixtime::parse(oldest).date(), true)))
+		: Lower(tr::lng_contacts_loading(tr::now));
+	_link = Lower(tr::lng_cancel(tr::now));
+	refresh();
+}
+
+void DatesBar::setActive(DateRange range) {
+	_mode = Mode::Active;
+	_text = FormatRange(range);
+	_link = QString();
+	refresh();
+}
+
+int DatesBar::chipHeight() const {
+	const auto padding = st::giftBoxTabPadding;
+	return st::normalFont->height + padding.top() + padding.bottom();
+}
+
+int DatesBar::naturalWidth() const {
+	const auto margin = st::giftBoxResaleTabsMargin;
+	const auto padding = st::giftBoxTabPadding;
+	const auto &font = st::normalFont;
+	auto result = margin.left() + margin.right();
+	switch (_mode) {
+	case Mode::Idle:
+		result += st::menuIconSchedule.width() + font->width(_text);
+		break;
+	case Mode::Loading:
+		result += font->width(_text) + font->spacew * 4 + font->width(_link);
+		break;
+	case Mode::Active:
+		result += padding.left()
+			+ font->width(_text)
+			+ font->spacew * 2
+			+ font->width(_cross)
+			+ padding.right();
+		break;
+	}
+	return result;
+}
+
+void DatesBar::refresh() {
+	setOver(Part::None);
+	resizeToWidth(width());
+	setVisible(height() > 0);
+	update();
+}
+
+int DatesBar::resizeGetHeight(int newWidth) {
+	if (_mode == Mode::Idle && !_idleShown) {
+		return 0;
+	}
+	layout(newWidth);
+	const auto margin = st::giftBoxResaleTabsMargin;
+	return margin.top() + chipHeight() + margin.top();
+}
+
+void DatesBar::layout(int width) {
+	const auto margin = st::giftBoxResaleTabsMargin;
+	const auto padding = st::giftBoxTabPadding;
+	const auto &font = st::normalFont;
+	const auto top = margin.top();
+	const auto height = chipHeight();
+	const auto left = margin.left();
+	const auto available = std::max(width - left - margin.right(), 0);
+	_icon = _textRect = _linkRect = _chipRect = _clearRect = QRect();
+	switch (_mode) {
+	case Mode::Idle: {
+		const auto &icon = st::menuIconSchedule;
+		_icon = QRect(
+			left,
+			top + (height - icon.height()) / 2,
+			icon.width(),
+			icon.height());
+		_textRect = QRect(
+			left + icon.width(),
+			top,
+			std::min(font->width(_text), available - icon.width()),
+			height);
+	} break;
+	case Mode::Loading: {
+		const auto linkWidth = font->width(_link);
+		_linkRect = QRect(
+			left + available - linkWidth,
+			top,
+			linkWidth,
+			height);
+		_textRect = QRect(
+			left,
+			top,
+			std::max(available - linkWidth - font->spacew * 4, 0),
+			height);
+	} break;
+	case Mode::Active: {
+		const auto crossWidth = font->spacew * 2
+			+ font->width(_cross)
+			+ padding.right();
+		const auto textWidth = std::min(
+			font->width(_text),
+			std::max(available - padding.left() - crossWidth, 0));
+		_chipRect = QRect(
+			left,
+			top,
+			padding.left() + textWidth + crossWidth,
+			height);
+		_textRect = QRect(left + padding.left(), top, textWidth, height);
+		_clearRect = QRect(
+			_textRect.x() + _textRect.width(),
+			top,
+			crossWidth,
+			height);
+	} break;
+	}
+}
+
+void DatesBar::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto &font = st::normalFont;
+	const auto drawText = [&](
+			const QRect &rect,
+			const QString &text,
+			bool underline,
+			style::align align) {
+		p.setFont(underline ? font->underline() : font);
+		p.drawText(rect, font->elided(text, rect.width()), align);
+	};
+	switch (_mode) {
+	case Mode::Idle: {
+		st::menuIconSchedule.paint(p, _icon.topLeft(), width());
+		p.setPen(st::windowActiveTextFg);
+		drawText(_textRect, _text, _over == Part::Choose, style::al_left);
+	} break;
+	case Mode::Loading: {
+		p.setPen(st::windowSubTextFg);
+		drawText(_textRect, _text, false, style::al_left);
+		p.setPen(st::windowActiveTextFg);
+		drawText(_linkRect, _link, _over == Part::Cancel, style::al_left);
+	} break;
+	case Mode::Active: {
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::giftBoxTabBgActive);
+		const auto radius = _chipRect.height() / 2.;
+		p.drawRoundedRect(_chipRect, radius, radius);
+		p.setPen(st::giftBoxTabFgActive);
+		drawText(_textRect, _text, _over == Part::Choose, style::al_left);
+		p.setOpacity((_over == Part::Clear) ? 1. : 0.6);
+		drawText(
+			_clearRect.marginsRemoved(
+				{ 0, 0, st::giftBoxTabPadding.right(), 0 }),
+			_cross,
+			false,
+			style::al_right);
+	} break;
+	}
+}
+
+DatesBar::Part DatesBar::partAt(QPoint point) const {
+	switch (_mode) {
+	case Mode::Idle:
+		return _icon.united(_textRect).contains(point)
+			? Part::Choose
+			: Part::None;
+	case Mode::Loading:
+		return _linkRect.contains(point) ? Part::Cancel : Part::None;
+	case Mode::Active:
+		return _clearRect.contains(point)
+			? Part::Clear
+			: _chipRect.contains(point)
+			? Part::Choose
+			: Part::None;
+	}
+	return Part::None;
+}
+
+void DatesBar::setOver(Part part) {
+	if (_over == part) {
+		return;
+	}
+	_over = part;
+	setCursor((part == Part::None) ? style::cur_default : style::cur_pointer);
+	update();
+}
+
+void DatesBar::mouseMoveEvent(QMouseEvent *e) {
+	setOver(partAt(e->pos()));
+}
+
+void DatesBar::mousePressEvent(QMouseEvent *e) {
+	if (e->button() == Qt::LeftButton) {
+		_pressed = partAt(e->pos());
+	}
+}
+
+void DatesBar::mouseReleaseEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	const auto pressed = std::exchange(_pressed, Part::None);
+	if (pressed == Part::None || pressed != partAt(e->pos())) {
+		return;
+	}
+	const auto callback = (pressed == Part::Choose)
+		? choose
+		: (pressed == Part::Cancel)
+		? cancel
+		: clear;
+	if (callback) {
+		callback();
+	}
+}
+
+void DatesBar::leaveEventHook(QEvent *e) {
+	setOver(Part::None);
+}
+
+[[nodiscard]] base::flat_map<MediaKey, DateRange> &MediaRanges() {
+	static auto result = base::flat_map<MediaKey, DateRange>();
+	return result;
+}
+
+[[nodiscard]] rpl::event_stream<MediaKey> &MediaChanges() {
+	static auto result = rpl::event_stream<MediaKey>();
+	return result;
+}
+
+[[nodiscard]] DateRange LookupMedia(const MediaKey &key) {
+	const auto &ranges = MediaRanges();
+	const auto i = ranges.find(key);
+	return (i != end(ranges)) ? i->second : DateRange();
+}
+
+[[nodiscard]] std::optional<MediaKey> MediaKeyFor(
+		not_null<Info::AbstractController*> controller) {
+	const auto section = controller->section();
+	const auto key = controller->key();
+	const auto peer = key.peer();
+	if (section.type() != Info::Section::Type::Media || !peer) {
+		return std::nullopt;
+	}
+	const auto topic = key.topic();
+	const auto sublist = key.sublist();
+	return MediaKey{
+		.session = &peer->session(),
+		.peerId = peer->id,
+		.topicRootId = topic ? topic->rootId() : MsgId(),
+		.monoforumPeerId = sublist ? sublist->sublistPeer()->id : PeerId(),
+		.type = section.mediaType(),
+	};
+}
+
+void SetMediaRange(const MediaKey &key, PeerId migratedId, DateRange range) {
+	auto &ranges = MediaRanges();
+	for (const auto peerId : { key.peerId, migratedId }) {
+		if (!peerId) {
+			continue;
+		}
+		auto copy = key;
+		copy.peerId = peerId;
+		if (range.empty()) {
+			ranges.remove(copy);
+		} else {
+			ranges[copy] = range;
+		}
+		key.session->storage().unload(Storage::SharedMediaUnloadThread(
+			peerId,
+			key.topicRootId,
+			key.monoforumPeerId));
+	}
+	MediaChanges().fire_copy(key);
+}
+
+void ChooseMediaRange(
+		not_null<Ui::RpWidget*> widget,
+		not_null<Info::AbstractController*> controller,
+		const MediaKey &key) {
+	const auto migratedId = controller->migratedPeerId();
+	ChooseDateRange(
+		controller->uiShow(),
+		LookupMedia(key),
+		crl::guard(widget, [=](DateRange range) {
+			SetMediaRange(key, migratedId, range);
+		}));
+}
