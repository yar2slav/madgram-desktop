+constexpr auto kGiftsPerPage = 100;
+
+struct DateRange {
+	QDate from;
+	QDate till;
+
+	[[nodiscard]] bool empty() const {
+		return !from.isValid();
+	}
+	[[nodiscard]] TimeId start() const {
+		return base::unixtime::serialize(QDateTime(from, QTime(0, 0)));
+	}
+	[[nodiscard]] TimeId end() const {
+		return base::unixtime::serialize(
+			QDateTime(till.addDays(1), QTime(0, 0)));
+	}
+	[[nodiscard]] bool contains(TimeId date) const {
+		return (date >= start()) && (date < end());
+	}
+
+	friend inline bool operator==(
+		const DateRange &,
+		const DateRange &) = default;
+};
+
+struct MediaKey {
+	Main::Session *session = nullptr;
+	PeerId peerId = 0;
+	MsgId topicRootId = 0;
+	PeerId monoforumPeerId = 0;
+	Storage::SharedMediaType type = Storage::SharedMediaType::kCount;
+
+	friend inline auto operator<=>(
+		const MediaKey &,
+		const MediaKey &) = default;
+	friend inline bool operator==(
+		const MediaKey &,
+		const MediaKey &) = default;
+};
+
+[[nodiscard]] QString FormatDay(QDate date, bool year) {
+	const auto month = Lang::MonthSmall(date.month())(tr::now);
+	const auto day = QString::number(date.day());
+	return year
+		? tr::lng_month_day_year(
+			tr::now,
+			lt_month,
+			month,
+			lt_day,
+			day,
+			lt_year,
+			QString::number(date.year()))
+		: tr::lng_month_day(tr::now, lt_month, month, lt_day, day);
+}
+
+[[nodiscard]] QString FormatRange(DateRange range) {
+	if (range.from == range.till) {
+		return FormatDay(range.from, true);
+	}
+	const auto sameYear = (range.from.year() == range.till.year());
+	return FormatDay(range.from, !sameYear)
+		+ QString::fromUtf8(" \xe2\x80\x93 ")
+		+ FormatDay(range.till, true);
+}
+
+void ChooseDateRange(
+		std::shared_ptr<Ui::Show> show,
+		DateRange current,
+		Fn<void(DateRange)> done) {
+	const auto today = QDate::currentDate();
+	const auto highlighted = current.empty() ? today : current.till;
+	const auto selected = std::make_shared<std::optional<bool>>();
+	const auto selectionChanged = [=](
+			not_null<Ui::CalendarBox*> box,
+			std::optional<int> count) {
+		if (!count.has_value()) {
+			*selected = std::nullopt;
+			return;
+		}
+		const auto has = (*count > 0);
+		if (*selected == has) {
+			return;
+		}
+		*selected = has;
+		box->clearButtons();
+		box->addButton(tr::lng_cancel() | rpl::map(Lower), [=] {
+			box->toggleSelectionMode(false);
+		});
+		if (has) {
+			box->addLeftButton(rpl::single(Lower(u"Show these days"_q)), [=] {
+				const auto from = box->selectedFirstDate();
+				const auto till = box->selectedLastDate();
+				if (from.isValid() && till.isValid()) {
+					done({ from, till });
+					box->closeBox();
+				}
+			});
+		}
+	};
+	show->show(Box<Ui::CalendarBox>(Ui::CalendarBoxArgs{
+		.month = highlighted,
+		.highlighted = highlighted,
+		.callback = [=](QDate date, Fn<void()> close) {
+			done({ date, date });
+			close();
+		},
+		.maxDate = today,
+		.allowsSelection = true,
+		.selectionChanged = selectionChanged,
+	}));
+}
