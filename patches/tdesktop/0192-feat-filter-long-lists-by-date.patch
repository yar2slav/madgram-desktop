+void ListDatesDelegate::setDatesFilter(
+		Fn<bool(not_null<PeerListRow*>)> hides,
+		Fn<void(bool)> sliceDone) {
+	_hides = std::move(hides);
+	_sliceDone = std::move(sliceDone);
+}
