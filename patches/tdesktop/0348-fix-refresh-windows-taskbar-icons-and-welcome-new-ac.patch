diff --git a/Telegram/SourceFiles/tele/tele_welcome.cpp b/Telegram/SourceFiles/tele/tele_welcome.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3b33e2303e0543dbcac435946fcfe7c684722069
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_welcome.cpp
@@ -0,0 +1,85 @@
+#include "tele/tele_welcome.h"
+
+#include "core/application.h"
+#include "data/data_session.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "tele/tele_changelog_chat.h"
+#include "tele/tele_lowercase.h"
+#include <QtCore/QCoreApplication>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDir>
+#include <QtCore/QFileInfo>
+#include <QtCore/QSaveFile>
+
+namespace Tele {
+namespace {
+
+QString WelcomePath(not_null<Main::Session*> session) {
+	const auto identity = QByteArray::number(session->userId().bare)
+		+ (session->isTestMode() ? ":test" : ":production");
+	const auto key = QCryptographicHash::hash(identity,
+		QCryptographicHash::Sha256).toHex();
+	return cWorkingDir() + u"tdata/mad_welcome/"_q
+		+ QString::fromLatin1(key);
+}
+
+void Welcome(not_null<Main::Session*> session) {
+	const auto path = WelcomePath(session);
+	if (QFileInfo::exists(path)) {
+		return;
+	}
+	const auto post = [=] {
+		if (QFileInfo::exists(path)) {
+			return;
+		}
+		const auto text = Tr(u"Welcome to mad!\n\n"
+			"Client options are in Settings → mad settings. "
+			"Ghost mode and streamer mode are also available in the side menu "
+			"and tray.\n\nEncrypted history sync is off by default. "
+			"Enable it separately if you want to use it.\n\n"
+			"This is a local message from mad, visible only on this device."_q);
+		PostChangelog(session, { { .text = { text } } });
+		QDir().mkpath(QFileInfo(path).absolutePath());
+		auto marker = QSaveFile(path);
+		if (marker.open(QIODevice::WriteOnly) && marker.write("1") == 1) {
+			if (!marker.commit()) {
+				LOG(("Mad Welcome: could not save state."));
+			}
+		}
+	};
+	if (session->data().chatsListLoaded()) {
+		crl::on_main(session, post);
+	} else {
+		session->data().chatsListLoadedEvents(
+		) | rpl::filter([](Data::Folder *folder) {
+			return !folder;
+		}) | rpl::take(1) | rpl::on_next(post, session->lifetime());
+	}
+}
+
+class WelcomeState final : public QObject {
+public:
+	WelcomeState() : QObject(QCoreApplication::instance()) {
+		Core::App().domain().activeSessionValue(
+		) | rpl::on_next([](Main::Session *session) {
+			if (session) {
+				Welcome(session);
+			}
+		}, _lifetime);
+	}
+
+private:
+	rpl::lifetime _lifetime;
+};
+
+}
+
+void StartWelcome() {
+	static auto started = false;
+	if (!std::exchange(started, true)) {
+		new WelcomeState();
+	}
+}
