+void RefreshWindowsAppIcon(not_null<QWidget*> window) {
+	const auto logo = CustomAppLogo();
+	if (!logo || logo->isNull()) {
+		return;
+	}
+	auto png = QByteArray();
+	auto buffer = QBuffer(&png);
+	if (!logo->scaled(256, 256, Qt::KeepAspectRatio,
+		Qt::SmoothTransformation).save(&buffer, "PNG")) {
+		return;
+	}
+	const auto digest = QCryptographicHash::hash(png,
+		QCryptographicHash::Sha256).toHex();
+	const auto path = cWorkingDir() + u"tdata/mad_icons/app-"_q
+		+ QString::fromLatin1(digest) + u".ico"_q;
+	if (!QFileInfo::exists(path)) {
+		QDir().mkpath(QFileInfo(path).absolutePath());
+		auto file = QSaveFile(path);
+		if (!file.open(QIODevice::WriteOnly)) {
+			return;
+		}
+		auto stream = QDataStream(&file);
+		stream.setByteOrder(QDataStream::LittleEndian);
+		stream << quint16(0) << quint16(1) << quint16(1)
+			<< quint8(0) << quint8(0) << quint8(0) << quint8(0)
+			<< quint16(1) << quint16(32) << quint32(png.size()) << quint32(22);
+		if (file.write(png) != png.size() || !file.commit()) {
+			return;
+		}
+	}
+	auto store = static_cast<IPropertyStore*>(nullptr);
+	if (FAILED(SHGetPropertyStoreForWindow(
+		reinterpret_cast<HWND>(window->winId()), IID_PPV_ARGS(&store)))) {
+		return;
+	}
+	const auto guard = gsl::finally([&] { store->Release(); });
+	const auto set = [&](const PROPERTYKEY &key, const QString &text) {
+		auto value = PROPVARIANT();
+		if (FAILED(InitPropVariantFromString(text.toStdWString().c_str(), &value))) {
+			return false;
+		}
+		const auto result = store->SetValue(key, value);
+		PropVariantClear(&value);
+		return SUCCEEDED(result);
+	};
+	const auto command = u"\"%1\" -workdir \"%2\""_q.arg(
+		QDir::toNativeSeparators(cExeDir() + cExeName()),
+		QDir::toNativeSeparators(QDir(cWorkingDir()).absolutePath()));
+	if (!set(PKEY_AppUserModel_RelaunchCommand, command)
+		|| !set(PKEY_AppUserModel_RelaunchDisplayNameResource, u"mad"_q)
+		|| !set(PKEY_AppUserModel_RelaunchIconResource,
+			QDir::toNativeSeparators(path) + u",0"_q)
+		|| !set(Platform::AppUserModelId::Key(),
+			QString::fromStdWString(Platform::AppUserModelId::Id()))) {
+		return;
+	}
+	store->Commit();
+}
+
 QPixmap TrayIconWithCounter(
 		Window::CounterLayerArgs &&args,
 		bool smallIcon,
