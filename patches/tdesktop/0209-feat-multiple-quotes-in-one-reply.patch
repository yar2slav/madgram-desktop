+void AppendToField(
+		not_null<History*> history,
+		not_null<Ui::InputField*> field,
+		TextWithEntities quoted,
+		const QString &credit) {
+	StripEntities(history, quoted);
+	if (quoted.empty()) {
+		return;
+	}
+	const auto own = field->getTextWithTags();
+	const auto separator = own.text.isEmpty() ? 0 : 2;
+	const auto prefix = credit.isEmpty() ? 0 : int(credit.size()) + 1;
+	const auto limit = Data::PremiumLimits(
+		&history->session()).messageLengthCurrent();
+	const auto available = limit
+		- int(own.text.size())
+		- separator
+		- prefix
+		- 1;
+	if (available < 2) {
+		return;
+	}
+	Truncate(quoted, available);
+	if (prefix) {
+		auto credited = TextWithEntities{ credit + QChar('\n') };
+		credited.entities.push_back(
+			EntityInText(EntityType::Bold, 0, int(credit.size())));
+		for (auto entity : quoted.entities) {
+			entity.shiftRight(prefix);
+			credited.entities.push_back(std::move(entity));
+		}
+		credited.text.append(quoted.text);
+		quoted = std::move(credited);
+	}
+	WrapInQuotes(quoted);
+	auto result = own;
+	if (separator) {
+		result.text.append(u"\n\n"_q);
+	}
+	const auto shift = int(result.text.size());
+	for (auto tag : TextUtilities::ConvertEntitiesToTextTags(
+			quoted.entities)) {
+		tag.offset += shift;
+		result.tags.push_back(std::move(tag));
+	}
+	result.text.append(quoted.text);
+	result.text.append(QChar('\n'));
+	field->setTextWithTags(result, Ui::InputField::HistoryAction::NewEntry);
+	field->setCursorPosition(int(result.text.size()));
+	field->ensureCursorVisible();
+	field->setFocus();
+}
+
+void AppendToEditor(
+		const MultiQuoteCompose &compose,
+		std::vector<Block> blocks,
+		const QString &credit) {
+	auto dropped = false;
+	DropUneditable(blocks, dropped);
+	if (dropped) {
+		ShowTeleToast(
+			compose.field->window(),
+			Lower(u"Some blocks can't be quoted and were left out"_q));
+	}
+	if (!blocks.empty()) {
+		OpenFocused(compose.rich, QuoteMime(std::move(blocks), credit));
+	}
+}
+
 } // namespace
 
 Iv::RichPageBlocksSlice RichQuoteBlocks(
@@ -245,26 +347,68 @@ void ApplyRichQuote(
 		auto dropped = false;
 		DropUneditable(blocks, dropped);
 		if (!blocks.empty()) {
-			auto quote = Block();
-			quote.kind = Iv::RichPage::BlockKind::Quote;
-			quote.blocks = std::move(blocks);
-			auto data = Iv::Editor::ClipboardBlockData();
-			data.blocks.push_back(std::move(quote));
-			data.blocks.push_back(Iv::Editor::MakeParagraphBlock());
-			auto mime = Iv::Editor::MimeDataFromClipboardData(
-				Iv::Editor::ClipboardData(std::move(data)));
 			if (dropped) {
 				ShowTeleToast(
 					compose.field->window(),
 					Lower(u"Some blocks can't be quoted and were left out"_q));
 			}
-			OpenFocused(
-				compose.rich,
-				std::shared_ptr<QMimeData>(mime.release()));
+			QuoteReplies()[history] = replyTo.messageId;
+			OpenFocused(compose.rich, QuoteMime(std::move(blocks), QString()));
 			return;
 		}
 	}
+	QuoteReplies()[history] = replyTo.messageId;
 	InsertPlain(history, slice, compose.field);
 }
 
+bool AppendQuote(
+		not_null<History*> history,
+		const FullReplyTo &replyTo,
+		MultiQuoteCompose compose) {
+	if (!MultiQuote() || compose.editing || base::IsCtrlPressed()) {
+		return false;
+	}
+	auto &pending = PendingQuote();
+	const auto rich = replyTo.quote.empty()
+		&& pending
+		&& (pending->itemId == replyTo.messageId);
+	if (!rich && replyTo.quote.empty()) {
+		QuoteReplies().remove(history);
+		return false;
+	}
+	const auto &current = compose.current;
+	const auto &replies = QuoteReplies();
+	const auto i = replies.find(history);
+	const auto active = current.messageId
+		&& (!current.quote.empty()
+			|| (i != end(replies) && i->second == current.messageId));
+	const auto item = active
+		? history->owner().message(replyTo.messageId)
+		: nullptr;
+	if (!item) {
+		return false;
+	}
+	const auto slice = rich
+		? base::take(pending)->slice
+		: Iv::RichPageBlocksSlice();
+	const auto credit = (replyTo.messageId != current.messageId)
+		? item->author()->name()
+		: QString();
+	if (compose.editorOpen) {
+		AppendToEditor(
+			compose,
+			(rich
+				? slice.blocks
+				: Iv::SplitTextIntoRichPage(replyTo.quote).blocks),
+			credit);
+	} else {
+		AppendToField(
+			history,
+			compose.field,
+			rich ? Flatten(slice) : replyTo.quote,
+			credit);
+	}
+	return true;
+}
+
 } // namespace Tele
