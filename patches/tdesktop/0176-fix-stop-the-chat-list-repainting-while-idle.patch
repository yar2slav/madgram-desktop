From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Fri, 2 Oct 2026 03:10:45 +0300
Subject: [PATCH] fix: stop the chat list repainting while idle

---
 Telegram/SourceFiles/ui/unread_badge.cpp | 33 +++++++++++++-----------
 1 file changed, 18 insertions(+), 15 deletions(-)

diff --git a/Telegram/SourceFiles/ui/unread_badge.cpp b/Telegram/SourceFiles/ui/unread_badge.cpp
index 08596e3a22e60616b195530c2ee7f696cd9d7251..09f43461e6c8a053140c4f959d11b8d53383552c 100644
--- a/Telegram/SourceFiles/ui/unread_badge.cpp
+++ b/Telegram/SourceFiles/ui/unread_badge.cpp
@@ -46,6 +46,7 @@ private:
 	const int _innerSize = 0;
 	const int _outerSize = 0;
 	QImage _frame;
+	QColor _frameColor;
 
 };
 
@@ -67,25 +68,28 @@ QString ScaledBotVerifiedEmoji::entityData() {
 }
 
 void ScaledBotVerifiedEmoji::paint(QPainter &p, const Context &context) {
-	if (!_wrapped->ready()) {
-		return;
-	}
-	const auto ratio = style::DevicePixelRatio();
-	const auto sourcePx = Data::FrameSizeFromTag(
-		Data::CustomEmojiSizeTag::Isolated);
-	if (_frame.width() != sourcePx) {
+	if (_frame.isNull() || _frameColor != context.textColor) {
+		if (!_wrapped->ready()) {
+			return;
+		}
+		const auto ratio = style::DevicePixelRatio();
+		const auto sourcePx = Data::FrameSizeFromTag(
+			Data::CustomEmojiSizeTag::Isolated);
 		_frame = QImage(
 			QSize(sourcePx, sourcePx),
 			QImage::Format_ARGB32_Premultiplied);
 		_frame.setDevicePixelRatio(ratio);
+		_frame.fill(Qt::transparent);
+
+		auto painter = QPainter(&_frame);
+		painter.translate(-context.position);
+		const auto was = context.internal.forceFirstFrame;
+		context.internal.forceFirstFrame = true;
+		_wrapped->paint(painter, context);
+		context.internal.forceFirstFrame = was;
+		painter.end();
+		_frameColor = context.textColor;
 	}
-	_frame.fill(Qt::transparent);
-
-	auto painter = QPainter(&_frame);
-	painter.translate(-context.position);
-	_wrapped->paint(painter, context);
-	painter.end();
-
 	const auto skip = (_outerSize - _innerSize) / 2;
 	auto hq = PainterHighQualityEnabler(p);
 	p.drawImage(
@@ -479,7 +483,6 @@ int PeerBadge::drawVerified(
 			.textColor = st.color->c,
 			.now = crl::now(),
 			.position = position + st.position,
-			.paused = On(PowerSaving::kEmojiStatus),
 		});
 		return icon->width();
 	}
