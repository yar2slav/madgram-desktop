@@ -0,0 +1,40 @@
+#pragma once
+
+#include "data/data_msg_id.h"
+
+class HistoryItem;
+
+namespace Data {
+class Session;
+} // namespace Data
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace Tele {
+
+void ReactionSendFinished(
+	not_null<Data::Session*> owner,
+	FullMsgId itemId,
+	bool success);
+
+void CancelWhoReactedRequest(
+	not_null<Main::Session*> session,
+	mtpRequestId &requestId);
+
+[[nodiscard]] rpl::producer<> WhoReactedRefreshes(
+	not_null<HistoryItem*> item);
+
+template <typename Value>
+[[nodiscard]] rpl::producer<Value> RefreshedWhoReacted(
+		not_null<HistoryItem*> item,
+		rpl::producer<Value> ids) {
+	return WhoReactedRefreshes(
+		item
+	) | rpl::map([=] {
+		return ids;
+	}) | rpl::flatten_latest();
+}
+
+} // namespace Tele
