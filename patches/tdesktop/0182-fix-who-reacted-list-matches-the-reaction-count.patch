diff --git a/Telegram/SourceFiles/tele/tele_who_reacted.cpp b/Telegram/SourceFiles/tele/tele_who_reacted.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2f1ebdfc5d6608aeb3954616c18844d0934c5d3d
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_who_reacted.cpp
@@ -0,0 +1,139 @@
+#include "tele/tele_who_reacted.h"
+
+#include "apiwrap.h"
+#include "base/timer.h"
+#include "data/data_message_reaction_id.h"
+#include "data/data_message_reactions.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kRefreshDelay = crl::time(1000);
+
+struct Counted {
+	Data::ReactionId id;
+	int count = 0;
+	bool my = false;
+	std::vector<not_null<PeerData*>> recent;
+
+	friend inline bool operator==(
+		const Counted &a,
+		const Counted &b) = default;
+};
+
+[[nodiscard]] std::vector<Counted> Snapshot(not_null<HistoryItem*> item) {
+	auto result = std::vector<Counted>();
+	const auto &recent = item->recentReactions();
+	for (const auto &reaction : item->reactions()) {
+		if (reaction.id.paid()) {
+			continue;
+		}
+		auto entry = Counted{
+			.id = reaction.id,
+			.count = reaction.count,
+			.my = reaction.my,
+		};
+		const auto i = recent.find(reaction.id);
+		if (i != end(recent)) {
+			entry.recent = i->second
+				| ranges::views::transform(&Data::RecentReaction::peer)
+				| ranges::to_vector;
+		}
+		result.push_back(std::move(entry));
+	}
+	ranges::sort(result, std::less<>(), &Counted::id);
+	return result;
+}
+
+[[nodiscard]] rpl::event_stream<not_null<HistoryItem*>> &SendsFinished() {
+	static auto result = rpl::event_stream<not_null<HistoryItem*>>();
+	return result;
+}
+
+} // namespace
+
+void ReactionSendFinished(
+		not_null<Data::Session*> owner,
+		FullMsgId itemId,
+		bool success) {
+	if (const auto item = owner->message(itemId)) {
+		if (!success) {
+			item->updateReactionsUnknown();
+		}
+		SendsFinished().fire_copy(item);
+	}
+}
+
+void CancelWhoReactedRequest(
+		not_null<Main::Session*> session,
+		mtpRequestId &requestId) {
+	if (const auto id = base::take(requestId)) {
+		session->api().request(id).cancel();
+	}
+}
+
+rpl::producer<> WhoReactedRefreshes(not_null<HistoryItem*> item) {
+	return [=](auto consumer) {
+		struct State {
+			std::vector<Counted> snapshot;
+			crl::time fired = 0;
+			base::Timer timer;
+			bool removed = false;
+		};
+		auto lifetime = rpl::lifetime();
+		const auto state = lifetime.make_state<State>();
+		const auto fire = [=] {
+			state->fired = crl::now();
+			consumer.put_next({});
+		};
+		state->snapshot = Snapshot(item);
+		state->timer.setCallback(fire);
+
+		const auto owner = &item->history()->owner();
+		rpl::merge(
+			owner->itemDataChanges(
+			) | rpl::filter([=](not_null<HistoryItem*> changed) {
+				if (changed != item || state->removed) {
+					return false;
+				}
+				auto now = Snapshot(item);
+				if (now == state->snapshot) {
+					return false;
+				}
+				state->snapshot = std::move(now);
+				return true;
+			}) | rpl::to_empty,
+			SendsFinished().events(
+			) | rpl::filter([=](not_null<HistoryItem*> finished) {
+				return (finished == item) && !state->removed;
+			}) | rpl::to_empty
+		) | rpl::on_next([=] {
+			if (state->timer.isActive()) {
+				return;
+			}
+			const auto left = state->fired + kRefreshDelay - crl::now();
+			if (left > 0) {
+				state->timer.callOnce(left);
+			} else {
+				fire();
+			}
+		}, lifetime);
+
+		owner->itemRemoved(
+		) | rpl::filter([=](not_null<const HistoryItem*> removed) {
+			return (removed == item);
+		}) | rpl::on_next([=] {
+			state->removed = true;
+			state->timer.cancel();
+		}, lifetime);
+
+		fire();
+		return lifetime;
+	};
+}
+
+} // namespace Tele
