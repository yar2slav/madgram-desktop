@@ -762,6 +762,9 @@ void HistoryInner::setupSwipeReplyAndBack() {
 		if (inSelectionMode().inSelectionMode) {
 			return result;
 		}
+		if (Tele::NoSwipeReply()) {
+			return result;
+		}
 		enumerateItems<EnumItemsDirection::BottomToTop>([&](
 				not_null<Element*> view,
 				int itemtop,
diff --git a/Telegram/SourceFiles/history/view/history_view_chat_section.cpp b/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
