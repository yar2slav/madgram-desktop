+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -105,6 +105,9 @@ extern const char kOptionDockedGrid[];
 extern const char kOptionLocalFolders[];
 extern const char kOptionBookmarks[];
 extern const char kOptionReturnPoint[];
+extern const char kOptionNoGestures[];
+extern const char kOptionNoSwipeReply[];
+extern const char kOptionNoSwipeBack[];
 
 [[nodiscard]] bool HideStories();
 [[nodiscard]] bool InvisibleStories();
@@ -277,5 +280,7 @@ void SetDockedGrid(bool enabled);
 [[nodiscard]] rpl::producer<> MessageBookmarksChanges();
 [[nodiscard]] bool ReturnPoint();
 [[nodiscard]] rpl::producer<> ReturnPointChanges();
+[[nodiscard]] bool NoSwipeReply();
+[[nodiscard]] bool NoSwipeBack();
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index eae5813f3fdced9d39d6c9a55c8c2bfef24167fa..50cb0df711ec66a6f9547100a869a92427437767 100644
