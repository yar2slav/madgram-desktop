--- a/Telegram/SourceFiles/ui/controls/swipe_handler.cpp
+++ b/Telegram/SourceFiles/ui/controls/swipe_handler.cpp
@@ -13,6 +13,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "base/event_filter.h"
 #include "ui/chat/chat_style.h"
 #include "ui/controls/swipe_handler_data.h"
+#include "tele/tele_options.h"
 #include "ui/painter.h"
 #include "ui/rect.h"
 #include "ui/ui_utility.h"
@@ -249,7 +250,9 @@ void SetupSwipeHandler(SwipeHandlerArgs &&args) {
 				* state->finishByTopData.speedRatio;
 			if (!state->finishByTopData.callback
 				|| (state->finishByTopData.msgBareId == kMsgBareIdSwipeBack
-					&& !base::Platform::IsSwipeBackEnabled())) {
+					&& !base::Platform::IsSwipeBackEnabled())
+				|| (state->finishByTopData.msgBareId == kMsgBareIdSwipeBack
+					&& Tele::NoSwipeBack())) {
 				setOrientation(Qt::Vertical);
 			}
 		};
