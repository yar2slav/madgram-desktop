+		}
 		const auto view = _inner->lookupItemByY(data.cursorPosition.y());
 		if (!view
 			|| (!view->data()->isRegular()
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 5c7466a7bfdec4666e11ce751c86ce9764fbccc6..edb51e57313a354cb03d25194e581085c94042d2 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1897,6 +1897,20 @@ void FillInterface(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionAttachMenuClick,
 		{ u"hover"_q, u"paperclip"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionNoGestures,
+		{ u"swipe"_q, u"trackpad"_q, u"touchscreen"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionNoSwipeReply,
+		{ u"gesture"_q },
+		::Tele::kOptionNoGestures);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionNoSwipeBack,
+		{ u"gesture"_q, u"navigation"_q },
+		::Tele::kOptionNoGestures);
 	AddCallButtons(builder);
 	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Text"_q);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 695de6c46cb64b2a652465ebefc8127fa0e7f8ce..0715403451954be32a5a607c0446bfe5434b07f0 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -109,6 +109,9 @@ const char kOptionDockedGrid[] = "tele-docked-grid";
 const char kOptionLocalFolders[] = "tele-local-folders";
 const char kOptionBookmarks[] = "tele-bookmarks";
 const char kOptionReturnPoint[] = "tele-return-point";
+const char kOptionNoGestures[] = "tele-no-gestures";
+const char kOptionNoSwipeReply[] = "tele-no-swipe-reply";
+const char kOptionNoSwipeBack[] = "tele-no-swipe-back";
 
 namespace {
 
@@ -755,6 +758,22 @@ base::options::toggle ReturnPointOption({
 	.description = "After you send a message while scrolled up.",
 });
 
+base::options::toggle NoGesturesOption({
+	.id = kOptionNoGestures,
+	.name = "Turn off touchpad gestures",
+});
+
+base::options::toggle NoSwipeReplyOption({
+	.id = kOptionNoSwipeReply,
+	.name = "Swipe to reply",
+});
+
+base::options::toggle NoSwipeBackOption({
+	.id = kOptionNoSwipeBack,
+	.name = "Swipe back",
+	.description = "Also covers swiping between tabs, folders and photos.",
+});
+
 void MigrateHideCalls() {
 	if (!HideCallsOption.value()) {
 		return;
@@ -1636,4 +1655,12 @@ rpl::producer<> ReturnPointChanges() {
 	return ReturnPointOption.changes();
 }
 
+bool NoSwipeReply() {
+	return NoGesturesOption.value() && NoSwipeReplyOption.value();
+}
+
+bool NoSwipeBack() {
+	return NoGesturesOption.value() && NoSwipeBackOption.value();
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 8e2930a8c9c38a610e7808a72e3b29f841360e33..0171c791b54ed17418be687300c61e04a255b22e 100644
