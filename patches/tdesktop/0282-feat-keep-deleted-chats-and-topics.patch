+	base::flat_map<PeerId, std::vector<MsgId>> marked;
+	base::flat_map<PeerId, bool> releasedChats;
+	base::flat_map<FullMsgId, bool> releasedTopics;
+	base::flat_set<PeerId> leaving;
+	base::flat_set<FullMsgId> ownTopicDeletes;
+	base::flat_set<FullMsgId> purgingTopics;
+	base::flat_set<PeerId> checking;
+	base::flat_set<PeerId> restoredChats;
+	base::flat_set<FullMsgId> restoredTopics;
+};
+
+struct ChatRecord {
+	bool own = false;
+	int folderId = 0;
+	QByteArray peer;
+	std::vector<MsgId> marked;
+};
+
+struct TopicRecord {
+	bool own = false;
+	bool whole = false;
+	QString title;
+	int32 colorId = 0;
+	DocumentId iconId = 0;
+	PeerId creatorId = 0;
+	TimeId date = 0;
+	bool closed = false;
+};
+
+auto Purging = false;
+
+[[nodiscard]] base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<SessionState>> &Sessions() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<SessionState>>();
+	return result;
+}
+
+[[nodiscard]] SessionState *Find(not_null<Main::Session*> session) {
+	auto &sessions = Sessions();
+	const auto i = sessions.find(session);
+	return (i != end(sessions)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] bool Supported(not_null<PeerData*> peer) {
+	if (peer->isSelf()
+		|| peer->isRepliesChat()
+		|| peer->isVerifyCodes()
+		|| peer->isMonoforum()
+		|| peer->migrateTo()
+		|| IsChangelogPeer(peer)) {
+		return false;
+	} else if (const auto channel = peer->asChannel()) {
+		return !channel->isCommunity();
+	}
+	return true;
+}
+
+[[nodiscard]] bool Accessible(not_null<PeerData*> peer) {
+	if (const auto chat = peer->asChat()) {
+		return chat->amIn();
+	} else if (const auto channel = peer->asChannel()) {
+		return channel->amIn();
+	}
+	return true;
+}
+
+[[nodiscard]] bool IsKeptTopicKey(
+		not_null<Main::Session*> session,
+		FullMsgId key) {
+	const auto state = Find(session);
+	return state && state->topics.contains(key);
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> LoadedItems(
+		not_null<History*> history,
+		std::optional<MsgId> rootId) {
+	auto result = HistoryLoadedItems(history);
+	result.erase(ranges::remove_if(result, [&](not_null<HistoryItem*> item) {
+		return !item->isRegular()
+			|| IsKeptDeleted(item)
+			|| (rootId && item->topicRootId() != *rootId);
+	}), end(result));
+	return result;
+}
+
+[[nodiscard]] std::vector<MsgId> KeptIds(
+		const std::vector<not_null<HistoryItem*>> &items) {
+	auto result = std::vector<MsgId>();
+	result.reserve(items.size());
+	for (const auto &item : items) {
+		if (IsKeptDeleted(item)) {
+			result.push_back(item->id);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> KeptTopicItems(
+		not_null<History*> history,
+		MsgId rootId) {
+	auto result = KeptDeletedItems(history);
+	result.erase(ranges::remove_if(result, [&](not_null<HistoryItem*> item) {
+		return (item->topicRootId() != rootId);
+	}), end(result));
+	return result;
+}
+
+[[nodiscard]] HistoryItem *Newest(
+		const std::vector<not_null<HistoryItem*>> &items) {
+	auto result = (HistoryItem*)nullptr;
+	for (const auto &item : items) {
+		if (!result || result->id < item->id) {
+			result = item.get();
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool AllLoadedKept(not_null<History*> history) {
+	for (const auto &block : history->blocks) {
+		for (const auto &view : block->messages) {
+			const auto item = view->data();
+			if (item->isRegular() && !IsKeptDeleted(item)) {
+				return false;
+			}
+		}
+	}
+	const auto last = history->lastMessage();
+	return !last || !last->isRegular() || IsKeptDeleted(last);
+}
+
+void ClearUnread(not_null<History*> history) {
+	history->setUnreadMark(false);
+	history->setUnreadCount(0);
+	history->unreadMentions().clear();
+	history->unreadReactions().clear();
+	history->unreadPollVotes().clear();
+	Core::App().notifications().clearFromHistory(history);
+}
+
+void ClearTopicUnread(not_null<Data::ForumTopic*> topic) {
+	const auto last = topic->lastMessage();
+	topic->replies()->setInboxReadTill(
+		(last && last->isRegular()) ? last->id : topic->rootId(),
+		std::make_optional(0));
+	topic->unreadMentions().clear();
+	topic->unreadReactions().clear();
+	Core::App().notifications().clearFromTopic(topic);
+}
+
+[[nodiscard]] QByteArray SerializeChat(
+		not_null<History*> history,
+		bool own,
+		const std::vector<MsgId> &marked) {
+	auto peer = QByteArray();
+	{
+		auto stream = QDataStream(&peer, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		Serialize::writePeer(stream, history->peer);
+	}
+	const auto folder = history->folder();
+	auto result = QByteArray();
+	{
+		auto stream = QDataStream(&result, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		stream
+			<< kRecordVersion
+			<< quint8(own ? 1 : 0)
+			<< qint32(folder ? folder->id() : 0)
+			<< peer
+			<< quint32(marked.size());
+		for (const auto &id : marked) {
+			stream << qint64(id.bare);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<ChatRecord> ParseChat(const QByteArray &blob) {
+	auto stream = QDataStream(blob);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto version = qint32();
+	auto own = quint8();
+	auto folderId = qint32();
+	auto peer = QByteArray();
+	auto count = quint32();
+	stream >> version >> own >> folderId >> peer >> count;
+	if (stream.status() != QDataStream::Ok
+		|| version != kRecordVersion
+		|| count > quint32(blob.size())) {
+		return std::nullopt;
+	}
+	auto marked = std::vector<MsgId>();
+	marked.reserve(count);
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = qint64();
+		stream >> id;
+		marked.push_back(MsgId(id));
+	}
+	if (stream.status() != QDataStream::Ok) {
+		return std::nullopt;
+	}
+	return ChatRecord{
+		.own = (own != 0),
+		.folderId = folderId,
+		.peer = peer,
+		.marked = std::move(marked),
+	};
+}
+
+[[nodiscard]] QByteArray SerializeTopic(
+		not_null<Data::ForumTopic*> topic,
+		bool own,
+		bool whole) {
+	auto result = QByteArray();
+	{
+		auto stream = QDataStream(&result, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		stream
+			<< kRecordVersion
+			<< quint8(own ? 1 : 0)
+			<< quint8(whole ? 1 : 0)
+			<< topic->title()
+			<< qint32(topic->colorId())
+			<< quint64(topic->iconId())
+			<< quint64(SerializePeerId(topic->creatorId()))
+			<< qint32(topic->creationDate())
+			<< quint8(topic->closed() ? 1 : 0);
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<TopicRecord> ParseTopic(const QByteArray &blob) {
+	auto stream = QDataStream(blob);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto version = qint32();
+	auto own = quint8();
+	auto whole = quint8();
+	auto title = QString();
+	auto colorId = qint32();
+	auto iconId = quint64();
+	auto creatorId = quint64();
+	auto date = qint32();
+	auto closed = quint8();
+	stream
+		>> version
+		>> own
+		>> whole
+		>> title
+		>> colorId
+		>> iconId
+		>> creatorId
+		>> date
+		>> closed;
+	if (stream.status() != QDataStream::Ok || version != kRecordVersion) {
+		return std::nullopt;
+	}
+	return TopicRecord{
+		.own = (own != 0),
+		.whole = (whole != 0),
+		.title = title,
+		.colorId = colorId,
+		.iconId = DocumentId(iconId),
+		.creatorId = DeserializePeerId(creatorId),
+		.date = TimeId(date),
+		.closed = (closed != 0),
+	};
+}
+
+void ForgetWholeTopics(not_null<Main::Session*> session, PeerId peerId) {
+	for (const auto &record : KeptThreads(session)) {
+		if (record.id.peer != peerId || !record.id.msg) {
+			continue;
+		}
+		const auto parsed = ParseTopic(record.blob);
+		if (!parsed || parsed->whole) {
+			ForgetKeptThread(session, record.id);
+		}
+	}
+}
+
+void Refresh(not_null<History*> history) {
+	history->session().changes().peerUpdated(
+		history->peer,
+		Data::PeerUpdate::Flag::Rights);
+	history->updateChatListExistence();
+	history->updateChatListSortPosition();
+	if (history->inChatList()) {
+		history->updateChatListEntry();
+	}
+}
+
+bool MarkChat(not_null<History*> history, bool own) {
+	const auto session = &history->session();
+	const auto state = Find(session);
+	if (!state) {
+		return false;
+	}
+	const auto peer = history->peer;
+	state->chats[peer->id] = own;
+	const auto loaded = LoadedItems(history, std::nullopt);
+	auto items = loaded;
+	if (own) {
+		KeepOwnDeleted(items);
+	} else {
+		KeepDeleted(items);
+	}
+	if (!KeptDeletedCount(history)) {
+		state->chats.remove(peer->id);
+		return false;
+	}
+	auto &marked = state->marked[peer->id];
+	for (const auto &id : KeptIds(loaded)) {
+		marked.push_back(id);
+	}
+	if (history->isPinnedDialog(FilterId())) {
+		history->owner().setChatPinned(history, FilterId(), false);
+	}
+	ClearUnread(history);
+	StoreKeptThread(
+		session,
+		FullMsgId(peer->id, MsgId()),
+		SerializeChat(history, own, marked));
+	if (const auto forum = peer->forum()) {
+		forum->enumerateTopics([&](not_null<Data::ForumTopic*> topic) {
+			if (topic->creating()) {
+				return;
+			}
+			ClearTopicUnread(topic);
+			StoreKeptThread(
+				session,
+				FullMsgId(peer->id, topic->rootId()),
+				SerializeTopic(topic, own, true));
+		});
+	}
+	Refresh(history);
+	return true;
+}
+
+void ReleaseMarked(not_null<History*> history) {
+	const auto state = Find(&history->session());
+	const auto peer = history->peer;
+	const auto marked = state ? state->marked.take(peer->id) : std::nullopt;
+	if (!marked || peer->isUser()) {
+		return;
+	}
+	auto &owner = history->owner();
+	for (const auto &id : *marked) {
+		if (const auto item = owner.message(peer->id, id)) {
+			UnkeepDeleted(item);
+		}
+	}
+}
+
+void UnmarkChat(not_null<History*> history) {
+	const auto session = &history->session();
+	const auto state = Find(session);
+	const auto peer = history->peer;
+	if (!state || !state->chats.remove(peer->id)) {
+		return;
+	}
+	ForgetKeptThread(session, FullMsgId(peer->id, MsgId()));
+	ForgetWholeTopics(session, peer->id);
+	ReleaseMarked(history);
+	Refresh(history);
+}
+
+bool MarkTopic(not_null<Data::ForumTopic*> topic, bool own) {
+	const auto history = topic->history();
+	const auto session = &history->session();
+	const auto state = Find(session);
+	if (!state) {
+		return false;
+	}
+	const auto rootId = topic->rootId();
+	const auto key = FullMsgId(history->peer->id, rootId);
+	state->topics[key] = own;
+	auto items = LoadedItems(history, rootId);
+	if (own) {
+		KeepOwnDeleted(items);
+	} else {
+		KeepDeleted(items);
+	}
+	if (KeptTopicItems(history, rootId).empty()) {
+		state->topics.remove(key);
+		return false;
+	}
+	if (topic->isPinnedDialog(FilterId())) {
+		history->owner().setChatPinned(topic.get(), FilterId(), false);
+	}
+	ClearTopicUnread(topic);
+	StoreKeptThread(session, key, SerializeTopic(topic, own, false));
+	session->changes().peerUpdated(
+		history->peer,
+		Data::PeerUpdate::Flag::Rights);
+	if (topic->inChatList()) {
+		topic->updateChatListEntry();
+	}
+	return true;
+}
+
+void CheckVanished(not_null<History*> history) {
+	const auto session = &history->session();
+	const auto state = Find(session);
+	const auto peerId = history->peer->id;
+	if (!state || !state->checking.emplace(peerId).second) {
+		return;
+	}
+	const auto weak = base::make_weak(history.get());
+	const auto finish = [=] {
+		if (const auto now = Find(session)) {
+			now->checking.remove(peerId);
+		}
+	};
+	session->api().request(MTPmessages_GetPeerDialogs(
+		MTP_vector<MTPInputDialogPeer>(
+			1,
+			MTP_inputDialogPeer(history->peer->input()))
+	)).done([=](const MTPmessages_PeerDialogs &result) {
+		finish();
+		const auto strong = weak.get();
+		if (!strong
+			|| !KeepDeletedChats()
+			|| IsKeptHistory(strong)
+			|| !strong->folderKnown()
+			|| !AllLoadedKept(strong)) {
+			return;
+		}
+		auto exists = false;
+		for (const auto &dialog : result.data().vdialogs().v) {
+			dialog.match([&](const MTPDdialog &data) {
+				if (peerFromMTP(data.vpeer()) == peerId) {
+					exists = true;
+				}
+			}, [](const auto &) {
+			});
+		}
+		if (!exists) {
+			MarkChat(strong, false);
+		}
+	}).fail([=](const MTP::Error &error) {
+		finish();
+		const auto strong = weak.get();
+		const auto type = error.type();
+		if (strong
+			&& (type == u"PEER_ID_INVALID"_q || type == u"CHAT_ID_INVALID"_q)
+			&& KeepDeletedChats()
+			&& !IsKeptHistory(strong)
+			&& strong->folderKnown()
+			&& AllLoadedKept(strong)) {
+			MarkChat(strong, false);
+		}
+	}).send();
+}
+
+void RestoreTopics(not_null<Data::Forum*> forum) {
+	const auto history = forum->history();
+	const auto session = &history->session();
+	const auto state = Find(session);
+	if (!state || !KeepDeletedChats() || !KeepDeletedPersist()) {
+		return;
+	}
+	const auto peerId = history->peer->id;
+	const auto keptChat = IsKeptHistory(history);
+	for (const auto &record : KeptThreads(session)) {
+		if (record.id.peer != peerId
+			|| !record.id.msg
+			|| state->restoredTopics.contains(record.id)) {
+			continue;
+		}
+		const auto parsed = ParseTopic(record.blob);
+		if (!parsed) {
+			ForgetKeptThread(session, record.id);
+			continue;
+		} else if (parsed->whole && !keptChat) {
+			continue;
+		} else if (!keptChat && !forum->topicsList()->loaded()) {
+			continue;
+		}
+		state->restoredTopics.emplace(record.id);
+		if (state->topics.contains(record.id)) {
+			continue;
+		}
+		const auto rootId = record.id.msg;
+		if (forum->topicFor(rootId)) {
+			if (!parsed->whole) {
+				ForgetKeptThread(session, record.id);
+			}
+			continue;
+		}
+		const auto last = Newest(KeptTopicItems(history, rootId));
+		if (!last) {
+			ForgetKeptThread(session, record.id);
+			continue;
+		}
+		if (!parsed->whole) {
+			state->topics[record.id] = parsed->own;
+		}
+		const auto topic = forum->applyTopicAdded(
+			rootId,
+			parsed->title,
+			parsed->colorId,
+			parsed->iconId,
+			parsed->creatorId,
+			parsed->date,
+			false);
+		topic->setClosed(parsed->closed);
+		topic->applyMaybeLast(last);
+	}
+}
+
+void RestoreChat(
+		not_null<Main::Session*> session,
+		not_null<SessionState*> state,
+		const KeptThreadRecord &record,
+		const ChatRecord &parsed) {
+	auto &owner = session->data();
+	const auto peerId = record.id.peer;
+	if (const auto existing = owner.historyLoaded(peerId)
+		; existing && existing->inChatList()) {
+		if (IsKeptHistory(existing)) {
+			return;
+		} else if (Accessible(existing->peer)) {
+			ForgetKeptThread(session, record.id);
+		} else if (!IsKeptHistory(existing)) {
+			MarkChat(existing, parsed.own);
+		}
+		return;
+	}
+	const auto loaded = owner.peerLoaded(peerId);
+	const auto wasLoaded = loaded && loaded->isLoaded();
+	auto stream = QDataStream(parsed.peer);
+	stream.setVersion(QDataStream::Qt_5_1);
+	const auto peer = Serialize::readPeer(session, record.appVersion, stream);
+	if (!peer || peer->id != peerId || !Supported(peer)) {
+		ForgetKeptThread(session, record.id);
+		return;
+	}
+	if (!wasLoaded) {
+		if (const auto channel = peer->asChannel()) {
+			if (channel->amIn()) {
+				channel->setFlags(channel->flags() | ChannelDataFlag::Left);
+			}
+		} else if (const auto chat = peer->asChat()) {
+			if (chat->amIn()) {
+				chat->setFlags(chat->flags() | ChatDataFlag::Left);
+			}
+		}
+	}
+	const auto history = owner.history(peer);
+	state->chats[peerId] = parsed.own;
+	state->marked[peerId] = parsed.marked;
+	const auto last = Newest(KeptDeletedItems(history));
+	if (!last) {
+		state->chats.remove(peerId);
+		state->marked.remove(peerId);
+		ForgetKeptThread(session, record.id);
+		return;
+	}
+	history->applyDialogTopMessage(last->id);
+	history->applyDialogFields(
+		(parsed.folderId ? owner.folder(parsed.folderId).get() : nullptr),
+		0,
+		last->id,
+		last->id);
+	if (const auto forum = peer->forum()) {
+		RestoreTopics(forum);
+	}
+	Refresh(history);
+}
+
+void RestoreChats(not_null<Main::Session*> session) {
+	const auto state = Find(session);
+	if (!state || !KeepDeletedChats() || !KeepDeletedPersist()) {
+		return;
+	}
+	auto &owner = session->data();
+	if (!owner.chatsListLoaded()) {
+		return;
+	}
+	const auto archive = owner.folderLoaded(Data::Folder::kId);
+	const auto archiveReady = !archive || owner.chatsListLoaded(archive);
+	for (const auto &record : KeptThreads(session)) {
+		if (record.id.msg || state->restoredChats.contains(record.id.peer)) {
+			continue;
+		}
+		const auto parsed = ParseChat(record.blob);
+		if (!parsed) {
+			ForgetKeptThread(session, record.id);
+			continue;
+		} else if (parsed->folderId && !archiveReady) {
+			continue;
+		}
+		state->restoredChats.emplace(record.id.peer);
+		RestoreChat(session, state, record, *parsed);
+	}
+	auto forums = base::flat_set<PeerId>();
+	for (const auto &record : KeptThreads(session)) {
+		if (record.id.msg) {
+			forums.emplace(record.id.peer);
+		}
+	}
+	for (const auto &peerId : forums) {
+		const auto history = owner.historyLoaded(peerId);
+		const auto forum = history ? history->peer->forum() : nullptr;
+		if (forum && forum->topicsList()->loaded()) {
+			RestoreTopics(forum);
+		}
+	}
+}
+
+void Reacquire(not_null<Main::Session*> session) {
+	const auto state = Find(session);
+	if (!state) {
+		return;
+	}
+	auto &owner = session->data();
+	for (const auto &[peerId, own] : base::take(state->releasedChats)) {
+		const auto history = owner.historyLoaded(peerId);
+		if (!history) {
+			state->marked.remove(peerId);
+			continue;
+		}
+		const auto back = history->peer->isUser()
+			? !AllLoadedKept(history)
+			: Accessible(history->peer);
+		if (!back && KeptDeletedCount(history)) {
+			state->chats[peerId] = own;
+			Refresh(history);
+		} else {
+			ForgetKeptThread(session, FullMsgId(peerId, MsgId()));
+			ForgetWholeTopics(session, peerId);
+			ReleaseMarked(history);
+		}
+	}
+	for (const auto &[key, own] : base::take(state->releasedTopics)) {
+		const auto history = owner.historyLoaded(key.peer);
+		const auto forum = history ? history->peer->forum() : nullptr;
+		const auto topic = forum ? forum->topicFor(key.msg) : nullptr;
+		if (topic && !KeptTopicItems(history, key.msg).empty()) {
+			state->topics[key] = own;
+			if (topic->inChatList()) {
+				topic->updateChatListEntry();
+			}
+			session->changes().peerUpdated(
+				history->peer,
+				Data::PeerUpdate::Flag::Rights);
+		}
+	}
+	state->restoredChats.clear();
+	state->restoredTopics.clear();
+	RestoreChats(session);
+}
+
+void ReleaseAll(not_null<Main::Session*> session) {
+	const auto state = Find(session);
+	if (!state) {
+		return;
+	}
+	auto &owner = session->data();
+	const auto chats = base::take(state->chats);
+	const auto topics = base::take(state->topics);
+	for (const auto &[peerId, own] : chats) {
+		state->releasedChats[peerId] = own;
+	}
+	for (const auto &[key, own] : topics) {
+		state->releasedTopics[key] = own;
+	}
+	state->restoredChats.clear();
+	state->restoredTopics.clear();
+	for (const auto &[peerId, own] : chats) {
+		if (const auto history = owner.historyLoaded(peerId)) {
+			Refresh(history);
+		}
+	}
+	for (const auto &[key, own] : topics) {
+		if (const auto history = owner.historyLoaded(key.peer)) {
+			const auto forum = history->peer->forum();
+			const auto topic = forum ? forum->topicFor(key.msg) : nullptr;
+			if (topic && topic->inChatList()) {
+				topic->updateChatListEntry();
+			}
+			Refresh(history);
+		}
+	}
+}
+
+void PurgeTopic(not_null<Data::ForumTopic*> topic) {
+	const auto history = topic->history();
+	const auto session = &history->session();
+	const auto state = Find(session);
+	if (!state) {
+		return;
+	}
+	const auto forum = topic->forum();
+	const auto rootId = topic->rootId();
+	const auto key = FullMsgId(history->peer->id, rootId);
+	state->topics.remove(key);
+	ForgetKeptThread(session, key);
+	auto ids = MessageIdsList();
+	for (const auto &item : KeptTopicItems(history, rootId)) {
+		ids.push_back(item->fullId());
+	}
+	if (!ids.empty()) {
+		history->owner().histories().deleteMessages(ids, false);
+	}
+	state->purgingTopics.emplace(key);
+	forum->applyTopicDeleted(rootId);
+	state->purgingTopics.remove(key);
+	session->changes().peerUpdated(
+		history->peer,
+		Data::PeerUpdate::Flag::Rights);
+}
+
+void ConfirmDelete(
+		not_null<Window::SessionController*> controller,
+		QString text,
+		Fn<void()> done) {
+	controller->show(Ui::MakeConfirmBox({
+		.text = std::move(text),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			done();
+		},
+		.confirmText = Lower(u"Delete"_q),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+} // namespace
+
+std::vector<not_null<HistoryItem*>> HistoryLoadedItems(
+		not_null<History*> history) {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	result.reserve(history->_items.size());
+	for (const auto &item : history->_items) {
+		result.push_back(item.get());
+	}
+	return result;
+}
+
+void SetupKeptChats(not_null<Main::Session*> session) {
+	Sessions().emplace(session, std::make_unique<SessionState>());
+	session->lifetime().add([=] {
+		Sessions().remove(session);
+	});
+
+	session->data().chatsListLoadedEvents(
+	) | rpl::on_next([=](Data::Folder *) {
+		RestoreChats(session);
+	}, session->lifetime());
+
+	session->data().newItemAdded(
+	) | rpl::on_next([=](not_null<HistoryItem*> item) {
+		const auto history = item->history();
+		if (IsKeptHistory(history)
+			&& item->isRegular()
+			&& !IsKeptDeleted(item)
+			&& Accessible(history->peer)) {
+			UnmarkChat(history);
+		}
+	}, session->lifetime());
+
+	KeepDeletedChatsValue(
+	) | rpl::skip(1) | rpl::on_next([=](bool on) {
+		if (on) {
+			Reacquire(session);
+		} else {
+			ReleaseAll(session);
+		}
+	}, session->lifetime());
+}
+
+bool IsKeptChat(const PeerData *peer) {
+	if (!peer || Sessions().empty()) {
+		return false;
+	}
+	const auto state = Find(&peer->session());
+	return state && state->chats.contains(peer->id);
+}
+
+bool IsKeptHistory(not_null<const History*> history) {
+	return IsKeptChat(history->peer);
+}
+
+bool IsKeptThread(const Data::Thread *thread) {
+	if (!thread || Sessions().empty()) {
+		return false;
+	} else if (IsKeptHistory(thread->owningHistory())) {
+		return true;
+	} else if (const auto topic = thread->asTopic()) {
+		return IsKeptTopicKey(
+			&topic->session(),
+			FullMsgId(topic->peer()->id, topic->rootId()));
+	}
+	return false;
+}
+
+QString KeptChatError(const PeerData *peer) {
+	return IsKeptChat(peer)
+		? Lower(u"This chat was deleted."_q)
+		: QString();
+}
+
+QString KeptThreadError(const Data::Thread *thread) {
+	if (!IsKeptThread(thread)) {
+		return QString();
+	} else if (IsKeptHistory(thread->owningHistory())) {
+		return Lower(u"This chat was deleted."_q);
+	}
+	return Lower(u"This topic was deleted."_q);
+}
+
+bool KeepConversation(not_null<PeerData*> peer) {
+	if (Purging
+		|| !KeepDeletedChats()
+		|| !KeepDeletedOwn()
+		|| !Supported(peer)) {
+		return false;
+	}
+	const auto history = peer->owner().historyLoaded(peer);
+	if (!history) {
+		return false;
+	} else if (IsKeptHistory(history)) {
+		return true;
+	} else if (!history->inChatList()) {
+		return false;
+	}
+	return MarkChat(history, true);
+}
+
+bool DeleteKeptChat(not_null<PeerData*> peer) {
+	const auto history = peer->owner().historyLoaded(peer);
+	if (!history || !IsKeptHistory(history)) {
+		return false;
+	}
+	const auto session = &history->session();
+	const auto state = Find(session);
+	state->chats.remove(peer->id);
+	state->marked.remove(peer->id);
+	auto topics = std::vector<FullMsgId>();
+	for (const auto &[key, own] : state->topics) {
+		if (key.peer == peer->id) {
+			topics.push_back(key);
+		}
+	}
+	for (const auto &key : topics) {
+		state->topics.remove(key);
+	}
+	ForgetKeptPeer(session, peer->id);
+	ClearKeptDeleted(history);
+	Purging = true;
+	peer->owner().deleteConversationLocally(peer);
+	Purging = false;
+	session->changes().peerUpdated(peer, Data::PeerUpdate::Flag::Rights);
+	return true;
+}
+
+void NoteLeavingChannel(not_null<ChannelData*> channel) {
+	if (const auto state = Find(&channel->session())) {
+		if (channel->amIn()) {
+			state->leaving.emplace(channel->id);
+		}
+	}
+}
+
+void LeavingChannelFailed(not_null<ChannelData*> channel) {
+	if (const auto state = Find(&channel->session())) {
+		state->leaving.remove(channel->id);
+	}
+}
+
+void KeptDialogApplied(not_null<History*> history, MsgId topMessageId) {
+	if (!topMessageId
+		|| !IsKeptHistory(history)
+		|| !Accessible(history->peer)) {
+		return;
+	}
+	const auto item = history->owner().message(history->peer, topMessageId);
+	if (!item || !IsKeptDeleted(item)) {
+		UnmarkChat(history);
+	}
+}
+
+void KeptChannelAmInChanged(not_null<ChannelData*> channel) {
+	const auto state = Find(&channel->session());
+	if (!state) {
+		return;
+	}
+	const auto history = channel->owner().historyLoaded(channel);
+	if (channel->amIn()) {
+		state->leaving.remove(channel->id);
+		if (history && IsKeptHistory(history)) {
+			UnmarkChat(history);
+		}
+		return;
+	}
+	const auto own = state->leaving.remove(channel->id);
+	if (!KeepDeletedChats()
+		|| (own && !KeepDeletedOwn())
+		|| !history
+		|| !history->inChatList()
+		|| IsKeptHistory(history)
+		|| !Supported(channel)) {
+		return;
+	}
+	MarkChat(history, own);
+}
+
+bool KeepsForbiddenChat(not_null<PeerData*> peer) {
+	if (!KeepDeletedChats() || !Supported(peer)) {
+		return false;
+	}
+	const auto history = peer->owner().historyLoaded(peer);
+	if (!history) {
+		return false;
+	} else if (IsKeptHistory(history)) {
+		return true;
+	} else if (!history->inChatList()) {
+		return false;
+	}
+	const auto chat = peer->asChat();
+	if (chat && !(chat->flags() & ChatDataFlag::Forbidden)) {
+		const auto weak = base::make_weak(history);
+		crl::on_main(&peer->session(), [=] {
+			if (const auto strong = weak.get()) {
+				if (!IsKeptHistory(strong) && strong->inChatList()) {
+					CheckVanished(strong);
+				}
+			}
+		});
+	}
+	return true;
+}
+
+void KeptChatsItemsDeleted(const std::vector<not_null<HistoryItem*>> &items) {
+	if (items.empty() || Sessions().empty() || !KeepDeletedChats()) {
+		return;
+	}
+	auto histories = base::flat_set<not_null<History*>>();
+	for (const auto &item : items) {
+		const auto history = item->history();
+		if (IsKeptHistory(history)) {
+			continue;
+		}
+		const auto peer = history->peer;
+		if (const auto forum = peer->forum()) {
+			const auto rootId = item->topicRootId();
+			if (rootId == item->id
+				&& rootId != Data::ForumTopic::kGeneralId
+				&& !IsKeptTopicKey(
+					&history->session(),
+					FullMsgId(peer->id, rootId))) {
+				forum->requestTopic(rootId);
+			}
+		} else if (peer->isUser() || peer->isChat()) {
+			histories.emplace(history);
+		}
+	}
+	for (const auto &history : histories) {
+		if (history->inChatList()
+			&& Supported(history->peer)
+			&& AllLoadedKept(history)) {
+			CheckVanished(history);
+		}
+	}
+}
+
+void SetupKeptTopics(not_null<Data::Forum*> forum) {
+	forum->chatsListLoadedEvents(
+	) | rpl::on_next([=] {
+		RestoreTopics(forum);
+	}, forum->lifetime());
+}
+
+bool KeepDeletedTopic(not_null<Data::Forum*> forum, MsgId rootId) {
+	const auto session = &forum->session();
+	const auto state = Find(session);
+	if (!state) {
+		return false;
+	}
+	const auto key = FullMsgId(forum->peer()->id, rootId);
+	if (state->purgingTopics.remove(key)) {
+		return false;
+	}
+	const auto own = state->ownTopicDeletes.remove(key);
+	if (state->topics.contains(key)
+		|| IsKeptHistory(forum->history())) {
+		return true;
+	} else if (!KeepDeletedChats()
+		|| (own && !KeepDeletedOwn())
+		|| rootId == Data::ForumTopic::kGeneralId
+		|| !Supported(forum->peer())) {
+		return false;
+	}
+	const auto topic = forum->topicFor(rootId);
+	if (!topic || topic->creating()) {
+		return false;
+	}
+	return MarkTopic(topic, own);
+}
+
+bool HandleTopicDelete(not_null<Data::ForumTopic*> topic) {
+	if (!Find(&topic->session()) || !IsKeptThread(topic)) {
+		return false;
+	}
+	PurgeTopic(topic);
+	return true;
+}
+
+void NoteOwnTopicDelete(not_null<Data::Forum*> forum, MsgId rootId) {
+	const auto state = Find(&forum->session());
+	if (state && KeepDeletedChats()) {
+		state->ownTopicDeletes.emplace(FullMsgId(forum->peer()->id, rootId));
+	}
+}
+
+bool KeptTopicIds(
+		not_null<History*> history,
+		MsgId rootId,
+		std::vector<MsgId> &list) {
+	if (Sessions().empty()
+		|| !history->peer->isForum()
+		|| (!IsKeptHistory(history)
+			&& !IsKeptTopicKey(
+				&history->session(),
+				FullMsgId(history->peer->id, rootId)))) {
+		return false;
+	}
+	list.clear();
+	for (const auto &item : KeptTopicItems(history, rootId)) {
+		list.push_back(item->id);
+	}
+	ranges::sort(list, std::greater<>());
+	return true;
+}
+
+int PaintKeptChatMark(
+		QPainter &p,
+		not_null<const Dialogs::Entry*> entry,
+		QPoint position,
+		bool active,
+		bool selected) {
+	if (Sessions().empty()) {
+		return 0;
+	}
+	const auto history = entry->asHistory();
+	const auto topic = entry->asTopic();
+	if (!(history ? IsKeptHistory(history) : IsKeptThread(topic))) {
+		return 0;
+	}
+	const auto pen = p.pen();
+	p.setPen(active
+		? st::dialogsDateFgActive
+		: selected
+		? st::dialogsDateFgOver
+		: st::dialogsDateFg);
+	PaintDeletedIcon(
+		p,
+		position.x() + DeletedIconWidth(),
+		position.y()
+			+ (st::semiboldFont->height - st::msgDateFont->height) / 2);
+	p.setPen(pen);
+	return DeletedIconWidth() + st::dialogsChatTypeSkip;
+}
+
+void AddKeptChatActions(
+		not_null<Window::SessionController*> controller,
+		Data::Thread *thread,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!thread || Sessions().empty() || !IsKeptThread(thread)) {
+		return;
+	}
+	if (const auto topic = thread->asTopic()) {
+		if (topic->canDelete()) {
+			return;
+		}
+		const auto weak = base::make_weak(topic);
+		TagMenuAction(addAction({
+			.text = Lower(u"Delete topic"_q),
+			.handler = [=] {
+				ConfirmDelete(
+					controller,
+					Lower(u"Delete this topic and its kept messages "
+						"from this device?"_q),
+					[=] {
+						if (const auto strong = weak.get()) {
+							PurgeTopic(strong);
+						}
+					});
+			},
+			.icon = &st::menuIconDeleteAttention,
+			.isAttention = true,
+		}), u"kept_delete_topic"_q);
+		return;
+	}
+	const auto history = thread->asHistory();
+	const auto channel = history ? history->peer->asChannel() : nullptr;
+	if (!channel || channel->amIn()) {
+		return;
+	}
+	const auto weak = base::make_weak(history);
+	TagMenuAction(addAction({
+		.text = Lower(u"Delete chat"_q),
+		.handler = [=] {
+			ConfirmDelete(
+				controller,
+				Lower(u"Delete this chat and its kept messages "
+					"from this device?"_q),
+				[=] {
+					if (const auto strong = weak.get()) {
+						[[maybe_unused]] const auto deleted = DeleteKeptChat(
+							strong->peer);
+					}
+				});
+		},
+		.icon = &st::menuIconDeleteAttention,
+		.isAttention = true,
+	}), u"kept_delete_chat"_q);
+}
+
+} // namespace Tele
