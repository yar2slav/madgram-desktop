+namespace Tele {
+namespace {
+
+constexpr auto kUnlockTimeout = crl::time(60'000);
+constexpr auto kResetCountdown = 10;
+constexpr auto kSaltSize = 16;
+constexpr auto kHashSize = 32;
+constexpr auto kArgonMemory = uint32(19456);
+constexpr auto kArgonIterations = uint32(2);
+constexpr auto kPbkdf2Iterations = 200'000;
+
+struct Waiter {
+	Fn<void()> done;
+	Fn<void()> cancelled;
+};
+
+crl::time UnlockedAt = 0;
+std::vector<Waiter> Waiters;
+int Generation = 0;
+bool Asking = false;
+base::weak_qptr<Ui::BoxContent> Prompt;
+
+[[nodiscard]] const char *ActionOption(LocalPasswordAction action) {
+	using Action = LocalPasswordAction;
+	switch (action) {
+	case Action::TransferGifts: return kOptionLocalPasswordTransfer;
+	case Action::ConvertGifts: return kOptionLocalPasswordConvert;
+	case Action::SellGifts: return kOptionLocalPasswordSell;
+	case Action::UpgradeGifts: return kOptionLocalPasswordUpgrade;
+	case Action::BuyGifts: return kOptionLocalPasswordBuy;
+	case Action::SendGifts: return kOptionLocalPasswordSend;
+	case Action::PaidReactions: return kOptionLocalPasswordReactions;
+	case Action::PaidMedia: return kOptionLocalPasswordPaidMedia;
+	case Action::Subscriptions: return kOptionLocalPasswordSubscriptions;
+	}
+	Unexpected("Action in Tele::ActionOption.");
+}
+
+[[nodiscard]] QString Encode(bytes::const_span value) {
+	return QString::fromLatin1(QByteArray(
+		reinterpret_cast<const char*>(value.data()),
+		value.size()).toBase64());
+}
+
+[[nodiscard]] QByteArray Decode(const QString &value) {
+	return QByteArray::fromBase64(value.toLatin1());
+}
+
+[[nodiscard]] std::optional<bytes::vector> Argon2id(
+		bytes::const_span password,
+		bytes::const_span salt,
+		uint32 memory,
+		uint32 iterations) {
+	if (!memory || !iterations) {
+		return std::nullopt;
+	}
+	const auto kdf = EVP_KDF_fetch(nullptr, "ARGON2ID", nullptr);
+	if (!kdf) {
+		return std::nullopt;
+	}
+	const auto context = EVP_KDF_CTX_new(kdf);
+	EVP_KDF_free(kdf);
+	if (!context) {
+		return std::nullopt;
+	}
+	auto lanes = uint32(1);
+	auto threads = uint32(1);
+	auto memcost = memory;
+	auto iter = iterations;
+	OSSL_PARAM params[] = {
+		OSSL_PARAM_construct_octet_string(
+			OSSL_KDF_PARAM_PASSWORD,
+			const_cast<bytes::type*>(password.data()),
+			password.size()),
+		OSSL_PARAM_construct_octet_string(
+			OSSL_KDF_PARAM_SALT,
+			const_cast<bytes::type*>(salt.data()),
+			salt.size()),
+		OSSL_PARAM_construct_uint32(OSSL_KDF_PARAM_ITER, &iter),
+		OSSL_PARAM_construct_uint32("threads", &threads),
+		OSSL_PARAM_construct_uint32("lanes", &lanes),
+		OSSL_PARAM_construct_uint32("memcost", &memcost),
+		OSSL_PARAM_construct_end(),
+	};
+	auto result = bytes::vector(kHashSize);
+	const auto derived = EVP_KDF_derive(
+		context,
+		reinterpret_cast<unsigned char*>(result.data()),
+		result.size(),
+		params);
+	EVP_KDF_CTX_free(context);
+	if (derived != 1) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] QString MakeHash(const QString &password) {
+	const auto utf8 = password.toUtf8();
+	const auto value = bytes::make_span(utf8);
+	auto salt = bytes::vector(kSaltSize);
+	base::RandomFill(salt);
+	const auto argon = Argon2id(
+		value,
+		salt,
+		kArgonMemory,
+		kArgonIterations);
+	if (argon) {
+		return u"argon2id$%1$%2$%3$%4"_q
+			.arg(kArgonMemory)
+			.arg(kArgonIterations)
+			.arg(Encode(salt), Encode(*argon));
+	}
+	const auto pbkdf2 = openssl::Pbkdf2Sha512(
+		value,
+		salt,
+		kPbkdf2Iterations);
+	return u"pbkdf2-sha512$%1$%2$%3"_q
+		.arg(kPbkdf2Iterations)
+		.arg(Encode(salt), Encode(pbkdf2));
+}
+
+[[nodiscard]] bool Matches(const QString &password) {
+	if (password.isEmpty()) {
+		return false;
+	}
+	const auto parts = LocalPasswordHash().split('$');
+	const auto utf8 = password.toUtf8();
+	const auto value = bytes::make_span(utf8);
+	auto computed = std::optional<bytes::vector>();
+	auto expected = QByteArray();
+	if (parts.size() == 5 && parts[0] == u"argon2id"_q) {
+		const auto salt = Decode(parts[3]);
+		expected = Decode(parts[4]);
+		computed = Argon2id(
+			value,
+			bytes::make_span(salt),
+			parts[1].toUInt(),
+			parts[2].toUInt());
+	} else if (parts.size() == 4 && parts[0] == u"pbkdf2-sha512"_q) {
+		const auto iterations = parts[1].toInt();
+		const auto salt = Decode(parts[2]);
+		expected = Decode(parts[3]);
+		if (iterations > 0) {
+			computed = openssl::Pbkdf2Sha512(
+				value,
+				bytes::make_span(salt),
+				iterations);
+		}
+	}
+	return computed
+		&& !expected.isEmpty()
+		&& (computed->size() == size_t(expected.size()))
+		&& !CRYPTO_memcmp(
+			computed->data(),
+			expected.constData(),
+			expected.size());
+}
+
+[[nodiscard]] bool Unlocked() {
+	return UnlockedAt && (crl::now() - UnlockedAt < kUnlockTimeout);
+}
+
+void Resolve(int generation, bool success) {
+	if (!Asking || generation != Generation) {
+		return;
+	}
+	Asking = false;
+	Prompt = nullptr;
+	auto waiters = base::take(Waiters);
+	for (auto &waiter : waiters) {
+		if (success) {
+			if (waiter.done) {
+				waiter.done();
+			}
+		} else if (waiter.cancelled) {
+			waiter.cancelled();
+		}
+	}
+}
+
+void Drop(int generation) {
+	if (Asking && generation == Generation) {
+		Asking = false;
+		Prompt = nullptr;
+		Waiters.clear();
+	}
+}
+
+void ClearLocalPassword() {
+	SetLocalPasswordHash(QString());
+	UnlockedAt = 0;
+	if (const auto box = Prompt.get()) {
+		box->closeBox();
+	}
+}
+
+[[nodiscard]] not_null<rpl::variable<QString>*> AddError(
+		not_null<Ui::GenericBox*> box) {
+	const auto error = box->lifetime().make_state<rpl::variable<QString>>();
+	const auto wrap = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			box,
+			object_ptr<Ui::FlatLabel>(
+				box,
+				error->value(),
+				st::changePhoneError)));
+	wrap->hide(anim::type::instant);
+	wrap->toggleOn(error->value() | rpl::map([](const QString &text) {
+		return !text.isEmpty();
+	}));
+	return error;
+}
+
+[[nodiscard]] not_null<Ui::PasswordInput*> AddField(
+		not_null<Ui::GenericBox*> box,
+		const QString &placeholder) {
+	auto container = object_ptr<Ui::RpWidget>(box);
+	const auto raw = container.data();
+	const auto field = Ui::CreateChild<Ui::PasswordInput>(
+		raw,
+		st::defaultInputField,
+		rpl::single(placeholder));
+	raw->resize(raw->width(), field->height());
+	raw->widthValue() | rpl::on_next([=](int width) {
+		field->resize(width, field->height());
+		field->moveToLeft(0, 0);
+	}, raw->lifetime());
+	box->addRow(std::move(container));
+	return field;
+}
+
+void OnSubmit(not_null<Ui::PasswordInput*> field, Fn<void()> callback) {
+	QObject::connect(
+		field,
+		&Ui::MaskedInputField::submitted,
+		[=](Qt::KeyboardModifiers) { callback(); });
+}
+
+void ResetWithCloudBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show,
+		QString hint) {
+	box->setTitle(rpl::single(Lower(u"Reset local password"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Enter the cloud password of your Telegram account."_q),
+		st::boxLabel));
+	const auto field = AddField(
+		box,
+		hint.isEmpty() ? Lower(u"Cloud password"_q) : hint);
+	const auto error = AddError(box);
+	const auto checking = box->lifetime().make_state<bool>(false);
+	const auto submit = [=] {
+		if (*checking) {
+			return;
+		}
+		const auto text = field->getLastText();
+		if (text.isEmpty()) {
+			field->showError();
+			return;
+		}
+		*checking = true;
+		const auto weak = base::make_weak(box);
+		show->session().api().cloudPassword().check(
+			text
+		) | rpl::on_error_done([=](const QString &type) {
+			if (!weak) {
+				return;
+			}
+			*checking = false;
+			field->showError();
+			field->selectAll();
+			*error = (type == u"PASSWORD_HASH_INVALID"_q)
+				? Lower(u"Wrong password."_q)
+				: type.startsWith(u"FLOOD_WAIT_"_q)
+				? Lower(u"Too many tries, try again later."_q)
+				: type;
+		}, [=] {
+			ClearLocalPassword();
+			if (const auto strong = weak.get()) {
+				strong->closeBox();
+			}
+			show->showToast(Lower(u"Local password removed."_q));
+		}, box->lifetime());
+	};
+	OnSubmit(field, submit);
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(
+		rpl::single(Lower(u"Reset"_q)),
+		submit,
+		st::attentionBoxButton);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void ResetWithCountdownBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show) {
+	box->setTitle(rpl::single(Lower(u"Reset local password"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Gifts and stars stop asking for a password."_q),
+		st::boxLabel));
+	const auto left = box->lifetime().make_state<rpl::variable<int>>(
+		kResetCountdown);
+	const auto timer = box->lifetime().make_state<base::Timer>();
+	timer->setCallback([=] {
+		*left = std::max(left->current() - 1, 0);
+		if (!left->current()) {
+			timer->cancel();
+		}
+	});
+	timer->callEach(1000);
+	box->addButton(left->value() | rpl::map([](int seconds) {
+		return seconds
+			? Lower(u"Reset (%1)"_q).arg(seconds)
+			: Lower(u"Reset"_q);
+	}), [=] {
+		if (left->current()) {
+			return;
+		}
+		ClearLocalPassword();
+		box->closeBox();
+		show->showToast(Lower(u"Local password removed."_q));
+	}, st::attentionBoxButton);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void ShowReset(std::shared_ptr<Main::SessionShow> show) {
+	const auto session = &show->session();
+	const auto open = [=](const Core::CloudPasswordState &state) {
+		if (state.hasPassword) {
+			show->show(Box(ResetWithCloudBox, show, state.hint));
+		} else {
+			show->show(Box(ResetWithCountdownBox, show));
+		}
+	};
+	auto &cloud = session->api().cloudPassword();
+	if (const auto state = cloud.stateCurrent()) {
+		open(*state);
+		return;
+	}
+	cloud.state(
+	) | rpl::take(1) | rpl::on_next(open, session->lifetime());
+	cloud.reload();
+}
+
+void AddForgot(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show) {
+	const auto link = box->addRow(
+		object_ptr<Ui::LinkButton>(
+			box,
+			Lower(u"Forgot password?"_q)),
+		style::al_left);
+	link->setClickedCallback([=] {
+		ShowReset(show);
+	});
+}
+
+void PromptBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show,
+		int generation) {
+	box->setTitle(rpl::single(Lower(u"Local password"_q)));
+	const auto field = AddField(box, Lower(u"Password"_q));
+	const auto error = AddError(box);
+	AddForgot(box, show);
+	const auto submit = [=] {
+		if (Matches(field->getLastText())) {
+			UnlockedAt = crl::now();
+			const auto weak = base::make_weak(box);
+			Resolve(generation, true);
+			if (const auto strong = weak.get()) {
+				strong->closeBox();
+			}
+			return;
+		}
+		field->showError();
+		field->selectAll();
+		*error = Lower(u"Wrong password."_q);
+	};
+	OnSubmit(field, submit);
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_continue(), submit);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->boxClosing() | rpl::on_next([=] {
+		Resolve(generation, false);
+	}, box->lifetime());
+	box->lifetime().add([=] {
+		Drop(generation);
+	});
+}
+
+void Ask(
+		std::shared_ptr<Main::SessionShow> show,
+		Fn<void()> done,
+		Fn<void()> cancelled) {
+	Waiters.push_back({ std::move(done), std::move(cancelled) });
+	if (Asking) {
+		return;
+	}
+	Asking = true;
+	const auto generation = ++Generation;
+	if (!show->valid()) {
+		Drop(generation);
+		return;
+	}
+	Prompt = show->show(Box(PromptBox, show, generation));
+}
+
+[[nodiscard]] std::optional<LocalPasswordAction> FormAction(
+		not_null<Main::Session*> session,
+		const Payments::CreditsFormData &form) {
+	if (form.invoice.subscriptionPeriod) {
+		return LocalPasswordAction::Subscriptions;
+	}
+	const auto message = std::get_if<Payments::InvoiceMessage>(
+		&form.id.value);
+	const auto item = message
+		? session->data().message(message->peer, message->itemId)
+		: nullptr;
+	const auto media = item ? item->media() : nullptr;
+	const auto invoice = media ? media->invoice() : nullptr;
+	if (invoice && invoice->isPaidMedia) {
+		return LocalPasswordAction::PaidMedia;
+	}
+	return std::nullopt;
+}
+
+} // namespace
+
+bool LocalPasswordSet() {
+	return !LocalPasswordHash().isEmpty();
+}
+
+rpl::producer<bool> LocalPasswordSetValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		LocalPasswordHashChanges()
+	) | rpl::map([] {
+		return LocalPasswordSet();
+	});
+}
+
+bool LocalPasswordNeeded(LocalPasswordAction action) {
+	return LocalPasswordSet()
+		&& base::options::lookup<bool>(ActionOption(action)).value()
+		&& !Unlocked();
+}
+
+void RequireLocalPassword(
+		std::shared_ptr<Main::SessionShow> show,
+		LocalPasswordAction action,
+		Fn<void()> done,
+		Fn<void()> cancelled) {
+	if (!LocalPasswordNeeded(action)) {
+		if (done) {
+			done();
+		}
+		return;
+	}
+	Ask(std::move(show), std::move(done), std::move(cancelled));
+}
+
+bool InterceptLocalPassword(
+		std::shared_ptr<Main::SessionShow> show,
+		LocalPasswordAction action,
+		Fn<void()> retry,
+		Fn<void()> cancelled) {
+	if (!LocalPasswordNeeded(action)) {
+		return false;
+	}
+	Ask(std::move(show), std::move(retry), std::move(cancelled));
+	return true;
+}
+
+void RequireLocalPasswordForForm(
+		std::shared_ptr<Main::SessionShow> show,
+		const Payments::CreditsFormData &form,
+		Fn<void()> done) {
+	if (const auto action = FormAction(&show->session(), form)) {
+		RequireLocalPassword(std::move(show), *action, std::move(done));
+	} else if (done) {
+		done();
+	}
+}
+
+void ConfirmLocalPassword(
+		std::shared_ptr<Main::SessionShow> show,
+		Fn<void()> done,
+		Fn<void()> cancelled) {
+	if (!LocalPasswordSet() || Unlocked()) {
+		if (done) {
+			done();
+		}
+		return;
+	}
+	Ask(std::move(show), std::move(done), std::move(cancelled));
+}
+
+void LocalPasswordBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show) {
+	const auto set = LocalPasswordSet();
+	box->setTitle(rpl::single(Lower(u"Local password"_q)));
+	const auto current = set
+		? AddField(box, Lower(u"Current password"_q)).get()
+		: nullptr;
+	if (set) {
+		AddForgot(box, show);
+	}
+	const auto password = AddField(
+		box,
+		Lower(set ? u"New password"_q : u"Password"_q));
+	const auto repeat = AddField(box, Lower(u"Repeat password"_q));
+	const auto error = AddError(box);
+	const auto checkCurrent = [=] {
+		if (!current || Matches(current->getLastText())) {
+			return true;
+		}
+		current->showError();
+		current->selectAll();
+		*error = Lower(u"Wrong password."_q);
+		return false;
+	};
+	const auto save = [=] {
+		if (!checkCurrent()) {
+			return;
+		}
+		const auto value = password->getLastText();
+		if (value.isEmpty()) {
+			password->showError();
+			return;
+		} else if (repeat->getLastText() != value) {
+			repeat->showError();
+			*error = Lower(u"Passwords don't match."_q);
+			return;
+		}
+		SetLocalPasswordHash(MakeHash(value));
+		UnlockedAt = 0;
+		box->closeBox();
+		show->showToast(set
+			? Lower(u"Local password changed."_q)
+			: Lower(u"Local password set."_q));
+	};
+	if (current) {
+		OnSubmit(current, [=] {
+			password->setFocus();
+		});
+	}
+	OnSubmit(password, [=] {
+		repeat->setFocus();
+	});
+	OnSubmit(repeat, save);
+	box->setFocusCallback([=] {
+		if (current) {
+			current->setFocusFast();
+		} else {
+			password->setFocusFast();
+		}
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	if (set) {
+		box->addLeftButton(rpl::single(Lower(u"Remove"_q)), [=] {
+			if (!checkCurrent()) {
+				return;
+			}
+			ClearLocalPassword();
+			box->closeBox();
+			show->showToast(Lower(u"Local password removed."_q));
+		}, st::attentionBoxButton);
+	}
+}
+
+} // namespace Tele
