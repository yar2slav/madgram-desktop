+void AddLocalPasswordAction(SectionBuilder &builder, const char id[]) {
+	auto &option = base::options::lookup<bool>(id);
+	const auto name = ::Tele::Lower(option.name());
+	WithParent(builder, option.id(), name, ::Tele::kOptionLocalPassword, [&] {
+		if (!Shown(option.id())) {
+			return;
+		}
+		builder.add([&](const WidgetContext &ctx) {
+			const auto controller = ctx.controller;
+			auto result = object_ptr<Button>(
+				ctx.container,
+				rpl::single(name),
+				st::settingsButtonNoIcon);
+			const auto button = result.data();
+			const auto reverts = button->lifetime().make_state<
+				rpl::event_stream<bool>>();
+			button->toggleOn(rpl::merge(
+				rpl::single(
+					rpl::empty
+				) | rpl::then(
+					option.changes()
+				) | rpl::map([&option] {
+					return option.value();
+				}),
+				reverts->events()));
+			button->toggledChanges(
+			) | rpl::filter([&option](bool toggled) {
+				return (toggled != option.value());
+			}) | rpl::on_next([=, &option](bool toggled) {
+				if (toggled) {
+					option.set(true);
+					return;
+				}
+				reverts->fire(true);
+				::Tele::ConfirmLocalPassword(controller->uiShow(), [&option] {
+					option.set(false);
+				});
+			}, button->lifetime());
+			SetupLink(button, option.id());
+			return SectionBuilder::WidgetToAdd{
+				.widget = std::move(result),
+				.align = style::al_justify,
+			};
+		}, [&] {
+			return SearchEntry{
+				.id = option.id(),
+				.title = name,
+				.keywords = { u"local password"_q },
+			};
+		});
+	});
+}
+
+void AddLocalPassword(SectionBuilder &builder) {
+	const auto controller = builder.controller();
+	const auto id = QString::fromLatin1(::Tele::kOptionLocalPassword);
+	const auto description = ::Tele::Lower(u"Asked before stars are spent "
+		"or gifts leave your account, kept on this device only."_q);
+	const auto button = AddButton(builder, {
+		.id = id,
+		.title = rpl::single(::Tele::Lower(u"Local password"_q)),
+		.st = &st::settingsButtonNoIcon,
+		.label = ::Tele::LocalPasswordSetValue(
+		) | rpl::map([](bool set) {
+			return set ? u"on"_q : u"off"_q;
+		}),
+		.onClick = [=] {
+			controller->show(
+				Box(::Tele::LocalPasswordBox, controller->uiShow()));
+		},
+		.keywords = {
+			description,
+			u"pin"_q,
+			u"passcode"_q,
+			u"2fa"_q,
+			u"lock"_q,
+		},
+	});
+	if (button) {
+		SetupLink(button, id);
+	}
+	AddAbout(builder, id, description);
+	for (const auto option : {
+		::Tele::kOptionLocalPasswordTransfer,
+		::Tele::kOptionLocalPasswordConvert,
+		::Tele::kOptionLocalPasswordSell,
+		::Tele::kOptionLocalPasswordUpgrade,
+		::Tele::kOptionLocalPasswordBuy,
+		::Tele::kOptionLocalPasswordSend,
+		::Tele::kOptionLocalPasswordReactions,
+		::Tele::kOptionLocalPasswordPaidMedia,
+		::Tele::kOptionLocalPasswordSubscriptions,
+	}) {
+		AddLocalPasswordAction(builder, option);
+	}
+}
+
 void FillPrivacy(SectionBuilder &builder) {
 	AddSkip(builder);
 	AddGroupTitle(builder, u"Ghost mode"_q);
@@ -3077,6 +3175,9 @@ void FillPrivacy(SectionBuilder &builder) {
 				u"Screen capture can't be blocked on this system."_q));
 	}
 	AddOptionToggle(builder, ::Tele::kOptionStreamerModeInMenu);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Local password"_q);
+	AddLocalPassword(builder);
 	AddSkip(builder);
 }
 
