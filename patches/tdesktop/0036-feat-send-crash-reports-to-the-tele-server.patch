 .../SourceFiles/core/crash_report_window.cpp   | 18 ++++++++++++++----
 Telegram/SourceFiles/core/crash_reports.cpp    |  2 ++
 Telegram/SourceFiles/tele/tele_crash.cpp       | 18 ++++++++++++++++++
 Telegram/SourceFiles/tele/tele_crash.h         |  8 ++++++++
 5 files changed, 44 insertions(+), 4 deletions(-)
 create mode 100644 Telegram/SourceFiles/tele/tele_crash.cpp
 create mode 100644 Telegram/SourceFiles/tele/tele_crash.h

diff --git a/Telegram/CMakeLists.txt b/Telegram/CMakeLists.txt
index 8e06c0b9ce052fd58a8d0b73306a45b4c2aafd21..4fb02b6d25b6d5628d32d96a78afabf623520b83 100644
