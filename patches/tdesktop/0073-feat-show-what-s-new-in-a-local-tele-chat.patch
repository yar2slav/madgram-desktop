+		auto buildOk = false;
+		const auto id = pair[0].trimmed().toULongLong(&idOk);
+		const auto build = pair[1].trimmed().toInt(&buildOk);
+		if (idOk && buildOk && id && !(id & kTestBit) && build > 0) {
