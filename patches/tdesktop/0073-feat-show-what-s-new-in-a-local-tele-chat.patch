+		user->notify().resetToDefault();
+	}
+	return user;
+}
+
+[[nodiscard]] not_null<History*> EnsureHistory(not_null<UserData*> user) {
+	const auto history = user->owner().history(user);
+	if (!history->folderKnown()) {
+		history->applyDialogFields(nullptr, 0, 0, 0);
+		history->dialogEntryApplied();
+	}
+	return history;
+}
+
+void MarkRead(not_null<History*> history) {
+	history->owner().histories().readInbox(history);
+}
+
+void ConfirmDelete(
+		not_null<Window::SessionController*> controller,
+		not_null<History*> history) {
+	const auto weak = base::make_weak(history.get());
+	controller->show(Ui::MakeConfirmBox({
+		.text = Lower(u"Delete the tele chat? It exists only on this "
+			"device."_q),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			if (const auto strong = weak.get()) {
+				strong->owner().deleteConversationLocally(strong->peer);
+			}
+		},
+		.confirmText = Lower(u"Delete"_q),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+void ProfileBox(not_null<Ui::GenericBox*> box, not_null<UserData*> user) {
+	const auto &st = st::infoProfileCover;
+	const auto cover = box->addRow(
+		object_ptr<Ui::FixedHeightWidget>(box, st.height),
+		style::margins());
+	const auto view = cover->lifetime().make_state<Ui::PeerUserpicView>();
+	cover->paintRequest(
+	) | rpl::on_next([=] {
+		auto p = QPainter(cover);
+		const auto skip = (st.photo.size.width() - st.photo.photoSize) / 2;
+		user->paintUserpic(p, *view, {
+			.position = QPoint(st.photoLeft + skip, st.photoTop + skip),
+			.size = st.photo.photoSize,
+		});
+	}, cover->lifetime());
+	const auto name = Ui::CreateChild<Ui::FlatLabel>(
+		cover,
+		user->name(),
+		st.name);
+	name->moveToLeft(st.nameLeft, st.nameTop);
+	const auto verified = Ui::CreateChild<Ui::RpWidget>(cover);
+	verified->resize(st::infoVerifiedStar.size());
+	verified->setAttribute(Qt::WA_TransparentForMouseEvents);
+	verified->paintRequest(
+	) | rpl::on_next([=] {
+		auto p = QPainter(verified);
+		st::infoVerifiedStar.paint(p, 0, 0, verified->width());
+		st::infoVerifiedCheck.paint(p, 0, 0, verified->width());
+	}, verified->lifetime());
+	name->geometryValue(
+	) | rpl::on_next([=](QRect geometry) {
+		verified->moveToLeft(
+			geometry.x() + geometry.width() + st::normalFont->spacew,
+			geometry.y() + (geometry.height() - verified->height()) / 2);
+	}, verified->lifetime());
+	const auto status = Ui::CreateChild<Ui::FlatLabel>(
+		cover,
+		StatusText(),
+		st.status);
+	status->moveToLeft(st.statusLeft, st.statusTop);
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Release notes of tele, only on this device."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(box->verticalLayout());
+	const auto link = [=](
+			const QString &text,
+			const style::icon &icon,
+			const QString &url) {
+		Settings::AddButtonWithIcon(
+			box->verticalLayout(),
+			rpl::single(Lower(text)),
+			st::settingsButton,
+			{ &icon }
+		)->addClickHandler([=] {
+			box->closeBox();
+			UrlClickHandler::Open(url);
+		});
+	};
+	link(
+		u"tele on GitHub"_q,
+		st::menuIconLink,
+		u"https://github.com/nitreojs/tele"_q);
+	link(
+		u"Updates channel"_q,
+		st::menuIconChannel,
+		u"https://t.me/teleAppUpdates"_q);
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+void ShowProfile(
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> user) {
+	controller->show(Box(ProfileBox, user));
+}
+
+} // namespace
+
+bool IsChangelogPeer(const PeerData *peer) {
+	return peer && (peer->id == ChangelogPeerId());
+}
+
+QImage *ChangelogUserpic(not_null<const PeerData*> peer) {
+	if (!IsChangelogPeer(peer)) {
+		return nullptr;
+	}
+	static auto result = QImage(u":/gui/art/tele_userpic.jpg"_q).scaled(
+		kUserpicSize,
+		kUserpicSize,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation
+	).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+	return &result;
+}
+
+std::optional<QString> ChangelogStatus(not_null<const UserData*> user) {
+	return IsChangelogPeer(user) ? StatusText() : std::optional<QString>();
+}
+
+[[nodiscard]] HistoryMessageMarkupData UrlButton(
+		const ChangelogMessage &message) {
+	auto result = HistoryMessageMarkupData();
+	if (message.buttonUrl.isEmpty()) {
+		return result;
+	}
+	using Button = HistoryMessageMarkupButton;
+	result.rows.push_back({ Button(
+		Button::Type::Url,
+		message.buttonText,
+		Button::Visual(),
+		message.buttonUrl.toUtf8()) });
+	result.flags = ReplyMarkupFlag::Inline;
+	return result;
+}
+
+void PostChangelog(
+		not_null<Main::Session*> session,
+		const std::vector<ChangelogMessage> &messages) {
+	const auto user = EnsureUser(session);
+	const auto history = EnsureHistory(user);
+	const auto owner = &session->data();
+	const auto date = base::unixtime::now();
+	for (const auto &message : messages) {
+		const auto item = history->makeMessage({
+			.id = owner->nextLocalMessageId(),
+			.flags = MessageFlag::ClientSideUnread | MessageFlag::Local,
+			.from = user->id,
+			.date = date,
+			.markup = UrlButton(message),
+		}, message.text, MTP_messageMediaEmpty());
+		if (message.rich) {
+			item->applyLocalRichPage(message.rich);
+		}
+		history->addNewLocalMessage(item);
+	}
+	owner->sendHistoryChangeNotifications();
+}
+
+bool ShowChangelogChat(
+		not_null<Window::SessionController*> controller,
+		PeerId peerId,
+		const Window::SectionShow &params) {
+	if (peerId != ChangelogPeerId()) {
+		return false;
+	}
+	const auto history = controller->session().data().historyLoaded(peerId);
+	if (history && !history->clientSideMessages().empty()) {
+		controller->showSection(
+			std::make_shared<ChangelogMemento>(history),
+			params);
+	}
+	return true;
+}
+
+bool ShowChangelogProfile(
+		not_null<Window::SessionController*> controller,
+		not_null<Window::SectionMemento*> memento) {
+	const auto info = dynamic_cast<Info::Memento*>(memento.get());
+	if (!info || !info->stackSize()) {
+		return false;
+	}
+	const auto peer = info->content()->peer();
+	if (!IsChangelogPeer(peer)) {
+		return false;
+	}
+	ShowProfile(controller, peer->asUser());
+	return true;
+}
+
+bool FillChangelogMenu(
+		not_null<Window::SessionController*> controller,
+		const Dialogs::EntryState &request,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto history = request.key.history();
+	if (!history || !IsChangelogPeer(history->peer)) {
+		return false;
+	}
+	if (history->unreadCount() > 0) {
+		addAction(tr::lng_context_mark_read(tr::now), [=] {
+			MarkRead(history);
+		}, &st::menuIconMarkRead);
+	}
+	if (request.section != Dialogs::EntryState::Section::Profile) {
+		const auto user = history->peer->asUser();
+		addAction(tr::lng_context_view_profile(tr::now), [=] {
+			ShowProfile(controller, user);
+		}, &st::menuIconProfile);
+	}
+	addAction({
+		.text = tr::lng_profile_delete_conversation(tr::now),
+		.handler = [=] { ConfirmDelete(controller, history); },
+		.icon = &st::menuIconDeleteAttention,
+		.isAttention = true,
+	});
+	return true;
+}
+
+bool PerformChangelogQuickAction(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer,
+		Dialogs::Ui::QuickDialogAction action) {
+	if (!IsChangelogPeer(peer)) {
+		return false;
+	}
+	using Action = Dialogs::Ui::QuickDialogAction;
+	const auto history = peer->owner().history(peer);
+	if (action == Action::Read) {
+		MarkRead(history);
+	} else if (action == Action::Delete) {
+		ConfirmDelete(controller, history);
+	}
+	return true;
+}
+
+bool SkipChangelogDialogEntry(
+		not_null<History*> history,
+		Fn<void()> callback) {
+	if (!IsChangelogPeer(history->peer)) {
+		return false;
+	}
+	if (!history->folderKnown()) {
+		history->clearFolder();
+	}
+	history->dialogEntryApplied();
+	if (callback) {
+		crl::on_main(&history->session(), std::move(callback));
+	}
+	return true;
+}
+
+} // namespace Tele
