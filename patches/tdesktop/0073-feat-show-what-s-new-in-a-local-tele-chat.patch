+ChangelogWidget::ChangelogWidget(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller,
+	not_null<History*> history)
+: Window::SectionWidget(parent, controller, history->peer)
+, HistoryView::WindowListDelegate(controller)
+, _history(history)
+, _topBar(this, controller)
+, _topBarShadow(this)
+, _scroll(std::make_unique<Ui::ElasticScroll>(
+	this,
+	controller->chatStyle()->value(lifetime(), st::historyScroll))) {
+	controller->chatStyle()->paletteChanged(
+	) | rpl::on_next([=] {
+		_scroll->updateBars();
+	}, _scroll->lifetime());
+
+	Window::ChatThemeValueFromPeer(
+		controller,
+		history->peer
+	) | rpl::on_next([=](std::shared_ptr<Ui::ChatTheme> &&theme) {
+		_theme = std::move(theme);
+		controller->setChatStyleTheme(_theme);
+	}, lifetime());
+
+	_topBar->setActiveChat(
+		TopBarWidget::ActiveChat{
+			.key = _history,
+			.section = Dialogs::EntryState::Section::History,
+		},
+		nullptr);
+
+	_topBar->move(0, 0);
+	_topBar->resizeToWidth(width());
+	_topBar->show();
+
+	_topBar->deleteSelectionRequest(
+	) | rpl::on_next([=] {
+		confirmDeleteSelected();
+	}, _topBar->lifetime());
+	_topBar->clearSelectionRequest(
+	) | rpl::on_next([=] {
+		clearSelected();
+	}, _topBar->lifetime());
+	setupSearch();
+
+	_topBarShadow->raise();
+	controller->adaptive().value(
+	) | rpl::on_next([=] {
+		updateAdaptiveLayout();
+	}, lifetime());
+
+	_scroll->setHandleTouch(false);
+	_inner = _scroll->setOwnedWidget(object_ptr<ListWidget>(
+		this,
+		&controller->session(),
+		static_cast<ListDelegate*>(this)));
+	_inner->lower();
+	_scroll->move(0, _topBar->height());
+	_scroll->show();
+	_scroll->setOverscrollBg(QColor(0, 0, 0, 0));
+	_scroll->setOverscrollEdges([=] {
+		return _inner->loadedAtTopKnown() && _inner->loadedAtTop();
+	}, [=] {
+		return _inner->loadedAtBottomKnown() && _inner->loadedAtBottom();
+	});
+	_scroll->scrolls(
+	) | rpl::on_next([=] {
+		onScroll();
+	}, lifetime());
+
+	_inner->scrollKeyEvents(
+	) | rpl::on_next([=](not_null<QKeyEvent*> e) {
+		_scroll->keyPressEvent(e);
+	}, lifetime());
+
+	const auto owner = &_history->owner();
+	owner->newItemAdded(
+	) | rpl::filter([=](not_null<HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+		markRead();
+	}, lifetime());
+	owner->itemRemoved(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+	owner->historyCleared(
+	) | rpl::filter([=](not_null<const History*> history) {
+		return (history == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+
+	Window::SetupSwipeBackSection(this, _scroll.get(), _inner);
+
+	crl::on_main(this, [=] {
+		markRead();
+	});
+}
+
+void ChangelogWidget::setupSearch() {
+	_topBar->searchRequest(
+	) | rpl::on_next([=] {
+		_topBar->toggleSearch(true, anim::type::normal);
+	}, _topBar->lifetime());
+	_topBar->searchCancelled(
+	) | rpl::on_next([=] {
+		cancelSearch();
+	}, _topBar->lifetime());
+	_topBar->searchQuery(
+	) | rpl::on_next([=](const QString &query) {
+		const auto now = query.trimmed();
+		if (_query != now) {
+			_query = now;
+			_refreshes.fire({});
+		}
+	}, _topBar->lifetime());
+}
+
+void ChangelogWidget::cancelSearch() {
+	_topBar->searchClear();
+	_topBar->toggleSearch(false, anim::type::normal);
+	doSetInnerFocus();
+}
+
+void ChangelogWidget::scheduleRefresh() {
+	if (_refreshScheduled) {
+		return;
+	}
+	_refreshScheduled = true;
+	crl::on_main(this, [=] {
+		_refreshScheduled = false;
+		if (items().empty()) {
+			controller()->showBackFromStack();
+			return;
+		}
+		_refreshes.fire({});
+	});
+}
+
+void ChangelogWidget::markRead() {
+	if (_history->unreadCount() > 0) {
+		_history->owner().histories().readInbox(_history);
+	}
+}
+
+std::vector<not_null<HistoryItem*>> ChangelogWidget::items() const {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &item : _history->clientSideMessages()) {
+		if (item->isHistoryEntry()) {
+			result.push_back(item);
+		}
+	}
+	ranges::sort(result, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return a->id < b->id;
+	});
+	return result;
+}
+
+Data::MessagesSlice ChangelogWidget::buildSlice(
+		Data::MessagePosition aroundId) const {
+	auto items = this->items();
+	if (!_query.isEmpty()) {
+		const auto skip = [&](not_null<HistoryItem*> item) {
+			return !item->originalText().text.contains(
+				_query,
+				Qt::CaseInsensitive);
+		};
+		items.erase(ranges::remove_if(items, skip), end(items));
+	}
+	auto result = Data::MessagesSlice();
+	const auto size = int(items.size());
+	result.fullCount = size;
+	result.skippedBefore = result.skippedAfter = 0;
+	if (!size) {
+		return result;
+	}
+	const auto i = ranges::find(
+		items,
+		aroundId.fullId,
+		&HistoryItem::fullId);
+	result.nearestToAround = ((i != end(items)) ? *i : items.front())
+		->fullId();
+	result.ids.reserve(size);
+	for (const auto &item : items) {
+		result.ids.push_back(item->fullId());
+	}
+	return result;
+}
