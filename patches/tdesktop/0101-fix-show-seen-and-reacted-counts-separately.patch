+#include "tele/tele_who_read.h"
+
+#include "lang/lang_keys.h"
+#include "ui/controls/who_reacted_context_action.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool WithReadReceipts(Ui::WhoReadType type) {
+	return (type == Ui::WhoReadType::Seen)
+		|| (type == Ui::WhoReadType::Listened)
+		|| (type == Ui::WhoReadType::Watched);
+}
+
+[[nodiscard]] QString SeenPart(Ui::WhoReadType type, int count) {
+	return (type == Ui::WhoReadType::Listened)
+		? tr::lng_context_seen_listened(tr::now, lt_count, count)
+		: (type == Ui::WhoReadType::Watched)
+		? tr::lng_context_seen_watched(tr::now, lt_count, count)
+		: tr::lng_context_seen_text(tr::now, lt_count, count);
+}
+
+[[nodiscard]] QString Join(Ui::WhoReadType type, int seen, int reacted) {
+	return SeenPart(type, seen)
+		+ QString::fromUtf8(" \xC2\xB7 ")
+		+ tr::lng_context_seen_reacted(tr::now, lt_count_short, reacted);
+}
+
+} // namespace
+
+QString SeenReactedText(const Ui::WhoReadContent &content) {
+	if (content.state == Ui::WhoReadState::Unknown
+		|| !WithReadReceipts(content.type)) {
+		return QString();
+	}
+	auto reactors = base::flat_set<uint64>();
+	auto readers = base::flat_set<uint64>();
+	auto entries = 0;
+	for (const auto &participant : content.participants) {
+		if (participant.reaction.empty()) {
+			readers.emplace(participant.id);
+		} else {
+			reactors.emplace(participant.id);
+			++entries;
+		}
+	}
+	for (const auto id : reactors) {
+		readers.remove(id);
+	}
+	const auto reacted = (entries < content.fullReactionsCount)
+		? std::max(int(reactors.size()), content.fullReactionsCount)
+		: int(reactors.size());
+	const auto seenOnly = int(readers.size());
+	return (reacted > 0 && seenOnly > 0)
+		? Join(content.type, reacted + seenOnly, reacted)
+		: QString();
+}
+
+QString SeenReactedMaxText(const Ui::WhoReadContent &content) {
+	return (WithReadReceipts(content.type) && content.fullReactionsCount > 0)
+		? Join(content.type, 999, content.fullReactionsCount)
+		: QString();
+}
+
+} // namespace Tele
