+bool Preview::handleKey(int key) {
+	if (rows() < 2 || !allowed()) {
+		return false;
+	} else if (key == Qt::Key_Up) {
+		if (_selected < 0) {
+			auto cursor = _field->textCursor();
+			if (cursor.movePosition(QTextCursor::Up)) {
+				return false;
+			}
+			select(rows() - 1);
+		} else {
+			select(std::max(_selected - 1, 0));
+		}
+		return true;
+	} else if (key == Qt::Key_Down) {
+		if (_selected < 0) {
+			return false;
+		}
+		select((_selected + 1 < rows()) ? (_selected + 1) : -1);
+		return true;
+	} else if ((key == Qt::Key_Enter || key == Qt::Key_Return)
+		&& (_selected >= 0)) {
+		sendRow(_selected);
+		return true;
+	}
+	return false;
+}
