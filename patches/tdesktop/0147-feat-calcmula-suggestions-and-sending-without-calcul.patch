+void CalcmulaMenu(
+		not_null<Ui::InputField*> field,
+		SendMenu::Details &details) {
+	const auto sender = FindSender(field);
+	if (!sender || !sender->active()) {
+		return;
+	}
+	const auto weak = QPointer<Sender>(sender);
+	const auto previous = details.teleMenu;
+	details.teleMenu = [=](not_null<Ui::PopupMenu*> menu) {
+		if (weak) {
+			menu->addAction(
+				Lower(u"Send without calculating"_q),
+				crl::guard(weak.data(), [=] {
+					if (weak->active()) {
+						weak->send();
+					}
+				}),
+				&st::menuIconSend);
+		}
+		if (previous) {
+			previous(menu);
+		}
+	};
+}
