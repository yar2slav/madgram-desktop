+MTPMessagesFilter SearchTypeFilter(Api::SearchFilter filter) {
+	switch (filter) {
+	case Filter::Photo: return MTP_inputMessagesFilterPhotos();
+	case Filter::Video: return MTP_inputMessagesFilterVideo();
+	case Filter::File: return MTP_inputMessagesFilterDocument();
+	case Filter::Music: return MTP_inputMessagesFilterMusic();
+	case Filter::Voice: return MTP_inputMessagesFilterVoice();
+	case Filter::RoundVideo: return MTP_inputMessagesFilterRoundVideo();
+	case Filter::Gif: return MTP_inputMessagesFilterGif();
+	case Filter::Url: return MTP_inputMessagesFilterUrl();
+	case Filter::Pinned: return MTP_inputMessagesFilterPinned();
+	case Filter::NoFilter: break;
+	}
+	return MTP_inputMessagesFilterEmpty();
+}
