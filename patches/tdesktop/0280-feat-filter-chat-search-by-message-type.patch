+bool MatchesSearchType(
+		not_null<HistoryItem*> item,
+		Api::SearchFilter filter) {
+	using Type = Storage::SharedMediaType;
+	const auto type = [&]() -> std::optional<Type> {
+		switch (filter) {
+		case Filter::Photo: return Type::Photo;
+		case Filter::Video: return Type::Video;
+		case Filter::File: return Type::File;
+		case Filter::Music: return Type::MusicFile;
+		case Filter::Voice: return Type::VoiceFile;
+		case Filter::RoundVideo: return Type::RoundFile;
+		case Filter::Gif: return Type::GIF;
+		case Filter::Url: return Type::Link;
+		case Filter::Pinned: return Type::Pinned;
+		case Filter::NoFilter: break;
+		}
+		return std::nullopt;
+	}();
+	return !type || item->sharedMediaTypes().test(*type);
+}
+
+bool SearchTypeCombines(PeerData *from, Api::SearchFilter filter) {
+	return from
+		&& (filter != Filter::NoFilter)
+		&& (filter != Filter::Pinned);
+}
+
+void SearchTypeUserScrolls(
+		not_null<Ui::ScrollArea*> scroll,
+		Fn<void()> callback) {
+	base::install_event_filter(scroll, scroll->viewport(), [=](
+			not_null<QEvent*> e) {
+		if (e->type() == QEvent::Wheel) {
+			callback();
+		}
+		return base::EventFilterResult::Continue;
+	});
+	scroll->scrolls() | rpl::on_next([=] {
+		callback();
+	}, scroll->lifetime());
+}
+
+void SearchTypePages::start() {
+	_pages = _found = 0;
+	_wanted = _full = false;
+}
+
+bool SearchTypePages::take() {
+	if (_full) {
+		return false;
+	} else if (_pages >= kComboPages) {
+		_wanted = true;
+		return false;
+	}
+	++_pages;
+	return true;
+}
+
+bool SearchTypePages::received(int matches, bool full) {
+	_found += matches;
+	_full = full;
+	if (full) {
+		return false;
+	} else if (_found >= kComboTarget) {
+		_pages = _found = 0;
+		return false;
+	}
+	return (_pages < kComboPages);
+}
+
+bool SearchTypePages::resume() {
+	_pages = _found = 0;
+	return base::take(_wanted) && !_full;
+}
