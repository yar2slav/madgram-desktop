+	return _filter;
+}
+
+rpl::producer<> ComposeSearchType::changes() const {
+	return _changes.events();
+}
+
+void ComposeSearchType::setAvailable(bool available) {
+	if (!_button) {
+		return;
+	}
+	if (!available) {
+		_menu = nullptr;
+		if (_filter != Filter::NoFilter) {
+			_filter = Filter::NoFilter;
+			_button->setFilter(_filter);
+		}
+	}
+	_button->setVisible(available);
+}
+
+void ComposeSearchType::showMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		_button.get(),
+		st::popupMenuWithIcons);
+	FillMenu(_menu.get(), _filter, [=](Filter filter) { choose(filter); });
+	_menu->setForcedOrigin(Ui::PanelAnimation::Origin::BottomLeft);
+	_menu->popup(_button->mapToGlobal(QPoint()));
+}
+
+void ComposeSearchType::choose(Api::SearchFilter filter) {
+	if (_filter == filter) {
+		return;
+	}
+	_filter = filter;
+	_button->setFilter(filter);
+	_changes.fire({});
+}
+
