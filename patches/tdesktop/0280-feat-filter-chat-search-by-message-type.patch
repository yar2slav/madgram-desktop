+[[nodiscard]] int Count(const MTPmessages_Messages &result) {
+	return result.match([](const MTPDmessages_messages &data) {
+		return int(data.vmessages().v.size());
+	}, [](const MTPDmessages_messagesSlice &data) {
+		return data.vcount().v;
+	}, [](const MTPDmessages_channelMessages &data) {
+		return data.vcount().v;
+	}, [](const MTPDmessages_messagesNotModified &data) {
+		return data.vcount().v;
+	});
+}
+
+struct Type {
+	Filter filter = Filter::NoFilter;
+	const char *name = nullptr;
+};
+
+constexpr auto kTypes = std::array{
+	Type{ Filter::NoFilter, "All messages" },
+	Type{ Filter::Photo, "Photos" },
+	Type{ Filter::Video, "Videos" },
+	Type{ Filter::File, "Files" },
+	Type{ Filter::Music, "Music" },
+	Type{ Filter::Voice, "Voice messages" },
+	Type{ Filter::RoundVideo, "Round videos" },
+	Type{ Filter::Gif, "GIFs" },
+	Type{ Filter::Url, "Links" },
+};
+
+[[nodiscard]] const style::icon &Icon(Filter filter) {
+	switch (filter) {
+	case Filter::Photo: return st::infoIconMediaPhoto;
+	case Filter::Video:
+	case Filter::RoundVideo: return st::infoIconMediaVideo;
+	case Filter::File: return st::infoIconMediaFile;
+	case Filter::Music: return st::infoIconMediaAudio;
+	case Filter::Voice: return st::infoIconMediaVoice;
+	case Filter::Gif: return st::infoIconMediaGif;
+	case Filter::Url: return st::infoIconMediaLink;
+	case Filter::NoFilter:
+	case Filter::Pinned: break;
+	}
+	return st::menuIconTagFilter;
+}
+
+void FillMenu(
+		not_null<Ui::PopupMenu*> menu,
+		Filter current,
+		Fn<void(Filter)> choose) {
+	for (const auto &type : kTypes) {
+		const auto filter = type.filter;
+		menu->addAction(
+			Lower(QString::fromLatin1(type.name)),
+			[=] { choose(filter); },
+			(current == filter) ? &st::mediaPlayerMenuCheck : nullptr);
+	}
+}
