+
+};
+
+[[nodiscard]] auto Registry()
+-> base::flat_map<not_null<QWidget*>, DialogsSearchType*> & {
+	static auto result = base::flat_map<
+		not_null<QWidget*>,
+		DialogsSearchType*>();
+	return result;
+}
+
+[[nodiscard]] DialogsSearchType *Lookup(not_null<QWidget*> widget) {
+	const auto &registry = Registry();
+	const auto i = registry.find(widget);
+	return (i != end(registry)) ? i->second : nullptr;
+}
+
+DialogsSearchType::DialogsSearchType(DialogsSearchTypeDescriptor &&descriptor)
+: _widget(descriptor.widget)
+, _changed(std::move(descriptor.changed))
+, _more(std::move(descriptor.more))
+, _probed(std::move(descriptor.probed))
+, _button(base::make_unique_q<DialogsTypeButton>(descriptor.parent)) {
+	Registry().emplace(_widget, this);
+
+	if (const auto scroll = descriptor.scroll) {
+		base::install_event_filter(_button.get(), scroll, [=](
+				not_null<QEvent*> e) {
+			if (e->type() == QEvent::Wheel) {
+				resume();
+			}
+			return base::EventFilterResult::Continue;
+		});
+		scroll->scrolls() | rpl::on_next([=] {
+			resume();
+		}, _lifetime);
+	}
+
+	_button->hide();
+	_button->setAccessibleName(Lower(u"Message type"_q));
+	_button->setClickedCallback([=] { showMenu(); });
+
+	SearchTypesValue(
+	) | rpl::skip(1) | rpl::on_next([=](bool enabled) {
+		if (!enabled && clear()) {
+			_changed(true);
+		}
+		updateVisibility();
+	}, _lifetime);
+}
+
+DialogsSearchType::~DialogsSearchType() {
+	Registry().remove(_widget);
+}
