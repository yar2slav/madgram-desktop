-			if (_requestId == id) {
+			const auto current = (_requestId == id);
+			if (current && _combo && _combo->holdFailed()) {
+				finish();
+				return;
+			} else if (current) {
 				_requestId = 0;
 			}
-			if (error.type() == u"SEARCH_QUERY_EMPTY"_q) {
+			const auto terminal = (error.type() == u"SEARCH_QUERY_EMPTY"_q)
+				|| (error.type() == u"INPUT_FILTER_INVALID"_q);
+			if (current && _combo) {
+				if (terminal) {
+					(void)_combo->pages().received(0, true);
+				}
+				_messagesFounds.fire({
+					_comboCount + (terminal ? 0 : 1),
+					base::take(_comboFound),
+					nextToken,
+					!terminal,
+				});
+			} else if (terminal) {
 				_messagesFounds.fire({ 0, MessageIdsList(), nextToken });
 			}
 
@@ -166,9 +225,13 @@ void MessagesSearch::searchReceived(
 		const QString &nextToken) {
 	if (requestId != _requestId) {
 		return;
+	} else if (_combo && _combo->hold(result)) {
+		return;
 	}
 	auto &owner = _history->owner();
+	auto complete = false;
 	auto found = result.match([&](const MTPDmessages_messages &data) {
+		complete = true;
 		if (_requestId != 0) {
 			// Don't apply cached data!
 			owner.processUsers(data.vusers());
@@ -206,7 +269,8 @@ void MessagesSearch::searchReceived(
 		auto items = HistoryItemsFromTL(&owner, data.vmessages().v);
 		const auto total = int(data.vcount().v);
 		return FoundMessages{ total, std::move(items), nextToken };
-	}, [](const MTPDmessages_messagesNotModified &data) {
+	}, [&](const MTPDmessages_messagesNotModified &data) {
+		complete = true;
 		return FoundMessages{};
 	});
 	if (!_offsetId) {
@@ -216,6 +280,26 @@ void MessagesSearch::searchReceived(
 	_offsetId = found.messages.empty()
 		? MsgId()
 		: found.messages.back().msg;
+	if (_combo) {
+		const auto full = complete || found.messages.empty();
+		auto matches = 0;
+		for (const auto &id : found.messages) {
+			const auto item = owner.message(id);
+			if (item && _combo->matches(item)) {
+				_comboFound.push_back(id);
+				++matches;
+			}
+		}
+		_comboCount += matches;
+		if (_combo->pages().received(matches, full)
+			&& _combo->pages().take()) {
+			searchRequest();
+			return;
+		}
+		found.messages = base::take(_comboFound);
+		found.total = _comboCount + (full ? 0 : 1);
+		found.partial = !full;
+	}
 	_messagesFounds.fire(std::move(found));
 }
 
