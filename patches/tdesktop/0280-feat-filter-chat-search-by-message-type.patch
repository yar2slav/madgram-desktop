+void DialogsSearchType::setState(const Dialogs::SearchState &state) {
+	using Tab = Dialogs::ChatSearchTab;
+	_eligible = state.inChat.owningHistory()
+		&& ((state.tab == Tab::ThisPeer) || (state.tab == Tab::ThisTopic));
+	if (_key != state.inChat || !_eligible) {
+		_key = state.inChat;
+		clear();
+	}
+	updateVisibility();
+}
+
+void DialogsSearchType::setBlocked(bool blocked) {
+	_blocked = blocked;
+	if (blocked && clear()) {
+		_changed(false);
+	}
+	updateVisibility();
+}
+
+void DialogsSearchType::reset() {
+	if (clear()) {
+		_changed(false);
+	}
+}
+
+bool DialogsSearchType::chosen() const {
+	return (_filter != Filter::NoFilter);
+}
+
+bool DialogsSearchType::dirty() const {
+	return shown() && (_requested != _filter);
+}
+
+void DialogsSearchType::invalidate() {
+	_requested = std::nullopt;
+}
+
+bool DialogsSearchType::combines(PeerData *from) const {
+	return shown() && SearchTypeCombines(from, _filter);
+}
+
+bool DialogsSearchType::local() const {
+	return (_combo != nullptr);
+}
+
+MTPMessagesFilter DialogsSearchType::takeFilter(PeerData *from) {
+	_requested = _filter;
+	_count = _migratedCount = 0;
+	_inject = FullMsgId();
+	_delivered = false;
+	if (SearchTypeCombines(from, _filter)) {
+		_combo = std::make_unique<SearchTypeCombo>(
+			not_null<PeerData*>(from),
+			_filter);
+		return _combo->filter();
+	}
+	_combo = nullptr;
+	return SearchTypeFilter(_filter);
+}
+
+MTPMessagesFilter DialogsSearchType::requestedFilter() const {
+	return _combo
+		? _combo->filter()
+		: SearchTypeFilter(_requested.value_or(Filter::NoFilter));
+}
+
+bool DialogsSearchType::sendsFrom() const {
+	return !_combo || _combo->sendsFrom();
+}
+
+int DialogsSearchType::limit(int fallback) const {
+	return _combo ? _combo->limit() : fallback;
+}
+
+bool DialogsSearchType::more() {
+	return !_combo || _combo->pages().take();
+}
+
+void DialogsSearchType::probe(SearchTypeParams params) {
+	if (_combo) {
+		_combo->probe(std::move(params), _probed);
+	}
+}
+
+bool DialogsSearchType::hold(const MTPmessages_Messages &result) {
+	return _combo && _combo->hold(result);
+}
+
+bool DialogsSearchType::holdFailed() {
+	return _combo && _combo->holdFailed();
+}
+
+void DialogsSearchType::cancel() {
+	if (_combo) {
+		_combo->cancel();
+	}
+}
+
+SearchTypeReceived DialogsSearchType::received(
+		std::vector<not_null<HistoryItem*>> &messages,
+		HistoryItem *&inject,
+		int &count,
+		bool migrated,
+		bool full) {
+	if (!_combo) {
+		return {};
+	}
+	const auto combo = _combo.get();
+	messages.erase(ranges::remove_if(messages, [&](
+			not_null<HistoryItem*> item) {
+		return !combo->matches(item);
+	}), end(messages));
+	const auto matches = int(messages.size());
+	auto &total = migrated ? _migratedCount : _count;
+	total += matches;
+	count = total;
+	const auto more = combo->pages().received(matches, full);
+	const auto defer = more && !migrated && !_count;
+	if (defer) {
+		if (inject) {
+			_inject = inject->fullId();
+		}
+		inject = nullptr;
+	} else if (!migrated && !_delivered) {
+		_delivered = true;
+		if (!inject && _inject) {
+			inject = combo->from()->owner().message(_inject);
+		}
+		_inject = FullMsgId();
+	}
+	return { .defer = defer, .more = more };
+}
+
+void DialogsSearchType::resume() {
+	if (_combo && _combo->pages().resume() && _more) {
+		_more();
+	}
+}
+
+bool DialogsSearchType::shown() const {
+	return SearchTypes() && _eligible && !_blocked;
+}
+
+bool DialogsSearchType::clear() {
+	_menu = nullptr;
+	_combo = nullptr;
+	if (_filter == Filter::NoFilter) {
+		return false;
+	}
+	_filter = Filter::NoFilter;
+	_button->setFilter(_filter);
+	return true;
+}
+
+void DialogsSearchType::choose(Filter filter) {
+	if (_filter == filter || !shown()) {
+		return;
+	}
+	_filter = filter;
+	_button->setFilter(filter);
+	_changed(true);
+}
+
+void DialogsSearchType::showMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		_button.get(),
+		st::popupMenuWithIcons);
+	FillMenu(_menu.get(), _filter, [=](Filter filter) { choose(filter); });
+	_menu->popup(_button->mapToGlobal(QPoint(0, _button->height())));
+}
+
+void DialogsSearchType::updateVisibility() {
+	const auto visible = shown();
+	if (!visible) {
+		_menu = nullptr;
+	}
+	if (_button->isHidden() == visible) {
+		_button->setVisible(visible);
+	}
+}
