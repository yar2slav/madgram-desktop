+}
+
+bool SearchTypeCombo::matches(not_null<HistoryItem*> item) const {
+	return _typeOnServer
+		? (item->from() == _from)
+		: MatchesSearchType(item, _filter);
+}
+
+SearchTypePages &SearchTypeCombo::pages() {
+	return _pages;
+}
+
+void SearchTypeCombo::probe(SearchTypeParams params, Done done) {
+	_api.request(base::take(_typeRequest)).cancel();
+	_done = std::move(done);
+	_byFrom = _byType = std::nullopt;
+	_typeOnServer = false;
+	_probing = true;
+	_fromDone = _typeDone = false;
+
+	using Flag = MTPmessages_Search::Flag;
+	const auto saved = params.saved;
+	const auto topMsgId = params.topMsgId;
+	_typeRequest = _api.request(MTPmessages_Search(
+		MTP_flags((topMsgId ? Flag::f_top_msg_id : Flag())
+			| (saved ? Flag::f_saved_peer_id : Flag())
+			| (params.tags.empty() ? Flag() : Flag::f_saved_reaction)),
+		params.peer->input(),
+		MTP_string(params.query),
+		MTP_inputPeerEmpty(),
+		(saved ? saved->input() : MTP_inputPeerEmpty()),
+		MTP_vector_from_range(params.tags | ranges::views::transform(
+			Data::ReactionToMTP
+		)),
+		MTP_int(topMsgId),
+		SearchTypeFilter(_filter),
+		MTP_int(0), // min_date
+		MTP_int(0), // max_date
+		MTP_int(0), // offset_id
+		MTP_int(0), // add_offset
+		MTP_int(kComboPerPage),
+		MTP_int(0), // max_id
+		MTP_int(0), // min_id
+		MTP_long(0) // hash
+	)).done([=](const MTPmessages_Messages &result) {
+		_typeRequest = 0;
+		_typeDone = true;
+		_byType = result;
+		resolve();
+	}).fail([=] {
+		_typeRequest = 0;
+		_typeDone = true;
+		resolve();
+	}).send();
+}
+
+bool SearchTypeCombo::hold(const MTPmessages_Messages &result) {
+	if (!_probing || _fromDone) {
+		return false;
+	}
+	_fromDone = true;
+	_byFrom = result;
+	resolve();
+	return true;
+}
+
+bool SearchTypeCombo::holdFailed() {
+	if (!_probing || _fromDone) {
+		return false;
+	}
+	_fromDone = true;
+	resolve();
+	return true;
+}
+
+void SearchTypeCombo::cancel() {
+	_api.request(base::take(_typeRequest)).cancel();
+	if (_probing) {
+		_probing = false;
+		_done = nullptr;
+		_byFrom = _byType = std::nullopt;
+		_typeOnServer = false;
+	}
+}
+
+void SearchTypeCombo::resolve() {
+	if (!_fromDone || !_typeDone) {
+		return;
+	}
+	_probing = false;
+	auto chosen = std::optional<MTPmessages_Messages>();
+	if (_byFrom && (!_byType || Count(*_byFrom) <= Count(*_byType))) {
+		_typeOnServer = false;
+		chosen = base::take(_byFrom);
+	} else if (_byType) {
+		_typeOnServer = true;
+		chosen = base::take(_byType);
+	}
+	_byFrom = _byType = std::nullopt;
+	if (const auto done = base::take(_done)) {
+		done(chosen ? &*chosen : nullptr);
+	}
+}
