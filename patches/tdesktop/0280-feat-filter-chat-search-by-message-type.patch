+ComposeSearchType::ComposeSearchType(not_null<Ui::RpWidget*> bar) {
+	if (SearchTypes()) {
+		_button = base::make_unique_q<Button>(bar.get());
+		_button->setClickedCallback([=] { showMenu(); });
+	}
+}
