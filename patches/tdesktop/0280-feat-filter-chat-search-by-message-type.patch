+bool DialogsSearchTypeChosen(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type && type->chosen();
+}
+
+bool DialogsSearchTypeChosenAbove(not_null<QWidget*> child) {
+	for (auto w = child->parentWidget(); w; w = w->parentWidget()) {
+		if (const auto type = Lookup(w)) {
+			return type->chosen();
+		}
+	}
+	return false;
+}
+
+bool DialogsSearchTypeDirty(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type && type->dirty();
+}
