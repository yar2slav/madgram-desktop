+SearchTypeCombo::SearchTypeCombo(
+	not_null<PeerData*> from,
+	Api::SearchFilter filter)
+: _api(&from->session().mtp())
+, _from(from)
+, _filter(filter) {
+	_pages.start();
+	(void)_pages.take();
+}
