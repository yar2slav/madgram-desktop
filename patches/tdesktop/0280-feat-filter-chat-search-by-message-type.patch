+void DialogsSearchTypeInvalidate(not_null<QWidget*> widget) {
+	if (const auto type = Lookup(widget)) {
+		type->invalidate();
+	}
+}
+
+bool DialogsSearchTypeCombines(not_null<QWidget*> widget, PeerData *from) {
+	const auto type = Lookup(widget);
+	return type && type->combines(from);
+}
+
+bool DialogsSearchTypeLocal(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type && type->local();
+}
+
+MTPMessagesFilter DialogsSearchTypeTake(
+		not_null<QWidget*> widget,
+		PeerData *from) {
+	const auto type = Lookup(widget);
+	return type ? type->takeFilter(from) : MTP_inputMessagesFilterEmpty();
+}
+
+MTPMessagesFilter DialogsSearchTypeRequested(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type ? type->requestedFilter() : MTP_inputMessagesFilterEmpty();
+}
+
+bool DialogsSearchTypeSendsFrom(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return !type || type->sendsFrom();
+}
+
+int DialogsSearchTypeLimit(not_null<QWidget*> widget, int limit) {
+	const auto type = Lookup(widget);
+	return type ? type->limit(limit) : limit;
+}
+
+bool DialogsSearchTypeMore(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return !type || type->more();
+}
+
+void DialogsSearchTypeProbe(
+		not_null<QWidget*> widget,
+		SearchTypeParams params) {
+	if (const auto type = Lookup(widget)) {
+		type->probe(std::move(params));
+	}
+}
+
+bool DialogsSearchTypeHold(
+		not_null<QWidget*> widget,
+		const MTPmessages_Messages &result) {
+	const auto type = Lookup(widget);
+	return type && type->hold(result);
+}
+
+bool DialogsSearchTypeHoldFailed(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type && type->holdFailed();
+}
+
+void DialogsSearchTypeCancel(not_null<QWidget*> widget) {
+	if (const auto type = Lookup(widget)) {
+		type->cancel();
+	}
+}
+
+SearchTypeReceived DialogsSearchTypeReceived(
+		not_null<QWidget*> widget,
+		std::vector<not_null<HistoryItem*>> &messages,
+		HistoryItem *&inject,
+		int &count,
+		bool migrated,
+		bool full) {
+	const auto type = Lookup(widget);
+	return type
+		? type->received(messages, inject, count, migrated, full)
+		: SearchTypeReceived();
+}
+
