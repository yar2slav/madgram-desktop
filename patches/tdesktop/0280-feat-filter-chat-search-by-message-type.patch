+
+	const not_null<QWidget*> _widget;
+	const Fn<void(bool)> _changed;
+	const Fn<void()> _more;
+	const SearchTypeCombo::Done _probed;
+	const base::unique_qptr<DialogsTypeButton> _button;
+	std::unique_ptr<SearchTypeCombo> _combo;
+	int _count = 0;
+	int _migratedCount = 0;
+	FullMsgId _inject;
+	bool _delivered = false;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+	Dialogs::Key _key;
