+
+bool SearchTypeCombo::sendsFrom() const {
+	return !_typeOnServer;
+}
+
+MTPMessagesFilter SearchTypeCombo::filter() const {
+	return _typeOnServer
+		? SearchTypeFilter(_filter)
+		: MTP_inputMessagesFilterEmpty();
+}
