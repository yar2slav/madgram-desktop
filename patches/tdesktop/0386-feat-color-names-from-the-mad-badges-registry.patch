 constexpr auto kMaxBytes = 2 * 1024 * 1024;
 
+[[nodiscard]] std::optional<QColor> ParseColor(const QString &text) {
+	if (text.size() != 7 || text[0] != QChar('#')) {
+		return std::nullopt;
+	}
+	auto value = 0;
+	for (auto i = 1; i != 7; ++i) {
+		const auto ch = text[i].unicode();
+		const auto digit = (ch >= '0' && ch <= '9') ? (ch - '0')
+			: (ch >= 'a' && ch <= 'f') ? (ch - 'a' + 10)
+			: (ch >= 'A' && ch <= 'F') ? (ch - 'A' + 10)
+			: -1;
+		if (digit < 0) {
+			return std::nullopt;
+		}
+		value = value * 16 + digit;
+	}
+	return QColor((value >> 16) & 0xFF, (value >> 8) & 0xFF, value & 0xFF);
+}
+
 [[nodiscard]] bool ValidHash(const QString &value) {
 	if (value.size() != 64) {
 		return false;
@@ -69,6 +88,13 @@ std::optional<MadBadge> FindMadBadge(const MadRegistry &registry, const QString
 	return badge == registry.badges.cend() ? std::nullopt : std::optional(*badge);
 }
 
+std::vector<QColor> FindMadName(const MadRegistry &registry, const QString &target, qint64 now) {
+	const auto i = registry.names.constFind(target);
+	return (i == registry.names.cend() || (i->expiresAt && i->expiresAt <= now))
+		? std::vector<QColor>()
+		: i->colors;
+}
+
 bool MadAssetUrlAllowed(const QUrl &url) {
 	const auto query = QUrlQuery(url).queryItems();
 	const auto versioned = query.size() == 1
@@ -180,6 +206,38 @@ std::optional<MadRegistry> DecodeMadRegistry(
 		}
 		result.assignments.insert(key, { badgeId, expiry });
 	}
+	const auto names = data["names"];
+	if (!names.isUndefined()) {
+		if (!names.isArray() || names.toArray().size() > 100000) {
+			return std::nullopt;
+		}
+		for (const auto &value : names.toArray()) {
+			if (!value.isObject()) {
+				return std::nullopt;
+			}
+			const auto item = value.toObject();
+			const auto type = item["peerType"].toString();
+			const auto id = Integer(item["peerId"]);
+			const auto key = type + ':' + QString::number(id);
+			const auto expires = item["expiresAt"];
+			const auto expiry = expires.isNull() || expires.isUndefined() ? 0 : Integer(expires);
+			const auto colors = item["colors"].toArray();
+			if ((type != QStringLiteral("user") && type != QStringLiteral("legacyGroup")
+				&& type != QStringLiteral("channel")) || id <= 0 || expiry < 0
+				|| colors.isEmpty() || colors.size() > 4 || result.names.contains(key)) {
+				return std::nullopt;
+			}
+			auto name = MadName{ .expiresAt = expiry };
+			for (const auto &color : colors) {
+				const auto parsed = ParseColor(color.toString());
+				if (!parsed) {
+					return std::nullopt;
+				}
+				name.colors.push_back(*parsed);
+			}
+			result.names.insert(key, std::move(name));
+		}
+	}
 	return result;
 }
 
