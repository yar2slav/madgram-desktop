index 0000000000000000000000000000000000000000..df89af4e6abe79270075c653788055808ffd9889
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mad_names.cpp
@@ -0,0 +1,46 @@
+#include "tele/tele_mad_names.h"
+
+#include "tele/tele_mad_badges.h"
+
+#include <QtGui/QPainter>
+
+namespace Tele {
+
+void ApplyMadNameColor(
+		QPainter &p,
+		PeerData *peer,
+		QRect rect,
+		bool skip) {
+	if (skip || !peer || rect.width() <= 0) {
+		return;
+	}
+	const auto colors = MadNameColors(peer);
+	if (colors.empty()) {
+		return;
+	} else if (colors.size() == 1) {
+		p.setPen(colors.front());
+		return;
+	}
+	auto gradient = QLinearGradient(
+		QPointF(rect.left(), 0.),
+		QPointF(rect.left() + rect.width(), 0.));
+	const auto last = int(colors.size()) - 1;
+	for (auto i = 0; i <= last; ++i) {
+		gradient.setColorAt(float64(i) / last, colors[i]);
+	}
+	p.setPen(QPen(QBrush(gradient), 1.));
+}
+
+std::optional<QColor> MadTitleColor(
+		PeerData *peer,
+		std::optional<QColor> upstream) {
+	if (upstream || !peer) {
+		return upstream;
+	}
+	const auto colors = MadNameColors(peer);
+	return colors.empty()
+		? upstream
+		: std::optional<QColor>(colors.front());
+}
+
+}
