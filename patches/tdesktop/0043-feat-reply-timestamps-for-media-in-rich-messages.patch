diff --git a/Telegram/SourceFiles/tele/tele_rich_timestamps.cpp b/Telegram/SourceFiles/tele/tele_rich_timestamps.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..411624b64d5f7d782d5d2a7b5de292a867321312
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_rich_timestamps.cpp
@@ -0,0 +1,64 @@
+#include "tele/tele_rich_timestamps.h"
+
+#include "data/data_document.h"
+#include "history/history_item.h"
+#include "history/view/media/history_view_media.h"
+#include "iv/iv_rich_page.h"
+
+namespace Tele {
+namespace {
+
+using Block = Iv::RichPage::Block;
+
+[[nodiscard]] bool Suitable(DocumentData *document) {
+	return document && HistoryView::DurationForTimestampLinks(document);
+}
+
+[[nodiscard]] DocumentData *FindInBlocks(const std::vector<Block> &blocks);
+
+[[nodiscard]] DocumentData *FindInBlock(const Block &block) {
+	if (Suitable(block.document)) {
+		return block.document;
+	}
+	for (const auto &item : block.mediaItems) {
+		if (Suitable(item.document)) {
+			return item.document;
+		}
+	}
+	if (const auto found = FindInBlocks(block.blocks)) {
+		return found;
+	}
+	for (const auto &item : block.listItems) {
+		if (const auto found = FindInBlocks(item.blocks)) {
+			return found;
+		}
+	}
+	return nullptr;
+}
+
+DocumentData *FindInBlocks(const std::vector<Block> &blocks) {
+	for (const auto &block : blocks) {
+		if (const auto found = FindInBlock(block)) {
+			return found;
+		}
+	}
+	return nullptr;
+}
+
+} // namespace
+
+DocumentId RichTimestampDocumentId(const HistoryItem *item) {
+	if (!item) {
+		return 0;
+	}
+	for (const auto &page : { item->richPage(), item->fullRichPage() }) {
+		if (page) {
+			if (const auto found = FindInBlocks(page->blocks)) {
+				return found->id;
+			}
+		}
+	}
+	return 0;
+}
+
+} // namespace Tele
