+void AddUpdates(SectionBuilder &builder) {
+	AddOptionToggle(builder, ::Tele::kOptionAutoUpdate);
+	AddOptionToggle(builder, ::Tele::kOptionShowChangelog);
+	const auto controller = builder.controller();
+	const auto button = AddButton(builder, {
+		.id = u"tele-check-updates"_q,
+		.title = ::Tele::UpdateReadyValue() | rpl::map([](bool ready) {
+			return ::Tele::Tr(ready ? u"Restart to update"_q : u"Check for updates"_q);
+		}),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [=] {
+			if (::Tele::UpdatesOffForLaunch()) {
+				controller->showToast(
+					::Tele::Tr(u"Updates are off for this launch."_q));
+			} else if (::Tele::UpdateReady()) {
+				::Tele::RestartToUpdate();
+			} else {
+				::Tele::CheckForUpdates();
+			}
+		},
+		.keywords = { u"version"_q, u"github"_q },
+	});
+	if (button) {
+		SetupLink(button, u"tele-check-updates"_q);
+	}
+	if (Picked) {
+		return;
+	}
+	builder.addSkip();
+	builder.addDividerText(::Tele::UpdateStatusValue(
+	) | rpl::map([](const ::Tele::UpdateStatus &status) {
+		return UpdateStatusText(status) + u"\n\n"_q + BuildText();
+	}));
+}
