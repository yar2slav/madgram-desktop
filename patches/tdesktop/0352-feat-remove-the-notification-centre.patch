-void TurnOnOption(const char id[]) {
-	auto &option = base::options::lookup<bool>(id);
-	option.set(true);
-	const auto i = GroupChildren().find(option.id());
-	if (i == end(GroupChildren())) {
-		return;
-	}
-	const auto any = ranges::any_of(i->second, [](const char *child) {
-		return base::options::lookup<bool>(child).value();
-	});
-	if (!any) {
-		for (const auto child : i->second) {
-			TurnOnOption(child);
-		}
-	}
-}
-const QString *CurrentSubRow = nullptr;
-
-[[nodiscard]] bool Current(rpl::producer<bool> value) {
-	auto result = false;
-	auto lifetime = rpl::lifetime();
-	std::move(value).start(
-		[&](bool now) { result = now; },
-		[](auto&&) {},
-		[] {},
-		lifetime);
-	return result;
-}
-
-[[nodiscard]] rpl::producer<bool> OptionOnValue(const char id[]) {
-	const auto option = &base::options::details::Lookup(id);
-	return rpl::single(
-		rpl::empty
-	) | rpl::then(
-		option->changes()
-	) | rpl::map([=] {
-		return v::match(option->value(), [](bool value) {
-			return value;
-		}, [](int value) {
-			return (value != 0);
-		}, [](const QString &value) {
-			return !value.isEmpty();
-		});
-	});
-}
-
-[[nodiscard]] rpl::producer<bool> RequirementValue(
-		not_null<::Main::Session*> session,
-		const Requirement &requirement) {
-	auto value = requirement.value
-		? requirement.value(session)
-		: OptionOnValue(requirement.id);
-	return std::move(value) | rpl::map([off = requirement.off](bool on) {
-		return (on != off);
-	});
-}
-
-[[nodiscard]] rpl::producer<bool> ShownValue(
-		not_null<::Main::Session*> session,
-		const QString &id) {
-	const auto i = Parents().find(id);
-	if (i == end(Parents())) {
-		return rpl::single(true);
-	}
-	const auto sub = SubRows().contains(id);
-	auto list = std::vector<rpl::producer<bool>>();
-	for (const auto &requirement : i->second.list) {
-		if (!sub) {
-			list.push_back(RequirementValue(session, requirement));
-		}
-		list.push_back(ShownValue(
-			session,
-			QString::fromLatin1(requirement.id)));
-	}
-	return rpl::combine(
-		std::move(list)
-	) | rpl::map([](const std::vector<bool> &values) {
-		return ranges::all_of(values, [](bool value) { return value; });
-	}) | rpl::distinct_until_changed();
-}
-
-[[nodiscard]] const Requirement *HiddenBy(
-		not_null<::Main::Session*> session,
-		const QString &id) {
-	const auto i = Parents().find(id);
-	if (i == end(Parents())) {
-		return nullptr;
-	}
-	const auto sub = SubRows().contains(id);
-	for (const auto &requirement : i->second.list) {
-		const auto parent = QString::fromLatin1(requirement.id);
-		if (const auto above = HiddenBy(session, parent)) {
-			return above;
-		} else if (!sub && !Current(RequirementValue(session, requirement))) {
-			return &requirement;
-		}
-	}
-	return nullptr;
-}
-
-[[nodiscard]] rpl::producer<bool> EnabledValue(const QString &id) {
-	auto list = std::vector<rpl::producer<bool>>();
-	for (auto current = id; SubRows().contains(current);) {
-		const auto i = Parents().find(current);
-		if (i == end(Parents()) || i->second.list.empty()) {
-			break;
-		}
-		const auto parent = i->second.list.front().id;
-		list.push_back(OptionOnValue(parent));
-		current = QString::fromLatin1(parent);
-	}
-	if (list.empty()) {
-		return rpl::single(true);
-	}
-	return rpl::combine(
-		std::move(list)
-	) | rpl::map([](const std::vector<bool> &values) {
-		return ranges::all_of(values, [](bool value) { return value; });
-	}) | rpl::distinct_until_changed();
-}
