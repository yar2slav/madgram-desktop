+void AddButtonChoice(
+		SectionBuilder &builder,
+		const char id[],
+		QString (*get)(),
+		void (*set)(const QString&),
+		rpl::producer<QString> (*value)(),
+		std::vector<ButtonChoice> choices,
+		QStringList keywords,
+		Parent parent = {}) {
+	const auto &option = base::options::lookup<QString>(id);
+	const auto controller = builder.controller();
+	const auto name = ::Tele::Tr(option.name());
+	const auto description = ::Tele::Tr(option.description());
+	keywords.push_front(description);
+	auto values = std::vector<QString>();
+	auto labels = std::vector<QString>();
+	auto options = std::vector<QString>();
+	for (const auto &choice : choices) {
+		values.push_back(choice.value);
+		labels.push_back(::Tele::Tr(choice.label));
+		options.push_back(::Tele::Tr(choice.option.isEmpty()
+			? choice.label
+			: choice.option));
+	}
+	WithParent(builder, option.id(), name, std::move(parent), [&] {
+		const auto button = AddButton(builder, {
+			.id = option.id(),
+			.title = rpl::single(name),
+			.st = &st::settingsButtonNoIcon,
+			.label = value() | rpl::map([=](const QString &now) {
+				const auto i = ranges::find(values, now);
+				return labels[(i != end(values))
+					? int(i - begin(values))
+					: 0];
+			}),
+			.onClick = [=] {
+				controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+					const auto current = ranges::find(values, get());
+					SingleChoiceBox(box, {
+						.title = rpl::single(name),
+						.options = options,
+						.initialSelection = (current != end(values))
+							? int(current - begin(values))
+							: 0,
+						.callback = [=](int index) {
+							set(values[index]);
+						},
+					});
+				}));
+			},
+			.keywords = std::move(keywords),
+		});
+		if (button) {
+			SetupLink(button, option.id());
+		}
+		AddAbout(builder, option.id(), description);
+	});
+}
