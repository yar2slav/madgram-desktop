+[[nodiscard]] TextWithEntities Highlighted(
+		const QString &text,
+		const QStringList &words) {
+	auto found = std::vector<std::pair<int, int>>();
+	for (const auto &word : words) {
+		auto from = 0;
+		while (true) {
+			const auto index = text.indexOf(word, from, Qt::CaseInsensitive);
+			if (index < 0) {
+				break;
+			}
+			from = index + int(word.size());
+			found.emplace_back(index, from);
+		}
+	}
+	ranges::sort(found);
+	auto result = TextWithEntities{ text };
+	auto start = -1;
+	auto till = -1;
+	const auto flush = [&] {
+		if (start < 0) {
+			return;
+		}
+		const auto length = till - start;
+		result.entities.push_back(
+			EntityInText(EntityType::Semibold, start, length));
+		result.entities.push_back(
+			EntityInText(EntityType::Colorized, start, length));
+	};
+	for (const auto &[from, to] : found) {
+		if (start >= 0 && from <= till) {
+			till = std::max(till, to);
+		} else {
+			flush();
+			start = from;
+			till = to;
+		}
+	}
+	flush();
+	return result;
+}
+
+void AddSubRows(base::flat_set<QString> &ids, const QString &id) {
+	for (const auto &[child, parent] : Parents()) {
+		if (!parent.list.empty()
+			&& SubRows().contains(child)
+			&& QString::fromLatin1(parent.list.front().id) == id
+			&& ids.emplace(child).second) {
+			AddSubRows(ids, child);
+		}
+	}
+}
+
+[[nodiscard]] base::flat_set<QString> NewPicked(
+		const std::vector<QString> &options) {
+	auto result = base::flat_set<QString>(begin(options), end(options));
+	for (const auto &id : options) {
+		AddAncestors(result, id);
+		AddSubRows(result, id);
+	}
+	return result;
+}
+
+void AddNewRows(
+		SectionBuilder &builder,
+		const NewPages &pages,
+		const base::flat_set<QString> &picked) {
+	auto indices = base::flat_set<int>();
+	for (const auto &id : picked) {
+		const auto i = pages.where.find(id);
+		if (i != end(pages.where)) {
+			for (const auto index : i->second) {
+				indices.emplace(index);
+			}
+		}
+	}
+	Picked = &picked;
+	for (const auto index : indices) {
+		pages.list[index].fill(builder);
+	}
+	Picked = nullptr;
+}
+
+void AddNewText(
+		SectionBuilder &builder,
+		const TextWithEntities &text,
+		const style::FlatLabel &st,
+		QMargins margin,
+		bool fresh) {
+	builder.add([&](const WidgetContext &ctx) {
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto raw = result.data();
+		const auto label = raw->add(
+			object_ptr<Ui::FlatLabel>(raw, st),
+			margin);
+		label->setMarkedText(text);
+		if (fresh) {
+			const auto badge = CreateNewPill(raw);
+			rpl::combine(
+				label->geometryValue(),
+				raw->widthValue()
+			) | rpl::on_next([=](QRect geometry, int outer) {
+				const auto &st = st::settingsButtonNoIcon;
+				const auto toggle = 2 * st.toggle.border
+					+ st.toggle.diameter
+					+ st.toggle.width;
+				const auto center = outer - st.toggleSkip - toggle / 2;
+				badge->moveToLeft(
+					center - badge->width() / 2,
+					NewPillTop(label->st().style.font, geometry.y(), badge),
+					outer);
+			}, badge->lifetime());
+		}
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+			.align = style::al_justify,
+		};
+	}, nullptr);
+}
+
+struct NewBlock {
+	std::vector<QString> options;
+	std::vector<not_null<const ::Tele::ChangelogHistoryItem*>> items;
+};
+
+void AddNewRelease(
+		SectionBuilder &builder,
+		const NewPages &pages,
+		const ::Tele::ChangelogHistoryRelease &release,
+		const QStringList &words,
+		const base::flat_set<QString> &fresh,
+		base::flat_set<QString> &covered,
+		bool &first) {
+	auto blocks = std::vector<NewBlock>();
+	auto plain = std::vector<not_null<const ::Tele::ChangelogHistoryItem*>>();
+	for (const auto &item : release.items) {
+		if (!NewMatches(item, words)) {
+			continue;
+		}
+		auto options = std::vector<QString>();
+		for (const auto &id : item.options) {
+			if (pages.where.contains(id)) {
+				options.push_back(id);
+			}
+		}
+		if (options.empty()) {
+			plain.push_back(&item);
+			continue;
+		}
+		ranges::sort(options);
+		options.erase(ranges::unique(options), end(options));
+		const auto i = ranges::find(blocks, options, &NewBlock::options);
+		if (i != end(blocks)) {
+			i->items.push_back(&item);
+		} else {
+			blocks.push_back({ std::move(options), { &item } });
+		}
+	}
+	const auto addTitle = [&](const QString &text) {
+		AddNewGroupDivider(builder, first);
+		builder.addSubsectionTitle(rpl::single(::Tele::Lower(words.isEmpty()
+			? text
+			: ::Tele::Tr(u"mad %1, %2"_q).arg(release.version).arg(text))));
+	};
+	if (!blocks.empty()) {
+		addTitle(u"Settings"_q);
+		for (const auto &block : blocks) {
+			const auto picked = NewPicked(block.options);
+			AddNewRows(builder, pages, picked);
+			for (const auto &id : picked) {
+				covered.emplace(id);
+			}
+			auto badge = ranges::any_of(block.options, [&](
+					const QString &id) {
+				return fresh.contains(id);
+			});
+			for (const auto item : block.items) {
+				AddNewText(
+					builder,
+					Highlighted(::Tele::Lower(item->text), words),
+					st::settingsExperimentalAbout,
+					st::settingsExperimentalAboutPadding,
+					base::take(badge));
+			}
+		}
+	}
+	if (!plain.empty()) {
+		addTitle(u"Always on"_q);
+		const auto &padding = st::settingsExperimentalAboutPadding;
+		const auto margin = QMargins(
+			padding.left(),
+			padding.bottom() / 2,
+			padding.left(),
+			padding.bottom() / 2);
+		for (const auto item : plain) {
+			AddNewText(
+				builder,
+				Highlighted(::Tele::Lower(item->text), words),
+				st::settingsExperimentalTitle,
+				margin,
+				false);
+		}
+	}
+}
+
+void AddFreshSettings(
+		SectionBuilder &builder,
+		const NewPages &pages,
+		const base::flat_set<QString> &ids,
+		bool &first) {
+	if (ids.empty()) {
+		return;
+	}
+	const auto controller = builder.controller();
+	const auto showOther = builder.showOther();
+	if (ids.contains(u"tele/messages"_q)) {
+		AddNewGroupDivider(builder, first);
+		builder.addSubsectionTitle(rpl::single(::Tele::Tr(u"Moved"_q)));
+		builder.add([&](const WidgetContext &ctx) {
+			return SectionBuilder::WidgetToAdd{
+				.widget = object_ptr<Ui::FlatLabel>(
+					ctx.container,
+					::Tele::Tr(u"Chats and messages is now Chats, "
+						"Messages, Sending, Notifications and Menus. Chat "
+						"and profile options moved from Interface to Chats, "
+						"unread counters to Notifications."_q),
+					st::settingsExperimentalAbout),
+				.margin = st::settingsExperimentalAboutPadding,
+			};
+		}, nullptr);
+	}
+	auto categories = std::vector<not_null<const Category*>>();
+	for (const auto &category : Categories()) {
+		if (ids.contains(CategoryId(category))) {
+			categories.push_back(&category);
+		}
+	}
+	if (!categories.empty()) {
+		AddNewGroupDivider(builder, first);
+		builder.addSubsectionTitle(rpl::single(
+			::Tele::Tr(u"New pages"_q)));
+		for (const auto &category : categories) {
+			const auto button = builder.addSectionButton({
+				.title = rpl::single(::Tele::Tr(category->title)),
+				.targetSection = category->id,
+				.icon = { category->icon },
+			});
+			if (button) {
+				SetupCopyLink(button, category->id, QString());
+			}
+		}
+	}
+	for (const auto &page : pages.list) {
+		auto picked = base::flat_set<QString>();
+		auto highlight = QString();
+		for (const auto &id : page.ids) {
+			if (ids.contains(id)) {
+				if (highlight.isEmpty()) {
+					highlight = id;
+				}
+				picked.emplace(id);
+			}
+		}
+		if (picked.empty()) {
+			continue;
+		}
+		const auto children = std::vector<QString>(begin(picked), end(picked));
+		for (const auto &id : children) {
+			AddAncestors(picked, id);
+		}
+		AddNewGroupDivider(builder, first);
+		builder.addSubsectionTitle(rpl::single(
+			::Tele::Tr(u"New in %1"_q).arg(page.title)));
+		Picked = &picked;
+		page.fill(builder);
+		Picked = nullptr;
+		const auto section = page.section;
+		builder.addButton({
+			.title = rpl::single(
+				::Tele::Tr(u"Open %1"_q).arg(page.title)),
+			.st = &st::settingsButtonLightNoIcon,
+			.onClick = [=] {
+				controller->setHighlightControlId(highlight);
+				showOther(section);
+			},
+		});
+	}
+}
+
+void FillNew(
+		SectionBuilder &builder,
+		const NewPages &pages,
+		int version,
+		const QString &query) {
+	const auto words = QueryWords(query);
+	const auto &fresh = ::Tele::NewSettings();
+	const auto freshIds = base::flat_set<QString>(begin(fresh), end(fresh));
+	auto covered = base::flat_set<QString>();
+	auto first = true;
+	builder.addSkip();
+	for (const auto &release : ::Tele::ChangelogHistory()) {
+		if (words.isEmpty() && release.version != version) {
+			continue;
+		}
+		AddNewRelease(
+			builder,
+			pages,
+			release,
+			words,
+			freshIds,
+			covered,
+			first);
+	}
+	if (words.isEmpty() && version == DefaultNewVersion()) {
+		auto rest = base::flat_set<QString>();
+		for (const auto &id : fresh) {
+			if (!covered.contains(id)) {
+				rest.emplace(id);
+			}
+		}
+		AddFreshSettings(builder, pages, rest, first);
+	}
+	if (first) {
+		builder.add([&](const WidgetContext &ctx) {
+			return SectionBuilder::WidgetToAdd{
+				.widget = object_ptr<Ui::FlatLabel>(
+					ctx.container,
+					(words.isEmpty()
+						? rpl::producer<QString>(rpl::single(::Tele::Tr(u"No release notes yet."_q)))
+						: tr::lng_search_tab_no_results()),
+					st::settingsSearchNoResults),
+				.margin = st::settingsSearchNoResultsPadding,
+			};
+		}, nullptr);
+	}
+	builder.addSkip();
+}
