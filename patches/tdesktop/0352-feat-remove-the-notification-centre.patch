+void SetupCopyLink(
+		not_null<Ui::RpWidget*> widget,
+		Type section,
+		const QString &id) {
+	const auto menu = widget->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	base::install_event_filter(widget, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::ContextMenu) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto owner = FindSection(widget);
+		const auto link = owner
+			? ::Tele::PublicMadLink(Core::DeepLinks::SettingsDeepLink(
+				section ? section : owner->id(),
+				id))
+			: QString();
+		if (link.isEmpty()) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto controller = owner->controller();
+		*menu = base::make_unique_q<Ui::PopupMenu>(
+			widget,
+			st::popupMenuWithIcons);
+		(*menu)->addAction(tr::lng_context_copy_link(tr::now), [=] {
+			TextUtilities::SetClipboardText(TextForMimeData::Simple(link));
+			controller->showToast({
+				.text = { tr::lng_channel_public_link_copied(tr::now) },
+				.iconLottie = u"toast/voip_invite"_q,
+				.iconLottieSize = st::toastLottieIconSize,
+			});
+		}, &st::menuIconLink);
+		(*menu)->popup(QCursor::pos());
+		return base::EventFilterResult::Cancel;
+	}, widget->lifetime());
