+[[nodiscard]] Requirement SavedHistorySwitches() {
+	return Requirement(::Tele::kOptionKeepDeletedPersist, [](
+			not_null<::Main::Session*> session) {
+		return rpl::combine(
+			::Tele::KeepDeletedPersistValue(),
+			::Tele::EditHistoryPersistValue()
+		) | rpl::map(rpl::mappers::_1 || rpl::mappers::_2);
+	});
+}
