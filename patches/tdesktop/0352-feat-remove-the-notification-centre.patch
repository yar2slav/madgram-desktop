+[[nodiscard]] OptionRow CreateOptionRow(
+		not_null<QWidget*> parent,
+		not_null<Window::SessionController*> controller,
+		const QString &name,
+		const QString &description) {
+	auto result = object_ptr<::Tele::SettingButton>(parent, nullptr, st::settingsButtonNoIcon);
+	const auto button = result.data();
+	const auto helpWidth = description.isEmpty() ? 0 : st::madSettingHelpSize;
+	const auto right = st::rightsButtonToggleWidth;
+	const auto title = ::Tele::SetupSettingText(button,
+		rpl::single(TextWithEntities::Simple(name)), nullptr, right + helpWidth);
+	AddSettingHelp(button, controller, name, description, right);
+	return { std::move(result), button, title };
+}
