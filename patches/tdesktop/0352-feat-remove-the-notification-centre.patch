-void AddLocalPasswordAction(SectionBuilder &builder, const char id[]) {
-	auto &option = base::options::lookup<bool>(id);
-	const auto name = ::Tele::Tr(option.name());
-	WithParent(builder, option.id(), name, ::Tele::kOptionLocalPassword, [&] {
-		if (!Shown(option.id())) {
-			return;
-		}
-		builder.add([&](const WidgetContext &ctx) {
-			const auto controller = ctx.controller;
-			auto result = object_ptr<Button>(
-				ctx.container,
-				rpl::single(name),
-				st::settingsButtonNoIcon);
-			const auto button = result.data();
-			const auto reverts = button->lifetime().make_state<
-				rpl::event_stream<bool>>();
-			button->toggleOn(rpl::merge(
-				rpl::single(
-					rpl::empty
-				) | rpl::then(
-					option.changes()
-				) | rpl::map([&option] {
-					return option.value();
-				}),
-				reverts->events()));
-			button->toggledChanges(
-			) | rpl::filter([&option](bool toggled) {
-				return (toggled != option.value());
-			}) | rpl::on_next([=, &option](bool toggled) {
-				if (toggled) {
-					option.set(true);
-					return;
-				}
-				reverts->fire(true);
-				::Tele::ConfirmLocalPassword(controller->uiShow(), [&option] {
-					option.set(false);
-				});
-			}, button->lifetime());
-			SetupLink(button, option.id());
-			return SectionBuilder::WidgetToAdd{
-				.widget = std::move(result),
-				.align = style::al_justify,
-			};
-		}, [&] {
-			return SearchEntry{
-				.id = option.id(),
-				.title = name,
-				.keywords = { u"local password"_q },
-			};
-		});
-	});
-}
