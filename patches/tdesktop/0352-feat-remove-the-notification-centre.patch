+void AddSavedHistory(SectionBuilder &builder) {
+	AddButtonChoice(
+		builder,
+		::Tele::kOptionSavedHistoryPeriod,
+		::Tele::SavedHistoryPeriod,
+		::Tele::SetSavedHistoryPeriod,
+		::Tele::SavedHistoryPeriodValue,
+		{
+			{ u"1"_q, u"1 day"_q },
+			{ QString(), u"7 days"_q },
+			{ u"30"_q, u"30 days"_q },
+			{ u"forever"_q, u"Forever"_q },
+		},
+		{ u"restart"_q, u"retention"_q, u"days"_q },
+		{ SavedHistorySwitches() });
+	const auto controller = builder.controller();
+	const auto session = builder.session();
+	const auto id = u"tele-clear-saved-history"_q;
+	const auto name = ::Tele::Tr(u"Clear saved history"_q);
+	WithParent(builder, id, name, { SavedHistorySwitches() }, [&] {
+		const auto button = AddButton(builder, {
+			.id = id,
+			.title = rpl::single(name),
+			.st = &st::settingsButtonNoIcon,
+			.label = ::Tele::SavedHistorySizeValue(
+				session
+			) | rpl::map([](int64 size) {
+				return size ? Ui::FormatSizeText(size) : QString();
+			}),
+			.onClick = [=] {
+				controller->show(Ui::MakeConfirmBox({
+					.text = ::Tele::Tr(u"Clear deleted messages and edit "
+						"history saved for this account? Ones already shown "
+						"stay until mad restarts."_q),
+					.confirmed = [=](Fn<void()> close) {
+						::Tele::ClearSavedHistory(session);
+						close();
+					},
+					.confirmText = ::Tele::Tr(u"Clear"_q),
+					.confirmStyle = &st::attentionBoxButton,
+				}));
+			},
+			.keywords = { u"delete"_q, u"remove"_q, u"deleted"_q },
+		});
+		if (button) {
+			SetupLink(button, id);
+		}
+	});
+}
