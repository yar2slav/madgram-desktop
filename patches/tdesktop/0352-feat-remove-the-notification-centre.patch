-void AddNewRelease(
-		SectionBuilder &builder,
-		const NewPages &pages,
-		const ::Tele::ChangelogHistoryRelease &release,
-		const QStringList &words,
-		const base::flat_set<QString> &fresh,
-		base::flat_set<QString> &covered,
-		bool &first) {
-	auto blocks = std::vector<NewBlock>();
-	auto plain = std::vector<not_null<const ::Tele::ChangelogHistoryItem*>>();
-	for (const auto &item : release.items) {
-		if (!NewMatches(item, words)) {
-			continue;
-		}
-		auto options = std::vector<QString>();
-		for (const auto &id : item.options) {
-			if (pages.where.contains(id)) {
-				options.push_back(id);
-			}
-		}
-		if (options.empty()) {
-			plain.push_back(&item);
-			continue;
-		}
-		ranges::sort(options);
-		options.erase(ranges::unique(options), end(options));
-		const auto i = ranges::find(blocks, options, &NewBlock::options);
-		if (i != end(blocks)) {
-			i->items.push_back(&item);
-		} else {
-			blocks.push_back({ std::move(options), { &item } });
-		}
-	}
-	const auto addTitle = [&](const QString &text) {
-		AddNewGroupDivider(builder, first);
-		builder.addSubsectionTitle(rpl::single(::Tele::Lower(words.isEmpty()
-			? text
-			: ::Tele::Tr(u"mad %1, %2"_q).arg(release.version).arg(text))));
-	};
-	if (!blocks.empty()) {
-		addTitle(u"Settings"_q);
-		for (const auto &block : blocks) {
-			const auto picked = NewPicked(block.options);
-			AddNewRows(builder, pages, picked);
-			for (const auto &id : picked) {
-				covered.emplace(id);
-			}
-			auto badge = ranges::any_of(block.options, [&](
-					const QString &id) {
-				return fresh.contains(id);
-			});
-			for (const auto item : block.items) {
-				AddNewText(
-					builder,
-					Highlighted(::Tele::Lower(item->text), words),
-					st::settingsExperimentalAbout,
-					st::settingsExperimentalAboutPadding,
-					base::take(badge));
-			}
-		}
-	}
-	if (!plain.empty()) {
-		addTitle(u"Always on"_q);
-		const auto &padding = st::settingsExperimentalAboutPadding;
-		const auto margin = QMargins(
-			padding.left(),
-			padding.bottom() / 2,
-			padding.left(),
-			padding.bottom() / 2);
-		for (const auto item : plain) {
-			AddNewText(
-				builder,
-				Highlighted(::Tele::Lower(item->text), words),
-				st::settingsExperimentalTitle,
-				margin,
-				false);
-		}
-	}
