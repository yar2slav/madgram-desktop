+void NewSection::setQuery(const QString &query) {
+	const auto now = query.trimmed();
+	if (_query == now) {
+		return;
+	}
+	_query = now;
+	if (_tabsWrap) {
+		_tabsWrap->toggle(_query.isEmpty(), anim::type::normal);
+	}
+	rebuild();
+}
