+void LocalNamesController::refreshRows() {
+	const auto names = ::Tele::LocalNames(&session());
+	auto keep = base::flat_map<PeerListRowId, QString>();
+	for (const auto &entry : names) {
+		keep.emplace(entry.id.value, entry.name);
+	}
+	for (auto i = delegate()->peerListFullRowsCount(); i != 0;) {
+		const auto row = delegate()->peerListRowAt(--i);
+		const auto j = keep.find(row->id());
+		if (j == end(keep)
+			|| static_cast<LocalNameRow*>(row.get())->name() != j->second) {
+			delegate()->peerListRemoveRow(row);
+		}
+	}
+	for (const auto &entry : names) {
+		if (delegate()->peerListFindRow(entry.id.value)) {
+			continue;
+		}
+		const auto peer = session().data().peer(entry.id);
+		const auto user = peer->asUser();
+		auto row = std::make_unique<LocalNameRow>(peer, entry.name);
+		row->setActionLink(::Tele::Tr(u"Remove"_q));
+		row->setCustomStatus((user && user->isMinimalLoaded())
+			? ::Tele::LocalRealName(user)
+			: ::Tele::Tr(u"Unknown user"_q));
+		delegate()->peerListAppendRow(std::move(row));
+	}
+	setDescriptionText(names.empty()
+		? ::Tele::Tr(u"No custom names yet. Pick Set a name for me in "
+			"a user's menu."_q)
+		: QString());
+	delegate()->peerListRefreshRows();
