-void Store::write() {
-	_writeTimer.cancel();
-	const auto key = _session->local().peekLegacyLocalKey();
-	if (!key) {
-		return;
-	}
-	auto list = QJsonArray();
-	for (const auto &notice : _list) {
-		list.push_back(Serialize(notice));
-	}
-	auto server = QJsonArray();
-	for (const auto &seen : _server) {
-		server.push_back(QJsonArray{ seen.id, seen.rev, seen.toasted });
-	}
-	auto object = QJsonObject();
-	object.insert(u"last"_q, QString::number(_lastId));
-	object.insert(u"update"_q, _updateTag);
-	object.insert(u"server"_q, server);
-	object.insert(u"list"_q, list);
-	const auto json = QJsonDocument(object).toJson(QJsonDocument::Compact);
-	auto data = EncryptedDescriptor(
-		sizeof(quint32) * 3 + sizeof(quint64) + json.size());
-	data.stream
-		<< kMagic
-		<< kVersion
-		<< quint64(_session->uniqueId())
-		<< quint32(json.size());
-	data.stream.writeRawData(json.constData(), json.size());
-	auto file = FileWriteDescriptor(u"tele_notices"_q, folder());
-	file.writeEncrypted(data, key);
-}
