+void AddServer(SectionBuilder &builder) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionServerUrl);
+	const auto controller = builder.controller();
+	const auto description = ::Tele::Tr(option.description());
+	const auto server = AddButton(builder, {
+		.id = option.id(),
+		.title = rpl::single(::Tele::Tr(u"Server"_q)),
+		.st = &st::settingsButtonNoIcon,
+		.label = ::Tele::ServerUrlValue() | rpl::map([](const QString &url) {
+			return ::Tele::ServerOffForLaunch()
+				? u"off for this launch"_q
+				: url.isEmpty()
+				? u"off"_q
+				: url;
+		}),
+		.onClick = [=] {
+			controller->show(Box(ServerBox));
+		},
+		.keywords = { ::Tele::Tr(option.name()), description },
+	});
+	if (server) {
+		SetupLink(server, option.id());
+	}
+	const auto refreshId = u"tele-refresh-badges"_q;
+	const auto refreshTitle = ::Tele::Tr(u"Refresh now"_q);
+	WithParent(builder, refreshId, refreshTitle, ::Tele::kOptionServerUrl, [&] {
+		const auto refresh = AddButton(builder, {
+			.id = refreshId,
+			.title = rpl::single(refreshTitle),
