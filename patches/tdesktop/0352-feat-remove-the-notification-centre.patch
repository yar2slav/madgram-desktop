+void PickPeersController::prepareViewHook() {
+	delegate()->peerListSetTitle(rpl::single(_title));
+	auto loaded = std::vector<not_null<PeerData*>>();
+	auto unknown = std::vector<std::unique_ptr<PeerListRow>>();
+	for (const auto &peer : _selected) {
+		if (peer->isMinimalLoaded()) {
+			loaded.push_back(peer);
+		} else {
+			unknown.push_back(std::make_unique<UnknownPeerRow>(
+				peer,
+				(peer->isUser()
+					? ::Tele::Tr(u"Unknown user"_q)
+					: ::Tele::Tr(u"Unknown chat"_q))));
+		}
+	}
+	delegate()->peerListAddSelectedPeers(loaded);
+	if (!unknown.empty()) {
+		auto rows = std::vector<not_null<PeerListRow*>>();
+		for (const auto &row : unknown) {
+			rows.push_back(row.get());
+		}
+		delegate()->peerListAddSelectedRows(rows);
+	}
+}
+
+void PickPeersController::rowClicked(not_null<PeerListRow*> row) {
+	const auto peer = row->peer();
+	delegate()->peerListSetRowChecked(row, !row->checked());
+	if (const auto channel = peer->asChannel()) {
+		if (!channel->membersCountKnown()) {
+			channel->updateFull();
+		}
+	}
+}
+
+auto PickPeersController::createRow(not_null<History*> history)
+-> std::unique_ptr<Row> {
+	const auto peer = history->peer;
+	if (peer->isSelf()
+		|| peer->isRepliesChat()
+		|| peer->isVerifyCodes()
+		|| !_filter(peer)) {
+		return nullptr;
+	}
+	auto result = std::make_unique<Row>(history);
+	if (const auto chat = peer->asChat()) {
+		if (chat->count > 0) {
+			result->setCustomStatus(tr::lng_chat_status_members(
+				tr::now,
+				lt_count_decimal,
+				chat->count));
+		}
+	} else if (const auto channel = peer->asChannel()) {
+		if (channel->membersCountKnown() && channel->membersCount() > 0) {
+			result->setCustomStatus(channel->isBroadcast()
+				? tr::lng_chat_status_subscribers(
+					tr::now,
+					lt_count_decimal,
+					channel->membersCount())
+				: tr::lng_chat_status_members(
+					tr::now,
+					lt_count_decimal,
+					channel->membersCount()));
+		}
+	}
+	return result;
+}
