-int Entry::resizeGetHeight(int newWidth) {
-	const auto padding = st::boxRowPadding.left() / 2;
-	const auto iconSize = style::ConvertScale(kIconSize);
-	const auto available = std::max(newWidth - left() - right(), 1);
-	const auto titled = !_notice.title.isEmpty();
-	_titleWidth = std::max(
-		available - _timeWidth - st::boxRowPadding.right() / 2,
-		1);
-	auto top = padding;
-	_timeTop = padding;
-	if (titled) {
-		_timeTop += (st::semiboldFont->height - st::normalFont->height) / 2;
-		top += _title.countHeight(_titleWidth);
-	}
-	const auto blocks = std::array{ _value.get(), _text.get() };
-	auto heights = std::array<int, 2>();
-	auto total = 0;
-	for (auto i = 0; i != int(blocks.size()); ++i) {
-		if (blocks[i]) {
-			heights[i] = blocks[i]->resizeGetHeight(
-				titled ? available : _titleWidth);
-			total += heights[i];
-		}
-	}
-	if (!titled && total) {
-		top += std::max((iconSize - total) / 2, 0);
-		_timeTop = top;
-	}
-	for (auto i = 0; i != int(blocks.size()); ++i) {
-		if (blocks[i]) {
-			blocks[i]->moveToLeft(left(), top, newWidth);
-			top += heights[i];
-		}
-	}
-	_photoRect = QRect();
-	if (!_photo.isNull()) {
-		top += padding;
-		const auto maxHeight = style::ConvertScale(kPhotoMaxHeight);
-		const auto size = _photo.size().scaled(
-			available,
-			maxHeight,
-			Qt::KeepAspectRatio);
-		_photoRect = QRect(left(), top, size.width(), size.height());
-		top += size.height();
-	}
-	if (!_buttons.empty()) {
-		top += padding / 2;
-		const auto skip = style::ConvertScale(kButtonSkip);
-		auto x = left() - st::defaultLightButton.padding.left();
-		auto height = 0;
-		for (const auto button : _buttons) {
-			button->moveToLeft(x, top, newWidth);
-			x += button->width() + skip;
-			height = std::max(height, button->height());
-		}
-		top += height;
-	}
-	return std::max(
-		top + padding,
-		padding * 2 + style::ConvertScale(kIconSize));
-}
