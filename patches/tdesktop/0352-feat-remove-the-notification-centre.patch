+
+[[nodiscard]] QString FilterId(Filter filter) {
+	switch (filter) {
+	case Filter::All: return u"all"_q;
+	case Filter::Mentions: return u"mentions"_q;
+	case Filter::Limits: return u"limits"_q;
+	case Filter::Server: return u"server"_q;
+	case Filter::Tele: return u"tele"_q;
+	case Filter::Copied: return u"copied"_q;
+	case Filter::Scripts: return u"scripts"_q;
+	}
+	Unexpected("Filter in Tele::FilterId.");
+}
+
+[[nodiscard]] Filter FilterFromId(const QString &id) {
+	for (const auto filter : {
+			Filter::All,
+			Filter::Mentions,
+			Filter::Limits,
+			Filter::Server,
+			Filter::Tele,
+			Filter::Copied,
+			Filter::Scripts }) {
+		if (FilterId(filter) == id) {
+			return filter;
+		}
+	}
+	return Filter::All;
+}
+
+[[nodiscard]] bool Matches(Filter filter, NoticeKind kind) {
+	switch (filter) {
+	case Filter::All: return true;
+	case Filter::Mentions: return (kind == NoticeKind::Mention);
+	case Filter::Limits: return (kind == NoticeKind::Limit);
+	case Filter::Server: return (kind == NoticeKind::Server);
+	case Filter::Tele: return (kind != NoticeKind::Limit)
+		&& (kind != NoticeKind::Server)
+		&& (kind != NoticeKind::Mention)
+		&& (kind != NoticeKind::Copy)
+		&& (kind != NoticeKind::Script);
+	case Filter::Copied: return (kind == NoticeKind::Copy);
+	case Filter::Scripts: return (kind == NoticeKind::Script);
+	}
+	Unexpected("Filter in Tele::Matches.");
+}
+
+[[nodiscard]] const style::icon &MentionIcon(bool reply) {
+	return reply ? st::menuIconReply : st::dialogsUnreadMention.icon;
+}
+
+[[nodiscard]] const style::icon &MentionBadgeIcon(bool reply) {
+	return reply
+		? st::dialogsMiniReplyIcon.icon
+		: st::dialogsUnreadMention.icon;
+}
+
+[[nodiscard]] const style::icon &KindIcon(NoticeKind kind, bool reply) {
+	switch (kind) {
+	case NoticeKind::Limit: return st::menuIconTimer;
+	case NoticeKind::Server: return st::menuIconInfo;
+	case NoticeKind::Tele: return st::menuIconNotifications;
+	case NoticeKind::Update: return st::menuIconDownload;
+	case NoticeKind::Crash: return st::menuIconReport;
+	case NoticeKind::Online: return st::menuIconUserShow;
+	case NoticeKind::Mention: return MentionIcon(reply);
+	case NoticeKind::Copy: return st::menuIconCopy;
+	case NoticeKind::Script: return st::menuIconExperimental;
+	}
+	Unexpected("Kind in Tele::KindIcon.");
+}
+
+[[nodiscard]] const style::color &KindColor(const Notice &notice) {
+	switch (notice.tone) {
+	case NoticeTone::Info: return st::settingsIconBg4;
+	case NoticeTone::Success: return st::settingsIconBg2;
+	case NoticeTone::Warning: return st::settingsIconBg3;
+	case NoticeTone::Critical: return st::settingsIconBg1;
+	case NoticeTone::None: break;
+	}
+	switch (notice.kind) {
+	case NoticeKind::Limit: return st::settingsIconBg8;
+	case NoticeKind::Server: return st::settingsIconBg4;
+	case NoticeKind::Tele: return st::settingsIconBg5;
+	case NoticeKind::Update: return st::settingsIconBg2;
+	case NoticeKind::Crash: return st::settingsIconBg1;
+	case NoticeKind::Online: return st::settingsIconBg6;
+	case NoticeKind::Mention: return st::settingsIconBg4;
+	case NoticeKind::Copy: return st::settingsIconBg3;
+	case NoticeKind::Script: return st::settingsIconBg6;
+	}
+	Unexpected("Kind in Tele::KindColor.");
+}
+
+[[nodiscard]] QString TimeAgo(TimeId date) {
+	const auto now = base::unixtime::now();
+	const auto seconds = std::max(now - date, 0);
+	if (seconds < 60) {
+		return Tr(u"Just now"_q);
+	} else if (seconds < 3600) {
+		return Tr(u"%1 m ago"_q).arg(seconds / 60);
+	} else if (seconds < 86400) {
+		return Tr(u"%1 h ago"_q).arg(seconds / 3600);
+	}
+	const auto parsed = base::unixtime::parse(date);
+	return QLocale().toString(parsed.date(), QLocale::ShortFormat);
+}
+
+[[nodiscard]] TextWithEntities FullText(const Notice &notice) {
+	auto result = TextWithEntities{ notice.title };
+	if (!notice.text.text.isEmpty()) {
+		if (!result.text.isEmpty()) {
+			result.append('\n');
+		}
+		result.append(notice.text);
+	}
+	return result;
+}
