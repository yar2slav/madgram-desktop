+[[nodiscard]] Requirement GhostSwitches() {
+	return Requirement(::Tele::kOptionGhost, [](
+			not_null<::Main::Session*> session) {
+		return rpl::combine(
+			::Tele::GhostValue(),
+			::Tele::GhostChatsCountValue(
+				session,
+				::Tele::GhostOverride::Always)
+		) | rpl::map([](bool ghost, int always) {
+			return ghost || (always > 0);
+		});
+	});
+}
