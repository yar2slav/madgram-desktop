+void AddAppIcons(SectionBuilder &builder) {
+	using Slot = ::Tele::IconSlot;
+	const auto controller = builder.controller();
+	for (const auto slot : { Slot::App, Slot::Tray }) {
+		const auto app = slot == Slot::App;
+		AddIconButton(builder,
+			app ? ::Tele::kOptionAppIcon : ::Tele::kOptionTrayIcon,
+			(app ? ::Tele::AppIconValue() : ::Tele::TrayIconValue())
+				| rpl::map([=](const QString &value) {
+					return ::Tele::IconPresetName(value, slot);
+				}),
+			[=](not_null<Ui::PopupMenu*> menu) {
+				for (const auto &value : { u"red"_q, u"white"_q, u"telegram"_q }) {
+					menu->addAction(::Tele::IconPresetName(value, slot), [=] {
+						::Tele::SetIconPreset(slot, value);
+					}, &st::menuIconPhoto);
+				}
+				menu->addAction(::Tele::Tr(u"Choose an image..."_q), [=] {
+					ChooseIconFile(controller, slot);
+				}, &st::menuIconPhoto);
+				if (!app) {
+					menu->addAction(::Tele::Tr(u"Same as the app icon"_q), [] {
+						::Tele::SetTraySameAsApp();
+					}, &st::menuIconPhotoSet);
+				}
+				menu->addAction(::Tele::Tr(u"Reset to default"_q), [=] {
+					::Tele::ResetIcon(slot);
+				}, &st::menuIconRestore);
+			});
+	}
+}
