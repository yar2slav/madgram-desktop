-				: object_ptr<Button>(object_ptr<::Tele::SettingButton>(container, nullptr, style));
-			const auto button = result.data();
-			if (!icon) {
-				::Tele::SetupSettingText(button,
-					rpl::duplicate(args.title) | rpl::map([](const QString &text) {
-						return TextWithEntities::Simple(text);
