+void NewSection::setupContent() {
+	_content = Ui::CreateChild<Ui::VerticalLayout>(this);
+	if (const auto version = ReleaseWithOption(
+			controller()->highlightControlId())) {
+		_version = version;
+		_versionPicked = true;
+	} else {
+		_version = DefaultNewVersion();
+	}
+	::Tele::ChangelogHistoryChanges(
+	) | rpl::on_next([=] {
+		const auto was = _version;
+		if (!_versionPicked) {
+			_version = DefaultNewVersion();
+		}
+		refreshTabs();
+		if (_version != was || !_query.isEmpty()) {
+			rebuild();
+		}
+	}, lifetime());
+	::Tele::RefreshChangelogHistory();
+	rebuild();
+	Ui::ResizeFitChild(this, _content);
+}
+
+void NewSection::refreshTabs() {
+	if (!_tabs) {
+		return;
+	}
+	auto tabs = std::vector<Ui::SubTabs::Tab>();
+	for (const auto &release : ::Tele::ChangelogHistory()) {
+		tabs.push_back({
+			.id = QString::number(release.version),
+			.text = { u"mad %1"_q.arg(release.version) },
+		});
+	}
+	_tabs->setTabs(std::move(tabs));
+	if (HasRelease(_version)) {
+		_tabs->setActiveTab(QString::number(_version));
+	}
+}
+
+void NewSection::pickVersion(int version) {
+	_versionPicked = true;
+	if (_tabs) {
+		_tabs->setActiveTab(QString::number(version));
+	}
+	if (_version != version) {
+		_version = version;
+		rebuild();
+	}
+}
