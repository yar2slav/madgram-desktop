+[[nodiscard]] int LowercaseHeight(const style::font &font) {
+	return -QFontMetrics(font->f).tightBoundingRect(u"x"_q).top();
+}
+
+[[nodiscard]] not_null<Ui::RpWidget*> CreateNewPill(
+		not_null<Ui::RpWidget*> parent) {
+	const auto &st = st::settingsPremiumNewBadge;
+	const auto &base = st::settingsPremiumNewBadgePadding;
+	const auto font = st.style.font;
+	const auto vertical = base.top() + base.bottom();
+	const auto shift = font->height
+		- 2 * font->ascent
+		+ LowercaseHeight(font);
+	const auto top = std::clamp((vertical + shift) / 2, 0, vertical);
+	const auto padding = style::margins(
+		base.left(),
+		top,
+		base.right(),
+		vertical - top);
+	const auto badge = Ui::CreateChild<Ui::PaddingWrap<Ui::FlatLabel>>(
+		parent.get(),
+		object_ptr<Ui::FlatLabel>(
+			parent,
+			::Tele::Tr(u"NEW"_q),
+			st),
+		padding);
+	badge->show();
+	badge->setAttribute(Qt::WA_TransparentForMouseEvents);
+	badge->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(badge);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgActive);
+		const auto radius = base.left();
+		p.drawRoundedRect(badge->rect(), radius, radius);
+	}, badge->lifetime());
+	return badge;
+}
+
+[[nodiscard]] int NewPillTop(
+		const style::font &font,
+		int lineTop,
+		not_null<Ui::RpWidget*> pill) {
+	return lineTop
+		+ font->ascent
+		- (LowercaseHeight(font) + pill->height()) / 2;
+}
+
+void AddNewBadge(not_null<Button*> button, const QString &title) {
+	const auto badge = CreateNewPill(button);
+	rpl::combine(
+		button->widthValue(),
+		::Tele::NewSettingsSeenValue()
+	) | rpl::on_next([=](int width, bool seen) {
+		const auto &st = st::settingsButton;
+		const auto left = st.padding.left()
+			+ st.style.font->width(title)
+			+ st.style.font->spacew;
+		const auto available = width - left - st.padding.right();
+		badge->setVisible(!seen && available >= badge->width());
+		if (!badge->isHidden()) {
+			const auto top = NewPillTop(
+				st.style.font,
+				st.padding.top(),
+				badge);
+			badge->moveToLeft(left, top, width);
+		}
+	}, badge->lifetime());
+}
