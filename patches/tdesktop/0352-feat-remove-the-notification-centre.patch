-	}
-	const auto name = ::Tele::Tr(u"Debug logs"_q);
-	const auto description = ::Tele::Tr(u"Turning them off restarts the app."_q);
-	builder.add([&](const WidgetContext &ctx) {
-		const auto controller = ctx.controller;
-		auto row = CreateOptionRow(ctx.container, controller, name, description);
-		const auto button = row.button;
-		const auto state = button->lifetime().make_state<
-			rpl::variable<bool>>(Logs::DebugEnabled());
-		button->toggleOn(state->value());
-		button->toggledChanges(
-		) | rpl::filter([](bool toggled) {
-			return (toggled != Logs::DebugEnabled());
-		}) | rpl::on_next([=] {
-			const auto text = Logs::DebugEnabled()
-				? u"Do you want to disable DEBUG logs?"_q
-				: u"Do you want to enable DEBUG logs?\n\n"
-					"All network events will be logged."_q;
-			auto box = Ui::MakeConfirmBox({
-				.text = ::Tele::Lower(text),
-				.confirmed = [](Fn<void()> close) {
-					Core::App().switchDebugMode();
-					close();
-				},
-			});
-			const auto weak = base::make_weak(button);
-			box->boxClosing() | rpl::on_next([=] {
-				if (weak) {
-					state->force_assign(Logs::DebugEnabled());
-				}
-			}, box->lifetime());
-			controller->show(std::move(box));
-		}, button->lifetime());
