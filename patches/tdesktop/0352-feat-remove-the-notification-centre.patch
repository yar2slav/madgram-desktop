+		const auto parent = QString::fromLatin1(requirement.id);
+		if (ids.emplace(parent).second) {
+			AddAncestors(ids, parent);
+		}
+	}
+}
+
+void RedirectHighlight(
+		not_null<Window::SessionController*> controller,
+		const QString &id,
+		const QString &name) {
+	if (controller->highlightControlId() != id) {
+		return;
+	}
+	const auto requirement = HiddenBy(&controller->session(), id);
+	if (!requirement) {
+		return;
+	}
+	const auto &option = base::options::details::Lookup(requirement->id);
+	controller->setHighlightControlId(option.id());
+	controller->showToast(::Tele::Tr(requirement->off
+		? u"Turn off \"%1\" to see \"%2\"."_q
+		: u"Turn on \"%1\" to see \"%2\"."_q).arg(::Tele::Tr(option.name()), name));
+}
+
+void WithParent(
+		SectionBuilder &builder,
+		const QString &id,
+		const QString &name,
+		Parent parent,
+		FnMut<void()> add,
+		const QString &owner = QString()) {
+	if (parent.list.empty()) {
+		add();
+		return;
+	}
+	const auto &first = parent.list.front();
+	const auto sub = CurrentGroup
+		&& (parent.list.size() == 1)
+		&& !first.off
+		&& !first.value
+		&& (CurrentGroup->id == QString::fromLatin1(first.id));
+	Parents()[id] = std::move(parent);
+	if (sub) {
+		SubRows().emplace(id);
+	}
+	if (!Shown(owner.isEmpty() ? id : owner)) {
+		return;
+	}
+	if (const auto controller = builder.controller()) {
+		RedirectHighlight(controller, id, name);
+	}
+	if (sub) {
+		const auto outer = std::exchange(CurrentSubRow, &id);
+		add();
+		CurrentSubRow = outer;
+	} else {
+		builder.scope(std::move(add), ShownValue(builder.session(), id));
+	}
+}
