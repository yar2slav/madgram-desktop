+			_photoCache.setDevicePixelRatio(ratio);
+		}
+		auto hq = PainterHighQualityEnabler(p);
+		auto path = QPainterPath();
+		path.addRoundedRect(
+			_photoRect,
+			st::roundRadiusLarge,
+			st::roundRadiusLarge);
+		p.setClipPath(path);
+		p.drawImage(_photoRect, _photoCache);
+		p.setClipping(false);
+	}
+}
+
+void Entry::paintBadgedUserpic(QPainter &p, int x, int y, int size) {
+	const auto badge = style::ConvertScale(kBadgeSize);
+	const auto stroke = style::ConvertScale(kBadgeStroke);
+	const auto inner = size - badge + style::ConvertScale(kBadgeShift);
+	const auto ratio = style::DevicePixelRatio();
+	const auto key = _from->userpicUniqueKey(_userpic);
+	if (_userpicKey != key
+		|| _userpicCache.size() != QSize(size, size) * ratio) {
+		_userpicKey = key;
+		_userpicCache = QImage(
+			QSize(size, size) * ratio,
+			QImage::Format_ARGB32_Premultiplied);
+		_userpicCache.setDevicePixelRatio(ratio);
+		_userpicCache.fill(Qt::transparent);
+		auto q = QPainter(&_userpicCache);
+		_from->paintUserpic(q, _userpic, 0, 0, size);
+		auto hq = PainterHighQualityEnabler(q);
+		q.setCompositionMode(QPainter::CompositionMode_Clear);
+		q.setPen(Qt::NoPen);
+		q.setBrush(Qt::black);
+		q.drawEllipse(
+			inner - stroke,
+			inner - stroke,
+			badge + 2 * stroke,
+			badge + 2 * stroke);
+	}
+	const auto left = rtl() ? (width() - x - size) : x;
+	p.drawImage(left, y, _userpicCache);
+	const auto badgeLeft = left + inner;
+	const auto badgeTop = y + inner;
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(KindColor(_notice));
+		p.drawEllipse(badgeLeft, badgeTop, badge, badge);
+	}
+	const auto &icon = MentionBadgeIcon(_reply);
+	icon.paint(
+		p,
+		badgeLeft + (badge - icon.width()) / 2,
+		badgeTop + (badge - icon.height()) / 2,
+		width(),
+		st::settingsIconFg->c);
+}
+
+void Entry::contextMenuEvent(QContextMenuEvent *e) {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	fillMenu(_menu.get());
+	_menu->popup(e->globalPos());
+}
+
+void Entry::fillMenu(not_null<Ui::PopupMenu*> menu) {
+	const auto text = _value ? _notice.value : FullText(_notice);
+	menu->addAction(Tr(u"Copy"_q), [=] {
+		TextUtilities::SetClipboardText(TextForMimeData::Rich(
+			base::duplicate(text)));
+	}, &st::menuIconCopy);
+	const auto session = &_controller->session();
+	const auto id = _notice.id;
+	menu->addAction(Tr(u"Delete"_q), [=] {
+		crl::on_main(session, [=] {
+			RemoveNotice(session, id);
+		});
+	}, &st::menuIconDelete);
+}
+
+void Entry::activate() {
+	if (_value) {
+		TextUtilities::SetClipboardText(TextForMimeData::Rich(
+			base::duplicate(_notice.value)));
+		_controller->showToast(Tr(u"Copied to clipboard."_q));
+	} else if (_notice.kind == NoticeKind::Mention && _notice.peer) {
+		ShowMentionNotice(_controller, _notice);
+	} else if (_notice.peer) {
+		_controller->showPeerHistory(
+			PeerId(PeerIdHelper(_notice.peer)),
+			Window::SectionShow::Way::Forward);
+	} else if (_notice.kind == NoticeKind::Update && !_buttons.empty()) {
+		UrlClickHandler::Open(
+			_notice.buttons.front().url,
+			LinkContext(_controller));
+	}
+}
+
+class NoticesSection final
+	: public ::Settings::Section<NoticesSection> {
+public:
+	NoticesSection(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller);
+
+	[[nodiscard]] rpl::producer<QString> title() override;
+	void fillTopBarMenu(const Ui::Menu::MenuCallback &addAction) override;
+	base::weak_qptr<Ui::RpWidget> createPinnedToTop(
+		not_null<QWidget*> parent) override;
+
+private:
+	void changed();
+	void rebuild();
+
+	const not_null<Main::Session*> _session;
+	const not_null<Ui::VerticalLayout*> _content;
+	Filter _filter = Filter::All;
+	base::flat_set<uint64> _fresh;
+	std::vector<uint64> _shown;
+	std::vector<QPointer<Entry>> _entries;
+	base::Timer _timer;
+	bool _built = false;
+
+};
+
+NoticesSection::NoticesSection(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: ::Settings::Section<NoticesSection>(parent, controller)
+, _session(&controller->session())
+, _content(Ui::CreateChild<Ui::VerticalLayout>(this))
+, _timer([=] {
+	for (const auto &entry : _entries) {
+		if (entry) {
+			entry->refreshTime();
+		}
+	}
+}) {
+	Ui::ResizeFitChild(this, _content);
+	_timer.callEach(kRefreshTimeAgo);
+	NoticesChanges(
+		_session
+	) | rpl::on_next([=] {
+		changed();
+	}, lifetime());
+	changed();
+}
+
+rpl::producer<QString> NoticesSection::title() {
+	return rpl::single(Tr(u"Notifications"_q));
+}
+
+void NoticesSection::fillTopBarMenu(
+		const Ui::Menu::MenuCallback &addAction) {
+	if (Notices(_session).empty()) {
+		return;
+	}
+	const auto session = _session;
+	const auto window = controller();
+	addAction({
+		.text = Tr(u"Clear all"_q),
+		.handler = [=] {
+			window->show(Ui::MakeConfirmBox({
+				.text = Tr(u"Clear all notifications?"_q),
+				.confirmed = [=](Fn<void()> close) {
+					ClearNotices(session);
+					close();
+				},
+				.confirmText = Tr(u"Clear"_q),
+				.confirmStyle = &st::attentionBoxButton,
+			}));
+		},
+		.icon = &st::menuIconDeleteAttention,
+		.isAttention = true,
+	});
+}
+
+base::weak_qptr<Ui::RpWidget> NoticesSection::createPinnedToTop(
+		not_null<QWidget*> parent) {
+	const auto wrap = Ui::CreateChild<Ui::VerticalLayout>(parent.get());
+	auto tabs = std::vector<Ui::SubTabs::Tab>();
+	for (const auto &[filter, name] : {
+			std::pair{ Filter::All, u"All"_q },
+			std::pair{ Filter::Mentions, u"Mentions"_q },
+			std::pair{ Filter::Limits, u"Limits"_q },
+			std::pair{ Filter::Server, u"Server"_q },
+			std::pair{ Filter::Tele, u"tele"_q },
+			std::pair{ Filter::Copied, u"Copied"_q },
+			std::pair{ Filter::Scripts, u"Scripts"_q } }) {
+		tabs.push_back({
+			.id = FilterId(filter),
+			.text = { Lower(name) },
+		});
+	}
+	const auto subtabs = wrap->add(
+		object_ptr<Ui::SubTabs>(
+			wrap,
+			st::defaultSubTabs,
+			Ui::SubTabs::Options{
+				.selected = FilterId(_filter),
+				.centered = true,
+			},
+			std::move(tabs)),
+		QMargins(0, st::boxRowPadding.left() / 2, 0, 0));
+	subtabs->activated(
+	) | rpl::on_next([=](const QString &id) {
+		subtabs->setActiveTab(id);
+		const auto filter = FilterFromId(id);
+		if (_filter != filter) {
+			_filter = filter;
+			rebuild();
+		}
+	}, subtabs->lifetime());
+	wrap->paintRequest(
+	) | rpl::on_next([=](QRect clip) {
+		QPainter(wrap).fillRect(clip, st::windowBg);
+	}, wrap->lifetime());
+	return base::make_weak(static_cast<Ui::RpWidget*>(wrap));
+}
+
+void NoticesSection::changed() {
+	auto unread = false;
+	auto shown = std::vector<uint64>();
+	for (const auto &notice : Notices(_session)) {
+		if (notice.unread) {
+			_fresh.emplace(notice.id);
+			unread = true;
+		}
+		if (Matches(_filter, notice.kind)) {
+			shown.push_back(notice.id);
+		}
+	}
+	if (!_built || shown != _shown) {
+		rebuild();
+	}
+	if (unread) {
+		crl::on_main(this, [=] {
+			MarkNoticesRead(_session);
+		});
+	}
+}
+
+void NoticesSection::rebuild() {
+	_built = true;
+	_shown.clear();
+	_entries.clear();
+	_content->clear();
+	const auto &list = Notices(_session);
+	for (const auto &notice : list) {
+		if (!Matches(_filter, notice.kind)) {
+			continue;
+		}
+		_shown.push_back(notice.id);
+		_entries.push_back(_content->add(object_ptr<Entry>(
+			_content,
+			controller(),
+			notice,
+			_fresh.contains(notice.id))));
+	}
+	if (_shown.empty()) {
+		_content->add(
+			object_ptr<Ui::FlatLabel>(
+				_content,
+				Lower(list.empty()
+					? Tr(u"No notifications yet."_q)
+					: Tr(u"Nothing here."_q)),
+				st::boxDividerLabel),
+			st::boxRowPadding + QMargins(
+				0,
+				st::boxRowPadding.left(),
+				0,
+				st::boxRowPadding.left()),
+			style::al_top);
+	}
+	_content->resizeToWidth(width());
+}
+
+} // namespace
+
+void ShowNotices(not_null<Window::SessionController*> controller) {
+	if (NoticesCentre()) {
+		controller->showSettings(NoticesSection::Id());
+	}
+}
+
