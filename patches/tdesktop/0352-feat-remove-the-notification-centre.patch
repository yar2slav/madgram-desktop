+[[nodiscard]] QString UpdateStatusText(const ::Tele::UpdateStatus &status) {
+	using State = ::Tele::UpdateState;
+	switch (status.state) {
+	case State::Disabled:
+		return status.error.isEmpty()
+			? ::Tele::Tr(u"Local builds don't update themselves."_q)
+			: ::Tele::Lower(status.error);
+	case State::Idle:
+		return ::Tele::Tr(u"Not checked yet."_q);
+	case State::Checking:
+		return ::Tele::Tr(u"Checking for updates..."_q);
+	case State::Latest:
+		return ::Tele::Tr(u"You have the latest build."_q);
+	case State::Downloading:
+		return (status.total > 0)
+			? ::Tele::Tr(u"Downloading %1: %2%"_q).arg(status.tag).arg(
+				status.ready * 100 / status.total)
+			: ::Tele::Tr(u"Downloading %1..."_q).arg(status.tag);
+	case State::Ready:
+		return u"%1 is ready, restart to update."_q.arg(status.tag);
+	case State::Failed:
+		return ::Tele::Tr(u"Update failed: %1"_q).arg(status.error);
+	}
+	return QString();
+}
