+void MigrateHideCalls() {
+	if (!HideCallsOption.value()) {
+		return;
+	}
+	HideCallsOption.set(false);
+	if (CallButtonOption.value().isEmpty()) {
+		CallButtonOption.set(u"hide"_q);
+	}
+}
+
+void HashTitleBuild(base::options::option<QString> &option) {
+	const auto value = option.value();
+	if (value == option.defaultValue()) {
+		return;
+	}
+	const auto hashed = Titles::HashBuilds(value);
+	if (hashed != value) {
+		option.set(hashed);
+	}
+}
+
+void MigrateTitleBuild() {
+	if (TitleBuildHashOption.value()) {
+		return;
+	}
+	TitleBuildHashOption.set(true);
+	HashTitleBuild(TitleTemplateOption);
+	HashTitleBuild(WindowTitleTemplateOption);
+}
