+	add(u"badges"_q, u"Badges"_q, st::menuIconStar,
+		{ u"mad"_q, u"бейджи"_q, u"значки"_q }, FillMadBadges);
+	add(u"server"_q, u"Server"_q, st::menuIconLink,
