+void TeleSection::buildIndex() {
+	const auto session = &controller()->session();
+	const auto push = [&](
+			SearchEntry &&entry,
+			const QString &subtitle,
+			not_null<const style::icon*> icon) {
+		auto text = entry.title;
+		for (const auto &keyword : entry.keywords) {
+			text += ' ' + keyword;
+		}
+		_index.push_back({
+			.entry = std::move(entry),
+			.terms = SearchWords(text),
+			.subtitle = subtitle,
+			.icon = icon,
+		});
+	};
+	for (const auto &category : Categories()) {
+		const auto add = [&](SearchEntry &&entry) {
+			push(
+				std::move(entry),
+				::Tele::Tr(category.title),
+				category.icon);
+		};
+		add({
+			.title = ::Tele::Tr(category.title),
+			.keywords = category.keywords,
+			.section = category.id,
+		});
+		for (auto &entry : category.helper->index(session)) {
+			add(std::move(entry));
+		}
+	}
+	for (auto &entry : kMeta.index(session)) {
+		if (entry.id == kNewId) {
+			entry.id = QString();
+			entry.section = NewSection::Id();
+			push(std::move(entry), u"mad"_q, &st::menuIconStar);
+		} else if (!entry.id.isEmpty()) {
+			push(std::move(entry), u"mad"_q, &st::menuIconCustomize);
+		}
+	}
+}
+
+void TeleSection::applyQuery(const QString &query) {
+	const auto words = SearchWords(query);
+	const auto searching = !words.isEmpty();
+	_main->toggle(!searching, anim::type::instant);
+	_results->toggle(searching, anim::type::instant);
+	const auto list = _results->entity();
+	list->clear();
+	_openFirst = nullptr;
+	if (!searching) {
+		return;
+	} else if (_index.empty()) {
+		buildIndex();
+	}
+	for (const auto &result : _index) {
+		if (!MatchesWords(result.terms, words)) {
+			continue;
+		}
+		const auto &entry = result.entry;
+		const auto button = AddResultButton(
+			list,
+			entry.title,
+			(entry.id.isEmpty() ? u"mad"_q : result.subtitle),
+			result.icon);
+		const auto id = entry.id;
+		const auto section = entry.section;
+		const auto open = [=] {
+			if (!id.isEmpty()) {
+				controller()->setHighlightControlId(id);
+			}
+			showOther(section);
+		};
+		button->addClickHandler(open);
+		SetupCopyLink(button, section, id);
+		if (!_openFirst) {
+			_openFirst = open;
+		}
+	}
+	if (!_openFirst) {
