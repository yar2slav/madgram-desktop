+void InvisibleNamesPhraseBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<::Main::Session*> session) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionInvisibleNamesPhrase);
+	box->setTitle(rpl::single(::Tele::Tr(option.name())));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(::Tele::DefaultInvisibleNamesPhrase()),
+		::Tele::InvisibleNamesPhrase()));
+	box->addRow(
+		::Tele::CreateInvisibleNamesPreview(
+			box,
+			session,
+			rpl::single(
+				rpl::empty
+			) | rpl::then(field->changes()) | rpl::map([=] {
+				return field->getLastText();
+			})),
+		style::margins(
+			st::boxRowPadding.left() - st::defaultDialogRow.padding.left(),
+			0,
+			0,
+			0));
+	const auto save = [=] {
+		const auto phrase = ::Tele::NormalizeInvisibleNamesPhrase(
+			field->getLastText());
+		if (phrase.isEmpty()) {
+			field->showError();
+			return;
+		}
+		::Tele::SetInvisibleNamesPhrase(phrase);
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+		field->selectAll();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(::Tele::Tr(u"Reset"_q)), [=] {
+		::Tele::SetInvisibleNamesPhrase(QString());
+		box->closeBox();
+	});
+}
