+base::weak_qptr<Ui::RpWidget> NewSection::createPinnedToTop(
+		not_null<QWidget*> parent) {
+	const auto wrap = Ui::CreateChild<Ui::VerticalLayout>(parent.get());
+	const auto skip = st::boxRowPadding.left() / 2;
+	_tabsWrap = wrap->add(object_ptr<Ui::SlideWrap<Ui::SubTabs>>(
+		wrap,
+		object_ptr<Ui::SubTabs>(
+			wrap,
+			st::defaultSubTabs,
+			Ui::SubTabs::Options{ .centered = true }),
+		QMargins(0, skip, 0, skip)));
+	_tabs = _tabsWrap->entity();
+	refreshTabs();
+	_tabsWrap->toggle(_query.isEmpty(), anim::type::instant);
+	_tabs->activated(
+	) | rpl::on_next([=](const QString &id) {
+		pickVersion(id.toInt());
+	}, _tabs->lifetime());
+	auto search = CreateSectionSearchRow(wrap, _query);
+	_searchController = std::move(search.controller);
+	_searchField = search.field;
+	const auto row = search.row;
+	wrap->add(object_ptr<Ui::RpWidget>::fromRaw(row));
+	_searchController->queryValue(
+	) | rpl::on_next([=](const QString &query) {
+		setQuery(query);
+	}, row->lifetime());
+	wrap->paintRequest(
+	) | rpl::on_next([=](QRect clip) {
+		QPainter(wrap).fillRect(clip, st::windowBg);
+	}, wrap->lifetime());
+	return base::make_weak(static_cast<Ui::RpWidget*>(wrap));
+}
