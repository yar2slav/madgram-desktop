+void AddOptionToggleRow(
+		SectionBuilder &builder,
+		base::options::toggle &option,
+		QStringList keywords) {
+	if (!Shown(option.id())) {
+		return;
+	}
+	const auto name = ::Tele::Tr(option.name());
+	const auto description = ::Tele::Tr(option.description());
+	builder.add([&](const WidgetContext &ctx) {
+		const auto controller = ctx.controller;
+		auto row = CreateOptionRow(ctx.container, controller, name, description);
+		const auto button = row.button;
+		const auto title = row.title;
+		const auto about = row.about;
+		button->toggleOn(rpl::single(
+			rpl::empty
+		) | rpl::then(
+			option.changes()
+		) | rpl::map([&option] {
+			return option.value();
+		}));
+
+		const auto restart = OptionRestarter(button, controller, option);
+		button->toggledChanges(
+		) | rpl::filter([&option](bool toggled) {
+			return (toggled != option.value());
+		}) | rpl::on_next([=, &option](bool toggled) {
+			option.set(toggled);
+			if (restart) {
+				restart();
+			}
+		}, button->lifetime());
+		BlockClicksWhenDisabled(button);
+		ApplySubRow(button, [=](std::optional<QColor> color) {
+			button->setDisabled(color.has_value());
+			button->setColorOverride(color);
+			if (title) {
+				title->setTextColorOverride(color);
+			}
+			if (about) {
+				about->setTextColorOverride(AboutColor(color));
+			}
+		});
+		SetupLink(button, option.id());
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(row.widget),
+			.align = style::al_justify,
+		};
+	}, [&] {
+		keywords.push_back(description);
+		return SearchEntry{
+			.id = option.id(),
+			.title = name,
+			.keywords = std::move(keywords),
+		};
+	});
+}
+
+struct GroupState {
+	GroupState()
+	: toggle(st::settingsButtonNoIcon.toggle, false, [this] {
+		if (check) {
+			check->update();
+		}
+	}) {
+	}
+
+	QPointer<Ui::RpWidget> check;
+	QPointer<Ui::RpWidget> arrow;
+	QPointer<Ui::SlideWrap<Ui::VerticalLayout>> wrap;
+	Ui::ToggleView toggle;
+	Ui::Animations::Simple animation;
+	rpl::variable<QString> counter;
+};
+
+[[nodiscard]] std::shared_ptr<GroupState> AddOptionGroupRow(
+		SectionBuilder &builder,
+		base::options::toggle &option,
+		QStringList keywords) {
+	const auto name = ::Tele::Tr(option.name());
+	const auto description = ::Tele::Tr(option.description());
+	auto result = std::shared_ptr<GroupState>();
+	builder.add([&](const WidgetContext &ctx) {
+		const auto controller = ctx.controller;
+		const auto state = std::make_shared<GroupState>();
+		result = state;
+		const auto &st = st::settingsButtonNoIcon;
+		const auto right = st::rightsButtonToggleWidth
+			+ st::permissionsExpandIcon.width()
+			+ st::rightsButtonArrowSkip;
+		auto text = state->counter.value(
+		) | rpl::map([=](const QString &counter) {
+			auto result = TextWithEntities::Simple(name);
+			if (!counter.isEmpty()) {
+				result.append(tr::bold(u"  "_q + counter));
+			}
+			return result;
+		});
+		auto widget = object_ptr<Ui::RpWidget>(nullptr);
+		auto button = (Button*)nullptr;
+		auto title = (Ui::FlatLabel*)nullptr;
+		auto about = (Ui::FlatLabel*)nullptr;
+		const auto helpWidth = description.isEmpty() ? 0 : st::madSettingHelpSize;
+		auto owned = object_ptr<::Tele::SettingButton>(ctx.container, nullptr, st);
+		button = owned.data();
+		title = ::Tele::SetupSettingText(button, std::move(text), nullptr, right + helpWidth);
+		widget = std::move(owned);
+		AddSettingHelp(button, controller, name, description,
+			st::rightsButtonToggleWidth + st::rightsButtonArrowSkip);
+		const auto root = widget.data();
+		root->lifetime().add([state] {});
+
+		const auto arrow = Ui::CreateChild<Ui::RpWidget>(root);
+		state->arrow = arrow;
+		arrow->resize(st::permissionsExpandIcon.size());
+		arrow->setAttribute(Qt::WA_TransparentForMouseEvents);
+		arrow->paintRequest(
+		) | rpl::on_next([=] {
+			auto p = QPainter(arrow);
+			const auto &icon = st::permissionsExpandIcon;
+			const auto wrap = state->wrap.data();
+			const auto progress = state->animation.value(
+				(wrap && wrap->toggled()) ? 1. : 0.);
+			auto hq = std::optional<PainterHighQualityEnabler>();
+			if (progress > 0.) {
+				const auto center = QPointF(
+					icon.width() / 2.,
+					icon.height() / 2.);
+				hq.emplace(p);
+				p.translate(center);
+				p.rotate(progress * 180.);
+				p.translate(-center);
+			}
+			icon.paint(p, 0, 0, arrow->width());
+		}, arrow->lifetime());
+
+		const auto toggleButton = Ui::CreateChild<Button>(
+			root,
+			nullptr,
+			st);
+		const auto check = Ui::CreateChild<Ui::RpWidget>(toggleButton);
+		state->check = check;
+		check->resize(state->toggle.getSize());
+		check->setAttribute(Qt::WA_TransparentForMouseEvents);
+		check->paintRequest(
+		) | rpl::on_next([=] {
+			auto p = QPainter(check);
+			state->toggle.paint(p, 0, 0, check->width());
+		}, check->lifetime());
+		const auto separator = Ui::CreateChild<Ui::RpWidget>(root);
+		separator->paintRequest(
+		) | rpl::on_next([=] {
+			auto p = QPainter(separator);
+			p.fillRect(
+				separator->rect(),
+				st::settingsButtonNoIcon.textBgOver);
+		}, separator->lifetime());
+
+		const auto reposition = [=] {
+			const auto &st = st::settingsButtonNoIcon;
+			const auto width = root->width();
+			const auto height = root->height();
+			const auto toggleWidth = st::rightsButtonToggleWidth;
+			toggleButton->setGeometry(
+				width - toggleWidth,
+				0,
+				toggleWidth,
+				height);
+			check->moveToRight(
+				st.toggleSkip,
+				(height - check->height()) / 2);
+			const auto line = 2 * st.toggle.border + st.toggle.diameter;
+			separator->setGeometry(
+				toggleButton->x() - st::lineWidth,
+				(height - line) / 2,
+				st::lineWidth,
+				line);
+			const auto skip = st::rightsButtonArrowSkip;
+			const auto limit = toggleButton->x() - skip - arrow->width() - helpWidth;
+			arrow->moveToLeft(limit, (height - arrow->height()) / 2);
+		};
+		root->sizeValue() | rpl::on_next([=] {
+			reposition();
+		}, root->lifetime());
+
+		rpl::single(
+			rpl::empty
+		) | rpl::then(
+			option.changes()
+		) | rpl::on_next([=, &option] {
+			state->toggle.setChecked(option.value(), anim::type::normal);
+		}, toggleButton->lifetime());
+		state->toggle.finishAnimating();
+
+		const auto restart = OptionRestarter(root, controller, option);
+		toggleButton->setClickedCallback([=, &option] {
+			if (option.value()) {
+				option.set(false);
+			} else {
+				TurnOnOption(option.id().toUtf8().constData());
+			}
+			if (restart) {
+				restart();
+			}
+		});
+		button->setClickedCallback([=] {
+			if (const auto wrap = state->wrap.data()) {
+				wrap->toggle(!wrap->toggled(), anim::type::normal);
+			}
+		});
+		BlockClicksWhenDisabled(toggleButton);
+		ApplySubRow(root, [=](std::optional<QColor> color) {
+			toggleButton->setDisabled(color.has_value());
+			if (title) {
+				title->setTextColorOverride(color);
+			} else {
+				button->setColorOverride(color);
+			}
+			if (about) {
+				about->setTextColorOverride(AboutColor(color));
+			}
+		});
+		SetupLink(button, option.id());
+		SetupLink(toggleButton, option.id());
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(widget),
+			.align = style::al_justify,
+		};
+	}, [&] {
+		keywords.push_back(description);
+		return SearchEntry{
+			.id = option.id(),
+			.title = name,
+			.keywords = std::move(keywords),
+		};
+	});
+	return result;
+}
+
+void SetupGroup(
+		SectionBuilder &builder,
+		const std::shared_ptr<GroupState> &state,
+		not_null<Ui::SlideWrap<Ui::VerticalLayout>*> wrap,
+		const QString &id,
+		const std::vector<const char*> &toggles) {
+	state->wrap = wrap.get();
+	const auto &padding = st::settingsButtonNoIcon.padding;
+	wrap->entity()->add(
+		object_ptr<Ui::PlainShadow>(wrap->entity()),
+		QMargins(padding.left(), 0, padding.right(), 0));
+	if (!toggles.empty()) {
+		auto values = std::vector<rpl::producer<bool>>();
+		for (const auto toggle : toggles) {
+			values.push_back(OptionOnValue(toggle));
+		}
+		const auto total = int(toggles.size());
+		state->counter = rpl::combine(
+			std::move(values)
+		) | rpl::map([=](const std::vector<bool> &values) {
+			const auto on = ranges::count(values, true);
+			return u"%1/%2"_q.arg(on).arg(total);
+		});
+	}
+	auto expand = (Picked != nullptr);
+	if (const auto controller = builder.controller(); !expand) {
+		const auto highlight = controller
+			? controller->highlightControlId()
+			: QString();
+		if (!highlight.isEmpty() && highlight != id) {
+			auto ancestors = base::flat_set<QString>();
+			AddAncestors(ancestors, highlight);
+			expand = ancestors.contains(id);
+		}
+	}
+	wrap->toggle(expand, anim::type::instant);
+	wrap->toggledValue(
+	) | rpl::skip(1) | rpl::on_next([=](bool toggled) {
+		const auto raw = state.get();
+		raw->animation.start(
+			[=] {
+				if (const auto arrow = raw->arrow.data()) {
+					arrow->update();
+				}
+			},
+			toggled ? 0. : 1.,
+			toggled ? 1. : 0.,
+			st::slideWrapDuration);
+	}, wrap->lifetime());
+}
+
+void AddOptionGroup(
+		SectionBuilder &builder,
+		base::options::toggle &option,
+		QStringList keywords,
+		FnMut<void()> children) {
+	if (!Shown(option.id())) {
+		return;
+	}
+	const auto state = AddOptionGroupRow(builder, option, std::move(keywords));
+	auto group = OpenGroup{ .id = option.id() };
+	const auto outer = std::exchange(CurrentGroup, &group);
+	auto wrap = (Ui::SlideWrap<Ui::VerticalLayout>*)nullptr;
+	builder.scope(std::move(children), nullptr, [&](
+			SectionBuilder::ToggledScopePtr scope) {
+		wrap = scope;
+	});
+	CurrentGroup = outer;
+	GroupChildren()[option.id()] = group.toggles;
+	if (state && wrap) {
+		SetupGroup(builder, state, wrap, option.id(), group.toggles);
+	}
+}
+
+void AddOptionToggle(
+		SectionBuilder &builder,
+		const char id[],
+		QStringList keywords = {},
+		Parent parent = {},
+		FnMut<void()> children = nullptr) {
+	auto &option = base::options::lookup<bool>(id);
+	const auto name = ::Tele::Tr(option.name());
+	WithParent(builder, option.id(), name, std::move(parent), [&] {
+		if (children) {
+			AddOptionGroup(
+				builder,
+				option,
+				std::move(keywords),
+				std::move(children));
+		} else {
+			AddOptionToggleRow(builder, option, std::move(keywords));
+		}
+	});
+	if (CurrentGroup && SubRows().contains(option.id())) {
+		CurrentGroup->toggles.push_back(id);
+	}
+}
+
+void AddAbout(
+		SectionBuilder &builder,
+		const QString &owner,
+		const QString &text) {
+	if (!Shown(owner) || text.isEmpty()) {
+		return;
+	}
+	builder.add([&](const WidgetContext &ctx) {
+		for (const auto child : ctx.container->findChildren<QWidget*>()) {
+			const auto button = dynamic_cast<Button*>(child);
+			if (!button || button->property("mad-setting-id").toString() != owner
+					|| button->property("mad-help-width").toInt()) {
+				continue;
+			}
+			button->setProperty("mad-help-width", st::madSettingHelpSize);
+			AddSettingHelp(button, ctx.controller, button->accessibleName(), text,
+				button->st().padding.right());
+			break;
+		}
+		return SectionBuilder::WidgetToAdd{};
+	}, nullptr);
+}
