+void ServerBox(not_null<Ui::GenericBox*> box) {
+	box->setTitle(rpl::single(u"mad server"_q));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(::Tele::Tr(u"Server URL"_q)),
+		::Tele::ServerUrl()));
+	const auto save = [=] {
+		const auto url = ::Tele::NormalizeServerUrl(field->getLastText());
+		if (!url) {
+			field->showError();
+			return;
+		}
+		::Tele::SetServerUrl(*url);
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(::Tele::Tr(u"Reset"_q)), [=] {
+		::Tele::SetServerUrl(base::options::lookup<QString>(
+			::Tele::kOptionServerUrl).defaultValue());
+		box->closeBox();
+	});
+}
