+struct ServerSeen {
+	QString id;
+	int rev = 0;
+	bool toasted = false;
+};
+
+struct PendingCrash {
+	QString id;
+	bool freeze = false;
+};
+
+[[nodiscard]] std::vector<PendingCrash> &PendingCrashes() {
+	static auto result = std::vector<PendingCrash>();
+	return result;
+}
+
+constexpr auto kKindNames = std::array{
+	std::pair{ NoticeKind::Limit, "limit" },
+	std::pair{ NoticeKind::Server, "server" },
+	std::pair{ NoticeKind::Tele, "tele" },
+	std::pair{ NoticeKind::Update, "update" },
+	std::pair{ NoticeKind::Crash, "crash" },
+	std::pair{ NoticeKind::Online, "online" },
+	std::pair{ NoticeKind::Mention, "mention" },
+	std::pair{ NoticeKind::Copy, "copy" },
+	std::pair{ NoticeKind::Script, "script" },
+};
+
+constexpr auto kToneNames = std::array{
+	std::pair{ NoticeTone::None, "" },
+	std::pair{ NoticeTone::Info, "info" },
+	std::pair{ NoticeTone::Success, "success" },
+	std::pair{ NoticeTone::Warning, "warning" },
+	std::pair{ NoticeTone::Critical, "critical" },
+};
+
+constexpr auto kEntityNames = std::array{
+	std::pair{ EntityType::Bold, "bold" },
+	std::pair{ EntityType::Semibold, "semibold" },
+	std::pair{ EntityType::Italic, "italic" },
+	std::pair{ EntityType::Underline, "underline" },
+	std::pair{ EntityType::StrikeOut, "strikeout" },
+	std::pair{ EntityType::Spoiler, "spoiler" },
+	std::pair{ EntityType::Code, "code" },
+	std::pair{ EntityType::Pre, "pre" },
+	std::pair{ EntityType::Url, "url" },
+	std::pair{ EntityType::CustomUrl, "link" },
+	std::pair{ EntityType::CustomEmoji, "emoji" },
+	std::pair{ EntityType::Blockquote, "blockquote" },
+};
+
+template <typename Value, size_t Size>
+[[nodiscard]] QString NameOf(
+		const std::array<std::pair<Value, const char*>, Size> &names,
+		Value value) {
+	for (const auto &[known, name] : names) {
+		if (known == value) {
+			return QString::fromLatin1(name);
+		}
+	}
+	return QString();
+}
+
+template <typename Value, size_t Size>
+[[nodiscard]] std::optional<Value> ValueOf(
+		const std::array<std::pair<Value, const char*>, Size> &names,
+		const QString &name) {
+	for (const auto &[known, string] : names) {
+		if (name == QLatin1String(string)) {
+			return known;
+		}
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] bool LinkAllowed(const QString &url) {
+	return url.startsWith(u"https://"_q, Qt::CaseInsensitive)
+		|| url.startsWith(u"http://"_q, Qt::CaseInsensitive)
+		|| url.startsWith(u"tg://"_q, Qt::CaseInsensitive);
+}
+
+[[nodiscard]] TextWithEntities Sanitize(TextWithEntities text) {
+	const auto size = int(text.text.size());
+	auto &entities = text.entities;
+	entities.erase(ranges::remove_if(entities, [&](const EntityInText &e) {
+		return NameOf(kEntityNames, e.type()).isEmpty()
+			|| e.offset() < 0
+			|| e.length() <= 0
+			|| e.offset() + e.length() > size
+			|| (e.type() == EntityType::CustomUrl && !LinkAllowed(e.data()));
+	}), entities.end());
+	return text;
+}
+
+[[nodiscard]] QJsonArray SerializeEntities(const EntitiesInText &entities) {
+	auto result = QJsonArray();
+	for (const auto &entity : entities) {
+		result.push_back(QJsonArray{
+			NameOf(kEntityNames, entity.type()),
+			entity.offset(),
+			entity.length(),
+			entity.data(),
+		});
+	}
+	return result;
+}
+
+[[nodiscard]] EntitiesInText ParseEntities(const QJsonArray &list) {
+	auto result = EntitiesInText();
+	for (const auto &value : list) {
+		const auto fields = value.toArray();
+		const auto type = ValueOf(kEntityNames, fields.at(0).toString());
+		if (type) {
+			result.push_back(EntityInText(
+				*type,
+				fields.at(1).toInt(),
+				fields.at(2).toInt(),
+				fields.at(3).toString()));
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QJsonObject Serialize(const Notice &notice) {
+	auto buttons = QJsonArray();
+	for (const auto &button : notice.buttons) {
+		buttons.push_back(QJsonArray{ button.text, button.url });
+	}
+	auto result = QJsonObject();
+	result.insert(u"id"_q, QString::number(notice.id));
+	result.insert(u"kind"_q, NameOf(kKindNames, notice.kind));
+	result.insert(u"tone"_q, NameOf(kToneNames, notice.tone));
+	result.insert(u"date"_q, notice.date);
+	result.insert(u"key"_q, notice.key);
+	result.insert(u"rev"_q, notice.rev);
+	result.insert(u"title"_q, notice.title);
+	result.insert(u"text"_q, notice.text.text);
+	result.insert(u"entities"_q, SerializeEntities(notice.text.entities));
+	if (notice.kind == NoticeKind::Copy) {
+		result.insert(u"value"_q, notice.value.text);
+		result.insert(
+			u"ventities"_q,
+			SerializeEntities(notice.value.entities));
+	}
+	result.insert(u"buttons"_q, buttons);
+	result.insert(u"photo"_q, notice.photo);
+	result.insert(u"pw"_q, notice.photoSize.width());
+	result.insert(u"ph"_q, notice.photoSize.height());
+	result.insert(u"peer"_q, QString::number(notice.peer));
+	if (notice.kind == NoticeKind::Mention) {
+		result.insert(u"from"_q, QString::number(notice.from));
+		result.insert(u"msg"_q, QString::number(notice.msg));
+		result.insert(u"topic"_q, QString::number(notice.topic));
+		result.insert(u"source"_q, QString::number(notice.source));
+		result.insert(u"smsg"_q, QString::number(notice.sourceMsg));
+		if (notice.reply) {
+			result.insert(u"reply"_q, *notice.reply);
+		}
+	}
+	result.insert(u"unread"_q, notice.unread);
+	return result;
+}
+
+[[nodiscard]] std::optional<Notice> Parse(const QJsonObject &fields) {
+	const auto kind = ValueOf(kKindNames, fields.value(u"kind"_q).toString());
+	const auto tone = ValueOf(kToneNames, fields.value(u"tone"_q).toString());
+	const auto id = fields.value(u"id"_q).toString().toULongLong();
+	if (!kind || !tone || !id) {
+		return std::nullopt;
+	}
+	auto result = Notice{
+		.id = id,
+		.kind = *kind,
+		.tone = *tone,
+		.date = TimeId(fields.value(u"date"_q).toInt()),
+		.key = fields.value(u"key"_q).toString(),
+		.rev = fields.value(u"rev"_q).toInt(),
+		.title = fields.value(u"title"_q).toString(),
+		.text = Sanitize({
+			fields.value(u"text"_q).toString(),
+			ParseEntities(fields.value(u"entities"_q).toArray()),
+		}),
+		.value = Sanitize({
+			fields.value(u"value"_q).toString(),
+			ParseEntities(fields.value(u"ventities"_q).toArray()),
+		}),
+		.photo = fields.value(u"photo"_q).toString(),
+		.photoSize = QSize(
+			fields.value(u"pw"_q).toInt(),
+			fields.value(u"ph"_q).toInt()),
+		.peer = fields.value(u"peer"_q).toString().toULongLong(),
+		.from = fields.value(u"from"_q).toString().toULongLong(),
+		.msg = fields.value(u"msg"_q).toString().toLongLong(),
+		.topic = fields.value(u"topic"_q).toString().toLongLong(),
+		.source = fields.value(u"source"_q).toString().toULongLong(),
+		.sourceMsg = fields.value(u"smsg"_q).toString().toLongLong(),
+		.unread = fields.value(u"unread"_q).toBool(),
+	};
+	if (result.kind == NoticeKind::Mention && fields.contains(u"reply"_q)) {
+		result.reply = fields.value(u"reply"_q).toBool();
+	}
+	for (const auto &value : fields.value(u"buttons"_q).toArray()) {
+		const auto button = value.toArray();
+		const auto url = button.at(1).toString();
+		if (LinkAllowed(url) && result.buttons.size() < 2) {
+			result.buttons.push_back({ button.at(0).toString(), url });
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString UpdateBuild(const QString &tag) {
+	const auto index = tag.lastIndexOf(u"-tele."_q);
+	return (index >= 0) ? tag.mid(index + 6) : tag;
+}
+
+class Store final {
+public:
+	explicit Store(not_null<Main::Session*> session);
+	~Store();
+
+	[[nodiscard]] static Store *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] const std::vector<Notice> &list() const;
+	[[nodiscard]] const Notice *find(const QString &key) const;
+	[[nodiscard]] rpl::producer<> changes() const;
+	[[nodiscard]] rpl::producer<int> unreadValue() const;
+
+	void add(Notice notice);
+	void addTele(Notice notice, const QString &where);
+	void markRead();
+	void markRead(uint64 id);
+	void setText(uint64 id, TextWithEntities text);
+	void remove(uint64 id);
+	void clear();
+	[[nodiscard]] QImage photo(const QString &name) const;
+	void savePhoto(const QString &name, const QByteArray &bytes);
+	[[nodiscard]] const ServerSeen *server(const QString &id) const;
+	void setServer(ServerSeen seen);
+	void deliverCrashes();
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write();
+	void changed();
+	void scheduleWrite();
+	void trim();
+	void removePhotos(const std::vector<QString> &names);
+	void updateStatus(const UpdateStatus &status);
+
+	const not_null<Main::Session*> _session;
+	std::vector<Notice> _list;
+	std::vector<ServerSeen> _server;
+	base::flat_map<QString, QByteArray> _photos;
+	QString _updateTag;
+	QString _teleWhere;
+	uint64 _teleId = 0;
+	crl::time _teleAt = 0;
+	uint64 _lastId = 0;
+	rpl::variable<int> _unread;
+	rpl::event_stream<> _changes;
+	base::Timer _writeTimer;
+	rpl::lifetime _lifetime;
+
+};
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session)
+, _writeTimer([=] { write(); }) {
+	Registry().emplace(session, this);
+	read();
+	trim();
+	_unread = int(ranges::count(_list, true, &Notice::unread));
+	deliverCrashes();
+	UpdateStatusValue(
+	) | rpl::on_next([=](const UpdateStatus &status) {
+		updateStatus(status);
+	}, _lifetime);
+}
+
+Store::~Store() {
+	if (_writeTimer.isActive()) {
+		write();
+	}
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Store::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>>();
+	return result;
+}
+
+Store *Store::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+const std::vector<Notice> &Store::list() const {
+	return _list;
+}
+
+const Notice *Store::find(const QString &key) const {
+	if (key.isEmpty()) {
+		return nullptr;
+	}
+	const auto i = ranges::find(_list, key, &Notice::key);
+	return (i != end(_list)) ? &*i : nullptr;
+}
+
+rpl::producer<> Store::changes() const {
+	return _changes.events();
+}
+
+rpl::producer<int> Store::unreadValue() const {
+	return _unread.value();
+}
+
+void Store::add(Notice notice) {
+	notice.id = ++_lastId;
+	notice.unread = true;
+	if (!notice.date) {
+		notice.date = base::unixtime::now();
+	}
+	notice.text = Sanitize(std::move(notice.text));
+	notice.value = Sanitize(std::move(notice.value));
+	if (notice.buttons.size() > 2) {
+		notice.buttons.resize(2);
+	}
+	auto removed = std::vector<QString>();
+	if (!notice.key.isEmpty()) {
+		const auto i = ranges::find(_list, notice.key, &Notice::key);
+		if (i != end(_list)) {
+			if (!i->photo.isEmpty() && i->photo != notice.photo) {
+				removed.push_back(i->photo);
+			}
+			_list.erase(i);
+		}
+	}
+	_list.insert(begin(_list), std::move(notice));
+	removePhotos(removed);
+	trim();
+	changed();
+}
+
+void Store::addTele(Notice notice, const QString &where) {
+	const auto now = crl::now();
+	const auto last = ranges::find(_list, _teleId, &Notice::id);
+	const auto merge = (_teleWhere == where)
+		&& (now - _teleAt < kMergeTeleToasts)
+		&& (last != end(_list))
+		&& (last->kind == notice.kind)
+		&& (last->value == notice.value);
+	if (merge) {
+		_list.erase(last);
+	}
+	add(std::move(notice));
+	_teleWhere = where;
+	_teleId = _list.front().id;
+	_teleAt = now;
+}
+
+void Store::markRead() {
+	auto any = false;
+	for (auto &notice : _list) {
+		any = std::exchange(notice.unread, false) || any;
+	}
+	if (any) {
+		changed();
+	}
+}
+
+void Store::markRead(uint64 id) {
+	const auto i = ranges::find(_list, id, &Notice::id);
+	if (i != end(_list) && std::exchange(i->unread, false)) {
+		changed();
+	}
+}
+
+void Store::setText(uint64 id, TextWithEntities text) {
+	const auto i = ranges::find(_list, id, &Notice::id);
+	if (i == end(_list)) {
+		return;
+	}
+	text = Sanitize(std::move(text));
+	if (i->text != text) {
+		i->text = std::move(text);
+		changed();
+	}
+}
+
+void Store::remove(uint64 id) {
+	const auto i = ranges::find(_list, id, &Notice::id);
+	if (i == end(_list)) {
+		return;
+	}
+	const auto photo = i->photo;
+	_list.erase(i);
+	if (!photo.isEmpty()) {
+		removePhotos({ photo });
+	}
+	changed();
+}
+
+void Store::clear() {
+	if (_list.empty()) {
+		return;
+	}
+	auto photos = std::vector<QString>();
+	for (const auto &notice : base::take(_list)) {
+		if (!notice.photo.isEmpty()) {
+			photos.push_back(notice.photo);
+		}
+	}
+	removePhotos(photos);
+	changed();
+}
+
+QImage Store::photo(const QString &name) const {
+	if (const auto i = _photos.find(name); i != end(_photos)) {
+		auto image = QImage();
+		image.loadFromData(i->second);
+		return image;
+	}
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (name.isEmpty()
+		|| !key
+		|| !ReadEncryptedFile(file, name, folder(), key)) {
+		return QImage();
+	}
+	auto bytes = QByteArray();
+	file.stream >> bytes;
+	if (file.stream.status() != QDataStream::Ok) {
+		return QImage();
+	}
+	auto image = QImage();
+	image.loadFromData(bytes);
+	return image;
+}
+
+void Store::savePhoto(const QString &name, const QByteArray &bytes) {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || name.isEmpty()) {
+		return;
+	}
+	_photos[name] = bytes;
+	auto data = EncryptedDescriptor(sizeof(quint32) + bytes.size());
+	data.stream << bytes;
+	auto file = FileWriteDescriptor(name, folder());
+	file.writeEncrypted(data, key);
+}
+
+const ServerSeen *Store::server(const QString &id) const {
+	const auto i = ranges::find(_server, id, &ServerSeen::id);
+	return (i != end(_server)) ? &*i : nullptr;
+}
+
+void Store::setServer(ServerSeen seen) {
+	const auto i = ranges::find(_server, seen.id, &ServerSeen::id);
+	if (i != end(_server)) {
+		_server.erase(i);
+	}
+	_server.push_back(std::move(seen));
+	if (_server.size() > kMaxServerNotices) {
+		_server.erase(begin(_server));
+	}
+	scheduleWrite();
+}
+
+void Store::deliverCrashes() {
+	auto &pending = PendingCrashes();
+	if (pending.empty() || !NoticesCentre()) {
+		return;
+	}
+	for (const auto &crash : base::take(pending)) {
+		const auto title = crash.freeze
+			? (crash.id.isEmpty()
+				? u"Freeze report sent"_q
+				: u"Freeze report #%1 sent"_q.arg(crash.id))
+			: (crash.id.isEmpty()
+				? u"Crash report sent"_q
+				: u"Crash report #%1 sent"_q.arg(crash.id));
+		add({ .kind = NoticeKind::Crash, .title = Lower(title) });
+	}
+}
+
+QString Store::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void Store::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_notices"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto size = quint32();
+	file.stream >> magic >> version >> owner >> size;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| size > kMaxJsonSize) {
+		return;
+	}
+	auto json = QByteArray(int(size), Qt::Uninitialized);
+	if (file.stream.readRawData(json.data(), json.size()) != json.size()) {
+		return;
+	}
+	const auto object = QJsonDocument::fromJson(json).object();
+	_lastId = object.value(u"last"_q).toString().toULongLong();
+	_updateTag = object.value(u"update"_q).toString();
+	for (const auto &value : object.value(u"server"_q).toArray()) {
+		const auto fields = value.toArray();
+		const auto id = fields.at(0).toString();
+		if (!id.isEmpty() && int(_server.size()) < kMaxServerNotices) {
+			_server.push_back({
+				.id = id,
+				.rev = fields.at(1).toInt(),
+				.toasted = fields.at(2).toBool(),
+			});
+		}
+	}
+	for (const auto &value : object.value(u"list"_q).toArray()) {
+		if (auto notice = Parse(value.toObject())) {
+			_lastId = std::max(_lastId, notice->id);
+			_list.push_back(std::move(*notice));
+		}
+	}
+	ranges::stable_sort(_list, ranges::greater(), &Notice::date);
+}
+
+void Store::write() {
+	_writeTimer.cancel();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto list = QJsonArray();
+	for (const auto &notice : _list) {
+		list.push_back(Serialize(notice));
+	}
+	auto server = QJsonArray();
+	for (const auto &seen : _server) {
+		server.push_back(QJsonArray{ seen.id, seen.rev, seen.toasted });
+	}
+	auto object = QJsonObject();
+	object.insert(u"last"_q, QString::number(_lastId));
+	object.insert(u"update"_q, _updateTag);
+	object.insert(u"server"_q, server);
+	object.insert(u"list"_q, list);
+	const auto json = QJsonDocument(object).toJson(QJsonDocument::Compact);
+	auto data = EncryptedDescriptor(
+		sizeof(quint32) * 3 + sizeof(quint64) + json.size());
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(json.size());
+	data.stream.writeRawData(json.constData(), json.size());
+	auto file = FileWriteDescriptor(u"tele_notices"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+void Store::changed() {
+	_unread = int(ranges::count(_list, true, &Notice::unread));
+	_changes.fire({});
+	scheduleWrite();
+}
+
+void Store::scheduleWrite() {
+	if (!_writeTimer.isActive()) {
+		_writeTimer.callOnce(kWriteDelay);
+	}
+}
+
+void Store::trim() {
+	const auto old = base::unixtime::now() - kMaxAge;
+	auto removed = std::vector<QString>();
+	auto mentions = 0;
+	auto others = 0;
+	for (auto i = begin(_list); i != end(_list);) {
+		const auto mention = (i->kind == NoticeKind::Mention);
+		auto &count = mention ? mentions : others;
+		if (count < (mention ? kMaxMentions : kMaxNotices)
+			&& i->date >= old) {
+			++count;
+			++i;
+			continue;
+		} else if (!i->photo.isEmpty()) {
+			removed.push_back(i->photo);
+		}
+		i = _list.erase(i);
+	}
+	removePhotos(removed);
+}
+
+void Store::removePhotos(const std::vector<QString> &names) {
+	const auto base = folder();
+	for (const auto &name : names) {
+		if (ranges::contains(_list, name, &Notice::photo)) {
+			continue;
+		}
+		_photos.remove(name);
+		for (const auto suffix : { 's', '0', '1' }) {
+			QFile::remove(base + name + suffix);
+		}
+	}
+}
+
+void Store::updateStatus(const UpdateStatus &status) {
+	using State = UpdateState;
+	if ((status.state != State::Downloading && status.state != State::Ready)
+		|| status.tag.isEmpty()
+		|| status.tag == _updateTag
+		|| !NoticesCentre()) {
+		return;
+	}
+	_updateTag = status.tag;
+	add({
+		.kind = NoticeKind::Update,
+		.key = u"update"_q,
+		.title = Tr(u"tele %1 is out"_q).arg(UpdateBuild(status.tag)),
+		.buttons = { {
+			.text = Tr(u"What's new"_q),
+			.url = QString::fromLatin1(kReleasesPrefix)
+				+ u"tag/"_q
+				+ status.tag,
+		} },
+	});
+}
