+void LogCopiedToast(
+		Main::Session *session,
+		const QString &title,
+		const TextWithEntities &text,
+		TextWithEntities copied,
+		std::source_location where) {
+	if (!NoticesCentre() || !NoticesCopies()) {
+		return;
+	} else if (!session && Core::IsAppLaunched()) {
+		session = Core::App().maybePrimarySession();
+	}
+	const auto store = session ? Store::Find(session) : nullptr;
+	if (!store || copied.text.isEmpty()) {
+		return;
+	}
+	const auto titled = !title.isEmpty();
+	store->addTele({
+		.kind = NoticeKind::Copy,
+		.title = titled ? title : text.text,
+		.text = titled ? text : TextWithEntities(),
+		.value = std::move(copied),
+	}, ToastWhere(where));
+}
+
+} // namespace Tele
