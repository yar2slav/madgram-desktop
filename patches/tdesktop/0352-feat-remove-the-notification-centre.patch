+	rpl::combine(
+		EnabledValue(*CurrentSubRow),
+		rpl::single(rpl::empty) | rpl::then(style::PaletteChanged())
+	) | rpl::on_next([=](bool enabled, rpl::empty_value) {
+		apply(enabled
+			? std::optional<QColor>()
+			: std::make_optional(st::windowSubTextFg->c));
+	}, owner->lifetime());
+}
