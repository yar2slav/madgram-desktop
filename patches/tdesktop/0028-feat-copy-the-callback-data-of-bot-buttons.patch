 }
 
+void AddCopyButtonPayloadAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		const ClickHandlerPtr &link) {
+	const auto handler = dynamic_cast<ReplyMarkupClickHandler*>(link.get());
+	const auto button = handler ? handler->getButton() : nullptr;
+	if (!button) {
+		return;
+	}
+	const auto &data = button->data;
+	auto action = QString();
+	auto text = QString();
+	auto toast = QString();
+	switch (button->type) {
+	case Type::Callback:
+	case Type::CallbackWithPassword:
+		if (IsText(data)) {
+			action = u"Copy callback data"_q;
+			text = QString::fromUtf8(data);
+		} else {
+			action = u"Copy callback data as hex"_q;
+			text = QString::fromLatin1(data.toHex());
+		}
+		toast = u"Callback data copied to clipboard."_q;
+		break;
+	case Type::SwitchInline:
+	case Type::SwitchInlineSame:
+		action = u"Copy inline query"_q;
+		text = QString::fromUtf8(data);
+		toast = u"Inline query copied to clipboard."_q;
+		break;
+	case Type::WebView:
+	case Type::SimpleWebView:
+		action = u"Copy web app URL"_q;
+		text = QString::fromUtf8(data);
+		toast = u"Web app URL copied to clipboard."_q;
+		break;
+	case Type::CopyText:
+		action = u"Copy text from button"_q;
+		text = QString::fromUtf8(data);
+		toast = tr::lng_text_copied(tr::now);
+		break;
+	case Type::UserProfile:
+		action = u"Copy user ID"_q;
+		text = QString::number(data.toULongLong());
+		toast = u"ID copied to clipboard."_q;
+		break;
+	default:
+		break;
+	}
+	if (text.isEmpty()) {
+		return;
+	}
+	menu->addAction(action, [=] {
+		QGuiApplication::clipboard()->setText(text);
+		show->showToast({
+			.text = { toast },
+			.iconLottie = u"toast/copy"_q,
+			.iconLottieSize = st::toastLottieIconSize,
+		});
+	}, &st::menuIconCopy);
+}
+
 } // namespace Tele
