+[[nodiscard]] bool IsText(const QByteArray &data) {
+	const auto text = QString::fromUtf8(data);
+	return (text.toUtf8() == data) && IsPrintable(text);
+}
+
 [[nodiscard]] QString Bytes(const QByteArray &data) {
 	if (data.isEmpty()) {
 		return u"(empty)"_q;
 	}
-	const auto text = QString::fromUtf8(data);
-	if (text.toUtf8() == data && IsPrintable(text)) {
-		return Quoted(text);
+	if (IsText(data)) {
+		return Quoted(QString::fromUtf8(data));
 	}
 	return u"hex, %1 bytes: %2"_q.arg(data.size()).arg(
 		Limited(QString::fromLatin1(data.toHex(' '))));
@@ -264,4 +277,67 @@ QString MarkupButtonTooltip(
