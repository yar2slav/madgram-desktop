+constexpr auto kLocalFolderBase = FilterId(0x40000000);
+constexpr auto kNoLimit = 0x00FFFFFF;
+constexpr auto kMagic = quint32(0x444C4654);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxStored = quint32(1 << 20);
+
+using namespace Storage::details;
+using Histories = base::flat_set<not_null<History*>>;
+using HistoryList = std::vector<not_null<History*>>;
+using Flags = Data::ChatFilter::Flags;
+
+struct StoredFolder {
+	FilterId id = 0;
+	TextWithEntities title;
+	QString emoji;
+	qint32 color = -1;
+	quint32 flags = 0;
+	std::vector<PeerId> always;
+	std::vector<PeerId> pinned;
+	std::vector<PeerId> never;
+
+	friend inline bool operator==(
+		const StoredFolder &a,
+		const StoredFolder &b) = default;
+};
+
+struct Overflow {
+	std::vector<PeerId> always;
+	std::vector<PeerId> pinned;
+	std::vector<PeerId> never;
+
+	[[nodiscard]] bool empty() const {
+		return always.empty() && never.empty();
+	}
+
+	friend inline bool operator==(
+		const Overflow &a,
+		const Overflow &b) = default;
+};
+
+struct ServerPart {
+	Histories always;
+	Histories never;
+};
+
+struct Split {
+	Data::ChatFilter server;
+	Overflow local;
+};
+
+class Store final {
+public:
+	explicit Store(not_null<Main::Session*> session);
+
+	[[nodiscard]] not_null<Main::Session*> session() const;
+	[[nodiscard]] const std::vector<StoredFolder> &folders() const;
+	[[nodiscard]] const Overflow *overflow(FilterId id) const;
+	[[nodiscard]] const std::vector<FilterId> &order() const;
+	[[nodiscard]] const ServerPart *server(FilterId id) const;
+
+	void setFolder(StoredFolder folder);
+	void setOverflow(FilterId id, Overflow overflow);
+	void setOrder(std::vector<FilterId> order);
+	void setServer(FilterId id, ServerPart part);
+	void forget(FilterId id);
+	void prune(const base::flat_set<FilterId> &server);
+	[[nodiscard]] FilterId nextId(const std::vector<Data::ChatFilter> &list);
+
+private:
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write();
+
+	const not_null<Main::Session*> _session;
+	std::vector<StoredFolder> _folders;
+	base::flat_map<FilterId, Overflow> _overflow;
+	std::vector<FilterId> _order;
+	base::flat_map<FilterId, ServerPart> _server;
+	FilterId _lastId = kLocalFolderBase - 1;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] std::map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Store>> &Stores() {
+	static auto result = std::map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Store>>();
+	return result;
+}
+
+[[nodiscard]] Store &Lookup(not_null<Main::Session*> session) {
+	auto &stores = Stores();
+	const auto i = stores.find(session);
+	if (i != end(stores)) {
+		return *i->second;
+	}
+	session->lifetime().add([=] {
+		Stores().erase(session);
+	});
+	return *stores.emplace(
+		session,
+		std::make_unique<Store>(session)).first->second;
+}
+
+template <typename Range>
+[[nodiscard]] std::vector<PeerId> Ids(const Range &histories) {
+	auto result = std::vector<PeerId>();
+	result.reserve(histories.size());
+	for (const auto &history : histories) {
+		result.push_back(history->peer->id);
+	}
+	return result;
+}
+
+[[nodiscard]] HistoryList ToList(
+		not_null<Main::Session*> session,
+		const std::vector<PeerId> &ids) {
+	auto result = HistoryList();
+	result.reserve(ids.size());
+	for (const auto id : ids) {
+		if (id) {
+			result.push_back(session->data().history(id));
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] Histories ToSet(
+		not_null<Main::Session*> session,
+		const std::vector<PeerId> &ids) {
+	const auto list = ToList(session, ids);
+	return { list.begin(), list.end() };
+}
+
+void WriteIds(QDataStream &stream, const std::vector<PeerId> &ids) {
+	stream << quint32(ids.size());
+	for (const auto id : ids) {
+		stream << SerializePeerId(id);
+	}
+}
+
+[[nodiscard]] bool ReadIds(QDataStream &stream, std::vector<PeerId> &ids) {
+	auto count = quint32();
+	stream >> count;
+	if (!CheckStreamStatus(stream) || count > kMaxStored) {
+		return false;
+	}
+	ids.reserve(count);
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = quint64();
+		stream >> id;
+		ids.push_back(DeserializePeerId(id));
+	}
+	return CheckStreamStatus(stream);
+}
+
+void WriteFolder(QDataStream &stream, const StoredFolder &folder) {
+	stream
+		<< qint32(folder.id)
+		<< folder.title.text
+		<< quint32(folder.title.entities.size());
+	for (const auto &entity : folder.title.entities) {
+		stream
+			<< qint32(entity.type())
+			<< qint32(entity.offset())
+			<< qint32(entity.length())
+			<< entity.data();
+	}
+	stream << folder.emoji << folder.color << folder.flags;
+	WriteIds(stream, folder.always);
+	WriteIds(stream, folder.pinned);
+	WriteIds(stream, folder.never);
+}
+
+[[nodiscard]] std::optional<StoredFolder> ReadFolder(QDataStream &stream) {
+	auto result = StoredFolder();
+	auto id = qint32();
+	auto entities = quint32();
+	stream >> id >> result.title.text >> entities;
+	if (!CheckStreamStatus(stream) || entities > kMaxStored) {
+		return std::nullopt;
+	}
+	result.id = id;
+	for (auto i = quint32(); i != entities; ++i) {
+		auto type = qint32();
+		auto offset = qint32();
+		auto length = qint32();
+		auto data = QString();
+		stream >> type >> offset >> length >> data;
+		result.title.entities.push_back(EntityInText(
+			EntityType(type),
+			offset,
+			length,
+			data));
+	}
+	stream >> result.emoji >> result.color >> result.flags;
+	if (!CheckStreamStatus(stream)
+		|| !ReadIds(stream, result.always)
+		|| !ReadIds(stream, result.pinned)
+		|| !ReadIds(stream, result.never)) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] StoredFolder ToStored(const Data::ChatFilter &filter) {
+	const auto color = filter.colorIndex();
+	return {
+		.id = filter.id(),
+		.title = filter.titleText(),
+		.emoji = filter.iconEmoji(),
+		.color = color ? qint32(*color) : qint32(-1),
+		.flags = quint32(filter.flags().value()),
+		.always = Ids(filter.always()),
+		.pinned = Ids(filter.pinned()),
+		.never = Ids(filter.never()),
+	};
+}
+
+[[nodiscard]] Data::ChatFilter ToFilter(
+		not_null<Main::Session*> session,
+		const StoredFolder &folder) {
+	using Flag = Data::ChatFilter::Flag;
+	const auto flags = Flags::from_raw(ushort(folder.flags));
+	auto pinned = ToList(session, folder.pinned);
+	auto always = ToSet(session, folder.always);
+	for (const auto history : pinned) {
+		always.emplace(history);
+	}
+	return Data::ChatFilter(
+		folder.id,
+		{ folder.title, bool(flags & Flag::StaticTitle) },
+		folder.emoji,
+		((folder.color >= 0)
+			? std::make_optional(uint8(folder.color))
+			: std::nullopt),
+		flags & ~(Flag::Chatlist | Flag::HasMyLinks),
+		std::move(always),
+		std::move(pinned),
+		ToSet(session, folder.never));
+}
+
+[[nodiscard]] Data::ChatFilter Merge(
+		const Store &store,
+		const Data::ChatFilter &filter) {
+	const auto local = store.overflow(filter.id());
+	if (!local) {
+		return filter;
+	}
+	const auto session = store.session();
+	const auto localAlways = ToSet(session, local->always);
+	auto always = filter.always();
+	for (const auto history : localAlways) {
+		always.emplace(history);
+	}
+	auto never = filter.never();
+	for (const auto history : ToList(session, local->never)) {
+		never.emplace(history);
+	}
+	auto pinned = HistoryList();
+	for (const auto history : ToList(session, local->pinned)) {
+		if ((ranges::contains(filter.pinned(), history)
+				|| localAlways.contains(history))
+			&& !ranges::contains(pinned, history)) {
+			pinned.push_back(history);
+		}
+	}
+	for (const auto history : filter.pinned()) {
+		if (!ranges::contains(pinned, history)) {
+			pinned.push_back(history);
+		}
+	}
+	return Data::ChatFilter(
+		filter.id(),
+		filter.title(),
+		filter.iconEmoji(),
+		filter.colorIndex(),
+		filter.flags(),
+		std::move(always),
+		std::move(pinned),
+		std::move(never));
+}
+
+[[nodiscard]] Split ComputeSplit(
+		const Store &store,
+		const Data::ChatFilter &filter,
+		FilterId id) {
+	const auto session = store.session();
+	const auto limit = Data::PremiumLimits(
+		session
+	).dialogFiltersChatsCurrent();
+	const auto stored = store.overflow(id);
+	const auto known = store.server(id);
+	const auto &pinned = filter.pinned();
+	const auto pick = [&](
+			HistoryList list,
+			const Histories *server,
+			const std::vector<PeerId> *local) {
+		const auto isLocal = [&](not_null<History*> history) {
+			return local && ranges::contains(*local, history->peer->id);
+		};
+		const auto rank = [&](not_null<History*> history) {
+			const auto onServer = server
+				? server->contains(history)
+				: !isLocal(history);
+			return onServer ? 0 : isLocal(history) ? 1 : 2;
+		};
+		const auto key = [&](not_null<History*> history) {
+			const auto i = ranges::find(pinned, history);
+			return std::make_pair(rank(history), int(i - begin(pinned)));
+		};
+		ranges::stable_sort(list, [&](
+				not_null<History*> a,
+				not_null<History*> b) {
+			return key(a) < key(b);
+		});
+		const auto count = std::min(int(list.size()), limit);
+		return std::make_pair(
+			Histories(list.begin(), list.begin() + count),
+			HistoryList(list.begin() + count, list.end()));
+	};
+	auto [serverAlways, localAlways] = pick(
+		HistoryList(filter.always().begin(), filter.always().end()),
+		known ? &known->always : nullptr,
+		stored ? &stored->always : nullptr);
+	auto [serverNever, localNever] = pick(
+		HistoryList(filter.never().begin(), filter.never().end()),
+		known ? &known->never : nullptr,
+		stored ? &stored->never : nullptr);
+	auto serverPinned = pinned | ranges::views::filter([&](
+			not_null<History*> history) {
+		return serverAlways.contains(history);
+	}) | ranges::to_vector;
+	auto local = Overflow{
+		.always = Ids(localAlways),
+		.never = Ids(localNever),
+	};
+	if (serverPinned.size() != pinned.size()) {
+		local.pinned = Ids(pinned);
+	}
+	return {
+		.server = Data::ChatFilter(
+			filter.id(),
+			filter.title(),
+			filter.iconEmoji(),
+			filter.colorIndex(),
+			filter.flags(),
+			std::move(serverAlways),
+			std::move(serverPinned),
+			std::move(serverNever)),
+		.local = std::move(local),
+	};
+}
+
+[[nodiscard]] Main::Session *SessionFor(const Data::ChatFilter &filter) {
+	if (!filter.always().empty()) {
+		return &(*filter.always().begin())->session();
+	} else if (!filter.never().empty()) {
+		return &(*filter.never().begin())->session();
+	}
+	return Core::App().domain().active().maybeSession();
+}
+
+[[nodiscard]] std::vector<FilterId> MergeOrder(
+		std::vector<FilterId> result,
+		const std::vector<FilterId> &locals,
+		const std::vector<FilterId> &stored) {
+	result.erase(ranges::remove_if(result, [&](FilterId id) {
+		return IsLocalFolder(id) && !ranges::contains(locals, id);
+	}), end(result));
+	auto pending = stored | ranges::views::filter([&](FilterId id) {
+		return ranges::contains(locals, id);
+	}) | ranges::to_vector;
+	for (const auto id : locals) {
+		if (!ranges::contains(pending, id)) {
+			pending.push_back(id);
+		}
+	}
+	for (const auto id : pending) {
+		if (ranges::contains(result, id)) {
+			continue;
+		}
+		auto position = int(result.size());
+		const auto s = ranges::find(stored, id);
+		if (s != end(stored)) {
+			position = 0;
+			for (auto k = s; k != begin(stored);) {
+				const auto r = ranges::find(result, *--k);
+				if (r != end(result)) {
+					position = int(r - begin(result)) + 1;
+					break;
+				}
+			}
+		}
+		result.insert(begin(result) + position, id);
+	}
+	return result;
+}
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session) {
+	read();
+	LocalFoldersValue(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		_session->data().chatsFilters().reload();
+	}, _lifetime);
+}
+
+not_null<Main::Session*> Store::session() const {
+	return _session;
+}
+
+const std::vector<StoredFolder> &Store::folders() const {
+	return _folders;
+}
+
+const Overflow *Store::overflow(FilterId id) const {
+	const auto i = _overflow.find(id);
+	return (i != end(_overflow)) ? &i->second : nullptr;
+}
+
+const std::vector<FilterId> &Store::order() const {
+	return _order;
+}
+
+const ServerPart *Store::server(FilterId id) const {
+	const auto i = _server.find(id);
+	return (i != end(_server)) ? &i->second : nullptr;
+}
+
+void Store::setFolder(StoredFolder folder) {
+	const auto i = ranges::find(_folders, folder.id, &StoredFolder::id);
+	if (i == end(_folders)) {
+		_folders.push_back(std::move(folder));
+	} else if (*i != folder) {
+		*i = std::move(folder);
+	} else {
+		return;
+	}
+	write();
+}
+
+void Store::setOverflow(FilterId id, Overflow overflow) {
+	const auto i = _overflow.find(id);
+	if (overflow.empty()) {
+		if (i == end(_overflow)) {
+			return;
+		}
+		_overflow.erase(i);
+	} else if (i == end(_overflow)) {
+		_overflow.emplace(id, std::move(overflow));
+	} else if (i->second != overflow) {
+		i->second = std::move(overflow);
+	} else {
+		return;
+	}
+	write();
+}
+
+void Store::setOrder(std::vector<FilterId> order) {
+	if (_order != order) {
+		_order = std::move(order);
+		write();
+	}
+}
+
+void Store::setServer(FilterId id, ServerPart part) {
+	_server[id] = std::move(part);
+}
+
+void Store::forget(FilterId id) {
+	_server.remove(id);
+	const auto i = ranges::find(_folders, id, &StoredFolder::id);
+	if (i != end(_folders)) {
+		_folders.erase(i);
+		_order.erase(ranges::remove(_order, id), end(_order));
+		write();
+	} else if (_overflow.remove(id)) {
+		write();
+	}
+}
+
+void Store::prune(const base::flat_set<FilterId> &server) {
+	for (auto i = begin(_server); i != end(_server);) {
+		if (server.contains(i->first)) {
+			++i;
+		} else {
+			i = _server.erase(i);
+		}
+	}
+	auto changed = false;
+	for (auto i = begin(_overflow); i != end(_overflow);) {
+		if (server.contains(i->first)) {
+			++i;
+		} else {
+			i = _overflow.erase(i);
+			changed = true;
+		}
+	}
+	if (changed) {
+		write();
+	}
+}
+
+FilterId Store::nextId(const std::vector<Data::ChatFilter> &list) {
+	for (const auto &folder : _folders) {
+		_lastId = std::max(_lastId, folder.id);
+	}
+	for (const auto &filter : list) {
+		if (IsLocalFolder(filter.id())) {
+			_lastId = std::max(_lastId, filter.id());
+		}
+	}
+	return ++_lastId;
+}
+
+QString Store::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + u"/tele_folders/"_q;
+}
+
+void Store::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"index"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (!CheckStreamStatus(file.stream)
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxStored) {
+		return;
+	}
+	auto folders = std::vector<StoredFolder>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto folder = ReadFolder(file.stream);
+		if (!folder) {
+			return;
+		} else if (IsLocalFolder(folder->id)) {
+			folders.push_back(std::move(*folder));
+		}
+	}
+	file.stream >> count;
+	if (!CheckStreamStatus(file.stream) || count > kMaxStored) {
+		return;
+	}
+	auto overflow = base::flat_map<FilterId, Overflow>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = qint32();
+		auto entry = Overflow();
+		file.stream >> id;
+		if (!CheckStreamStatus(file.stream)
+			|| !ReadIds(file.stream, entry.always)
+			|| !ReadIds(file.stream, entry.pinned)
+			|| !ReadIds(file.stream, entry.never)) {
+			return;
+		} else if (id && !IsLocalFolder(id) && !entry.empty()) {
+			overflow.emplace(id, std::move(entry));
+		}
+	}
+	file.stream >> count;
+	if (!CheckStreamStatus(file.stream) || count > kMaxStored) {
+		return;
+	}
+	auto order = std::vector<FilterId>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = qint32();
+		file.stream >> id;
+		order.push_back(id);
+	}
+	if (!CheckStreamStatus(file.stream)) {
+		return;
+	}
+	_folders = std::move(folders);
+	_overflow = std::move(overflow);
+	_order = std::move(order);
+}
+
+void Store::write() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 5 + sizeof(quint64);
+	const auto ids = [](const std::vector<PeerId> &list) {
+		return sizeof(quint32) + list.size() * sizeof(quint64);
+	};
+	for (const auto &folder : _folders) {
+		size += 64
+			+ (folder.title.text.size() + folder.emoji.size())
+				* sizeof(QChar)
+			+ folder.title.entities.size() * 64
+			+ ids(folder.always)
+			+ ids(folder.pinned)
+			+ ids(folder.never);
+	}
+	for (const auto &[id, entry] : _overflow) {
+		size += sizeof(qint32)
+			+ ids(entry.always)
+			+ ids(entry.pinned)
+			+ ids(entry.never);
+	}
+	size += _order.size() * sizeof(qint32);
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_folders.size());
+	for (const auto &folder : _folders) {
+		WriteFolder(data.stream, folder);
+	}
+	data.stream << quint32(_overflow.size());
+	for (const auto &[id, entry] : _overflow) {
+		data.stream << qint32(id);
+		WriteIds(data.stream, entry.always);
+		WriteIds(data.stream, entry.pinned);
+		WriteIds(data.stream, entry.never);
+	}
+	data.stream << quint32(_order.size());
+	for (const auto id : _order) {
+		data.stream << qint32(id);
+	}
+	auto file = FileWriteDescriptor(u"index"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+} // namespace
+
+bool IsLocalFolder(FilterId id) {
+	return (id >= kLocalFolderBase);
+}
+
+int LocalFolderTabs(not_null<Main::Session*> session) {
+	return int(ranges::count_if(
+		session->data().chatsFilters().list(),
+		IsLocalFolder,
+		&Data::ChatFilter::id));
+}
+
+int FolderCountLimit(int serverLimit) {
+	return LocalFolders() ? kNoLimit : serverLimit;
+}
+
+int FolderChatsLimit(int serverLimit) {
+	return LocalFolders() ? kNoLimit : serverLimit;
+}
+
+rpl::producer<int> FolderChatsLimitValue(rpl::producer<int> serverLimit) {
+	return rpl::combine(
+		std::move(serverLimit),
+		LocalFoldersValue()
+	) | rpl::map([](int limit, bool local) {
+		return local ? kNoLimit : limit;
+	});
+}
+
+QString FolderChatsCount(int count, int limit) {
+	return (limit >= kNoLimit)
+		? QString::number(count)
+		: u"%1 / %2"_q.arg(count).arg(limit);
+}
+
+FilterId NewFolderId(not_null<Main::Session*> session, int rows) {
+	if (!LocalFolders()) {
+		return 0;
+	}
+	const auto &list = session->data().chatsFilters().list();
+	auto server = 0;
+	auto listed = 0;
+	for (const auto &filter : list) {
+		if (const auto id = filter.id()) {
+			++listed;
+			if (!IsLocalFolder(id)) {
+				++server;
+			}
+		}
+	}
+	const auto pending = std::max(rows - listed, 0);
+	const auto limit = Data::PremiumLimits(session).dialogFiltersCurrent();
+	return (server + pending < limit) ? 0 : Lookup(session).nextId(list);
+}
+
+bool SaveLocalFolder(
+		not_null<Main::Session*> session,
+		const Data::ChatFilter &filter) {
+	if (!IsLocalFolder(filter.id())) {
+		return false;
+	}
+	session->data().chatsFilters().set(filter);
+	return true;
+}
+
+QString FolderStatus(
+		not_null<Main::Session*> session,
+		const Data::ChatFilter &filter,
+		QString status) {
+	const auto separator = ' ' + Ui::kQBullet + ' ';
+	if (IsLocalFolder(filter.id())) {
+		return status + separator + Lower(u"Local"_q);
+	} else if (!LocalFolders() || !filter.id()) {
+		return status;
+	}
+	const auto local = Lookup(session).overflow(filter.id());
+	const auto count = local
+		? int(local->always.size() + local->never.size())
+		: 0;
+	return count
+		? (status + separator + Lower(u"%1 on this device"_q).arg(count))
+		: status;
+}
+
+not_null<Ui::VerticalLayout*> FolderLinksContainer(
+		not_null<Ui::VerticalLayout*> content,
+		FilterId id) {
+	if (!IsLocalFolder(id)) {
+		return content;
+	}
+	const auto wrap = content->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			content,
+			object_ptr<Ui::VerticalLayout>(content)));
+	wrap->hide(anim::type::instant);
+	return wrap->entity();
+}
+
+Data::ChatFilter ServerFolder(const Data::ChatFilter &filter) {
+	const auto id = filter.id();
+	const auto session = SessionFor(filter);
+	if (!id || IsLocalFolder(id) || !LocalFolders() || !session) {
+		return filter;
+	}
+	return ComputeSplit(Lookup(session), filter, id).server;
+}
+
+std::optional<Data::ChatFilter> ServerFolderPart(
+		const Data::ChatFilter &filter,
+		FilterId replaceId) {
+	const auto id = replaceId ? replaceId : filter.id();
+	if (!id || IsLocalFolder(id) || !LocalFolders()) {
+		return std::nullopt;
+	}
+	const auto session = SessionFor(filter);
+	if (!session) {
+		return std::nullopt;
+	}
+	auto &store = Lookup(session);
+	auto split = ComputeSplit(store, filter, id);
+	store.setServer(id, {
+		.always = split.server.always(),
+		.never = split.server.never(),
+	});
+	const auto local = !split.local.empty();
+	store.setOverflow(id, std::move(split.local));
+	return local ? std::make_optional(std::move(split.server)) : std::nullopt;
+}
+
+MTPVector<MTPint> ServerFolderOrder(const MTPVector<MTPint> &order) {
+	auto result = QVector<MTPint>();
+	result.reserve(order.v.size());
+	for (const auto &id : order.v) {
+		if (!IsLocalFolder(id.v)) {
+			result.push_back(id);
+		}
+	}
+	return MTP_vector<MTPint>(std::move(result));
+}
+
+std::vector<Data::ChatFilter> WithLocalFolders(
+		not_null<Data::Session*> owner,
+		const QVector<MTPDialogFilter> &list) {
+	const auto session = &owner->session();
+	auto &store = Lookup(session);
+	auto result = std::vector<Data::ChatFilter>();
+	result.reserve(list.size());
+	auto ids = base::flat_set<FilterId>();
+	for (const auto &data : list) {
+		auto parsed = Data::ChatFilter::FromTL(data, owner);
+		if (const auto id = parsed.id()) {
+			ids.emplace(id);
+			store.setServer(id, {
+				.always = parsed.always(),
+				.never = parsed.never(),
+			});
+		}
+		result.push_back(std::move(parsed));
+	}
+	store.prune(ids);
+	if (!LocalFolders()) {
+		return result;
+	}
+	for (auto &filter : result) {
+		filter = Merge(store, filter);
+	}
+	if (store.folders().empty()) {
+		return result;
+	}
+	auto locals = std::vector<FilterId>();
+	for (const auto &folder : store.folders()) {
+		locals.push_back(folder.id);
+	}
+	const auto order = MergeOrder(
+		ranges::views::all(
+			result
+		) | ranges::views::transform(
+			&Data::ChatFilter::id
+		) | ranges::to_vector,
+		locals,
+		store.order());
+	auto merged = std::vector<Data::ChatFilter>();
+	merged.reserve(order.size());
+	for (const auto id : order) {
+		const auto i = ranges::find(result, id, &Data::ChatFilter::id);
+		if (i != end(result)) {
+			merged.push_back(std::move(*i));
+		} else {
+			const auto j = ranges::find(
+				store.folders(),
+				id,
+				&StoredFolder::id);
+			merged.push_back(ToFilter(session, *j));
+		}
+	}
+	return merged;
+}
+
+Data::ChatFilter WithLocalPart(
+		not_null<Data::Session*> owner,
+		Data::ChatFilter filter) {
+	const auto id = filter.id();
+	if (!id || IsLocalFolder(id)) {
+		return filter;
+	}
+	auto &store = Lookup(&owner->session());
+	store.setServer(id, {
+		.always = filter.always(),
+		.never = filter.never(),
+	});
+	return LocalFolders() ? Merge(store, filter) : filter;
+}
+
+QVector<MTPint> WithLocalOrder(
+		not_null<Data::Session*> owner,
+		const QVector<MTPint> &order) {
+	if (!LocalFolders()) {
+		return order;
+	}
+	auto locals = std::vector<FilterId>();
+	for (const auto &filter : owner->chatsFilters().list()) {
+		if (IsLocalFolder(filter.id())) {
+			locals.push_back(filter.id());
+		}
+	}
+	auto ids = std::vector<FilterId>();
+	ids.reserve(order.size());
+	for (const auto &id : order) {
+		ids.push_back(id.v);
+	}
+	if (locals.empty() && !ranges::any_of(ids, IsLocalFolder)) {
+		return order;
+	}
+	auto &store = Lookup(&owner->session());
+	auto merged = MergeOrder(std::move(ids), locals, store.order());
+	auto result = QVector<MTPint>();
+	result.reserve(merged.size());
+	for (const auto id : merged) {
+		result.push_back(MTP_int(id));
+	}
+	store.setOrder(std::move(merged));
+	return result;
+}
+
+void KeepFolder(
+		not_null<Data::Session*> owner,
+		const Data::ChatFilter &filter) {
+	if (IsLocalFolder(filter.id())) {
+		Lookup(&owner->session()).setFolder(ToStored(filter));
+	}
+}
+
+void ForgetFolder(not_null<Data::Session*> owner, FilterId id) {
+	if (id) {
+		Lookup(&owner->session()).forget(id);
+	}
+}
+
+} // namespace Tele
