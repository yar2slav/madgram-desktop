+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E9EE0);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxSaved = 4 * 1024 * 1024;
+constexpr auto kFetchAttempts = 4;
+constexpr auto kFetchDelay = crl::time(700);
+constexpr auto kRestoreAttempts = 5;
+constexpr auto kRestoreDelay = crl::time(2000);
+constexpr auto kArmDelay = crl::time(5000);
+
+using Rules = QVector<MTPInputPrivacyRule>;
+
+struct Peeked {
+	TimeId seen = 0;
+	TimeId onlineTill = 0;
+	Data::LastseenStatus armedStatus;
+	uint64 serial = 0;
+	bool armed = false;
+	bool shownInProfile = false;
+	bool shownInChat = false;
+};
+
+[[nodiscard]] MTPInputPrivacyKey Key() {
+	return MTP_inputPrivacyKeyStatusTimestamp();
+}
+
+[[nodiscard]] uint64 InputUserId(const MTPInputUser &user) {
+	return (user.type() == mtpc_inputUser)
+		? uint64(user.c_inputUser().vuser_id().v)
+		: 0;
+}
+
+[[nodiscard]] std::optional<QVector<MTPInputUser>> InputUsers(
+		not_null<Main::Session*> session,
+		const MTPVector<MTPlong> &ids) {
+	auto result = QVector<MTPInputUser>();
+	result.reserve(ids.v.size());
+	for (const auto &id : ids.v) {
+		const auto user = session->data().userLoaded(UserId(id.v));
+		if (!user || (!user->accessHash() && !user->isSelf())) {
+			return std::nullopt;
+		}
+		result.push_back(user->inputUser());
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<Rules> ToInput(
+		not_null<Main::Session*> session,
+		const QVector<MTPPrivacyRule> &rules) {
+	auto result = Rules();
+	result.reserve(rules.size());
+	auto ok = true;
+	for (const auto &rule : rules) {
+		rule.match([&](const MTPDprivacyValueAllowContacts &) {
+			result.push_back(MTP_inputPrivacyValueAllowContacts());
+		}, [&](const MTPDprivacyValueAllowAll &) {
+			result.push_back(MTP_inputPrivacyValueAllowAll());
+		}, [&](const MTPDprivacyValueAllowUsers &data) {
+			if (const auto users = InputUsers(session, data.vusers())) {
+				result.push_back(MTP_inputPrivacyValueAllowUsers(
+					MTP_vector<MTPInputUser>(*users)));
+			} else {
+				ok = false;
+			}
+		}, [&](const MTPDprivacyValueDisallowContacts &) {
+			result.push_back(MTP_inputPrivacyValueDisallowContacts());
+		}, [&](const MTPDprivacyValueDisallowAll &) {
+			result.push_back(MTP_inputPrivacyValueDisallowAll());
+		}, [&](const MTPDprivacyValueDisallowUsers &data) {
+			if (const auto users = InputUsers(session, data.vusers())) {
+				result.push_back(MTP_inputPrivacyValueDisallowUsers(
+					MTP_vector<MTPInputUser>(*users)));
+			} else {
+				ok = false;
+			}
+		}, [&](const MTPDprivacyValueAllowChatParticipants &data) {
+			result.push_back(
+				MTP_inputPrivacyValueAllowChatParticipants(data.vchats()));
+		}, [&](const MTPDprivacyValueDisallowChatParticipants &data) {
+			result.push_back(
+				MTP_inputPrivacyValueDisallowChatParticipants(data.vchats()));
+		}, [&](const MTPDprivacyValueAllowCloseFriends &) {
+			result.push_back(MTP_inputPrivacyValueAllowCloseFriends());
+		}, [&](const MTPDprivacyValueAllowPremium &) {
+			result.push_back(MTP_inputPrivacyValueAllowPremium());
+		}, [&](const MTPDprivacyValueAllowBots &) {
+			result.push_back(MTP_inputPrivacyValueAllowBots());
+		}, [&](const MTPDprivacyValueDisallowBots &) {
+			result.push_back(MTP_inputPrivacyValueDisallowBots());
+		});
+	}
+	return ok ? std::make_optional(std::move(result)) : std::nullopt;
+}
+
+[[nodiscard]] std::optional<Rules> WithAllowed(
+		const Rules &original,
+		not_null<UserData*> user) {
+	const auto id = peerToUser(user->id).bare;
+	auto allowed = QVector<MTPInputUser>{ user->inputUser() };
+	auto rest = Rules();
+	auto alreadyAllowed = false;
+	auto disallowed = false;
+	for (const auto &rule : original) {
+		switch (rule.type()) {
+		case mtpc_inputPrivacyValueAllowUsers: {
+			const auto &users = rule.c_inputPrivacyValueAllowUsers().vusers();
+			for (const auto &entry : users.v) {
+				if (InputUserId(entry) == id) {
+					alreadyAllowed = true;
+				} else {
+					allowed.push_back(entry);
+				}
+			}
+		} break;
+		case mtpc_inputPrivacyValueDisallowUsers: {
+			const auto &users
+				= rule.c_inputPrivacyValueDisallowUsers().vusers();
+			auto left = QVector<MTPInputUser>();
+			for (const auto &entry : users.v) {
+				if (InputUserId(entry) == id) {
+					disallowed = true;
+				} else {
+					left.push_back(entry);
+				}
+			}
+			if (!left.isEmpty()) {
+				rest.push_back(MTP_inputPrivacyValueDisallowUsers(
+					MTP_vector<MTPInputUser>(left)));
+			}
+		} break;
+		default:
+			rest.push_back(rule);
+			break;
+		}
+	}
+	if (alreadyAllowed && !disallowed) {
+		return std::nullopt;
+	}
+	auto result = Rules();
+	result.reserve(rest.size() + 1);
+	result.push_back(MTP_inputPrivacyValueAllowUsers(
+		MTP_vector<MTPInputUser>(allowed)));
+	for (const auto &rule : rest) {
+		result.push_back(rule);
+	}
+	return result;
+}
+
+[[nodiscard]] QByteArray SerializeRules(const Rules &rules) {
+	auto buffer = mtpBuffer();
+	MTPVector<MTPInputPrivacyRule>(
+		MTP_vector<MTPInputPrivacyRule>(rules)).write(buffer);
+	return QByteArray(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(mtpPrime));
+}
+
+[[nodiscard]] std::optional<Rules> DeserializeRules(
+		const QByteArray &bytes) {
+	if (bytes.isEmpty() || (bytes.size() % sizeof(mtpPrime))) {
+		return std::nullopt;
+	}
+	auto from = reinterpret_cast<const mtpPrime*>(bytes.constData());
+	const auto end = from + (bytes.size() / sizeof(mtpPrime));
+	auto result = MTPVector<MTPInputPrivacyRule>();
+	if (!result.read(from, end) || from != end) {
+		return std::nullopt;
+	}
+	return result.v;
+}
+
+[[nodiscard]] QString Phrase(const Peeked &peeked, TimeId now) {
+	if (peeked.onlineTill > now) {
+		return tr::lng_status_online(tr::now);
+	}
+	const auto seen = base::unixtime::parse(peeked.seen);
+	const auto today = base::unixtime::parse(now);
+	const auto locale = QLocale();
+	const auto time = locale.toString(seen.time(), QLocale::ShortFormat);
+	if (seen.date() == today.date()) {
+		return tr::lng_status_lastseen_today(tr::now, lt_time, time);
+	} else if (seen.date().addDays(1) == today.date()) {
+		return tr::lng_status_lastseen_yesterday(tr::now, lt_time, time);
+	}
+	return tr::lng_status_lastseen_date_time(
+		tr::now,
+		lt_date,
+		locale.toString(seen.date(), QLocale::ShortFormat),
+		lt_time,
+		time);
+}
+
+[[nodiscard]] UserData *Peekable(PeerData *peer) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	if (!user
+		|| user->isSelf()
+		|| user->isBot()
+		|| user->isServiceUser()
+		|| user->isInaccessible()
+		|| IsChangelogPeer(user)
+		|| user->session().premium()) {
+		return nullptr;
+	}
+	return user;
+}
+
+[[nodiscard]] bool StatusHidden(not_null<UserData*> user) {
+	const auto &lastseen = user->lastseen();
+	return lastseen.isHidden()
+		&& !lastseen.isOnline(base::unixtime::now());
+}
+
+[[nodiscard]] bool HiddenByMe(not_null<UserData*> user) {
+	return StatusHidden(user) && user->lastseen().isHiddenByMe();
+}
+
+class State final : public base::has_weak_ptr {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State *Find(not_null<Main::Session*> session);
+	[[nodiscard]] static not_null<State*> For(
+		not_null<Main::Session*> session);
+
+	void peek(not_null<UserData*> user);
+	[[nodiscard]] const Peeked *lookup(not_null<UserData*> user) const;
+	void markShown(not_null<UserData*> user, bool profile);
+	void opened(not_null<UserData*> user, bool profile);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	[[nodiscard]] bool save(const Rules &rules) const;
+	[[nodiscard]] std::optional<Rules> load() const;
+	void clearSaved() const;
+
+	void begin(not_null<UserData*> user, const Rules &original);
+	void fetch(
+		not_null<UserData*> user,
+		int attempt,
+		Fn<void(std::optional<Peeked>)> done);
+	void restore(Rules rules, int attempt, Fn<void(bool)> done);
+	void finish(not_null<UserData*> user, std::optional<Peeked> result);
+	void store(not_null<UserData*> user, Peeked peeked);
+	void forget(not_null<UserData*> user);
+	void statusChanged(not_null<PeerData*> peer);
+	void toast(const QString &text) const;
+
+	const not_null<Main::Session*> _session;
+	MTP::Sender _api;
+	base::flat_map<UserId, Peeked> _peeked;
+	uint64 _serial = 0;
+	bool _busy = false;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session)
+, _api(&session->mtp()) {
+	Registry().emplace(session, this);
+
+	_session->changes().peerUpdates(
+		Data::PeerUpdate::Flag::OnlineStatus
+	) | rpl::on_next([=](const Data::PeerUpdate &update) {
+		statusChanged(update.peer);
+	}, _lifetime);
+
+	if (auto saved = load()) {
+		_busy = true;
+		crl::on_main(this, [=, rules = std::move(*saved)] {
+			restore(rules, 0, [=](bool restored) {
+				_busy = false;
+				if (!restored) {
+					toast(Lower(u"Couldn't restore your last seen privacy, "
+						"tele tries again on the next start"_q));
+				}
+			});
+		});
+	}
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State *State::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+not_null<State*> State::For(not_null<Main::Session*> session) {
+	if (const auto result = Find(session)) {
+		return result;
+	}
+	return session->lifetime().make_state<State>(session);
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+bool State::save(const Rules &rules) const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return false;
+	}
+	const auto bytes = SerializeRules(rules);
+	const auto size = sizeof(quint32)
+		+ sizeof(qint32)
+		+ sizeof(quint64)
+		+ Serialize::bytearraySize(bytes);
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< bytes;
+	auto file = FileWriteDescriptor(u"tele_peek"_q, folder(), true);
+	file.writeEncrypted(data, key);
+	return true;
+}
+
+std::optional<Rules> State::load() const {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_peek"_q, folder(), key)) {
+		return std::nullopt;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto bytes = QByteArray();
+	file.stream >> magic >> version >> owner;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()) {
+		clearSaved();
+		return std::nullopt;
+	}
+	file.stream >> bytes;
+	auto result = (file.stream.status() == QDataStream::Ok
+		&& bytes.size() <= kMaxSaved)
+		? DeserializeRules(bytes)
+		: std::nullopt;
+	if (!result) {
+		clearSaved();
+	}
+	return result;
+}
+
+void State::clearSaved() const {
+	const auto base = folder() + u"tele_peek"_q;
+	QFile::remove(base + '0');
+	QFile::remove(base + '1');
+	QFile::remove(base + 's');
+}
+
+void State::toast(const QString &text) const {
+	if (const auto window = _session->tryResolveWindow()) {
+		ShowTeleToast(window, text);
+	}
+}
+
+void State::peek(not_null<UserData*> user) {
+	if (!HiddenByMe(user)) {
+		toast(Lower(u"Your privacy doesn't hide their last seen"_q));
+		return;
+	} else if (_busy) {
+		toast(Lower(u"Already peeking, wait a moment"_q));
+		return;
+	}
+	_busy = true;
+	if (auto saved = load()) {
+		restore(std::move(*saved), 0, [=](bool restored) {
+			_busy = false;
+			if (restored) {
+				peek(user);
+			} else {
+				toast(Lower(u"Couldn't restore your last seen privacy, "
+					"tele tries again on the next start"_q));
+			}
+		});
+		return;
+	}
+	_api.request(MTPaccount_GetPrivacy(
+		Key()
+	)).done([=](const MTPaccount_PrivacyRules &result) {
+		auto original = std::optional<Rules>();
+		result.match([&](const MTPDaccount_privacyRules &data) {
+			_session->data().processUsers(data.vusers());
+			_session->data().processChats(data.vchats());
+			original = ToInput(_session, data.vrules().v);
+		});
+		if (!original) {
+			_busy = false;
+			toast(Lower(u"Couldn't read your last seen privacy"_q));
+			return;
+		}
+		begin(user, *original);
+	}).fail([=] {
+		_busy = false;
+		toast(Lower(u"Couldn't read your last seen privacy"_q));
+	}).send();
+}
+
+void State::begin(not_null<UserData*> user, const Rules &original) {
+	const auto modified = WithAllowed(original, user);
+	if (!modified) {
+		fetch(user, kFetchAttempts - 1, [=](std::optional<Peeked> result) {
+			finish(user, result);
+		});
+		return;
+	}
+	if (!save(original)) {
+		_busy = false;
+		toast(Lower(u"Couldn't save your privacy rules, nothing changed"_q));
+		return;
+	}
+	_api.request(MTPaccount_SetPrivacy(
+		Key(),
+		MTP_vector<MTPInputPrivacyRule>(*modified)
+	)).done([=] {
+		fetch(user, 0, [=](std::optional<Peeked> result) {
+			restore(original, 0, [=](bool restored) {
+				if (!restored) {
+					toast(Lower(u"Couldn't restore your last seen privacy, "
+						"tele tries again on the next start"_q));
+				}
+				finish(user, result);
+			});
+		});
+	}).fail([=] {
+		clearSaved();
+		_busy = false;
+		toast(Lower(u"Couldn't change your last seen privacy"_q));
+	}).send();
+}
+
+void State::fetch(
+		not_null<UserData*> user,
+		int attempt,
+		Fn<void(std::optional<Peeked>)> done) {
+	const auto id = peerToUser(user->id);
+	_api.request(MTPusers_GetUsers(
+		MTP_vector<MTPInputUser>(1, user->inputUser())
+	)).done([=](const MTPVector<MTPUser> &result) {
+		auto found = std::optional<Peeked>();
+		const auto now = base::unixtime::now();
+		for (const auto &entry : result.v) {
+			entry.match([&](const MTPDuser &data) {
+				const auto status = data.vstatus();
+				if (UserId(data.vid()) != id || !status) {
+					return;
+				}
+				status->match([&](const MTPDuserStatusOnline &online) {
+					found = Peeked{
+						.seen = now,
+						.onlineTill = online.vexpires().v,
+					};
+				}, [&](const MTPDuserStatusOffline &offline) {
+					found = Peeked{ .seen = offline.vwas_online().v };
+				}, [](const auto &) {
+				});
+			}, [](const MTPDuserEmpty &) {
+			});
+		}
+		if (found || attempt + 1 >= kFetchAttempts) {
+			done(found);
+			return;
+		}
+		base::call_delayed(kFetchDelay, this, [=] {
+			fetch(user, attempt + 1, done);
+		});
+	}).fail([=] {
+		done(std::nullopt);
+	}).send();
+}
+
+void State::restore(Rules rules, int attempt, Fn<void(bool)> done) {
+	_api.request(MTPaccount_SetPrivacy(
+		Key(),
+		MTP_vector<MTPInputPrivacyRule>(rules)
+	)).done([=] {
+		clearSaved();
+		_session->api().userPrivacy().reload(
+			Api::UserPrivacy::Key::LastSeen);
+		done(true);
+	}).fail([=] {
+		if (attempt + 1 >= kRestoreAttempts) {
+			done(false);
+			return;
+		}
+		base::call_delayed(kRestoreDelay, this, [=] {
+			restore(rules, attempt + 1, done);
+		});
+	}).send();
+}
+
+void State::finish(
+		not_null<UserData*> user,
+		std::optional<Peeked> result) {
+	_busy = false;
+	if (!result) {
+		toast(Lower(u"They hide their last seen from you"_q));
+		return;
+	}
+	store(user, *result);
+	toast(Lower(u"Peeked: "_q) + Phrase(*result, base::unixtime::now()));
+}
+
+void State::store(not_null<UserData*> user, Peeked peeked) {
+	const auto id = peerToUser(user->id);
+	const auto serial = peeked.serial = ++_serial;
+	_peeked[id] = peeked;
+	_session->changes().peerUpdated(
+		user,
+		Data::PeerUpdate::Flag::OnlineStatus);
+	base::call_delayed(kArmDelay, this, [=] {
+		const auto i = _peeked.find(id);
+		if (i != end(_peeked) && i->second.serial == serial) {
+			i->second.armedStatus = user->lastseen();
+			i->second.armed = true;
+		}
+	});
+	const auto now = base::unixtime::now();
+	if (peeked.onlineTill > now) {
+		const auto delay = (peeked.onlineTill - now + 1) * crl::time(1000);
+		base::call_delayed(delay, this, [=] {
+			const auto i = _peeked.find(id);
+			if (i != end(_peeked) && i->second.serial == serial) {
+				_session->changes().peerUpdated(
+					user,
+					Data::PeerUpdate::Flag::OnlineStatus);
+			}
+		});
+	}
+}
+
+void State::forget(not_null<UserData*> user) {
+	if (_peeked.remove(peerToUser(user->id))) {
+		_session->changes().peerUpdated(
+			user,
+			Data::PeerUpdate::Flag::OnlineStatus);
+	}
+}
+
+void State::statusChanged(not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	if (!user) {
+		return;
+	}
+	const auto i = _peeked.find(peerToUser(user->id));
+	if (i == end(_peeked)
+		|| !i->second.armed
+		|| i->second.armedStatus == user->lastseen()) {
+		return;
+	}
+	forget(user);
+}
+
+const Peeked *State::lookup(not_null<UserData*> user) const {
+	const auto i = _peeked.find(peerToUser(user->id));
+	return (i != end(_peeked)) ? &i->second : nullptr;
+}
+
+void State::markShown(not_null<UserData*> user, bool profile) {
+	const auto i = _peeked.find(peerToUser(user->id));
+	if (i != end(_peeked)) {
+		(profile ? i->second.shownInProfile : i->second.shownInChat) = true;
+	}
+}
+
+void State::opened(not_null<UserData*> user, bool profile) {
+	const auto i = _peeked.find(peerToUser(user->id));
+	if (i != end(_peeked)
+		&& (profile ? i->second.shownInProfile : i->second.shownInChat)) {
+		forget(user);
+	}
+}
+
+[[nodiscard]] std::optional<QString> PeekedText(
+		not_null<UserData*> user,
+		TimeId now) {
+	if (!PeekLastSeen() || !StatusHidden(user)) {
+		return std::nullopt;
+	}
+	const auto state = State::Find(&user->session());
+	const auto peeked = state ? state->lookup(user) : nullptr;
+	return peeked ? std::make_optional(Phrase(*peeked, now)) : std::nullopt;
+}
+
+} // namespace
+
+void SetupPeekLastSeen(not_null<Main::Session*> session) {
+	State::For(session);
+}
+
+void AddPeekLastSeenAction(
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = Peekable(peer);
+	if (!user || !PeekLastSeen() || !HiddenByMe(user)) {
+		return;
+	}
+	addAction(Lower(u"Peek last seen"_q), [=] {
+		State::For(&user->session())->peek(user);
+	}, &st::menuIconWhenOnline);
+}
+
+rpl::producer<TextWithEntities> PeekedStatusValue(not_null<PeerData*> peer) {
+	const auto user = Peekable(peer);
+	if (!user) {
+		return rpl::single(TextWithEntities());
+	}
+	if (const auto state = State::Find(&user->session())) {
+		state->opened(user, true);
+	}
+	return user->session().changes().peerFlagsValue(
+		user,
+		Data::PeerUpdate::Flag::OnlineStatus
+	) | rpl::map([=] {
+		const auto text = PeekedText(user, base::unixtime::now());
+		if (!text) {
+			return TextWithEntities();
+		}
+		State::For(&user->session())->markShown(user, true);
+		return TextWithEntities{ *text };
+	});
+}
+
+QString WithPeekedStatus(
+		not_null<UserData*> user,
+		const QString &status,
+		TimeId now) {
+	const auto text = PeekedText(user, now);
+	if (!text) {
+		return status;
+	}
+	State::For(&user->session())->markShown(user, false);
+	return status + u" \u00B7 "_q + Lower(u"Peeked: "_q) + *text;
+}
+
+void PeekChatOpened(PeerData *peer) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	if (!user) {
+		return;
+	}
+	if (const auto state = State::Find(&user->session())) {
+		state->opened(user, false);
+	}
+}
+
