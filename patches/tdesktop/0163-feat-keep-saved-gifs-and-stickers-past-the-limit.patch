index 0000000000000000000000000000000000000000..996d9e59f975c22208c2d43ac92c0f6e96dc0174
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_past_limit.cpp
@@ -0,0 +1,431 @@
+#include "tele/tele_past_limit.h"
+
+#include "data/data_document.h"
+#include "data/data_premium_limits.h"
+#include "data/data_session.h"
+#include "data/stickers/data_stickers.h"
+#include "lang/lang_hardcoded.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/serialize_common.h"
+#include "storage/serialize_document.h"
+#include "storage/storage_account.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E0A57);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxDocuments = 65536;
+
+enum class Kind : uchar {
+	Gifs,
+	Faved,
+};
+constexpr auto kKinds = 2;
+
+using Documents = std::vector<not_null<DocumentData*>>;
+
+class State final : public base::has_weak_ptr {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] bool contains(
+		Kind kind,
+		not_null<const DocumentData*> document);
+	[[nodiscard]] const Data::SavedGifs &gifs(const Data::SavedGifs &saved);
+	[[nodiscard]] Data::StickersSet *faved(const Data::StickersSets &sets);
+	bool forget(not_null<DocumentData*> document);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	[[nodiscard]] Documents current(Kind kind) const;
+	[[nodiscard]] int limit(Kind kind) const;
+	void load();
+	void read();
+	void write() const;
+	void check(Kind kind);
+	void notify(Kind kind) const;
+
+	const not_null<Main::Session*> _session;
+	std::array<Documents, kKinds> _seen;
+	std::array<Documents, kKinds> _extra;
+	Data::SavedGifs _gifs;
+	std::unique_ptr<Data::StickersSet> _faved;
+	bool _loaded = false;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+
+	auto &stickers = session->data().stickers();
+	stickers.savedGifsUpdated(
+	) | rpl::on_next([=] {
+		check(Kind::Gifs);
+	}, _lifetime);
+
+	stickers.updated(
+		Data::StickersType::Stickers
+	) | rpl::on_next([=] {
+		check(Kind::Faved);
+	}, _lifetime);
+
+	MediaPastLimitChanges(
+	) | rpl::on_next([=] {
+		notify(Kind::Gifs);
+		notify(Kind::Faved);
+	}, _lifetime);
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State *State::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+Documents State::current(Kind kind) const {
+	const auto &stickers = _session->data().stickers();
+	auto result = Documents();
+	if (kind == Kind::Gifs) {
+		const auto &saved = stickers.savedGifs();
+		result.reserve(saved.size());
+		for (const auto document : saved) {
+			result.push_back(document);
+		}
+		return result;
+	}
+	const auto &sets = stickers.sets();
+	const auto i = sets.find(Data::Stickers::FavedSetId);
+	if (i != end(sets)) {
+		const auto &list = i->second->stickers;
+		result.reserve(list.size());
+		for (const auto document : list) {
+			result.push_back(document);
+		}
+	}
+	return result;
+}
+
+int State::limit(Kind kind) const {
+	const auto limits = Data::PremiumLimits(_session);
+	return (kind == Kind::Gifs)
+		? limits.gifsCurrent()
+		: limits.stickersFavedCurrent();
+}
+
+void State::load() {
+	if (!_loaded) {
+		_loaded = true;
+		read();
+	}
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(file, u"tele_past_limit"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	file.stream >> magic >> version >> owner;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()) {
+		return;
+	}
+	auto result = std::array<Documents, kKinds>();
+	for (auto kind = 0; kind != kKinds; ++kind) {
+		auto count = quint32();
+		file.stream >> count;
+		if (file.stream.status() != QDataStream::Ok
+			|| count > kMaxDocuments) {
+			return;
+		}
+		auto &list = result[kind];
+		list.reserve(count);
+		for (auto i = quint32(); i != count; ++i) {
+			auto document = (DocumentData*)nullptr;
+			if (Kind(kind) == Kind::Gifs) {
+				document = Serialize::Document::readFromStream(
+					_session,
+					file.version,
+					file.stream);
+			} else {
+				auto setId = quint64();
+				auto accessHash = quint64();
+				auto shortName = QString();
+				file.stream >> setId >> accessHash >> shortName;
+				if (file.stream.status() != QDataStream::Ok) {
+					return;
+				}
+				document = Serialize::Document::readStickerFromStream(
+					_session,
+					file.version,
+					file.stream,
+					{ setId, accessHash, shortName });
+			}
+			if (file.stream.status() != QDataStream::Ok) {
+				return;
+			} else if (!document
+				|| ((Kind(kind) == Kind::Gifs)
+					? !document->isGifv()
+					: !document->sticker())
+				|| ranges::contains(list, not_null(document))) {
+				continue;
+			}
+			list.push_back(document);
+		}
+	}
+	_extra = std::move(result);
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) + sizeof(qint32) + sizeof(quint64);
+	for (auto kind = 0; kind != kKinds; ++kind) {
+		size += sizeof(quint32);
+		for (const auto document : _extra[kind]) {
+			size += Serialize::Document::sizeInStream(document);
+			if (Kind(kind) == Kind::Faved) {
+				const auto sticker = document->sticker();
+				size += sizeof(quint64) * 2 + Serialize::stringSize(
+					sticker ? sticker->set.shortName : QString());
+			}
+		}
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId());
+	for (auto kind = 0; kind != kKinds; ++kind) {
+		data.stream << quint32(_extra[kind].size());
+		for (const auto document : _extra[kind]) {
+			if (Kind(kind) == Kind::Faved) {
+				const auto sticker = document->sticker();
+				const auto set = sticker
+					? sticker->set
+					: StickerSetIdentifier();
+				data.stream
+					<< quint64(set.id)
+					<< quint64(set.accessHash)
+					<< set.shortName;
+			}
+			Serialize::Document::writeToStream(data.stream, document);
+		}
+	}
+	auto file = FileWriteDescriptor(u"tele_past_limit"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+void State::check(Kind kind) {
+	auto now = current(kind);
+	auto &seen = _seen[int(kind)];
+	if (!MediaPastLimit()) {
+		seen = std::move(now);
+		return;
+	}
+	load();
+	auto &extra = _extra[int(kind)];
+	auto changed = false;
+	if (int(now.size()) >= limit(kind)) {
+		auto dropped = Documents();
+		for (const auto document : seen) {
+			if (!ranges::contains(now, document)
+				&& !ranges::contains(extra, document)) {
+				dropped.push_back(document);
+			}
+		}
+		if (!dropped.empty()) {
+			extra.insert(begin(extra), begin(dropped), end(dropped));
+			changed = true;
+		}
+	}
+	const auto kept = std::remove_if(begin(extra), end(extra), [&](
+			not_null<DocumentData*> document) {
+		return ranges::contains(now, document);
+	});
+	if (kept != end(extra)) {
+		extra.erase(kept, end(extra));
+		changed = true;
+	}
+	seen = std::move(now);
+	if (changed) {
+		write();
+		crl::on_main(this, [=] {
+			notify(kind);
+		});
+	}
+}
+
+void State::notify(Kind kind) const {
+	auto &stickers = _session->data().stickers();
+	if (kind == Kind::Gifs) {
+		stickers.notifySavedGifsUpdated();
+	} else {
+		stickers.notifyUpdated(Data::StickersType::Stickers);
+	}
+}
+
+bool State::contains(Kind kind, not_null<const DocumentData*> document) {
+	if (!MediaPastLimit()) {
+		return false;
+	}
+	load();
+	return ranges::contains(
+		_extra[int(kind)],
+		document.get(),
+		&not_null<DocumentData*>::get);
+}
+
+const Data::SavedGifs &State::gifs(const Data::SavedGifs &saved) {
+	if (!MediaPastLimit()) {
+		return saved;
+	}
+	load();
+	const auto &extra = _extra[int(Kind::Gifs)];
+	if (extra.empty()) {
+		return saved;
+	}
+	_gifs = saved;
+	for (const auto document : extra) {
+		if (!_gifs.contains(document)) {
+			_gifs.push_back(document);
+		}
+	}
+	return _gifs;
+}
+
+Data::StickersSet *State::faved(const Data::StickersSets &sets) {
+	const auto i = sets.find(Data::Stickers::FavedSetId);
+	const auto set = (i != end(sets)) ? i->second.get() : nullptr;
+	if (!MediaPastLimit()) {
+		return set;
+	}
+	load();
+	const auto &extra = _extra[int(Kind::Faved)];
+	if (extra.empty()) {
+		return set;
+	}
+	if (!_faved) {
+		_faved = std::make_unique<Data::StickersSet>(
+			&_session->data(),
+			Data::Stickers::FavedSetId,
+			uint64(0),
+			uint64(0),
+			Lang::Hard::FavedSetTitle(),
+			QString(),
+			0,
+			Data::StickersSetFlag::Special,
+			TimeId(0));
+	}
+	_faved->stickers = set ? set->stickers : Data::StickersPack();
+	for (const auto document : extra) {
+		if (!_faved->stickers.contains(document)) {
+			_faved->stickers.push_back(document);
+		}
+	}
+	_faved->count = _faved->stickers.size();
+	return _faved.get();
+}
+
+bool State::forget(not_null<DocumentData*> document) {
+	if (!MediaPastLimit()) {
+		return false;
+	}
+	load();
+	auto result = false;
+	for (auto kind = 0; kind != kKinds; ++kind) {
+		auto &seen = _seen[kind];
+		seen.erase(
+			std::remove(begin(seen), end(seen), document),
+			end(seen));
+		auto &extra = _extra[kind];
+		const auto i = ranges::find(extra, document);
+		if (i != end(extra)) {
+			extra.erase(i);
+			result = true;
+			write();
+			notify(Kind(kind));
+		}
+	}
+	return result;
+}
+
+} // namespace
+
+void SetupMediaPastLimit(not_null<Main::Session*> session) {
+	session->lifetime().make_state<State>(session);
+}
+
+const Data::SavedGifs &SavedGifsPastLimit(
+		not_null<Main::Session*> session,
+		const Data::SavedGifs &saved) {
+	const auto state = State::Find(session);
+	return state ? state->gifs(saved) : saved;
+}
+
+Data::StickersSet *FavedSetPastLimit(
+		not_null<Main::Session*> session,
+		const Data::StickersSets &sets) {
+	if (const auto state = State::Find(session)) {
+		return state->faved(sets);
+	}
+	const auto i = sets.find(Data::Stickers::FavedSetId);
+	return (i != end(sets)) ? i->second.get() : nullptr;
+}
+
+bool IsSavedGifPastLimit(not_null<const DocumentData*> document) {
+	const auto state = State::Find(&document->session());
+	return state && state->contains(Kind::Gifs, document);
+}
+
+bool IsFavedPastLimit(not_null<const DocumentData*> document) {
+	const auto state = State::Find(&document->session());
+	return state && state->contains(Kind::Faved, document);
+}
+
+bool ForgetPastLimit(not_null<DocumentData*> document) {
+	const auto state = State::Find(&document->session());
+	return state && state->forget(document);
+}
+
+} // namespace Tele
