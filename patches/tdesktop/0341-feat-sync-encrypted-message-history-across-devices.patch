diff --git a/Telegram/SourceFiles/tele/tests/history_crypto_tests.cpp b/Telegram/SourceFiles/tele/tests/history_crypto_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..72b9981510a1dc8263670f8ef7f78b754d2f95a7
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tests/history_crypto_tests.cpp
@@ -0,0 +1,51 @@
+#include "tele/tele_history_crypto.h"
+#include "tele/tele_history_records.h"
+#include <QtCore/QDataStream>
+#include <QtCore/QIODevice>
+#include <QtCore/QCoreApplication>
+#include <QtCore/QDebug>
+
+int main(int argc, char **argv) {
+	QCoreApplication app(argc, argv);
+	const auto check = [](bool good) { if (!good) qFatal("history crypto test failed"); };
+	const auto key = Tele::NewHistoryKey();
+	const auto vault = QByteArray(32, 'a');
+	const auto plain = QByteArray("message");
+	check(key.size() == 32);
+	const auto first = Tele::SealHistory(key, vault, plain);
+	const auto second = Tele::SealHistory(key, vault, plain);
+	check(first && second && *first != *second);
+	check(Tele::OpenHistory(key, vault, *first) == plain);
+	check(!Tele::OpenHistory(Tele::NewHistoryKey(), vault, *first));
+	check(!Tele::OpenHistory(key, QByteArray(32, 'b'), *first));
+	for (auto i = 0; i != first->size(); ++i) {
+		auto changed = *first;
+		changed[i] = char(changed[i] ^ 1);
+		check(!Tele::OpenHistory(key, vault, changed));
+	}
+	check(!Tele::OpenHistory(key, vault, first->left(28)));
+	check(!Tele::SealHistory(QByteArray(31, 'a'), vault, plain));
+	check(!Tele::SealHistory(key, vault, QByteArray(2 * 1024 * 1024, 'a')));
+	const auto empty = Tele::SealHistory(key, vault, {});
+	check(empty && Tele::OpenHistory(key, vault, *empty) == QByteArray());
+	const auto vector = QByteArray::fromHex("012222222222222222222222228ae954827aa649125aec8011f9b87bde7a92743aa1a8fa");
+	check(Tele::OpenHistory(QByteArray(32, char(0x11)), vault, vector) == plain);
+	const auto revision = [](qint32 date, QString text) {
+		auto bytes = QByteArray();
+		auto stream = QDataStream(&bytes, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		stream << qint32(1) << quint8(1) << quint32(1)
+			<< date << quint8(0) << text << quint32(0) << quint8(0);
+		return bytes;
+	};
+	const auto a = revision(10, QStringLiteral("first"));
+	const auto b = revision(20, QStringLiteral("second"));
+	const auto merged = Tele::MergeHistoryEdits(a, b);
+	check(merged.has_value());
+	check(Tele::MergeHistoryEdits(b, a) == merged);
+	check(Tele::MergeHistoryEdits(*merged, a) == merged);
+	check(Tele::MergeHistoryEdits(*merged, *merged) == merged);
+	check(!Tele::MergeHistoryEdits(a, b.left(b.size() - 1)));
+	check(!Tele::MergeHistoryEdits({}, QByteArray("broken")));
+	qInfo("history crypto and merge tests passed");
+}
