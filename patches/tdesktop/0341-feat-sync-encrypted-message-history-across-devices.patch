@@ -0,0 +1,435 @@
+#include "tele/tele_history_sync.h"
+
+#include "base/options.h"
+#include "main/main_session.h"
+#include "storage/storage_account.h"
+#include "storage/details/storage_file_utilities.h"
+#include "tele/tele_history_crypto.h"
+#include "tele/tele_kept_store.h"
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/checkbox.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_widgets.h"
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QFileInfo>
+#include <QtCore/QFile>
+#include <QtCore/QMessageAuthenticationCode>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QMap>
+#include <QtCore/QPointer>
+#include <QtCore/QSet>
+#include <QtCore/QTimer>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+constexpr auto kResponseLimit = 8 * 1024 * 1024;
+
+QString Hash(const QByteArray &bytes) {
+	return QString::fromLatin1(QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex());
+}
+
+QString Digest(const QByteArray &plain, const QByteArray &key) {
+	const auto derived = QMessageAuthenticationCode::hash("mad-history-seen-v1", key, QCryptographicHash::Sha256);
+	return QString::fromLatin1(QMessageAuthenticationCode::hash(plain, derived, QCryptographicHash::Sha256).toHex());
+}
+
+bool Hex(const QString &text, int size) {
+	return text.size() == size && ranges::all_of(text, [](QChar c) {
+		return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+	});
+}
+
+class Sync final : public QObject {
+public:
+	explicit Sync(not_null<Main::Session*> session);
+	void tick();
+	void rescan();
+	bool save();
+	void stop();
+	bool enabled() const;
+	bool configure(const QString &text);
+	QString transfer() const;
+	bool dirty = true;
+	rpl::variable<QString> status;
+	QJsonObject config;
+
+private:
+	void request(const QString &method, const QString &suffix, QByteArray body,
+		Fn<void(int, QByteArray)> done);
+	void loadLedger();
+	void remember(const QString &digest);
+	QString ledger() const;
+	void pull();
+	void push();
+	const not_null<Main::Session*> _session;
+	QNetworkAccessManager _network;
+	QNetworkReply *_reply = nullptr;
+	QTimer _timer;
+	QSet<QString> _sent;
+	QByteArray _pendingDigests;
+	QJsonArray _outgoing;
+	QJsonArray _digests;
+	int _position = 0;
+	KeptHistoryCursor _cursor;
+	bool _exporting = false;
+	bool _ledgerLoaded = false;
+	uint64 _generation = 0;
+	rpl::lifetime _lifetime;
+};
+
+QMap<Main::Session*, Sync*> Instances;
+
+QString Owner(not_null<Main::Session*> session) {
+	return QString::number(session->uniqueId());
+}
+
+QString Folder(not_null<Main::Session*> session) {
+	return QFileInfo(session->local().supportModePath()).absolutePath() + '/';
+}
+
+Sync::Sync(not_null<Main::Session*> session) : _session(session) {
+	auto file = FileReadDescriptor();
+	const auto key = session->local().peekLegacyLocalKey();
+	if (key && ReadEncryptedFile(file, u"mad_history_sync"_q, Folder(session), key)) {
+		auto bytes = QByteArray();
+		file.stream >> bytes;
+		if (file.stream.status() == QDataStream::Ok && bytes.size() <= kResponseLimit) {
+			const auto saved = QJsonDocument::fromJson(bytes).object();
+			if (saved.value(u"owner"_q).toString() == Owner(session)) {
+				config = saved;
+
+			}
+		}
+	}
+	status = Tr(u"History sync is off"_q);
+	connect(&_timer, &QTimer::timeout, this, [=] { tick(); });
+	_timer.start(60000);
+	base::options::lookup<QString>(kOptionHistorySyncAccounts).changes()
+		| rpl::on_next([=] { stop(); tick(); }, _lifetime);
+	base::options::lookup<QString>(kOptionServerUrl).changes()
+		| rpl::on_next([=] { stop(); }, _lifetime);
+	QTimer::singleShot(0, this, [=] { tick(); });
+}
+
+void Sync::loadLedger() {
+	if (std::exchange(_ledgerLoaded, true)) return;
+	if (Hex(config.value(u"vault"_q).toString(), 32)) {
+		auto seen = QFile(ledger());
+		if (seen.open(QIODevice::ReadWrite) && seen.size() <= 64 * 1024 * 1024) {
+			if (!seen.size()) config.insert(u"cursor"_q, u"0"_q);
+			if (seen.size() % 32) {
+				seen.resize(seen.size() - seen.size() % 32);
+				config.insert(u"cursor"_q, u"0"_q);
+			}
+			while (!seen.atEnd()) {
+				const auto bytes = seen.read(32);
+				if (bytes.size() != 32) { config.insert(u"cursor"_q, u"0"_q); break; }
+				_sent.insert(QString::fromLatin1(bytes.toHex()));
+			}
+		} else config.insert(u"cursor"_q, u"0"_q);
+	}
+}
+
+bool Sync::enabled() const {
+	return !OfflineForLaunch() && !ServerOffForLaunch() && !_session->isTestMode()
+		&& base::options::lookup<QString>(kOptionHistorySyncAccounts).value().split(',').contains(Owner(_session))
+		&& KeepDeletedPersist() && EditHistoryPersist()
+		&& !ServerUrl().isEmpty() && config.value(u"server"_q).toString() == ServerUrl()
+		&& Hex(config.value(u"vault"_q).toString(), 32)
+		&& Hex(config.value(u"token"_q).toString(), 64)
+		&& QByteArray::fromBase64(config.value(u"key"_q).toString().toLatin1()).size() == 32;
+}
+
+QString Sync::ledger() const {
+	return Folder(_session) + u"mad_history_seen_"_q + config.value(u"vault"_q).toString();
+}
+
+void Sync::remember(const QString &digest) {
+	if (_sent.contains(digest)) return;
+	_sent.insert(digest);
+	_pendingDigests.append(QByteArray::fromHex(digest.toLatin1()));
+}
+
+bool Sync::save() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !Hex(config.value(u"vault"_q).toString(), 32)) return false;
+	if (!_pendingDigests.isEmpty()) {
+		auto seen = QFile(ledger());
+		if (!seen.open(QIODevice::WriteOnly | QIODevice::Append)) return false;
+		const auto size = seen.size();
+		if (size + _pendingDigests.size() > 64 * 1024 * 1024
+			|| seen.write(_pendingDigests) != _pendingDigests.size() || !seen.flush()) {
+			seen.resize(size);
+			return false;
+		}
+		_pendingDigests.clear();
+	}
+	auto value = config;
+	value.insert(u"owner"_q, Owner(_session));
+	const auto bytes = QJsonDocument(value).toJson(QJsonDocument::Compact);
+	auto data = EncryptedDescriptor(bytes.size() + 8);
+	data.stream << bytes;
+	auto file = FileWriteDescriptor(u"mad_history_sync"_q, Folder(_session), true);
+	file.writeEncrypted(data, key);
+	return file.finish();
+}
+
+void Sync::stop() {
+	++_generation;
+	if (_reply) _reply->abort();
+	_outgoing = {};
+	_digests = {};
+	_position = 0;
+	_exporting = false;
+	dirty = true;
+	status = Tr(u"History sync is off"_q);
+}
+
+bool Sync::configure(const QString &text) {
+	if (_session->isTestMode() || text.size() > 8192) return false;
+	const auto value = QJsonDocument::fromJson(text.toUtf8()).object();
+	const auto owner = value.value(u"owner"_q).toString();
+	const auto vault = value.value(u"vault"_q).toString();
+	const auto token = value.value(u"token"_q).toString();
+	const auto server = QUrl(ServerUrl());
+	if (value.value(u"version"_q).toInt() != 1 || !Hex(vault, 32) || !Hex(token, 64)
+		|| (!owner.isEmpty() && owner != Owner(_session))
+		|| server.scheme() != u"https"_q || !server.userInfo().isEmpty()
+		|| server.host().isEmpty() || server.hasQuery() || server.hasFragment()) return false;
+	auto key = QByteArray::fromBase64(value.value(u"key"_q).toString().toLatin1());
+	if (key.isEmpty() && !value.contains(u"key"_q)) {
+		key = config.value(u"vault"_q).toString() == vault
+			? QByteArray::fromBase64(config.value(u"key"_q).toString().toLatin1())
+			: NewHistoryKey();
+	}
+	if (key.size() != 32) return false;
+	auto &enabled = base::options::lookup<QString>(kOptionHistorySyncAccounts);
+	auto accounts = enabled.value().split(',', Qt::SkipEmptyParts);
+	accounts.removeAll(Owner(_session));
+	enabled.set(accounts.join(','));
+	stop();
+	_sent.clear();
+	_pendingDigests.clear();
+	_ledgerLoaded = false;
+	config = QJsonObject{
+		{ u"version"_q, 1 }, { u"owner"_q, Owner(_session) },
+		{ u"server"_q, ServerUrl() }, { u"vault"_q, vault }, { u"token"_q, token },
+		{ u"key"_q, QString::fromLatin1(key.toBase64()) }, { u"cursor"_q, u"0"_q },
+	};
+	if (!save()) { config = {}; return false; }
+	status = Tr(u"Connection saved. Back up the transfer code before enabling sync."_q);
+	return true;
+}
+
+QString Sync::transfer() const {
+	auto value = config;
+	value.remove(u"cursor"_q);
+	return QString::fromUtf8(QJsonDocument(value).toJson(QJsonDocument::Compact));
+}
+
+void Sync::request(const QString &method, const QString &suffix, QByteArray body,
+		Fn<void(int, QByteArray)> done) {
+	if (!enabled()) { done(0, {}); return; }
+	const auto url = ServerUrl() + u"/v1/vaults/"_q + config.value(u"vault"_q).toString() + u"/events"_q + suffix;
+	auto request = QNetworkRequest(QUrl(url));
+	request.setTransferTimeout(15000);
+	request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+	request.setAttribute(QNetworkRequest::CookieLoadControlAttribute, QNetworkRequest::Manual);
+	request.setAttribute(QNetworkRequest::CookieSaveControlAttribute, QNetworkRequest::Manual);
+	request.setRawHeader("Authorization", "Bearer " + config.value(u"token"_q).toString().toLatin1());
+	request.setRawHeader("Content-Type", "application/json");
+	const auto reply = method == u"GET"_q ? _network.get(request) : _network.post(request, body);
+	_reply = reply;
+	const auto generation = _generation;
+	const auto buffer = std::make_shared<QByteArray>();
+	connect(reply, &QIODevice::readyRead, this, [=] {
+		buffer->append(reply->read(kResponseLimit + 1 - buffer->size()));
+		if (buffer->size() > kResponseLimit || reply->bytesAvailable()) reply->abort();
+	});
+	connect(reply, &QNetworkReply::finished, this, [=] {
+		if (_reply == reply) _reply = nullptr;
+		buffer->append(reply->read(kResponseLimit + 1 - buffer->size()));
+		const auto code = reply->error() == QNetworkReply::NoError && buffer->size() <= kResponseLimit
+			? reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt() : 0;
+		reply->deleteLater();
+		if (generation == _generation) done(code, *buffer);
+	});
+}
+
+void Sync::rescan() {
+	stop();
+	config.insert(u"cursor"_q, u"0"_q);
+	if (save()) tick();
+}
+
+void Sync::tick() {
+	if (!enabled() || _reply) return;
+	loadLedger();
+	status = Tr(u"Syncing history..."_q);
+	pull();
+}
+
+void Sync::pull() {
+	if (!enabled() || _reply) return;
+	const auto cursor = config.value(u"cursor"_q).toString(u"0"_q);
+	request(u"GET"_q, u"?after="_q + cursor, {}, [=](int code, QByteArray bytes) {
+		if (code != 200) { status = Tr(u"History sync failed; local history is unchanged."_q); return; }
+		const auto response = QJsonDocument::fromJson(bytes).object();
+		const auto events = response.value(u"events"_q).toArray();
+		if (!response.value(u"events"_q).isArray()) { status = Tr(u"Invalid encrypted history response"_q); return; }
+		const auto next = response.value(u"next"_q).toString();
+		auto ok = false;
+		const auto nextNumber = next.toLongLong(&ok);
+		if (!ok || nextNumber < cursor.toLongLong() || events.size() > 64
+			|| (!events.isEmpty() && nextNumber == cursor.toLongLong())) {
+			status = Tr(u"Invalid encrypted history response"_q); return;
+		}
+		const auto key = QByteArray::fromBase64(config.value(u"key"_q).toString().toLatin1());
+		const auto vault = config.value(u"vault"_q).toString().toLatin1();
+		auto sequence = cursor.toLongLong();
+		auto records = QJsonArray();
+		auto digests = QSet<QString>();
+		for (const auto event : events) {
+			const auto object = event.toObject();
+			auto sequenceOk = false;
+			const auto nextSequence = object.value(u"seq"_q).toString().toLongLong(&sequenceOk);
+			if (!sequenceOk || nextSequence <= sequence || nextSequence > nextNumber) { status = Tr(u"Invalid encrypted history response"_q); return; }
+			sequence = nextSequence;
+			const auto sealed = QByteArray::fromBase64(object.value(u"blob"_q).toString().toLatin1());
+			const auto plain = OpenHistory(key, vault, sealed);
+			if (!plain || Hash(sealed) != object.value(u"id"_q).toString()) {
+				status = Tr(u"Wrong master key or damaged history; nothing was imported."_q); return;
+			}
+			const auto record = QJsonDocument::fromJson(*plain).object();
+			if (record.value(u"owner"_q).toString() != Owner(_session)) {
+				status = Tr(u"History belongs to another account"_q); return;
+			}
+			records.append(record);
+			digests.insert(Digest(*plain, key));
+		}
+		if (sequence != nextNumber || !ImportKeptHistory(_session, records)) {
+			status = Tr(u"Invalid encrypted history response"_q); return;
+		}
+		for (const auto &digest : digests) remember(digest);
+		config.insert(u"cursor"_q, next);
+		if (!events.isEmpty() && !save()) { status = Tr(u"Could not save sync state to disk"_q); return; }
+		if (!events.isEmpty()) QTimer::singleShot(0, this, [=] { if (enabled()) pull(); });
+		else push();
+	});
+}
+
+void Sync::push() {
+	if (!enabled() || _reply) return;
+	if (_position >= _outgoing.size()) {
+		_outgoing = {}; _digests = {}; _position = 0;
+		if (!_exporting && std::exchange(dirty, false)) {
+			_cursor = {};
+			_exporting = true;
+		}
+		if (_exporting) {
+			const auto key = QByteArray::fromBase64(config.value(u"key"_q).toString().toLatin1());
+			const auto vault = config.value(u"vault"_q).toString().toLatin1();
+			for (const auto value : ExportKeptHistory(_session, _cursor)) {
+				const auto plain = QJsonDocument(value.toObject()).toJson(QJsonDocument::Compact);
+				const auto digest = Digest(plain, key);
+				if (_sent.contains(digest)) continue;
+				const auto sealed = SealHistory(key, vault, plain);
+				if (!sealed) { dirty = true; status = Tr(u"A history record is too large to sync"_q); return; }
+				_outgoing.append(QJsonObject{ { u"id"_q, Hash(*sealed) },
+					{ u"blob"_q, QString::fromLatin1(sealed->toBase64()) } });
+				_digests.append(digest);
+			}
+			_exporting = _cursor.kind <= 2;
+		}
+	}
+	if (_position == _outgoing.size()) {
+		if (_exporting || dirty) QTimer::singleShot(0, this, [=] { push(); });
+		else status = Tr(u"History is synced"_q);
+		return;
+	}
+	auto batch = QJsonArray();
+	auto end = _position;
+	auto size = 0;
+	for (; end < _outgoing.size(); ++end) {
+		const auto event = _outgoing[end].toObject();
+		const auto nextSize = int(event.value(u"blob"_q).toString().size()) + 256;
+		if (!batch.isEmpty() && size + nextSize > 6 * 1024 * 1024) break;
+		size += nextSize;
+		batch.append(event);
+	}
+	const auto body = QJsonDocument(QJsonObject{ { u"events"_q, batch } }).toJson(QJsonDocument::Compact);
+	request(u"POST"_q, {}, body, [=](int code, QByteArray) {
+		if (code != 200) { status = Tr(u"History sync failed; local history is unchanged."_q); return; }
+		for (auto i = _position; i != end; ++i) remember(_digests[i].toString());
+		_position = end;
+		if (!save()) { status = Tr(u"Could not save sync state to disk"_q); return; }
+		QTimer::singleShot(0, this, [=] { push(); });
+	});
+}
+
+}
+
+void SetupHistorySync(not_null<Main::Session*> session) {
+	const auto sync = session->lifetime().make_state<Sync>(session);
+	Instances.insert(session, sync);
+	session->lifetime().add([=] { Instances.remove(session); });
+}
+
+void HistorySyncChanged(not_null<Main::Session*> session) {
+	if (const auto sync = Instances.value(session)) sync->dirty = true;
+}
+
+void HistorySyncBox(not_null<Ui::GenericBox*> box, not_null<Main::Session*> session) {
+	const auto sync = QPointer<Sync>(Instances.value(session));
+	box->setTitle(rpl::single(Tr(u"Encrypted history sync"_q)));
+	if (!sync) return;
+	box->addRow(object_ptr<Ui::FlatLabel>(box, Tr(u"Sync saved deleted messages and edit history for this account. Media files are not uploaded. Keep a backup of your master key."_q), st::boxLabel));
+	const auto check = box->addRow(object_ptr<Ui::Checkbox>(box,
+		Tr(u"Enable for this account"_q), base::options::lookup<QString>(kOptionHistorySyncAccounts).value().split(',').contains(Owner(session)), st::defaultCheckbox, st::defaultToggle));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(box, st::defaultInputField,
+		rpl::single(Tr(u"Connection or transfer code"_q))));
+	box->addRow(object_ptr<Ui::FlatLabel>(box, sync->status.value(), st::boxLabel));
+	check->checkedChanges() | rpl::on_next([=](bool enabled) {
+		if (!sync) return;
+		auto &option = base::options::lookup<QString>(kOptionHistorySyncAccounts);
+		auto accounts = option.value().split(',', Qt::SkipEmptyParts);
+		accounts.removeAll(Owner(session));
+		if (enabled && sync->config.contains(u"key"_q) && !session->isTestMode()) {
+			accounts.push_back(Owner(session));
+			base::options::lookup<bool>(kOptionKeepDeleted).set(true);
+			base::options::lookup<bool>(kOptionEditHistory).set(true);
+			base::options::lookup<bool>(kOptionKeepDeletedPersist).set(true);
+			base::options::lookup<bool>(kOptionEditHistoryPersist).set(true);
+		}
+		option.set(accounts.join(','));
+		if (enabled && !accounts.contains(Owner(session))) { check->setChecked(false); field->showError(); }
+	}, box->lifetime());
+	box->addButton(rpl::single(Tr(u"Save"_q)), [=] {
+		if (!sync) return;
+		if (!sync->configure(field->getLastText())) {
+			field->showError();
+			sync->status = Tr(u"Check the connection code, account and HTTPS server address"_q);
+		}
+		else { check->setChecked(false); field->setText(QString()); }
+	});
+	const auto transfer = box->addRow(object_ptr<Ui::LinkButton>(box, Tr(u"Show transfer code"_q)));
+	transfer->setClickedCallback([=] { if (sync) field->setText(sync->transfer()); });
+	const auto rescan = box->addRow(object_ptr<Ui::LinkButton>(box, Tr(u"Download history again"_q)));
+	rescan->setClickedCallback([=] { if (sync) sync->rescan(); });
+	box->addButton(rpl::single(Tr(u"Close"_q)), [=] { box->closeBox(); });
+}
+
+}
