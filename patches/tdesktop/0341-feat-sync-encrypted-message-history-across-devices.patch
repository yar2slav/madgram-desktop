+QJsonArray Store::snapshot(KeptHistoryCursor &cursor) {
+	auto result = QJsonArray();
+	if (!ensureLoaded()) return result;
+	for (; cursor.kind <= 2; ++cursor.kind, cursor.after = FullMsgId()) {
+		const auto kind = EntryKind(cursor.kind);
+		const auto &entries = list(kind);
+		for (auto i = entries.upper_bound(cursor.after); i != entries.end(); ++i) {
+			const auto &[id, entry] = *i;
+			cursor.after = id;
+			result.append(QJsonObject{
+				{ u"version"_q, 1 },
+				{ u"owner"_q, QString::number(_session->uniqueId()) },
+				{ u"peer"_q, QString::number(SerializePeerId(id.peer)) },
+				{ u"message"_q, QString::number(id.msg.bare) },
+				{ u"kind"_q, int(kind) }, { u"stamp"_q, int(entry.stamp) },
+				{ u"app"_q, entry.appVersion }, { u"own"_q, entry.own },
+				{ u"withChat"_q, entry.withChat },
+				{ u"blob"_q, QString::fromLatin1(entry.blob.toBase64()) },
+			});
+			if (result.size() == 16) return result;
+		}
+	}
+	return result;
+}
+
+bool Store::merge(const QJsonArray &records) {
+	if (!ensureLoaded() || records.size() > 64) return false;
+	auto pending = std::map<std::pair<EntryKind, FullMsgId>, Entry>();
+	for (const auto &value : records) {
+		const auto record = value.toObject();
+		auto peerOk = false; auto msgOk = false;
+		const auto peer = record.value(u"peer"_q).toString().toULongLong(&peerOk);
+		const auto msg = record.value(u"message"_q).toString().toLongLong(&msgOk);
+		const auto kind = record.value(u"kind"_q).toInt();
+		const auto blob = QByteArray::fromBase64(record.value(u"blob"_q).toString().toLatin1());
+		if (!peerOk || !msgOk || !peer || msg <= 0 || (kind != 1 && kind != 2)
+			|| record.value(u"version"_q).toInt() != 1
+			|| record.value(u"owner"_q).toString() != QString::number(_session->uniqueId())
+			|| record.value(u"app"_q).toInt() != AppVersion
+			|| blob.isEmpty() || blob.size() > 1024 * 1024) return false;
+		const auto id = FullMsgId(DeserializePeerId(peer), MsgId(msg));
+		const auto type = EntryKind(kind);
+		auto entry = Entry{
+			.stamp = TimeId(record.value(u"stamp"_q).toInt()), .blob = blob,
+			.own = record.value(u"own"_q).toBool(),
+			.withChat = record.value(u"withChat"_q).toBool(),
+		};
+		const auto key = std::make_pair(type, id);
+		const auto local = list(type).find(id);
+		const auto staged = pending.find(key);
+		const auto before = staged != pending.end() ? &staged->second
+			: local != list(type).end() ? &local->second : nullptr;
+		if (type == EntryKind::Edits) {
+			const auto merged = MergeHistoryEdits(before ? before->blob : QByteArray(), entry.blob);
+			if (!merged) return false;
+			entry.blob = *merged;
+		} else if (before) {
+			entry = *before;
+			entry.withChat |= record.value(u"withChat"_q).toBool();
+		}
+		if (before) entry.stamp = std::max(entry.stamp, before->stamp);
+		pending[key] = std::move(entry);
+	}
+	for (auto &[key, entry] : pending) {
+		const auto [kind, id] = key;
+		const auto existing = list(kind).find(id);
+		if (existing != list(kind).end() && existing->second.blob == entry.blob
+			&& existing->second.withChat == entry.withChat) continue;
+		put(kind, id, std::move(entry));
+		_restored.remove(id.peer);
+		if (kind == EntryKind::Edits) InvalidateSyncedEdits(_session, id);
+	}
+	if (!pending.empty()) {
+		changed();
+		flush();
+		for (const auto &[key, entry] : pending) {
+			if (key.first == EntryKind::Deleted) {
+				if (const auto history = _session->data().historyLoaded(key.second.peer)) {
+					RefreshSyncedDeleted(history);
+				}
+			}
+		}
+	}
+	auto durable = false;
+	_writer.with_sync([&](Writer &writer) { durable = writer.healthy(); });
+	return durable;
+}
+
 [[nodiscard]] Store *StoreFor(not_null<const HistoryItem*> item) {
 	return Store::Find(&item->history()->session());
 }
 
 } // namespace
 
+QJsonArray ExportKeptHistory(not_null<Main::Session*> session, KeptHistoryCursor &cursor) {
+	const auto store = Store::Find(session);
+	return store ? store->snapshot(cursor) : QJsonArray();
+}
+
+bool ImportKeptHistory(not_null<Main::Session*> session, const QJsonArray &records) {
+	const auto store = Store::Find(session);
+	return store && store->merge(records);
+}
+
 void SetupKeptStore(not_null<Main::Session*> session) {
 	session->lifetime().make_state<Store>(session);
+	SetupHistorySync(session);
 }
 
