diff --git a/Telegram/SourceFiles/tele/tele_history_records.cpp b/Telegram/SourceFiles/tele/tele_history_records.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ce3c37f7bd0c9e72e2930108025a2dc4ac9a0beb
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_history_records.cpp
@@ -0,0 +1,78 @@
+#include "tele/tele_history_records.h"
+#include <QtCore/QBuffer>
+#include <QtCore/QDataStream>
+#include <QtCore/QCryptographicHash>
+#include <map>
+#include <algorithm>
+#include <limits>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxVersions = quint32(10000);
+
+QDataStream &Prepared(QDataStream &stream) {
+	stream.setVersion(QDataStream::Qt_5_1);
+	return stream;
+}
+
+bool SkipText(QDataStream &stream, QString &text) {
+	auto count = quint32();
+	stream >> text >> count;
+	if (stream.status() != QDataStream::Ok || count > 100000) return false;
+	for (auto i = quint32(); i != count; ++i) {
+		auto type = qint32(); auto offset = qint32(); auto length = qint32(); auto data = QString();
+		stream >> type >> offset >> length >> data;
+		if (stream.status() != QDataStream::Ok || offset < 0 || length < 0
+			|| qint64(offset) + length > text.size()) return false;
+	}
+	return true;
+}
+
+}
+
+[[nodiscard]] std::optional<QByteArray> MergeHistoryEdits(
+		const QByteArray &left, const QByteArray &right) {
+	auto chunks = std::map<std::pair<qint32, QByteArray>, QByteArray>();
+	auto since = std::numeric_limits<qint32>::max();
+	auto original = quint8(0);
+	for (const auto &blob : { left, right }) {
+		if (blob.isEmpty()) continue;
+		auto buffer = QBuffer();
+		buffer.setData(blob);
+		buffer.open(QIODevice::ReadOnly);
+		auto stream = QDataStream(&buffer);
+		Prepared(stream);
+		auto stamp = qint32(); auto first = quint8(); auto count = quint32();
+		stream >> stamp >> first >> count;
+		if (count > kMaxVersions) return std::nullopt;
+		since = std::min(since, stamp);
+		original |= first;
+		for (auto i = quint32(); i != count; ++i) {
+			const auto start = buffer.pos();
+			auto date = qint32(); auto initial = quint8(); auto kind = quint8();
+			auto text = QString();
+			stream >> date >> initial;
+			if (!SkipText(stream, text)) return std::nullopt;
+			stream >> kind;
+			if (kind == 1 || kind == 2) {
+				auto media = QByteArray(); auto spoiler = quint8();
+				stream >> media >> spoiler;
+			} else if (kind != 0) return std::nullopt;
+			if (stream.status() != QDataStream::Ok) return std::nullopt;
+			const auto chunk = blob.mid(start, buffer.pos() - start);
+			chunks[{ date, QCryptographicHash::hash(chunk, QCryptographicHash::Sha256) }] = chunk;
+		}
+		if (!stream.atEnd() || stream.status() != QDataStream::Ok) return std::nullopt;
+	}
+	if (chunks.empty() || chunks.size() > kMaxVersions) return std::nullopt;
+	auto result = QByteArray();
+	auto stream = QDataStream(&result, QIODevice::WriteOnly);
+	Prepared(stream) << since << original << quint32(chunks.size());
+	for (auto i = chunks.rbegin(); i != chunks.rend(); ++i) {
+		stream.writeRawData(i->second.constData(), i->second.size());
+	}
+	return result.size() <= 1024 * 1024 ? std::optional(result) : std::nullopt;
+}
+
+}
