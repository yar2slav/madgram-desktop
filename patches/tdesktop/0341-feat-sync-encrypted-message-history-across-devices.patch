diff --git a/Telegram/SourceFiles/tele/tele_history_crypto.cpp b/Telegram/SourceFiles/tele/tele_history_crypto.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c511f6799a1a6f198b8e93205322d0a63320933d
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_history_crypto.cpp
@@ -0,0 +1,76 @@
+#include "tele/tele_history_crypto.h"
+
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+#include <memory>
+
+namespace Tele {
+namespace {
+
+constexpr auto kLimit = 2 * 1024 * 1024 - 29;
+using Cipher = std::unique_ptr<EVP_CIPHER_CTX, decltype(&EVP_CIPHER_CTX_free)>;
+
+}
+
+QByteArray NewHistoryKey() {
+	auto result = QByteArray(32, Qt::Uninitialized);
+	return RAND_bytes(reinterpret_cast<unsigned char*>(result.data()), result.size()) == 1
+		? result : QByteArray();
+}
+
+std::optional<QByteArray> SealHistory(
+		const QByteArray &key, const QByteArray &vault, const QByteArray &plain) {
+	if (key.size() != 32 || vault.size() != 32 || plain.size() > kLimit) {
+		return std::nullopt;
+	}
+	auto context = Cipher(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+	auto result = QByteArray(29 + plain.size(), Qt::Uninitialized);
+	auto out = reinterpret_cast<unsigned char*>(result.data());
+	const auto aad = "mad-history-v1:" + vault;
+	auto size = 0;
+	auto tail = 0;
+	out[0] = 1;
+	if (!context || RAND_bytes(out + 1, 12) != 1
+		|| EVP_EncryptInit_ex(context.get(), EVP_aes_256_gcm(), nullptr,
+			reinterpret_cast<const unsigned char*>(key.constData()), out + 1) != 1
+		|| EVP_EncryptUpdate(context.get(), nullptr, &size,
+			reinterpret_cast<const unsigned char*>(aad.constData()), aad.size()) != 1
+		|| EVP_EncryptUpdate(context.get(), out + 29, &size,
+			reinterpret_cast<const unsigned char*>(plain.constData()), plain.size()) != 1
+		|| EVP_EncryptFinal_ex(context.get(), out + 29 + size, &tail) != 1
+		|| EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_GCM_GET_TAG, 16, out + 13) != 1) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+std::optional<QByteArray> OpenHistory(
+		const QByteArray &key, const QByteArray &vault, const QByteArray &sealed) {
+	if (key.size() != 32 || vault.size() != 32 || sealed.size() < 29
+		|| sealed.size() > kLimit + 29 || sealed[0] != 1) {
+		return std::nullopt;
+	}
+	auto context = Cipher(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+	auto result = QByteArray(sealed.size() - 29 + 16, Qt::Uninitialized);
+	auto out = reinterpret_cast<unsigned char*>(result.data());
+	const auto in = reinterpret_cast<const unsigned char*>(sealed.constData());
+	const auto aad = "mad-history-v1:" + vault;
+	auto tag = sealed.mid(13, 16);
+	auto size = 0;
+	auto tail = 0;
+	if (!context
+		|| EVP_DecryptInit_ex(context.get(), EVP_aes_256_gcm(), nullptr,
+			reinterpret_cast<const unsigned char*>(key.constData()), in + 1) != 1
+		|| EVP_DecryptUpdate(context.get(), nullptr, &size,
+			reinterpret_cast<const unsigned char*>(aad.constData()), aad.size()) != 1
+		|| EVP_DecryptUpdate(context.get(), out, &size, in + 29, sealed.size() - 29) != 1
+		|| EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_GCM_SET_TAG, 16, tag.data()) != 1
+		|| EVP_DecryptFinal_ex(context.get(), out + size, &tail) != 1) {
+		result.fill(0);
+		return std::nullopt;
+	}
+	result.resize(size + tail);
+	return result;
+}
+
+}
