+[[nodiscard]] not_null<PeerData*> SamplePeer(
+		not_null<Main::Session*> session) {
+	for (const auto &row : *session->data().chatsList()->indexed()) {
+		const auto history = row->history();
+		const auto channel = history
+			? history->peer->asBroadcast()
+			: nullptr;
+		if (channel
+			&& channel->amIn()
+			&& channel->hasUsername()
+			&& channel->hasUserpic()) {
+			return channel;
+		}
+	}
+	return session->user();
+}
+
+void AddFormatToggle(
+		not_null<Ui::PopupMenu*> menu,
+		const char id[],
+		const style::icon *icon,
+		bool enabled) {
+	const auto option = &base::options::lookup<bool>(id);
+	auto item = base::make_unique_q<Ui::Menu::Toggle>(
+		menu->menu(),
+		menu->st().menu,
+		Lower(option->name()),
+		[=] { option->set(!option->value()); },
+		icon,
+		icon);
+	item->action()->setCheckable(true);
+	item->action()->setChecked(option->value());
+	item->action()->setEnabled(enabled);
+	FitMenuToggle(item.get());
+	menu->addAction(std::move(item));
+}
+
+[[nodiscard]] object_ptr<Ui::RpWidget> CreateHeader(
+		not_null<QWidget*> parent,
+		not_null<PeerData*> peer) {
+	const auto &st = st::infoPersonalChannelUserpic;
+	const auto &padding = st::infoProfileLabeledPadding;
+	auto result = object_ptr<Ui::RpWidget>(parent);
+	const auto raw = result.data();
+	const auto userpic = Ui::CreateChild<Ui::UserpicButton>(raw, peer, st);
+	userpic->setAttribute(Qt::WA_TransparentForMouseEvents);
+	const auto name = Ui::CreateChild<Ui::FlatLabel>(
+		raw,
+		Info::Profile::NameValue(peer),
+		st::settingsCoverName);
+	name->setAttribute(Qt::WA_TransparentForMouseEvents);
+	raw->resize(
+		raw->width(),
+		padding.top() + st.size.height() + padding.bottom());
+	rpl::combine(
+		raw->widthValue(),
+		name->heightValue()
+	) | rpl::on_next([=](int width, int) {
+		const auto left = padding.left() + st.size.width() + padding.left();
+		userpic->moveToLeft(padding.left(), padding.top(), width);
+		name->resizeToNaturalWidth(
+			std::max(width - left - padding.right(), 1));
+		name->moveToLeft(
+			left,
+			padding.top() + (st.size.height() - name->height()) / 2,
+			width);
+	}, raw->lifetime());
+	return result;
+}
