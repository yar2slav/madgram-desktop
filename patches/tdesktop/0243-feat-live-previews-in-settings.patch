+
+constexpr auto kDimmedOpacity = 0.4;
+constexpr auto kOverOpacity = 0.5;
+constexpr auto kStoryViews = 12;
+constexpr auto kMarkSize = 16;
+constexpr auto kMarkStroke = 2;
+constexpr auto kMarkShift = 2;
+
+enum class Row {
+	Online,
+	Typing,
+	Read,
+	Stories,
+};
+
+constexpr auto kRows = std::array{
+	Row::Online,
+	Row::Typing,
+	Row::Read,
+	Row::Stories,
+};
+
+[[nodiscard]] const char *RowOption(Row row) {
+	switch (row) {
+	case Row::Online: return kOptionGhostOnline;
+	case Row::Typing: return kOptionGhostTyping;
+	case Row::Read: return kOptionGhostRead;
+	case Row::Stories: return kOptionGhostStories;
+	}
+	Unexpected("Row in RowOption.");
+}
+
+[[nodiscard]] bool Hidden(Row row) {
+	switch (row) {
+	case Row::Online: return GhostOnline();
+	case Row::Typing: return GhostTyping();
+	case Row::Read: return GhostRead();
+	case Row::Stories: return GhostStories() || WatchStoriesInvisibly();
+	}
+	Unexpected("Row in Hidden.");
+}
+
+[[nodiscard]] bool Clickable(Row row) {
+	return (row != Row::Stories) || !WatchStoriesInvisibly();
+}
+
+[[nodiscard]] rpl::producer<> Changes() {
+	const auto changes = [](const char id[]) {
+		return base::options::lookup<bool>(id).changes();
+	};
+	return rpl::merge(
+		InvisibleStoriesChanges(),
+		GhostOnlineChanges(),
+		changes(kOptionGhostRead),
+		changes(kOptionGhostReadOnReply),
+		changes(kOptionGhostTyping),
+		changes(kOptionGhostSchedule));
+}
+
+[[nodiscard]] QString RevealsText() {
+	auto list = QStringList{
+		u"reactions"_q,
+		u"story replies"_q,
+		u"live stories"_q,
+	};
+	if (GhostRead() && GhostReadOnReply()) {
+		list.push_back(u"replying (it reads the chat)"_q);
+	}
+	if (GhostOnline() && !GhostSchedule()) {
+		list.push_back(u"sending (online for a moment)"_q);
+	}
+	return Lower(u"Click a row to switch it. Still reveals you: %1."_q.arg(
+		list.join(u", "_q)));
+}
+
+[[nodiscard]] AdminLog::OwnedItem GenerateItem(
+		not_null<HistoryView::ElementDelegate*> delegate,
+		not_null<History*> history,
+		bool out) {
+	const auto item = history->makeMessage({
+		.id = history->nextNonHistoryEntryId(),
+		.flags = (MessageFlag::FakeHistoryItem
+			| MessageFlag::HasFromId
+			| (out ? MessageFlag::Outgoing : MessageFlag(0))),
+		.from = (out ? history->session().userPeerId() : history->peer->id),
+		.date = base::unixtime::now(),
+	}, TextWithEntities{ Lower(u"See you tomorrow?"_q) },
+		MTP_messageMediaEmpty());
+	auto result = AdminLog::OwnedItem(delegate, item);
+	result->initDimensions();
+	return result;
+}
+
+class PreviewDelegate final : public HistoryView::SimpleElementDelegate {
+public:
+	using SimpleElementDelegate::SimpleElementDelegate;
+
+	HistoryView::Context elementContext() override {
+		return HistoryView::Context::ContactPreview;
+	}
+	bool elementShownUnread(
+			not_null<const HistoryView::Element*> view) override {
+		return GhostRead();
+	}
+
+};
+
+[[nodiscard]] QRect BubbleGeometry(not_null<HistoryView::Element*> view) {
+	auto result = view->innerGeometry();
+	result.setTop(
+		result.top() - st::msgPadding.top() - st::mediaInBubbleSkip);
+	const auto tail = st::historyBubbleTailInLeft.width();
+	return view->hasOutLayout()
+		? result.marginsAdded({ 0, 0, tail, 0 })
+		: result.marginsAdded({ tail, 0, 0, 0 });
+}
+
+class Preview final : public Ui::RpWidget {
+public:
+	Preview(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller);
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+
+private:
+	struct Message {
+		not_null<HistoryView::Element*> view;
+		QPoint position;
+	};
+
+	void paintContent(Painter &p);
+	void paintCaption(QPainter &p, QRect column, const QString &text);
+	void paintCard(QPainter &p, QRect card, const style::color &bg);
+	void paintLines(
+		QPainter &p,
+		QRect card,
+		int left,
+		const QString &title,
+		const QString &status,
+		const QString &shorter,
+		bool active);
+	void paintHeader(
+		QPainter &p,
+		QRect card,
+		const QString &status,
+		bool active,
+		bool marked);
+	void paintField(QPainter &p, QRect card);
+	void paintStory(QPainter &p, QRect card);
+	void paintViews(QPainter &p, QRect card, bool seen);
+	void paintMark(QPainter &p, QRect icon, const style::color &ring);
+	void paintMessage(
+		Painter &p,
+		const Message &message,
+		Ui::ChatPaintContext context);
+	void paintStatus(QPainter &p);
+	[[nodiscard]] int rowAt(QPoint position) const;
+	void setOver(int index);
+
+	const not_null<Window::SessionController*> _controller;
+	const not_null<UserData*> _self;
+	const std::unique_ptr<Ui::ChatStyle> _chatStyle;
+	const std::unique_ptr<PreviewDelegate> _delegate;
+	AdminLog::OwnedItem _incoming;
+	AdminLog::OwnedItem _outgoing;
+	Ui::EmptyUserpic _friend;
+	Ui::PeerUserpicView _userpic;
+	Ui::Animations::Simple _dim;
+	std::array<QRect, kRows.size()> _rows;
+	QRect _leftColumn;
+	QRect _rightColumn;
+	std::optional<Message> _left;
+	std::optional<Message> _right;
+	int _skip = 0;
+	int _padding = 0;
+	int _over = -1;
+	int _pressed = -1;
+
+};
+
+Preview::Preview(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: RpWidget(parent)
+, _controller(controller)
+, _self(controller->session().user())
+, _chatStyle(std::make_unique<Ui::ChatStyle>(
+	controller->session().colorIndicesValue()))
+, _delegate(std::make_unique<PreviewDelegate>(controller, [=] {
+	update();
+}))
+, _incoming(GenerateItem(
+	_delegate.get(),
+	controller->session().data().history(
+		PeerData::kServiceNotificationsId),
+	false))
+, _outgoing(GenerateItem(
+	_delegate.get(),
+	controller->session().data().history(
+		PeerData::kServiceNotificationsId),
+	true))
+, _friend(
+	Ui::EmptyUserpic::UserpicColor(Ui::EmptyUserpic::ColorIndex(0)),
+	Lower(u"Friend"_q))
+, _skip(2 * st::defaultVerticalListSkip)
+, _padding(st::msgServicePadding.left() * 2 / 3) {
+	_chatStyle->apply(controller->defaultChatTheme().get());
+	setMouseTracking(true);
+
+	const auto session = &controller->session();
+	session->data().viewRepaintRequest(
+	) | rpl::on_next([=](Data::RequestViewRepaint data) {
+		if (data.view == _incoming.get() || data.view == _outgoing.get()) {
+			update();
+		}
+	}, lifetime());
+
+	rpl::merge(
+		session->changes().peerUpdates(
+			_self,
+			(Data::PeerUpdate::Flag::Name | Data::PeerUpdate::Flag::Photo)
+		) | rpl::to_empty,
+		session->downloaderTaskFinished()
+	) | rpl::on_next([=] {
+		update();
+	}, lifetime());
+
+	rpl::merge(
+		Changes(),
+		controller->defaultChatTheme()->repaintBackgroundRequests()
+	) | rpl::on_next([=] {
+		update();
+	}, lifetime());
+
+	GhostValue() | rpl::on_next([=](bool ghost) {
+		if (!ghost) {
+			_pressed = -1;
+			setOver(-1);
+		}
+		if (!width()) {
+			return;
+		}
+		_dim.start(
+			[=] { update(); },
+			ghost ? kDimmedOpacity : 1.,
+			ghost ? 1. : kDimmedOpacity,
+			st::universalDuration);
+	}, lifetime());
+}
+
+int Preview::resizeGetHeight(int newWidth) {
+	const auto column = (newWidth - 3 * _skip) / 2;
+	if (column < st::msgMinWidth / 2) {
+		return height();
+	}
+	auto top = _skip;
+	const auto caption = st::msgServiceFont->height
+		+ st::msgServicePadding.top()
+		+ st::msgServicePadding.bottom();
+	_leftColumn = QRect(_skip, top, column, caption);
+	_rightColumn = QRect(2 * _skip + column, top, column, caption);
+	top += caption + _skip;
+	const auto card = st::msgPhotoSize + 2 * _padding;
+	const auto element = column
+		+ st::msgMargin.left()
+		+ st::msgMargin.right()
+		- st::historyBubbleTailInLeft.width();
+	for (auto i = 0; i != int(kRows.size()); ++i) {
+		auto height = card;
+		if (kRows[i] == Row::Read) {
+			_incoming->resizeGetHeight(element);
+			_outgoing->resizeGetHeight(element);
+			const auto incoming = BubbleGeometry(_incoming.get());
+			const auto outgoing = BubbleGeometry(_outgoing.get());
+			height = std::max(incoming.height(), outgoing.height());
+			_left = Message{
+				_incoming.get(),
+				QPoint(
+					_leftColumn.x() - incoming.x(),
+					top + height - incoming.y() - incoming.height()),
+			};
+			_right = Message{
+				_outgoing.get(),
+				QPoint(
+					_rightColumn.x()
+						+ column
+						- outgoing.x()
+						- outgoing.width(),
+					top + height - outgoing.y() - outgoing.height()),
+			};
+		}
+		_rows[i] = QRect(_skip, top, newWidth - 2 * _skip, height);
+		top += height + _skip;
+	}
+	return top;
+}
+
+void Preview::paintEvent(QPaintEvent *e) {
+	const auto ratio = style::DevicePixelRatio();
+	const auto theme = _controller->defaultChatTheme().get();
+	auto frame = QImage(
+		size() * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	frame.setDevicePixelRatio(ratio);
+	{
+		auto p = Painter(&frame);
+		Window::SectionWidget::PaintBackground(p, theme, size(), rect());
+		const auto opacity = _dim.value(Ghost() ? 1. : kDimmedOpacity);
+		if (opacity < 1.) {
+			auto content = QImage(
+				size() * ratio,
+				QImage::Format_ARGB32_Premultiplied);
+			content.setDevicePixelRatio(ratio);
+			content.fill(Qt::transparent);
+			{
+				auto q = Painter(&content);
+				paintContent(q);
+			}
+			p.setOpacity(opacity);
+			p.drawImage(0, 0, content);
+		} else {
+			paintContent(p);
+		}
+	}
+	QPainter(this).drawImage(
+		0,
+		0,
+		Images::Round(std::move(frame), ImageRoundRadius::Large));
+}
+
+void Preview::paintContent(Painter &p) {
+	if (!_left || !_right) {
+		return;
+	}
+	if (_over >= 0) {
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(_chatStyle->msgServiceBg());
+		p.setOpacity(kOverOpacity);
+		const auto radius = st::roundRadiusLarge;
+		const auto half = _skip / 2;
+		p.drawRoundedRect(
+			_rows[_over].marginsAdded({ half, half, half, half }),
+			radius,
+			radius);
+		p.setOpacity(1.);
+	}
+	paintCaption(p, _leftColumn, Lower(u"You"_q));
+	paintCaption(p, _rightColumn, Lower(u"What they see"_q));
+
+	const auto theme = _controller->defaultChatTheme().get();
+	const auto context = theme->preparePaintContext(
+		_chatStyle.get(),
+		rect(),
+		rect(),
+		rect(),
+		_controller->isGifPausedAtLeastFor(Window::GifPauseReason::Any));
+	const auto online = !Hidden(Row::Online);
+	const auto status = online
+		? tr::lng_status_online(tr::now)
+		: tr::lng_status_recently(tr::now);
+	for (auto i = 0; i != int(kRows.size()); ++i) {
+		const auto row = kRows[i];
+		const auto &geometry = _rows[i];
+		const auto left = QRect(
+			_leftColumn.x(),
+			geometry.y(),
+			_leftColumn.width(),
+			geometry.height());
+		const auto right = QRect(
+			_rightColumn.x(),
+			geometry.y(),
+			_rightColumn.width(),
+			geometry.height());
+		const auto hidden = Hidden(row);
+		switch (row) {
+		case Row::Online:
+			paintHeader(p, left, tr::lng_status_online(tr::now), true, false);
+			paintHeader(p, right, status, online, hidden);
+			break;
+		case Row::Typing:
+			paintField(p, left);
+			if (hidden) {
+				paintHeader(p, right, status, online, true);
+			} else {
+				paintHeader(
+					p,
+					right,
+					tr::lng_typing(tr::now) + QChar(0x2026),
+					true,
+					false);
+			}
+			break;
+		case Row::Read:
+			paintMessage(p, *_left, context);
+			paintMessage(p, *_right, context);
+			if (hidden) {
+				const auto bubble = BubbleGeometry(_outgoing.get()).translated(
+					_right->position);
+				const auto &icon = st::menuIconStealth;
+				const auto size = icon.width() + st::defaultVerticalListSkip;
+				const auto mark = QRect(
+					bubble.x() - _skip - size,
+					bubble.y() + (bubble.height() - size) / 2,
+					size,
+					size);
+				if (mark.x() >= right.x()) {
+					auto hq = PainterHighQualityEnabler(p);
+					p.setPen(Qt::NoPen);
+					p.setBrush(_chatStyle->msgServiceBg());
+					p.drawEllipse(mark);
+					icon.paint(
+						p,
+						mark.x() + (size - icon.width()) / 2,
+						mark.y() + (size - icon.height()) / 2,
+						width(),
+						_chatStyle->msgServiceFg()->c);
+				}
+			}
+			break;
+		case Row::Stories:
+			paintStory(p, left);
+			paintViews(p, right, !hidden);
+			break;
+		}
+	}
+}
+
+void Preview::paintCaption(QPainter &p, QRect column, const QString &text) {
+	const auto &font = st::msgServiceFont;
+	const auto &padding = st::msgServicePadding;
+	const auto available = column.width() - padding.left() - padding.right();
+	const auto elided = font->elided(text, available);
+	const auto width = font->width(elided) + padding.left() + padding.right();
+	const auto pill = QRect(
+		column.x() + (column.width() - width) / 2,
+		column.y(),
+		width,
+		column.height());
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(_chatStyle->msgServiceBg());
+	const auto radius = pill.height() / 2.;
+	p.drawRoundedRect(pill, radius, radius);
+	p.setPen(_chatStyle->msgServiceFg());
+	p.setFont(font);
+	p.drawText(
+		pill.x() + padding.left(),
+		pill.y() + padding.top() + font->ascent,
+		elided);
+}
+
+void Preview::paintCard(QPainter &p, QRect card, const style::color &bg) {
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(bg);
+	const auto radius = st::roundRadiusLarge;
+	p.drawRoundedRect(card, radius, radius);
+}
+
+void Preview::paintLines(
+		QPainter &p,
+		QRect card,
+		int left,
+		const QString &title,
+		const QString &status,
+		const QString &shorter,
+		bool active) {
+	const auto available = card.x() + card.width() - _padding - left;
+	if (available <= 0) {
+		return;
+	}
+	const auto &bold = st::semiboldFont;
+	const auto &normal = st::normalFont;
+	const auto line = (normal->width(status) <= available || shorter.isEmpty())
+		? status
+		: shorter;
+	const auto top = card.y()
+		+ (card.height() - bold->height - normal->height) / 2;
+	p.setFont(bold);
+	p.setPen(st::windowBoldFg);
+	p.drawText(left, top + bold->ascent, bold->elided(title, available));
+	p.setFont(normal);
+	p.setPen(active ? st::windowActiveTextFg : st::windowSubTextFg);
+	p.drawText(
+		left,
+		top + bold->height + normal->ascent,
+		normal->elided(line, available));
+}
+
+void Preview::paintHeader(
+		QPainter &p,
+		QRect card,
+		const QString &status,
+		bool active,
+		bool marked) {
+	paintCard(p, card, st::windowBg);
+	const auto size = st::msgPhotoSize;
+	const auto userpic = QRect(
+		card.x() + _padding,
+		card.y() + (card.height() - size) / 2,
+		size,
+		size);
+	_self->paintUserpic(p, _userpic, userpic.x(), userpic.y(), size);
+	if (marked) {
+		paintMark(p, userpic, st::windowBg);
+	}
+	paintLines(
+		p,
+		card,
+		card.x() + 2 * _padding + size,
+		_self->name(),
+		status,
+		marked ? Lower(u"Recently"_q) : QString(),
+		active);
+}
+
+void Preview::paintField(QPainter &p, QRect card) {
+	paintCard(p, card, st::historyComposeAreaBg);
+	const auto &font = st::normalFont;
+	const auto left = card.x() + 2 * _padding;
+	const auto available = card.width() - 4 * _padding - st::lineWidth;
+	auto text = QString();
+	for (const auto &word : Lower(u"On my way, be there in"_q).split(' ')) {
+		const auto longer = text.isEmpty() ? word : (text + ' ' + word);
+		if (font->width(longer) > available) {
+			break;
+		}
+		text = longer;
+	}
+	if (text.isEmpty()) {
+		return;
+	}
+	const auto top = card.y() + (card.height() - font->height) / 2;
+	p.setFont(font);
+	p.setPen(st::historyComposeAreaFg);
+	p.drawText(left, top + font->ascent, text);
+	p.fillRect(
+		left + font->width(text) + st::lineWidth,
+		top,
+		st::lineWidth,
+		font->height,
+		st::historyComposeAreaFg);
+}
+
+void Preview::paintStory(QPainter &p, QRect card) {
+	paintCard(p, card, st::windowBg);
+	const auto size = st::msgPhotoSize;
+	const auto outer = QRect(
+		card.x() + _padding,
+		card.y() + (card.height() - size) / 2,
+		size,
+		size);
+	const auto line = 2 * st::lineWidth;
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(QPen(st::windowActiveTextFg, line));
+		p.setBrush(Qt::NoBrush);
+		const auto half = line / 2.;
+		p.drawEllipse(QRectF(outer).marginsRemoved({ half, half, half, half }));
+	}
+	const auto inset = 2 * line;
+	_friend.paintCircle(
+		p,
+		outer.x() + inset,
+		outer.y() + inset,
+		width(),
+		size - 2 * inset);
+	paintLines(
+		p,
+		card,
+		card.x() + 2 * _padding + size,
+		Lower(u"Their story"_q),
+		Lower(u"You watch it"_q),
+		QString(),
+		false);
+}
+
+void Preview::paintViews(QPainter &p, QRect card, bool seen) {
+	paintCard(p, card, st::windowBg);
+	const auto size = st::msgPhotoSize;
+	const auto &icon = st::storiesViewsIcon;
+	const auto area = QRect(
+		card.x() + _padding,
+		card.y() + (card.height() - size) / 2,
+		size,
+		size);
+	icon.paint(
+		p,
+		area.x() + (size - icon.width()) / 2,
+		area.y() + (size - icon.height()) / 2,
+		width(),
+		st::windowSubTextFg->c);
+	if (!seen) {
+		paintMark(p, area, st::windowBg);
+	}
+	paintLines(
+		p,
+		card,
+		card.x() + 2 * _padding + size,
+		tr::lng_stories_views(
+			tr::now,
+			lt_count,
+			kStoryViews - (seen ? 0 : 1)),
+		Lower(seen ? u"Including you"_q : u"Without you"_q),
+		QString(),
+		seen);
+}
+
+void Preview::paintMark(QPainter &p, QRect icon, const style::color &ring) {
+	const auto badge = style::ConvertScale(kMarkSize);
+	const auto stroke = style::ConvertScale(kMarkStroke);
+	const auto shift = style::ConvertScale(kMarkShift);
+	const auto mark = QRect(
+		icon.x() + icon.width() - badge + shift,
+		icon.y() + icon.height() - badge + shift,
+		badge,
+		badge);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(ring);
+	p.drawEllipse(mark.marginsAdded({ stroke, stroke, stroke, stroke }));
+	p.setBrush(st::windowBgActive);
+	p.drawEllipse(mark);
+	const auto &stealth = st::menuIconStealth;
+	const auto inner = badge - 2 * stroke;
+	const auto percent = inner * 100 / stealth.width();
+	const auto image = stealth.instance(
+		st::windowFgActive->c,
+		style::Scale() * style::DevicePixelRatio() * percent / 100,
+		true);
+	p.drawImage(
+		QRect(
+			mark.x() + (badge - inner) / 2,
+			mark.y() + (badge - inner) / 2,
+			inner,
+			inner),
+		image);
+}
+
+void Preview::paintMessage(
+		Painter &p,
+		const Message &message,
+		Ui::ChatPaintContext context) {
+	context.outbg = message.view->hasOutLayout();
+	p.translate(message.position);
+	message.view->draw(p, context.translated(-message.position));
+	p.translate(-message.position);
+}
+
+int Preview::rowAt(QPoint position) const {
+	if (!Ghost()) {
+		return -1;
+	}
+	const auto half = _skip / 2;
+	for (auto i = 0; i != int(kRows.size()); ++i) {
+		const auto area = _rows[i].marginsAdded({ half, half, half, half });
+		if (area.contains(position)) {
+			return Clickable(kRows[i]) ? i : -1;
+		}
+	}
+	return -1;
+}
+
+void Preview::setOver(int index) {
+	if (_over == index) {
+		return;
+	}
+	_over = index;
+	setCursor((index >= 0) ? style::cur_pointer : style::cur_default);
+	update();
+}
+
+void Preview::mouseMoveEvent(QMouseEvent *e) {
+	setOver(rowAt(e->pos()));
+}
+
+void Preview::mousePressEvent(QMouseEvent *e) {
+	if (e->button() == Qt::LeftButton) {
+		_pressed = rowAt(e->pos());
+	}
+}
+
+void Preview::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = std::exchange(_pressed, -1);
+	if (e->button() != Qt::LeftButton
+		|| pressed < 0
+		|| pressed != rowAt(e->pos())) {
+		return;
+	}
+	auto &option = base::options::lookup<bool>(RowOption(kRows[pressed]));
+	option.set(!option.value());
+}
+
+void Preview::leaveEventHook(QEvent *e) {
+	setOver(-1);
+}
+
+} // namespace
+
+object_ptr<Ui::RpWidget> CreateGhostPreview(
+		not_null<QWidget*> parent,
+		not_null<Window::SessionController*> controller) {
+	auto result = object_ptr<Ui::VerticalLayout>(parent);
+	const auto raw = result.data();
+	const auto &padding = st::settingsButtonNoIcon.padding;
+	raw->add(
+		object_ptr<Preview>(raw, controller),
+		QMargins(
+			padding.left(),
+			st::defaultVerticalListSkip,
+			padding.left(),
+			st::defaultVerticalListSkip));
+	raw->add(
+		object_ptr<Ui::FlatLabel>(
+			raw,
+			rpl::single(rpl::empty) | rpl::then(
+				Changes()
+			) | rpl::map(RevealsText),
+			st::settingsExperimentalAbout),
+		st::settingsExperimentalAboutPadding);
+	return result;
+}
+
+} // namespace Tele
