+object_ptr<Ui::RpWidget> CreateInvisibleNamesPreview(
+		not_null<QWidget*> parent,
+		not_null<Main::Session*> session,
+		rpl::producer<QString> phrase) {
+	struct Row {
+		Ui::EmptyUserpic userpic;
+		QString username;
+		QString status;
+		Ui::Text::String name;
+	};
+	struct PreviewState {
+		std::vector<Row> rows;
+		QString phrase;
+	};
+	const auto &st = st::defaultDialogRow;
+	auto result = object_ptr<Ui::RpWidget>(parent.get());
+	const auto raw = result.data();
+	const auto state = raw->lifetime().make_state<PreviewState>();
+	const auto blank = QString(QChar(0x3164));
+	state->rows.reserve(2);
+	state->rows.push_back({
+		.userpic = Ui::EmptyUserpic(Ui::EmptyUserpic::UserpicColor(1), blank),
+		.username = u"username"_q,
+		.status = Lower(u"Blank name, has a username"_q),
+	});
+	state->rows.push_back({
+		.userpic = Ui::EmptyUserpic(Ui::EmptyUserpic::UserpicColor(4), blank),
+		.status = Lower(u"Blank name, no username"_q),
+	});
+	const auto refresh = [=] {
+		const auto &style = st::semiboldTextStyle;
+		for (auto &row : state->rows) {
+			if (!InvisibleNames()) {
+				row.name.setText(style, blank, Ui::NameTextOptions());
+				continue;
+			}
+			const auto shown = row.username.isEmpty()
+				? Fallback(session->user(), state->phrase)
+				: ('@' + row.username);
+			row.name.setMarkedText(
+				style,
+				MarkName(shown),
+				Ui::NameTextOptions(),
+				NameContext(style));
+		}
+		raw->update();
+	};
+	rpl::merge(
+		InvisibleNamesValue() | rpl::to_empty,
+		InvisibleNamesFallbackValue() | rpl::to_empty,
+		std::move(phrase) | rpl::map([=](const QString &value) {
+			state->phrase = NormalizeInvisibleNamesPhrase(value);
+			return rpl::empty;
+		}),
+		base::options::details::Lookup(kOptionBotApiPeerIds).changes(),
+		base::options::details::Lookup(
+			kOptionPeerIdsWithoutSpaces).changes()
+	) | rpl::on_next(refresh, raw->lifetime());
+	raw->resize(raw->width(), int(state->rows.size()) * st.height);
+	raw->paintRequest() | rpl::on_next([=] {
+		auto p = Painter(raw);
+		const auto width = raw->width();
+		const auto available = std::max(
+			width - st.nameLeft - st.padding.right(),
+			0);
+		auto top = 0;
+		for (const auto &row : state->rows) {
+			row.userpic.paintCircle(
+				p,
+				st.padding.left(),
+				top + st.padding.top(),
+				width,
+				st.photoSize);
+			p.setPen(st::dialogsNameFg);
+			row.name.draw(p, {
+				.position = QPoint(st.nameLeft, top + st.nameTop),
+				.outerWidth = width,
+				.availableWidth = available,
+				.elisionLines = 1,
+			});
+			p.setFont(st::dialogsTextFont);
+			p.setPen(st::dialogsTextFg);
+			p.drawTextLeft(
+				st.textLeft,
+				top + st.textTop,
+				width,
+				st::dialogsTextFont->elided(row.status, available));
+			top += st.height;
+		}
+	}, raw->lifetime());
+	return result;
+}
