+
+object_ptr<Ui::RpWidget> CreateProfilePreview(
+		not_null<QWidget*> parent,
+		not_null<Window::SessionController*> controller) {
+	const auto peer = SamplePeer(&controller->session());
+	auto result = object_ptr<Ui::VerticalLayout>(parent);
+	const auto raw = result.data();
+	raw->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(raw);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::boxDividerBg);
+		p.drawRoundedRect(
+			raw->rect(),
+			st::roundRadiusLarge,
+			st::roundRadiusLarge);
+	}, raw->lifetime());
+	raw->add(CreateHeader(raw, peer));
+	const auto add = [&](
+			rpl::producer<TextWithEntities> label,
+			rpl::producer<TextWithEntities> text) {
+		auto line = Info::Profile::CreateTextWithLabel(
+			raw,
+			std::move(label),
+			std::move(text),
+			st::infoLabel,
+			st::infoLabeledOneLine,
+			st::infoProfileLabeledPadding,
+			st::popupMenuWithIcons);
+		const auto result = line.text;
+		raw->add(std::move(line.wrap));
+		return result;
+	};
+	if (const auto user = peer->asUser()) {
+		add(
+			tr::lng_info_mobile_label(tr::marked),
+			ProfilePhoneValue(Info::Profile::PhoneWithSpoilerValue(
+				user,
+				Info::Profile::PhoneOrHiddenValue(user))));
+		add(
+			tr::lng_info_username_label(tr::marked),
+			Info::Profile::UsernameValue(user, true));
+	} else {
+		add(
+			tr::lng_info_link_label(tr::marked),
+			Info::Profile::LinkValue(
+				peer,
+				true
+			) | rpl::map([](const Info::Profile::LinkWithUrl &link) {
+				return tr::marked(link.text.startsWith(u"https://"_q)
+					? link.text.mid(u"https://"_q.size())
+					: link.text);
+			}));
+	}
+	const auto id = add(
+		rpl::single(tr::marked(Lower(u"ID"_q))),
+		PeerIdTextValue(peer));
+	SetupPeerIdLabel(id, peer, controller);
+	id->setContextMenuHook([=](Ui::FlatLabel::ContextMenuRequest request) {
+		if (!request.selection.empty()) {
+			id->fillContextMenu(request);
+			return;
+		}
+		AddFormatToggle(
+			request.menu,
+			kOptionPeerIdsWithoutSpaces,
+			&st::menuIconEdit,
+			true);
+		AddFormatToggle(
+			request.menu,
+			kOptionBotApiPeerIds,
+			&st::menuIconBot,
+			true);
+		AddFormatToggle(
+			request.menu,
+			kOptionMergeIdDc,
+			&st::menuIconIpAddress,
+			ShowDc());
+	});
+	SetupPeerDcLabel(
+		add(
+			rpl::single(tr::marked(Lower(u"DC"_q))),
+			PeerDcTextValue(peer)),
+		peer,
+		controller);
+	return result;
+}
