From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 3 Oct 2026 15:12:36 +0300
Subject: [PATCH] feat: send crash reports without a dump

---
 .../SourceFiles/core/crash_report_window.cpp  | 21 ++++++++++-----
 .../SourceFiles/core/crash_report_window.h    |  1 +
 Telegram/SourceFiles/tele/tele_crash.cpp      | 26 +++++++++++++++++++
 Telegram/SourceFiles/tele/tele_crash.h        |  5 ++++
 4 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/Telegram/SourceFiles/core/crash_report_window.cpp b/Telegram/SourceFiles/core/crash_report_window.cpp
index 0f9653630531c14d352487058bc067d1a08284d6..ebe2d97e66b4b5af88833f52281d3dc330a4e098 100644
--- a/Telegram/SourceFiles/core/crash_report_window.cpp
+++ b/Telegram/SourceFiles/core/crash_report_window.cpp
@@ -319,6 +319,13 @@ LastCrashedWindow::LastCrashedWindow(
 , _launch(std::move(launch)) {
 	excludeReportUsername();
 
+	const auto teleNoReport = [&](const QString &note) {
+		if (Tele::CollectCrashReports()) {
+			_teleNotes.push_back(note);
+		} else {
+			_sendingState = SendingNoReport;
+		}
+	};
 	if (!Tele::CollectCrashReports()
 		&& !cInstallBetaVersion()
 		&& !cAlphaVersion()) {
@@ -326,7 +333,7 @@ LastCrashedWindow::LastCrashedWindow(
 		_sendingState = SendingNoReport;
 	} else if (Core::OpenGLLastCheckFailed()) {
 		// Nothing we can do right now with graphics driver crashes in GL.
-		_sendingState = SendingNoReport;
+		teleNoReport(u"graphics driver crash"_q);
 	}
 	if (_sendingState != SendingNoReport) {
 		qint64 dumpsize = 0;
@@ -375,7 +382,7 @@ LastCrashedWindow::LastCrashedWindow(
 			}
 		}
 		if (_minidumpName.isEmpty()) { // currently don't accept crash reports without dumps from google libraries
-			_sendingState = SendingNoReport;
+			teleNoReport(u"no dump was written"_q);
 		} else {
 			_minidump.setText(u"+ %1 (%2 KB)"_q.arg(_minidumpName).arg(dumpsize / 1024));
 		}
@@ -384,7 +391,7 @@ LastCrashedWindow::LastCrashedWindow(
 		QString version = getReportField(qstr("version"), qstr("Version:"));
 		QString current = cAlphaVersion() ? u"-%1"_q.arg(cAlphaVersion()) : QString::number(AppVersion);
 		if (version != current) { // currently don't accept crash reports from not current app version
-			_sendingState = SendingNoReport;
+			teleNoReport(u"this happened in another version"_q);
 		}
 	}
 
@@ -397,7 +404,7 @@ LastCrashedWindow::LastCrashedWindow(
 	if (_sendingState == SendingNoReport) {
 		_label.setText(Tele::Lower(u"Last time tele was not closed properly."_q));
 	} else {
-		_label.setText(Tele::Lower(u"Last time tele crashed :("_q));
+		_label.setText(Tele::CrashTitle(_teleNotes));
 	}
 
 	if (_updaterData) {
@@ -473,7 +480,7 @@ LastCrashedWindow::LastCrashedWindow(
 	}
 
 	_pleaseSendReport.setText(u"Please send us a crash report."_q);
-	_yourReportName.setText(u"Crash ID: %1"_q.arg(QString(_minidumpName).replace(".dmp", "")));
+	_yourReportName.setText(Tele::CrashId(_minidumpName));
 	_yourReportName.setCursor(style::cur_text);
 	_yourReportName.setTextInteractionFlags(Qt::TextSelectableByMouse);
 
@@ -657,7 +664,9 @@ void LastCrashedWindow::checkingFinished() {
 	reportPart.setHeader(QNetworkRequest::ContentTypeHeader, QVariant("application/octet-stream"));
 	reportPart.setHeader(QNetworkRequest::ContentDispositionHeader, QVariant("form-data; name=\"report\"; filename=\"report.telegramcrash\""));
 	const auto dump = Tele::ZipCrashDump(_minidumpFull, minidumpFileName());
-	reportPart.setBody(Tele::WithDumpNote(getCrashReportRaw(), dump.note));
+	reportPart.setBody(Tele::WithDumpNote(
+		Tele::WithReportNotes(getCrashReportRaw(), _teleNotes),
+		dump.note));
 	multipart->append(reportPart);
 
 	if (dump.note.isEmpty()) {
diff --git a/Telegram/SourceFiles/core/crash_report_window.h b/Telegram/SourceFiles/core/crash_report_window.h
index 57501d76347f8cf6f62abd8a9c258b2adab14fd0..455197773c6e25a47566426ca5a486e9282b08df 100644
--- a/Telegram/SourceFiles/core/crash_report_window.h
+++ b/Telegram/SourceFiles/core/crash_report_window.h
@@ -138,6 +138,7 @@ private:
 
 	QString _minidumpName, _minidumpFull, _reportText;
 	QString _reportUsername, _reportTextNoUsername;
+	QStringList _teleNotes;
 	QByteArray getCrashReportRaw() const;
 
 	bool _reportShown, _reportSaved;
diff --git a/Telegram/SourceFiles/tele/tele_crash.cpp b/Telegram/SourceFiles/tele/tele_crash.cpp
index 305e055d01177f98268917ec9447f555bf839c76..10ed6205e57528a4abcb77c6d4a6140316393e1e 100644
--- a/Telegram/SourceFiles/tele/tele_crash.cpp
+++ b/Telegram/SourceFiles/tele/tele_crash.cpp
@@ -2,6 +2,7 @@
 
 #include "base/zlib_help.h"
 #include "tele/tele_launch_flags.h"
+#include "tele/tele_lowercase.h"
 #include "tele/tele_options.h"
 
 namespace Tele {
@@ -112,4 +113,29 @@ QByteArray WithDumpNote(QByteArray report, const QString &note) {
 	return report.append(note.toUtf8()).append('\n');
 }
 
+QByteArray WithReportNotes(QByteArray report, const QStringList &notes) {
+	auto header = QByteArray();
+	for (const auto &note : notes) {
+		header.append("Tele-Note: ").append(note.toUtf8()).append('\n');
+	}
+	return report.prepend(header);
+}
+
+QString CrashTitle(const QStringList &notes) {
+	const auto title = Lower(u"Last time tele crashed :("_q);
+	if (notes.isEmpty()) {
+		return title;
+	}
+	return u"<div>%1</div><div style=\"font-weight: normal; color: #808080;\">%2</div>"_q.arg(
+		title.toHtmlEscaped(),
+		Lower(notes.join(u", "_q)).toHtmlEscaped());
+}
+
+QString CrashId(const QString &minidumpName) {
+	return minidumpName.isEmpty()
+		? u"Crash ID: none"_q
+		: u"Crash ID: %1"_q.arg(
+			QString(minidumpName).replace(u".dmp"_q, QString()));
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_crash.h b/Telegram/SourceFiles/tele/tele_crash.h
index 6f04a623182a23f0899fcb1d4f3439eea9c20e71..39e72197b8c34bd033f1f87714421512700a6870 100644
--- a/Telegram/SourceFiles/tele/tele_crash.h
+++ b/Telegram/SourceFiles/tele/tele_crash.h
@@ -18,5 +18,10 @@ struct CrashDumpZip {
 [[nodiscard]] QByteArray WithDumpNote(
 	QByteArray report,
 	const QString &note);
+[[nodiscard]] QByteArray WithReportNotes(
+	QByteArray report,
+	const QStringList &notes);
+[[nodiscard]] QString CrashTitle(const QStringList &notes);
+[[nodiscard]] QString CrashId(const QString &minidumpName);
 
 } // namespace Tele
