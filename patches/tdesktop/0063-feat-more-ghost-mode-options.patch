@@ -48,6 +52,7 @@ constexpr auto kTestBit = BareId(1) << 63;
 constexpr auto kChannelShift = int64(1000000000000LL);
 constexpr auto kScheduleDelay = TimeId(12);
 constexpr auto kScheduleProxyDelay = TimeId(15);
+constexpr auto kOfflineAfterSendDelay = crl::time(200);
 
 using Key = BareId;
 
@@ -262,6 +267,70 @@ void MarkReadTill(not_null<HistoryItem*> item) {
 			caption);
 }
 
+using OfflineTimerMap = base::flat_map<
+	not_null<Main::Session*>,
+	std::unique_ptr<base::Timer>>;
+
+using ReadReaction = std::pair<PeerId, Data::ReactionId>;
+using ReadReactions = base::flat_map<
+	FullMsgId,
+	base::flat_set<ReadReaction>>;
+using ReadReactionsMap = base::flat_map<
+	not_null<Main::Session*>,
+	ReadReactions>;
+
+[[nodiscard]] ReadReactionsMap &LocalReadReactions() {
+	static auto result = ReadReactionsMap();
+	return result;
+}
+
+void RememberReadReactions(not_null<HistoryItem*> item) {
+	auto pairs = base::flat_set<ReadReaction>();
+	for (const auto &[id, list] : item->recentReactions()) {
+		for (const auto &reaction : list) {
+			if (!reaction.my) {
+				pairs.emplace(reaction.peer->id, id);
+			}
+		}
+	}
+	if (pairs.empty()) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	auto &map = LocalReadReactions();
+	auto i = map.find(session);
+	if (i == end(map)) {
+		i = map.emplace(session, ReadReactions()).first;
+		session->lifetime().add([=] {
+			LocalReadReactions().remove(session);
+		});
+	}
+	auto &already = i->second[item->fullId()];
+	for (const auto &pair : pairs) {
+		already.emplace(pair);
+	}
+}
+
+[[nodiscard]] OfflineTimerMap &OfflineTimers() {
+	static auto result = OfflineTimerMap();
+	return result;
+}
+
+void SendOffline(not_null<Main::Session*> session) {
+	if (!HideOnline()) {
+		return;
+	}
+	session->api().request(MTPaccount_UpdateStatus(
+		MTP_bool(true)
+	)).send();
+	const auto self = session->user();
+	self->updateLastseen(Data::LastseenStatus::OnlineTill(
+		base::unixtime::now() - 1));
+	session->changes().peerUpdated(
+		self,
+		Data::PeerUpdate::Flag::OnlineStatus);
+}
+
 } // namespace
 
 bool HideRead(not_null<PeerData*> peer) {
@@ -287,6 +356,53 @@ bool SkipReadInbox(not_null<History*> history, MsgId tillId) {
 	return true;
 }
 
+bool HideContentsRead(not_null<HistoryItem*> item) {
+	if (!HideRead(item->history()->peer)) {
+		return false;
+	}
+	RememberReadReactions(item);
+	return true;
+}
+
+void ApplyLocalReactionsRead(
+		not_null<HistoryItem*> item,
+		base::flat_map<
+			Data::ReactionId,
+			std::vector<Data::RecentReaction>> &recent,
+		bool min) {
+	auto &map = LocalReadReactions();
+	const auto i = map.find(&item->history()->session());
+	if (i == end(map)) {
+		return;
+	}
+	auto &items = i->second;
+	const auto j = items.find(item->fullId());
+	if (j == end(items)) {
+		return;
+	}
+	const auto hide = HideRead(item->history()->peer);
+	auto kept = base::flat_set<ReadReaction>();
+	for (auto &[id, list] : recent) {
+		for (auto &reaction : list) {
+			const auto key = ReadReaction(reaction.peer->id, id);
+			if (!reaction.unread || !j->second.contains(key)) {
+				continue;
+			}
+			kept.emplace(key);
+			if (hide) {
+				reaction.unread = false;
+			}
+		}
+	}
+	if (min) {
+		return;
+	} else if (kept.empty()) {
+		items.erase(j);
+	} else {
+		j->second = std::move(kept);
+	}
+}
+
 void ReadOnSend(const Api::SendAction &action) {
 	const auto history = action.history;
 	const auto peer = history->peer;
@@ -318,6 +434,24 @@ void ReadOnSend(const Api::SendAction &action) {
 	}
 }
 
+void OfflineAfterSend(not_null<Main::Session*> session) {
+	if (!HideOnline()) {
+		return;
+	}
+	auto &timers = OfflineTimers();
+	auto i = timers.find(session);
+	if (i == end(timers)) {
+		i = timers.emplace(
+			session,
+			std::make_unique<base::Timer>([=] { SendOffline(session); })
+		).first;
+		session->lifetime().add([=] {
+			OfflineTimers().remove(session);
+		});
+	}
+	i->second->callOnce(kOfflineAfterSendDelay);
+}
+
 void ApplyGhostSchedule(Api::SendAction &action, const QString &caption) {
 	if (CanGhostSchedule(action, caption)) {
 		action.options.scheduled = base::unixtime::now() + ScheduleDelay();
@@ -378,6 +512,9 @@ void AddMarkReadAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
 }
 
