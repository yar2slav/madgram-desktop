+void ShowOnlineNotifyBox(not_null<Window::SessionController*> window) {
+	const auto session = &window->session();
+	auto selected = std::vector<not_null<PeerData*>>();
+	for (const auto &id : ::Tele::OnlineWatched(session)) {
+		selected.push_back(session->data().user(id));
+	}
+	ShowPickPeersBox(
+		window,
+		::Tele::Lower(u"Online notifications"_q),
+		std::move(selected),
+		[](not_null<PeerData*> peer) {
+			const auto user = peer->asUser();
+			return user && !user->isBot() && !user->isServiceUser();
+		},
+		[=](std::vector<not_null<PeerData*>> peers) {
+			::Tele::SetOnlineWatched(session, peers);
+		});
+}
+
+void AddOnlineNotify(SectionBuilder &builder) {
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionOnlineNotify,
+		{ u"presence"_q, u"status"_q, u"watch"_q });
+	const auto controller = builder.controller();
+	const auto id = u"tele-online-notify-people"_q;
+	const auto name = ::Tele::Lower(u"Online notifications"_q);
+	WithParent(builder, id, name, ::Tele::kOptionOnlineNotify, [&] {
+		const auto button = AddButton(builder, {
+			.id = id,
+			.title = rpl::single(name),
+			.st = &st::settingsButtonNoIcon,
+			.label = ::Tele::OnlineWatchedCountValue(
+				builder.session()
+			) | rpl::map([](int count) {
+				return count ? QString::number(count) : u"none"_q;
+			}),
+			.onClick = [=] {
+				ShowOnlineNotifyBox(controller);
+			},
+			.keywords = { u"presence"_q, u"status"_q, u"watch"_q },
+		});
+		if (button) {
+			SetupLink(button, id);
+		}
+	});
+}
