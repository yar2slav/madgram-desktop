diff --git a/Telegram/SourceFiles/tele/tele_online_notify.cpp b/Telegram/SourceFiles/tele/tele_online_notify.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d02ac4b8306b0bdbd84653aa7758a40112829203
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_online_notify.cpp
@@ -0,0 +1,367 @@
+#include "tele/tele_online_notify.h"
+
+#include "base/unixtime.h"
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "data/data_changes.h"
+#include "data/data_peer_values.h"
+#include "data/data_session.h"
+#include "data/data_thread.h"
+#include "data/data_user.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/userpic_view.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/menu/menu_toggle.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/notifications_manager.h"
+#include "window/notifications_manager_default.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+using Window::Notifications::ManagerType;
+using Window::Notifications::NativeManager;
+using DefaultManager = Window::Notifications::Default::Manager;
+
+constexpr auto kMagic = quint32(0x7E1E0271);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxUsers = 65536;
+constexpr auto kCooldown = 10 * 60 * crl::time(1000);
+constexpr auto kNotificationId = MsgId(SpecialMsgIdShift + 1024);
+
+struct Presence {
+	TimeId till = 0;
+	crl::time notified = 0;
+};
+
+[[nodiscard]] rpl::event_stream<> &Changes() {
+	static auto result = rpl::event_stream<>();
+	return result;
+}
+
+[[nodiscard]] UserData *Watchable(PeerData *peer) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	return (user
+		&& !user->isSelf()
+		&& !user->isBot()
+		&& !user->isServiceUser()
+		&& !user->isInaccessible())
+		? user
+		: nullptr;
+}
+
+bool ShowOnline(not_null<UserData*> user) {
+	if (Core::Quitting()) {
+		return false;
+	}
+	const auto session = &user->session();
+	const auto &settings = Core::App().settings();
+	if (!settings.desktopNotify()
+		|| (!settings.notifyFromAll()
+			&& &session->account() != &Core::App().domain().active())) {
+		return false;
+	}
+	auto &manager = Core::App().notifications().manager();
+	if (manager.skipToast()) {
+		return false;
+	}
+	const auto options = manager.getNotificationOptions(
+		nullptr,
+		Data::ItemNotificationType::Message);
+	if (options.hideNameAndPhoto) {
+		return false;
+	}
+	const auto text = Lower(u"Came online"_q);
+	if (manager.type() == ManagerType::Default) {
+		static_cast<DefaultManager&>(manager).showCustomNotification(
+			session->data().history(user),
+			text);
+		return true;
+	}
+	const auto native = (manager.type() == ManagerType::Native)
+		? dynamic_cast<NativeManager*>(&manager)
+		: nullptr;
+	if (!native) {
+		return false;
+	}
+	user->loadUserpic();
+	auto userpicView = user->createUserpicView();
+	native->showCustomNotification({
+		.peer = user,
+		.itemId = kNotificationId,
+		.title = native->addTargetAccountName(user->name(), session),
+		.message = text,
+		.options = options,
+	}, userpicView);
+	return true;
+}
+
+class State final {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] bool watched(UserId id) const;
+	[[nodiscard]] std::vector<UserId> list() const;
+	void set(base::flat_set<UserId> ids);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+	void rememberMissing();
+	void updated(not_null<UserData*> user);
+
+	const not_null<Main::Session*> _session;
+	base::flat_set<UserId> _watched;
+	base::flat_map<UserId, Presence> _presence;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+	rememberMissing();
+	session->changes().peerUpdates(
+		Data::PeerUpdate::Flag::OnlineStatus
+	) | rpl::on_next([=](const Data::PeerUpdate &update) {
+		if (const auto user = update.peer->asUser()) {
+			updated(user);
+		}
+	}, _lifetime);
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State *State::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+bool State::watched(UserId id) const {
+	return _watched.contains(id);
+}
+
+std::vector<UserId> State::list() const {
+	return { begin(_watched), end(_watched) };
+}
+
+void State::set(base::flat_set<UserId> ids) {
+	if (ids == _watched) {
+		return;
+	}
+	_watched = std::move(ids);
+	for (auto i = begin(_presence); i != end(_presence);) {
+		if (_watched.contains(i->first)) {
+			++i;
+		} else {
+			i = _presence.erase(i);
+		}
+	}
+	rememberMissing();
+	write();
+	Changes().fire({});
+}
+
+void State::rememberMissing() {
+	if (_presence.size() >= _watched.size()) {
+		return;
+	}
+	for (const auto id : _watched) {
+		if (_presence.contains(id)) {
+			continue;
+		} else if (const auto user = _session->data().userLoaded(id)) {
+			_presence.emplace(id, Presence{
+				.till = user->lastseen().onlineTill(),
+			});
+		}
+	}
+}
+
+void State::updated(not_null<UserData*> user) {
+	const auto i = _presence.find(peerToUser(user->id));
+	if (i == end(_presence)) {
+		rememberMissing();
+		return;
+	}
+	const auto till = user->lastseen().onlineTill();
+	const auto now = base::unixtime::now();
+	const auto was = (i->second.till > now);
+	i->second.till = till;
+	if (was || !OnlineNotify() || !Data::IsUserOnline(user, now)) {
+		return;
+	}
+	const auto ms = crl::now();
+	if (i->second.notified && ms - i->second.notified < kCooldown) {
+		return;
+	} else if (ShowOnline(user)) {
+		i->second.notified = ms;
+	}
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_online"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxUsers) {
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = quint64();
+		file.stream >> id;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (id) {
+			_watched.emplace(UserId(id));
+		}
+	}
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	const auto size = sizeof(quint32) * 3
+		+ sizeof(quint64)
+		+ _watched.size() * sizeof(quint64);
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_watched.size());
+	for (const auto id : _watched) {
+		data.stream << quint64(id.bare);
+	}
+	auto file = FileWriteDescriptor(u"tele_online"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+void SetWatched(not_null<UserData*> user, bool watched) {
+	const auto state = State::Find(&user->session());
+	if (!state) {
+		return;
+	}
+	const auto id = peerToUser(user->id);
+	auto ids = base::flat_set<UserId>();
+	for (const auto existing : state->list()) {
+		ids.emplace(existing);
+	}
+	if (watched) {
+		ids.emplace(id);
+	} else {
+		ids.remove(id);
+	}
+	state->set(std::move(ids));
+}
+
+} // namespace
+
+void SetupOnlineNotify(not_null<Main::Session*> session) {
+	session->lifetime().make_state<State>(session);
+}
+
+void AddOnlineNotifyAction(
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = Watchable(peer);
+	if (!user || !OnlineNotify()) {
+		return;
+	}
+	const auto state = State::Find(&user->session());
+	if (!state) {
+		return;
+	}
+	const auto watched = state->watched(peerToUser(user->id));
+	addAction({ .make = [=](not_null<Ui::PopupMenu*> menu) {
+		auto result = base::make_unique_q<Ui::Menu::Toggle>(
+			menu->menu(),
+			menu->st().menu,
+			Lower(u"Notify when online"_q),
+			[=] { SetWatched(user, !watched); },
+			&st::menuIconNotifications,
+			&st::menuIconNotifications);
+		result->action()->setCheckable(true);
+		result->action()->setChecked(watched);
+		return base::unique_qptr<Ui::Menu::ItemBase>(std::move(result));
+	} });
+}
+
+std::vector<UserId> OnlineWatched(not_null<Main::Session*> session) {
+	const auto state = State::Find(session);
+	return state ? state->list() : std::vector<UserId>();
+}
+
+void SetOnlineWatched(
+		not_null<Main::Session*> session,
+		const std::vector<not_null<PeerData*>> &peers) {
+	const auto state = State::Find(session);
+	if (!state) {
+		return;
+	}
+	auto ids = base::flat_set<UserId>();
+	for (const auto &peer : peers) {
+		if (const auto user = Watchable(peer)) {
+			ids.emplace(peerToUser(user->id));
+		}
+	}
+	state->set(std::move(ids));
+}
+
+rpl::producer<int> OnlineWatchedCountValue(
+		not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		Changes().events()
+	) | rpl::map([=] {
+		return int(OnlineWatched(session).size());
+	});
+}
+
+} // namespace Tele
