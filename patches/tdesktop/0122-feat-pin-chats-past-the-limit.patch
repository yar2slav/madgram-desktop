+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E9105);
+constexpr auto kVersion = qint32(2);
+constexpr auto kLocalBase = 0x10000;
+constexpr auto kUnmappedBase = 0x8000;
+constexpr auto kMaxLists = 1024;
+constexpr auto kMaxItems = 4096;
+
+enum class ListKind : uchar {
+	Chats,
+	Filter,
+	Saved,
+	Topics,
+};
+
+struct ListId {
+	ListKind kind = ListKind::Chats;
+	uint64 id = 0;
+
+	friend inline auto operator<=>(const ListId &, const ListId &) = default;
+	friend inline bool operator==(const ListId &, const ListId &) = default;
+};
+
+struct Item {
+	uint64 id = 0;
+	uint64 hash = 0;
+	bool local = false;
+};
+
+using Shown = std::pair<const Dialogs::Entry*, FilterId>;
+
+bool PaintingLocal = false;
+
+[[nodiscard]] FilterId FilterOf(ListId list) {
+	return (list.kind == ListKind::Filter) ? FilterId(list.id) : FilterId();
+}
+
+[[nodiscard]] bool FilterExists(
+		not_null<Data::Session*> owner,
+		FilterId filterId) {
+	return ranges::contains(
+		owner->chatsFilters().list(),
+		filterId,
+		&Data::ChatFilter::id);
+}
+
+[[nodiscard]] bool ServerPinned(
+		not_null<Dialogs::Entry*> entry,
+		FilterId filterId) {
+	const auto owner = &entry->owner();
+	if (filterId && !FilterExists(owner, filterId)) {
+		return false;
+	}
+	const auto list = filterId
+		? owner->chatsFilters().chatsList(filterId)
+		: owner->chatsListFor(entry);
+	return ranges::contains(list->pinned()->order(), Dialogs::Key(entry));
+}
+
+[[nodiscard]] std::optional<ListId> ListFor(
+		not_null<Dialogs::Entry*> entry,
+		FilterId filterId) {
+	if (filterId) {
+		if (!entry->asHistory()) {
+			return std::nullopt;
+		}
+		return ListId{ ListKind::Filter, uint64(uint32(filterId)) };
+	} else if (const auto topic = entry->asTopic()) {
+		return ListId{ ListKind::Topics, topic->peer()->id.value };
+	} else if (const auto sublist = entry->asSublist()) {
+		if (sublist->parentChat()) {
+			return std::nullopt;
+		}
+		return ListId{ ListKind::Saved };
+	} else if (const auto history = entry->asHistory()) {
+		if (!history->folderKnown()) {
+			return std::nullopt;
+		}
+		const auto folder = history->folder();
+		const auto owner = &history->owner();
+		if (owner->chatsListFor(history) != owner->chatsList(folder)) {
+			return std::nullopt;
+		}
+		return ListId{
+			ListKind::Chats,
+			folder ? uint64(folder->id()) : uint64(),
+		};
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] Item ItemFor(not_null<Dialogs::Entry*> entry) {
+	if (const auto topic = entry->asTopic()) {
+		return { uint64(topic->rootId().bare) };
+	}
+	const auto sublist = entry->asSublist();
+	const auto peer = sublist
+		? sublist->sublistPeer()
+		: entry->asHistory()->peer;
+	const auto user = peer->asUser();
+	const auto channel = peer->asChannel();
+	return {
+		peer->id.value,
+		user ? user->accessHash() : channel ? channel->accessHash() : 0,
+	};
+}
+
+[[nodiscard]] std::optional<Item> ItemForKey(ListId list, Dialogs::Key key) {
+	const auto entry = key.entry();
+	const auto fits = (list.kind == ListKind::Topics)
+		? (entry->asTopic() != nullptr)
+		: (list.kind == ListKind::Saved)
+		? (entry->asSublist() != nullptr)
+		: (entry->asHistory() != nullptr);
+	return fits ? ItemFor(entry) : std::optional<Item>();
+}
+
+[[nodiscard]] auto FindItem(std::vector<Item> &items, uint64 id) {
+	return ranges::find(items, id, &Item::id);
+}
+
+struct Placed {
+	ListId list;
+	Item item;
+	not_null<Dialogs::Entry*> entry;
+	int position = 0;
+	bool local = false;
+};
+
+class State final : public base::has_weak_ptr {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] bool toggle(
+		not_null<Window::SessionController*> controller,
+		not_null<Dialogs::Entry*> entry,
+		FilterId filterId,
+		Fn<void()> onToggled);
+	void fallback(not_null<Dialogs::Entry*> entry);
+	[[nodiscard]] bool reorder(
+		FilterId filterId,
+		not_null<Dialogs::Entry*> entry1,
+		not_null<Dialogs::Entry*> entry2);
+	[[nodiscard]] bool reorderTopics(
+		not_null<Data::Forum*> forum,
+		const QVector<MTPint> &ids);
+	[[nodiscard]] bool takeDragLocal();
+	[[nodiscard]] bool shown(
+		not_null<const Dialogs::Entry*> entry,
+		FilterId filterId) const;
+	[[nodiscard]] int sortIndex(
+		not_null<const Dialogs::Entry*> entry,
+		FilterId filterId,
+		int index) const;
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+	void scheduleRefresh();
+	void refresh();
+	void add(ListId list, Item item);
+	void load(ListId list, Item item);
+	[[nodiscard]] Dialogs::Entry *resolve(
+		ListId list,
+		Item item,
+		bool strict) const;
+	[[nodiscard]] PeerData *placeholder(PeerId id, uint64 hash) const;
+	[[nodiscard]] const std::vector<Dialogs::Key> *serverOrder(
+		ListId list) const;
+	[[nodiscard]] std::vector<Item> serverItems(ListId list) const;
+	[[nodiscard]] bool settled(ListId list, const Item &item) const;
+	[[nodiscard]] bool merge(ListId list, std::vector<Item> &items) const;
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<ListId, std::vector<Item>> _lists;
+	std::vector<std::pair<ListId, Item>> _applied;
+	std::vector<std::pair<ListId, Item>> _placed;
+	base::flat_set<Shown> _shown;
+	base::flat_map<Shown, int> _positions;
+	base::flat_set<std::pair<ListId, uint64>> _requested;
+	bool _refreshing = false;
+	bool _scheduled = false;
+	bool _cleared = false;
+	bool _dragLocal = false;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+
+	const auto owner = &session->data();
+	rpl::merge(
+		LocalPinsChanges(),
+		owner->pinnedDialogsOrderUpdated(),
+		owner->chatsListChanges() | rpl::to_empty,
+		owner->chatsFilters().changed(),
+		owner->savedMessages().chatsListChanges(),
+		owner->savedMessages().sublistDestroyed() | rpl::to_empty,
+		session->changes().historyUpdates(
+			Data::HistoryUpdate::Flag::Folder
+		) | rpl::to_empty
+	) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, _lifetime);
+
+	owner->sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		_cleared = true;
+	}, _lifetime);
+
+	scheduleRefresh();
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State *State::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_pins"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version < 1
+		|| version > kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxLists) {
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto kind = quint8();
+		auto id = quint64();
+		auto size = quint32();
+		file.stream >> kind >> id >> size;
+		if (file.stream.status() != QDataStream::Ok
+			|| kind > quint8(ListKind::Topics)
+			|| size > kMaxItems) {
+			return;
+		}
+		auto items = std::vector<Item>();
+		items.reserve(size);
+		for (auto j = quint32(); j != size; ++j) {
+			auto item = Item{ .local = true };
+			file.stream >> item.id >> item.hash;
+			if (version > 1) {
+				auto local = quint8();
+				file.stream >> local;
+				item.local = (local != 0);
+			}
+			if (file.stream.status() != QDataStream::Ok) {
+				return;
+			} else if (item.id && FindItem(items, item.id) == end(items)) {
+				items.push_back(item);
+			}
+		}
+		if (ranges::any_of(items, &Item::local)) {
+			_lists.emplace(ListId{ ListKind(kind), id }, std::move(items));
+		}
+	}
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &[list, items] : _lists) {
+		size += sizeof(quint8) + sizeof(quint64) + sizeof(quint32);
+		size += items.size() * (sizeof(quint64) * 2 + sizeof(quint8));
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_lists.size());
+	for (const auto &[list, items] : _lists) {
+		data.stream
+			<< quint8(list.kind)
+			<< quint64(list.id)
+			<< quint32(items.size());
+		for (const auto &item : items) {
+			data.stream
+				<< quint64(item.id)
+				<< quint64(item.hash)
+				<< quint8(item.local ? 1 : 0);
+		}
+	}
+	auto file = FileWriteDescriptor(u"tele_pins"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+PeerData *State::placeholder(PeerId id, uint64 hash) const {
+	const auto owner = &_session->data();
+	if (const auto loaded = owner->peerLoaded(id)) {
+		return loaded;
+	} else if (peerIsChat(id)) {
+		return owner->peer(id);
+	} else if (!hash) {
+		return nullptr;
+	} else if (peerIsUser(id)) {
+		const auto user = owner->user(peerToUser(id));
+		if (!user->accessHash()) {
+			user->setAccessHash(hash);
+		}
+		return user;
+	} else if (peerIsChannel(id)) {
+		const auto channel = owner->channel(peerToChannel(id));
+		if (!channel->accessHash()) {
+			channel->setAccessHash(hash);
+		}
+		return channel;
+	}
+	return nullptr;
+}
+
+Dialogs::Entry *State::resolve(ListId list, Item item, bool strict) const {
+	const auto owner = &_session->data();
+	switch (list.kind) {
+	case ListKind::Chats:
+	case ListKind::Filter: {
+		const auto history = owner->historyLoaded(PeerId(item.id));
+		if (!history || !strict) {
+			return history;
+		} else if (list.kind == ListKind::Filter) {
+			return (history->folderKnown()
+				&& FilterExists(owner, FilterOf(list)))
+				? history
+				: nullptr;
+		}
+		return (ListFor(history, FilterId()) == list) ? history : nullptr;
+	}
+	case ListKind::Saved: {
+		const auto peer = owner->peerLoaded(PeerId(item.id));
+		return peer ? owner->savedMessages().sublistLoaded(peer) : nullptr;
+	}
+	case ListKind::Topics: {
+		const auto peer = owner->peerLoaded(PeerId(list.id));
+		const auto forum = peer ? peer->forum() : nullptr;
+		return forum ? forum->topicFor(MsgId(int64(item.id))) : nullptr;
+	}
+	}
+	return nullptr;
+}
+
+const std::vector<Dialogs::Key> *State::serverOrder(ListId list) const {
+	const auto owner = &_session->data();
+	switch (list.kind) {
+	case ListKind::Chats: {
+		if (!list.id) {
+			return &owner->chatsList(nullptr)->pinned()->order();
+		}
+		const auto folder = owner->folderLoaded(FolderId(list.id));
+		return folder ? &folder->chatsList()->pinned()->order() : nullptr;
+	}
+	case ListKind::Filter: {
+		const auto filterId = FilterOf(list);
+		return FilterExists(owner, filterId)
+			? &owner->chatsFilters().chatsList(filterId)->pinned()->order()
+			: nullptr;
+	}
+	case ListKind::Saved:
+		return &owner->savedMessages().chatsList()->pinned()->order();
+	case ListKind::Topics: {
+		const auto peer = owner->peerLoaded(PeerId(list.id));
+		const auto forum = peer ? peer->forum() : nullptr;
+		return forum ? &forum->topicsList()->pinned()->order() : nullptr;
+	}
+	}
+	return nullptr;
+}
+
+std::vector<Item> State::serverItems(ListId list) const {
+	auto result = std::vector<Item>();
+	if (const auto order = serverOrder(list)) {
+		result.reserve(order->size());
+		for (const auto &key : *order) {
+			if (const auto item = ItemForKey(list, key)) {
+				result.push_back(*item);
+			}
+		}
+	}
+	return result;
+}
+
+bool State::settled(ListId list, const Item &item) const {
+	const auto owner = &_session->data();
+	switch (list.kind) {
+	case ListKind::Chats: {
+		const auto history = owner->historyLoaded(PeerId(item.id));
+		return history && history->folderKnown();
+	}
+	case ListKind::Filter:
+		return owner->historyLoaded(PeerId(item.id)) != nullptr;
+	case ListKind::Saved:
+		return owner->savedMessages().chatsList()->loaded()
+			&& resolve(list, item, false);
+	case ListKind::Topics:
+		return resolve(list, item, false) != nullptr;
+	}
+	return false;
+}
+
+bool State::merge(ListId list, std::vector<Item> &items) const {
+	if (!serverOrder(list)) {
+		return false;
+	}
+	const auto server = serverItems(list);
+	const auto removed = ranges::remove_if(items, [&](const Item &item) {
+		return !item.local
+			&& !ranges::contains(server, item.id, &Item::id)
+			&& settled(list, item);
+	});
+	auto changed = (removed != end(items));
+	items.erase(removed, end(items));
+	for (auto k = 0; k != int(server.size()); ++k) {
+		if (FindItem(items, server[k].id) != end(items)) {
+			continue;
+		}
+		auto position = begin(items);
+		if (k > 0) {
+			position = FindItem(items, server[k - 1].id) + 1;
+		} else {
+			for (auto j = 1; j != int(server.size()); ++j) {
+				const auto next = FindItem(items, server[j].id);
+				if (next != end(items)) {
+					position = next;
+					break;
+				}
+			}
+		}
+		items.insert(position, server[k]);
+		changed = true;
+	}
+	return changed;
+}
+
+void State::load(ListId list, Item item) {
+	const auto key = std::make_pair(list, item.id);
+	if (_requested.contains(key)) {
+		return;
+	}
+	const auto owner = &_session->data();
+	const auto done = crl::guard(this, [=] {
+		scheduleRefresh();
+	});
+	switch (list.kind) {
+	case ListKind::Chats:
+	case ListKind::Filter: {
+		if (list.kind == ListKind::Filter
+			&& !FilterExists(owner, FilterOf(list))) {
+			return;
+		}
+		const auto peer = placeholder(PeerId(item.id), item.hash);
+		if (!peer) {
+			return;
+		}
+		const auto history = owner->history(peer);
+		if (history->folderKnown()) {
+			return;
+		}
+		_requested.emplace(key);
+		owner->histories().requestDialogEntry(history, done);
+	} break;
+	case ListKind::Saved: {
+		if (const auto peer = placeholder(PeerId(item.id), item.hash)) {
+			_requested.emplace(key);
+			owner->savedMessages().requestSublist(peer, done);
+		}
+	} break;
+	case ListKind::Topics: {
+		const auto peer = owner->peerLoaded(PeerId(list.id));
+		if (const auto forum = peer ? peer->forum() : nullptr) {
+			_requested.emplace(key);
+			forum->requestTopic(MsgId(int64(item.id)), done);
+		}
+	} break;
+	}
+}
+
+void State::scheduleRefresh() {
+	if (_scheduled) {
+		return;
+	}
+	_scheduled = true;
+	crl::on_main(this, [=] {
+		_scheduled = false;
+		refresh();
+	});
+}
+
+void State::refresh() {
+	if (_refreshing || _cleared) {
+		return;
+	}
+	_refreshing = true;
+	auto changed = false;
+	auto now = std::vector<Placed>();
+	auto shown = base::flat_set<Shown>();
+	auto positions = base::flat_map<Shown, int>();
+	if (LocalPins()) {
+		for (auto &[list, items] : _lists) {
+			changed = merge(list, items) || changed;
+			const auto filterId = FilterOf(list);
+			const auto order = serverOrder(list);
+			auto position = 0;
+			for (const auto &item : items) {
+				auto entry = resolve(list, item, false);
+				const auto server = entry
+					&& order
+					&& ranges::contains(*order, Dialogs::Key(entry));
+				if (!server) {
+					entry = item.local ? resolve(list, item, true) : nullptr;
+					if (!entry) {
+						if (item.local) {
+							load(list, item);
+						}
+						continue;
+					}
+					shown.emplace(entry, filterId);
+				}
+				positions.emplace(Shown(entry, filterId), ++position);
+				now.push_back({
+					.list = list,
+					.item = item,
+					.entry = entry,
+					.position = position,
+					.local = !server,
+				});
+			}
+		}
+	}
+	const auto was = std::exchange(_positions, std::move(positions));
+	_shown = std::move(shown);
+	for (const auto &one : now) {
+		if (one.local) {
+			one.entry->cachePinnedIndex(
+				FilterOf(one.list),
+				kLocalBase + one.position);
+		}
+	}
+	for (const auto &[list, item] : _applied) {
+		const auto filterId = FilterOf(list);
+		const auto entry = resolve(list, item, false);
+		if (entry
+			&& !_shown.contains(Shown(entry, filterId))
+			&& !ServerPinned(entry, filterId)) {
+			entry->cachePinnedIndex(filterId, 0);
+		}
+	}
+	const auto resort = [&](not_null<Dialogs::Entry*> entry, ListId list) {
+		const auto key = Shown(entry, FilterOf(list));
+		const auto i = was.find(key);
+		const auto j = _positions.find(key);
+		const auto before = (i != end(was)) ? i->second : 0;
+		const auto after = (j != end(_positions)) ? j->second : 0;
+		if (before != after) {
+			entry->updateChatListSortPosition();
+		}
+	};
+	for (const auto &[list, item] : _placed) {
+		if (const auto entry = resolve(list, item, false)) {
+			resort(entry, list);
+		}
+	}
+	_placed.clear();
+	_applied.clear();
+	for (const auto &one : now) {
+		resort(one.entry, one.list);
+		_placed.emplace_back(one.list, one.item);
+		if (one.local) {
+			_applied.emplace_back(one.list, one.item);
+		}
+	}
+	if (changed) {
+		write();
+	}
+	_refreshing = false;
+}
+
+void State::add(ListId list, Item item) {
+	auto i = _lists.find(list);
+	if (i == end(_lists)) {
+		i = _lists.emplace(list, serverItems(list)).first;
+	}
+	auto &items = i->second;
+	const auto j = FindItem(items, item.id);
+	if (j != end(items)) {
+		j->local = true;
+	} else {
+		item.local = true;
+		items.push_back(item);
+	}
+	write();
+	refresh();
+}
+
+bool State::toggle(
+		not_null<Window::SessionController*> controller,
+		not_null<Dialogs::Entry*> entry,
+		FilterId filterId,
+		Fn<void()> onToggled) {
+	if (!LocalPins()) {
+		return false;
+	}
+	const auto list = ListFor(entry, filterId);
+	if (!list) {
+		return false;
+	}
+	const auto item = ItemFor(entry);
+	if (entry->isPinnedDialog(filterId)) {
+		const auto i = _lists.find(*list);
+		if (i == end(_lists)) {
+			return false;
+		}
+		auto &items = i->second;
+		const auto j = FindItem(items, item.id);
+		if (j == end(items) || !j->local) {
+			return false;
+		}
+		const auto server = ServerPinned(entry, filterId);
+		if (server) {
+			j->local = false;
+		} else {
+			items.erase(j);
+		}
+		if (ranges::none_of(items, &Item::local)) {
+			_lists.erase(i);
+		}
+		write();
+		refresh();
+		return !server;
+	}
+	const auto owner = &entry->owner();
+	const auto history = entry->asHistory();
+	const auto canPin = filterId
+		? owner->pinnedCanPin(filterId, history)
+		: owner->pinnedCanPin(entry);
+	if (canPin) {
+		return false;
+	}
+	add(*list, item);
+	if (history) {
+		controller->content()->dialogsToUp();
+	}
+	if (onToggled) {
+		onToggled();
+	}
+	return true;
+}
+
+void State::fallback(not_null<Dialogs::Entry*> entry) {
+	const auto list = ListFor(entry, FilterId());
+	if (!list || !ServerPinned(entry, FilterId())) {
+		return;
+	}
+	entry->owner().setChatPinned(entry, FilterId(), false);
+	add(*list, ItemFor(entry));
+}
+
+bool State::reorder(
+		FilterId filterId,
+		not_null<Dialogs::Entry*> entry1,
+		not_null<Dialogs::Entry*> entry2) {
+	if (!LocalPins()) {
+		return false;
+	}
+	const auto list = ListFor(entry1, filterId);
+	if (!list || list != ListFor(entry2, filterId)) {
+		return false;
+	}
+	const auto i = _lists.find(*list);
+	if (i == end(_lists)) {
+		return false;
+	}
+	const auto server = ServerPinned(entry1, filterId)
+		&& ServerPinned(entry2, filterId);
+	auto &items = i->second;
+	const auto a = FindItem(items, ItemFor(entry1).id);
+	const auto b = FindItem(items, ItemFor(entry2).id);
+	if (a == end(items) || b == end(items)) {
+		return !server;
+	}
+	std::iter_swap(a, b);
+	if (!server) {
+		_dragLocal = true;
+	}
+	write();
+	refresh();
+	return !server;
+}
+
+bool State::reorderTopics(
+		not_null<Data::Forum*> forum,
+		const QVector<MTPint> &ids) {
+	if (!LocalPins()) {
+		return false;
+	}
+	const auto list = ListId{ ListKind::Topics, forum->peer()->id.value };
+	const auto i = _lists.find(list);
+	if (i == end(_lists)) {
+		return false;
+	}
+	auto &items = i->second;
+	auto before = std::vector<uint64>();
+	for (const auto &item : items) {
+		const auto entry = resolve(list, item, false);
+		if (entry && _positions.contains(Shown(entry, FilterId()))) {
+			before.push_back(item.id);
+		}
+	}
+	auto after = ranges::views::all(
+		ids
+	) | ranges::views::transform([](const MTPint &id) {
+		return uint64(int64(id.v));
+	}) | ranges::to_vector;
+	if (ranges::is_permutation(before, after)) {
+		const auto local = [&](uint64 id) {
+			const auto topic = forum->topicFor(MsgId(int64(id)));
+			return topic && _shown.contains(Shown(topic, FilterId()));
+		};
+		auto crossed = false;
+		auto server = QVector<MTPint>();
+		for (auto k = 0; k != int(after.size()); ++k) {
+			if ((local(before[k]) || local(after[k]))
+				&& (before[k] != after[k])) {
+				crossed = true;
+			}
+			if (!local(after[k])) {
+				server.push_back(MTP_int(int(int64(after[k]))));
+			}
+		}
+		const auto copy = items;
+		auto next = begin(after);
+		for (auto &item : items) {
+			if (ranges::contains(before, item.id)) {
+				item = *ranges::find(copy, *next++, &Item::id);
+			}
+		}
+		write();
+		if (!crossed) {
+			forum->topicsList()->pinned()->applyList(forum, server);
+			_session->api().savePinnedOrder(forum);
+		}
+	}
+	refresh();
+	return true;
+}
+
+bool State::takeDragLocal() {
+	return std::exchange(_dragLocal, false);
+}
+
+bool State::shown(
+		not_null<const Dialogs::Entry*> entry,
+		FilterId filterId) const {
+	return _shown.contains(Shown(entry, filterId));
+}
+
+int State::sortIndex(
+		not_null<const Dialogs::Entry*> entry,
+		FilterId filterId,
+		int index) const {
+	const auto i = _positions.find(Shown(entry, filterId));
+	return (i != end(_positions)) ? i->second : (index + kUnmappedBase);
+}
+
+void Erode(QImage &image, int radius) {
+	const auto width = image.width();
+	const auto height = image.height();
+	const auto stride = image.bytesPerLine() / 4;
+	const auto pixels = reinterpret_cast<uint32*>(image.bits());
+	auto alpha = std::vector<int>(width * height);
+	for (auto y = 0; y != height; ++y) {
+		for (auto x = 0; x != width; ++x) {
+			alpha[y * width + x] = qAlpha(pixels[y * stride + x]);
+		}
+	}
+	auto rows = std::vector<int>(width * height);
+	for (auto y = 0; y != height; ++y) {
+		for (auto x = 0; x != width; ++x) {
+			auto value = 255;
+			for (auto dx = -radius; dx <= radius; ++dx) {
+				const auto nx = x + dx;
+				value = std::min(
+					value,
+					(nx >= 0 && nx < width) ? alpha[y * width + nx] : 0);
+			}
+			rows[y * width + x] = value;
+		}
+	}
+	for (auto y = 0; y != height; ++y) {
+		for (auto x = 0; x != width; ++x) {
+			const auto was = alpha[y * width + x];
+			if (!was) {
+				continue;
+			}
+			auto inner = 255;
+			for (auto dy = -radius; dy <= radius; ++dy) {
+				const auto ny = y + dy;
+				inner = std::min(
+					inner,
+					(ny >= 0 && ny < height) ? rows[ny * width + x] : 0);
+			}
+			const auto keep = std::max(was - inner, 0);
+			auto &pixel = pixels[y * stride + x];
+			pixel = qRgba(
+				qRed(pixel) * keep / was,
+				qGreen(pixel) * keep / was,
+				qBlue(pixel) * keep / was,
+				keep);
+		}
+	}
+}
+
+[[nodiscard]] const QImage &HollowIcon(const style::icon &icon) {
+	struct Cached {
+		QImage image;
+		int palette = 0;
+	};
+	static auto cache = base::flat_map<const style::icon*, Cached>();
+	const auto ratio = style::DevicePixelRatio();
+	const auto size = QSize(icon.width(), icon.height()) * ratio;
+	auto &cached = cache[&icon];
+	if (cached.image.size() == size
+		&& cached.palette == style::PaletteVersion()) {
+		return cached.image;
+	}
+	auto image = QImage(size, QImage::Format_ARGB32_Premultiplied);
+	image.fill(Qt::transparent);
+	image.setDevicePixelRatio(ratio);
+	{
+		auto p = QPainter(&image);
+		icon.paint(p, 0, 0, icon.width());
+	}
+	Erode(image, std::max(1, (ratio * style::Scale() + 50) / 100));
+	cached.image = std::move(image);
+	cached.palette = style::PaletteVersion();
+	return cached.image;
+}
