+
+void SetupLocalPins(not_null<Main::Session*> session) {
+	session->lifetime().make_state<State>(session);
+}
+
+bool ToggleLocalPin(
+		not_null<Window::SessionController*> controller,
+		not_null<Dialogs::Entry*> entry,
+		FilterId filterId,
+		Fn<void()> onToggled) {
+	const auto state = State::Find(&entry->session());
+	return state
+		&& state->toggle(controller, entry, filterId, std::move(onToggled));
+}
+
+Fn<void(const MTP::Error&)> LocalPinFallback(
+		not_null<Dialogs::Entry*> entry) {
+	return [weak = base::make_weak(entry)](const MTP::Error &error) {
+		const auto type = error.type();
+		if (!LocalPins()
+			|| (type != u"PINNED_DIALOGS_TOO_MUCH"_q
+				&& type != u"PINNED_TOO_MUCH"_q)) {
+			return;
+		} else if (const auto strong = weak.get()) {
+			if (const auto state = State::Find(&strong->session())) {
+				state->fallback(strong);
+			}
+		}
+	};
+}
+
+bool ReorderLocalPins(
+		FilterId filterId,
+		Dialogs::Key key1,
+		Dialogs::Key key2) {
+	const auto entry = key1.entry();
+	const auto state = State::Find(&entry->session());
+	return state && state->reorder(filterId, entry, key2.entry());
+}
+
+bool ReorderLocalTopicPins(
+		not_null<Data::Forum*> forum,
+		const QVector<MTPint> &ids) {
+	const auto state = State::Find(&forum->session());
+	return state && state->reorderTopics(forum, ids);
+}
+
+bool KeepPinnedOrderLocal(not_null<Main::Session*> session) {
+	const auto state = State::Find(session);
+	return state && state->takeDragLocal();
+}
+
+int PinnedSortIndex(
+		not_null<const Dialogs::Entry*> entry,
+		FilterId filterId,
+		int index) {
+	const auto state = State::Find(&entry->session());
+	return state
+		? state->sortIndex(entry, filterId, index)
+		: (index + kUnmappedBase);
+}
+
+LocalPinPaint::LocalPinPaint(
+		not_null<Dialogs::Entry*> entry,
+		FilterId filterId) {
+	const auto state = State::Find(&entry->session());
+	_was = std::exchange(
+		PaintingLocal,
+		state && state->shown(entry, filterId));
+}
+
+LocalPinPaint::~LocalPinPaint() {
+	PaintingLocal = _was;
+}
+
+void PaintPinnedIcon(
+		QPainter &p,
+		const style::icon &icon,
+		int x,
+		int y,
+		int outerWidth) {
+	if (!PaintingLocal) {
+		icon.paint(p, x, y, outerWidth);
+		return;
+	}
+	p.drawImage(
+		style::rtlrect(x, y, icon.width(), icon.height(), outerWidth),
+		HollowIcon(icon));
+}
