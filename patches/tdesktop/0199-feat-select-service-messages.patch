diff --git a/Telegram/SourceFiles/tele/tele_select_service.cpp b/Telegram/SourceFiles/tele/tele_select_service.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5994f151f253b60d03a43fb2466771f3cfa04220
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_select_service.cpp
@@ -0,0 +1,57 @@
+#include "tele/tele_select_service.h"
+
+#include "data/data_session.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "history/view/history_view_list_widget.h"
+#include "main/main_session.h"
+#include "ui/chat/chat_style.h"
+
+namespace Tele {
+
+void DropSelectedService(
+		base::flat_set<not_null<HistoryItem*>, std::less<>> &selected) {
+	for (auto i = selected.begin(); i != selected.end();) {
+		if ((*i)->isService()) {
+			i = selected.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+void DropSelectedService(
+		not_null<Main::Session*> session,
+		base::flat_map<
+			FullMsgId,
+			HistoryView::SelectionData,
+			std::less<>> &selected) {
+	for (auto i = selected.begin(); i != selected.end();) {
+		const auto item = session->data().message(i->first);
+		if (item && item->isService()) {
+			i = selected.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+void PaintServiceSelection(
+		QPainter &p,
+		const Ui::ChatPaintContext &context,
+		not_null<const HistoryView::Element*> view,
+		int geometryHeight) {
+	if (!context.selected()) {
+		return;
+	}
+	const auto top = view->marginTop();
+	const auto fill = std::min(top, view->marginBottom());
+	p.fillRect(
+		0,
+		top - fill,
+		view->width(),
+		fill + geometryHeight + fill,
+		context.st->msgSelectOverlay());
+}
+
+} // namespace Tele
