index 0000000000000000000000000000000000000000..e6491daf590874d1cfd3cfadedc22c991b8ffb91
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_list_previews.cpp
@@ -0,0 +1,102 @@
+#include "tele/tele_list_previews.h"
+
+#include "dialogs/dialogs_entry.h"
+#include "lang/lang_keys.h"
+#include "tele/tele_options.h"
+#include "styles/style_dialogs.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] style::DialogRow MakeCompact(
+		const style::DialogRow &base,
+		int photoSize,
+		int skip) {
+	auto result = base;
+	result.padding.setTop(skip);
+	result.padding.setBottom(skip);
+	result.photoSize = photoSize;
+	result.height = skip + photoSize + skip;
+	result.nameLeft = base.nameLeft - (base.photoSize - photoSize);
+	result.textLeft = result.nameLeft;
+	result.nameTop = (result.height - st::semiboldFont->height) / 2;
+	result.textTop = result.nameTop;
+	result.topicsHeight = 0;
+	return result;
+}
+
+[[nodiscard]] const style::DialogRow &CompactRow() {
+	static const auto result = MakeCompact(
+		st::defaultDialogRow,
+		style::ConvertScale(28),
+		style::ConvertScale(6));
+	return result;
+}
+
+[[nodiscard]] const style::DialogRow &CompactTopicRow() {
+	static const auto result = MakeCompact(
+		st::forumTopicRow,
+		st::forumTopicRow.photoSize,
+		st::forumTopicRow.padding.top());
+	return result;
+}
+
+} // namespace
+
+const style::DialogRow *CompactListRowSt(
+		not_null<const Dialogs::Entry*> entry) {
+	if (!HideListPreviews()) {
+		return nullptr;
+	}
+	return entry->asTopic() ? &CompactTopicRow() : &CompactRow();
+}
+
+bool CompactListRow(const style::DialogRow &st) {
+	return (&st == &CompactRow()) || (&st == &CompactTopicRow());
+}
+
+int ListRowNameLeft(const style::DialogRow &st) {
+	if (!HideListPreviews()) {
+		return st.nameLeft;
+	}
+	return (&st == &st::forumTopicRow)
+		? CompactTopicRow().nameLeft
+		: CompactRow().nameLeft;
+}
+
+int ListRowMinHeight(int height) {
+	if (!HideListPreviews()) {
+		return height;
+	}
+	return std::min({
+		height,
+		CompactRow().height,
+		CompactTopicRow().height,
+	});
+}
+
+QRect ListRowCornerRect(QRect rect) {
+	return HideListPreviews() ? QRect() : rect;
+}
+
+void PaintCompactDraft(
+		QPainter &p,
+		QRect &rectForName,
+		bool active,
+		bool selected) {
+	const auto text = tr::lng_from_draft(tr::now);
+	const auto width = st::dialogsDateFont->width(text);
+	rectForName.setWidth(rectForName.width() - width - st::dialogsDateSkip);
+	p.setFont(st::dialogsDateFont);
+	p.setPen(active
+		? st::dialogsDraftFgActive
+		: selected
+		? st::dialogsDraftFgOver
+		: st::dialogsDraftFg);
+	p.drawText(
+		rectForName.left() + rectForName.width() + st::dialogsDateSkip,
+		rectForName.top() + st::semiboldFont->height - st::normalFont->descent,
+		text);
+}
+
+} // namespace Tele
