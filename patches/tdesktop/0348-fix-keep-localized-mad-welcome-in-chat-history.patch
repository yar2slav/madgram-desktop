+			if (state.value(u"version"_q).toInt() == 2) {
+				const auto date = state.value(u"date"_q).toInteger();
+				if (date > 0 && date <= now) {
+					_date = TimeId(date);
+				}
+				_dismissed = state.value(u"dismissed"_q).toBool();
