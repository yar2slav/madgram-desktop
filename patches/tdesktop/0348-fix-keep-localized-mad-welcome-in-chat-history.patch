+		const auto info = QFileInfo(_path);
+		_existing = info.exists();
+		const auto now = base::unixtime::now();
+		_date = _existing ? TimeId(std::clamp<qint64>(
+			info.lastModified().toSecsSinceEpoch(), 1, now)) : now;
