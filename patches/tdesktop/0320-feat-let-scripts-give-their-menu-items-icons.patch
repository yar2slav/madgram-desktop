+		: builtin
+		? MakeStyleMenuIcon(builtin)
+		: nullptr;
+}
+
+std::optional<ScriptIcon> ReadScriptIcon(
+		JSContext *ctx,
+		JSValueConst value,
+		not_null<Instance*> instance,
+		const char *api) {
+	const auto fail = [&](const QString &text) -> std::optional<ScriptIcon> {
+		JS_ThrowTypeError(
+			ctx,
+			"%s: %s",
+			api,
+			text.toUtf8().constData());
+		return std::nullopt;
+	};
+	if (JS_IsUndefined(value) || JS_IsNull(value)) {
+		return ScriptIcon();
+	} else if (JS_IsBigInt(value)) {
+		auto id = std::int64_t();
+		if (JS_ToBigInt64(ctx, &id, value) < 0 || id <= 0) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			return fail(u"icon must be a custom emoji document id"_q);
+		}
+		return ScriptIcon{
+			.custom = MakeCustomEmojiMenuIcon(
+				ScriptSession(instance),
+				uint64(id)),
+		};
+	} else if (JS_IsString(value)) {
+		const auto text = FromStd(ToStd(ctx, value)).trimmed();
+		if (text.isEmpty()) {
+			return fail(u"icon can't be empty"_q);
+		} else if (const auto builtin = BuiltinIcon(text)) {
+			return ScriptIcon{ .builtin = builtin };
+		} else if (text.startsWith(u"<svg"_q, Qt::CaseInsensitive)
+			|| text.startsWith(u"<?xml"_q, Qt::CaseInsensitive)) {
+			if (const auto icon = MakeSvgMenuIcon(text.toUtf8())) {
+				return ScriptIcon{ .custom = icon };
+			}
+			return fail(u"the icon isn't a valid SVG"_q);
+		} else if (IsImagePath(text)) {
+			const auto path = QDir(instance->file().root).absoluteFilePath(
+				text);
+			auto file = QFile(path);
+			if (!file.open(QIODevice::ReadOnly)) {
+				return fail(u"can't read the icon file "_q + path);
+			} else if (file.size() > kMaxIconBytes) {
+				return fail(u"the icon file is over 1 MB"_q);
+			}
+			if (const auto icon = IconFromBytes(file.readAll())) {
+				return ScriptIcon{ .custom = icon };
+			}
+			return fail(u"the icon file isn't a valid SVG, PNG, JPEG "
+				"or WebP image"_q);
+		} else if (const auto icon = MakeEmojiMenuIcon(text)) {
+			return ScriptIcon{ .custom = icon };
+		}
+		return fail(u"icon '"_q
+			+ Preview(text)
+			+ u"' isn't a tele icon name, one emoji, an <svg> or an image "
+			"file"_q);
+	} else if (const auto bytes = BytesFrom(ctx, value)) {
+		if (bytes->size() > kMaxIconBytes) {
+			return fail(u"the icon is over 1 MB"_q);
+		} else if (const auto icon = IconFromBytes(*bytes)) {
+			return ScriptIcon{ .custom = icon };
+		}
+		return fail(u"the icon bytes aren't a valid SVG, PNG, JPEG or WebP "
+			"image"_q);
+	}
+	return fail(u"icon must be a string, a bigint or a Uint8Array"_q);
+}
