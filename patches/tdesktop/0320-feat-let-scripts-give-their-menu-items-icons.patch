+
+[[nodiscard]] bool LooksLikeSvg(const QByteArray &bytes) {
+	const auto trimmed = bytes.trimmed();
+	return trimmed.startsWith('<');
+}
+
+[[nodiscard]] std::shared_ptr<const MenuIcon> IconFromBytes(
+		const QByteArray &bytes) {
+	if (LooksLikeSvg(bytes)) {
+		return MakeSvgMenuIcon(bytes);
+	}
+	auto copy = bytes;
+	auto buffer = QBuffer(&copy);
+	if (!buffer.open(QIODevice::ReadOnly)) {
+		return nullptr;
+	}
+	auto reader = QImageReader(&buffer);
+	reader.setAutoTransform(true);
+	const auto size = reader.size();
+	if (!size.isValid()
+		|| size.isEmpty()
+		|| int64(size.width()) * size.height() > kMaxIconPixels) {
+		return nullptr;
+	} else if (std::max(size.width(), size.height()) > kIconSide) {
+		reader.setScaledSize(
+			size.scaled(kIconSide, kIconSide, Qt::KeepAspectRatio));
+	}
+	return MakeImageMenuIcon(reader.read());
+}
+
+[[nodiscard]] bool IsImagePath(const QString &text) {
+	const auto lower = text.toLower();
+	return lower.endsWith(u".svg"_q)
+		|| lower.endsWith(u".png"_q)
+		|| lower.endsWith(u".jpg"_q)
+		|| lower.endsWith(u".jpeg"_q)
+		|| lower.endsWith(u".webp"_q);
+}
+
+[[nodiscard]] QString Preview(const QString &text) {
+	return (text.size() > 32) ? (text.left(32) + QChar(0x2026)) : text;
+}
