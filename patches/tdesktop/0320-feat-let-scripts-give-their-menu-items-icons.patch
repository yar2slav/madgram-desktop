+
+[[nodiscard]] QRect ContentRect(QSize box, QSize content) {
+	if (content.isEmpty()) {
+		return QRect();
+	}
+	const auto inset = box.width() / 12;
+	const auto available = QRect(QPoint(), box).marginsRemoved(
+		{ inset, inset, inset, inset });
+	const auto scaled = content.scaled(
+		available.size(),
+		Qt::KeepAspectRatio);
+	return QRect(
+		available.x() + (available.width() - scaled.width()) / 2,
+		available.y() + (available.height() - scaled.height()) / 2,
+		scaled.width(),
+		scaled.height());
+}
+
+class StyleIcon final : public MenuIcon {
+public:
+	explicit StyleIcon(not_null<const style::icon*> icon) : _icon(icon) {
+	}
+
+	PaintFn bind(Fn<void()> repaint) const override {
+		const auto icon = _icon;
+		return [=](QPainter &p, QRect rect, QColor color) {
+			icon->paintInCenter(p, rect, color);
+		};
+	}
+
+private:
+	const not_null<const style::icon*> _icon;
+
+};
+
+class EmojiIcon final : public MenuIcon {
+public:
+	explicit EmojiIcon(EmojiPtr emoji) : _emoji(emoji) {
+	}
+
+	PaintFn bind(Fn<void()> repaint) const override {
+		const auto emoji = _emoji;
+		return [=](QPainter &p, QRect rect, QColor color) {
+			const auto size = Ui::Emoji::GetSizeNormal();
+			const auto side = size / style::DevicePixelRatio();
+			Ui::Emoji::Draw(
+				p,
+				emoji,
+				size,
+				rect.x() + (rect.width() - side) / 2,
+				rect.y() + (rect.height() - side) / 2);
+		};
+	}
+
+private:
+	const EmojiPtr _emoji;
+
+};
+
+class SvgIcon final : public MenuIcon {
+public:
+	SvgIcon(QByteArray svg, QSize size) : _svg(std::move(svg)), _size(size) {
+	}
+
+	PaintFn bind(Fn<void()> repaint) const override {
+		return [=](QPainter &p, QRect rect, QColor color) {
+			p.drawImage(rect.topLeft(), prepare(rect.size(), color));
+		};
+	}
+
+private:
+	[[nodiscard]] const QImage &prepare(QSize size, QColor color) const {
+		const auto ratio = style::DevicePixelRatio();
+		if (_cache.size() != size * ratio || _color != color) {
+			_color = color;
+			_cache = QImage(
+				size * ratio,
+				QImage::Format_ARGB32_Premultiplied);
+			_cache.setDevicePixelRatio(ratio);
+			_cache.fill(Qt::transparent);
+			auto q = QPainter(&_cache);
+			auto hq = PainterHighQualityEnabler(q);
+			auto renderer = QSvgRenderer(_svg);
+			renderer.render(&q, QRectF(ContentRect(size, _size)));
+			q.setCompositionMode(QPainter::CompositionMode_SourceIn);
+			q.fillRect(QRect(QPoint(), size), color);
+		}
+		return _cache;
+	}
+
+	const QByteArray _svg;
+	const QSize _size;
+	mutable QImage _cache;
+	mutable QColor _color;
+
+};
+
+class ImageIcon final : public MenuIcon {
+public:
+	explicit ImageIcon(QImage image) : _image(std::move(image)) {
+	}
+
+	PaintFn bind(Fn<void()> repaint) const override {
+		return [=](QPainter &p, QRect rect, QColor color) {
+			p.drawImage(rect.topLeft(), prepare(rect.size()));
+		};
+	}
+
+private:
+	[[nodiscard]] const QImage &prepare(QSize size) const {
+		const auto ratio = style::DevicePixelRatio();
+		if (_cache.size() != size * ratio) {
+			_cache = QImage(
+				size * ratio,
+				QImage::Format_ARGB32_Premultiplied);
+			_cache.setDevicePixelRatio(ratio);
+			_cache.fill(Qt::transparent);
+			auto q = QPainter(&_cache);
+			auto hq = PainterHighQualityEnabler(q);
+			q.drawImage(ContentRect(size, _image.size()), _image);
+		}
+		return _cache;
+	}
+
+	const QImage _image;
+	mutable QImage _cache;
+
+};
+
+class CustomEmojiIcon final : public MenuIcon {
+public:
+	CustomEmojiIcon(not_null<Main::Session*> session, uint64 documentId)
+	: _session(base::make_weak(session))
+	, _documentId(documentId) {
+	}
+
+	PaintFn bind(Fn<void()> repaint) const override {
+		const auto session = _session.get();
+		if (!session) {
+			return nullptr;
+		}
+		const auto emoji = std::shared_ptr<Ui::Text::CustomEmoji>(
+			session->data().customEmojiManager().create(
+				DocumentId(_documentId),
+				std::move(repaint),
+				Data::CustomEmojiSizeTag::Normal));
+		const auto weak = _session;
+		return [=](QPainter &p, QRect rect, QColor color) {
+			if (!weak.get()) {
+				return;
+			}
+			const auto side = Data::FrameSizeFromTag(
+				Data::CustomEmojiSizeTag::Normal
+			) / style::DevicePixelRatio();
+			emoji->paint(p, {
+				.textColor = color,
+				.now = crl::now(),
+				.position = QPoint(
+					rect.x() + (rect.width() - side) / 2,
+					rect.y() + (rect.height() - side) / 2),
+				.paused = PowerSaving::On(PowerSaving::kEmojiChat),
+			});
+		};
+	}
+
+private:
+	const base::weak_ptr<Main::Session> _session;
+	const uint64 _documentId = 0;
+
+};
+
+} // namespace
+
+std::shared_ptr<const MenuIcon> MakeStyleMenuIcon(
+		not_null<const style::icon*> icon) {
+	return std::make_shared<StyleIcon>(icon);
+}
+
+std::shared_ptr<const MenuIcon> MakeEmojiMenuIcon(const QString &emoji) {
+	auto length = 0;
+	const auto found = Ui::Emoji::Find(emoji, &length);
+	return (found && length == emoji.size())
+		? std::make_shared<EmojiIcon>(found)
+		: nullptr;
+}
+
+std::shared_ptr<const MenuIcon> MakeSvgMenuIcon(const QByteArray &svg) {
+	auto renderer = QSvgRenderer(svg);
+	if (!renderer.isValid()) {
+		return nullptr;
+	}
+	const auto view = renderer.viewBoxF().size();
+	const auto size = view.isEmpty()
+		? renderer.defaultSize()
+		: QSize(
+			std::max(int(std::ceil(view.width())), 1),
+			std::max(int(std::ceil(view.height())), 1));
+	return size.isEmpty()
+		? nullptr
+		: std::make_shared<SvgIcon>(svg, size);
+}
+
+std::shared_ptr<const MenuIcon> MakeImageMenuIcon(const QImage &image) {
+	return image.isNull()
+		? nullptr
+		: std::make_shared<ImageIcon>(
+			image.convertToFormat(QImage::Format_ARGB32_Premultiplied));
+}
+
+std::shared_ptr<const MenuIcon> MakeCustomEmojiMenuIcon(
+		not_null<Main::Session*> session,
+		uint64 documentId) {
+	return documentId
+		? std::make_shared<CustomEmojiIcon>(session, documentId)
+		: nullptr;
+}
+
+QSize MenuIconSize() {
+	return st::menuIconCopy.size();
+}
+
+QColor MenuIconColor(const style::Menu &st, bool selected) {
+	const auto text = (selected ? st.itemFgOver : st.itemFg)->c;
+	const auto icon = st::menuIconColor->c;
+	const auto dark = [](const QColor &color) {
+		return color.lightnessF() < 0.5;
+	};
+	return (dark(text) == dark(icon)) ? icon : text;
+}
+
+bool MenuHasIcons(const style::Menu &st) {
+	const auto &position = st.itemIconPosition;
+	return !position.isNull()
+		&& (st.itemPadding.left() >= position.x() + MenuIconSize().width());
+}
+
+IconMenuAction::IconMenuAction(
+	not_null<Ui::Menu::Menu*> parent,
+	const style::Menu &st,
+	not_null<QAction*> action,
+	std::shared_ptr<const MenuIcon> icon)
+: Action(parent, st, action, nullptr, nullptr)
+, _icon(std::move(icon))
+, _paint(_icon ? _icon->bind([=] { update(); }) : MenuIcon::PaintFn()) {
+}
+
+const std::shared_ptr<const MenuIcon> &IconMenuAction::menuIcon() const {
+	return _icon;
+}
+
+void IconMenuAction::paintEvent(QPaintEvent *e) {
+	Action::paintEvent(e);
+	if (!_paint || !MenuHasIcons(st())) {
+		return;
+	}
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto size = MenuIconSize();
+	const auto &position = st().itemIconPosition;
+	const auto left = style::RightToLeft()
+		? (width() - position.x() - size.width())
+		: position.x();
+	const auto color = isEnabled()
+		? MenuIconColor(st(), isSelected())
+		: st().itemFgDisabled->c;
+	_paint(p, QRect(QPoint(left, position.y()), size), color);
+}
+
+namespace {
+
+[[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeIconItem(
+		not_null<Ui::PopupMenu*> menu,
+		const QString &text,
+		Fn<void()> callback,
+		std::shared_ptr<const MenuIcon> icon) {
+	const auto raw = menu->menu();
+	const auto &st = raw->st();
+	const auto action = Ui::Menu::CreateAction(
+		raw.get(),
+		text,
+		std::move(callback));
+	if (!icon || !MenuHasIcons(st)) {
+		return base::make_unique_q<Ui::Menu::Action>(
+			raw,
+			st,
+			action,
+			nullptr,
+			nullptr);
+	}
+	return base::make_unique_q<IconMenuAction>(
+		raw,
+		st,
+		action,
+		std::move(icon));
+}
+
+} // namespace
+
+not_null<QAction*> AddIconMenuAction(
+		not_null<Ui::PopupMenu*> menu,
+		const QString &text,
+		Fn<void()> callback,
+		std::shared_ptr<const MenuIcon> icon) {
+	return menu->addAction(
+		MakeIconItem(menu, text, std::move(callback), std::move(icon)));
+}
+
+Ui::Menu::MenuCallback::Args IconMenuArgs(
+		const QString &text,
+		Fn<void()> callback,
+		std::shared_ptr<const MenuIcon> icon) {
+	return {
+		.text = text,
+		.handler = callback,
+		.icon = nullptr,
+		.make = [=](not_null<Ui::PopupMenu*> menu) {
+			return MakeIconItem(menu, text, callback, icon);
+		},
+	};
+}
+
+void AddMenuIconToButton(
+		not_null<Ui::RpWidget*> button,
+		int left,
+		std::shared_ptr<const MenuIcon> icon) {
+	if (!icon) {
+		return;
+	}
+	const auto widget = Ui::CreateChild<Ui::RpWidget>(button.get());
+	widget->setAttribute(Qt::WA_TransparentForMouseEvents);
+	widget->resize(MenuIconSize());
+	widget->show();
+	const auto paint = widget->lifetime().make_state<MenuIcon::PaintFn>(
+		icon->bind([=] { widget->update(); }));
+	button->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		widget->moveToLeft(
+			left,
+			(size.height() - widget->height()) / 2,
+			size.width());
+	}, widget->lifetime());
+	widget->paintRequest(
+	) | rpl::on_next([=] {
+		if (*paint) {
+			auto p = QPainter(widget);
+			auto hq = PainterHighQualityEnabler(p);
+			(*paint)(p, widget->rect(), st::menuIconColor->c);
+		}
+	}, widget->lifetime());
+}
+
+} // namespace Tele
