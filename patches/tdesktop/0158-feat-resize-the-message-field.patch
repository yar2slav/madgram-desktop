@@ -0,0 +1,65 @@
+#pragma once
+
+#include "base/unique_qptr.h"
+
+namespace Ui {
+class InputField;
+class RpWidget;
+} // namespace Ui
+
+namespace Tele {
+
+struct FieldResizeDescriptor {
+	not_null<Ui::RpWidget*> parent;
+	not_null<Ui::InputField*> field;
+	rpl::producer<QRect> edge;
+	rpl::producer<bool> shown;
+	QWidget *above = nullptr;
+	Fn<void()> apply;
+	bool applyNow = false;
+};
+
+class FieldResize final {
+public:
+	explicit FieldResize(FieldResizeDescriptor &&descriptor);
+	~FieldResize();
+
+	void raise();
+	void setMaxHeight(int height);
+	[[nodiscard]] int maxHeight() const;
+
+private:
+	void setupHandle(rpl::producer<QRect> edge, rpl::producer<bool> shown);
+	void setupApply(bool applyNow);
+	void handleEvent(not_null<QEvent*> e);
+	void drag(int globalY);
+	void finishDrag();
+	void apply();
+	void applyMin();
+
+	const not_null<Ui::RpWidget*> _parent;
+	const not_null<Ui::InputField*> _field;
+	const Fn<void()> _apply;
+	base::unique_qptr<Ui::RpWidget> _handle;
+	int _max = 0;
+	int _appliedChosen = 0;
+	int _dragStartY = 0;
+	int _dragStartHeight = 0;
+	int _dragLastY = 0;
+	bool _hovered = false;
+	bool _pressed = false;
+	bool _dragging = false;
+	bool _applying = false;
+	bool _minApplied = false;
+
+};
+
+[[nodiscard]] int FieldMaxHeight(not_null<const QWidget*> widget);
+[[nodiscard]] int FieldResizeMaxHeight(const FieldResize *resize);
+void FieldResizeSetMax(
+	FieldResize *resize,
