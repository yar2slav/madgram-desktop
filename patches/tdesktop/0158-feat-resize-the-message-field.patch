diff --git a/Telegram/SourceFiles/tele/tele_field_resize.cpp b/Telegram/SourceFiles/tele/tele_field_resize.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b903ee1f313081103481ba87a03c714368a7d7d3
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_field_resize.cpp
@@ -0,0 +1,253 @@
+#include "tele/tele_field_resize.h"
+
+#include "tele/tele_options.h"
+#include "ui/painter.h"
+#include "ui/rp_widget.h"
+#include "ui/widgets/fields/input_field.h"
+#include "styles/style_chat_helpers.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kHandleHeight = 6;
+constexpr auto kLineWidth = 36;
+constexpr auto kLineHeight = 3;
+constexpr auto kLineOpacity = 0.5;
+
+[[nodiscard]] int OneLineHeight() {
+	return st::historySendSize.height() - 2 * st::historySendPadding;
+}
+
+[[nodiscard]] int ClampHeight(not_null<const QWidget*> widget, int height) {
+	return std::max(
+		std::min(height, widget->window()->height() / 2),
+		OneLineHeight());
+}
+
+[[nodiscard]] int Unscaled(int height) {
+	return std::max(int(std::round(height * 100. / style::Scale())), 1);
+}
+
+[[nodiscard]] int ChosenHeight(not_null<const QWidget*> widget) {
+	const auto stored = ResizableField() ? FieldHeight() : 0;
+	return (stored > 0)
+		? ClampHeight(widget, style::ConvertScale(stored))
+		: 0;
+}
+
+} // namespace
+
+FieldResize::FieldResize(FieldResizeDescriptor &&descriptor)
+: _parent(descriptor.parent)
+, _field(descriptor.field)
+, _apply(std::move(descriptor.apply))
+, _max(st::historyComposeFieldMaxHeight)
+, _handle(base::make_unique_q<Ui::RpWidget>(_parent)) {
+	if (const auto above = descriptor.above) {
+		_handle->stackUnder(above);
+		above->stackUnder(_handle.get());
+	}
+	setupHandle(std::move(descriptor.edge), std::move(descriptor.shown));
+	setupApply(descriptor.applyNow);
+}
+
+FieldResize::~FieldResize() = default;
+
+void FieldResize::raise() {
+	_handle->raise();
+}
+
+void FieldResize::setMaxHeight(int height) {
+	_max = height;
+	_field->setMaxHeight(height);
+	applyMin();
+}
+
+void FieldResize::applyMin() {
+	const auto chosen = ChosenHeight(_parent);
+	if (chosen > 0) {
+		_minApplied = true;
+		_field->setMinHeight(std::min(chosen, _max));
+	} else if (_minApplied) {
+		_minApplied = false;
+		_field->setMinHeight(std::min(OneLineHeight(), _max));
+	}
+}
+
+int FieldResize::maxHeight() const {
+	return FieldMaxHeight(_parent);
+}
+
+void FieldResize::setupHandle(
+		rpl::producer<QRect> edge,
+		rpl::producer<bool> shown) {
+	const auto handle = _handle.get();
+	handle->setCursor(style::cur_sizever);
+
+	std::move(edge) | rpl::on_next([=](QRect rect) {
+		const auto height = style::ConvertScale(kHandleHeight);
+		handle->setGeometry(
+			rect.x(),
+			rect.y() - height,
+			rect.width(),
+			height);
+	}, handle->lifetime());
+
+	rpl::combine(
+		std::move(shown),
+		ResizableFieldValue()
+	) | rpl::on_next([=](bool shown, bool enabled) {
+		handle->setVisible(shown && enabled);
+	}, handle->lifetime());
+
+	handle->paintRequest() | rpl::on_next([=] {
+		if (!_hovered && !_dragging) {
+			return;
+		}
+		auto p = QPainter(handle);
+		auto hq = PainterHighQualityEnabler(p);
+		const auto width = style::ConvertScale(kLineWidth);
+		const auto height = style::ConvertScale(kLineHeight);
+		const auto radius = height / 2.;
+		p.setOpacity(kLineOpacity);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowSubTextFg);
+		p.drawRoundedRect(
+			QRect(
+				(handle->width() - width) / 2,
+				(handle->height() - height) / 2,
+				width,
+				height),
+			radius,
+			radius);
+	}, handle->lifetime());
+
+	handle->events() | rpl::on_next([=](not_null<QEvent*> e) {
+		handleEvent(e);
+	}, handle->lifetime());
+}
+
+void FieldResize::setupApply(bool applyNow) {
+	_appliedChosen = ChosenHeight(_parent);
+	rpl::merge(
+		ResizableFieldValue() | rpl::skip(1) | rpl::to_empty,
+		FieldHeightChanges()
+	) | rpl::on_next([=] {
+		if (!_dragging) {
+			apply();
+		}
+	}, _handle->lifetime());
+
+	_parent->heightValue() | rpl::on_next([=] {
+		if (!_dragging && ChosenHeight(_parent) != _appliedChosen) {
+			apply();
+		}
+	}, _handle->lifetime());
+
+	if (applyNow && ResizableField() && FieldHeight() > 0) {
+		apply();
+	}
+}
+
+void FieldResize::handleEvent(not_null<QEvent*> e) {
+	const auto type = e->type();
+	if (type == QEvent::Enter || type == QEvent::Leave) {
+		_hovered = (type == QEvent::Enter);
+		_handle->update();
+		return;
+	} else if (type != QEvent::MouseButtonPress
+		&& type != QEvent::MouseMove
+		&& type != QEvent::MouseButtonRelease
+		&& type != QEvent::MouseButtonDblClick) {
+		return;
+	}
+	const auto mouse = static_cast<QMouseEvent*>(e.get());
+	if (type == QEvent::MouseMove) {
+		if (_pressed) {
+			drag(mouse->globalPos().y());
+		}
+		return;
+	} else if (mouse->button() != Qt::LeftButton) {
+		return;
+	} else if (type == QEvent::MouseButtonPress) {
+		_pressed = true;
+		_dragStartY = _dragLastY = mouse->globalPos().y();
+		_dragStartHeight = _field->height();
+	} else if (type == QEvent::MouseButtonRelease) {
+		_pressed = false;
+		finishDrag();
+	} else {
+		_pressed = false;
+		SetFieldHeight(0);
+	}
+}
+
+void FieldResize::drag(int globalY) {
+	if (globalY == _dragLastY || _applying) {
+		return;
+	}
+	_dragLastY = globalY;
+	const auto height = ClampHeight(
+		_parent,
+		_dragStartHeight + _dragStartY - globalY);
+	if (!_dragging && height == _dragStartHeight) {
+		return;
+	}
+	_dragging = true;
+	SetFieldHeight(Unscaled(height));
+	apply();
+	_handle->update();
+}
+
+void FieldResize::finishDrag() {
+	if (!_dragging) {
+		return;
+	}
+	_dragging = false;
+	apply();
+	_handle->update();
+}
+
+void FieldResize::apply() {
+	if (_applying) {
+		return;
+	} else if (_parent->height() <= 0) {
+		_appliedChosen = -1;
+		return;
+	}
+	_applying = true;
+	_appliedChosen = ChosenHeight(_parent);
+	_apply();
+	_applying = false;
+}
+
+int FieldMaxHeight(not_null<const QWidget*> widget) {
+	return std::max(
+		st::historyComposeFieldMaxHeight,
+		ChosenHeight(widget));
+}
+
+int FieldResizeMaxHeight(const FieldResize *resize) {
+	return resize
+		? resize->maxHeight()
+		: st::historyComposeFieldMaxHeight;
+}
+
+void FieldResizeSetMax(
+		FieldResize *resize,
+		not_null<Ui::InputField*> field,
+		int height) {
+	if (resize) {
+		resize->setMaxHeight(height);
+	} else {
+		field->setMaxHeight(height);
+	}
+}
+
+void FieldResizeRaise(FieldResize *resize) {
+	if (resize) {
+		resize->raise();
+	}
+}
+
+} // namespace Tele
