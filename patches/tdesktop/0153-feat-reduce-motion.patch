@@ -0,0 +1,72 @@
+#include "tele/tele_reduce_motion.h"
+
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "tele/tele_options.h"
+#include "ui/power_saving.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kMotionFlags = PowerSaving::Flags(PowerSaving::kAnimations)
+	| PowerSaving::kStickersPanel
+	| PowerSaving::kStickersChat
+	| PowerSaving::kEmojiPanel
+	| PowerSaving::kEmojiReactions
+	| PowerSaving::kEmojiChat
+	| PowerSaving::kEmojiStatus
+	| PowerSaving::kChatBackground
+	| PowerSaving::kChatSpoiler
+	| PowerSaving::kChatEffects;
+
+void Apply() {
+	if (!ReduceMotionSaved().isEmpty()) {
+		return;
+	}
+	auto &settings = Core::App().settings();
+	const auto current = PowerSaving::Current();
+	SetReduceMotionSaved(u"%1 %2"_q
+		.arg((current & kMotionFlags).value())
+		.arg(settings.loopAnimatedStickers() ? 1 : 0));
+	PowerSaving::Set(current | kMotionFlags);
+	settings.setLoopAnimatedStickers(false);
+	Core::App().saveSettingsDelayed();
+}
+
+void Restore() {
+	const auto saved = ReduceMotionSaved().split(' ');
+	if (saved.size() != 2) {
+		SetReduceMotionSaved(QString());
+		return;
+	}
+	auto &settings = Core::App().settings();
+	const auto previous = PowerSaving::Flags::from_raw(saved[0].toUInt());
+	const auto current = PowerSaving::Current();
+	PowerSaving::Set((current & ~kMotionFlags)
+		| (current & previous & kMotionFlags));
+	if (!settings.loopAnimatedStickers()) {
+		settings.setLoopAnimatedStickers(saved[1] == u"1"_q);
+	}
+	SetReduceMotionSaved(QString());
+	Core::App().saveSettingsDelayed();
+}
+
+void Sync() {
+	if (ReduceMotion()) {
+		Apply();
+	} else if (!ReduceMotionSaved().isEmpty()) {
+		Restore();
+	}
+}
+
+} // namespace
+
+void StartReduceMotion() {
+	static auto lifetime = rpl::lifetime();
+	Sync();
+	ReduceMotionChanges() | rpl::on_next([] {
+		Sync();
+	}, lifetime);
+}
+
+} // namespace Tele
