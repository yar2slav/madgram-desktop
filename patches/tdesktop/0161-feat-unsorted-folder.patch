new file mode 100644
index 0000000000000000000000000000000000000000..ca87d5a7754a62966203279c6cad5e39c5c3cd3a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_unsorted_folder.cpp
@@ -0,0 +1,178 @@
+#include "tele/tele_unsorted_folder.h"
+
+#include "data/data_channel.h"
+#include "data/data_chat_filters.h"
+#include "data/data_folder.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "dialogs/dialogs_indexed_list.h"
+#include "dialogs/dialogs_main_list.h"
+#include "history/history.h"
+#include "main/main_session.h"
+#include "menu/menu_mark_as_read.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_mute.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+namespace {
+
+using Flag = Data::ChatFilter::Flag;
+
+struct Covered {
+	Flag type = Flag();
+	bool covered = false;
+};
+
+using CoveredCache = std::unordered_map<not_null<History*>, Covered>;
+
+[[nodiscard]] std::map<
+		not_null<Main::Session*>,
+		CoveredCache> &Caches() {
+	static auto result = std::map<
+		not_null<Main::Session*>,
+		CoveredCache>();
+	return result;
+}
+
+[[nodiscard]] CoveredCache &CacheFor(not_null<Main::Session*> session) {
+	auto &caches = Caches();
+	const auto i = caches.find(session);
+	if (i != end(caches)) {
+		return i->second;
+	}
+	session->lifetime().add([=] {
+		Caches().erase(session);
+	});
+	return caches[session];
+}
+
+[[nodiscard]] Flag TypeFlag(not_null<History*> history) {
+	const auto peer = history->peer;
+	if (const auto user = peer->asUser()) {
+		return user->isBot()
+			? Flag::Bots
+			: user->isContact()
+			? Flag::Contacts
+			: Flag::NonContacts;
+	} else if (const auto channel = peer->asChannel()) {
+		return channel->isBroadcast() ? Flag::Channels : Flag::Groups;
+	}
+	return Flag::Groups;
+}
+
+[[nodiscard]] bool CoveredByOther(
+		not_null<History*> history,
+		Flag type) {
+	for (const auto &other : history->owner().chatsFilters().list()) {
+		const auto id = other.id();
+		if (!id
+			|| IsUnsortedFolder(id)
+			|| other.never().contains(history)) {
+			continue;
+		} else if ((other.flags() & type)
+			|| other.always().contains(history)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+} // namespace
+
+bool IsUnsortedFolder(FilterId id) {
+	return (id == kUnsortedFolderId);
+}
+
+Data::ChatFilter UnsortedFolderFilter() {
+	return Data::ChatFilter(
+		kUnsortedFolderId,
+		{ TextWithEntities{ Lower(u"Unsorted"_q) } },
+		QString(),
+		std::nullopt,
+		Data::ChatFilter::Flag::NoArchived,
+		{},
+		{},
+		{});
+}
+
+std::optional<bool> UnsortedFolderContains(
+		const Data::ChatFilter &filter,
+		not_null<History*> history) {
+	if (!IsUnsortedFolder(filter.id())) {
+		return std::nullopt;
+	} else if (!(filter.flags() & Data::ChatFilter::Flag::NoArchived)
+		|| !history->folderKnown()
+		|| history->folder()) {
+		return false;
+	}
+	const auto channel = history->peer->asChannel();
+	if (channel && channel->isCommunity()) {
+		return false;
+	}
+	const auto type = TypeFlag(history);
+	auto &cache = CacheFor(&history->session());
+	const auto i = cache.find(history);
+	if (i != end(cache) && i->second.type == type) {
+		return !i->second.covered;
+	}
+	const auto covered = CoveredByOther(history, type);
+	cache[history] = Covered{ .type = type, .covered = covered };
+	return !covered;
+}
+
+void RefreshUnsortedFolder(not_null<Main::Session*> session) {
+	CacheFor(session).clear();
+	const auto owner = &session->data();
+	const auto filters = &owner->chatsFilters();
+	const auto &list = filters->list();
+	const auto i = ranges::find(
+		list,
+		kUnsortedFolderId,
+		&Data::ChatFilter::id);
+	const auto filter = (i != end(list)) ? &*i : nullptr;
+	auto changed = false;
+	const auto feed = [&](not_null<Dialogs::MainList*> source) {
+		for (const auto &row : *source->indexed()) {
+			const auto history = row->history();
+			if (!history) {
+				continue;
+			}
+			const auto now = filter && filter->contains(history);
+			if (now == history->inChatList(kUnsortedFolderId)) {
+				continue;
+			}
+			const auto chats = filters->chatsList(kUnsortedFolderId);
+			if (now) {
+				history->addToChatList(kUnsortedFolderId, chats);
+			} else {
+				history->removeFromChatList(kUnsortedFolderId, chats);
+			}
+			changed = true;
+		}
+	};
+	feed(owner->chatsList());
+	if (const auto folder = owner->folderLoaded(Data::Folder::kId)) {
+		feed(folder->chatsList());
+	}
+	if (changed) {
+		owner->chatsListChanged(nullptr);
+	}
+}
+
+void AddUnsortedFolderActions(
+		not_null<Window::SessionController*> controller,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto session = &controller->session();
+	MarkAsReadMenu::AddChatListAction(
+		controller,
+		MarkAsReadMenu::ChatListKind::Folder,
+		[=] {
+			return session->data().chatsFilters().chatsList(
+				kUnsortedFolderId);
+		},
+		addAction);
+	AddMuteFolderAction(session, kUnsortedFolderId, addAction);
+}
+
+} // namespace Tele
