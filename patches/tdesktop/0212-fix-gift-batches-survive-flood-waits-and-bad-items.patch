diff --git a/Telegram/SourceFiles/tele/tele_gift_batch.cpp b/Telegram/SourceFiles/tele/tele_gift_batch.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3fde784dbe93658ae2ac47c7a7c74905e69e8138
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_batch.cpp
@@ -0,0 +1,269 @@
+#include "tele/tele_gift_batch.h"
+
+#include "base/timer.h"
+#include "base/weak_ptr.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "mtproto/mtp_instance.h"
+#include "tele/tele_flood_wait.h"
+#include "tele/tele_lowercase.h"
+#include "ui/text/format_values.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kTick = crl::time(250);
+
+[[nodiscard]] bool Tracked(mtpTypeId request) {
+	switch (request) {
+	case mtpc_payments_getPaymentForm:
+	case mtpc_payments_sendStarsForm:
+	case mtpc_payments_saveStarGift:
+	case mtpc_payments_transferStarGift:
+	case mtpc_payments_updateStarGiftPrice:
+	case mtpc_payments_convertStarGift:
+		return true;
+	}
+	return false;
+}
+
+class Runner final : public std::enable_shared_from_this<Runner> {
+public:
+	explicit Runner(GiftBatch &&batch);
+
+	void start();
+
+private:
+	[[nodiscard]] bool alive() const;
+	void next();
+	void stepDone(int step, bool ok, const QString &error);
+	void flood(const FloodWait &event);
+	void tick();
+	void clearWait();
+	void report();
+	void cancel();
+	void finish();
+
+	GiftBatch _batch;
+	const base::weak_ptr<Main::Session> _session;
+	GiftBatchResult _result;
+	int _index = 0;
+	int _step = 0;
+	bool _running = false;
+	bool _finished = false;
+	QString _error;
+	base::flat_set<mtpRequestId> _waiting;
+	crl::time _waitTill = 0;
+	int _shown = -1;
+	base::Timer _timer;
+	rpl::lifetime _lifetime;
+
+};
+
+Runner::Runner(GiftBatch &&batch)
+: _batch(std::move(batch))
+, _session(base::make_weak(_batch.session.get()))
+, _timer([=] { tick(); }) {
+	_batch.session->mtp().teleFloodWaits(
+	) | rpl::on_next([=](const FloodWait &event) {
+		flood(event);
+	}, _lifetime);
+}
+
+void Runner::start() {
+	next();
+}
+
+bool Runner::alive() const {
+	return _session && (!_batch.alive || _batch.alive());
+}
+
+void Runner::next() {
+	if (_finished) {
+		return;
+	} else if (_index >= _batch.total) {
+		finish();
+		return;
+	} else if (!alive()) {
+		cancel();
+		return;
+	}
+	_running = true;
+	_error = QString();
+	const auto step = ++_step;
+	report();
+	_batch.step(_index, [self = shared_from_this(), step](
+			bool ok,
+			QString error) {
+		self->stepDone(step, ok, error);
+	});
+}
+
+void Runner::stepDone(int step, bool ok, const QString &error) {
+	if (_finished || step != _step || !_running) {
+		return;
+	}
+	_running = false;
+	clearWait();
+	if (ok) {
+		++_result.done;
+	} else {
+		const auto type = error.isEmpty() ? _error : error;
+		if (!_batch.skipFailed) {
+			_result.failed = true;
+			_result.error = type;
+			finish();
+			return;
+		}
+		_result.skipped.push_back(_index);
+		_result.errors.push_back(type);
+	}
+	++_index;
+	next();
+}
+
+void Runner::flood(const FloodWait &event) {
+	if (!_running || !Tracked(event.request)) {
+		return;
+	} else if (event.resent) {
+		if (_waiting.remove(event.requestId) && _waiting.empty()) {
+			clearWait();
+		}
+		return;
+	} else if (event.seconds < 0) {
+		_error = event.error;
+		return;
+	} else if (event.seconds == 0) {
+		return;
+	}
+	_waiting.emplace(event.requestId);
+	_waitTill = std::max(
+		_waitTill,
+		crl::now() + event.seconds * crl::time(1000));
+	if (!_timer.isActive()) {
+		_timer.callEach(kTick);
+	}
+	report();
+}
+
+void Runner::tick() {
+	const auto self = shared_from_this();
+	if (!alive()) {
+		cancel();
+	} else if (crl::now() >= _waitTill) {
+		clearWait();
+	} else {
+		report();
+	}
+}
+
+void Runner::clearWait() {
+	_timer.cancel();
+	_waiting.clear();
+	if (_waitTill) {
+		_waitTill = 0;
+		report();
+	}
+}
+
+void Runner::report() {
+	if (_finished || !_batch.progress) {
+		return;
+	}
+	const auto left = _waitTill ? (_waitTill - crl::now()) : crl::time();
+	const auto wait = int((std::max(left, crl::time()) + 999) / 1000);
+	if (_shown == wait && wait > 0) {
+		return;
+	}
+	_shown = wait;
+	_batch.progress({ .index = _index, .wait = wait });
+}
+
+void Runner::cancel() {
+	if (_finished) {
+		return;
+	}
+	_result.cancelled = true;
+	const auto waiting = base::take(_waiting);
+	const auto session = _session.get();
+	finish();
+	if (session) {
+		for (const auto requestId : waiting) {
+			session->mtp().cancel(requestId);
+		}
+	}
+}
+
+void Runner::finish() {
+	if (_finished) {
+		return;
+	}
+	_finished = true;
+	_timer.cancel();
+	_lifetime.destroy();
+	if (const auto finished = base::take(_batch.finished)) {
+		finished(base::take(_result));
+	}
+}
+
+} // namespace
+
+void RunGiftBatch(GiftBatch &&batch) {
+	std::make_shared<Runner>(std::move(batch))->start();
+}
+
+QString GiftBatchWait(int seconds) {
+	return Ui::FormatDurationText(seconds);
+}
+
+QString GiftErrorReason(const QString &type) {
+	if (type.isEmpty()) {
+		return Lower(u"Failed"_q);
+	} else if (type == u"STARGIFT_USAGE_LIMITED"_q) {
+		return tr::lng_gift_sold_out_title(tr::now);
+	} else if (type == u"USER_DISALLOWED_STARGIFTS"_q) {
+		return tr::lng_edit_privacy_gifts_restricted(tr::now);
+	} else if (type == u"STARGIFT_MESSAGE_INVALID"_q) {
+		return tr::lng_gift_send_message_restricted(tr::now);
+	} else if (type == u"STARGIFT_ALREADY_BURNED"_q) {
+		return tr::lng_gift_burned_message(tr::now);
+	} else if (type.startsWith(u"STARGIFT_TRANSFER_TOO_EARLY_"_q)) {
+		return Lower(u"Can't be transferred yet"_q);
+	} else if (type.startsWith(u"STARGIFT_RESELL_TOO_EARLY_"_q)) {
+		return Lower(u"Can't be sold yet"_q);
+	}
+	return type;
+}
+
+QString GiftBatchText(
+		const GiftBatchResult &result,
+		int total,
+		const QString &success) {
+	auto reasons = QStringList();
+	for (const auto &error : result.errors) {
+		const auto reason = GiftErrorReason(error);
+		if (!reasons.contains(reason)) {
+			reasons.push_back(reason);
+		}
+	}
+	const auto skipped = int(result.skipped.size());
+	const auto skips = skipped
+		? Lower(u"%1 skipped: %2"_q).arg(skipped).arg(reasons.join(u"; "_q))
+		: QString();
+	if (result.cancelled) {
+		const auto text = Lower(u"Cancelled after %1 of %2."_q)
+			.arg(result.done + skipped)
+			.arg(total);
+		return skips.isEmpty() ? text : (text + ' ' + skips);
+	} else if (result.failed) {
+		return Lower(u"Stopped after %1 of %2: %3"_q)
+			.arg(result.done)
+			.arg(total)
+			.arg(GiftErrorReason(result.error));
+	} else if (skipped) {
+		return Lower(u"%1 done, %2"_q).arg(result.done).arg(skips);
+	}
+	return success;
+}
+
+} // namespace Tele
