+};
+
+struct GiftBatchResult {
+	int done = 0;
+	std::vector<int> skipped;
+	std::vector<QString> errors;
+	QString error;
+	bool failed = false;
+	bool cancelled = false;
+};
+
+struct GiftBatch {
+	not_null<Main::Session*> session;
+	int total = 0;
+	bool skipFailed = false;
+	Fn<bool()> alive;
+	Fn<void(int, Fn<void(bool, QString)>)> step;
+	Fn<void(GiftBatchProgress)> progress;
+	Fn<void(GiftBatchResult)> finished;
+};
+
+void RunGiftBatch(GiftBatch &&batch);
+
+[[nodiscard]] QString GiftBatchWait(int seconds);
+[[nodiscard]] QString GiftErrorReason(const QString &type);
+[[nodiscard]] QString GiftBatchText(
+	const GiftBatchResult &result,
+	int total,
+	const QString &success);
+
+} // namespace Tele
