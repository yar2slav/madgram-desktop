diff --git a/Telegram/SourceFiles/tele/tele_confirm_send.cpp b/Telegram/SourceFiles/tele/tele_confirm_send.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..950291bb74e04f0f398c123f22d99b2befeb6941
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_confirm_send.cpp
@@ -0,0 +1,236 @@
+#include "tele/tele_confirm_send.h"
+
+#include "base/event_filter.h"
+#include "base/timer.h"
+#include "data/data_document.h"
+#include "inline_bots/inline_bot_layout_item.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/painter.h"
+#include "ui/toast/toast.h"
+#include "styles/palette.h"
+#include "styles/style_basic.h"
+
+#include <QtCore/QPointer>
+#include <QtGui/QCursor>
+#include <QtGui/QKeyEvent>
+#include <QtGui/QMouseEvent>
+
+namespace Tele {
+namespace {
+
+constexpr auto kTimeout = 5 * crl::time(1000);
+constexpr auto kToastDuration = crl::time(1500);
+constexpr auto kPanelProperty = "teleConfirmSend";
+
+class Selection final : public QObject {
+public:
+	Selection(not_null<QWidget*> list, const void *key);
+
+	[[nodiscard]] bool matches(
+		not_null<const QWidget*> list,
+		const void *key) const;
+	void finish();
+
+private:
+	void clickAgain();
+
+	const not_null<QWidget*> _list;
+	const void *_key = nullptr;
+	const QPoint _globalPosition;
+	base::Timer _timer;
+	base::weak_ptr<Ui::Toast::Instance> _toast;
+
+};
+
+QPointer<Selection> Current;
+
+void Clear() {
+	if (const auto selection = Current.data()) {
+		Current = nullptr;
+		selection->finish();
+		selection->deleteLater();
+	}
+}
+
+Selection::Selection(not_null<QWidget*> list, const void *key)
+: QObject(list.get())
+, _list(list)
+, _key(key)
+, _globalPosition(QCursor::pos())
+, _timer([=] {
+	if (Current == this) {
+		Clear();
+	}
+}) {
+	_timer.callOnce(kTimeout);
+	base::install_event_filter(this, list, [=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::Hide && Current == this) {
+			Clear();
+		}
+		return base::EventFilterResult::Continue;
+	});
+	base::install_event_filter(
+		this,
+		QCoreApplication::instance(),
+		[=](not_null<QEvent*> e) {
+			if (e->type() != QEvent::KeyPress || Current != this) {
+				return base::EventFilterResult::Continue;
+			}
+			const auto key = static_cast<QKeyEvent*>(e.get())->key();
+			if (key == Qt::Key_Escape) {
+				Clear();
+			} else if (key == Qt::Key_Enter || key == Qt::Key_Return) {
+				clickAgain();
+			} else {
+				return base::EventFilterResult::Continue;
+			}
+			return base::EventFilterResult::Cancel;
+		});
+	_toast = Ui::Toast::Show(list->window(), Ui::Toast::Config{
+		.text = TextWithEntities{ Lower(u"Click again to send"_q) },
+		.duration = kToastDuration,
+	});
+	list->update();
+}
+
+bool Selection::matches(not_null<const QWidget*> list, const void *key) const {
+	return (_list.get() == list.get()) && (_key == key);
+}
+
+void Selection::finish() {
+	_timer.cancel();
+	if (const auto toast = _toast.get()) {
+		toast->hideAnimated();
+	}
+	_list->update();
+}
+
+void Selection::clickAgain() {
+	const auto list = QPointer<QWidget>(_list.get());
+	const auto local = list->mapFromGlobal(_globalPosition);
+	auto press = QMouseEvent(
+		QEvent::MouseButtonPress,
+		local,
+		_globalPosition,
+		Qt::LeftButton,
+		Qt::LeftButton,
+		Qt::NoModifier);
+	auto release = QMouseEvent(
+		QEvent::MouseButtonRelease,
+		local,
+		_globalPosition,
+		Qt::LeftButton,
+		Qt::NoButton,
+		Qt::NoModifier);
+	QCoreApplication::sendEvent(list.data(), &press);
+	if (list) {
+		QCoreApplication::sendEvent(list.data(), &release);
+	}
+}
+
+[[nodiscard]] bool Confirmed(not_null<QWidget*> list, const void *key) {
+	if (Current && Current->matches(list, key)) {
+		Clear();
+		return true;
+	}
+	Clear();
+	Current = new Selection(list, key);
+	return false;
+}
+
+[[nodiscard]] bool InMarkedPanel(not_null<QWidget*> list) {
+	for (auto w = list->parentWidget(); w; w = w->parentWidget()) {
+		if (w->property(kPanelProperty).toBool()) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] bool NeedsConfirmation(
+		const InlineBots::Layout::ItemBase *item,
+		const std::shared_ptr<ClickHandler> &handler) {
+	using InlineBots::Layout::SendClickHandler;
+	if (!item || !dynamic_cast<SendClickHandler*>(handler.get())) {
+		return false;
+	}
+	const auto document = item->getDocument()
+		? item->getDocument()
+		: item->getPreviewDocument();
+	if (!document) {
+		return false;
+	} else if (document->sticker()) {
+		return ConfirmStickers();
+	}
+	return (document->isGifv() || document->isAnimation()) && ConfirmGifs();
+}
+
+} // namespace
+
+void MarkConfirmSendPanel(not_null<QWidget*> panel) {
+	panel->setProperty(kPanelProperty, true);
+}
+
+bool PanelStickerClickConfirmed(
+		not_null<QWidget*> list,
+		not_null<DocumentData*> document) {
+	if (!ConfirmStickers() || !InMarkedPanel(list)) {
+		return true;
+	}
+	return Confirmed(list, document.get());
+}
+
+bool SuggestionClickConfirmed(
+		not_null<QWidget*> list,
+		not_null<DocumentData*> document) {
+	if (!ConfirmStickers()) {
+		return true;
+	}
+	return Confirmed(list, document.get());
+}
+
+bool PanelGifClickConfirmed(
+		not_null<QWidget*> list,
+		const InlineBots::Layout::ItemBase *item,
+		const std::shared_ptr<ClickHandler> &handler) {
+	if (!NeedsConfirmation(item, handler) || !InMarkedPanel(list)) {
+		return true;
+	}
+	return Confirmed(list, item);
+}
+
+bool InlineResultClickConfirmed(
+		not_null<QWidget*> list,
+		const InlineBots::Layout::ItemBase *item,
+		const std::shared_ptr<ClickHandler> &handler) {
+	if (!NeedsConfirmation(item, handler)) {
+		return true;
+	}
+	return Confirmed(list, item);
+}
+
+void PaintSendSelection(
+		QPainter &p,
+		not_null<const QWidget*> list,
+		const void *key,
+		QRect rect) {
+	if (!Current || !Current->matches(list, key)) {
+		return;
+	}
+	const auto line = st::lineWidth * 2;
+	auto fill = st::windowActiveTextFg->c;
+	fill.setAlphaF(0.15);
+	p.save();
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(QPen(st::windowActiveTextFg->c, line));
+	p.setBrush(fill);
+	const auto half = line / 2.;
+	p.drawRoundedRect(
+		QRectF(rect).marginsRemoved({ half, half, half, half }),
+		st::roundRadiusLarge,
+		st::roundRadiusLarge);
+	p.restore();
+}
+
+} // namespace Tele
