+#pragma once
+
+class ClickHandler;
+class DocumentData;
+
+namespace InlineBots::Layout {
+class ItemBase;
+} // namespace InlineBots::Layout
+
+namespace Tele {
+
+void MarkConfirmSendPanel(not_null<QWidget*> panel);
+
+[[nodiscard]] bool PanelStickerClickConfirmed(
+	not_null<QWidget*> list,
+	not_null<DocumentData*> document);
+[[nodiscard]] bool SuggestionClickConfirmed(
+	not_null<QWidget*> list,
+	not_null<DocumentData*> document);
+[[nodiscard]] bool PanelGifClickConfirmed(
+	not_null<QWidget*> list,
+	const InlineBots::Layout::ItemBase *item,
+	const std::shared_ptr<ClickHandler> &handler);
+[[nodiscard]] bool InlineResultClickConfirmed(
+	not_null<QWidget*> list,
+	const InlineBots::Layout::ItemBase *item,
+	const std::shared_ptr<ClickHandler> &handler);
+
+void PaintSendSelection(
+	QPainter &p,
+	not_null<const QWidget*> list,
+	const void *key,
+	QRect rect);
+
+} // namespace Tele
