+class Highlighter final : public QSyntaxHighlighter {
+public:
+	Highlighter(not_null<QTextDocument*> document, bool window);
+
+protected:
+	void highlightBlock(const QString &text) override;
+
+private:
+	const bool _window = false;
+
+};
+
+Highlighter::Highlighter(not_null<QTextDocument*> document, bool window)
+: QSyntaxHighlighter(document.get())
+, _window(window) {
+}
+
+void Highlighter::highlightBlock(const QString &text) {
+	for (const auto &span : Titles::Parse(text, _window).spans) {
+		auto format = QTextCharFormat();
+		format.setForeground(SpanColor(span.type));
+		setFormat(span.from, span.till - span.from, format);
+	}
+}
+
+void PaintChips(not_null<QTextEdit*> edit, bool window) {
+	const auto document = edit->document();
+	const auto layout = document->documentLayout();
+	const auto shift = QPoint(
+		-edit->horizontalScrollBar()->value(),
+		-edit->verticalScrollBar()->value());
+	const auto padding = style::ConvertScale(2);
+	const auto radius = st::roundRadiusSmall;
+	auto p = QPainter(edit->viewport());
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	for (auto block = document->begin(); block.isValid(); block = block.next()) {
+		const auto lines = block.layout();
+		if (!lines) {
+			continue;
+		}
+		const auto origin = layout->blockBoundingRect(block).topLeft()
+			+ QPointF(shift);
+		const auto count = std::max(lines->lineCount(), 0);
+		for (const auto &span : Titles::Parse(block.text(), window).spans) {
+			if (span.type == Titles::SpanType::Bracket) {
+				continue;
+			}
+			auto color = SpanColor(span.type);
+			color.setAlpha(40);
+			p.setBrush(color);
+			for (auto i = 0; i != count; ++i) {
+				const auto line = lines->lineAt(i);
+				const auto lineFrom = line.textStart();
+				const auto lineTill = lineFrom + line.textLength();
+				const auto from = std::max(span.from, lineFrom);
+				const auto till = std::min(span.till, lineTill);
+				if (from >= till) {
+					continue;
+				}
+				const auto left = line.cursorToX(from);
+				const auto right = line.cursorToX(till);
+				p.drawRoundedRect(
+					QRectF(
+						origin.x() + left - padding,
+						origin.y() + line.y(),
+						right - left + 2 * padding,
+						line.height()),
+					radius,
+					radius);
+			}
+		}
+	}
+}
+
+class Palette final
+	: public Ui::RpWidget
+	, public Ui::AbstractTooltipShower {
+public:
+	Palette(
+		QWidget *parent,
+		std::vector<Group> groups,
+		Fn<QString(const QString &token)> value,
+		Fn<void(const QString &token)> insert);
+
+	QString tooltipText() const override;
+	QPoint tooltipPos() const override;
+	bool tooltipWindowActive() const override;
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void contextMenuEvent(QContextMenuEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+
+private:
+	struct Chip {
+		QString name;
+		std::vector<QString> variants;
+		int row = 0;
+		int width = 0;
+		QRect rect;
+	};
+
+	[[nodiscard]] int chipAt(QPoint point) const;
+	void select(int index);
+	void showMenu(int index);
+
+	const style::font &_font;
+	const int _height = 0;
+	const int _padding = 0;
+	const int _skip = 0;
+	const int _rowSkip = 0;
+	const Fn<QString(const QString &token)> _value;
+	const Fn<void(const QString &token)> _insert;
+	std::vector<QString> _titles;
+	std::vector<int> _titleTops;
+	std::vector<Chip> _chips;
+	int _captionWidth = 0;
+	int _selected = -1;
+	int _pressed = -1;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+
+};
+
+Palette::Palette(
+	QWidget *parent,
+	std::vector<Group> groups,
+	Fn<QString(const QString &token)> value,
+	Fn<void(const QString &token)> insert)
+: RpWidget(parent)
+, _font(st::normalFont)
+, _height(st::normalFont->height + style::ConvertScale(8))
+, _padding(style::ConvertScale(10))
+, _skip(style::ConvertScale(6))
+, _rowSkip(style::ConvertScale(10))
+, _value(std::move(value))
+, _insert(std::move(insert)) {
+	for (auto &group : groups) {
+		const auto row = int(_titles.size());
+		_titles.push_back(Lower(group.title));
+		_captionWidth = std::max(_captionWidth, _font->width(_titles.back()));
+		for (auto &variable : group.variables) {
+			const auto width = _font->width(variable.name) + 2 * _padding;
+			_chips.push_back({
+				.name = std::move(variable.name),
+				.variants = std::move(variable.variants),
+				.row = row,
+				.width = width,
+			});
+		}
+	}
+	_captionWidth += style::ConvertScale(14);
+	_titleTops.resize(_titles.size());
+	setMouseTracking(true);
+}
+
+int Palette::resizeGetHeight(int newWidth) {
+	auto top = 0;
+	auto left = _captionWidth;
+	auto row = -1;
+	for (auto &chip : _chips) {
+		if (chip.row != row) {
+			if (row >= 0) {
+				top += _height + _rowSkip;
+			}
+			row = chip.row;
+			_titleTops[row] = top;
+			left = _captionWidth;
+		} else if (left + chip.width > newWidth && left > _captionWidth) {
+			top += _height + _skip;
+			left = _captionWidth;
+		}
+		chip.rect = QRect(left, top, chip.width, _height);
+		left += chip.width + _skip;
+	}
+	return _chips.empty() ? 0 : (top + _height);
+}
+
+void Palette::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setFont(_font);
+	const auto baseline = (_height - _font->height) / 2 + _font->ascent;
+	p.setPen(st::windowSubTextFg);
+	for (auto i = 0, count = int(_titles.size()); i != count; ++i) {
+		p.drawText(0, _titleTops[i] + baseline, _titles[i]);
+	}
+	const auto radius = _height / 2.;
+	for (auto i = 0, count = int(_chips.size()); i != count; ++i) {
+		const auto &chip = _chips[i];
+		p.setPen(Qt::NoPen);
+		p.setBrush((i == _selected)
+			? st::lightButtonBgRipple
+			: st::lightButtonBgOver);
+		p.drawRoundedRect(chip.rect, radius, radius);
+		p.setPen(st::lightButtonFg);
+		p.drawText(
+			chip.rect.x() + _padding,
+			chip.rect.y() + baseline,
+			chip.name);
+	}
+}
+
+int Palette::chipAt(QPoint point) const {
+	for (auto i = 0, count = int(_chips.size()); i != count; ++i) {
+		if (_chips[i].rect.contains(point)) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+void Palette::select(int index) {
+	if (_selected == index) {
+		return;
+	}
+	_selected = index;
+	setCursor((index >= 0) ? style::cur_pointer : style::cur_default);
+	update();
+	if (index >= 0) {
+		Ui::Tooltip::Show(800, this);
+	} else {
+		Ui::Tooltip::Hide();
+	}
+}
+
+void Palette::mouseMoveEvent(QMouseEvent *e) {
+	select(chipAt(e->pos()));
+}
+
+void Palette::mousePressEvent(QMouseEvent *e) {
+	_pressed = (e->button() == Qt::LeftButton) ? chipAt(e->pos()) : -1;
+}
+
+void Palette::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = std::exchange(_pressed, -1);
+	if (e->button() == Qt::LeftButton
+		&& pressed >= 0
+		&& pressed == chipAt(e->pos())) {
+		_insert(MakeToken(_chips[pressed].name, QString()));
+	}
+}
+
+void Palette::contextMenuEvent(QContextMenuEvent *e) {
+	const auto index = chipAt(e->pos());
+	if (index >= 0) {
+		showMenu(index);
+	}
+}
+
+void Palette::leaveEventHook(QEvent *e) {
+	select(-1);
+}
+
+void Palette::showMenu(int index) {
+	Ui::Tooltip::Hide();
+	_menu = base::make_unique_q<Ui::PopupMenu>(this, st::defaultPopupMenu);
+	const auto &chip = _chips[index];
+	for (const auto &variant : chip.variants) {
+		const auto token = MakeToken(chip.name, variant);
+		const auto value = _value(token);
+		const auto insert = _insert;
+		_menu->addAction(
+			(value.isEmpty() ? Lower(u"Empty now"_q) : value)
+				+ QChar('\t')
+				+ token,
+			[=] { insert(token); });
+	}
+	_menu->popup(QCursor::pos());
+}
+
+QString Palette::tooltipText() const {
+	if (_selected < 0) {
+		return QString();
+	}
+	const auto value = _value(MakeToken(_chips[_selected].name, QString()));
+	return value.isEmpty() ? Lower(u"Empty now"_q) : value;
+}
+
+QPoint Palette::tooltipPos() const {
+	return QCursor::pos();
+}
+
+bool Palette::tooltipWindowActive() const {
+	return Ui::AppInFocus() && Ui::InFocusChain(window());
+}
+
+[[nodiscard]] style::margins RowMargins(int top) {
+	return style::margins(
+		st::boxRowPadding.left(),
+		top,
+		st::boxRowPadding.right(),
+		0);
+}
