+void TitleTemplateBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::Controller*> window,
+		bool windowTitle) {
+	const auto option = &base::options::lookup<QString>(windowTitle
+		? kOptionWindowTitleTemplate
+		: kOptionTitleTemplate);
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(windowTitle
+		? u"Window title"_q
+		: u"Title bar label"_q)));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Template"_q)),
+		option->value()));
+	const auto edit = field->rawTextEdit();
+	const auto highlighter = new Highlighter(edit->document(), windowTitle);
+	base::install_event_filter(edit->viewport(), [=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::Paint) {
+			PaintChips(edit, windowTitle);
+		}
+		return base::EventFilterResult::Continue;
+	}, field->lifetime());
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		highlighter->rehighlight();
+	}, field->lifetime());
+	const auto preview = box->addRow(
+		object_ptr<Ui::FlatLabel>(box, QString(), st::boxLabel),
+		RowMargins(st::boxRowPadding.left() / 2));
+	const auto error = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			box,
+			object_ptr<Ui::FlatLabel>(box, QString(), st::boxDividerLabel)),
+		RowMargins(st::boxRowPadding.left() / 3));
+	error->entity()->setTextColorOverride(st::boxTextFgError->c);
+	error->hide(anim::type::instant);
+	const auto refreshPreview = [=] {
+		const auto source = field->getLastText();
+		const auto text = windowTitle
+			? PreviewWindowTitleText(window, source)
+			: PreviewTitleText(window, source);
+		preview->setText(!text.isEmpty()
+			? text
+			: !windowTitle
+			? Lower(u"No label"_q)
+			: source.isEmpty()
+			? Lower(u"Default title"_q)
+			: Lower(u"Empty title"_q));
+	};
+	const auto refresh = [=] {
+		refreshPreview();
+		const auto errors = Titles::Parse(
+			field->getLastText(),
+			windowTitle).errors;
+		if (!errors.isEmpty()) {
+			error->entity()->setText(errors.join('\n'));
+		}
+		error->toggle(!errors.isEmpty(), anim::type::normal);
+	};
+	const auto setTemplate = [=](const QString &text) {
+		field->setText(text);
+		field->setCursorPosition(int(text.size()));
+		field->setFocusFast();
+		refresh();
+	};
+	const auto links = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		RowMargins(st::boxRowPadding.left() / 2));
+	const auto presets = Ui::CreateChild<Ui::LinkButton>(
+		links,
+		Lower(u"Presets"_q),
+		st::boxLinkButton);
+	links->resize(links->width(), presets->height());
+	const auto menu = box->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	presets->setClickedCallback([=] {
+		*menu = base::make_unique_q<Ui::PopupMenu>(
+			presets,
+			st::defaultPopupMenu);
+		for (const auto &preset : Presets(windowTitle)) {
+			(*menu)->addAction(
+				!preset.isEmpty()
+					? preset
+					: windowTitle
+					? Lower(u"Default title"_q)
+					: Lower(u"No label"_q),
+				[=] { setTemplate(preset); });
+		}
+		(*menu)->popup(presets->mapToGlobal(QPoint(0, presets->height())));
+	});
+	box->addRow(
+		object_ptr<Palette>(
+			box,
+			Groups(windowTitle),
+			[=](const QString &token) {
+				return windowTitle
+					? PreviewWindowTitleText(window, token)
+					: PreviewTitleText(window, token);
+			},
+			[=](const QString &token) {
+				field->rawTextEdit()->insertPlainText(token);
+				field->setFocusFast();
+			}),
+		RowMargins(st::boxRowPadding.left() / 2));
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"Click a variable to insert it, right-click it for other "
+				"forms. Modifiers go after |, left to right: lower, upper, "
+				"title, cap, short, first, last, max:20, pad:2, k, "
+				"default:text. [ \u2026 ] hides its part when a variable "
+				"inside is empty or 0, doubled brackets are literal."_q),
+			st::boxDividerLabel),
+		RowMargins(st::boxRowPadding.left() / 2));
+	if (windowTitle) {
+		box->addRow(
+			object_ptr<Ui::FlatLabel>(
+				box,
+				Lower(u"The title Windows, macOS and Linux show in the "
+					"taskbar, Alt+Tab and the system window frame. Empty "
+					"keeps the default title, a template that renders to "
+					"nothing leaves the title blank."_q),
+				st::boxDividerLabel),
+			RowMargins(st::boxRowPadding.left() / 3));
+	}
+	const auto timer = box->lifetime().make_state<base::Timer>(
+		refreshPreview);
+	timer->callEach(crl::time(1000));
+	field->changes(
+	) | rpl::on_next(refresh, field->lifetime());
+	refresh();
+	const auto save = [=] {
+		option->set(field->getLastText());
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Reset"_q)), [=] {
+		setTemplate(option->defaultValue());
+	});
+}
+
+} // namespace Tele
