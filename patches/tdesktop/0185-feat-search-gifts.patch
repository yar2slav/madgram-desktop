+struct GiftListSearch::State {
+	State(
+		not_null<Ui::RpWidget*> parent,
+		not_null<PeerData*> peer,
+		Fn<void()> changed);
+
+	void load();
+	void done(const MTPpayments_SavedStarGifts &result);
+	void applyUpdate(const Data::GiftUpdate &update);
+	void applyUpdate(const Data::GiftsUpdate &update);
+	void queryChanged(const QString &query);
+	void refreshChips();
+	void paintChips();
+	void selectChip(QPoint position);
+	void showMenu(int index);
+	void toggle(int index, const QString &name);
+	void clear(int index);
+	[[nodiscard]] bool active() const;
+	[[nodiscard]] bool matches(const Item &item) const;
+	[[nodiscard]] std::vector<Value> values(int index) const;
+
+	const not_null<PeerData*> peer;
+	const Fn<void()> changed;
+	MTP::Sender api;
+	std::vector<Item> items;
+	base::flat_set<Data::SavedStarGiftId> ids;
+	QString offset;
+	mtpRequestId requestId = 0;
+	bool started = false;
+	bool loaded = false;
+	QStringList words;
+	std::array<base::flat_set<QString>, kChipsCount> selected;
+	std::array<Chip, kChipsCount> chips;
+	int selectedChip = -1;
+	int pressedChip = -1;
+	int rowHeight = 0;
+	base::unique_qptr<Ui::RpWidget> bar;
+	Ui::MultiSelect *select = nullptr;
+	Ui::RpWidget *row = nullptr;
+	base::unique_qptr<Ui::PopupMenu> menu;
+	rpl::lifetime lifetime;
+};
+
+GiftListSearch::State::State(
+	not_null<Ui::RpWidget*> parent,
+	not_null<PeerData*> peer,
+	Fn<void()> changed)
+: peer(peer)
+, changed(std::move(changed))
+, api(&peer->session().mtp())
+, bar(base::make_unique_q<Ui::RpWidget>(parent)) {
+	select = Ui::CreateChild<Ui::MultiSelect>(
+		bar.get(),
+		st::defaultMultiSelect,
+		tr::lng_dlg_filter() | rpl::map(Lower));
+	row = Ui::CreateChild<Ui::RpWidget>(bar.get());
+
+	select->setQueryChangedCallback([=](const QString &query) {
+		queryChanged(query);
+	});
+	select->setCancelledCallback([=] {
+		select->clearQuery();
+	});
+
+	const auto padding = st::giftBoxTabPadding;
+	rowHeight = st::giftBoxResaleTabsMargin.top()
+		+ st::giftBoxTabStyle.font->height
+		+ padding.top()
+		+ padding.bottom();
+	refreshChips();
+
+	row->setMouseTracking(true);
+	row->events() | rpl::on_next([=](not_null<QEvent*> e) {
+		switch (e->type()) {
+		case QEvent::Leave: {
+			selectedChip = -1;
+			row->setCursor(style::cur_default);
+		} break;
+		case QEvent::MouseMove: {
+			selectChip(static_cast<QMouseEvent*>(e.get())->pos());
+		} break;
+		case QEvent::MouseButtonPress: {
+			const auto me = static_cast<QMouseEvent*>(e.get());
+			if (me->button() == Qt::LeftButton) {
+				selectChip(me->pos());
+				pressedChip = selectedChip;
+			}
+		} break;
+		case QEvent::MouseButtonRelease: {
+			const auto me = static_cast<QMouseEvent*>(e.get());
+			if (me->button() != Qt::LeftButton) {
+				break;
+			}
+			const auto pressed = std::exchange(pressedChip, -1);
+			if (pressed >= 0 && pressed == selectedChip) {
+				showMenu(pressed);
+			}
+		} break;
+		default: break;
+		}
+	}, row->lifetime());
+
+	row->paintRequest() | rpl::on_next([=] {
+		paintChips();
+	}, row->lifetime());
+
+	peer->owner().giftUpdates(
+	) | rpl::on_next([=](const Data::GiftUpdate &update) {
+		applyUpdate(update);
+	}, lifetime);
+
+	peer->owner().giftsUpdates(
+	) | rpl::on_next([=](const Data::GiftsUpdate &update) {
+		applyUpdate(update);
+	}, lifetime);
+
+	row->show();
+	select->show();
+	bar->show();
+}
+
+void GiftListSearch::State::load() {
+	if (requestId || loaded) {
+		return;
+	}
+	if (!started) {
+		started = true;
+		Ui::PreloadUniqueGiftResellPrices(&peer->session());
+	}
+	using Flag = MTPpayments_GetSavedStarGifts::Flag;
+	requestId = api.request(MTPpayments_GetSavedStarGifts(
+		MTP_flags(Flag::f_exclude_unlimited
+			| Flag::f_exclude_unupgradable
+			| Flag::f_exclude_upgradable),
+		peer->input(),
+		MTP_int(0),
+		MTP_string(offset),
+		MTP_int(kPerPage)
+	)).done([=](const MTPpayments_SavedStarGifts &result) {
+		requestId = 0;
+		done(result);
+	}).fail([=] {
+		requestId = 0;
+		row->update();
+	}).send();
+	row->update();
+}
+
+void GiftListSearch::State::done(const MTPpayments_SavedStarGifts &result) {
+	const auto &data = result.data();
+	const auto owner = &peer->owner();
+	owner->processUsers(data.vusers());
+	owner->processChats(data.vchats());
+
+	const auto &list = data.vgifts().v;
+	for (const auto &gift : list) {
+		auto parsed = Api::FromTL(peer, gift);
+		if (!parsed || !parsed->info.unique) {
+			continue;
+		} else if (parsed->manageId && !ids.emplace(parsed->manageId).second) {
+			continue;
+		}
+		items.push_back(MakeItem(std::move(*parsed)));
+	}
+	const auto next = data.vnext_offset()
+		? qs(*data.vnext_offset())
+		: QString();
+	if (next.isEmpty() || list.isEmpty()) {
+		loaded = true;
+	} else {
+		offset = next;
+	}
+	row->update();
+	if (active()) {
+		changed();
+	}
+	load();
+}
+
+void GiftListSearch::State::applyUpdate(const Data::GiftUpdate &update) {
+	const auto byId = [](const Item &item) {
+		return item.gift.manageId;
+	};
+	const auto bySlug = [](const Item &item) {
+		return item.gift.info.unique->slug;
+	};
+	const auto i = update.id
+		? ranges::find(items, update.id, byId)
+		: ranges::find(items, update.slug, bySlug);
+	if (i == end(items)) {
+		return;
+	}
+	using Action = Data::GiftUpdate::Action;
+	switch (update.action) {
+	case Action::Convert:
+	case Action::Transfer:
+	case Action::Delete:
+		ids.remove(i->gift.manageId);
+		items.erase(i);
+		break;
+	case Action::Save: i->gift.hidden = false; break;
+	case Action::Unsave: i->gift.hidden = true; break;
+	case Action::Pin: i->gift.pinned = true; break;
+	case Action::Unpin: i->gift.pinned = false; break;
+	default: break;
+	}
+}
+
+void GiftListSearch::State::applyUpdate(const Data::GiftsUpdate &update) {
+	if (update.peer != peer) {
+		return;
+	}
+	const auto id = update.collectionId;
+	for (auto &item : items) {
+		auto &list = item.gift.collectionIds;
+		if (ranges::contains(update.added, item.gift.manageId)) {
+			if (!ranges::contains(list, id)) {
+				list.push_back(id);
+			}
+		} else if (ranges::contains(update.removed, item.gift.manageId)) {
+			list.erase(ranges::remove(list, id), end(list));
+		}
+	}
+}
+
+void GiftListSearch::State::queryChanged(const QString &query) {
+	auto now = query.simplified().toLower().split(
+		QChar(' '),
+		Qt::SkipEmptyParts);
+	if (now == words) {
+		return;
+	}
+	words = std::move(now);
+	if (!words.isEmpty()) {
+		load();
+	}
+	changed();
+}
+
+void GiftListSearch::State::refreshChips() {
+	const auto margin = st::giftBoxResaleTabsMargin;
+	const auto padding = st::giftBoxTabPadding;
+	auto x = margin.left();
+	for (auto i = 0; i != kChipsCount; ++i) {
+		auto &chip = chips[i];
+		const auto &list = selected[i];
+		const auto name = (list.size() == 1)
+			? list.front()
+			: Lower(ChipName(i, int(list.size())));
+		chip.text.setMarkedText(
+			st::semiboldTextStyle,
+			TextWithEntities{ name }.append(st::giftBoxResaleTabsDropdown),
+			kMarkupTextOptions);
+		const auto size = QRect(
+			0,
+			0,
+			chip.text.maxWidth(),
+			st::giftBoxTabStyle.font->height).marginsAdded(padding).size();
+		chip.geometry = QRect(QPoint(x, margin.top()), size);
+		x += size.width() + st::giftBoxResaleTabSkip;
+	}
+	row->update();
+}
+
+void GiftListSearch::State::paintChips() {
+	auto p = QPainter(row);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto padding = st::giftBoxTabPadding;
+	for (const auto &chip : chips) {
+		p.setBrush(st::giftBoxTabBgActive);
+		p.setPen(Qt::NoPen);
+		const auto radius = chip.geometry.height() / 2.;
+		p.drawRoundedRect(chip.geometry, radius, radius);
+		p.setPen(st::giftBoxTabFgActive);
+		chip.text.draw(p, {
+			.position = chip.geometry.marginsRemoved(padding).topLeft(),
+			.availableWidth = chip.text.maxWidth(),
+		});
+	}
+	if (!requestId) {
+		return;
+	}
+	const auto text = items.empty()
+		? Lower(tr::lng_contacts_loading(tr::now))
+		: Lower(u"Loading %1..."_q.arg(
+			Lang::FormatCountDecimal(int64(items.size()))));
+	const auto &last = chips.back().geometry;
+	const auto left = last.x() + last.width() + st::giftBoxResaleTabSkip;
+	const auto available = row->width()
+		- st::giftBoxResaleTabsMargin.right()
+		- left;
+	if (available <= 0) {
+		return;
+	}
+	const auto &font = st::normalFont;
+	p.setFont(font);
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		QRect(left, last.y(), available, last.height()),
+		font->elided(text, available),
+		style::al_right);
+}
+
+void GiftListSearch::State::selectChip(QPoint position) {
+	auto index = -1;
+	for (auto i = 0; i != kChipsCount; ++i) {
+		if (chips[i].geometry.contains(position)) {
+			index = i;
+			break;
+		}
+	}
+	if ((selectedChip >= 0) != (index >= 0)) {
+		row->setCursor((index >= 0) ? style::cur_pointer : style::cur_default);
+	}
+	selectedChip = index;
+}
+
+void GiftListSearch::State::showMenu(int index) {
+	if (menu) {
+		return;
+	}
+	load();
+	menu = base::make_unique_q<Ui::PopupMenu>(row, st::giftBoxResaleFilter);
+	const auto raw = menu.get();
+	auto context = Core::TextContext({ .session = &peer->session() });
+	context.customEmojiFactory = [original = context.customEmojiFactory](
+			QStringView data,
+			const Ui::Text::MarkedContext &context) {
+		return Ui::GiftResaleColorEmoji::Owns(data)
+			? std::make_unique<Ui::GiftResaleColorEmoji>(data)
+			: original(data, context);
+	};
+	const auto add = [&](
+			TextWithEntities text,
+			Fn<void()> callback,
+			QString emoji,
+			const style::icon *icon,
+			bool checked) {
+		auto action = base::make_unique_q<Ui::GiftResaleFilterAction>(
+			raw->menu(),
+			raw->st().menu,
+			std::move(text),
+			emoji.isEmpty() ? Ui::Text::MarkedContext() : context,
+			emoji,
+			icon);
+		action->setChecked(checked);
+		action->setActionTriggered(std::move(callback));
+		raw->addAction(std::move(action));
+	};
+	const auto &now = selected[index];
+	if (!now.empty()) {
+		add(
+			{ Lower(tr::lng_gift_resale_filter_all(tr::now)) },
+			[=] { clear(index); },
+			QString(),
+			&st::menuIconSelect,
+			false);
+	}
+	for (const auto &value : values(index)) {
+		const auto name = value.name;
+		const auto emoji = (index == 1)
+			? Ui::GiftResaleColorEmoji::DataFor(value.color)
+			: value.document
+			? Data::SerializeCustomEmojiId(value.document->id)
+			: QString();
+		add(
+			tr::marked(name).append(' ').append(
+				tr::bold(Lang::FormatCountDecimal(value.count))),
+			[=] { toggle(index, name); },
+			emoji,
+			nullptr,
+			now.empty() || now.contains(name));
+	}
+	if (raw->empty()) {
+		menu = nullptr;
+		return;
+	}
+	raw->popup(QCursor::pos());
+}
+
+void GiftListSearch::State::toggle(int index, const QString &name) {
+	auto &list = selected[index];
+	if (!list.remove(name)) {
+		list.emplace(name);
+	}
+	refreshChips();
+	changed();
+}
+
+void GiftListSearch::State::clear(int index) {
+	selected[index].clear();
+	refreshChips();
+	changed();
+}
+
+bool GiftListSearch::State::active() const {
+	return !words.isEmpty() || ranges::any_of(selected, [](const auto &list) {
+		return !list.empty();
+	});
+}
+
+bool GiftListSearch::State::matches(const Item &item) const {
+	const auto &unique = *item.gift.info.unique;
+	for (auto i = 0; i != kChipsCount; ++i) {
+		const auto &list = selected[i];
+		if (!list.empty() && !list.contains(AttributeName(unique, i))) {
+			return false;
+		}
+	}
+	for (const auto &word : words) {
+		const auto has = ranges::any_of(item.fields, [&](const QString &f) {
+			return f.contains(word);
+		});
+		if (!has) {
+			return false;
+		}
+	}
+	return true;
+}
+
+std::vector<Value> GiftListSearch::State::values(int index) const {
+	auto map = base::flat_map<QString, Value>();
+	for (const auto &item : items) {
+		const auto &unique = *item.gift.info.unique;
+		const auto &name = AttributeName(unique, index);
+		if (name.isEmpty()) {
+			continue;
+		}
+		auto &value = map[name];
+		if (!value.count) {
+			value.name = name;
+			value.document = (index == 0)
+				? unique.model.document.get()
+				: (index == 2)
+				? unique.pattern.document.get()
+				: nullptr;
+			value.color = unique.backdrop.centerColor;
+		}
+		++value.count;
+	}
+	auto result = std::vector<Value>();
+	result.reserve(map.size());
+	for (auto &[name, value] : map) {
+		result.push_back(std::move(value));
+	}
+	ranges::stable_sort(result, ranges::greater(), &Value::count);
+	return result;
+}
+
+GiftListSearch::GiftListSearch(
+	not_null<Ui::RpWidget*> parent,
+	not_null<PeerData*> peer,
+	Fn<void()> changed)
+: _state(std::make_unique<State>(parent, peer, std::move(changed))) {
+}
+
+GiftListSearch::~GiftListSearch() = default;
+
+bool GiftListSearch::active() const {
+	return _state->active();
+}
+
+int GiftListSearch::resizeGetHeight(int width) {
+	const auto state = _state.get();
+	state->select->resizeToWidth(width);
+	state->select->moveToLeft(0, 0);
+	const auto top = state->select->height();
+	state->row->setGeometry(0, top, width, state->rowHeight);
+	state->bar->setGeometry(0, 0, width, top + state->rowHeight);
+	return state->bar->height();
+}
+
+std::vector<Data::SavedStarGift> GiftListSearch::found(
+		int collectionId,
+		bool skipSaved,
+		bool skipUnsaved) const {
+	auto result = std::vector<Data::SavedStarGift>();
+	for (const auto &item : _state->items) {
+		const auto &gift = item.gift;
+		if ((collectionId
+				&& !ranges::contains(gift.collectionIds, collectionId))
+			|| (skipSaved && !gift.hidden)
+			|| (skipUnsaved && gift.hidden)
+			|| !_state->matches(item)) {
+			continue;
+		}
+		result.push_back(gift);
+	}
+	return result;
+}
+
+std::unique_ptr<Ui::RpWidget> GiftListSearch::createAbout(
+		not_null<Ui::RpWidget*> parent,
+		bool empty) const {
+	if (!empty || !_state->loaded) {
+		return nullptr;
+	}
+	auto result = std::make_unique<Ui::FlatLabel>(
+		parent,
+		Lower(tr::lng_peer_gifts_empty_search(tr::now)),
+		st::giftListAbout);
+	result->show();
+	return result;
+}
+
+std::unique_ptr<GiftListSearch> MakeGiftListSearch(
+		not_null<Ui::RpWidget*> parent,
+		not_null<PeerData*> peer,
+		Fn<void()> changed) {
+	return GiftSearch()
+		? std::make_unique<GiftListSearch>(parent, peer, std::move(changed))
+		: nullptr;
+}
+
+} // namespace Tele
