+constexpr auto kPerPage = 100;
+constexpr auto kChipsCount = 3;
+
+struct Item {
+	Data::SavedStarGift gift;
+	std::array<QString, 5> fields;
+};
+
+struct Value {
+	QString name;
+	int count = 0;
+	DocumentData *document = nullptr;
+	QColor color;
+};
+
+struct Chip {
+	QRect geometry;
+	Ui::Text::String text;
+};
+
+[[nodiscard]] Item MakeItem(Data::SavedStarGift gift) {
+	const auto &unique = *gift.info.unique;
+	auto fields = std::array<QString, 5>{
+		unique.title.toLower(),
+		u"#"_q + QString::number(unique.number),
+		unique.model.name.toLower(),
+		unique.backdrop.name.toLower(),
+		unique.pattern.name.toLower(),
+	};
+	return { .gift = std::move(gift), .fields = std::move(fields) };
+}
+
+[[nodiscard]] const QString &AttributeName(
+		const Data::UniqueGift &unique,
+		int index) {
+	return (index == 0)
+		? unique.model.name
+		: (index == 1)
+		? unique.backdrop.name
+		: unique.pattern.name;
+}
+
+[[nodiscard]] QString ChipName(int index, int count) {
+	if (index == 0) {
+		return count
+			? tr::lng_gift_resale_models(tr::now, lt_count, count)
+			: tr::lng_gift_resale_model(tr::now);
+	} else if (index == 1) {
+		return count
+			? tr::lng_gift_resale_backdrops(tr::now, lt_count, count)
+			: tr::lng_gift_resale_backdrop(tr::now);
+	}
+	return count
+		? tr::lng_gift_resale_symbols(tr::now, lt_count, count)
+		: tr::lng_gift_resale_symbol(tr::now);
+}
