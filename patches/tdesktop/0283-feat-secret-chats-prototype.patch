+	refreshRestriction();
+	setupComposeControls();
+	setupDragArea();
+
+	const auto owner = &_history->owner();
+	owner->newItemAdded(
+	) | rpl::filter([=](not_null<HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+		if (controller->widget()->isActive()) {
+			markRead();
+		}
+	}, lifetime());
+	owner->itemRemoved(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+	owner->historyCleared(
+	) | rpl::filter([=](not_null<const History*> history) {
+		return (history == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+
+	if (const auto manager = this->manager()) {
+		manager->chatChanges(
+		) | rpl::filter(
+			rpl::mappers::_1 == _chatId
+		) | rpl::on_next([=] {
+			if (!chat()) {
+				crl::on_main(this, [=] {
+					controller->showBackFromStack();
+				});
+				return;
+			}
+			refreshRestriction();
+		}, lifetime());
+	}
+
+	Window::SetupSwipeBackSection(this, _scroll.get(), _inner);
+}
+
+Manager *SecretWidget::manager() const {
+	return FindManager(&_history->session());
+}
