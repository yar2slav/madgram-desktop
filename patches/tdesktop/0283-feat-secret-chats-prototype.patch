@@ -0,0 +1,271 @@
+#include "tele/secret/secret_crypto.h"
+
+#include "base/random.h"
+#include "mtproto/mtproto_auth_key.h"
+
+#include <openssl/md5.h>
+#include <openssl/sha.h>
+
+#include <cstring>
+
+namespace Tele::Secret {
+namespace {
+
+constexpr auto kMinPadding = 12;
+constexpr auto kMaxPadding = 1024;
+
+struct Kdf {
+	uchar key[32] = { 0 };
+	uchar iv[32] = { 0 };
+};
+
+[[nodiscard]] const uchar *Raw(const QByteArray &data) {
+	return reinterpret_cast<const uchar*>(data.constData());
+}
+
+[[nodiscard]] Kdf DeriveKdf(const QByteArray &key, const uchar *msgKey, int x) {
+	uchar first[16 + 36];
+	std::memcpy(first, msgKey, 16);
+	std::memcpy(first + 16, Raw(key) + x, 36);
+	uchar a[SHA256_DIGEST_LENGTH];
+	SHA256(first, sizeof(first), a);
+
+	uchar second[36 + 16];
+	std::memcpy(second, Raw(key) + 40 + x, 36);
+	std::memcpy(second + 36, msgKey, 16);
+	uchar b[SHA256_DIGEST_LENGTH];
+	SHA256(second, sizeof(second), b);
+
+	auto result = Kdf();
+	std::memcpy(result.key, a, 8);
+	std::memcpy(result.key + 8, b + 8, 16);
+	std::memcpy(result.key + 24, a + 24, 8);
+	std::memcpy(result.iv, b, 8);
+	std::memcpy(result.iv + 8, a + 8, 16);
+	std::memcpy(result.iv + 24, b + 24, 8);
+	return result;
+}
+
+void ComputeMsgKey(
+		const QByteArray &key,
+		int x,
+		const QByteArray &plain,
+		uchar *msgKey) {
+	auto context = SHA256_CTX();
+	SHA256_Init(&context);
+	SHA256_Update(&context, Raw(key) + 88 + x, 32);
+	SHA256_Update(&context, Raw(plain), plain.size());
+	uchar large[SHA256_DIGEST_LENGTH];
+	SHA256_Final(large, &context);
+	std::memcpy(msgKey, large + 8, 16);
+}
+
+} // namespace
+
+QByteArray RandomBytes(int size) {
+	auto result = QByteArray(size, Qt::Uninitialized);
+	if (size > 0) {
+		base::RandomFill(result.data(), size);
+	}
+	return result;
+}
+
+int64 RandomId() {
+	auto result = int64();
+	while (!result) {
+		result = base::RandomValue<int64>();
+	}
+	return result;
+}
+
+int64 KeyFingerprint(const QByteArray &key) {
+	uchar digest[SHA_DIGEST_LENGTH];
+	SHA1(Raw(key), key.size(), digest);
+	auto result = int64();
+	std::memcpy(&result, digest + 12, sizeof(result));
+	return result;
+}
+
+QByteArray PadKey(const QByteArray &key) {
+	if (key.size() >= kKeySize) {
+		return key.right(kKeySize);
+	}
+	return QByteArray(kKeySize - key.size(), char(0)) + key;
+}
+
+QByteArray KeyVisualHash(const QByteArray &key) {
+	uchar sha1[SHA_DIGEST_LENGTH];
+	SHA1(Raw(key), key.size(), sha1);
+	uchar sha256[SHA256_DIGEST_LENGTH];
+	SHA256(Raw(key), key.size(), sha256);
+	auto result = QByteArray(36, Qt::Uninitialized);
+	std::memcpy(result.data(), sha1, 16);
+	std::memcpy(result.data() + 16, sha256, 20);
+	return result;
+}
+
+int64 PacketFingerprint(const QByteArray &packet) {
+	auto result = int64();
+	if (packet.size() >= 8) {
+		std::memcpy(&result, packet.constData(), sizeof(result));
+	}
+	return result;
+}
+
+QByteArray EncryptPacket(
+		const QByteArray &key,
+		bool creator,
+		const QByteArray &object) {
+	if (key.size() != kKeySize) {
+		return QByteArray();
+	}
+	const auto x = creator ? 0 : 8;
+	const auto extra = int(uchar(RandomBytes(1)[0]));
+	const auto total = (4 + int(object.size()) + kMinPadding + extra + 15)
+		& ~15;
+	auto plain = QByteArray(total, Qt::Uninitialized);
+	const auto length = int32(object.size());
+	std::memcpy(plain.data(), &length, 4);
+	std::memcpy(plain.data() + 4, object.constData(), object.size());
+	const auto padStart = 4 + int(object.size());
+	base::RandomFill(plain.data() + padStart, total - padStart);
+
+	uchar msgKey[16];
+	ComputeMsgKey(key, x, plain, msgKey);
+	const auto kdf = DeriveKdf(key, msgKey, x);
+
+	auto result = QByteArray(8 + 16 + total, Qt::Uninitialized);
+	const auto fingerprint = KeyFingerprint(key);
+	std::memcpy(result.data(), &fingerprint, 8);
+	std::memcpy(result.data() + 8, msgKey, 16);
+	MTP::aesIgeEncryptRaw(
+		plain.constData(),
+		result.data() + 24,
+		uint32(total),
+		kdf.key,
+		kdf.iv);
+	return result;
+}
+
+bool DecryptPacket(
+		const QByteArray &key,
+		bool creator,
+		const QByteArray &packet,
+		QByteArray &object) {
+	if (key.size() != kKeySize || packet.size() < 8 + 16 + 16) {
+		return false;
+	} else if (PacketFingerprint(packet) != KeyFingerprint(key)) {
+		return false;
+	}
+	const auto x = creator ? 8 : 0;
+	const auto size = int(packet.size()) - 24;
+	if (size % 16) {
+		return false;
+	}
+	const auto msgKey = Raw(packet) + 8;
+	const auto kdf = DeriveKdf(key, msgKey, x);
+	auto plain = QByteArray(size, Qt::Uninitialized);
+	MTP::aesIgeDecryptRaw(
+		packet.constData() + 24,
+		plain.data(),
+		uint32(size),
+		kdf.key,
+		kdf.iv);
+
+	uchar expected[16];
+	ComputeMsgKey(key, x, plain, expected);
+	auto diff = 0;
+	for (auto i = 0; i != 16; ++i) {
+		diff |= int(expected[i] ^ msgKey[i]);
+	}
+	if (diff) {
+		return false;
+	}
+	auto length = int32();
+	std::memcpy(&length, plain.constData(), 4);
+	if (length <= 0 || (length & 3) || length > size - 4) {
+		return false;
+	}
+	const auto padding = size - 4 - length;
+	if (padding < kMinPadding || padding > kMaxPadding) {
+		return false;
+	}
+	object = plain.mid(4, length);
+	return true;
+}
+
+int32 FileFingerprint(const QByteArray &key, const QByteArray &iv) {
+	const auto joined = key + iv;
+	uchar digest[MD5_DIGEST_LENGTH];
+	MD5(Raw(joined), joined.size(), digest);
+	auto first = int32();
+	auto second = int32();
+	std::memcpy(&first, digest, 4);
+	std::memcpy(&second, digest + 4, 4);
+	return first ^ second;
+}
+
+QByteArray EncryptFile(
+		const QByteArray &plain,
+		const QByteArray &key,
+		const QByteArray &iv) {
+	if (key.size() != kFileKeySize || iv.size() != kFileKeySize) {
+		return QByteArray();
+	}
+	const auto size = int(plain.size());
+	const auto padded = (size + 15) & ~15;
+	auto input = QByteArray(padded, Qt::Uninitialized);
+	if (size > 0) {
+		std::memcpy(input.data(), plain.constData(), size);
+	}
+	if (padded > size) {
+		base::RandomFill(input.data() + size, padded - size);
+	}
+	auto result = QByteArray(padded, Qt::Uninitialized);
+	if (padded > 0) {
+		MTP::aesIgeEncryptRaw(
+			input.constData(),
+			result.data(),
+			uint32(padded),
+			key.constData(),
+			iv.constData());
+	}
+	return result;
+}
+
+bool DecryptFile(
+		const QByteArray &encrypted,
+		const QByteArray &key,
+		const QByteArray &iv,
+		int64 size,
+		QByteArray &plain) {
+	const auto length = int64(encrypted.size());
+	if (key.size() != kFileKeySize
+		|| iv.size() != kFileKeySize
+		|| (length % 16) != 0
+		|| size < 0
+		|| size > length) {
+		return false;
+	}
+	plain = QByteArray(int(length), Qt::Uninitialized);
+	if (length > 0) {
+		MTP::aesIgeDecryptRaw(
+			encrypted.constData(),
+			plain.data(),
+			uint32(length),
+			key.constData(),
+			iv.constData());
+	}
+	plain.resize(int(size));
+	return true;
+}
+
+QByteArray Md5Hex(const QByteArray &data) {
+	uchar digest[MD5_DIGEST_LENGTH];
+	MD5(Raw(data), data.size(), digest);
+	return QByteArray(
+		reinterpret_cast<const char*>(digest),
+		MD5_DIGEST_LENGTH).toHex();
+}
+
+} // namespace Tele::Secret
