+		return false;
+	}
+	const auto count = r.readInt();
+	if (count < 0 || count > 10000) {
+		return false;
+	}
+	for (auto i = 0; i != count; ++i) {
+		const auto constructor = r.readUInt();
+		auto entity = Entity();
+		auto known = false;
+		for (const auto &item : kEntities) {
+			if (item.id == constructor) {
+				entity.type = item.type;
+				known = true;
+				break;
+			}
+		}
+		if (!known) {
+			return false;
+		}
+		entity.offset = r.readInt();
+		entity.length = r.readInt();
+		switch (entity.type) {
+		case EntityType::Pre:
+		case EntityType::TextUrl:
+			entity.extra = r.readString();
+			break;
+		case EntityType::MentionName:
+			entity.id = r.readInt();
+			break;
+		case EntityType::CustomEmoji:
+			entity.id = r.readLong();
+			break;
+		default:
+			break;
+		}
+		if (r.failed()) {
+			return false;
+		}
+		result.push_back(std::move(entity));
+	}
+	return true;
+}
+
+[[nodiscard]] bool SkipFileLocation(Reader &r) {
+	const auto constructor = r.readUInt();
+	if (constructor == kFileLocationUnavailable) {
+		(void)r.readLong();
+		(void)r.readInt();
+		(void)r.readLong();
+	} else if (constructor == kFileLocation) {
+		(void)r.readInt();
+		(void)r.readLong();
+		(void)r.readInt();
+		(void)r.readLong();
+	} else {
+		return false;
+	}
+	return !r.failed();
+}
+
+[[nodiscard]] bool SkipPhotoSize(Reader &r) {
+	switch (r.readUInt()) {
+	case kPhotoSizeEmpty:
+		(void)r.readBytes();
+		break;
+	case kPhotoSize:
+		(void)r.readBytes();
+		if (!SkipFileLocation(r)) {
+			return false;
+		}
+		(void)r.readInt();
+		(void)r.readInt();
+		(void)r.readInt();
+		break;
+	case kPhotoCachedSize:
+		(void)r.readBytes();
+		if (!SkipFileLocation(r)) {
+			return false;
+		}
+		(void)r.readInt();
+		(void)r.readInt();
+		(void)r.readBytes();
+		break;
+	default:
+		return false;
+	}
+	return !r.failed();
+}
+
+[[nodiscard]] bool ParseAttributes(Reader &r, Media &media) {
+	if (r.readUInt() != kVector) {
+		return false;
+	}
+	const auto count = r.readInt();
+	if (count < 0 || count > 100) {
+		return false;
+	}
+	auto voice = false;
+	auto audio = false;
+	auto sticker = false;
+	auto video = false;
+	auto round = false;
+	auto animated = false;
+	for (auto i = 0; i != count; ++i) {
+		switch (r.readUInt()) {
+		case kAttrImageSize:
+			media.width = r.readInt();
+			media.height = r.readInt();
+			break;
+		case kAttrAnimated:
+			animated = true;
+			break;
+		case kAttrSticker23:
+			sticker = true;
+			break;
+		case kAttrSticker: {
+			sticker = true;
+			media.emoji = r.readString();
+			const auto set = r.readUInt();
+			if (set == kStickerSetShortName) {
+				media.stickerSet = r.readString();
+			} else if (set != kStickerSetEmpty) {
+				return false;
+			}
+		} break;
+		case kAttrVideo23:
+			video = true;
+			media.duration = r.readInt();
+			media.width = r.readInt();
+			media.height = r.readInt();
+			break;
+		case kAttrVideo: {
+			video = true;
+			const auto flags = r.readInt();
+			round = (flags & 1) != 0;
+			media.duration = r.readInt();
+			media.width = r.readInt();
+			media.height = r.readInt();
+		} break;
+		case kAttrAudio23:
+			audio = true;
+			media.duration = r.readInt();
+			break;
+		case kAttrAudio45:
+			audio = true;
+			media.duration = r.readInt();
+			media.title = r.readString();
+			media.performer = r.readString();
+			break;
+		case kAttrAudio: {
+			audio = true;
+			const auto flags = r.readInt();
+			voice = (flags & (1 << 10)) != 0;
+			media.duration = r.readInt();
+			if (flags & 1) {
+				media.title = r.readString();
+			}
+			if (flags & 2) {
+				media.performer = r.readString();
+			}
+			if (flags & 4) {
+				media.waveform = r.readBytes();
+			}
+		} break;
+		case kAttrFilename:
+			media.fileName = r.readString();
+			break;
+		default:
+			return false;
+		}
+		if (r.failed()) {
+			return false;
+		}
+	}
+	media.type = sticker
+		? MediaType::Sticker
+		: voice
+		? MediaType::Voice
+		: audio
+		? MediaType::Audio
+		: round
+		? MediaType::Round
+		: animated
+		? MediaType::Animation
+		: video
+		? MediaType::Video
+		: MediaType::Document;
+	return true;
+}
+
+[[nodiscard]] bool ParseMedia(Reader &r, Media &media) {
+	const auto constructor = r.readUInt();
+	if (r.failed()) {
+		return false;
+	}
+	const auto readThumb = [&] {
+		media.thumb = r.readBytes();
+		media.thumbWidth = r.readInt();
+		media.thumbHeight = r.readInt();
+	};
+	const auto readKey = [&] {
+		media.key = r.readBytes();
+		media.iv = r.readBytes();
+	};
+	switch (constructor) {
+	case kMediaEmpty:
+		media.type = MediaType::None;
+		return true;
+	case kMediaPhoto8:
+	case kMediaPhoto:
+		media.type = MediaType::Photo;
+		readThumb();
+		media.width = r.readInt();
+		media.height = r.readInt();
+		media.size = r.readInt();
+		readKey();
+		if (constructor == kMediaPhoto) {
+			media.caption = r.readString();
+		}
+		media.mime = u"image/jpeg"_q;
+		return !r.failed();
+	case kMediaVideo8:
+	case kMediaVideo23:
+	case kMediaVideo:
+		media.type = MediaType::Video;
+		readThumb();
+		media.duration = r.readInt();
+		if (constructor != kMediaVideo8) {
+			media.mime = r.readString();
+		}
+		media.width = r.readInt();
+		media.height = r.readInt();
+		media.size = r.readInt();
+		readKey();
+		if (constructor == kMediaVideo) {
+			media.caption = r.readString();
+		}
+		if (media.mime.isEmpty()) {
+			media.mime = u"video/mp4"_q;
+		}
+		return !r.failed();
+	case kMediaDocument8:
+		media.type = MediaType::Document;
+		readThumb();
+		media.fileName = r.readString();
+		media.mime = r.readString();
+		media.size = r.readInt();
+		readKey();
+		return !r.failed();
+	case kMediaDocument46:
+	case kMediaDocument:
+		readThumb();
+		media.mime = r.readString();
+		media.size = (constructor == kMediaDocument)
+			? r.readLong()
+			: int64(r.readInt());
+		readKey();
+		if (!ParseAttributes(r, media)) {
+			return false;
+		}
+		media.caption = r.readString();
+		return !r.failed();
+	case kMediaAudio8:
+		media.type = MediaType::Voice;
+		media.duration = r.readInt();
+		media.size = r.readInt();
+		readKey();
+		media.mime = u"audio/ogg"_q;
+		return !r.failed();
+	case kMediaAudio:
+		media.type = MediaType::Voice;
+		media.duration = r.readInt();
+		media.mime = r.readString();
+		media.size = r.readInt();
+		readKey();
+		return !r.failed();
+	case kMediaGeo:
+		media.type = MediaType::Geo;
+		media.latitude = r.readDouble();
+		media.longitude = r.readDouble();
+		return !r.failed();
+	case kMediaContact:
+		media.type = MediaType::Contact;
+		media.phone = r.readString();
+		media.firstName = r.readString();
+		media.lastName = r.readString();
+		media.userId = r.readInt();
+		return !r.failed();
+	case kMediaVenue:
+		media.type = MediaType::Venue;
+		media.latitude = r.readDouble();
+		media.longitude = r.readDouble();
+		media.venueTitle = r.readString();
+		media.venueAddress = r.readString();
+		media.venueProvider = r.readString();
+		media.venueId = r.readString();
+		return !r.failed();
+	case kMediaWebPage:
+		media.type = MediaType::None;
+		(void)r.readBytes();
+		return !r.failed();
+	case kMediaExternal: {
+		media.documentId = uint64(r.readLong());
+		media.documentAccessHash = uint64(r.readLong());
+		media.documentDate = r.readInt();
+		media.mime = r.readString();
+		media.size = r.readInt();
+		if (!SkipPhotoSize(r)) {
+			return false;
+		}
+		media.documentDc = r.readInt();
+		if (!ParseAttributes(r, media) || r.failed()) {
+			return false;
+		}
+		media.external = true;
+		return media.documentId && media.documentAccessHash;
+	}
+	default:
+		return false;
+	}
+}
+
+[[nodiscard]] bool ParseAction(Reader &r, Inbound &result) {
+	const auto constructor = r.readUInt();
+	if (r.failed()) {
+		return false;
+	}
+	const auto readIds = [&] {
+		if (r.readUInt() != kVector) {
+			return false;
+		}
+		const auto count = r.readInt();
+		if (count < 0 || count * 8 > r.left()) {
+			return false;
+		}
+		for (auto i = 0; i != count; ++i) {
+			result.ids.push_back(r.readLong());
+		}
+		return !r.failed();
+	};
+	switch (constructor) {
+	case kActionNotifyLayer:
+		result.action = ActionKind::NotifyLayer;
+		result.actionValue = r.readInt();
+		return !r.failed();
+	case kActionResend:
+		result.action = ActionKind::Resend;
+		result.resendStart = r.readInt();
+		result.resendEnd = r.readInt();
+		return !r.failed();
+	case kActionReadMessages:
+		result.action = ActionKind::ReadMessages;
+		return readIds();
+	case kActionDeleteMessages:
+		result.action = ActionKind::DeleteMessages;
+		return readIds();
+	case kActionScreenshotMessages:
+		result.action = ActionKind::ScreenshotMessages;
+		return readIds();
+	case kActionFlushHistory:
+		result.action = ActionKind::FlushHistory;
+		return true;
+	case kActionSetMessageTTL:
+		result.action = ActionKind::SetTtl;
+		result.actionValue = r.readInt();
+		return !r.failed();
+	case kActionTyping:
+		result.action = ActionKind::Typing;
+		return true;
+	case kActionRequestKey:
+		result.action = ActionKind::RequestKey;
+		result.exchangeId = r.readLong();
+		result.value = r.readBytes();
+		return !r.failed();
+	case kActionAcceptKey:
+		result.action = ActionKind::AcceptKey;
+		result.exchangeId = r.readLong();
+		result.value = r.readBytes();
+		result.fingerprint = r.readLong();
+		return !r.failed();
+	case kActionAbortKey:
+		result.action = ActionKind::AbortKey;
+		result.exchangeId = r.readLong();
+		return !r.failed();
+	case kActionCommitKey:
+		result.action = ActionKind::CommitKey;
+		result.exchangeId = r.readLong();
+		result.fingerprint = r.readLong();
+		return !r.failed();
+	case kActionNoop:
+		result.action = ActionKind::Noop;
+		return true;
+	default:
+		result.action = ActionKind::Other;
+		return true;
+	}
+}
+
+[[nodiscard]] bool ParseMessage(Reader &r, Inbound &result) {
+	const auto constructor = r.readUInt();
+	if (r.failed()) {
+		return false;
+	}
+	switch (constructor) {
+	case kDecryptedMessage:
+	case kDecryptedMessage46: {
+		const auto flags = r.readInt();
+		result.randomId = r.readLong();
+		result.ttl = r.readInt();
+		result.text = r.readString();
+		if (r.failed()) {
+			return false;
+		}
+		if (flags & (1 << 9)) {
+			if (!ParseMedia(r, result.media)) {
+				result.media = Media{ .type = MediaType::Unsupported };
+				return true;
+			}
+		}
+		if (flags & (1 << 7)) {
+			if (!ParseEntities(r, result.entities)) {
+				result.entities.clear();
+				return true;
+			}
+		}
+		if (flags & (1 << 11)) {
+			(void)r.readBytes();
+		}
+		if (flags & (1 << 3)) {
+			result.replyTo = r.readLong();
+		}
+		if (r.failed()) {
+			result.replyTo = 0;
+		}
+		return true;
+	}
+	case kDecryptedMessage23: {
+		result.randomId = r.readLong();
+		result.ttl = r.readInt();
+		result.text = r.readString();
+		if (r.failed()) {
+			return false;
+		}
+		if (!ParseMedia(r, result.media)) {
+			result.media = Media{ .type = MediaType::Unsupported };
+		}
+		return true;
+	}
+	case kDecryptedMessage8: {
+		result.randomId = r.readLong();
+		(void)r.readBytes();
+		result.text = r.readString();
+		if (r.failed()) {
+			return false;
+		}
+		if (!ParseMedia(r, result.media)) {
+			result.media = Media{ .type = MediaType::Unsupported };
+		}
+		return true;
+	}
+	case kDecryptedMessageService:
+		result.service = true;
+		result.randomId = r.readLong();
+		return ParseAction(r, result);
+	case kDecryptedMessageService8:
+		result.service = true;
+		result.randomId = r.readLong();
+		(void)r.readBytes();
+		return ParseAction(r, result);
+	default:
+		return false;
+	}
+}
+
+void WriteEntities(Writer &w, const std::vector<Entity> &entities) {
+	w.writeUInt(kVector);
+	w.writeInt(int32(entities.size()));
+	for (const auto &entity : entities) {
+		auto constructor = kEntities[0].id;
+		for (const auto &item : kEntities) {
+			if (item.type == entity.type) {
+				constructor = item.id;
+				break;
+			}
+		}
+		w.writeUInt(constructor);
+		w.writeInt(entity.offset);
+		w.writeInt(entity.length);
+		switch (entity.type) {
+		case EntityType::Pre:
+		case EntityType::TextUrl:
+			w.writeString(entity.extra);
+			break;
+		case EntityType::MentionName:
+			w.writeInt(int32(entity.id));
+			break;
+		case EntityType::CustomEmoji:
+			w.writeLong(entity.id);
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+void WriteAttributes(Writer &w, const Media &media) {
+	auto attributes = Writer();
+	auto count = 0;
+	const auto add = [&](uint32 constructor) {
+		attributes.writeUInt(constructor);
+		++count;
+	};
+	const auto image = media.mime.startsWith(u"image/"_q);
+	if (!media.fileName.isEmpty()
+		&& media.type != MediaType::Voice
+		&& media.type != MediaType::Round) {
+		add(kAttrFilename);
+		attributes.writeString(media.fileName);
+	}
+	switch (media.type) {
+	case MediaType::Sticker:
+		if (media.width > 0 && media.height > 0) {
+			add(kAttrImageSize);
+			attributes.writeInt(media.width);
+			attributes.writeInt(media.height);
+		}
+		add(kAttrSticker);
+		attributes.writeString(media.emoji);
+		if (media.stickerSet.isEmpty()) {
+			attributes.writeUInt(kStickerSetEmpty);
+		} else {
+			attributes.writeUInt(kStickerSetShortName);
+			attributes.writeString(media.stickerSet);
+		}
+		break;
+	case MediaType::Animation:
+		add(kAttrAnimated);
+		if (image) {
+			if (media.width > 0 && media.height > 0) {
+				add(kAttrImageSize);
+				attributes.writeInt(media.width);
+				attributes.writeInt(media.height);
+			}
+		} else {
+			add(kAttrVideo);
+			attributes.writeInt(0);
+			attributes.writeInt(media.duration);
+			attributes.writeInt(media.width);
+			attributes.writeInt(media.height);
+		}
+		break;
+	case MediaType::Video:
+	case MediaType::Round:
+		add(kAttrVideo);
+		attributes.writeInt((media.type == MediaType::Round) ? 1 : 0);
+		attributes.writeInt(media.duration);
+		attributes.writeInt(media.width);
+		attributes.writeInt(media.height);
+		break;
+	case MediaType::Voice:
+	case MediaType::Audio: {
+		const auto voice = (media.type == MediaType::Voice);
+		const auto flags = (voice ? (1 << 10) : 0)
+			| ((voice && !media.waveform.isEmpty()) ? 4 : 0)
+			| ((!voice && !media.title.isEmpty()) ? 1 : 0)
+			| ((!voice && !media.performer.isEmpty()) ? 2 : 0);
+		add(kAttrAudio);
+		attributes.writeInt(flags);
+		attributes.writeInt(media.duration);
+		if (flags & 1) {
+			attributes.writeString(media.title);
+		}
+		if (flags & 2) {
+			attributes.writeString(media.performer);
+		}
+		if (flags & 4) {
+			attributes.writeBytes(media.waveform);
+		}
+	} break;
+	default:
+		if (image && media.width > 0 && media.height > 0) {
+			add(kAttrImageSize);
+			attributes.writeInt(media.width);
+			attributes.writeInt(media.height);
+		}
+		break;
+	}
+	w.writeUInt(kVector);
+	w.writeInt(count);
+	w.writeRaw(attributes.data());
+}
+
+void WriteMedia(Writer &w, const Media &media) {
+	if (media.external) {
+		w.writeUInt(kMediaExternal);
+		w.writeLong(int64(media.documentId));
+		w.writeLong(int64(media.documentAccessHash));
+		w.writeInt(media.documentDate);
+		w.writeString(media.mime);
+		w.writeInt(int32(media.size));
+		w.writeUInt(kPhotoSizeEmpty);
+		w.writeString(u"s"_q);
+		w.writeInt(media.documentDc);
+		WriteAttributes(w, media);
+	} else if (media.type == MediaType::Photo) {
+		w.writeUInt(kMediaPhoto);
+		w.writeBytes(media.thumb);
+		w.writeInt(media.thumbWidth);
+		w.writeInt(media.thumbHeight);
+		w.writeInt(media.width);
+		w.writeInt(media.height);
+		w.writeInt(int32(media.size));
+		w.writeBytes(media.key);
+		w.writeBytes(media.iv);
+		w.writeString(QString());
+	} else {
+		w.writeUInt(kMediaDocument46);
+		w.writeBytes(media.thumb);
+		w.writeInt(media.thumbWidth);
+		w.writeInt(media.thumbHeight);
+		w.writeString(media.mime);
+		w.writeInt(int32(media.size));
+		w.writeBytes(media.key);
+		w.writeBytes(media.iv);
+		WriteAttributes(w, media);
+		w.writeString(QString());
+	}
+}
+
+[[nodiscard]] QByteArray ServiceMessage(
+		int64 randomId,
+		const Writer &action) {
+	auto writer = Writer();
+	writer.writeUInt(kDecryptedMessageService);
+	writer.writeLong(randomId);
+	writer.writeRaw(action.data());
+	return writer.data();
+}
+
+[[nodiscard]] QByteArray IdsAction(
+		uint32 constructor,
+		int64 randomId,
+		const std::vector<int64> &ids) {
+	auto action = Writer();
+	action.writeUInt(constructor);
+	action.writeUInt(kVector);
+	action.writeInt(int32(ids.size()));
+	for (const auto id : ids) {
+		action.writeLong(id);
+	}
+	return ServiceMessage(randomId, action);
+}
+
+} // namespace
+
+bool ParseLayerObject(const QByteArray &object, Inbound &result) {
+	auto reader = Reader(object);
+	if (reader.readUInt() != kDecryptedMessageLayer) {
+		return false;
+	}
+	(void)reader.readBytes();
+	result.layer = reader.readInt();
+	result.inSeqNo = reader.readInt();
+	result.outSeqNo = reader.readInt();
+	if (reader.failed()) {
+		return false;
+	}
+	if (!ParseMessage(reader, result)) {
+		result.unsupported = true;
+	}
+	return true;
+}
+
+QByteArray BuildLayerObject(
+		const QByteArray &message,
+		int layer,
+		int inSeqNo,
+		int outSeqNo) {
+	auto writer = Writer();
+	writer.writeUInt(kDecryptedMessageLayer);
+	writer.writeBytes(RandomBytes(15 + int(uchar(RandomBytes(1)[0])) % 16));
+	writer.writeInt(layer);
+	writer.writeInt(inSeqNo);
+	writer.writeInt(outSeqNo);
+	writer.writeRaw(message);
+	return writer.data();
+}
+
+QByteArray BuildMessage(const OutboundText &data) {
+	auto flags = 0;
+	if (!data.entities.empty()) {
+		flags |= (1 << 7);
+	}
+	if (data.replyTo) {
+		flags |= (1 << 3);
+	}
+	if (data.media) {
+		flags |= (1 << 9);
+	}
+	auto writer = Writer();
+	writer.writeUInt(kDecryptedMessage);
+	writer.writeInt(flags);
+	writer.writeLong(data.randomId);
+	writer.writeInt(data.ttl);
+	writer.writeString(data.text);
+	if (data.media) {
+		WriteMedia(writer, *data.media);
+	}
+	if (!data.entities.empty()) {
+		WriteEntities(writer, data.entities);
+	}
+	if (data.replyTo) {
+		writer.writeLong(data.replyTo);
+	}
+	return writer.data();
+}
+
+bool HasFile(const Media &media) {
+	if (media.external) {
+		return false;
+	}
+	switch (media.type) {
+	case MediaType::Photo:
+	case MediaType::Video:
+	case MediaType::Round:
+	case MediaType::Animation:
+	case MediaType::Voice:
+	case MediaType::Audio:
+	case MediaType::Document:
+	case MediaType::Sticker:
+		return true;
+	default:
+		return false;
+	}
+}
+
+QByteArray BuildNotifyLayer(int64 randomId, int layer) {
+	auto action = Writer();
+	action.writeUInt(kActionNotifyLayer);
+	action.writeInt(layer);
+	return ServiceMessage(randomId, action);
+}
+
+QByteArray BuildResend(int64 randomId, int start, int end) {
+	auto action = Writer();
+	action.writeUInt(kActionResend);
+	action.writeInt(start);
+	action.writeInt(end);
+	return ServiceMessage(randomId, action);
+}
+
+QByteArray BuildNoop(int64 randomId) {
+	auto action = Writer();
+	action.writeUInt(kActionNoop);
+	return ServiceMessage(randomId, action);
+}
+
+QByteArray BuildReadMessages(int64 randomId, const std::vector<int64> &ids) {
+	return IdsAction(kActionReadMessages, randomId, ids);
+}
+
+QByteArray BuildDeleteMessages(
+		int64 randomId,
+		const std::vector<int64> &ids) {
+	return IdsAction(kActionDeleteMessages, randomId, ids);
+}
+
+QByteArray BuildSetTtl(int64 randomId, int ttl) {
+	auto action = Writer();
+	action.writeUInt(kActionSetMessageTTL);
+	action.writeInt(ttl);
+	return ServiceMessage(randomId, action);
+}
+
+QByteArray BuildAcceptKey(
+		int64 randomId,
+		int64 exchangeId,
+		const QByteArray &gB,
+		int64 fingerprint) {
+	auto action = Writer();
+	action.writeUInt(kActionAcceptKey);
+	action.writeLong(exchangeId);
+	action.writeBytes(gB);
+	action.writeLong(fingerprint);
+	return ServiceMessage(randomId, action);
+}
+
+QByteArray BuildAbortKey(int64 randomId, int64 exchangeId) {
+	auto action = Writer();
+	action.writeUInt(kActionAbortKey);
+	action.writeLong(exchangeId);
+	return ServiceMessage(randomId, action);
+}
+
+} // namespace Tele::Secret
