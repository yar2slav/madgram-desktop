+	const QVector<MTPEncryptedMessage> &messages,
+	int qts);
+[[nodiscard]] int MissedQts(not_null<Main::Session*> session, int serverQts);
+[[nodiscard]] int DifferenceEmpty(not_null<Main::Session*> session);
