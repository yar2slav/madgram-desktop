+[[nodiscard]] OutgoingFile ToOutgoing(
+		const Ui::PreparedFile &file,
+		bool compress) {
+	using Type = Ui::PreparedFile::Type;
+	using Info = Ui::PreparedFileInformation;
+	auto result = OutgoingFile();
+	result.path = file.path;
+	result.content = file.content;
+	result.name = file.displayName.isEmpty()
+		? QFileInfo(file.path).fileName()
+		: file.displayName;
+	result.caption = TextWithEntities{
+		file.caption.text,
+		TextUtilities::ConvertTextTagsToEntities(file.caption.tags),
+	};
+	result.width = file.originalDimensions.width();
+	result.height = file.originalDimensions.height();
+	result.type = MediaType::Document;
+	if (const auto info = file.information.get()) {
+		result.mime = info->filemime;
+		if (const auto image = std::get_if<Info::Image>(&info->media)) {
+			result.image = image->modifications
+				? Editor::ImageModified(image->data, image->modifications)
+				: image->data;
+			if (compress && image->animated) {
+				result.type = MediaType::Animation;
+			} else if (compress && file.type == Type::Photo) {
+				result.type = MediaType::Photo;
+			}
+		} else if (const auto video = std::get_if<Info::Video>(
+				&info->media)) {
+			result.image = video->thumbnail;
+			result.duration = (video->duration > 0)
+				? int(video->duration / 1000)
+				: 0;
+			if (compress) {
+				result.type = video->isGifv
+					? MediaType::Animation
+					: MediaType::Video;
+			}
+			if (result.width <= 0 || result.height <= 0) {
+				result.width = video->thumbnail.width();
+				result.height = video->thumbnail.height();
+			}
+		} else if (const auto song = std::get_if<Info::Song>(
+				&info->media)) {
+			result.type = MediaType::Audio;
+			result.duration = (song->duration > 0)
+				? int(song->duration / 1000)
+				: 0;
+			result.title = song->title;
+			result.performer = song->performer;
+		}
+	}
+	if (result.mime.isEmpty()) {
+		result.mime = result.path.isEmpty()
+			? Core::MimeTypeForData(result.content).name()
+			: Core::MimeTypeForFile(QFileInfo(result.path)).name();
+	}
+	if (result.name.isEmpty() && result.type == MediaType::Document) {
+		result.name = u"file"_q;
+	}
+	return result;
+}
+
+void ObtainBytes(
+		not_null<DocumentData*> document,
+		Fn<void(QByteArray)> done,
+		rpl::lifetime &lifetime) {
+	const auto media = document->createMediaView();
+	const auto read = [=] {
+		auto bytes = media->bytes();
+		if (bytes.isEmpty()) {
+			const auto &location = document->location(true);
+			if (!location.isEmpty() && location.accessEnable()) {
+				auto file = QFile(location.name());
+				if (file.open(QIODevice::ReadOnly)) {
+					bytes = file.readAll();
+				}
+				location.accessDisable();
+			}
+		}
+		return bytes;
+	};
+	if (auto bytes = read(); !bytes.isEmpty()) {
+		done(std::move(bytes));
+		return;
+	}
+	document->save(document->stickerOrGifOrigin(), QString());
+	document->session().downloaderTaskFinished(
+	) | rpl::filter([=] {
+		return !read().isEmpty();
+	}) | rpl::take(1) | rpl::on_next([=] {
+		done(read());
+	}, lifetime);
+}
