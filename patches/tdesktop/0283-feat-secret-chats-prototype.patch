+
+void Manager::requestDh(
+		Fn<void(const DhConfig&)> done,
+		Fn<void()> fail) {
+	_session->api().request(MTPmessages_GetDhConfig(
+		MTP_int(_dhVersion),
+		MTP_int(256)
+	)).done(crl::guard(this, [=](const MTPmessages_DhConfig &result) {
+		result.match([&](const MTPDmessages_dhConfig &data) {
+			auto config = DhConfig{
+				.g = data.vg().v,
+				.p = data.vp().v,
+				.random = data.vrandom().v,
+			};
+			if (config.random.size() != 256
+				|| !MTP::IsPrimeAndGood(
+					bytes::make_span(config.p),
+					config.g)) {
+				LOG(("Tele Secret Error: bad DH config."));
+				fail();
+				return;
+			}
+			_dhVersion = data.vversion().v;
+			_dh = DhConfig{ .g = config.g, .p = config.p };
+			done(config);
+		}, [&](const MTPDmessages_dhConfigNotModified &data) {
+			if (!_dh) {
+				fail();
+				return;
+			}
+			auto config = *_dh;
+			config.random = data.vrandom().v;
+			if (config.random.size() != 256) {
+				fail();
+				return;
+			}
+			done(config);
+		});
+	})).fail(crl::guard(this, [=](const MTP::Error &) {
+		fail();
+	})).send();
+}
+
+void Manager::start(not_null<UserData*> user, Fn<void(int)> started) {
+	if (const auto existing = findActiveWith(user)) {
+		if (started) {
+			started(existing->id);
+		}
+		return;
+	}
+	const auto userId = peerToUser(user->id).bare;
+	requestDh([=](const DhConfig &config) {
+		const auto first = MTP::CreateModExp(
+			config.g,
+			bytes::make_span(config.p),
+			bytes::make_span(config.random));
+		const auto secret = ToArray(first.randomPower);
+		auto randomId = int32();
+		while (!randomId) {
+			randomId = base::RandomValue<int32>() & 0x7FFFFFFF;
+		}
+		_session->api().request(MTPmessages_RequestEncryption(
+			user->inputUser(),
+			MTP_int(randomId),
+			MTP_bytes(ToArray(first.modexp))
+		)).done(crl::guard(this, [=](const MTPEncryptedChat &result) {
+			result.match([&](const MTPDencryptedChatWaiting &data) {
+				auto chat = Chat();
+				chat.id = data.vid().v;
+				chat.accessHash = data.vaccess_hash().v;
+				chat.peerUserId = userId;
+				chat.creator = true;
+				chat.state = ChatState::Waiting;
+				chat.date = data.vdate().v;
+				chat.secret = secret;
+				chat.dhG = config.g;
+				chat.dhP = config.p;
+				const auto id = chat.id;
+				_removed.remove(id);
+				auto &added = _chats.emplace(
+					id,
+					std::move(chat)).first->second;
+				ensureBinding(added);
+				addNote(
+					added,
+					Lower(u"You invited %1 to a secret chat."_q).arg(
+						peerName(added)),
+					added.date);
+				saveNow();
+				changed(added);
+				if (started) {
+					started(id);
+				}
+			}, [&](const MTPDencryptedChatDiscarded &) {
+				toast(Lower(u"Couldn't start the secret chat."_q));
+			}, [&](const auto &) {
+				applyChat(result);
+			});
+		})).fail(crl::guard(this, [=](const MTP::Error &error) {
+			toast(Lower(u"Couldn't start the secret chat: "_q)
+				+ error.type());
+		})).send();
+	}, [=] {
+		toast(Lower(u"Couldn't get the encryption parameters."_q));
+	});
+}
+
+void Manager::accept(int chatId) {
+	const auto chat = find(chatId);
+	if (!chat || chat->state != ChatState::Requested || chat->working) {
+		return;
+	}
+	chat->working = true;
+	const auto gA = chat->secret;
+	requestDh([=](const DhConfig &config) {
+		const auto chat = find(chatId);
+		if (!chat || chat->state != ChatState::Requested) {
+			return;
+		}
+		const auto second = MTP::CreateModExp(
+			config.g,
+			bytes::make_span(config.p),
+			bytes::make_span(config.random));
+		const auto raw = MTP::CreateAuthKey(
+			bytes::make_span(gA),
+			second.randomPower,
+			bytes::make_span(config.p));
+		if (raw.empty()) {
+			chat->working = false;
+			toast(Lower(u"The secret chat request is invalid."_q));
+			abort(*chat);
+			return;
+		}
+		const auto key = PadKey(ToArray(raw));
+		const auto fingerprint = KeyFingerprint(key);
+		chat->dhG = config.g;
+		chat->dhP = config.p;
+		_session->api().request(MTPmessages_AcceptEncryption(
+			input(*chat),
+			MTP_bytes(ToArray(second.modexp)),
+			MTP_long(fingerprint)
+		)).done(crl::guard(this, [=](const MTPEncryptedChat &result) {
+			const auto chat = find(chatId);
+			if (!chat) {
+				return;
+			}
+			chat->working = false;
+			result.match([&](const MTPDencryptedChat &data) {
+				if (int64(data.vkey_fingerprint().v) != fingerprint) {
+					toast(Lower(u"The encryption keys don't match."_q));
+					abort(*chat);
+					return;
+				}
+				chat->accessHash = data.vaccess_hash().v;
+				becomeReady(*chat, key);
+			}, [&](const auto &) {
+				applyChat(result);
+			});
+		})).fail(crl::guard(this, [=](const MTP::Error &error) {
+			const auto chat = find(chatId);
+			if (!chat) {
+				return;
+			}
+			chat->working = false;
+			const auto type = error.type();
+			if (type.startsWith(u"ENCRYPTION_"_q)
+				|| type == u"CHAT_ID_INVALID"_q) {
+				onDiscarded(chatId, false);
+			}
+			toast(Lower(u"Couldn't accept the secret chat: "_q) + type);
+		})).send();
+	}, [=] {
+		if (const auto chat = find(chatId)) {
+			chat->working = false;
+		}
+		toast(Lower(u"Couldn't get the encryption parameters."_q));
+	});
+}
+
+void Manager::decline(int chatId) {
+	remove(chatId);
+}
+
+void Manager::remove(int chatId) {
+	const auto chat = find(chatId);
+	if (!chat) {
+		return;
+	}
+	if (chat->state != ChatState::Discarded) {
+		_session->api().request(MTPmessages_DiscardEncryption(
+			MTP_flags(0),
+			MTP_int(chatId)
+		)).send();
+	}
+	for (const auto &message : chat->messages) {
+		dropMedia(*chat, message);
+	}
+	destroyBinding(*chat);
+	_chats.erase(chatId);
+	_removed.emplace(chatId);
+	saveNow();
+	_chatChanges.fire_copy(chatId);
+}
+
+void Manager::purge(bool discardOnServer) {
+	auto ids = std::vector<int>();
+	for (auto &[id, chat] : _chats) {
+		if (discardOnServer && chat.state != ChatState::Discarded) {
+			_session->api().request(MTPmessages_DiscardEncryption(
+				MTP_flags(0),
+				MTP_int(id)
+			)).send();
+		}
+		for (const auto &message : chat.messages) {
+			dropMedia(chat, message);
+		}
+		destroyBinding(chat);
+		ids.push_back(id);
+	}
+	_chats.clear();
+	_saveQueued = false;
+	Vault::Remove(_store);
+	for (const auto id : ids) {
+		_chatChanges.fire_copy(int(id));
+	}
+}
+
+void Manager::applyChat(const MTPEncryptedChat &chat) {
+	chat.match([&](const MTPDencryptedChatEmpty &) {
+	}, [&](const MTPDencryptedChatWaiting &data) {
+		if (const auto existing = find(data.vid().v)) {
+			existing->accessHash = data.vaccess_hash().v;
+			save();
+		}
+	}, [&](const MTPDencryptedChatRequested &data) {
+		onRequested(data);
+	}, [&](const MTPDencryptedChat &data) {
+		onAccepted(data);
+	}, [&](const MTPDencryptedChatDiscarded &data) {
+		onDiscarded(data.vid().v, data.is_history_deleted());
+	});
+}
+
+void Manager::onRequested(const MTPDencryptedChatRequested &data) {
+	const auto id = data.vid().v;
+	if (find(id)
+		|| _removed.contains(id)
+		|| data.vadmin_id().v == peerToUser(_session->userPeerId()).bare) {
+		return;
+	}
+	auto chat = Chat();
+	chat.id = id;
+	chat.accessHash = data.vaccess_hash().v;
+	chat.peerUserId = data.vadmin_id().v;
+	chat.creator = false;
+	chat.state = ChatState::Requested;
+	chat.date = data.vdate().v;
+	chat.secret = data.vg_a().v;
+	auto &added = _chats.emplace(id, std::move(chat)).first->second;
+	ensureBinding(added);
+	addNote(
+		added,
+		Lower(u"%1 invited you to a secret chat."_q).arg(peerName(added)),
+		added.date,
+		true);
+	saveNow();
+	changed(added);
+}
+
+void Manager::onAccepted(const MTPDencryptedChat &data) {
+	const auto chat = find(data.vid().v);
+	if (!chat) {
+		return;
+	}
+	if (chat->state == ChatState::Waiting && chat->creator) {
+		chat->accessHash = data.vaccess_hash().v;
+		const auto raw = MTP::CreateAuthKey(
+			bytes::make_span(data.vg_a_or_b().v),
+			bytes::make_span(chat->secret),
+			bytes::make_span(chat->dhP));
+		if (raw.empty()) {
+			toast(Lower(u"The secret chat answer is invalid."_q));
+			abort(*chat);
+			return;
+		}
+		const auto key = PadKey(ToArray(raw));
+		if (KeyFingerprint(key) != int64(data.vkey_fingerprint().v)) {
+			toast(Lower(u"The encryption keys don't match."_q));
+			abort(*chat);
+			return;
+		}
+		becomeReady(*chat, key);
+	} else if (chat->state == ChatState::Requested && !chat->working) {
+		chat->state = ChatState::Discarded;
+		chat->secret = QByteArray();
+		addNote(
+			*chat,
+			Lower(u"The secret chat was accepted on another device."_q),
+			base::unixtime::now());
+		saveNow();
+		changed(*chat);
+	}
+}
+
+void Manager::onDiscarded(int chatId, bool historyDeleted) {
+	const auto chat = find(chatId);
+	if (!chat || chat->state == ChatState::Discarded) {
+		return;
+	}
+	chat->state = ChatState::Discarded;
+	chat->secret = QByteArray();
+	chat->key = QByteArray();
+	chat->pendingKey = QByteArray();
+	chat->oldKey = QByteArray();
+	chat->waiting.clear();
+	chat->early.clear();
+	if (historyDeleted) {
+		clearMessages(*chat);
+	}
+	addNote(
+		*chat,
+		Lower(u"The secret chat ended."_q),
+		base::unixtime::now());
+	saveNow();
+	changed(*chat);
+}
+
+void Manager::abort(Chat &chat) {
+	if (chat.state != ChatState::Discarded) {
+		_session->api().request(MTPmessages_DiscardEncryption(
+			MTP_flags(0),
+			MTP_int(chat.id)
+		)).send();
+	}
+	onDiscarded(chat.id, false);
+}
+
+void Manager::becomeReady(Chat &chat, QByteArray key) {
+	chat.key = std::move(key);
+	chat.fingerprint = KeyFingerprint(chat.key);
+	chat.keyHash = KeyVisualHash(chat.key);
+	chat.state = ChatState::Ready;
+	chat.secret = QByteArray();
+	chat.inRaw = chat.outRaw = chat.hisInRaw = 0;
+	chat.keyUses = 0;
+	chat.keyDate = base::unixtime::now();
+	chat.working = false;
+	addNote(
+		chat,
+		(chat.creator
+			? Lower(u"%1 joined your secret chat."_q).arg(peerName(chat))
+			: Lower(u"You joined the secret chat."_q)),
+		base::unixtime::now());
+	const auto randomId = RandomId();
+	sendService(chat, BuildNotifyLayer(randomId, kLayer), randomId);
+	saveNow();
+	changed(chat);
+	const auto chatId = chat.id;
+	auto early = base::take(chat.early);
+	for (const auto &entry : early) {
+		onEncrypted(
+			chatId,
+			entry.date,
+			entry.bytes,
+			entry.file ? &*entry.file : nullptr);
+	}
+}
+
+void Manager::handleEncrypted(const MTPEncryptedMessage &message) {
+	message.match([&](const MTPDencryptedMessage &data) {
+		onEncrypted(
+			data.vchat_id().v,
+			data.vdate().v,
+			data.vbytes().v,
+			&data.vfile());
+	}, [&](const MTPDencryptedMessageService &data) {
+		onEncrypted(
+			data.vchat_id().v,
+			data.vdate().v,
+			data.vbytes().v,
+			nullptr);
+	});
+}
+
+void Manager::onEncrypted(
+		int chatId,
+		TimeId date,
+		const QByteArray &bytes,
+		const MTPEncryptedFile *file) {
+	const auto chat = find(chatId);
+	if (!chat) {
+		return;
+	} else if (chat->state == ChatState::Waiting) {
+		if (int(chat->early.size()) < kMaxEarly) {
+			chat->early.push_back({
+				.date = date,
+				.bytes = bytes,
+				.file = (file
+					? std::make_optional(*file)
+					: std::optional<MTPEncryptedFile>()),
+			});
+		}
+		return;
+	} else if (chat->state != ChatState::Ready) {
+		return;
+	}
+	const auto fingerprint = PacketFingerprint(bytes);
+	auto object = QByteArray();
+	auto decrypted = false;
+	auto withPending = false;
+	auto withCurrent = false;
+	if (fingerprint == chat->fingerprint) {
+		decrypted = DecryptPacket(chat->key, chat->creator, bytes, object);
+		withCurrent = decrypted;
+	} else if (!chat->pendingKey.isEmpty()
+		&& fingerprint == KeyFingerprint(chat->pendingKey)) {
+		decrypted = DecryptPacket(
+			chat->pendingKey,
+			chat->creator,
+			bytes,
+			object);
+		withPending = decrypted;
+	} else if (!chat->oldKey.isEmpty()
+		&& fingerprint == KeyFingerprint(chat->oldKey)) {
+		decrypted = DecryptPacket(chat->oldKey, chat->creator, bytes, object);
+	}
+	if (!decrypted) {
+		LOG(("Tele Secret Error: could not decrypt a message in %1."
+			).arg(chatId));
+		return;
+	}
+	if (withPending) {
+		switchToPendingKey(*chat);
+	}
+	auto inbound = Inbound();
+	if (!ParseLayerObject(object, inbound)) {
+		LOG(("Tele Secret Error: could not parse a message in %1."
+			).arg(chatId));
+		return;
+	}
+	if (file) {
+		file->match([&](const MTPDencryptedFile &data) {
+			auto &media = inbound.media;
+			media.fileId = data.vid().v;
+			media.fileAccessHash = data.vaccess_hash().v;
+			media.fileSize = data.vsize().v;
+			media.fileDc = data.vdc_id().v;
+			media.fileFingerprint = data.vkey_fingerprint().v;
+		}, [](const MTPDencryptedFileEmpty &) {
+		});
+	}
+	receive(*chat, std::move(inbound), date);
+	if (withCurrent && chat->waiting.empty() && !chat->oldKey.isEmpty()) {
+		chat->oldKey = QByteArray();
+		save();
+	}
+}
+
+void Manager::receive(Chat &chat, Inbound &&inbound, TimeId date) {
+	const auto remoteOut = chat.creator ? 0 : 1;
+	if (inbound.outSeqNo < 0
+		|| inbound.inSeqNo < 0
+		|| (inbound.outSeqNo % 2) != remoteOut
+		|| (inbound.inSeqNo % 2) != (1 - remoteOut)) {
+		LOG(("Tele Secret Error: bad seq_no parity in %1, aborting."
+			).arg(chat.id));
+		abort(chat);
+		return;
+	}
+	const auto raw = inbound.outSeqNo / 2;
+	if (inbound.service
+		&& !inbound.unsupported
+		&& inbound.action == ActionKind::Resend
+		&& raw >= chat.inRaw
+		&& !chat.handledResends.contains(inbound.randomId)) {
+		chat.handledResends.emplace(inbound.randomId);
+		answerResend(chat, inbound.resendStart, inbound.resendEnd);
+	}
+	if (raw < chat.inRaw) {
+		return;
+	} else if (raw > chat.inRaw) {
+		if (int(chat.waiting.size()) >= kMaxWaiting) {
+			return;
+		}
+		chat.waiting.emplace(raw, std::make_pair(std::move(inbound), date));
+		const auto now = crl::now();
+		if (!chat.gapSince) {
+			chat.gapSince = now;
+		} else if (now - chat.gapSince > kGapTimeout) {
+			LOG(("Tele Secret Error: skipping a seq_no gap %1..%2 in %3."
+				).arg(chat.inRaw
+				).arg(chat.waiting.begin()->first - 1
+				).arg(chat.id));
+			chat.inRaw = chat.waiting.begin()->first;
+			chat.gapSince = 0;
+			addNote(
+				chat,
+				Lower(u"Some messages could not be received."_q),
+				date);
+			drainWaiting(chat);
+			return;
+		}
+		requestResend(chat, chat.inRaw, chat.waiting.begin()->first - 1);
+		return;
+	}
+	process(chat, inbound, date);
+	drainWaiting(chat);
+	if (const auto current = find(chat.id); current && current->waiting.empty()) {
+		current->gapSince = 0;
+	}
+}
+
+void Manager::drainWaiting(Chat &chat) {
+	const auto chatId = chat.id;
+	while (true) {
+		const auto current = find(chatId);
+		if (!current || current->state != ChatState::Ready) {
+			return;
+		}
+		auto &waiting = current->waiting;
+		while (!waiting.empty() && waiting.begin()->first < current->inRaw) {
+			waiting.erase(waiting.begin());
+		}
+		if (waiting.empty() || waiting.begin()->first != current->inRaw) {
+			return;
+		}
+		auto entry = std::move(waiting.begin()->second);
+		waiting.erase(waiting.begin());
+		process(*current, entry.first, entry.second);
+	}
+}
+
+void Manager::requestResend(Chat &chat, int fromRaw, int tillRaw) {
+	if (tillRaw < fromRaw || tillRaw <= chat.resendRequestedTill) {
+		return;
+	}
+	chat.resendRequestedTill = tillRaw;
+	const auto remoteOut = chat.creator ? 0 : 1;
+	const auto randomId = RandomId();
+	sendService(
+		chat,
+		BuildResend(
+			randomId,
+			fromRaw * 2 + remoteOut,
+			tillRaw * 2 + remoteOut),
+		randomId);
+}
+
+void Manager::answerResend(Chat &chat, int start, int end) {
+	const auto from = start / 2;
+	const auto till = std::min(end / 2, from + kMaxResend);
+	auto packets = std::vector<Packet>();
+	for (const auto &packet : chat.outbox) {
+		if (packet.seqOut >= from && packet.seqOut <= till) {
+			packets.push_back(packet);
+		}
+	}
+	if (int(packets.size()) != (till - from + 1)) {
+		LOG(("Tele Secret Error: can't resend %1..%2 in %3, have %4."
+			).arg(from
+			).arg(till
+			).arg(chat.id
+			).arg(packets.size()));
+	}
+	for (const auto &packet : packets) {
+		sendPacket(chat, packet);
+	}
+}
+
+void Manager::process(Chat &chat, const Inbound &inbound, TimeId date) {
+	const auto hisIn = inbound.inSeqNo / 2;
+	if (hisIn > chat.outRaw || hisIn < chat.hisInRaw) {
+		LOG(("Tele Secret Error: bad in_seq_no %1 (sent %2, had %3) in %4."
+			).arg(inbound.inSeqNo
+			).arg(chat.outRaw
+			).arg(chat.hisInRaw
+			).arg(chat.id));
+		abort(chat);
+		return;
+	}
+	chat.inRaw = inbound.outSeqNo / 2 + 1;
+	chat.hisInRaw = hisIn;
+	++chat.keyUses;
+	chat.hisLayer = std::max(chat.hisLayer, inbound.layer);
+	if (inbound.unsupported) {
+		addNote(
+			chat,
+			Lower(u"This message isn't supported in tele yet."_q),
+			date);
+	} else if (inbound.service) {
+		processService(chat, inbound, date);
+	} else {
+		auto message = Message();
+		message.randomId = inbound.randomId;
+		message.date = date;
+		message.text = inbound.text.isEmpty()
+			? ToText(inbound.media.caption, {})
+			: ToText(inbound.text, inbound.entities);
+		message.replyTo = inbound.replyTo;
+		message.ttl = std::max(inbound.ttl, 0);
+		message.media = inbound.media;
+		message.media.caption = QString();
+		auto &media = message.media;
+		auto notice = QString();
+		if (media.type == MediaType::Unsupported) {
+			notice = Lower(u"[This media isn't supported in tele yet]"_q);
+		} else if (HasFile(media)
+			&& (!media.fileId
+				|| media.key.size() != kFileKeySize
+				|| media.iv.size() != kFileKeySize
+				|| (FileFingerprint(media.key, media.iv)
+					!= media.fileFingerprint))) {
+			LOG(("Tele Secret Error: bad file in %1.").arg(chat.id));
+			notice = Lower(u"[This file couldn't be verified]"_q);
+		}
+		if (!notice.isEmpty()) {
+			media = Media();
+			message.text = message.text.text.isEmpty()
+				? TextWithEntities{ notice }
+				: TextWithEntities{ notice + '\n' }.append(
+					std::move(message.text));
+		}
+		if (message.text.text.isEmpty() && media.type == MediaType::None) {
+			message.text = TextWithEntities{
+				Lower(u"This message isn't supported in tele yet."_q),
+			};
+		}
+		const auto randomId = message.randomId;
+		const auto download = HasFile(media);
+		addMessage(chat, std::move(message), true);
+		if (download) {
+			startDownload(chat.id, randomId);
+		}
+	}
+	save();
+	if (const auto current = find(chat.id)) {
+		maybeRekey(*current);
+	}
+}
+
+void Manager::processService(
+		Chat &chat,
+		const Inbound &inbound,
+		TimeId date) {
+	switch (inbound.action) {
+	case ActionKind::NotifyLayer:
+		chat.hisLayer = std::max(chat.hisLayer, inbound.actionValue);
+		break;
+	case ActionKind::Resend:
+		if (!chat.handledResends.contains(inbound.randomId)) {
+			chat.handledResends.emplace(inbound.randomId);
+			answerResend(chat, inbound.resendStart, inbound.resendEnd);
+		}
+		break;
+	case ActionKind::DeleteMessages:
+		for (const auto id : inbound.ids) {
+			removeMessage(chat, id);
+		}
+		changed(chat);
+		break;
+	case ActionKind::ReadMessages: {
+		auto started = false;
+		for (const auto id : inbound.ids) {
+			const auto message = findMessage(chat, id);
+			if (message
+				&& message->out
+				&& message->ttl > 0
+				&& !message->destroyAt) {
+				startCountdown(chat, *message);
+				started = true;
+			}
+		}
+		if (started) {
+			save();
+		}
+	} break;
+	case ActionKind::FlushHistory:
+		clearMessages(chat);
+		changed(chat);
+		break;
+	case ActionKind::SetTtl: {
+		const auto ttl = std::max(inbound.actionValue, 0);
+		chat.ttl = ttl;
+		addNote(
+			chat,
+			(ttl
+				? Lower(u"%1 set the self-destruct timer to %2"_q).arg(
+					peerName(chat),
+					TimerFullText(ttl))
+				: Lower(u"%1 turned off the self-destruct timer"_q).arg(
+					peerName(chat))),
+			date);
+		changed(chat);
+	} break;
+	case ActionKind::ScreenshotMessages:
+		addNote(
+			chat,
+			Lower(u"%1 took a screenshot"_q).arg(peerName(chat)),
+			date);
+		break;
+	case ActionKind::Typing:
+		showTyping(chat);
+		break;
+	case ActionKind::RequestKey:
+		handleRequestKey(chat, inbound);
+		break;
+	case ActionKind::CommitKey:
+		handleCommitKey(chat, inbound);
+		break;
+	case ActionKind::AbortKey:
+		if (chat.exchangeId && chat.exchangeId == inbound.exchangeId) {
+			clearExchange(chat);
+			chat.keyUses = 0;
+			chat.keyDate = base::unixtime::now();
+			save();
+		}
+		break;
+	case ActionKind::AcceptKey:
+		handleAcceptKey(chat, inbound);
+		break;
+	default:
+		break;
+	}
+}
+
+void Manager::handleRequestKey(Chat &chat, const Inbound &inbound) {
+	if (chat.exchangeId == inbound.exchangeId && chat.exchangeId) {
+		return;
+	} else if (chat.exchangeId && !chat.rekeySecret.isEmpty()) {
+		if (chat.exchangeId > inbound.exchangeId) {
+			return;
+		}
+		clearExchange(chat);
+	} else if (chat.exchangeId) {
+		const auto randomId = RandomId();
+		sendService(chat, BuildAbortKey(randomId, inbound.exchangeId), randomId);
+		return;
+	}
+	if (chat.dhP.isEmpty() || !chat.dhG) {
+		const auto randomId = RandomId();
+		sendService(chat, BuildAbortKey(randomId, inbound.exchangeId), randomId);
+		return;
+	}
+	const auto second = MTP::CreateModExp(
+		chat.dhG,
+		bytes::make_span(chat.dhP),
+		bytes::make_span(RandomBytes(MTP::ModExpFirst::kRandomPowerSize)));
+	const auto raw = MTP::CreateAuthKey(
+		bytes::make_span(inbound.value),
+		second.randomPower,
+		bytes::make_span(chat.dhP));
+	if (raw.empty()) {
+		const auto randomId = RandomId();
+		sendService(chat, BuildAbortKey(randomId, inbound.exchangeId), randomId);
+		return;
+	}
+	const auto key = PadKey(ToArray(raw));
+	chat.exchangeId = inbound.exchangeId;
+	chat.pendingKey = key;
+	const auto randomId = RandomId();
+	sendService(
+		chat,
+		BuildAcceptKey(
+			randomId,
+			inbound.exchangeId,
+			ToArray(second.modexp),
+			KeyFingerprint(key)),
+		randomId);
+}
+
+void Manager::handleCommitKey(Chat &chat, const Inbound &inbound) {
+	if (chat.pendingKey.isEmpty()
+		|| !chat.rekeySecret.isEmpty()
+		|| chat.exchangeId != inbound.exchangeId) {
+		return;
+	} else if (KeyFingerprint(chat.pendingKey) != inbound.fingerprint) {
+		LOG(("Tele Secret Error: re-key fingerprint mismatch in %1."
+			).arg(chat.id));
+		abort(chat);
+		return;
+	}
+	switchToPendingKey(chat);
+}
+
+void Manager::switchToPendingKey(Chat &chat) {
+	if (chat.pendingKey.isEmpty()) {
+		return;
+	}
+	chat.oldKey = chat.key;
+	chat.key = base::take(chat.pendingKey);
+	chat.fingerprint = KeyFingerprint(chat.key);
+	clearExchange(chat);
+	chat.keyUses = 0;
+	chat.keyDate = base::unixtime::now();
+	const auto randomId = RandomId();
+	sendService(chat, BuildNoop(randomId), randomId);
+	saveNow();
+}
+
+void Manager::clearExchange(Chat &chat) {
+	chat.exchangeId = 0;
+	chat.pendingKey = QByteArray();
+	chat.rekeySecret = QByteArray();
+}
+
+void Manager::handleAcceptKey(Chat &chat, const Inbound &inbound) {
+	const auto abortWith = [&](int64 exchangeId) {
+		const auto randomId = RandomId();
+		sendService(chat, BuildAbortKey(randomId, exchangeId), randomId);
+	};
+	if (!chat.exchangeId
+		|| chat.exchangeId != inbound.exchangeId
+		|| chat.rekeySecret.isEmpty()) {
+		abortWith(inbound.exchangeId);
+		return;
+	}
+	const auto raw = MTP::CreateAuthKey(
+		bytes::make_span(inbound.value),
+		bytes::make_span(chat.rekeySecret),
+		bytes::make_span(chat.dhP));
+	const auto key = raw.empty() ? QByteArray() : PadKey(ToArray(raw));
+	if (key.isEmpty() || KeyFingerprint(key) != inbound.fingerprint) {
+		LOG(("Tele Secret Error: bad re-key answer in %1.").arg(chat.id));
+		const auto exchangeId = chat.exchangeId;
+		clearExchange(chat);
+		chat.keyUses = 0;
+		chat.keyDate = base::unixtime::now();
+		abortWith(exchangeId);
+		return;
+	}
+	const auto exchangeId = chat.exchangeId;
+	const auto fingerprint = KeyFingerprint(key);
+	auto action = Writer();
+	action.writeUInt(kActionCommitKey);
+	action.writeLong(exchangeId);
+	action.writeLong(fingerprint);
+	auto commit = Writer();
+	const auto randomId = RandomId();
+	commit.writeUInt(kDecryptedMessageService);
+	commit.writeLong(randomId);
+	commit.writeRaw(action.data());
+	sendService(chat, commit.data(), randomId);
+	chat.oldKey = chat.key;
+	chat.key = key;
+	chat.fingerprint = fingerprint;
+	clearExchange(chat);
+	chat.keyUses = 0;
+	chat.keyDate = base::unixtime::now();
+	saveNow();
+}
+
+void Manager::maybeRekey(Chat &chat) {
+	if (chat.state != ChatState::Ready
+		|| chat.exchangeId
+		|| chat.dhP.isEmpty()
+		|| !chat.dhG
+		|| chat.hisLayer < kRekeyMinLayer
+		|| chat.keyUses <= 0) {
+		return;
+	} else if (chat.keyUses < kRekeyUses
+		&& base::unixtime::now() - chat.keyDate < kRekeyPeriod) {
+		return;
+	}
+	const auto first = MTP::CreateModExp(
+		chat.dhG,
+		bytes::make_span(chat.dhP),
+		bytes::make_span(RandomBytes(MTP::ModExpFirst::kRandomPowerSize)));
+	auto exchangeId = int64();
+	while (!exchangeId) {
+		exchangeId = base::RandomValue<int64>();
+	}
+	chat.exchangeId = exchangeId;
+	chat.rekeySecret = ToArray(first.randomPower);
+	auto action = Writer();
+	action.writeUInt(kActionRequestKey);
+	action.writeLong(exchangeId);
+	action.writeBytes(ToArray(first.modexp));
+	auto request = Writer();
+	const auto randomId = RandomId();
+	request.writeUInt(kDecryptedMessageService);
+	request.writeLong(randomId);
+	request.writeRaw(action.data());
+	sendService(chat, request.data(), randomId);
+	saveNow();
+}
+
+int Manager::sendLayer(const Chat &chat) const {
+	return std::min(kLayer, std::max(kMinLayer, chat.hisLayer));
+}
+
+void Manager::dispatch(
+		Chat &chat,
+		const QByteArray &message,
+		int64 randomId,
+		bool service,
+		const Packet *file) {
+	if (chat.state != ChatState::Ready || chat.key.isEmpty()) {
+		return;
+	}
+	const auto outParity = chat.creator ? 1 : 0;
+	const auto inParity = chat.creator ? 0 : 1;
+	auto packet = file ? *file : Packet();
+	packet.seqOut = chat.outRaw;
+	packet.randomId = randomId;
+	packet.service = service;
+	packet.acked = false;
+	packet.object = BuildLayerObject(
+		message,
+		sendLayer(chat),
+		chat.inRaw * 2 + inParity,
+		chat.outRaw * 2 + outParity);
+	++chat.outRaw;
+	++chat.keyUses;
+	chat.outbox.push_back(packet);
+	while (int(chat.outbox.size()) > kMaxOutbox) {
+		chat.outbox.pop_front();
+	}
+	saveNow();
+	sendPacket(chat, packet);
+	if (!service) {
+		maybeRekey(chat);
+	}
+}
+
+void Manager::sendPacket(Chat &chat, const Packet &packet) {
+	const auto data = EncryptPacket(chat.key, chat.creator, packet.object);
+	if (data.isEmpty()) {
+		return;
+	}
+	const auto chatId = chat.id;
+	const auto randomId = packet.randomId;
+	const auto done = crl::guard(this, [=](
+			const MTPmessages_SentEncryptedMessage &result) {
+		packetSent(chatId, randomId, &result);
+	});
+	const auto fail = crl::guard(this, [=](const MTP::Error &error) {
+		packetFailed(chatId, randomId, error.type());
+	});
+	if (packet.service) {
+		chat.lastRequestId = _session->api().request(
+			MTPmessages_SendEncryptedService(
+				input(chat),
+				MTP_long(randomId),
+				MTP_bytes(data))
+		).done(done).fail(fail).afterRequest(chat.lastRequestId).send();
+	} else if (packet.file) {
+		const auto file = packet.fileAccessHash
+			? MTP_inputEncryptedFile(
+				MTP_long(packet.fileId),
+				MTP_long(packet.fileAccessHash))
+			: packet.big
+			? MTP_inputEncryptedFileBigUploaded(
+				MTP_long(packet.uploadId),
+				MTP_int(packet.parts),
+				MTP_int(packet.fingerprint))
+			: MTP_inputEncryptedFileUploaded(
+				MTP_long(packet.uploadId),
+				MTP_int(packet.parts),
+				MTP_string(QString::fromLatin1(packet.md5)),
+				MTP_int(packet.fingerprint));
+		chat.lastRequestId = _session->api().request(
+			MTPmessages_SendEncryptedFile(
+				MTP_flags(0),
+				input(chat),
+				MTP_long(randomId),
+				MTP_bytes(data),
+				file)
+		).done(done).fail(fail).afterRequest(chat.lastRequestId).send();
+	} else {
+		chat.lastRequestId = _session->api().request(
+			MTPmessages_SendEncrypted(
+				MTP_flags(0),
+				input(chat),
+				MTP_long(randomId),
+				MTP_bytes(data))
+		).done(done).fail(fail).afterRequest(chat.lastRequestId).send();
+	}
+}
+
+void Manager::packetSent(
+		int chatId,
+		int64 randomId,
+		const MTPmessages_SentEncryptedMessage *result) {
+	const auto chat = find(chatId);
+	if (!chat) {
+		return;
+	}
+	auto file = (const MTPEncryptedFile*)nullptr;
+	if (result) {
+		result->match([&](const MTPDmessages_sentEncryptedFile &data) {
+			file = &data.vfile();
+		}, [](const MTPDmessages_sentEncryptedMessage &) {
+		});
+	}
+	const auto message = findMessage(*chat, randomId);
+	if (file) {
+		file->match([&](const MTPDencryptedFile &data) {
+			for (auto &packet : chat->outbox) {
+				if (packet.randomId == randomId && packet.file) {
+					packet.fileId = data.vid().v;
+					packet.fileAccessHash = data.vaccess_hash().v;
+				}
+			}
+			if (message) {
+				message->media.fileId = data.vid().v;
+				message->media.fileAccessHash = data.vaccess_hash().v;
+				message->media.fileDc = data.vdc_id().v;
+				message->media.fileSize = data.vsize().v;
+			}
+		}, [](const MTPDencryptedFileEmpty &) {
+		});
+	}
+	for (auto &packet : chat->outbox) {
+		if (packet.randomId == randomId) {
+			packet.acked = true;
+		}
+	}
+	if (const auto message = findMessage(*chat, randomId)) {
+		if (message->state == MessageState::Sending
+			|| message->state == MessageState::Failed) {
+			setMessageState(*chat, randomId, MessageState::Sent);
+		}
+	}
+	save();
+}
+
+void Manager::packetFailed(int chatId, int64 randomId, const QString &type) {
+	const auto chat = find(chatId);
+	if (!chat) {
+		return;
+	}
+	LOG(("Tele Secret Error: send failed in %1: %2").arg(chatId).arg(type));
+	if (type == u"RANDOM_ID_DUPLICATE"_q) {
+		packetSent(chatId, randomId, nullptr);
+		return;
+	}
+	if (const auto message = findMessage(*chat, randomId)) {
+		if (message->state == MessageState::Sending) {
+			setMessageState(*chat, randomId, MessageState::Failed);
+		}
+	}
+	if (type.startsWith(u"ENCRYPTION_"_q) || type == u"CHAT_ID_INVALID"_q) {
+		onDiscarded(chatId, false);
+	}
+}
+
+void Manager::sendService(
+		Chat &chat,
+		const QByteArray &message,
+		int64 randomId) {
+	dispatch(chat, message, randomId, true);
+}
+
+void Manager::resendUnacked(Chat &chat) {
+	auto packets = std::vector<Packet>();
+	for (const auto &packet : chat.outbox) {
+		if (!packet.acked) {
+			packets.push_back(packet);
+		}
+	}
+	for (const auto &packet : packets) {
+		sendPacket(chat, packet);
+	}
+}
+
+void Manager::sendText(int chatId, TextWithEntities text, int64 replyTo) {
+	const auto chat = find(chatId);
+	if (!chat || chat->state != ChatState::Ready) {
+		return;
+	}
+	TextUtilities::PrepareForSending(text, 0);
+	TextUtilities::Trim(text);
+	auto left = std::move(text);
+	auto sending = TextWithEntities();
+	auto first = true;
+	while (TextUtilities::CutPart(sending, left, kMessagePart)) {
+		const auto current = find(chatId);
+		if (!current || current->state != ChatState::Ready) {
+			return;
+		}
+		auto data = OutboundText();
+		data.randomId = RandomId();
+		data.text = sending.text;
+		data.entities = FromText(sending, sendLayer(*current));
+		data.replyTo = first ? replyTo : 0;
+		data.ttl = current->ttl;
+		first = false;
+
+		auto message = Message();
+		message.randomId = data.randomId;
+		message.out = true;
+		message.date = base::unixtime::now();
+		message.state = MessageState::Sending;
+		message.text = ToText(data.text, data.entities);
+		message.replyTo = data.replyTo;
+		message.ttl = data.ttl;
+		addMessage(*current, std::move(message), true);
+		dispatch(*current, BuildMessage(data), data.randomId, false);
+	}
+}
+
+void Manager::deleteMessages(
+		int chatId,
+		const std::vector<int64> &randomIds) {
+	const auto chat = find(chatId);
+	if (!chat || randomIds.empty()) {
+		return;
+	}
+	auto announce = std::vector<int64>();
+	for (const auto id : randomIds) {
+		if (const auto message = findMessage(*chat, id)) {
+			if (!message->note) {
+				announce.push_back(id);
+			}
+			removeMessage(*chat, id);
+		}
+		for (auto &packet : chat->outbox) {
+			if (packet.randomId != id || packet.acked || packet.service) {
+				continue;
+			}
+			auto parsed = Inbound();
+			if (ParseLayerObject(packet.object, parsed)) {
+				packet.object = BuildLayerObject(
+					BuildDeleteMessages(id, { id }),
+					parsed.layer,
+					parsed.inSeqNo,
+					parsed.outSeqNo);
+				packet.service = true;
+				packet.file = false;
+			}
+		}
+	}
+	if (chat->state == ChatState::Ready && !announce.empty()) {
+		const auto randomId = RandomId();
+		sendService(*chat, BuildDeleteMessages(randomId, announce), randomId);
+	}
+	save();
+	changed(*chat);
+}
+
+void Manager::markRead(int chatId) {
+	const auto chat = find(chatId);
+	if (!chat) {
+		return;
+	}
+	auto &owner = _session->data();
+	const auto &binding = chat->binding;
+	if (binding.history) {
+		for (const auto &[randomId, msgId] : binding.items) {
+			if (const auto item = owner.message(binding.user->id, msgId)) {
+				owner.histories().readClientSideMessage(item);
+			}
+		}
+		if (binding.history->unreadCount()) {
+			binding.history->setUnreadCount(0);
+		}
+		Core::App().notifications().clearIncomingFromHistory(
+			binding.history);
+	}
+	auto maxDate = TimeId();
+	for (const auto &message : chat->messages) {
+		if (!message.out && !message.note) {
+			maxDate = std::max(maxDate, message.date);
+		}
+	}
+	auto dirty = (chat->unread != 0);
+	chat->unread = 0;
+	const auto real = chat->binding.real;
+	const auto ghost = real && HideRead(real);
+	const auto ready = (chat->state == ChatState::Ready);
+	if (ready && maxDate > chat->readSent && !ghost) {
+		chat->readSent = maxDate;
+		dirty = true;
+		_session->api().request(MTPmessages_ReadEncryptedHistory(
+			input(*chat),
+			MTP_int(maxDate)
+		)).send();
+	}
+	if (!KeepSecretMedia()) {
+		const auto till = (ready || ghost) ? chat->readSent : maxDate;
+		auto shown = std::vector<int64>();
+		for (auto &message : chat->messages) {
+			if (message.out
+				|| message.note
+				|| message.ttl <= 0
+				|| message.destroyAt
+				|| message.date > till) {
+				continue;
+			} else if (ShowsOnOpen(message)) {
+				if (ghost) {
+					continue;
+				}
+				shown.push_back(message.randomId);
+			} else if (IsViewTriggered(message)) {
+				continue;
+			}
+			startCountdown(*chat, message);
+			dirty = true;
+		}
+		if (ready && !shown.empty()) {
+			const auto serviceId = RandomId();
+			sendService(
+				*chat,
+				BuildReadMessages(serviceId, shown),
+				serviceId);
+		}
+	}
+	if (dirty) {
+		save();
+	}
+}
+
+void Manager::setTyping(int chatId) {
+	const auto chat = find(chatId);
+	if (!chat || chat->state != ChatState::Ready) {
+		return;
+	} else if (const auto real = chat->binding.real; real && HideTyping(real)) {
+		return;
+	}
+	const auto now = crl::now();
+	if (chat->typingSent && now - chat->typingSent < kTypingSendEvery) {
+		return;
+	}
+	chat->typingSent = now;
+	_session->api().request(MTPmessages_SetEncryptedTyping(
+		input(*chat),
+		MTP_bool(true)
+	)).send();
+}
+
+void Manager::setTtl(int chatId, int ttl) {
+	const auto chat = find(chatId);
+	ttl = std::max(ttl, 0);
+	if (!chat || chat->state != ChatState::Ready || chat->ttl == ttl) {
+		return;
+	}
+	chat->ttl = ttl;
+	const auto randomId = RandomId();
+	sendService(*chat, BuildSetTtl(randomId, ttl), randomId);
+	addNote(
+		*chat,
+		(ttl
+			? Lower(u"You set the self-destruct timer to %1"_q).arg(
+				TimerFullText(ttl))
+			: Lower(u"You turned off the self-destruct timer"_q)),
+		base::unixtime::now());
+	changed(*chat);
+}
+
+void Manager::viewed(int chatId, MsgId msgId) {
+	if (KeepSecretMedia()) {
+		return;
+	}
+	const auto chat = find(chatId);
+	const auto randomId = randomIdOf(chatId, msgId);
+	const auto message = (chat && randomId)
+		? findMessage(*chat, randomId)
+		: nullptr;
+	if (!message
+		|| message->out
+		|| message->destroyAt
+		|| !IsViewTriggered(*message)) {
+		return;
+	}
+	startViewCountdown(*chat, *message, false);
+}
+
+void Manager::markViewed(int chatId, MsgId msgId) {
+	const auto chat = find(chatId);
+	const auto randomId = randomIdOf(chatId, msgId);
+	const auto message = (chat && randomId)
+		? findMessage(*chat, randomId)
+		: nullptr;
+	if (!message
+		|| message->out
+		|| message->note
+		|| message->ttl <= 0
+		|| message->destroyAt) {
+		return;
+	} else if (IsViewTriggered(*message)) {
+		startViewCountdown(*chat, *message, true);
+		return;
+	}
+	const auto date = message->date;
+	startCountdown(*chat, *message);
+	if (chat->state == ChatState::Ready && date > chat->readSent) {
+		chat->readSent = date;
+		_session->api().request(MTPmessages_ReadEncryptedHistory(
+			input(*chat),
+			MTP_int(date)
+		)).send();
+	}
+	save();
+}
+
+void Manager::startCountdown(Chat &chat, Message &message) {
+	if (message.ttl <= 0 || message.destroyAt) {
+		return;
+	}
+	message.destroyAt = base::unixtime::now() + message.ttl;
+	refreshTimerText(chat, message);
+	scheduleTtl();
+}
+
+void Manager::startViewCountdown(Chat &chat, Message &message, bool force) {
+	const auto real = chat.binding.real;
+	if (!force && real && HideRead(real)) {
+		return;
+	}
+	const auto randomId = message.randomId;
+	startCountdown(chat, message);
+	save();
+	if (chat.state == ChatState::Ready) {
+		const auto serviceId = RandomId();
+		sendService(
+			chat,
+			BuildReadMessages(serviceId, { randomId }),
+			serviceId);
+	}
+}
+
+void Manager::scheduleTtl() {
+	if (!_ttlTimer.isActive()) {
+		_ttlTimer.callEach(kTtlCheckEvery);
+	}
+}
+
+void Manager::checkTtls() {
+	const auto now = base::unixtime::now();
+	auto running = false;
+	for (auto &[id, chat] : _chats) {
+		auto expired = std::vector<int64>();
+		for (const auto &message : chat.messages) {
+			if (!message.destroyAt) {
+				continue;
+			} else if (message.destroyAt <= now) {
+				expired.push_back(message.randomId);
+			} else {
+				running = true;
+				refreshTimerText(chat, message);
+			}
+		}
+		if (!expired.empty()) {
+			for (const auto randomId : expired) {
+				removeMessage(chat, randomId);
+			}
+			save();
+			changed(chat);
+		}
+	}
+	if (!running) {
+		_ttlTimer.cancel();
+	}
+}
+
+void Manager::purgeExpired(Chat &chat) {
+	const auto now = base::unixtime::now();
+	auto expired = std::vector<int64>();
+	for (const auto &message : chat.messages) {
+		if (message.destroyAt && message.destroyAt <= now) {
+			expired.push_back(message.randomId);
+		}
+	}
+	if (expired.empty()) {
+		return;
+	}
+	for (const auto randomId : expired) {
+		removeMessage(chat, randomId);
+	}
+	save();
+}
+
+void Manager::refreshTimerText(const Chat &chat, const Message &message) {
+	const auto key = Key(chat.id, message.randomId);
+	const auto text = MessageTimerText(message);
+	auto &cached = _timerTexts[key];
+	if (cached == text) {
+		return;
+	}
+	cached = text;
+	const auto &binding = chat.binding;
+	const auto i = binding.items.find(message.randomId);
+	if (!binding.user || i == end(binding.items)) {
+		return;
+	}
+	auto &owner = _session->data();
+	if (const auto item = owner.message(binding.user->id, i->second)) {
+		owner.notifyItemDataChange(item);
+	}
+}
+
+int64 Manager::randomIdOf(int chatId, MsgId msgId) const {
+	const auto i = _chats.find(chatId);
+	if (i == end(_chats)) {
+		return 0;
+	}
+	const auto &ids = i->second.binding.randomIds;
+	const auto j = ids.find(msgId);
+	return (j != end(ids)) ? j->second : 0;
+}
+
+bool Manager::outgoingRead(int chatId, MsgId msgId) const {
+	const auto randomId = randomIdOf(chatId, msgId);
+	if (!randomId) {
+		return false;
+	}
+	const auto &chat = _chats.find(chatId)->second;
+	for (const auto &message : chat.messages) {
+		if (message.randomId == randomId) {
+			return (message.state == MessageState::Read);
+		}
+	}
+	return false;
+}
+
+QString Manager::timerText(int chatId, MsgId msgId) const {
+	const auto message = messageOf(chatId, msgId);
+	return message ? MessageTimerText(*message) : QString();
+}
+
+UserData *Manager::realUser(PeerId fakePeerId) const {
+	if (!IsSecretPeerId(fakePeerId)) {
+		return nullptr;
+	}
+	const auto i = _chats.find(ChatIdOf(fakePeerId));
+	return (i != end(_chats)) ? i->second.binding.real : nullptr;
+}
+
+Message *Manager::findMessage(Chat &chat, int64 randomId) {
+	for (auto &message : chat.messages) {
+		if (message.randomId == randomId) {
+			return &message;
+		}
+	}
+	return nullptr;
+}
+
+void Manager::addMessage(Chat &chat, Message message, bool fresh) {
+	if (findMessage(chat, message.randomId)) {
+		return;
+	}
+	const auto unread = fresh && !message.out && !message.note;
+	if (unread) {
+		++chat.unread;
+	}
+	chat.messages.push_back(std::move(message));
+	createItem(chat, chat.messages.back(), unread);
+	while (int(chat.messages.size()) > kMaxMessages) {
+		dropMedia(chat, chat.messages.front());
+		destroyItem(chat, chat.messages.front().randomId);
+		chat.messages.erase(begin(chat.messages));
+	}
+	save();
+}
+
+void Manager::addNote(
+		Chat &chat,
+		const QString &text,
+		TimeId date,
+		bool unread) {
+	auto message = Message();
+	message.randomId = RandomId();
+	message.note = true;
+	message.date = date;
+	message.text = TextWithEntities{ text };
+	chat.messages.push_back(message);
+	createItem(chat, chat.messages.back(), unread);
+	save();
+}
+
+void Manager::setMessageState(
+		Chat &chat,
+		int64 randomId,
+		MessageState state) {
+	const auto message = findMessage(chat, randomId);
+	if (!message || message->state == state) {
+		return;
+	}
+	message->state = state;
+	save();
+	const auto &binding = chat.binding;
+	const auto i = binding.items.find(randomId);
+	if (!binding.user || i == end(binding.items)) {
+		return;
+	}
+	auto &owner = _session->data();
+	const auto item = owner.message(binding.user->id, i->second);
+	if (!item) {
+		return;
+	}
+	if (state == MessageState::Failed) {
+		if (item->isSending()) {
+			item->sendFailed();
+		}
+	} else if (item->isSending()) {
+		item->markEphemeralSent();
+	} else if (item->hasFailed()) {
+		destroyItem(chat, randomId);
+		createItem(chat, *message, false);
+		return;
+	}
+	owner.requestItemRepaint(item);
+}
+
+void Manager::removeMessage(Chat &chat, int64 randomId) {
+	if (const auto message = findMessage(chat, randomId)) {
+		dropMedia(chat, *message);
+	}
+	destroyItem(chat, randomId);
+	chat.messages.erase(
+		ranges::remove(chat.messages, randomId, &Message::randomId),
+		end(chat.messages));
+}
+
+void Manager::clearMessages(Chat &chat) {
+	auto ids = std::vector<int64>();
+	for (const auto &message : chat.messages) {
+		ids.push_back(message.randomId);
+		dropMedia(chat, message);
+	}
+	for (const auto id : ids) {
+		destroyItem(chat, id);
+	}
+	chat.messages.clear();
+	chat.unread = 0;
+	if (const auto history = chat.binding.history) {
+		history->setUnreadCount(0);
+	}
+}
+
+void Manager::ensureBinding(Chat &chat) {
+	auto &binding = chat.binding;
+	auto &owner = _session->data();
+	if (!binding.real) {
+		binding.real = owner.userLoaded(UserId(chat.peerUserId));
+		if (binding.real) {
+			const auto chatId = chat.id;
+			_session->changes().peerUpdates(
+				binding.real,
+				(Data::PeerUpdate::Flag::Name
+					| Data::PeerUpdate::Flag::Photo)
+			) | rpl::on_next([=](const Data::PeerUpdate &update) {
+				const auto chat = find(chatId);
+				if (!chat) {
+					return;
+				}
+				refreshBinding(*chat);
+				if ((update.flags & Data::PeerUpdate::Flag::Photo)
+					&& chat->binding.user) {
+					_session->changes().peerUpdated(
+						chat->binding.user,
+						Data::PeerUpdate::Flag::Photo);
+				}
+			}, binding.lifetime);
+		}
+	}
+	rememberPeer(chat);
+	const auto name = peerName(chat);
+	if (!binding.user) {
+		using Flag = MTPDuser::Flag;
+		binding.user = owner.processUser(MTP_user(
+			MTP_flags(Flag::f_first_name | Flag::f_photo),
+			MTP_long(FakeBare(chat.id)),
+			MTPlong(),
+			MTP_string(name),
+			MTPstring(),
+			MTPstring(),
+			MTPstring(),
+			MTP_userProfilePhotoEmpty(),
+			MTPUserStatus(),
+			MTPint(),
+			MTPVector<MTPRestrictionReason>(),
+			MTPstring(),
+			MTPstring(),
+			MTPEmojiStatus(),
+			MTPVector<MTPUsername>(),
+			MTPRecentStory(),
+			MTPPeerColor(),
+			MTPPeerColor(),
+			MTPint(),
+			MTPlong(),
+			MTPlong(),
+			MTPlong()));
+		binding.user->setCallsStatus(UserData::CallsStatus::Disabled);
+		if (binding.user->notify().settingsUnknown()) {
+			binding.user->notify().resetToDefault();
+		}
+	} else if (binding.user->name() != name) {
+		binding.user->setName(name, QString(), QString(), QString());
+	}
+	if (!binding.history) {
+		binding.history = owner.history(binding.user);
+		if (!binding.history->folderKnown()) {
+			binding.history->applyDialogFields(nullptr, 0, 0, 0);
+			binding.history->dialogEntryApplied();
+		}
+	}
+}
+
+void Manager::rememberPeer(Chat &chat) {
+	const auto real = chat.binding.real;
+	if (!real) {
+		return;
+	}
+	auto dirty = false;
+	if (const auto hash = real->accessHash()
+		; hash && hash != chat.peerAccessHash) {
+		chat.peerAccessHash = hash;
+		dirty = true;
+	}
+	if (const auto name = real->name()
+		; !name.isEmpty() && name != chat.peerName) {
+		chat.peerName = name;
+		dirty = true;
+	}
+	if (dirty) {
+		save();
+	}
+}
+
+void Manager::bindReal(Chat &chat) {
+	if (chat.binding.real || !chat.binding.user) {
+		return;
+	}
+	ensureBinding(chat);
+	if (!chat.binding.real) {
+		return;
+	}
+	_session->changes().peerUpdated(
+		chat.binding.user,
+		(Data::PeerUpdate::Flag::Photo
+			| Data::PeerUpdate::Flag::OnlineStatus));
+	_chatChanges.fire_copy(chat.id);
+}
+
+void Manager::refreshUsers() {
+	for (auto &[id, chat] : _chats) {
+		bindReal(chat);
+	}
+	requestUsers();
+}
+
+void Manager::requestUsers() {
+	if (_usersRequested) {
+		return;
+	}
+	auto users = QVector<MTPInputUser>();
+	for (const auto &[id, chat] : _chats) {
+		if (!chat.binding.real && chat.peerUserId && chat.peerAccessHash) {
+			users.push_back(MTP_inputUser(
+				MTP_long(chat.peerUserId),
+				MTP_long(chat.peerAccessHash)));
+		}
+	}
+	if (users.isEmpty()) {
+		return;
+	}
+	_usersRequested = true;
+	_session->api().request(MTPusers_GetUsers(
+		MTP_vector<MTPInputUser>(std::move(users))
+	)).done(crl::guard(this, [=](const MTPVector<MTPUser> &result) {
+		_session->data().processUsers(result);
+		for (auto &[id, chat] : _chats) {
+			bindReal(chat);
+		}
+	})).fail(crl::guard(this, [=](const MTP::Error &) {
+		_usersRequested = false;
+	})).send();
+}
+
+void Manager::refreshBinding(Chat &chat) {
+	ensureBinding(chat);
+	_session->changes().peerUpdated(
+		chat.binding.user,
+		Data::PeerUpdate::Flag::OnlineStatus);
+}
+
+void Manager::createItem(Chat &chat, const Message &message, bool unread) {
+	auto &binding = chat.binding;
+	if (!binding.history || binding.items.contains(message.randomId)) {
+		return;
+	}
+	const auto history = binding.history;
+	auto &owner = _session->data();
+	const auto id = owner.nextLocalMessageId();
+	binding.items[message.randomId] = id;
+	binding.randomIds[id] = message.randomId;
+	auto flags = MessageFlags(MessageFlag::Local);
+	auto item = (HistoryItem*)nullptr;
+	if (message.note) {
+		if (unread) {
+			flags |= MessageFlag::ClientSideUnread;
+		}
+		item = history->makeMessage(
+			HistoryItemCommonFields{
+				.id = id,
+				.flags = flags,
+				.date = message.date,
+			},
+			PreparedServiceText{ .text = message.text });
+		history->addNewLocalMessage(item);
+	} else {
+		flags |= MessageFlag::HasFromId;
+		if (message.out) {
+			flags |= MessageFlag::Outgoing;
+			if (message.state == MessageState::Sending
+				|| message.state == MessageState::Failed) {
+				flags |= MessageFlag::BeingSent;
+			}
+		} else if (unread) {
+			flags |= MessageFlag::ClientSideUnread;
+		}
+		auto replyTo = FullReplyTo();
+		if (message.replyTo) {
+			const auto i = binding.items.find(message.replyTo);
+			if (i != end(binding.items)) {
+				replyTo.messageId = FullMsgId(binding.user->id, i->second);
+				flags |= MessageFlag::HasReplyInfo;
+			}
+		}
+		auto fields = HistoryItemCommonFields{
+			.id = id,
+			.flags = flags,
+			.from = (message.out
+				? _session->userPeerId()
+				: binding.user->id),
+			.replyTo = replyTo,
+			.date = message.date,
+			.mediaSpoiler = (!message.out && IsHoldMedia(message)),
+		};
+		const auto &media = message.media;
+		if (media.external) {
+			item = history->addNewLocalMessage(
+				std::move(fields),
+				externalDocument(media),
+				message.text);
+		} else if (HasFile(media) && media.type == MediaType::Photo) {
+			item = history->addNewLocalMessage(
+				std::move(fields),
+				mediaPhoto(chat, message),
+				message.text);
+		} else if (HasFile(media)) {
+			item = history->addNewLocalMessage(
+				std::move(fields),
+				mediaDocument(chat, message),
+				message.text);
+		} else if (media.type == MediaType::Contact) {
+			item = history->addNewLocalMessage(
+				std::move(fields),
+				message.text,
+				MTP_messageMediaContact(
+					MTP_string(media.phone),
+					MTP_string(media.firstName),
+					MTP_string(media.lastName),
+					MTP_string(QString()),
+					MTP_long(media.userId)));
+		} else if (media.type == MediaType::Geo
+			|| media.type == MediaType::Venue) {
+			auto text = LocationText(media);
+			if (!message.text.empty()) {
+				text.append(u"\n\n"_q).append(message.text);
+			}
+			item = history->addNewLocalMessage(
+				std::move(fields),
+				text,
+				MTP_messageMediaEmpty());
+		} else {
+			item = history->addNewLocalMessage(
+				std::move(fields),
+				message.text,
+				MTP_messageMediaEmpty());
+		}
+		if (message.state == MessageState::Failed) {
+			item->sendFailed();
+		}
+	}
+	owner.sendHistoryChangeNotifications();
+}
+
+void Manager::destroyItem(Chat &chat, int64 randomId) {
+	auto &binding = chat.binding;
+	_timerTexts.remove(Key(chat.id, randomId));
+	const auto i = binding.items.find(randomId);
+	if (i == end(binding.items)) {
+		return;
+	}
+	const auto msgId = i->second;
+	binding.items.erase(i);
+	binding.randomIds.remove(msgId);
+	if (binding.user) {
+		if (const auto item = _session->data().message(
+				binding.user->id,
+				msgId)) {
+			item->destroy();
+		}
+	}
+}
+
+void Manager::destroyBinding(Chat &chat) {
+	auto &binding = chat.binding;
+	auto ids = std::vector<int64>();
+	for (const auto &[randomId, msgId] : binding.items) {
+		ids.push_back(randomId);
+	}
+	for (const auto id : ids) {
+		destroyItem(chat, id);
+	}
+	if (binding.user && binding.history) {
+		_session->data().deleteConversationLocally(binding.user);
+	}
+	binding.history = nullptr;
+	binding.real = nullptr;
+	binding.lifetime.destroy();
+}
+
+void Manager::showTyping(Chat &chat) {
+	const auto &binding = chat.binding;
+	if (!binding.history || !binding.user) {
+		return;
+	}
+	_session->data().sendActionManager().registerFor(
+		binding.history,
+		MsgId(0),
+		binding.user,
+		MTP_sendMessageTypingAction(),
+		base::unixtime::now());
+}
+
+not_null<DocumentData*> Manager::mediaDocument(
+		Chat &chat,
+		const Message &message) {
+	auto &binding = chat.binding;
+	if (const auto i = binding.documents.find(message.randomId)
+		; i != end(binding.documents)) {
+		return i->second;
+	}
+	const auto &media = message.media;
+	const auto document = _session->data().document(
+		DocumentId(uint64(message.randomId)),
+		FakeAccess(message.randomId),
+		QByteArray(),
+		message.date,
+		DocumentAttributes(media),
+		(media.mime.isEmpty() ? DefaultMime(media.type) : media.mime),
+		InlineImageLocation(),
+		ImageWithLocation(),
+		ImageWithLocation(),
+		false,
+		(media.fileDc ? media.fileDc : _session->mainDcId()),
+		media.size);
+	document->setNotSupportsStreaming();
+	binding.documents.emplace(message.randomId, document);
+	_documentKeys[document] = Key(chat.id, message.randomId);
+	return document;
+}
+
+not_null<PhotoData*> Manager::mediaPhoto(
+		Chat &chat,
+		const Message &message) {
+	auto &binding = chat.binding;
+	if (const auto i = binding.photos.find(message.randomId)
+		; i != end(binding.photos)) {
+		return i->second;
+	}
+	const auto &media = message.media;
+	const auto id = PhotoId(uint64(message.randomId));
+	const auto access = FakeAccess(message.randomId);
+	const auto dc = media.fileDc ? media.fileDc : _session->mainDcId();
+	const auto width = (media.width > 0)
+		? media.width
+		: std::max(media.thumbWidth, 1) * 4;
+	const auto height = (media.height > 0)
+		? media.height
+		: std::max(media.thumbHeight, 1) * 4;
+	const auto large = ImageWithLocation{
+		.location = ImageLocation(
+			{ StorageFileLocation(
+				dc,
+				_session->userId(),
+				MTP_inputPhotoFileLocation(
+					MTP_long(id),
+					MTP_long(access),
+					MTP_bytes(QByteArray()),
+					MTP_string(u"y"_q))) },
+			width,
+			height),
+		.bytesCount = int(media.size),
+	};
+	const auto photo = _session->data().photo(
+		id,
+		access,
+		QByteArray(),
+		message.date,
+		dc,
+		false,
+		QByteArray(),
+		ImageWithLocation(),
+		ImageWithLocation(),
+		large,
+		ImageWithLocation(),
+		ImageWithLocation(),
+		crl::time(0));
+	binding.photos.emplace(message.randomId, photo);
+	_photoKeys[photo] = Key(chat.id, message.randomId);
+	return photo;
+}
+
+not_null<DocumentData*> Manager::externalDocument(const Media &media) {
+	auto &owner = _session->data();
+	const auto existing = owner.document(DocumentId(media.documentId));
+	if (existing->hasRemoteLocation()) {
+		return existing;
+	}
+	const auto result = owner.document(
+		DocumentId(media.documentId),
+		media.documentAccessHash,
+		QByteArray(),
+		media.documentDate,
+		DocumentAttributes(media),
+		media.mime,
+		InlineImageLocation(),
+		ImageWithLocation(),
+		ImageWithLocation(),
+		false,
+		media.documentDc,
+		media.size);
+	if (!media.stickerSet.isEmpty()) {
+		requestStickerSet(media.stickerSet);
+	}
+	return result;
+}
+
+void Manager::requestStickerSet(const QString &shortName) {
+	if (_stickerSetsRequested.contains(shortName)) {
+		return;
+	}
+	_stickerSetsRequested.emplace(shortName);
+	_session->api().request(MTPmessages_GetStickerSet(
+		MTP_inputStickerSetShortName(MTP_string(shortName)),
+		MTP_int(0)
+	)).done(crl::guard(this, [=](const MTPmessages_StickerSet &result) {
+		result.match([&](const MTPDmessages_stickerSet &data) {
+			auto &owner = _session->data();
+			for (const auto &document : data.vdocuments().v) {
+				const auto parsed = owner.processDocument(document);
+				if (parsed->status == FileDownloadFailed) {
+					parsed->status = FileReady;
+				}
+				owner.notifyDocumentLayoutChanged(parsed);
+			}
+		}, [](const MTPDmessages_stickerSetNotModified &) {
+		});
+	})).send();
+}
+
+bool Manager::ownsDocument(not_null<const DocumentData*> document) const {
+	return _documentKeys.contains(document);
+}
+
+bool Manager::ownsPhoto(not_null<const PhotoData*> photo) const {
+	return _photoKeys.contains(photo);
+}
