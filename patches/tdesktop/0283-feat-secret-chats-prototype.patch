+void SetThumb(Media &media, const QImage &image) {
+	if (image.isNull()) {
+		return;
+	}
+	const auto thumb = Opaque(image).scaled(
+		kThumbSide,
+		kThumbSide,
+		Qt::KeepAspectRatio,
+		Qt::SmoothTransformation);
+	media.thumb = JpegBytes(thumb, kThumbQuality);
+	media.thumbWidth = thumb.width();
+	media.thumbHeight = thumb.height();
+}
+
+[[nodiscard]] QString DefaultMime(MediaType type) {
+	switch (type) {
+	case MediaType::Photo: return u"image/jpeg"_q;
+	case MediaType::Video:
+	case MediaType::Round:
+	case MediaType::Animation: return u"video/mp4"_q;
+	case MediaType::Voice: return u"audio/ogg"_q;
+	case MediaType::Audio: return u"audio/mpeg"_q;
+	default: return u"application/octet-stream"_q;
+	}
+}
+
+[[nodiscard]] QVector<MTPDocumentAttribute> DocumentAttributes(
+		const Media &media) {
+	auto result = QVector<MTPDocumentAttribute>();
+	if (!media.fileName.isEmpty()) {
+		result.push_back(MTP_documentAttributeFilename(
+			MTP_string(media.fileName)));
+	}
+	const auto image = media.mime.startsWith(u"image/"_q);
+	const auto imageSize = [&] {
+		if (media.width > 0 && media.height > 0) {
+			result.push_back(MTP_documentAttributeImageSize(
+				MTP_int(media.width),
+				MTP_int(media.height)));
+		}
+	};
+	const auto video = [&](bool round) {
+		using Flag = MTPDdocumentAttributeVideo::Flag;
+		result.push_back(MTP_documentAttributeVideo(
+			MTP_flags(round ? Flag::f_round_message : Flag()),
+			MTP_double(media.duration),
+			MTP_int(media.width),
+			MTP_int(media.height),
+			MTPint(),
+			MTPdouble(),
+			MTPstring()));
+	};
+	switch (media.type) {
+	case MediaType::Sticker:
+		imageSize();
+		result.push_back(MTP_documentAttributeSticker(
+			MTP_flags(0),
+			MTP_string(media.emoji),
+			(media.stickerSet.isEmpty()
+				? MTP_inputStickerSetEmpty()
+				: MTP_inputStickerSetShortName(
+					MTP_string(media.stickerSet))),
+			MTPMaskCoords()));
+		if (media.mime == u"video/webm"_q) {
+			video(false);
+		}
+		break;
+	case MediaType::Animation:
+		result.push_back(MTP_documentAttributeAnimated());
+		if (image) {
+			imageSize();
+		} else {
+			video(false);
+		}
+		break;
+	case MediaType::Video:
+	case MediaType::Round:
+		video(media.type == MediaType::Round);
+		break;
+	case MediaType::Voice:
+	case MediaType::Audio: {
+		using Flag = MTPDdocumentAttributeAudio::Flag;
+		const auto voice = (media.type == MediaType::Voice);
+		auto flags = MTPDdocumentAttributeAudio::Flags(0);
+		if (voice) {
+			flags |= Flag::f_voice;
+			if (!media.waveform.isEmpty()) {
+				flags |= Flag::f_waveform;
+			}
+		} else {
+			if (!media.title.isEmpty()) {
+				flags |= Flag::f_title;
+			}
+			if (!media.performer.isEmpty()) {
+				flags |= Flag::f_performer;
+			}
+		}
+		result.push_back(MTP_documentAttributeAudio(
+			MTP_flags(flags),
+			MTP_int(media.duration),
+			MTP_string(media.title),
+			MTP_string(media.performer),
+			MTP_bytes(media.waveform)));
+	} break;
+	default:
+		if (image) {
+			imageSize();
+		}
+		break;
+	}
+	return result;
+}
+
+[[nodiscard]] TextWithEntities LocationText(const Media &media) {
+	const auto latitude = QString::number(media.latitude, 'f', 6);
+	const auto longitude = QString::number(media.longitude, 'f', 6);
+	const auto url = u"https://www.openstreetmap.org/?mlat=%1&mlon=%2"
+		"#map=16/%1/%2"_q.arg(latitude, longitude);
+	auto result = TextWithEntities();
+	if (media.type == MediaType::Venue) {
+		if (!media.venueTitle.isEmpty()) {
+			result.text += media.venueTitle + '\n';
+		}
+		if (!media.venueAddress.isEmpty()) {
+			result.text += media.venueAddress + '\n';
+		}
+	}
+	result.text += Lower(u"Location: "_q);
+	const auto coordinates = latitude + u", "_q + longitude;
+	result.entities.push_back(EntityInText(
+		::EntityType::CustomUrl,
+		int(result.text.size()),
+		int(coordinates.size()),
+		url));
+	result.text += coordinates;
+	return result;
+}
+
+[[nodiscard]] QString MessageTimerText(const Message &message) {
+	if (message.note || message.ttl <= 0) {
+		return QString();
+	}
+	const auto left = message.destroyAt
+		? std::max(message.destroyAt - base::unixtime::now(), TimeId(1))
+		: TimeId(message.ttl);
+	return TimerTinyText(left);
+}
+
+[[nodiscard]] bool ShowsOnOpen(const Message &message) {
+	return IsViewTriggered(message)
+		&& !IsHoldMedia(message)
+		&& (message.media.type == MediaType::Photo
+			|| message.media.type == MediaType::Animation);
+}
+
+} // namespace
+
+int ChatIdOf(PeerId peerId) {
+	return IsSecretPeerId(peerId)
+		? int(uint32((peerToUser(peerId).bare - kPeerBase) / 2))
+		: 0;
+}
+
+bool IsHoldMedia(const Message &message) {
+	if (message.note
+		|| message.ttl <= 0
+		|| message.ttl > kHoldMediaTtl
+		|| !HasFile(message.media)) {
+		return false;
+	}
+	switch (message.media.type) {
+	case MediaType::Photo:
+	case MediaType::Video:
+	case MediaType::Round:
+	case MediaType::Animation:
+		return true;
+	default:
+		return false;
+	}
+}
+
+bool IsViewTriggered(const Message &message) {
+	if (message.note || message.ttl <= 0) {
+		return false;
+	}
+	switch (message.media.type) {
+	case MediaType::Photo:
+	case MediaType::Animation:
+		return (message.ttl <= kHoldMediaTtl);
+	case MediaType::Video:
+	case MediaType::Round:
+	case MediaType::Voice:
+		return true;
+	default:
+		return false;
+	}
+}
+
+QString TimerTinyText(int seconds) {
+	if (seconds <= 0) {
+		return QString();
+	}
+	const auto up = [&](int unit) {
+		return QString::number((seconds + unit - 1) / unit);
+	};
+	return (seconds < 60)
+		? (QString::number(seconds) + 's')
+		: (seconds < 3600)
+		? (up(60) + 'm')
+		: (seconds < 86400)
+		? (up(3600) + 'h')
+		: (seconds < 7 * 86400)
+		? (up(86400) + 'd')
+		: (up(7 * 86400) + 'w');
+}
+
+QString TimerFullText(int seconds) {
+	const auto make = [](int count, const QString &unit) -> QString {
+		return QString::number(count)
+			+ ' '
+			+ unit
+			+ ((count == 1) ? QString() : u"s"_q);
+	};
+	return (seconds <= 0)
+		? QString()
+		: !(seconds % (7 * 86400))
+		? make(seconds / (7 * 86400), u"week"_q)
+		: !(seconds % 86400)
+		? make(seconds / 86400, u"day"_q)
+		: !(seconds % 3600)
+		? make(seconds / 3600, u"hour"_q)
+		: !(seconds % 60)
+		? make(seconds / 60, u"minute"_q)
+		: make(seconds, u"second"_q);
+}
+
+Manager::Manager(not_null<Main::Session*> session)
+: _session(session)
+, _store(Vault::Prepare(session))
+, _ttlTimer([=] { checkTtls(); }) {
+	load();
+	crl::on_main(this, [=] {
+		for (auto &[id, chat] : _chats) {
+			ensureBinding(chat);
+			purgeExpired(chat);
+			const auto from = std::max(
+				int(chat.messages.size()) - kShownMessages,
+				0);
+			auto unreadLeft = chat.unread;
+			auto unreadFrom = int(chat.messages.size());
+			for (auto i = int(chat.messages.size()) - 1;
+				i >= from && unreadLeft > 0;
+				--i) {
+				const auto &message = chat.messages[i];
+				if (!message.out && !message.note) {
+					unreadFrom = i;
+					--unreadLeft;
+				}
+			}
+			for (auto i = from; i != int(chat.messages.size()); ++i) {
+				const auto &message = chat.messages[i];
+				createItem(
+					chat,
+					message,
+					!message.out && !message.note && (i >= unreadFrom));
+			}
+			if (const auto history = chat.binding.history) {
+				Core::App().notifications().clearFromHistory(history);
+			}
+			if (chat.state == ChatState::Ready) {
+				resendUnacked(chat);
+			}
+			auto downloads = std::vector<int64>();
+			for (const auto &message : chat.messages) {
+				if (!message.out
+					&& HasFile(message.media)
+					&& !message.media.stored) {
+					downloads.push_back(message.randomId);
+				}
+			}
+			for (const auto randomId : downloads) {
+				startDownload(id, randomId);
+			}
+		}
+		_session->data().sendHistoryChangeNotifications();
+		requestUsers();
+		scheduleTtl();
+	});
+	_session->changes().peerUpdates(
+		Data::PeerUpdate::Flag::Name
+	) | rpl::filter([](const Data::PeerUpdate &update) {
+		return update.peer->isUser() && !IsSecretPeerId(update.peer->id);
+	}) | rpl::on_next([=](const Data::PeerUpdate &update) {
+		const auto bare = peerToUser(update.peer->id).bare;
+		for (auto &[id, chat] : _chats) {
+			if (!chat.binding.real && chat.peerUserId == bare) {
+				bindReal(chat);
+			}
+		}
+	}, _lifetime);
+	_session->data().itemRemoved(
+	) | rpl::filter([](not_null<const HistoryItem*> item) {
+		return item->isSending()
+			&& IsSecretPeerId(item->history()->peer->id);
+	}) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		itemRemoved(item->history()->peer->id, item->id);
+	}, _lifetime);
+	::Media::Player::instance()->updatedNotifier(
+	) | rpl::on_next([=](const ::Media::Player::TrackState &state) {
+		const auto context = state.id.contextId();
+		const auto document = state.id.audio();
+		if (!IsSecretPeerId(context.peer)
+			|| !document
+			|| &document->session() != _session.get()) {
+			return;
+		} else if (state.state != ::Media::Player::State::Playing) {
+			if (::Media::Player::IsStopped(state.state)
+				&& _playViewed == context) {
+				_playViewed = FullMsgId();
+			}
+			return;
+		} else if (_playViewed == context) {
+			return;
+		}
+		_playViewed = context;
+		viewed(ChatIdOf(context.peer), context.msg);
+	}, _lifetime);
+}
