+[[nodiscard]] TextWithEntities ToText(
+		const QString &text,
+		const std::vector<Entity> &entities) {
+	auto result = TextWithEntities{ text };
+	const auto size = int(text.size());
+	for (const auto &entity : entities) {
+		const auto type = ToTextType(entity.type);
+		if (type == ::EntityType::Invalid
+			|| entity.length <= 0
+			|| entity.offset < 0
+			|| entity.offset > size
+			|| entity.length > size - entity.offset) {
+			continue;
+		}
+		result.entities.push_back(EntityInText(
+			type,
+			entity.offset,
+			entity.length,
+			entity.extra));
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<Entity> FromText(
+		const TextWithEntities &text,
+		int layer) {
+	auto result = std::vector<Entity>();
+	for (const auto &entity : text.entities) {
+		const auto type = FromTextType(entity.type(), layer);
+		if (!type) {
+			continue;
+		}
+		result.push_back({
+			.type = *type,
+			.offset = entity.offset(),
+			.length = entity.length(),
+			.extra = ((*type == EntityType::Pre
+				|| *type == EntityType::TextUrl)
+				? entity.data()
+				: QString()),
+		});
+	}
+	return result;
+}
+
+void WriteText(QDataStream &stream, const TextWithEntities &text) {
+	stream << text.text << qint32(text.entities.size());
+	for (const auto &entity : text.entities) {
+		stream
+			<< qint32(entity.type())
+			<< qint32(entity.offset())
+			<< qint32(entity.length())
+			<< entity.data();
+	}
+}
+
+[[nodiscard]] TextWithEntities ReadText(QDataStream &stream) {
+	auto result = TextWithEntities();
+	auto count = qint32();
+	stream >> result.text >> count;
+	for (auto i = 0; i < count && stream.status() == QDataStream::Ok; ++i) {
+		auto type = qint32();
+		auto offset = qint32();
+		auto length = qint32();
+		auto data = QString();
+		stream >> type >> offset >> length >> data;
+		if (type > 0 && type <= int(::EntityType::FormattedDate)) {
+			result.entities.push_back(EntityInText(
+				::EntityType(type),
+				offset,
+				length,
+				data));
+		}
+	}
+	return result;
+}
