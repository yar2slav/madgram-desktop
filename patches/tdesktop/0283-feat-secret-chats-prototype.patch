+#include "media/streaming/media_streaming_player.h"
+#include "tele/secret/secret_chats.h"
+#include "tele/secret/secret_manager.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_secret_media.h"
+#include "ui/image/image.h"
+#include "ui/painter.h"
+#include "ui/rp_widget.h"
+#include "window/window_session_controller.h"
+#include "styles/style_basic.h"
+
+#include <QtGui/QGuiApplication>
+#include <QtGui/QPainterPath>
+
+namespace Tele::Secret {
+namespace {
+
+constexpr auto kCheckEvery = crl::time(100);
+constexpr auto kMargin = 24;
+
+class HoldViewer final : public Ui::RpWidget {
+public:
+	HoldViewer(
+		QWidget *parent,
+		not_null<HistoryItem*> item,
+		Fn<void()> close);
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+
+	void check();
+	void startVideo();
+	[[nodiscard]] QSize mediaSize() const;
+	[[nodiscard]] QRect contentRect() const;
+
+	const not_null<Main::Session*> _session;
+	const FullMsgId _itemId;
+	const int _chatId = 0;
+	const Fn<void()> _close;
+	PhotoData *_photo = nullptr;
+	DocumentData *_document = nullptr;
+	std::shared_ptr<Data::PhotoMedia> _photoMedia;
+	std::shared_ptr<Data::DocumentMedia> _documentMedia;
+	std::unique_ptr<::Media::Streaming::Instance> _instance;
+	base::Timer _timer;
+	bool _holding = false;
+	bool _revealed = false;
+
+};
+
+HoldViewer::HoldViewer(
+	QWidget *parent,
+	not_null<HistoryItem*> item,
+	Fn<void()> close)
+: RpWidget(parent)
+, _session(&item->history()->session())
+, _itemId(item->fullId())
+, _chatId(ChatIdOf(item->history()->peer->id))
+, _close(std::move(close))
+, _timer([=] { check(); }) {
+	if (const auto media = item->media()) {
+		_photo = media->photo();
+		_document = media->document();
+	}
+	if (_photo) {
+		_photoMedia = _photo->createMediaView();
+	} else if (_document) {
+		_documentMedia = _document->createMediaView();
+	}
+	if (const auto manager = FindManager(_session)) {
+		manager->loadMedia(_chatId, item->id, crl::guard(this, [=] {
+			update();
+		}));
+	}
+	_session->data().itemRemoved(
+		_itemId
+	) | rpl::on_next([=] {
+		_close();
+	}, lifetime());
+	setCursor(style::cur_pointer);
+	_timer.callEach(kCheckEvery);
+}
+
+void HoldViewer::check() {
+	if (!_holding) {
+		return;
+	} else if (!(QGuiApplication::mouseButtons() & Qt::LeftButton)) {
+		_holding = false;
+		_close();
+		return;
+	} else if (_document && !_instance) {
+		startVideo();
+	}
+	update();
+}
+
+void HoldViewer::startVideo() {
+	if (!_documentMedia || _documentMedia->bytes().isEmpty()) {
+		return;
+	}
+	_instance = std::make_unique<::Media::Streaming::Instance>(
+		_document,
+		_itemId,
+		[=] { update(); });
+	if (!_instance->valid()) {
+		_instance = nullptr;
+		return;
+	}
+	_instance->player().updates(
+	) | rpl::on_next_error([=](::Media::Streaming::Update &&) {
+		update();
+	}, [=](::Media::Streaming::Error &&) {
+		update();
+	}, _instance->lifetime());
+	auto options = ::Media::Streaming::PlaybackOptions();
+	options.audioId = AudioMsgId(_document, _itemId);
+	options.loop = true;
+	_instance->play(options);
+}
+
+QSize HoldViewer::mediaSize() const {
+	if (_photo) {
+		return QSize(_photo->width(), _photo->height());
+	} else if (_document && _document->isVideoMessage()) {
+		return QSize(1, 1);
+	} else if (_instance && _instance->ready()) {
+		return _instance->info().video.size;
+	} else if (_document) {
+		return _document->dimensions;
+	}
+	return QSize();
+}
+
+QRect HoldViewer::contentRect() const {
+	const auto margin = style::ConvertScale(kMargin);
+	const auto available = rect().marginsRemoved(
+		{ margin, margin, margin, margin });
+	auto size = mediaSize();
+	if (size.isEmpty() || available.isEmpty()) {
+		return available;
+	}
+	size = size.scaled(available.size(), Qt::KeepAspectRatio);
+	return QRect(
+		available.x() + (available.width() - size.width()) / 2,
+		available.y() + (available.height() - size.height()) / 2,
+		size.width(),
+		size.height());
+}
+
+void HoldViewer::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto drawText = [&](const QString &text, QRect area) {
+		p.setFont(st::semiboldFont);
+		p.setPen(QColor(255, 255, 255));
+		p.drawText(area, text, style::al_center);
+	};
+	if (!_holding) {
+		drawText(Lower(u"Hold to view"_q), rect());
+		return;
+	}
+	const auto content = contentRect();
+	auto hq = PainterHighQualityEnabler(p);
+	auto shown = false;
+	if (_photoMedia) {
+		if (const auto image = _photoMedia->image(Data::PhotoSize::Large)) {
+			p.drawImage(content, image->original());
+			shown = true;
+		}
+	} else if (_instance && _instance->ready()) {
+		auto request = ::Media::Streaming::FrameRequest();
+		request.outer = request.resize = content.size()
+			* style::DevicePixelRatio();
+		const auto frame = _instance->frame(request);
+		if (!frame.isNull()) {
+			if (_document->isVideoMessage()) {
+				auto path = QPainterPath();
+				path.addEllipse(content);
+				p.setClipPath(path);
+			}
+			p.drawImage(content, frame);
+			p.setClipping(false);
+			shown = true;
+		}
+	}
+	if (!shown) {
+		drawText(Lower(u"Loading..."_q), rect());
+	}
+	if (const auto item = _session->data().message(_itemId)) {
+		const auto timer = TimerText(item);
+		if (!timer.isEmpty()) {
+			const auto margin = style::ConvertScale(kMargin);
+			drawText(timer, QRect(0, 0, width(), margin));
+		}
+	}
+}
+
+void HoldViewer::mousePressEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	_holding = true;
+	if (!_revealed) {
+		_revealed = true;
+		if (const auto manager = FindManager(_session)) {
+			manager->viewed(_chatId, _itemId.msg);
+		}
+	}
+	if (_document && !_instance) {
+		startVideo();
+	}
+	update();
+}
+
+void HoldViewer::mouseReleaseEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton || !_holding) {
+		return;
+	}
+	_holding = false;
+	_close();
+}
+
+} // namespace
+
+void ShowHoldViewer(
+		not_null<Window::SessionController*> controller,
+		not_null<HistoryItem*> item) {
+	const auto parent = controller->content();
+	const auto show = controller->uiShow();
+	const auto closing = std::make_shared<bool>(false);
+	const auto close = [=] {
+		if (!*closing) {
+			*closing = true;
+			show->hideLayer();
+		}
+	};
+	auto layer = std::make_unique<Editor::LayerWidget>(
+		parent,
+		base::make_unique_q<HoldViewer>(parent, item, close));
+	Core::App().screenshotProtection().addContentReason(
+		controller->widget(),
+		rpl::single(ForbidsCapture(item)),
+		layer->lifetime());
+	base::install_event_filter(layer.get(), [=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::KeyPress) {
+			const auto k = static_cast<QKeyEvent*>(e.get());
+			if (k->key() == Qt::Key_Escape) {
+				close();
+			}
+			return base::EventFilterResult::Cancel;
+		}
+		return base::EventFilterResult::Continue;
+	});
+	controller->showLayer(std::move(layer), Ui::LayerOption::KeepOther);
+}
+
+} // namespace Tele::Secret
