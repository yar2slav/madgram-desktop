+void SecretWidget::setupComposeControls() {
+	_composeControls->setCurrentDialogsEntryState({
+		.key = _history,
+		.section = Dialogs::EntryState::Section::History,
+	});
+	_composeControls->setHistory({
+		.history = _history.get(),
+		.sendActionFactory = [=] {
+			return Api::SendAction(_history);
+		},
+		.writeRestriction = _restriction.value(),
+	});
+
+	_composeControls->height(
+	) | rpl::on_next([=] {
+		const auto wasMax = (_scroll->scrollTop() >= _scroll->scrollTopMax());
+		updateControlsGeometry();
+		if (wasMax) {
+			listScrollTo(_scroll->scrollTopMax());
+		}
+	}, lifetime());
+
+	_composeControls->cancelRequests(
+	) | rpl::on_next([=] {
+		listCancelRequest();
+	}, lifetime());
+
+	_composeControls->sendRequests(
+	) | rpl::on_next([=] {
+		send();
+	}, lifetime());
+
+	_composeControls->sendActionUpdates(
+	) | rpl::on_next([=](ComposeControls::SendActionUpdate &&data) {
+		if (data.type == Api::SendProgressType::Typing && !data.cancel) {
+			if (const auto manager = this->manager()) {
+				manager->setTyping(_chatId);
+			}
+		}
+	}, lifetime());
+
+	rpl::merge(
+		_composeControls->scrollKeyEvents(),
+		_inner->scrollKeyEvents()
+	) | rpl::on_next([=](not_null<QKeyEvent*> e) {
+		_scroll->keyPressEvent(e);
+	}, lifetime());
+
+	_composeControls->setPasteToastParent(_scroll.get());
+	_composeControls->setMimeDataHook([=](
+			not_null<const QMimeData*> data,
+			Ui::InputField::MimeAction action) {
+		if (action == Ui::InputField::MimeAction::Check) {
+			return Core::CanSendFiles(data);
+		} else if (action == Ui::InputField::MimeAction::Insert) {
+			return confirmSendingFiles(
+				data,
+				std::nullopt,
+				Core::ReadMimeText(data));
+		}
+		return false;
+	});
+
+	_composeControls->sendVoiceRequests(
+	) | rpl::on_next([=](const ComposeControls::VoiceToSend &data) {
+		sendVoice(data);
+	}, lifetime());
+
+	_composeControls->attachRequests(
+	) | rpl::filter([=] {
+		return !_choosingAttach;
+	}) | rpl::on_next([=](std::optional<bool> overrideCompress) {
+		_choosingAttach = true;
+		base::call_delayed(
+			st::historyAttach.ripple.hideDuration,
+			this,
+			[=] { chooseAttach(overrideCompress); });
+	}, lifetime());
+
+	_composeControls->setSendAsFileConfirmed(crl::guard(this, [=](
+			std::shared_ptr<Ui::PreparedBundle> bundle,
+			Api::SendOptions options) {
+		sendingFilesConfirmed(
+			std::move(bundle),
+			_composeControls->replyingToMessage());
+	}));
+
+	_composeControls->fileChosen(
+	) | rpl::on_next([=](ChatHelpers::FileChosen data) {
+		controller()->hideLayer(anim::type::normal);
+		sendChosenDocument(data.document, std::move(data.caption));
+	}, lifetime());
+
+	_composeControls->photoChosen(
+	) | rpl::on_next([=](ChatHelpers::PhotoChosen chosen) {
+		controller()->showToast(
+			Lower(u"This can't be sent in secret chats yet."_q));
+	}, lifetime());
+
+	_composeControls->inlineResultChosen(
+	) | rpl::on_next([=](ComposeControls::InlineChosen chosen) {
+		const auto document = chosen.result
+			? chosen.result->document()
+			: nullptr;
+		if (document && document->isAnimation()) {
+			sendAnimation(document);
+		} else {
+			controller()->showToast(
+				Lower(u"This can't be sent in secret chats yet."_q));
+		}
+	}, lifetime());
+
+	_composeControls->viewportEvents(
+	) | rpl::on_next([=](not_null<QEvent*> e) {
+		_scroll->viewportEvent(e);
+	}, lifetime());
+}
+
+void SecretWidget::send() {
+	const auto manager = this->manager();
+	const auto chat = this->chat();
+	if (!manager || !chat || chat->state != ChatState::Ready) {
+		return;
+	}
+	const auto text = _composeControls->getTextWithAppliedMarkdown();
+	auto sending = TextWithEntities{
+		text.text,
+		TextUtilities::ConvertTextTagsToEntities(text.tags),
+	};
+	if (sending.text.trimmed().isEmpty()) {
+		return;
+	}
+	const auto reply = _composeControls->replyingToMessage();
+	const auto replyTo = (reply.messageId.peer == _history->peer->id)
+		? manager->randomIdOf(_chatId, reply.messageId.msg)
+		: int64();
+	manager->sendText(_chatId, std::move(sending), replyTo);
+	_composeControls->clear();
+	_composeControls->hidePanelsAnimated();
+	_composeControls->focus();
+	crl::on_main(this, [=] {
+		listScrollTo(_scroll->scrollTopMax());
+	});
+}
+
+bool SecretWidget::canSendNow() const {
+	const auto chat = this->chat();
+	if (!chat || chat->state != ChatState::Ready) {
+		controller()->showToast(Lower(u"The secret chat isn't ready."_q));
+		return false;
+	}
+	return true;
+}
+
+int64 SecretWidget::replyRandomId() const {
+	const auto manager = this->manager();
+	const auto reply = _composeControls->replyingToMessage();
+	return (manager && reply.messageId.peer == _history->peer->id)
+		? manager->randomIdOf(_chatId, reply.messageId.msg)
+		: int64();
+}
+
+void SecretWidget::finishSending() {
+	_composeControls->cancelReplyMessage();
+	_composeControls->hidePanelsAnimated();
+	_composeControls->focus();
+	crl::on_main(this, [=] {
+		listScrollTo(_scroll->scrollTopMax());
+	});
+}
+
+void SecretWidget::setupDragArea() {
+	const auto filter = [=](not_null<const QMimeData*> data) {
+		const auto chat = this->chat();
+		return chat
+			&& (chat->state == ChatState::Ready)
+			&& !_composeControls->isRecording();
+	};
+	const auto areas = DragArea::SetupDragAreaToContainer(
+		this,
+		filter,
+		nullptr,
+		[=] { updateControlsGeometry(); });
+	const auto dropped = [=](bool overrideSendImagesAsPhotos) {
+		return [=](const QMimeData *data) {
+			confirmSendingFiles(data, overrideSendImagesAsPhotos);
+			Window::ActivateWindow(controller());
+		};
+	};
+	areas.document->setDroppedCallback(dropped(false));
+	areas.photo->setDroppedCallback(dropped(true));
+}
+
+void SecretWidget::chooseAttach(
+		std::optional<bool> overrideSendImagesAsPhotos) {
+	_choosingAttach = false;
+	if (!canSendNow()) {
+		return;
+	}
+	const auto filter = (overrideSendImagesAsPhotos == true)
+		? FileDialog::PhotoVideoFilesFilter()
+		: FileDialog::AllOrImagesFilter();
+	FileDialog::GetOpenPaths(this, tr::lng_choose_files(tr::now), filter, crl::guard(this, [=](
+			FileDialog::OpenResult &&result) {
+		if (result.paths.isEmpty() && result.remoteContent.isEmpty()) {
+			return;
+		}
+		if (!result.remoteContent.isEmpty()) {
+			auto read = Images::Read({
+				.content = result.remoteContent,
+			});
+			if (!read.image.isNull() && !read.animated) {
+				confirmSendingFiles(
+					std::move(read.image),
+					std::move(result.remoteContent),
+					overrideSendImagesAsPhotos);
+			} else if (const auto manager = this->manager()) {
+				auto file = OutgoingFile();
+				file.content = result.remoteContent;
+				file.mime = Core::MimeTypeForData(file.content).name();
+				file.name = u"file"_q;
+				file.replyTo = replyRandomId();
+				manager->sendFile(_chatId, std::move(file));
+				finishSending();
+			}
+		} else {
+			const auto premium = controller()->session().user()->isPremium();
+			auto list = Storage::PrepareMediaList(
+				result.paths,
+				st::sendMediaPreviewSize,
+				premium);
+			list.overrideSendImagesAsPhotos = overrideSendImagesAsPhotos;
+			confirmSendingFiles(std::move(list));
+		}
+	}), nullptr);
+}
+
+bool SecretWidget::confirmSendingFiles(
+		not_null<const QMimeData*> data,
+		std::optional<bool> overrideSendImagesAsPhotos,
+		const QString &insertTextOnCancel) {
+	const auto hasImage = data->hasImage();
+	const auto premium = controller()->session().user()->isPremium();
+	if (const auto urls = Core::ReadMimeUrls(data); !urls.empty()) {
+		auto list = Storage::PrepareMediaList(
+			urls,
+			st::sendMediaPreviewSize,
+			premium);
+		if (list.error != Ui::PreparedList::Error::NonLocalUrl) {
+			if (list.error == Ui::PreparedList::Error::None || !hasImage) {
+				list.overrideSendImagesAsPhotos = overrideSendImagesAsPhotos;
+				confirmSendingFiles(std::move(list), QString());
+				return true;
+			}
+		}
+	}
+	if (auto read = Core::ReadMimeImage(data)) {
+		confirmSendingFiles(
+			std::move(read.image),
+			std::move(read.content),
+			overrideSendImagesAsPhotos,
+			insertTextOnCancel);
+		return true;
+	}
+	return false;
+}
+
+bool SecretWidget::confirmSendingFiles(
+		QImage &&image,
+		QByteArray &&content,
+		std::optional<bool> overrideSendImagesAsPhotos,
+		const QString &insertTextOnCancel) {
+	if (image.isNull()) {
+		return false;
+	}
+	auto list = Storage::PrepareMediaFromImage(
+		std::move(image),
+		std::move(content),
+		st::sendMediaPreviewSize);
+	list.overrideSendImagesAsPhotos = overrideSendImagesAsPhotos;
+	return confirmSendingFiles(std::move(list), insertTextOnCancel);
+}
+
+bool SecretWidget::confirmSendingFiles(
+		Ui::PreparedList &&list,
+		const QString &insertTextOnCancel) {
+	using Error = Ui::PreparedList::Error;
+	if (!canSendNow()) {
+		return false;
+	} else if (list.error == Error::TooLargeFile) {
+		controller()->showToast(Lower(
+			u"Files over 100 MB can't be sent in secret chats."_q));
+		return false;
+	} else if (list.error != Error::None || list.files.empty()) {
+		controller()->showToast(Lower(u"Couldn't read the file."_q));
+		return false;
+	}
+	auto box = Box<SendFilesBox>(
+		controller(),
+		std::move(list),
+		_composeControls->getTextWithAppliedMarkdown(),
+		_history->peer,
+		Api::SendType::Normal,
+		SendMenu::Details());
+	box->setReplyTo(_composeControls->replyingToMessage());
+	box->setConfirmedCallback(crl::guard(this, [=](
+			std::shared_ptr<Ui::PreparedBundle> bundle,
+			Api::SendOptions options,
+			FullReplyTo replyTo) {
+		sendingFilesConfirmed(std::move(bundle), replyTo);
+	}));
+	box->setCancelledCallback(_composeControls->restoreTextCallback(
+		insertTextOnCancel));
+	box->takeTextWithTagsRequests(
+	) | rpl::on_next([=](TextWithTags &&text) {
+		_composeControls->setText(std::move(text));
+	}, box->lifetime());
+	Window::ActivateWindow(controller());
+	controller()->show(std::move(box));
+	return true;
+}
+
+void SecretWidget::sendingFilesConfirmed(
+		std::shared_ptr<Ui::PreparedBundle> bundle,
+		FullReplyTo replyTo) {
+	const auto manager = this->manager();
+	if (!manager || !canSendNow()) {
+		return;
+	}
+	const auto compress = bundle->way.sendImagesAsPhotos();
+	auto reply = (replyTo.messageId.peer == _history->peer->id)
+		? manager->randomIdOf(_chatId, replyTo.messageId.msg)
+		: int64();
+	for (auto &group : bundle->groups) {
+		for (auto &file : group.list.files) {
+			if (file.size > kMaxFileSize) {
+				controller()->showToast(Lower(
+					u"Files over 100 MB can't be sent in secret chats."_q));
+				continue;
+			}
+			auto outgoing = ToOutgoing(file, compress);
+			outgoing.replyTo = std::exchange(reply, int64());
+			manager->sendFile(_chatId, std::move(outgoing));
+		}
+	}
+	finishSending();
+}
+
+void SecretWidget::sendVoice(const ComposeControls::VoiceToSend &data) {
+	const auto manager = this->manager();
+	if (!manager || !canSendNow() || data.bytes.isEmpty()) {
+		return;
+	}
+	auto file = OutgoingFile();
+	file.content = data.bytes;
+	file.duration = int(std::max(data.duration, crl::time(1000)) / 1000);
+	file.replyTo = replyRandomId();
+	if (data.video) {
+		file.type = MediaType::Round;
+		file.mime = u"video/mp4"_q;
+	} else {
+		file.type = MediaType::Voice;
+		file.mime = u"audio/ogg"_q;
+		file.waveform = documentWaveformEncode5bit(data.waveform);
+	}
+	manager->sendFile(_chatId, std::move(file));
+	finishSending();
+}
+
+void SecretWidget::sendChosenDocument(
+		not_null<DocumentData*> document,
+		TextWithTags caption) {
+	const auto manager = this->manager();
+	if (!manager || !canSendNow()) {
+		return;
+	}
+	if (document->sticker()) {
+		manager->sendSticker(_chatId, document, replyRandomId());
+		_composeControls->clearFieldAfterStickerSend();
+		finishSending();
+	} else if (document->isAnimation()) {
+		sendAnimation(document, std::move(caption));
+	} else {
+		controller()->showToast(
+			Lower(u"This can't be sent in secret chats yet."_q));
+	}
+}
+
+void SecretWidget::sendAnimation(
+		not_null<DocumentData*> document,
+		TextWithTags caption) {
+	if (!canSendNow()) {
+		return;
+	}
+	const auto replyTo = replyRandomId();
+	const auto chatId = _chatId;
+	const auto session = &_history->session();
+	finishSending();
+	ObtainBytes(document, crl::guard(this, [=](QByteArray bytes) {
+		const auto manager = FindManager(session);
+		if (!manager || bytes.isEmpty()) {
+			return;
+		}
+		auto file = OutgoingFile();
+		file.content = std::move(bytes);
+		file.name = document->filename();
+		file.mime = document->mimeString();
+		file.type = MediaType::Animation;
+		file.width = document->dimensions.width();
+		file.height = document->dimensions.height();
+		const auto duration = document->duration();
+		file.duration = (duration > 0) ? int(duration / 1000) : 0;
+		file.caption = TextWithEntities{
+			caption.text,
+			TextUtilities::ConvertTextTagsToEntities(caption.tags),
+		};
+		file.replyTo = replyTo;
+		manager->sendFile(chatId, std::move(file));
+	}), lifetime());
+}
+
+void SecretWidget::addMediaActions(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	const auto manager = this->manager();
+	if (!media || !manager || (IsTimedMedia(item) && !CopyProtected())) {
+		return;
+	}
+	const auto chatId = _chatId;
+	const auto msgId = item->id;
+	const auto itemId = item->fullId();
+	const auto session = &_history->session();
+	if (const auto photo = media->photo()) {
+		if (!manager->ownsPhoto(photo)) {
+			return;
+		}
+		const auto whenLoaded = [=](
+				Fn<void(std::shared_ptr<Data::PhotoMedia>)> callback) {
+			if (const auto manager = FindManager(session)) {
+				manager->loadMedia(chatId, msgId, [=] {
+					const auto loaded = photo->activeMediaView();
+					if (loaded && loaded->loaded()) {
+						callback(loaded);
+					}
+				});
+			}
+		};
+		menu->addAction(tr::lng_context_save_image(tr::now), [=] {
+			whenLoaded([=](std::shared_ptr<Data::PhotoMedia> loaded) {
+				FileDialog::GetWritePath(
+					Core::App().getFileDialogParent(),
+					tr::lng_save_photo(tr::now),
+					u"JPEG Image (*.jpg);;"_q + FileDialog::AllFilesFilter(),
+					filedialogDefaultName(u"photo"_q, u".jpg"_q),
+					crl::guard(session, [=](const QString &result) {
+						if (!result.isEmpty()) {
+							loaded->saveToFile(result);
+						}
+					}));
+			});
+		}, &st::menuIconSaveImage);
+		menu->addAction(tr::lng_context_copy_image(tr::now), [=] {
+			whenLoaded([](std::shared_ptr<Data::PhotoMedia> loaded) {
+				loaded->setToClipboard();
+			});
+		}, &st::menuIconCopy);
+	} else if (const auto document = media->document()) {
+		if (!manager->ownsDocument(document)) {
+			return;
+		}
+		menu->addAction(tr::lng_context_save_file(tr::now), [=] {
+			if (const auto manager = FindManager(session)) {
+				manager->loadMedia(chatId, msgId, [=] {
+					DocumentSaveClickHandler::Save(
+						itemId,
+						document,
+						DocumentSaveClickHandler::Mode::ToNewFile);
+				});
+			}
+		}, &st::menuIconDownload);
+	}
+}
+
+void SecretWidget::markRead() {
+	if (const auto manager = this->manager()) {
+		manager->markRead(_chatId);
+	}
+}
+
+void SecretWidget::scheduleRefresh() {
+	if (_refreshScheduled) {
+		return;
+	}
+	_refreshScheduled = true;
+	crl::on_main(this, [=] {
+		_refreshScheduled = false;
+		_refreshes.fire({});
+	});
+}
+
+std::vector<not_null<HistoryItem*>> SecretWidget::items() const {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &item : _history->clientSideMessages()) {
+		if (item->isHistoryEntry() && !item->isBusinessShortcut()) {
+			result.push_back(item);
+		}
+	}
+	ranges::sort(result, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return a->id < b->id;
+	});
+	return result;
+}
+
+Data::MessagesSlice SecretWidget::buildSlice(
+		Data::MessagePosition aroundId) const {
+	auto items = this->items();
+	if (!_query.isEmpty()) {
+		const auto skip = [&](not_null<HistoryItem*> item) {
+			return !item->originalText().text.contains(
+				_query,
+				Qt::CaseInsensitive);
+		};
+		items.erase(ranges::remove_if(items, skip), end(items));
+	}
+	auto result = Data::MessagesSlice();
+	const auto size = int(items.size());
+	result.fullCount = size;
+	result.skippedBefore = result.skippedAfter = 0;
+	if (!size) {
+		return result;
+	}
+	const auto i = ranges::find(
+		items,
+		aroundId.fullId,
+		&HistoryItem::fullId);
+	result.nearestToAround = ((i != end(items)) ? *i : items.back())
+		->fullId();
+	result.ids.reserve(size);
+	for (const auto &item : items) {
+		result.ids.push_back(item->fullId());
+	}
+	return result;
+}
