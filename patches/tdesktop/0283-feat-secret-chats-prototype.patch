+
+void SecretWidget::refreshRestriction() {
+	using Type = Controls::WriteRestrictionType;
+	const auto chat = this->chat();
+	const auto name = [&] {
+		const auto manager = this->manager();
+		const auto real = manager
+			? manager->realUser(_history->peer->id)
+			: nullptr;
+		return real ? real->shortName() : _history->peer->shortName();
+	}();
+	auto text = QString();
+	if (!chat) {
+		text = Lower(u"The secret chat was deleted."_q);
+	} else if (chat->state == ChatState::Requested) {
+		text = Lower(u"Accept the invite in the chat menu."_q);
+	} else if (chat->state == ChatState::Waiting) {
+		text = Lower(u"Waiting for %1 to get online."_q).arg(name);
+	} else if (chat->state == ChatState::Discarded) {
+		text = Lower(u"The secret chat ended."_q);
+	}
+	_restriction = text.isEmpty()
+		? Controls::WriteRestriction()
+		: Controls::WriteRestriction{ .text = text, .type = Type::Rights };
+}
