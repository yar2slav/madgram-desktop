+const Message *Manager::messageOf(int chatId, MsgId msgId) const {
+	const auto i = _chats.find(chatId);
+	if (i == end(_chats)) {
+		return nullptr;
+	}
+	const auto randomId = randomIdOf(chatId, msgId);
+	for (const auto &message : i->second.messages) {
+		if (message.randomId == randomId) {
+			return &message;
+		}
+	}
+	return nullptr;
+}
+
+bool Manager::loadDocument(
+		not_null<DocumentData*> document,
+		const Data::FileOrigin &origin,
+		const QString &toFile,
+		bool autoLoading) {
+	const auto i = _documentKeys.find(document);
+	if (i == end(_documentKeys)) {
+		return false;
+	}
+	const auto key = i->second;
+	const auto viewable = document->isVideoFile()
+		|| document->isAnimation()
+		|| document->isVoiceMessage()
+		|| document->isVideoMessage()
+		|| document->isAudioFile()
+		|| document->sticker()
+		|| document->isImage();
+	const auto saveTo = (autoLoading || viewable) ? QString() : toFile;
+	const auto copy = origin;
+	materialize(key, saveTo.isEmpty() ? Fn<void()>() : Fn<void()>([=] {
+		const auto media = document->activeMediaView();
+		if (media && media->loaded()) {
+			document->save(copy, saveTo);
+		}
+	}));
+	return true;
+}
+
+bool Manager::loadPhoto(not_null<PhotoData*> photo) {
+	const auto i = _photoKeys.find(photo);
+	if (i == end(_photoKeys)) {
+		return false;
+	}
+	materialize(i->second, nullptr);
+	return true;
+}
+
+void Manager::loadMedia(int chatId, MsgId msgId, Fn<void()> done) {
+	const auto randomId = randomIdOf(chatId, msgId);
+	if (!randomId) {
+		return;
+	}
+	materialize(Key(chatId, randomId), std::move(done));
+}
+
+void Manager::materialize(Key key, Fn<void()> done) {
+	const auto chat = find(key.first);
+	const auto message = chat ? findMessage(*chat, key.second) : nullptr;
+	if (!message || !HasFile(message->media) || _broken.contains(key)) {
+		return;
+	}
+	for (const auto &held : _held) {
+		if (held.key == key) {
+			const auto loaded = (held.photo && held.photo->loaded())
+				|| (held.document && held.document->loaded());
+			if (loaded) {
+				if (done) {
+					done();
+				}
+				return;
+			}
+		}
+	}
+	if (done) {
+		_waiters[key].push_back(std::move(done));
+	}
+	if (!message->media.stored) {
+		startDownload(key.first, key.second);
+		return;
+	} else if (_materializing.contains(key)) {
+		return;
+	}
+	_materializing.emplace(key);
+	const auto photo = (message->media.type == MediaType::Photo);
+	const auto name = Vault::FileName(key.first, key.second);
+	const auto weak = base::make_weak(this);
+	crl::async([=, store = _store] {
+		auto plain = QByteArray();
+		const auto ok = Vault::ReadFile(store, name, plain);
+		auto image = (ok && photo)
+			? Images::Read({ .content = plain }).image
+			: QImage();
+		crl::on_main(weak, [=, image = std::move(image)] {
+			_materializing.remove(key);
+			if (!ok) {
+				LOG(("Tele Secret Error: could not read a stored file."));
+				const auto owner = find(key.first);
+				const auto entry = owner
+					? findMessage(*owner, key.second)
+					: nullptr;
+				if (entry && !entry->out && entry->media.fileId) {
+					entry->media.stored = false;
+					save();
+					startDownload(key.first, key.second);
+				} else {
+					_broken.emplace(key);
+					_waiters.erase(key);
+				}
+				return;
+			}
+			present(key, plain, image);
+		});
+	});
+}
+
+void Manager::present(
+		Key key,
+		const QByteArray &bytes,
+		const QImage &image) {
+	const auto chat = find(key.first);
+	if (!chat || !findMessage(*chat, key.second) || bytes.isEmpty()) {
+		_waiters.erase(key);
+		return;
+	}
+	auto &owner = _session->data();
+	const auto &binding = chat->binding;
+	if (const auto i = binding.photos.find(key.second)
+		; i != end(binding.photos)) {
+		const auto photo = i->second;
+		if (image.isNull()) {
+			_broken.emplace(key);
+			_waiters.erase(key);
+			return;
+		}
+		auto media = photo->createMediaView();
+		media->set(
+			Data::PhotoSize::Large,
+			Data::PhotoSize::Large,
+			image,
+			bytes);
+		hold({ .key = key, .photo = media, .size = int64(bytes.size()) });
+		owner.photoLoadDone(photo);
+	} else if (const auto j = binding.documents.find(key.second)
+		; j != end(binding.documents)) {
+		const auto document = j->second;
+		auto media = document->createMediaView();
+		media->setBytes(bytes);
+		hold({
+			.key = key,
+			.document = media,
+			.size = int64(bytes.size()),
+		});
+		owner.documentLoadDone(document);
+	}
+	runWaiters(key);
+}
+
+void Manager::runWaiters(Key key) {
+	const auto i = _waiters.find(key);
+	if (i == end(_waiters)) {
+		return;
+	}
+	auto callbacks = std::move(i->second);
+	_waiters.erase(i);
+	for (const auto &callback : callbacks) {
+		callback();
+	}
+}
+
+void Manager::hold(Held held) {
+	for (auto i = begin(_held); i != end(_held); ++i) {
+		if (i->key == held.key) {
+			_heldBytes -= i->size;
+			_held.erase(i);
+			break;
+		}
+	}
+	_heldBytes += held.size;
+	_held.push_back(std::move(held));
+	while (_heldBytes > kHeldLimit && _held.size() > 1) {
+		_heldBytes -= _held.front().size;
+		_held.pop_front();
+	}
+}
+
+void Manager::dropMedia(Chat &chat, const Message &message) {
+	const auto key = Key(chat.id, message.randomId);
+	cancelTransfer(key);
+	_waiters.erase(key);
+	_broken.remove(key);
+	for (auto i = begin(_held); i != end(_held); ++i) {
+		if (i->key == key) {
+			_heldBytes -= i->size;
+			_held.erase(i);
+			break;
+		}
+	}
+	auto &binding = chat.binding;
+	if (const auto i = binding.documents.find(message.randomId)
+		; i != end(binding.documents)) {
+		const auto document = i->second;
+		document->uploadingData = nullptr;
+		_documentKeys.remove(document);
+		binding.documents.erase(i);
+	}
+	if (const auto i = binding.photos.find(message.randomId)
+		; i != end(binding.photos)) {
+		const auto photo = i->second;
+		photo->uploadingData = nullptr;
+		_photoKeys.remove(photo);
+		binding.photos.erase(i);
+	}
+	if (HasFile(message.media)) {
+		Vault::RemoveFile(_store, Vault::FileName(chat.id, message.randomId));
+	}
+}
+
+void Manager::itemRemoved(PeerId peerId, MsgId msgId) {
+	const auto chat = findByPeer(peerId);
+	if (!chat) {
+		return;
+	}
+	auto &binding = chat->binding;
+	const auto i = binding.randomIds.find(msgId);
+	if (i == end(binding.randomIds)) {
+		return;
+	}
+	const auto randomId = i->second;
+	binding.randomIds.erase(i);
+	binding.items.remove(randomId);
+	const auto chatId = chat->id;
+	crl::on_main(this, [=] {
+		if (const auto chat = find(chatId)) {
+			if (findMessage(*chat, randomId)) {
+				deleteMessages(chatId, { randomId });
+			}
+		}
+	});
+}
+
+Manager::Prepared Manager::PrepareFile(OutgoingFile &&file) {
+	auto result = Prepared();
+	auto bytes = std::move(file.content);
+	if (bytes.isEmpty() && !file.path.isEmpty()) {
+		auto f = QFile(file.path);
+		if (f.size() > kMaxFileSize) {
+			result.error = u"too big"_q;
+			return result;
+		} else if (f.open(QIODevice::ReadOnly)) {
+			bytes = f.readAll();
+		}
+	}
+	if (bytes.isEmpty()) {
+		result.error = u"empty"_q;
+		return result;
+	} else if (bytes.size() > kMaxFileSize) {
+		result.error = u"too big"_q;
+		return result;
+	}
+	auto &media = result.media;
+	media.type = file.type;
+	media.mime = file.mime;
+	media.fileName = file.name;
+	media.width = file.width;
+	media.height = file.height;
+	media.duration = file.duration;
+	media.title = file.title;
+	media.performer = file.performer;
+	media.waveform = file.waveform;
+	if (media.type == MediaType::Photo) {
+		auto image = file.image.isNull()
+			? Images::Read({ .content = bytes }).image
+			: file.image;
+		if (image.isNull()) {
+			media.type = MediaType::Document;
+		} else {
+			image = Opaque(image);
+			if (image.width() > kPhotoSide || image.height() > kPhotoSide) {
+				image = image.scaled(
+					kPhotoSide,
+					kPhotoSide,
+					Qt::KeepAspectRatio,
+					Qt::SmoothTransformation);
+			}
+			bytes = JpegBytes(image, kPhotoQuality);
+			media.mime = u"image/jpeg"_q;
+			media.fileName = QString();
+			media.width = image.width();
+			media.height = image.height();
+			SetThumb(media, image);
+			result.image = std::move(image);
+		}
+	} else if ((media.type == MediaType::Round
+		|| media.type == MediaType::Video
+		|| media.type == MediaType::Animation)
+		&& !media.mime.startsWith(u"image/"_q)
+		&& (media.width <= 0 || file.image.isNull())) {
+		const auto info = ::Media::Clip::PrepareForSending(QString(), bytes);
+		if (const auto video = std::get_if<
+				Ui::PreparedFileInformation::Video>(&info.media)) {
+			if (!media.duration && video->duration > 0) {
+				media.duration = int(video->duration / 1000);
+			}
+			if (file.image.isNull()) {
+				file.image = video->thumbnail;
+			}
+		}
+		if (!file.image.isNull()
+			&& (media.width <= 0 || media.height <= 0)) {
+			media.width = file.image.width();
+			media.height = file.image.height();
+		}
+		SetThumb(media, file.image);
+	} else if (media.type == MediaType::Video
+		|| media.type == MediaType::Round
+		|| media.type == MediaType::Animation
+		|| (media.type == MediaType::Document
+			&& media.mime.startsWith(u"image/"_q))) {
+		SetThumb(media, file.image);
+	}
+	if (media.mime.isEmpty()) {
+		media.mime = DefaultMime(media.type);
+	}
+	if (media.type == MediaType::Round) {
+		const auto side = std::max(media.width, media.height);
+		if (side <= 0) {
+			media.width = media.height = 384;
+		}
+	}
+	media.size = bytes.size();
+	result.bytes = std::move(bytes);
+	return result;
+}
+
+void Manager::sendFile(int chatId, OutgoingFile file) {
+	const auto chat = find(chatId);
+	if (!chat || chat->state != ChatState::Ready) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	auto caption = std::move(file.caption);
+	const auto replyTo = file.replyTo;
+	crl::async([=, file = std::move(file)]() mutable {
+		auto prepared = PrepareFile(std::move(file));
+		crl::on_main(weak, [=, prepared = std::move(prepared)]() mutable {
+			sendPrepared(chatId, std::move(prepared), caption, replyTo);
+		});
+	});
+}
+
+void Manager::sendPrepared(
+		int chatId,
+		Prepared &&prepared,
+		TextWithEntities caption,
+		int64 replyTo) {
+	const auto chat = find(chatId);
+	if (!chat || chat->state != ChatState::Ready) {
+		return;
+	} else if (prepared.error == u"too big"_q) {
+		toast(Lower(u"Files over 100 MB can't be sent in secret chats."_q));
+		return;
+	} else if (!prepared.error.isEmpty()) {
+		toast(Lower(u"Couldn't read the file."_q));
+		return;
+	}
+	TextUtilities::PrepareForSending(caption, 0);
+	TextUtilities::Trim(caption);
+	auto message = Message();
+	message.randomId = RandomId();
+	message.out = true;
+	message.date = base::unixtime::now();
+	message.state = MessageState::Sending;
+	message.replyTo = replyTo;
+	message.ttl = chat->ttl;
+	message.media = std::move(prepared.media);
+	message.media.key = RandomBytes(kFileKeySize);
+	message.media.iv = RandomBytes(kFileKeySize);
+	message.media.fileFingerprint = FileFingerprint(
+		message.media.key,
+		message.media.iv);
+	message.text = ToText(
+		caption.text,
+		FromText(caption, sendLayer(*chat)));
+	const auto key = Key(chatId, message.randomId);
+	const auto media = message.media;
+	const auto bytes = prepared.bytes;
+	addMessage(*chat, std::move(message), true);
+	present(key, bytes, prepared.image);
+	setUploadProgress(key, 0, bytes.size());
+	_transfers[key].upload = true;
+	const auto name = Vault::FileName(chatId, key.second);
+	const auto weak = base::make_weak(this);
+	crl::async([=, store = _store] {
+		const auto stored = Vault::WriteFile(store, name, bytes);
+		auto encrypted = EncryptFile(bytes, media.key, media.iv);
+		auto md5 = (encrypted.size() > kBigFileSize)
+			? QByteArray()
+			: Md5Hex(encrypted);
+		crl::on_main(weak, [=, encrypted = std::move(encrypted)]() mutable {
+			filePrepared(key, stored, std::move(encrypted), md5);
+		});
+	});
+}
+
+void Manager::filePrepared(
+		Key key,
+		bool stored,
+		QByteArray encrypted,
+		QByteArray md5) {
+	const auto chat = find(key.first);
+	const auto message = chat ? findMessage(*chat, key.second) : nullptr;
+	const auto i = _transfers.find(key);
+	if (!message || i == end(_transfers)) {
+		Vault::RemoveFile(_store, Vault::FileName(key.first, key.second));
+		return;
+	} else if (encrypted.isEmpty()) {
+		transferFailed(key, u"ENCRYPT_FAILED"_q);
+		return;
+	}
+	message->media.stored = stored;
+	if (!stored) {
+		LOG(("Tele Secret Error: could not store a sent file."));
+	}
+	save();
+	auto &transfer = i->second;
+	transfer.total = encrypted.size();
+	transfer.data = std::move(encrypted);
+	transfer.md5 = md5;
+	transfer.big = (transfer.total > kBigFileSize);
+	transfer.parts = int((transfer.total + kPartSize - 1) / kPartSize);
+	transfer.uploadId = uint64(RandomId());
+	transfer.fingerprint = message->media.fileFingerprint;
+	uploadNext(key);
+}
+
+void Manager::uploadNext(Key key) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers)) {
+		return;
+	}
+	auto &transfer = i->second;
+	while (transfer.inFlight < kTransferInFlight
+		&& transfer.nextOffset < transfer.total) {
+		const auto offset = transfer.nextOffset;
+		const auto part = int(offset / kPartSize);
+		const auto size = std::min(
+			int64(kPartSize),
+			transfer.total - offset);
+		transfer.nextOffset += size;
+		++transfer.inFlight;
+		const auto bytes = transfer.data.mid(int(offset), int(size));
+		const auto done = crl::guard(this, [=](const MTPBool &) {
+			uploadPartDone(key, size);
+		});
+		const auto fail = crl::guard(this, [=](const MTP::Error &error) {
+			transferFailed(key, error.type());
+		});
+		const auto dc = MTP::uploadDcId(part % kTransferSessions);
+		const auto requestId = transfer.big
+			? _session->api().request(MTPupload_SaveBigFilePart(
+				MTP_long(transfer.uploadId),
+				MTP_int(part),
+				MTP_int(transfer.parts),
+				MTP_bytes(bytes)
+			)).done(done).fail(fail).toDC(dc).send()
+			: _session->api().request(MTPupload_SaveFilePart(
+				MTP_long(transfer.uploadId),
+				MTP_int(part),
+				MTP_bytes(bytes)
+			)).done(done).fail(fail).toDC(dc).send();
+		transfer.requests.emplace(requestId);
+	}
+}
+
+void Manager::uploadPartDone(Key key, int64 size) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers)) {
+		return;
+	}
+	auto &transfer = i->second;
+	--transfer.inFlight;
+	transfer.doneBytes += size;
+	setUploadProgress(key, transfer.doneBytes, transfer.total);
+	if (transfer.doneBytes >= transfer.total) {
+		finishUpload(key);
+	} else {
+		uploadNext(key);
+	}
+}
+
+void Manager::finishUpload(Key key) {
+	const auto i = _transfers.find(key);
+	const auto chat = find(key.first);
+	const auto message = chat ? findMessage(*chat, key.second) : nullptr;
+	if (i == end(_transfers) || !message) {
+		cancelTransfer(key);
+		return;
+	}
+	auto file = Packet();
+	file.file = true;
+	file.big = i->second.big;
+	file.uploadId = i->second.uploadId;
+	file.parts = i->second.parts;
+	file.fingerprint = i->second.fingerprint;
+	file.md5 = i->second.md5;
+	message->media.fileSize = i->second.total;
+	_transfers.erase(i);
+	if (chat->state != ChatState::Ready) {
+		setMessageState(*chat, key.second, MessageState::Failed);
+		return;
+	}
+	auto data = OutboundText();
+	data.randomId = message->randomId;
+	data.text = message->text.text;
+	data.entities = FromText(message->text, sendLayer(*chat));
+	data.replyTo = message->replyTo;
+	data.ttl = message->ttl;
+	data.media = &message->media;
+	dispatch(*chat, BuildMessage(data), data.randomId, false, &file);
+}
+
+void Manager::setUploadProgress(Key key, int64 offset, int64 size) {
+	const auto chat = find(key.first);
+	if (!chat) {
+		return;
+	}
+	auto &owner = _session->data();
+	const auto &binding = chat->binding;
+	const auto done = (offset >= size);
+	const auto apply = [&](std::unique_ptr<Data::UploadState> &state) {
+		if (done) {
+			state = nullptr;
+			return;
+		} else if (!state) {
+			state = std::make_unique<Data::UploadState>(size);
+		}
+		state->offset = offset;
+		state->size = size;
+	};
+	if (const auto i = binding.photos.find(key.second)
+		; i != end(binding.photos)) {
+		apply(i->second->uploadingData);
+		owner.requestPhotoViewRepaint(i->second);
+	} else if (const auto j = binding.documents.find(key.second)
+		; j != end(binding.documents)) {
+		apply(j->second->uploadingData);
+		owner.requestDocumentViewRepaint(j->second);
+	}
+}
+
+void Manager::transferFailed(Key key, const QString &type) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers)) {
+		return;
+	}
+	const auto upload = i->second.upload;
+	cancelTransfer(key);
+	LOG(("Tele Secret Error: file %1 failed in %2: %3"
+		).arg(upload ? u"upload"_q : u"download"_q
+		).arg(key.first
+		).arg(type));
+	const auto chat = find(key.first);
+	if (!chat) {
+		return;
+	}
+	if (upload) {
+		setUploadProgress(key, 1, 1);
+		setMessageState(*chat, key.second, MessageState::Failed);
+		toast(Lower(u"Couldn't send the file: "_q) + type);
+	} else if (_waiters.contains(key)) {
+		_waiters.erase(key);
+		toast(Lower(u"Couldn't download the file: "_q) + type);
+	}
+}
+
+void Manager::cancelTransfer(Key key) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers)) {
+		return;
+	}
+	for (const auto requestId : i->second.requests) {
+		_session->api().request(requestId).cancel();
+	}
+	_transfers.erase(i);
+}
+
+void Manager::startDownload(int chatId, int64 randomId) {
+	const auto key = Key(chatId, randomId);
+	const auto chat = find(chatId);
+	const auto message = chat ? findMessage(*chat, randomId) : nullptr;
+	if (!message
+		|| message->out
+		|| !HasFile(message->media)
+		|| message->media.stored
+		|| _transfers.contains(key)) {
+		return;
+	} else if (!message->media.fileId || message->media.fileSize <= 0) {
+		_waiters.erase(key);
+		return;
+	}
+	const auto &media = message->media;
+	if (media.size > kMaxFileSize || media.fileSize > kMaxFileSize + 16) {
+		if (_waiters.contains(key)) {
+			_waiters.erase(key);
+			toast(Lower(u"Files over 100 MB can't be downloaded in "
+				"secret chats."_q));
+		}
+		return;
+	}
+	auto &transfer = _transfers[key];
+	transfer.upload = false;
+	transfer.total = media.fileSize;
+	transfer.dcId = media.fileDc ? media.fileDc : _session->mainDcId();
+	downloadNext(key);
+}
+
+void Manager::downloadNext(Key key) {
+	const auto i = _transfers.find(key);
+	const auto chat = find(key.first);
+	const auto message = chat ? findMessage(*chat, key.second) : nullptr;
+	if (i == end(_transfers) || !message) {
+		cancelTransfer(key);
+		return;
+	}
+	auto &transfer = i->second;
+	const auto location = MTP_inputEncryptedFileLocation(
+		MTP_long(message->media.fileId),
+		MTP_long(message->media.fileAccessHash));
+	while (transfer.inFlight < kTransferInFlight
+		&& transfer.nextOffset < transfer.total) {
+		const auto offset = transfer.nextOffset;
+		transfer.nextOffset += kPartSize;
+		++transfer.inFlight;
+		const auto index = int(offset / kPartSize) % kTransferSessions;
+		const auto requestId = _session->api().request(MTPupload_GetFile(
+			MTP_flags(0),
+			location,
+			MTP_long(offset),
+			MTP_int(kPartSize)
+		)).done(crl::guard(this, [=](const MTPupload_File &result) {
+			result.match([&](const MTPDupload_file &data) {
+				downloadPartDone(key, offset, data.vbytes().v);
+			}, [&](const MTPDupload_fileCdnRedirect &) {
+				transferFailed(key, u"CDN_REDIRECT"_q);
+			});
+		})).fail(crl::guard(this, [=](const MTP::Error &error) {
+			transferFailed(key, error.type());
+		})).toDC(MTP::downloadDcId(transfer.dcId, index)).send();
+		transfer.requests.emplace(requestId);
+	}
+}
+
+void Manager::downloadPartDone(Key key, int64 offset, QByteArray bytes) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers)) {
+		return;
+	}
+	auto &transfer = i->second;
+	--transfer.inFlight;
+	const auto expected = std::min(transfer.total, offset + kPartSize);
+	if (offset + int64(bytes.size()) < expected) {
+		transferFailed(key, u"FILE_TRUNCATED"_q);
+		return;
+	}
+	transfer.doneBytes += bytes.size();
+	transfer.received.emplace(offset, std::move(bytes));
+	if (transfer.doneBytes >= transfer.total) {
+		finishDownload(key);
+	} else {
+		downloadNext(key);
+	}
+}
+
+void Manager::finishDownload(Key key) {
+	const auto i = _transfers.find(key);
+	const auto chat = find(key.first);
+	const auto message = chat ? findMessage(*chat, key.second) : nullptr;
+	if (i == end(_transfers) || !message) {
+		cancelTransfer(key);
+		return;
+	}
+	auto encrypted = QByteArray();
+	encrypted.reserve(int(i->second.total));
+	for (const auto &[offset, part] : i->second.received) {
+		if (offset != encrypted.size()) {
+			transferFailed(key, u"FILE_PARTS_INVALID"_q);
+			return;
+		}
+		encrypted.append(part);
+	}
+	encrypted.resize(int(std::min(int64(encrypted.size()), i->second.total)));
+	_transfers.erase(i);
+	const auto media = message->media;
+	const auto name = Vault::FileName(key.first, key.second);
+	const auto photo = (media.type == MediaType::Photo);
+	const auto weak = base::make_weak(this);
+	crl::async([=, store = _store, encrypted = std::move(encrypted)] {
+		auto plain = QByteArray();
+		const auto ok = DecryptFile(
+			encrypted,
+			media.key,
+			media.iv,
+			media.size,
+			plain);
+		const auto stored = ok && Vault::WriteFile(store, name, plain);
+		auto image = (ok && photo)
+			? Images::Read({ .content = plain }).image
+			: QImage();
+		crl::on_main(weak, [=, image = std::move(image)] {
+			const auto chat = find(key.first);
+			const auto message = chat
+				? findMessage(*chat, key.second)
+				: nullptr;
+			if (!message) {
+				Vault::RemoveFile(_store, name);
+				return;
+			} else if (!ok) {
+				LOG(("Tele Secret Error: could not decrypt a file in %1."
+					).arg(key.first));
+				_broken.emplace(key);
+				_waiters.erase(key);
+				return;
+			}
+			message->media.stored = stored;
+			save();
+			present(key, plain, image);
+		});
+	});
+}
+
+void Manager::sendSticker(
+		int chatId,
+		not_null<DocumentData*> document,
+		int64 replyTo) {
+	const auto chat = find(chatId);
+	const auto sticker = document->sticker();
+	if (!chat || chat->state != ChatState::Ready || !sticker) {
+		return;
+	}
+	auto access = uint64();
+	document->mtpInput().match([&](const MTPDinputDocument &data) {
+		access = data.vaccess_hash().v;
+	}, [](const MTPDinputDocumentEmpty &) {
+	});
+	if (!access) {
+		toast(Lower(u"This sticker can't be sent in secret chats."_q));
+		return;
+	}
+	auto setName = sticker->set.shortName;
+	if (setName.isEmpty() && sticker->set.id) {
+		const auto &sets = _session->data().stickers().sets();
+		if (const auto i = sets.find(sticker->set.id); i != end(sets)) {
+			setName = i->second->shortName;
+		}
+	}
+	auto message = Message();
+	message.randomId = RandomId();
+	message.out = true;
+	message.date = base::unixtime::now();
+	message.state = MessageState::Sending;
+	message.replyTo = replyTo;
+	message.ttl = chat->ttl;
+	auto &media = message.media;
+	media.type = MediaType::Sticker;
+	media.external = true;
+	media.documentId = document->id;
+	media.documentAccessHash = access;
+	media.documentDate = document->date;
+	media.documentDc = document->videoPreloadLocation().dcId();
+	media.mime = document->mimeString();
+	media.size = document->size;
+	media.width = document->dimensions.width();
+	media.height = document->dimensions.height();
+	media.emoji = sticker->alt;
+	media.stickerSet = setName;
+	if (!media.documentDc) {
+		toast(Lower(u"This sticker can't be sent in secret chats."_q));
+		return;
+	}
+	auto data = OutboundText();
+	data.randomId = message.randomId;
+	data.replyTo = replyTo;
+	data.ttl = message.ttl;
+	const auto object = [&] {
+		data.media = &media;
+		return BuildMessage(data);
+	}();
+	const auto randomId = message.randomId;
+	addMessage(*chat, std::move(message), true);
+	if (const auto current = find(chatId)) {
+		dispatch(*current, object, randomId, false);
+	}
+}
+
