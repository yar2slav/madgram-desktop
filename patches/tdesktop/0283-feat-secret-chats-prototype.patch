+inline constexpr uint32 kActionScreenshotMessages = 0x8ac1f475U;
+inline constexpr uint32 kActionFlushHistory = 0x6719e45cU;
+inline constexpr uint32 kActionResend = 0x511110b0U;
+inline constexpr uint32 kActionNotifyLayer = 0xf3048883U;
+inline constexpr uint32 kActionTyping = 0xccb27641U;
+inline constexpr uint32 kActionRequestKey = 0xf3c9611bU;
+inline constexpr uint32 kActionAcceptKey = 0x6fe1735bU;
+inline constexpr uint32 kActionAbortKey = 0xdd05ec6bU;
+inline constexpr uint32 kActionCommitKey = 0xec2e0b9bU;
+inline constexpr uint32 kActionNoop = 0xa82fdd63U;
+
+class Writer final {
+public:
+	void writeInt(int32 value) {
+		write(&value, sizeof(value));
+	}
+	void writeUInt(uint32 value) {
+		write(&value, sizeof(value));
+	}
+	void writeLong(int64 value) {
+		write(&value, sizeof(value));
+	}
+	void writeDouble(float64 value) {
+		write(&value, sizeof(value));
+	}
+	void writeBytes(const QByteArray &value) {
+		const auto size = int(value.size());
+		auto header = 1;
+		if (size < 254) {
+			_data.append(char(size));
+		} else {
+			_data.append(char(254));
+			_data.append(char(size & 0xFF));
+			_data.append(char((size >> 8) & 0xFF));
+			_data.append(char((size >> 16) & 0xFF));
+			header = 4;
+		}
+		_data.append(value);
+		for (auto written = header + size; written % 4; ++written) {
+			_data.append(char(0));
+		}
+	}
+	void writeString(const QString &value) {
+		writeBytes(value.toUtf8());
+	}
+	void writeRaw(const QByteArray &value) {
+		_data.append(value);
+	}
+	[[nodiscard]] const QByteArray &data() const {
+		return _data;
+	}
+
+private:
+	void write(const void *data, int size) {
+		_data.append(static_cast<const char*>(data), size);
+	}
+
+	QByteArray _data;
+
+};
+
+class Reader final {
+public:
+	explicit Reader(const QByteArray &data)
+	: _data(data) {
+	}
+
+	[[nodiscard]] bool failed() const {
+		return _failed;
+	}
+	[[nodiscard]] int left() const {
+		return int(_data.size()) - _position;
+	}
+	[[nodiscard]] int32 readInt() {
+		auto result = int32();
+		read(&result, sizeof(result));
+		return result;
+	}
+	[[nodiscard]] uint32 readUInt() {
+		auto result = uint32();
+		read(&result, sizeof(result));
+		return result;
+	}
+	[[nodiscard]] int64 readLong() {
+		auto result = int64();
+		read(&result, sizeof(result));
+		return result;
+	}
+	[[nodiscard]] float64 readDouble() {
+		auto result = float64();
+		read(&result, sizeof(result));
+		return result;
+	}
+	[[nodiscard]] QByteArray readBytes() {
+		if (left() < 1) {
+			_failed = true;
+			return QByteArray();
+		}
+		auto length = int(uchar(_data[_position++]));
+		auto header = 1;
+		if (length == 254) {
+			if (left() < 3) {
+				_failed = true;
+				return QByteArray();
+			}
+			length = int(uchar(_data[_position]))
+				| (int(uchar(_data[_position + 1])) << 8)
+				| (int(uchar(_data[_position + 2])) << 16);
+			_position += 3;
+			header = 4;
+		} else if (length == 255) {
+			_failed = true;
+			return QByteArray();
+		}
+		if (left() < length) {
+			_failed = true;
+			return QByteArray();
+		}
+		const auto result = _data.mid(_position, length);
+		_position += length;
+		const auto padding = (4 - ((header + length) % 4)) % 4;
+		if (left() < padding) {
+			_failed = true;
+			return result;
+		}
+		_position += padding;
+		return result;
+	}
+	[[nodiscard]] QString readString() {
+		return QString::fromUtf8(readBytes());
+	}
+
+private:
+	void read(void *to, int size) {
+		if (_failed || left() < size) {
+			_failed = true;
+			return;
+		}
+		std::memcpy(to, _data.constData() + _position, size);
+		_position += size;
+	}
+
+	const QByteArray &_data;
+	int _position = 0;
+	bool _failed = false;
+
+};
+
+} // namespace Tele::Secret
diff --git a/Telegram/SourceFiles/tele/secret/secret_vault.cpp b/Telegram/SourceFiles/tele/secret/secret_vault.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ae69f63d169ad33e8b2bfab5b3a9c0239349a901
--- /dev/null
+++ b/Telegram/SourceFiles/tele/secret/secret_vault.cpp
@@ -0,0 +1,237 @@
+#include "tele/secret/secret_vault.h"
+
+#include "main/main_session.h"
+#include "mtproto/mtproto_auth_key.h"
+#include "storage/storage_account.h"
+#include "tele/secret/secret_crypto.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QSaveFile>
+
+#include <openssl/evp.h>
+#include <openssl/sha.h>
+
+#include <array>
+#include <cstring>
+
+namespace Tele::Secret::Vault {
+namespace {
+
+constexpr char kMagic[4] = { 'T', 'S', 'C', '1' };
+constexpr auto kNonceSize = 12;
+constexpr auto kTagSize = 16;
+constexpr auto kHeaderSize = 4 + kNonceSize + kTagSize;
+
+[[nodiscard]] QByteArray Seal(
+		const Store &store,
+		const QByteArray &aad,
+		const QByteArray &plain) {
+	if (!store.valid) {
+		return QByteArray();
+	}
+	const auto &key = store.key;
+	auto result = QByteArray(kHeaderSize + plain.size(), Qt::Uninitialized);
+	std::memcpy(result.data(), kMagic, 4);
+	const auto nonce = RandomBytes(kNonceSize);
+	std::memcpy(result.data() + 4, nonce.constData(), kNonceSize);
+	const auto out = reinterpret_cast<uchar*>(result.data());
+	const auto cipher = EVP_CIPHER_CTX_new();
+	if (!cipher) {
+		return QByteArray();
+	}
+	auto length = 0;
+	auto ok = (EVP_EncryptInit_ex(
+		cipher,
+		EVP_aes_256_gcm(),
+		nullptr,
+		key.data(),
+		out + 4) == 1);
+	ok = ok && (EVP_EncryptUpdate(
+		cipher,
+		nullptr,
+		&length,
+		reinterpret_cast<const uchar*>(aad.constData()),
+		int(aad.size())) == 1);
+	if (ok && !plain.isEmpty()) {
+		ok = (EVP_EncryptUpdate(
+			cipher,
+			out + kHeaderSize,
+			&length,
+			reinterpret_cast<const uchar*>(plain.constData()),
+			int(plain.size())) == 1);
+	}
+	auto tail = std::array<uchar, 16>();
+	ok = ok && (EVP_EncryptFinal_ex(cipher, tail.data(), &length) == 1);
+	ok = ok && (EVP_CIPHER_CTX_ctrl(
+		cipher,
+		EVP_CTRL_GCM_GET_TAG,
+		kTagSize,
+		out + 4 + kNonceSize) == 1);
+	EVP_CIPHER_CTX_free(cipher);
+	return ok ? result : QByteArray();
+}
+
+[[nodiscard]] bool Open(
+		const Store &store,
+		const QByteArray &aad,
+		const QByteArray &sealed,
+		QByteArray &plain) {
+	if (!store.valid
+		|| sealed.size() < kHeaderSize
+		|| std::memcmp(sealed.constData(), kMagic, 4) != 0) {
+		return false;
+	}
+	const auto &key = store.key;
+	const auto in = reinterpret_cast<const uchar*>(sealed.constData());
+	const auto size = int(sealed.size()) - kHeaderSize;
+	plain = QByteArray(size, Qt::Uninitialized);
+	const auto cipher = EVP_CIPHER_CTX_new();
+	if (!cipher) {
+		return false;
+	}
+	auto length = 0;
+	auto tag = std::array<uchar, kTagSize>();
+	std::memcpy(tag.data(), in + 4 + kNonceSize, kTagSize);
+	auto ok = (EVP_DecryptInit_ex(
+		cipher,
+		EVP_aes_256_gcm(),
+		nullptr,
+		key.data(),
+		in + 4) == 1);
+	ok = ok && (EVP_CIPHER_CTX_ctrl(
+		cipher,
+		EVP_CTRL_GCM_SET_TAG,
+		kTagSize,
+		tag.data()) == 1);
+	ok = ok && (EVP_DecryptUpdate(
+		cipher,
+		nullptr,
+		&length,
+		reinterpret_cast<const uchar*>(aad.constData()),
+		int(aad.size())) == 1);
+	if (ok && size > 0) {
+		ok = (EVP_DecryptUpdate(
+			cipher,
+			reinterpret_cast<uchar*>(plain.data()),
+			&length,
+			in + kHeaderSize,
+			size) == 1);
+	}
+	auto tail = std::array<uchar, 16>();
+	ok = ok && (EVP_DecryptFinal_ex(cipher, tail.data(), &length) == 1);
+	EVP_CIPHER_CTX_free(cipher);
+	if (!ok) {
+		plain = QByteArray();
+	}
+	return ok;
+}
+
+[[nodiscard]] QString MediaFolder(const Store &store) {
+	return store.path + u"_media"_q;
+}
+
+[[nodiscard]] QByteArray FileAad(const Store &store, const QString &name) {
+	return store.aad + " file " + name.toUtf8();
+}
+
+} // namespace
+
+Store Prepare(not_null<Main::Session*> session) {
+	auto result = Store();
+	const auto support = session->local().supportModePath();
+	result.path = QFileInfo(support).absolutePath() + u"/tele_secret"_q;
+	const auto local = session->local().peekLegacyLocalKey();
+	if (!local) {
+		return result;
+	}
+	const auto data = local->data();
+	static const char kLabel[] = "tele/secret-chats/vault/v1";
+	auto context = SHA256_CTX();
+	SHA256_Init(&context);
+	SHA256_Update(&context, kLabel, sizeof(kLabel) - 1);
+	SHA256_Update(&context, data.data(), data.size());
+	SHA256_Final(result.key.data(), &context);
+	result.aad = "tele secret chats "
+		+ QByteArray::number(session->uniqueId());
+	result.valid = true;
+	return result;
+}
+
+bool Write(const Store &store, const QByteArray &plain) {
+	const auto sealed = Seal(store, store.aad, plain);
+	if (sealed.isEmpty()) {
+		return false;
+	}
+	QDir().mkpath(QFileInfo(store.path).absolutePath());
+	auto file = QSaveFile(store.path);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	return (file.write(sealed) == sealed.size()) && file.commit();
+}
+
+bool Read(const Store &store, QByteArray &plain) {
+	auto file = QFile(store.path);
+	if (!store.valid || !file.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	const auto sealed = file.readAll();
+	file.close();
+	return Open(store, store.aad, sealed, plain);
+}
+
+void Remove(const Store &store) {
+	if (!store.path.isEmpty()) {
+		QFile::remove(store.path);
+		QDir(MediaFolder(store)).removeRecursively();
+	}
+}
+
+QString FileName(int chatId, int64 randomId) {
+	return QString::number(uint32(chatId))
+		+ '_'
+		+ QString::number(uint64(randomId), 16);
+}
+
+bool WriteFile(
+		const Store &store,
+		const QString &name,
+		const QByteArray &plain) {
+	if (store.path.isEmpty() || name.isEmpty()) {
+		return false;
+	}
+	const auto sealed = Seal(store, FileAad(store, name), plain);
+	if (sealed.isEmpty()) {
+		return false;
+	}
+	const auto folder = MediaFolder(store);
+	QDir().mkpath(folder);
+	auto file = QSaveFile(folder + '/' + name);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	return (file.write(sealed) == sealed.size()) && file.commit();
+}
+
+bool ReadFile(const Store &store, const QString &name, QByteArray &plain) {
+	if (!store.valid || store.path.isEmpty() || name.isEmpty()) {
+		return false;
+	}
+	auto file = QFile(MediaFolder(store) + '/' + name);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	const auto sealed = file.readAll();
+	file.close();
+	return Open(store, FileAad(store, name), sealed, plain);
+}
+
+void RemoveFile(const Store &store, const QString &name) {
+	if (!store.path.isEmpty() && !name.isEmpty()) {
+		QFile::remove(MediaFolder(store) + '/' + name);
+	}
+}
+
+} // namespace Tele::Secret::Vault
