+		LOG(("Tele Secret Error: could not write the secret chats file."));
+	}
+}
+
+QByteArray Manager::serialize() const {
+	auto result = QByteArray();
+	{
+		auto buffer = QBuffer(&result);
+		buffer.open(QIODevice::WriteOnly);
+		auto stream = QDataStream(&buffer);
+		stream.setVersion(QDataStream::Qt_5_1);
+		stream
+			<< kSerializeMagic
+			<< kSerializeVersion
+			<< qint32(_qts)
+			<< qint32(_chats.size());
+		for (const auto &[id, chat] : _chats) {
+			stream
+				<< qint32(chat.id)
+				<< quint64(chat.accessHash)
+				<< quint64(chat.peerUserId)
+				<< qint32(chat.creator ? 1 : 0)
+				<< qint32(chat.state)
+				<< qint32(chat.date)
+				<< chat.secret
+				<< chat.key
+				<< qint64(chat.fingerprint)
+				<< chat.keyHash
+				<< qint32(chat.dhG)
+				<< chat.dhP
+				<< qint32(chat.hisLayer)
+				<< qint32(chat.inRaw)
+				<< qint32(chat.outRaw)
+				<< qint32(chat.hisInRaw)
+				<< qint64(chat.exchangeId)
+				<< chat.pendingKey
+				<< chat.oldKey
+				<< qint32(chat.unread)
+				<< qint32(chat.readSent)
+				<< chat.rekeySecret
+				<< qint32(chat.keyUses)
+				<< qint32(chat.keyDate)
+				<< quint64(chat.peerAccessHash)
+				<< chat.peerName
+				<< qint32(chat.ttl)
+				<< qint32(chat.outbox.size());
+			for (const auto &packet : chat.outbox) {
+				stream
+					<< qint32(packet.seqOut)
+					<< qint64(packet.randomId)
+					<< qint32(packet.service ? 1 : 0)
+					<< qint32(packet.acked ? 1 : 0)
+					<< packet.object
+					<< qint32(packet.file ? 1 : 0)
+					<< qint32(packet.big ? 1 : 0)
+					<< quint64(packet.uploadId)
+					<< qint32(packet.parts)
+					<< qint32(packet.fingerprint)
+					<< packet.md5
+					<< quint64(packet.fileId)
+					<< quint64(packet.fileAccessHash);
+			}
+			stream << qint32(chat.messages.size());
+			for (const auto &message : chat.messages) {
+				stream
+					<< qint64(message.randomId)
+					<< qint32(message.out ? 1 : 0)
+					<< qint32(message.note ? 1 : 0)
+					<< qint32(message.date)
+					<< qint32(message.state)
+					<< qint64(message.replyTo);
+				WriteText(stream, message.text);
+				WriteMedia(stream, message.media);
+				stream
+					<< qint32(message.ttl)
+					<< qint32(message.destroyAt);
+			}
+		}
+	}
+	return result;
+}
+
+void Manager::deserialize(const QByteArray &data) {
+	auto stream = QDataStream(data);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto magic = quint32();
+	auto version = qint32();
+	auto qts = qint32();
+	auto count = qint32();
+	stream >> magic >> version >> qts >> count;
+	if (stream.status() != QDataStream::Ok
+		|| magic != kSerializeMagic
+		|| version < 1
+		|| version > kSerializeVersion) {
+		LOG(("Tele Secret Error: bad secret chats file."));
+		return;
+	}
+	_qts = qts;
+	for (auto i = 0; i < count && stream.status() == QDataStream::Ok; ++i) {
+		auto chat = Chat();
+		auto id = qint32();
+		auto accessHash = quint64();
+		auto peerUserId = quint64();
+		auto creator = qint32();
+		auto state = qint32();
+		auto date = qint32();
+		auto fingerprint = qint64();
+		auto dhG = qint32();
+		auto hisLayer = qint32();
+		auto inRaw = qint32();
+		auto outRaw = qint32();
+		auto hisInRaw = qint32();
+		auto exchangeId = qint64();
+		auto unread = qint32();
+		auto readSent = qint32();
+		auto outboxCount = qint32();
+		stream
+			>> id
+			>> accessHash
+			>> peerUserId
+			>> creator
+			>> state
+			>> date
+			>> chat.secret
+			>> chat.key
+			>> fingerprint
+			>> chat.keyHash
+			>> dhG
+			>> chat.dhP
+			>> hisLayer
+			>> inRaw
+			>> outRaw
+			>> hisInRaw
+			>> exchangeId
+			>> chat.pendingKey
+			>> chat.oldKey
+			>> unread
+			>> readSent;
+		auto keyUses = qint32();
+		auto keyDate = qint32();
+		if (version >= 2) {
+			stream >> chat.rekeySecret >> keyUses >> keyDate;
+		}
+		auto peerAccessHash = quint64();
+		if (version >= 3) {
+			stream >> peerAccessHash >> chat.peerName;
+		}
+		auto ttl = qint32();
+		if (version >= 5) {
+			stream >> ttl;
+		}
+		stream >> outboxCount;
+		chat.peerAccessHash = peerAccessHash;
+		chat.ttl = std::max(int(ttl), 0);
+		chat.id = id;
+		chat.accessHash = accessHash;
+		chat.peerUserId = peerUserId;
+		chat.creator = (creator != 0);
+		chat.state = (state >= 0 && state <= int(ChatState::Discarded))
+			? ChatState(state)
+			: ChatState::Discarded;
+		chat.date = date;
+		chat.fingerprint = fingerprint;
+		chat.dhG = dhG;
+		chat.hisLayer = hisLayer;
+		chat.inRaw = inRaw;
+		chat.outRaw = outRaw;
+		chat.hisInRaw = hisInRaw;
+		chat.exchangeId = exchangeId;
+		chat.unread = unread;
+		chat.readSent = readSent;
+		chat.keyUses = keyUses;
+		chat.keyDate = keyDate ? TimeId(keyDate) : base::unixtime::now();
+		for (auto j = 0;
+			j < outboxCount && stream.status() == QDataStream::Ok;
+			++j) {
+			auto packet = Packet();
+			auto seqOut = qint32();
+			auto randomId = qint64();
+			auto service = qint32();
+			auto acked = qint32();
+			stream >> seqOut >> randomId >> service >> acked >> packet.object;
+			if (version >= 4) {
+				auto file = qint32();
+				auto big = qint32();
+				auto uploadId = quint64();
+				auto parts = qint32();
+				auto fingerprint = qint32();
+				auto fileId = quint64();
+				auto fileAccessHash = quint64();
+				stream
+					>> file
+					>> big
+					>> uploadId
+					>> parts
+					>> fingerprint
+					>> packet.md5
+					>> fileId
+					>> fileAccessHash;
+				packet.file = (file != 0);
+				packet.big = (big != 0);
+				packet.uploadId = uploadId;
+				packet.parts = parts;
+				packet.fingerprint = fingerprint;
+				packet.fileId = fileId;
+				packet.fileAccessHash = fileAccessHash;
+			}
+			packet.seqOut = seqOut;
+			packet.randomId = randomId;
+			packet.service = (service != 0);
+			packet.acked = (acked != 0);
+			chat.outbox.push_back(std::move(packet));
+		}
+		auto messages = qint32();
+		stream >> messages;
+		for (auto j = 0;
+			j < messages && stream.status() == QDataStream::Ok;
+			++j) {
+			auto message = Message();
+			auto randomId = qint64();
+			auto out = qint32();
+			auto note = qint32();
+			auto date = qint32();
+			auto state = qint32();
+			auto replyTo = qint64();
+			stream >> randomId >> out >> note >> date >> state >> replyTo;
+			message.randomId = randomId;
+			message.out = (out != 0);
+			message.note = (note != 0);
+			message.date = date;
+			message.state = (state >= 0 && state <= int(MessageState::Failed))
+				? MessageState(state)
+				: MessageState::Failed;
+			if (message.state == MessageState::Sending) {
+				message.state = MessageState::Failed;
+			}
+			message.replyTo = replyTo;
+			message.text = ReadText(stream);
+			if (version >= 4) {
+				message.media = ReadMedia(stream);
+			}
+			if (version >= 5) {
+				auto messageTtl = qint32();
+				auto destroyAt = qint32();
+				stream >> messageTtl >> destroyAt;
+				message.ttl = std::max(int(messageTtl), 0);
+				message.destroyAt = message.ttl ? TimeId(destroyAt) : 0;
+			}
+			chat.messages.push_back(std::move(message));
+		}
+		for (const auto &packet : chat.outbox) {
+			if (packet.acked || packet.service) {
+				continue;
+			}
+			for (auto &message : chat.messages) {
+				if (message.randomId == packet.randomId) {
+					message.state = MessageState::Sending;
+				}
+			}
+		}
+		if (stream.status() == QDataStream::Ok) {
+			const auto chatId = chat.id;
+			_chats.emplace(chatId, std::move(chat));
+		}
+	}
+	if (stream.status() != QDataStream::Ok) {
+		LOG(("Tele Secret Error: secret chats file is truncated."));
+	}
+}
+
+int Manager::handleUpdate(const MTPUpdate &update) {
+	switch (update.type()) {
+	case mtpc_updateNewEncryptedMessage: {
+		const auto &data = update.c_updateNewEncryptedMessage();
+		handleEncrypted(data.vmessage());
+		const auto qts = data.vqts().v;
+		if (qts > _qts) {
+			_qts = qts;
+			_session->api().request(MTPmessages_ReceivedQueue(
+				MTP_int(qts)
+			)).send();
+			save();
+		}
+		return qts;
+	}
+	case mtpc_updateEncryption: {
+		applyChat(update.c_updateEncryption().vchat());
+	} break;
+	case mtpc_updateEncryptedChatTyping: {
+		const auto &data = update.c_updateEncryptedChatTyping();
+		if (const auto chat = find(data.vchat_id().v)) {
+			showTyping(*chat);
+		}
+	} break;
+	case mtpc_updateEncryptedMessagesRead: {
+		const auto &data = update.c_updateEncryptedMessagesRead();
+		if (const auto chat = find(data.vchat_id().v)) {
+			const auto maxDate = data.vmax_date().v;
+			auto ids = std::vector<int64>();
+			for (const auto &message : chat->messages) {
+				if (message.out
+					&& !message.note
+					&& message.date <= maxDate
+					&& (message.state == MessageState::Sent
+						|| message.state == MessageState::Sending)) {
+					ids.push_back(message.randomId);
+				}
+			}
+			for (const auto id : ids) {
+				setMessageState(*chat, id, MessageState::Read);
+			}
+			auto started = false;
+			for (auto &message : chat->messages) {
+				if (message.out
+					&& message.ttl > 0
+					&& !message.destroyAt
+					&& message.date <= maxDate
+					&& message.state == MessageState::Read
+					&& !IsViewTriggered(message)) {
+					startCountdown(*chat, message);
+					started = true;
+				}
+			}
+			if (started) {
+				save();
+			}
+		}
+	} break;
+	}
+	return 0;
+}
+
+void Manager::handleDifference(
+		const QVector<MTPEncryptedMessage> &messages,
+		int qts) {
+	for (const auto &message : messages) {
+		handleEncrypted(message);
+	}
+	if (qts > _qts) {
+		_qts = qts;
+		if (!messages.isEmpty()) {
+			_session->api().request(MTPmessages_ReceivedQueue(
+				MTP_int(qts)
+			)).send();
+		}
+		save();
+	}
+}
+
+int Manager::missedQts(int serverQts) {
+	if (!_qts) {
+		_qts = serverQts;
+		save();
+		return 0;
+	} else if (_qts < serverQts) {
+		_serverQts = serverQts;
+		return _qts;
+	}
+	return 0;
+}
+
+int Manager::differenceEmpty() {
+	const auto qts = std::exchange(_serverQts, 0);
+	if (qts > _qts) {
+		_qts = qts;
+		save();
+		return qts;
+	}
+	return 0;
+}
