+inline constexpr uint32 kDecryptedMessageLayer = 0x1be31789U;
+inline constexpr uint32 kDecryptedMessage = 0x91cc4674U;
+inline constexpr uint32 kDecryptedMessage46 = 0x36b091deU;
+inline constexpr uint32 kDecryptedMessage23 = 0x204d3878U;
+inline constexpr uint32 kDecryptedMessage8 = 0x1f814f1fU;
+inline constexpr uint32 kDecryptedMessageService = 0x73164160U;
+inline constexpr uint32 kDecryptedMessageService8 = 0xaa48327dU;
+inline constexpr uint32 kActionSetMessageTTL = 0xa1733aecU;
+inline constexpr uint32 kActionReadMessages = 0x0c4f40beU;
