+
+namespace Tele::Secret {
+namespace {
+
+constexpr auto kGrid = 12;
+constexpr auto kPixel = 14;
+
+[[nodiscard]] base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Manager>> &Managers() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Manager>>();
+	return result;
+}
+
+[[nodiscard]] bool EnabledAtStart() {
+	static const auto result = SecretChats();
+	return result;
+}
+
+[[nodiscard]] bool PasscodeSet() {
+	return Core::App().domain().local().hasLocalPasscode();
+}
+
+[[nodiscard]] Chat *FindChat(const PeerData *peer) {
+	if (!peer || !IsSecretPeerId(peer->id)) {
+		return nullptr;
+	}
+	const auto manager = FindManager(&peer->session());
+	return manager ? manager->find(ChatIdOf(peer->id)) : nullptr;
+}
+
+[[nodiscard]] QString RealName(not_null<PeerData*> peer) {
+	const auto real = RealUser(peer);
+	return real ? real->name() : peer->name();
+}
+
+[[nodiscard]] const Message *FindMessage(not_null<const HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	if (!IsSecretPeerId(peer->id)) {
+		return nullptr;
+	}
+	const auto manager = FindManager(&peer->session());
+	return manager
+		? manager->messageOf(ChatIdOf(peer->id), item->id)
+		: nullptr;
+}
+
+[[nodiscard]] QImage MakeIdenticon(const QByteArray &hash) {
+	static const QColor kColors[4] = {
+		QColor(0xFF, 0xFF, 0xFF),
+		QColor(0xD5, 0xE6, 0xF3),
+		QColor(0x2D, 0x57, 0x75),
+		QColor(0x2F, 0x99, 0xC9),
+	};
+	auto image = QImage(kGrid, kGrid, QImage::Format_RGB32);
+	image.fill(Qt::white);
+	auto bit = 0;
+	for (auto y = 0; y != kGrid; ++y) {
+		for (auto x = 0; x != kGrid; ++x) {
+			const auto index = bit / 8;
+			const auto value = (index < hash.size())
+				? ((uchar(hash[index]) >> (bit % 8)) & 3)
+				: 0;
+			image.setPixelColor(x, y, kColors[value]);
+			bit += 2;
+		}
+	}
+	return image;
+}
+
+[[nodiscard]] QString HexText(const QByteArray &hash) {
+	auto result = QString();
+	const auto count = std::min(32, int(hash.size()));
+	for (auto i = 0; i != count; ++i) {
+		if (i) {
+			result += (i % 8 == 0)
+				? u"\n"_q
+				: (i % 4 == 0)
+				? u"  "_q
+				: u" "_q;
+		}
+		result += QString::number(uchar(hash[i]), 16)
+			.rightJustified(2, QChar('0'))
+			.toUpper();
+	}
+	return result;
+}
+
+void KeyBox(
+		not_null<Ui::GenericBox*> box,
+		QString name,
+		QByteArray hash) {
+	box->setTitle(rpl::single(Lower(u"Encryption key"_q)));
+	box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"If this image and text look the same on %1's "
+				"phone, the chat is end-to-end encrypted."_q).arg(name),
+			st::boxLabel),
+		st::boxPadding);
+	const auto size = style::ConvertScale(kGrid * kPixel);
+	const auto holder = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		st::boxPadding);
+	holder->resize(holder->width(), size);
+	const auto image = MakeIdenticon(hash);
+	holder->paintRequest(
+	) | rpl::on_next([=] {
+		auto p = QPainter(holder);
+		p.setRenderHint(QPainter::SmoothPixmapTransform, false);
+		const auto left = (holder->width() - size) / 2;
+		p.drawImage(QRect(left, 0, size, size), image);
+	}, holder->lifetime());
+	const auto hex = box->addRow(
+		object_ptr<Ui::FlatLabel>(box, HexText(hash), st::boxLabel),
+		st::boxPadding);
+	hex->setSelectable(true);
+}
+
+void ShowKeyBox(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer) {
+	const auto chat = FindChat(peer);
+	if (!chat || chat->keyHash.isEmpty()) {
+		return;
+	}
+	controller->show(Box(KeyBox, RealName(peer), chat->keyHash));
+}
+
+void ConfirmDelete(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer) {
+	const auto chat = FindChat(peer);
+	if (!chat) {
+		return;
+	}
+	const auto session = &peer->session();
+	const auto chatId = chat->id;
+	const auto ended = (chat->state == ChatState::Discarded);
+	controller->show(Ui::MakeConfirmBox({
+		.text = (ended
+			? Lower(u"Delete the secret chat from this device?"_q)
+			: Lower(u"End and delete the secret chat?"_q)),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			if (const auto manager = FindManager(session)) {
+				manager->remove(chatId);
+			}
+		},
+		.confirmText = tr::lng_box_delete(),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+void PromptAccept(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer) {
+	const auto chat = FindChat(peer);
+	if (!chat || chat->state != ChatState::Requested || chat->asked) {
+		return;
+	}
+	chat->asked = true;
+	const auto session = &peer->session();
+	const auto chatId = chat->id;
+	controller->show(Ui::MakeConfirmBox({
+		.text = Lower(u"%1 invited you to a secret chat. Accept it on "
+			"this device?"_q).arg(RealName(peer)),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			if (const auto manager = FindManager(session)) {
+				manager->accept(chatId);
+			}
+		},
+		.cancelled = [=](Fn<void()> &&close) {
+			close();
+			if (const auto manager = FindManager(session)) {
+				if (const auto chat = manager->find(chatId)) {
+					chat->asked = false;
+				}
+			}
+		},
+		.confirmText = rpl::single(Lower(u"Accept"_q)),
+		.cancelText = rpl::single(Lower(u"Not now"_q)),
+	}));
+}
+
+void Start(
+		not_null<Window::SessionController*> controller,
+		not_null<UserData*> user) {
+	const auto session = &controller->session();
+	const auto weak = base::make_weak(controller.get());
+	controller->show(Ui::MakeConfirmBox({
+		.text = Lower(u"Start a secret chat with %1?"_q).arg(user->name()),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			const auto manager = FindManager(session);
+			if (!manager) {
+				return;
+			}
+			manager->start(user, [=](int chatId) {
+				const auto strong = weak.get();
+				const auto manager = FindManager(session);
+				const auto chat = manager ? manager->find(chatId) : nullptr;
+				if (strong && chat && chat->binding.history) {
+					strong->showPeerHistory(chat->binding.history);
+				}
+			});
+		},
+		.confirmText = rpl::single(Lower(u"Start"_q)),
+	}));
+}
+
+} // namespace
+
+Manager *FindManager(not_null<Main::Session*> session) {
+	const auto i = Managers().find(session);
+	return (i != end(Managers())) ? i->second.get() : nullptr;
+}
+
+bool IsSecretPeer(const PeerData *peer) {
+	return peer && IsSecretPeerId(peer->id);
+}
+
+UserData *RealUser(const PeerData *peer) {
+	if (!peer || !IsSecretPeerId(peer->id)) {
+		return nullptr;
+	}
+	const auto manager = FindManager(&peer->session());
+	return manager ? manager->realUser(peer->id) : nullptr;
+}
+
+std::optional<QString> StatusText(not_null<const UserData*> user) {
+	if (!IsSecretPeerId(user->id)) {
+		return std::nullopt;
+	}
+	const auto chat = FindChat(user);
+	if (!chat) {
+		return Lower(u"Secret chat ended"_q);
+	}
+	switch (chat->state) {
+	case ChatState::Requested:
+		return Lower(u"Invited you to a secret chat"_q);
+	case ChatState::Waiting: {
+		const auto real = RealUser(user);
+		return Lower(u"Waiting for %1 to get online"_q).arg(real
+			? real->shortName()
+			: user->shortName());
+	}
+	case ChatState::Ready:
+		return Lower(u"Secret chat"_q);
+	case ChatState::Discarded:
+		return Lower(u"Secret chat ended"_q);
+	}
+	return std::nullopt;
+}
+
+bool InterceptSend(const Api::MessageToSend &message) {
+	const auto history = message.action.history;
+	if (!IsSecretPeer(history->peer)) {
+		return false;
+	}
+	const auto chatId = ChatIdOf(history->peer->id);
+	if (const auto manager = FindManager(&history->session())) {
+		const auto reply = message.action.replyTo.messageId;
+		const auto replyTo = (reply.peer == history->peer->id)
+			? manager->randomIdOf(chatId, reply.msg)
+			: int64();
+		const auto &text = message.textWithTags;
+		manager->sendText(chatId, TextWithEntities{
+			text.text,
+			TextUtilities::ConvertTextTagsToEntities(text.tags),
+		}, replyTo);
+	}
+	return true;
+}
+
+bool LoadDocument(
+		not_null<DocumentData*> document,
+		const Data::FileOrigin &origin,
+		const QString &toFile,
+		bool autoLoading) {
+	if (Managers().empty()) {
+		return false;
+	}
+	const auto manager = FindManager(&document->session());
+	return manager
+		&& manager->loadDocument(document, origin, toFile, autoLoading);
+}
+
+bool LoadPhoto(not_null<PhotoData*> photo) {
+	if (Managers().empty()) {
+		return false;
+	}
+	const auto manager = FindManager(&photo->session());
+	return manager && manager->loadPhoto(photo);
+}
+
+bool IsSecretDocument(not_null<const DocumentData*> document) {
+	if (Managers().empty()) {
+		return false;
+	}
+	const auto manager = FindManager(&document->session());
+	return manager && manager->ownsDocument(document);
+}
+
+int MessageTtl(not_null<const HistoryItem*> item) {
+	if (Managers().empty()) {
+		return 0;
+	}
+	const auto message = FindMessage(item);
+	return message ? message->ttl : 0;
+}
+
+bool IsTimedMedia(not_null<const HistoryItem*> item) {
+	const auto media = item->media();
+	return media
+		&& (media->photo() || media->document())
+		&& (MessageTtl(item) > 0);
+}
+
+crl::time HoldMediaTtl(not_null<History*> history, MsgId id) {
+	const auto peer = history->peer;
+	if (!IsSecretPeerId(peer->id)) {
+		return 0;
+	}
+	const auto manager = FindManager(&peer->session());
+	const auto message = manager
+		? manager->messageOf(ChatIdOf(peer->id), id)
+		: nullptr;
+	return (message && !message->out && IsHoldMedia(*message))
+		? crl::time(message->ttl)
+		: crl::time(0);
+}
+
+QString TimerText(not_null<const HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	if (!IsSecretPeerId(peer->id)) {
+		return QString();
+	}
+	const auto manager = FindManager(&peer->session());
+	return manager
+		? manager->timerText(ChatIdOf(peer->id), item->id)
+		: QString();
+}
+
+bool ShowsTimerButton(not_null<PeerData*> peer) {
+	return IsSecretPeer(peer) && FindManager(&peer->session());
+}
+
+bool SetupTimerButton(
+		not_null<Ui::IconButtonWithText*> button,
+		std::shared_ptr<Ui::Show> show,
+		not_null<PeerData*> peer) {
+	if (!IsSecretPeer(peer)) {
+		return false;
+	}
+	const auto session = &peer->session();
+	const auto chatId = ChatIdOf(peer->id);
+	button->setClickedCallback([=] {
+		ChooseTimer(show, peer);
+	});
+	const auto refresh = [=] {
+		const auto manager = FindManager(session);
+		const auto chat = manager ? manager->find(chatId) : nullptr;
+		button->setText(chat ? TimerTinyText(chat->ttl) : QString());
+	};
+	refresh();
+	if (const auto manager = FindManager(session)) {
+		manager->chatChanges(
+		) | rpl::filter(
+			rpl::mappers::_1 == chatId
+		) | rpl::on_next(refresh, button->lifetime());
+	}
+	return true;
+}
+
+void ChooseTimer(std::shared_ptr<Ui::Show> show, not_null<PeerData*> peer) {
+	const auto session = &peer->session();
+	const auto chatId = ChatIdOf(peer->id);
+	const auto manager = FindManager(session);
+	const auto chat = manager ? manager->find(chatId) : nullptr;
+	if (!chat) {
+		return;
+	} else if (chat->state != ChatState::Ready) {
+		show->showToast(Lower(u"The secret chat isn't ready."_q));
+		return;
+	}
+	const auto current = TimeId(chat->ttl);
+	show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Lower(u"Self-destruct timer"_q)));
+		box->addRow(
+			object_ptr<Ui::FlatLabel>(
+				box,
+				Lower(u"Messages disappear for both of you this long "
+					"after they're read."_q),
+				st::boxLabel),
+			st::boxPadding);
+		auto values = std::vector<TimeId>{ 0 };
+		for (auto i = 1; i <= 15; ++i) {
+			values.push_back(i);
+		}
+		values.push_back(30);
+		values.push_back(60);
+		values.push_back(3600);
+		values.push_back(86400);
+		values.push_back(7 * 86400);
+		auto phrases = std::vector<QString>();
+		phrases.reserve(values.size());
+		for (const auto value : values) {
+			phrases.push_back(value
+				? Lower(TimerFullText(value))
+				: Lower(u"Off"_q));
+		}
+		const auto picked = Ui::TimePickerBox(
+			box,
+			std::move(values),
+			std::move(phrases),
+			current);
+		box->addButton(tr::lng_settings_save(), [=] {
+			const auto value = int(picked());
+			if (const auto manager = FindManager(session)) {
+				manager->setTtl(chatId, value);
+			}
+			box->closeBox();
+		});
+		box->addButton(tr::lng_cancel(), [=] {
+			box->closeBox();
+		});
+	}));
+}
+
+void Setup(not_null<Main::Session*> session) {
+	const auto create = [=] {
+		if (EnabledAtStart()
+			&& PasscodeSet()
+			&& !Managers().contains(session)) {
+			Managers().emplace(session, std::make_unique<Manager>(session));
+		}
+	};
+	create();
+	Core::App().domain().local().localPasscodeChanged(
+	) | rpl::on_next([=] {
+		if (PasscodeSet()) {
+			create();
+			return;
+		}
+		const auto i = Managers().find(session);
+		if (i == end(Managers())) {
+			Vault::Remove(Vault::Prepare(session));
+			return;
+		}
+		const auto had = !i->second->empty();
+		i->second->purge(true);
+		Managers().erase(i);
+		if (had) {
+			Ui::Toast::Show(Lower(u"Secret chats were deleted because the "
+				"local passcode was removed."_q));
+		}
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		Managers().remove(session);
+	});
+}
+
+void LoggedOut(not_null<Main::Session*> session) {
+	if (const auto manager = FindManager(session)) {
+		manager->purge(false);
+		Managers().remove(session);
+	}
+	Vault::Remove(Vault::Prepare(session));
+}
+
+int HandleUpdate(not_null<Main::Session*> session, const MTPUpdate &update) {
+	const auto manager = FindManager(session);
+	return manager ? manager->handleUpdate(update) : 0;
+}
+
+void HandleDifference(
+		not_null<Main::Session*> session,
+		const QVector<MTPEncryptedMessage> &messages,
+		int qts) {
+	if (const auto manager = FindManager(session)) {
+		manager->handleDifference(messages, qts);
+	}
+}
+
+int MissedQts(not_null<Main::Session*> session, int serverQts) {
+	const auto manager = FindManager(session);
+	return manager ? manager->missedQts(serverQts) : 0;
+}
+
+int DifferenceEmpty(not_null<Main::Session*> session) {
+	const auto manager = FindManager(session);
+	return manager ? manager->differenceEmpty() : 0;
+}
+
+bool ShowChat(
+		not_null<Window::SessionController*> controller,
+		PeerId peerId,
+		const Window::SectionShow &params) {
+	if (!IsSecretPeerId(peerId)) {
+		return false;
+	}
+	const auto manager = FindManager(&controller->session());
+	if (manager) {
+		manager->refreshUsers();
+	}
+	const auto chat = manager ? manager->find(ChatIdOf(peerId)) : nullptr;
+	const auto history = chat ? chat->binding.history : nullptr;
+	if (!history) {
+		return true;
+	}
+	controller->showSection(
+		std::make_shared<SecretMemento>(history),
+		params);
+	if (chat->state == ChatState::Requested) {
+		PromptAccept(controller, history->peer);
+	}
+	return true;
+}
+
+bool ShowProfile(
+		not_null<Window::SessionController*> controller,
+		not_null<Window::SectionMemento*> memento,
+		const Window::SectionShow &params) {
+	const auto info = dynamic_cast<Info::Memento*>(memento.get());
+	if (!info || !info->stackSize()) {
+		return false;
+	}
+	const auto peer = info->content()->peer();
+	if (!IsSecretPeer(peer)) {
+		return false;
+	} else if (!params.thirdColumn) {
+		if (const auto real = RealUser(peer)) {
+			controller->showPeerInfo(real);
+		}
+	}
+	return true;
+}
+
+bool FillMenu(
+		not_null<Window::SessionController*> controller,
+		const Dialogs::EntryState &request,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto peer = request.key.peer();
+	if (!IsSecretPeer(peer)) {
+		return false;
+	}
+	const auto chat = FindChat(peer);
+	const auto session = &controller->session();
+	if (chat && chat->state == ChatState::Requested) {
+		const auto chatId = chat->id;
+		addAction(Lower(u"Accept secret chat"_q), [=] {
+			if (const auto manager = FindManager(session)) {
+				manager->accept(chatId);
+			}
+		}, &st::menuIconLock);
+		addAction(Lower(u"Decline"_q), [=] {
+			if (const auto manager = FindManager(session)) {
+				manager->decline(chatId);
+			}
+		}, &st::menuIconCancel);
+	}
+	if (chat && !chat->keyHash.isEmpty()) {
+		addAction(Lower(u"Encryption key"_q), [=] {
+			ShowKeyBox(controller, peer);
+		}, &st::menuIconLock);
+	}
+	if (chat
+		&& chat->state == ChatState::Ready
+		&& request.section == Dialogs::EntryState::Section::History) {
+		const auto ttl = chat->ttl;
+		addAction(
+			(Lower(u"Self-destruct timer"_q)
+				+ (ttl ? ('\t' + TimerTinyText(ttl)) : QString())),
+			[=] { ChooseTimer(controller->uiShow(), peer); },
+			&st::menuIconTTL);
+	}
+	if (request.section != Dialogs::EntryState::Section::Profile) {
+		if (const auto real = RealUser(peer)) {
+			addAction(tr::lng_context_view_profile(tr::now), [=] {
+				controller->showPeerInfo(real);
+			}, &st::menuIconProfile);
+		}
+	}
+	const auto history = peer->owner().historyLoaded(peer);
+	if (chat && history && history->unreadCount() > 0) {
+		const auto chatId = chat->id;
+		addAction(tr::lng_context_mark_read(tr::now), [=] {
+			if (const auto manager = FindManager(session)) {
+				manager->markRead(chatId);
+			}
+		}, &st::menuIconMarkRead);
+	}
+	addAction({
+		.text = Lower(u"Delete secret chat"_q),
+		.handler = [=] { ConfirmDelete(controller, peer); },
+		.icon = &st::menuIconDeleteAttention,
+		.isAttention = true,
+	});
+	return true;
+}
+
+void AddStartAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	if (!user
+		|| !EnabledAtStart()
+		|| user->isSelf()
+		|| user->isBot()
+		|| user->isServiceUser()
+		|| user->isInaccessible()
+		|| IsSecretPeer(user)
+		|| IsChangelogPeer(user)) {
+		return;
+	}
+	addAction(Lower(u"Start secret chat"_q), [=] {
+		if (FindManager(&controller->session())) {
+			Start(controller, user);
+			return;
+		}
+		const auto hasPasscode = Core::App().domain().local().hasPasscode();
+		controller->show(Ui::MakeConfirmBox({
+			.text = Lower(hasPasscode
+				? u"Secret chats need tele's passcode lock. With it on, "
+					"tele asks for your passcode every time it starts."_q
+				: u"Secret chats need tele's passcode lock. tele will ask "
+					"for the passcode every time it starts."_q),
+			.confirmed = [=](Fn<void()> &&close) {
+				close();
+				controller->showSettings(hasPasscode
+					? ::Settings::LocalPasscodeCheckId()
+					: ::Settings::LocalPasscodeCreateId());
+			},
+			.confirmText = tr::lng_continue(),
+		}));
+	}, &st::menuIconLock);
+}
+
+bool PerformQuickAction(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer,
+		Dialogs::Ui::QuickDialogAction action) {
+	if (!IsSecretPeer(peer)) {
+		return false;
+	}
+	using Action = Dialogs::Ui::QuickDialogAction;
+	if (action == Action::Read) {
+		if (const auto chat = FindChat(peer)) {
+			if (const auto manager = FindManager(&peer->session())) {
+				manager->markRead(chat->id);
+			}
+		}
+	} else if (action == Action::Delete) {
+		ConfirmDelete(controller, peer);
+	}
+	return true;
+}
+
+bool SkipDialogEntry(not_null<History*> history, Fn<void()> callback) {
+	if (!IsSecretPeer(history->peer)) {
+		return false;
+	}
+	if (!history->folderKnown()) {
+		history->clearFolder();
+	}
+	history->dialogEntryApplied();
+	if (callback) {
+		crl::on_main(&history->session(), std::move(callback));
+	}
+	return true;
+}
+
+int PaintLock(
+		QPainter &p,
+		not_null<PeerData*> peer,
+		QPoint position,
+		int outerWidth,
+		bool active,
+		bool selected) {
+	if (!IsSecretPeer(peer)) {
+		return 0;
+	}
+	const auto &icon = st::emojiPremiumLock;
+	const auto &color = active
+		? st::dialogsChatIconFgActive
+		: selected
+		? st::dialogsChatIconFgOver
+		: st::dialogsChatIconFg;
+	const auto top = (st::semiboldFont->height - icon.height()) / 2;
+	icon.paint(
+		p,
+		position + QPoint(0, std::max(top, 0)),
+		outerWidth,
+		color->c);
+	return icon.width();
+}
+
+} // namespace Tele::Secret
