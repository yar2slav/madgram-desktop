+void SecretWidget::confirmDelete(std::vector<int64> randomIds) {
+	if (randomIds.empty()) {
+		return;
+	}
+	const auto session = &_history->session();
+	const auto chatId = _chatId;
+	const auto list = _inner;
+	controller()->show(Ui::MakeConfirmBox({
+		.text = (randomIds.size() == 1)
+			? Lower(u"Delete this message for both of you?"_q)
+			: Lower(u"Delete %1 messages for both of you?"_q).arg(
+				int(randomIds.size())),
+		.confirmed = [=](Fn<void()> &&close) {
+			if (const auto manager = FindManager(session)) {
+				manager->deleteMessages(chatId, randomIds);
+			}
+			if (list) {
+				list->cancelSelection();
+			}
+			close();
+		},
+		.confirmText = tr::lng_box_delete(),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+void SecretWidget::deleteSelected() {
+	auto ids = std::vector<int64>();
+	for (const auto &item : _inner->getSelectedItems()) {
+		if (const auto owner = _history->owner().message(item.msgId)) {
+			if (const auto randomId = randomIdOf(owner)) {
+				ids.push_back(randomId);
+			}
+		}
+	}
+	confirmDelete(std::move(ids));
+}
+
+base::unique_qptr<Ui::PopupMenu> SecretWidget::fillMenu(
+		const ContextMenuRequest &request) {
+	auto result = base::make_unique_q<Ui::PopupMenu>(
+		_inner,
+		st::popupMenuWithIcons);
+	const auto menu = result.get();
+	if (request.overSelection && !request.selectedItems.empty()) {
+		menu->addAction(
+			tr::lng_context_delete_selected(tr::now),
+			crl::guard(this, [=] { deleteSelected(); }),
+			&st::menuIconDelete);
+		menu->addAction(
+			tr::lng_context_clear_selection(tr::now),
+			crl::guard(this, [=] { _inner->cancelSelection(); }),
+			&st::menuIconSelect);
+		return result;
+	}
+	const auto item = request.item;
+	if (!item) {
+		return result;
+	}
+	const auto randomId = randomIdOf(item);
+	const auto itemId = item->fullId();
+	const auto chat = this->chat();
+	if (!item->isService()
+		&& chat
+		&& chat->state == ChatState::Ready) {
+		menu->addAction(tr::lng_context_reply_msg(tr::now), crl::guard(this, [=] {
+			_composeControls->replyToMessage({ .messageId = itemId });
+			_composeControls->focus();
+		}), &st::menuIconReply);
+	}
+	if (request.overSelection && !request.selectedText.empty()) {
+		const auto text = request.selectedText;
+		menu->addAction(tr::lng_context_copy_selected(tr::now), [=] {
+			TextUtilities::SetClipboardText(text);
+		}, &st::menuIconCopy);
+	} else if (!item->isService() && !item->originalText().empty()) {
+		const auto text = item->originalText();
+		menu->addAction(tr::lng_context_copy_text(tr::now), [=] {
+			TextUtilities::SetClipboardText(TextForMimeData::Rich(
+				TextWithEntities(text)));
+		}, &st::menuIconCopy);
+	}
+	if (!item->isService()) {
+		addMediaActions(menu, item);
+	}
+	if (!item->isService()) {
+		const auto list = _inner;
+		const auto session = &_history->session();
+		menu->addAction(tr::lng_context_select_msg(tr::now), [=] {
+			if (const auto item = session->data().message(itemId)) {
+				if (list) {
+					list->selectItemAsGroup(item);
+				}
+			}
+		}, &st::menuIconSelect);
+	}
+	if (const auto manager = this->manager(); manager && KeepSecretMedia()) {
+		const auto message = manager->messageOf(_chatId, item->id);
+		if (message
+			&& !message->out
+			&& !message->note
+			&& message->ttl > 0
+			&& !message->destroyAt) {
+			const auto msgId = item->id;
+			menu->addAction(Lower(u"Mark as viewed"_q), crl::guard(this, [=] {
+				if (const auto manager = this->manager()) {
+					manager->markViewed(_chatId, msgId);
+				}
+			}), &st::menuIconMarkRead);
+		}
+	}
+	if (randomId) {
+		menu->addAction(tr::lng_context_delete_msg(tr::now), crl::guard(this, [=] {
+			confirmDelete({ randomId });
+		}), &st::menuIconDelete);
+	}
+	return result;
+}
