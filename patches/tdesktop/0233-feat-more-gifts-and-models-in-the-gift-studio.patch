+std::vector<PickerRow> CollectionRows(
+		const std::vector<QString> &collections,
+		const QString &query) {
+	auto result = std::vector<PickerRow>();
+	const auto groups = std::array{
+		std::pair{ CollectionGroup::Collectible, u"Collectibles"_q },
+		std::pair{ CollectionGroup::Gift, u"Gifts"_q },
+		std::pair{ CollectionGroup::Extra, u"Extras"_q },
+	};
+	for (const auto &[group, label] : groups) {
+		const auto header = int(result.size());
+		for (auto i = 0; i != int(collections.size()); ++i) {
+			const auto &collection = collections[i];
+			if (CollectionGroupOf(collection) != group) {
+				continue;
+			}
+			const auto title = CollectionTitle(collection);
+			if (query.isEmpty() || title.contains(query, Qt::CaseInsensitive)) {
+				result.push_back({ .name = title, .index = i });
+			}
+		}
+		if (int(result.size()) > header) {
+			result.insert(begin(result) + header, PickerRow{
+				.name = Lower(label),
+				.index = -1,
+				.header = true,
+			});
+		}
+	}
+	return result;
+}
