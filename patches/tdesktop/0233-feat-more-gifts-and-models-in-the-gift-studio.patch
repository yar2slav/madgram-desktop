+
+[[nodiscard]] std::vector<int> ModelPermilles(
+		const std::vector<Attribute> &models) {
+	auto result = std::vector<int>();
+	result.reserve(models.size());
+	for (const auto &model : models) {
+		result.push_back(model.custom ? -1 : model.permille);
+	}
+	return result;
+}
+
+[[nodiscard]] int FindExactModel(
+		const std::vector<Attribute> &models,
+		const QString &key) {
+	const auto i = ranges::find(models, key, &Attribute::key);
+	return (i != end(models)) ? int(i - begin(models)) : -1;
+}
+
+void PaintLoadPreview(QPainter &p, QRect rect) {
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::windowBgOver);
+	p.drawEllipse(rect);
+	auto pen = st::windowSubTextFg->p;
+	pen.setWidthF(style::ConvertScaleExact(2.));
+	pen.setCapStyle(Qt::RoundCap);
+	p.setPen(pen);
+	const auto center = QRectF(rect).center();
+	const auto half = rect.width() / 4.;
+	p.drawLine(
+		QPointF(center.x() - half, center.y()),
+		QPointF(center.x() + half, center.y()));
+	p.drawLine(
+		QPointF(center.x(), center.y() - half),
+		QPointF(center.x(), center.y() + half));
 }
 
