+ImportedModel ImportModel(const QString &path) {
+	const auto error = [](const QString &text) {
+		return ImportedModel{ .error = Lower(text) };
+	};
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return error(u"Couldn't read the file."_q);
+	} else if (file.size() > kMaxCustomModel) {
+		return error(u"The file is larger than 1 MB."_q);
+	}
+	const auto bytes = file.readAll();
+	if (bytes.size() < 2
+		|| uchar(bytes[0]) != 0x1F
+		|| uchar(bytes[1]) != 0x8B) {
+		return error(u"That's not a .tgs file: it isn't gzip-compressed."_q);
+	}
+	const auto json = Images::UnpackGzip(bytes);
+	if (json.isEmpty() || json == bytes) {
+		return error(u"Couldn't unpack the .tgs file."_q);
+	} else if (!ValidLottie(json)) {
+		return error(u"Couldn't read the animation in this .tgs file."_q);
+	}
+	const auto id = QString::fromLatin1(QCryptographicHash::hash(
+		bytes,
+		QCryptographicHash::Sha1).toHex().left(kCustomIdLength));
+	const auto target = CustomFile(id);
+	if (!QFile::exists(target)) {
+		QDir().mkpath(ModelsFolder());
+		auto saved = QSaveFile(target);
+		if (!saved.open(QIODevice::WriteOnly)
+			|| saved.write(bytes) != bytes.size()
+			|| !saved.commit()) {
+			return error(u"Couldn't copy the model into tdata."_q);
+		}
+	}
+	auto name = QFileInfo(path).completeBaseName().trimmed();
+	AddCustomModel({
+		.id = id,
+		.name = name.isEmpty() ? u"model"_q : name,
+	});
+	return { .key = QString::fromLatin1(kCustomPrefix) + id };
+}
