+void RequestPool(Fn<void(const Pool&)> done, Fn<void()> fail) {
+	auto &data = Data();
+	if (data.pool) {
+		done(*data.pool);
+		return;
+	}
+	data.poolDone.push_back(std::move(done));
+	data.poolFail.push_back(std::move(fail));
+	if (data.poolDone.size() > 1) {
+		return;
+	}
+	const auto failed = [] {
+		Data().poolDone.clear();
+		for (const auto &callback : base::take(Data().poolFail)) {
+			callback();
+		}
+	};
+	Fetch(u"gifts"_q, false, [=](QByteArray bytes) {
+		const auto gifts = ParseGifts(bytes);
+		if (gifts.empty()) {
+			failed();
+			return;
+		}
+		struct Collected {
+			std::vector<std::vector<Backdrop>> backdrops;
+			std::vector<std::vector<Attribute>> symbols;
+			int left = 0;
+			bool incomplete = false;
+		};
+		const auto count = int(gifts.size());
+		const auto collected = std::make_shared<Collected>();
+		collected->backdrops.resize(count);
+		collected->symbols.resize(count);
+		collected->left = 2 * count;
+		const auto check = [=] {
+			if (--collected->left) {
+				return;
+			}
+			auto pool = Pool();
+			auto backdropNames = base::flat_set<QString>();
+			auto symbolNames = base::flat_set<QString>();
+			for (auto i = 0; i != count; ++i) {
+				MergeUnique(
+					pool.backdrops,
+					backdropNames,
+					std::move(collected->backdrops[i]),
+					gifts[i]);
+				MergeUnique(
+					pool.symbols,
+					symbolNames,
+					std::move(collected->symbols[i]),
+					gifts[i]);
+			}
+			ranges::stable_sort(pool.backdrops, ranges::less(), &Backdrop::permille);
+			ranges::stable_sort(pool.symbols, ranges::less(), &Attribute::permille);
+			if (pool.backdrops.empty() || pool.symbols.empty()) {
+				failed();
+				return;
+			}
+			auto &data = Data();
+			data.poolFail.clear();
+			if (collected->incomplete) {
+				for (const auto &callback : base::take(data.poolDone)) {
+					callback(pool);
+				}
+				return;
+			}
+			data.pool = std::move(pool);
+			for (const auto &callback : base::take(data.poolDone)) {
+				callback(*data.pool);
+			}
+		};
+		const auto skip = [=] {
+			collected->incomplete = true;
+			check();
+		};
+		for (auto i = 0; i != count; ++i) {
+			const auto segment = Segment(gifts[i]);
+			Fetch(u"backdrops/"_q + segment + u"?sorted"_q, false, [=](
+					QByteArray bytes) {
+				collected->backdrops[i] = ParseBackdrops(bytes);
+				check();
+			}, skip);
+			Fetch(u"symbols/"_q + segment + u"?sorted"_q, false, [=](
+					QByteArray bytes) {
+				collected->symbols[i] = ParseAttributes(bytes);
+				check();
+			}, skip);
+		}
+	}, failed);
+}
