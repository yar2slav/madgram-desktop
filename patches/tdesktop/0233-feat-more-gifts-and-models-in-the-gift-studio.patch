+
+void RemoveCustomModel(const QString &id) {
+	Load();
+	auto &list = Data().models;
+	const auto was = list.size();
+	list.erase(ranges::remove(list, id, &CustomModel::id), end(list));
+	if (list.size() != was) {
+		Save();
+	}
