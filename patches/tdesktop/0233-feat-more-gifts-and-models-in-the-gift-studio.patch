+#include "tele/tele_gift_studio_emoji.h"
+
+#include "apiwrap.h"
+#include "core/application.h"
+#include "data/data_document.h"
+#include "data/data_document_media.h"
+#include "data/data_file_origin.h"
+#include "data/data_session.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QFile>
+#include <QtCore/QTimer>
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kLoadTimeout = 20 * 1000;
+
+void Download(
+		not_null<Main::Session*> session,
+		not_null<DocumentData*> document,
+		Fn<void(QByteArray)> done,
+		Fn<void()> fail) {
+	const auto media = document->createMediaView();
+	const auto read = [=] {
+		auto bytes = media->bytes();
+		if (bytes.isEmpty()) {
+			auto file = QFile(document->filepath());
+			if (file.open(QIODevice::ReadOnly)) {
+				bytes = file.readAll();
+			}
+		}
+		return bytes;
+	};
+	if (media->loaded()) {
+		const auto bytes = read();
+		if (bytes.isEmpty()) {
+			fail();
+		} else {
+			done(bytes);
+		}
+		return;
+	}
+	const auto finished = std::make_shared<bool>(false);
+	const auto finish = [=](QByteArray bytes) {
+		if (*finished) {
+			return;
+		}
+		*finished = true;
+		if (bytes.isEmpty()) {
+			fail();
+		} else {
+			done(std::move(bytes));
+		}
+	};
+	document->save(document->stickerSetOrigin(), QString());
+	session->downloaderTaskFinished(
+	) | rpl::filter([=] {
+		return !*finished && media->loaded();
+	}) | rpl::take(1) | rpl::on_next([=] {
+		finish(read());
+	}, session->lifetime());
+	const auto weak = base::make_weak(session);
+	QTimer::singleShot(kLoadTimeout, QCoreApplication::instance(), [=] {
+		finish((weak && media->loaded()) ? read() : QByteArray());
+	});
+}
+
+} // namespace
+
+void LoadEmojiSticker(
+		uint64 documentId,
+		Fn<void(QByteArray)> loaded,
+		Fn<void()> failed) {
+	const auto session = Core::App().domain().active().maybeSession();
+	if (!session) {
+		failed();
+		return;
+	}
+	const auto finished = std::make_shared<bool>(false);
+	const auto done = [=](QByteArray bytes) {
+		if (!std::exchange(*finished, true)) {
+			loaded(std::move(bytes));
+		}
+	};
+	const auto fail = [=] {
+		if (!std::exchange(*finished, true)) {
+			failed();
+		}
+	};
+	QTimer::singleShot(2 * kLoadTimeout, QCoreApplication::instance(), fail);
+	const auto weak = base::make_weak(session);
+	session->api().request(MTPmessages_GetCustomEmojiDocuments(
+		MTP_vector<MTPlong>(1, MTP_long(documentId))
+	)).done([=](const MTPVector<MTPDocument> &result) {
+		const auto strong = weak.get();
+		if (!strong) {
+			fail();
+			return;
+		}
+		auto found = (DocumentData*)nullptr;
+		for (const auto &entry : result.v) {
+			const auto document = strong->data().processDocument(entry);
+			if (document->id == documentId) {
+				found = document;
+			}
+		}
+		if (!found) {
+			fail();
+			return;
+		}
+		Download(strong, found, done, fail);
+	}).fail([=] {
+		fail();
+	}).send();
+}
+
+} // namespace Tele::GiftStudio
