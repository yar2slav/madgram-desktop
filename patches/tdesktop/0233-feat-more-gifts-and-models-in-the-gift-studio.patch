+
+[[nodiscard]] QString CustomId(const QString &key) {
+	if (!IsCustomModel(key)) {
+		return QString();
+	}
+	const auto result = key.mid(int(std::strlen(kCustomPrefix)));
+	if (result.size() != kCustomIdLength) {
+		return QString();
+	}
+	for (const auto ch : result) {
+		const auto hex = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+		if (!hex) {
+			return QString();
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString CustomFile(const QString &id) {
+	return ModelsFolder() + id + u".tgs"_q;
+}
+
+[[nodiscard]] QString CustomPath(const QString &id) {
+	return u"my/"_q + id;
+}
+
+[[nodiscard]] uint64 EmojiId(const QString &key) {
+	if (!key.startsWith(QLatin1String(kEmojiPrefix))) {
+		return 0;
+	}
+	auto ok = false;
+	const auto result = key.mid(
+		int(std::strlen(kEmojiPrefix))).toULongLong(&ok);
+	return ok ? result : 0;
+}
+
+[[nodiscard]] QString EmojiKey(uint64 id) {
+	return QString::fromLatin1(kEmojiPrefix) + QString::number(id);
+}
+
+[[nodiscard]] QString EmojiPath(uint64 id) {
+	return u"emoji/"_q + QString::number(id);
+}
+
+[[nodiscard]] uint64 ModelEmoji(const QString &gift, const QString &key) {
+	return (key == QLatin1String(kOriginalKey))
+		? (IsFakeCollection(gift) ? kTeddyOriginal : 0)
+		: EmojiId(key);
+}
+
+[[nodiscard]] bool LocalPreview(
+		PreviewKind kind,
+		const QString &gift,
+		const QString &name) {
+	switch (kind) {
+	case PreviewKind::Gift: return IsFakeCollection(gift);
+	case PreviewKind::Model:
+		return IsCustomModel(name) || (ModelEmoji(gift, name) != 0);
+	case PreviewKind::Symbol: return false;
+	}
+	return false;
