+void RemoveModel(const QString &key) {
+	const auto id = CustomId(key);
+	if (id.isEmpty()) {
+		return;
+	}
+	QFile::remove(CustomFile(id));
+	auto &data = Data();
+	const auto path = CustomPath(id);
+	if (const auto i = data.bytes.find(path); i != end(data.bytes)) {
+		data.total -= i->second.size();
+		data.bytes.erase(i);
+	}
+	const auto preview = PreviewPath(PreviewKind::Model, QString(), key);
+	data.previews.remove(preview);
+	data.failedPreviews.remove(preview);
+	RemoveCustomModel(id);
+}
