+template <typename List>
+[[nodiscard]] int PickWeighted(const List &list) {
+	auto total = uint64();
+	for (const auto &item : list) {
+		total += uint64(std::max(item.permille, 0));
+	}
+	if (!total) {
+		return list.empty() ? -1 : base::RandomIndex(int(list.size()));
+	}
+	auto left = base::RandomValue<uint64>() % total;
+	for (auto i = 0; i != int(list.size()); ++i) {
+		const auto weight = uint64(std::max(list[i].permille, 0));
+		if (left < weight) {
+			return i;
+		}
+		left -= weight;
+	}
+	return int(list.size()) - 1;
+}
