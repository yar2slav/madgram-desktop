+		auto json = Images::UnpackGzip(raw);
+		if (json == raw || !ValidLottie(json)) {
+			failed();
+			return;
+		}
+		WriteDisk(path, raw);
+		Remember(path, json);
+		auto callbacks = Data().pending.take(path).value_or(Pending());
+		for (const auto &callback : callbacks.done) {
+			callback(json);
+		}
+	}, failed);
