+#include "tele/tele_copy_markdown.h"
+
+#include "data/data_groups.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_text.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+
+namespace Tele {
+namespace {
+
+enum class Format {
+	Markdown,
+	Html,
+};
+
+enum class Kind {
+	Quote,
+	Pre,
+	Inline,
+	Code,
+};
+
+struct Span {
+	EntityType type = EntityType::Invalid;
+	Kind kind = Kind::Inline;
+	int from = 0;
+	int till = 0;
+	QString data;
+	QString open;
+	QString close;
+};
+
+class Writer final {
+public:
+	explicit Writer(Format format) : _format(format) {
+	}
+
+	void text(QChar ch) {
+		if (_format == Format::Html) {
+			_result += Escape(QStringView(&ch, 1), false);
+			return;
+		}
+		flushBreak(ch);
+		put(ch);
+	}
+	void markup(const QString &value) {
+		if (value.isEmpty()) {
+			return;
+		} else if (_format == Format::Html) {
+			_result += value;
+			return;
+		}
+		flushBreak(value[0]);
+		for (const auto ch : value) {
+			put(ch);
+		}
+	}
+	void ensureLine() {
+		_breakPending = false;
+		if (!_result.isEmpty() && !_lineStart) {
+			put('\n');
+		}
+	}
+	void requestBreak() {
+		_breakPending = true;
+	}
+	void enterQuote() {
+		++_quote;
+	}
+	void leaveQuote() {
+		--_quote;
+	}
+
+	[[nodiscard]] static QString Escape(QStringView text, bool attribute) {
+		auto result = QString();
+		result.reserve(text.size());
+		for (const auto ch : text) {
+			if (ch == '&') {
+				result += u"&amp;"_q;
+			} else if (ch == '<') {
+				result += u"&lt;"_q;
+			} else if (ch == '>') {
+				result += u"&gt;"_q;
+			} else if (attribute && ch == '"') {
+				result += u"&quot;"_q;
+			} else {
+				result += ch;
+			}
+		}
+		return result;
+	}
+
+	[[nodiscard]] QString result() && {
+		return std::move(_result);
+	}
+
+private:
+	void flushBreak(QChar next) {
+		if (!_breakPending) {
+			return;
+		}
+		_breakPending = false;
+		if (next != '\n' && !_lineStart) {
+			put('\n');
+		}
+	}
+	void put(QChar ch) {
+		if (_lineStart && _quote > 0) {
+			_result += (ch == '\n') ? u">"_q : u"> "_q;
+		}
+		_result += ch;
+		_lineStart = (ch == '\n');
+	}
+
+	const Format _format;
+	QString _result;
+	int _quote = 0;
+	bool _lineStart = true;
+	bool _breakPending = false;
+
+};
+
+[[nodiscard]] Kind KindOf(EntityType type) {
+	switch (type) {
+	case EntityType::Blockquote: return Kind::Quote;
+	case EntityType::Pre: return Kind::Pre;
+	case EntityType::Code: return Kind::Code;
+	default: break;
+	}
+	return Kind::Inline;
+}
+
+[[nodiscard]] bool Block(Kind kind) {
+	return (kind == Kind::Quote) || (kind == Kind::Pre);
+}
+
+[[nodiscard]] QString MentionUrl(const QString &data) {
+	const auto fields = TextUtilities::MentionNameDataToFields(data);
+	return fields.userId
+		? (u"tg://user?id="_q + QString::number(fields.userId))
+		: QString();
+}
+
+[[nodiscard]] std::vector<Span> CollectSpans(const TextWithEntities &text) {
+	const auto size = int(text.text.size());
+	auto result = std::vector<Span>();
+	for (const auto &entity : text.entities) {
+		const auto type = entity.type();
+		auto data = entity.data();
+		switch (type) {
+		case EntityType::Bold:
+		case EntityType::Italic:
+		case EntityType::Underline:
+		case EntityType::StrikeOut:
+		case EntityType::Spoiler:
+		case EntityType::Code:
+		case EntityType::Pre:
+		case EntityType::Blockquote:
+			break;
+		case EntityType::CustomUrl:
+			if (data.isEmpty()) {
+				continue;
+			}
+			break;
+		case EntityType::MentionName:
+			data = MentionUrl(data);
+			if (data.isEmpty()) {
+				continue;
+			}
+			break;
+		default:
+			continue;
+		}
+		const auto from = std::clamp(entity.offset(), 0, size);
+		const auto till = std::clamp(entity.offset() + entity.length(), 0, size);
+		if (till > from) {
+			result.push_back({
+				.type = type,
+				.kind = KindOf(type),
+				.from = from,
+				.till = till,
+				.data = std::move(data),
+			});
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<Span> SplitSpans(
+		std::vector<Span> spans,
+		QStringView text,
+		Format format) {
+	auto cuts = std::vector<int>();
+	for (const auto &span : spans) {
+		if (span.kind != Kind::Inline) {
+			cuts.push_back(span.from);
+			cuts.push_back(span.till);
+		}
+	}
+	if (format == Format::Markdown) {
+		for (auto i = 0; i != int(text.size()); ++i) {
+			if (text[i] == '\n') {
+				cuts.push_back(i);
+				cuts.push_back(i + 1);
+			}
+		}
+	}
+	ranges::sort(cuts);
+	cuts.erase(ranges::unique(cuts), end(cuts));
+
+	auto result = std::vector<Span>();
+	const auto push = [&](const Span &span, int from, int till) {
+		if (format == Format::Markdown) {
+			if (till - from == 1 && text[from] == '\n') {
+				return;
+			} else if (span.kind == Kind::Inline) {
+				while (from < till && text[from].isSpace()) {
+					++from;
+				}
+				while (till > from && text[till - 1].isSpace()) {
+					--till;
+				}
+			}
+		}
+		if (till > from) {
+			auto piece = span;
+			piece.from = from;
+			piece.till = till;
+			result.push_back(std::move(piece));
+		}
+	};
+	for (const auto &span : spans) {
+		if (Block(span.kind)) {
+			result.push_back(span);
+			continue;
+		}
+		auto from = span.from;
+		for (const auto cut : cuts) {
+			if (cut > from && cut < span.till) {
+				push(span, from, cut);
+				from = cut;
+			}
+		}
+		push(span, from, span.till);
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<Span> DropInsideCode(std::vector<Span> spans) {
+	auto result = std::vector<Span>();
+	result.reserve(spans.size());
+	for (auto i = 0; i != int(spans.size()); ++i) {
+		const auto &span = spans[i];
+		if (span.kind == Kind::Quote) {
+			result.push_back(span);
+			continue;
+		}
+		auto inside = false;
+		for (auto j = 0; j != int(spans.size()); ++j) {
+			const auto &code = spans[j];
+			if (j == i
+				|| (code.kind != Kind::Code && code.kind != Kind::Pre)
+				|| code.from > span.from
+				|| code.till < span.till) {
+				continue;
+			}
+			const auto same = (code.from == span.from)
+				&& (code.till == span.till);
+			if (same
+				&& ((span.kind == Kind::Inline && code.kind == Kind::Code)
+					|| (span.kind != Kind::Inline && j > i))) {
+				continue;
+			}
+			inside = true;
+			break;
+		}
+		if (!inside) {
+			result.push_back(span);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] int LongestRun(QStringView text, QChar ch) {
+	auto result = 0;
+	auto current = 0;
+	for (const auto c : text) {
+		current = (c == ch) ? (current + 1) : 0;
+		result = std::max(result, current);
+	}
+	return result;
+}
+
+[[nodiscard]] QString MarkdownUrl(QString url) {
+	return url
+		.replace(' ', u"%20"_q)
+		.replace('(', u"%28"_q)
+		.replace(')', u"%29"_q);
+}
+
+void Decorate(Span &span, QStringView text, Format format) {
+	const auto markdown = (format == Format::Markdown);
+	const auto both = [&](const QString &value) {
+		span.open = span.close = value;
+	};
+	const auto tag = [&](const QString &name) {
+		span.open = QChar('<') + name + QChar('>');
+		span.close = u"</"_q + name + QChar('>');
+	};
+	const auto simple = [&](const QString &value, const QString &name) {
+		if (markdown) {
+			both(value);
+		} else {
+			tag(name);
+		}
+	};
+	switch (span.type) {
+	case EntityType::Bold: simple(u"**"_q, u"b"_q); break;
+	case EntityType::Italic: simple(u"_"_q, u"i"_q); break;
+	case EntityType::Underline: simple(u"__"_q, u"u"_q); break;
+	case EntityType::StrikeOut: simple(u"~~"_q, u"s"_q); break;
+	case EntityType::Spoiler:
+		if (markdown) {
+			both(u"||"_q);
+		} else {
+			span.open = u"<span class=\"tg-spoiler\">"_q;
+			span.close = u"</span>"_q;
+		}
+		break;
+	case EntityType::CustomUrl:
+	case EntityType::MentionName:
+		if (markdown) {
+			span.open = u"["_q;
+			span.close = u"]("_q + MarkdownUrl(span.data) + QChar(')');
+		} else {
+			span.open = u"<a href=\""_q
+				+ Writer::Escape(span.data, true)
+				+ u"\">"_q;
+			span.close = u"</a>"_q;
+		}
+		break;
+	case EntityType::Code:
+		if (markdown) {
+			const auto content = text.mid(span.from, span.till - span.from);
+			const auto fence = QString(
+				LongestRun(content, '`') + 1,
+				QChar('`'));
+			const auto pad = (content.startsWith('`')
+				|| content.endsWith('`'))
+				? u" "_q
+				: QString();
+			span.open = fence + pad;
+			span.close = pad + fence;
+		} else {
+			tag(u"code"_q);
+		}
+		break;
+	case EntityType::Pre: {
+		const auto language = span.data.trimmed();
+		if (markdown) {
+			const auto content = text.mid(span.from, span.till - span.from);
+			const auto fence = QString(
+				std::max(3, LongestRun(content, '`') + 1),
+				QChar('`'));
+			span.open = fence + language + QChar('\n');
+			span.close = fence;
+		} else if (language.isEmpty()) {
+			tag(u"pre"_q);
+		} else {
+			span.open = u"<pre><code class=\"language-"_q
+				+ Writer::Escape(language, true)
+				+ u"\">"_q;
+			span.close = u"</code></pre>"_q;
+		}
+	} break;
+	case EntityType::Blockquote:
+		if (!markdown) {
+			span.open = span.data.isEmpty()
+				? u"<blockquote>"_q
+				: u"<blockquote expandable>"_q;
+			span.close = u"</blockquote>"_q;
+		}
+		break;
+	default: break;
+	}
+}
+
+void Open(Writer &writer, const Span &span, Format format) {
+	if (format == Format::Markdown) {
+		if (span.kind == Kind::Quote) {
+			writer.ensureLine();
+			writer.enterQuote();
+			return;
+		} else if (span.kind == Kind::Pre) {
+			writer.ensureLine();
+		}
+	}
+	writer.markup(span.open);
+}
+
+void Close(Writer &writer, const Span &span, Format format) {
+	if (format == Format::Markdown) {
+		if (span.kind == Kind::Quote) {
+			writer.leaveQuote();
+			writer.requestBreak();
+			return;
+		} else if (span.kind == Kind::Pre) {
+			writer.ensureLine();
+			writer.markup(span.close);
+			writer.requestBreak();
+			return;
+		}
+	}
+	writer.markup(span.close);
+}
+
+[[nodiscard]] QString Convert(const TextWithEntities &text, Format format) {
+	const auto view = QStringView(text.text);
+	auto spans = DropInsideCode(
+		SplitSpans(CollectSpans(text), view, format));
+	ranges::stable_sort(spans, [](const Span &a, const Span &b) {
+		if (a.from != b.from) {
+			return a.from < b.from;
+		} else if (a.till != b.till) {
+			return a.till > b.till;
+		}
+		return int(a.kind) < int(b.kind);
+	});
+	for (auto &span : spans) {
+		Decorate(span, view, format);
+	}
+
+	auto writer = Writer(format);
+	auto stack = std::vector<int>();
+	auto next = 0;
+	const auto count = int(spans.size());
+	const auto size = int(view.size());
+	for (auto position = 0; position <= size; ++position) {
+		const auto ending = ranges::find_if(stack, [&](int index) {
+			return spans[index].till == position;
+		});
+		if (ending != end(stack)) {
+			const auto lowest = int(ending - begin(stack));
+			auto reopen = std::vector<int>();
+			while (int(stack.size()) > lowest) {
+				const auto index = stack.back();
+				stack.pop_back();
+				Close(writer, spans[index], format);
+				if (spans[index].till != position) {
+					reopen.push_back(index);
+				}
+			}
+			for (auto i = rbegin(reopen); i != rend(reopen); ++i) {
+				Open(writer, spans[*i], format);
+				stack.push_back(*i);
+			}
+		}
+		while (next != count && spans[next].from == position) {
+			Open(writer, spans[next], format);
+			stack.push_back(next++);
+		}
+		if (position < size) {
+			writer.text(view[position]);
+		}
+	}
+	return std::move(writer).result();
+}
+
+[[nodiscard]] TextWithEntities ItemText(
+		not_null<HistoryItem*> item,
+		bool asGroup) {
+	if (asGroup) {
+		if (const auto group = item->history()->owner().groups().find(item)) {
+			return HistoryGroupText(group).rich;
+		}
+	}
+	return HistoryItemText(item).rich;
+}
+
+} // namespace
+
+QString TextToMarkdown(const TextWithEntities &text) {
+	return Convert(text, Format::Markdown);
+}
+
+QString TextToHtml(const TextWithEntities &text) {
+	return Convert(text, Format::Html);
+}
+
+void AddCopyMarkupActions(
+		not_null<Ui::PopupMenu*> menu,
+		const TextWithEntities &text) {
+	if (!CopyMarkdown() || text.text.isEmpty()) {
+		return;
+	}
+	menu->addAction(Lower(u"Copy as Markdown"_q), [=] {
+		QGuiApplication::clipboard()->setText(TextToMarkdown(text));
+	}, &st::menuIconCopy);
+	menu->addAction(Lower(u"Copy as HTML"_q), [=] {
+		QGuiApplication::clipboard()->setText(TextToHtml(text));
+	}, &st::menuIconCopy);
+}
+
+void AddCopyMarkupActions(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<HistoryItem*> item,
+		bool asGroup) {
+	if (CopyMarkdown()) {
+		AddCopyMarkupActions(menu, ItemText(item, asGroup));
+	}
+}
+
+} // namespace Tele
