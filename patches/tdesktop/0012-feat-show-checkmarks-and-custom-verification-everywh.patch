+
+void AddAccountBotVerify(
+		not_null<Ui::SettingsButton*> button,
+		not_null<UserData*> user,
+		Fn<bool()> paused) {
+	if (!user->botVerifyDetails()) {
+		return;
+	}
+	const auto badge = button->lifetime().make_state<Info::Profile::Badge>(
+		button,
+		st::settingsInfoPeerBadge,
+		&user->session(),
+		Info::Profile::BotVerifyBadgeForPeer(user),
+		nullptr,
+		std::move(paused),
+		0,
+		Info::Profile::BadgeType::BotVerified);
+	button->heightValue(
+	) | rpl::on_next([=](int height) {
+		const auto &st = st::mainMenuAddAccountButton;
+		badge->move(
+			st.padding.left(),
+			st.padding.top(),
+			height - st.padding.top());
+	}, button->lifetime());
+}
+
+CoverBadges::CoverBadges(
+	not_null<QWidget*> parent,
+	not_null<UserData*> user,
+	Fn<bool()> paused,
+	const style::InfoPeerBadge *verifiedSt)
+: _botVerify(std::make_unique<Info::Profile::Badge>(
+	parent,
+	st::settingsInfoPeerBadge,
+	&user->session(),
+	Info::Profile::BotVerifyBadgeForPeer(user),
+	nullptr,
+	paused,
+	0,
+	Info::Profile::BadgeType::BotVerified))
+, _verified(std::make_unique<Info::Profile::Badge>(
+	parent,
+	verifiedSt ? *verifiedSt : st::settingsInfoPeerBadge,
+	&user->session(),
+	Info::Profile::VerifiedContentForPeer(user),
+	nullptr,
+	paused,
+	0,
+	Info::Profile::BadgeType::Verified))
+, _verifiedSkip(verifiedSt ? verifiedSt->position.x() : 0) {
+}
+
+CoverBadges::~CoverBadges() = default;
+
+rpl::producer<> CoverBadges::updated() const {
+	return rpl::merge(_botVerify->updated(), _verified->updated());
+}
+
+int CoverBadges::leftSkip() const {
+	const auto widget = _botVerify->widget();
+	return widget ? (widget->width() + st::semiboldFont->spacew) : 0;
+}
+
+int CoverBadges::rightWidth() const {
+	const auto widget = _verified->widget();
+	return widget ? (widget->width() + _verifiedSkip) : 0;
+}
+
+void CoverBadges::move(int left, int right, int top, int bottom) {
+	_botVerify->move(left, top, bottom);
+	_verified->move(right, top, bottom);
+}
+
+} // namespace Tele
