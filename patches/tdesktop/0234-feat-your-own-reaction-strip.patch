+					QPointF(
+						at.x() + _inner.x() + _inner.width() / 2.,
+						at.y() + _inner.y() + _inner.height() + radius),
+					radius,
+					radius);
+			}
 		} else if (!hiding) {
 			clearStateForHidden(icon);
 		}
