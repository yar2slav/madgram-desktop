+int Editor::MinimalWidth() {
+	const auto strip = 2 * st::reactStripSkip
+		+ (kReactionStripMaxCount + 1) * st::reactStripSize;
+	const auto &shadow = st::reactionCornerShadow;
+	return 2 * st::msgMargin.left()
+		+ shadow.left()
+		+ strip
+		+ shadow.right();
+}
