@@ -0,0 +1,147 @@
+#include "tele/tele_reaction_order.h"
+
+#include "data/data_message_reactions.h"
+#include "data/data_session.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxEmojiLength = 32;
+
+using Ids = std::vector<Data::ReactionId>;
+
+[[nodiscard]] std::optional<Data::ReactionId> ParseOne(QString part) {
+	part = part.trimmed();
+	if (part.isEmpty()
+		|| part.size() > kMaxEmojiLength
+		|| part == QString(Data::ReactionId::PaidTag())) {
+		return std::nullopt;
+	}
+	const auto digits = ranges::all_of(part, [](QChar ch) {
+		return ch.isDigit();
+	});
+	if (digits) {
+		auto ok = false;
+		const auto id = part.toULongLong(&ok);
+		return (ok && id)
+			? std::make_optional(Data::ReactionId{ DocumentId(id) })
+			: std::nullopt;
+	} else if (ranges::any_of(part, [](QChar ch) { return ch.isSpace(); })) {
+		return std::nullopt;
+	}
+	return Data::ReactionId{ part };
+}
+
+} // namespace
+
+Ids ParseReactionOrder(const QString &value) {
+	auto result = Ids();
+	for (const auto &part : value.split(QChar(','))) {
+		const auto id = ParseOne(part);
+		result.push_back((id && !ranges::contains(result, *id))
+			? *id
+			: Data::ReactionId());
+	}
+	while (!result.empty() && result.back().empty()) {
+		result.pop_back();
+	}
+	return result;
+}
+
+QString SerializeReactionOrder(const Ids &list) {
+	auto parts = QStringList();
+	for (const auto &id : list) {
+		parts.push_back(id.custom()
+			? QString::number(id.custom())
+			: id.emoji());
+	}
+	while (!parts.isEmpty() && parts.back().isEmpty()) {
+		parts.pop_back();
+	}
+	return parts.join(QChar(','));
+}
+
+int PinnedReactionsCount(const Ids &list) {
+	return int(ranges::count_if(list, [](const Data::ReactionId &id) {
+		return !id.empty();
+	}));
+}
+
+Data::PossibleItemReactionsRef ApplyReactionOrder(
+		not_null<Main::Session*> session,
+		const Data::PossibleItemReactionsRef &reactions,
+		const Ids &order) {
+	if (!PinnedReactionsCount(order)
+		|| reactions.tags
+		|| !reactions.stickers.empty()
+		|| ranges::any_of(reactions.recent, [](const auto &reaction) {
+			return reaction->effect;
+		})) {
+		return reactions;
+	}
+	auto result = reactions;
+	auto &list = result.recent;
+	const auto paid = ranges::find(
+		list,
+		Data::ReactionId::Paid(),
+		&Data::Reaction::id);
+	const auto paidIndex = (paid != end(list))
+		? int(paid - begin(list))
+		: -1;
+	const Data::Reaction *paidReaction = (paidIndex >= 0)
+		? paid->get()
+		: nullptr;
+	if (paidReaction) {
+		list.erase(paid);
+	}
+	const auto owner = &session->data().reactions();
+	auto placed = std::vector<const Data::Reaction*>(order.size());
+	for (auto i = 0, count = int(order.size()); i != count; ++i) {
+		const auto &id = order[i];
+		if (id.empty()) {
+			continue;
+		}
+		const auto j = ranges::find(list, id, &Data::Reaction::id);
+		if (j != end(list)) {
+			placed[i] = j->get();
+			list.erase(j);
+		} else if (id.custom() && result.customAllowed) {
+			placed[i] = owner->lookupTemporary(id);
+		}
+	}
+	auto merged = std::vector<not_null<const Data::Reaction*>>();
+	merged.reserve(list.size() + placed.size());
+	auto rest = begin(list);
+	for (const auto reaction : placed) {
+		if (reaction) {
+			merged.push_back(reaction);
+		} else if (rest != end(list)) {
+			merged.push_back(*rest++);
+		}
+	}
+	merged.insert(end(merged), rest, end(list));
+	list = std::move(merged);
+	if (paidReaction) {
+		list.insert(
+			begin(list) + std::min(paidIndex, int(list.size())),
+			not_null(paidReaction));
+	}
+	return result;
+}
+
+Data::PossibleItemReactionsRef ReactionStripOrder(
+		not_null<Main::Session*> session,
+		const Data::PossibleItemReactionsRef &reactions) {
+	return ApplyReactionOrder(
+		session,
+		reactions,
+		ParseReactionOrder(ReactionsOrder()));
+}
+
+QString NormalizeReactionOrder(const QString &value) {
+	return SerializeReactionOrder(ParseReactionOrder(value));
+}
+
+} // namespace Tele
