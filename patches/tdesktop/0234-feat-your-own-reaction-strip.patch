+#include "tele/tele_reaction_strip.h"
+
+#include "data/data_message_reactions.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+int ReactionStripColumns(
+		const Data::PossibleItemReactions &reactions,
+		int columns,
+		int max) {
+	const auto count = ReactionsStripCount().toInt();
+	if (count < kReactionStripMinCount
+		|| count > kReactionStripMaxCount
+		|| !reactions.stickers.empty()
+		|| ranges::any_of(reactions.recent, &Data::Reaction::effect)) {
+		return columns;
+	}
+	return std::min(count + 1, max);
+}
+
+} // namespace Tele
