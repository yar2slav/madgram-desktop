+
+bool Editor::idle() const {
+	return !_drag && !_expanded && (_pressIndex < 0);
+}
+
+void Editor::rebuild() {
+	cancelDrag();
+	_expanded = false;
+	_replaceAt = -1;
+	if (_selector) {
+		_selector->beforeDestroy();
+		_selector = nullptr;
+	}
+	const auto reactions = Ordered(_session, _pinned);
+	_shownCount = int(reactions.recent.size());
+	if (reactions.recent.empty()) {
+		_body = QRect();
+		_area->hide();
+		resizeToWidth(width());
+		update();
+		return;
+	}
+	_selector = base::make_unique_q<Selector>(
+		_area,
+		st::reactPanelEmojiPan,
+		_controller->uiShow(),
+		reactions,
+		TextWithEntities(),
+		crl::guard(this, [=](bool) { collapseLater(); }),
+		nullptr,
+		[=] {
+			return _controller->isGifPausedAtLeastFor(
+				Window::GifPauseReason::Layer);
+		},
+		true);
+	const auto selector = _selector.get();
+	const auto &st = st::popupMenuWithIcons;
+	const auto &extend = st::reactStripExtend;
+	const auto added = extend.left() + extend.right();
+	const auto outer = selector->countWidth(
+		_menuWidth + added,
+		st.menu.widthMax + added);
+	const auto margins = selector->marginsForShadow();
+	_stripTop = margins.top()
+		+ selector->extendTopForCategoriesAndAbout(outer);
+	_menu->setForceWidth(outer - added);
+	_body = QRect(
+		margins.left() + extend.left(),
+		_stripTop + extend.top(),
+		outer - added,
+		st.scrollPadding.top() + _menu->height() + st.scrollPadding.bottom());
+	_menu->move(_body.x(), _body.y() + st.scrollPadding.top());
+	_area->resize(outer + margins.left() + margins.right(), _area->height());
+	selector->initGeometry(_stripTop);
+	selector->strip()->setMarked(Marked(_pinned));
+	_collapsedHeight = std::max(
+		_body.y() + _body.height() + _shadow.extend().bottom(),
+		selector->y() + selector->height());
+	_expandedHeight = std::max(
+		_collapsedHeight,
+		_stripTop + st::emojiPanMinHeight + margins.bottom());
+	_area->resize(_area->width(), _collapsedHeight);
+	_area->show();
+	selector->show();
+
+	selector->willExpand(
+	) | rpl::on_next([=] {
+		cancelDrag();
+		_expanded = true;
+		setAreaHeight(_expandedHeight);
+	}, selector->lifetime());
+
+	selector->chosen(
+	) | rpl::on_next([=](HistoryView::Reactions::ChosenReaction chosen) {
+		if (!_expanded || chosen.id.empty()) {
+			return;
+		}
+		setPinned((_replaceAt >= 0)
+			? Replaced(_session, _pinned, _replaceAt, chosen.id)
+			: Appended(_pinned, chosen.id));
+		collapseLater();
+	}, selector->lifetime());
+
+	selector->escapes(
+	) | rpl::on_next([=] {
+		collapseLater();
+	}, selector->lifetime());
+
+	base::install_event_filter(selector, [=](not_null<QEvent*> e) {
+		return handleSelectorEvent(e);
+	});
+
+	resizeToWidth(width());
+	_layer->raise();
+	update();
+}
+
+void Editor::collapseLater() {
+	crl::on_main(this, [=] {
+		if (_expanded) {
+			rebuild();
+		}
+	});
+}
+
+void Editor::reset() {
+	if (_pinned.empty()) {
+		return;
+	}
+	cancelDrag();
+	setPinned({});
+	applyPinned();
+}
+
+void Editor::applyPinned() {
+	if (!_selector
+		|| _expanded
+		|| (int(Ordered(_session, _pinned).recent.size()) != _shownCount)) {
+		rebuild();
+	} else {
+		showPinned(_pinned);
+	}
+}
+
+void Editor::setAreaHeight(int height) {
+	if (_area->height() != height) {
+		_area->resize(_area->width(), height);
+		resizeToWidth(width());
+	}
+}
+
+void Editor::setPinned(Ids pinned) {
+	_pinned = std::move(pinned);
+	SetReactionsOrder(SerializeReactionOrder(_pinned));
+	resolveMissing();
+}
+
+void Editor::showPinned(const Ids &pinned) {
+	const auto reactions = Ordered(_session, pinned);
+	_selector->applyStripReactions(reactions);
+	_selector->strip()->setMarked(Marked(pinned));
+	if (!_drag) {
+		return;
+	}
+	const auto ids = CollectIds(reactions);
+	const auto i = ranges::find(ids, _drag->id);
+	const auto index = int(i - begin(ids));
+	_selector->strip()->setHiddenIndex(
+		(i != end(ids) && index < visibleReactions()) ? index : -1);
+}
+
+void Editor::resolveMissing() {
+	_resolveLifetime.destroy();
+	const auto owner = &_session->data();
+	for (const auto &id : _pinned) {
+		const auto custom = id.custom();
+		if (!custom || owner->document(custom)->sticker()) {
+			continue;
+		}
+		owner->customEmojiManager().resolve(
+			custom
+		) | rpl::on_next_error([=](not_null<DocumentData*>) {
+			crl::on_main(this, [=] {
+				if (idle()) {
+					rebuild();
+				}
+			});
+		}, [] {}, _resolveLifetime);
+	}
+}
+
+int Editor::visibleReactions() const {
+	const auto strip = _selector->strip();
+	return strip->count() - (strip->hasButton() ? 1 : 0);
+}
+
+bool Editor::isButton(int index) const {
+	const auto strip = _selector->strip();
+	return strip->hasButton() && (index == strip->count() - 1);
+}
+
+base::EventFilterResult Editor::handleSelectorEvent(not_null<QEvent*> e) {
+	using Result = base::EventFilterResult;
+	if (_expanded || !_selector) {
+		return Result::Continue;
+	}
+	const auto type = e->type();
+	if (type == QEvent::MouseButtonPress
+		|| type == QEvent::MouseButtonDblClick) {
+		const auto mouse = static_cast<QMouseEvent*>(e.get());
+		const auto index = _selector->lookupSelectedIndex(mouse->pos());
+		if (mouse->button() == Qt::LeftButton) {
+			_pressIndex = index;
+			_pressPosition = mouse->pos();
+			return Result::Continue;
+		}
+		return (index >= 0 && !isButton(index))
+			? Result::Cancel
+			: Result::Continue;
+	} else if (type == QEvent::MouseMove) {
+		const auto mouse = static_cast<QMouseEvent*>(e.get());
+		if (_drag) {
+			updateDrag(mouse->pos());
+			return Result::Cancel;
+		} else if (_pressIndex >= 0
+			&& (mouse->buttons() & Qt::LeftButton)
+			&& ((mouse->pos() - _pressPosition).manhattanLength()
+				>= QApplication::startDragDistance())) {
+			startDrag();
+			if (_drag) {
+				updateDrag(mouse->pos());
+				return Result::Cancel;
+			}
+		}
+		return Result::Continue;
+	} else if (type == QEvent::MouseButtonRelease) {
+		const auto mouse = static_cast<QMouseEvent*>(e.get());
+		const auto index = _selector->lookupSelectedIndex(mouse->pos());
+		if (mouse->button() != Qt::LeftButton) {
+			return (index >= 0 && !isButton(index))
+				? Result::Cancel
+				: Result::Continue;
+		}
+		const auto pressed = std::exchange(_pressIndex, -1);
+		if (_drag) {
+			finishDrag(mouse->pos());
+			return Result::Cancel;
+		} else if (pressed < 0 || isButton(pressed)) {
+			return Result::Continue;
+		} else if (pressed == index) {
+			_replaceAt = index;
+			_selector->expand();
+		}
+		return Result::Cancel;
+	} else if (type == QEvent::ContextMenu) {
+		const auto menu = static_cast<QContextMenuEvent*>(e.get());
+		const auto index = _selector->lookupSelectedIndex(menu->pos());
+		if (index < 0 || isButton(index)) {
+			return Result::Continue;
+		}
+		showContextMenu(index);
+		return Result::Cancel;
+	}
+	return Result::Continue;
+}
+
+void Editor::startDrag() {
+	const auto index = std::exchange(_pressIndex, -1);
+	const auto strip = _selector->strip();
+	if (index < 0 || index >= strip->count() || isButton(index)) {
+		return;
+	}
+	const auto ids = CollectIds(Ordered(_session, _pinned));
+	if (index >= int(ids.size())) {
+		return;
+	}
+	auto drag = Drag{
+		.id = ids[index],
+		.start = _pinned,
+		.shown = _pinned,
+	};
+	const auto slot = _selector->stripSlot(index);
+	drag.grab = _pressPosition - slot.center();
+	_selector->setSelected(-1);
+
+	const auto ratio = style::DevicePixelRatio();
+	drag.image = QImage(
+		slot.size() * 2 * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	drag.image.setDevicePixelRatio(ratio);
+	drag.image.fill(Qt::transparent);
+	{
+		auto p = QPainter(&drag.image);
+		strip->paintOne(
+			p,
+			index,
+			QPoint(slot.width() / 2, slot.height() / 2),
+			1.);
+	}
+	strip->setHiddenIndex(index);
+	_drag = std::move(drag);
+	_selector->setCursor(style::cur_sizeall);
+	_layer->show();
+	_layer->raise();
+}
+
+void Editor::updateDrag(QPoint position) {
+	auto &drag = *_drag;
+	drag.position = _selector->mapTo(this, position);
+	const auto strip = _selector->strip();
+	const auto first = _selector->stripSlot(0);
+	const auto size = first.width();
+	const auto reactions = visibleReactions();
+	const auto band = QRect(
+		first.x(),
+		first.y(),
+		size * strip->count(),
+		first.height()
+	).marginsAdded({ size, first.height(), size, first.height() });
+	const auto center = position - drag.grab;
+	const auto inside = band.contains(center);
+	const auto offset = (center.x() - first.x()) / float64(size);
+	drag.removing = !inside && ranges::contains(drag.start, drag.id);
+	auto shown = drag.removing
+		? Unpinned(drag.start, drag.id)
+		: drag.start;
+	if (inside) {
+		shown = Moved(
+			_session,
+			drag.start,
+			drag.id,
+			std::clamp(
+				int(std::floor(offset)),
+				0,
+				std::max(reactions - 1, 0)));
+		const auto same = (shown != drag.start)
+			&& (CollectIds(Ordered(_session, shown))
+				== CollectIds(Ordered(_session, drag.start)));
+		if (same) {
+			shown = drag.start;
+		}
+	}
+	if (shown != drag.shown) {
+		drag.shown = std::move(shown);
+		showPinned(drag.shown);
+	}
+	_layer->update();
+}
+
+void Editor::finishDrag(QPoint position) {
+	const auto drag = base::take(_drag);
+	_layer->hide();
+	_selector->strip()->setHiddenIndex(-1);
+	_selector->setCursor(style::cur_default);
+	if (drag->shown != _pinned) {
+		setPinned(drag->shown);
+		if (int(Ordered(_session, _pinned).recent.size()) != _shownCount) {
+			rebuild();
+			return;
+		}
+	}
+	_selector->setSelected(_selector->lookupSelectedIndex(position));
+}
+
+void Editor::cancelDrag() {
+	_pressIndex = -1;
+	if (base::take(_drag)) {
+		_layer->hide();
+	}
+}
+
+void Editor::showContextMenu(int index) {
+	const auto ids = CollectIds(Ordered(_session, _pinned));
+	if (index >= int(ids.size()) || !ranges::contains(_pinned, ids[index])) {
+		return;
+	}
+	const auto id = ids[index];
+	_contextMenu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	_contextMenu->addAction(Lower(u"Unpin"_q), [=] {
+		if (_drag || _expanded || !_selector) {
+			return;
+		}
+		setPinned(Unpinned(_pinned, id));
+		applyPinned();
+	}, &st::menuIconUnpin);
+	_contextMenu->popup(QCursor::pos());
+}
+
+void Editor::paintLayer(QPainter &p) {
+	if (!_drag || !_selector) {
+		return;
+	}
+	const auto &drag = *_drag;
+	const auto ratio = drag.image.devicePixelRatio();
+	const auto size = QSize(
+		int(drag.image.width() / ratio),
+		int(drag.image.height() / ratio));
+	const auto center = drag.position - drag.grab;
+	p.setOpacity(drag.removing ? kRemovingOpacity : 1.);
+	p.drawImage(
+		QRect(
+			center - QPoint(size.width() / 2, size.height() / 2),
+			size),
+		drag.image);
+}
+
+int Editor::resizeGetHeight(int newWidth) {
+	if (newWidth < st::msgMinWidth) {
+		return height();
+	}
+	const auto view = _item.get();
+	const auto height = view->resizeGetHeight(newWidth);
+	const auto skip = st::msgMargin.bottom();
+	const auto bubble = view->innerGeometry();
+	if (!_selector) {
+		_messageLeft = (newWidth - bubble.width()) / 2 - bubble.x();
+		_messageTop = skip;
+		return _messageTop + height + st::normalFont->height + 2 * skip;
+	}
+	const auto below = bubble.y() + bubble.height() + st::reactStripSkip;
+	_messageTop = std::max(skip, _stripTop - below);
+	const auto areaTop = _messageTop + below - _stripTop;
+	const auto margins = _selector->marginsForShadow();
+	const auto anchor = bubble.x() - margins.left();
+	const auto left = std::min(bubble.x(), anchor + margins.left());
+	const auto right = std::max(
+		bubble.x() + bubble.width(),
+		anchor + _area->width() - margins.right());
+	const auto centered = (newWidth - (right - left)) / 2 - left;
+	const auto lowest = -anchor;
+	const auto highest = newWidth - _area->width() - anchor;
+	_messageLeft = (highest < lowest)
+		? lowest
+		: std::clamp(centered, lowest, highest);
+	_area->move(anchor + _messageLeft, areaTop);
+	return areaTop + _area->height() + skip;
+}
+
+void Editor::paintEvent(QPaintEvent *e) {
+	const auto clip = e->rect();
+	const auto theme = _controller->defaultChatTheme().get();
+	Window::SectionWidget::PaintBackground(_controller, theme, this, clip);
+
+	auto p = Painter(this);
+	const auto view = _item.get();
+	auto context = theme->preparePaintContext(
+		_chatStyle.get(),
+		rect(),
+		rect(),
+		rect(),
+		_controller->isGifPausedAtLeastFor(Window::GifPauseReason::Layer));
+	context.outbg = view->hasOutLayout();
+	p.translate(_messageLeft, _messageTop);
+	view->draw(p, context);
+	p.translate(-_messageLeft, -_messageTop);
+
+	if (!_selector) {
+		p.setFont(st::normalFont);
+		p.setPen(st::msgServiceFg);
+		p.drawText(
+			QRect(
+				0,
+				_messageTop + view->height(),
+				width(),
+				height() - _messageTop - view->height()),
+			Lower(u"Loading reactions\u2026"_q),
+			style::al_center);
+	}
+}
+
+void Editor::mousePressEvent(QMouseEvent *e) {
+	if (_expanded) {
+		collapseLater();
+	}
+}
+
+} // namespace
+
+void ReactionMenuBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setTitle(rpl::single(Lower(u"Reactions in the menu"_q)));
+	box->setWidth(std::max(st::boxWideWidth, Editor::MinimalWidth()));
+
+	const auto editor = box->addRow(
+		object_ptr<Editor>(box, controller),
+		style::margins());
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"Click a reaction to change it, drag to reorder."_q),
+			st::boxDividerLabel),
+		st::boxRowPadding + QMargins(0, st::defaultVerticalListSkip, 0, 0));
+
+	Ui::AddSkip(box->verticalLayout());
+	Ui::AddSubsectionTitle(
+		box->verticalLayout(),
+		rpl::single(Lower(u"Shown in the strip"_q)));
+
+	const auto &labelSt = st::settingsScaleLabel;
+	auto slider = Settings::MakeSliderWithLabel(
+		box,
+		st::settingsScale,
+		labelSt,
+		st::normalFont->spacew * 2,
+		std::max(
+			labelSt.style.font->width(CountText(0)),
+			labelSt.style.font->width(
+				QString::number(kReactionStripMaxCount))),
+		true);
+	const auto label = slider.label;
+	const auto current = box->lifetime().make_state<int>(
+		ValidCount(ReactionsStripCount()));
+	label->setText(CountText(*current));
+	slider.slider->setPseudoDiscrete(
+		kReactionStripMaxCount - kReactionStripMinCount + 2,
+		[](int index) {
+			return index ? (kReactionStripMinCount + index - 1) : 0;
+		},
+		*current,
+		[=](int count) {
+			label->setText(CountText(count));
+			if (*current == count) {
+				return;
+			}
+			*current = count;
+			SetReactionsStripCount(count ? QString::number(count) : QString());
+			editor->rebuild();
+		});
+	box->addRow(std::move(slider.widget));
+
+	box->addLeftButton(rpl::single(Lower(u"Reset"_q)), [=] {
+		editor->reset();
+	});
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+rpl::producer<QString> ReactionMenuLabelValue() {
+	return rpl::combine(
+		ReactionsStripCountValue(),
+		ReactionsOrderValue()
+	) | rpl::map([](const QString &count, const QString &order) {
+		const auto shown = CountText(ValidCount(count));
+		const auto pinned = PinnedReactionsCount(ParseReactionOrder(order));
+		return pinned
+			? Lower(u"%1, %2 pinned"_q).arg(shown).arg(pinned)
+			: shown;
+	});
+}
+
