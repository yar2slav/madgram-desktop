+constexpr auto kRemovingOpacity = 0.4;
+
+using Ids = std::vector<Data::ReactionId>;
+using Selector = HistoryView::Reactions::Selector;
+
+[[nodiscard]] Data::PossibleItemReactionsRef Ordered(
+		not_null<Main::Session*> session,
+		const Ids &pinned) {
+	return ApplyReactionOrder(
+		session,
+		Data::LookupPossibleReactions(session),
+		pinned);
+}
+
+[[nodiscard]] Ids CollectIds(const Data::PossibleItemReactionsRef &list) {
+	auto result = Ids();
+	result.reserve(list.recent.size());
+	for (const auto &reaction : list.recent) {
+		result.push_back(reaction->id);
+	}
+	return result;
+}
+
+[[nodiscard]] Ids Trimmed(Ids list) {
+	while (!list.empty() && list.back().empty()) {
+		list.pop_back();
+	}
+	return list;
+}
+
+void Put(Ids &list, int slot, const Data::ReactionId &id) {
+	if (int(list.size()) <= slot) {
+		list.resize(slot + 1);
+	}
+	list[slot] = id;
+}
+
+[[nodiscard]] Ids Unpinned(Ids list, const Data::ReactionId &id) {
+	for (auto &value : list) {
+		if (value == id) {
+			value = Data::ReactionId();
+		}
+	}
+	return Trimmed(std::move(list));
+}
+
+[[nodiscard]] Ids PinnedAt(
+		const Ids &pinned,
+		const Data::ReactionId &id,
+		int slot) {
+	auto result = Unpinned(pinned, id);
+	Put(result, slot, id);
+	return result;
+}
+
+[[nodiscard]] Ids Appended(const Ids &pinned, const Data::ReactionId &id) {
+	const auto without = Unpinned(pinned, id);
+	return PinnedAt(without, id, int(without.size()));
+}
+
+[[nodiscard]] Ids Replaced(
+		not_null<Main::Session*> session,
+		const Ids &pinned,
+		int slot,
+		const Data::ReactionId &id) {
+	const auto shown = CollectIds(Ordered(session, pinned));
+	return PinnedAt(
+		(slot < int(shown.size())) ? Unpinned(pinned, shown[slot]) : pinned,
+		id,
+		slot);
+}
+
+[[nodiscard]] Ids Moved(
+		not_null<Main::Session*> session,
+		const Ids &pinned,
+		const Data::ReactionId &id,
+		int slot) {
+	auto shown = CollectIds(Ordered(session, pinned));
+	const auto from = ranges::find(shown, id);
+	if (from == end(shown)) {
+		return pinned;
+	}
+	shown.erase(from);
+	slot = std::clamp(slot, 0, int(shown.size()));
+	shown.insert(begin(shown) + slot, id);
+	auto result = Ids();
+	for (auto i = 0, count = int(shown.size()); i != count; ++i) {
+		const auto &value = shown[i];
+		if (value == id || ranges::contains(pinned, value)) {
+			Put(result, i, value);
+		}
+	}
+	for (auto i = 0, count = int(pinned.size()); i != count; ++i) {
+		const auto &value = pinned[i];
+		if (value.empty() || ranges::contains(shown, value)) {
+			continue;
+		}
+		auto free = i;
+		while (free < int(result.size()) && !result[free].empty()) {
+			++free;
+		}
+		Put(result, free, value);
+	}
+	return Trimmed(std::move(result));
+}
+
+[[nodiscard]] base::flat_set<Data::ReactionId> Marked(const Ids &pinned) {
+	auto result = base::flat_set<Data::ReactionId>();
+	for (const auto &id : pinned) {
+		if (!id.empty()) {
+			result.emplace(id);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] int ValidCount(const QString &value) {
+	const auto count = value.toInt();
+	return (count >= kReactionStripMinCount
+		&& count <= kReactionStripMaxCount)
+		? count
+		: 0;
+}
+
+[[nodiscard]] QString CountText(int count) {
+	return count ? QString::number(count) : Lower(u"Auto"_q);
+}
+
+[[nodiscard]] AdminLog::OwnedItem GenerateItem(
+		not_null<HistoryView::ElementDelegate*> delegate,
+		not_null<History*> history) {
+	const auto item = history->makeMessage({
+		.id = history->nextNonHistoryEntryId(),
+		.flags = MessageFlag::FakeHistoryItem,
+		.from = history->peer->id,
+		.date = base::unixtime::now(),
+	}, TextWithEntities{ Lower(u"Pinned reactions keep their place in "
+		"every message menu."_q) }, MTP_messageMediaEmpty());
+	return AdminLog::OwnedItem(delegate, item);
+}
