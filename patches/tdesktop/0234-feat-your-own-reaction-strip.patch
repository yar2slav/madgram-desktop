+void Strip::applyListKeepingState(
+		const std::vector<not_null<const Data::Reaction*>> &list,
+		AddedButton button) {
+	auto was = base::take(_icons);
+	auto used = std::vector<bool>(was.size());
+	const auto selected = std::exchange(_selectedIcon, -1);
+	const auto hidden = std::exchange(_hiddenIcon, -1);
+	const auto find = [&](const ReactionId &id, AddedButton added) {
+		for (auto i = 0, count = int(was.size()); i != count; ++i) {
+			if (!used[i] && was[i].added == added && was[i].id == id) {
+				used[i] = true;
+				return i;
+			}
+		}
+		return -1;
+	};
+	const auto push = [&](int from, ReactionIcons &&fresh) {
+		const auto index = int(_icons.size());
+		if (from < 0) {
+			_icons.push_back(std::move(fresh));
+			return;
+		}
+		_icons.push_back(std::move(was[from]));
+		auto &icon = _icons.back();
+		const auto shift = from + icon.slide.value(0.) - index;
+		if (shift != 0.) {
+			icon.slide.start(
+				_update,
+				shift,
+				0.,
+				kSlideDuration,
+				anim::easeOutCubic);
+		}
+		if (from == selected) {
+			_selectedIcon = index;
+		}
+		if (from == hidden) {
+			_hiddenIcon = index;
+		}
+	};
+	_icons.reserve(list.size() + 1);
+	for (const auto &reaction : list) {
+		push(find(reaction->id, AddedButton::None), {
+			.id = reaction->id,
+			.appearAnimation = reaction->appearAnimation,
+			.selectAnimation = reaction->selectAnimation,
+		});
+	}
+	_button = button;
+	if (_button != AddedButton::None) {
+		push(find(ReactionId(), _button), { .added = _button });
+	}
+	const auto frontAppeared = !_icons.empty()
+		&& _icons.front().appearAnimated;
+	resolveMainReactionIcon();
+	if (!_icons.empty()) {
+		_icons.front().appearAnimated = frontAppeared;
+	}
+	if (_update) {
+		_update();
+	}
+}
+
+void Strip::setHiddenIndex(int index) {
+	if (_hiddenIcon != index) {
+		_hiddenIcon = index;
+		if (_update) {
+			_update();
+		}
+	}
+}
+
+void Strip::setMarked(base::flat_set<ReactionId> marked) {
+	if (_marked != marked) {
+		_marked = std::move(marked);
+		if (_update) {
+			_update();
+		}
+	}
+}
