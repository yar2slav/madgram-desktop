diff --git a/Telegram/SourceFiles/tele/tele_ignored.cpp b/Telegram/SourceFiles/tele/tele_ignored.cpp
index 198ac13071d4b25d7d0ecd05fd8c694423c7f8ae..273f98d2cd4ccce52a4fc6ff28cea4657a289472 100644
--- a/Telegram/SourceFiles/tele/tele_ignored.cpp
+++ b/Telegram/SourceFiles/tele/tele_ignored.cpp
@@ -119,6 +119,16 @@ void RefreshData(const State &state) {
 	}
 }
 
+void RefreshSizes(const State &state) {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	for (const auto &view : state.views) {
+		items.emplace(view->data());
+	}
+	for (const auto &item : items) {
+		item->history()->owner().requestItemResize(item);
+	}
+}
+
 State::State() {
 	IgnoredListValue(
 	) | rpl::on_next([=](const QString &value) {
@@ -148,6 +158,11 @@ State::State() {
 	) | rpl::skip(1) | rpl::on_next([=] {
 		RefreshData(*this);
 	}, lifetime);
+
+	HideBubbleTailsChanges(
+	) | rpl::on_next([=] {
+		RefreshSizes(*this);
+	}, lifetime);
 }
 
 [[nodiscard]] bool Applies(Context context) {
