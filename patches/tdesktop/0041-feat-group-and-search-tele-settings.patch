+void TeleSection::sectionRestoreState(const std::any &state) {
+	const auto saved = std::any_cast<TeleSearchState>(&state);
+	if (!saved || saved->query.isEmpty()) {
+		return;
+	} else if (_searchField) {
+		_searchField->setText(saved->query);
+	} else {
+		_pendingQuery = saved->query;
+	}
