+[[nodiscard]] not_null<Button*> AddResultButton(
+		not_null<Ui::VerticalLayout*> list,
+		const QString &title,
+		const QString &subtitle,
+		const style::icon *icon) {
+	const auto &st = st::settingsSearchResult;
+	const auto button = list->add(CreateButtonWithIcon(
+		list,
+		rpl::single(title),
+		st,
+		{ icon }));
+	const auto details = Ui::CreateChild<Ui::FlatLabel>(
+		button,
+		subtitle,
+		st::settingsSearchResultDetails);
+	details->show();
+	details->moveToLeft(
+		st.padding.left(),
+		st.padding.top() + st.height - details->height());
+	details->setAttribute(Qt::WA_TransparentForMouseEvents);
+	return button;
+}
