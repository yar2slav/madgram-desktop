+[[nodiscard]] RotationFlow PhraseUpdateRotationFlow(
+		std::shared_ptr<Main::SessionShow> show) {
+	return {
+		.confirmed = [=](base::weak_qptr<Ui::GenericBox>, KeyAuthorization) {
+			LOG(("Wallet Info: secret phrase update confirmed."));
+			show->showToast({
+				.text = { Tele::Lower(u"Your secret phrase was updated."_q) },
+				.icon = &st::toastCheckIcon,
+			});
+		},
+		.dismissTitle = [] {
+			return rpl::single(
+				Tele::Lower(u"Cancel Updating Secret Phrase?"_q));
+		},
+	};
+}
+
+void ShowPhraseUpdateBox(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<Ui::GenericBox*> origin,
+		not_null<bool*> busy,
+		int64 feeNano,
+		KeyAuthorization auth) {
+	const auto weak = base::make_weak(origin);
+	show->showBox(Ui::MakeConfirmBox({
+		.text = BackupUpdateNoteText(
+			&show->session(),
+			rpl::single(std::make_optional(RotationQuote{
+				.feeNano = feeNano,
+			}))),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			if (const auto strong = weak.get()) {
+				StartRotation(
+					show,
+					strong,
+					busy,
+					feeNano,
+					auth,
+					PhraseUpdateRotationFlow(show));
+			}
+		},
+		.confirmText = tr::lng_continue(),
+		.title = tr::lng_wallet_backup_update_check(),
+	}));
+}
+
+void StartPhraseUpdate(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<Ui::GenericBox*> origin,
+		not_null<bool*> busy) {
+	const auto weak = base::make_weak(origin);
+	AcquireVaultUnlock({
+		.show = show,
+		.done = [=](KeyAuthorization auth) {
+			const auto strong = weak.get();
+			if (!strong || !auth.valid() || *busy) {
+				return;
+			}
+			auto &wallet = show->session().wallet();
+			if (!wallet.rotationOffered()) {
+				const auto changing = (wallet.tonConnectAccess()
+					== TonConnectAccess::KeyChanging);
+				LOG(("Wallet Info: secret phrase update not offered, "
+					"key changing: %1.").arg(changing ? u"yes"_q : u"no"_q));
+				if (changing) {
+					show->showToast(
+						tr::lng_wallet_import_key_changing(tr::now));
+				} else {
+					ShowRotationFailedToast(show, QString());
+				}
+				return;
+			}
+			*busy = true;
+			wallet.quoteRotationFee(auth, crl::guard(strong, [=](
+					FeeResult fee) {
+				*busy = false;
+				LOG(("Wallet Info: secret phrase update quote, "
+					"error %1, fee %2.").arg(int(fee.error)).arg(fee.feeNano));
+				if (fee.error == SendError::None) {
+					ShowPhraseUpdateBox(show, strong, busy, fee.feeNano, auth);
+				} else if (fee.error == SendError::InsufficientFees) {
+					ShowBackupTopUpAlert(show, fee.feeNano, [] {});
+				} else {
+					ShowRotationFailedToast(show, (fee.error == SendError::Locked)
+						? u"ROTATION_VAULT_LOCKED"_q
+						: (fee.error == SendError::AlreadySending)
+						? u"ROTATION_ALREADY_SENDING"_q
+						: QString());
+				}
+			}));
+		},
+	});
+}
