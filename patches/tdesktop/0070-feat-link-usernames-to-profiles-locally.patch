+
+UsernameAliasesController::UsernameAliasesController(
+	not_null<Window::SessionController*> window)
+: _window(window) {
+}
+
+Main::Session &UsernameAliasesController::session() const {
+	return _window->session();
+}
+
+void UsernameAliasesController::prepare() {
+	delegate()->peerListSetTitle(
+		rpl::single(::Tele::Lower(u"Username aliases"_q)));
+	::Tele::UsernameAliasesChanges(
+	) | rpl::on_next([=] {
+		refreshRows();
+	}, lifetime());
+	refreshRows();
+}
+
+void UsernameAliasesController::refreshRows() {
+	const auto aliases = ::Tele::UsernameAliases(&session());
+	auto keep = base::flat_set<PeerListRowId>();
+	for (const auto &entry : aliases) {
+		const auto key = std::make_pair(entry.alias, entry.id);
+		if (!_ids.contains(key)) {
+			_ids.emplace(key, PeerListRowId(_ids.size() + 1));
+		}
+		keep.emplace(_ids[key]);
+	}
+	for (auto i = delegate()->peerListFullRowsCount(); i != 0;) {
+		const auto row = delegate()->peerListRowAt(--i);
+		if (!keep.contains(row->id())) {
+			delegate()->peerListRemoveRow(row);
+		}
+	}
+	for (const auto &entry : aliases) {
+		const auto id = _ids[std::make_pair(entry.alias, entry.id)];
+		if (delegate()->peerListFindRow(id)) {
+			continue;
+		}
+		const auto peer = session().data().peer(entry.id);
+		auto row = std::make_unique<UsernameAliasRow>(peer, id, entry.alias);
+		row->setActionLink(::Tele::Lower(u"Remove"_q));
+		row->setCustomStatus(peer->isMinimalLoaded()
+			? peer->name()
+			: ::Tele::Lower(u"Unknown chat"_q));
+		delegate()->peerListAppendRow(std::move(row));
+	}
+	setDescriptionText(aliases.empty()
+		? ::Tele::Lower(u"No aliases yet. Pick Add alias in a chat's "
+			"menu."_q)
+		: QString());
+	delegate()->peerListRefreshRows();
+}
+
+void UsernameAliasesController::rowClicked(not_null<PeerListRow*> row) {
+	const auto peer = row->peer();
+	if (!peer->isMinimalLoaded()) {
+		return;
+	}
+	const auto window = _window;
+	crl::on_main(window, [=] {
+		window->showPeerInfo(peer);
+	});
+}
+
+void UsernameAliasesController::rowRightActionClicked(
+		not_null<PeerListRow*> row) {
+	const auto alias = static_cast<UsernameAliasRow*>(row.get())->alias();
+	const auto session = &this->session();
+	crl::on_main(_window, [=] {
+		::Tele::RemoveUsernameAlias(session, alias);
+	});
+}
+
+void ShowUsernameAliasesBox(not_null<Window::SessionController*> window) {
+	auto initBox = [=](not_null<PeerListBox*> box) {
+		box->addButton(tr::lng_close(), [=] {
