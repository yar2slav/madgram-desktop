+
+void RemoveUsernameAlias(
+		not_null<Main::Session*> session,
+		const QString &alias) {
+	auto map = SessionMap(session);
+	if (map.remove(alias)) {
+		Save(session, std::move(map));
+	}
+}
+
+void AddUsernameAliasAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer) {
+		return;
+	}
+	const auto weak = base::make_weak(controller);
+	addAction(Lower(u"Add alias"_q) + QChar(0x2026), [=] {
+		if (const auto strong = weak.get()) {
+			strong->show(Box(AliasBox, not_null(peer)));
+		}
+	}, &st::menuIconUsername);
+}
+
+bool ResolveUsernameAlias(
+		not_null<Window::SessionNavigation*> navigation,
+		const QString &username,
+		const Fn<void(not_null<PeerData*>)> &done) {
+	if (SkipAliases) {
+		return false;
+	}
+	const auto session = &navigation->session();
+	const auto id = AliasPeerId(session, username);
+	if (!id) {
+		return false;
+	} else if (const auto peer = LoadedPeer(session, id)) {
+		done(peer);
+	} else {
+		navigation->showToast('@'
+			+ username.toLower()
+			+ Lower(u" links to a chat that isn't loaded yet."_q));
+	}
+	return true;
+}
+
+void AddOpenRealUsernameAction(
+		not_null<Ui::PopupMenu*> menu,
+		const std::shared_ptr<Main::SessionShow> &show,
+		const std::shared_ptr<ClickHandler> &link) {
+	if (!link || !show) {
+		return;
+	}
+	const auto session = &show->session();
+	const auto username = LinkUsername(link);
+	if (username.isEmpty() || !AliasPeerId(session, username)) {
+		return;
+	}
+	const auto weak = base::make_weak(session->tryResolveWindow());
+	menu->addAction(Lower(u"Open the real "_q) + '@' + username, [=] {
+		SkipAliases = true;
+		link->onClick({
+			Qt::LeftButton,
+			QVariant::fromValue(ClickHandlerContext{
+				.sessionWindow = weak,
+			}),
+		});
+		SkipAliases = false;
+	}, &st::menuIconUsername);
+}
+
+std::vector<UsernameAliasMention> UsernameAliasMentions(
+		not_null<Main::Session*> session,
+		const QString &filter) {
+	auto result = std::vector<UsernameAliasMention>();
+	if (filter.isEmpty()) {
+		return result;
+	}
+	const auto query = filter.toLower();
+	for (const auto &[alias, id] : SessionMap(session)) {
+		if (alias.size() <= query.size()
+			|| !TextUtilities::RemoveAccents(alias).toLower().startsWith(
+				query)) {
+			continue;
+		}
+		const auto peer = LoadedPeer(session, id);
+		if (const auto user = peer ? peer->asUser() : nullptr) {
+			result.push_back({ alias, not_null(user) });
+		}
+	}
+	return result;
+}
+
+void ReplaceUsernameAliases(
+		not_null<History*> history,
+		TextWithEntities &text) {
+	const auto session = &history->session();
+	const auto &map = SessionMap(session);
+	if (map.empty()) {
+		return;
+	}
+	auto replaced = std::vector<std::pair<QString, QString>>();
+	auto position = 0;
+	while (true) {
+		const auto from = int(text.text.indexOf('@', position));
+		if (from < 0) {
+			break;
+		}
+		auto till = from + 1;
+		while (till < text.text.size() && IsAliasChar(text.text[till])) {
+			++till;
+		}
+		position = till;
+		const auto length = till - from - 1;
+		if (!length || length > kMaxAliasLength) {
+			continue;
+		} else if (from > 0) {
+			const auto previous = text.text.at(from - 1);
+			if (previous.isLetterOrNumber()
+				|| previous == '_'
+				|| previous == '@') {
+				continue;
+			}
+		}
+		const auto alias = text.text.mid(from + 1, length).toLower();
+		const auto i = map.find(alias);
+		if (i == end(map)) {
+			continue;
+		}
+		const auto mention = ReplaceableMention(text.entities, from, till);
+		if (!mention) {
+			continue;
+		}
+		const auto peer = LoadedPeer(session, i->second);
+		const auto username = peer ? PublicUsername(peer) : QString();
+		const auto user = peer ? peer->asUser() : nullptr;
+		auto value = QString();
+		auto mentionName = QString();
+		if (!username.isEmpty()) {
+			value = '@' + username;
+		} else if (user) {
+			value = user->firstName.isEmpty()
+				? user->name()
+				: user->firstName;
+			mentionName = TextUtilities::MentionNameDataFromFields({
+				.selfId = session->userId().bare,
+				.userId = peerToUser(user->id).bare,
+				.accessHash = user->accessHash(),
+			});
+		}
+		if (!value.isEmpty()) {
+			ReplaceToken(text, from, till, value, *mention, mentionName);
+			position = from + int(value.size());
+		}
+		if (!ranges::contains(
+				replaced,
+				alias,
+				&std::pair<QString, QString>::first)) {
+			replaced.emplace_back(alias, value);
+		}
+	}
+	if (!replaced.empty()) {
+		ShowReplacedToast(history, replaced);
+	}
+}
