+namespace Tele {
+namespace {
+
+constexpr auto kChannelShift = int64(1000000000000LL);
+constexpr auto kMaxAliasLength = 32;
+
+using Map = base::flat_map<QString, PeerId>;
+
+struct State {
+	State();
+
+	Map production;
+	Map test;
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+};
+
+bool SkipAliases = false;
+
+[[nodiscard]] PeerId ParseBotApiId(const QString &text) {
+	auto ok = false;
+	const auto id = text.toLongLong(&ok);
+	if (!ok || !id) {
+		return PeerId();
+	} else if (id > 0) {
+		return peerFromUser(UserId(uint64(id)));
+	} else if (id > -kChannelShift) {
+		return peerFromChat(ChatId(uint64(-id)));
+	}
+	return peerFromChannel(ChannelId(uint64(-id - kChannelShift)));
+}
+
+[[nodiscard]] QString BotApiId(PeerId id) {
+	const auto bare = int64(id.value & PeerId::kChatTypeMask);
+	return QString::number(peerIsChat(id)
+		? -bare
+		: peerIsChannel(id)
+		? -(kChannelShift + bare)
+		: bare);
+}
+
+[[nodiscard]] bool IsAliasChar(QChar ch) {
+	return ch.isLetterOrNumber() || (ch == '_');
+}
+
+[[nodiscard]] bool IsValidAlias(const QString &alias) {
+	if (alias.isEmpty() || alias.size() > kMaxAliasLength) {
+		return false;
+	}
+	for (const auto ch : alias) {
+		if (!IsAliasChar(ch)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString NormalizeAlias(QString alias) {
+	alias = alias.trimmed();
+	while (alias.startsWith('@')) {
+		alias = alias.mid(1);
+	}
+	return alias.toLower();
+}
+
+void Parse(const QString &value, Map &production, Map &test) {
+	production.clear();
+	test.clear();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto entry = part.trimmed();
+		const auto isTest = entry.startsWith(u"test:"_q);
+		if (isTest) {
+			entry = entry.mid(5);
+		}
+		const auto pair = entry.split(QChar('='));
+		if (pair.size() != 2) {
+			continue;
+		}
+		const auto alias = pair[0].trimmed().toLower();
+		const auto id = ParseBotApiId(pair[1].trimmed());
+		if (id && IsValidAlias(alias)) {
+			(isTest ? test : production)[alias] = id;
+		}
+	}
+}
+
+[[nodiscard]] QString Serialize(const Map &production, const Map &test) {
+	auto list = QStringList();
+	list.reserve(int(production.size() + test.size()));
+	for (const auto &[alias, id] : production) {
+		list.push_back(alias + '=' + BotApiId(id));
+	}
+	for (const auto &[alias, id] : test) {
+		list.push_back(u"test:"_q + alias + '=' + BotApiId(id));
+	}
+	return list.join(QChar(','));
+}
+
+State::State() {
+	UsernameAliasesValue(
+	) | rpl::on_next([=](const QString &value) {
+		Parse(value, production, test);
+		changes.fire({});
+	}, lifetime);
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
