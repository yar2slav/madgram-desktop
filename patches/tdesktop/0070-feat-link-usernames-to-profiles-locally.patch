+[[nodiscard]] const Map &SessionMap(not_null<Main::Session*> session) {
+	auto &state = Get();
+	return session->isTestMode() ? state.test : state.production;
+}
+
+void Save(not_null<Main::Session*> session, Map map) {
+	auto &state = Get();
+	SetUsernameAliases(session->isTestMode()
+		? Serialize(state.production, map)
+		: Serialize(map, state.test));
+}
+
+[[nodiscard]] PeerId AliasPeerId(
+		not_null<Main::Session*> session,
+		const QString &alias) {
+	const auto &map = SessionMap(session);
+	if (map.empty()) {
+		return PeerId();
+	}
+	const auto i = map.find(alias.toLower());
+	return (i != end(map)) ? i->second : PeerId();
+}
+
+[[nodiscard]] PeerData *LoadedPeer(
+		not_null<Main::Session*> session,
+		PeerId id) {
+	const auto peer = session->data().peerLoaded(id);
+	return (peer && peer->isMinimalLoaded()) ? peer : nullptr;
+}
+
+[[nodiscard]] QString LinkUsername(const std::shared_ptr<ClickHandler> &link) {
+	const auto url = link->url();
+	if (link->getTextEntity().type == EntityType::Mention) {
+		return url.startsWith('@') ? url.mid(1) : QString();
+	}
+	const auto local = Core::TryConvertUrlToLocal(url);
+	const auto prefix = u"tg://resolve?"_q;
+	if (!local.startsWith(prefix, Qt::CaseInsensitive)) {
+		return QString();
+	}
+	return QUrlQuery(local.mid(prefix.size())).queryItemValue(u"domain"_q);
+}
+
+[[nodiscard]] QString PublicUsername(not_null<PeerData*> peer) {
+	const auto &usernames = peer->usernames();
+	return usernames.empty() ? peer->username() : usernames.front();
+}
+
+[[nodiscard]] bool KeepsText(EntityType type) {
+	return (type == EntityType::Code)
+		|| (type == EntityType::Pre)
+		|| (type == EntityType::Url)
+		|| (type == EntityType::CustomUrl)
+		|| (type == EntityType::Email)
+		|| (type == EntityType::MentionName)
+		|| (type == EntityType::Hashtag)
+		|| (type == EntityType::Cashtag)
+		|| (type == EntityType::BotCommand)
+		|| (type == EntityType::CustomEmoji);
+}
+
+[[nodiscard]] std::optional<int> ReplaceableMention(
+		const EntitiesInText &entities,
+		int from,
+		int till) {
+	auto result = -1;
+	for (auto i = 0, count = int(entities.size()); i != count; ++i) {
+		const auto &entity = entities[i];
+		const auto start = entity.offset();
+		const auto end = start + entity.length();
+		if (end <= from || start >= till) {
+			continue;
+		} else if (KeepsText(entity.type())) {
+			return std::nullopt;
+		} else if (entity.type() == EntityType::Mention) {
+			if (start != from || end != till) {
+				return std::nullopt;
+			}
+			result = i;
+		} else if (start > from || end < till) {
+			return std::nullopt;
+		}
+	}
+	return result;
+}
+
+void ReplaceToken(
+		TextWithEntities &text,
+		int from,
+		int till,
+		const QString &value,
+		int mention,
+		const QString &mentionName) {
+	const auto delta = int(value.size()) - (till - from);
+	text.text.replace(from, till - from, value);
+	auto &entities = text.entities;
+	for (auto &entity : entities) {
+		const auto start = entity.offset();
+		const auto length = entity.length();
+		if (start >= till) {
+			entity = EntityInText(
+				entity.type(),
+				start + delta,
+				length,
+				entity.data());
+		} else if (start <= from && start + length >= till) {
+			entity = EntityInText(
+				entity.type(),
+				start,
+				length + delta,
+				entity.data());
+		}
+	}
+	if (mentionName.isEmpty()) {
+		return;
+	} else if (mention >= 0) {
+		entities.erase(entities.begin() + mention);
+	}
+	const auto position = ranges::find_if(entities, [&](
+			const EntityInText &entity) {
+		return entity.offset() > from;
+	});
+	entities.insert(position, EntityInText(
+		EntityType::MentionName,
+		from,
+		int(value.size()),
+		mentionName));
+}
+
+void ShowReplacedToast(
+		not_null<History*> history,
+		const std::vector<std::pair<QString, QString>> &replaced) {
+	auto done = QStringList();
+	auto skipped = QStringList();
+	for (const auto &[alias, value] : replaced) {
+		if (value.isEmpty()) {
+			skipped.push_back('@' + alias);
+		} else {
+			done.push_back('@' + alias + ' ' + QChar(0x2192) + ' ' + value);
+		}
+	}
+	auto message = done.join(u", "_q);
+	if (!skipped.isEmpty()) {
+		if (!message.isEmpty()) {
+			message += u"; "_q;
+		}
+		message += Lower(u"Not replaced: "_q) + skipped.join(u", "_q);
+	}
+	const auto session = &history->session();
+	if (const auto window = session->tryResolveWindow(history->peer)) {
+		window->showToast(message);
+	}
+}
+
+void AliasBox(not_null<Ui::GenericBox*> box, not_null<PeerData*> peer) {
+	const auto session = &peer->session();
+	box->setTitle(rpl::single(Lower(u"Alias for "_q) + peer->name()));
+	const auto wrap = box->addRow(object_ptr<Ui::RpWidget>(box));
+	const auto field = Ui::CreateChild<Ui::InputField>(
+		wrap,
+		st::setupChannelLink,
+		Ui::InputField::Mode::SingleLine,
+		nullptr,
+		QString());
+	field->setMaxLength(kMaxAliasLength);
+	const auto &font = st::setupChannelLink.style.font;
+	const auto prefix = u"@"_q;
+	field->setAdditionalMargins({ font->width(prefix), 0, 0, 0 });
+	const auto at = Ui::CreateChild<Ui::RpWidget>(field);
+	at->setAttribute(Qt::WA_TransparentForMouseEvents);
+	field->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		const auto margins = field->fullTextMargins();
+		at->setGeometry(
+			margins.left() - font->width(prefix),
+			0,
+			font->width(prefix),
+			size.height());
+		at->raise();
+	}, at->lifetime());
+	at->paintRequest(
+	) | rpl::on_next([=] {
+		auto p = QPainter(at);
+		const auto &st = st::setupChannelLink;
+		const auto line = std::max(st.style.lineHeight, font->height);
+		const auto ascent = line * 4. / 5.
+			- std::max(font->fleading.toReal(), 0.);
+		p.setFont(font);
+		p.setPen(st.placeholderFg);
+		p.drawText(
+			QPointF(0., field->fullTextMargins().top() + ascent),
+			prefix);
+	}, at->lifetime());
+	wrap->widthValue(
+	) | rpl::on_next([=](int width) {
+		field->resize(width, field->height());
+		field->moveToLeft(0, 0, width);
+	}, field->lifetime());
+	field->heightValue(
+	) | rpl::on_next([=](int height) {
+		wrap->resize(wrap->width(), height);
+	}, field->lifetime());
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Mentions of this alias will open this profile. Only you "
+			"see it."_q),
+		st::boxDividerLabel));
+	const auto save = [=] {
+		const auto alias = NormalizeAlias(field->getLastText());
+		if (!IsValidAlias(alias)) {
+			field->showError();
+			box->showToast(Lower(
+				u"Use 1-32 letters, digits or underscores."_q));
+			return;
+		}
+		auto map = SessionMap(session);
+		if (const auto i = map.find(alias); i != end(map)) {
+			if (i->second != peer->id) {
+				const auto other = session->data().peerLoaded(i->second);
+				field->showError();
+				box->showToast('@'
+					+ alias
+					+ Lower(u" already links to "_q)
+					+ ((other && other->isMinimalLoaded())
+						? other->name()
+						: Lower(u"another chat"_q)));
+				return;
+			}
+		} else {
+			map.emplace(alias, peer->id);
+			Save(session, std::move(map));
+		}
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(rpl::single(Lower(u"Add"_q)), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
