 }
 
 void BuildInterfaceScale(SectionBuilder &builder) {
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..56e5327dc7f466f2f5c3216565593299a91b69d1
--- /dev/null
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -0,0 +1,69 @@
+#include "settings/settings_tele.h"
+
+#include "core/version.h"
+#include "settings/settings_builder.h"
+#include "settings/settings_common_session.h"
+#include "tele/tele_build.h"
+#include "ui/vertical_list.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_settings.h"
+
+namespace Settings {
+namespace {
+
+class TeleSection final : public Section<TeleSection> {
+public:
+	TeleSection(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller);
+
+	[[nodiscard]] rpl::producer<QString> title() override;
+
+private:
+	void setupContent();
+
+};
+
+TeleSection::TeleSection(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: Section(parent, controller) {
+	setupContent();
+}
+
+rpl::producer<QString> TeleSection::title() {
+	return rpl::single(u"tele"_q);
+}
+
+void TeleSection::setupContent() {
+	const auto content = Ui::CreateChild<Ui::VerticalLayout>(this);
+
+	Ui::AddDividerText(
+		content,
+		rpl::single(u"Telegram Desktop %1 with tele patches, build %2."_q.arg(
+			QString::fromLatin1(AppVersionStr),
+			::Tele::TitleLabel())));
+
+	Ui::ResizeFitChild(this, content);
+}
+
+} // namespace
+
+Type TeleId() {
+	return TeleSection::Id();
+}
+
+void AddTeleSectionButton(Builder::SectionBuilder &builder) {
+	builder.addSkip();
+	builder.addDivider();
+	builder.addSkip();
+	builder.addSectionButton({
+		.title = rpl::single(u"tele"_q),
+		.targetSection = TeleId(),
+		.icon = { &st::menuIconCustomize },
+		.keywords = { u"tele"_q, u"fork"_q },
+	});
+}
+
+} // namespace Settings
diff --git a/Telegram/SourceFiles/settings/settings_tele.h b/Telegram/SourceFiles/settings/settings_tele.h
new file mode 100644
index 0000000000000000000000000000000000000000..729bad1f2234157137cc69718f23b0f7ca97bd0c
--- /dev/null
+++ b/Telegram/SourceFiles/settings/settings_tele.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include "settings/settings_type.h"
+
+namespace Settings::Builder {
+class SectionBuilder;
+} // namespace Settings::Builder
+
+namespace Settings {
+
+[[nodiscard]] Type TeleId();
+void AddTeleSectionButton(Builder::SectionBuilder &builder);
+
+} // namespace Settings
