 #include "ui/widgets/menu/menu_action.h"
@@ -227,4 +230,23 @@ void AddCopyFilePathAction(
 	}, &st::menuIconCopy);
 }
 
+bool AddCopyServiceTextAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<const HistoryView::Element*> view,
+		Fn<bool()> showCopyRestriction) {
+	if (!view->data()->isService()) {
+		return false;
+	}
+	const auto text = view->selectedText(FullSelection);
+	if (text.empty()) {
+		return false;
+	}
+	menu->addAction(tr::lng_context_copy_text(tr::now), [=] {
+		if (!showCopyRestriction()) {
+			TextUtilities::SetClipboardText(text);
+		}
+	}, &st::menuIconCopy);
+	return true;
+}
+
 } // namespace Tele
