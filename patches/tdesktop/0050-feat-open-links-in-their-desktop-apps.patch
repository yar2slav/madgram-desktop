+#include "tele/tele_app_links.h"
+
+#include "base/flat_map.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QUrlQuery>
+#include <QtGui/QDesktopServices>
+
+#ifdef Q_OS_WIN
+#include <windows.h>
+#elif defined Q_OS_MAC
+#include <CoreServices/CoreServices.h>
+#else
+#include <gio/gio.h>
+#endif
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool IsAlnum(QChar ch) {
+	return (ch >= 'a' && ch <= 'z')
+		|| (ch >= 'A' && ch <= 'Z')
+		|| (ch >= '0' && ch <= '9');
+}
+
+[[nodiscard]] bool IsId(const QString &value) {
+	return !value.isEmpty() && ranges::all_of(value, IsAlnum);
+}
+
+[[nodiscard]] bool IsNumber(const QString &value) {
+	return !value.isEmpty() && ranges::all_of(value, [](QChar ch) {
+		return (ch >= '0' && ch <= '9');
+	});
+}
+
+[[nodiscard]] bool IsSlug(const QString &value) {
+	return !value.isEmpty() && ranges::all_of(value, [](QChar ch) {
+		return IsAlnum(ch) || (ch == '-') || (ch == '_');
+	});
+}
+
+[[nodiscard]] bool IsSubdomainOf(const QString &host, const QString &domain) {
+	return (host == domain) || host.endsWith('.' + domain);
+}
+
+[[nodiscard]] QUrl SpotifyUrl(QStringList parts) {
+	static const auto kTypes = QStringList{
+		u"track"_q,
+		u"album"_q,
+		u"playlist"_q,
+		u"artist"_q,
+		u"episode"_q,
+		u"show"_q,
+	};
+	if (!parts.isEmpty() && parts.front().startsWith(u"intl-"_q)) {
+		parts.pop_front();
+	}
+	if (parts.size() != 2
+		|| !kTypes.contains(parts[0])
+		|| !IsId(parts[1])) {
+		return QUrl();
+	}
+	return QUrl(u"spotify:%1:%2"_q.arg(parts[0], parts[1]));
+}
+
+[[nodiscard]] QUrl SteamUrl(const QUrl &url) {
+	return QUrl(u"steam://openurl/"_q
+		+ QString::fromUtf8(url.toEncoded()));
+}
+
+[[nodiscard]] QUrl DiscordUrl(const QString &host, const QStringList &parts) {
+	const auto make = [](const QStringList &path) {
+		return QUrl(u"discord://discord.com/"_q + path.join('/'));
+	};
+	if (host == u"discord.gg"_q) {
+		return (parts.size() == 1 && IsSlug(parts[0]))
+			? make({ u"invite"_q, parts[0] })
+			: QUrl();
+	}
+	if (parts.size() == 2
+		&& parts[0] == u"invite"_q
+		&& IsSlug(parts[1])) {
+		return make(parts);
+	}
+	if (parts.size() < 2
+		|| parts.size() > 4
+		|| parts[0] != u"channels"_q
+		|| (parts[1] != u"@me"_q && !IsNumber(parts[1]))) {
+		return QUrl();
+	}
+	for (auto i = 2; i != parts.size(); ++i) {
+		if (!IsNumber(parts[i])) {
+			return QUrl();
+		}
+	}
+	return make(parts);
+}
+
+[[nodiscard]] QUrl ZoomUrl(
+		const QUrl &url,
+		const QString &host,
+		const QStringList &parts) {
+	if (parts.size() != 2 || parts[0] != u"j"_q || !IsNumber(parts[1])) {
+		return QUrl();
+	}
+	const auto password = QUrlQuery(url).queryItemValue(
+		u"pwd"_q,
+		QUrl::FullyEncoded);
+	return QUrl(u"zoommtg://%1/join?action=join&confno=%2"_q.arg(
+		host,
+		parts[1]) + (password.isEmpty() ? QString() : u"&pwd="_q + password));
+}
+
+[[nodiscard]] QUrl SlackUrl(const QStringList &parts) {
+	if (parts.size() < 2
+		|| parts.size() > 3
+		|| parts[0] != u"client"_q
+		|| !IsId(parts[1])
+		|| (parts.size() == 3 && !IsId(parts[2]))) {
+		return QUrl();
+	}
+	return QUrl((parts.size() == 3)
+		? u"slack://channel?team=%1&id=%2"_q.arg(parts[1], parts[2])
+		: u"slack://open?team=%1"_q.arg(parts[1]));
+}
+
+[[nodiscard]] QUrl EpicUrl(const QString &host, QStringList parts) {
+	const auto prefix = u"com.epicgames.launcher://store/"_q;
+	if (host == u"store.epicgames.com"_q) {
+		if (parts.size() > 2 && parts[0] != u"p"_q) {
+			parts.pop_front();
+		}
+		return (parts.size() == 2 && parts[0] == u"p"_q && IsSlug(parts[1]))
+			? QUrl(prefix + u"p/"_q + parts[1])
+			: QUrl();
+	}
+	if (parts.isEmpty() || parts[0] != u"store"_q) {
+		return QUrl();
+	}
+	parts.pop_front();
+	if (parts.size() > 2 && parts[0] != u"product"_q) {
+		parts.pop_front();
+	}
+	return (parts.size() >= 2 && parts[0] == u"product"_q && IsSlug(parts[1]))
+		? QUrl(prefix + u"product/"_q + parts[1])
+		: QUrl();
+}
+
+[[nodiscard]] QUrl WithScheme(QUrl url, const QString &scheme) {
+	url.setScheme(scheme);
+	return url;
+}
+
+[[nodiscard]] QUrl AppUrl(const QUrl &url) {
+	const auto scheme = url.scheme().toLower();
+	if (scheme != u"https"_q && scheme != u"http"_q) {
+		return QUrl();
+	}
+	const auto host = url.host().toLower();
+	const auto parts = url.path().split('/', Qt::SkipEmptyParts);
+	if (host == u"open.spotify.com"_q) {
+		return SpotifyUrl(parts);
+	} else if (host == u"store.steampowered.com"_q
+		|| host == u"steamcommunity.com"_q) {
+		return SteamUrl(url);
+	} else if (host == u"discord.gg"_q
+		|| host == u"discord.com"_q
+		|| host == u"www.discord.com"_q
+		|| host == u"ptb.discord.com"_q
+		|| host == u"canary.discord.com"_q
+		|| host == u"discordapp.com"_q
+		|| host == u"www.discordapp.com"_q) {
+		return DiscordUrl(host, parts);
+	} else if (IsSubdomainOf(host, u"zoom.us"_q)) {
+		return ZoomUrl(url, host, parts);
+	} else if (host == u"teams.microsoft.com"_q) {
+		return (!parts.isEmpty() && parts[0] == u"l"_q)
+			? WithScheme(url, u"msteams"_q)
+			: QUrl();
+	} else if (host == u"notion.so"_q
+		|| host == u"www.notion.so"_q
+		|| host == u"notion.com"_q
+		|| host == u"www.notion.com"_q) {
+		if (parts.isEmpty()) {
+			return QUrl();
+		}
+		auto result = WithScheme(url, u"notion"_q);
+		result.setHost(u"www.notion.so"_q);
+		return result;
+	} else if (host == u"app.slack.com"_q) {
+		return SlackUrl(parts);
+	} else if (host == u"store.epicgames.com"_q
+		|| host == u"www.epicgames.com"_q) {
+		return EpicUrl(host, parts);
+	}
+	return QUrl();
+}
+
+[[nodiscard]] bool LookupHandler(const QString &scheme) {
+#ifdef Q_OS_WIN
+	auto key = HKEY();
+	const auto path = scheme.toStdWString();
+	if (RegOpenKeyExW(
+			HKEY_CLASSES_ROOT,
+			path.c_str(),
+			0,
+			KEY_READ,
+			&key) != ERROR_SUCCESS) {
+		return false;
+	}
+	const auto result = (RegQueryValueExW(
+		key,
+		L"URL Protocol",
+		nullptr,
+		nullptr,
+		nullptr,
+		nullptr) == ERROR_SUCCESS);
+	RegCloseKey(key);
+	return result;
+#elif defined Q_OS_MAC
+	const auto bytes = (scheme + ':').toUtf8();
+	const auto url = CFURLCreateWithBytes(
+		kCFAllocatorDefault,
+		reinterpret_cast<const UInt8*>(bytes.constData()),
+		bytes.size(),
+		kCFStringEncodingUTF8,
+		nullptr);
+	if (!url) {
+		return false;
+	}
+	const auto app = LSCopyDefaultApplicationURLForURL(
+		url,
+		kLSRolesAll,
+		nullptr);
+	CFRelease(url);
+	if (!app) {
+		return false;
+	}
+	CFRelease(app);
+	return true;
+#else
+	const auto utf = scheme.toUtf8();
+	const auto info = g_app_info_get_default_for_uri_scheme(utf.constData());
+	if (!info) {
+		return false;
+	}
+	g_object_unref(info);
+	return true;
+#endif
+}
+
+[[nodiscard]] bool HasHandler(const QString &scheme) {
+	static auto Cache = base::flat_map<QString, bool>();
+	const auto i = Cache.find(scheme);
+	if (i != end(Cache)) {
+		return i->second;
+	}
+	const auto result = LookupHandler(scheme);
+	Cache.emplace(scheme, result);
+	return result;
+}
+
+} // namespace
+
+bool OpenInApp(const QString &url) {
+	if (!OpenLinksInApps()) {
+		return false;
+	}
+	const auto target = AppUrl(QUrl(url));
+	return target.isValid()
+		&& !target.isEmpty()
+		&& HasHandler(target.scheme())
+		&& QDesktopServices::openUrl(target);
+}
+
+} // namespace Tele
