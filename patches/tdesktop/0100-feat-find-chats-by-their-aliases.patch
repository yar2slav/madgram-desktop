+std::vector<not_null<PeerData*>> UsernameAliasPeers(
+		not_null<Main::Session*> session,
+		const QString &query,
+		bool resolve) {
+	struct Found {
+		QString alias;
+		PeerData *peer = nullptr;
+		bool local = false;
+	};
+	auto result = std::vector<not_null<PeerData*>>();
+	const auto normalized = NormalizeSearchQuery(query);
+	if (normalized.isEmpty()) {
+		return result;
+	}
+	auto found = std::vector<Found>();
+	for (const auto &[alias, id] : SessionMap(session)) {
+		if (AliasMatches(alias, normalized)) {
+			if (const auto peer = LoadedPeer(session, id)) {
+				found.push_back({ alias, peer, true });
+			}
+		}
+	}
+	auto targets = base::flat_map<QString, std::vector<QString>>();
+	if (ServerUsernamesOn(session)) {
+		for (const auto &[alias, username] : Server().targets) {
+			if (AliasMatches(alias, normalized)
+				&& !AliasPeerId(session, alias)) {
+				targets[username.toLower()].push_back(alias);
+			}
+		}
+	}
+	if (!targets.empty()) {
+		auto missing = targets;
+		const auto check = [&](not_null<PeerData*> peer) {
+			if (!peer->isMinimalLoaded()) {
+				return;
+			}
+			auto usernames = peer->usernames();
+			usernames.push_back(peer->username());
+			for (const auto &username : usernames) {
+				const auto lower = username.toLower();
+				const auto i = targets.find(lower);
+				if (i == end(targets) || !missing.remove(lower)) {
+					continue;
+				}
+				for (const auto &alias : i->second) {
+					found.push_back({ alias, peer.get(), false });
+				}
+			}
+		};
+		session->data().enumerateUsers(check);
+		session->data().enumerateGroups(check);
+		session->data().enumerateBroadcasts(check);
+		if (resolve && missing.size() == 1) {
+			ResolveSearchTarget(session, missing.front().first);
+		}
+	}
+	ranges::stable_sort(found, [&](const Found &a, const Found &b) {
+		const auto aExact = (a.alias.size() == normalized.size());
+		const auto bExact = (b.alias.size() == normalized.size());
+		return (aExact != bExact)
+			? aExact
+			: (a.local != b.local)
+			? a.local
+			: (a.alias < b.alias);
+	});
+	for (const auto &entry : found) {
+		const auto peer = not_null(entry.peer);
+		if (!ranges::contains(result, peer)) {
+			result.push_back(peer);
+		}
+	}
+	return result;
+}
+
+rpl::producer<not_null<Main::Session*>> UsernameAliasPeersResolved() {
+	return Resolves().resolved.events();
+}
