+[[nodiscard]] SearchResolves &Resolves() {
+	static auto result = SearchResolves();
+	return result;
+}
+
+[[nodiscard]] QString NormalizeSearchQuery(const QString &query) {
+	auto result = query.trimmed();
+	while (result.startsWith('@')) {
+		result = result.mid(1);
+	}
+	result = TextUtilities::RemoveAccents(result).toLower();
+	return IsValidAlias(result) ? result : QString();
+}
+
+[[nodiscard]] bool AliasMatches(const QString &alias, const QString &query) {
+	return TextUtilities::RemoveAccents(alias).toLower().startsWith(query);
+}
+
+void ResolveSearchTarget(
+		not_null<Main::Session*> session,
+		const QString &username) {
+	const auto key = std::make_pair(session->uniqueId(), username.toLower());
+	if (!Resolves().requested.emplace(key).second) {
+		return;
+	}
+	const auto weak = base::make_weak(session);
+	session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(0),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		const auto &data = result.data();
+		strong->data().processUsers(data.vusers());
+		strong->data().processChats(data.vchats());
+		Resolves().resolved.fire(not_null(strong));
+	}).send();
+}
