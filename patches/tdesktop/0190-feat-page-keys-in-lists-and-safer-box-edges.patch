diff --git a/Telegram/SourceFiles/tele/tele_list_keys.cpp b/Telegram/SourceFiles/tele/tele_list_keys.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..561e346a04687467df10483a40746bbfaf315290
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_list_keys.cpp
@@ -0,0 +1,207 @@
+#include "tele/tele_list_keys.h"
+
+#include "history/view/history_view_list_widget.h"
+#include "tele/tele_options.h"
+#include "ui/layers/layer_widget.h"
+#include "ui/widgets/elastic_scroll.h"
+#include "ui/widgets/scroll_area.h"
+#include "window/section_widget.h"
+
+#include <QtCore/QPointer>
+#include <QtGui/QCursor>
+#include <QtWidgets/QApplication>
+
+namespace Tele {
+namespace {
+
+constexpr auto kEdgeSkip = 24;
+
+class Filter final : public QObject {
+public:
+	using QObject::QObject;
+
+protected:
+	bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+	bool handleKey(not_null<QWidget*> widget, not_null<QKeyEvent*> e);
+	bool handleMouse(not_null<QWidget*> widget, not_null<QMouseEvent*> e);
+
+};
+
+[[nodiscard]] bool IsListKey(not_null<QKeyEvent*> e) {
+	const auto key = e->key();
+	const auto modifiers = e->modifiers()
+		& ~(Qt::KeypadModifier | Qt::GroupSwitchModifier);
+	return (modifiers == Qt::NoModifier)
+		&& (key == Qt::Key_PageUp
+			|| key == Qt::Key_PageDown
+			|| key == Qt::Key_Home
+			|| key == Qt::Key_End);
+}
+
+[[nodiscard]] bool InSection(not_null<QWidget*> widget) {
+	for (auto w = widget->parentWidget(); w; w = w->parentWidget()) {
+		if (dynamic_cast<Window::SectionWidget*>(w)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+template <typename Scroll>
+[[nodiscard]] bool Suitable(not_null<Scroll*> scroll) {
+	return scroll->isVisible()
+		&& (scroll->scrollTopMax() > 0)
+		&& !dynamic_cast<HistoryView::ListWidget*>(scroll->widget());
+}
+
+[[nodiscard]] bool Suitable(not_null<QWidget*> widget, bool section) {
+	if (section && !InSection(widget)) {
+		return false;
+	} else if (const auto area = dynamic_cast<Ui::ScrollArea*>(
+			widget.get())) {
+		return Suitable(not_null(area));
+	} else if (const auto elastic = dynamic_cast<Ui::ElasticScroll*>(
+			widget.get())) {
+		return Suitable(not_null(elastic));
+	}
+	return false;
+}
+
+template <typename Scroll>
+void ScrollByKey(not_null<Scroll*> scroll, int key) {
+	const auto top = scroll->scrollTop();
+	const auto max = scroll->scrollTopMax();
+	const auto page = scroll->height();
+	scroll->scrollToY((key == Qt::Key_Home)
+		? 0
+		: (key == Qt::Key_End)
+		? max
+		: (key == Qt::Key_PageUp)
+		? std::max(top - page, 0)
+		: std::min(top + page, max));
+}
+
+void ScrollByKey(not_null<QWidget*> widget, int key) {
+	if (const auto area = dynamic_cast<Ui::ScrollArea*>(widget.get())) {
+		ScrollByKey(not_null(area), key);
+	} else if (const auto elastic = dynamic_cast<Ui::ElasticScroll*>(
+			widget.get())) {
+		ScrollByKey(not_null(elastic), key);
+	}
+}
+
+[[nodiscard]] QWidget *FindUp(
+		QWidget *from,
+		not_null<QWidget*> bound,
+		bool section) {
+	if (!from || (from != bound && !bound->isAncestorOf(from))) {
+		return nullptr;
+	}
+	for (auto w = from; w; w = w->parentWidget()) {
+		if (Suitable(w, section)) {
+			return w;
+		} else if (w == bound) {
+			break;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] QWidget *FindLargest(not_null<QWidget*> bound) {
+	auto result = (QWidget*)nullptr;
+	for (const auto child : bound->findChildren<QWidget*>()) {
+		if (Suitable(child, false)
+			&& (!result || child->height() > result->height())) {
+			result = child;
+		}
+	}
+	return result;
+}
+
+bool Filter::eventFilter(QObject *watched, QEvent *event) {
+	const auto type = event->type();
+	if (type != QEvent::KeyPress
+		&& type != QEvent::MouseButtonPress
+		&& type != QEvent::MouseButtonDblClick) {
+		return false;
+	}
+	const auto widget = qobject_cast<QWidget*>(watched);
+	if (!widget) {
+		return false;
+	} else if (type == QEvent::KeyPress) {
+		return handleKey(widget, static_cast<QKeyEvent*>(event));
+	}
+	return handleMouse(widget, static_cast<QMouseEvent*>(event));
+}
+
+bool Filter::handleKey(not_null<QWidget*> widget, not_null<QKeyEvent*> e) {
+	if (!IsListKey(e)) {
+		return false;
+	}
+	const auto stack = dynamic_cast<Ui::LayerStackWidget*>(widget.get());
+	const auto layer = stack ? stack->topShownLayer() : nullptr;
+	const auto section = !stack;
+	const auto bound = layer
+		? const_cast<Ui::LayerWidget*>(layer)
+		: section
+		? widget.get()
+		: nullptr;
+	if (!bound || (section && !widget->isWindow())) {
+		return false;
+	}
+	auto scroll = FindUp(
+		QApplication::widgetAt(QCursor::pos()),
+		bound,
+		section);
+	if (!scroll) {
+		scroll = FindUp(QApplication::focusWidget(), bound, section);
+	}
+	if (!scroll && !section) {
+		scroll = FindLargest(bound);
+	}
+	if (!scroll) {
+		return false;
+	}
+	ScrollByKey(scroll, e->key());
+	e->accept();
+	return true;
+}
+
+bool Filter::handleMouse(
+		not_null<QWidget*> widget,
+		not_null<QMouseEvent*> e) {
+	const auto stack = dynamic_cast<Ui::LayerStackWidget*>(widget.get());
+	const auto layer = stack ? stack->topShownLayer() : nullptr;
+	if (!layer || !layer->isVisible()) {
+		return false;
+	}
+	const auto skip = style::ConvertScale(kEdgeSkip);
+	const auto rect = QRect(
+		layer->mapToGlobal(QPoint()),
+		layer->size()
+	).marginsAdded({ skip, skip, skip, skip });
+	if (!rect.contains(e->globalPos())) {
+		return false;
+	}
+	e->accept();
+	return true;
+}
+
+} // namespace
+
+void StartListKeys() {
+	static auto lifetime = rpl::lifetime();
+	static auto filter = QPointer<QObject>();
+	ListKeysValue() | rpl::on_next([](bool enabled) {
+		if (!enabled) {
+			delete filter.data();
+		} else if (!filter) {
+			filter = new Filter(qApp);
+			qApp->installEventFilter(filter);
+		}
+	}, lifetime);
+}
+
+} // namespace Tele
