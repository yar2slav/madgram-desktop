 base::options::toggle StaticUserpicsChatsOption({
 	.id = kOptionStaticUserpicsChats,
 	.name = "Static userpics in chats and profiles",
@@ -1653,6 +1661,16 @@ void SetReduceMotionSaved(const QString &value) {
 	ReduceMotionSavedOption.set(value);
 }
 
+rpl::producer<bool> ListKeysValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		ListKeysOption.changes()
+	) | rpl::map([] {
+		return ListKeysOption.value();
+	});
+}
+
 bool StaticUserpicsChats() {
 	return StaticUserpicsChatsOption.value();
 }
