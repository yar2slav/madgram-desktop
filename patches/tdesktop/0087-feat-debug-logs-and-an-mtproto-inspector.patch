+			return prefix + '{ ' + node.o + ' }';
+		}
+		let result = prefix + '{ ' + node.o + '\n' + spaces(level);
+		node.f.forEach(function (field, index) {
+			if (index) {
+				result += ',\n' + spaces(level);
+			}
+			result += '  ' + field[0] + ': ' + textOf(field[1], level + 1);
+		});
+		return result + ',\n' + spaces(level) + '}';
+	} else if ('v' in node) {
