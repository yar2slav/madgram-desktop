@@ -0,0 +1,302 @@
+#include "tele/tele_mtp_log.h"
+
+#include "tele/tele_debug_logs.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] QFileInfoList LogFiles() {
+	return QDir(DebugLogsFolder()).entryInfoList(
+		{ u"mtp*.txt"_q },
+		QDir::Files,
+		QDir::Time);
+}
+
+[[nodiscard]] QByteArray Finish(std::string &&json) {
+	return QByteArray::fromStdString(json);
+}
+
+[[nodiscard]] const MtpDump::Schema &LoadedSchema() {
+	static const auto result = [] {
+		auto schema = MtpDump::Schema();
+		for (const auto &name : { u"mtproto.tl"_q, u"api.tl"_q }) {
+			auto file = QFile(u":/tele/"_q + name);
+			if (file.open(QIODevice::ReadOnly)) {
+				const auto data = file.readAll();
+				schema.add(std::string_view(data.constData(), data.size()));
+			}
+		}
+		return schema;
+	}();
+	return result;
+}
+
+} // namespace
+
+int CountMtpLogFiles() {
+	return int(LogFiles().size());
+}
+
+void MtpLog::refresh() {
+	if (_loading) {
+		_again = true;
+		return;
+	}
+	const auto files = LogFiles();
+	for (const auto &info : files) {
+		const auto i = _offsets.find(info.fileName());
+		if (i != end(_offsets) && info.size() < i->second) {
+			_entries.clear();
+			_offsets.clear();
+			_lines.clear();
+			_files.clear();
+			_bytes = 0;
+			_trimmed = false;
+			break;
+		}
+	}
+	auto tasks = std::vector<Task>();
+	auto budget = kMaxBytes;
+	for (const auto &info : files) {
+		if (budget <= 0) {
+			break;
+		}
+		const auto name = info.fileName();
+		const auto i = _offsets.find(name);
+		const auto known = (i != end(_offsets));
+		const auto from = known ? i->second : qint64(0);
+		const auto size = info.size();
+		if (size <= from) {
+			continue;
+		}
+		const auto take = std::min(size - from, budget);
+		const auto middle = (size - take != from);
+		const auto lines = _lines.find(name);
+		budget -= take;
+		tasks.push_back({
+			.path = info.absoluteFilePath(),
+			.name = name,
+			.from = size - take,
+			.till = size,
+			.base = middle
+				? qint64(-1)
+				: !known
+				? qint64(0)
+				: (lines != end(_lines))
+				? lines->second
+				: qint64(-1),
+			.middle = middle,
+		});
+	}
+	if (tasks.empty()) {
+		_updates.fire({});
+		return;
+	}
+	ranges::reverse(tasks);
+	_loading = true;
+	const auto generation = _generation;
+	crl::async([=, weak = base::make_weak(this)] {
+		(void)LoadedSchema();
+		auto results = std::vector<Result>();
+		results.reserve(tasks.size());
+		for (const auto &task : tasks) {
+			auto file = QFile(task.path);
+			if (!file.open(QIODevice::ReadOnly) || !file.seek(task.from)) {
+				continue;
+			}
+			const auto data = file.read(task.till - task.from);
+			auto consumed = std::size_t();
+			auto lines = std::size_t();
+			auto entries = MtpDump::SplitEntries(
+				std::string_view(data.constData(), data.size()),
+				task.middle,
+				&consumed,
+				&lines);
+			results.push_back({
+				.name = task.name,
+				.offset = task.from + qint64(consumed),
+				.base = task.base,
+				.lines = qint64(lines),
+				.entries = std::move(entries),
+			});
+		}
+		crl::on_main(weak, [=, results = std::move(results)]() mutable {
+			apply(std::move(results), generation);
+		});
+	});
+}
+
+void MtpLog::reset() {
+	_entries.clear();
+	_offsets.clear();
+	_lines.clear();
+	_files.clear();
+	_bytes = 0;
+	_trimmed = false;
+	++_generation;
+	if (_loading) {
+		_again = true;
+	}
+	_updates.fire({});
+}
+
+void MtpLog::apply(std::vector<Result> results, int generation) {
+	if (generation != _generation) {
+		results.clear();
+	}
+	for (auto &result : results) {
+		_offsets[result.name] = result.offset;
+		_lines[result.name] = (result.base >= 0)
+			? (result.base + result.lines)
+			: qint64(-1);
+		const auto i = ranges::find(_files, result.name);
+		const auto file = int(i - begin(_files));
+		if (i == end(_files)) {
+			_files.push_back(result.name);
+		}
+		for (auto &entry : result.entries) {
+			entry.line = (result.base >= 0)
+				? (result.base + entry.line + 1)
+				: 0;
+			_bytes += qint64(entry.text.size());
+			_entries.push_back({
+				.id = ++_lastId,
+				.file = file,
+				.entry = std::move(entry),
+			});
+		}
+	}
+	while (!_entries.empty()
+		&& (int(_entries.size()) > kMaxEntries || _bytes > kMaxBytes)) {
+		_bytes -= qint64(_entries.front().entry.text.size());
+		_entries.pop_front();
+		_trimmed = true;
+	}
+	_loading = false;
+	if (base::take(_again)) {
+		refresh();
+	} else {
+		_updates.fire({});
+	}
+}
+
+rpl::producer<> MtpLog::updates() const {
+	return _updates.events();
+}
+
+const MtpLog::Stored *MtpLog::find(int id) const {
+	if (_entries.empty() || id < _entries.front().id) {
+		return nullptr;
+	}
+	const auto index = std::size_t(id - _entries.front().id);
+	return (index < _entries.size()) ? &_entries[index] : nullptr;
+}
+
+void MtpLog::appendMatches(
+		std::string &out,
+		const QByteArray &query) const {
+	const auto terms = MtpDump::SplitQuery(
+		std::string_view(query.constData(), query.size()));
+	out += '[';
+	auto first = true;
+	for (auto i = _entries.rbegin(); i != _entries.rend(); ++i) {
+		if (MtpDump::Matches(i->entry, terms)) {
+			if (!first) {
+				out += ',';
+			}
+			first = false;
+			out += std::to_string(i->id);
+		}
+	}
+	out += ']';
+}
+
+QByteArray MtpLog::listJson(const QByteArray &query) const {
+	auto result = std::string();
+	result.reserve(_entries.size() * 128 + 256);
+	auto dcs = base::flat_set<std::string>();
+	result += "{\"entries\":[";
+	auto first = true;
+	for (auto i = _entries.rbegin(); i != _entries.rend(); ++i) {
+		result += first ? "{\"i\":" : ",{\"i\":";
+		first = false;
+		result += std::to_string(i->id);
+		result += ',';
+		MtpDump::AppendSummary(result, i->entry);
+		result += '}';
+		dcs.emplace(i->entry.dc);
+	}
+	result += "],\"dcs\":[";
+	for (auto i = begin(dcs); i != end(dcs); ++i) {
+		if (i != begin(dcs)) {
+			result += ',';
+		}
+		MtpDump::AppendJsonString(result, *i);
+	}
+	result += "],\"files\":";
+	result += std::to_string(_files.size());
+	result += ",\"bytes\":";
+	result += std::to_string(_bytes);
+	result += ",\"maxEntries\":";
+	result += std::to_string(kMaxEntries);
+	result += ",\"maxMb\":";
+	result += std::to_string(kMaxBytes / (1024 * 1024));
+	result += ",\"layer\":";
+	result += std::to_string(MTP::details::kCurrentLayer);
+	result += ",\"last\":";
+	result += std::to_string(_lastId);
+	if (!query.isEmpty()) {
+		result += ",\"query\":";
+		MtpDump::AppendJsonString(
+			result,
+			std::string_view(query.constData(), query.size()));
+		result += ",\"matches\":";
+		appendMatches(result, query);
+	}
+	result += _trimmed ? ",\"trimmed\":true" : ",\"trimmed\":false";
+	result += _loading ? ",\"loading\":true}" : ",\"loading\":false}";
+	return Finish(std::move(result));
+}
+
+QByteArray MtpLog::entryJson(int id) const {
+	const auto stored = find(id);
+	if (!stored) {
+		return "null";
+	}
+	auto result = std::string("{\"i\":");
+	result += std::to_string(stored->id);
+	result += ",\"f\":";
+	MtpDump::AppendJsonString(
+		result,
+		_files[stored->file].toStdString());
+	result += ',';
+	MtpDump::AppendDetail(result, stored->entry, LoadedSchema());
+	result += '}';
+	return Finish(std::move(result));
+}
+
+MtpDump::Serialized MtpLog::serialize(
+		int id,
+		const std::vector<int> &path,
+		bool primary) const {
+	const auto stored = find(id);
+	if (!stored) {
+		return { .error = "this entry is gone" };
+	}
+	return MtpDump::Serialize(LoadedSchema(), stored->entry, path, primary);
+}
+
+QByteArray MtpLog::findJson(const QByteArray &query) const {
+	auto result = std::string("{\"ids\":");
+	appendMatches(result, query);
+	result += ",\"last\":";
+	result += std::to_string(_lastId);
+	result += _loading ? ",\"loading\":true}" : ",\"loading\":false}";
+	return Finish(std::move(result));
+}
+
+} // namespace Tele
