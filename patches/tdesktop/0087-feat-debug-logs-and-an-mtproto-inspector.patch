+#pragma once
+
+#include "base/weak_ptr.h"
+#include "tele/tele_mtp_dump.h"
+
+#include <deque>
+
+namespace Tele {
+
+class MtpLog final : public base::has_weak_ptr {
+public:
+	static constexpr auto kMaxEntries = 20000;
+	static constexpr auto kMaxBytes = qint64(32 * 1024 * 1024);
+
+	void refresh();
+	void reset();
+	[[nodiscard]] rpl::producer<> updates() const;
+
+	[[nodiscard]] QByteArray listJson(const QByteArray &query) const;
+	[[nodiscard]] QByteArray entryJson(int id) const;
+	[[nodiscard]] MtpDump::Serialized serialize(
+		int id,
+		const std::vector<int> &path,
+		bool primary) const;
+	[[nodiscard]] QByteArray findJson(const QByteArray &query) const;
+
+private:
+	struct Stored {
+		int id = 0;
+		int file = 0;
+		MtpDump::Entry entry;
+	};
+	struct Task {
+		QString path;
+		QString name;
+		qint64 from = 0;
+		qint64 till = 0;
+		qint64 base = -1;
+		bool middle = false;
+	};
+	struct Result {
+		QString name;
+		qint64 offset = 0;
+		qint64 base = -1;
+		qint64 lines = 0;
+		std::vector<MtpDump::Entry> entries;
+	};
+
+	void apply(std::vector<Result> results, int generation);
+	void appendMatches(std::string &out, const QByteArray &query) const;
+	[[nodiscard]] const Stored *find(int id) const;
+
+	std::deque<Stored> _entries;
+	base::flat_map<QString, qint64> _offsets;
+	base::flat_map<QString, qint64> _lines;
+	std::vector<QString> _files;
+	rpl::event_stream<> _updates;
+	qint64 _bytes = 0;
+	int _lastId = 0;
+	int _generation = 0;
+	bool _loading = false;
+	bool _again = false;
+	bool _trimmed = false;
+
+};
+
+[[nodiscard]] int CountMtpLogFiles();
+
+} // namespace Tele
