+		return result;
+	} else if ('v' in node) {
+		return node.v.map(jsonOf);
+	} else if ('g' in node) {
+		return true;
+	} else if (node.t === 'INT' || node.t === 'DOUBLE') {
+		const number = Number(node.s);
+		return isFinite(number) ? number : node.s;
