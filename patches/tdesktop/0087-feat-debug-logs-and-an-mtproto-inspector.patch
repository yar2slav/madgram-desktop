+			}
+		});
+	} else if (entry.k === 'r' && entry.r) {
+		entry.r.forEach(function (id, index) {
+			const request = state.sent.get(id);
+			result.push({
+				target: request ? request.i : 0,
+				method: request ? request.n : 'request ' + id,
+				result: entry.rn ? entry.rn[index] : entry.n,
+				time: request ? delta(request.t, entry.t) : 'not in the log',
+			});
+		});
+	}
+	return result;
+}
+
+function renderTitle(entry) {
+	const title = el('div', 'entry-title');
+	title.appendChild(span('badge badge-' + entry.k + ' ui', kindName(entry.k)));
+	const name = el('div', 'entry-name');
+	const split = entry.n.indexOf(': ');
+	const prefix = (split > 0) ? entry.n.slice(0, split) : '';
+	if (prefix === 'msg_container' || prefix === 'rpc_result') {
+		name.appendChild(span('entry-prefix', prefix));
+		name.appendChild(span('', entry.n.slice(split + 2)));
+	} else {
+		name.appendChild(span('', entry.n));
+	}
+	name.title = entry.n;
+	title.appendChild(name);
+	const meta = el('div', 'entry-meta');
+	meta.appendChild(span('', entry.t));
+	meta.appendChild(span('', 'dc ' + entry.d));
+	if (entry.s) {
+		meta.appendChild(span('', formatSize(entry.s)));
+	}
+	title.appendChild(meta);
+	return title;
+}
+
+function renderFacts(entry) {
+	const facts = [];
+	if (entry.m && entry.m.length) {
+		facts.push(['msg_id', entry.m[0]]);
+	}
+	if (entry.r && entry.r.length === 1) {
+		facts.push(['req_msg_id', entry.r[0]]);
+	}
+	if (entry.session) {
+		facts.push(['session', entry.session]);
+	}
+	if (entry.key) {
+		facts.push(['auth key', entry.key]);
+	}
+	if (entry.pdc) {
+		facts.push(['connection', 'dc ' + entry.pdc]);
+	}
+	facts.push(['file', entry.f + (entry.ln ? ':' + entry.ln : '')]);
+	facts.push(['log stamp', entry.q]);
+	const grid = el('div', 'facts');
+	for (const [key, value] of facts) {
+		grid.appendChild(span('fact-key ui', key));
+		const cell = span('fact-value', value);
+		cell.title = 'Click to copy';
+		cell.addEventListener('click', function () {
+			copy(value);
+		});
+		grid.appendChild(cell);
+	}
+	return grid;
+}
+
+function renderLinks(entry) {
+	const rows = linkedRows(entry);
+	if (!rows.length) {
+		return null;
+	}
+	const wrap = el('div', 'links');
+	const noun = (entry.k === 's')
+		? (rows.length === 1 ? 'response' : 'responses')
+		: (rows.length === 1 ? 'request' : 'requests');
+	const list = el('div', 'links-list');
+	for (const row of rows) {
+		const line = el('div', 'links-row' + (row.target ? '' : ' missing'));
+		line.appendChild(span('links-arrow', entry.k === 's' ? '\u21aa' : '\u21a9'));
+		const text = span('links-text');
+		text.appendChild(span('links-method', row.method));
+		text.appendChild(span('links-sep', ' \u2192 '));
+		text.appendChild(span('links-result', row.result));
+		text.title = row.method + ' \u2192 ' + row.result;
+		line.appendChild(text);
+		line.appendChild(span('links-time ui', row.time));
+		if (row.target) {
+			line.addEventListener('click', function () {
+				select(row.target, true);
+			});
+		}
+		list.appendChild(line);
+	}
+	const head = el('div', 'links-head ui');
+	if (rows.length > 3) {
+		const toggle = span('links-toggle');
+		head.appendChild(toggle);
+		head.appendChild(document.createTextNode(rows.length + ' ' + noun));
+		head.classList.add('foldable');
+		const setOpen = function (open) {
+			toggle.textContent = open ? '\u25be' : '\u25b8';
+			list.style.display = open ? '' : 'none';
+		};
+		let opened = false;
+		head.addEventListener('click', function () {
+			opened = !opened;
+			setOpen(opened);
+		});
+		setOpen(false);
+	} else {
+		head.textContent = noun;
+	}
+	wrap.appendChild(head);
+	wrap.appendChild(list);
+	return wrap;
+}
+
+function renderDetail(entry) {
+	state.detail = entry;
+	const box = els.detail;
+	box.textContent = '';
+
+	const header = el('div', 'entry-header');
+	header.appendChild(renderTitle(entry));
+	header.appendChild(renderFacts(entry));
+	const links = renderLinks(entry);
+	if (links) {
+		header.appendChild(links);
+	}
+	box.appendChild(header);
+
+	const actions = el('div', 'detail-actions');
+	actions.appendChild(actionButton('Copy entry', function () {
+		copy(entry.raw);
+	}));
+	box.appendChild(actions);
+
+	if (!entry.tree) {
+		box.appendChild(el('pre', 'raw', entry.raw));
+		return;
+	}
+	const tree = el('div', 'json-tree');
+	const root = makeNode(entry.tree, null, 0, false, []);
+	if (entry.pp) {
+		actions.appendChild(actionButton('Open on schema.jppgr.am', function () {
+			openOnSchema(entry.pp, true);
+		}));
+	}
+	actions.appendChild(actionButton('Copy JSON', function () {
+		copy(JSON.stringify(jsonOf(entry.tree), null, 2));
+	}));
+	actions.appendChild(actionButton('Expand all', function () {
+		expandAll(root);
+	}));
+	actions.appendChild(actionButton('Collapse all', function () {
+		collapseAll(root);
+	}));
+	if (entry.partial) {
+		box.appendChild(el('div', 'note ui', 'The app could not decode this message past the error, the rest was not logged.'));
+	}
+	tree.appendChild(root);
+	box.appendChild(tree);
+}
+
+function onKey(e) {
+	if (confirmShown()) {
+		if (e.key === 'Escape') {
+			hideConfirm();
+			e.preventDefault();
+		}
+		return;
+	}
+	const inFilter = (document.activeElement === els.filter);
+	const command = e.ctrlKey || e.metaKey;
+	if (e.key === 'ArrowDown') {
+		move(1);
+	} else if (e.key === 'ArrowUp') {
+		move(-1);
+	} else if (e.key === 'PageDown' && !inFilter) {
+		move(Math.max(1, Math.floor(els.list.clientHeight / rowHeight()) - 1));
+	} else if (e.key === 'PageUp' && !inFilter) {
+		move(-Math.max(1, Math.floor(els.list.clientHeight / rowHeight()) - 1));
+	} else if (e.key === 'Home' && !inFilter && state.view.length) {
+		select(state.view[0].i, true);
+	} else if (e.key === 'End' && !inFilter && state.view.length) {
+		select(state.view[state.view.length - 1].i, true);
+	} else if (e.key === 'Escape') {
+		if (els.filter.value) {
+			els.filter.value = '';
+			runQuery();
+		} else {
+			post({ event: 'close' });
+		}
+	} else if (command && (e.key === 'f' || e.key === 'F')) {
+		els.filter.focus();
+		els.filter.select();
+	} else if (e.key === 'F5' || (command && (e.key === 'r' || e.key === 'R'))) {
+		refresh();
+	} else if (e.key === '/' && !inFilter) {
+		els.filter.focus();
+	} else if (command && (e.key === 'w' || e.key === 'W')) {
+		post({ event: 'close' });
+	} else {
+		return;
+	}
+	e.preventDefault();
+}
+
+function refresh() {
+	post({ event: 'refresh' });
+}
+
+function bindSplit() {
+	els.split.addEventListener('pointerdown', function (e) {
+		e.preventDefault();
+		els.split.setPointerCapture(e.pointerId);
+		const moveSplit = function (event) {
+			const rect = els.main.getBoundingClientRect();
+			const x = Math.min(Math.max(event.clientX - rect.left, 240), rect.width - 240);
+			els.list.style.flexBasis = x + 'px';
+			renderRows(true);
+		};
+		const stop = function () {
+			els.split.removeEventListener('pointermove', moveSplit);
+			els.split.removeEventListener('pointerup', stop);
+			els.split.removeEventListener('pointercancel', stop);
+		};
+		els.split.addEventListener('pointermove', moveSplit);
+		els.split.addEventListener('pointerup', stop);
+		els.split.addEventListener('pointercancel', stop);
+	});
+}
+
+function init() {
+	for (const id of ['filter', 'kinds', 'dcs', 'refresh', 'folder', 'clear', 'status', 'main', 'list', 'spacer', 'rows', 'empty', 'split', 'detail', 'placeholder', 'confirm']) {
+		els[id] = document.getElementById(id);
+	}
+	els.confirmText = document.getElementById('confirm-text');
+	els.confirmOk = document.getElementById('confirm-ok');
+	els.confirmCancel = document.getElementById('confirm-cancel');
+	els.flash = el('div', 'flash ui');
+	document.body.appendChild(els.flash);
+	applyTheme();
+	renderChips();
+	renderStatus();
+	els.filter.addEventListener('input', function () {
+		clearTimeout(state.queryTimer);
+		state.queryTimer = setTimeout(runQuery, 150);
+	});
+	els.refresh.addEventListener('click', refresh);
+	els.clear.addEventListener('click', askClear);
+	els.confirmCancel.addEventListener('click', hideConfirm);
+	els.confirmOk.addEventListener('click', function () {
+		hideConfirm();
+		post({ event: 'clear' });
+	});
+	els.confirm.addEventListener('click', function (e) {
+		if (e.target === els.confirm) {
+			hideConfirm();
+		}
+	});
+	els.folder.addEventListener('click', function () {
+		post({ event: 'folder' });
+	});
+	els.list.addEventListener('scroll', function () {
+		renderRows(false);
+	});
+	els.rows.addEventListener('click', function (e) {
+		const row = e.target.closest('.row');
+		if (row) {
+			select(Number(row.dataset.id), false);
+		}
+	});
+	window.addEventListener('resize', function () {
+		renderRows(true);
+	});
+	document.addEventListener('keydown', onKey);
+	document.addEventListener('click', function (e) {
+		const anchor = e.target.closest('a');
+		if (anchor) {
+			e.preventDefault();
+		}
+	});
+	bindSplit();
+	els.filter.value = document.documentElement.dataset.query || '';
+	state.query = els.filter.value.trim();
+	loadList();
+	els.filter.focus();
+	els.filter.select();
+}
+
+function setQuery(query) {
+	els.filter.value = query;
+	clearTimeout(state.queryTimer);
+	resetDetail();
+	els.list.scrollTop = 0;
+	runQuery();
+	els.filter.focus();
+	els.filter.select();
+}
+
+window.MtpInspector = {
+	updated: function () {
+		if (els.list) {
+			loadList();
+		}
+	},
+	cleared: function () {
+		if (els.list) {
+			resetDetail();
+			els.list.scrollTop = 0;
+			renderRows(true);
+		}
+	},
+	setQuery: function (data) {
+		if (els.list) {
+			setQuery(data.query);
+		}
+	},
+	flash: function (data) {
+		if (els.list) {
+			flash(data.text, 5000);
+		}
+	},
+	updateStyles: function (styles) {
+		document.documentElement.setAttribute('style', styles);
+		applyTheme();
+	},
+};
+
+document.addEventListener('DOMContentLoaded', init);
+})();
