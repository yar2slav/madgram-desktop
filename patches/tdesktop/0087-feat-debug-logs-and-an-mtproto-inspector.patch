new file mode 100644
index 0000000000000000000000000000000000000000..1eadef0e43b79a12ba1a178c46116acc626b51be
--- /dev/null
+++ b/Telegram/Resources/tele_html/mtp_inspector.css
@@ -0,0 +1,533 @@
+:root {
+	--bg: var(--td-window-bg);
+	--bg-over: var(--td-window-bg-over);
+	--bg-ripple: var(--td-window-bg-ripple);
+	--text: var(--td-window-fg);
+	--dim: var(--td-window-sub-text-fg);
+	--accent: var(--td-window-active-text-fg);
+	--active-bg: var(--td-window-bg-active);
+	--active-fg: var(--td-window-fg-active);
+	--border: var(--td-filter-input-border-fg);
+	--divider: var(--td-box-divider-bg);
+	--attention: var(--td-attention-button-fg);
+	--syntax-key: #1d4ed8;
+	--syntax-type: #117d3b;
+	--syntax-type-hover: #14532d;
+	--syntax-number: #b45309;
+	--syntax-bool: #7c3aed;
+	--syntax-null: #b91c1c;
+	--syntax-invisible: #8a5a00;
+	--row: 24px;
+	--mono: "SF Mono", "Cascadia Code", "JetBrains Mono", "Fira Code", Consolas, monospace;
+}
+:root[data-theme="dark"] {
+	--syntax-key: #7aa2f7;
+	--syntax-type: #9ece6a;
+	--syntax-type-hover: #b9e89d;
+	--syntax-number: #ff9e64;
+	--syntax-bool: #bb9af7;
+	--syntax-null: #e87070;
+	--syntax-invisible: #e0af68;
+}
+html[data-lower="1"] .ui,
+html[data-lower="1"] #filter::placeholder {
+	text-transform: lowercase;
+}
+* {
+	box-sizing: border-box;
+}
+html, body {
+	height: 100%;
+	margin: 0;
+	background: var(--bg);
+	color: var(--text);
+	font-family: var(--mono);
+	font-size: 13px;
+	line-height: 1.5;
+}
+body {
+	display: flex;
+	flex-direction: column;
+	overflow: hidden;
+}
+::-webkit-scrollbar {
+	width: 10px;
+	height: 10px;
+}
+::-webkit-scrollbar-thumb {
+	background: var(--td-scroll-bar-bg);
+	border-radius: 5px;
+	border: 2px solid transparent;
+	background-clip: content-box;
+}
+::-webkit-scrollbar-thumb:hover {
+	background: var(--td-scroll-bar-bg-over);
+	background-clip: content-box;
+}
+::-webkit-scrollbar-corner {
+	background: transparent;
+}
+button {
+	font: inherit;
+	font-size: 12px;
+	color: var(--text);
+	background: var(--bg-over);
+	border: 1px solid var(--border);
+	padding: 2px 10px;
+	cursor: pointer;
+}
+button:hover {
+	background: var(--bg-ripple);
+}
+button.danger {
+	color: var(--attention);
+}
+button:disabled {
+	opacity: .5;
+	cursor: default;
+}
+#bar {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 8px;
+	padding: 8px 12px;
+	border-bottom: 1px solid var(--divider);
+}
+#filter {
+	flex: 1 1 280px;
+	min-width: 200px;
+	font: inherit;
+	color: var(--text);
+	background: var(--td-filter-input-inactive-bg);
+	border: 1px solid var(--border);
+	padding: 4px 8px;
+	outline: none;
+}
+#filter:focus {
+	border-color: var(--accent);
+}
+.grow {
+	flex: 1 1 0;
+}
+.chips {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 4px;
+}
+.chip {
+	font-size: 12px;
+	padding: 1px 8px;
+	border: 1px solid var(--border);
+	background: transparent;
+	color: var(--dim);
+	text-decoration: line-through;
+}
+.chip.on {
+	color: var(--text);
+	background: var(--bg-over);
+	text-decoration: none;
+}
+.chip.kind-s.on {
+	color: var(--accent);
+}
+.chip.kind-r.on {
+	color: var(--syntax-type);
+}
+#status {
+	padding: 4px 12px;
+	font-size: 12px;
+	color: var(--dim);
+	border-bottom: 1px solid var(--divider);
+}
+#main {
+	flex: 1 1 0;
+	display: flex;
+	min-height: 0;
+}
+#list {
+	position: relative;
+	flex: 0 0 44%;
+	overflow: auto;
+	outline: none;
+}
+#spacer {
+	width: 1px;
+}
+#rows {
+	position: absolute;
+	left: 0;
+	right: 0;
+	top: 0;
+}
+.row {
+	display: grid;
+	grid-template-columns: 92px 18px minmax(70px, 120px) 1fr auto;
+	gap: 6px;
+	align-items: center;
+	height: var(--row);
+	padding: 0 10px;
+	white-space: nowrap;
+	cursor: default;
+	font-size: 12px;
+}
+.row:hover {
+	background: var(--bg-over);
+}
+.row.selected {
+	background: var(--active-bg);
+	color: var(--active-fg);
+}
+.row.selected .dim,
+.row.selected .dir {
+	color: var(--active-fg);
+}
+.row > span {
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+.dim {
+	color: var(--dim);
+}
+.dir {
+	text-align: center;
+	font-weight: 600;
+}
+.dir-s {
+	color: var(--accent);
+}
+.dir-r {
+	color: var(--syntax-type);
+}
+.dir-o {
+	color: var(--dim);
+}
+.size {
+	text-align: right;
+	color: var(--dim);
+}
+#empty {
+	display: none;
+	padding: 24px 16px;
+	color: var(--dim);
+	white-space: pre-wrap;
+}
+#split {
+	flex: 0 0 5px;
+	cursor: col-resize;
+	border-left: 1px solid var(--divider);
+}
+#split:hover {
+	background: var(--bg-over);
+}
+#detail {
+	flex: 1 1 0;
+	overflow: auto;
+	padding: 12px 16px 24px;
+	min-width: 0;
+}
+#placeholder {
+	color: var(--dim);
+	padding-top: 12px;
+}
+.entry-header {
+	margin-bottom: 12px;
+	padding-bottom: 12px;
+	border-bottom: 1px solid var(--divider);
+}
+.entry-title {
+	display: flex;
+	align-items: flex-start;
+	gap: 10px;
+	margin-bottom: 10px;
+}
+.badge {
+	flex: 0 0 auto;
+	margin-top: 1px;
+	padding: 0 6px;
+	font-size: 11px;
+	line-height: 18px;
+	font-weight: 600;
+	border: 1px solid currentColor;
+	border-radius: 3px;
+}
+.badge-s {
+	color: var(--accent);
+}
+.badge-r {
+	color: var(--syntax-type);
+}
+.badge-o {
+	color: var(--dim);
+}
+.entry-name {
+	flex: 1 1 auto;
+	min-width: 0;
+	font-weight: 600;
+	overflow: hidden;
+	display: -webkit-box;
+	-webkit-line-clamp: 2;
+	-webkit-box-orient: vertical;
+	overflow-wrap: anywhere;
+}
+.entry-prefix {
+	color: var(--dim);
+	font-weight: normal;
+	margin-right: 6px;
+}
+.entry-meta {
+	flex: 0 0 auto;
+	display: flex;
+	gap: 10px;
+	font-size: 12px;
+	color: var(--dim);
+	margin-top: 1px;
+	white-space: nowrap;
+}
+.facts {
+	display: grid;
+	grid-template-columns: max-content minmax(0, 1fr);
+	column-gap: 16px;
+	row-gap: 1px;
+	font-size: 12px;
+}
+.fact-key {
+	color: var(--dim);
+}
+.fact-value {
+	justify-self: start;
+	max-width: 100%;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+	cursor: pointer;
+	padding: 0 4px;
+	margin: 0 -4px;
+	border-radius: 3px;
+}
+.fact-value:hover {
+	background: var(--bg-over);
+	color: var(--accent);
+}
+.links {
+	margin-top: 10px;
+	font-size: 12px;
+}
+.links-head {
+	color: var(--dim);
+	margin-bottom: 2px;
+}
+.links-head.foldable {
+	cursor: pointer;
+	user-select: none;
+}
+.links-head.foldable:hover {
+	color: var(--text);
+}
+.links-toggle {
+	display: inline-block;
+	width: 2ch;
+}
+.links-row {
+	display: grid;
+	grid-template-columns: 2ch minmax(0, 1fr) auto;
+	gap: 6px;
+	align-items: center;
+	padding: 1px 4px;
+	margin: 0 -4px;
+	border-radius: 3px;
+	cursor: pointer;
+}
+.links-row:hover {
+	background: var(--bg-over);
+}
+.links-row.missing {
+	cursor: default;
+	opacity: .6;
+}
+.links-row.missing:hover {
+	background: transparent;
+}
+.links-arrow {
+	color: var(--accent);
+}
+.links-text {
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.links-method {
+	color: var(--text);
+}
+.links-sep {
+	color: var(--dim);
+}
+.links-result {
+	color: var(--syntax-type);
+}
+.links-time {
+	color: var(--dim);
+	white-space: nowrap;
+}
+.detail-actions {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 6px;
+	margin-bottom: 12px;
+}
+.note {
+	color: var(--syntax-invisible);
+	font-size: 12px;
+	margin-bottom: 10px;
+}
+.raw {
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+	margin: 0;
+	font: inherit;
+}
+a, .link {
+	color: var(--accent);
+	cursor: pointer;
+	text-decoration: none;
+}
+a:hover, .link:hover {
+	text-decoration: underline;
+}
+.json-tree {
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+.json-children {
+	padding-left: 2ch;
+	margin-left: 5px;
+	border-left: 1px dotted var(--border);
+}
+.json-line {
+	position: relative;
+}
+.json-line:hover {
+	background: var(--bg-over);
+}
+.json-line:hover > .json-actions {
+	visibility: visible;
+}
+.json-actions {
+	visibility: hidden;
+	margin-left: 8px;
+	font-size: 11px;
+}
+.json-actions .link {
+	margin-right: 6px;
+	color: var(--dim);
+}
+.json-actions .link:hover {
+	color: var(--accent);
+}
+.json-toggle {
+	display: inline-block;
+	width: 2ch;
+	margin-left: -2ch;
+	text-align: center;
+	color: var(--dim);
+	cursor: pointer;
+	user-select: none;
+}
+.json-toggle:hover {
+	color: var(--text);
+}
+.json-key {
+	color: var(--syntax-key);
+}
+.json-string {
+	color: var(--syntax-type);
+}
+.json-number {
+	color: var(--syntax-number);
+}
+.json-bool {
+	color: var(--syntax-bool);
+}
+.json-error {
+	color: var(--syntax-null);
+}
+.json-punct {
+	color: var(--dim);
+}
+.json-type-hint {
+	color: var(--dim);
+	margin-left: 4px;
+}
+.json-ctor-link {
+	color: var(--syntax-type);
+	text-decoration: underline;
+	text-decoration-style: dotted;
+	text-underline-offset: 2px;
+	cursor: pointer;
+}
+.json-ctor-link:hover {
+	color: var(--syntax-type-hover);
+}
+.json-badge {
+	color: var(--syntax-invisible);
+	font-size: 11px;
+	margin-right: 6px;
+}
+.json-more {
+	color: var(--accent);
+	cursor: pointer;
+	margin-left: 6px;
+	font-size: 11px;
+}
+.json-jump {
+	color: var(--accent);
+	cursor: pointer;
+	margin-left: 6px;
+	font-size: 11px;
+}
+.json-summary {
+	color: var(--dim);
+	cursor: pointer;
+}
+.flash {
+	position: fixed;
+	right: 16px;
+	bottom: 16px;
+	padding: 6px 12px;
+	background: var(--active-bg);
+	color: var(--active-fg);
+	font-size: 12px;
+	max-width: 420px;
+	opacity: 0;
+	transition: opacity .15s;
+	pointer-events: none;
+}
+.flash.shown {
+	opacity: 1;
+}
+.modal {
+	display: none;
+	position: fixed;
+	inset: 0;
+	background: rgba(0, 0, 0, .4);
+	align-items: center;
+	justify-content: center;
+	z-index: 10;
+}
+.modal.shown {
+	display: flex;
+}
+.modal-box {
+	max-width: 440px;
+	margin: 16px;
+	padding: 20px 20px 14px;
+	background: var(--bg);
+	border: 1px solid var(--border);
+	white-space: pre-wrap;
+}
+.modal-buttons {
+	display: flex;
+	justify-content: flex-end;
+	gap: 8px;
+	margin-top: 18px;
+}
diff --git a/Telegram/Resources/tele_html/mtp_inspector.html b/Telegram/Resources/tele_html/mtp_inspector.html
