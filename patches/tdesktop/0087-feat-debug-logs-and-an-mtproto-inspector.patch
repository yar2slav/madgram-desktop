+[[nodiscard]] bool IsSchemaUrl(const QString &url) {
+	return url.startsWith(QString::fromLatin1(kSchemaPrefix));
+}
+
+class Inspector final {
+public:
+	Inspector(not_null<Main::Session*> session, const QString &query);
+	~Inspector();
+
+	[[nodiscard]] bool valid() const;
+	void activate();
+	void setQuery(const QString &query);
+
+private:
+	void createWindow(QRect parent);
+	[[nodiscard]] bool createWebview(const Webview::StorageId &storageId);
+	void handle(const QJsonObject &message);
+	void notify(const QString &method, const QJsonObject &argument);
+	void openSchema(const QJsonObject &message);
+	[[nodiscard]] Webview::DataResult serve(Webview::DataRequest request);
+	void updateStyles();
+
+	MtpLog _log;
+	QString _query;
+	std::unique_ptr<Ui::RpWindow> _window;
+	Ui::RpWidget *_container = nullptr;
+	std::unique_ptr<Webview::Window> _webview;
+	rpl::lifetime _lifetime;
+
+};
+
+std::unique_ptr<Inspector> Instance;
+
+void RequestClose(not_null<Inspector*> inspector) {
+	crl::on_main([=] {
+		if (Instance.get() == inspector) {
+			Instance = nullptr;
+		}
+	});
+}
+
+Inspector::Inspector(not_null<Main::Session*> session, const QString &query)
+: _query(query) {
+	const auto active = QApplication::activeWindow();
+	createWindow(active
+		? active->geometry()
+		: QGuiApplication::primaryScreen()->availableGeometry());
+	if (!createWebview(session->local().resolveStorageIdOther())) {
+		return;
+	}
+	_log.updates() | rpl::on_next([=] {
+		if (_webview) {
+			_webview->eval("if (window.MtpInspector) MtpInspector.updated();");
+		}
+	}, _lifetime);
+	DebugLogsCleared() | rpl::on_next([=] {
+		_log.reset();
+		_log.refresh();
+		notify(u"cleared"_q, {});
+	}, _lifetime);
+	_log.refresh();
+}
+
+Inspector::~Inspector() {
+	if (_window) {
+		_window->hide();
+	}
+	base::take(_webview);
+	_container = nullptr;
+	base::take(_window);
+}
+
+bool Inspector::valid() const {
+	return (_webview != nullptr);
+}
+
+void Inspector::activate() {
+	if (_window->isMinimized()) {
+		_window->showNormal();
+	} else if (_window->isHidden()) {
+		_window->show();
+	}
+	_window->raise();
+	_window->activateWindow();
+	if (_webview) {
+		_webview->focus();
+	}
+	_log.refresh();
+}
+
+void Inspector::setQuery(const QString &query) {
+	_query = query;
+	notify(u"setQuery"_q, { { u"query"_q, query } });
+}
+
+void Inspector::createWindow(QRect parent) {
+	_window = std::make_unique<Ui::RpWindow>();
+	const auto window = _window.get();
+	window->setWindowTitle(Lower(u"MTProto inspector"_q));
+	window->setMinimumSize({ st::windowMinWidth, st::windowMinHeight });
+
+	auto rect = QRect(
+		QPoint(),
+		QSize(style::ConvertScale(1100), style::ConvertScale(720)));
+	if (const auto screen = QGuiApplication::screenAt(parent.center())) {
+		const auto available = screen->availableGeometry();
+		rect.setSize(rect.size().boundedTo(available.size()));
+		rect.moveCenter(parent.center());
+		rect.moveLeft(std::clamp(
+			rect.left(),
+			available.left(),
+			available.left() + available.width() - rect.width()));
+		rect.moveTop(std::clamp(
+			rect.top(),
+			available.top(),
+			available.top() + available.height() - rect.height()));
+	} else {
+		rect.moveCenter(parent.center());
+	}
+	window->setGeometry(rect);
+
+	_container = Ui::CreateChild<Ui::RpWidget>(window->body().get());
+	window->body()->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		_container->setGeometry(QRect(QPoint(), size));
+	}, _container->lifetime());
+	_container->paintRequest() | rpl::on_next([=](QRect clip) {
+		QPainter(_container).fillRect(clip, st::windowBg);
+	}, _container->lifetime());
+
+	window->events(
+	) | rpl::on_next([=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::Close) {
+			RequestClose(this);
+		} else if (e->type() == QEvent::KeyPress
+			&& static_cast<QKeyEvent*>(e.get())->key() == Qt::Key_Escape) {
+			RequestClose(this);
+		}
+	}, window->lifetime());
+
+	_container->show();
+	window->show();
+}
+
+bool Inspector::createWebview(const Webview::StorageId &storageId) {
+	_webview = std::make_unique<Webview::Window>(
+		_container,
+		Webview::WindowConfig{
+			.opaqueBg = st::windowBg->c,
+			.storageId = storageId,
+			.safe = true,
+		});
+	const auto raw = _webview.get();
+	const auto widget = raw->widget();
+	if (!widget) {
+		_webview = nullptr;
+		return false;
+	}
+	widget->show();
+	_container->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		if (const auto widget = raw->widget()) {
+			widget->setGeometry(QRect(QPoint(), size));
+		}
+	}, _container->lifetime());
+	QObject::connect(widget, &QObject::destroyed, [=] {
+		if (_webview) {
+			RequestClose(this);
+		}
+	});
+
+	raw->setNavigationPolicyHandler([=](const QString &uri, bool newWindow) {
+		const auto url = QUrl(uri);
+		const auto scheme = url.scheme().toLower();
+		const auto host = url.host().toLower();
+		const auto external = (scheme == u"https"_q)
+			|| (scheme == u"http"_q
+				&& host != u"desktop-app-resource"_q
+				&& host != u"127.0.0.1"_q
+				&& host != u"localhost"_q);
+		if (!external) {
+			return true;
+		} else if (IsSchemaUrl(uri)) {
+			crl::on_main([=] {
+				File::OpenUrl(uri);
+			});
+		}
+		return false;
+	});
+	raw->setNavigationDoneHandler([](bool) {
+	});
+	raw->setMessageHandler([=](const QJsonDocument &message) {
+		crl::on_main(_window.get(), [=] {
+			handle(message.object());
+		});
+	});
+	raw->setDataRequestHandler([=](Webview::DataRequest request) {
+		return serve(std::move(request));
+	});
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		updateStyles();
+	}, raw->lifetime());
+
+	raw->init(R"()");
+	raw->navigateToData(QString::fromLatin1(
+		kPrefix.data(),
+		kPrefix.size()) + u"inspector.html"_q);
+	return true;
+}
+
+void Inspector::handle(const QJsonObject &message) {
+	const auto event = message.value(u"event"_q).toString();
+	if (event == u"copy"_q) {
+		QGuiApplication::clipboard()->setText(
+			message.value(u"text"_q).toString());
+	} else if (event == u"open"_q) {
+		const auto url = message.value(u"url"_q).toString();
+		if (IsSchemaUrl(url)) {
+			File::OpenUrl(url);
+		}
+	} else if (event == u"schema"_q) {
+		openSchema(message);
+	} else if (event == u"folder"_q) {
+		OpenLogsFolder();
+	} else if (event == u"refresh"_q) {
+		_log.refresh();
+	} else if (event == u"clear"_q) {
+		ClearDebugLogs(crl::guard(_window.get(), [=](QString text) {
+			notify(u"flash"_q, { { u"text"_q, text } });
+		}));
+	} else if (event == u"close"_q) {
+		RequestClose(this);
+	}
+}
+
+void Inspector::openSchema(const QJsonObject &message) {
+	auto path = std::vector<int>();
+	for (const auto &value : message.value(u"path"_q).toArray()) {
+		path.push_back(value.toInt());
+	}
+	const auto result = _log.serialize(
+		message.value(u"id"_q).toInt(),
+		path,
+		message.value(u"primary"_q).toBool());
+	if (!result.error.empty()) {
+		notify(u"flash"_q, { { u"text"_q, Lower(
+			u"Can't open it on schema.jppgr.am: "_q
+			+ QString::fromStdString(result.error)
+			+ '.') } });
+		return;
+	}
+	OpenTl(QByteArray::fromStdString(result.bytes));
+	if (result.padded) {
+		notify(u"flash"_q, { { u"text"_q, Lower(result.padded == 1
+			? u"The log cut one bytes value short, "
+				"the missing part was filled with zeros."_q
+			: u"The log cut %1 bytes values short, "
+				"the missing parts were filled with zeros."_q.arg(
+					result.padded)) } });
+	}
+}
+
+void Inspector::notify(const QString &method, const QJsonObject &argument) {
+	if (!_webview) {
+		return;
+	}
+	_webview->eval("if (window.MtpInspector) MtpInspector."
+		+ method.toUtf8()
+		+ '('
+		+ QJsonDocument(argument).toJson(QJsonDocument::Compact)
+		+ ");");
+}
+
+Webview::DataResult Inspector::serve(Webview::DataRequest request) {
+	auto id = std::string_view(request.id);
+	if (const auto cut = id.find_first_of("?#"); cut != id.npos) {
+		id = id.substr(0, cut);
+	}
+	if (!id.starts_with(kPrefix)) {
+		return Webview::DataResult::Failed;
+	}
+	id.remove_prefix(kPrefix.size());
+	const auto finish = [&](QByteArray data, std::string mime) {
+		request.done({
+			.stream = std::make_unique<Webview::DataStreamFromMemory>(
+				std::move(data),
+				std::move(mime)),
+		});
+		return Webview::DataResult::Done;
+	};
+	if (id == "inspector.html") {
+		return finish(Page(_query), "text/html; charset=utf-8");
+	} else if (id == "inspector.css") {
+		return finish(
+			Resource(u"mtp_inspector.css"_q),
+			"text/css; charset=utf-8");
+	} else if (id == "inspector.js") {
+		return finish(
+			Resource(u"mtp_inspector.js"_q),
+			"text/javascript; charset=utf-8");
+	} else if (id.starts_with("clear/")) {
+		const auto info = CountDebugLogs();
+		return finish(QJsonDocument(QJsonObject{
+			{ u"files"_q, info.files },
+			{ u"text"_q, info.files
+				? ClearDebugLogsQuestion(info)
+				: NothingToClearText(info) },
+			{ u"confirm"_q, Lower(u"Clear"_q) },
+			{ u"cancel"_q, Lower(u"Cancel"_q) },
+		}).toJson(QJsonDocument::Compact), kJson);
+	} else if (id.starts_with("list/")) {
+		auto hex = id.substr(5);
+		const auto dot = hex.find('.');
+		hex = (dot == hex.npos) ? std::string_view() : hex.substr(dot + 1);
+		hex = hex.substr(0, hex.find('.'));
+		return finish(_log.listJson(QByteArray::fromHex(
+			QByteArray(hex.data(), int(hex.size())))), kJson);
+	} else if (id.starts_with("entry/") && id.ends_with(".json")) {
+		const auto number = id.substr(6, id.size() - 11);
+		auto value = 0;
+		std::from_chars(number.data(), number.data() + number.size(), value);
+		return finish(_log.entryJson(value), kJson);
+	} else if (id.starts_with("find/")) {
+		auto hex = id.substr(5);
+		hex = hex.substr(0, hex.find('.'));
+		return finish(_log.findJson(QByteArray::fromHex(
+			QByteArray(hex.data(), int(hex.size())))), kJson);
+	}
+	return Webview::DataResult::Failed;
+}
+
+void Inspector::updateStyles() {
+	if (!_webview) {
+		return;
+	}
+	const auto styles = Ui::EscapeForScriptString(ComputeStyles());
+	_webview->eval("if (window.MtpInspector) MtpInspector.updateStyles('"
+		+ styles
+		+ "');");
+}
+
+void ShowUnavailable(
+		std::shared_ptr<Main::SessionShow> show,
+		TextWithEntities error) {
+	auto text = TextWithEntities{ Lower(
+		u"The MTProto inspector needs a webview, "
+		"which isn't available right now."_q) };
+	text.append(u"\n\n"_q).append(std::move(error));
+	show->show(Ui::MakeConfirmBox({
+		.text = std::move(text),
+		.confirmed = [](Fn<void()> close) {
+			OpenLogsFolder();
+			close();
+		},
+		.confirmText = Lower(u"Open the logs folder"_q),
+	}));
+}
+
+} // namespace
+
+void ShowMtpInspector(
+		std::shared_ptr<Main::SessionShow> show,
+		const QString &query) {
+	if (Instance) {
+		if (!query.isEmpty()) {
+			Instance->setQuery(query);
+		}
+		Instance->activate();
+		return;
+	}
+	const auto available = Webview::Availability();
+	if (available.error != Webview::Available::Error::None) {
+		ShowUnavailable(show, Ui::BotWebView::ErrorText(available));
+		return;
+	}
+	const auto session = &show->session();
+	auto inspector = std::make_unique<Inspector>(session, query);
+	if (!inspector->valid()) {
+		inspector = nullptr;
+		ShowUnavailable(
+			show,
+			{ Lower(u"Could not start the webview."_q) });
+		return;
+	}
+	Instance = std::move(inspector);
+	const auto raw = Instance.get();
+	session->lifetime().add([=] {
+		if (Instance.get() == raw) {
+			Instance = nullptr;
+		}
+	});
+}
+
+QString MtpInspectorActionText() {
+	return Lower(u"Open in MTProto inspector"_q);
+}
+
+QString MtpInspectorQuery(not_null<PeerData*> peer) {
+	return QString::number(BarePeerId(peer->id));
+}
+
+QString MtpInspectorQuery(not_null<HistoryItem*> item) {
+	return QString::number(item->id.bare)
+		+ ' '
+		+ MtpInspectorQuery(item->history()->peer);
+}
+
+void AddMtpInspectorAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<PeerData*> peer) {
+	if (!Logs::DebugEnabled()) {
+		return;
+	}
+	const auto query = MtpInspectorQuery(peer);
+	addAction(MtpInspectorActionText(), [=] {
+		ShowMtpInspector(show, query);
+	}, &st::menuIconSearch);
+}
+
+void AddMtpInspectorAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		const Dialogs::EntryState &request) {
+	if (const auto peer = request.key.peer()) {
+		AddMtpInspectorAction(addAction, show, peer);
+	}
+}
+
