diff --git a/Telegram/SourceFiles/tele/tele_mtp_dump.cpp b/Telegram/SourceFiles/tele/tele_mtp_dump.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7fc59998e3ebc53f9b1bf2cb0fb9ab1145367776
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mtp_dump.cpp
@@ -0,0 +1,1375 @@
+#include "tele/tele_mtp_dump.h"
+
+#include <algorithm>
+#include <charconv>
+#include <cstring>
+#include <optional>
+
+namespace Tele::MtpDump {
+namespace {
+
+constexpr auto kMaxDepth = 512;
+constexpr auto kMaxDescribeDepth = 16;
+constexpr auto kMaxNameLength = std::size_t(160);
+constexpr auto kMaxSummaryNames = std::size_t(4);
+
+constexpr std::string_view kNamespaces[] = {
+	"account",
+	"aicompose",
+	"auth",
+	"bots",
+	"channels",
+	"chatlists",
+	"communities",
+	"contacts",
+	"ephemeral",
+	"folders",
+	"fragment",
+	"help",
+	"langpack",
+	"messages",
+	"payments",
+	"phone",
+	"photos",
+	"premium",
+	"smsjobs",
+	"stats",
+	"stickers",
+	"storage",
+	"stories",
+	"updates",
+	"upload",
+	"users",
+};
+
+constexpr std::string_view kUnlinked[] = {
+	"accessPointRule",
+	"ipPort",
+	"ipPortSecret",
+	"ping",
+	"pong",
+	"resPQ",
+};
+
+struct Node {
+	enum class Type : unsigned char {
+		Object,
+		Vector,
+		Scalar,
+		Flag,
+		Error,
+	};
+	Type type = Type::Scalar;
+	std::string_view name;
+	std::string_view kind;
+	std::string_view prefix;
+	std::string value;
+	long long count = 0;
+	bool elided = false;
+	std::vector<std::string_view> keys;
+	std::vector<Node> items;
+};
+
+struct Parsed {
+	Node root;
+	std::string_view rest;
+	bool partial = false;
+};
+
+[[nodiscard]] bool IsSpace(char ch) {
+	return (ch == ' ') || (ch == '\n') || (ch == '\r') || (ch == '\t');
+}
+
+[[nodiscard]] bool IsDigit(char ch) {
+	return (ch >= '0') && (ch <= '9');
+}
+
+[[nodiscard]] bool IsKeyChar(char ch) {
+	return IsDigit(ch)
+		|| (ch >= 'a' && ch <= 'z')
+		|| (ch >= 'A' && ch <= 'Z')
+		|| (ch == '_');
+}
+
+[[nodiscard]] char Fold(char ch) {
+	return (ch >= 'A' && ch <= 'Z') ? char(ch - 'A' + 'a') : ch;
+}
+
+[[nodiscard]] long long ToNumber(std::string_view text) {
+	auto result = 0LL;
+	std::from_chars(text.data(), text.data() + text.size(), result);
+	return result;
+}
+
+template <std::size_t Size>
+[[nodiscard]] bool InList(
+		const std::string_view (&list)[Size],
+		std::string_view value) {
+	return std::find(std::begin(list), std::end(list), value)
+		!= std::end(list);
+}
+
+[[nodiscard]] bool Wanted(std::string_view name, std::string_view key) {
+	if (name == "core_message") {
+		return (key == "msg_id") || (key == "bytes") || (key == "body");
+	} else if (name == "msg_container") {
+		return (key == "messages");
+	} else if (name == "rpc_result") {
+		return (key == "req_msg_id") || (key == "result");
+	} else if (name == "rpc_error") {
+		return (key == "error_code") || (key == "error_message");
+	} else if (name.starts_with("invoke") || name == "initConnection") {
+		return (key == "query");
+	}
+	return false;
+}
+
+class Parser final {
+public:
+	Parser(std::string_view data, bool summary)
+	: _data(data)
+	, _summary(summary) {
+	}
+
+	[[nodiscard]] Node value(int depth);
+	[[nodiscard]] bool failed() const {
+		return _failed;
+	}
+	[[nodiscard]] std::string_view rest() const {
+		return _data.substr(_position);
+	}
+
+private:
+	[[nodiscard]] bool at(std::string_view what) const {
+		return _data.substr(_position).starts_with(what);
+	}
+	[[nodiscard]] bool take(std::string_view what) {
+		if (!at(what)) {
+			return false;
+		}
+		_position += what.size();
+		return true;
+	}
+	void spaces() {
+		while (_position < _data.size() && IsSpace(_data[_position])) {
+			++_position;
+		}
+	}
+	[[nodiscard]] Node fail(std::string text) {
+		_failed = true;
+		auto result = Node();
+		result.type = Node::Type::Error;
+		result.value = std::move(text);
+		return result;
+	}
+	[[nodiscard]] Node unexpected() {
+		const auto line = _data.find('\n', _position);
+		const auto till = std::min(line, _position + 64);
+		return fail("unexpected text: "
+			+ std::string(_data.substr(_position, till - _position)));
+	}
+	[[nodiscard]] Node object(int depth);
+	[[nodiscard]] Node vector(int depth);
+	[[nodiscard]] Node string();
+	[[nodiscard]] Node flag();
+	[[nodiscard]] Node scalar();
+	[[nodiscard]] Node error();
+	void skip(int depth) {
+		++_discard;
+		(void)value(depth);
+		--_discard;
+	}
+
+	std::string_view _data;
+	std::size_t _position = 0;
+	int _discard = 0;
+	bool _summary = false;
+	bool _failed = false;
+
+};
+
+Node Parser::value(int depth) {
+	if (depth > kMaxDepth) {
+		return fail("too deep");
+	}
+	const auto start = _position;
+	while (true) {
+		if (take("[GZIPPED] ")) {
+			continue;
+		} else if (at("[LAYER")) {
+			auto i = _position + 6;
+			while (i < _data.size() && IsDigit(_data[i])) {
+				++i;
+			}
+			if (i > _position + 6 && _data.substr(i).starts_with("] ")) {
+				_position = i + 2;
+				continue;
+			}
+		}
+		break;
+	}
+	auto prefix = _data.substr(start, _position - start);
+	while (!prefix.empty() && prefix.back() == ' ') {
+		prefix.remove_suffix(1);
+	}
+	auto result = at("[ERROR]")
+		? error()
+		: at("{ ")
+		? object(depth)
+		: at("[ vector<")
+		? vector(depth)
+		: at("\"")
+		? string()
+		: at("YES [ BY BIT ")
+		? flag()
+		: scalar();
+	result.prefix = prefix;
+	return result;
+}
+
+Node Parser::object(int depth) {
+	_position += 2;
+	const auto start = _position;
+	while (_position < _data.size()
+		&& !IsSpace(_data[_position])
+		&& _data[_position] != '}') {
+		++_position;
+	}
+	auto result = Node();
+	result.type = Node::Type::Object;
+	result.name = _data.substr(start, _position - start);
+	if (result.name.empty()) {
+		return unexpected();
+	}
+	while (true) {
+		spaces();
+		if (_position >= _data.size()) {
+			_failed = true;
+			return result;
+		} else if (_data[_position] == '}') {
+			++_position;
+			return result;
+		}
+		const auto start = _position;
+		while (_position < _data.size() && IsKeyChar(_data[_position])) {
+			++_position;
+		}
+		const auto key = _data.substr(start, _position - start);
+		if (key.empty() || !take(": ")) {
+			if (!_discard) {
+				result.keys.push_back(key);
+				result.items.push_back(unexpected());
+			} else {
+				_failed = true;
+			}
+			return result;
+		}
+		if (_discard || (_summary && !Wanted(result.name, key))) {
+			skip(depth + 1);
+		} else {
+			result.keys.push_back(key);
+			result.items.push_back(value(depth + 1));
+		}
+		if (_failed) {
+			return result;
+		}
+		spaces();
+		(void)take(",");
+	}
+}
+
+Node Parser::vector(int depth) {
+	_position += 9;
+	const auto start = _position;
+	while (_position < _data.size()
+		&& _data[_position] != '>'
+		&& _position - start < 32) {
+		++_position;
+	}
+	auto result = Node();
+	result.type = Node::Type::Vector;
+	result.name = _data.substr(start, _position - start);
+	if (!take("> (")) {
+		return unexpected();
+	}
+	const auto count = _position;
+	while (_position < _data.size()
+		&& (IsDigit(_data[_position]) || _data[_position] == '-')) {
+		++_position;
+	}
+	result.count = ToNumber(_data.substr(count, _position - count));
+	if (!take(")")) {
+		return unexpected();
+	}
+	while (true) {
+		spaces();
+		if (_position >= _data.size()) {
+			_failed = true;
+			return result;
+		} else if (_data[_position] == ']') {
+			++_position;
+			return result;
+		}
+		if (_discard) {
+			skip(depth + 1);
+		} else {
+			result.items.push_back(value(depth + 1));
+		}
+		if (_failed) {
+			return result;
+		}
+		spaces();
+		(void)take(",");
+	}
+}
+
+Node Parser::string() {
+	++_position;
+	auto result = Node();
+	result.kind = "STRING";
+	auto closed = false;
+	if (_discard) {
+		while (_position < _data.size()) {
+			const auto found = _data.find_first_of("\\\"", _position);
+			if (found == std::string_view::npos) {
+				_position = _data.size();
+				break;
+			}
+			_position = found + 1;
+			if (_data[found] == '"') {
+				closed = true;
+				break;
+			} else if (_position < _data.size()) {
+				++_position;
+			}
+		}
+	}
+	while (!_discard && _position < _data.size()) {
+		const auto ch = _data[_position++];
+		if (ch == '\\' && _position < _data.size()) {
+			const auto next = _data[_position++];
+			result.value += (next == 'n') ? '\n' : next;
+		} else if (ch == '"') {
+			closed = true;
+			break;
+		} else {
+			result.value += ch;
+		}
+	}
+	if (!closed) {
+		return fail("unterminated string");
+	}
+	(void)take(" [STRING]");
+	return result;
+}
+
+Node Parser::flag() {
+	_position += 13;
+	const auto bit = _position;
+	while (_position < _data.size() && IsDigit(_data[_position])) {
+		++_position;
+	}
+	auto result = Node();
+	result.type = Node::Type::Flag;
+	result.count = ToNumber(_data.substr(bit, _position - bit));
+	if (!take(" IN FIELD ")) {
+		return unexpected();
+	}
+	const auto field = _position;
+	while (_position < _data.size() && IsKeyChar(_data[_position])) {
+		++_position;
+	}
+	result.name = _data.substr(field, _position - field);
+	if (!take(" ]")) {
+		return unexpected();
+	}
+	return result;
+}
+
+Node Parser::scalar() {
+	const auto line = std::min(_data.find('\n', _position), _data.size());
+	const auto marker = _data.find(" [", _position);
+	if (marker == std::string_view::npos || marker >= line) {
+		return unexpected();
+	}
+	const auto close = _data.find(']', marker);
+	if (close == std::string_view::npos || close >= line) {
+		return unexpected();
+	}
+	auto result = Node();
+	auto value = _data.substr(_position, marker - _position);
+	result.kind = _data.substr(marker + 2, close - marker - 2);
+	_position = close + 1;
+	if (result.kind.ends_with(" BYTES")) {
+		result.count = ToNumber(result.kind);
+		result.kind = "BYTES";
+		if (value.ends_with("...")) {
+			value.remove_suffix(3);
+			result.elided = true;
+		}
+	}
+	if (!_discard) {
+		result.value = std::string(value);
+	}
+	return result;
+}
+
+Node Parser::error() {
+	_position += 7;
+	auto text = std::string();
+	if (take(" (")) {
+		const auto close = _data.find(')', _position);
+		const auto till = std::min(close, _data.size());
+		text = std::string(_data.substr(_position, till - _position));
+		_position = std::min(till + 1, _data.size());
+	}
+	if (at("(ERROR_SCHEME_BAD_CONS:")) {
+		const auto close = _data.find(')', _position);
+		const auto till = std::min(close, _data.size());
+		text += ' ';
+		text += _data.substr(_position + 1, till - _position - 1);
+		_position = std::min(till + 1, _data.size());
+	}
+	return fail(text.empty() ? std::string("could not decode") : text);
+}
+
+[[nodiscard]] Parsed Parse(std::string_view body, bool summary = false) {
+	auto parser = Parser(body, summary);
+	auto root = parser.value(0);
+	return { std::move(root), parser.rest(), parser.failed() };
+}
+
+[[nodiscard]] const Node *Field(const Node &node, std::string_view key) {
+	for (auto i = std::size_t(); i != node.keys.size(); ++i) {
+		if (node.keys[i] == key && i < node.items.size()) {
+			return &node.items[i];
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] std::string ScalarField(
+		const Node &node,
+		std::string_view key) {
+	const auto field = Field(node, key);
+	return (field && field->type == Node::Type::Scalar)
+		? field->value
+		: std::string();
+}
+
+[[nodiscard]] std::string DisplayName(std::string_view name) {
+	const auto underscore = name.find('_');
+	if (underscore != std::string_view::npos
+		&& InList(kNamespaces, name.substr(0, underscore))) {
+		return std::string(name.substr(0, underscore))
+			+ '.'
+			+ std::string(name.substr(underscore + 1));
+	}
+	return std::string(name);
+}
+
+[[nodiscard]] bool Linkable(std::string_view name) {
+	const auto underscore = name.find('_');
+	if (underscore != std::string_view::npos) {
+		return InList(kNamespaces, name.substr(0, underscore));
+	}
+	return !name.empty()
+		&& (name[0] >= 'a' && name[0] <= 'z')
+		&& !InList(kUnlinked, name);
+}
+
+void Cut(std::string &text, std::size_t size) {
+	if (text.size() <= size) {
+		return;
+	}
+	while (size > 0 && (static_cast<unsigned char>(text[size]) & 0xC0) == 0x80) {
+		--size;
+	}
+	text.resize(size);
+	text += "...";
+}
+
+[[nodiscard]] std::string Describe(
+		const Node &node,
+		Entry &entry,
+		int depth) {
+	if (depth > kMaxDescribeDepth) {
+		return std::string();
+	}
+	switch (node.type) {
+	case Node::Type::Vector: return "vector";
+	case Node::Type::Scalar: return std::string(node.kind);
+	case Node::Type::Flag: return "flag";
+	case Node::Type::Error: return "decode error";
+	case Node::Type::Object: break;
+	}
+	const auto name = node.name;
+	if (name == "core_message") {
+		auto id = ScalarField(node, "msg_id");
+		const auto index = entry.msgIds.size();
+		if (!id.empty()) {
+			entry.msgIds.push_back(std::move(id));
+			entry.msgNames.emplace_back();
+		}
+		const auto body = Field(node, "body");
+		auto result = body
+			? Describe(*body, entry, depth + 1)
+			: std::string(name);
+		if (index < entry.msgNames.size()) {
+			entry.msgNames[index] = result;
+			Cut(entry.msgNames[index], kMaxNameLength);
+		}
+		return result;
+	} else if (name == "msg_container") {
+		auto names = std::vector<std::string>();
+		const auto messages = Field(node, "messages");
+		if (messages && messages->type == Node::Type::Vector) {
+			for (const auto &item : messages->items) {
+				auto inner = Describe(item, entry, depth + 1);
+				if (std::find(begin(names), end(names), inner)
+					== end(names)) {
+					names.push_back(std::move(inner));
+				}
+			}
+		}
+		auto result = std::string(name);
+		for (auto i = std::size_t(); i != names.size(); ++i) {
+			if (i == kMaxSummaryNames) {
+				result += ", ...";
+				break;
+			}
+			result += i ? ", " : ": ";
+			result += names[i];
+		}
+		return result;
+	} else if (name == "rpc_result") {
+		auto id = ScalarField(node, "req_msg_id");
+		const auto index = entry.requestIds.size();
+		if (!id.empty()) {
+			entry.requestIds.push_back(std::move(id));
+			entry.requestNames.emplace_back();
+		}
+		const auto result = Field(node, "result");
+		auto inner = result
+			? Describe(*result, entry, depth + 1)
+			: std::string("empty");
+		if (index < entry.requestNames.size()) {
+			entry.requestNames[index] = inner;
+			Cut(entry.requestNames[index], kMaxNameLength);
+		}
+		return "rpc_result: " + inner;
+	} else if (name == "rpc_error") {
+		return "rpc_error "
+			+ ScalarField(node, "error_code")
+			+ ' '
+			+ ScalarField(node, "error_message");
+	} else if (name.starts_with("invoke") || name == "initConnection") {
+		if (const auto query = Field(node, "query")) {
+			return Describe(*query, entry, depth + 1);
+		}
+	}
+	return DisplayName(name);
+}
+
+void Finalize(Entry &entry) {
+	const auto send = std::string_view(entry.text).starts_with("Send: ");
+	const auto recv = !send
+		&& std::string_view(entry.text).starts_with("Recv: ");
+	if (!send && !recv) {
+		entry.name = entry.text.substr(0, entry.text.find('\n'));
+		Cut(entry.name, kMaxNameLength);
+		return;
+	}
+	entry.kind = send ? Kind::Send : Kind::Recv;
+	const auto parsed = Parse(std::string_view(entry.text).substr(6), true);
+	const auto &root = parsed.root;
+	if (root.type == Node::Type::Object && root.name == "core_message") {
+		entry.size = int(ToNumber(ScalarField(root, "bytes")));
+	}
+	entry.name = Describe(root, entry, 0);
+	Cut(entry.name, kMaxNameLength);
+}
+
+[[nodiscard]] bool ParseHeader(
+		std::string_view line,
+		std::string_view *stamp,
+		std::string_view *dc,
+		std::string_view *text) {
+	constexpr auto kTime = std::string_view("00:00:00.000 ");
+	if (line.size() < kTime.size() + 2 || line[0] != '[') {
+		return false;
+	}
+	for (auto i = std::size_t(); i != kTime.size(); ++i) {
+		const auto ch = line[i + 1];
+		if (IsDigit(kTime[i]) ? !IsDigit(ch) : (ch != kTime[i])) {
+			return false;
+		}
+	}
+	const auto close = line.find(']', kTime.size() + 1);
+	if (close == std::string_view::npos) {
+		return false;
+	}
+	const auto thread = line.substr(
+		kTime.size() + 1,
+		close - kTime.size() - 1);
+	const auto dash = thread.find('-');
+	if (dash == 0
+		|| dash == std::string_view::npos
+		|| dash + 1 == thread.size()
+		|| !std::all_of(begin(thread), end(thread), [](char ch) {
+			return IsDigit(ch) || ch == '-';
+		})) {
+		return false;
+	}
+	const auto rest = line.substr(close);
+	if (!rest.starts_with("] (dc:")) {
+		return false;
+	}
+	const auto label = rest.substr(6);
+	const auto finish = label.find(')');
+	if (finish == 0 || finish == std::string_view::npos) {
+		return false;
+	}
+	*stamp = line.substr(1, close - 1);
+	*dc = label.substr(0, finish);
+	*text = label.substr(finish + 1);
+	if (!text->empty() && text->front() == ' ') {
+		text->remove_prefix(1);
+	}
+	return true;
+}
+
+void AppendNumber(std::string &out, long long value) {
+	out += std::to_string(value);
+}
+
+void AppendNode(
+		std::string &out,
+		const Node &node,
+		const Schema &schema) {
+	out += '{';
+	if (!node.prefix.empty()) {
+		out += "\"p\":";
+		AppendJsonString(out, node.prefix);
+		out += ',';
+	}
+	switch (node.type) {
+	case Node::Type::Object: {
+		out += "\"o\":";
+		AppendJsonString(out, DisplayName(node.name));
+		if (Linkable(node.name)) {
+			out += ",\"l\":1";
+		}
+		if (schema.find(node.name)) {
+			out += ",\"z\":1";
+		}
+		out += ",\"f\":[";
+		for (auto i = std::size_t(); i != node.items.size(); ++i) {
+			if (i) {
+				out += ',';
+			}
+			out += '[';
+			AppendJsonString(out, node.keys[i]);
+			out += ',';
+			AppendNode(out, node.items[i], schema);
+			out += ']';
+		}
+		out += ']';
+	} break;
+	case Node::Type::Vector: {
+		out += "\"v\":[";
+		for (auto i = std::size_t(); i != node.items.size(); ++i) {
+			if (i) {
+				out += ',';
+			}
+			AppendNode(out, node.items[i], schema);
+		}
+		out += "],\"n\":";
+		AppendNumber(out, node.count);
+		if (!node.name.empty() && node.name != "0x0") {
+			out += ",\"e\":";
+			AppendJsonString(out, node.name);
+		}
+	} break;
+	case Node::Type::Scalar: {
+		out += "\"s\":";
+		AppendJsonString(out, node.value);
+		out += ",\"t\":";
+		AppendJsonString(out, node.kind);
+		if (node.kind == "BYTES") {
+			out += ",\"n\":";
+			AppendNumber(out, node.count);
+			if (node.elided) {
+				out += ",\"x\":1";
+			}
+		}
+	} break;
+	case Node::Type::Flag: {
+		out += "\"g\":";
+		AppendJsonString(out, node.name);
+		out += ",\"b\":";
+		AppendNumber(out, node.count);
+	} break;
+	case Node::Type::Error: {
+		out += "\"err\":";
+		AppendJsonString(out, node.value);
+	} break;
+	}
+	out += '}';
+}
+
+void AppendList(std::string &out, const std::vector<std::string> &list) {
+	out += '[';
+	for (auto i = std::size_t(); i != list.size(); ++i) {
+		if (i) {
+			out += ',';
+		}
+		AppendJsonString(out, list[i]);
+	}
+	out += ']';
+}
+
+void AppendSuffix(std::string &out, std::string_view rest) {
+	const auto start = rest.find("(dc:");
+	if (start == std::string_view::npos) {
+		return;
+	}
+	auto inner = rest.substr(start + 1);
+	inner = inner.substr(0, inner.find(')'));
+	while (!inner.empty()) {
+		const auto comma = inner.find(',');
+		const auto part = inner.substr(0, comma);
+		const auto colon = part.find(':');
+		if (colon != std::string_view::npos) {
+			const auto key = part.substr(0, colon);
+			const auto name = (key == "dc")
+				? std::string_view("pdc")
+				: (key == "key")
+				? std::string_view("key")
+				: (key == "session")
+				? std::string_view("session")
+				: std::string_view();
+			if (!name.empty()) {
+				out += ',';
+				AppendJsonString(out, name);
+				out += ':';
+				AppendJsonString(out, part.substr(colon + 1));
+			}
+		}
+		if (comma == std::string_view::npos) {
+			break;
+		}
+		inner.remove_prefix(comma + 1);
+	}
+}
+
+[[nodiscard]] std::optional<std::vector<int>> PrimaryPath(
+		const Node &root,
+		const Schema &schema) {
+	auto result = std::vector<int>();
+	auto node = &root;
+	while (node->type == Node::Type::Object) {
+		const auto key = (node->name == "core_message")
+			? std::string_view("body")
+			: (node->name == "rpc_result")
+			? std::string_view("result")
+			: std::string_view();
+		if (key.empty()) {
+			break;
+		}
+		const auto i = std::find(
+			begin(node->keys),
+			end(node->keys),
+			key);
+		const auto index = int(i - begin(node->keys));
+		if (i == end(node->keys) || index >= int(node->items.size())) {
+			return std::nullopt;
+		}
+		result.push_back(index);
+		node = &node->items[index];
+	}
+	if (node->type != Node::Type::Object || !schema.find(node->name)) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+void Put32(std::string &out, std::uint32_t value) {
+	for (auto i = 0; i != 4; ++i) {
+		out += char((value >> (8 * i)) & 0xFF);
+	}
+}
+
+void Put64(std::string &out, std::uint64_t value) {
+	Put32(out, std::uint32_t(value & 0xFFFFFFFFULL));
+	Put32(out, std::uint32_t(value >> 32));
+}
+
+void PutBytes(std::string &out, std::string_view data) {
+	const auto size = data.size();
+	auto header = std::size_t(1);
+	if (size < 254) {
+		out += char(size);
+	} else {
+		header = 4;
+		out += char(254);
+		out += char(size & 0xFF);
+		out += char((size >> 8) & 0xFF);
+		out += char((size >> 16) & 0xFF);
+	}
+	out.append(data);
+	while ((header + size) % 4) {
+		out += char(0);
+		++header;
+	}
+}
+
+[[nodiscard]] int HexValue(char ch) {
+	return (ch >= '0' && ch <= '9')
+		? (ch - '0')
+		: (ch >= 'a' && ch <= 'f')
+		? (ch - 'a' + 10)
+		: (ch >= 'A' && ch <= 'F')
+		? (ch - 'A' + 10)
+		: -1;
+}
+
+[[nodiscard]] std::vector<unsigned long long> Unsigned(std::string_view text) {
+	auto result = std::vector<unsigned long long>();
+	auto position = std::size_t();
+	while (position < text.size()) {
+		const auto plus = text.find(" + ", position);
+		const auto part = text.substr(
+			position,
+			(plus == std::string_view::npos) ? plus : (plus - position));
+		auto value = 0ULL;
+		std::from_chars(part.data(), part.data() + part.size(), value);
+		result.push_back(value);
+		if (plus == std::string_view::npos) {
+			break;
+		}
+		position = plus + 3;
+	}
+	return result;
+}
+
+class Serializer final {
+public:
+	explicit Serializer(const Schema &schema) : _schema(schema) {
+	}
+
+	[[nodiscard]] bool boxed(const Node &node);
+	[[nodiscard]] Serialized take() {
+		return std::move(_result);
+	}
+
+private:
+	[[nodiscard]] bool fail(std::string text) {
+		if (_result.error.empty()) {
+			_result.error = std::move(text);
+		}
+		return false;
+	}
+	[[nodiscard]] bool fields(
+		const Node &node,
+		const Schema::Constructor &constructor);
+	[[nodiscard]] bool value(std::string_view type, const Node &node);
+	[[nodiscard]] bool vector(
+		std::string_view type,
+		const Node &node,
+		bool boxed);
+	[[nodiscard]] bool scalar(std::string_view type, const Node &node);
+
+	const Schema &_schema;
+	Serialized _result;
+
+};
+
+bool Serializer::boxed(const Node &node) {
+	if (node.type != Node::Type::Object) {
+		return fail("expected an object");
+	}
+	const auto constructor = _schema.find(node.name);
+	if (!constructor) {
+		return fail(std::string(node.name) + " is not in the schema");
+	}
+	Put32(_result.bytes, constructor->id);
+	return fields(node, *constructor);
+}
+
+bool Serializer::fields(
+		const Node &node,
+		const Schema::Constructor &constructor) {
+	auto flags = std::uint64_t();
+	auto first = std::string();
+	for (const auto &param : constructor.params) {
+		const auto field = Field(node, param.name);
+		if (param.type == "#") {
+			if (!first.empty() && param.name == first + '2') {
+				Put32(_result.bytes, std::uint32_t(flags >> 32));
+				continue;
+			}
+			first = param.name;
+			if (!field || field->type != Node::Type::Scalar) {
+				return fail("missing " + param.name + " in "
+					+ std::string(node.name));
+			}
+			flags = std::uint64_t(ToNumber(field->value));
+			Put32(_result.bytes, std::uint32_t(flags & 0xFFFFFFFFULL));
+			continue;
+		} else if (!param.flag.empty()) {
+			if (!field || param.type == "true") {
+				continue;
+			}
+		} else if (!field) {
+			return fail("missing " + param.name + " in "
+				+ std::string(node.name));
+		}
+		if (!value(param.type, *field)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool Serializer::value(std::string_view type, const Node &node) {
+	if (node.type == Node::Type::Error) {
+		return fail("the log could not decode this object");
+	} else if (type.starts_with("Vector<")) {
+		return vector(type.substr(7, type.size() - 8), node, true);
+	} else if (type.starts_with("vector<")) {
+		return vector(type.substr(7, type.size() - 8), node, false);
+	} else if (type == "int"
+		|| type == "long"
+		|| type == "double"
+		|| type == "string"
+		|| type == "bytes"
+		|| type == "int128"
+		|| type == "int256") {
+		return scalar(type, node);
+	} else if (type == "true") {
+		return true;
+	}
+	const auto bare = type.starts_with('%');
+	if (bare) {
+		type.remove_prefix(1);
+	}
+	const auto dot = type.rfind('.');
+	const auto last = (dot == std::string_view::npos)
+		? type
+		: type.substr(dot + 1);
+	if (!bare
+		&& (type.starts_with('!')
+			|| (!last.empty() && last[0] >= 'A' && last[0] <= 'Z'))) {
+		return boxed(node);
+	} else if (node.type != Node::Type::Object) {
+		return fail("expected an object of type " + std::string(type));
+	}
+	const auto constructor = _schema.find(node.name);
+	if (!constructor) {
+		return fail(std::string(node.name) + " is not in the schema");
+	}
+	return fields(node, *constructor);
+}
+
+bool Serializer::vector(
+		std::string_view type,
+		const Node &node,
+		bool boxed) {
+	if (node.type != Node::Type::Vector) {
+		return fail("expected a vector");
+	} else if (node.count != (long long)node.items.size()) {
+		return fail("the log has only a part of a vector");
+	}
+	if (boxed) {
+		Put32(_result.bytes, 0x1cb5c415U);
+	}
+	Put32(_result.bytes, std::uint32_t(node.items.size()));
+	for (const auto &item : node.items) {
+		if (!value(type, item)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool Serializer::scalar(std::string_view type, const Node &node) {
+	if (node.type != Node::Type::Scalar) {
+		return fail("expected " + std::string(type));
+	}
+	auto &out = _result.bytes;
+	if (type == "int") {
+		Put32(out, std::uint32_t(ToNumber(node.value)));
+	} else if (type == "long") {
+		Put64(out, std::uint64_t(ToNumber(node.value)));
+	} else if (type == "double") {
+		const auto value = QByteArray(
+			node.value.data(),
+			int(node.value.size())).toDouble();
+		auto bits = std::uint64_t();
+		std::memcpy(&bits, &value, sizeof(bits));
+		Put64(out, bits);
+	} else if (type == "int128" || type == "int256") {
+		const auto parts = Unsigned(node.value);
+		const auto count = (type == "int128") ? 2U : 4U;
+		if (parts.size() != count) {
+			return fail("could not read " + std::string(type));
+		}
+		for (auto i = count; i != 0; --i) {
+			Put64(out, parts[i - 1]);
+		}
+	} else if (node.kind == "BYTES") {
+		auto data = std::string();
+		for (auto i = std::size_t(); i + 1 < node.value.size(); i += 3) {
+			const auto high = HexValue(node.value[i]);
+			const auto low = HexValue(node.value[i + 1]);
+			if (high < 0 || low < 0) {
+				return fail("could not read bytes");
+			}
+			data += char((high << 4) | low);
+		}
+		if (node.count > (long long)data.size()) {
+			++_result.padded;
+			data.resize(std::size_t(node.count), char(0));
+		}
+		PutBytes(out, data);
+	} else if (node.kind == "STRING") {
+		PutBytes(out, node.value);
+	} else {
+		return fail("expected " + std::string(type));
+	}
+	return true;
+}
+
+[[nodiscard]] char KindChar(Kind kind) {
+	switch (kind) {
+	case Kind::Send: return 's';
+	case Kind::Recv: return 'r';
+	case Kind::Other: return 'o';
+	}
+	return 'o';
+}
+
+[[nodiscard]] bool ContainsFolded(
+		std::string_view text,
+		std::string_view term) {
+	if (term.empty()) {
+		return true;
+	} else if (std::none_of(begin(term), end(term), [](char ch) {
+		return (ch >= 'a' && ch <= 'z');
+	})) {
+		return text.find(term) != std::string_view::npos;
+	}
+	return std::search(
+		begin(text),
+		end(text),
+		begin(term),
+		end(term),
+		[](char a, char b) { return Fold(a) == b; }) != end(text);
+}
+
+} // namespace
+
+std::vector<Entry> SplitEntries(
+		std::string_view data,
+		bool middle,
+		std::size_t *consumed,
+		std::size_t *lines) {
+	auto result = std::vector<Entry>();
+	auto position = std::size_t();
+	auto counted = std::size_t();
+	if (middle) {
+		const auto newline = data.find('\n');
+		if (newline == std::string_view::npos) {
+			*consumed = 0;
+			*lines = 0;
+			return result;
+		}
+		position = newline + 1;
+		counted = 1;
+	}
+	auto open = false;
+	const auto finish = [&] {
+		if (open) {
+			Finalize(result.back());
+			open = false;
+		}
+	};
+	while (position < data.size()) {
+		const auto newline = data.find('\n', position);
+		if (newline == std::string_view::npos) {
+			break;
+		}
+		auto line = data.substr(position, newline - position);
+		position = newline + 1;
+		const auto index = counted++;
+		if (!line.empty() && line.back() == '\r') {
+			line.remove_suffix(1);
+		}
+		auto stamp = std::string_view();
+		auto dc = std::string_view();
+		auto text = std::string_view();
+		if (ParseHeader(line, &stamp, &dc, &text)) {
+			finish();
+			auto &entry = result.emplace_back();
+			entry.line = (long long)index;
+			entry.stamp = std::string(stamp);
+			entry.dc = std::string(dc);
+			entry.text = std::string(text);
+			open = true;
+		} else if (line.starts_with("----------------")
+			|| line == "NEW LOGGING INSTANCE STARTED!!!") {
+			finish();
+		} else if (open) {
+			result.back().text += '\n';
+			result.back().text += line;
+		}
+	}
+	finish();
+	*consumed = position;
+	*lines = counted;
+	return result;
+}
+
+void AppendJsonString(std::string &out, std::string_view value) {
+	constexpr auto kHex = std::string_view("0123456789abcdef");
+	out += '"';
+	for (const auto ch : value) {
+		switch (ch) {
+		case '"': out += "\\\""; break;
+		case '\\': out += "\\\\"; break;
+		case '\n': out += "\\n"; break;
+		case '\r': out += "\\r"; break;
+		case '\t': out += "\\t"; break;
+		default:
+			if (static_cast<unsigned char>(ch) < 0x20) {
+				out += "\\u00";
+				out += kHex[(ch >> 4) & 0x0F];
+				out += kHex[ch & 0x0F];
+			} else {
+				out += ch;
+			}
+		}
+	}
+	out += '"';
+}
+
+void AppendSummary(std::string &out, const Entry &entry) {
+	out += "\"t\":";
+	AppendJsonString(out, std::string_view(entry.stamp).substr(0, 12));
+	out += ",\"d\":";
+	AppendJsonString(out, entry.dc);
+	out += ",\"k\":\"";
+	out += KindChar(entry.kind);
+	out += "\",\"n\":";
+	AppendJsonString(out, entry.name);
+	out += ",\"s\":";
+	AppendNumber(out, entry.size);
+	if (!entry.msgIds.empty()) {
+		out += ",\"m\":";
+		AppendList(out, entry.msgIds);
+	}
+	if (!entry.msgNames.empty()) {
+		out += ",\"mn\":";
+		AppendList(out, entry.msgNames);
+	}
+	if (!entry.requestIds.empty()) {
+		out += ",\"r\":";
+		AppendList(out, entry.requestIds);
+		out += ",\"rn\":";
+		AppendList(out, entry.requestNames);
+	}
+}
+
+void AppendDetail(
+		std::string &out,
+		const Entry &entry,
+		const Schema &schema) {
+	AppendSummary(out, entry);
+	out += ",\"q\":";
+	AppendJsonString(out, entry.stamp);
+	if (entry.line > 0) {
+		out += ",\"ln\":";
+		AppendNumber(out, entry.line);
+	}
+	out += ",\"raw\":";
+	AppendJsonString(
+		out,
+		'[' + entry.stamp + "] (dc:" + entry.dc + ") " + entry.text);
+	if (entry.kind == Kind::Other) {
+		out += ",\"tree\":null";
+		return;
+	}
+	const auto parsed = Parse(std::string_view(entry.text).substr(6));
+	out += ",\"tree\":";
+	AppendNode(out, parsed.root, schema);
+	if (const auto primary = PrimaryPath(parsed.root, schema)) {
+		out += ",\"pp\":[";
+		for (auto i = std::size_t(); i != primary->size(); ++i) {
+			if (i) {
+				out += ',';
+			}
+			AppendNumber(out, (*primary)[i]);
+		}
+		out += ']';
+	}
+	if (parsed.partial) {
+		out += ",\"partial\":true";
+	}
+	AppendSuffix(out, parsed.rest);
+}
+
+void Schema::add(std::string_view text) {
+	auto position = std::size_t();
+	while (position < text.size()) {
+		const auto newline = text.find('\n', position);
+		auto line = text.substr(
+			position,
+			(newline == std::string_view::npos)
+				? std::string_view::npos
+				: (newline - position));
+		position = (newline == std::string_view::npos)
+			? text.size()
+			: (newline + 1);
+		if (const auto comment = line.find("//")
+			; comment != std::string_view::npos) {
+			line = line.substr(0, comment);
+		}
+		const auto equals = line.find(" = ");
+		const auto hash = line.find('#');
+		const auto space = line.find(' ');
+		if (equals == std::string_view::npos
+			|| hash == std::string_view::npos
+			|| hash == 0
+			|| hash > equals
+			|| (space != std::string_view::npos && space < hash)) {
+			continue;
+		}
+		const auto name = line.substr(0, hash);
+		const auto till = std::min(space, equals);
+		const auto hex = line.substr(hash + 1, till - hash - 1);
+		auto constructor = Constructor();
+		const auto parsed = std::from_chars(
+			hex.data(),
+			hex.data() + hex.size(),
+			constructor.id,
+			16);
+		if (parsed.ec != std::errc() || name == "vector") {
+			continue;
+		}
+		auto params = (space < equals)
+			? line.substr(space + 1, equals - space - 1)
+			: std::string_view();
+		while (!params.empty()) {
+			const auto next = params.find(' ');
+			const auto token = params.substr(0, next);
+			params = (next == std::string_view::npos)
+				? std::string_view()
+				: params.substr(next + 1);
+			const auto colon = token.find(':');
+			if (token.empty()
+				|| token.front() == '{'
+				|| colon == std::string_view::npos) {
+				continue;
+			}
+			auto param = Param{ .name = std::string(token.substr(0, colon)) };
+			auto type = token.substr(colon + 1);
+			if (const auto question = type.find('?')
+				; question != std::string_view::npos) {
+				param.flag = std::string(type.substr(0, question));
+				type.remove_prefix(question + 1);
+			}
+			param.type = std::string(type);
+			constructor.params.push_back(std::move(param));
+		}
+		auto key = std::string(name);
+		std::replace(begin(key), end(key), '.', '_');
+		_constructors[std::move(key)] = std::move(constructor);
+	}
+}
+
+const Schema::Constructor *Schema::find(std::string_view name) const {
+	const auto i = _constructors.find(name);
+	return (i != end(_constructors)) ? &i->second : nullptr;
+}
+
+Serialized Serialize(
+		const Schema &schema,
+		const Entry &entry,
+		const std::vector<int> &path,
+		bool primary) {
+	auto result = Serialized();
+	if (entry.kind == Kind::Other) {
+		result.error = "this entry has no object";
+		return result;
+	}
+	const auto parsed = Parse(std::string_view(entry.text).substr(6));
+	auto way = path;
+	if (primary) {
+		const auto found = PrimaryPath(parsed.root, schema);
+		if (!found) {
+			result.error = "this entry has no single object";
+			return result;
+		}
+		way = *found;
+	}
+	auto node = &parsed.root;
+	for (const auto index : way) {
+		if ((node->type != Node::Type::Object
+				&& node->type != Node::Type::Vector)
+			|| index < 0
+			|| index >= int(node->items.size())) {
+			result.error = "this object is not in the entry";
+			return result;
+		}
+		node = &node->items[index];
+	}
+	auto serializer = Serializer(schema);
+	if (!serializer.boxed(*node)) {
+		auto failed = serializer.take();
+		failed.bytes.clear();
+		return failed;
+	}
+	return serializer.take();
+}
+
+std::vector<std::string> SplitQuery(std::string_view query) {
+	auto result = std::vector<std::string>();
+	auto current = std::string();
+	for (const auto ch : query) {
+		if (IsSpace(ch)) {
+			if (!current.empty()) {
+				result.push_back(std::move(current));
+				current = std::string();
+			}
+		} else {
+			current += Fold(ch);
+		}
+	}
+	if (!current.empty()) {
+		result.push_back(std::move(current));
+	}
+	return result;
+}
+
+bool Matches(const Entry &entry, const std::vector<std::string> &terms) {
+	for (const auto &term : terms) {
+		if (ContainsFolded(entry.name, term)
+			|| ContainsFolded(entry.dc, term)
+			|| ContainsFolded(entry.text, term)) {
+			continue;
+		}
+		const auto dot = term.find('.');
+		if (dot == std::string::npos) {
+			return false;
+		}
+		auto alternative = term;
+		alternative[dot] = '_';
+		if (!ContainsFolded(entry.text, alternative)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+} // namespace Tele::MtpDump
