index 0000000000000000000000000000000000000000..1bbd824d98157876e2d387d4ab6107ba15029b83
--- /dev/null
+++ b/Telegram/Resources/tele_html/mtp_inspector.html
@@ -0,0 +1,29 @@
+<!DOCTYPE html>
+<html style="__TELE_STYLES__" data-lower="__TELE_LOWER__" data-query="__TELE_QUERY__">
+<head>
+<meta charset="utf-8">
+<meta name="robots" content="noindex, nofollow">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>MTProto inspector</title>
+<link rel="stylesheet" href="inspector.css">
+<script src="inspector.js"></script>
+</head>
+<body>
+<header id="bar">
+<input id="filter" type="text" spellcheck="false" autocomplete="off" placeholder="Filter by constructor, method or any value">
+<div class="chips" id="kinds"></div>
+<div class="chips" id="dcs"></div>
+<span class="grow"></span>
+<button id="refresh" class="ui" type="button">Refresh</button>
+<button id="folder" class="ui" type="button">Logs folder</button>
+<button id="clear" class="ui danger" type="button">Clear</button>
+</header>
+<div id="status" class="ui"></div>
+<main id="main">
+<section id="list" tabindex="0"><div id="spacer"></div><div id="rows"></div><div id="empty" class="ui"></div></section>
+<div id="split"></div>
+<section id="detail"><div id="placeholder" class="ui">Select an entry to inspect it.</div></section>
+</main>
+<div id="confirm" class="modal"><div class="modal-box"><div id="confirm-text" class="ui"></div><div class="modal-buttons"><button id="confirm-cancel" class="ui" type="button"></button><button id="confirm-ok" class="ui danger" type="button"></button></div></div></div>
+</body>
+</html>
diff --git a/Telegram/Resources/tele_html/mtp_inspector.js b/Telegram/Resources/tele_html/mtp_inspector.js
new file mode 100644
index 0000000000000000000000000000000000000000..e10953d54a19f0f4522a71ea8c69287b07d56ddc
--- /dev/null
+++ b/Telegram/Resources/tele_html/mtp_inspector.js
@@ -0,0 +1,1078 @@
+(function () {
+'use strict';
+
+const kSchema = 'https://schema.jppgr.am/constructor/';
+const kStringLimit = 300;
+const kExpandDepth = 3;
+const kVectorOpenLimit = 40;
+const kKinds = [['s', 'send'], ['r', 'recv'], ['o', 'other']];
+const kWrappers = new Set(['core_message', 'msg_container', 'rpc_result', 'initConnection']);
+
+const state = {
+	info: null,
+	entries: [],
+	byId: new Map(),
+	sent: new Map(),
+	answers: new Map(),
+	offDcs: new Set(),
+	kinds: { s: true, r: true, o: false },
+	query: '',
+	matches: null,
+	view: [],
+	selected: 0,
+	detail: null,
+	nonce: 0,
+	queryTimer: 0,
+	queryToken: 0,
+	listToken: 0,
+	last: -1,
+	loading: false,
+	pollTimer: 0,
+	detailToken: 0,
+	from: -1,
+	till: -1,
+	flashTimer: 0,
+};
+const els = {};
+
+function post(message) {
+	if (window.external && window.external.invoke) {
+		window.external.invoke(JSON.stringify(message));
+	}
+}
+
+function fetchJson(path) {
+	return fetch(path, { cache: 'no-store' }).then(function (response) {
+		if (!response.ok) {
+			throw new Error(String(response.status));
+		}
+		return response.json();
+	});
+}
+
+function hex(text) {
+	const bytes = new TextEncoder().encode(text);
+	let result = '';
+	for (let i = 0; i < bytes.length; ++i) {
+		result += bytes[i].toString(16).padStart(2, '0');
+	}
+	return result;
+}
+
+function el(tag, className, text) {
+	const result = document.createElement(tag);
+	if (className) {
+		result.className = className;
+	}
+	if (text !== undefined) {
+		result.textContent = text;
+	}
+	return result;
+}
+
+function span(className, text) {
+	return el('span', className, text);
+}
+
+function link(className, text, callback, title) {
+	const result = span(className, text);
+	result.addEventListener('click', function (e) {
+		e.preventDefault();
+		e.stopPropagation();
+		callback();
+	});
+	if (title) {
+		result.title = title;
+	}
+	return result;
+}
+
+function rowHeight() {
+	return parseInt(getComputedStyle(document.documentElement).getPropertyValue('--row'), 10) || 24;
+}
+
+function flash(text, duration) {
+	els.flash.textContent = text;
+	els.flash.classList.add('shown');
+	clearTimeout(state.flashTimer);
