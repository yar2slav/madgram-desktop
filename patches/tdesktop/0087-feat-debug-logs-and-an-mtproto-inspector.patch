+[[nodiscard]] QByteArray Resource(const QString &name) {
+	auto file = QFile(u":/tele/"_q + name);
+	return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+}
+
+[[nodiscard]] QByteArray Page(const QString &query) {
+	auto result = Resource(u"mtp_inspector.html"_q);
+	result.replace("__TELE_STYLES__", Ui::EscapeForAttribute(ComputeStyles()));
+	result.replace("__TELE_LOWER__", LowercaseStrings() ? "1" : "0");
+	result.replace("__TELE_QUERY__", Ui::EscapeForAttribute(query.toUtf8()));
+	return result;
+}
