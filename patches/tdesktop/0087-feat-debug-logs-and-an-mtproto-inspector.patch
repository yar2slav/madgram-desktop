+void AppendJsonString(std::string &out, std::string_view value);
+void AppendSummary(std::string &out, const Entry &entry);
+void AppendDetail(
+	std::string &out,
+	const Entry &entry,
+	const Schema &schema);
+[[nodiscard]] Serialized Serialize(
+	const Schema &schema,
+	const Entry &entry,
+	const std::vector<int> &path,
+	bool primary);
+
+[[nodiscard]] std::vector<std::string> SplitQuery(std::string_view query);
+[[nodiscard]] bool Matches(
+	const Entry &entry,
+	const std::vector<std::string> &terms);
+
