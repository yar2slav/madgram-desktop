+void OpenLogsFolder() {
+	QDesktopServices::openUrl(QUrl::fromLocalFile(DebugLogsFolder()));
+}
+
+[[nodiscard]] BareId BarePeerId(PeerId id) {
+	return peerIsUser(id)
