+	std::size_t *lines);
+
+class Schema final {
+public:
+	struct Param {
+		std::string name;
+		std::string type;
+		std::string flag;
+	};
+	struct Constructor {
+		std::uint32_t id = 0;
+		std::vector<Param> params;
+	};
+
+	void add(std::string_view text);
+	[[nodiscard]] const Constructor *find(std::string_view name) const;
+
+private:
+	std::map<std::string, Constructor, std::less<>> _constructors;
+
+};
+
+struct Serialized {
+	std::string bytes;
+	std::string error;
+	int padded = 0;
+};
