+	Send,
+	Recv,
+	Other,
+};
+
+struct Entry {
+	std::string stamp;
+	std::string dc;
+	std::string text;
+	std::string name;
+	std::vector<std::string> msgIds;
+	std::vector<std::string> msgNames;
+	std::vector<std::string> requestIds;
+	std::vector<std::string> requestNames;
+	long long line = 0;
+	int size = 0;
+	Kind kind = Kind::Other;
+};
