@@ -0,0 +1,133 @@
+#include "tele/tele_debug_logs.h"
+
+#include "tele/tele_lowercase.h"
+#include "ui/text/format_values.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QTime>
+
+namespace Tele {
+namespace {
+
+constexpr auto kSwitchEach = 15;
+
+rpl::event_stream<> ClearedEvents;
+
+[[nodiscard]] QStringList FilesInUse() {
+	if (!Logs::DebugEnabled()) {
+		return {};
+	}
+	const auto now = QTime::currentTime();
+	const auto part = ((now.hour() * 60 + now.minute()) / kSwitchEach)
+		* kSwitchEach;
+	const auto postfix = u"_%1_%2.txt"_q
+		.arg(part / 60, 2, 10, QChar('0'))
+		.arg(part % 60, 2, 10, QChar('0'));
+	return { u"log"_q + postfix, u"mtp"_q + postfix };
+}
+
+[[nodiscard]] QString Files(int count) {
+	return (count == 1) ? u"1 file"_q : u"%1 files"_q.arg(count);
+}
+
+struct Scan {
+	QFileInfoList files;
+	int kept = 0;
+};
+
+[[nodiscard]] Scan ScanFolder() {
+	const auto inUse = FilesInUse();
+	auto result = Scan();
+	for (const auto &info : QDir(DebugLogsFolder()).entryInfoList(
+			QDir::Files | QDir::Hidden | QDir::System)) {
+		if (inUse.contains(info.fileName())) {
+			++result.kept;
+		} else {
+			result.files.push_back(info);
+		}
+	}
+	return result;
+}
+
+} // namespace
+
+QString DebugLogsFolder() {
+	return cWorkingDir() + u"DebugLogs"_q;
+}
+
+DebugLogsInfo CountDebugLogs() {
+	const auto scan = ScanFolder();
+	auto result = DebugLogsInfo{
+		.files = int(scan.files.size()),
+		.kept = scan.kept,
+	};
+	for (const auto &info : scan.files) {
+		result.bytes += info.size();
+	}
+	return result;
+}
+
+QString DebugLogsLabel(const DebugLogsInfo &info) {
+	return info.files
+		? Lower(Files(info.files) + u", "_q + Ui::FormatSizeText(info.bytes))
+		: Lower(u"Nothing to clear"_q);
+}
+
+QString ClearDebugLogsQuestion(const DebugLogsInfo &info) {
+	auto result = u"Delete %1 (%2) from DebugLogs?"_q
+		.arg(Files(info.files), Ui::FormatSizeText(info.bytes));
+	if (info.kept) {
+		result += u"\n\nThe %1 the app is writing right now will be kept, "
+			"they can be cleared once they rotate within 15 minutes "
+			"or after a restart."_q.arg(Files(info.kept));
+	}
+	return Lower(result);
+}
+
+QString NothingToClearText(const DebugLogsInfo &info) {
+	return Lower(info.kept
+		? u"Only the logs the app is writing right now are left."_q
+		: u"There are no debug logs to clear."_q);
+}
+
+void ClearDebugLogs(Fn<void(QString)> done) {
+	crl::async([=] {
+		const auto scan = ScanFolder();
+		auto removed = 0;
+		auto kept = scan.kept;
+		auto bytes = qint64();
+		for (const auto &info : scan.files) {
+			const auto size = info.size();
+			if (QFile::remove(info.absoluteFilePath())) {
+				++removed;
+				bytes += size;
+			} else {
+				++kept;
+			}
+		}
+		auto text = removed
+			? u"Deleted %1, %2."_q.arg(
+				Files(removed),
+				Ui::FormatSizeText(bytes))
+			: u"Nothing was deleted."_q;
+		if (kept) {
+			text += u" %1 in use by the app stayed, "
+				"they can be cleared after they rotate "
+				"or after a restart."_q.arg(Files(kept));
+		}
+		crl::on_main([=, text = Lower(text)] {
+			ClearedEvents.fire({});
+			if (done) {
+				done(text);
+			}
+		});
+	});
+}
+
+rpl::producer<> DebugLogsCleared() {
+	return ClearedEvents.events();
+}
+
+} // namespace Tele
