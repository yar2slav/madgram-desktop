+		{ "filter-input-border-fg", &st::filterInputBorderFg },
+		{ "filter-input-inactive-bg", &st::filterInputInactiveBg },
+		{ "box-divider-bg", &st::boxDividerBg },
+		{ "scroll-bar-bg", &st::scrollBarBg },
+		{ "scroll-bar-bg-over", &st::scrollBarBgOver },
+		{ "attention-button-fg", &st::attentionButtonFg },
