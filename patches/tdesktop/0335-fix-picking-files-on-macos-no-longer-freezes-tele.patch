diff --git a/Telegram/SourceFiles/tele/tele_file_dialog.cpp b/Telegram/SourceFiles/tele/tele_file_dialog.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cf4bd0e282234d32b7c550519fe96537c97b7f86
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_file_dialog.cpp
@@ -0,0 +1,192 @@
+#include "tele/tele_file_dialog.h"
+
+#include "base/invoke_queued.h"
+#include "base/platform/base_platform_info.h"
+#include "core/application.h"
+#include "core/file_utilities.h"
+#include "platform/platform_file_utilities.h"
+#include "settings.h"
+#include "storage/localstorage.h"
+#include "ui/delayed_activation.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtWidgets/QFileDialog>
+
+namespace Tele {
+namespace {
+
+using Type = FileDialog::internal::Type;
+
+void Open(
+		QPointer<QWidget> parent,
+		const QString &caption,
+		const QString &filter,
+		Type type,
+		QString startFile,
+		Fn<void(QStringList &&files)> done,
+		Fn<void()> failed) {
+	if (cDialogLastPath().isEmpty()) {
+		Platform::FileDialog::InitLastPath();
+	}
+	if (startFile.isEmpty() || startFile.at(0) != '/') {
+		startFile = cDialogLastPath() + '/' + startFile;
+	}
+	const auto window = (parent && parent->window()->isVisible())
+		? parent->window()
+		: Core::App().getFileDialogParent();
+	const auto dialog = new QFileDialog(
+		(window && window->isVisible()) ? window : nullptr,
+		caption,
+		QString(),
+		filter);
+	const auto info = QFileInfo(startFile);
+	if (info.isDir()) {
+		dialog->setDirectory(startFile);
+	} else {
+		dialog->setDirectory(info.absolutePath());
+		if (!info.fileName().isEmpty()) {
+			dialog->selectFile(info.fileName());
+		}
+	}
+	switch (type) {
+	case Type::ReadFile:
+		dialog->setFileMode(QFileDialog::ExistingFile);
+		break;
+	case Type::ReadFiles:
+		dialog->setFileMode(QFileDialog::ExistingFiles);
+		break;
+	case Type::ReadFolder:
+		dialog->setFileMode(QFileDialog::Directory);
+		dialog->setOption(QFileDialog::ShowDirsOnly);
+		break;
+	case Type::WriteFile:
+		dialog->setFileMode(QFileDialog::AnyFile);
+		dialog->setAcceptMode(QFileDialog::AcceptSave);
+		break;
+	}
+
+	const auto finished = std::make_shared<bool>(false);
+	const auto deliver = [=](QStringList files) {
+		*finished = true;
+		InvokeQueued(QCoreApplication::instance(), [=] {
+			if (!Core::IsAppLaunched() || Core::Quitting()) {
+				return;
+			}
+			Core::App().notifyFileDialogShown(false);
+			if (files.isEmpty() || files.front().isEmpty()) {
+				if (failed) {
+					failed();
+				}
+				return;
+			}
+			if (type != Type::ReadFolder) {
+				const auto path = QFileInfo(
+					files.back()).absoluteDir().absolutePath();
+				if (!path.isEmpty() && path != cDialogLastPath()) {
+					cSetDialogLastPath(path);
+					Local::writeSettings();
+				}
+			}
+			done(QStringList(files));
+		});
+	};
+	QObject::connect(dialog, &QObject::destroyed, [=] {
+		if (!*finished) {
+			deliver(QStringList());
+		}
+	});
+	QObject::connect(dialog, &QDialog::finished, [=](int result) {
+		if (*finished) {
+			return;
+		}
+		dialog->deleteLater();
+		deliver((result == QDialog::Accepted)
+			? dialog->selectedFiles()
+			: QStringList());
+	});
+
+	Ui::PreventDelayedActivation();
+	Core::App().notifyFileDialogShown(true);
+	dialog->open();
+}
+
+} // namespace
+
+bool GetOpenPathSheet(
+		QPointer<QWidget> parent,
+		const QString &caption,
+		const QString &filter,
+		Fn<void(FileDialog::OpenResult &&result)> callback,
+		Fn<void()> failed) {
+	if (!Platform::IsMac()) {
+		return false;
+	}
+	Open(parent, caption, filter, Type::ReadFile, QString(), [=](
+			QStringList &&files) {
+		if (callback) {
+			auto result = FileDialog::OpenResult();
+			result.paths.push_back(files.front());
+			callback(std::move(result));
+		}
+	}, failed);
+	return true;
+}
+
+bool GetOpenPathsSheet(
+		QPointer<QWidget> parent,
+		const QString &caption,
+		const QString &filter,
+		Fn<void(FileDialog::OpenResult &&result)> callback,
+		Fn<void()> failed) {
+	if (!Platform::IsMac()) {
+		return false;
+	}
+	Open(parent, caption, filter, Type::ReadFiles, QString(), [=](
+			QStringList &&files) {
+		if (callback) {
+			auto result = FileDialog::OpenResult();
+			result.paths = std::move(files);
+			callback(std::move(result));
+		}
+	}, failed);
+	return true;
+}
+
+bool GetWritePathSheet(
+		QPointer<QWidget> parent,
+		const QString &caption,
+		const QString &filter,
+		const QString &initialPath,
+		Fn<void(QString &&result)> callback,
+		Fn<void()> failed) {
+	if (!Platform::IsMac()) {
+		return false;
+	}
+	Open(parent, caption, filter, Type::WriteFile, initialPath, [=](
+			QStringList &&files) {
+		if (callback) {
+			callback(QString(files.front()));
+		}
+	}, failed);
+	return true;
+}
+
+bool GetFolderSheet(
+		QPointer<QWidget> parent,
+		const QString &caption,
+		const QString &initialPath,
+		Fn<void(QString &&result)> callback,
+		Fn<void()> failed) {
+	if (!Platform::IsMac()) {
+		return false;
+	}
+	Open(parent, caption, QString(), Type::ReadFolder, initialPath, [=](
+			QStringList &&files) {
+		if (callback) {
+			callback(QString(files.front()));
+		}
+	}, failed);
+	return true;
+}
+
+} // namespace Tele
