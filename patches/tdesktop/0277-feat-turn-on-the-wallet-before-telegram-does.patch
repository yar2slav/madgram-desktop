From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Fri, 9 Oct 2026 13:30:42 +0300
Subject: [PATCH] feat: turn on the wallet before telegram does

---
 Telegram/SourceFiles/main/main_app_config.cpp   |  3 ++-
 Telegram/SourceFiles/settings/settings_tele.cpp |  6 ++++++
 Telegram/SourceFiles/tele/tele_options.cpp      | 12 ++++++++++++
 Telegram/SourceFiles/tele/tele_options.h        |  2 ++
 Telegram/SourceFiles/tele/tele_settings_io.cpp  |  1 +
 5 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/main/main_app_config.cpp b/Telegram/SourceFiles/main/main_app_config.cpp
index 1eb3184295c03b31ba0b2c410080729b8cce7539..c7e82aa9d9257ba8728a3cc6534af2678b36e5b4 100644
--- a/Telegram/SourceFiles/main/main_app_config.cpp
+++ b/Telegram/SourceFiles/main/main_app_config.cpp
@@ -14,6 +14,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "data/data_session.h"
 #include "main/main_account.h"
 #include "main/main_session.h"
+#include "tele/tele_options.h"
 #include "test/test_l10n_seams.h"
 #include "ui/chat/chat_style.h"
 
@@ -276,7 +277,7 @@ QString AppConfig::oldWalletBotUsername() const {
 }
 
 bool AppConfig::walletAvailable() const {
-	return get<bool>(u"wallet_available"_q, true);
+	return Tele::ForceWallet() || get<bool>(u"wallet_available"_q, true);
 }
 
 int AppConfig::storiesAlbumLimit() const {
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index fb6187901d1b707f2c79f08dbd6a90ceb7bf0e00..938a5abb42c7896d5048b60a5dd2e12c64594791 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -4015,6 +4015,12 @@ void FillDebug(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionFontFix,
 		{ u"font family"_q, u"cut off"_q, u"directwrite"_q, u"google sans"_q });
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Experimental"_q);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionForceWallet,
+		{ u"money"_q, u"ton"_q, u"crypto"_q, u"gram"_q });
 	AddSkip(builder);
 }
 
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 9b5ada0ca86b4ec30928748f1b2abdd4fbf854d7..af90b31f2919dca7a17fbfbb406b581d4bbe0b17 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -36,6 +36,7 @@ const char kOptionLowercase[] = "tele-lowercase";
 const char kOptionScaleOnePercent[] = "tele-scale-1";
 const char kOptionSmallWindow[] = "tele-small-window";
 const char kOptionFontFix[] = "tele-font-fix";
+const char kOptionForceWallet[] = "tele-force-wallet";
 const char kOptionHideSponsored[] = "tele-hide-sponsored";
 const char kOptionHideProxySponsor[] = "tele-hide-proxy-sponsor";
 const char kOptionNoLinkWarning[] = "tele-no-link-warning";
@@ -408,6 +409,13 @@ base::options::toggle FontFixOption({
 	.restartRequired = true,
 });
 
+base::options::toggle ForceWalletOption({
+	.id = kOptionForceWallet,
+	.name = "Wallet before telegram turns it on",
+	.description = "The server may still refuse it for your account.",
+	.restartRequired = true,
+});
+
 base::options::toggle HideCallsOption({
 	.id = kOptionHideCalls,
 });
@@ -1861,6 +1869,10 @@ bool FontFix() {
 	return FontFixOption.value();
 }
 
+bool ForceWallet() {
+	return ForceWalletOption.value();
+}
+
 QString CallButton() {
 	MigrateHideCalls();
 	return CallButtonOption.value();
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index eef54ec51147ad0fe23f80653ecef27960cc1fc4..55489fbbf983fb53ace85b8a273a51419dfcd981 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -31,6 +31,7 @@ extern const char kOptionLowercase[];
 extern const char kOptionScaleOnePercent[];
 extern const char kOptionSmallWindow[];
 extern const char kOptionFontFix[];
+extern const char kOptionForceWallet[];
 extern const char kOptionHideSponsored[];
 extern const char kOptionHideProxySponsor[];
 extern const char kOptionNoLinkWarning[];
@@ -272,6 +273,7 @@ void SetKnownSettings(const QString &value);
 [[nodiscard]] bool SmallWindow();
 [[nodiscard]] rpl::producer<> SmallWindowChanges();
 [[nodiscard]] bool FontFix();
+[[nodiscard]] bool ForceWallet();
 [[nodiscard]] QString CallButton();
 void SetCallButton(const QString &value);
 [[nodiscard]] rpl::producer<QString> CallButtonValue();
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index bcdfaf4450be1c9ab04a6f7eb9fa8d558fc8f4e0..48c79fbd774e528cdb00c01392bb88d861d54372 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
+++ b/Telegram/SourceFiles/tele/tele_settings_io.cpp
@@ -124,6 +124,7 @@ struct Spec {
 		Toggle(kOptionScaleOnePercent),
 		Toggle(kOptionSmallWindow),
 		Toggle(kOptionFontFix),
+		Toggle(kOptionForceWallet),
 		Toggle(kOptionHideSponsored),
 		Toggle(kOptionHideProxySponsor),
 		Toggle(kOptionNoLinkWarning),
