@@ -438,6 +482,65 @@ void AttachSavedCover(
 	return QImage();
 }
 
+[[nodiscard]] bool Empty(const Tray &tray) {
+	return tray.items.empty() && !tray.sticker;
+}
+
+[[nodiscard]] QImage StickerFrame(
+		not_null<DocumentData*> document,
+		not_null<Data::DocumentMedia*> media) {
+	const auto sticker = document->sticker();
+	if (!sticker || !media->loaded()) {
+		return QImage();
+	}
+	const auto bytes = Lottie::ReadContent(
+		media->bytes(),
+		document->filepath());
+	if (bytes.isEmpty()) {
+		return QImage();
+	}
+	auto generator = std::unique_ptr<Ui::FrameGenerator>();
+	switch (sticker->type) {
+	case StickerType::Tgs:
+		generator = std::make_unique<Lottie::FrameGenerator>(bytes);
+		break;
+	case StickerType::Webm:
+		generator = std::make_unique<FFmpeg::FrameGenerator>(bytes);
+		break;
+	case StickerType::Webp:
+		generator = std::make_unique<Ui::ImageFrameGenerator>(bytes);
+		break;
+	}
+	if (!generator) {
+		return QImage();
+	}
+	const auto side = Scaled(72) * style::DevicePixelRatio();
+	return generator->renderNext(
+		QImage(),
+		QSize(side, side),
+		Qt::KeepAspectRatio).image;
+}
+
+bool RefreshSticker(Tray &tray) {
+	if (!tray.sticker || tray.sticker->ready) {
+		return false;
+	}
+	auto &sticker = *tray.sticker;
+	auto frame = StickerFrame(sticker.document, sticker.media.get());
+	if (!frame.isNull()) {
+		sticker.image = std::move(frame);
+		sticker.ready = true;
+		return true;
+	} else if (!sticker.image.isNull()) {
+		return false;
+	} else if (const auto thumbnail = sticker.media->thumbnail()) {
+		sticker.image = thumbnail->original();
+		sticker.ready = !sticker.document->sticker();
+		return !sticker.image.isNull();
+	}
+	return false;
+}
