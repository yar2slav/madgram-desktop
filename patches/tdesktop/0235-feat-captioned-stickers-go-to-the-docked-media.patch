+void DockedStore::addSticker(
+		DockedKey key,
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<DocumentData*> document) {
+	auto &tray = _trays[key];
+	tray.show = std::move(show);
+	tray.collapsed = false;
+	if (!tray.sticker || tray.sticker->document != document) {
+		auto media = document->createMediaView();
+		media->checkStickerLarge();
+		if (!document->sticker()) {
+			document->loadThumbnail(document->stickerOrGifOrigin());
+		}
+		tray.sticker = DockedSticker{
+			.document = document,
+			.media = std::move(media),
+			.id = ++_autoId,
+		};
+		RefreshSticker(tray);
+	}
+	notify(key);
+}
+
+void DockedStore::removeSticker(DockedKey key) {
+	const auto tray = lookup(key);
+	if (!tray || !tray->sticker) {
+		return;
+	}
+	tray->sticker = std::nullopt;
+	if (Empty(*tray)) {
+		_trays.erase(key);
+	}
+	notify(key);
+}
+
+DocumentData *DockedStore::sticker(DockedKey key) const {
+	const auto tray = find(key);
+	return (tray && tray->sticker) ? tray->sticker->document.get() : nullptr;
+}
+
+bool DockedStore::hasItems(DockedKey key) const {
+	const auto tray = find(key);
+	return tray && !tray->items.empty();
+}
+
+void DockedStore::refreshStickers() {
+	auto changed = std::vector<DockedKey>();
+	for (auto &[key, tray] : _trays) {
+		if (RefreshSticker(tray)) {
+			changed.push_back(key);
+		}
+	}
+	for (const auto &key : changed) {
+		notify(key);
+	}
+}
