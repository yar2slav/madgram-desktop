+[[nodiscard]] bool StickerFile(const Ui::PreparedFile &file, bool compress) {
+	if (!file.information) {
+		return false;
+	}
+	using Video = Ui::PreparedFileInformation::Video;
+	const auto &mime = file.information->filemime;
+	if (const auto video = std::get_if<Video>(&file.information->media)) {
+		return video->isWebmSticker && (mime == u"video/webm"_q);
+	}
+	return Core::IsMimeStickerAnimated(mime)
+		|| (Core::IsMimeSticker(mime)
+			&& !(compress && file.type == FileType::Photo));
+}
+
+[[nodiscard]] QString TitleText(const Tray &tray) {
+	const auto compress = tray.way.sendImagesAsPhotos();
