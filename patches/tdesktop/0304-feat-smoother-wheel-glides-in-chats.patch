diff --git a/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp b/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp
index e0b2bede571db9fff706a3631b8b1aff645abc09..62a3e2b9f1dc09dd361afbdeafbdb0fddfeff194 100644
--- a/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp
+++ b/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp
@@ -1,9 +1,194 @@
 #include "tele/tele_smooth_scroll.h"
 
 #include "tele/tele_options.h"
+#include "tele/tele_scroll_layer.h"
+#include "tele/tele_scroll_stats.h"
+#include "base/timer.h"
+#include "ui/rp_widget.h"
 #include "ui/widgets/smooth_wheel.h"
 
+#include <QtCore/QCoreApplication>
+#include <QtCore/QPointer>
+
 namespace Tele {
+namespace {
+
+constexpr auto kDownloadsRepaintDelay = crl::time(100);
+constexpr auto kHeldRepaintTimeout = crl::time(32);
+
+[[nodiscard]] std::vector<QPointer<QWidget>> &Gliding();
+
+[[nodiscard]] std::vector<QPointer<QWidget>> &Pausable() {
+	static auto result = std::vector<QPointer<QWidget>>();
+	return result;
+}
+
+[[nodiscard]] std::vector<QPointer<QWidget>> &Paused() {
+	static auto result = std::vector<QPointer<QWidget>>();
+	return result;
+}
+
+[[nodiscard]] bool InsideGlide(not_null<QWidget*> widget) {
+	return ranges::any_of(Gliding(), [&](const QPointer<QWidget> &scroll) {
+		return scroll && scroll->isAncestorOf(widget);
+	});
+}
+
+[[nodiscard]] bool OverlapsGlide(
+		not_null<QWidget*> widget,
+		not_null<QWidget*> scroll) {
+	auto branch = scroll.get();
+	while (const auto parent = branch->parentWidget()) {
+		if (parent->isAncestorOf(widget)) {
+			auto other = widget.get();
+			while (other->parentWidget() != parent) {
+				other = other->parentWidget();
+			}
+			return branch->geometry().intersects(other->geometry());
+		}
+		branch = parent;
+	}
+	return false;
+}
+
+void Resume(not_null<QWidget*> widget) {
+	auto &paused = Paused();
+	const auto i = ranges::find_if(paused, [&](const QPointer<QWidget> &e) {
+		return (e.data() == widget.get());
+	});
+	if (i != end(paused)) {
+		paused.erase(i);
+		widget->setUpdatesEnabled(true);
+	}
+}
+
+// While a glide runs, window repaints wait for its next step, so the
+// window paints once per step instead of whenever something changes.
+// Widgets that asked for it and don't overlap the glide stop repainting
+// meanwhile: a paused widget under a box or over the gliding area would
+// leave a hole whenever the glide repaints across it.
+class FrameBatcher final : public QObject {
+public:
+	FrameBatcher(not_null<QWidget*> scroll, not_null<QWidget*> window)
+	: QObject(scroll)
+	, _scroll(scroll)
+	, _window(window)
+	, _timeout([=] {
+		_stepped = true;
+		release();
+	}) {
+		window->installEventFilter(this);
+		for (const auto &weak : Pausable()) {
+			const auto widget = weak.data();
+			if (!widget
+				|| widget->window() != window.get()
+				|| widget->isAncestorOf(scroll)) {
+				continue;
+			} else if (scroll->isAncestorOf(widget)) {
+				Resume(widget);
+			} else if (widget->updatesEnabled()
+				&& !InsideGlide(widget)
+				&& !OverlapsGlide(widget, scroll)) {
+				widget->setUpdatesEnabled(false);
+				Paused().push_back(widget);
+				_paused.push_back(widget);
+			}
+		}
+	}
+	~FrameBatcher() {
+		release();
+		for (const auto &widget : _paused) {
+			if (widget) {
+				Resume(widget.data());
+			}
+		}
+	}
+
+	[[nodiscard]] QWidget *scroll() const {
+		return _scroll.data();
+	}
+
+	void stepped() {
+		_stepped = true;
+		release();
+	}
+
+	bool eventFilter(QObject *watched, QEvent *e) override {
+		if (watched != _window.data() || e->type() != QEvent::UpdateRequest) {
+			return false;
+		} else if (base::take(_stepped)) {
+			return false;
+		} else if (!_held) {
+			_held = true;
+			_timeout.callOnce(kHeldRepaintTimeout);
+		}
+		return true;
+	}
+
+private:
+	void release() {
+		if (!base::take(_held)) {
+			return;
+		}
+		_timeout.cancel();
+		if (const auto window = _window.data()) {
+			QCoreApplication::postEvent(
+				window,
+				new QEvent(QEvent::UpdateRequest),
+				Qt::LowEventPriority);
+		}
+	}
+
+	const QPointer<QWidget> _scroll;
+	const QPointer<QWidget> _window;
+	std::vector<QPointer<QWidget>> _paused;
+	base::Timer _timeout;
+	bool _stepped = false;
+	bool _held = false;
+
+};
+
+[[nodiscard]] std::vector<QPointer<FrameBatcher>> &Batchers() {
+	static auto result = std::vector<QPointer<FrameBatcher>>();
+	return result;
+}
+
+[[nodiscard]] FrameBatcher *FindBatcher(not_null<QWidget*> scroll) {
+	auto &list = Batchers();
+	list.erase(ranges::remove_if(list, [](const QPointer<FrameBatcher> &e) {
+		return !e;
+	}), end(list));
+	for (const auto &batcher : list) {
+		if (batcher->scroll() == scroll.get()) {
+			return batcher.data();
+		}
+	}
+	return nullptr;
+}
+
+void StartBatching(not_null<QWidget*> scroll) {
+	if (!FindBatcher(scroll)) {
