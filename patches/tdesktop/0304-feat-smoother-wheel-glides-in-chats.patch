+#pragma once
+
+#include <chrono>
+
+class Painter;
+
+namespace Tele {
+
+struct ScrollLayerInfo {
+	bool used = false;
+	int paints = 0;
+	float64 paintMs = 0.;
+};
+
+class ScrollLayer final {
+public:
+	ScrollLayer(
+		not_null<QWidget*> widget,
+		not_null<QWidget*> scroll,
+		Fn<void(Painter&, QRect)> paint);
+	~ScrollLayer();
+
+	class Timing final {
+	public:
+		explicit Timing(ScrollLayer *layer);
+		Timing(const Timing &other) = delete;
+		Timing &operator=(const Timing &other) = delete;
+		~Timing();
+
+	private:
+		ScrollLayer *_layer = nullptr;
+		std::chrono::steady_clock::time_point _started;
+
+	};
+
+	[[nodiscard]] bool gliding() const;
+	[[nodiscard]] Timing measure();
+
+	void invalidate();
+	void invalidate(QRect rect);
+	void stick(QRect rect);
+	[[nodiscard]] bool paint(
+		QPainter &p,
+		QRect clip,
+		bool usable,
+		uint64 key);
+
+	[[nodiscard]] not_null<QWidget*> scroll() const;
+	[[nodiscard]] ScrollLayerInfo info() const;
+	void started(bool measure);
+	void finished();
+
+private:
+	void release();
+	void moveTo(int top);
+	void repaint(QRect rect);
+
+	const not_null<QWidget*> _widget;
+	const not_null<QWidget*> _scroll;
+	const Fn<void(Painter&, QRect)> _paint;
+	QImage _image;
+	int _ratio = 1;
+	int _imageTop = 0;
+	int _validTop = 0;
+	int _validBottom = 0;
+	QRegion _dirty;
+	QRegion _sticky;
+	QRegion _stickyBefore;
+	uint64 _key = 0;
+	bool _gliding = false;
+	bool _used = false;
+	bool _measuring = false;
+	int _paints = 0;
+	float64 _paintMs = 0.;
+
+};
+
+[[nodiscard]] uint64 ScrollLayerMix(uint64 seed, uint64 value);
+
+template <typename ...Values>
+[[nodiscard]] uint64 ScrollLayerKey(const Values &...values) {
+	auto result = uint64(0x9e3779b97f4a7c15ULL);
+	const auto add = [&](const auto &value) {
+		using Type = std::decay_t<decltype(value)>;
+		if constexpr (std::is_pointer_v<Type>) {
+			result = ScrollLayerMix(
+				result,
+				uint64(reinterpret_cast<uintptr_t>(value)));
+		} else if constexpr (std::is_enum_v<Type>) {
+			result = ScrollLayerMix(
+				result,
+				uint64(int64(std::underlying_type_t<Type>(value))));
+		} else {
+			result = ScrollLayerMix(result, uint64(int64(value)));
+		}
+	};
+	(add(values), ...);
+	return result;
+}
+
+void ScrollLayerStarted(not_null<QWidget*> scroll, bool measure);
+void ScrollLayerFinished(not_null<QWidget*> scroll);
+[[nodiscard]] std::optional<ScrollLayerInfo> ScrollLayerGlideInfo(
+	not_null<QWidget*> scroll);
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_scroll_stats.cpp b/Telegram/SourceFiles/tele/tele_scroll_stats.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2e34ba36a15d223a8abc6b155137e5fa079efc2e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_scroll_stats.cpp
@@ -0,0 +1,334 @@
+#include "tele/tele_scroll_stats.h"
+
+#include "tele/tele_scroll_layer.h"
+
+#include "base/flat_map.h"
+
+#include <QtCore/QAbstractEventDispatcher>
+#include <QtCore/QCoreApplication>
+#include <QtCore/QEvent>
+#include <QtCore/QPointer>
+#include <QtGui/QPaintEvent>
+#include <QtGui/QScreen>
+
+#include <chrono>
+#include <typeinfo>
+
+#ifndef _MSC_VER
+#include <cxxabi.h>
+#include <cstdlib>
+#endif // !_MSC_VER
+
+namespace Tele {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+[[nodiscard]] float64 Milliseconds(Clock::duration duration) {
+	return std::chrono::duration<float64, std::milli>(duration).count();
+}
+
+class AppFilter final : public QObject {
+public:
+	AppFilter(QObject *parent, Fn<bool(QObject*, QEvent*)> filter)
+	: QObject(parent)
+	, _filter(std::move(filter)) {
+		QCoreApplication::instance()->installEventFilter(this);
+	}
+
+	bool eventFilter(QObject *watched, QEvent *e) override {
+		return _filter(watched, e);
+	}
+
+private:
+	const Fn<bool(QObject*, QEvent*)> _filter;
+
+};
+
+class WindowPaints final : public QObject {
+public:
+	struct Widget {
+		int count = 0;
+		float64 sum = 0.;
+		float64 width = 0.;
+		float64 height = 0.;
+		float64 dirty = 0.;
+	};
+
+	explicit WindowPaints(not_null<QWidget*> window) : _window(window) {
+		window->installEventFilter(this);
+		new AppFilter(this, [=](QObject *watched, QEvent *e) {
+			return (e->type() == QEvent::Paint) && paint(watched, e);
+		});
+		if (const auto dispatcher = QAbstractEventDispatcher::instance()) {
+			using Dispatcher = QAbstractEventDispatcher;
+			connect(dispatcher, &Dispatcher::aboutToBlock, this, [=] {
+				_blockedSince = Clock::now();
+				_blocked = true;
+			});
+			connect(dispatcher, &Dispatcher::awake, this, [=] {
+				if (base::take(_blocked)) {
+					idle += Milliseconds(Clock::now() - _blockedSince);
+				}
+			});
+		}
+	}
+
+	bool eventFilter(QObject *watched, QEvent *e) override {
+		if (_inside
+			|| watched != _window.data()
+			|| e->type() != QEvent::UpdateRequest) {
+			return false;
+		}
+		_inside = true;
+		const auto started = Clock::now();
+		watched->event(e);
+		const auto ms = Milliseconds(Clock::now() - started);
+		_inside = false;
+		++count;
+		sum += ms;
+		max = std::max(max, ms);
+		return true;
+	}
+
+	int count = 0;
+	float64 sum = 0.;
+	float64 max = 0.;
+	float64 idle = 0.;
+	base::flat_map<const std::type_info*, Widget> widgets;
+
+private:
+	bool paint(QObject *watched, QEvent *e) {
+		if (!_inside || _painting || !watched->isWidgetType()) {
+			return false;
+		}
+		const auto info = &typeid(*watched);
+		const auto rect = static_cast<QPaintEvent*>(e)->rect();
+		auto area = 0.;
+		for (const auto &part : static_cast<QPaintEvent*>(e)->region()) {
+			area += float64(part.width()) * part.height();
+		}
+		const auto full = float64(rect.width()) * rect.height();
+		_painting = true;
+		const auto started = Clock::now();
+		QCoreApplication::instance()->notify(watched, e);
+		const auto ms = Milliseconds(Clock::now() - started);
+		_painting = false;
+		auto &widget = widgets[info];
+		++widget.count;
+		widget.sum += ms;
+		widget.width += rect.width();
+		widget.height += rect.height();
+		widget.dirty += (full > 0.) ? (area / full) : 1.;
+		return true;
+	}
+
+	QPointer<QWidget> _window;
+	Clock::time_point _blockedSince;
+	bool _blocked = false;
+	bool _inside = false;
+	bool _painting = false;
+
+};
+
+struct DeleteLater {
+	void operator()(QObject *object) const {
+		object->deleteLater();
+	}
+};
+
+struct Glide {
+	QPointer<QWidget> scroll;
+	QString name;
+	std::unique_ptr<WindowPaints, DeleteLater> paints;
+	Clock::time_point started;
+	Clock::time_point last;
+	int frames = 0;
+	float64 minInterval = 0.;
+	float64 maxInterval = 0.;
+	float64 sumInterval = 0.;
+};
+
+[[nodiscard]] std::vector<Glide> &Glides() {
+	static auto result = std::vector<Glide>();
+	return result;
+}
+
+[[nodiscard]] Glide *Find(not_null<QWidget*> scroll) {
+	for (auto &glide : Glides()) {
+		if (glide.scroll.data() == scroll.get()) {
+			return &glide;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] QString TypeName(const std::type_info &info) {
+	const auto raw = info.name();
+#ifdef _MSC_VER
+	auto result = QString::fromLatin1(raw);
+	for (const auto prefix : { u"class "_q, u"struct "_q }) {
+		if (result.startsWith(prefix)) {
+			return result.mid(prefix.size());
+		}
+	}
+	return result;
+#else // _MSC_VER
+	auto status = 0;
+	const auto demangled = abi::__cxa_demangle(raw, nullptr, nullptr, &status);
+	const auto result = QString::fromLatin1(
+		(status == 0 && demangled) ? demangled : raw);
+	std::free(demangled);
+	return result;
+#endif // _MSC_VER
+}
+
+[[nodiscard]] QString Name(not_null<QWidget*> scroll) {
+	auto result = TypeName(typeid(*scroll.get()));
+	if (const auto parent = scroll->parentWidget()) {
+		result += u" in "_q + TypeName(typeid(*parent));
+	}
+	return result;
+}
+
+[[nodiscard]] QString Format(float64 value) {
+	return QString::number(value, 'f', 2);
+}
+
+[[nodiscard]] float64 ScreenRate(not_null<QWidget*> scroll) {
+	const auto screen = scroll->screen();
+	return screen ? float64(screen->refreshRate()) : 0.;
+}
+
+[[nodiscard]] QString WidgetPaints(const WindowPaints &paints) {
+	if (!paints.count) {
+		return QString();
+	}
+	using Entry = std::pair<const std::type_info*, WindowPaints::Widget>;
+	auto entries = std::vector<Entry>();
+	entries.reserve(paints.widgets.size());
+	for (const auto &[info, widget] : paints.widgets) {
+		entries.emplace_back(info, widget);
+	}
+	ranges::sort(entries, ranges::greater(), [](const Entry &entry) {
+		return entry.second.sum;
+	});
+	constexpr auto kShown = 6;
+	auto list = QStringList();
+	auto painted = 0.;
+	for (const auto &[info, widget] : entries) {
+		painted += widget.sum;
+		if (list.size() < kShown) {
+			list.push_back((u"%1 %2 x%3 (%4x%5, %6% dirty)"_q)
+				.arg(TypeName(*info))
+				.arg(Format(widget.sum / paints.count))
+				.arg(Format(widget.count / float64(paints.count)))
+				.arg(int(base::SafeRound(widget.width / widget.count)))
+				.arg(int(base::SafeRound(widget.height / widget.count)))
+				.arg(int(base::SafeRound(100. * widget.dirty / widget.count))));
+		}
+	}
+	if (int(entries.size()) > kShown) {
+		auto others = 0.;
+		for (auto i = kShown; i != int(entries.size()); ++i) {
+			others += entries[i].second.sum;
+		}
+		list.push_back((u"%1 others %2"_q)
+			.arg(int(entries.size()) - kShown)
+			.arg(Format(others / paints.count)));
+	}
+	return (u", per update: %1; compose and present %2 ms"_q)
+		.arg(list.join(u", "_q))
+		.arg(Format((paints.sum - painted) / paints.count));
+}
+
+} // namespace
+
+void ScrollStatsStarted(not_null<QWidget*> scroll) {
+	auto &glides = Glides();
+	glides.erase(ranges::remove_if(glides, [&](const Glide &glide) {
+		return !glide.scroll || (glide.scroll.data() == scroll.get());
+	}), glides.end());
+	const auto now = Clock::now();
+	glides.push_back({
+		.scroll = scroll.get(),
+		.name = Name(scroll),
+		.paints = std::unique_ptr<WindowPaints, DeleteLater>(
+			new WindowPaints(scroll->window())),
+		.started = now,
+		.last = now,
+	});
+}
+
+void ScrollStatsFrame(not_null<QWidget*> scroll) {
+	const auto glide = Find(scroll);
+	if (!glide) {
+		return;
+	}
+	const auto now = Clock::now();
+	if (glide->frames > 0) {
+		const auto interval = Milliseconds(now - glide->last);
+		glide->minInterval = (glide->frames > 1)
+			? std::min(glide->minInterval, interval)
+			: interval;
+		glide->maxInterval = std::max(glide->maxInterval, interval);
+		glide->sumInterval += interval;
+	}
+	glide->last = now;
+	++glide->frames;
+}
+
+void ScrollStatsFinished(not_null<QWidget*> scroll) {
+	const auto glide = Find(scroll);
+	if (!glide) {
+		return;
+	}
+	const auto duration = Milliseconds(Clock::now() - glide->started);
+	const auto fps = (duration > 0.)
+		? (glide->frames * 1000. / duration)
+		: 0.;
+	const auto intervals = glide->frames - 1;
+	const auto interval = (intervals > 0)
+		? (u"interval min %1 / avg %2 / max %3 ms"_q)
+			.arg(Format(glide->minInterval))
+			.arg(Format(glide->sumInterval / intervals))
+			.arg(Format(glide->maxInterval))
+		: u"interval n/a"_q;
+	const auto info = ScrollLayerGlideInfo(scroll);
+	const auto layer = !info
+		? u"no chat layer"_q
+		: (u"chat layer %1, paint %2 ms avg over %3 paints"_q)
+			.arg(info->used ? u"used"_q : u"not used"_q)
+			.arg(Format(info->paints ? (info->paintMs / info->paints) : 0.))
+			.arg(info->paints);
+	const auto &paints = *glide->paints;
+	const auto window = (u"window paint and present %1 ms avg / %2 max"
+		" over %3 updates"_q)
+		.arg(Format(paints.count ? (paints.sum / paints.count) : 0.))
+		.arg(Format(paints.max))
+		.arg(paints.count);
+	const auto busy = (glide->frames > 0)
+		? (u", main thread busy %1 ms per frame, idle %2%"_q)
+			.arg(Format(
+				std::max(duration - paints.idle, 0.) / glide->frames))
+			.arg(int(base::SafeRound((duration > 0.)
+				? (100. * paints.idle / duration)
+				: 0.)))
+		: QString();
+	LOG(("Tele Scroll: %1, %2 frames in %3 ms, %4 fps, %5, screen %6 Hz, "
+		"%7%10, %8%9"
+		).arg(glide->name
+		).arg(glide->frames
+		).arg(Format(duration)
+		).arg(Format(fps)
+		).arg(interval
+		).arg(Format(ScreenRate(scroll))
+		).arg(window
+		).arg(layer
+		).arg(WidgetPaints(paints)
+		).arg(busy));
+	auto &glides = Glides();
+	glides.erase(glides.begin() + (glide - glides.data()));
+}
+
+} // namespace Tele
