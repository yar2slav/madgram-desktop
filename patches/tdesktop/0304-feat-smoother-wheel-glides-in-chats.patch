+#include "tele/tele_scroll_layer.h"
+
+#include "ui/painter.h"
+
+#include <QtGui/QPaintEngine>
+
+#include <cmath>
+#include <cstring>
+
+namespace Tele {
+namespace {
+
+constexpr auto kScreens = 3;
+
+[[nodiscard]] std::vector<not_null<ScrollLayer*>> &Layers() {
+	static auto result = std::vector<not_null<ScrollLayer*>>();
+	return result;
+}
+
+[[nodiscard]] ScrollLayer *Find(not_null<QWidget*> scroll) {
+	for (const auto &layer : Layers()) {
+		if (layer->scroll() == scroll) {
+			return layer;
+		}
+	}
+	return nullptr;
+}
+
+} // namespace
+
+ScrollLayer::Timing::Timing(ScrollLayer *layer)
+: _layer(layer)
+, _started(layer
+	? std::chrono::steady_clock::now()
+	: std::chrono::steady_clock::time_point()) {
+}
+
+ScrollLayer::Timing::~Timing() {
+	if (_layer) {
+		const auto elapsed = std::chrono::duration<float64, std::milli>(
+			std::chrono::steady_clock::now() - _started);
+		++_layer->_paints;
+		_layer->_paintMs += elapsed.count();
+	}
+}
+
+ScrollLayer::ScrollLayer(
+	not_null<QWidget*> widget,
+	not_null<QWidget*> scroll,
+	Fn<void(Painter&, QRect)> paint)
+: _widget(widget)
+, _scroll(scroll)
+, _paint(std::move(paint)) {
+	Layers().push_back(this);
+}
+
+ScrollLayer::~ScrollLayer() {
+	auto &layers = Layers();
+	layers.erase(
+		ranges::remove(layers, not_null<ScrollLayer*>(this)),
+		layers.end());
+}
+
+bool ScrollLayer::gliding() const {
+	return _gliding;
+}
+
+ScrollLayer::Timing ScrollLayer::measure() {
+	return Timing((_gliding && _measuring) ? this : nullptr);
+}
+
+void ScrollLayer::invalidate() {
+	_validBottom = _validTop;
+	_dirty = QRegion();
+}
+
+void ScrollLayer::invalidate(QRect rect) {
+	if (_gliding && !_image.isNull() && !rect.isEmpty()) {
+		_dirty += rect;
+	}
+}
+
+void ScrollLayer::stick(QRect rect) {
+	if (_gliding && !rect.isEmpty()) {
+		_sticky += rect;
+	}
+}
+
+bool ScrollLayer::paint(
+		QPainter &p,
+		QRect clip,
+		bool usable,
+		uint64 key) {
+	if (!_gliding) {
+		return false;
+	}
+	const auto ratio = _widget->devicePixelRatioF();
+	const auto whole = int(std::round(ratio));
+	const auto width = _widget->width();
+	const auto height = _scroll->height() * kScreens;
+	const auto top = std::max(clip.y(), 0);
+	const auto bottom = std::min(clip.y() + clip.height(), _widget->height());
+	if (bottom <= top) {
+		return false;
+	}
+	const auto sticky = base::take(_sticky);
+	const auto stickyBefore = std::exchange(_stickyBefore, sticky);
+	if (!usable
+		|| whole < 1
+		|| std::abs(ratio - whole) > 0.001
+		|| width <= 0
+		|| height <= 0
+		|| (bottom - top) > height) {
+		release();
+		return false;
+	}
+	if (_image.isNull()
+		|| _ratio != whole
+		|| _image.width() != width * whole
+		|| _image.height() != height * whole) {
+		_image = QImage(
+			QSize(width, height) * whole,
+			QImage::Format_ARGB32_Premultiplied);
+		_image.setDevicePixelRatio(whole);
+		_ratio = whole;
+		_imageTop = top;
+		_validTop = _validBottom = top;
+		_dirty = QRegion();
+		_key = key;
+	} else if (_key != key) {
+		_key = key;
+		invalidate();
+	}
+	if (top < _imageTop || bottom > _imageTop + height) {
+		moveTo(top - (height - (bottom - top)) / 2);
+	}
+	auto dirty = base::take(_dirty) + sticky + stickyBefore;
+	if (_validTop < _validBottom && !dirty.isEmpty()) {
+		dirty &= QRect(0, _validTop, width, _validBottom - _validTop);
+		for (const auto &rect : dirty) {
+			repaint(rect);
+		}
+	}
+	if (_validTop >= _validBottom
+		|| bottom <= _validTop
+		|| top >= _validBottom) {
+		repaint(QRect(0, top, width, bottom - top));
+		_validTop = top;
+		_validBottom = bottom;
+	} else {
+		if (top < _validTop) {
+			repaint(QRect(0, top, width, _validTop - top));
+			_validTop = top;
+		}
+		if (bottom > _validBottom) {
+			repaint(QRect(0, _validBottom, width, bottom - _validBottom));
+			_validBottom = bottom;
+		}
+	}
+	const auto target = QRect(clip.x(), top, clip.width(), bottom - top);
+	p.drawImage(
+		target,
+		_image,
+		QRect(
+			target.x() * whole,
+			(target.y() - _imageTop) * whole,
+			target.width() * whole,
+			target.height() * whole));
+	_used = true;
+	return true;
+}
+
+void ScrollLayer::moveTo(int top) {
+	const auto height = _image.height() / _ratio;
+	const auto from = std::max({ _validTop, _imageTop, top });
+	const auto till = std::min({
+		_validBottom,
+		_imageTop + height,
+		top + height,
+	});
+	if (from < till) {
+		const auto line = std::size_t(_image.bytesPerLine()) * _ratio;
+		const auto bits = _image.bits();
+		std::memmove(
+			bits + std::size_t(from - top) * line,
+			bits + std::size_t(from - _imageTop) * line,
+			std::size_t(till - from) * line);
+		_validTop = from;
+		_validBottom = till;
+	} else {
+		_validTop = _validBottom = top;
+	}
+	_imageTop = top;
+}
+
+void ScrollLayer::repaint(QRect rect) {
+	const auto engine = _image.paintEngine();
+	engine->setSystemClip(QRegion(
+		rect.x() * _ratio,
+		(rect.y() - _imageTop) * _ratio,
+		rect.width() * _ratio,
+		rect.height() * _ratio));
+	{
+		auto p = Painter(&_image);
+		p.translate(0, -_imageTop);
+		p.setCompositionMode(QPainter::CompositionMode_Source);
+		p.fillRect(rect, Qt::transparent);
+		p.setCompositionMode(QPainter::CompositionMode_SourceOver);
+		_paint(p, rect);
+	}
+	engine->setSystemClip(QRegion());
+}
+
+not_null<QWidget*> ScrollLayer::scroll() const {
+	return _scroll;
+}
+
+ScrollLayerInfo ScrollLayer::info() const {
+	return {
+		.used = _used,
+		.paints = _paints,
+		.paintMs = _paintMs,
+	};
+}
+
+void ScrollLayer::started(bool measure) {
+	_gliding = true;
+	_used = false;
+	_measuring = measure;
+	_paints = 0;
+	_paintMs = 0.;
+}
+
+void ScrollLayer::finished() {
+	if (!base::take(_gliding)) {
+		return;
+	}
+	release();
+	if (base::take(_used)) {
+		_widget->update();
+	}
+}
+
+void ScrollLayer::release() {
+	_image = QImage();
+	_validTop = _validBottom = _imageTop = 0;
+	_dirty = QRegion();
+	_sticky = QRegion();
+	_stickyBefore = QRegion();
+	_key = 0;
+}
+
+uint64 ScrollLayerMix(uint64 seed, uint64 value) {
+	return seed ^ (value
+		+ 0x9e3779b97f4a7c15ULL
+		+ (seed << 6)
+		+ (seed >> 2));
+}
+
+void ScrollLayerStarted(not_null<QWidget*> scroll, bool measure) {
+	if (const auto layer = Find(scroll)) {
+		layer->started(measure);
+	}
+}
+
+void ScrollLayerFinished(not_null<QWidget*> scroll) {
+	if (const auto layer = Find(scroll)) {
+		layer->finished();
+	}
+}
+
+std::optional<ScrollLayerInfo> ScrollLayerGlideInfo(
+		not_null<QWidget*> scroll) {
+	if (const auto layer = Find(scroll)) {
+		return layer->info();
+	}
+	return std::nullopt;
+}
+
+} // namespace Tele
