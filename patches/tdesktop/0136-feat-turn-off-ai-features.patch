+#include "data/data_session.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+void SetupNoAi(not_null<Main::Session*> session) {
+	NoAiChanges(
+	) | rpl::filter([] {
+		return !NoAi();
+	}) | rpl::on_next([=] {
+		session->data().aiComposeTones().refresh();
+	}, session->lifetime());
