From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 21:22:11 +0300
Subject: [PATCH] feat: send replies to older messages past the queue

---
 Telegram/SourceFiles/data/data_histories.cpp  | 10 +++-
 .../SourceFiles/settings/settings_tele.cpp    |  5 ++
 Telegram/SourceFiles/tele/tele_options.cpp    | 15 ++++++
 Telegram/SourceFiles/tele/tele_options.h      |  3 ++
 Telegram/SourceFiles/tele/tele_send_order.cpp | 51 +++++++++++++++++--
 Telegram/SourceFiles/tele/tele_send_order.h   |  1 +
 .../SourceFiles/tele/tele_settings_io.cpp     |  1 +
 7 files changed, 80 insertions(+), 6 deletions(-)

diff --git a/Telegram/SourceFiles/data/data_histories.cpp b/Telegram/SourceFiles/data/data_histories.cpp
index 71244e46e70ba094e6f35a254dc7b11acce3b300..1e518e38c585aa7be24cc24a22c286502a06c03f 100644
--- a/Telegram/SourceFiles/data/data_histories.cpp
+++ b/Telegram/SourceFiles/data/data_histories.cpp
@@ -1185,9 +1185,15 @@ int Histories::sendPreparedMessage(
 		_creatingTopicRequests.emplace(id);
 		return id;
 	}
-	if (Tele::HoldBehindMedia(history, randomId, message(history, replyTo), [=] {
+	const auto send = [=] {
 		sendPreparedMessage(history, replyTo, randomId, message, done, fail);
-	})) {
+	};
+	if (Tele::HoldBehindMedia(
+			history,
+			replyTo,
+			randomId,
+			message(history, replyTo),
+			send)) {
 		return 0;
 	}
 	auto realReplyTo = replyTo;
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 40bfd00c292ce85e9f40061092b28d4b1b88a7a4..3a720274fc9946d07faddbde912a6d7b3eafdb21 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1929,6 +1929,11 @@ void FillChats(SectionBuilder &builder) {
 		builder,
