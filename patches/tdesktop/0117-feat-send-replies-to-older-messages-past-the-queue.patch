 [[nodiscard]] bool PunctualScheduled();
diff --git a/Telegram/SourceFiles/tele/tele_send_order.cpp b/Telegram/SourceFiles/tele/tele_send_order.cpp
index 68d15093dd5a88f2595011a52af5140f9d66fe73..5dd28474eb9e395be0f7f5c11a680ba28709599e 100644
--- a/Telegram/SourceFiles/tele/tele_send_order.cpp
+++ b/Telegram/SourceFiles/tele/tele_send_order.cpp
@@ -6,6 +6,7 @@
 #include "data/data_session.h"
 #include "history/history.h"
 #include "history/history_item.h"
+#include "history/history_item_components.h"
 #include "history/view/history_view_element.h"
 #include "main/main_session.h"
 #include "storage/file_upload.h"
@@ -132,6 +133,7 @@ using Element = HistoryView::Element;
 struct Held {
 	not_null<History*> history;
 	std::vector<FullMsgId> ids;
+	FullMsgId reply;
 	Fn<void()> send;
 };
 
@@ -168,7 +170,9 @@ void Schedule(not_null<Main::Session*> session) {
 }
 
 QueueState::QueueState() {
-	QueueBehindMediaChanges(
+	rpl::merge(
+		QueueBehindMediaChanges(),
+		SendOlderRepliesChanges()
 	) | rpl::on_next([] {
 		for (const auto &[session, queue] : Queues().sessions) {
 			Schedule(session);
@@ -233,9 +237,41 @@ void MarkFailed(not_null<Main::Session*> session, FullMsgId id) {
 		&& !(queue && queue->failed.contains(item->fullId()));
 }
 
+[[nodiscard]] bool Older(
+		not_null<HistoryItem*> reply,
+		not_null<HistoryItem*> than) {
+	if (!IsServerMsgId(reply->id)) {
+		return false;
+	} else if (reply->date() != than->date()) {
+		return (reply->date() < than->date());
+	}
+	const auto view = reply->mainView();
+	const auto thanView = than->mainView();
+	return view
+		&& thanView
+		&& (reply->history() == than->history())
+		&& Below(thanView, view);
+}
+
+[[nodiscard]] FullMsgId ExplicitReply(
+		not_null<History*> history,
+		const FullReplyTo &replyTo) {
+	const auto id = replyTo.messageId;
+	if (!id || (id.msg == replyTo.topicRootId)) {
+		return {};
+	}
+	const auto item = history->owner().message(id);
+	return (item
+		&& !item->isDiscussionPost()
+		&& !item->Has<HistoryServiceTopicInfo>())
+		? id
+		: FullMsgId();
+}
+
 [[nodiscard]] bool Blocked(
 		not_null<History*> history,
 		const std::vector<FullMsgId> &ids,
+		FullMsgId replyId,
 		const Queue *queue) {
 	const auto &owner = history->owner();
 	auto first = (HistoryItem*)nullptr;
@@ -250,12 +286,16 @@ void MarkFailed(not_null<Main::Session*> session, FullMsgId id) {
 	}
 	const auto topicRootId = first->topicRootId();
 	const auto sublistPeerId = first->sublistPeerId();
+	const auto reply = (replyId && SendOlderReplies())
+		? owner.message(replyId)
+		: nullptr;
 	for (const auto &item : history->clientSideMessages()) {
 		if (item->id >= first->id
 			|| !item->isSending()
 			|| ranges::contains(ids, item->fullId())
 			|| item->topicRootId() != topicRootId
-			|| item->sublistPeerId() != sublistPeerId) {
+			|| item->sublistPeerId() != sublistPeerId
+			|| (reply && Older(reply, item))) {
 			continue;
 		} else if (IsHeld(queue, item->fullId())
 			|| IsSendingMedia(queue, item)) {
@@ -298,7 +338,7 @@ void Check(not_null<Main::Session*> session) {
 		const auto &entry = queue.held[index];
 		if (enabled
 			&& AnyAlive(entry)
-			&& Blocked(entry.history, entry.ids, &queue)) {
+			&& Blocked(entry.history, entry.ids, entry.reply, &queue)) {
 			++index;
 			continue;
 		}
@@ -350,6 +390,7 @@ void MoveSentToBottom(not_null<HistoryItem*> item) {
 
 bool HoldBehindMedia(
 		not_null<History*> history,
+		const FullReplyTo &replyTo,
 		uint64 randomId,
 		const Data::Histories::PreparedMessage &message,
 		Fn<void()> send) {
@@ -376,12 +417,14 @@ bool HoldBehindMedia(
 	const auto &sessions = Queues().sessions;
 	const auto i = sessions.find(session);
 	const auto queue = (i != end(sessions)) ? &i->second : nullptr;
-	if (!Blocked(history, ids, queue)) {
+	const auto reply = ExplicitReply(history, replyTo);
+	if (!Blocked(history, ids, reply, queue)) {
 		return false;
 	}
 	SessionQueue(session).held.push_back({
 		.history = history,
 		.ids = std::move(ids),
+		.reply = reply,
 		.send = std::move(send),
 	});
 	return true;
