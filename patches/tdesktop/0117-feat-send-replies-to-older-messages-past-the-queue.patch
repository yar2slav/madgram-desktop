 	AddOptionToggle(builder, ::Tele::kOptionPunctualScheduled);
 	AddOptionToggle(builder, ::Tele::kOptionHdPhotos);
 	AddOptionToggle(
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index ab7e0fad9a1db0a4925ce884c91097aa64d95014..c12ac3347220d6f760c3d38483fce14ba27613d7 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -79,6 +79,7 @@ const char kOptionWindowTitleTemplate[] = "tele-window-title";
 const char kOptionMessageMenuLayout[] = "tele-message-menu";
 const char kOptionSentToBottom[] = "tele-sent-to-bottom";
 const char kOptionQueueBehindMedia[] = "tele-queue-behind-media";
+const char kOptionSendOlderReplies[] = "tele-send-older-replies";
 const char kOptionInlineWithoutVia[] = "tele-inline-without-via";
 const char kOptionNoRichPastePrompt[] = "tele-no-rich-paste-prompt";
 const char kOptionPunctualScheduled[] = "tele-punctual-scheduled";
@@ -560,6 +561,12 @@ base::options::toggle QueueBehindMediaOption({
 	.name = "Queue messages behind uploading media",
 });
 
+base::options::toggle SendOlderRepliesOption({
+	.id = kOptionSendOlderReplies,
+	.name = "Send replies to older messages right away",
+	.description = "Older than the uploading media.",
+});
+
 base::options::toggle InlineWithoutViaOption({
 	.id = kOptionInlineWithoutVia,
 	.name = "Send inline results without via",
@@ -1266,6 +1273,14 @@ rpl::producer<> QueueBehindMediaChanges() {
 	return QueueBehindMediaOption.changes();
 }
 
+bool SendOlderReplies() {
+	return SendOlderRepliesOption.value();
+}
+
+rpl::producer<> SendOlderRepliesChanges() {
+	return SendOlderRepliesOption.changes();
+}
+
 bool InlineWithoutVia() {
 	return InlineWithoutViaOption.value();
 }
