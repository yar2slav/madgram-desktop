+void Restore(not_null<History*> history) {
+	if (!KeepDeletedMessages() || !WantedIn(history)) {
+		return;
+	}
+	const auto restored = RestoreKeptDeleted(history, KeepDeletedOwn());
+	if (restored.empty()) {
