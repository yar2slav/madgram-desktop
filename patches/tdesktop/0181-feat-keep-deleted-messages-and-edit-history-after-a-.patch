+			{ u"1"_q, u"1 day"_q },
+			{ QString(), u"7 days"_q },
+			{ u"30"_q, u"30 days"_q },
+			{ u"forever"_q, u"Forever"_q },
+		},
+		{ u"restart"_q, u"retention"_q, u"days"_q },
+		{ SavedHistorySwitches() });
+	const auto controller = builder.controller();
+	const auto session = builder.session();
+	const auto id = u"tele-clear-saved-history"_q;
+	const auto name = ::Tele::Lower(u"Clear saved history"_q);
+	WithParent(builder, id, name, { SavedHistorySwitches() }, [&] {
+		const auto button = AddButton(builder, {
+			.id = id,
+			.title = rpl::single(name),
+			.st = &st::settingsButtonNoIcon,
+			.label = ::Tele::SavedHistorySizeValue(
