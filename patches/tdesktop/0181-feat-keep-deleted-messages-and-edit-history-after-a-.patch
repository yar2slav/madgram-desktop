+						::Tele::ClearSavedHistory(session);
+						close();
+					},
+					.confirmText = ::Tele::Lower(u"Clear"_q),
+					.confirmStyle = &st::attentionBoxButton,
+				}));
+			},
+			.keywords = { u"delete"_q, u"remove"_q, u"deleted"_q },
