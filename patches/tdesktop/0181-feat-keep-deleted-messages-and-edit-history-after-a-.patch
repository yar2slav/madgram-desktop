+void Persist(not_null<const HistoryItem*> item, const Record &record) {
+	auto &owner = item->history()->owner();
+	auto result = KeptEditRecord{
+		.since = record.since,
+		.original = record.original,
+	};
+	for (const auto &version : record.versions) {
+		if (const auto snapshot = owner.message(version.snapshot)) {
+			result.versions.push_back({
+				.item = snapshot,
+				.date = version.date,
+				.original = version.original,
+			});
+		}
+	}
+	StoreEditVersions(item, result);
+}
+
+[[nodiscard]] Record *FindOrRestore(not_null<const HistoryItem*> item) {
+	if (const auto record = FindRecord(item)) {
+		return record;
+	}
+	const auto restored = RestoreEditVersions(item);
+	if (!restored) {
+		return nullptr;
+	}
+	auto record = Record{
+		.since = restored->since,
+		.original = restored->original,
+	};
+	for (const auto &version : restored->versions) {
+		record.versions.push_back({
+			.content = Read(version.item),
+			.snapshot = version.item->fullId(),
+			.date = version.date,
+			.original = version.original,
+		});
+	}
+	auto &records = Sessions(&item->history()->session()).records;
+	return &records.emplace(item, std::move(record)).first->second;
+}
