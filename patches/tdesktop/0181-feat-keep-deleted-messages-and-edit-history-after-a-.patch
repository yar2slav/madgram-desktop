+constexpr auto kMagic = quint32(0x7E1E4B50);
+constexpr auto kLegacyVersion = qint32(1);
+constexpr auto kVersion = qint32(2);
+constexpr auto kFileMagic = quint32(0x7E1E4B46);
+constexpr auto kFileVersion = qint32(1);
+constexpr auto kChunkSize = 1024 * 1024;
+constexpr auto kSizeLimit = int64(200) * 1024 * 1024;
+constexpr auto kPruneTarget = kSizeLimit - kSizeLimit / 10;
+constexpr auto kCompactSlack = int64(4) * 1024 * 1024;
+constexpr auto kOverhead = int64(48);
+constexpr auto kWriteDelay = crl::time(5000);
+constexpr auto kPruneDelay = crl::time(3600) * 1000;
+constexpr auto kMaxEntries = quint32(1000000);
+constexpr auto kMaxEntities = quint32(100000);
+constexpr auto kMaxVersions = quint32(10000);
+constexpr auto kDay = TimeId(86400);
+
+enum class EntryKind : quint8 {
+	Deleted = 1,
+	Edits = 2,
+};
+
+enum class Op : quint8 {
+	Put = 1,
