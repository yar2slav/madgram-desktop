+
+Store::Store(not_null<Main::Session*> session)
+: _session(session)
+, _writeTimer([=] { write(); })
+, _pruneTimer([=] { prune(); })
+, _writer(base::make_weak(this), folder(), session->uniqueId()) {
+	Registry().emplace(session, this);
+	QDir(tempFolder()).removeRecursively();
+
+	rpl::merge(
+		KeepDeletedPersistValue(),
+		EditHistoryPersistValue()
+	) | rpl::filter(
+		rpl::mappers::_1
+	) | rpl::on_next([=](bool) {
+		ensureLoaded();
+	}, _lifetime);
+
+	SavedHistoryPeriodValue(
+	) | rpl::skip(1) | rpl::on_next([=](const QString &) {
+		if (_loaded) {
+			prune();
+		}
+	}, _lifetime);
+
+	session->data().sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		_closing = true;
+		flush();
+	}, _lifetime);
+
+	_pruneTimer.callEach(kPruneDelay);
+}
+
+Store::~Store() {
+	flush();
+	QDir(tempFolder()).removeRecursively();
+	Registry().remove(_session);
+}
