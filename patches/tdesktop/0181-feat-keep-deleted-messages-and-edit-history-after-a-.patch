+
+void Store::read() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	if (!readJournal(key) && readLegacy(key)) {
+		_compact = true;
+	}
+	_size = _bytes;
+	if (_compact) {
+		_writeTimer.callOnce(kWriteDelay);
+	}
+}
+
+bool Store::readJournal(const MTP::AuthKeyPtr &key) {
+	auto file = QFile(JournalPath(folder()));
+	if (!file.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	auto stream = QDataStream(&file);
+	Prepared(stream);
+	auto magic = quint32();
+	auto version = qint32();
+	stream >> magic >> version;
+	if (stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion) {
+		_compact = true;
+		return false;
+	}
+	while (!stream.atEnd()) {
+		auto encrypted = QByteArray();
+		stream >> encrypted;
+		auto data = EncryptedDescriptor();
+		if (stream.status() != QDataStream::Ok
+			|| !DecryptLocal(data, encrypted, key)
+			|| !apply(data.stream)) {
+			_compact = true;
+			break;
+		}
+	}
+	_journal = file.size();
+	return true;
+}
+
+bool Store::readLegacy(const MTP::AuthKeyPtr &key) {
+	auto file = FileReadDescriptor();
+	if (!ReadEncryptedFile(file, u"index"_q, folder(), key)) {
+		return false;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto appVersion = qint32();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> appVersion >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kLegacyVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxEntries) {
+		return false;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto kind = quint8();
+		auto peer = quint64();
+		auto msg = qint64();
+		auto entry = Entry();
+		auto stamp = qint32();
+		auto own = quint8();
+		auto mediaSize = qint64();
+		file.stream
+			>> kind
+			>> peer
+			>> msg
+			>> stamp
+			>> own
+			>> entry.blob
+			>> entry.media
+			>> mediaSize;
+		if (file.stream.status() != QDataStream::Ok) {
+			break;
+		}
+		entry.stamp = stamp;
+		entry.own = (own != 0);
+		entry.mediaSize = mediaSize;
+		entry.appVersion = appVersion;
+		const auto id = FullMsgId(DeserializePeerId(peer), MsgId(msg));
+		if (!id.peer || !id.msg) {
+			continue;
+		} else if (kind == quint8(EntryKind::Deleted)
+			|| kind == quint8(EntryKind::Edits)) {
+			set(EntryKind(kind), id, std::move(entry));
+		}
+	}
+	return true;
+}
+
+bool Store::apply(QDataStream &stream) {
+	auto owner = quint64();
+	stream >> owner;
+	if (stream.status() != QDataStream::Ok
+		|| owner != _session->uniqueId()) {
+		return false;
+	}
+	while (!stream.atEnd()) {
+		auto op = quint8();
+		auto kind = quint8();
+		auto peer = quint64();
+		auto msg = qint64();
+		stream >> op >> kind >> peer >> msg;
+		if (stream.status() != QDataStream::Ok
+			|| (kind != quint8(EntryKind::Deleted)
+				&& kind != quint8(EntryKind::Edits))) {
+			return false;
+		}
+		const auto id = FullMsgId(DeserializePeerId(peer), MsgId(msg));
+		auto &entries = list(EntryKind(kind));
+		if (op == quint8(Op::Put)) {
+			auto entry = Entry();
+			auto stamp = qint32();
+			auto own = quint8();
+			auto appVersion = qint32();
+			auto mediaSize = qint64();
+			stream
+				>> stamp
+				>> own
+				>> appVersion
+				>> entry.blob
+				>> entry.media
+				>> mediaSize;
+			if (stream.status() != QDataStream::Ok) {
+				return false;
+			}
+			entry.stamp = stamp;
+			entry.own = (own != 0);
+			entry.appVersion = appVersion;
+			entry.mediaSize = mediaSize;
+			if (id.peer && id.msg) {
+				set(EntryKind(kind), id, std::move(entry));
+			}
+		} else if (op == quint8(Op::Remove)) {
+			const auto i = entries.find(id);
+			if (i != end(entries)) {
+				tally(i->second, -1);
+				entries.erase(i);
+			}
+		} else if (op == quint8(Op::Media)) {
+			auto media = QString();
+			auto mediaSize = qint64();
+			stream >> media >> mediaSize;
+			if (stream.status() != QDataStream::Ok) {
+				return false;
+			}
+			const auto i = entries.find(id);
+			if (i != end(entries)) {
+				tally(i->second, -1);
+				i->second.media = media;
+				i->second.mediaSize = mediaSize;
+				tally(i->second, 1);
+			}
+		} else {
+			return false;
+		}
+	}
+	return true;
+}
+
+void Store::tally(const Entry &entry, int sign) {
+	_bytes += sign * Weight(entry);
+	_live += sign * Footprint(entry);
+}
+
+void Store::set(EntryKind kind, FullMsgId id, Entry entry) {
+	auto &entries = list(kind);
+	const auto [i, inserted] = entries.try_emplace(id);
+	if (!inserted) {
+		tally(i->second, -1);
+	}
+	i->second = std::move(entry);
+	tally(i->second, 1);
+}
+
+void Store::put(EntryKind kind, FullMsgId id, Entry entry) {
+	auto stream = QDataStream(
+		&_pending,
+		QIODevice::WriteOnly | QIODevice::Append);
+	WritePut(Prepared(stream), kind, id, entry);
+	set(kind, id, std::move(entry));
+}
+
+Entries::iterator Store::erase(EntryKind kind, Entries::iterator i) {
+	auto stream = QDataStream(
+		&_pending,
+		QIODevice::WriteOnly | QIODevice::Append);
+	WriteKey(Prepared(stream), Op::Remove, kind, i->first);
+	if (!i->second.media.isEmpty()) {
+		_drop.push_back(mediaFolder() + i->second.media);
+	}
+	tally(i->second, -1);
+	return list(kind).erase(i);
+}
+
+void Store::write() {
+	_writeTimer.cancel();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!_loaded || !key) {
+		return;
+	} else if (_compact || _journal > 2 * _live + kCompactSlack) {
+		compact(key);
+		return;
+	} else if (_pending.isEmpty() && _drop.empty()) {
+		return;
+	}
+	_journal += kOverhead + _pending.size();
+	_writer.with([
+		ops = base::take(_pending),
+		drop = base::take(_drop),
+		key
+	](Writer &writer) mutable {
+		writer.append(std::move(ops), std::move(drop), key);
+	});
+}
+
+void Store::compact(const MTP::AuthKeyPtr &key) {
+	auto entries = std::vector<Stored>();
+	entries.reserve(_deleted.size() + _edits.size());
+	for (const auto kind : { EntryKind::Deleted, EntryKind::Edits }) {
+		for (const auto &[id, entry] : list(kind)) {
+			entries.push_back({ kind, id, entry });
+		}
+	}
+	_compact = false;
+	_journal = _live;
+	_pending = QByteArray();
+	_writer.with([
+		entries = std::move(entries),
+		drop = base::take(_drop),
+		key
+	](Writer &writer) mutable {
+		writer.compact(std::move(entries), std::move(drop), key);
+	});
+}
+
+void Store::flush() {
+	if (_writeTimer.isActive() || _compact) {
+		write();
+	}
+	_writer.with_sync([](Writer &) {
+	});
+}
+
+void Store::changed() {
+	if (_bytes > kSizeLimit) {
+		prune();
+	}
+	_size = _bytes;
+	if (!_writeTimer.isActive()) {
+		_writeTimer.callOnce(kWriteDelay);
+	}
+}
+
+void Store::prune() {
+	if (!_loaded) {
+		return;
+	}
+	auto removed = false;
+	if (const auto retention = Retention()) {
+		const auto now = base::unixtime::now();
+		for (const auto kind : { EntryKind::Deleted, EntryKind::Edits }) {
+			auto &entries = list(kind);
+			for (auto i = begin(entries); i != end(entries);) {
+				if (i->second.stamp + retention < now) {
+					i = erase(kind, i);
+					removed = true;
+				} else {
+					++i;
+				}
+			}
+		}
+	}
+	if (_bytes > kSizeLimit) {
+		auto order = std::vector<std::tuple<TimeId, EntryKind, FullMsgId>>();
+		order.reserve(_deleted.size() + _edits.size());
+		for (const auto kind : { EntryKind::Deleted, EntryKind::Edits }) {
+			for (const auto &[id, entry] : list(kind)) {
+				order.emplace_back(entry.stamp, kind, id);
+			}
+		}
+		ranges::sort(order, ranges::less(), [](const auto &value) {
+			return std::get<0>(value);
+		});
+		for (const auto &[stamp, kind, id] : order) {
+			if (_bytes <= kPruneTarget) {
+				break;
+			}
+			erase(kind, list(kind).find(id));
+			removed = true;
+		}
+	}
+	_size = _bytes;
+	if (removed && !_writeTimer.isActive()) {
+		_writeTimer.callOnce(kWriteDelay);
+	}
+}
+
+void Store::collectGarbage() {
+	auto used = base::flat_set<QString>();
+	for (const auto entries : { &_deleted, &_edits }) {
+		for (const auto &[id, entry] : *entries) {
+			if (!entry.media.isEmpty()) {
+				used.emplace(entry.media);
+			}
+		}
+	}
+	crl::async([path = mediaFolder(), used = std::move(used)] {
+		const auto names = QDir(path).entryList(QDir::Files);
+		for (const auto &name : names) {
+			if (!used.contains(name)) {
+				QFile::remove(path + name);
+			}
+		}
+	});
+}
+
+void Store::storeDeleted(not_null<HistoryItem*> item, bool own) {
+	if (!KeepDeletedPersist() || !ensureLoaded()) {
+		return;
+	}
+	const auto id = item->fullId();
+	if (_deleted.contains(id)) {
+		return;
+	}
+	put(EntryKind::Deleted, id, Entry{
+		.stamp = base::unixtime::now(),
+		.blob = SerializeDeleted(item),
+		.own = own,
+	});
+	copyMedia(id, item);
+	changed();
+}
+
+void Store::forgetDeleted(FullMsgId id) {
+	if (_closing || !_loaded) {
+		return;
+	}
+	const auto i = _deleted.find(id);
+	if (i == end(_deleted)) {
+		return;
+	}
+	erase(EntryKind::Deleted, i);
+	changed();
+}
+
+void Store::copyMedia(FullMsgId id, not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	if (!media) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	const auto fromCache = [=](Storage::Cache::Key key) {
+		_session->data().cache().get(key, [=](QByteArray &&bytes) {
+			if (bytes.isEmpty()) {
+				return;
+			}
+			crl::on_main(weak, [=, bytes = std::move(bytes)]() mutable {
+				copyMediaFrom(id, QString(), std::move(bytes));
+			});
+		});
+	};
+	if (const auto photo = media->photo()) {
+		const auto &large = photo->location(Data::PhotoSize::Large);
+		if (const auto key = large.file().cacheKey()) {
+			fromCache(key);
+		}
+	} else if (const auto document = media->document()) {
+		if (document->size > kSizeLimit) {
+			return;
+		}
+		const auto path = document->filepath(true);
+		if (!path.isEmpty()) {
+			copyMediaFrom(id, path, QByteArray());
+		} else if (document->loadedInMediaCache()) {
+			if (const auto key = document->cacheKey()) {
+				fromCache(key);
+			}
+		}
+	}
+}
+
+void Store::copyMediaFrom(FullMsgId id, QString source, QByteArray bytes) {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !_deleted.contains(id)) {
+		return;
+	}
+	const auto name = RandomHex();
+	const auto path = mediaFolder() + name;
+	const auto weak = base::make_weak(this);
+	crl::async([=, bytes = std::move(bytes)]() mutable {
+		const auto ok = WriteEncryptedFile(source, std::move(bytes), path, key);
+		const auto size = ok ? QFileInfo(path).size() : int64();
+		crl::on_main([=] {
+			if (const auto strong = weak.get()) {
+				if (ok) {
+					strong->mediaCopied(id, name, size);
+				}
+			} else if (ok) {
+				QFile::remove(path);
+			}
+		});
+	});
+}
+
+void Store::mediaCopied(FullMsgId id, const QString &name, int64 size) {
+	const auto i = _deleted.find(id);
+	if (_closing || i == end(_deleted) || !i->second.media.isEmpty()) {
+		QFile::remove(mediaFolder() + name);
+		return;
+	}
+	tally(i->second, -1);
+	i->second.media = name;
+	i->second.mediaSize = size;
+	tally(i->second, 1);
+	auto stream = QDataStream(
+		&_pending,
+		QIODevice::WriteOnly | QIODevice::Append);
+	WriteKey(Prepared(stream), Op::Media, EntryKind::Deleted, id);
+	stream << name << qint64(size);
+	changed();
+}
+
+void Store::restoreMedia(const Entry &entry, not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (entry.media.isEmpty() || !media || !key) {
+		return;
+	}
+	const auto path = mediaFolder() + entry.media;
+	if (const auto photo = media->photo()) {
+		const auto &large = photo->location(Data::PhotoSize::Large);
+		const auto cacheKey = large.file().cacheKey();
+		auto bytes = cacheKey ? DecryptBytes(path, key) : QByteArray();
+		if (!bytes.isEmpty()) {
+			_session->data().cache().putIfEmpty(
+				cacheKey,
+				Storage::Cache::Database::TaggedValue(
+					std::move(bytes),
+					Data::kImageCacheTag));
+		}
+		return;
+	}
+	const auto document = media->document();
+	if (!document || !document->filepath(true).isEmpty()) {
+		return;
+	}
+	const auto cacheKey = document->cacheKey();
+	if (cacheKey && entry.mediaSize <= Storage::kMaxFileInMemory) {
+		auto bytes = DecryptBytes(path, key);
+		if (!bytes.isEmpty()) {
+			_session->data().cache().putIfEmpty(
+				cacheKey,
+				Storage::Cache::Database::TaggedValue(
+					std::move(bytes),
+					document->cacheTag()));
+			document->setLoadedInMediaCache(true);
+		}
+		return;
+	}
+	const auto name = document->filename().isEmpty()
+		? entry.media
+		: document->filename();
+	const auto to = tempFolder() + entry.media + '/' + name;
+	const auto weak = base::make_weak(this);
+	const auto raw = document;
+	crl::async([=] {
+		const auto ok = DecryptToFile(path, to, key);
+		crl::on_main(weak, [=] {
+			if (ok && raw->filepath(true).isEmpty()) {
+				raw->setLocation(Core::FileLocation(to));
+				_session->data().requestDocumentViewRepaint(raw);
+			}
+		});
+	});
+}
+
+std::vector<not_null<HistoryItem*>> Store::restoreDeleted(
+		not_null<History*> history,
+		bool own) {
+	if (!KeepDeletedPersist() || !ensureLoaded()) {
+		return {};
+	}
+	const auto peer = history->peer->id;
+	if (!_restored.emplace(peer).second) {
+		return {};
+	}
+	auto &owner = history->owner();
+	auto result = std::vector<not_null<HistoryItem*>>();
+	auto broken = std::vector<FullMsgId>();
+	for (auto i = _deleted.lower_bound(FullMsgId(peer, MsgId()))
+		; i != end(_deleted) && i->first.peer == peer
+		; ++i) {
+		const auto &[id, entry] = *i;
+		if ((entry.own && !own) || owner.message(id)) {
+			continue;
+		}
+		const auto item = DeserializeDeleted(
+			history,
+			id.msg,
+			entry.blob,
+			entry.appVersion);
+		if (!item) {
+			broken.push_back(id);
+			continue;
+		}
+		restoreMedia(entry, item);
+		result.push_back(item);
+	}
+	for (const auto &id : broken) {
+		erase(EntryKind::Deleted, _deleted.find(id));
+	}
+	if (!broken.empty()) {
+		changed();
+	}
+	return result;
+}
+
+void Store::storeEdits(
+		not_null<const HistoryItem*> item,
+		const KeptEditRecord &record) {
+	if (!EditHistoryPersist()
+		|| !item->isRegular()
+		|| !ensureLoaded()) {
+		return;
+	}
+	const auto id = item->fullId();
+	if (record.versions.empty()) {
+		forgetEdits(id);
+		return;
+	}
+	put(EntryKind::Edits, id, Entry{
+		.stamp = base::unixtime::now(),
+		.blob = SerializeEdits(record),
+	});
+	changed();
+}
+
+void Store::forgetEdits(FullMsgId id) {
+	if (_closing || !_loaded) {
+		return;
+	}
+	const auto i = _edits.find(id);
+	if (i != end(_edits)) {
+		erase(EntryKind::Edits, i);
+		changed();
+	}
+}
+
+std::optional<KeptEditRecord> Store::restoreEdits(
+		not_null<const HistoryItem*> item) {
+	if (!EditHistoryPersist()
+		|| !item->isRegular()
+		|| !ensureLoaded()) {
+		return std::nullopt;
+	}
+	const auto i = _edits.find(item->fullId());
+	if (i == end(_edits)) {
+		return std::nullopt;
+	}
+	auto result = DeserializeEdits(
+		item,
+		i->second.blob,
+		i->second.appVersion);
+	if (!result) {
+		erase(EntryKind::Edits, i);
+		changed();
+	}
+	return result;
+}
+
+rpl::producer<int64> Store::sizeValue() const {
+	return _size.value();
+}
+
+void Store::clear() {
+	_writeTimer.cancel();
+	_deleted.clear();
+	_edits.clear();
+	_pending = QByteArray();
+	_drop.clear();
+	_bytes = 0;
+	_live = 0;
+	_journal = 0;
+	_compact = false;
+	_size = 0;
+	_loaded = true;
+	_writer.with([](Writer &writer) {
+		writer.clear();
+	});
+}
+
+void Store::writeFailed() {
+	_compact = true;
+}
+
+Writer::Writer(base::weak_ptr<Store> store, QString folder, uint64 owner)
+: _store(std::move(store))
+, _folder(std::move(folder))
+, _owner(owner) {
+}
+
+void Writer::append(
+		QByteArray ops,
+		std::vector<QString> drop,
+		const MTP::AuthKeyPtr &key) {
+	if (!_broken) {
+		auto data = EncryptedDescriptor(sizeof(quint64) + ops.size());
+		data.stream << quint64(_owner);
+		data.stream.writeRawData(ops.constData(), ops.size());
+		const auto encrypted = PrepareEncrypted(data, key);
+		QDir().mkpath(_folder);
+		auto file = QFile(JournalPath(_folder));
+		if (!file.open(QIODevice::WriteOnly | QIODevice::Append)) {
+			fail();
+		} else {
+			const auto was = file.size();
+			auto stream = QDataStream(&file);
+			Prepared(stream);
+			if (!was) {
+				stream << kMagic << kVersion;
+			}
+			stream << encrypted;
+			if (stream.status() != QDataStream::Ok || !file.flush()) {
+				file.resize(was);
+				fail();
+			}
+		}
+	}
+	for (const auto &path : drop) {
+		QFile::remove(path);
+	}
+}
+
+void Writer::compact(
+		std::vector<Stored> entries,
+		std::vector<QString> drop,
+		const MTP::AuthKeyPtr &key) {
+	QDir().mkpath(_folder);
+	auto file = QSaveFile(JournalPath(_folder));
+	auto ok = file.open(QIODevice::WriteOnly);
+	if (ok) {
+		auto stream = QDataStream(&file);
+		Prepared(stream) << kMagic << kVersion;
+		auto data = std::optional<EncryptedDescriptor>();
+		const auto flush = [&] {
+			stream << PrepareEncrypted(*data, key);
+			data.reset();
+		};
+		for (const auto &[kind, id, entry] : entries) {
+			if (!data) {
+				data.emplace(kChunkSize);
+				data->stream << quint64(_owner);
+			}
+			WritePut(data->stream, kind, id, entry);
+			if (data->data.size() >= kChunkSize) {
+				flush();
+			}
+		}
+		if (data) {
+			flush();
+		}
+		ok = (stream.status() == QDataStream::Ok) && file.commit();
+	}
+	if (ok) {
+		_broken = false;
+		const auto legacy = _folder + u"index"_q;
+		for (const auto postfix : { 's', '0', '1' }) {
+			QFile::remove(legacy + QChar(postfix));
+		}
+	} else {
+		fail();
+	}
+	for (const auto &path : drop) {
+		QFile::remove(path);
+	}
+}
+
+void Writer::clear() {
+	QDir(_folder).removeRecursively();
+	_broken = false;
+}
+
+void Writer::fail() {
+	_broken = true;
+	crl::on_main(_store, [store = _store] {
+		store->writeFailed();
+	});
+}
