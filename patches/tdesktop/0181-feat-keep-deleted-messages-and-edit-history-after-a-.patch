+
+[[nodiscard]] QString RandomHex() {
+	return u"%1"_q.arg(base::RandomValue<uint64>(), 16, 16, QChar('0'));
+}
+
+[[nodiscard]] TimeId Retention() {
+	const auto value = SavedHistoryPeriod();
+	return (value == u"forever"_q)
+		? TimeId(0)
+		: (value == u"1"_q)
+		? kDay
+		: (value == u"30"_q)
+		? (30 * kDay)
+		: (7 * kDay);
+}
+
+[[nodiscard]] QDataStream &Prepared(QDataStream &stream) {
+	stream.setVersion(QDataStream::Qt_5_1);
+	return stream;
+}
+
+void WriteText(QDataStream &stream, const TextWithEntities &text) {
+	stream << text.text << quint32(text.entities.size());
+	for (const auto &entity : text.entities) {
+		stream
+			<< qint32(entity.type())
+			<< qint32(entity.offset())
+			<< qint32(entity.length())
+			<< entity.data();
+	}
+}
+
+[[nodiscard]] bool ReadText(QDataStream &stream, TextWithEntities &text) {
+	auto count = quint32();
+	stream >> text.text >> count;
+	if (stream.status() != QDataStream::Ok || count > kMaxEntities) {
+		return false;
+	}
+	text.entities.reserve(count);
+	for (auto i = quint32(); i != count; ++i) {
+		auto type = qint32();
+		auto offset = qint32();
+		auto length = qint32();
+		auto data = QString();
+		stream >> type >> offset >> length >> data;
+		if (stream.status() != QDataStream::Ok) {
+			return false;
+		}
+		const auto entity = EntityInText(
+			EntityType(type),
+			offset,
+			length,
+			data);
+		if (type >= 0 && entity.validForText(text.text.size())) {
+			text.entities.push_back(entity);
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QByteArray SerializePhoto(not_null<PhotoData*> photo) {
+	auto access = uint64();
+	photo->mtpInput().match([&](const MTPDinputPhoto &data) {
+		access = data.vaccess_hash().v;
+	}, [](const auto &) {});
+	auto dc = 0;
+	const auto &large = photo->location(Data::PhotoSize::Large);
+	if (const auto storage = std::get_if<StorageFileLocation>(
+			&large.file().data)) {
+		dc = storage->dcId();
+	}
+	auto result = QByteArray();
+	auto stream = QDataStream(&result, QIODevice::WriteOnly);
+	Prepared(stream)
+		<< quint64(photo->id)
+		<< quint64(access)
+		<< photo->fileReference()
+		<< qint32(photo->date())
+		<< qint32(dc)
+		<< quint8(photo->hasAttachedStickers() ? 1 : 0)
+		<< photo->inlineThumbnailBytes();
+	for (const auto size : {
+			Data::PhotoSize::Small,
+			Data::PhotoSize::Thumbnail,
+			Data::PhotoSize::Large }) {
+		const auto &location = photo->location(size);
+		stream
+			<< (location.valid() ? location.serialize() : QByteArray())
+			<< qint32(photo->imageByteSize(size));
+	}
+	return result;
+}
+
+[[nodiscard]] PhotoData *DeserializePhoto(
+		not_null<Main::Session*> session,
+		const QByteArray &serialized) {
+	auto stream = QDataStream(serialized);
+	Prepared(stream);
+	auto id = quint64();
+	auto access = quint64();
+	auto reference = QByteArray();
+	auto date = qint32();
+	auto dc = qint32();
+	auto stickers = quint8();
+	auto inlineThumbnail = QByteArray();
+	stream >> id >> access >> reference >> date >> dc >> stickers;
+	stream >> inlineThumbnail;
+	auto images = std::array<ImageWithLocation, 3>();
+	for (auto &image : images) {
+		auto location = QByteArray();
+		auto bytes = qint32();
+		stream >> location >> bytes;
+		if (!location.isEmpty()) {
+			if (const auto parsed = ImageLocation::FromSerialized(location)) {
+				image.location = *parsed;
+			}
+		}
+		image.bytesCount = bytes;
+	}
+	if (stream.status() != QDataStream::Ok || !id) {
+		return nullptr;
+	}
+	return session->data().photo(
+		PhotoId(id),
+		access,
+		reference,
+		date,
+		dc,
+		(stickers != 0),
+		inlineThumbnail,
+		images[0],
+		images[1],
+		images[2],
+		ImageWithLocation(),
+		ImageWithLocation(),
+		crl::time(0)).get();
+}
+
+[[nodiscard]] QByteArray SerializeDocument(not_null<DocumentData*> document) {
+	auto result = QByteArray();
+	auto stream = QDataStream(&result, QIODevice::WriteOnly);
+	Prepared(stream);
+	Serialize::Document::writeToStream(stream, document);
+	const auto seconds = document->hasDuration()
+		? qint32(document->duration() / 1000)
+		: qint32(0);
+	if (const auto sticker = document->sticker()) {
+		stream
+			<< quint8(ExtraKind::Sticker)
+			<< sticker->alt
+			<< quint64(sticker->set.id)
+			<< quint64(sticker->set.accessHash)
+			<< quint8((sticker->setType == Data::StickersType::Masks)
+				? 1
+				: 0);
+	} else if (const auto voice = document->voice()) {
+		stream
+			<< quint8(ExtraKind::Audio)
+			<< quint8(1)
+			<< seconds
+			<< QString()
+			<< QString()
+			<< documentWaveformEncode5bit(voice->waveform);
+	} else if (const auto song = document->song()) {
+		stream
+			<< quint8(ExtraKind::Audio)
+			<< quint8(0)
+			<< seconds
+			<< song->title
+			<< song->performer
+			<< QByteArray();
+	} else {
+		stream << quint8(ExtraKind::None);
+	}
+	return result;
+}
+
+[[nodiscard]] DocumentData *DeserializeDocument(
+		not_null<Main::Session*> session,
+		const QByteArray &serialized,
+		qint32 appVersion) {
+	auto stream = QDataStream(serialized);
+	Prepared(stream);
+	const auto document = Serialize::Document::readFromStream(
+		session,
+		appVersion,
+		stream);
+	auto kind = quint8();
+	stream >> kind;
+	auto attributes = QVector<MTPDocumentAttribute>();
+	if (kind == quint8(ExtraKind::Sticker)) {
+		auto alt = QString();
+		auto setId = quint64();
+		auto setAccess = quint64();
+		auto mask = quint8();
+		stream >> alt >> setId >> setAccess >> mask;
+		using Flag = MTPDdocumentAttributeSticker::Flag;
+		attributes.push_back(MTP_documentAttributeSticker(
+			MTP_flags(mask ? Flag::f_mask : Flag()),
+			MTP_string(alt),
+			(setId
+				? MTP_inputStickerSetID(MTP_long(setId), MTP_long(setAccess))
+				: MTP_inputStickerSetEmpty()),
+			MTPMaskCoords()));
+	} else if (kind == quint8(ExtraKind::Audio)) {
+		auto voice = quint8();
+		auto seconds = qint32();
+		auto title = QString();
+		auto performer = QString();
+		auto waveform = QByteArray();
+		stream >> voice >> seconds >> title >> performer >> waveform;
+		using Flag = MTPDdocumentAttributeAudio::Flag;
+		attributes.push_back(MTP_documentAttributeAudio(
+			MTP_flags((voice ? Flag::f_voice : Flag())
+				| (title.isEmpty() ? Flag() : Flag::f_title)
+				| (performer.isEmpty() ? Flag() : Flag::f_performer)
+				| (waveform.isEmpty() ? Flag() : Flag::f_waveform)),
+			MTP_int(seconds),
+			MTP_string(title),
+			MTP_string(performer),
+			MTP_bytes(waveform)));
+	} else if (kind != quint8(ExtraKind::None)) {
+		return nullptr;
+	}
+	if (!document || stream.status() != QDataStream::Ok) {
+		return nullptr;
+	}
+	if (!attributes.isEmpty()) {
+		document->setattributes(attributes);
+	}
+	return document;
+}
+
+void WriteContent(QDataStream &stream, not_null<const HistoryItem*> item) {
+	const auto media = item->media();
+	const auto photo = media ? media->photo() : nullptr;
+	const auto document = media ? media->document() : nullptr;
+	if (photo) {
+		WriteText(stream, item->originalText());
+		stream
+			<< quint8(ContentKind::Photo)
+			<< SerializePhoto(photo)
+			<< quint8(media->hasSpoiler() ? 1 : 0);
+	} else if (document) {
+		WriteText(stream, item->originalText());
+		stream
+			<< quint8(ContentKind::Document)
+			<< SerializeDocument(document)
+			<< quint8(media->hasSpoiler() ? 1 : 0);
+	} else if (!media || media->webpage()) {
+		WriteText(stream, item->originalText());
+		stream << quint8(ContentKind::Text);
+	} else {
+		auto options = HistoryView::ToPreviewOptions();
+		options.hideSender = true;
+		options.generateImages = false;
+		options.ignoreGroup = true;
+		WriteText(stream, item->toPreview(options).text);
+		stream << quint8(ContentKind::Text);
+	}
+}
+
+[[nodiscard]] std::optional<Content> ReadContent(
+		QDataStream &stream,
+		not_null<Main::Session*> session,
+		qint32 appVersion) {
+	auto result = Content();
+	if (!ReadText(stream, result.text)) {
+		return std::nullopt;
+	}
+	auto kind = quint8();
+	stream >> kind;
+	if (kind == quint8(ContentKind::Photo)
+		|| kind == quint8(ContentKind::Document)) {
+		auto serialized = QByteArray();
+		auto spoiler = quint8();
+		stream >> serialized >> spoiler;
+		if (stream.status() != QDataStream::Ok) {
+			return std::nullopt;
+		}
+		result.spoiler = (spoiler != 0);
+		if (kind == quint8(ContentKind::Photo)) {
+			result.photo = DeserializePhoto(session, serialized);
+		} else {
+			result.document = DeserializeDocument(
+				session,
+				serialized,
+				appVersion);
+		}
+	} else if (kind != quint8(ContentKind::Text)) {
+		return std::nullopt;
+	}
+	if (stream.status() != QDataStream::Ok) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] not_null<HistoryItem*> MakeItem(
+		not_null<History*> history,
+		HistoryItemCommonFields &&fields,
+		const Content &content) {
+	fields.mediaSpoiler = content.spoiler;
+	if (const auto photo = content.photo) {
+		return history->makeMessage(
+			std::move(fields),
+			not_null<PhotoData*>(photo),
+			content.text);
+	} else if (const auto document = content.document) {
+		return history->makeMessage(
+			std::move(fields),
+			not_null<DocumentData*>(document),
+			content.text);
+	}
+	return history->makeMessage(
+		std::move(fields),
+		content.text,
+		MTP_messageMediaEmpty());
+}
+
+[[nodiscard]] MessageFlags SnapshotFlags(not_null<const HistoryItem*> item) {
+	auto result = MessageFlags(MessageFlag::FakeHistoryItem);
+	if (item->out()) {
+		result |= MessageFlag::Outgoing;
+	}
+	if (item->isPost()) {
+		result |= MessageFlag::Post;
+	}
+	if (item->from() != item->history()->peer) {
+		result |= MessageFlag::HasFromId;
+	}
+	return result;
+}
+
+[[nodiscard]] QByteArray SerializeDeleted(not_null<const HistoryItem*> item) {
+	const auto history = item->history();
+	const auto from = item->from();
+	const auto reply = item->replyTo();
+	const auto author = item->Get<HistoryMessageSigned>();
+	const auto via = item->viaBot();
+	auto flags = quint32();
+	if (item->out()) {
+		flags |= kOutgoing;
+	}
+	if (item->isPost()) {
+		flags |= kPost;
+	}
+	if (from != history->peer) {
+		flags |= kHasFrom;
+	}
+	auto peer = QByteArray();
+	if (from != history->peer && !from->isSelf()) {
+		auto buffer = QDataStream(&peer, QIODevice::WriteOnly);
+		Serialize::writePeer(Prepared(buffer), from);
+	}
+	auto result = QByteArray();
+	auto stream = QDataStream(&result, QIODevice::WriteOnly);
+	Prepared(stream)
+		<< quint32(flags)
+		<< SerializePeerId(from->id)
+		<< qint32(item->date())
+		<< SerializePeerId(reply.messageId.peer)
+		<< qint64(reply.messageId.msg.bare)
+		<< qint64(reply.topicRootId.bare)
+		<< SerializePeerId(reply.monoforumPeerId)
+		<< qint32(reply.quoteOffset);
+	WriteText(stream, reply.quote);
+	stream
+		<< (author ? author->author : QString())
+		<< quint64(item->groupId().raw())
+		<< quint64(via ? peerToUser(via->id).bare : 0)
+		<< peer;
+	WriteContent(stream, item);
+	return result;
+}
+
+[[nodiscard]] HistoryItem *DeserializeDeleted(
+		not_null<History*> history,
+		MsgId id,
+		const QByteArray &blob,
+		qint32 appVersion) {
+	const auto session = &history->session();
+	auto stream = QDataStream(blob);
+	Prepared(stream);
+	auto flags = quint32();
+	auto from = quint64();
+	auto date = qint32();
+	auto replyPeer = quint64();
+	auto replyId = qint64();
+	auto topicRootId = qint64();
+	auto monoforumPeer = quint64();
+	auto quoteOffset = qint32();
+	auto quote = TextWithEntities();
+	stream
+		>> flags
+		>> from
+		>> date
+		>> replyPeer
+		>> replyId
+		>> topicRootId
+		>> monoforumPeer
+		>> quoteOffset;
+	if (!ReadText(stream, quote)) {
+		return nullptr;
+	}
+	auto author = QString();
+	auto grouped = quint64();
+	auto via = quint64();
+	auto peer = QByteArray();
+	stream >> author >> grouped >> via >> peer;
+	if (stream.status() != QDataStream::Ok) {
+		return nullptr;
+	}
+	const auto fromId = DeserializePeerId(from);
+	if (!peer.isEmpty() && fromId && !session->data().peerLoaded(fromId)) {
+		auto buffer = QDataStream(peer);
+		Serialize::readPeer(session, appVersion, Prepared(buffer));
+	}
+	const auto content = ReadContent(stream, session, appVersion);
+	if (!content) {
+		return nullptr;
+	}
+	auto replyTo = FullReplyTo{
+		.messageId = FullMsgId(DeserializePeerId(replyPeer), MsgId(replyId)),
+		.quote = std::move(quote),
+		.topicRootId = MsgId(topicRootId),
+		.monoforumPeerId = DeserializePeerId(monoforumPeer),
+		.quoteOffset = quoteOffset,
+	};
+	if (replyTo.topicRootId == Data::ForumTopic::kGeneralId
+		&& !replyTo.messageId) {
+		replyTo.topicRootId = 0;
+	}
+	auto messageFlags = MessageFlags();
+	if (flags & kOutgoing) {
+		messageFlags |= MessageFlag::Outgoing;
+	}
+	if (flags & kPost) {
+		messageFlags |= MessageFlag::Post;
+	}
+	if ((flags & kHasFrom) && fromId) {
+		messageFlags |= MessageFlag::HasFromId;
+	}
+	if (replyTo.messageId || replyTo.topicRootId) {
+		messageFlags |= MessageFlag::HasReplyInfo;
+	}
+	if (!author.isEmpty()) {
+		messageFlags |= MessageFlag::HasPostAuthor;
+	}
+	return MakeItem(history, {
+		.id = id,
+		.flags = messageFlags,
+		.from = fromId,
+		.replyTo = std::move(replyTo),
+		.date = date,
+		.viaBotId = UserId(via),
+		.postAuthor = author,
+		.groupedId = grouped,
+	}, *content);
+}
+
+[[nodiscard]] QByteArray SerializeEdits(const KeptEditRecord &record) {
+	auto result = QByteArray();
+	auto stream = QDataStream(&result, QIODevice::WriteOnly);
+	Prepared(stream)
+		<< qint32(record.since)
+		<< quint8(record.original ? 1 : 0)
+		<< quint32(record.versions.size());
+	for (const auto &version : record.versions) {
+		stream
+			<< qint32(version.date)
+			<< quint8(version.original ? 1 : 0);
+		WriteContent(stream, version.item);
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<KeptEditRecord> DeserializeEdits(
+		not_null<const HistoryItem*> item,
+		const QByteArray &blob,
+		qint32 appVersion) {
+	const auto history = item->history();
+	const auto session = &history->session();
+	auto stream = QDataStream(blob);
+	Prepared(stream);
+	auto since = qint32();
+	auto original = quint8();
+	auto count = quint32();
+	stream >> since >> original >> count;
+	if (stream.status() != QDataStream::Ok || count > kMaxVersions) {
+		return std::nullopt;
+	}
+	auto result = KeptEditRecord{
+		.since = since,
+		.original = (original != 0),
+	};
+	auto parsed = std::vector<std::tuple<TimeId, bool, Content>>();
+	parsed.reserve(count);
+	for (auto i = quint32(); i != count; ++i) {
+		auto date = qint32();
+		auto first = quint8();
+		stream >> date >> first;
+		auto content = ReadContent(stream, session, appVersion);
+		if (!content) {
+			return std::nullopt;
+		}
+		parsed.emplace_back(date, (first != 0), std::move(*content));
+	}
+	if (parsed.empty()) {
+		return std::nullopt;
+	}
+	const auto from = item->from()->id;
+	result.versions.reserve(parsed.size());
+	for (const auto &[date, first, content] : parsed) {
+		const auto snapshot = MakeItem(history, {
+			.id = history->nextNonHistoryEntryId(),
+			.flags = SnapshotFlags(item),
+			.from = from,
+			.date = date,
+		}, content);
+		result.versions.push_back({
+			.item = snapshot,
+			.date = date,
+			.original = first,
+		});
+	}
+	return result;
+}
+
+[[nodiscard]] bool WriteEncryptedFile(
+		const QString &source,
+		QByteArray bytes,
+		const QString &path,
+		const MTP::AuthKeyPtr &key) {
+	auto input = std::unique_ptr<QIODevice>();
+	if (!source.isEmpty()) {
+		input = std::make_unique<QFile>(source);
+	} else {
+		input = std::make_unique<QBuffer>(&bytes);
+	}
+	if (!input->open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	QDir().mkpath(QFileInfo(path).absolutePath());
+	auto output = QFile(path);
+	if (!output.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	auto stream = QDataStream(&output);
+	Prepared(stream) << kFileMagic << kFileVersion;
+	while (stream.status() == QDataStream::Ok) {
+		const auto chunk = input->read(kChunkSize);
+		if (chunk.isEmpty()) {
+			break;
+		}
+		auto data = EncryptedDescriptor(chunk.size());
+		data.stream.writeRawData(chunk.constData(), chunk.size());
+		stream << PrepareEncrypted(data, key);
+	}
+	const auto ok = (stream.status() == QDataStream::Ok)
+		&& input->atEnd()
+		&& output.flush();
+	output.close();
+	if (!ok) {
+		QFile::remove(path);
+	}
+	return ok;
+}
+
+[[nodiscard]] bool DecryptFile(
+		const QString &from,
+		QIODevice &output,
+		const MTP::AuthKeyPtr &key) {
+	auto input = QFile(from);
+	if (!input.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	auto stream = QDataStream(&input);
+	Prepared(stream);
+	auto magic = quint32();
+	auto version = qint32();
+	stream >> magic >> version;
+	if (stream.status() != QDataStream::Ok
+		|| magic != kFileMagic
+		|| version != kFileVersion) {
+		return false;
+	}
+	const auto skip = int(sizeof(uint32));
+	while (!stream.atEnd()) {
+		auto encrypted = QByteArray();
+		stream >> encrypted;
+		auto data = EncryptedDescriptor();
+		if (stream.status() != QDataStream::Ok
+			|| !DecryptLocal(data, encrypted, key)
+			|| data.data.size() < skip) {
+			return false;
+		}
+		const auto size = data.data.size() - skip;
+		if (output.write(data.data.constData() + skip, size) != size) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QByteArray DecryptBytes(
+		const QString &from,
+		const MTP::AuthKeyPtr &key) {
+	auto result = QByteArray();
+	auto buffer = QBuffer(&result);
+	buffer.open(QIODevice::WriteOnly);
+	return DecryptFile(from, buffer, key) ? result : QByteArray();
+}
+
+[[nodiscard]] bool DecryptToFile(
+		const QString &from,
+		const QString &to,
+		const MTP::AuthKeyPtr &key) {
+	QDir().mkpath(QFileInfo(to).absolutePath());
+	auto output = QFile(to);
+	if (!output.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	const auto ok = DecryptFile(from, output, key) && output.flush();
+	output.close();
+	if (!ok) {
+		QFile::remove(to);
+	}
+	return ok;
+}
+
+[[nodiscard]] QString JournalPath(const QString &folder) {
+	return folder + u"journal"_q;
+}
+
+[[nodiscard]] int64 Weight(const Entry &entry) {
+	return entry.blob.size() + entry.mediaSize;
+}
+
+[[nodiscard]] int64 Footprint(const Entry &entry) {
+	return kOverhead
+		+ entry.blob.size()
+		+ entry.media.size() * int64(sizeof(QChar));
+}
+
+void WriteKey(QDataStream &stream, Op op, EntryKind kind, FullMsgId id) {
+	stream
+		<< quint8(op)
+		<< quint8(kind)
+		<< SerializePeerId(id.peer)
+		<< qint64(id.msg.bare);
+}
+
+void WritePut(
+		QDataStream &stream,
+		EntryKind kind,
+		FullMsgId id,
+		const Entry &entry) {
+	WriteKey(stream, Op::Put, kind, id);
+	stream
+		<< qint32(entry.stamp)
+		<< quint8(entry.own ? 1 : 0)
+		<< qint32(entry.appVersion)
+		<< entry.blob
+		<< entry.media
+		<< qint64(entry.mediaSize);
+}
