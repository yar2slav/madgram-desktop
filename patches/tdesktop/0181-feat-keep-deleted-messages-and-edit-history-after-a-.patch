+void StoreEditVersions(
+		not_null<const HistoryItem*> item,
+		const KeptEditRecord &record) {
+	if (const auto store = StoreFor(item)) {
+		store->storeEdits(item, record);
+	}
+}
+
+void ForgetEditVersions(not_null<const HistoryItem*> item) {
+	if (const auto store = StoreFor(item)) {
+		store->forgetEdits(item->fullId());
+	}
+}
+
+std::optional<KeptEditRecord> RestoreEditVersions(
+		not_null<const HistoryItem*> item) {
+	const auto store = StoreFor(item);
+	return store ? store->restoreEdits(item) : std::nullopt;
+}
+
+rpl::producer<int64> SavedHistorySizeValue(
+		not_null<Main::Session*> session) {
+	const auto store = Store::Find(session);
+	return store ? store->sizeValue() : rpl::single(int64());
+}
+
+void ClearSavedHistory(not_null<Main::Session*> session) {
+	if (const auto store = Store::Find(session)) {
+		store->clear();
+	}
+}
+
+} // namespace Tele
