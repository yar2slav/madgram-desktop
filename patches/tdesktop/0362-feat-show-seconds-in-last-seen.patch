diff --git a/Telegram/SourceFiles/tele/tele_last_seen_seconds.cpp b/Telegram/SourceFiles/tele/tele_last_seen_seconds.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cee9be3dd32225e17a4af961d062de947ed5b6b3
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_last_seen_seconds.cpp
@@ -0,0 +1,70 @@
+#include "tele/tele_last_seen_seconds.h"
+
+#include "base/unixtime.h"
+#include "data/data_changes.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "tele/tele_time.h"
+
+#include <QtCore/QLocale>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool Enabled() {
+	return MessageSeconds() && LastSeenSeconds();
+}
+
+void RefreshShown(not_null<Main::Session*> session) {
+	auto users = std::vector<not_null<UserData*>>();
+	session->data().enumerateUsers([&](not_null<UserData*> user) {
+		users.push_back(user);
+	});
+	for (const auto &user : users) {
+		session->changes().peerUpdated(
+			user,
+			Data::PeerUpdate::Flag::OnlineStatus);
+	}
+}
+
+} // namespace
+
+QString LastSeenTime(const QTime &time, bool seconds) {
+	return (seconds && Enabled())
+		? FormatMessageTime(time)
+		: QLocale().toString(time, QLocale::ShortFormat);
+}
+
+std::optional<QString> LastSeenExact(TimeId till, TimeId now) {
+	if (!Enabled() || (till <= 0)) {
+		return std::nullopt;
+	}
+	const auto online = base::unixtime::parse(till);
+	const auto today = base::unixtime::parse(now).date();
+	const auto time = FormatMessageTime(online.time());
+	if (online.date() == today) {
+		return tr::lng_status_lastseen_today(tr::now, lt_time, time);
+	} else if (online.date().addDays(1) == today) {
+		return tr::lng_status_lastseen_yesterday(tr::now, lt_time, time);
+	}
+	return tr::lng_status_lastseen_date_time(
+		tr::now,
+		lt_date,
+		QLocale().toString(online.date(), QLocale::ShortFormat),
+		lt_time,
+		time);
+}
+
+void SetupLastSeenSeconds(not_null<Main::Session*> session) {
+	rpl::merge(
+		MessageSecondsValue() | rpl::skip(1) | rpl::to_empty,
+		LastSeenSecondsValue() | rpl::skip(1) | rpl::to_empty
+	) | rpl::on_next([=] {
+		RefreshShown(session);
+	}, session->lifetime());
+}
+
+} // namespace Tele
