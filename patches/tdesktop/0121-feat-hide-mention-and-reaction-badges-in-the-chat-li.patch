@@ -1139,7 +1140,8 @@ void RowPainter::Paint(
 	const auto thread = row->thread();
 	const auto sublist = row->sublist();
 	const auto peer = history ? history->peer.get() : nullptr;
-	const auto badgesState = entry->chatListBadgesState();
+	const auto badgesState = Tele::VisibleUnreadBadges(
+		entry->chatListBadgesState());
 	entry->chatListPreloadData(); // Allow chat list message resolve.
 	const auto item = entry->chatListMessage();
 	const auto cloudDraft = [&]() -> const Data::Draft*{
@@ -1319,7 +1321,7 @@ void RowPainter::Paint(
 	previewOptions.searchLowerText = context.searchLowerText;
 
 	const auto badgesState = context.displayUnreadInfo
-		? entry->chatListBadgesState()
+		? Tele::VisibleUnreadBadges(entry->chatListBadgesState())
 		: BadgesState();
 	const auto displayPinnedIcon = false;
 
diff --git a/Telegram/SourceFiles/history/view/history_view_subsection_tabs.cpp b/Telegram/SourceFiles/history/view/history_view_subsection_tabs.cpp
index 9a4f2c9d3cdbd175c38cd4ab8ebabd31bd5e0221..e11ca116303455c6b692fe25536b319f4b649a5e 100644
