@@ -75,6 +76,10 @@ SubsectionTabs::SubsectionTabs(
 			refreshSlice();
 		}
 	}, _lifetime);
+
+	Tele::CornerButtonsHiddenChanges() | rpl::on_next([=] {
+		scheduleRefresh();
+	}, _lifetime);
 }
 
 SubsectionTabs::~SubsectionTabs() {
@@ -914,7 +919,7 @@ void SubsectionTabs::refreshSlice() {
 		}
 		slice.push_back({
 			.thread = thread,
-			.badges = badges,
+			.badges = Tele::VisibleUnreadBadges(badges),
 			.iconId = topic ? topic->iconId() : DocumentId(),
 			.name = thread->chatListName(),
 		});
diff --git a/Telegram/SourceFiles/tele/tele_corner_buttons.cpp b/Telegram/SourceFiles/tele/tele_corner_buttons.cpp
index a26a8bec8d16b1e9278bd4b266ceea3464754447..d2a955d7150084c311e532b60089d57edbddfc16 100644
--- a/Telegram/SourceFiles/tele/tele_corner_buttons.cpp
+++ b/Telegram/SourceFiles/tele/tele_corner_buttons.cpp
@@ -1,5 +1,6 @@
 #include "tele/tele_corner_buttons.h"
 
+#include "dialogs/dialogs_common.h"
 #include "history/view/history_view_corner_buttons.h"
 #include "tele/tele_options.h"
 
@@ -20,4 +21,14 @@ rpl::producer<> CornerButtonsHiddenChanges() {
 		HideReactionsButtonChanges());
 }
 
+Dialogs::BadgesState VisibleUnreadBadges(Dialogs::BadgesState state) {
+	if (HideMentionsButton()) {
+		state.mention = false;
+	}
+	if (HideReactionsButton()) {
+		state.reaction = false;
+	}
+	return state;
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_corner_buttons.h b/Telegram/SourceFiles/tele/tele_corner_buttons.h
index 66b8794f83a2cefcd14ee1ee8d9beda86acef87b..c8af8108b64f6921dab2558d7672104b8e280657 100644
--- a/Telegram/SourceFiles/tele/tele_corner_buttons.h
+++ b/Telegram/SourceFiles/tele/tele_corner_buttons.h
@@ -1,5 +1,9 @@
 #pragma once
 
+namespace Dialogs {
+struct BadgesState;
+} // namespace Dialogs
+
 namespace HistoryView {
 enum class CornerButtonType;
 } // namespace HistoryView
@@ -8,5 +12,7 @@ namespace Tele {
 
 [[nodiscard]] bool CornerButtonHidden(HistoryView::CornerButtonType type);
 [[nodiscard]] rpl::producer<> CornerButtonsHiddenChanges();
+[[nodiscard]] Dialogs::BadgesState VisibleUnreadBadges(
+	Dialogs::BadgesState state);
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
