 });
 
 base::options::toggle HideReactionsButtonOption({
 	.id = kOptionHideReactionsButton,
-	.name = "Hide the reactions button",
+	.name = "Hide unread reaction markers",
 });
 
 base::options::toggle EmojiPanelClickOption({
