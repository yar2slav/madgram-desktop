+++ b/Telegram/SourceFiles/history/view/history_view_subsection_tabs.cpp
@@ -25,6 +25,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "lang/lang_keys.h"
