+std::unique_ptr<Ui::SeparatePanel> CreateMtpPanel(const QString &title) {
+	auto result = std::make_unique<Ui::SeparatePanel>();
+	const auto panel = result.get();
+	panel->setObjectName(QString::fromLatin1(kPanelName));
+	panel->setWindowFlag(Qt::WindowStaysOnTopHint, false);
+	panel->setWindowTitle(title);
+	panel->setTitle(rpl::single(title));
+	Shortcuts::Listen(panel);
+
+	const auto active = QApplication::activeWindow();
+	const auto screen = active
+		? active->screen()
+		: QGuiApplication::primaryScreen();
+	const auto available = screen ? screen->availableGeometry() : QRect();
+	auto size = QSize(style::ConvertScale(1100), style::ConvertScale(720));
+	if (!available.isEmpty()) {
+		size = size.boundedTo(available.size());
+	}
+	panel->setInnerSize(size, true);
+
+	const auto frame = panel->size() - panel->innerGeometry().size();
+	panel->setMinimumSize(
+		QSize(style::ConvertScale(560), style::ConvertScale(400)) + frame);
+	if (!available.isEmpty()) {
+		const auto geometry = panel->geometry();
+		const auto bounded = geometry.size().boundedTo(
+			available.size()
+		).expandedTo(panel->minimumSize());
+		if (bounded != geometry.size()) {
+			auto rect = QRect(QPoint(), bounded);
+			rect.moveCenter(geometry.center());
+			rect.moveLeft(std::max(
+				available.left(),
+				std::min(
+					rect.left(),
+					available.left() + available.width() - rect.width())));
+			rect.moveTop(std::max(
+				available.top(),
+				std::min(
+					rect.top(),
+					available.top() + available.height() - rect.height())));
+			Ui::SetGeometryAndScreen(panel, rect);
+		}
+	}
+	return result;
+}
+
+bool CloseActiveMtpPanel() {
+	if (const auto panel = ActivePanel()) {
+		panel->close();
+		return true;
+	}
+	return false;
+}
+
+bool MinimizeActiveMtpPanel() {
+	if (const auto panel = ActivePanel()) {
+		panel->setWindowState(panel->windowState() | Qt::WindowMinimized);
+		return true;
+	}
+	return false;
+}
