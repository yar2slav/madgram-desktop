+
+[[nodiscard]] State *Find(not_null<Ui::RpWidget*> list) {
+	const auto &registry = Registry();
+	const auto i = registry.find(list);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] bool Contains(
+		not_null<State*> state,
+		const Data::SavedStarGiftId &id) {
+	return ranges::contains(
+		state->selected,
+		id,
+		&Data::SavedStarGift::manageId);
+}
+
+[[nodiscard]] QString GiftsCount(int count) {
+	return (count == 1)
+		? Lower(u"1 gift"_q)
+		: Lower(u"%1 gifts"_q).arg(count);
+}
+
+[[nodiscard]] bool Transferable(const Data::SavedStarGift &gift) {
+	const auto unique = gift.info.unique.get();
+	if (!unique
+		|| !unique->ownerId
+		|| (unique->starsForTransfer < 0)
+		|| (unique->canTransferAt > base::unixtime::now())) {
+		return false;
+	}
+	const auto chat = gift.manageId.chat();
+	return chat ? chat->canTransferGifts() : gift.mine;
+}
