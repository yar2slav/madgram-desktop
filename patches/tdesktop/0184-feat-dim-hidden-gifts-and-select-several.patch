+[[nodiscard]] QImage HiddenIcon() {
+	static auto result = st::menuIconStealth.instance(QColor(255, 255, 255));
+	return result;
+}
+
+void PaintHiddenBadge(QPainter &p, QRect inner) {
+	const auto icon = HiddenIcon();
+	const auto size = icon.size() / icon.devicePixelRatio();
+	const auto padding = style::ConvertScale(4);
+	const auto skip = st::giftBoxUserpicSkip;
+	const auto badge = QRect(
+		inner.x() + inner.width() - skip - size.width() - 2 * padding,
+		inner.y() + inner.height() - skip - size.height() - 2 * padding,
+		size.width() + 2 * padding,
+		size.height() + 2 * padding);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(QColor(0, 0, 0, 160));
+	const auto radius = badge.height() / 4.;
+	p.drawRoundedRect(badge, radius, radius);
+	p.drawImage(badge.x() + padding, badge.y() + padding, icon);
+}
+
+void UpdateChecks(not_null<State*> state, const Data::SavedStarGiftId &id) {
+	const auto checked = Contains(state, id);
+	for (const auto &[button, check] : Checks()) {
+		if (check->active
+			&& check->list == state->list.get()
+			&& check->id == id
+			&& check->checked != checked) {
+			check->checked = checked;
+			check->box->setChecked(checked);
+			button->update();
+		}
+	}
+}
