+void ToggleSaved(not_null<State*> state, bool save) {
+	auto list = std::vector<Data::SavedStarGiftId>();
+	for (const auto &gift : state->selected) {
+		if (gift.hidden == save) {
+			list.push_back(gift.manageId);
+		}
+	}
+	if (list.empty()) {
+		return;
+	}
+	state->busy = true;
+	const auto show = state->window->uiShow();
+	const auto session = &state->window->session();
+	const auto total = int(list.size());
+	const auto weak = base::make_weak(state->list);
+	const auto step = std::make_shared<Fn<void(int)>>();
+	*step = [=](int index) {
+		const auto strong = weak.get();
+		const auto current = strong ? Find(strong) : nullptr;
+		if (index == total) {
+			show->showToast(save
+				? Lower(u"%1 shown"_q).arg(GiftsCount(total))
+				: Lower(u"%1 hidden"_q).arg(GiftsCount(total)));
+			if (current) {
+				Finish(current);
+			}
+			*step = nullptr;
+			return;
+		}
+		using Flag = MTPpayments_SaveStarGift::Flag;
+		const auto id = list[index];
+		session->api().request(MTPpayments_SaveStarGift(
+			MTP_flags(save ? Flag(0) : Flag::f_unsave),
+			Api::InputSavedStarGiftId(id)
+		)).done([=] {
+			using Action = Data::GiftUpdate::Action;
+			session->data().notifyGiftUpdate({
+				.id = id,
+				.action = (save ? Action::Save : Action::Unsave),
+			});
+			if (const auto onstack = *step) {
+				onstack(index + 1);
+			}
+		}).fail([=](const MTP::Error &error) {
+			ShowError(show, error);
+			if (const auto strong = weak.get()) {
+				if (const auto current = Find(strong)) {
+					Finish(current);
+				}
+			}
+			*step = nullptr;
+		}).send();
+	};
+	(*step)(0);
+}
+
+void TogglePinned(not_null<State*> state, bool pin) {
+	auto list = std::vector<Data::SavedStarGiftId>();
+	for (const auto &gift : state->selected) {
+		if (gift.pinned != pin) {
+			list.push_back(gift.manageId);
+		}
+	}
+	if (list.empty()) {
+		return;
+	}
+	state->busy = true;
+	const auto show = state->window->uiShow();
+	const auto session = &state->window->session();
+	const auto peer = state->peer;
+	const auto weak = base::make_weak(state->list);
+	const auto finish = [=] {
+		if (const auto strong = weak.get()) {
+			if (const auto current = Find(strong)) {
+				Finish(current);
+			}
+		}
+	};
+	auto &recent = session->recentSharedGifts();
+	recent.request(peer, [=](std::vector<Data::SavedStarGift> pinned) {
+		auto ids = std::vector<Data::SavedStarGiftId>();
+		for (const auto &gift : pinned) {
+			if (gift.pinned
+				&& (pin || !ranges::contains(list, gift.manageId))) {
+				ids.push_back(gift.manageId);
+			}
+		}
+		if (pin) {
+			for (const auto &id : list) {
+				if (!ranges::contains(ids, id)) {
+					ids.push_back(id);
+				}
+			}
+			const auto limit = session->appConfig().pinnedGiftsLimit();
+			if (int(ids.size()) > limit) {
+				show->showToast(
+					Lower(u"You can pin up to %1."_q).arg(GiftsCount(limit)));
+				finish();
+				return;
+			}
+		}
+		auto inputs = QVector<MTPInputSavedStarGift>();
+		inputs.reserve(ids.size());
+		for (const auto &id : ids) {
+			inputs.push_back(Api::InputSavedStarGiftId(id));
+		}
+		session->api().request(MTPpayments_ToggleStarGiftsPinnedToTop(
+			peer->input(),
+			MTP_vector<MTPInputSavedStarGift>(std::move(inputs))
+		)).done([=] {
+			session->recentSharedGifts().clearLastRequestTime(peer);
+			using Action = Data::GiftUpdate::Action;
+			for (const auto &id : list) {
+				session->data().notifyGiftUpdate({
+					.id = id,
+					.action = (pin ? Action::Pin : Action::Unpin),
+				});
+			}
+			show->showToast(pin
+				? Lower(u"%1 pinned"_q).arg(GiftsCount(int(list.size())))
+				: Lower(u"%1 unpinned"_q).arg(GiftsCount(int(list.size()))));
+			finish();
+		}).fail([=](const MTP::Error &error) {
+			ShowError(show, error);
+			finish();
+		}).send();
+	}, true);
+}
