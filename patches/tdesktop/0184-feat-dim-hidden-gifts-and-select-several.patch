+void RunTransfer(
+		not_null<State*> state,
+		std::vector<Data::SavedStarGift> gifts,
+		not_null<PeerData*> to) {
+	state->busy = true;
+	const auto window = state->window;
+	const auto show = window->uiShow();
+	const auto total = int(gifts.size());
+	const auto weak = base::make_weak(state->list);
+	const auto progress = std::make_shared<rpl::variable<int>>(0);
+	const auto cancelled = std::make_shared<bool>(false);
+	auto box = Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Lower(u"Transferring gifts"_q)));
+		box->setCloseByOutsideClick(false);
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			progress->value() | rpl::map([=](int done) {
+				return Lower(u"%1 of %2"_q).arg(done + 1).arg(total);
+			}),
+			st::boxLabel));
+		box->addButton(tr::lng_cancel(), [=] {
+			*cancelled = true;
+			box->closeBox();
+		});
+	});
+	const auto progressBox = base::make_weak(box.data());
+	window->show(std::move(box));
+	const auto step = std::make_shared<Fn<void(int)>>();
+	const auto finish = [=](int done) {
+		if (const auto strong = progressBox.get()) {
+			strong->closeBox();
+		}
+		if (done < total) {
+			show->showToast(Lower(u"Transferred %1 of %2."_q)
+				.arg(done)
+				.arg(GiftsCount(total)));
+		} else {
+			show->showToast(Lower(u"%1 transferred to %2."_q)
+				.arg(GiftsCount(total))
+				.arg(to->shortName()));
+		}
+		if (const auto strong = weak.get()) {
+			if (const auto current = Find(strong)) {
+				Finish(current);
+			}
+		}
+		*step = nullptr;
+	};
+	*step = [=](int index) {
+		if (index == total || *cancelled) {
+			finish(index);
+			return;
+		}
+		*progress = index;
+		const auto &gift = gifts[index];
+		TransferUniqueGift(
+			window,
+			to,
+			gift.info.unique,
+			gift.manageId,
+			[=](bool ok) {
+				if (!ok) {
+					finish(index);
+				} else if (const auto onstack = *step) {
+					onstack(index + 1);
+				}
+			});
+	};
+	(*step)(0);
+}
+
+void Transfer(not_null<State*> state) {
+	const auto gifts = state->selected;
+	if (gifts.empty() || !ranges::all_of(gifts, Transferable)) {
+		return;
+	}
+	const auto window = state->window;
+	const auto weak = base::make_weak(state->list);
+	const auto chooser = std::make_shared<base::weak_qptr<PeerListBox>>();
+	const auto choose = [=](not_null<PeerData*> to) {
+		if (const auto strong = chooser->get()) {
+			strong->closeBox();
+		}
+		auto stars = int64();
+		for (const auto &gift : gifts) {
+			stars += std::max(gift.info.unique->starsForTransfer, 0);
+		}
+		const auto count = GiftsCount(int(gifts.size()));
+		const auto text = (stars > 0)
+			? Lower(u"Transfer %1 to %2 for %3 stars?"_q)
+				.arg(count)
+				.arg(to->shortName())
+				.arg(Lang::FormatCountDecimal(stars))
+			: Lower(u"Transfer %1 to %2?"_q)
+				.arg(count)
+				.arg(to->shortName());
+		window->show(Ui::MakeConfirmBox({
+			.text = text,
+			.confirmed = [=](Fn<void()> close) {
+				close();
+				if (const auto strong = weak.get()) {
+					if (const auto current = Find(strong)) {
+						if (!current->busy) {
+							RunTransfer(current, gifts, to);
+						}
+					}
+				}
+			},
+			.confirmText = tr::lng_gift_transfer_button(),
+		}));
+	};
+	auto controller = std::make_unique<RecipientController>(
+		&window->session(),
+		Lower(u"Transfer %1"_q).arg(GiftsCount(int(gifts.size()))),
+		choose);
+	auto box = Box<PeerListBox>(
+		std::move(controller),
+		[=](not_null<PeerListBox*> box) {
+			box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+		});
+	*chooser = base::make_weak(box.data());
+	window->show(std::move(box));
+}
+
+class Bar final : public Ui::RpWidget {
+public:
+	Bar(not_null<State*> state);
+
+	[[nodiscard]] static int FullHeight();
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+
+	not_null<Ui::RoundButton*> addAction(
+		const QString &text,
+		Fn<void()> callback);
+	void refresh();
+	void updateControlsGeometry();
+	void toggleEscape(bool enabled);
+
+	const not_null<State*> _state;
+	object_ptr<Ui::IconButton> _cancel;
+	std::vector<not_null<Ui::RoundButton*>> _actions;
+	Ui::RoundButton *_show = nullptr;
+	Ui::RoundButton *_hide = nullptr;
+	Ui::RoundButton *_transfer = nullptr;
+	Ui::RoundButton *_pin = nullptr;
+	Ui::RoundButton *_unpin = nullptr;
+	rpl::lifetime _escape;
+	QString _text;
+
+};
+
+Bar::Bar(not_null<State*> state)
+: RpWidget(state->scroll->parentWidget())
+, _state(state)
+, _cancel(this, st::dialogsMenuToggle) {
+	_cancel->setIconOverride(
+		&st::boxTitleCloseIcon,
+		&st::boxTitleCloseIconOver);
+	_cancel->setAccessibleName(tr::lng_cancel(tr::now));
+	_cancel->setClickedCallback([=] { SetActive(_state, false); });
+	_show = addAction(Lower(u"Show"_q), [=] { ToggleSaved(_state, true); });
+	_hide = addAction(Lower(u"Hide"_q), [=] { ToggleSaved(_state, false); });
+	_transfer = addAction(tr::lng_gift_transfer_button(tr::now), [=] {
+		Transfer(_state);
+	});
+	_pin = addAction(Lower(u"Pin"_q), [=] { TogglePinned(_state, true); });
+	_unpin = addAction(Lower(u"Unpin"_q), [=] {
+		TogglePinned(_state, false);
+	});
+
+	_state->scroll->geometryValue() | rpl::on_next([=](QRect geometry) {
+		const auto height = FullHeight();
+		setGeometry(
+			geometry.x(),
+			geometry.y() + geometry.height() - height,
+			geometry.width(),
+			height);
+	}, lifetime());
+	sizeValue() | rpl::on_next([=] {
+		updateControlsGeometry();
+	}, lifetime());
+	_state->changes.events() | rpl::on_next([=] {
+		refresh();
+	}, lifetime());
+	refresh();
+	toggleEscape(true);
+	show();
+	raise();
+}
+
+int Bar::FullHeight() {
+	const auto skip = st::dialogsFilterPadding;
+	return skip.y()
+		+ st::dialogsMenuToggle.height
+		+ st::defaultLightButton.height
+		+ 2 * skip.y();
+}
+
+not_null<Ui::RoundButton*> Bar::addAction(
+		const QString &text,
+		Fn<void()> callback) {
+	const auto button = Ui::CreateChild<Ui::RoundButton>(
+		this,
+		rpl::single(text),
+		st::defaultLightButton);
+	button->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	button->setClickedCallback([=] {
+		if (!_state->busy) {
+			callback();
+		}
+	});
+	_actions.push_back(button);
+	return button;
+}
+
+void Bar::refresh() {
+	const auto &selected = _state->selected;
+	const auto count = int(selected.size());
+	_text = Lower(u"%1 selected"_q).arg(count);
+	const auto any = (count > 0);
+	const auto allPinned = any
+		&& ranges::all_of(selected, &Data::SavedStarGift::pinned);
+	const auto pinnable = any
+		&& !allPinned
+		&& ranges::all_of(selected, [](const Data::SavedStarGift &gift) {
+			return gift.info.unique && !gift.hidden;
+		});
+	_show->setVisible(ranges::any_of(selected, &Data::SavedStarGift::hidden));
+	_hide->setVisible(ranges::any_of(selected, [](const auto &gift) {
+		return !gift.hidden;
+	}));
+	_transfer->setVisible(any && ranges::all_of(selected, Transferable));
+	_pin->setVisible(pinnable);
+	_unpin->setVisible(allPinned);
+	updateControlsGeometry();
+	raise();
+}
+
+void Bar::updateControlsGeometry() {
+	const auto skip = st::dialogsFilterPadding;
+	_cancel->moveToRight(skip.x(), skip.y());
+	auto visible = std::vector<not_null<Ui::RoundButton*>>();
+	for (const auto &button : _actions) {
+		if (!button->isHidden()) {
+			visible.push_back(button);
+		}
+	}
+	if (!visible.empty()) {
+		const auto count = int(visible.size());
+		const auto available = width() - (count + 1) * skip.x();
+		const auto single = std::max(available / count, 1);
+		auto left = skip.x();
+		const auto top = skip.y() + _cancel->height() + skip.y();
+		for (const auto &button : visible) {
+			button->setFullWidth(single);
+			button->moveToLeft(left, top);
+			left += single + skip.x();
+		}
+	}
+	update();
+}
+
+void Bar::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.fillRect(e->rect(), st::windowBg);
+	p.fillRect(0, 0, width(), st::lineWidth, st::shadowFg);
+	const auto &font = st::semiboldFont;
+	p.setFont(font);
+	p.setPen(st::windowBoldFg);
+	const auto skip = st::dialogsFilterPadding;
+	p.drawTextLeft(
+		skip.x() * 2,
+		skip.y() + (_cancel->height() - font->height) / 2,
+		width(),
+		_text);
+}
+
+void Bar::toggleEscape(bool enabled) {
+	if (!enabled) {
+		_escape.destroy();
+		return;
+	} else if (_escape) {
+		return;
+	}
+	base::install_event_filter(qApp, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::KeyPress) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto key = static_cast<QKeyEvent*>(e.get());
+		const auto content = parentWidget();
+		const auto focus = QApplication::focusWidget();
+		if (key->key() != Qt::Key_Escape
+			|| (key->modifiers() != Qt::NoModifier)
+			|| isHidden()
+			|| (QApplication::activeWindow() != window())
+			|| QApplication::activePopupWidget()
+			|| !focus
+			|| !(focus == content
+				|| content->isAncestorOf(focus)
+				|| focus->isAncestorOf(content))) {
+			return base::EventFilterResult::Continue;
+		}
+		SetActive(_state, false);
+		return base::EventFilterResult::Cancel;
+	}, _escape);
+}
+
+void SetActive(not_null<State*> state, bool active) {
+	if (state->active == active) {
+		return;
+	}
+	state->active = active;
+	state->selected.clear();
+	if (active) {
+		state->bar = base::make_unique_q<Bar>(state);
+	} else if (const auto bar = state->bar.release()) {
+		bar->hide();
+		bar->deleteLater();
+	}
+	state->refresh();
+}
+
+} // namespace
+
+bool PaintGiftButton(
+		QPainter &p,
+		not_null<QWidget*> button,
+		QRect inner,
+		const Info::PeerGifts::GiftDescriptor &descriptor,
+		Fn<void(QPainter&)> paint) {
+	const auto stars = std::get_if<Info::PeerGifts::GiftTypeStars>(
+		&descriptor);
+	const auto hidden = stars && stars->hidden && GiftHiddenDim();
+	const auto &checks = Checks();
+	const auto i = checks.find(button);
+	const auto check = (i != end(checks) && i->second->active)
+		? i->second.get()
+		: nullptr;
+	if (!hidden && !check) {
+		return false;
+	}
+	if (hidden) {
+		const auto ratio = style::DevicePixelRatio();
+		static auto cache = QImage();
+		const auto size = button->size() * ratio;
+		if (cache.width() < size.width() || cache.height() < size.height()) {
+			cache = QImage(
+				std::max(size.width(), cache.width()),
+				std::max(size.height(), cache.height()),
+				QImage::Format_ARGB32_Premultiplied);
+		}
+		cache.setDevicePixelRatio(ratio);
+		cache.fill(Qt::transparent);
+		auto q = QPainter(&cache);
+		paint(q);
+		q.end();
+		p.setOpacity(kHiddenOpacity);
+		p.drawImage(
+			button->rect(),
+			cache,
+			QRect(QPoint(), size));
+		p.setOpacity(1.);
+		PaintHiddenBadge(p, inner);
+	} else {
+		paint(p);
+	}
+	if (check) {
+		const auto skip = st::giftBoxUserpicSkip;
+		check->box->paint(
+			p,
+			inner.topLeft() + QPoint(skip, skip),
+			button->width(),
+			check->checked,
+			true);
+	}
+	return true;
+}
+
+void SetupGiftSelection(
+		not_null<Ui::RpWidget*> list,
+		Ui::ScrollArea *scroll,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		Fn<void()> refresh) {
+	if (!scroll || !GiftSelect() || !peer->canManageGifts()) {
+		return;
+	}
+	const auto state = list->lifetime().make_state<State>(
+		list,
+		scroll,
+		window,
+		peer,
+		std::move(refresh));
+	peer->owner().giftUpdates(
+	) | rpl::on_next([=](const Data::GiftUpdate &update) {
+		using Action = Data::GiftUpdate::Action;
+		auto &selected = state->selected;
+		const auto i = ranges::find_if(selected, [&](const auto &gift) {
+			return update.id
+				? (gift.manageId == update.id)
+				: (gift.info.unique && gift.info.unique->slug == update.slug);
+		});
+		if (i == end(selected)) {
+			return;
+		}
+		switch (update.action) {
+		case Action::Save: i->hidden = false; break;
+		case Action::Unsave: i->hidden = true; i->pinned = false; break;
+		case Action::Pin: i->pinned = true; break;
+		case Action::Unpin: i->pinned = false; break;
+		case Action::Convert:
+		case Action::Transfer:
+		case Action::Delete: selected.erase(i); break;
+		default: return;
+		}
+		state->changes.fire({});
+	}, list->lifetime());
+}
+
+void FillGiftSelectionMenu(
+		not_null<Ui::RpWidget*> list,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto state = Find(list);
+	if (!state || state->active || !GiftSelect()) {
+		return;
+	}
+	addAction(Lower(u"Select gifts"_q), [=] {
+		if (const auto current = Find(list)) {
+			SetActive(current, true);
+		}
+	}, &st::menuIconSelect);
+}
+
+bool GiftSelectionActive(not_null<Ui::RpWidget*> list) {
+	const auto state = Find(list);
+	return state && state->active;
+}
+
+bool GiftSelectionToggle(
+		not_null<Ui::RpWidget*> list,
+		const Data::SavedStarGift &gift) {
+	const auto state = Find(list);
+	if (!state || !state->active) {
+		return false;
+	} else if (state->busy) {
+		return true;
+	}
+	auto &selected = state->selected;
+	const auto i = ranges::find(
+		selected,
+		gift.manageId,
+		&Data::SavedStarGift::manageId);
+	if (i != end(selected)) {
+		selected.erase(i);
+	} else {
+		selected.push_back(gift);
+	}
+	UpdateChecks(state, gift.manageId);
+	state->changes.fire({});
+	return true;
+}
+
+void GiftSelectionApply(
+		not_null<Ui::RpWidget*> list,
+		not_null<QWidget*> button,
+		const Data::SavedStarGiftId &id) {
+	const auto state = Find(list);
+	if (!state) {
+		return;
+	}
+	auto &checks = Checks();
+	auto i = checks.find(button);
+	if (!state->active) {
+		if (i != end(checks) && i->second->active) {
+			i->second->active = false;
+			button->update();
+		}
+		return;
+	}
+	if (i == end(checks)) {
+		auto check = std::make_unique<Check>();
+		check->box = std::make_unique<Overview::Layout::Checkbox>(
+			[=] { button->update(); },
+			st::overviewSmallCheck);
+		i = checks.emplace(button, std::move(check)).first;
+		QObject::connect(button.get(), &QObject::destroyed, [=] {
+			Checks().remove(button);
+		});
+	}
+	const auto check = i->second.get();
+	const auto checked = Contains(state, id);
+	if (!check->active || check->id != id || check->checked != checked) {
+		check->box->setChecked(checked, anim::type::instant);
+	}
+	check->list = list.get();
+	check->id = id;
+	check->checked = checked;
+	check->active = true;
+	button->update();
+}
+
+int GiftSelectionBottomSkip(not_null<Ui::RpWidget*> list) {
+	const auto state = Find(list);
+	return (state && state->active) ? Bar::FullHeight() : 0;
+}
+
+} // namespace Tele
