diff --git a/Telegram/SourceFiles/tele/tele_export.cpp b/Telegram/SourceFiles/tele/tele_export.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ca842d749f7d194f3e2c907443c91341ca055567
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_export.cpp
@@ -0,0 +1,21 @@
+#include "tele/tele_export.h"
+
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kBigMessagesInFile = 10000;
+constexpr auto kBigFileChunkSize = 1024 * 1024;
+
+} // namespace
+
+int ExportMessagesInFile(int count) {
+	return BigExport() ? kBigMessagesInFile : count;
+}
+
+int ExportFileChunkSize(int size) {
+	return BigExport() ? kBigFileChunkSize : size;
+}
+
+} // namespace Tele
