+class RawResult final {
+public:
+	template <typename Prime>
+	[[nodiscard]] bool read(
+			const Prime *&from,
+			const Prime *end,
+			mtpTypeId cons = 0) {
+		bytes = QByteArray(
+			reinterpret_cast<const char*>(from),
+			(end - from) * sizeof(Prime));
+		from = end;
+		return true;
+	}
+
+	QByteArray bytes;
+
+};
+
+class RawMethod {
+public:
+	RawMethod() = default;
+	explicit RawMethod(QByteArray bytes) : _bytes(std::move(bytes)) {
+	}
+
+	[[nodiscard]] mtpTypeId type() const {
+		auto result = mtpTypeId();
+		memcpy(&result, _bytes.constData(), sizeof(result));
+		return result;
+	}
+
+	template <typename Prime>
+	[[nodiscard]] bool read(
+			const Prime *&from,
+			const Prime *end,
+			mtpTypeId cons) {
+		return false;
+	}
+
+	template <typename Accumulator>
+	void write(Accumulator &to) const {
+		tl::Writer<Accumulator>::PutBytes(
+			to,
+			_bytes.constData() + sizeof(mtpTypeId),
+			_bytes.size() - sizeof(mtpTypeId));
+	}
+
+	using ResponseType = RawResult;
+
+private:
+	QByteArray _bytes;
+
+};
+
+using RawRequest = tl::boxed<RawMethod>;
