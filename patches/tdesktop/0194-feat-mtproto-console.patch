+TlRuntime::Request MtpConsoleRequests::serialize() const {
+	return TlRuntime::Serialize(
+		ConsoleSchema(),
+		_current.value,
+		[=](const Value &value, std::string_view type) {
+			return resolve(value, type);
+		});
+}
+
+TlRuntime::Resolution MtpConsoleRequests::resolve(
+		const Value &value,
+		std::string_view type) const {
+	const auto fail = [](QString error) {
+		return TlRuntime::Resolution{ .error = error.toStdString() };
+	};
+	const auto wrapper = (type == "InputNotifyPeer")
+		? "inputNotifyPeer"
+		: (type == "InputDialogPeer")
+		? "inputDialogPeer"
+		: nullptr;
+	if (wrapper) {
+		auto result = resolve(value, "InputPeer");
+		if (!result.bytes.empty()) {
+			const auto id = ConsoleSchema().constructor(wrapper)->id;
+			auto prefix = std::string(4, '\0');
+			for (auto i = 0; i != 4; ++i) {
+				prefix[i] = char((id >> (8 * i)) & 0xFF);
+			}
+			result.bytes = prefix + result.bytes;
+		}
+		return result;
+	}
+	const auto name = FromStd(type);
+	const auto user = (type == "InputUser");
+	const auto channel = (type == "InputChannel");
+	if (!user && !channel && type != "InputPeer") {
+		return fail(Lower(u"expected "_q) + name);
+	}
+	const auto text = FromStd(value.text).trimmed();
+	const auto input = [&](not_null<PeerData*> peer) {
+		if (user) {
+			const auto found = peer->asUser();
+			if (!found) {
+				return fail(text + Lower(u" isn't a user"_q));
+			}
+			const auto result = found->inputUser();
+			noteResolved(text, DescribeInput(result));
+			return TlRuntime::Resolution{ .bytes = ToStd(
+				SerializeTl(result)) };
+		} else if (channel) {
+			const auto found = peer->asChannel();
+			if (!found) {
+				return fail(text + Lower(u" isn't a channel"_q));
+			}
+			const auto result = found->inputChannel();
+			noteResolved(text, DescribeInput(result));
+			return TlRuntime::Resolution{ .bytes = ToStd(
+				SerializeTl(result)) };
+		}
+		const auto result = peer->input();
+		noteResolved(text, DescribeInput(result));
+		return TlRuntime::Resolution{ .bytes = ToStd(SerializeTl(result)) };
+	};
+	const auto lower = text.toLower();
+	if (lower == u"me"_q || lower == u"@me"_q || lower == u"self"_q) {
+		if (user) {
+			return { .bytes = ToStd(
+				SerializeTl(MTPInputUser(MTP_inputUserSelf()))) };
+		} else if (!channel) {
+			return { .bytes = ToStd(
+				SerializeTl(MTPInputPeer(MTP_inputPeerSelf()))) };
+		}
+		return input(_session->user());
+	}
+	auto numeric = false;
+	const auto id = text.toLongLong(&numeric);
+	if (numeric) {
+		const auto peer = FindPeer(_session, id);
+		return peer
+			? input(peer)
+			: fail(Lower(u"Peer "_q) + text + Lower(u" isn't loaded"_q));
+	}
+	const auto target = ParseTarget(text);
+	if (!target) {
+		return fail(Lower(u"Can't use "_q) + text + Lower(u" as "_q) + name);
+	} else if (target->channel) {
+		const auto peer = _session->data().peerLoaded(
+			peerFromChannel(ChannelId(target->channel)));
+		return peer
+			? input(peer)
+			: fail(Lower(u"Channel "_q)
+				+ QString::number(target->channel)
+				+ Lower(u" isn't loaded"_q));
+	} else if (const auto peer = _session->data().peerByUsername(
+			target->username)) {
+		return input(peer);
+	} else if (_tried.contains(target->username.toLower())) {
+		return fail(Lower(u"Couldn't find @"_q) + target->username);
+	}
+	return { .pending = true };
+}
+
+void MtpConsoleRequests::noteResolved(
+		const QString &text,
+		QString input) const {
+	if (input.isEmpty()) {
+		return;
+	}
+	const auto i = ranges::find(
+		_resolved,
+		text,
+		&std::pair<QString, QString>::first);
+	if (i == end(_resolved)) {
+		_resolved.emplace_back(text, std::move(input));
+	}
+}
+
+void MtpConsoleRequests::prepare(int id) {
+	_resolved.clear();
+	auto request = serialize();
+	if (!request.error.empty()) {
+		finishLocal(id, FromStd(request.error));
+		return;
+	} else if (request.pending.empty()) {
+		sendRaw(
+			id,
+			QByteArray::fromStdString(request.bytes),
+			FromStd(request.type));
+		return;
+	}
+	auto usernames = QStringList();
+	for (const auto &text : request.pending) {
+		const auto target = ParseTarget(FromStd(text).trimmed());
+		if (target && !target->username.isEmpty()) {
+			usernames.push_back(target->username);
+		}
+	}
+	usernames.removeDuplicates();
+	if (usernames.isEmpty()) {
+		finishLocal(id, Lower(u"Couldn't resolve the peers."_q));
+		return;
+	}
+	_callbacks.status(
+		id,
+		Lower(u"Resolving "_q) + u"@"_q + usernames.join(u", @"_q));
+	resolveUsernames(id, usernames);
+}
+
+void MtpConsoleRequests::resolveUsernames(
+		int id,
+		const QStringList &usernames) {
+	const auto left = std::make_shared<int>(usernames.size());
+	const auto finish = [=] {
+		if (!--*left && _current.id == id) {
+			prepare(id);
+		}
+	};
+	for (const auto &username : usernames) {
+		_tried.emplace(username.toLower());
+		_api.request(MTPcontacts_ResolveUsername(
+			MTP_flags(0),
+			MTP_string(username),
+			MTPstring()
+		)).done([=](const MTPcontacts_ResolvedPeer &result) {
+			const auto &data = result.data();
+			_session->data().processUsers(data.vusers());
+			_session->data().processChats(data.vchats());
+			finish();
+		}).fail(finish).send();
+	}
+}
+
+void MtpConsoleRequests::sendRaw(int id, QByteArray bytes, QString type) {
+	auto resolved = QStringList();
+	for (const auto &[text, input] : _resolved) {
+		resolved.push_back(text + u" \u2192 "_q + input);
+	}
+	_current.resolved = resolved;
+	_callbacks.status(id, resolved.isEmpty()
+		? Lower(u"Sending"_q)
+		: (Lower(u"Sending, "_q) + resolved.join(u", "_q)));
+	_current.started = crl::now();
+	_current.requestId = _api.request(
+		RawRequest(std::move(bytes))
+	).done([=](const RawResult &result) {
+		received(id, result.bytes, type);
+	}).fail([=](const MTP::Error &error) {
+		failed(id, error);
+	}).send();
+}
+
+void MtpConsoleRequests::received(
+		int id,
+		const QByteArray &bytes,
+		const QString &type) {
+	if (_current.id != id) {
+		return;
+	}
+	const auto elapsed = int(crl::now() - _current.started);
+	const auto parsed = TlRuntime::Parse(
+		ConsoleSchema(),
+		std::string_view(bytes.constData(), bytes.size()),
+		type.toStdString());
+	auto json = std::string("{\"type\":");
+	MtpDump::AppendJsonString(json, type.toStdString());
+	json += ",\"size\":" + std::to_string(bytes.size()) + ",\"error\":";
+	MtpDump::AppendJsonString(json, parsed.error);
+	json += ",\"tree\":" + (parsed.json.empty()
+		? std::string("{\"err\":\"empty\"}")
+		: parsed.json) + '}';
+	_results.push_back({
+		.id = id,
+		.bytes = bytes,
+		.json = QByteArray::fromStdString(json),
+	});
+	if (_results.size() > kMaxResults) {
+		_results.erase(begin(_results));
+	}
+	const auto applied = applyUpdates(bytes);
+	const auto method = _current.method;
+	const auto resolved = _current.resolved;
+	remember(u"ok"_q, true, elapsed);
+	_current = Current();
+	_callbacks.done(QJsonObject{
+		{ u"id"_q, id },
+		{ u"ok"_q, true },
+		{ u"method"_q, method },
+		{ u"type"_q, type },
+		{ u"elapsed"_q, elapsed },
+		{ u"size"_q, int(bytes.size()) },
+		{ u"applied"_q, applied },
+		{ u"resolved"_q, QJsonArray::fromStringList(resolved) },
+	});
+}
+
+void MtpConsoleRequests::failed(int id, const MTP::Error &error) {
+	if (_current.id != id) {
+		return;
+	}
+	const auto elapsed = int(crl::now() - _current.started);
+	const auto resolved = _current.resolved;
+	remember(
+		QString::number(error.code()) + ' ' + error.type(),
+		false,
+		elapsed);
+	_current = Current();
+	_callbacks.done(QJsonObject{
+		{ u"id"_q, id },
+		{ u"ok"_q, false },
+		{ u"code"_q, error.code() },
+		{ u"type"_q, error.type() },
+		{ u"error"_q, error.description() },
+		{ u"elapsed"_q, elapsed },
+		{ u"resolved"_q, QJsonArray::fromStringList(resolved) },
+	});
+}
+
+void MtpConsoleRequests::finishLocal(int id, const QString &error) {
+	if (_current.id == id) {
+		_current = Current();
+	}
+	_callbacks.done(QJsonObject{
+		{ u"id"_q, id },
+		{ u"ok"_q, false },
+		{ u"error"_q, error },
+	});
+}
+
+bool MtpConsoleRequests::applyUpdates(const QByteArray &bytes) const {
+	if (bytes.size() < int(sizeof(mtpPrime))) {
+		return false;
+	}
+	auto from = reinterpret_cast<const mtpPrime*>(bytes.constData());
+	const auto end = from + (bytes.size() / sizeof(mtpPrime));
+	switch (mtpTypeId(*from)) {
+	case mtpc_updatesTooLong:
+	case mtpc_updateShortMessage:
+	case mtpc_updateShortChatMessage:
+	case mtpc_updateShort:
+	case mtpc_updatesCombined:
+	case mtpc_updates:
+	case mtpc_updateShortSentMessage: {
+		auto updates = MTPUpdates();
+		if (!updates.read(from, end)) {
+			return false;
+		}
+		_session->api().applyUpdates(updates);
+		return true;
+	}
+	case mtpc_payments_paymentResult: {
+		auto result = MTPpayments_PaymentResult();
+		if (!result.read(from, end)) {
+			return false;
+		}
+		_session->api().applyUpdates(
+			result.c_payments_paymentResult().vupdates());
+		return true;
+	}
+	}
+	return false;
+}
+
+void MtpConsoleRequests::remember(QString status, bool ok, int elapsed) {
+	const auto text = _current.text;
+	_history.erase(ranges::remove(_history, text, &Entry::text), end(_history));
+	_history.insert(begin(_history), Entry{
+		.text = text,
+		.method = _current.method,
+		.status = std::move(status),
+		.date = base::unixtime::now(),
+		.elapsed = elapsed,
+		.ok = ok,
+	});
+	if (_history.size() > kMaxHistory) {
+		_history.resize(kMaxHistory);
+	}
+	writeHistory();
+	_callbacks.historyChanged();
+}
+
+void MtpConsoleRequests::forget(int index) {
+	if (index < 0) {
+		_history.clear();
+	} else if (index < int(_history.size())) {
+		_history.erase(begin(_history) + index);
+	} else {
+		return;
+	}
+	writeHistory();
+	_callbacks.historyChanged();
+}
+
+QByteArray MtpConsoleRequests::result(int id) const {
+	const auto i = ranges::find(_results, id, &Result::id);
+	return (i != end(_results)) ? i->json : QByteArray();
+}
+
+QByteArray MtpConsoleRequests::resultPart(int id, int from, int till) const {
+	const auto i = ranges::find(_results, id, &Result::id);
+	if (i == end(_results)
+		|| from < 0
+		|| till <= from
+		|| till > i->bytes.size()) {
+		return QByteArray();
+	}
+	return i->bytes.mid(from, till - from);
+}
+
+QJsonArray MtpConsoleRequests::history() const {
+	auto result = QJsonArray();
+	for (const auto &entry : _history) {
+		result.push_back(QJsonObject{
+			{ u"t"_q, entry.text },
+			{ u"m"_q, entry.method },
+			{ u"d"_q, double(entry.date) },
+			{ u"e"_q, entry.elapsed },
+			{ u"s"_q, entry.status },
+			{ u"ok"_q, entry.ok },
+		});
+	}
+	return result;
+}
+
+QByteArray MtpConsoleRequests::peers() const {
+	auto result = QJsonArray();
+	const auto add = [&](not_null<PeerData*> peer) {
+		const auto username = peer->username();
+		result.push_back(QJsonObject{
+			{ u"u"_q, username },
+			{ u"id"_q, QString::number(BotApiId(peer)) },
+			{ u"n"_q, peer->name() },
+			{ u"k"_q, peer->isUser()
+				? u"user"_q
+				: peer->isChat()
+				? u"chat"_q
+				: peer->isMegagroup()
+				? u"group"_q
+				: u"channel"_q },
+		});
+	};
+	for (const auto &row : *_session->data().chatsList()->indexed()) {
+		const auto history = row->history();
+		if (!history || history->peer->isSelf()) {
+			continue;
+		}
+		add(history->peer);
+		if (result.size() >= kMaxPeers) {
+			break;
+		}
+	}
+	return QJsonDocument(result).toJson(QJsonDocument::Compact);
+}
+
+QString MtpConsoleRequests::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void MtpConsoleRequests::readHistory() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(file, u"tele_mtpconsole"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxHistory) {
+		return;
+	}
+	auto list = std::vector<Entry>();
+	list.reserve(count);
+	for (auto i = quint32(); i != count; ++i) {
+		auto entry = Entry();
+		auto date = qint32();
+		auto elapsed = qint32();
+		auto ok = qint32();
+		file.stream
+			>> entry.text
+			>> entry.method
+			>> entry.status
+			>> date
+			>> elapsed
+			>> ok;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		}
+		entry.date = TimeId(date);
+		entry.elapsed = int(elapsed);
+		entry.ok = (ok != 0);
+		list.push_back(std::move(entry));
+	}
+	_history = std::move(list);
+}
+
+void MtpConsoleRequests::writeHistory() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &entry : _history) {
+		size += Serialize::stringSize(entry.text)
+			+ Serialize::stringSize(entry.method)
+			+ Serialize::stringSize(entry.status)
+			+ sizeof(qint32) * 3;
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_history.size());
+	for (const auto &entry : _history) {
+		data.stream
+			<< entry.text
+			<< entry.method
+			<< entry.status
+			<< qint32(entry.date)
+			<< qint32(entry.elapsed)
+			<< qint32(entry.ok ? 1 : 0);
+	}
+	auto file = FileWriteDescriptor(u"tele_mtpconsole"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+} // namespace Tele
