+		'confirm', 'confirm-text', 'confirm-ok', 'confirm-cancel', 'mode-text', 'mode-json', 'mode-form', 'check',
+		'help', 'help-panel', 'help-box', 'highlight', 'format']) {
+		const key = id.replace(/-(\w)/g, function (all, letter) {
+			return letter.toUpperCase();
+		});
+		els[id.startsWith('mode-') ? id : key] = document.getElementById(id);
+	}
+	els.flash = el('div', 'flash ui');
+	document.body.appendChild(els.flash);
+	applyTheme();
+	bindSplit();
+	bindEditor();
+	bindHighlight();
+	for (const mode of ['text', 'json', 'form']) {
+		els['mode-' + mode].addEventListener('click', function () {
+			setMode(mode);
+		});
+	}
+	els.send.addEventListener('click', send);
+	els.format.addEventListener('click', formatInput);
+	els.help.addEventListener('click', function () {
+		hidePopup();
+		toggleHelp(!helpShown());
+	});
+	els.helpPanel.addEventListener('click', function (e) {
+		if (e.target === els.helpPanel) {
+			toggleHelp(false);
+		}
+	});
+	els.cancel.addEventListener('click', cancel);
+	els.historyClear.addEventListener('click', function () {
+		showModal('clear', 0, 'Clear the whole request history?', 'Clear', true);
+	});
+	els.confirmOk.addEventListener('click', modalOk);
+	els.confirmCancel.addEventListener('click', modalCancel);
+	els.confirm.addEventListener('click', function (e) {
+		if (e.target === els.confirm) {
+			modalCancel();
+		}
+	});
+	document.addEventListener('keydown', onKey);
+	window.addEventListener('resize', hidePopup);
+	updateModeUi();
+	formRender(null);
+	renderPending();
+	renderHistory();
+	renderPlaceholder();
+	updateHint();
+	fetchJson('schema.json').then(function (data) {
+		loadSchema(data);
+		renderPlaceholder();
+		updateHint();
+	}).catch(function () {
+		state.schemaFailed = true;
+		renderPending();
+		renderPlaceholder();
+	});
+	fetchJson('history/' + (++state.nonce) + '.json').then(function (list) {
+		state.history = Array.isArray(list) ? list : [];
+		renderHistory();
+	}).catch(function () {
+	});
+	loadPeers();
+	focusEditor();
+}
+
+window.MtpConsole = {
+	status: function (data) {
+		const pending = state.pending;
+		if (pending && data && data.id === pending.id) {
+			pending.status = String(data.text || '');
+			renderPending();
+		}
+	},
+	confirm: function (data) {
+		const pending = state.pending;
+		if (pending && data && data.id === pending.id) {
+			showModal('send', data.id, String(data.text || ''), 'Send', false);
+		}
+	},
+	done: function (data) {
+		const pending = state.pending;
+		if (!pending || !data || data.id !== pending.id) {
+			return;
+		}
+		stopPending();
+		renderResult(data.id, data.method || pending.method, data);
+	},
+	history: function (list) {
+		state.history = Array.isArray(list) ? list : [];
+		if (els.historyList) {
+			renderHistory();
+			loadPeers();
+		}
+	},
+	flash: function (data) {
+		if (els.flash) {
+			flash(String(data && data.text || ''), 5000);
+		}
+	},
+	updateStyles: function (styles) {
+		document.documentElement.setAttribute('style', styles);
+		applyTheme();
+	},
+	focus: function () {
+		if (els.input) {
+			focusEditor();
+		}
+	},
+};
+
+document.addEventListener('DOMContentLoaded', init);
+})();
