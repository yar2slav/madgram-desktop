@@ -0,0 +1,624 @@
+html[data-lower="1"] #method::placeholder {
+	text-transform: lowercase;
+}
+[hidden] {
+	display: none !important;
+}
+::placeholder {
+	color: var(--dim);
+	opacity: .8;
+}
+.modes {
+	display: flex;
+}
+.mode {
+	color: var(--dim);
+	background: transparent;
+	padding: 2px 12px;
+}
+.mode + .mode {
+	border-left: none;
+}
+.mode.on {
+	color: var(--active-fg);
+	background: var(--active-bg);
+	border-color: var(--active-bg);
+}
+#send {
+	color: var(--accent);
+	font-weight: 600;
+}
+#history {
+	flex: 0 0 260px;
+	display: flex;
+	flex-direction: column;
+	min-height: 0;
+	border-right: 1px solid var(--divider);
+}
+#history-list {
+	flex: 1 1 auto;
+	overflow: auto;
+	min-height: 0;
+}
+#history-empty {
+	flex: 1 1 auto;
+	padding: 16px 12px;
+	color: var(--dim);
+	font-size: 12px;
+}
+#history-foot {
+	flex: 0 0 auto;
+	padding: 8px 10px;
+	border-top: 1px solid var(--divider);
+}
+.hrow {
+	padding: 5px 10px 6px;
+	border-bottom: 1px solid var(--divider);
+	font-size: 12px;
+	cursor: pointer;
+	user-select: none;
+}
+.hrow:hover {
+	background: var(--bg-over);
+}
+.hrow-top,
+.hrow-bottom {
+	display: flex;
+	align-items: baseline;
+	gap: 8px;
+	white-space: nowrap;
+}
+.hrow-method {
+	flex: 1 1 auto;
+	min-width: 0;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+.hrow-actions {
+	flex: 0 0 auto;
+	display: flex;
+	gap: 8px;
+	visibility: hidden;
+}
+.hrow:hover .hrow-actions {
+	visibility: visible;
+}
+.hrow-actions .link {
+	color: var(--dim);
+}
+.hrow-actions .link:hover {
+	color: var(--accent);
+}
+.hrow-status {
+	flex: 1 1 auto;
+	min-width: 0;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	color: var(--syntax-type);
+}
+.hrow-status.fail {
+	color: var(--attention);
+}
+.hrow-meta {
+	flex: 0 0 auto;
+	color: var(--dim);
+}
+#work {
+	flex: 1 1 0;
+	display: flex;
+	flex-direction: column;
+	min-width: 0;
+	min-height: 0;
+}
+#editor {
+	flex: 0 0 35%;
+	display: flex;
+	flex-direction: column;
+	padding: 10px 12px 4px;
+}
+#text-pane {
+	position: relative;
+	flex: 1 1 0;
+	display: flex;
+	min-height: 48px;
+	background: var(--td-filter-input-inactive-bg);
+}
+#highlight {
+	position: absolute;
+	left: 0;
+	top: 0;
+	margin: 0;
+	padding: 6px 8px;
+	border: 0;
+	font: inherit;
+	color: var(--text);
+	background: transparent;
+	tab-size: 2;
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+	overflow: hidden;
+	pointer-events: none;
+	z-index: 0;
+}
+#input {
+	position: relative;
+	z-index: 1;
+	flex: 1 1 auto;
+	min-height: 0;
+	resize: none;
+	font: inherit;
+	color: transparent;
+	caret-color: var(--text);
+	background: transparent;
+	border: 1px solid var(--border);
+	padding: 6px 8px;
+	outline: none;
+	tab-size: 2;
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+#input::placeholder {
+	color: var(--dim);
+}
+#input::selection {
+	color: transparent;
+	background: color-mix(in srgb, var(--accent) 30%, transparent);
+}
+.composing #input {
+	color: var(--text);
+}
+.composing #highlight {
+	visibility: hidden;
+}
+.hl-method {
+	color: var(--accent);
+}
+.hl-ctor {
+	color: var(--syntax-type);
+	text-decoration: underline dotted;
+	text-underline-offset: 2px;
+}
+.hl-key {
+	color: var(--syntax-key);
+}
+.hl-string {
+	color: var(--syntax-type);
+}
+.hl-number {
+	color: var(--syntax-number);
+}
+.hl-literal {
+	color: var(--syntax-bool);
+}
+.hl-peer {
+	color: var(--syntax-invisible);
+}
+.hl-punct,
+.hl-comment {
+	color: var(--dim);
+}
+.hl-invalid {
+	color: var(--attention);
+	text-decoration: underline wavy var(--attention);
+}
+.hl-bracket,
+.hl-word {
+	color: var(--text);
+}
+#input:focus,
+#method:focus,
+.form-text:focus,
+select.form-control:focus {
+	border-color: var(--accent);
+}
+#form-pane {
+	flex: 1 1 0;
+	min-height: 96px;
+	overflow: auto;
+	padding-right: 4px;
+}
+.form-head {
+	display: flex;
+	align-items: center;
+	gap: 10px;
+	margin-bottom: 8px;
+}
+.form-label {
+	color: var(--dim);
+}
+#method,
+.form-text,
+select.form-control {
+	font: inherit;
+	color: var(--text);
+	background: var(--td-filter-input-inactive-bg);
+	border: 1px solid var(--border);
+	padding: 2px 6px;
+	outline: none;
+	min-width: 0;
+}
+#method {
+	flex: 0 1 420px;
+	padding: 3px 8px;
+}
+#form {
+	display: grid;
+	grid-template-columns: max-content minmax(0, max-content) minmax(160px, 1fr);
+	gap: 4px 12px;
+	align-items: center;
+	padding-bottom: 6px;
+}
+.form-row {
+	display: contents;
+}
+.form-name {
+	color: var(--syntax-key);
+	white-space: nowrap;
+}
+.form-required {
+	color: var(--attention);
+	margin-left: 2px;
+}
+.form-type {
+	max-width: 280px;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+	font-size: 12px;
+}
+.form-optional {
+	color: var(--dim);
+	margin-left: 6px;
+	font-size: 11px;
+}
+.form-other .form-name {
+	color: var(--dim);
+}
+.form-note {
+	grid-column: 1 / -1;
+	color: var(--attention);
+	font-size: 12px;
+}
+select.form-control {
+	justify-self: start;
+	min-width: 90px;
+}
+input[type="checkbox"].form-control {
+	justify-self: start;
+	margin: 0;
+	accent-color: var(--accent);
+}
+#hint {
+	flex: 0 0 auto;
+	min-height: 22px;
+	padding: 2px 0;
+	line-height: 18px;
+	font-size: 12px;
+	color: var(--dim);
+}
+.hint-line {
+	padding-left: 4ch;
+	text-indent: -4ch;
+	white-space: normal;
+	overflow-wrap: anywhere;
+}
+.hint-param {
+	white-space: nowrap;
+}
+.hint-current {
+	background: var(--bg-over);
+	outline: 1px solid var(--border);
+}
+.hint-missing .hint-key {
+	color: var(--attention);
+	text-decoration: underline wavy var(--attention);
+	text-underline-offset: 3px;
+}
+.hint-accepts {
+	color: var(--dim);
+}
+#check {
+	display: none;
+	flex: 0 0 auto;
+	padding-bottom: 2px;
+	font-size: 12px;
+	line-height: 18px;
+	color: var(--attention);
+	overflow-wrap: anywhere;
+}
+#check.shown {
+	display: block;
+}
+.check-label {
+	color: var(--dim);
+}
+.form-row.missing .form-name {
+	color: var(--attention);
+	text-decoration: underline wavy var(--attention);
+	text-underline-offset: 3px;
+}
+.form-row.missing .form-control,
+.form-row.invalid .form-control {
+	border-color: var(--attention);
+}
+.form-row.invalid .form-name {
+	color: var(--attention);
+}
+.result-resolved {
+	margin: -4px 0 10px;
+	font-size: 12px;
+	color: var(--dim);
+	overflow-wrap: anywhere;
+}
+#help.on {
+	color: var(--accent);
+	border-color: var(--accent);
+}
+.help-box {
+	max-width: 760px;
+	width: calc(100% - 32px);
+	max-height: calc(100% - 32px);
+	overflow-y: auto;
+	white-space: normal;
+}
+.help-head {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	margin-bottom: 10px;
+}
+.help-title {
+	font-weight: 600;
+}
+.help-grid {
+	display: grid;
+	grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
+	gap: 3px 16px;
+	font-size: 12px;
+}
+.help-section {
+	grid-column: 1 / -1;
+	margin-top: 8px;
+	color: var(--accent);
+}
+.help-code {
+	color: var(--syntax-key);
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+.help-text {
+	color: var(--dim);
+}
+.hint-name,
+.hint-owner {
+	color: var(--text);
+	font-weight: 600;
+}
+.hint-key {
+	color: var(--syntax-key);
+}
+.hint-type {
+	color: var(--syntax-type);
+}
+.hint-note {
+	margin-left: 8px;
+	color: var(--dim);
+}
+#error {
+	display: none;
+	flex: 0 0 auto;
+	max-height: 60px;
+	overflow: auto;
+	padding-bottom: 4px;
+	font-size: 12px;
+	color: var(--attention);
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+#error.shown {
+	display: block;
+}
+#hsplit {
+	flex: 0 0 5px;
+	cursor: row-resize;
+	border-bottom: 1px solid var(--divider);
+}
+#hsplit:hover {
+	background: var(--bg-over);
+}
+#pending {
+	display: none;
+	padding: 4px 16px;
+	font-size: 12px;
+	white-space: pre;
+	text-overflow: ellipsis;
+	overflow: hidden;
+	border-bottom: 1px solid var(--divider);
+	background: var(--bg-over);
+}
+#pending.shown {
+	display: block;
+}
+.pending-dot {
+	display: inline-block;
+	vertical-align: middle;
+	width: 7px;
+	height: 7px;
+	margin-right: 8px;
+	border-radius: 50%;
+	background: var(--accent);
+	animation: pulse 1s ease-in-out infinite alternate;
+}
+@keyframes pulse {
+	from {
+		opacity: .25;
+	}
+	to {
+		opacity: 1;
+	}
+}
+.pending-method {
+	font-weight: 600;
+}
+.pending-status {
+	color: var(--accent);
+}
+.pending-time {
+	color: var(--dim);
+}
+#output {
+	flex: 1 1 0;
+	min-height: 0;
+	overflow: auto;
+	padding: 12px 16px 24px;
+}
+#output.stale {
+	opacity: .55;
+}
+.placeholder {
+	color: var(--dim);
+	padding-top: 6px;
+}
+.placeholder-layer {
+	margin-top: 4px;
+	font-size: 12px;
+}
+.result-head {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: baseline;
+	gap: 4px 8px;
+	margin-bottom: 12px;
+	padding-bottom: 10px;
+	border-bottom: 1px solid var(--divider);
+}
+.result-method {
+	font-weight: 600;
+}
+.result-type {
+	color: var(--syntax-type);
+	cursor: pointer;
+}
+.result-type:hover {
+	text-decoration: underline;
+}
+.result-meta {
+	margin-left: auto;
+	display: flex;
+	gap: 12px;
+	font-size: 12px;
+	color: var(--dim);
+	white-space: nowrap;
+}
+.result-applied {
+	color: var(--syntax-type);
+}
+.result-error {
+	margin-bottom: 12px;
+	padding: 10px 14px;
+	border-left: 3px solid var(--attention);
+	background: var(--bg-over);
+}
+.error-title {
+	font-size: 16px;
+	font-weight: 600;
+	color: var(--attention);
+	overflow-wrap: anywhere;
+}
+.error-code {
+	margin-right: 10px;
+}
+.error-type {
+	cursor: pointer;
+}
+.error-type:hover {
+	text-decoration: underline;
+}
+.error-local {
+	font-size: 14px;
+	white-space: pre-wrap;
+}
+.error-text {
+	margin-top: 6px;
+	font-size: 12px;
+	color: var(--text);
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+#popup {
+	display: none;
+	position: fixed;
+	z-index: 20;
+	min-width: 280px;
+	max-width: min(620px, calc(100vw - 8px));
+	max-height: 320px;
+	overflow-y: auto;
+	padding: 2px 0;
+	font-size: 12px;
+	background: var(--bg);
+	border: 1px solid var(--border);
+	box-shadow: 0 6px 18px rgba(0, 0, 0, .2);
+}
+#popup.shown {
+	display: block;
+}
+.ac-item {
+	display: flex;
+	align-items: baseline;
+	gap: 8px;
+	padding: 2px 10px;
+	white-space: nowrap;
+	cursor: pointer;
+}
+.ac-item:hover {
+	background: var(--bg-over);
+}
+.ac-item.selected {
+	color: var(--active-fg);
+	background: var(--active-bg);
+}
+.ac-name {
+	flex: 0 1 auto;
+	min-width: 0;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+.ac-detail {
+	flex: 0 1 auto;
+	min-width: 0;
+	margin-left: auto;
+	padding-left: 16px;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	color: var(--dim);
+}
+.ac-danger {
+	flex: 0 0 auto;
+	font-size: 11px;
+	color: var(--attention);
+}
+.ac-optional {
+	flex: 0 0 auto;
+	font-size: 11px;
+	color: var(--dim);
+}
+.ac-item.selected .ac-detail,
+.ac-item.selected .ac-optional,
+.ac-item.selected .ac-danger {
+	color: var(--active-fg);
+}
+.ac-item.selected .ac-danger {
+	font-weight: 600;
+}
+.mirror {
+	position: absolute;
+	top: 0;
+	left: -10000px;
+	visibility: hidden;
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+	height: auto;
+}
+#confirm-text {
+	overflow-wrap: anywhere;
+}
diff --git a/Telegram/Resources/tele_html/mtp_console.html b/Telegram/Resources/tele_html/mtp_console.html
