+struct Target {
+	QString username;
+	BareId channel = 0;
+};
+
+[[nodiscard]] bool ValidUsername(const QString &username) {
+	static const auto regexp = QRegularExpression(
+		u"^[A-Za-z0-9_]{1,64}$"_q);
+	return regexp.match(username).hasMatch();
+}
+
+[[nodiscard]] std::optional<Target> ParseTarget(QString text) {
+	if (text.startsWith('@')) {
+		const auto username = text.mid(1);
+		return ValidUsername(username)
+			? std::make_optional(Target{ .username = username })
+			: std::nullopt;
+	}
+	const auto lower = text.toLower();
+	if (lower.startsWith(u"tg://resolve?"_q)) {
+		for (const auto &part : text.mid(13).split('&')) {
+			if (part.startsWith(u"domain="_q, Qt::CaseInsensitive)) {
+				const auto username = part.mid(7);
+				return ValidUsername(username)
+					? std::make_optional(Target{ .username = username })
+					: std::nullopt;
+			}
+		}
+		return std::nullopt;
+	}
+	auto path = text;
+	for (const auto &scheme : { u"https://"_q, u"http://"_q }) {
+		if (lower.startsWith(scheme)) {
+			path = text.mid(scheme.size());
+			break;
+		}
+	}
+	auto found = false;
+	for (const auto &host : {
+			u"t.me/"_q,
+			u"www.t.me/"_q,
+			u"telegram.me/"_q,
+			u"telegram.dog/"_q }) {
+		if (path.startsWith(host, Qt::CaseInsensitive)) {
+			path = path.mid(host.size());
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		static const auto plain = QRegularExpression(
+			u"^[A-Za-z][A-Za-z0-9_]{2,63}$"_q);
+		return plain.match(text).hasMatch()
+			? std::make_optional(Target{ .username = text })
+			: std::nullopt;
+	}
+	path = path.section('?', 0, 0).section('#', 0, 0);
+	const auto parts = path.split('/', Qt::SkipEmptyParts);
+	if (parts.isEmpty()) {
+		return std::nullopt;
+	} else if (parts[0] == u"c"_q && parts.size() > 1) {
+		auto ok = false;
+		const auto channel = parts[1].toULongLong(&ok);
+		return (ok && channel)
+			? std::make_optional(Target{ .channel = BareId(channel) })
+			: std::nullopt;
+	}
+	const auto username = (parts[0] == u"s"_q && parts.size() > 1)
+		? parts[1]
+		: parts[0];
+	return ValidUsername(username)
+		? std::make_optional(Target{ .username = username })
+		: std::nullopt;
+}
+
+[[nodiscard]] PeerData *FindPeer(not_null<Main::Session*> session, int64 id) {
+	auto &data = session->data();
+	if (id < 0) {
+		return (id <= -kChannelShift)
+			? data.peerLoaded(peerFromChannel(
+				ChannelId(BareId(-id - kChannelShift))))
+			: data.peerLoaded(peerFromChat(ChatId(BareId(-id))));
+	}
+	const auto bare = BareId(id);
+	for (const auto peerId : {
+			peerFromUser(UserId(bare)),
+			peerFromChannel(ChannelId(bare)),
+			peerFromChat(ChatId(bare)) }) {
+		if (const auto peer = data.peerLoaded(peerId)) {
+			return peer;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] int64 BotApiId(not_null<PeerData*> peer) {
+	if (const auto user = peer->asUser()) {
+		return int64(peerToUser(user->id).bare);
+	} else if (const auto chat = peer->asChat()) {
+		return -int64(peerToChat(chat->id).bare);
+	}
+	return -kChannelShift - int64(peerToChannel(peer->id).bare);
+}
+
+[[nodiscard]] QString DescribeInput(const MTPInputPeer &input) {
+	return input.match([](const MTPDinputPeerUser &data) {
+		return u"inputPeerUser(user_id:%1, access_hash:%2)"_q
+			.arg(int64(data.vuser_id().v))
+			.arg(int64(data.vaccess_hash().v));
+	}, [](const MTPDinputPeerChat &data) {
+		return u"inputPeerChat(chat_id:%1)"_q.arg(int64(data.vchat_id().v));
+	}, [](const MTPDinputPeerChannel &data) {
+		return u"inputPeerChannel(channel_id:%1, access_hash:%2)"_q
+			.arg(int64(data.vchannel_id().v))
+			.arg(int64(data.vaccess_hash().v));
+	}, [](const MTPDinputPeerSelf &) {
+		return u"inputPeerSelf"_q;
+	}, [](const auto &) {
+		return QString();
+	});
+}
+
+[[nodiscard]] QString DescribeInput(const MTPInputUser &input) {
+	return input.match([](const MTPDinputUser &data) {
+		return u"inputUser(user_id:%1, access_hash:%2)"_q
+			.arg(int64(data.vuser_id().v))
+			.arg(int64(data.vaccess_hash().v));
+	}, [](const MTPDinputUserSelf &) {
+		return u"inputUserSelf"_q;
+	}, [](const auto &) {
