+void MtpConsoleRequests::send(
+		int id,
+		const QJsonValue &request,
+		const QString &text,
+		bool confirmed) {
+	if (_current.id) {
+		cancel(_current.id);
+	}
+	auto value = ValueFromJson(request);
+	if (!value || value->type != Value::Type::Object) {
+		finishLocal(id, Lower(u"The request is malformed."_q));
+		return;
+	}
+	_tried.clear();
+	const auto method = FromStd(value->text);
+	_current = Current{
+		.id = id,
+		.value = std::move(*value),
+		.text = text,
+		.method = method,
+	};
+	const auto checked = serialize();
+	if (!checked.error.empty()) {
+		finishLocal(id, FromStd(checked.error));
+		return;
+	}
+	auto methods = std::vector<const Value*>();
+	CollectMethods(_current.value, methods);
+	if (!confirmed) {
+		auto destructive = QStringList();
+		auto paid = QStringList();
+		for (const auto method : methods) {
+			if (const auto danger = FindDanger(method->text)) {
+				(danger->action ? paid : destructive).push_back(
+					FromStd(method->text));
+			}
+		}
+		destructive.removeDuplicates();
+		paid.removeDuplicates();
+		if (!destructive.isEmpty() || !paid.isEmpty()) {
+			auto parts = QStringList();
+			if (!destructive.isEmpty()) {
+				parts.push_back(destructive.join(u", "_q)
+					+ Lower(u" can't be undone."_q));
+			}
+			if (!paid.isEmpty()) {
+				parts.push_back(paid.join(u", "_q)
+					+ Lower(u" can spend Stars or give away gifts."_q));
+			}
+			parts.push_back(Lower(u"Send it anyway?"_q));
+			_callbacks.confirm(id, parts.join(' '));
+			return;
+		}
+	}
+	for (const auto method : methods) {
+		const auto action = PasswordAction(*method);
+		if (!action || !LocalPasswordNeeded(*action)) {
+			continue;
+		}
+		if (!_show->valid()) {
+			finishLocal(id, Lower(u"Open the main window to enter "
+				"the local password."_q));
+			return;
+		}
+		_callbacks.status(id, Lower(u"Waiting for the local password"_q));
+		ActivateWindowOf(_show);
+		RequireLocalPassword(_show, *action, crl::guard(this, [=] {
+			if (_current.id == id) {
+				prepare(id);
+			}
+		}), crl::guard(this, [=] {
+			if (_current.id == id) {
+				finishLocal(id, Lower(u"Cancelled."_q));
+			}
+		}));
+		return;
+	}
+	prepare(id);
+}
+
+void MtpConsoleRequests::cancel(int id) {
+	if (_current.id != id) {
+		return;
+	}
+	if (_current.requestId) {
+		_api.request(_current.requestId).cancel();
+	}
+	_current = Current();
+}
