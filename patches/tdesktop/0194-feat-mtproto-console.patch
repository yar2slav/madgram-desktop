+[[nodiscard]] const TlRuntime::Schema &ConsoleSchema() {
+	static const auto result = [] {
+		auto schema = TlRuntime::Schema();
+		for (const auto &[name, methods] : {
+				std::pair{ u"api.tl"_q, true },
+				std::pair{ u"mtproto.tl"_q, false } }) {
+			auto file = QFile(u":/tele/"_q + name);
+			if (file.open(QIODevice::ReadOnly)) {
+				const auto data = file.readAll();
+				schema.add(
+					std::string_view(data.constData(), data.size()),
+					methods);
+			}
+		}
+		return schema;
+	}();
+	return result;
+}
+
+[[nodiscard]] const Danger *FindDanger(std::string_view method) {
+	for (const auto &danger : kDangerous) {
+		if (method == danger.method) {
+			return &danger;
+		}
+	}
+	return nullptr;
+}
+
+void CollectMethods(
+		const Value &value,
+		std::vector<const Value*> &result) {
+	if (value.type == Value::Type::Object
+		&& ConsoleSchema().method(value.text)) {
+		result.push_back(&value);
+	}
+	for (const auto &[name, field] : value.fields) {
+		CollectMethods(field, result);
+	}
+	for (const auto &item : value.items) {
+		CollectMethods(item, result);
+	}
+}
+
+[[nodiscard]] std::optional<Action> PasswordAction(const Value &method) {
+	const auto danger = FindDanger(method.text);
+	if (!danger || !danger->action) {
+		return std::nullopt;
+	}
+	for (const auto &[name, field] : method.fields) {
+		if (name != "invoice" || field.type != Value::Type::Object) {
+			continue;
+		}
+		for (const auto &[invoice, action] : kInvoiceActions) {
+			if (field.text == invoice) {
+				return action;
+			}
+		}
+	}
+	return danger->action;
+}
+
+[[nodiscard]] std::optional<Value> ValueFromJson(const QJsonValue &json) {
+	if (!json.isObject()) {
+		return std::nullopt;
+	}
+	const auto object = json.toObject();
+	auto result = Value();
+	const auto text = [&](const QString &key) {
+		return object.value(key).toString().toStdString();
+	};
+	if (object.contains(u"o"_q)) {
+		result.type = Value::Type::Object;
+		result.text = text(u"o"_q);
+		for (const auto &entry : object.value(u"f"_q).toArray()) {
+			const auto pair = entry.toArray();
+			auto field = (pair.size() == 2)
+				? ValueFromJson(pair[1])
+				: std::nullopt;
+			if (!field) {
+				return std::nullopt;
+			}
+			result.fields.emplace_back(
+				pair[0].toString().toStdString(),
+				std::move(*field));
+		}
+	} else if (object.contains(u"v"_q)) {
+		result.type = Value::Type::Vector;
+		for (const auto &entry : object.value(u"v"_q).toArray()) {
+			auto item = ValueFromJson(entry);
+			if (!item) {
+				return std::nullopt;
+			}
+			result.items.push_back(std::move(*item));
+		}
+	} else if (object.contains(u"n"_q)) {
+		result.type = Value::Type::Number;
+		result.text = text(u"n"_q);
+	} else if (object.contains(u"s"_q)) {
+		result.type = Value::Type::String;
+		result.text = text(u"s"_q);
+	} else if (object.contains(u"w"_q)) {
+		result.type = Value::Type::Word;
+		result.text = text(u"w"_q);
+	} else if (object.contains(u"b"_q)) {
+		result.type = Value::Type::Bool;
+		result.flag = object.value(u"b"_q).toBool();
+	} else {
+		return std::nullopt;
+	}
+	return result;
+}
