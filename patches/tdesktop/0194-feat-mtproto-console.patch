@@ -0,0 +1,433 @@
+#include "tele/tele_mtp_console.h"
+
+#include "core/application.h"
+#include "core/file_utilities.h"
+#include "core/shortcuts.h"
+#include "main/main_session.h"
+#include "main/session/session_show.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_mtp_console_requests.h"
+#include "tele/tele_mtp_inspector.h"
+#include "tele/tele_options.h"
+#include "tele/tele_view_tl.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/chat/attach/attach_bot_webview.h"
+#include "ui/webview_helpers.h"
+#include "ui/widgets/rp_window.h"
+#include "webview/webview_data_stream_memory.h"
+#include "webview/webview_embed.h"
+#include "webview/webview_interface.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+#include "styles/palette.h"
+#include "styles/style_window.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+#include <QtGui/QPainter>
+#include <QtGui/QScreen>
+#include <QtWidgets/QApplication>
+
+#include <charconv>
+
+namespace Tele {
+namespace {
+
+constexpr auto kPrefix = std::string_view("tele-mtpc/");
+constexpr auto kSchemaPrefix = "https://schema.jppgr.am/";
+constexpr auto kJson = "application/json; charset=utf-8";
+
+[[nodiscard]] QByteArray Page() {
+	auto result = MtpWebviewResource(u"mtp_console.html"_q);
+	result.replace("__TELE_STYLES__", Ui::EscapeForAttribute(
+		MtpWebviewStyles()));
+	result.replace("__TELE_LOWER__", LowercaseStrings() ? "1" : "0");
+	return result;
+}
+
+[[nodiscard]] QByteArray ToJson(const QJsonValue &value) {
+	return value.isArray()
+		? QJsonDocument(value.toArray()).toJson(QJsonDocument::Compact)
+		: QJsonDocument(value.toObject()).toJson(QJsonDocument::Compact);
+}
+
+[[nodiscard]] int NumberIn(std::string_view id, std::string_view prefix) {
+	if (!id.starts_with(prefix) || !id.ends_with(".json")) {
+		return -1;
+	}
+	id = id.substr(prefix.size(), id.size() - prefix.size() - 5);
+	auto result = 0;
+	const auto parsed = std::from_chars(
+		id.data(),
+		id.data() + id.size(),
+		result);
+	return (parsed.ec == std::errc()) ? result : -1;
+}
+
+class Console final : public base::has_weak_ptr {
+public:
+	explicit Console(std::shared_ptr<Main::SessionShow> show);
+	~Console();
+
+	[[nodiscard]] bool valid() const;
+	[[nodiscard]] not_null<Main::Session*> session() const;
+	void activate();
+
+private:
+	void createWindow(QRect parent);
+	[[nodiscard]] bool createWebview(const Webview::StorageId &storageId);
+	void handle(const QJsonObject &message);
+	void notify(const QString &method, const QJsonValue &argument);
+	[[nodiscard]] Webview::DataResult serve(Webview::DataRequest request);
+	void updateStyles();
+
+	const not_null<Main::Session*> _session;
+	MtpConsoleRequests _requests;
+	std::unique_ptr<Ui::RpWindow> _window;
+	Ui::RpWidget *_container = nullptr;
+	std::unique_ptr<Webview::Window> _webview;
+
+};
+
+std::unique_ptr<Console> Instance;
+
+void RequestClose(not_null<Console*> console) {
+	crl::on_main([=] {
+		if (Instance.get() == console) {
+			Instance = nullptr;
+		}
+	});
+}
+
+Console::Console(std::shared_ptr<Main::SessionShow> show)
+: _session(&show->session())
+, _requests(show, {
+	.status = [=](int id, QString text) {
+		notify(u"status"_q, QJsonObject{
+			{ u"id"_q, id },
+			{ u"text"_q, text },
+		});
+	},
+	.confirm = [=](int id, QString text) {
+		notify(u"confirm"_q, QJsonObject{
+			{ u"id"_q, id },
+			{ u"text"_q, text },
+		});
+	},
+	.done = [=](QJsonObject result) {
+		notify(u"done"_q, result);
+	},
+	.historyChanged = [=] {
+		notify(u"history"_q, _requests.history());
+	},
+}) {
+	const auto active = QApplication::activeWindow();
+	createWindow(active
+		? active->geometry()
+		: QGuiApplication::primaryScreen()->availableGeometry());
+	if (!createWebview(_session->local().resolveStorageIdOther())) {
+		return;
+	}
+}
+
+Console::~Console() {
+	if (_window) {
+		_window->hide();
+	}
+	base::take(_webview);
+	_container = nullptr;
+	base::take(_window);
+}
+
+bool Console::valid() const {
+	return (_webview != nullptr);
+}
+
+not_null<Main::Session*> Console::session() const {
+	return _session;
+}
+
+void Console::activate() {
+	if (_window->isMinimized()) {
+		_window->showNormal();
+	} else if (_window->isHidden()) {
+		_window->show();
+	}
+	_window->raise();
+	_window->activateWindow();
+	if (_webview) {
+		_webview->focus();
+		notify(u"focus"_q, QJsonObject());
+	}
+}
+
+void Console::createWindow(QRect parent) {
+	_window = std::make_unique<Ui::RpWindow>();
+	const auto window = _window.get();
+	window->setWindowTitle(Lower(u"MTProto console"_q));
+	window->setMinimumSize({ st::windowMinWidth, st::windowMinHeight });
+
+	auto rect = QRect(
+		QPoint(),
+		QSize(style::ConvertScale(1100), style::ConvertScale(720)));
+	if (const auto screen = QGuiApplication::screenAt(parent.center())) {
+		const auto available = screen->availableGeometry();
+		rect.setSize(rect.size().boundedTo(available.size()));
+		rect.moveCenter(parent.center());
+		rect.moveLeft(std::clamp(
+			rect.left(),
+			available.left(),
+			available.left() + available.width() - rect.width()));
+		rect.moveTop(std::clamp(
+			rect.top(),
+			available.top(),
+			available.top() + available.height() - rect.height()));
+	} else {
+		rect.moveCenter(parent.center());
+	}
+	window->setGeometry(rect);
+
+	_container = Ui::CreateChild<Ui::RpWidget>(window->body().get());
+	window->body()->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		_container->setGeometry(QRect(QPoint(), size));
+	}, _container->lifetime());
+	_container->paintRequest() | rpl::on_next([=](QRect clip) {
+		QPainter(_container).fillRect(clip, st::windowBg);
+	}, _container->lifetime());
+
+	window->events(
+	) | rpl::on_next([=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::Close) {
+			RequestClose(this);
+		}
+	}, window->lifetime());
+
+	_container->show();
+	window->show();
+}
+
+bool Console::createWebview(const Webview::StorageId &storageId) {
+	_webview = std::make_unique<Webview::Window>(
+		_container,
+		Webview::WindowConfig{
+			.opaqueBg = st::windowBg->c,
+			.storageId = storageId,
+			.safe = true,
+		});
+	const auto raw = _webview.get();
+	const auto widget = raw->widget();
+	if (!widget) {
+		_webview = nullptr;
+		return false;
+	}
+	widget->show();
+	_container->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		if (const auto widget = raw->widget()) {
+			widget->setGeometry(QRect(QPoint(), size));
+		}
+	}, _container->lifetime());
+	QObject::connect(widget, &QObject::destroyed, [=] {
+		if (_webview) {
+			RequestClose(this);
+		}
+	});
+
+	raw->setNavigationPolicyHandler([=](const QString &uri, bool newWindow) {
+		const auto url = QUrl(uri);
+		const auto scheme = url.scheme().toLower();
+		const auto host = url.host().toLower();
+		const auto external = (scheme == u"https"_q)
+			|| (scheme == u"http"_q
+				&& host != u"desktop-app-resource"_q
+				&& host != u"127.0.0.1"_q
+				&& host != u"localhost"_q);
+		if (!external) {
+			return true;
+		} else if (uri.startsWith(QString::fromLatin1(kSchemaPrefix))) {
+			crl::on_main([=] {
+				File::OpenUrl(uri);
+			});
+		}
+		return false;
+	});
+	raw->setNavigationDoneHandler([](bool) {
+	});
+	raw->setMessageHandler([=](const QJsonDocument &message) {
+		crl::on_main(_window.get(), [=] {
+			handle(message.object());
+		});
+	});
+	raw->setDataRequestHandler([=](Webview::DataRequest request) {
+		return serve(std::move(request));
+	});
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		updateStyles();
+	}, raw->lifetime());
+
+	raw->init(R"()");
+	raw->navigateToData(QString::fromLatin1(
+		kPrefix.data(),
+		kPrefix.size()) + u"console.html"_q);
+	return true;
+}
+
+void Console::handle(const QJsonObject &message) {
+	const auto event = message.value(u"event"_q).toString();
+	const auto id = message.value(u"id"_q).toInt();
+	if (event == u"send"_q) {
+		_requests.send(
+			id,
+			message.value(u"request"_q),
+			message.value(u"text"_q).toString(),
+			message.value(u"confirmed"_q).toBool());
+	} else if (event == u"cancel"_q) {
+		_requests.cancel(id);
+	} else if (event == u"copy"_q) {
+		QGuiApplication::clipboard()->setText(
+			message.value(u"text"_q).toString());
+	} else if (event == u"open"_q) {
+		const auto url = message.value(u"url"_q).toString();
+		if (url.startsWith(QString::fromLatin1(kSchemaPrefix))) {
+			File::OpenUrl(url);
+		}
+	} else if (event == u"schema"_q) {
+		const auto bytes = _requests.resultPart(
+			id,
+			message.value(u"from"_q).toInt(),
+			message.value(u"till"_q).toInt());
+		if (bytes.isEmpty()) {
+			notify(u"flash"_q, QJsonObject{ { u"text"_q, Lower(
+				u"This object isn't available anymore."_q) } });
+		} else {
+			OpenTl(_session, bytes);
+		}
+	} else if (event == u"forget"_q) {
+		_requests.forget(message.value(u"index"_q).toInt());
+	} else if (event == u"close"_q) {
+		RequestClose(this);
+	}
+}
+
+void Console::notify(const QString &method, const QJsonValue &argument) {
+	if (!_webview) {
+		return;
+	}
+	_webview->eval("if (window.MtpConsole) MtpConsole."
+		+ method.toUtf8()
+		+ '('
+		+ ToJson(argument)
+		+ ");");
+}
+
+Webview::DataResult Console::serve(Webview::DataRequest request) {
+	auto id = std::string_view(request.id);
+	if (const auto cut = id.find_first_of("?#"); cut != id.npos) {
+		id = id.substr(0, cut);
+	}
+	if (!id.starts_with(kPrefix)) {
+		return Webview::DataResult::Failed;
+	}
+	id.remove_prefix(kPrefix.size());
+	const auto finish = [&](QByteArray data, std::string mime) {
+		request.done({
+			.stream = std::make_unique<Webview::DataStreamFromMemory>(
+				std::move(data),
+				std::move(mime)),
+		});
+		return Webview::DataResult::Done;
+	};
+	if (id == "console.html") {
+		return finish(Page(), "text/html; charset=utf-8");
+	} else if (id == "console.css") {
+		return finish(
+			MtpWebviewResource(u"mtp_console.css"_q),
+			"text/css; charset=utf-8");
+	} else if (id == "inspector.css") {
+		return finish(
+			MtpWebviewResource(u"mtp_inspector.css"_q),
+			"text/css; charset=utf-8");
+	} else if (id == "console.js") {
+		return finish(
+			MtpWebviewResource(u"mtp_console.js"_q),
+			"text/javascript; charset=utf-8");
+	} else if (id == "schema.json") {
+		return finish(MtpConsoleRequests::SchemaJson(), kJson);
+	} else if (id.starts_with("peers/")) {
+		return finish(_requests.peers(), kJson);
+	} else if (id.starts_with("history/")) {
+		return finish(ToJson(_requests.history()), kJson);
+	} else if (const auto number = NumberIn(id, "result/"); number > 0) {
+		auto result = _requests.result(number);
+		if (!result.isEmpty()) {
+			return finish(std::move(result), kJson);
+		}
+	}
+	return Webview::DataResult::Failed;
+}
+
+void Console::updateStyles() {
+	if (!_webview) {
+		return;
+	}
+	const auto styles = Ui::EscapeForScriptString(MtpWebviewStyles());
+	_webview->eval("if (window.MtpConsole) MtpConsole.updateStyles('"
+		+ styles
+		+ "');");
+}
+
+} // namespace
+
+void ShowMtpConsole(std::shared_ptr<Main::SessionShow> show) {
+	const auto session = &show->session();
+	if (Instance && Instance->session() == session) {
+		Instance->activate();
+		return;
+	}
+	Instance = nullptr;
+	const auto available = Webview::Availability();
+	if (available.error != Webview::Available::Error::None) {
+		auto text = TextWithEntities{ Lower(u"The MTProto console needs "
+			"a webview, which isn't available right now."_q) };
+		text.append(u"\n\n"_q).append(Ui::BotWebView::ErrorText(available));
+		show->show(Ui::MakeInformBox(std::move(text)));
+		return;
+	}
+	auto console = std::make_unique<Console>(show);
+	if (!console->valid()) {
+		show->showToast(Lower(u"Could not start the webview."_q));
+		return;
+	}
+	Instance = std::move(console);
+	const auto raw = Instance.get();
+	session->lifetime().add([=] {
+		if (Instance.get() == raw) {
+			Instance = nullptr;
+		}
+	});
+}
+
+void StartMtpConsole() {
+	static auto lifetime = rpl::lifetime();
+	Shortcuts::Requests(
+	) | rpl::on_next([](not_null<Shortcuts::Request*> request) {
+		using Command = Shortcuts::Command;
+		request->check(Command::TeleMtpConsole) && request->handle([] {
+			const auto window = Core::App().activeWindow();
+			const auto controller = window
+				? window->sessionController()
+				: nullptr;
+			if (!controller) {
+				return false;
+			}
+			ShowMtpConsole(controller->uiShow());
+			return true;
+		});
+	}, lifetime);
+}
