+		QStringList resolved;
+	};
+	struct Result {
+		int id = 0;
+		QByteArray bytes;
+		QByteArray json;
+	};
+	struct Entry {
+		QString text;
+		QString method;
+		QString status;
+		TimeId date = 0;
+		int elapsed = 0;
+		bool ok = false;
+	};
+
+	[[nodiscard]] TlRuntime::Request serialize() const;
+	[[nodiscard]] TlRuntime::Resolution resolve(
+		const TlRuntime::Value &value,
+		std::string_view type) const;
+	void prepare(int id);
+	void resolveUsernames(int id, const QStringList &usernames);
+	void sendRaw(int id, QByteArray bytes, QString type);
+	void noteResolved(const QString &text, QString input) const;
+	void received(int id, const QByteArray &bytes, const QString &type);
+	void failed(int id, const MTP::Error &error);
+	void finishLocal(int id, const QString &error);
+	[[nodiscard]] bool applyUpdates(const QByteArray &bytes) const;
+	void remember(QString status, bool ok, int elapsed);
+
+	[[nodiscard]] QString folder() const;
+	void readHistory();
+	void writeHistory() const;
+
+	const std::shared_ptr<Main::SessionShow> _show;
+	const not_null<Main::Session*> _session;
+	const Callbacks _callbacks;
+	MTP::Sender _api;
+	Current _current;
+	std::vector<Result> _results;
+	std::vector<Entry> _history;
+	base::flat_set<QString> _tried;
+	mutable std::vector<std::pair<QString, QString>> _resolved;
+
+};
