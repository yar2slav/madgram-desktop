+
+constexpr auto kVectorId = std::uint32_t(0x1cb5c415U);
+constexpr auto kBoolTrue = std::uint32_t(0x997275b5U);
+constexpr auto kBoolFalse = std::uint32_t(0xbc799737U);
+constexpr auto kHexDigits = std::string_view("0123456789abcdef");
+
+[[nodiscard]] bool IsSpace(char ch) {
+	return (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n');
+}
+
+[[nodiscard]] std::string_view Trim(std::string_view text) {
+	while (!text.empty() && IsSpace(text.front())) {
+		text.remove_prefix(1);
+	}
+	while (!text.empty() && IsSpace(text.back())) {
+		text.remove_suffix(1);
+	}
+	return text;
+}
+
+[[nodiscard]] bool IsIdentChar(char ch) {
+	return (ch >= 'a' && ch <= 'z')
+		|| (ch >= 'A' && ch <= 'Z')
+		|| (ch >= '0' && ch <= '9')
+		|| ch == '_';
+}
+
+[[nodiscard]] std::uint32_t Crc32(std::string_view data) {
+	auto crc = 0xFFFFFFFFU;
+	for (const auto ch : data) {
+		crc ^= static_cast<unsigned char>(ch);
+		for (auto i = 0; i != 8; ++i) {
+			crc = (crc >> 1) ^ (0xEDB88320U & (0U - (crc & 1U)));
+		}
+	}
+	return ~crc;
+}
+
+void ReplaceAll(
+		std::string &text,
+		std::string_view from,
+		std::string_view to) {
+	auto position = std::size_t();
+	while ((position = text.find(from, position)) != std::string::npos) {
+		text.replace(position, from.size(), to);
+		position += to.size();
+	}
+}
+
+[[nodiscard]] std::size_t TrueFlagLength(std::string_view text) {
+	auto i = std::size_t(1);
+	while (i < text.size() && IsIdentChar(text[i])) {
+		++i;
+	}
+	if (i == 1 || text.substr(i, 6) != ":flags") {
+		return 0;
+	}
+	i += 6;
+	if (i < text.size() && text[i] == '2') {
+		++i;
+	}
+	if (i >= text.size() || text[i] != '.') {
+		return 0;
+	}
+	const auto digits = ++i;
+	while (i < text.size() && text[i] >= '0' && text[i] <= '9') {
+		++i;
+	}
+	if (i == digits || text.substr(i, 5) != "?true") {
+		return 0;
+	}
+	return i + 5;
+}
+
+[[nodiscard]] bool IsBuiltin(std::string_view type) {
+	return type == "int"
+		|| type == "long"
+		|| type == "double"
+		|| type == "string"
+		|| type == "bytes"
+		|| type == "int128"
+		|| type == "int256";
+}
+
+[[nodiscard]] bool IsBareName(std::string_view type) {
+	const auto dot = type.rfind('.');
+	const auto last = (dot == std::string_view::npos)
+		? type
+		: type.substr(dot + 1);
+	return !last.empty() && last.front() >= 'a' && last.front() <= 'z';
+}
+
+[[nodiscard]] std::string_view VectorItem(std::string_view type) {
+	return type.substr(7, type.size() - 8);
+}
+
+void Put32(std::string &out, std::uint32_t value) {
+	for (auto i = 0; i != 4; ++i) {
+		out += char((value >> (8 * i)) & 0xFF);
+	}
+}
+
+void Put64(std::string &out, std::uint64_t value) {
+	Put32(out, std::uint32_t(value & 0xFFFFFFFFULL));
+	Put32(out, std::uint32_t(value >> 32));
+}
+
+void PutBytes(std::string &out, std::string_view data) {
+	const auto size = data.size();
+	auto header = std::size_t(1);
+	if (size < 254) {
+		out += char(size);
+	} else {
+		header = 4;
+		out += char(254);
+		out += char(size & 0xFF);
+		out += char((size >> 8) & 0xFF);
+		out += char((size >> 16) & 0xFF);
+	}
+	out.append(data);
+	while ((header + size) % 4) {
+		out += char(0);
+		++header;
+	}
+}
+
+void AppendHex(std::string &out, std::string_view data) {
+	for (const auto ch : data) {
+		const auto byte = static_cast<unsigned char>(ch);
+		out += kHexDigits[byte >> 4];
+		out += kHexDigits[byte & 0x0F];
+	}
+}
+
+[[nodiscard]] int HexValue(char ch) {
+	return (ch >= '0' && ch <= '9')
+		? (ch - '0')
+		: (ch >= 'a' && ch <= 'f')
+		? (ch - 'a' + 10)
+		: (ch >= 'A' && ch <= 'F')
+		? (ch - 'A' + 10)
+		: -1;
+}
+
+[[nodiscard]] std::string_view WithoutHexPrefix(std::string_view text) {
+	const auto prefixed = (text.size() > 1)
+		&& text[0] == '0'
+		&& (text[1] == 'x' || text[1] == 'X');
+	return prefixed ? text.substr(2) : std::string_view();
+}
+
+[[nodiscard]] std::optional<std::string> DecodeHex(std::string_view text) {
+	if (text.size() % 2) {
+		return std::nullopt;
+	}
+	auto result = std::string();
+	result.reserve(text.size() / 2);
+	for (auto i = std::size_t(); i != text.size(); i += 2) {
+		const auto high = HexValue(text[i]);
+		const auto low = HexValue(text[i + 1]);
+		if (high < 0 || low < 0) {
+			return std::nullopt;
+		}
+		result += char((high << 4) | low);
+	}
+	return result;
+}
+
+[[nodiscard]] int Base64Value(char ch) {
+	return (ch >= 'A' && ch <= 'Z')
+		? (ch - 'A')
+		: (ch >= 'a' && ch <= 'z')
+		? (ch - 'a' + 26)
+		: (ch >= '0' && ch <= '9')
+		? (ch - '0' + 52)
+		: (ch == '+' || ch == '-')
+		? 62
+		: (ch == '/' || ch == '_')
+		? 63
+		: -1;
+}
+
+[[nodiscard]] std::optional<std::string> DecodeBase64(std::string_view text) {
+	while (!text.empty() && text.back() == '=') {
+		text.remove_suffix(1);
+	}
+	auto result = std::string();
+	auto buffer = std::uint32_t();
+	auto bits = 0;
+	for (const auto ch : text) {
+		const auto value = Base64Value(ch);
+		if (value < 0) {
+			return std::nullopt;
+		}
+		buffer = (buffer << 6) | std::uint32_t(value);
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			result += char((buffer >> bits) & 0xFF);
+		}
+	}
+	return result;
+}
+
+struct Integer {
+	std::uint64_t magnitude = 0;
+	bool negative = false;
+};
+
+[[nodiscard]] std::optional<Integer> ParseInteger(std::string_view text) {
+	auto result = Integer();
+	if (!text.empty() && text.front() == '-') {
+		result.negative = true;
+		text.remove_prefix(1);
+	}
+	if (const auto hex = WithoutHexPrefix(text); !hex.empty()) {
+		if (hex.size() > 16) {
+			return std::nullopt;
+		}
+		for (const auto ch : hex) {
+			const auto value = HexValue(ch);
+			if (value < 0) {
+				return std::nullopt;
+			}
+			result.magnitude = (result.magnitude << 4) | std::uint64_t(value);
+		}
+		return result;
+	} else if (text.empty()) {
+		return std::nullopt;
+	}
+	const auto end = text.data() + text.size();
+	const auto parsed = std::from_chars(text.data(), end, result.magnitude);
+	if (parsed.ec != std::errc() || parsed.ptr != end) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] bool ValidUtf8(std::string_view text) {
+	auto i = std::size_t();
+	while (i < text.size()) {
+		const auto byte = static_cast<unsigned char>(text[i]);
+		auto extra = 0;
+		auto minimum = std::uint32_t();
+		if (byte < 0x80) {
+			++i;
+			continue;
+		} else if ((byte & 0xE0) == 0xC0) {
+			extra = 1;
+			minimum = 0x80;
+		} else if ((byte & 0xF0) == 0xE0) {
+			extra = 2;
+			minimum = 0x800;
+		} else if ((byte & 0xF8) == 0xF0) {
+			extra = 3;
+			minimum = 0x10000;
+		} else {
+			return false;
+		}
+		if (i + extra >= text.size()) {
+			return false;
+		}
+		auto code = std::uint32_t(byte & (0x3F >> extra));
+		for (auto j = 1; j <= extra; ++j) {
+			const auto next = static_cast<unsigned char>(text[i + j]);
+			if ((next & 0xC0) != 0x80) {
+				return false;
+			}
+			code = (code << 6) | (next & 0x3F);
+		}
+		if (code < minimum
+			|| code > 0x10FFFF
+			|| (code >= 0xD800 && code <= 0xDFFF)) {
+			return false;
+		}
+		i += extra + 1;
+	}
+	return true;
+}
+
+void AppendScalar(
+		std::string &out,
+		std::string_view kind,
+		std::string_view text) {
+	out += "{\"t\":\"";
+	out += kind;
+	out += "\",\"s\":";
+	MtpDump::AppendJsonString(out, text);
+	out += '}';
+}
+
+void AppendParams(std::string &out, const Combinator &combinator) {
+	out += '[';
+	MtpDump::AppendJsonString(out, combinator.name);
+	out += ',';
+	MtpDump::AppendJsonString(out, combinator.type);
+	out += ",[";
+	auto first = true;
+	for (const auto &param : combinator.params) {
+		if (!first) {
+			out += ',';
+		}
+		first = false;
+		out += '[';
+		MtpDump::AppendJsonString(out, param.name);
+		out += ',';
+		MtpDump::AppendJsonString(out, param.type);
+		out += ',';
+		MtpDump::AppendJsonString(out, (param.flagBit >= 0)
+			? (param.flagField + '.' + std::to_string(param.flagBit))
+			: std::string());
+		out += ']';
+	}
+	out += "]]";
+}
+
+class Serializer final {
+public:
+	Serializer(
+		const Schema &schema,
+		const Resolver &resolver,
+		Request &result);
+
+	[[nodiscard]] bool method(const Value &value, std::string &type);
+
+private:
+	[[nodiscard]] bool fail(std::string text);
+	[[nodiscard]] std::string path() const;
+	[[nodiscard]] bool fields(
+		const Value &value,
+		const Combinator &combinator,
+		std::string *generic);
+	[[nodiscard]] bool value(std::string_view type, const Value &value);
+	[[nodiscard]] bool vector(
+		std::string_view type,
+		const Value &value,
+		bool boxed);
+	[[nodiscard]] bool bare(std::string_view type, const Value &value);
+	[[nodiscard]] bool boxed(std::string_view type, const Value &value);
+	[[nodiscard]] bool scalar(std::string_view type, const Value &value);
+	[[nodiscard]] bool integer(
+		std::string_view type,
+		const Value &value,
+		bool wide);
+
+	const Schema &_schema;
+	const Resolver &_resolver;
+	Request &_result;
+	std::vector<std::string> _path;
+
+};
+
+Serializer::Serializer(
+	const Schema &schema,
+	const Resolver &resolver,
+	Request &result)
+: _schema(schema)
+, _resolver(resolver)
+, _result(result) {
+}
+
+bool Serializer::fail(std::string text) {
+	if (_result.error.empty()) {
+		const auto where = path();
+		_result.error = where.empty() ? std::move(text) : (where + ": " + text);
+	}
+	return false;
+}
+
+std::string Serializer::path() const {
+	auto result = std::string();
+	for (const auto &part : _path) {
+		if (!result.empty() && part.front() != '[') {
+			result += '.';
+		}
+		result += part;
+	}
+	return result;
+}
+
+bool Serializer::method(const Value &value, std::string &type) {
+	if (value.type != Value::Type::Object) {
+		return fail("expected a method");
+	}
+	const auto combinator = _schema.method(value.text);
+	if (!combinator) {
+		return fail(value.text + " is not a method in the schema");
+	}
+	_result.methods.push_back(combinator->name);
+	Put32(_result.bytes, combinator->id);
+	auto generic = std::string();
+	if (!fields(value, *combinator, &generic)) {
+		return false;
+	}
+	type = generic.empty() ? combinator->type : generic;
+	return true;
+}
+
+bool Serializer::fields(
+		const Value &value,
+		const Combinator &combinator,
+		std::string *generic) {
+	const auto find = [&](std::string_view name) -> const Value* {
+		for (const auto &[key, field] : value.fields) {
+			if (key == name) {
+				return &field;
+			}
+		}
+		return nullptr;
+	};
+	for (auto i = std::size_t(); i != value.fields.size(); ++i) {
+		const auto &key = value.fields[i].first;
+		const auto known = std::any_of(
+			begin(combinator.params),
+			end(combinator.params),
+			[&](const Param &param) { return param.name == key; });
+		if (!known) {
+			return fail(combinator.name + " has no field " + key);
+		}
+		for (auto j = std::size_t(); j != i; ++j) {
+			if (value.fields[j].first == key) {
+				return fail(key + " is set twice in " + combinator.name);
+			}
+		}
+	}
+	auto flags = std::map<std::string, std::uint32_t, std::less<>>();
+	for (const auto &param : combinator.params) {
+		const auto field = (param.flagBit >= 0) ? find(param.name) : nullptr;
+		if (!field) {
+			continue;
+		} else if (param.flagBit > 31) {
+			return fail("bad flag " + param.name + " in " + combinator.name);
+		} else if (param.type == "true") {
+			if (field->type != Value::Type::Bool) {
+				_path.push_back(param.name);
+				return fail("expected true or false");
+			} else if (!field->flag) {
+				continue;
+			}
+		}
+		flags[param.flagField] |= (1U << param.flagBit);
+	}
+	for (const auto &param : combinator.params) {
+		if (param.type == "#") {
+			Put32(_result.bytes, flags[param.name]);
+			continue;
+		}
+		const auto field = find(param.name);
+		if (param.flagBit >= 0) {
+			if (!field || param.type == "true") {
+				continue;
+			}
+		} else if (!field) {
+			if (param.type == "true") {
+				continue;
+			}
+			return fail("missing "
+				+ param.name
+				+ ':'
+				+ param.type
+				+ " in "
+				+ combinator.name);
+		}
+		_path.push_back(param.name);
+		if (param.type.starts_with('!')) {
+			auto inner = std::string();
+			if (!method(*field, inner)) {
+				return false;
+			} else if (generic) {
+				*generic = std::move(inner);
+			}
+		} else if (!this->value(param.type, *field)) {
+			return false;
+		}
+		_path.pop_back();
+	}
+	return true;
+}
+
+bool Serializer::value(std::string_view type, const Value &value) {
+	if (IsBuiltin(type)) {
+		return scalar(type, value);
+	} else if (type == "true") {
+		return true;
+	} else if (type == "Bool") {
+		if (value.type == Value::Type::Bool) {
+			Put32(_result.bytes, value.flag ? kBoolTrue : kBoolFalse);
+			return true;
+		} else if (value.type == Value::Type::Object
+			&& value.fields.empty()
+			&& (value.text == "boolTrue" || value.text == "boolFalse")) {
+			Put32(_result.bytes, (value.text == "boolTrue")
+				? kBoolTrue
+				: kBoolFalse);
+			return true;
+		}
+		return fail("expected true or false");
+	} else if (type.starts_with("Vector<") && type.ends_with('>')) {
+		return vector(VectorItem(type), value, true);
+	} else if (type.starts_with("vector<") && type.ends_with('>')) {
+		return vector(VectorItem(type), value, false);
+	} else if (type.starts_with('%') || IsBareName(type)) {
+		return bare(type, value);
+	}
+	return boxed(type, value);
+}
+
+bool Serializer::vector(
+		std::string_view type,
+		const Value &value,
+		bool boxed) {
+	const auto single = (value.type != Value::Type::Vector);
+	const auto count = single ? std::size_t(1) : value.items.size();
+	if (boxed) {
+		Put32(_result.bytes, kVectorId);
+	}
+	Put32(_result.bytes, std::uint32_t(count));
+	for (auto i = std::size_t(); i != count; ++i) {
+		_path.push_back('[' + std::to_string(i) + ']');
+		if (!this->value(type, single ? value : value.items[i])) {
+			return false;
+		}
+		_path.pop_back();
+	}
+	return true;
+}
+
+bool Serializer::bare(std::string_view type, const Value &value) {
+	if (value.type != Value::Type::Object) {
+		return fail("expected an object of type " + std::string(type));
+	}
+	const auto combinator = _schema.constructor(value.text);
+	if (!combinator) {
+		return fail(value.text + " is not in the schema");
+	}
+	const auto expected = type.starts_with('%')
+		? (combinator->type == type.substr(1))
+		: (combinator->name == type);
+	if (!expected) {
+		return fail("expected "
+			+ std::string(type)
+			+ ", "
+			+ value.text
+			+ " is "
+			+ combinator->type);
+	}
+	return fields(value, *combinator, nullptr);
+}
+
+bool Serializer::boxed(std::string_view type, const Value &value) {
+	if (value.type == Value::Type::Object) {
+		const auto combinator = _schema.constructor(value.text);
+		if (!combinator) {
+			return fail(value.text + (_schema.method(value.text)
+				? " is a method, expected "
+				: " is not in the schema, expected ") + std::string(type));
+		} else if (combinator->type != type && type != "Object") {
+			return fail("expected "
+				+ std::string(type)
+				+ ", "
+				+ value.text
+				+ " is "
+				+ combinator->type);
+		}
+		Put32(_result.bytes, combinator->id);
+		return fields(value, *combinator, nullptr);
+	} else if (value.type == Value::Type::Vector
+		|| value.type == Value::Type::Bool
+		|| !_resolver) {
+		return fail("expected " + std::string(type));
+	}
+	auto resolved = _resolver(value, type);
+	if (resolved.pending) {
+		const auto &list = _result.pending;
+		if (std::find(begin(list), end(list), value.text) == end(list)) {
+			_result.pending.push_back(value.text);
+		}
+		return true;
+	} else if (!resolved.error.empty()) {
+		return fail(std::move(resolved.error));
+	}
+	_result.bytes += resolved.bytes;
+	return true;
+}
+
+bool Serializer::integer(
+		std::string_view type,
+		const Value &value,
+		bool wide) {
+	if (value.type != Value::Type::Number
+		&& value.type != Value::Type::String) {
+		return fail("expected " + std::string(type));
+	}
+	const auto parsed = ParseInteger(Trim(value.text));
+	if (!parsed) {
+		return fail("expected " + std::string(type) + ", got " + value.text);
+	}
+	const auto limit = wide
+		? (parsed->negative ? (1ULL << 63) : ~0ULL)
+		: (parsed->negative ? (1ULL << 31) : 0xFFFFFFFFULL);
+	if (parsed->magnitude > limit) {
+		return fail(value.text + " doesn't fit in " + std::string(type));
+	}
+	const auto bits = parsed->negative
+		? (0ULL - parsed->magnitude)
+		: parsed->magnitude;
+	if (wide) {
+		Put64(_result.bytes, bits);
+	} else {
+		Put32(_result.bytes, std::uint32_t(bits & 0xFFFFFFFFULL));
+	}
+	return true;
+}
+
+bool Serializer::scalar(std::string_view type, const Value &value) {
+	if (type == "int") {
+		return integer(type, value, false);
+	} else if (type == "long") {
+		return integer(type, value, true);
+	} else if (value.type == Value::Type::Vector
+		|| value.type == Value::Type::Object
+		|| value.type == Value::Type::Bool) {
+		return fail("expected " + std::string(type));
+	}
+	const auto &text = value.text;
+	if (type == "double") {
+		const auto trimmed = Trim(text);
+		auto ok = false;
+		const auto result = QByteArray(
+			trimmed.data(),
+			int(trimmed.size())).toDouble(&ok);
+		if (value.type == Value::Type::Word || trimmed.empty() || !ok) {
+			return fail("expected double, got " + text);
+		}
+		auto bits = std::uint64_t();
+		std::memcpy(&bits, &result, sizeof(bits));
+		Put64(_result.bytes, bits);
+	} else if (type == "string") {
+		PutBytes(_result.bytes, text);
+	} else if (type == "bytes") {
+		const auto hex = WithoutHexPrefix(text);
+		if (const auto decoded = hex.empty()
+				? std::optional<std::string>()
+				: DecodeHex(hex)) {
+			PutBytes(_result.bytes, *decoded);
+		} else if (text.starts_with("base64:")) {
+			const auto data = DecodeBase64(std::string_view(text).substr(7));
+			if (!data) {
+				return fail("bad base64");
+			}
+			PutBytes(_result.bytes, *data);
+		} else {
+			PutBytes(_result.bytes, text);
+		}
+	} else {
+		const auto size = (type == "int128") ? 16 : 32;
+		const auto hex = WithoutHexPrefix(text);
+		const auto decoded = DecodeHex(hex.empty()
+			? std::string_view(text)
+			: hex);
+		if (!decoded || int(decoded->size()) != size) {
+			return fail("expected "
+				+ std::string(type)
+				+ " as 0x and "
+				+ std::to_string(size * 2)
+				+ " hex digits");
+		}
+		_result.bytes += *decoded;
+	}
+	return true;
+}
+
+class Reader final {
+public:
+	Reader(const Schema &schema, std::string_view data);
+
+	[[nodiscard]] bool value(std::string_view type);
+	[[nodiscard]] Parsed take();
+
+private:
+	[[nodiscard]] bool fail(std::string text);
+	[[nodiscard]] bool has(std::size_t count) const;
+	[[nodiscard]] std::uint32_t get32();
+	[[nodiscard]] std::uint64_t get64();
+	[[nodiscard]] bool bytes(std::string_view &result);
+	[[nodiscard]] bool object(
+		const Combinator &combinator,
+		std::size_t from,
+		bool boxed);
+	[[nodiscard]] bool vector(std::string_view type, bool boxed);
+	[[nodiscard]] bool scalar(std::string_view type);
+
+	const Schema &_schema;
+	const std::string_view _data;
+	std::size_t _offset = 0;
+	std::string _out;
+	std::string _error;
+
+};
+
+Reader::Reader(const Schema &schema, std::string_view data)
+: _schema(schema)
+, _data(data) {
+}
+
+Parsed Reader::take() {
+	if (_error.empty() && _offset != _data.size()) {
+		_error = std::to_string(_data.size() - _offset)
+			+ " bytes left after the result";
+	}
+	return { .json = std::move(_out), .error = std::move(_error) };
+}
+
+bool Reader::fail(std::string text) {
+	if (_error.empty()) {
+		_error = text + " at byte " + std::to_string(_offset);
+	}
+	_out += "{\"err\":";
+	MtpDump::AppendJsonString(_out, text);
+	_out += '}';
+	return false;
+}
+
+bool Reader::has(std::size_t count) const {
+	return (_data.size() - _offset) >= count;
+}
+
+std::uint32_t Reader::get32() {
+	auto result = std::uint32_t();
+	for (auto i = 0; i != 4; ++i) {
+		result |= std::uint32_t(
+			static_cast<unsigned char>(_data[_offset + i])) << (8 * i);
+	}
+	_offset += 4;
+	return result;
+}
+
+std::uint64_t Reader::get64() {
+	const auto low = get32();
+	const auto high = get32();
+	return (std::uint64_t(high) << 32) | low;
+}
+
+bool Reader::bytes(std::string_view &result) {
+	if (!has(4)) {
+		return false;
+	}
+	auto size = std::size_t(static_cast<unsigned char>(_data[_offset]));
+	auto header = std::size_t(1);
+	if (size == 254) {
+		header = 4;
+		const auto byte = [&](int index) {
+			return std::size_t(
+				static_cast<unsigned char>(_data[_offset + index]));
+		};
+		size = byte(1) | (byte(2) << 8) | (byte(3) << 16);
+	} else if (size == 255) {
+		return false;
+	}
+	const auto padded = ((header + size + 3) / 4) * 4;
+	if (!has(padded)) {
+		return false;
+	}
+	result = _data.substr(_offset + header, size);
+	_offset += padded;
+	return true;
+}
+
+bool Reader::value(std::string_view type) {
+	if (IsBuiltin(type)) {
+		return scalar(type);
+	} else if (type == "Bool") {
+		if (!has(4)) {
+			return fail("the response ended early");
+		}
+		const auto id = get32();
+		if (id != kBoolTrue && id != kBoolFalse) {
+			_offset -= 4;
+			return fail("expected Bool");
+		}
+		AppendScalar(_out, "BOOL", (id == kBoolTrue) ? "true" : "false");
+		return true;
+	} else if (type.starts_with("Vector<") && type.ends_with('>')) {
+		return vector(VectorItem(type), true);
+	} else if (type.starts_with("vector<") && type.ends_with('>')) {
+		return vector(VectorItem(type), false);
+	} else if (type.starts_with('%')) {
+		const auto list = _schema.constructorsOf(type.substr(1));
+		if (list.size() != 1) {
+			return fail("can't read bare " + std::string(type.substr(1)));
+		}
+		return object(*list.front(), _offset, false);
+	} else if (IsBareName(type)) {
+		const auto combinator = _schema.constructor(type);
+		if (!combinator) {
+			return fail(std::string(type) + " is not in the schema");
+		}
+		return object(*combinator, _offset, false);
+	}
+	const auto from = _offset;
+	if (!has(4)) {
+		return fail("the response ended early");
+	}
+	const auto id = get32();
+	const auto combinator = _schema.constructor(id);
+	if (!combinator) {
+		_offset = from;
+		auto hex = std::string("0x");
+		for (auto i = 7; i >= 0; --i) {
+			hex += kHexDigits[(id >> (4 * i)) & 0x0F];
+		}
+		return fail("unknown constructor " + hex);
+	}
+	return object(*combinator, from, true);
+}
+
+bool Reader::object(
+		const Combinator &combinator,
+		std::size_t from,
+		bool boxed) {
+	_out += "{\"o\":";
+	MtpDump::AppendJsonString(_out, combinator.name);
+	_out += ",\"f\":[";
+	auto flags = std::map<std::string, std::uint32_t, std::less<>>();
+	auto first = true;
+	for (const auto &param : combinator.params) {
+		if (param.flagBit >= 0) {
+			const auto i = flags.find(param.flagField);
+			const auto set = (i != end(flags))
+				&& param.flagBit < 32
+				&& ((i->second >> param.flagBit) & 1U);
+			if (!set) {
+				continue;
+			}
+		}
+		if (!first) {
+			_out += ',';
+		}
+		first = false;
+		_out += '[';
+		MtpDump::AppendJsonString(_out, param.name);
+		_out += ',';
+		auto ok = true;
+		if (param.type == "#") {
+			if (!has(4)) {
+				ok = fail("the response ended early");
+			} else {
+				const auto value = get32();
+				flags[param.name] = value;
+				AppendScalar(_out, "INT", std::to_string(value));
+			}
+		} else if (param.type == "true") {
+			_out += "{\"g\":";
+			MtpDump::AppendJsonString(_out, param.flagField);
+			_out += ",\"b\":";
+			_out += std::to_string(param.flagBit);
+			_out += '}';
+		} else {
+			ok = value(param.type.starts_with('!')
+				? std::string_view("Object")
+				: std::string_view(param.type));
+		}
+		_out += ']';
+		if (!ok) {
+			_out += "]}";
+			return false;
+		}
+	}
+	_out += ']';
+	if (boxed) {
+		_out += ",\"r\":[";
+		_out += std::to_string(from);
+		_out += ',';
+		_out += std::to_string(_offset);
+		_out += ']';
+	}
+	_out += '}';
+	return true;
+}
+
+bool Reader::vector(std::string_view type, bool boxed) {
+	if (boxed) {
+		if (!has(4)) {
+			return fail("the response ended early");
+		} else if (get32() != kVectorId) {
+			_offset -= 4;
+			return fail("expected a vector");
+		}
+	}
+	if (!has(4)) {
+		return fail("the response ended early");
+	}
+	const auto count = get32();
+	if (count > (_data.size() - _offset) / 4) {
+		return fail("bad vector size " + std::to_string(count));
+	}
+	_out += "{\"v\":[";
+	const auto finish = [&] {
+		_out += "],\"n\":";
+		_out += std::to_string(count);
+		_out += '}';
+	};
+	for (auto i = std::uint32_t(); i != count; ++i) {
+		if (i) {
+			_out += ',';
+		}
+		if (!value(type)) {
+			finish();
+			return false;
+		}
+	}
+	finish();
+	return true;
+}
+
+bool Reader::scalar(std::string_view type) {
+	if (type == "string" || type == "bytes") {
+		auto data = std::string_view();
+		if (!bytes(data)) {
+			return fail("bad " + std::string(type));
+		} else if (type == "string" && ValidUtf8(data)) {
+			AppendScalar(_out, "STRING", data);
+			return true;
+		}
+		auto hex = std::string();
+		AppendHex(hex, data);
+		_out += "{\"t\":\"BYTES\",\"s\":\"";
+		_out += hex;
+		_out += "\",\"n\":";
+		_out += std::to_string(data.size());
+		_out += '}';
+		return true;
+	}
+	const auto size = (type == "int")
+		? 4
+		: (type == "int128")
+		? 16
+		: (type == "int256")
+		? 32
+		: 8;
+	if (!has(size)) {
+		return fail("the response ended early");
+	}
+	if (type == "int") {
+		AppendScalar(_out, "INT", std::to_string(std::int32_t(get32())));
+	} else if (type == "long") {
+		AppendScalar(_out, "LONG", std::to_string(std::int64_t(get64())));
+	} else if (type == "double") {
+		const auto bits = get64();
+		auto value = 0.;
+		std::memcpy(&value, &bits, sizeof(value));
+		const auto formatted = QByteArray::number(
+			value,
+			'g',
+			QLocale::FloatingPointShortest);
+		AppendScalar(
+			_out,
+			"DOUBLE",
+			std::string_view(formatted.constData(), formatted.size()));
+	} else {
+		auto hex = std::string();
+		AppendHex(hex, _data.substr(_offset, size));
+		_offset += size;
+		AppendScalar(_out, (size == 16) ? "INT128" : "INT256", hex);
+	}
+	return true;
+}
+
+} // namespace
+
+std::uint32_t ComputeId(std::string_view line) {
+	line = Trim(line);
+	if (!line.empty() && line.back() == ';') {
+		line.remove_suffix(1);
+	}
+	const auto equals = line.find('=');
+	if (equals == std::string_view::npos) {
+		return 0;
+	}
+	const auto head = line.substr(0, equals);
+	const auto nameEnd = std::min(head.find(' '), head.find('#'));
+	auto rest = (nameEnd == std::string_view::npos)
+		? std::string_view()
+		: head.substr(nameEnd);
+	if (rest.starts_with('#')) {
+		const auto space = rest.find(' ');
+		rest = (space == std::string_view::npos)
+			? std::string_view()
+			: rest.substr(space);
+	}
+	auto clean = std::string(head.substr(0, nameEnd))
+		+ std::string(rest)
+		+ "= "
+		+ std::string(Trim(line.substr(equals + 1)));
+	for (auto i = std::size_t(); i < clean.size(); ++i) {
+		if (clean[i] == ' ') {
+			if (const auto length = TrueFlagLength(
+					std::string_view(clean).substr(i))) {
+				clean.erase(i, length);
+				--i;
+			}
+		}
+	}
+	std::replace(begin(clean), end(clean), '<', ' ');
+	std::replace(begin(clean), end(clean), '>', ' ');
+	ReplaceAll(clean, "  ", " ");
+	if (clean.starts_with(' ')) {
+		clean.erase(0, 1);
+	}
+	if (clean.ends_with(' ')) {
+		clean.pop_back();
+	}
+	ReplaceAll(clean, ":bytes ", ":string ");
+	ReplaceAll(clean, "?bytes ", "?string ");
+	clean.erase(std::remove(begin(clean), end(clean), '{'), end(clean));
+	clean.erase(std::remove(begin(clean), end(clean), '}'), end(clean));
+	return Crc32(clean);
+}
+
+void Schema::add(std::string_view text, bool methods) {
+	auto functions = false;
+	auto position = std::size_t();
+	while (position < text.size()) {
+		const auto newline = text.find('\n', position);
+		auto line = text.substr(
+			position,
+			(newline == std::string_view::npos)
+				? std::string_view::npos
+				: (newline - position));
+		position = (newline == std::string_view::npos)
+			? text.size()
+			: (newline + 1);
+		if (const auto comment = line.find("//")
+			; comment != std::string_view::npos) {
+			line = line.substr(0, comment);
+		}
+		line = Trim(line);
+		if (line == "---functions---") {
+			functions = true;
+			continue;
+		} else if (line == "---types---") {
+			functions = false;
+			continue;
+		} else if (line.empty() || line.back() != ';') {
+			continue;
+		}
+		const auto equals = line.find(" = ");
+		if (equals == std::string_view::npos) {
+			continue;
+		}
+		auto head = line.substr(0, equals);
+		const auto type = Trim(
+			line.substr(equals + 3, line.size() - equals - 4));
+		const auto space = head.find(' ');
+		const auto first = head.substr(0, space);
+		const auto hash = first.find('#');
+		auto combinator = Combinator{
+			.name = std::string(first.substr(0, hash)),
+			.type = std::string(type),
+			.method = functions,
+		};
+		if (combinator.name.empty()
+			|| combinator.name == "vector"
+			|| type.empty()
+			|| type.find(' ') != std::string_view::npos
+			|| (functions && !methods)) {
+			continue;
+		}
+		auto valid = true;
+		auto params = (space == std::string_view::npos)
+			? std::string_view()
+			: head.substr(space + 1);
+		while (valid && !params.empty()) {
+			const auto next = params.find(' ');
+			const auto token = params.substr(0, next);
+			params = (next == std::string_view::npos)
+				? std::string_view()
+				: params.substr(next + 1);
+			if (token.empty()
+				|| (token.front() == '{' && token.back() == '}')) {
+				continue;
+			}
+			const auto colon = token.find(':');
+			if (colon == std::string_view::npos || colon == 0) {
+				valid = false;
+				break;
+			}
+			auto param = Param{ .name = std::string(token.substr(0, colon)) };
+			auto kind = token.substr(colon + 1);
+			if (const auto question = kind.find('?')
+				; question != std::string_view::npos) {
+				const auto condition = kind.substr(0, question);
+				const auto dot = condition.find('.');
+				auto bit = 0;
+				const auto digits = (dot == std::string_view::npos)
+					? std::string_view()
+					: condition.substr(dot + 1);
+				const auto parsed = std::from_chars(
+					digits.data(),
+					digits.data() + digits.size(),
+					bit);
+				if (digits.empty()
+					|| parsed.ec != std::errc()
+					|| parsed.ptr != digits.data() + digits.size()) {
+					valid = false;
+					break;
+				}
+				param.flagField = std::string(condition.substr(0, dot));
+				param.flagBit = bit;
+				kind.remove_prefix(question + 1);
+			}
+			if (kind.empty()) {
+				valid = false;
+				break;
+			}
+			param.type = std::string(kind);
+			combinator.params.push_back(std::move(param));
+		}
+		if (!valid) {
+			continue;
+		} else if (hash != std::string_view::npos) {
+			const auto hex = first.substr(hash + 1);
+			const auto parsed = std::from_chars(
+				hex.data(),
+				hex.data() + hex.size(),
+				combinator.id,
+				16);
+			if (parsed.ec != std::errc()
+				|| parsed.ptr != hex.data() + hex.size()) {
+				continue;
+			}
+		} else {
+			combinator.id = ComputeId(line);
+		}
+		auto &names = functions ? _methods : _constructors;
+		if (names.contains(combinator.name)) {
+			continue;
+		}
+		const auto index = _list.size();
+		names.emplace(combinator.name, index);
+		if (!functions) {
+			_ids.emplace(combinator.id, index);
+			_types[combinator.type].push_back(index);
+		}
+		_list.push_back(std::move(combinator));
+	}
+}
+
+const Combinator *Schema::constructor(std::uint32_t id) const {
+	const auto i = _ids.find(id);
+	return (i != end(_ids)) ? &_list[i->second] : nullptr;
+}
+
+const Combinator *Schema::constructor(std::string_view name) const {
+	const auto i = _constructors.find(name);
+	return (i != end(_constructors)) ? &_list[i->second] : nullptr;
+}
+
+const Combinator *Schema::method(std::string_view name) const {
+	const auto i = _methods.find(name);
+	return (i != end(_methods)) ? &_list[i->second] : nullptr;
+}
+
+std::vector<const Combinator*> Schema::constructorsOf(
+		std::string_view type) const {
+	auto result = std::vector<const Combinator*>();
+	if (const auto i = _types.find(type); i != end(_types)) {
+		for (const auto index : i->second) {
+			result.push_back(&_list[index]);
+		}
+	}
+	return result;
+}
+
+std::string Schema::json(
+		int layer,
+		const std::vector<std::string> &dangerous) const {
+	auto result = std::string("{\"layer\":") + std::to_string(layer);
+	const auto list = [&](const char *key, const auto &names) {
+		result += ",\"";
+		result += key;
+		result += "\":[";
+		auto first = true;
+		for (const auto &[name, index] : names) {
+			if (!first) {
+				result += ',';
+			}
+			first = false;
+			AppendParams(result, _list[index]);
+		}
+		result += ']';
+	};
+	list("methods", _methods);
+	list("constructors", _constructors);
+	result += ",\"dangerous\":[";
+	for (auto i = std::size_t(); i != dangerous.size(); ++i) {
+		if (i) {
+			result += ',';
+		}
+		MtpDump::AppendJsonString(result, dangerous[i]);
+	}
+	result += "]}";
+	return result;
+}
+
+Request Serialize(
+		const Schema &schema,
+		const Value &value,
+		const Resolver &resolver) {
+	auto result = Request();
+	auto serializer = Serializer(schema, resolver, result);
+	auto type = std::string();
+	if (!serializer.method(value, type)) {
+		result.bytes.clear();
+		result.pending.clear();
+	} else if (!result.pending.empty()) {
+		result.bytes.clear();
+	} else {
+		result.type = std::move(type);
+	}
+	return result;
+}
+
+Parsed Parse(
+		const Schema &schema,
+		std::string_view bytes,
+		std::string_view type) {
+	auto reader = Reader(schema, bytes);
+	[[maybe_unused]] const auto ok = reader.value(type.empty()
+		? std::string_view("Object")
+		: type);
+	return reader.take();
+}
+
