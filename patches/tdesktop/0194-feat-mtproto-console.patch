@@ -0,0 +1,40 @@
+<!DOCTYPE html>
+<html style="__TELE_STYLES__" data-lower="__TELE_LOWER__">
+<head>
+<meta charset="utf-8">
+<meta name="robots" content="noindex, nofollow">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>MTProto console</title>
+<link rel="stylesheet" href="inspector.css">
+<link rel="stylesheet" href="console.css">
+<script src="console.js"></script>
+</head>
+<body>
+<header id="bar">
+<div class="modes" id="modes"><button id="mode-text" class="mode ui on" type="button" title="Ctrl+1">Text</button><button id="mode-json" class="mode ui" type="button" title="Ctrl+2">JSON</button><button id="mode-form" class="mode ui" type="button" title="Ctrl+3">Form</button></div>
+<span class="grow"></span>
+<button id="format" class="ui" type="button" title="Ctrl+Shift+F">Format</button>
+<button id="help" class="ui" type="button" title="F1">?</button>
+<button id="send" class="ui" type="button" title="Ctrl+Enter">Send</button>
+<button id="cancel" class="ui danger" type="button" hidden>Cancel</button>
+</header>
+<main id="main">
+<aside id="history"><div id="history-list"></div><div id="history-empty" class="ui">No requests yet.</div><div id="history-foot"><button id="history-clear" class="ui danger" type="button">Clear history</button></div></aside>
+<section id="work">
+<div id="editor">
+<div id="text-pane"><pre id="highlight" aria-hidden="true"></pre><textarea id="input" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" wrap="soft"></textarea></div>
+<div id="form-pane" hidden><div class="form-head"><label class="form-label ui" for="method">Method</label><input id="method" type="text" spellcheck="false" autocomplete="off" placeholder="Method name"></div><div id="form"></div></div>
+<div id="hint"></div>
+<div id="check"></div>
+<div id="error"></div>
+</div>
+<div id="hsplit"></div>
+<div id="pending"></div>
+<section id="output"></section>
+</section>
+</main>
+<div id="popup"></div>
+<div id="help-panel" class="modal"><div id="help-box" class="modal-box help-box"></div></div>
+<div id="confirm" class="modal"><div class="modal-box"><div id="confirm-text"></div><div class="modal-buttons"><button id="confirm-cancel" class="ui" type="button">Cancel</button><button id="confirm-ok" class="ui danger" type="button">Send</button></div></div></div>
+</body>
+</html>
diff --git a/Telegram/Resources/tele_html/mtp_console.js b/Telegram/Resources/tele_html/mtp_console.js
new file mode 100644
index 0000000000000000000000000000000000000000..ad7c9aa727ff60ca71466e7988c1420f1a2c754d
--- /dev/null
+++ b/Telegram/Resources/tele_html/mtp_console.js
@@ -0,0 +1,3445 @@
+(function () {
+'use strict';
+
+const kSchema = 'https://schema.jppgr.am/';
+const kStringLimit = 300;
+const kBytesLimit = 64;
+const kExpandDepth = 3;
+const kVectorOpenLimit = 40;
+const kPopupLimit = 12;
+const kJsonWidth = 80;
