+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Tele::TlRuntime {
+
+struct Param {
+	std::string name;
+	std::string type;
+	std::string flagField;
+	int flagBit = -1;
+};
+
+struct Combinator {
+	std::string name;
+	std::string type;
+	std::vector<Param> params;
+	std::uint32_t id = 0;
+	bool method = false;
+};
+
+class Schema final {
+public:
+	void add(std::string_view text, bool methods);
+
+	[[nodiscard]] const Combinator *constructor(std::uint32_t id) const;
+	[[nodiscard]] const Combinator *constructor(std::string_view name) const;
+	[[nodiscard]] const Combinator *method(std::string_view name) const;
+	[[nodiscard]] std::vector<const Combinator*> constructorsOf(
+		std::string_view type) const;
+	[[nodiscard]] std::string json(
+		int layer,
+		const std::vector<std::string> &dangerous) const;
+
+private:
+	std::vector<Combinator> _list;
+	std::map<std::uint32_t, std::size_t> _ids;
+	std::map<std::string, std::size_t, std::less<>> _constructors;
+	std::map<std::string, std::size_t, std::less<>> _methods;
+	std::map<std::string, std::vector<std::size_t>, std::less<>> _types;
+
+};
+
+[[nodiscard]] std::uint32_t ComputeId(std::string_view line);
+
+struct Value {
+	enum class Type : unsigned char {
+		Number,
+		String,
+		Bool,
+		Word,
+		Vector,
+		Object,
+	};
+
+	Type type = Type::Word;
+	std::string text;
+	std::vector<Value> items;
+	std::vector<std::pair<std::string, Value>> fields;
+	bool flag = false;
+};
+
+struct Resolution {
+	std::string bytes;
+	std::string error;
+	bool pending = false;
+};
+
+using Resolver = std::function<Resolution(
+	const Value &value,
+	std::string_view type)>;
+
+struct Request {
+	std::string bytes;
+	std::string error;
+	std::string type;
+	std::vector<std::string> methods;
+	std::vector<std::string> pending;
+};
+
+[[nodiscard]] Request Serialize(
+	const Schema &schema,
+	const Value &value,
+	const Resolver &resolver);
+
+struct Parsed {
+	std::string json;
+	std::string error;
+};
+
+[[nodiscard]] Parsed Parse(
+	const Schema &schema,
+	std::string_view bytes,
+	std::string_view type);
+
