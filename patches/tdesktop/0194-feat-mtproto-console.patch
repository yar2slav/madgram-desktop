+	for (const row of els.form.querySelectorAll('.form-row[data-name]')) {
+		const param = paramOf(combinator, row.dataset.name);
+		const control = row.querySelector('.form-control');
+		let value = null;
+		if (control.type === 'checkbox') {
+			value = control.checked ? { b: true } : null;
+		} else if (control.tagName === 'SELECT') {
+			value = control.value ? { b: control.value === 'true' } : null;
+		} else if (control.value.trim()) {
+			try {
+				value = parseValueText(control.value, param ? param.type : '');
+			} catch (e) {
+				if (e.parse) {
+					e.field = row.dataset.name;
+					e.source = control.value;
+					e.control = control;
+				}
+				throw e;
+			}
+		}
+		if (value) {
+			fields.push([row.dataset.name, value]);
+			seen.add(row.dataset.name);
+		}
+	}
+	const other = els.other ? els.other.value : '';
+	if (other.trim()) {
+		let list;
+		try {
+			list = parseFieldList(other, combinator);
+		} catch (e) {
+			if (e.parse) {
+				e.other = true;
+				e.source = other;
+				e.control = els.other;
+			}
+			throw e;
+		}
