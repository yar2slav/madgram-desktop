+		u"Import settings..."_q,
+		::Tele::ImportSettingsBox,
+		{ u"backup"_q, u"restore"_q, u"load"_q, u"file"_q });
+	AddAbout(builder, ::Tele::Lower(u"Move tele settings to another "
+		"computer or share them with friends as a file or text."_q));
