+} // namespace
+
+QByteArray ExportSettings(SettingsGroups groups) {
+	LogUnclassified();
+	auto options = QJsonObject();
+	auto icons = QJsonObject();
+	auto backgrounds = QJsonObject();
+	for (const auto &spec : Specs()) {
+		const auto id = QString::fromLatin1(spec.id);
+		if (spec.kind == Kind::Internal) {
+			continue;
+		} else if (spec.kind == Kind::AppLinks) {
+			const auto value = ExportAppLinks(groups);
+			if (!value.isEmpty()) {
+				options.insert(id, value);
+			}
+			continue;
+		} else if (!(groups & spec.group)) {
+			continue;
+		} else if (spec.kind == Kind::Toggle) {
+			options.insert(id, CurrentFlag(spec));
+			continue;
+		}
+		auto value = CurrentText(spec);
+		if (spec.kind == Kind::AppIcon || spec.kind == Kind::TrayIcon) {
+			if (value == u"custom"_q) {
+				const auto bytes = CustomIconContent(Slot(spec));
+				if (bytes.isEmpty()) {
+					value = QString();
+				} else {
+					icons.insert(
+						(spec.kind == Kind::AppIcon) ? u"app"_q : u"tray"_q,
+						Encode(bytes));
+				}
+			}
+		} else if (spec.kind == Kind::List) {
+			value = spec.normalize(value);
+		} else if (spec.kind == Kind::Backgrounds) {
+			value = NormalizeChatBackgrounds(value, HasFile({}));
+			ExportBackgrounds(value, backgrounds);
+		}
+		if (spec.group == SettingsGroup::People && value.isEmpty()) {
+			continue;
+		}
+		options.insert(id, value);
+	}
+	auto names = QJsonArray();
+	for (const auto group : {
+			SettingsGroup::Settings,
+			SettingsGroup::People,
+			SettingsGroup::Device }) {
+		if (groups & group) {
+			names.push_back(GroupKey(group));
+		}
+	}
+	auto root = QJsonObject();
+	root.insert(u"format"_q, QString::fromLatin1(kFormat));
+	root.insert(u"version"_q, kVersion);
+	root.insert(u"tele"_q, u"%1 (Telegram Desktop %2)"_q.arg(
+		TitleLabel(),
+		QString::fromLatin1(AppVersionStr)));
+	root.insert(u"build"_q, BuildNumber());
+	root.insert(u"exported"_q, QDateTime::currentSecsSinceEpoch());
+	root.insert(u"groups"_q, names);
+	root.insert(u"options"_q, options);
+	if (!icons.isEmpty()) {
+		root.insert(u"icons"_q, icons);
+	}
+	if (!backgrounds.isEmpty()) {
+		root.insert(u"backgrounds"_q, backgrounds);
+	}
+	return QJsonDocument(root).toJson(QJsonDocument::Indented);
+}
+
+SettingsImport ParseSettings(const QByteArray &data) {
+	auto result = SettingsImport();
+	const auto fail = [&](const QString &error) {
+		result.error = Lower(error);
+		return std::move(result);
+	};
+	if (data.size() > kMaxSize) {
+		return fail(u"The file is too big."_q);
+	}
+	auto bytes = data.trimmed();
+	if (bytes.startsWith("\xEF\xBB\xBF")) {
+		bytes = bytes.mid(3);
+	}
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(bytes, &error);
+	const auto root = document.object();
+	if (error.error != QJsonParseError::NoError
+		|| !document.isObject()
+		|| root.value(u"format"_q).toString() != QLatin1String(kFormat)) {
+		return fail(u"This isn't a tele settings file."_q);
+	}
+	result.version = root.value(u"version"_q).toInt();
+	if (result.version < 1) {
+		return fail(u"Unknown settings file version."_q);
+	}
+	result.newer = (result.version > kVersion);
+	result.tele = root.value(u"tele"_q).toString();
+	result.exported = qint64(root.value(u"exported"_q).toDouble());
+	const auto options = root.value(u"options"_q).toObject();
+	const auto icons = root.value(u"icons"_q).toObject();
+	const auto backgrounds = root.value(u"backgrounds"_q).toObject();
+	auto parser = Parser(result, icons, backgrounds);
+	for (const auto &spec : Specs()) {
+		const auto i = options.find(QString::fromLatin1(spec.id));
+		if (i != options.end()) {
+			parser.parse(spec, *i);
+		}
+	}
+	for (auto i = options.begin(); i != options.end(); ++i) {
+		if (!FindSpec(i.key())) {
+			++result.unknown;
+		}
+	}
+	if (result.entries.empty()
+		&& result.skipped.empty()
+		&& !result.unknown) {
+		return fail(u"There are no settings in this file."_q);
+	}
+	return result;
+}
+
+int CountImportEntries(const SettingsImport &data, SettingsGroup group) {
+	return int(ranges::count(
+		data.entries,
+		group,
+		&SettingsImportEntry::group));
+}
+
+SettingsChanges CountSettingsChanges(
+		const SettingsImport &data,
+		SettingsGroups groups) {
+	auto result = SettingsChanges();
+	auto texts = base::flat_map<QString, QString>();
+	for (const auto &entry : data.entries) {
+		const auto spec = FindSpec(entry.id);
+		if (!spec || !(groups & entry.group)) {
+			continue;
+		}
+		auto changed = false;
+		if (spec->kind == Kind::Toggle) {
+			changed = (entry.flag != CurrentFlag(*spec));
+		} else if (spec->kind == Kind::AppIcon
+			|| spec->kind == Kind::TrayIcon) {
+			changed = IconChanges(*spec, entry);
+		} else {
+			const auto i = texts.find(entry.id);
+			const auto current = (i != end(texts))
+				? i->second
+				: CurrentText(*spec);
+			const auto next = NextText(*spec, entry, current);
+			texts[entry.id] = next;
+			changed = (next != current);
+		}
+		if (changed) {
+			++result.count;
+			result.restart = result.restart || RestartRequired(*spec);
+		}
+	}
+	return result;
+}
+
+SettingsChanges ApplySettings(
+		const SettingsImport &data,
+		SettingsGroups groups) {
+	auto result = SettingsChanges();
+	const auto draftsBefore = LocalDrafts();
+	for (const auto &entry : data.entries) {
+		const auto spec = FindSpec(entry.id);
+		if (!spec || !(groups & entry.group)) {
+			continue;
+		}
+		auto changed = false;
+		if (spec->kind == Kind::Toggle) {
+			auto &option = base::options::lookup<bool>(spec->id);
+			changed = (option.value() != entry.flag);
+			if (changed) {
+				option.set(entry.flag);
+			}
+		} else if (spec->kind == Kind::AppIcon
+			|| spec->kind == Kind::TrayIcon) {
+			changed = IconChanges(*spec, entry);
+			if (changed) {
+				ApplyIcon(*spec, entry);
+			}
+		} else {
+			if (spec->kind == Kind::Backgrounds) {
+				WriteFiles(entry.files);
+			}
+			const auto current = CurrentText(*spec);
+			const auto next = NextText(*spec, entry, current);
+			changed = (next != current);
+			if (changed) {
+				SetText(*spec, next);
+			}
+		}
+		if (changed) {
+			++result.count;
+			result.restart = result.restart || RestartRequired(*spec);
+		}
+	}
+	if (!draftsBefore && LocalDrafts()) {
+		PersistLocalDrafts();
+	}
+	return result;
+}
+
+QString SettingName(const QString &id) {
+	const auto spec = FindSpec(id);
+	if (!spec || spec->kind == Kind::Internal) {
+		return id;
+	}
+	const auto &name = base::options::details::Lookup(spec->id).name();
+	return name.isEmpty() ? id : Lower(name);
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.h b/Telegram/SourceFiles/tele/tele_settings_io.h
new file mode 100644
index 0000000000000000000000000000000000000000..69bef6a50cb9d32f687d612d65da88427794704e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_settings_io.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "base/flags.h"
+
+namespace Tele {
+
+enum class SettingsGroup : uchar {
+	Settings = (1 << 0),
+	People = (1 << 1),
+	Device = (1 << 2),
+};
+inline constexpr bool is_flag_type(SettingsGroup) { return true; }
+using SettingsGroups = base::flags<SettingsGroup>;
+
+struct SettingsIssue {
+	QString key;
+	QString reason;
+};
+
+struct SettingsImportEntry {
+	QString id;
+	SettingsGroup group = SettingsGroup::Settings;
+	bool flag = false;
+	QString text;
+	QByteArray image;
+	base::flat_map<QString, QByteArray> files;
+};
+
+struct SettingsImport {
+	QString error;
+	QString tele;
+	qint64 exported = 0;
+	int version = 0;
+	bool newer = false;
+	std::vector<SettingsImportEntry> entries;
+	std::vector<SettingsIssue> skipped;
+	int unknown = 0;
+};
+
+struct SettingsChanges {
+	int count = 0;
+	bool restart = false;
+};
+
+[[nodiscard]] QByteArray ExportSettings(SettingsGroups groups);
+[[nodiscard]] SettingsImport ParseSettings(const QByteArray &data);
+[[nodiscard]] int CountImportEntries(
+	const SettingsImport &data,
+	SettingsGroup group);
+[[nodiscard]] SettingsChanges CountSettingsChanges(
+	const SettingsImport &data,
+	SettingsGroups groups);
+SettingsChanges ApplySettings(
+	const SettingsImport &data,
+	SettingsGroups groups);
+[[nodiscard]] QString SettingName(const QString &id);
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_settings_io_box.cpp b/Telegram/SourceFiles/tele/tele_settings_io_box.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e32927e7780bfd981c5cd711c63f6fa9be0e5a10
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_settings_io_box.cpp
@@ -0,0 +1,383 @@
+#include "tele/tele_settings_io_box.h"
+
+#include "core/application.h"
+#include "core/file_utilities.h"
+#include "lang/lang_keys.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_settings_io.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/layers/generic_box.h"
+#include "ui/layers/show.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_widgets.h"
+
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxFileSize = 64 * 1024 * 1024;
+constexpr auto kMaxSkippedShown = 20;
+
+struct GroupInfo {
+	SettingsGroup group;
+	QString title;
+	QString exportAbout;
+	QString importAbout;
+	bool exportChecked = false;
+};
+
+[[nodiscard]] const std::vector<GroupInfo> &Groups() {
+	static const auto result = std::vector<GroupInfo>{
+		{
+			.group = SettingsGroup::Settings,
+			.title = u"Settings"_q,
+			.exportAbout = u"All toggles and choices, title templates, the "
+				"message menu, link rewrite rules, link previews and the "
+				"links opened in default apps."_q,
+			.importAbout = u"They replace yours. Links you open in a chosen "
+				"program stay as they are."_q,
+			.exportChecked = true,
+		},
+		{
+			.group = SettingsGroup::People,
+			.title = u"People"_q,
+			.exportAbout = u"Username aliases, custom names, ignored users, "
+				"ghost mode in chats and chat backgrounds. They point to "
+				"specific chats, so they only make sense for someone who "
+				"has the same people."_q,
+			.importAbout = u"Added to yours, the file wins for chats you "
+				"both have. They only work for the same people."_q,
+		},
+		{
+			.group = SettingsGroup::Device,
+			.title = u"This device"_q,
+			.exportAbout = u"Custom app and tray icons, and programs picked "
+				"to open links. Program paths may not exist on another "
+				"computer."_q,
+			.importAbout = u"Icons and programs that open links. A program "
+				"that isn't on this computer won't open anything."_q,
+		},
+	};
+	return result;
+}
+
+[[nodiscard]] QString SettingsFilter() {
+	return u"tele settings (*.tele-settings.json);;"_q
+		+ FileDialog::AllFilesFilter();
+}
+
+[[nodiscard]] QString SuggestedName() {
+	return u"tele-%1.tele-settings.json"_q.arg(
+		QDate::currentDate().toString(u"yyyy-MM-dd"_q));
+}
+
+[[nodiscard]] QString Plural(int count, const QString &one) {
+	return (count == 1) ? one : (one + 's');
+}
+
+[[nodiscard]] not_null<Ui::Checkbox*> AddGroup(
+		not_null<Ui::GenericBox*> box,
+		const QString &title,
+		const QString &about,
+		bool checked) {
+	const auto checkbox = box->addRow(object_ptr<Ui::Checkbox>(
+		box,
+		title,
+		checked,
+		st::defaultBoxCheckbox));
+	const auto rect = checkbox->checkRect();
+	const auto left = rect.x()
+		+ rect.width()
+		+ st::defaultBoxCheckbox.textPosition.x();
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(box, about, st::boxDividerLabel),
+		st::boxRowPadding + style::margins(left, 0, 0, 0));
+	Ui::AddSkip(box->verticalLayout());
+	return checkbox;
+}
+
+[[nodiscard]] rpl::producer<QString> ChangesText(
+		std::shared_ptr<SettingsImport> data,
+		rpl::producer<SettingsGroups> groups) {
+	return std::move(groups) | rpl::map([=](SettingsGroups groups) {
+		const auto changes = CountSettingsChanges(*data, groups);
+		if (!changes.count) {
+			return Lower(u"Nothing will change."_q);
+		}
+		return Lower(u"Will change %1 %2.%3"_q
+			.arg(changes.count)
+			.arg(Plural(changes.count, u"setting"_q))
+			.arg(changes.restart
+				? u" Some of them need a restart."_q
+				: QString()));
+	});
+}
+
+[[nodiscard]] QString SkippedText(const SettingsImport &data) {
+	auto lines = QStringList();
+	const auto shown = std::min(int(data.skipped.size()), kMaxSkippedShown);
+	for (auto i = 0; i != shown; ++i) {
+		const auto &issue = data.skipped[i];
+		lines.push_back(u"- %1: %2"_q.arg(
+			SettingName(issue.key),
+			Lower(issue.reason)));
+	}
+	if (const auto more = int(data.skipped.size()) - shown; more > 0) {
+		lines.push_back(Lower(u"And %1 more."_q.arg(more)));
+	}
+	if (data.unknown > 0) {
+		lines.push_back(Lower(u"%1 %2 this tele doesn't know, skipped."_q
+			.arg(data.unknown)
+			.arg(Plural(data.unknown, u"setting"_q))));
+	}
+	return lines.join('\n');
+}
+
+void ImportPreviewBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<SettingsImport> data) {
+	const auto show = box->uiShow();
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Import settings"_q)));
+
+	auto about = data->tele.isEmpty()
+		? Lower(u"Exported from tele"_q)
+		: (Lower(u"Exported from "_q) + data->tele);
+	if (data->exported > 0) {
+		about += Lower(u", %1"_q).arg(QDateTime::fromSecsSinceEpoch(
+			data->exported).toString(u"yyyy-MM-dd HH:mm"_q));
+	}
+	about += '.';
+	if (data->newer) {
+		about += ' ' + Lower(u"The file is from a newer tele, what this "
+			"version doesn't know is skipped."_q);
+	}
+	box->addRow(object_ptr<Ui::FlatLabel>(box, about, st::boxDividerLabel));
+	Ui::AddSkip(box->verticalLayout());
+
+	const auto selected = box->lifetime().make_state<
+		rpl::variable<SettingsGroups>>();
+	for (const auto &info : Groups()) {
+		const auto count = CountImportEntries(*data, info.group);
+		if (!count) {
+			continue;
+		}
+		const auto group = info.group;
+		*selected = (selected->current() | group);
+		const auto checkbox = AddGroup(
+			box,
+			Lower(u"%1, %2 in the file"_q.arg(info.title).arg(count)),
+			Lower(info.importAbout),
+			true);
+		checkbox->checkedChanges(
+		) | rpl::on_next([=](bool checked) {
+			const auto now = selected->current();
+			*selected = checked ? (now | group) : (now & ~group);
+		}, checkbox->lifetime());
+	}
+
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		ChangesText(data, selected->value()),
+		st::boxLabel));
+
+	if (const auto skipped = SkippedText(*data); !skipped.isEmpty()) {
+		Ui::AddSkip(box->verticalLayout());
+		Ui::AddDivider(box->verticalLayout());
+		Ui::AddSkip(box->verticalLayout());
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"Skipped:"_q) + '\n' + skipped,
+			st::boxDividerLabel));
+	}
+
+	box->addButton(rpl::single(Lower(u"Import"_q)), [=] {
+		const auto groups = selected->current();
+		if (!groups || !CountSettingsChanges(*data, groups).count) {
+			show->showToast(Lower(u"Nothing to import."_q));
+			return;
+		}
+		const auto result = ApplySettings(*data, groups);
+		box->closeBox();
+		const auto text = Lower(u"Imported, %1 %2 changed."_q
+			.arg(result.count)
+			.arg(Plural(result.count, u"setting"_q)));
+		if (result.restart) {
+			show->showBox(Ui::MakeConfirmBox({
+				.text = text + ' ' + Lower(u"Some of them need a restart."_q),
+				.confirmed = [] { Core::Restart(); },
+				.confirmText = tr::lng_settings_restart_now(),
+				.cancelText = tr::lng_settings_restart_later(),
+			}));
+		} else {
+			show->showToast(text);
+		}
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void OpenPreview(
+		not_null<Ui::GenericBox*> box,
+		const QByteArray &bytes,
+		Fn<void(QString)> fail) {
+	auto data = std::make_shared<SettingsImport>(ParseSettings(bytes));
+	if (!data->error.isEmpty()) {
+		fail(data->error);
+		return;
+	}
+	box->uiShow()->showBox(Box(ImportPreviewBox, std::move(data)));
+	box->closeBox();
+}
+
+} // namespace
+
+void ExportSettingsBox(not_null<Ui::GenericBox*> box) {
+	const auto show = box->uiShow();
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Export settings"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Save your tele settings to a file or copy them as text. "
+			"They can be imported in any tele, on any account."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(box->verticalLayout());
+
+	const auto checkboxes = box->lifetime().make_state<
+		std::vector<std::pair<SettingsGroup, not_null<Ui::Checkbox*>>>>();
+	for (const auto &info : Groups()) {
+		checkboxes->emplace_back(info.group, AddGroup(
+			box,
+			Lower(info.title),
+			Lower(info.exportAbout),
+			info.exportChecked));
+	}
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Accounts, sessions, drafts and cached tele server data are "
+			"never exported."_q),
+		st::boxDividerLabel));
+
+	const auto content = [=]() -> std::optional<QByteArray> {
+		auto groups = SettingsGroups();
+		for (const auto &[group, checkbox] : *checkboxes) {
+			if (checkbox->checked()) {
+				groups |= group;
+			}
+		}
+		if (!groups) {
+			show->showToast(Lower(u"Choose what to export."_q));
+			return std::nullopt;
+		}
+		return ExportSettings(groups);
+	};
+	box->addButton(rpl::single(Lower(u"Save..."_q)), [=] {
+		const auto data = content();
+		if (!data) {
+			return;
+		}
+		FileDialog::GetWritePath(
+			box.get(),
+			Lower(u"Export settings"_q),
+			SettingsFilter(),
+			SuggestedName(),
+			crl::guard(box, [=](QString &&path) {
+				auto file = QFile(path);
+				if (!file.open(QIODevice::WriteOnly)
+					|| file.write(*data) != data->size()) {
+					show->showToast(Lower(u"Couldn't write the file."_q));
+					return;
+				}
+				file.close();
+				show->showToast(Lower(u"Saved to %1."_q).arg(
+					QFileInfo(path).fileName()));
+				box->closeBox();
+			}));
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Copy"_q)), [=] {
+		const auto data = content();
+		if (!data) {
+			return;
+		}
+		QGuiApplication::clipboard()->setText(QString::fromUtf8(*data));
+		show->showToast(Lower(u"Copied. Paste it into Import settings in "
+			"any tele."_q));
+		box->closeBox();
+	});
+}
+
+void ImportSettingsBox(not_null<Ui::GenericBox*> box) {
+	const auto show = box->uiShow();
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Import settings"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Choose a .tele-settings.json file or paste the text someone "
+			"shared. You'll see what changes before anything is applied, "
+			"and your accounts are never touched."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(box->verticalLayout());
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::newGroupDescription,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(Lower(u"Paste settings here"_q))));
+	Ui::AddSkip(box->verticalLayout());
+
+	const auto fail = [=](QString error) {
+		show->showToast(error);
+	};
+	const auto submit = [=] {
+		const auto text = field->getLastText().trimmed();
+		if (text.isEmpty()) {
+			field->showError();
+			return;
+		}
+		OpenPreview(box, text.toUtf8(), fail);
+	};
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(rpl::single(Lower(u"Continue"_q)), submit);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Choose a file..."_q)), [=] {
+		FileDialog::GetOpenPath(
+			box.get(),
+			Lower(u"Import settings"_q),
+			u"tele settings (*.tele-settings.json *.json);;"_q
+				+ FileDialog::AllFilesFilter(),
+			crl::guard(box, [=](FileDialog::OpenResult &&result) {
+				auto bytes = result.remoteContent;
+				if (!result.paths.isEmpty()) {
+					auto file = QFile(result.paths.front());
+					if (file.size() > kMaxFileSize) {
+						fail(Lower(u"The file is too big."_q));
+						return;
+					} else if (!file.open(QIODevice::ReadOnly)) {
+						fail(Lower(u"Couldn't read the file."_q));
+						return;
+					}
+					bytes = file.readAll();
+				}
+				if (!bytes.isEmpty()) {
+					OpenPreview(box, bytes, fail);
+				}
+			}));
+	});
+}
+
+} // namespace Tele
