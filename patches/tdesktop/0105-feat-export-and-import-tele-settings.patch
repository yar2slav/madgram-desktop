 	});
 }
 
+std::optional<QString> NormalizeMessageMenuLayout(const QString &value) {
+	const auto &registry = Registry();
+	const auto known = ranges::any_of(
+		value.split(',', Qt::SkipEmptyParts),
+		[&](const QString &part) {
+			const auto trimmed = part.trimmed();
+			const auto key = trimmed.startsWith('-')
+				? trimmed.mid(1)
+				: trimmed;
+			return ranges::contains(registry, key, &Known::key);
+		});
+	if (!known && !value.trimmed().isEmpty()) {
+		return std::nullopt;
+	}
+	return SerializeLayout(ResolveLayout(value));
+}
+
 } // namespace Tele
