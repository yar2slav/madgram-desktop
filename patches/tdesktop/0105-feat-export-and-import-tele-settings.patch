+#include "tele/tele_options.h"
+#include "tele/tele_title_template.h"
+#include "tele/tele_username_aliases.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace Tele {
+namespace {
+
+constexpr auto kFormat = "tele-settings";
+constexpr auto kVersion = 1;
+constexpr auto kMaxSize = 64 * 1024 * 1024;
+
+enum class Kind : uchar {
+	Toggle,
+	Choice,
+	Title,
+	WindowTitle,
+	MessageMenu,
+	LinkRewrites,
+	ServerUrl,
+	AppLinks,
+	AppIcon,
+	TrayIcon,
+	List,
+	Backgrounds,
+	Internal,
+};
+
+struct Spec {
+	const char *id = nullptr;
+	SettingsGroup group = SettingsGroup::Settings;
+	Kind kind = Kind::Toggle;
+	QStringList choices;
+	QString (*normalize)(const QString &value) = nullptr;
+	QString (*get)() = nullptr;
+	void (*set)(const QString &value) = nullptr;
+};
+
+[[nodiscard]] Spec Toggle(const char *id) {
+	return { .id = id };
+}
+
+[[nodiscard]] Spec Text(const char *id, Kind kind) {
+	return { .id = id, .kind = kind };
+}
+
+[[nodiscard]] Spec Choice(const char *id, QStringList choices) {
+	return { .id = id, .kind = Kind::Choice, .choices = std::move(choices) };
+}
+
+[[nodiscard]] Spec People(
+		const char *id,
+		Kind kind,
+		QString (*normalize)(const QString &value) = nullptr) {
+	return {
+		.id = id,
+		.group = SettingsGroup::People,
+		.kind = kind,
+		.normalize = normalize,
+	};
+}
+
+[[nodiscard]] Spec Device(const char *id, Kind kind) {
+	return { .id = id, .group = SettingsGroup::Device, .kind = kind };
+}
+
+[[nodiscard]] Spec Internal(const char *id) {
+	return { .id = id, .kind = Kind::Internal };
+}
+
+[[nodiscard]] const std::vector<Spec> &Specs() {
+	static const auto result = std::vector<Spec>{
+		Toggle(kOptionHideStories),
+		Toggle(kOptionInvisibleStories),
+		Toggle(kOptionGhost),
+		Toggle(kOptionGhostInMenu),
+		Toggle(kOptionGhostRead),
+		Toggle(kOptionGhostReadOnReply),
+		Toggle(kOptionGhostTyping),
+		Toggle(kOptionGhostOnline),
+		Toggle(kOptionGhostSchedule),
+		Toggle(kOptionGhostStories),
