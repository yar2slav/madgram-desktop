 }
 
+QString NormalizeChatBackgrounds(
+		const QString &value,
+		Fn<bool(const QString &file)> hasFile) {
+	auto specs = Parse(value);
+	for (auto i = begin(specs); i != end(specs);) {
+		if (i->second == NoneSpec() || ParseCustom(i->second, hasFile)) {
+			++i;
+		} else {
+			i = specs.erase(i);
+		}
+	}
+	return Serialize(specs);
+}
+
+QStringList ChatBackgroundFiles(const QString &value) {
+	auto result = QStringList();
+	for (const auto &[key, spec] : Parse(value)) {
+		const auto file = SpecFile(spec);
+		if (!file.isEmpty() && !result.contains(file)) {
+			result.push_back(file);
+		}
+	}
+	return result;
+}
+
+QString ChatBackgroundFilePath(const QString &file) {
+	return Folder() + file;
+}
+
