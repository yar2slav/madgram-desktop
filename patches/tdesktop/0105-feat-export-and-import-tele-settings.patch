+void AddBackup(SectionBuilder &builder) {
+	const auto controller = builder.controller();
+	const auto add = [&](
+			const QString &id,
+			const QString &title,
+			void (*box)(not_null<Ui::GenericBox*>),
+			QStringList keywords) {
+		const auto button = builder.addButton({
+			.id = id,
+			.title = rpl::single(::Tele::Lower(title)),
+			.st = &st::settingsButtonNoIcon,
+			.onClick = [=] {
