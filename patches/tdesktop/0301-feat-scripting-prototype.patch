index 0000000000000000000000000000000000000000..49f5058e07ec6c5f9a91653a06c4df90011d2dce
--- /dev/null
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_worker.cpp
@@ -0,0 +1,825 @@
+#include "tele/scripting/tele_script_worker.h"
+
+#include "tele/scripting/tele_script_engine.h"
+#include "tele/scripting/tele_script_instance.h"
+#include "tele/scripting/tele_script_intl.h"
+#include "tele/scripting/tele_script_native.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QRegularExpression>
+#include <QtCore/QThread>
+#include <QtCore/QUrl>
+
+#include <atomic>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kMaxWorkers = 8;
+constexpr auto kThreadStack = uint(4 * 1024 * 1024);
+constexpr auto kWriteFlags = JS_WRITE_OBJ_REFERENCE;
+constexpr auto kReadFlags = JS_READ_OBJ_REFERENCE;
+constexpr auto kScopeLookup = "globalThis.__teleExtensions"
+	".find((extension) => extension.name === 'worker')";
+
+constexpr auto kTypings = R"ts(
+interface WorkerOptions {
+  name?: string
+}
+
+interface ErrorEventInit extends EventInit {
+  message?: string
+  filename?: string
+  lineno?: number
+  colno?: number
+  error?: unknown
+}
+
+declare class ErrorEvent extends Event {
+  constructor(type: string, init?: ErrorEventInit)
+  readonly message: string
+  readonly filename: string
+  readonly lineno: number
+  readonly colno: number
+  readonly error: unknown
+}
+
+declare class Worker extends EventTarget {
+  constructor(path: string | URL, options?: WorkerOptions)
+  postMessage(data: unknown, transfer?: Transferable[] | StructuredSerializeOptions): void
+  terminate(): void
+  onmessage: ((this: Worker, event: MessageEvent) => void) | null
+  onmessageerror: ((this: Worker, event: MessageEvent) => void) | null
+  onerror: ((this: Worker, event: ErrorEvent) => void) | null
+  addEventListener(type: 'message' | 'messageerror', listener: (this: Worker, event: MessageEvent) => void, options?: AddEventListenerOptions | boolean): void
+  addEventListener(type: 'error', listener: (this: Worker, event: ErrorEvent) => void, options?: AddEventListenerOptions | boolean): void
+  addEventListener(type: string, listener: EventListenerOrEventListenerObject | null, options?: AddEventListenerOptions | boolean): void
+  removeEventListener(type: 'message' | 'messageerror', listener: (this: Worker, event: MessageEvent) => void, options?: EventListenerOptions | boolean): void
+  removeEventListener(type: 'error', listener: (this: Worker, event: ErrorEvent) => void, options?: EventListenerOptions | boolean): void
+  removeEventListener(type: string, listener: EventListenerOrEventListenerObject | null, options?: EventListenerOptions | boolean): void
+}
+
+interface WorkerGlobalScope extends EventTarget {
+  readonly self: WorkerGlobalScope
+  readonly name: string
+  postMessage(data: unknown, transfer?: Transferable[] | StructuredSerializeOptions): void
+  close(): never
+  onmessage: ((this: WorkerGlobalScope, event: MessageEvent) => void) | null
+  onmessageerror: ((this: WorkerGlobalScope, event: MessageEvent) => void) | null
+  addEventListener(type: 'message' | 'messageerror', listener: (this: WorkerGlobalScope, event: MessageEvent) => void, options?: AddEventListenerOptions | boolean): void
+  addEventListener(type: string, listener: EventListenerOrEventListenerObject | null, options?: AddEventListenerOptions | boolean): void
+  removeEventListener(type: 'message' | 'messageerror', listener: (this: WorkerGlobalScope, event: MessageEvent) => void, options?: EventListenerOptions | boolean): void
+  removeEventListener(type: string, listener: EventListenerOrEventListenerObject | null, options?: EventListenerOptions | boolean): void
+}
+)ts";
+
+struct Fault {
+	QString message;
+	QString filename;
+	int lineno = 0;
+	int colno = 0;
+};
+
+struct Scope {
+	std::unique_ptr<Engine> engine;
+	JSValue dispatch = JS_UNDEFINED;
+	JSValue describe = JS_UNDEFINED;
+	bool closing = false;
+	bool ready = false;
+	std::vector<QByteArray> held;
+};
+
+struct Located {
+	QString path;
+	const char *code = nullptr;
+	QString error;
+};
+
+[[nodiscard]] std::optional<QByteArray> Serialize(
+		JSContext *ctx,
+		JSValueConst value) {
+	auto size = std::size_t();
+	const auto data = JS_WriteObject(ctx, &size, value, kWriteFlags);
+	if (!data) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(reinterpret_cast<const char*>(data), int(size));
+	js_free(ctx, data);
+	return result;
+}
+
+[[nodiscard]] JSValue Deserialize(JSContext *ctx, const QByteArray &bytes) {
+	return JS_ReadObject(
+		ctx,
+		reinterpret_cast<const uint8_t*>(bytes.constData()),
+		std::size_t(bytes.size()),
+		kReadFlags);
+}
+
+class Host final {
+public:
+	Host(
+		int id,
+		not_null<Instance*> instance,
+		int listener,
+		QString path,
+		QString root,
+		QString name);
+	~Host();
+
+	Host(const Host &) = delete;
+	Host &operator=(const Host &) = delete;
+
+	[[nodiscard]] const void *owner() const;
+	[[nodiscard]] base::weak_ptr<Instance> instance() const;
+	[[nodiscard]] int listener() const;
+	[[nodiscard]] QString label() const;
+
+	void start(QByteArray code, QString error);
+	void post(QByteArray bytes);
+
+	void send(QByteArray bytes);
+	void close();
+	void report(JSValueConst error);
+	void ready();
+
+private:
+	template <typename Callback>
+	void queue(Callback &&callback) {
+		QMetaObject::invokeMethod(
+			_context.get(),
+			std::forward<Callback>(callback),
+			Qt::QueuedConnection);
+	}
+
+	void run(QByteArray code, QString error);
+	[[nodiscard]] bool setup(JSContext *ctx);
+	void evaluate(JSContext *ctx, const QByteArray &code);
+	void receive(QByteArray bytes);
+	void print(LogLevel level, QString text, QByteArray values);
+	void fail(Fault fault);
+	void finish();
+	void drop();
+	[[nodiscard]] bool active() const;
+
+	const int _id = 0;
+	const void *_owner = nullptr;
+	const base::weak_ptr<Instance> _instance;
+	const int _listener = 0;
+	const QString _path;
+	const QString _root;
+	const QString _name;
+
+	std::atomic<bool> _terminated = false;
+	std::mutex _mutex;
+	Engine *_engine = nullptr;
+
+	std::unique_ptr<Scope> _scope;
+	bool _finished = false;
+
+	QThread _thread;
+	std::unique_ptr<QObject> _context;
+
+};
+
+thread_local Host *Current = nullptr;
+
+JSValue Evaluated(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic,
+		JSValue *data) {
+	if (const auto host = Current) {
+		if (magic == 1 && argc > 0) {
+			host->report(argv[0]);
+		}
+		host->ready();
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue NativeScope(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto host = Current;
+	if (!host) {
+		return JS_ThrowInternalError(ctx, "the worker is gone");
+	}
+	switch (magic) {
+	case 0: {
+		const auto bytes = Serialize(ctx, (argc > 0) ? argv[0] : JS_UNDEFINED);
+		if (!bytes) {
+			return JS_EXCEPTION;
+		}
+		host->send(*bytes);
+	} break;
+	case 1: {
+		host->close();
+		JS_ThrowInternalError(ctx, "the worker closed");
+		auto error = JS_GetException(ctx);
+		JS_SetUncatchableError(ctx, error);
+		return JS_Throw(ctx, error);
+	}
+	case 2:
+		host->report((argc > 0) ? argv[0] : JS_UNDEFINED);
+		break;
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] std::map<int, std::unique_ptr<Host>> &Hosts() {
+	static auto result = std::map<int, std::unique_ptr<Host>>();
+	return result;
+}
+
+[[nodiscard]] int NextId() {
+	static auto result = 0;
+	return ++result;
+}
+
+[[nodiscard]] Host *Find(int id, const void *owner) {
+	const auto i = Hosts().find(id);
+	return (i != end(Hosts()) && (!owner || i->second->owner() == owner))
+		? i->second.get()
+		: nullptr;
+}
+
+void Remove(int id, bool forget) {
+	auto &hosts = Hosts();
+	const auto i = hosts.find(id);
+	if (i == end(hosts)) {
+		return;
+	}
+	auto host = std::move(i->second);
+	hosts.erase(i);
+	if (forget) {
+		ForgetKept(host->instance(), host->listener());
+	}
+	host = nullptr;
+}
+
+void Deliver(int id, Fn<JSValue(JSContext*)> packet, const QString &where) {
+	const auto host = Find(id, nullptr);
+	if (!host) {
+		return;
+	}
+	const auto instance = host->instance();
+	const auto listener = host->listener();
+	CallKept(instance, listener, std::move(packet), where);
+}
+
+void Delivered(int id, QByteArray bytes) {
+	Deliver(id, [=](JSContext *ctx) {
+		auto packet = JS_NewObject(ctx);
+		auto data = Deserialize(ctx, bytes);
+		if (JS_IsException(data)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			JS_SetPropertyStr(
+				ctx,
+				packet,
+				"type",
+				JS_NewString(ctx, "messageerror"));
+		} else {
+			JS_SetPropertyStr(ctx, packet, "type", JS_NewString(ctx, "message"));
+			JS_SetPropertyStr(ctx, packet, "data", data);
+		}
+		return packet;
+	}, u"a worker message"_q);
+}
+
+void Failed(int id, Fault fault) {
+	Deliver(id, [=](JSContext *ctx) {
+		auto packet = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, packet, "type", JS_NewString(ctx, "error"));
+		JS_SetPropertyStr(
+			ctx,
+			packet,
+			"message",
+			NewString(ctx, fault.message));
+		JS_SetPropertyStr(
+			ctx,
+			packet,
+			"filename",
+			NewString(ctx, fault.filename));
+		JS_SetPropertyStr(ctx, packet, "lineno", JS_NewInt32(ctx, fault.lineno));
+		JS_SetPropertyStr(ctx, packet, "colno", JS_NewInt32(ctx, fault.colno));
+		return packet;
+	}, u"a worker error"_q);
+}
+
+void Printed(int id, LogLevel level, QString text, QByteArray values) {
+	const auto host = Find(id, nullptr);
+	const auto strong = host ? host->instance().get() : nullptr;
+	const auto ctx = strong ? strong->context() : nullptr;
+	if (const auto engine = ctx ? EngineOf(ctx) : nullptr) {
+		engine->log(
+			level,
+			u"[worker "_q + host->label() + u"] "_q + text,
+			std::move(values));
+	}
+}
+
+Host::Host(
+	int id,
+	not_null<Instance*> instance,
+	int listener,
+	QString path,
+	QString root,
+	QString name)
+: _id(id)
+, _owner(instance.get())
+, _instance(base::make_weak(instance.get()))
+, _listener(listener)
+, _path(std::move(path))
+, _root(std::move(root))
+, _name(std::move(name))
+, _context(std::make_unique<QObject>()) {
+	_thread.setStackSize(kThreadStack);
+	_context->moveToThread(&_thread);
+	_thread.start();
+}
+
+Host::~Host() {
+	{
+		const auto lock = std::lock_guard(_mutex);
+		_terminated = true;
+		if (_engine) {
+			_engine->interrupt();
+		}
+	}
+	QMetaObject::invokeMethod(_context.get(), [&] {
+		drop();
+	}, Qt::BlockingQueuedConnection);
+	_thread.quit();
+	_thread.wait();
+}
+
+const void *Host::owner() const {
+	return _owner;
+}
+
+base::weak_ptr<Instance> Host::instance() const {
+	return _instance;
+}
+
+int Host::listener() const {
+	return _listener;
+}
+
+QString Host::label() const {
+	return _name.isEmpty() ? QFileInfo(_path).fileName() : _name;
+}
+
+void Host::start(QByteArray code, QString error) {
+	queue([=] {
+		run(code, error);
+	});
+}
+
+void Host::post(QByteArray bytes) {
+	queue([=] {
+		receive(bytes);
+	});
+}
+
+bool Host::active() const {
+	return !_terminated && _scope && !_scope->closing;
+}
+
+void Host::run(QByteArray code, QString error) {
+	if (_terminated) {
+		return;
+	} else if (!error.isEmpty()) {
+		fail({ .message = error, .filename = _path });
+		finish();
+		return;
+	}
+	Current = this;
+	_scope = std::make_unique<Scope>();
+	_scope->engine = std::make_unique<Engine>(
+		_path,
+		_root,
+		[=](LogLevel level, QString text, QByteArray values) {
+			print(level, std::move(text), std::move(values));
+		},
+		EngineKind::Worker);
+	const auto engine = _scope->engine.get();
+	{
+		const auto lock = std::lock_guard(_mutex);
+		_engine = engine;
+		if (_terminated) {
+			engine->interrupt();
+		}
+	}
+	engine->setFaultHandler([=](JSValueConst error) {
+		report(error);
+	});
+	const auto ctx = engine->ctx();
+	JS_UpdateStackTop(JS_GetRuntime(ctx));
+	if (!setup(ctx)) {
+		finish();
+		return;
+	}
+	evaluate(ctx, code);
+}
+
+bool Host::setup(JSContext *ctx) {
+	const auto engine = _scope->engine.get();
+	auto natives = JS_NewObject(ctx);
+	AddNatives(ctx, natives, {
+		{ "workerScopePost", NativeScope, 1, 0 },
+		{ "workerScopeClose", NativeScope, 0, 1 },
+		{ "workerScopeReport", NativeScope, 1, 2 },
+	});
+	JS_SetPropertyStr(ctx, natives, "workerScopeName", NewString(ctx, _name));
+	AddIntlNatives(ctx, natives);
+	auto extension = JS_Eval(
+		ctx,
+		kScopeLookup,
+		std::strlen(kScopeLookup),
+		"<tele worker>",
+		JS_EVAL_TYPE_GLOBAL);
+	if (JS_IsException(extension)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		extension = JS_UNDEFINED;
+	}
+	auto scope = JS_IsObject(extension)
+		? JS_GetPropertyStr(ctx, extension, "scope")
+		: JS_UNDEFINED;
+	auto result = false;
+	if (!JS_IsFunction(ctx, scope)) {
+		fail({
+			.message = u"the worker runtime is missing"_q,
+			.filename = _path,
+		});
+	} else {
+		JSValueConst args[] = { natives };
+		auto hooks = engine->call(
+			scope,
+			extension,
+			args,
+			0,
+			u"the worker scope"_q);
+		if (JS_IsObject(hooks)) {
+			_scope->dispatch = JS_GetPropertyStr(ctx, hooks, "dispatch");
+			_scope->describe = JS_GetPropertyStr(ctx, hooks, "describe");
+			result = JS_IsFunction(ctx, _scope->dispatch);
+		}
+		JS_FreeValue(ctx, hooks);
+	}
+	JS_FreeValue(ctx, scope);
+	JS_FreeValue(ctx, extension);
+	JS_FreeValue(ctx, natives);
+	return result;
+}
+
+void Host::evaluate(JSContext *ctx, const QByteArray &code) {
+	const auto engine = _scope->engine.get();
+	const auto name = _path.toUtf8();
+	auto result = JS_Eval(
+		ctx,
+		code.constData(),
+		code.size(),
+		name.constData(),
+		JS_EVAL_TYPE_MODULE);
+	if (JS_IsException(result)) {
+		engine->report(u"loading"_q);
+		finish();
+		return;
+	}
+	engine->drain(false);
+	if (JS_IsPromise(result)
+		&& JS_PromiseState(ctx, result) == JS_PROMISE_REJECTED) {
+		auto reason = JS_PromiseResult(ctx, result);
+		engine->rejected(result, reason, true);
+		report(reason);
+		JS_FreeValue(ctx, reason);
+	}
+	if (JS_IsPromise(result)
+		&& JS_PromiseState(ctx, result) == JS_PROMISE_PENDING) {
+		auto fulfilled = JS_NewCFunctionData(ctx, Evaluated, 1, 0, 0, nullptr);
+		auto rejected = JS_NewCFunctionData(ctx, Evaluated, 1, 1, 0, nullptr);
+		auto then = JS_GetPropertyStr(ctx, result, "then");
+		JSValueConst args[] = { fulfilled, rejected };
+		JS_FreeValue(ctx, JS_Call(ctx, then, result, 2, args));
+		JS_FreeValue(ctx, then);
+		JS_FreeValue(ctx, fulfilled);
+		JS_FreeValue(ctx, rejected);
+	} else {
+		ready();
+	}
+	JS_FreeValue(ctx, result);
+	engine->flushRejections();
+}
+
+void Host::ready() {
+	queue([=] {
+		if (!_scope || _scope->ready) {
+			return;
+		}
+		_scope->ready = true;
+		auto held = base::take(_scope->held);
+		for (auto &bytes : held) {
+			receive(std::move(bytes));
+		}
+	});
+}
+
+void Host::receive(QByteArray bytes) {
+	if (!active()) {
+		return;
+	} else if (!_scope->ready) {
+		_scope->held.push_back(std::move(bytes));
+		return;
+	}
+	const auto engine = _scope->engine.get();
+	const auto ctx = engine->ctx();
+	JS_UpdateStackTop(JS_GetRuntime(ctx));
+	auto data = Deserialize(ctx, bytes);
+	const auto broken = JS_IsException(data);
+	if (broken) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		data = JS_UNDEFINED;
+	}
+	auto type = JS_NewString(ctx, broken ? "messageerror" : "message");
+	JSValueConst args[] = { type, data };
+	JS_FreeValue(
+		ctx,
+		engine->call(
+			_scope->dispatch,
+			JS_UNDEFINED,
+			args,
+			0,
+			u"a worker message"_q));
+	JS_FreeValue(ctx, type);
+	JS_FreeValue(ctx, data);
+	engine->drain();
+}
+
+void Host::send(QByteArray bytes) {
+	if (active()) {
+		crl::on_main([id = _id, bytes = std::move(bytes)] {
+			Delivered(id, bytes);
+		});
+	}
+}
+
+void Host::close() {
+	if (!_scope || _scope->closing) {
+		return;
+	}
+	_scope->closing = true;
+	_scope->engine->interrupt();
+	queue([=] {
+		finish();
+	});
+}
+
+void Host::report(JSValueConst error) {
+	if (!active()) {
+		return;
+	}
+	const auto engine = _scope->engine.get();
+	const auto ctx = engine->ctx();
+	auto fault = Fault();
+	if (JS_IsFunction(ctx, _scope->describe)) {
+		auto described = JS_Call(
+			ctx,
+			_scope->describe,
+			JS_UNDEFINED,
+			1,
+			const_cast<JSValue*>(&error));
+		if (JS_IsException(described)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+		} else {
+			fault.message = StringProperty(ctx, described, "message");
+			fault.filename = StringProperty(ctx, described, "filename");
+			fault.lineno = int(
+				NumberProperty(ctx, described, "lineno").value_or(0));
+			fault.colno = int(
+				NumberProperty(ctx, described, "colno").value_or(0));
+		}
+		JS_FreeValue(ctx, described);
+	}
+	if (fault.message.isEmpty()) {
+		fault.message = u"Uncaught "_q + engine->describe(error);
+	}
+	if (fault.filename.isEmpty()) {
+		fault.filename = _path;
+	}
+	fail(std::move(fault));
+}
+
+void Host::print(LogLevel level, QString text, QByteArray values) {
+	if (_terminated || (_scope && _scope->closing)) {
+		return;
+	}
+	crl::on_main([
+			id = _id,
+			level,
+			text = std::move(text),
+			values = std::move(values)] {
+		Printed(id, level, text, values);
+	});
+}
+
+void Host::fail(Fault fault) {
+	if (_terminated) {
+		return;
+	}
+	crl::on_main([id = _id, fault = std::move(fault)] {
+		Failed(id, fault);
+	});
+}
+
+void Host::finish() {
+	if (_finished) {
+		return;
+	}
+	_finished = true;
+	drop();
+	crl::on_main([id = _id] {
+		Remove(id, true);
+	});
+}
+
+void Host::drop() {
+	if (!_scope) {
+		return;
+	}
+	{
+		const auto lock = std::lock_guard(_mutex);
+		_engine = nullptr;
+	}
+	const auto ctx = _scope->engine->ctx();
+	JS_FreeValue(ctx, _scope->dispatch);
+	JS_FreeValue(ctx, _scope->describe);
+	_scope = nullptr;
+	Current = nullptr;
+}
+
+[[nodiscard]] Located Locate(
+		const QString &entry,
+		const QString &root,
+		const QString &requested) {
+	static const auto scheme = QRegularExpression(
+		u"^[A-Za-z][A-Za-z0-9+.\\-]+:"_q);
+	auto path = requested;
+	if (path.startsWith(u"file:"_q, Qt::CaseInsensitive)) {
+		path = QUrl(path).toLocalFile();
+		if (path.isEmpty()) {
+			return { .code = "not-found", .error = u"can't open '"_q
+				+ requested
+				+ '\'' };
+		}
+	} else if (scheme.match(path).hasMatch()) {
+		return { .code = "unsupported", .error = u"a worker starts from "
+			u"a file of the script, not '"_q + requested + '\'' };
+	}
+	const auto folder = QFileInfo(entry).absolutePath();
+	const auto full = QDir::cleanPath(QDir(folder).absoluteFilePath(path));
+	if (full != root && !full.startsWith(root + '/')) {
+		return { .code = "forbidden", .error = u"'"_q
+			+ requested
+			+ u"' is outside the script"_q };
+	}
+	for (const auto &suffix : { QString(), u".ts"_q, u".js"_q }) {
+		if (QFileInfo(full + suffix).isFile()) {
+			return { .path = full + suffix };
+		}
+	}
+	return { .code = "not-found", .error = u"can't find '"_q
+		+ requested
+		+ '\'' };
+}
+
+JSValue Start(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	if (argc < 3 || !JS_IsString(argv[0]) || !JS_IsFunction(ctx, argv[2])) {
+		return JS_ThrowTypeError(ctx, "a worker needs a path");
+	}
+	const auto running = ranges::count_if(Hosts(), [&](const auto &pair) {
+		return pair.second->owner() == instance.get();
+	});
+	if (running >= kMaxWorkers) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"a script runs at most %1 workers at once"_q.arg(kMaxWorkers));
+	}
+	const auto engine = EngineOf(ctx);
+	const auto located = Locate(
+		engine->entry(),
+		engine->root(),
+		FromStd(ToStd(ctx, argv[0])));
+	if (located.code) {
+		return ThrowTeleError(ctx, located.code, located.error);
+	}
+	auto file = QFile(located.path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"can't read "_q + QFileInfo(located.path).fileName());
+	}
+	auto code = file.readAll();
+	auto error = QString();
+	if (located.path.endsWith(u".ts"_q, Qt::CaseInsensitive)
+		|| located.path.endsWith(u".mts"_q, Qt::CaseInsensitive)) {
+		auto failure = QString();
+		if (auto stripped = engine->transpile(code, failure)) {
+			code = std::move(*stripped);
+		} else {
+			error = QFileInfo(located.path).fileName() + u": "_q + failure;
+		}
+	}
+	const auto name = JS_IsString(argv[1])
+		? FromStd(ToStd(ctx, argv[1]))
+		: QString();
+	const auto listener = KeepFunction(instance, argv[2]);
+	const auto id = NextId();
+	auto host = std::make_unique<Host>(
+		id,
+		instance,
+		listener,
+		located.path,
+		engine->root(),
+		name);
+	const auto raw = host.get();
+	Hosts().emplace(id, std::move(host));
+	ScriptLifetime(instance).add([id] {
+		Remove(id, false);
+	});
+	raw->start(std::move(code), std::move(error));
+	return JS_NewInt32(ctx, id);
+}
+
+JSValue NativeWorker(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (magic == 0) {
+		return Start(ctx, instance, argc, argv);
+	}
+	auto id = 0;
+	if (argc < 1 || !JS_IsNumber(argv[0])) {
+		return JS_ThrowTypeError(ctx, "a worker needs its id");
+	} else if (JS_ToInt32(ctx, &id, argv[0]) < 0) {
+		return JS_EXCEPTION;
+	}
+	if (magic == 1) {
+		const auto bytes = Serialize(ctx, (argc > 1) ? argv[1] : JS_UNDEFINED);
+		if (!bytes) {
+			return JS_EXCEPTION;
+		} else if (const auto host = Find(id, instance)) {
+			host->post(*bytes);
+		}
+	} else if (Find(id, instance)) {
+		Remove(id, true);
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddWorkerNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "workerStart", NativeWorker, 3, 0 },
+		{ "workerPost", NativeWorker, 2, 1 },
+		{ "workerTerminate", NativeWorker, 1, 2 },
+	});
+}
