+void Console::handleScripts(const QString &event, const QJsonObject &message) {
+	using namespace Scripting;
+	const auto id = message.value(u"id"_q).toString();
+	if (event == u"scripts"_q) {
+		if (!_scriptsLifetime) {
+			ScriptsChanged(
+				_session
+			) | rpl::on_next([=] {
+				sendScripts();
+			}, _scriptsLifetime);
+			ScriptLogChanges(
+				_session
+			) | rpl::on_next([=](const ScriptLogged &logged) {
+				notify(u"scriptLogAppend"_q, QJsonObject{
+					{ u"id"_q, logged.id },
+					{ u"line"_q, LogLineJson(logged.line) },
+				});
+			}, _scriptsLifetime);
+		}
+		sendScripts();
+	} else if (event == u"script-log"_q) {
+		auto lines = QJsonArray();
+		for (const auto &line : ScriptLog(_session, id)) {
+			lines.push_back(LogLineJson(line));
+		}
+		notify(u"scriptLog"_q, QJsonObject{
+			{ u"id"_q, id },
+			{ u"lines"_q, lines },
+		});
+	} else if (event == u"script-toggle"_q) {
+		const auto enabled = message.value(u"enabled"_q).toBool();
+		SetScriptEnabled(_session, id, enabled);
+		if (enabled) {
+			const auto scripts = Scripts(_session);
+			const auto i = ranges::find(scripts, id, &ScriptState::id);
+			if (i != end(scripts) && i->approval) {
+				if (const auto window = _session->tryResolveWindow()) {
+					window->window().activate();
+					ShowScriptApproval(window->uiShow(), _session, id);
+				}
+			}
+		}
+	} else if (event == u"script-reload"_q) {
+		ReloadScript(_session, id);
+	} else if (event == u"script-review"_q) {
+		if (const auto window = _session->tryResolveWindow()) {
+			window->window().activate();
+			ShowScriptApproval(window->uiShow(), _session, id);
+		}
+	} else if (event == u"scripts-folder"_q) {
+		PrepareScriptsFolder();
+		QDesktopServices::openUrl(QUrl::fromLocalFile(ScriptsFolder()));
+	} else if (event == u"repl-eval"_q) {
+		const auto seq = message.value(u"seq"_q).toInt();
+		const auto weak = base::make_weak(this);
+		EvaluateInScript(
+			_session,
+			message.value(u"target"_q).toString(),
+			message.value(u"code"_q).toString(),
+			[=](bool ok, QString text, QByteArray tree) {
+				crl::on_main(weak, [=] {
+					auto result = QJsonObject{
+						{ u"seq"_q, seq },
+						{ u"ok"_q, ok },
+						{ u"text"_q, text },
+					};
+					const auto parsed = QJsonDocument::fromJson(
+						u"["_q.toUtf8() + tree + "]");
+					if (!tree.isEmpty() && parsed.isArray()) {
+						result.insert(u"tree"_q, parsed.array().at(0));
+					}
+					notify(u"replResult"_q, result);
+				});
+			});
+	}
+}
+
+void Console::sendScripts() {
+	using namespace Scripting;
+	auto list = QJsonArray();
+	for (const auto &script : Scripts(_session)) {
+		list.push_back(QJsonObject{
+			{ u"id"_q, script.id },
+			{ u"name"_q, script.name },
+			{ u"enabled"_q, script.enabled },
+			{ u"running"_q, script.running },
+			{ u"approval"_q, script.approval },
+			{ u"error"_q, script.error },
+			{ u"requested"_q, QJsonArray::fromStringList(script.requested) },
+			{ u"granted"_q, QJsonArray::fromStringList(script.granted) },
+		});
+	}
+	notify(u"scripts"_q, QJsonObject{
+		{ u"folder"_q, QDir::toNativeSeparators(ScriptsFolder()) },
+		{ u"list"_q, list },
+	});
+}
