+[[nodiscard]] const Definition &DefinitionOf(Capability capability) {
+	const auto i = ranges::find(kDefinitions, capability, &Definition::capability);
+	Assert(i != end(kDefinitions));
+	return *i;
+}
+
+[[nodiscard]] bool ValidDomain(std::string_view host) {
+	static const auto expression = QRegularExpression(
+		u"^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
+		"(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*$"_q);
+	return expression.match(QString::fromUtf8(
+		host.data(),
+		int(host.size()))).hasMatch();
+}
+
+[[nodiscard]] bool HostMatches(std::string_view scope, std::string_view host) {
+	if (scope.empty() || scope == host) {
+		return true;
+	}
+	return host.size() > scope.size()
+		&& host.ends_with(scope)
+		&& host[host.size() - scope.size() - 1] == '.';
+}
+
+[[nodiscard]] std::string_view Prefix(std::string_view pattern) {
+	return IsGlob(pattern) ? pattern.substr(0, pattern.size() - 1) : pattern;
+}
+
+[[nodiscard]] bool MethodMatches(
+		Capability capability,
+		std::string_view scope,
+		std::string_view method) {
+	if (scope == method) {
+		return true;
+	} else if (DangerousName(capability, method)) {
+		return false;
+	}
+	return scope.empty()
+		|| (IsGlob(scope) && method.starts_with(Prefix(scope)));
+}
+
+[[nodiscard]] bool Covers(const Grant &wide, const Grant &narrow) {
+	if (wide.capability != narrow.capability) {
+		return false;
+	} else if (wide.capability == Capability::AccountWrite
+		&& narrow.scope == "gifts") {
+		return wide.scope == narrow.scope;
+	} else if (wide.scope == narrow.scope || wide.scope.empty()) {
+		return wide.scope == narrow.scope
+			|| !DangerousName(narrow.capability, narrow.scope);
+	}
+	switch (DefinitionOf(wide.capability).kind) {
+	case ScopeKind::Domain:
+		return !narrow.scope.empty() && HostMatches(wide.scope, narrow.scope);
+	case ScopeKind::Path:
+		return !narrow.scope.empty()
+			&& PathInside(
+				ResolveScopeFolder(narrow.scope),
+				ResolveScopeFolder(wide.scope));
+	case ScopeKind::Method:
+		if (narrow.scope.empty() || !IsGlob(wide.scope)) {
+			return false;
+		} else if (!IsGlob(narrow.scope)) {
+			return MethodMatches(wide.capability, wide.scope, narrow.scope);
+		}
+		return Prefix(narrow.scope).starts_with(Prefix(wide.scope));
+	default:
+		return false;
+	}
+}
+
+[[nodiscard]] std::vector<std::string> SplitScopes(std::string_view text) {
+	auto result = std::vector<std::string>();
+	while (!text.empty()) {
+		const auto comma = text.find(',');
+		auto part = text.substr(0, comma);
+		while (!part.empty() && part.front() == ' ') {
+			part.remove_prefix(1);
+		}
+		while (!part.empty() && part.back() == ' ') {
+			part.remove_suffix(1);
+		}
+		result.emplace_back(part);
+		if (comma == std::string_view::npos) {
+			break;
+		}
+		text.remove_prefix(comma + 1);
+	}
+	return result;
+}
+
+} // namespace
+
+const char *CapabilityName(Capability capability) {
+	return DefinitionOf(capability).name;
+}
+
+QString GrantText(Capability capability, std::string_view scope) {
+	const auto name = QString::fromLatin1(CapabilityName(capability));
+	return scope.empty()
+		? name
+		: (name + '(' + QString::fromUtf8(scope.data(), int(scope.size())) + ')');
+}
+
+QString ResolveScopeFolder(std::string_view scope) {
+	auto text = QString::fromUtf8(scope.data(), int(scope.size())).trimmed();
+	text.replace('\\', '/');
+	if (text.isEmpty()) {
+		return QString();
+	}
+	const auto slash = text.indexOf('/');
+	const auto head = (slash < 0) ? text : text.left(slash);
+	const auto tail = (slash < 0) ? QString() : text.mid(slash);
+	const auto location = [&]() -> std::optional<QStandardPaths::StandardLocation> {
+		if (head == u"~"_q || head == u"home"_q) {
+			return QStandardPaths::HomeLocation;
+		} else if (head == u"documents"_q) {
+			return QStandardPaths::DocumentsLocation;
+		} else if (head == u"downloads"_q) {
+			return QStandardPaths::DownloadLocation;
+		} else if (head == u"desktop"_q) {
+			return QStandardPaths::DesktopLocation;
+		} else if (head == u"pictures"_q) {
+			return QStandardPaths::PicturesLocation;
+		} else if (head == u"music"_q) {
+			return QStandardPaths::MusicLocation;
+		} else if (head == u"videos"_q) {
+			return QStandardPaths::MoviesLocation;
+		} else if (head == u"temp"_q) {
+			return QStandardPaths::TempLocation;
+		}
+		return std::nullopt;
+	}();
+	auto absolute = QString();
+	if (location) {
+		const auto root = QStandardPaths::writableLocation(*location);
+		if (root.isEmpty()) {
+			return QString();
+		}
+		absolute = root + tail;
+	} else if (QDir::isAbsolutePath(text)) {
+		absolute = text;
+	} else {
+		return QString();
+	}
+	auto clean = QDir::cleanPath(absolute);
+	while (clean.size() > 1 && clean.endsWith('/') && !clean.endsWith(u":/"_q)) {
+		clean.chop(1);
+	}
+	return clean;
+}
+
+bool PathInside(const QString &path, const QString &folder) {
+	if (path.isEmpty() || folder.isEmpty()) {
+		return false;
+	}
+	const auto clean = QDir::cleanPath(QString(path).replace('\\', '/'));
+#ifdef Q_OS_WIN
+	constexpr auto sensitivity = Qt::CaseInsensitive;
+#else
+	constexpr auto sensitivity = Qt::CaseSensitive;
+#endif
+	if (clean.compare(folder, sensitivity) == 0) {
+		return true;
+	}
+	const auto prefix = folder.endsWith('/') ? folder : (folder + '/');
+	return clean.startsWith(prefix, sensitivity);
+}
+
+Tier GrantTier(const Grant &grant) {
+	const auto &definition = DefinitionOf(grant.capability);
+	if (DangerousName(grant.capability, grant.scope)) {
+		return Tier::Dangerous;
+	} else if (grant.capability == Capability::Call && grant.scope.empty()) {
+		return Tier::Caution;
+	} else if ((grant.capability == Capability::FsRead
+		|| grant.capability == Capability::FsWrite)
+		&& grant.scope.empty()) {
+		return Tier::Dangerous;
+	} else if (grant.capability == Capability::AccountWrite
+		&& grant.scope == "gifts") {
+		return Tier::Dangerous;
+	}
+	return definition.tier;
+}
+
+bool IsUpdateName(std::string_view name) {
+	const auto combinator = TlRuntime::BundledSchema().constructor(name);
+	return combinator
+		&& (combinator->type == "Update"
+			|| name == "updateShortMessage"
+			|| name == "updateShortChatMessage"
+			|| name == "updateShortSentMessage");
+}
+
+bool IsGlob(std::string_view pattern) {
+	return !pattern.empty() && pattern.back() == '*';
+}
+
+bool DangerousName(Capability capability, std::string_view name) {
+	return ((capability == Capability::Call)
+			|| (capability == Capability::InterceptRpc))
+		&& !name.empty()
+		&& !IsGlob(name)
+		&& IsDangerousMethod(name);
+}
+
+std::vector<Grant> AccountGrantsFor(std::string_view method) {
+	auto result = std::vector<Grant>();
+	for (const auto &entry : kAccountMethods) {
+		if (entry.method == method) {
+			result.push_back({
+				.capability = entry.capability,
+				.scope = std::string(entry.scope),
+			});
+		}
+	}
+	return result;
+}
+
+bool TakeoverMethod(std::string_view method) {
+	return method.starts_with("auth.")
+		|| ranges::contains(kTakeoverMethods, method);
+}
+
+Permissions Permissions::Parse(
+		const QStringList &list,
+		QString &error,
+		QStringList *warnings) {
+	auto result = Permissions();
+	for (const auto &entry : list) {
+		const auto text = entry.trimmed().toStdString();
+		const auto open = text.find('(');
+		auto name = std::string_view(text).substr(0, open);
+		while (!name.empty() && name.back() == ' ') {
+			name.remove_suffix(1);
+		}
+		const auto i = ranges::find_if(kDefinitions, [&](const Definition &d) {
+			return name == d.name;
+		});
+		if (i == end(kDefinitions)) {
+			if (warnings) {
+				warnings->push_back(u"unknown grant '%1' is ignored"_q.arg(entry));
+			}
+			continue;
+		}
+		auto scopes = std::vector<std::string>();
+		if (open != std::string::npos) {
+			if (text.back() != ')') {
+				error = u"grant '%1' is missing ')'"_q.arg(entry);
+				return Permissions();
+			}
+			scopes = SplitScopes(std::string_view(text).substr(
+				open + 1,
+				text.size() - open - 2));
+			if (scopes.empty()
+				|| ranges::any_of(scopes, &std::string::empty)) {
+				error = u"grant '%1' has an empty scope"_q.arg(entry);
+				return Permissions();
+			} else if (i->kind == ScopeKind::None) {
+				error = u"grant '%1' takes no scopes"_q.arg(entry);
+				return Permissions();
+			}
+		} else {
+			scopes.emplace_back();
+		}
+		for (auto &scope : scopes) {
+			if (scope == "*") {
+				scope.clear();
+			}
+			const auto bad = [&](const QString &what) {
+				error = u"grant '%1': '%2' is not %3"_q.arg(
+					entry,
+					QString::fromStdString(scope),
+					what);
+			};
+			if (!scope.empty()) {
+				switch (i->kind) {
+				case ScopeKind::Method:
+					if (!IsGlob(scope)
+						&& !TlRuntime::BundledSchema().method(scope)) {
+						bad(u"a method"_q);
+						return Permissions();
+					}
+					break;
+				case ScopeKind::Update:
+					if (!IsUpdateName(scope)) {
+						bad(u"an update"_q);
+						return Permissions();
+					}
+					break;
+				case ScopeKind::UpdateOrEvent:
+					if (!IsUpdateName(scope) && !ranges::contains(kEvents, scope)) {
+						bad(u"an update or new_message, edit_message, "
+							"delete_message"_q);
+						return Permissions();
+					}
+					break;
+				case ScopeKind::List:
+					if (!ranges::contains(i->list, scope)) {
+						auto names = QStringList();
+						for (const auto known : i->list) {
+							names.push_back(QString::fromLatin1(
+								known.data(),
+								int(known.size())));
+						}
+						bad(u"one of "_q + names.join(u", "_q));
+						return Permissions();
+					}
+					break;
+				case ScopeKind::Domain:
+					scope = QString::fromStdString(scope).toLower().toStdString();
+					if (!ValidDomain(scope)) {
+						bad(u"a host"_q);
+						return Permissions();
+					}
+					break;
+				case ScopeKind::Path:
+					if (ResolveScopeFolder(scope).isEmpty()) {
+						bad(u"a folder (an absolute path, ~ or documents, "
+							"downloads, desktop, pictures, music, videos, "
+							"home, temp, optionally followed by /sub)"_q);
+						return Permissions();
+					}
+					break;
+				case ScopeKind::None:
+					break;
+				}
+			}
+			auto grant = Grant{ .capability = i->capability, .scope = scope };
+			if (!ranges::contains(result._grants, grant)) {
+				result._grants.push_back(std::move(grant));
+			}
+		}
+	}
+	return result;
+}
+
+bool Permissions::allows(Capability capability, std::string_view name) const {
+	const auto method = (capability == Capability::Call)
+		|| (capability == Capability::InterceptRpc);
+	if (method
+		&& TakeoverMethod(name)
+		&& !any(Capability::DisableApiFiltering)) {
+		return false;
+	}
+	for (const auto &grant : _grants) {
+		if (grant.capability != capability) {
+			continue;
+		}
+		switch (DefinitionOf(capability).kind) {
+		case ScopeKind::Method:
+			if (MethodMatches(capability, grant.scope, name)) {
+				return true;
+			}
+			break;
+		case ScopeKind::Domain:
+			if (HostMatches(grant.scope, name)) {
+				return true;
+			}
+			break;
+		case ScopeKind::Path:
+			if (grant.scope.empty()
+				|| PathInside(
+					QString::fromUtf8(name.data(), int(name.size())),
+					ResolveScopeFolder(grant.scope))) {
+				return true;
+			}
+			break;
+		default:
+			if (grant.scope == name
+				|| (grant.scope.empty()
+					&& !(capability == Capability::AccountWrite
+						&& name == "gifts"))) {
+				return true;
+			}
+			break;
+		}
+	}
+	return false;
+}
+
+bool Permissions::any(Capability capability) const {
+	return ranges::any_of(_grants, [&](const Grant &grant) {
+		return grant.capability == capability;
+	});
+}
+
+bool Permissions::covers(const Permissions &other) const {
+	return ranges::all_of(other._grants, [&](const Grant &narrow) {
+		return ranges::any_of(_grants, [&](const Grant &wide) {
+			return Covers(wide, narrow);
+		});
+	});
+}
+
+bool Permissions::empty() const {
+	return _grants.empty();
+}
+
+QStringList Permissions::strings() const {
+	auto result = QStringList();
+	for (const auto &grant : _grants) {
+		result.push_back(GrantText(grant.capability, grant.scope));
+	}
+	return result;
+}
+
+const std::vector<Grant> &Permissions::grants() const {
+	return _grants;
+}
+
+} // namespace Tele::Scripting
