+			ApplySend(copy, data, replyTo);
+			session->api().sendInlineResult(
+				bot,
+				result,
+				copy,
+				localMessageId,
+				done);
+		},
+		.dropped = [=] {
+			if (done) {
+				done(false);
+			}
+		},
+	}));
+	return true;
+}
