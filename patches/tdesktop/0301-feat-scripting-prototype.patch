+	const auto ctx = _engine->ctx();
+	_unwrap = JS_Eval(
+		ctx,
+		kUnwrap,
+		std::strlen(kUnwrap),
+		"<tele>",
+		JS_EVAL_TYPE_GLOBAL);
+	auto ignored = QString();
+	_permissions = Permissions::Parse({
+		u"call"_q,
+		u"onUpdate"_q,
+		u"interceptRpc"_q,
+		u"interceptUpdate"_q,
+		u"interceptSendMessage"_q,
+		u"account.read"_q,
+		u"account.write"_q,
+		u"fetch"_q,
+		u"clipboard.read"_q,
+		u"clipboard.write"_q,
+		u"openUrl"_q,
+		u"notify"_q,
+	}, ignored);
+	_tg = makeTg();
+	_started = true;
+}
+
+void Instance::evaluate(
+		QString code,
+		Fn<void(bool, QString, QByteArray)> done) {
+	if (!_engine || !_started) {
+		done(false, Lower(u"The script isn't running."_q), {});
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto error = QString();
+	const auto stripped = _engine->transpile(code.toUtf8(), error);
+	if (!stripped) {
+		done(false, error, {});
+		return;
+	}
+	auto global = JS_GetGlobalObject(ctx);
+	JS_SetPropertyStr(ctx, global, "tg", JS_DupValue(ctx, _tg));
+	JS_FreeValue(ctx, global);
+	auto promise = _engine->evaluate(*stripped, kReplBudget);
+	if (JS_IsException(promise)) {
+		auto exception = JS_GetException(ctx);
+		done(false, _engine->describe(exception), Tree(ctx, exception));
+		JS_FreeValue(ctx, exception);
+		return;
+	}
+	const auto key = ++_evaluationKey;
+	_evaluations.emplace(key, std::move(done));
+	auto then = JS_GetPropertyStr(ctx, promise, "then");
+	JSValue handlers[] = {
+		JS_NewCFunctionMagic(
+			ctx,
+			Evaluated,
+			"evaluated",
+			1,
+			JS_CFUNC_generic_magic,
+			key * 2 + 1),
+		JS_NewCFunctionMagic(
+			ctx,
+			Evaluated,
+			"failed",
+			1,
+			JS_CFUNC_generic_magic,
+			key * 2),
+	};
+	JS_FreeValue(ctx, JS_Call(ctx, then, promise, 2, handlers));
+	JS_FreeValue(ctx, handlers[0]);
+	JS_FreeValue(ctx, handlers[1]);
+	JS_FreeValue(ctx, then);
+	JS_FreeValue(ctx, promise);
+	_engine->drain();
+}
+
+JSValue Instance::Evaluated(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_evaluations.find(magic / 2);
+	if (i == end(instance->_evaluations)) {
+		return JS_UNDEFINED;
+	}
+	auto done = std::move(i->second);
+	instance->_evaluations.erase(i);
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		done(false, instance->_engine->describe(value), Tree(ctx, value));
+		return JS_UNDEFINED;
+	}
+	auto result = JS_GetPropertyStr(ctx, value, "value");
+	JSValueConst args[] = { result };
+	auto text = CallGlobal(ctx, "__teleInspect", args);
+	auto tree = Tree(ctx, result);
+	JS_FreeValue(ctx, result);
+	done(true, JS_IsException(text)
+		? u"[unprintable]"_q
+		: FromStd(ToStd(ctx, text)), std::move(tree));
+	JS_FreeValue(ctx, text);
+	return JS_UNDEFINED;
+}
