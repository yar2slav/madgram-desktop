+[[nodiscard]] QString ScopeTitle(
+		Capability capability,
+		std::string_view scope) {
+	if (capability == Capability::AccountWrite && scope == "stories") {
+		return Lower(u"post, edit and delete stories"_q);
+	} else if (capability == Capability::AccountWrite && scope == "gifts") {
+		return Lower(u"transfer, sell, convert and upgrade your gifts"_q);
+	}
+	static const auto titles = std::vector<std::pair<std::string_view, QString>>{
+		{ "self", u"profile"_q },
+		{ "peers", u"chats and contacts"_q },
+		{ "messages", u"messages"_q },
+		{ "dialogs", u"chat list"_q },
+		{ "history", u"chat history"_q },
+		{ "draft", u"drafts"_q },
+		{ "send", u"send messages"_q },
+		{ "edit", u"edit messages"_q },
+		{ "delete", u"delete messages"_q },
+		{ "forward", u"forward messages"_q },
+		{ "react", u"react"_q },
+		{ "read", u"mark chats as read"_q },
+		{ "typing", u"show typing"_q },
+		{ "local", u"messages that were never sent"_q },
+		{ "notify", u"change notification settings"_q },
+		{ "stories", u"stories"_q },
+		{ "gifts", u"gifts"_q },
+	};
+	const auto i = ranges::find(titles, scope, [](const auto &pair) {
+		return pair.first;
+	});
+	return (i != end(titles))
+		? Lower(i->second)
+		: QString::fromUtf8(scope.data(), int(scope.size()));
+}
+
+struct Group {
