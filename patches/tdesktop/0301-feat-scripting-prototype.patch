+					throw new TypeError(`${what}: privacy 'selected' needs users`);
+				}
+				return [{ _: 'inputPrivacyValueAllowUsers', users: list }];
+			};
+
+			const storyFrom = async (result, input, peer, storyId, what) => {
+				const raw = updatesOf(result).find((update) => update._ === 'updateStory'
+					&& update.story._ === 'storyItem'
+					&& (storyId === undefined || update.story.id === storyId))?.story;
+				if (raw) {
+					return storyOf(raw, peer, selfId);
+				} else if (storyId !== undefined) {
+					const story = await get(input, storyId);
+					if (story) {
+						return story;
+					}
+				}
+				throw new TeleError('internal', `the answer to ${what} had no story in it`);
+			};
+
+			const stories = {
+				async list(peer) {
+					const { input, id } = await target(peer);
+					const result = await tg.call({ _: 'stories.getPeerStories', peer: input });
