+} // namespace
+
+void AddChatUiNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "chatuiBanner", NativeChatUi, 3, int(Op::Banner) },
+		{ "chatuiBannerRemove", NativeChatUi, 1, int(Op::BannerRemove) },
+		{ "chatuiSelection", NativeChatUi, 0, int(Op::Selection) },
+		{ "chatuiOnSelection", NativeChatUi, 1, int(Op::OnSelection) },
+		{ "chatuiFocused", NativeChatUi, 0, int(Op::Focused) },
+		{ "chatuiOnFocus", NativeChatUi, 1, int(Op::OnFocus) },
+		{ "chatuiOnComposeState", NativeChatUi, 1, int(Op::OnComposeState) },
+		{ "chatuiOff", NativeChatUi, 1, int(Op::Off) },
+		{ "chatuiComposeState", NativeChatUi, 1, int(Op::ComposeState) },
+		{ "chatuiSetReply", NativeChatUi, 2, int(Op::SetReply) },
+		{ "chatuiAttach", NativeChatUi, 2, int(Op::Attach) },
+		{ "chatuiSendOptions", NativeChatUi, 2, int(Op::SendOptions) },
+		{ "chatuiInterceptPaste", NativeChatUi, 1, int(Op::InterceptPaste) },
+		{ "chatuiAnswer", NativeChatUi, 2, int(Op::Answer) },
+	});
+}
+
+std::string_view ChatUiTypings() {
+	return kTypings;
+}
+
+std::unique_ptr<Ui::RpWidget> MakeChatBanners(
+		not_null<QWidget*> parent,
+		not_null<PeerData*> peer,
+		Fn<void()> relayout) {
+	auto result = std::make_unique<ChatBanners>(
+		parent,
+		peer,
+		std::move(relayout));
+	result->show();
+	return result;
+}
+
+void ReportSelection(
+		not_null<Ui::RpWidget*> source,
+		not_null<Main::Session*> session,
+		PeerData *peer,
+		const std::vector<FullMsgId> &ids) {
+	const auto chat = peer
+		? peer->id
+		: ids.empty()
+		? PeerId()
+		: ids.front().peer;
+	auto list = std::vector<MsgId>();
+	if (chat && !Secret::IsSecretPeerId(chat)) {
+		for (const auto &id : ids) {
+			if (id.peer == chat) {
+				list.push_back(id.msg);
+			}
+		}
+		ranges::sort(list);
+		list.erase(ranges::unique(list), end(list));
+	}
+	auto &entries = Selections();
+	const auto i = ranges::find(entries, source, &SelectionEntry::source);
+	if (list.empty()) {
+		if (i == end(entries)) {
+			return;
+		}
+		entries.erase(i);
+	} else if (i != end(entries) && i->peer == chat && i->ids == list) {
+		return;
+	} else {
+		if (i != end(entries)) {
+			entries.erase(i);
+		}
+		entries.push_back({
+			.source = source,
+			.session = session,
+			.peer = chat,
+			.ids = std::move(list),
+		});
+		if (WatchedSources().emplace(source).second) {
+			source->lifetime().add([=] {
+				WatchedSources().remove(source);
+				auto &remaining = Selections();
+				const auto j = ranges::find(
+					remaining,
+					source,
+					&SelectionEntry::source);
+				if (j != end(remaining)) {
+					remaining.erase(j);
+					SelectionChanges().fire_copy(session);
+				}
+			});
+		}
+	}
+	SelectionChanges().fire_copy(session);
+}
+
+void TrackComposeSurface(
+		not_null<Ui::RpWidget*> owner,
+		not_null<Main::Session*> session,
+		ComposeSurface surface) {
+	auto changes = std::move(surface.changes);
+	Surfaces().push_back(std::make_unique<Surface>(Surface{
+		.owner = owner,
+		.session = session,
+		.data = std::move(surface),
+	}));
+	const auto raw = Surfaces().back().get();
+	owner->lifetime().add([=] {
+		auto &surfaces = Surfaces();
+		surfaces.erase(ranges::remove_if(surfaces, [&](const auto &entry) {
+			return (entry.get() == raw);
+		}), end(surfaces));
+	});
+	rpl::merge(
+		std::move(changes),
+		session->sendAsPeers().updated() | rpl::to_empty,
+		session->changes().peerUpdates(
+			Data::PeerUpdate::Flag::Notifications
+		) | rpl::to_empty
+	) | rpl::on_next([=] {
+		CheckSurface(raw);
+	}, owner->lifetime());
+}
+
+void ComposeSurfaceChanged(not_null<Ui::RpWidget*> owner) {
+	for (const auto &surface : Surfaces()) {
+		if (surface->owner == owner) {
+			CheckSurface(surface.get());
+		}
+	}
+}
+
+Ui::InputField::MimeDataHook WithPasteInterceptor(
+		not_null<Ui::InputField*> field,
+		Fn<PeerData*()> peer,
+		Ui::InputField::MimeDataHook hook) {
+	const auto weak = QPointer<Ui::InputField>(field.get());
+	return [=](
+			not_null<const QMimeData*> data,
+			Ui::InputField::MimeAction action) {
+		const auto current = (action == Ui::InputField::MimeAction::Insert
+			&& !ReplayingPaste
+			&& peer)
+			? peer()
+			: nullptr;
+		if (current
+			&& !Secret::IsSecretPeer(current)
+			&& InterceptsPaste(&current->session())) {
+			const auto session = &current->session();
+			const auto peerId = current->id;
+			auto run = std::make_shared<PasteRun>(PasteRun{
+				.data = PasteDataOf(peerId, data),
+			});
+			for (const auto &entry : Interceptors()) {
+				if (entry.session == session) {
+					run->interceptors.push_back(entry.id);
+				}
+			}
+			const auto copy = CopyMime(data);
+			const auto sessionWeak = base::make_weak(session);
+			run->done = [=](PasteVerdict verdict) {
+				const auto files = (verdict.kind == PasteVerdict::Kind::Files);
+				const auto now = (files || !weak) ? nullptr : peer();
+				if (files || (now && now->id == peerId)) {
+					ApplyPaste(weak, sessionWeak, peerId, copy, std::move(verdict));
+				}
+			};
+			crl::on_main([=] {
+				AskFrom(run, 0);
+			});
+			return true;
+		}
+		return hook ? hook(data, action) : false;
+	};
+}
+
+} // namespace Tele::Scripting
