+void ShowLog(std::shared_ptr<Manager> manager, const QString &id) {
+	const auto state = FindScript(manager->session, id);
+	if (!state) {
+		return;
+	}
+	const auto session = manager->session;
+	manager->show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setWidth(st::boxWideWidth);
+		box->setNoContentMargin(true);
+		box->setTitle(rpl::single(Lower(u"%1: log"_q).arg(state->name)));
+		const auto top = box->setPinnedToTopContent(
+			object_ptr<Ui::VerticalLayout>(box));
+		const auto search = top->add(object_ptr<Ui::MultiSelect>(
+			top,
+			st::defaultMultiSelect,
+			rpl::single(Lower(u"Search the log"_q))));
+		auto tabs = std::vector<Ui::SubTabs::Tab>();
+		for (const auto &[filter, name] : {
+				std::pair{ LevelFilter::All, u"All"_q },
+				std::pair{ LevelFilter::Info, u"Info"_q },
+				std::pair{ LevelFilter::Warnings, u"Warnings"_q },
+				std::pair{ LevelFilter::Errors, u"Errors"_q } }) {
+			tabs.push_back({
+				.id = LevelFilterId(filter),
+				.text = { Lower(name) },
+			});
+		}
+		const auto subtabs = top->add(
+			object_ptr<Ui::SubTabs>(
+				top,
+				st::defaultSubTabs,
+				Ui::SubTabs::Options{
+					.selected = LevelFilterId(LevelFilter::All),
+					.centered = true,
+				},
+				std::move(tabs)),
+			QMargins(
+				0,
+				st::boxRowPadding.left() / 2,
+				0,
+				st::boxRowPadding.left() / 2));
+		const auto height = std::clamp(
+			manager->panel->innerGeometry().height()
+				- style::ConvertScale(320),
+			style::ConvertScale(160),
+			st::boxMaxListHeight);
+		const auto area = box->addRow(
+			object_ptr<Ui::FixedHeightWidget>(box, height),
+			style::margins());
+		const auto scroll = Ui::CreateChild<Ui::ScrollArea>(
+			area,
+			st::boxScroll);
+		const auto view = scroll->setOwnedWidget(object_ptr<LogView>(
+			scroll,
+			manager->show,
+			0));
+		area->sizeValue(
+		) | rpl::on_next([=](QSize size) {
+			scroll->setGeometry(QRect(QPoint(), size));
+			view->resizeToWidth(size.width());
+		}, area->lifetime());
+		struct State {
+			LevelFilter filter = LevelFilter::All;
+			QString query;
+		};
+		const auto shared = std::make_shared<State>();
+		const auto toBottom = [=] {
+			scroll->scrollToY(scroll->scrollTopMax());
+		};
+		const auto apply = [=] {
+			view->setFilter(shared->filter, shared->query);
+			toBottom();
+		};
+		search->setQueryChangedCallback([=](const QString &query) {
+			shared->query = query;
+			apply();
+		});
+		subtabs->activated(
+		) | rpl::on_next([=](const QString &tab) {
+			subtabs->setActiveTab(tab);
+			shared->filter = LevelFilterFromId(tab);
+			apply();
+		}, subtabs->lifetime());
+		view->setLines(ScriptLog(session, id));
+		ScriptLogChanges(
+			session
+		) | rpl::filter([=](const ScriptLogged &logged) {
+			return logged.id == id;
+		}) | rpl::on_next([=](const ScriptLogged &logged) {
+			const auto bottom = (scroll->scrollTop()
+				>= scroll->scrollTopMax() - st::lineWidth * 4);
+			view->append(logged.line);
+			if (bottom) {
+				toBottom();
+			}
+		}, view->lifetime());
+		box->setFocusCallback([=] {
+			search->setInnerFocus();
+		});
+		crl::on_main(view, toBottom);
+		box->addButton(rpl::single(Lower(u"Copy"_q)), [=] {
+			QGuiApplication::clipboard()->setText(view->shownText());
+			Toast(manager, Lower(u"Copied."_q));
+		});
+		box->addButton(rpl::single(Lower(u"Clear"_q)), [=] {
+			ClearScriptLog(session, id);
+			view->setLines({});
+		});
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	}), Ui::LayerOption::KeepOther);
+}
