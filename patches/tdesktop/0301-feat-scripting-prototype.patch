+#include "tele/scripting/tele_script_tl.h"
+
+#include "tele/tele_tl_runtime.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <vector>
+
+namespace Tele::Scripting {
+namespace {
+
+using TlRuntime::Combinator;
+
+constexpr auto kVectorId = std::uint32_t(0x1cb5c415U);
+constexpr auto kBoolTrue = std::uint32_t(0x997275b5U);
+constexpr auto kBoolFalse = std::uint32_t(0xbc799737U);
+constexpr auto kMaxDepth = 64;
+constexpr auto kMaxSafeInteger = 9007199254740991.;
+
+[[nodiscard]] bool IsBareName(std::string_view type) {
+	const auto dot = type.rfind('.');
+	const auto last = (dot == std::string_view::npos)
+		? type
+		: type.substr(dot + 1);
+	return !last.empty() && last.front() >= 'a' && last.front() <= 'z';
+}
+
+[[nodiscard]] bool IsVector(std::string_view type, char first) {
+	return type.size() > 8
+		&& type.front() == first
+		&& type.substr(1, 6) == "ector<"
+		&& type.back() == '>';
+}
+
+[[nodiscard]] std::string_view VectorItem(std::string_view type) {
+	return type.substr(7, type.size() - 8);
+}
+
+[[nodiscard]] bool IsBlob(std::string_view type) {
+	return type == "bytes" || type == "int128" || type == "int256";
+}
+
+[[nodiscard]] std::size_t BlobSize(std::string_view type) {
+	return (type == "int128") ? 16 : (type == "int256") ? 32 : 0;
+}
+
+constexpr auto kServiceUserId = std::int64_t(777000);
+
+[[nodiscard]] bool FromService(JSContext *ctx, JSValueConst peer) {
+	auto user = JS_GetPropertyStr(ctx, peer, "userId");
+	auto id = std::int64_t();
+	const auto result = JS_IsBigInt(user)
+		&& (JS_ToBigInt64(ctx, &id, user) == 0)
+		&& (id == kServiceUserId);
+	JS_FreeValue(ctx, user);
+	return result;
+}
+
+[[nodiscard]] std::string MaskCodes(std::string_view text) {
+	auto result = std::string();
+	result.reserve(text.size());
+	for (auto i = std::size_t(); i != text.size();) {
+		auto j = i;
+		while (j != text.size() && text[j] >= '0' && text[j] <= '9') {
+			++j;
+		}
+		if (j - i >= 5) {
+			result.append(j - i, '*');
+			i = j;
+		} else if (j != i) {
+			result.append(text.substr(i, j - i));
+			i = j;
+		} else {
+			result += text[i++];
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::string ToStdText(JSContext *ctx, JSValueConst value) {
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(ctx, &size, value);
+	auto result = text ? std::string(text, size) : std::string();
+	if (text) {
+		JS_FreeCString(ctx, text);
+	}
+	return result;
+}
+
+class Reader final {
+public:
+	Reader(JSContext *ctx, std::string_view data, DecodeFilter filter);
+
+	[[nodiscard]] JSValue value(std::string_view type, int depth);
+	[[nodiscard]] bool failed() const;
+	[[nodiscard]] std::string error() const;
+	[[nodiscard]] bool filtered() const {
+		return _filtered;
+	}
+	[[nodiscard]] std::size_t offset() const;
+
+private:
+	[[nodiscard]] JSValue fail(std::string text);
+	[[nodiscard]] bool has(std::size_t count) const;
+	[[nodiscard]] std::uint32_t get32();
+	[[nodiscard]] std::uint64_t get64();
+	[[nodiscard]] bool bytes(std::string_view &result);
+	[[nodiscard]] JSValue object(const Combinator &combinator, int depth);
+	[[nodiscard]] JSValue vector(
+		std::string_view item,
+		bool boxed,
+		int depth);
+	[[nodiscard]] JSValue scalar(std::string_view type);
+
+	JSContext *_ctx = nullptr;
+	const std::string_view _data;
+	const DecodeFilter _filter;
+	std::size_t _offset = 0;
+	std::string _error;
+	bool _filtered = false;
+
+};
+
+Reader::Reader(JSContext *ctx, std::string_view data, DecodeFilter filter)
+: _ctx(ctx)
+, _data(data)
+, _filter(filter) {
+}
+
+bool Reader::failed() const {
+	return !_error.empty();
+}
+
+std::string Reader::error() const {
+	return _error;
+}
+
+std::size_t Reader::offset() const {
+	return _offset;
+}
+
+JSValue Reader::fail(std::string text) {
+	if (_error.empty()) {
+		_error = text + " at byte " + std::to_string(_offset);
+	}
+	return JS_UNDEFINED;
+}
+
+bool Reader::has(std::size_t count) const {
+	return (_data.size() - _offset) >= count;
+}
+
+std::uint32_t Reader::get32() {
+	auto result = std::uint32_t();
+	for (auto i = 0; i != 4; ++i) {
+		result |= std::uint32_t(
+			static_cast<unsigned char>(_data[_offset + i])) << (8 * i);
+	}
+	_offset += 4;
+	return result;
+}
+
+std::uint64_t Reader::get64() {
+	const auto low = get32();
+	const auto high = get32();
+	return (std::uint64_t(high) << 32) | low;
+}
+
+bool Reader::bytes(std::string_view &result) {
+	if (!has(4)) {
+		return false;
+	}
+	auto size = std::size_t(static_cast<unsigned char>(_data[_offset]));
+	auto header = std::size_t(1);
+	if (size == 254) {
+		header = 4;
+		const auto byte = [&](int index) {
+			return std::size_t(
+				static_cast<unsigned char>(_data[_offset + index]));
+		};
+		size = byte(1) | (byte(2) << 8) | (byte(3) << 16);
+	} else if (size == 255) {
+		return false;
+	}
+	const auto padded = ((header + size + 3) / 4) * 4;
+	if (!has(padded)) {
+		return false;
+	}
+	result = _data.substr(_offset + header, size);
+	_offset += padded;
+	return true;
+}
+
+JSValue Reader::value(std::string_view type, int depth) {
+	if (depth > kMaxDepth) {
+		return fail("nested too deep");
+	} else if (type == "int"
+		|| type == "long"
+		|| type == "double"
+		|| type == "string"
+		|| IsBlob(type)) {
+		return scalar(type);
+	} else if (type == "Bool") {
+		if (!has(4)) {
+			return fail("ended early");
+		}
+		const auto id = get32();
+		if (id != kBoolTrue && id != kBoolFalse) {
+			return fail("expected Bool");
+		}
+		return JS_NewBool(_ctx, id == kBoolTrue);
+	} else if (IsVector(type, 'V')) {
+		return vector(VectorItem(type), true, depth);
+	} else if (IsVector(type, 'v')) {
+		return vector(VectorItem(type), false, depth);
+	} else if (type.starts_with('%')) {
+		const auto list = Schema().constructorsOf(type.substr(1));
+		if (list.size() != 1) {
+			return fail("can't read bare " + std::string(type.substr(1)));
+		}
+		return object(*list.front(), depth);
+	} else if (IsBareName(type)) {
+		const auto combinator = Schema().constructor(type);
+		if (!combinator) {
+			return fail(std::string(type) + " is not in the schema");
+		}
+		return object(*combinator, depth);
+	}
+	if (!has(4)) {
+		return fail("ended early");
+	}
+	const auto id = get32();
+	const auto combinator = CombinatorById(id);
+	if (!combinator) {
+		_offset -= 4;
+		char hex[16];
+		std::snprintf(hex, sizeof(hex), "0x%08x", unsigned(id));
+		return fail(std::string("unknown constructor ") + hex);
+	}
+	return object(*combinator, depth);
+}
+
+JSValue Reader::object(const Combinator &combinator, int depth) {
+	auto result = JS_NewObject(_ctx);
+	JS_SetPropertyStr(
+		_ctx,
+		result,
+		"_",
+		JS_NewStringLen(
+			_ctx,
+			combinator.name.data(),
+			combinator.name.size()));
+	auto flags = std::map<std::string, std::uint32_t, std::less<>>();
+	const auto message = _filter.sensitive && (combinator.name == "message");
+	const auto config = _filter.sensitive && (combinator.name == "config");
+	const auto draft = _filter.drafts
+		&& (combinator.name == "draftMessage");
+	auto service = false;
+	for (const auto &param : combinator.params) {
+		const auto name = CamelCase(param.name);
+		if (param.flagBit >= 0) {
+			const auto i = flags.find(param.flagField);
+			const auto set = (i != end(flags))
+				&& param.flagBit < 32
+				&& ((i->second >> param.flagBit) & 1U);
+			if (!set) {
+				if (param.type == "true") {
+					JS_SetPropertyStr(
+						_ctx,
+						result,
+						name.c_str(),
+						JS_FALSE);
+				}
+				continue;
+			}
+		}
+		if (param.type == "#") {
+			if (!has(4)) {
+				JS_FreeValue(_ctx, result);
+				return fail("ended early");
+			}
+			flags[param.name] = get32();
+			continue;
+		} else if (param.type == "true") {
+			JS_SetPropertyStr(_ctx, result, name.c_str(), JS_TRUE);
+			continue;
+		}
+		auto field = value(
+			param.type.starts_with('!')
+				? std::string_view("Object")
+				: std::string_view(param.type),
+			depth + 1);
+		if (failed()) {
+			JS_FreeValue(_ctx, field);
+			JS_FreeValue(_ctx, result);
+			_error = combinator.name + '.' + name + ": " + _error;
+			return JS_UNDEFINED;
+		}
+		if (message && (name == "fromId" || name == "peerId")) {
+			service = service || FromService(_ctx, field);
+		} else if (message && service && name == "message") {
+			const auto text = ToStdText(_ctx, field);
+			JS_FreeValue(_ctx, field);
+			const auto masked = MaskCodes(text);
+			_filtered = _filtered || (masked != text);
+			field = JS_NewStringLen(_ctx, masked.data(), masked.size());
+		} else if ((config && name == "autologinToken")
+			|| (draft && name == "entities")) {
+			JS_FreeValue(_ctx, field);
+			_filtered = true;
+			continue;
+		} else if (draft && name == "message") {
+			JS_FreeValue(_ctx, field);
+			_filtered = true;
+			field = JS_NewString(_ctx, "");
+		}
+		JS_SetPropertyStr(_ctx, result, name.c_str(), field);
+	}
+	return result;
+}
+
+JSValue Reader::vector(std::string_view item, bool boxed, int depth) {
+	if (boxed) {
+		if (!has(4)) {
+			return fail("ended early");
+		} else if (get32() != kVectorId) {
+			_offset -= 4;
+			return fail("expected a vector");
+		}
+	}
+	if (!has(4)) {
+		return fail("ended early");
+	}
+	const auto count = get32();
+	if (count > (_data.size() - _offset) / 4 + 1) {
+		return fail("bad vector size " + std::to_string(count));
+	}
+	auto result = JS_NewArray(_ctx);
+	for (auto i = std::uint32_t(); i != count; ++i) {
+		auto element = value(item, depth + 1);
+		if (failed()) {
+			JS_FreeValue(_ctx, element);
+			JS_FreeValue(_ctx, result);
+			return JS_UNDEFINED;
+		}
+		JS_SetPropertyUint32(_ctx, result, i, element);
+	}
+	return result;
+}
+
+JSValue Reader::scalar(std::string_view type) {
+	if (type == "string" || type == "bytes") {
+		auto data = std::string_view();
+		if (!bytes(data)) {
+			return fail("bad " + std::string(type));
+		} else if (type == "string") {
+			return JS_NewStringLen(_ctx, data.data(), data.size());
+		}
+		return JS_NewUint8ArrayCopy(
+			_ctx,
+			reinterpret_cast<const uint8_t*>(data.data()),
+			data.size());
+	}
+	const auto size = (type == "int") ? std::size_t(4)
+		: IsBlob(type) ? BlobSize(type)
+		: std::size_t(8);
+	if (!has(size)) {
+		return fail("ended early");
+	}
+	if (type == "int") {
+		return JS_NewInt32(_ctx, std::int32_t(get32()));
+	} else if (type == "long") {
+		return JS_NewBigInt64(_ctx, std::int64_t(get64()));
+	} else if (type == "double") {
+		const auto bits = get64();
+		auto result = 0.;
+		std::memcpy(&result, &bits, sizeof(result));
+		return JS_NewFloat64(_ctx, result);
+	}
+	const auto data = _data.substr(_offset, size);
+	_offset += size;
+	return JS_NewUint8ArrayCopy(
+		_ctx,
+		reinterpret_cast<const uint8_t*>(data.data()),
+		data.size());
+}
+
+class Walker final {
+public:
+	Walker(std::string_view data, const ObjectFound &found);
+
+	[[nodiscard]] bool value(std::string_view type, int depth);
+
+private:
+	[[nodiscard]] bool has(std::size_t count) const;
+	[[nodiscard]] std::uint32_t get32();
+	[[nodiscard]] bool skip(std::size_t count);
+	[[nodiscard]] bool bytes();
+	[[nodiscard]] bool object(const Combinator &combinator, int depth);
+	[[nodiscard]] bool vector(std::string_view item, bool boxed, int depth);
+
+	const std::string_view _data;
+	const ObjectFound &_found;
+	std::size_t _offset = 0;
+
+};
+
+Walker::Walker(std::string_view data, const ObjectFound &found)
+: _data(data)
+, _found(found) {
+}
+
+bool Walker::has(std::size_t count) const {
+	return (_data.size() - _offset) >= count;
+}
+
+std::uint32_t Walker::get32() {
+	auto result = std::uint32_t();
+	for (auto i = 0; i != 4; ++i) {
+		result |= std::uint32_t(
+			static_cast<unsigned char>(_data[_offset + i])) << (8 * i);
+	}
+	_offset += 4;
+	return result;
+}
+
+bool Walker::skip(std::size_t count) {
+	if (!has(count)) {
+		return false;
+	}
+	_offset += count;
+	return true;
+}
+
+bool Walker::bytes() {
+	if (!has(4)) {
+		return false;
+	}
+	auto size = std::size_t(static_cast<unsigned char>(_data[_offset]));
+	auto header = std::size_t(1);
+	if (size == 254) {
+		header = 4;
+		const auto byte = [&](int index) {
+			return std::size_t(
+				static_cast<unsigned char>(_data[_offset + index]));
+		};
+		size = byte(1) | (byte(2) << 8) | (byte(3) << 16);
+	} else if (size == 255) {
+		return false;
+	}
+	return skip(((header + size + 3) / 4) * 4);
+}
+
+bool Walker::value(std::string_view type, int depth) {
+	if (depth > kMaxDepth) {
+		return false;
+	} else if (type == "int") {
+		return skip(4);
+	} else if (type == "long" || type == "double") {
+		return skip(8);
+	} else if (type == "int128" || type == "int256") {
+		return skip(BlobSize(type));
+	} else if (type == "string" || type == "bytes") {
+		return bytes();
+	} else if (type == "Bool") {
+		return skip(4);
+	} else if (IsVector(type, 'V')) {
+		return vector(VectorItem(type), true, depth);
+	} else if (IsVector(type, 'v')) {
+		return vector(VectorItem(type), false, depth);
+	} else if (type.starts_with('%')) {
+		const auto list = Schema().constructorsOf(type.substr(1));
+		return (list.size() == 1) && object(*list.front(), depth);
+	} else if (IsBareName(type)) {
+		const auto combinator = Schema().constructor(type);
+		return combinator && object(*combinator, depth);
+	}
+	if (!has(4)) {
+		return false;
+	}
+	const auto start = _offset;
+	const auto combinator = CombinatorById(get32());
+	if (!combinator || !object(*combinator, depth)) {
+		return false;
+	}
+	if (combinator->type == "User" || combinator->type == "Chat") {
+		_found(combinator->type, _data.substr(start, _offset - start));
+	}
+	return true;
+}
+
+bool Walker::object(const Combinator &combinator, int depth) {
+	auto flags = std::map<std::string, std::uint32_t, std::less<>>();
+	for (const auto &param : combinator.params) {
+		if (param.flagBit >= 0) {
+			const auto i = flags.find(param.flagField);
+			const auto set = (i != end(flags))
+				&& param.flagBit < 32
+				&& ((i->second >> param.flagBit) & 1U);
+			if (!set) {
+				continue;
+			}
+		}
+		if (param.type == "#") {
+			if (!has(4)) {
+				return false;
+			}
+			flags[param.name] = get32();
+		} else if (param.type != "true"
+			&& !value(
+				param.type.starts_with('!')
+					? std::string_view("Object")
+					: std::string_view(param.type),
+				depth + 1)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool Walker::vector(std::string_view item, bool boxed, int depth) {
+	if (boxed) {
+		if (!has(4) || get32() != kVectorId) {
+			return false;
+		}
+	}
+	if (!has(4)) {
+		return false;
+	}
+	const auto count = get32();
+	if (count > (_data.size() - _offset) / 4 + 1) {
+		return false;
+	}
+	for (auto i = std::uint32_t(); i != count; ++i) {
+		if (!value(item, depth + 1)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+class Writer final {
+public:
+	explicit Writer(JSContext *ctx);
+
+	[[nodiscard]] bool method(
+		JSValueConst value,
+		std::string &name,
+		std::string &resultType);
+	[[nodiscard]] bool value(
+		JSValueConst value,
+		std::string_view type,
+		int depth);
+	[[nodiscard]] std::string take();
+	[[nodiscard]] std::string error() const;
+
+private:
+	[[nodiscard]] bool fail(std::string text);
+	[[nodiscard]] std::string path() const;
+	[[nodiscard]] std::string constructorName(JSValueConst value);
+	[[nodiscard]] bool object(
+		JSValueConst value,
+		const Combinator &combinator,
+		bool boxed,
+		int depth);
+	[[nodiscard]] bool vector(
+		JSValueConst value,
+		std::string_view item,
+		bool boxed,
+		int depth);
+	[[nodiscard]] bool scalar(JSValueConst value, std::string_view type);
+	void put32(std::uint32_t value);
+	void put64(std::uint64_t value);
+	void putBytes(std::string_view data);
+
+	JSContext *_ctx = nullptr;
+	std::string _out;
+	std::vector<std::string> _path;
+	std::string _error;
+
+};
+
+Writer::Writer(JSContext *ctx)
+: _ctx(ctx) {
+}
+
+std::string Writer::take() {
+	return std::move(_out);
+}
+
+std::string Writer::error() const {
+	return _error;
+}
+
+bool Writer::fail(std::string text) {
+	if (_error.empty()) {
+		const auto where = path();
+		_error = where.empty() ? text : (where + ": " + text);
+	}
+	return false;
+}
+
+std::string Writer::path() const {
+	auto result = std::string();
+	for (const auto &part : _path) {
+		if (!result.empty() && !part.starts_with('[')) {
+			result += '.';
+		}
+		result += part;
+	}
+	return result;
+}
+
+void Writer::put32(std::uint32_t value) {
+	for (auto i = 0; i != 4; ++i) {
+		_out += char((value >> (8 * i)) & 0xFF);
+	}
+}
+
+void Writer::put64(std::uint64_t value) {
+	put32(std::uint32_t(value & 0xFFFFFFFFULL));
+	put32(std::uint32_t(value >> 32));
+}
+
+void Writer::putBytes(std::string_view data) {
+	const auto size = data.size();
+	auto header = std::size_t(1);
+	if (size < 254) {
+		_out += char(size);
+	} else {
+		header = 4;
+		_out += char(254);
+		_out += char(size & 0xFF);
+		_out += char((size >> 8) & 0xFF);
+		_out += char((size >> 16) & 0xFF);
+	}
+	_out.append(data.data(), data.size());
+	while ((header + size) % 4) {
+		_out += char(0);
+		++header;
+	}
+}
+
+std::string Writer::constructorName(JSValueConst value) {
+	if (!JS_IsObject(value)) {
+		return std::string();
+	}
+	auto name = JS_GetPropertyStr(_ctx, value, "_");
+	auto result = std::string();
+	if (JS_IsString(name)) {
+		auto size = std::size_t();
+		if (const auto text = JS_ToCStringLen(_ctx, &size, name)) {
+			result.assign(text, size);
+			JS_FreeCString(_ctx, text);
+		}
+	}
+	JS_FreeValue(_ctx, name);
+	return result;
+}
+
+bool Writer::method(
+		JSValueConst value,
+		std::string &name,
+		std::string &resultType) {
+	name = constructorName(value);
+	if (name.empty()) {
+		return fail("a request needs a _ with the method name");
+	}
+	const auto combinator = Schema().method(name);
+	if (!combinator) {
+		return fail(name + " is not a method in the schema");
+	}
+	resultType = combinator->type;
+	_path.push_back(name);
+	const auto result = object(value, *combinator, true, 0);
+	_path.pop_back();
+	return result;
+}
+
+bool Writer::value(JSValueConst value, std::string_view type, int depth) {
+	if (depth > kMaxDepth) {
+		return fail("nested too deep");
+	} else if (type == "int"
+		|| type == "long"
+		|| type == "double"
+		|| type == "string"
+		|| IsBlob(type)) {
+		return scalar(value, type);
+	} else if (type == "Bool") {
+		if (!JS_IsBool(value)) {
+			return fail("expected a boolean");
+		}
+		put32(JS_ToBool(_ctx, value) ? kBoolTrue : kBoolFalse);
+		return true;
+	} else if (IsVector(type, 'V')) {
+		return vector(value, VectorItem(type), true, depth);
+	} else if (IsVector(type, 'v')) {
+		return vector(value, VectorItem(type), false, depth);
+	}
+	const auto bare = type.starts_with('%') || IsBareName(type);
+	const auto name = constructorName(value);
+	if (name.empty()) {
+		return fail("expected an object with _ ("
+			+ std::string(type)
+			+ ")");
+	}
+	if (const auto method = Schema().method(name)
+		; method && type == "Object") {
+		_path.push_back(name);
+		const auto result = object(value, *method, true, depth);
+		_path.pop_back();
+		return result;
+	}
+	const auto combinator = Schema().constructor(name);
+	if (!combinator) {
+		return fail(name + " is not in the schema");
+	}
+	const auto expected = type.starts_with('%') ? type.substr(1) : type;
+	if (type != "Object"
+		&& !bare
+		&& combinator->type != expected) {
+		return fail(name + " is a " + combinator->type
+			+ ", not a " + std::string(expected));
+	}
+	return object(value, *combinator, !bare, depth);
+}
+
+bool Writer::object(
+		JSValueConst value,
+		const Combinator &combinator,
+		bool boxed,
+		int depth) {
+	if (boxed) {
+		put32(combinator.id);
+	}
+	struct Field {
+		const TlRuntime::Param *param = nullptr;
+		JSValue value = JS_UNDEFINED;
+		bool present = false;
+	};
+	auto fields = std::vector<Field>();
+	fields.reserve(combinator.params.size());
+	auto flags = std::map<std::string, std::uint32_t, std::less<>>();
+	for (const auto &param : combinator.params) {
+		auto field = Field{ .param = &param };
+		if (param.type != "#") {
+			field.value = JS_GetPropertyStr(
+				_ctx,
+				value,
+				CamelCase(param.name).c_str());
+			field.present = (param.type == "true")
+				? (JS_ToBool(_ctx, field.value) > 0)
+				: !(JS_IsUndefined(field.value) || JS_IsNull(field.value));
+			if (param.flagBit >= 0 && field.present && param.flagBit < 32) {
+				flags[param.flagField] |= (1U << param.flagBit);
+			}
+		}
+		fields.push_back(field);
+	}
+	const auto release = [&] {
+		for (auto &field : fields) {
+			JS_FreeValue(_ctx, field.value);
+		}
+	};
+	for (auto &field : fields) {
+		const auto &param = *field.param;
+		if (param.type == "#") {
+			put32(flags[param.name]);
+			continue;
+		} else if (param.type == "true") {
+			continue;
+		} else if (param.flagBit >= 0 && !field.present) {
+			continue;
+		} else if (!field.present) {
+			_path.push_back(CamelCase(param.name));
+			fail("is required");
+			_path.pop_back();
+			release();
+			return false;
+		}
+		_path.push_back(CamelCase(param.name));
+		const auto ok = this->value(
+			field.value,
+			param.type.starts_with('!')
+				? std::string_view("Object")
+				: std::string_view(param.type),
+			depth + 1);
+		_path.pop_back();
+		if (!ok) {
+			release();
+			return false;
+		}
+	}
+	release();
+	return true;
+}
+
+bool Writer::vector(
+		JSValueConst value,
+		std::string_view item,
+		bool boxed,
+		int depth) {
+	if (!JS_IsArray(value)) {
+		return fail("expected an array");
+	}
+	auto length = std::int64_t();
+	if (JS_GetLength(_ctx, value, &length) < 0 || length > 0x7FFFFFFF) {
+		return fail("bad array");
+	}
+	if (boxed) {
+		put32(kVectorId);
+	}
+	put32(std::uint32_t(length));
+	for (auto i = std::int64_t(); i != length; ++i) {
+		auto element = JS_GetPropertyUint32(_ctx, value, std::uint32_t(i));
+		_path.push_back('[' + std::to_string(i) + ']');
+		const auto ok = this->value(element, item, depth + 1);
+		_path.pop_back();
+		JS_FreeValue(_ctx, element);
+		if (!ok) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool Writer::scalar(JSValueConst value, std::string_view type) {
+	if (type == "int") {
+		if (JS_IsBigInt(value)) {
+			auto result = std::int64_t();
+			JS_ToBigInt64(_ctx, &result, value);
+			if (result < INT32_MIN || result > INT32_MAX) {
+				return fail("doesn't fit an int");
+			}
+			put32(std::uint32_t(std::int32_t(result)));
+			return true;
+		} else if (!JS_IsNumber(value)) {
+			return fail("expected a number");
+		}
+		auto number = 0.;
+		JS_ToFloat64(_ctx, &number, value);
+		if (number != std::floor(number)
+			|| number < double(INT32_MIN)
+			|| number > double(UINT32_MAX)) {
+			return fail("expected a 32-bit integer");
+		}
+		put32(std::uint32_t(std::int64_t(number)));
+		return true;
+	} else if (type == "long") {
+		auto result = std::int64_t();
+		if (JS_IsBigInt(value)) {
+			JS_ToBigInt64(_ctx, &result, value);
+		} else if (JS_IsNumber(value)) {
+			auto number = 0.;
+			JS_ToFloat64(_ctx, &number, value);
+			if (number != std::floor(number)
+				|| std::fabs(number) > kMaxSafeInteger) {
+				return fail("expected a bigint");
+			}
+			result = std::int64_t(number);
+		} else {
+			return fail("expected a bigint");
+		}
+		put64(std::uint64_t(result));
+		return true;
+	} else if (type == "double") {
+		if (!JS_IsNumber(value)) {
+			return fail("expected a number");
+		}
+		auto number = 0.;
+		JS_ToFloat64(_ctx, &number, value);
+		auto bits = std::uint64_t();
+		std::memcpy(&bits, &number, sizeof(bits));
+		put64(bits);
+		return true;
+	} else if (type == "string" || (type == "bytes" && JS_IsString(value))) {
+		if (!JS_IsString(value)) {
+			return fail("expected a string");
+		}
+		auto size = std::size_t();
+		const auto text = JS_ToCStringLen(_ctx, &size, value);
+		if (!text) {
+			return fail("bad string");
+		}
+		putBytes(std::string_view(text, size));
+		JS_FreeCString(_ctx, text);
+		return true;
+	}
+	if (JS_GetTypedArrayType(value) != JS_TYPED_ARRAY_UINT8) {
+		return fail("expected a Uint8Array");
+	}
+	auto size = std::size_t();
+	const auto data = JS_GetUint8Array(_ctx, &size, value);
+	if (!data) {
+		return fail("bad Uint8Array");
+	}
+	const auto view = std::string_view(
+		reinterpret_cast<const char*>(data),
+		size);
+	if (type == "bytes") {
+		putBytes(view);
+		return true;
+	} else if (size != BlobSize(type)) {
+		return fail("expected "
+			+ std::to_string(BlobSize(type))
+			+ " bytes");
+	}
+	_out.append(view.data(), view.size());
+	return true;
+}
+
+} // namespace
+
+const TlRuntime::Schema &Schema() {
+	return TlRuntime::BundledSchema();
+}
+
+std::string CamelCase(std::string_view name) {
+	static auto cache = std::map<std::string, std::string, std::less<>>();
+	if (const auto i = cache.find(name); i != end(cache)) {
+		return i->second;
+	}
+	auto result = std::string();
+	result.reserve(name.size());
+	auto upper = false;
+	for (const auto ch : name) {
+		if (ch == '_' && !result.empty()) {
+			upper = true;
+		} else if (upper && ch >= 'a' && ch <= 'z') {
+			result += char(ch - 'a' + 'A');
+			upper = false;
+		} else {
+			result += ch;
+			upper = false;
+		}
+	}
+	cache.emplace(std::string(name), result);
+	return result;
+}
+
+const TlRuntime::Combinator *CombinatorById(std::uint32_t id) {
+	if (const auto result = Schema().constructor(id)) {
+		return result;
+	}
+	return Schema().method(id);
+}
+
+std::uint32_t LeadingId(std::string_view bytes) {
+	if (bytes.size() < 4) {
+		return 0;
+	}
+	auto result = std::uint32_t();
+	for (auto i = 0; i != 4; ++i) {
+		result |= std::uint32_t(
+			static_cast<unsigned char>(bytes[i])) << (8 * i);
+	}
+	return result;
+}
+
+std::string EncodeRpcError(int code, std::string_view type) {
+	auto result = std::string();
+	const auto put32 = [&](std::uint32_t value) {
+		for (auto i = 0; i != 4; ++i) {
+			result += char((value >> (8 * i)) & 0xFF);
+		}
+	};
+	put32(0x2144ca19U);
+	put32(std::uint32_t(code));
+	const auto size = type.size();
+	if (size < 254) {
+		result += char(size);
+	} else {
+		result += char(254);
+		result += char(size & 0xFF);
+		result += char((size >> 8) & 0xFF);
+		result += char((size >> 16) & 0xFF);
+	}
+	result.append(type.data(), size);
+	while (result.size() % 4) {
+		result += char(0);
+	}
+	return result;
+}
+
+bool ForEachObject(
+		std::string_view bytes,
+		std::string_view type,
+		const ObjectFound &found) {
+	auto walker = Walker(bytes, found);
+	return walker.value(type, 0);
+}
+
+Decoded DecodeTl(
+		JSContext *ctx,
+		std::string_view bytes,
+		std::string_view type,
+		DecodeFilter filter) {
+	auto reader = Reader(ctx, bytes, filter);
+	auto value = reader.value(type, 0);
+	if (reader.failed()) {
+		JS_FreeValue(ctx, value);
+		return { .error = reader.error() };
+	}
+	return { .value = value, .filtered = reader.filtered() };
+}
+
+Encoded EncodeMethod(JSContext *ctx, JSValueConst value) {
+	auto writer = Writer(ctx);
+	auto result = Encoded();
+	if (!writer.method(value, result.method, result.resultType)) {
+		result.error = writer.error();
+		return result;
+	}
+	result.bytes = writer.take();
+	return result;
+}
+
+Encoded EncodeTl(JSContext *ctx, JSValueConst value, std::string_view type) {
+	auto writer = Writer(ctx);
+	auto result = Encoded();
+	if (!writer.value(value, type, 0)) {
+		result.error = writer.error();
+		return result;
+	}
+	result.bytes = writer.take();
+	return result;
+}
+
+} // namespace Tele::Scripting
