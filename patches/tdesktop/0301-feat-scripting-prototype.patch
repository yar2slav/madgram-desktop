+
+void Instance::interceptDrop(DropData data, Fn<void(bool)> done) {
+	if (!_engine) {
+		done(true);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto payload = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(data.peer)));
+	auto files = JS_NewArray(ctx);
+	for (auto i = 0; i != int(data.files.size()); ++i) {
+		const auto &file = data.files[i];
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, item, "name", NewString(ctx, file.name));
+		JS_SetPropertyStr(ctx, item, "path", NewString(ctx, file.path));
+		JS_SetPropertyStr(ctx, item, "size", JS_NewInt64(ctx, file.size));
+		JS_SetPropertyUint32(ctx, files, std::uint32_t(i), item);
+	}
+	JS_SetPropertyStr(ctx, payload, "files", files);
+	auto urls = JS_NewArray(ctx);
+	for (auto i = 0; i != int(data.urls.size()); ++i) {
+		JS_SetPropertyUint32(
+			ctx,
+			urls,
+			std::uint32_t(i),
+			NewString(ctx, data.urls[i]));
+	}
+	JS_SetPropertyStr(ctx, payload, "urls", urls);
+	JS_SetPropertyStr(ctx, payload, "text", NewString(ctx, data.text));
+	JS_SetPropertyStr(ctx, payload, "image", JS_NewBool(ctx, data.image));
+	runGate(
+		Kind::Drop,
+		"__teleRunDrops",
+		payload,
+		u"interceptDrop"_q,
+		u"accept"_q,
+		[=](std::optional<QString> result) { done(result.has_value()); });
+}
