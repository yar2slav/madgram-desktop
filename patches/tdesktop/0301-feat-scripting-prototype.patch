+
+QString ScriptInstallTarget(const QString &fileName) {
+	const auto name = QFileInfo(fileName).fileName();
+	const auto lower = name.toLower();
+	if (name.isEmpty()
+		|| name.startsWith('.')
+		|| !(lower.endsWith(u".ts"_q) || lower.endsWith(u".js"_q))) {
+		return QString();
+	}
+	return QDir(ScriptsFolder()).absoluteFilePath(name);
+}
+
+QString InstallScript(const QString &fileName, const QByteArray &content) {
+	const auto target = ScriptInstallTarget(fileName);
+	if (target.isEmpty()) {
+		return Lower(u"A script is a .ts or .js file."_q);
+	}
+	PrepareScriptsFolder();
+	auto file = QFile(target);
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)
+		|| file.write(content) != content.size()) {
+		return Lower(u"Can't write %1."_q).arg(
+			QDir::toNativeSeparators(target));
+	}
+	return QString();
+}
+
+QString UpdateScript(const QString &id, const QByteArray &content) {
+	const auto target = ScriptInstallTarget(id);
+	if (target.isEmpty() || !QFileInfo(target).isFile()) {
+		return Lower(u"This script is already gone."_q);
+	}
+	QFile::moveToTrash(target);
+	auto file = QFile(target);
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)
+		|| file.write(content) != content.size()) {
+		return Lower(u"Can't write %1."_q).arg(
+			QDir::toNativeSeparators(target));
+	}
+	return QString();
+}
+
+ScriptPeek PeekScriptContent(const QByteArray &content) {
+	auto peeked = PeekText(content);
+	return {
+		.name = std::move(peeked.name),
+		.version = std::move(peeked.meta.version),
+		.grants = std::move(peeked.grants),
+	};
+}
+
+bool NewerScriptVersion(const QString &current, const QString &candidate) {
+	if (candidate.trimmed().isEmpty()) {
+		return false;
+	}
+	const auto was = ParseVersion(current);
+	const auto now = ParseVersion(candidate);
+	return (was && now)
+		? (CompareVersions(*was, *now) < 0)
+		: (candidate.trimmed() != current.trimmed());
+}
+
+void DownloadScript(
+		const QUrl &url,
+		const QString &etag,
+		qint64 limit,
+		Fn<void(ScriptDownload)> done) {
+	if (const auto updates = UpdatesInstance().lock()) {
+		Fetch(updates->network(), url, etag, limit, std::move(done));
+	} else {
+		done({ .error = Lower(u"Scripts aren't available."_q) });
+	}
+}
+
+QString ScriptSource(const QString &id) {
+	const auto &sources = Folder().sources;
+	const auto i = sources.find(id);
+	return (i != end(sources)) ? i->second.url : QString();
+}
+
+void SetScriptSource(
+		const QString &id,
+		const QString &url,
+		const QString &etag,
+		const QString &version) {
+	auto &settings = Folder();
+	const auto i = settings.sources.find(id);
+	if (url.isEmpty()) {
+		if (i == end(settings.sources)) {
+			return;
+		}
+		settings.sources.erase(i);
+	} else if (id.isEmpty() || id.size() > kMaxIdLength) {
+		return;
+	} else {
+		settings.sources[id] = SourceSetting{
+			.url = url,
+			.etag = etag,
+			.latest = version,
+		};
+	}
+	WriteSettings();
+	settings.sourcesChanged.fire({});
+}
+
+void CheckScriptUpdates(const QString &id, Fn<void(QString)> done) {
+	if (const auto updates = UpdatesInstance().lock()) {
+		updates->check(id, std::move(done));
+	} else if (done) {
+		done(Lower(u"Scripts aren't available."_q));
+	}
+}
+
+QString RemoveScript(not_null<Main::Session*> session, const QString &id) {
+	const auto host = Host::Find(session);
+	return host
+		? host->remove(id)
+		: Lower(u"Scripts aren't available."_q);
+}
+
+std::optional<ScriptPageView> ScriptSettingsView(
+		not_null<Main::Session*> session,
+		const QString &id) {
+	const auto host = Host::Find(session);
+	return host ? host->settingsView(id) : std::nullopt;
+}
+
+void SetupScripts(not_null<Main::Session*> session) {
+	session->lifetime().make_state<Host>(session);
+	session->lifetime().make_state<std::shared_ptr<Updates>>(
+		AcquireUpdates());
+}
+
+QString DefaultScriptsFolder() {
+	return WithSlash(cWorkingDir() + u"scripts"_q);
+}
+
+QString ScriptsFolder() {
+	const auto &value = Folder().value;
+	return value.isEmpty() ? DefaultScriptsFolder() : WithSlash(value);
+}
+
+void SetScriptsFolder(const QString &path) {
+	const auto clean = (path.isEmpty()
+		|| WithSlash(path) == DefaultScriptsFolder())
+		? QString()
+		: WithSlash(path);
+	auto &folder = Folder();
+	if (folder.value == clean) {
+		return;
+	}
+	folder.value = clean;
+	WriteSettings();
+	Host::RefreshAll();
+}
+
+void PrepareScriptsFolder() {
+	QDir().mkpath(ScriptsFolder());
+	WriteTypings(ScriptsFolder());
+}
+
+std::vector<ScriptState> Scripts(not_null<Main::Session*> session) {
+	if (const auto host = Host::Find(session)) {
+		return host->scripts();
+	}
+	return {};
+}
+
+void SetScriptEnabled(
+		not_null<Main::Session*> session,
+		const QString &id,
+		bool enabled) {
+	if (const auto host = Host::Find(session)) {
+		host->setEnabled(id, enabled);
+	}
+}
+
+std::vector<ScriptLogLine> ScriptLog(
+		not_null<Main::Session*> session,
+		const QString &id) {
+	if (const auto host = Host::Find(session)) {
+		return host->log(id);
+	}
+	return {};
+}
+
+rpl::producer<ScriptLogged> ScriptLogChanges(
+		not_null<Main::Session*> session) {
+	if (const auto host = Host::Find(session)) {
+		return host->logChanges();
+	}
+	return rpl::never<ScriptLogged>();
+}
+
+int EmitScriptEvent(
+		not_null<Main::Session*> session,
+		const QString &from,
+		const QString &fromName,
+		const QString &event,
+		const QByteArray &payload,
+		const QString &target) {
+	const auto host = Host::Find(session);
+	return host ? host->emit(from, fromName, event, payload, target) : 0;
+}
+
+void ClearScriptLog(not_null<Main::Session*> session, const QString &id) {
+	if (const auto host = Host::Find(session)) {
+		host->clearLog(id);
+	}
+}
+
+void RescanScripts(not_null<Main::Session*> session) {
+	if (const auto host = Host::Find(session)) {
+		host->rescan();
+	}
+}
+
+void ReloadScript(not_null<Main::Session*> session, const QString &id) {
+	if (const auto host = Host::Find(session)) {
+		host->reload(id);
+	}
+}
+
+void EvaluateInScript(
+		not_null<Main::Session*> session,
+		const QString &target,
+		const QString &code,
+		Fn<void(bool, QString, QByteArray)> done) {
+	if (const auto host = Host::Find(session)) {
+		host->evaluate(target, code, std::move(done));
+	} else {
+		done(false, Lower(u"Scripts aren't available."_q), {});
+	}
+}
+
+void ApproveScript(not_null<Main::Session*> session, const QString &id) {
+	if (const auto host = Host::Find(session)) {
+		host->approve(id);
+	}
+}
+
+rpl::producer<> ScriptsChanged(not_null<Main::Session*> session) {
+	if (const auto host = Host::Find(session)) {
+		return rpl::merge(
+			host->changes(),
+			Folder().sourcesChanged.events());
+	}
+	return rpl::never<>();
+}
+
+} // namespace Tele::Scripting
