+enum class LogLevel : uchar {
+	Info,
+	Warning,
+	Error,
+	Fault,
+};
+
+enum class EngineKind : uchar {
+	Script,
+	Worker,
+};
+
+class Engine final {
+public:
+	Engine(
+		QString entry,
+		QString root,
+		Fn<void(LogLevel, QString, QByteArray)> log,
+		EngineKind kind = EngineKind::Script);
+	~Engine();
+
+	Engine(const Engine &) = delete;
+	Engine &operator=(const Engine &) = delete;
+
+	[[nodiscard]] JSContext *ctx() const;
+	void setOwner(void *owner);
+	[[nodiscard]] void *owner() const;
+	[[nodiscard]] const QString &root() const;
