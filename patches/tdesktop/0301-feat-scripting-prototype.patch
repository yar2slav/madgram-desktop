+
+void Host::reload(const QString &id) {
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i != end(_entries) && _grants.contains(id)) {
+		i->toasted = 0;
+		start(*i, true);
+		_changes.fire({});
+	}
+}
+
+void Host::evaluate(
+		const QString &target,
+		const QString &code,
+		Fn<void(bool, QString, QByteArray)> done) {
+	if (target.isEmpty()) {
+		if (!_repl) {
+			const auto folder = QDir(ScriptsFolder()).absolutePath();
+			_repl = std::make_unique<Instance>(
+				_session,
+				ScriptFile{
+					.id = QString(),
+					.entry = folder + u"/<repl>.ts"_q,
+					.root = folder,
+				},
+				_storage.storage(u"<repl>"_q),
+				_storage.storage(u"<repl>\n#local"_q),
+				outputFor(QString()),
+				nullptr);
+			_repl->startScratch();
+		}
+		_repl->evaluate(code, std::move(done));
+		return;
+	}
+	const auto i = ranges::find(_entries, target, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i == end(_entries) || !i->instance) {
+		done(false, Lower(u"The script isn't running."_q), {});
+		return;
+	}
+	i->instance->evaluate(code, std::move(done));
+}
+
+void Host::notify(const QString &id, const QString &text) {
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	ScriptNotice(
+		_session,
+		(i != end(_entries) && i->instance)
+			? i->instance->name()
+			: QFileInfo(id).completeBaseName(),
+		NoticeTone::Warning,
+		TextWithEntities{ text });
+	const auto now = crl::now();
+	if (i != end(_entries)) {
+		if (i->toasted && now - i->toasted < kToastMerge) {
+			return;
+		}
+		i->toasted = now;
+	}
+	crl::on_main(this, [=] {
+		if (const auto window = WindowOf(_session)) {
+			window->showToast(text);
+		}
+	});
+}
+
+void Host::failed(const QString &id) {
+	crl::on_main(this, [=] {
+		const auto i = ranges::find(_entries, id, [](const Entry &e) {
+			return e.file.id;
+		});
+		if (i == end(_entries) || !i->instance) {
+			return;
+		}
+		const auto name = i->instance->name();
+		i->instance = nullptr;
+		i->error = Lower(u"Turned off after failing 5 times in a row."_q);
+		i->toasted = 0;
+		_grants.remove(id);
+		write();
+		notify(id, Lower(u"Script %1 kept failing and was turned off."_q
+		).arg(name));
+		_changes.fire({});
+	});
+}
+
+void Host::remember(Entry &entry, not_null<Instance*> instance) {
+	entry.name = instance->name();
+	entry.meta = instance->meta();
+	entry.declared = instance->permissions().strings();
+	entry.metaStamps = Collect(entry.file, instance->files());
+}
+
+void Host::peek(Entry &entry) {
+	auto peeked = PeekScript(entry.file.entry);
+	entry.name = std::move(peeked.name);
+	entry.meta = std::move(peeked.meta);
+	entry.declared = std::move(peeked.grants);
+	entry.metaStamps = Stamps{
+		{ entry.file.entry, Stamp(entry.file.entry) },
+	};
+}
+
+void Host::revoke(const QString &id, const QString &grant) {
+	const auto i = _grants.find(id);
+	if (i == end(_grants) || !i->second.removeAll(grant)) {
+		return;
+	}
+	write();
+	const auto j = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (j != end(_entries)) {
+		start(*j, true);
+	}
+	_changes.fire({});
+}
+
+ScriptStorageUsage Host::storageUsage(const QString &id) {
+	const auto storage = _storage.storage(id);
+	const auto locals = _storage.storage(id + u"\n#local"_q);
+	return {
+		.keys = int(storage->keys().size()),
+		.bytes = storage->size(),
+		.locals = int(locals->keys().size()),
+		.localBytes = locals->size(),
+	};
+}
+
+void Host::clearStorage(const QString &id) {
+	_storage.storage(id)->clear();
+	_storage.storage(id + u"\n#local"_q)->clear();
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i != end(_entries) && i->instance) {
+		start(*i, true);
+	}
+	_changes.fire({});
+}
+
+QString Host::remove(const QString &id) {
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i == end(_entries)) {
+		return Lower(u"This script is already gone."_q);
+	}
+	const auto path = i->file.folder ? i->file.root : i->file.entry;
+	i->instance = nullptr;
+	if (!QFile::moveToTrash(path)) {
+		const auto removed = i->file.folder
+			? QDir(path).removeRecursively()
+			: QFile::remove(path);
+		if (!removed) {
+			return Lower(u"Can't remove %1."_q).arg(
+				QDir::toNativeSeparators(path));
+		}
+	}
+	_grants.remove(id);
+	SetScriptSource(id, QString());
+	write();
+	refresh();
+	return QString();
+}
+
+std::vector<ScriptState> Host::scripts() const {
+	auto result = std::vector<ScriptState>();
+	result.reserve(_entries.size());
+	for (const auto &entry : _entries) {
+		const auto &meta = entry.meta;
+		const auto icon = [&] {
+			const auto lower = meta.icon.toLower();
+			const auto image = lower.endsWith(u".png"_q)
+				|| lower.endsWith(u".jpg"_q)
+				|| lower.endsWith(u".jpeg"_q)
+				|| lower.endsWith(u".webp"_q)
+				|| lower.endsWith(u".svg"_q);
+			return image
+				? QDir(entry.file.root).absoluteFilePath(meta.icon)
+				: meta.icon;
+		}();
+		const auto &sources = Folder().sources;
+		const auto source = entry.file.folder
+			? end(sources)
+			: sources.find(entry.file.id);
+		const auto sourced = (source != end(sources));
+		result.push_back({
+			.id = entry.file.id,
+			.name = (entry.instance
+				? entry.instance->name()
+				: !entry.name.isEmpty()
+				? entry.name
+				: entry.file.id),
+			.version = meta.version,
+			.description = meta.description,
+			.author = meta.author,
+			.icon = icon,
+			.homepage = meta.homepage,
+			.path = entry.file.entry,
+			.root = entry.file.root,
+			.error = entry.error,
+			.source = sourced ? source->second.url : QString(),
+			.update = (sourced
+				&& NewerScriptVersion(meta.version, source->second.latest))
+				? source->second.latest
+				: QString(),
+			.declared = entry.declared,
+			.requested = entry.requested,
+			.granted = [&] {
+				const auto i = _grants.find(entry.file.id);
+				return (i != end(_grants)) ? i->second : QStringList();
+			}(),
+			.folder = entry.file.folder,
+			.enabled = _grants.contains(entry.file.id),
+			.running = (entry.instance != nullptr),
+			.approval = entry.approval,
+			.settings = entry.instance && entry.instance->hasSettings(),
+		});
+	}
+	return result;
+}
+
+void Host::setEnabled(const QString &id, bool enabled) {
+	if (enabled == _grants.contains(id)) {
+		return;
+	}
+	if (enabled) {
+		_grants.emplace(id, QStringList());
+	} else {
+		_grants.remove(id);
+	}
+	write();
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i != end(_entries)) {
+		if (enabled) {
+			i->toasted = 0;
+			start(*i, true);
+		} else {
+			i->instance = nullptr;
+			i->error = QString();
+			i->approval = false;
+			i->requested = QStringList();
+		}
+	}
+	_changes.fire({});
+}
+
+void Host::approve(const QString &id) {
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	if (i == end(_entries) || !i->approval || !_grants.contains(id)) {
+		return;
+	}
+	_grants[id] = i->requested;
+	write();
+	start(*i, true);
+	_changes.fire({});
+}
