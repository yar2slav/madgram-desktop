+				case 'everyone':
+					return [{ _: 'inputPrivacyValueAllowAll' }, ...except];
+				case 'contacts':
+					return [{ _: 'inputPrivacyValueAllowContacts' }, ...except];
+				case 'close':
+					return [{ _: 'inputPrivacyValueAllowCloseFriends' }];
+				}
