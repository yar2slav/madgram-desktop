diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_native.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_native.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ee2e13662314c39a85000744f017fae9baa23190
--- /dev/null
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_native.cpp
@@ -0,0 +1,237 @@
+#include "tele/scripting/tele_script_native.h"
+
+#include "tele/scripting/tele_script_instance.h"
+
+namespace Tele::Scripting {
+
+QString FromStd(std::string_view text) {
+	return QString::fromUtf8(text.data(), int(text.size()));
+}
+
+std::string ToStd(JSContext *ctx, JSValueConst value) {
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(ctx, &size, value);
+	auto result = text ? std::string(text, size) : std::string();
+	if (text) {
+		JS_FreeCString(ctx, text);
+	}
+	return result;
+}
+
+JSValue NewString(JSContext *ctx, const QString &text) {
+	const auto utf8 = text.toUtf8();
+	return JS_NewStringLen(ctx, utf8.constData(), utf8.size());
+}
+
+QString StringProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = QString();
+	if (JS_IsString(value)) {
+		result = FromStd(ToStd(ctx, value));
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+bool BoolProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	const auto result = (JS_ToBool(ctx, value) > 0);
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+JSValue MakeTeleError(
+		JSContext *ctx,
+		const char *code,
+		const QString &message,
+		const QString &grant) {
+	auto global = JS_GetGlobalObject(ctx);
+	auto constructor = JS_GetPropertyStr(ctx, global, "__teleTeleError");
+	JS_FreeValue(ctx, global);
+	const auto text = message.toUtf8();
+	const auto token = grant.toUtf8();
+	JSValue args[] = {
+		JS_NewString(ctx, code),
+		JS_NewStringLen(ctx, text.constData(), text.size()),
+		grant.isEmpty()
+			? JS_UNDEFINED
+			: JS_NewStringLen(ctx, token.constData(), token.size()),
+	};
+	auto error = JS_CallConstructor(ctx, constructor, 3, args);
+	for (const auto arg : args) {
+		JS_FreeValue(ctx, arg);
+	}
+	JS_FreeValue(ctx, constructor);
+	return error;
+}
+
+JSValue ThrowTeleError(
+		JSContext *ctx,
+		const char *code,
+		const QString &message,
+		const QString &grant) {
+	auto error = MakeTeleError(ctx, code, message, grant);
+	return JS_IsException(error) ? error : JS_Throw(ctx, error);
+}
+
+JSValue ThrowNotGranted(
+		JSContext *ctx,
+		const QString &what,
+		const QString &grant) {
+	return ThrowTeleError(
+		ctx,
+		"not-granted",
+		u"%1 needs the grant '%2'"_q.arg(what, grant),
+		grant);
+}
+
+Instance *Permitted(
+		JSContext *ctx,
+		Capability capability,
+		std::string_view scope,
+		const char *what) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		JS_ThrowInternalError(ctx, "the script was stopped");
+		return nullptr;
+	} else if (!instance->permissions().allows(capability, scope)) {
+		ThrowNotGranted(
+			ctx,
+			QString::fromLatin1(what),
+			GrantText(capability, scope));
+		return nullptr;
+	}
+	return instance;
+}
+
+JSValue NewBytes(JSContext *ctx, const QByteArray &bytes) {
+	return JS_NewUint8ArrayCopy(
+		ctx,
+		reinterpret_cast<const uint8_t*>(bytes.constData()),
+		size_t(bytes.size()));
+}
+
+std::optional<QByteArray> BytesFrom(JSContext *ctx, JSValueConst value) {
+	auto size = size_t();
+	if (const auto data = JS_GetUint8Array(ctx, &size, value)) {
+		return QByteArray(reinterpret_cast<const char*>(data), int(size));
+	}
+	JS_FreeValue(ctx, JS_GetException(ctx));
+	if (const auto data = JS_GetArrayBuffer(ctx, &size, value)) {
+		return QByteArray(reinterpret_cast<const char*>(data), int(size));
+	}
+	JS_FreeValue(ctx, JS_GetException(ctx));
+	return std::nullopt;
+}
+
+std::optional<double> NumberProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::optional<double>();
+	if (JS_IsNumber(value)) {
+		auto number = 0.;
+		if (!JS_ToFloat64(ctx, &number, value)) {
+			result = number;
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+void AddNatives(
+		JSContext *ctx,
+		JSValueConst natives,
+		std::initializer_list<NativeFunction> list) {
+	for (const auto &entry : list) {
+		JS_SetPropertyStr(
+			ctx,
+			natives,
+			entry.name,
+			JS_NewCFunctionMagic(
+				ctx,
+				entry.function,
+				entry.name,
+				entry.length,
+				JS_CFUNC_generic_magic,
+				entry.magic));
+	}
+}
+
+std::pair<Pending, JSValue> NewPending(JSContext *ctx) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return {
+			Pending(),
+			JS_ThrowInternalError(ctx, "the script was stopped"),
+		};
+	}
+	auto [key, promise] = instance->newPromise();
+	return { Pending{ base::make_weak(instance), key }, promise };
+}
+
+void Resolve(const Pending &pending, Fn<JSValue(JSContext*)> value) {
+	const auto strong = pending.instance.get();
+	const auto ctx = strong ? strong->context() : nullptr;
+	if (ctx && pending.key) {
+		strong->settle(pending.key, true, value(ctx));
+	}
+}
+
+void Reject(
+		const Pending &pending,
+		const char *code,
+		const QString &message) {
+	RejectWith(pending, [=](JSContext *ctx) {
+		return MakeTeleError(ctx, code, message);
+	});
+}
+
+void RejectWith(const Pending &pending, Fn<JSValue(JSContext*)> error) {
+	const auto strong = pending.instance.get();
+	const auto ctx = strong ? strong->context() : nullptr;
+	if (ctx && pending.key) {
+		strong->settle(pending.key, false, error(ctx));
+	}
+}
+
+int KeepFunction(not_null<Instance*> instance, JSValueConst function) {
+	return instance->keep(function);
+}
+
+void CallKept(
+		const base::weak_ptr<Instance> &instance,
+		int id,
+		Fn<JSValue(JSContext*)> payload,
+		const QString &where) {
+	if (const auto strong = instance.get(); strong && id) {
+		strong->callKept(id, std::move(payload), where);
+	}
+}
+
+void ForgetKept(const base::weak_ptr<Instance> &instance, int id) {
+	if (const auto strong = instance.get(); strong && id) {
+		strong->forgetKept(id);
+	}
+}
+
+rpl::lifetime &ScriptLifetime(not_null<Instance*> instance) {
+	return instance->extensionsLifetime();
+}
+
+QString ScriptId(not_null<Instance*> instance) {
+	return instance->file().id;
+}
+
+not_null<Main::Session*> ScriptSession(not_null<Instance*> instance) {
+	return instance->session();
+}
+
+} // namespace Tele::Scripting
