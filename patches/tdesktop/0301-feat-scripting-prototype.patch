+std::optional<QString> Engine::resolve(
+		const QString &base,
+		const QString &name) {
+	if (_kind == EngineKind::Worker) {
+		_lastError = u"a worker can't import modules, bundle '"_q
+			+ name
+			+ u"' into the worker file or send its data with postMessage"_q;
+		return std::nullopt;
+	} else if (name == u"tele"_q) {
+		return name;
+	}
+	const auto directory = QDir::isRelativePath(base)
+		? _root
+		: QFileInfo(base).absolutePath();
+	return ModuleResolver(_root, modulesLimit(), _files).resolve(
+		directory,
+		name,
+		_lastError);
+}
