+std::optional<QByteArray> Engine::transpile(
+		const QByteArray &code,
+		QString &error) {
+	if (!_stripper) {
+		_stripper = StripWorker::Shared();
+	}
+	auto result = _stripper->strip(code, _root + u"/<repl>.ts"_q, error);
+	if (!result) {
+		return std::nullopt;
