+JSValue FoldersReorder(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Options,
+		{},
+		"tg.tele.folders.reorder");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto order = std::vector<FilterId>();
+	auto length = std::int64_t();
+	auto bad = (argc < 1)
+		|| !JS_IsArray(argv[0])
+		|| (JS_GetLength(ctx, argv[0], &length) < 0);
+	for (auto i = std::int64_t(); !bad && i != length; ++i) {
+		auto entry = JS_GetPropertyUint32(ctx, argv[0], uint32_t(i));
+		auto id = std::int32_t();
+		bad = !JS_IsNumber(entry) || JS_ToInt32(ctx, &id, entry) < 0;
+		JS_FreeValue(ctx, entry);
+		order.push_back(FilterId(id));
+	}
+	const auto filters = &instance->session()->data().chatsFilters();
+	const auto &list = filters->list();
+	auto existing = std::vector<FilterId>();
+	for (const auto &filter : list) {
+		if (filter.id()) {
+			existing.push_back(filter.id());
+		}
+	}
+	auto given = order;
+	given.erase(ranges::remove(given, FilterId()), end(given));
+	if (bad || !ranges::is_permutation(given, existing)) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.folders.reorder needs every folder id from "
+			"tg.tele.folders.list() exactly once");
+	}
+	if (!ranges::contains(order, FilterId())) {
+		auto position = 0;
+		for (const auto &filter : list) {
+			const auto id = filter.id();
+			if (!id) {
+				break;
+			} else if (const auto i = ranges::find(order, id)
+				; i != end(order)) {
+				position = int(i - begin(order)) + 1;
+			}
+		}
+		order.insert(begin(order) + position, FilterId());
+	}
+	filters->saveOrder(order);
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] QStringList RuleLines(const QString &value) {
+	auto result = QStringList();
+	for (const auto &line : value.split(QChar('\n'))) {
+		if (!line.isEmpty()) {
+			result.push_back(line);
+		}
+	}
+	return result;
+}
