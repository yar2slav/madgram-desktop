+[[nodiscard]] ComposeSnapshot SnapshotOf(const Surface &surface) {
+	const auto &data = surface.data;
+	const auto peer = data.peer ? data.peer() : nullptr;
+	if (!peer || Secret::IsSecretPeer(peer)) {
+		return ComposeSnapshot();
+	}
+	return {
+		.peer = peer->id,
+		.replyTo = data.replyTo ? data.replyTo() : FullMsgId(),
+		.editing = data.editing ? data.editing() : MsgId(),
+		.attached = data.attached ? data.attached() : 0,
+		.silent = SilentOf(not_null(peer)),
+		.scheduled = data.scheduled,
+		.sendAs = SendAsOf(not_null(peer)),
+	};
+}
+
+void CheckSurface(not_null<Surface*> surface) {
+	if (!surface->data.replyTo || !HasComposeListeners()) {
+		return;
+	}
+	const auto snapshot = SnapshotOf(*surface);
+	if (surface->last == snapshot) {
+		return;
+	}
+	surface->last = snapshot;
+	if (snapshot.peer) {
+		ComposeChanges().fire({
+			.session = surface->session,
+			.state = snapshot,
+		});
+	}
+}
+
+template <typename Check>
+[[nodiscard]] Surface *FindSurface(
+		not_null<Main::Session*> session,
+		PeerId peer,
+		Check check) {
+	auto result = (Surface*)nullptr;
+	for (const auto &surface : Surfaces()) {
+		if (surface->session != session || !check(surface->data)) {
+			continue;
+		}
+		const auto current = surface->data.peer
+			? surface->data.peer()
+			: nullptr;
+		if (!current || current->id != peer) {
+			continue;
+		} else if (surface->owner->isVisible()) {
+			return surface.get();
+		} else if (!result) {
+			result = surface.get();
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] JSValue StateValue(
+		JSContext *ctx,
+		const ComposeSnapshot &state) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(state.peer)));
+	if (state.replyTo) {
+		auto reply = JS_NewObject(ctx);
+		JS_SetPropertyStr(
+			ctx,
+			reply,
+			"chatId",
+			JS_NewBigInt64(ctx, MarkedId(state.replyTo.peer)));
+		JS_SetPropertyStr(
+			ctx,
+			reply,
+			"messageId",
+			JS_NewInt64(ctx, state.replyTo.msg.bare));
+		JS_SetPropertyStr(ctx, result, "replyTo", reply);
+	} else {
+		JS_SetPropertyStr(ctx, result, "replyTo", JS_NULL);
+	}
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"editing",
+		state.editing ? JS_NewInt64(ctx, state.editing.bare) : JS_NULL);
+	JS_SetPropertyStr(ctx, result, "silent", JS_NewBool(ctx, state.silent));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"scheduled",
+		JS_NewBool(ctx, state.scheduled));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"sendAs",
+		state.sendAs
+			? JS_NewBigInt64(ctx, MarkedId(state.sendAs))
+			: JS_NULL);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"attached",
+		JS_NewInt32(ctx, state.attached));
+	return result;
+}
+
+void AttachFiles(
+		not_null<Main::Session*> session,
+		PeerId peer,
+		std::vector<AttachedFile> files,
+		Fn<void(bool)> done) {
+	auto list = std::make_shared<Ui::PreparedList>();
+	const auto max = Ui::MaxAlbumItems();
+	for (auto &file : files) {
+		auto prepared = Ui::PreparedFile(QString());
+		prepared.displayName = file.name;
+		prepared.size = file.bytes.size();
+		prepared.content = std::move(file.bytes);
+		if (int(list->files.size()) < max) {
+			list->files.push_back(std::move(prepared));
+		} else {
+			list->filesToProcess.push_back(std::move(prepared));
+		}
+	}
+	const auto previewWidth = int(st::sendMediaPreviewSize);
+	const auto sideLimit = PhotoSideLimit();
+	const auto weak = base::make_weak(session.get());
+	crl::async([=] {
+		for (auto &file : list->files) {
+			Storage::PrepareDetails(file, previewWidth, sideLimit);
+		}
+		crl::on_main([=] {
+			const auto strong = weak.get();
+			const auto surface = strong
+				? FindSurface(not_null(strong), peer, [](
+						const ComposeSurface &data) {
+					return bool(data.attach);
+				})
+				: nullptr;
+			const auto attached = surface
+				&& surface->data.attach(std::move(*list));
+			if (done) {
+				done(attached);
+			}
+		});
+	});
+}
+
+[[nodiscard]] PasteVerdict VerdictFrom(JSContext *ctx, JSValueConst value) {
+	auto result = PasteVerdict();
+	if (!JS_IsObject(value)) {
+		return result;
+	}
+	const auto kind = StringProperty(ctx, value, "kind");
+	if (kind == u"drop"_q) {
+		result.kind = PasteVerdict::Kind::Drop;
+	} else if (kind == u"text"_q) {
+		result.kind = PasteVerdict::Kind::Text;
+		result.text = StringProperty(ctx, value, "text");
+	} else if (kind == u"files"_q) {
+		auto files = JS_GetPropertyStr(ctx, value, "files");
+		auto parsed = FilesFrom(ctx, files);
+		JS_FreeValue(ctx, files);
+		if (parsed) {
+			result.kind = PasteVerdict::Kind::Files;
+			result.files = std::move(*parsed);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool InterceptsPaste(not_null<Main::Session*> session) {
+	return ranges::any_of(Interceptors(), [&](const Interceptor &entry) {
+		return (entry.session == session)
+			&& (entry.instance.get() != nullptr);
+	});
+}
+
+[[nodiscard]] std::shared_ptr<QMimeData> CopyMime(
+		not_null<const QMimeData*> data) {
+	auto result = std::make_shared<QMimeData>();
+	for (const auto &format : data->formats()) {
+		result->setData(format, data->data(format));
+	}
+	if (data->hasUrls()) {
+		result->setUrls(data->urls());
+	}
+	if (data->hasImage()) {
+		result->setImageData(data->imageData());
+	}
+	if (data->hasText()) {
+		result->setText(data->text());
+	}
+	return result;
+}
+
+[[nodiscard]] PasteData PasteDataOf(
+		PeerId peer,
+		not_null<const QMimeData*> data) {
+	auto result = PasteData{
+		.peer = peer,
+		.text = data->hasText() ? data->text() : QString(),
+	};
+	for (const auto &url : data->urls()) {
+		if (url.isLocalFile()) {
+			const auto path = url.toLocalFile();
+			const auto info = QFileInfo(path);
+			result.files.push_back({
+				.name = info.fileName(),
+				.path = path,
+				.size = info.size(),
+			});
+		}
+	}
+	result.kind = !result.files.empty()
+		? u"files"_q
+		: data->hasImage()
+		? u"image"_q
+		: u"text"_q;
+	return result;
+}
+
+[[nodiscard]] JSValue PasteValue(
+		JSContext *ctx,
+		int callId,
+		const PasteData &data) {
+	auto paste = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		paste,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(data.peer)));
+	JS_SetPropertyStr(ctx, paste, "kind", NewString(ctx, data.kind));
+	JS_SetPropertyStr(ctx, paste, "text", NewString(ctx, data.text));
+	auto files = JS_NewArray(ctx);
+	for (auto i = 0; i != int(data.files.size()); ++i) {
+		const auto &file = data.files[i];
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, item, "name", NewString(ctx, file.name));
+		JS_SetPropertyStr(ctx, item, "path", NewString(ctx, file.path));
+		JS_SetPropertyStr(ctx, item, "size", JS_NewInt64(ctx, file.size));
+		JS_SetPropertyUint32(ctx, files, std::uint32_t(i), item);
+	}
+	JS_SetPropertyStr(ctx, paste, "files", files);
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "callId", JS_NewInt32(ctx, callId));
+	JS_SetPropertyStr(ctx, result, "paste", paste);
+	return result;
+}
+
+void AskFrom(std::shared_ptr<PasteRun> run, std::size_t index) {
+	const auto &interceptors = Interceptors();
+	for (; index < run->interceptors.size(); ++index) {
+		const auto i = ranges::find(
+			interceptors,
+			run->interceptors[index],
+			&Interceptor::id);
+		if (i == end(interceptors) || !i->instance.get()) {
+			continue;
+		}
+		const auto callId = NextId();
+		const auto next = index + 1;
+		Answers().emplace(callId, Answer{
+			.owner = i->owner,
+			.done = [=](PasteVerdict verdict) {
+				if (verdict.kind == PasteVerdict::Kind::Keep) {
+					AskFrom(run, next);
+				} else {
+					run->done(std::move(verdict));
+				}
+			},
+		});
+		const auto instance = i->instance;
+		const auto kept = i->kept;
+		base::call_delayed(kPasteTimeout, [=] {
+			FinishAnswer(callId, PasteVerdict());
+		});
+		CallKept(instance, kept, [=](JSContext *ctx) {
+			return PasteValue(ctx, callId, run->data);
+		}, u"tg.compose.interceptPaste"_q);
+		return;
+	}
+	run->done(PasteVerdict());
+}
+
+void Replay(
+		const QPointer<Ui::InputField> &field,
+		not_null<const QMimeData*> data) {
+	const auto strong = field.data();
+	if (!strong) {
+		return;
+	}
+	const auto edit = strong->rawTextEdit().get();
+	++ReplayingPaste;
+	(edit->*MimeInserter::Method())(data.get());
+	--ReplayingPaste;
+}
+
+void ApplyPaste(
+		const QPointer<Ui::InputField> &field,
+		const base::weak_ptr<Main::Session> &session,
+		PeerId peer,
+		const std::shared_ptr<QMimeData> &copy,
+		PasteVerdict verdict) {
+	switch (verdict.kind) {
+	case PasteVerdict::Kind::Drop:
+		return;
+	case PasteVerdict::Kind::Files:
+		if (const auto strong = session.get()) {
+			AttachFiles(
+				not_null(strong),
+				peer,
+				std::move(verdict.files),
+				nullptr);
+		}
+		return;
+	case PasteVerdict::Kind::Text: {
+		QMimeData data;
+		data.setText(verdict.text);
+		Replay(field, &data);
+		return;
+	}
+	case PasteVerdict::Kind::Keep:
+		Replay(field, copy.get());
+		return;
+	}
+}
+
+JSValue NativeChatUi(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto raw = Instance::From(ctx);
+	if (!raw) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto owner = not_null<Instance*>(raw);
+	const auto session = ScriptSession(owner);
+	const auto arg = [&](int index) {
+		return (argc > index) ? argv[index] : JS_UNDEFINED;
+	};
+	const auto targetPeer = [&](int index) -> PeerData* {
+		const auto value = arg(index);
+		const auto id = PeerFromMarked(ctx, value);
+		const auto peer = id
+			? session->data().peerLoaded(*id)
+			: (JS_IsNull(value) || JS_IsUndefined(value))
+			? ActivePeer(session)
+			: nullptr;
+		return (peer && !Secret::IsSecretPeer(peer)) ? peer : nullptr;
+	};
+	const auto idArg = [&](int index) {
+		auto result = std::int32_t();
+		if (JS_ToInt32(ctx, &result, arg(index))) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			return 0;
+		}
+		return int(result);
+	};
+	switch (Op(magic)) {
+	case Op::Banner: {
+		const auto chat = PeerFromMarked(ctx, arg(0));
+		const auto options = arg(1);
+		if (!chat || !JS_IsObject(options) || !JS_IsFunction(ctx, arg(2))) {
+			return JS_ThrowTypeError(ctx, "tg.ui.banner(options)");
+		}
+		auto banner = Banner{
+			.id = NextId(),
+			.owner = owner,
+			.instance = base::make_weak(raw),
+			.session = session,
+			.peer = *chat,
+			.text = StringProperty(ctx, options, "text"),
+			.icon = StringProperty(ctx, options, "icon"),
+			.closable = BoolProperty(ctx, options, "closable"),
+		};
+		if (banner.text.isEmpty()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.banner: text must be a non-empty string");
+		}
+		auto buttons = JS_GetPropertyStr(ctx, options, "buttons");
+		if (JS_IsArray(buttons)) {
+			const auto count = std::min(ArrayLength(ctx, buttons), kMaxButtons);
+			for (auto i = 0; i != count; ++i) {
+				banner.buttons.push_back(ArrayString(ctx, buttons, i));
+			}
+		}
+		JS_FreeValue(ctx, buttons);
+		Track(owner);
+		banner.handler = KeepFunction(owner, arg(2));
+		const auto id = banner.id;
+		Banners().push_back(std::move(banner));
+		BannerChanges().fire({});
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::BannerRemove: {
+		const auto id = idArg(0);
+		auto &banners = Banners();
+		const auto i = ranges::find_if(banners, [&](const Banner &banner) {
+			return (banner.id == id) && (banner.owner == owner);
+		});
+		if (i != end(banners)) {
+			const auto instance = i->instance;
+			const auto handler = i->handler;
+			banners.erase(i);
+			ForgetKept(instance, handler);
+			BannerChanges().fire({});
+		}
+		return JS_UNDEFINED;
+	}
+	case Op::Selection:
+		if (const auto entry = CurrentSelection(session)) {
+			return SelectionValue(ctx, entry->peer, entry->ids);
+		}
+		return JS_NULL;
+	case Op::OnSelection: {
+		if (!JS_IsFunction(ctx, arg(0))) {
+			return JS_ThrowTypeError(ctx, "tg.ui.onSelectionChanged(function)");
+		}
+		const auto id = NextId();
+		const auto listener = AddListener(
+			id,
+			owner,
+			arg(0),
+			ListenerKind::Selection);
+		SelectionChanges().events(
+		) | rpl::filter([=](not_null<Main::Session*> changed) {
+			return (changed == session);
+		}) | rpl::on_next([=] {
+			if (listener->scheduled) {
+				return;
+			}
+			listener->scheduled = true;
+			Later(id, [=](not_null<Listener*> entry) {
+				entry->scheduled = false;
+				const auto current = CurrentSelection(session);
+				const auto peer = current ? current->peer : PeerId();
+				const auto ids = current
+					? current->ids
+					: std::vector<MsgId>();
+				CallKept(entry->instance, entry->kept, [=](JSContext *ctx) {
+					return peer ? SelectionValue(ctx, peer, ids) : JS_NULL;
+				}, u"tg.ui.onSelectionChanged"_q);
+			});
+		}, listener->lifetime);
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::Focused:
+		return JS_NewBool(ctx, Focused(session));
+	case Op::OnFocus: {
+		if (!JS_IsFunction(ctx, arg(0))) {
+			return JS_ThrowTypeError(ctx, "tg.app.focus.onChange(function)");
+		}
+		const auto id = NextId();
+		const auto listener = AddListener(
+			id,
+			owner,
+			arg(0),
+			ListenerKind::Focus);
+		const auto last = std::make_shared<bool>(Focused(session));
+		base::qt_signal_producer(
+			qApp,
+			&QGuiApplication::focusWindowChanged
+		) | rpl::to_empty | rpl::on_next([=] {
+			Later(id, [=](not_null<Listener*> entry) {
+				const auto now = Focused(session);
+				if (*last == now) {
+					return;
+				}
+				*last = now;
+				CallKept(entry->instance, entry->kept, [=](JSContext *ctx) {
+					return JS_NewBool(ctx, now);
+				}, u"tg.app.focus.onChange"_q);
+			});
+		}, listener->lifetime);
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::OnComposeState: {
+		if (!JS_IsFunction(ctx, arg(0))) {
+			return JS_ThrowTypeError(ctx, "tg.compose.onStateChange(function)");
+		}
+		const auto id = NextId();
+		const auto listener = AddListener(
+			id,
+			owner,
+			arg(0),
+			ListenerKind::Compose);
+		ComposeChanges().events(
+		) | rpl::filter([=](const ComposeChange &change) {
+			return (change.session == session);
+		}) | rpl::on_next([=](const ComposeChange &change) {
+			const auto state = change.state;
+			Later(id, [=](not_null<Listener*> entry) {
+				CallKept(entry->instance, entry->kept, [=](JSContext *ctx) {
+					return StateValue(ctx, state);
+				}, u"tg.compose.onStateChange"_q);
+			});
+		}, listener->lifetime);
+		for (const auto &surface : Surfaces()) {
+			if (surface->session == session) {
+				surface->last = SnapshotOf(*surface);
+			}
+		}
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::Off: {
+		const auto id = idArg(0);
+		auto &listeners = Listeners();
+		const auto i = listeners.find(id);
+		if (i != end(listeners) && i->second->owner == owner) {
+			ForgetKept(i->second->instance, i->second->kept);
+			listeners.erase(i);
+		}
+		auto &interceptors = Interceptors();
+		const auto j = ranges::find(interceptors, id, &Interceptor::id);
+		if (j != end(interceptors) && j->owner == owner) {
+			ForgetKept(j->instance, j->kept);
+			interceptors.erase(j);
+		}
+		return JS_UNDEFINED;
+	}
+	case Op::ComposeState: {
+		const auto peer = targetPeer(0);
+		const auto surface = peer
+			? FindSurface(session, peer->id, [](const ComposeSurface &data) {
+				return bool(data.replyTo);
+			})
+			: nullptr;
+		const auto state = surface ? SnapshotOf(*surface) : ComposeSnapshot();
+		return state.peer ? StateValue(ctx, state) : JS_NULL;
+	}
+	case Op::SetReply: {
+		const auto peer = targetPeer(0);
+		auto msg = std::int64_t();
+		if (JS_IsNumber(arg(1)) && JS_ToInt64(ctx, &msg, arg(1))) {
+			return JS_EXCEPTION;
+		} else if (msg < 0) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.compose.setReply: messageId must be a positive integer or null");
+		}
+		const auto surface = peer
+			? FindSurface(session, peer->id, [](const ComposeSurface &data) {
+				return bool(data.setReply);
+			})
+			: nullptr;
+		if (!surface
+			|| (msg && !session->data().message(peer->id, MsgId(msg)))) {
+			return JS_FALSE;
+		}
+		surface->data.setReply(MsgId(msg));
+		return JS_TRUE;
+	}
+	case Op::Attach: {
+		const auto peer = targetPeer(0);
+		auto files = FilesFrom(ctx, arg(1));
+		if (!files) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.compose.attach: files must be a non-empty array of { name, bytes }");
+		}
+		auto created = NewPending(ctx);
+		const auto pending = created.first;
+		if (JS_IsException(created.second)) {
+			return created.second;
+		} else if (!peer) {
+			Resolve(pending, [](JSContext*) { return JS_FALSE; });
+			return created.second;
+		}
+		AttachFiles(session, peer->id, std::move(*files), [=](bool done) {
+			Resolve(pending, [=](JSContext *ctx) {
+				return JS_NewBool(ctx, done);
+			});
+		});
+		return created.second;
+	}
+	case Op::SendOptions: {
+		const auto peer = targetPeer(0);
+		const auto options = arg(1);
+		if (!JS_IsObject(options)) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.compose.setSendOptions({ silent?, sendAs? })");
+		}
+		auto silentValue = JS_GetPropertyStr(ctx, options, "silent");
+		const auto hasSilent = JS_IsBool(silentValue);
+		const auto silent = hasSilent && (JS_ToBool(ctx, silentValue) > 0);
+		JS_FreeValue(ctx, silentValue);
+		auto sendAsValue = JS_GetPropertyStr(ctx, options, "sendAs");
+		const auto sendAs = PeerFromMarked(ctx, sendAsValue);
+		JS_FreeValue(ctx, sendAsValue);
+		if (hasSilent
+			&& !Permitted(
+				ctx,
+				Capability::AccountWrite,
+				"notify",
+				"tg.compose.setSendOptions({ silent })")) {
+			return JS_EXCEPTION;
+		} else if (!peer) {
+			return JS_FALSE;
+		}
+		const auto chat = not_null<PeerData*>(peer);
+		if (hasSilent
+			&& (!chat->isBroadcast()
+				|| chat->owner().notifySettings().silentPostsUnknown(chat))) {
+			return ThrowTeleError(
+				ctx,
+				"unsupported",
+				u"silent sending is a setting of channels you post in"_q);
+		}
+		if (sendAs) {
+			auto &peers = session->sendAsPeers();
+			const auto &list = peers.list({ chat });
+			const auto i = ranges::find(
+				list,
+				*sendAs,
+				[](const Main::SendAsPeer &as) { return as.peer->id; });
+			if (i == end(list)) {
+				return ThrowTeleError(
+					ctx,
+					"not-found",
+					u"this chat doesn't offer sending as that peer"_q);
+			} else if (i->premiumRequired && !session->premium()) {
+				return ThrowTeleError(
+					ctx,
+					"forbidden",
+					u"sending as that peer needs telegram premium"_q);
+			}
+		}
+		if (hasSilent && SilentOf(chat) != silent) {
+			chat->owner().notifySettings().update(chat, {}, silent);
+		}
+		if (sendAs) {
+			session->sendAsPeers().setChosen(chat, *sendAs);
+		}
+		return JS_TRUE;
+	}
+	case Op::InterceptPaste: {
+		if (!JS_IsFunction(ctx, arg(0))) {
+			return JS_ThrowTypeError(ctx, "tg.compose.interceptPaste(function)");
+		} else if (!Permitted(
+				ctx,
+				Capability::InterceptDrop,
+				{},
+				"tg.compose.interceptPaste")) {
+			return JS_EXCEPTION;
+		}
+		Track(owner);
+		const auto id = NextId();
+		Interceptors().push_back({
+			.id = id,
+			.owner = owner,
+			.instance = base::make_weak(raw),
+			.session = session,
+			.kept = KeepFunction(owner, arg(0)),
+		});
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::Answer: {
+		const auto callId = idArg(0);
+		const auto i = Answers().find(callId);
+		if (i != end(Answers()) && i->second.owner == owner) {
+			const auto verdict = VerdictFrom(ctx, arg(1));
+			crl::on_main([=] {
+				FinishAnswer(callId, verdict);
+			});
+		}
+		return JS_UNDEFINED;
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = std::string_view(R"TS(
+declare module 'tele' {
+  export interface BannerButton {
+    text: string
+    onClick(): unknown
+  }
+
+  export interface BannerOptions {
+    place: 'chat' | 'chats'
+    chat?: InputPeerLike
+    text: string
+    icon?: string
+    buttons?: BannerButton[]
+    closable?: boolean
+    onClose?(): unknown
+  }
+
+  export interface MessageSelection {
+    chatId: bigint
+    ids: number[]
+  }
+
+  export interface Ui {
+    banner(options: BannerOptions): Disposer
+    selection(): MessageSelection | null
+    onSelectionChanged(callback: (selection: MessageSelection | null) => unknown): Disposer
+  }
+
+  export interface AppFocus {
+    readonly focused: boolean
+    onChange(callback: (focused: boolean) => unknown): Disposer
+  }
+
+  export interface App {
+    readonly focus: AppFocus
+  }
+
+  export interface ComposeState {
+    chatId: bigint
+    replyTo: { chatId: bigint, messageId: number } | null
+    editing: number | null
+    silent: boolean
+    scheduled: boolean
+    sendAs: bigint | null
+    attached: number
+  }
+
+  export interface AttachFile {
+    name: string
+    bytes: Uint8Array | ArrayBuffer
+  }
+
+  export interface PasteInfo {
+    chatId: bigint
+    kind: 'text' | 'image' | 'files'
+    text: string
+    files: { name: string, path: string, size: number }[]
+  }
+
+  export type PasteVerdict = 'keep' | 'drop' | { text: string } | { files: AttachFile[] }
+
+  export type PasteInterceptor = (
+    paste: PasteInfo,
+  ) => PasteVerdict | null | void | Promise<PasteVerdict | null | void>
+
+  export interface Compose {
+    state(peer?: InputPeerLike): Promise<ComposeState | null>
+    onStateChange(callback: (state: ComposeState) => unknown): Disposer
+    setReply(messageId: number | null, peer?: InputPeerLike): Promise<boolean>
+    attach(files: AttachFile[], peer?: InputPeerLike): Promise<boolean>
+    setSendOptions(
+      options: { silent?: boolean, sendAs?: InputPeerLike },
+      peer?: InputPeerLike,
+    ): Promise<boolean>
+    interceptPaste(interceptor: PasteInterceptor): Disposer
+  }
+}
+)TS");
