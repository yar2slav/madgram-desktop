+struct Registry {
+	base::flat_map<int, Entry> entries;
+	base::flat_map<int, Waiting> waiting;
+	base::flat_map<not_null<QWidget*>, Host*> hosts;
+	base::flat_set<Instance*> tracked;
+	rpl::event_stream<> bannersChanged;
+	int nextEntry = 0;
+	int nextCall = 0;
+};
+
+[[nodiscard]] Registry &State() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] std::optional<std::uint64_t> BigField(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::optional<std::uint64_t>();
+	if (JS_IsBigInt(value)) {
+		auto number = std::int64_t();
+		JS_ToBigInt64(ctx, &number, value);
+		result = std::uint64_t(number);
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] PeerData *PeerFromInput(
+		JSContext *ctx,
+		JSValueConst value,
+		not_null<Main::Session*> session) {
+	if (!JS_IsObject(value)) {
+		return nullptr;
+	}
+	auto name = JS_GetPropertyStr(ctx, value, "_");
+	const auto type = ToStd(ctx, name);
+	JS_FreeValue(ctx, name);
+	auto id = PeerId();
+	if (type == "inputPeerSelf") {
+		id = session->userPeerId();
+	} else if (const auto user = BigField(ctx, value, "userId")) {
+		id = peerFromUser(UserId(*user));
+	} else if (const auto chat = BigField(ctx, value, "chatId")) {
+		id = peerFromChat(ChatId(*chat));
+	} else if (const auto channel = BigField(ctx, value, "channelId")) {
+		id = peerFromChannel(ChannelId(*channel));
+	}
+	return id ? session->data().peerLoaded(id) : nullptr;
+}
+
+[[nodiscard]] JSValue Payload(JSContext *ctx, const char *kind) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "kind", JS_NewString(ctx, kind));
+	return result;
+}
+
+[[nodiscard]] JSValue CallPayload(
+		JSContext *ctx,
+		const char *kind,
+		int callId) {
+	auto result = Payload(ctx, kind);
+	JS_SetPropertyStr(ctx, result, "callId", JS_NewInt32(ctx, callId));
+	return result;
+}
+
+[[nodiscard]] std::optional<Waiting> Take(int callId) {
+	auto &waiting = State().waiting;
+	const auto i = waiting.find(callId);
+	if (i == end(waiting)) {
+		return std::nullopt;
+	}
+	auto result = std::move(i->second);
+	waiting.erase(i);
+	return result;
+}
+
+int Ask(
+		const Entry &entry,
+		Fn<JSValue(JSContext*, int)> payload,
+		Fn<void(JSContext*, JSValueConst, int)> answer,
+		Fn<void(int)> fallback,
+		const QString &where) {
+	auto &data = State();
+	const auto callId = ++data.nextCall;
+	const auto instance = entry.instance;
+	const auto function = entry.function;
+	data.waiting.emplace(callId, Waiting{
+		.owner = entry.owner,
+		.answer = std::move(answer),
+		.fallback = std::move(fallback),
+	});
+	base::call_delayed(kAnswerTimeout, [=] {
+		if (const auto waiting = Take(callId)) {
+			waiting->fallback(callId);
+		}
+	});
+	CallKept(instance, function, [=](JSContext *ctx) {
+		return payload(ctx, callId);
+	}, where);
+	return callId;
+}
+
+void SendCancel(int provider, int callId) {
+	crl::on_main([=] {
+		const auto &entries = State().entries;
+		const auto i = entries.find(provider);
+		if (i == end(entries)) {
+			return;
+		}
+		CallKept(i->second.instance, i->second.function, [=](JSContext *ctx) {
+			return CallPayload(ctx, "cancel", callId);
+		}, u"search provider"_q);
+	});
+}
+
+[[nodiscard]] std::vector<Result> ParseResults(
+		JSContext *ctx,
+		JSValueConst value,
+		not_null<Main::Session*> session) {
+	auto result = std::vector<Result>();
+	auto length = std::int64_t();
+	if (!JS_IsArray(value)) {
+		return result;
+	} else if (JS_GetLength(ctx, value, &length) < 0) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return result;
+	}
+	const auto count = int(std::min(length, std::int64_t(kMaxResults)));
+	for (auto i = 0; i != count; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, value, std::uint32_t(i));
+		if (JS_IsObject(item)) {
+			auto title = StringProperty(ctx, item, "title");
+			if (!title.trimmed().isEmpty()) {
+				auto peer = JS_GetPropertyStr(ctx, item, "peer");
+				const auto messageId = NumberProperty(ctx, item, "messageId");
+				result.push_back({
+					.title = std::move(title),
+					.subtitle = StringProperty(ctx, item, "subtitle"),
+					.peer = PeerFromInput(ctx, peer, session),
+					.messageId = (messageId && *messageId > 0)
+						? MsgId(std::int64_t(*messageId))
+						: MsgId(),
+					.index = i,
+					.click = BoolProperty(ctx, item, "click"),
+				});
+				JS_FreeValue(ctx, peer);
+			}
+		}
+		JS_FreeValue(ctx, item);
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<FullMsgId> PickIds(
+		JSContext *ctx,
+		JSValueConst value,
+		const std::vector<FullMsgId> &ids) {
+	auto length = std::int64_t();
+	if (!JS_IsArray(value)) {
+		return ids;
+	} else if (JS_GetLength(ctx, value, &length) < 0) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return ids;
+	}
+	auto result = std::vector<FullMsgId>();
+	auto used = base::flat_set<int>();
+	for (auto i = std::int64_t(); i != length; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, value, std::uint32_t(i));
+		auto index = 0;
+		if (JS_IsNumber(item)
+			&& !JS_ToInt32(ctx, &index, item)
+			&& index >= 0
+			&& index < int(ids.size())
+			&& !used.contains(index)) {
+			used.emplace(index);
+			result.push_back(ids[index]);
+		}
+		JS_FreeValue(ctx, item);
+	}
+	return result;
+}
