+
+void AddStoryActions(
+		const Ui::Menu::MenuCallback &addAction,
+		Data::Story *story) {
+	if (!story) {
+		return;
+	}
+	const auto session = &story->session();
+	const auto peer = MarkedId(story->peer()->id);
+	const auto storyId = story->id();
+	for (const auto &action : StoriesRegistry().actions) {
+		const auto strong = action.owned.weak.get();
+		if (!strong || ScriptSession(strong).get() != session) {
+			continue;
+		}
+		const auto weak = action.owned.weak;
+		const auto kept = action.owned.kept;
+		addAction(action.text, [=] {
+			crl::on_main([=] {
+				CallKept(weak, kept, [=](JSContext *ctx) {
+					auto result = JS_NewObject(ctx);
+					JS_SetPropertyStr(
+						ctx,
+						result,
+						"peer",
+						JS_NewBigInt64(ctx, peer));
+					JS_SetPropertyStr(
+						ctx,
+						result,
+						"storyId",
+						JS_NewInt32(ctx, storyId));
+					return result;
+				}, u"tg.stories.registerStoryAction"_q);
+			});
+		}, &st::mediaMenuIconExperimental);
+	}
+}
+
+bool InterceptStoryView(
+		not_null<Main::Session*> session,
+		FullStoryId id,
+		bool viewed) {
+	if (id.peer == session->userPeerId()) {
+		return false;
+	}
+	auto list = std::vector<Owned>();
+	for (const auto &entry : StoriesRegistry().interceptors) {
+		const auto strong = entry.weak.get();
+		if (strong && ScriptSession(strong) == session) {
+			list.push_back(entry);
+		}
+	}
+	if (list.empty()) {
+		return false;
+	}
+	const auto weak = base::make_weak(session);
+	auto chain = std::make_shared<ViewChain>(ViewChain{
+		.list = std::move(list),
+		.info = InfoOf(session, id),
+		.done = [=](bool skip) {
+			const auto strong = weak.get();
+			if (!strong) {
+				return;
+			} else if (skip) {
+				Tele::RememberStoryRead(strong, id);
+				ApplyRead(strong, id.peer, id.story);
+			} else {
+				strong->data().stories().markAsRead(id, viewed);
+			}
+		},
+	});
+	crl::on_main([=] {
+		Ask(chain, 0);
+	});
+	return true;
+}
