+class Host final : public base::has_weak_ptr {
+public:
+	explicit Host(DialogsDescriptor &&descriptor);
+	~Host();
+
+	[[nodiscard]] not_null<Main::Session*> session() const;
+	void searchChanged(const QString &query, PeerData *inChat);
+	void providersChanged();
+	void providerRemoved(int provider);
+
+private:
+	void runSearch();
+	void cancelPending();
+	void applyResults(
+		int provider,
+		int generation,
+		int callId,
+		std::vector<Result> results);
+	void clicked(int provider, int callId, const Result &result);
+	void rebuildResults();
+	void refreshBanners();
+	void updateBannersShown();
+
+	const not_null<QWidget*> _widget;
+	const not_null<Window::SessionController*> _controller;
+	const not_null<Ui::VerticalLayout*> _list;
+	Ui::VerticalLayout *_results = nullptr;
+	Ui::SlideWrap<Ui::VerticalLayout> *_banners = nullptr;
+	QString _query;
+	PeerData *_inChat = nullptr;
+	int _generation = 0;
+	base::Timer _debounce;
+	std::vector<std::pair<int, int>> _pending;
+	std::vector<Block> _blocks;
+	rpl::lifetime _lifetime;
+
+};
+
+Host::Host(DialogsDescriptor &&descriptor)
+: _widget(descriptor.widget)
+, _controller(descriptor.controller)
+, _list(descriptor.list)
+, _debounce([=] { runSearch(); }) {
+	State().hosts.emplace(_widget, this);
+	_results = _list->insert(
+		IndexOf(_list, descriptor.inner),
+		object_ptr<Ui::VerticalLayout>(_list.get()));
+	if (descriptor.banners) {
+		_banners = _list->insert(
+			IndexOf(_list, _results),
+			object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+				_list.get(),
+				object_ptr<Ui::VerticalLayout>(_list.get())));
+		_banners->toggle(false, anim::type::instant);
+		State().bannersChanged.events(
+		) | rpl::on_next([=] {
+			refreshBanners();
+		}, _lifetime);
+		refreshBanners();
+	}
+}
+
+Host::~Host() {
+	State().hosts.remove(_widget);
+}
+
+not_null<Main::Session*> Host::session() const {
+	return &_controller->session();
+}
+
+void Host::searchChanged(const QString &query, PeerData *inChat) {
+	const auto trimmed = query.trimmed();
+	if (trimmed == _query && inChat == _inChat) {
+		return;
+	}
+	_query = trimmed;
+	_inChat = inChat;
+	++_generation;
+	cancelPending();
+	updateBannersShown();
+	if (_query.isEmpty()) {
+		_debounce.cancel();
+		_blocks.clear();
+		rebuildResults();
+		return;
+	}
+	providersChanged();
+}
+
+void Host::providersChanged() {
+	if (_query.isEmpty()) {
+		return;
+	}
+	const auto session = this->session();
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.kind == Kind::Provider && entry.session == session) {
+			_debounce.callOnce(kDebounce);
+			return;
+		}
+	}
+	_debounce.cancel();
+	if (!_blocks.empty()) {
+		_blocks.clear();
+		rebuildResults();
+	}
+}
+
+void Host::providerRemoved(int provider) {
+	const auto i = ranges::find(_blocks, provider, &Block::provider);
+	if (i != end(_blocks)) {
+		_blocks.erase(i);
+		rebuildResults();
+	}
+}
+
+void Host::runSearch() {
+	cancelPending();
+	const auto session = this->session();
+	auto providers = std::vector<std::pair<int, Entry>>();
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.kind == Kind::Provider && entry.session == session) {
+			providers.emplace_back(id, entry);
+		}
+	}
+	const auto weak = base::make_weak(this);
+	const auto generation = _generation;
+	const auto query = _query;
+	const auto chatId = _inChat
+		? std::make_optional(MarkedId(_inChat->id))
+		: std::nullopt;
+	const auto sessionWeak = base::make_weak(session);
+	for (const auto &[provider, entry] : providers) {
+		const auto id = provider;
+		const auto asked = Ask(entry, [=](JSContext *ctx, int callId) {
+			auto result = CallPayload(ctx, "search", callId);
+			JS_SetPropertyStr(ctx, result, "query", NewString(ctx, query));
+			if (chatId) {
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"chatId",
+					JS_NewBigInt64(ctx, *chatId));
+			}
+			return result;
+		}, [=](JSContext *ctx, JSValueConst value, int callId) {
+			const auto strong = sessionWeak.get();
+			const auto results = strong
+				? ParseResults(ctx, value, strong)
+				: std::vector<Result>();
+			crl::on_main(weak, [=] {
+				if (const auto host = weak.get()) {
+					host->applyResults(id, generation, callId, results);
+				}
+			});
+		}, [=](int callId) {
+			SendCancel(id, callId);
+			if (const auto host = weak.get()) {
+				host->applyResults(id, generation, callId, {});
+			}
+		}, u"search provider"_q);
+		if (State().waiting.contains(asked)) {
+			_pending.emplace_back(asked, id);
+		}
+	}
+}
+
+void Host::cancelPending() {
+	for (const auto &[callId, provider] : base::take(_pending)) {
+		if (Take(callId)) {
+			SendCancel(provider, callId);
+		}
+	}
+}
+
+void Host::applyResults(
+		int provider,
+		int generation,
+		int callId,
+		std::vector<Result> results) {
+	if (generation != _generation) {
+		return;
+	}
+	const auto &entries = State().entries;
+	const auto entry = entries.find(provider);
+	const auto i = ranges::find(_blocks, provider, &Block::provider);
+	if (entry == end(entries) || results.empty()) {
+		if (i == end(_blocks)) {
+			return;
+		}
+		_blocks.erase(i);
+	} else {
+		auto block = Block{
+			.provider = provider,
+			.callId = callId,
+			.title = entry->second.text,
+			.results = std::move(results),
+		};
+		if (i != end(_blocks)) {
+			*i = std::move(block);
+		} else {
+			const auto before = ranges::find_if(_blocks, [&](const Block &b) {
+				return b.provider > provider;
+			});
+			_blocks.insert(before, std::move(block));
+		}
+	}
+	rebuildResults();
+}
+
+void Host::clicked(int provider, int callId, const Result &result) {
+	if (const auto peer = result.peer) {
+		_controller->showPeerHistory(
+			peer,
+			Window::SectionShow::Way::ClearStack,
+			result.messageId ? result.messageId : ShowAtUnreadMsgId);
+	}
+	if (!result.click) {
+		return;
+	}
+	const auto &entries = State().entries;
+	const auto i = entries.find(provider);
+	if (i == end(entries)) {
+		return;
+	}
+	const auto index = result.index;
+	CallKept(i->second.instance, i->second.function, [=](JSContext *ctx) {
+		auto payload = CallPayload(ctx, "click", callId);
+		JS_SetPropertyStr(ctx, payload, "index", JS_NewInt32(ctx, index));
+		return payload;
+	}, u"search provider"_q);
+}
+
+void Host::rebuildResults() {
+	_results->clear();
+	if (_query.isEmpty()) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	for (const auto &block : _blocks) {
+		AddHeader(_results, block.title);
+		const auto provider = block.provider;
+		const auto callId = block.callId;
+		for (const auto &result : block.results) {
+			const auto row = _results->add(
+				object_ptr<ResultRow>(_results, result));
+			row->setClickedCallback([=] {
+				crl::on_main(weak, [=] {
+					if (const auto host = weak.get()) {
+						host->clicked(provider, callId, result);
+					}
+				});
+			});
+		}
+	}
+}
+
+void Host::refreshBanners() {
+	const auto layout = _banners->entity();
+	layout->clear();
+	const auto session = this->session();
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.kind != Kind::Banner || entry.session != session) {
+			continue;
+		}
+		const auto banner = id;
+		layout->add(object_ptr<BannerBar>(layout, entry, [=](int index) {
+			crl::on_main([=] { PressBanner(banner, index); });
+		}, [=] {
+			crl::on_main([=] { CloseBanner(banner); });
+		}));
+	}
+	updateBannersShown();
+}
+
+void Host::updateBannersShown() {
+	if (_banners) {
+		_banners->toggle(
+			_query.isEmpty()
+				&& !_inChat
+				&& (_banners->entity()->count() > 0),
+			anim::type::instant);
+	}
+}
+
+void ProvidersChanged(Main::Session *session) {
+	auto hosts = std::vector<base::weak_ptr<Host>>();
+	for (const auto &[widget, host] : State().hosts) {
+		if (host->session() == session) {
+			hosts.push_back(base::make_weak(host));
+		}
+	}
+	for (const auto &weak : hosts) {
+		if (const auto host = weak.get()) {
+			host->providersChanged();
+		}
+	}
+}
+
+void ProviderRemoved(int provider) {
+	auto hosts = std::vector<base::weak_ptr<Host>>();
+	for (const auto &[widget, host] : State().hosts) {
+		hosts.push_back(base::make_weak(host));
+	}
+	for (const auto &weak : hosts) {
+		if (const auto host = weak.get()) {
+			host->providerRemoved(provider);
+		}
+	}
+}
+
+void RemoveOwner(Instance *owner) {
+	auto &data = State();
+	data.tracked.remove(owner);
+	auto banners = false;
+	auto providers = std::vector<int>();
+	for (auto i = begin(data.entries); i != end(data.entries);) {
+		if (i->second.owner != owner) {
+			++i;
+			continue;
+		}
+		if (i->second.kind == Kind::Banner) {
+			banners = true;
+		} else if (i->second.kind == Kind::Provider) {
+			providers.push_back(i->first);
+		}
+		i = data.entries.erase(i);
+	}
+	auto fallbacks = std::vector<std::pair<int, Fn<void(int)>>>();
+	for (auto i = begin(data.waiting); i != end(data.waiting);) {
+		if (i->second.owner == owner) {
+			fallbacks.emplace_back(i->first, std::move(i->second.fallback));
+			i = data.waiting.erase(i);
+		} else {
+			++i;
+		}
+	}
+	for (auto &[callId, fallback] : fallbacks) {
+		crl::on_main([callId, fallback = std::move(fallback)] {
+			fallback(callId);
+		});
+	}
+	if (banners) {
+		data.bannersChanged.fire({});
+	}
+	for (const auto provider : providers) {
+		ProviderRemoved(provider);
+	}
+}
+
+void Track(not_null<Instance*> instance) {
+	auto &data = State();
+	const auto raw = instance.get();
+	if (data.tracked.contains(raw)) {
+		return;
+	}
+	data.tracked.emplace(raw);
+	ScriptLifetime(instance).add([=] {
+		RemoveOwner(raw);
+	});
+}
+
+[[nodiscard]] int Add(
+		not_null<Instance*> instance,
+		Entry entry,
+		JSValueConst function) {
+	entry.owner = instance.get();
+	entry.instance = base::make_weak(instance.get());
+	entry.session = ScriptSession(instance);
+	entry.function = KeepFunction(instance, function);
+	Track(instance);
+	auto &data = State();
+	const auto id = ++data.nextEntry;
+	const auto kind = entry.kind;
+	const auto session = entry.session;
+	data.entries.emplace(id, std::move(entry));
+	if (kind == Kind::Banner) {
+		data.bannersChanged.fire({});
+	} else if (kind == Kind::Provider) {
+		ProvidersChanged(session);
+	}
+	return id;
+}
+
+void Remove(not_null<Instance*> instance, int id) {
+	auto &data = State();
+	const auto i = data.entries.find(id);
+	if (i == end(data.entries) || i->second.owner != instance.get()) {
+		return;
+	}
+	const auto kind = i->second.kind;
+	const auto weak = i->second.instance;
+	const auto function = i->second.function;
+	data.entries.erase(i);
+	ForgetKept(weak, function);
+	if (kind == Kind::Banner) {
+		data.bannersChanged.fire({});
+	} else if (kind == Kind::Provider) {
+		ProviderRemoved(id);
+	}
+}
+
+[[nodiscard]] JSValue Answer(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	auto callId = 0;
+	if (!instance || argc < 1 || JS_ToInt32(ctx, &callId, argv[0]) < 0) {
+		return JS_UNDEFINED;
+	}
+	const auto &waiting = State().waiting;
+	const auto i = waiting.find(callId);
+	if (i == end(waiting) || i->second.owner != instance) {
+		return JS_UNDEFINED;
+	}
+	if (const auto taken = Take(callId)) {
+		taken->answer(ctx, (argc > 1) ? argv[1] : JS_UNDEFINED, callId);
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue RegisterProvider(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 2
+		|| !JS_IsString(argv[0])
+		|| !JS_IsFunction(ctx, argv[1])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.registerSearchProvider({ title, search })");
+	}
+	const auto title = FromStd(ToStd(ctx, argv[0])).trimmed();
+	if (title.isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.registerSearchProvider: title must be a non-empty string");
+	}
+	return JS_NewInt32(ctx, Add(instance, Entry{
+		.kind = Kind::Provider,
+		.text = title.left(kMaxTitle),
+	}, argv[1]));
+}
+
+[[nodiscard]] JSValue InterceptSearch(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"messages",
+		"tg.interceptSearch");
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.interceptSearch(function)");
+	}
+	return JS_NewInt32(ctx, Add(instance, Entry{
+		.kind = Kind::Interceptor,
+	}, argv[0]));
+}
+
+[[nodiscard]] JSValue Banner(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 2
+		|| !JS_IsObject(argv[0])
+		|| !JS_IsFunction(ctx, argv[1])) {
+		return JS_ThrowTypeError(ctx, "tg.ui.banner(options)");
+	}
+	auto entry = Entry{
+		.kind = Kind::Banner,
+		.text = StringProperty(ctx, argv[0], "text"),
+		.icon = StringProperty(ctx, argv[0], "icon"),
+		.closable = BoolProperty(ctx, argv[0], "closable"),
+	};
+	if (entry.text.trimmed().isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.banner: text must be a non-empty string");
+	}
+	auto buttons = JS_GetPropertyStr(ctx, argv[0], "buttons");
+	auto length = std::int64_t();
+	if (JS_IsArray(buttons) && !JS_GetLength(ctx, buttons, &length)) {
+		const auto count = int(std::min(length, std::int64_t(kMaxButtons)));
+		for (auto i = 0; i != count; ++i) {
+			auto button = JS_GetPropertyUint32(ctx, buttons, std::uint32_t(i));
+			if (JS_IsString(button)) {
+				entry.buttons.push_back(FromStd(ToStd(ctx, button)));
+			}
+			JS_FreeValue(ctx, button);
+		}
+	}
+	JS_FreeValue(ctx, buttons);
+	return JS_NewInt32(ctx, Add(instance, std::move(entry), argv[1]));
+}
+
+JSValue NativeDialogs(
+		JSContext *ctx,
+		JSValueConst thisValue,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case 0: return RegisterProvider(ctx, argc, argv);
+	case 1: return InterceptSearch(ctx, argc, argv);
+	case 2: return Banner(ctx, argc, argv);
+	case 3: {
+		const auto instance = Instance::From(ctx);
+		auto id = 0;
+		if (instance
+			&& argc > 0
+			&& JS_IsNumber(argv[0])
+			&& !JS_ToInt32(ctx, &id, argv[0])) {
+			Remove(instance, id);
+		}
+		return JS_UNDEFINED;
+	}
+	case 4: return Answer(ctx, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+struct Chain {
+	base::weak_ptr<Main::Session> session;
+	QString query;
+	std::optional<std::int64_t> chatId;
+	std::vector<FullMsgId> ids;
+	FullMsgId inject;
+	std::vector<int> interceptors;
+	int index = 0;
+	Fn<void(std::vector<not_null<HistoryItem*>>, HistoryItem*)> done;
+};
+
+[[nodiscard]] JSValue SearchedMessage(
+		JSContext *ctx,
+		not_null<HistoryItem*> item) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(item->history()->peer->id)));
+	JS_SetPropertyStr(ctx, result, "id", JS_NewInt64(ctx, item->id.bare));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"text",
+		NewString(ctx, item->originalText().text));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"date",
+		JS_NewDate(ctx, double(item->date()) * 1000.));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"fromId",
+		JS_NewBigInt64(ctx, MarkedId(item->from()->id)));
+	return result;
+}
+
+void Step(std::shared_ptr<Chain> chain) {
+	const auto session = chain->session.get();
+	if (!session) {
+		return;
+	}
+	const auto &entries = State().entries;
+	while (chain->index < int(chain->interceptors.size())) {
+		const auto i = entries.find(chain->interceptors[chain->index++]);
+		if (i == end(entries) || !i->second.instance.get()) {
+			continue;
+		}
+		const auto ids = chain->ids;
+		if (ids.empty()) {
+			break;
+		}
+		Ask(i->second, [=](JSContext *ctx, int callId) {
+			auto result = CallPayload(ctx, "search", callId);
+			JS_SetPropertyStr(
+				ctx,
+				result,
+				"query",
+				NewString(ctx, chain->query));
+			if (chain->chatId) {
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"chatId",
+					JS_NewBigInt64(ctx, *chain->chatId));
+			}
+			auto list = JS_NewArray(ctx);
+			if (const auto strong = chain->session.get()) {
+				auto index = std::uint32_t();
+				for (const auto &id : ids) {
+					if (const auto item = strong->data().message(id)) {
+						JS_SetPropertyUint32(
+							ctx,
+							list,
+							index++,
+							SearchedMessage(ctx, item));
+					}
+				}
+			}
+			JS_SetPropertyStr(ctx, result, "results", list);
+			return result;
+		}, [=](JSContext *ctx, JSValueConst value, int) {
+			chain->ids = PickIds(ctx, value, ids);
+			crl::on_main([=] { Step(chain); });
+		}, [=](int) {
+			Step(chain);
+		}, u"tg.interceptSearch"_q);
+		return;
+	}
+	auto items = std::vector<not_null<HistoryItem*>>();
+	items.reserve(chain->ids.size());
+	for (const auto &id : chain->ids) {
+		if (const auto item = session->data().message(id)) {
+			items.push_back(item);
+		}
+	}
+	const auto inject = chain->inject
+		? session->data().message(chain->inject)
+		: nullptr;
+	chain->done(std::move(items), inject);
+}
+
+} // namespace
+
+void AddDialogsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "dialogsRegisterProvider", NativeDialogs, 2, 0 },
+		{ "dialogsInterceptSearch", NativeDialogs, 1, 1 },
+		{ "dialogsBanner", NativeDialogs, 2, 2 },
+		{ "dialogsRemove", NativeDialogs, 1, 3 },
+		{ "dialogsAnswer", NativeDialogs, 2, 4 },
+	});
+}
+
+void SetupDialogs(DialogsDescriptor &&descriptor) {
+	const auto widget = descriptor.widget;
+	widget->lifetime().make_state<Host>(std::move(descriptor));
+}
+
+void DialogsSearchChanged(
+		not_null<QWidget*> widget,
+		const QString &query,
+		PeerData *inChat) {
+	if (const auto host = LookupHost(widget)) {
+		host->searchChanged(query, inChat);
+	}
+}
+
+void InterceptDialogsSearch(
+		not_null<Main::Session*> session,
+		const QString &query,
+		PeerData *inChat,
+		std::vector<not_null<HistoryItem*>> items,
+		HistoryItem *inject,
+		Fn<void(std::vector<not_null<HistoryItem*>>, HistoryItem*)> done) {
+	auto interceptors = std::vector<int>();
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.kind == Kind::Interceptor && entry.session == session) {
+			interceptors.push_back(id);
+		}
+	}
+	if (interceptors.empty() || items.empty()) {
+		done(std::move(items), inject);
+		return;
+	}
+	auto ids = std::vector<FullMsgId>();
+	ids.reserve(items.size());
+	for (const auto &item : items) {
+		ids.push_back(item->fullId());
+	}
+	auto chain = std::make_shared<Chain>(Chain{
+		.session = base::make_weak(session),
+		.query = query,
+		.chatId = inChat
+			? std::make_optional(MarkedId(inChat->id))
+			: std::nullopt,
+		.ids = std::move(ids),
+		.inject = inject ? inject->fullId() : FullMsgId(),
+		.interceptors = std::move(interceptors),
+		.done = std::move(done),
+	});
+	crl::on_main([=] { Step(chain); });
+}
+
+std::string_view DialogsTypings() {
+	return R"TS(
+declare module 'tele' {
+  export interface SearchProviderResult {
+    title: string
+    subtitle?: string
+    peer?: InputPeerLike
+    messageId?: number
+    onClick?(): unknown
+  }
+
+  export interface SearchProviderContext {
+    readonly chatId?: bigint
+    readonly signal: AbortSignal
+  }
+
+  export interface SearchProvider {
+    title: string
+    search(
+      query: string,
+      context: SearchProviderContext,
+    ):
+      | readonly SearchProviderResult[]
+      | null
+      | void
+      | Promise<readonly SearchProviderResult[] | null | void>
+  }
+
+  export interface SearchedMessage {
+    readonly chatId: bigint
+    readonly id: number
+    readonly text: string
+    readonly date: Date
+    readonly fromId: bigint
+  }
+
+  export interface SearchInterception {
+    readonly query: string
+    readonly chatId?: bigint
+    readonly results: SearchedMessage[]
+  }
+
+  export type SearchInterceptor = (
+    search: SearchInterception,
+  ) =>
+    | readonly SearchedMessage[]
+    | null
+    | void
+    | Promise<readonly SearchedMessage[] | null | void>
+
+  export interface Ui {
+    registerSearchProvider(provider: SearchProvider): Disposer
+  }
+
+  export interface Tg {
+    interceptSearch(interceptor: SearchInterceptor): Disposer
+  }
+}
+)TS";
+}
+
