+[[nodiscard]] std::shared_ptr<Updates> AcquireUpdates() {
+	auto &weak = UpdatesInstance();
+	if (auto strong = weak.lock()) {
+		return strong;
+	}
+	auto result = std::make_shared<Updates>();
+	weak = result;
+	return result;
+}
