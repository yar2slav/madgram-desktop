--- /dev/null
+++ b/Telegram/Resources/tele/scripting/panels.js
@@ -0,0 +1,97 @@
+(() => {
+	const STICKERS = 0;
+	const EMOJI = 1;
+	const GIFS = 2;
+
+	globalThis.__teleExtensions.push({
+		name: 'panels',
+		tg(tg, natives) {
+			const report = (what, error) => {
+				console.error(`${what}: ${error?.stack ?? error}`);
+			};
+			const titleOf = (what, options) => {
+				if (typeof options.title !== 'string' || !options.title) {
+					throw new TypeError(`${what}: title is a non-empty string`);
+				}
+				return options.title;
+			};
+			const listOf = (what, value) => {
+				if (!Array.isArray(value)) {
+					throw new TypeError(`${what} must return an array`);
+				}
+				return value;
+			};
+			const idsOf = (list) => list.map((id, index) => {
+				if (typeof id === 'bigint') {
+					return id;
+				} else if (typeof id === 'string' && /^-?\d+$/.test(id)) {
+					return BigInt(id);
+				}
+				throw new TypeError(`tg.ui.registerEmojiSet: emoji ${index} is not a custom emoji id (a bigint or a string of digits)`);
+			});
+			const define = (name, value) => {
+				Object.defineProperty(tg.ui, name, { value, enumerable: true });
+			};
+
+			define('registerStickerSet', (options) => {
+				const what = 'tg.ui.registerStickerSet';
+				if (typeof options?.stickers !== 'function') {
+					throw new TypeError(`${what}({ title, icon?, stickers: () => [...] })`);
+				}
+				const title = titleOf(what, options);
+				const icon = options.icon ?? 0;
+				if (!Number.isInteger(icon) || icon < 0) {
+					throw new TypeError(`${what}: icon is the index of a sticker`);
+				}
+				const id = natives.panelsRegister(STICKERS, title, null);
+				(async () => {
+					const stickers = listOf(`${what}: stickers()`, await options.stickers());
+					const shown = natives.panelsFill(id, stickers, icon);
+					if (typeof shown === 'number' && shown < stickers.length) {
+						console.warn(`${what}: ${stickers.length - shown} of ${stickers.length} stickers are input documents tele doesn't know, they are skipped`);
+					}
+				})().catch((error) => report(what, error));
+				return __teleDisposer(() => natives.panelsRemove(id));
+			});
+
+			define('registerEmojiSet', (options) => {
+				const what = 'tg.ui.registerEmojiSet';
+				if (typeof options?.emoji !== 'function') {
+					throw new TypeError(`${what}({ title, emoji: () => [...] })`);
+				}
+				const title = titleOf(what, options);
+				const id = natives.panelsRegister(EMOJI, title, null);
+				(async () => {
+					const ids = idsOf(listOf(`${what}: emoji()`, await options.emoji()));
+					natives.panelsFill(id, ids, 0);
+				})().catch((error) => report(what, error));
+				return __teleDisposer(() => natives.panelsRemove(id));
+			});
+
+			define('registerGifSource', (options) => {
+				const what = 'tg.ui.registerGifSource';
+				if (typeof options?.search !== 'function') {
+					throw new TypeError(`${what}({ title, search: (query) => [...] })`);
+				}
+				const title = titleOf(what, options);
+				const answer = (callId, results) => {
+					try {
+						natives.panelsAnswer(callId, results);
+					} catch (error) {
+						report(what, error);
+						natives.panelsAnswer(callId, []);
+					}
+				};
+				const id = natives.panelsRegister(GIFS, title, ({ callId, query }) => {
+					(async () => listOf(`${what}: search()`, await options.search(query)))().then(
+						(results) => answer(callId, results),
+						(error) => {
+							report(what, error);
+							answer(callId, []);
+						});
+				});
+				return __teleDisposer(() => natives.panelsRemove(id));
+			});
+		},
+	});
+})();
