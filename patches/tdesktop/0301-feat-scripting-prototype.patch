+			Lower(u"Act as you: send, edit, delete and forward messages, "
+				"react, read chats, type, change drafts and notification "
+				"settings and post stories (not your gifts: they need "
+				"their own grant)."_q),
+			Lower(u"Act as you: %1."_q),
