+void EditUpdateLink(
+		std::shared_ptr<Manager> manager,
+		const QString &id,
+		const QString &current) {
+	manager->show->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(Lower(u"Update link"_q)));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"A direct link to the newest version of this .ts or "
+				".js file. tele checks it when you open the Scripts "
+				"manager and every 6 hours, and offers an update when "
+				"its version is newer. Leave it empty to stop checking."_q),
+			st::boxDividerLabel));
+		Ui::AddSkip(box->verticalLayout());
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(u"https://example.com/script.ts"_q)));
+		if (!current.isEmpty()) {
+			field->setText(current);
+			field->setCursorPosition(int(current.size()));
+		}
+		box->setFocusCallback([=] {
+			field->setFocusFast();
+		});
+		const auto submit = [=] {
+			const auto text = field->getLastText().trimmed();
+			if (text.isEmpty()) {
+				box->closeBox();
+				SetScriptSource(id, QString());
+				return;
+			}
+			const auto url = ParseLink(text);
+			if (!url) {
+				field->showError();
+				return;
+			}
+			box->closeBox();
+			const auto link = url->toString();
+			if (link == current) {
+				return;
+			}
+			SetScriptSource(id, link);
+			CheckScriptUpdates(id, [=](QString error) {
+				ReportCheck(manager, id, error);
+			});
+		};
+		field->submits() | rpl::on_next(submit, field->lifetime());
+		box->addButton(rpl::single(Lower(u"Save"_q)), submit);
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
