+[[nodiscard]] bool FolderExists(
+		not_null<Main::Session*> session,
+		FilterId id) {
+	return ranges::contains(
+		session->data().chatsFilters().list(),
+		id,
+		&Data::ChatFilter::id);
+}
+
+[[nodiscard]] DecodeFilter FilterFor(not_null<Instance*> instance) {
+	const auto &permissions = instance->permissions();
+	const auto unfiltered = permissions.any(Capability::DisableApiFiltering);
+	return {
+		.sensitive = !unfiltered,
+		.drafts = !unfiltered
+			&& !permissions.allows(Capability::AccountRead, "draft"),
+	};
+}
+
+[[nodiscard]] std::string Serialized(const MTPMessage &message) {
+	auto buffer = mtpBuffer();
+	message.write(buffer);
+	return std::string(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(mtpPrime));
+}
+
+[[nodiscard]] std::string Synthesized(
+		not_null<HistoryItem*> item,
+		const TextWithEntities &text,
+		TimeId editDate) {
+	using MessageFlag = MTPDmessage::Flag;
+	const auto session = &item->history()->session();
+	const auto entities = Api::EntitiesToMTP(
+		session,
+		text.entities,
+		Api::ConvertOption::SkipLocal);
+	const auto flags = MessageFlag::f_from_id
+		| (item->out() ? MessageFlag::f_out : MessageFlag())
+		| (item->isPost() ? MessageFlag::f_post : MessageFlag())
+		| (entities.v.isEmpty() ? MessageFlag() : MessageFlag::f_entities)
+		| (editDate ? MessageFlag::f_edit_date : MessageFlag());
+	return Serialized(MTP_message(
+		MTP_flags(flags),
+		MTP_int(int(item->id.bare)),
+		peerToMTP(item->from()->id),
+		MTPint(),
+		MTPstring(),
+		peerToMTP(item->history()->peer->id),
+		MTPPeer(),
+		MTPMessageFwdHeader(),
+		MTPlong(),
+		MTPlong(),
+		MTPPeer(),
+		MTPMessageReplyHeader(),
+		MTP_int(item->date()),
+		MTP_string(text.text),
+		MTPMessageMedia(),
+		MTPReplyMarkup(),
+		entities,
+		MTPint(),
+		MTPint(),
+		MTPMessageReplies(),
+		MTP_int(editDate),
+		MTPstring(),
+		MTPlong(),
+		MTPMessageReactions(),
+		MTPVector<MTPRestrictionReason>(),
+		MTPint(),
+		MTPint(),
+		MTPlong(),
+		MTPFactCheck(),
+		MTPint(),
+		MTPlong(),
+		MTPSuggestedPost(),
+		MTPint(),
+		MTPstring(),
+		MTPRichMessage()));
+}
+
+[[nodiscard]] JSValue DecodeMessage(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		std::string_view bytes) {
+	auto decoded = DecodeTl(ctx, bytes, "Message", FilterFor(instance));
+	if (!decoded.error.empty()) {
+		JS_FreeValue(ctx, decoded.value);
+		return JS_NULL;
+	}
+	return decoded.value;
+}
+
+[[nodiscard]] JSValue KeptRaw(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		not_null<HistoryItem*> item) {
+	const auto session = &item->history()->session();
+	const auto cached = CachedMessage(
+		session,
+		item->history()->peer->id,
+		item->id);
+	if (cached) {
+		auto result = DecodeMessage(ctx, instance, *cached);
+		if (!JS_IsNull(result)) {
+			return result;
+		}
+	}
+	return DecodeMessage(
+		ctx,
+		instance,
+		Synthesized(item, item->originalText(), TimeId()));
+}
+
+[[nodiscard]] const char *RefusalCode(const QString &type) {
+	return (type.contains(u"TOO_MUCH"_q) || type.startsWith(u"FLOOD"_q))
+		? "quota-exceeded"
+		: "forbidden";
+}
+
+void ForgetInstance(const Instance *owner) {
+	auto &registry = Get();
+	registry.hooked.erase(owner);
+	for (auto i = begin(registry.listeners); i != end(registry.listeners);) {
+		if (i->second.owner == owner) {
+			i = registry.listeners.erase(i);
+		} else {
+			++i;
+		}
+	}
+	for (auto i = begin(registry.verdicts); i != end(registry.verdicts);) {
+		if (i->second.owner == owner) {
+			i = registry.verdicts.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+void Discard(not_null<Main::Session*> session, FullMsgId id) {
+	const auto item = session->data().message(id);
+	if (!item || !IsKeptDeleted(item)) {
+		return;
+	}
+	const auto history = item->history();
+	const auto wasLast = (history->lastMessage() == item);
+	const auto wasInChats = (history->chatListMessage() == item);
+	UnkeepDeleted(item);
+	session->data().notifyItemsAboutToBeDestroyed({ item });
+	item->destroy();
+	if (wasLast || wasInChats) {
+		history->requestChatListMessage();
+	}
+}
+
+void DispatchKept(
+		not_null<Main::Session*> session,
+		const std::vector<FullMsgId> &ids,
+		bool own) {
+	struct Target {
+		base::weak_ptr<Instance> instance;
+		const Instance *owner = nullptr;
+		int kept = 0;
+		bool intercept = false;
+	};
+	auto targets = std::vector<Target>();
+	for (const auto &[kept, listener] : Get().listeners) {
+		if (listener.session == session.get()
+			&& listener.kind != ListenerKind::Bookmarks) {
+			targets.push_back({
+				.instance = listener.instance,
+				.owner = listener.owner,
+				.kept = kept,
+				.intercept = (listener.kind == ListenerKind::Intercept),
+			});
+		}
+	}
+	const auto weakSession = base::make_weak(session.get());
+	for (const auto &id : ids) {
+		for (const auto &target : targets) {
+			const auto item = session->data().message(id);
+			if (!item || !IsKeptDeleted(item)) {
+				break;
+			} else if (!target.instance.get()) {
+				continue;
+			}
+			auto callId = 0;
+			if (target.intercept) {
+				auto &registry = Get();
+				callId = ++registry.verdictId;
+				registry.verdicts.emplace(callId, Verdict{
+					.owner = target.owner,
+					.session = weakSession,
+					.id = id,
+				});
+				base::call_delayed(kVerdictTimeout, [=] {
+					Get().verdicts.erase(callId);
+				});
+			}
+			const auto weak = target.instance;
+			CallKept(weak, target.kept, [=](JSContext *ctx) {
+				const auto strong = weak.get();
+				const auto alive = weakSession.get();
+				const auto found = alive ? alive->data().message(id) : nullptr;
+				auto payload = JS_NewObject(ctx);
+				JS_SetPropertyStr(
+					ctx,
+					payload,
+					"chatId",
+					JS_NewBigInt64(ctx, MarkedOf(id.peer)));
+				JS_SetPropertyStr(ctx, payload, "own", JS_NewBool(ctx, own));
+				JS_SetPropertyStr(
+					ctx,
+					payload,
+					"callId",
+					JS_NewInt32(ctx, callId));
+				JS_SetPropertyStr(
+					ctx,
+					payload,
+					"raw",
+					(strong && found) ? KeptRaw(ctx, strong, found) : JS_NULL);
+				return payload;
+			}, target.intercept
+				? u"tg.tele.deleted.interceptKeep"_q
+				: u"tg.tele.deleted.onKept"_q);
+		}
+	}
+}
+
+void EnsureKeptSubscription() {
+	auto &registry = Get();
+	if (registry.subscribed) {
+		return;
+	}
+	registry.subscribed = true;
+	KeptDeletedAdded(
+	) | rpl::on_next([](const KeptDeletedEvent &event) {
+		const auto &listeners = Get().listeners;
+		const auto wanted = ranges::any_of(listeners, [](const auto &pair) {
+			return pair.second.kind != ListenerKind::Bookmarks;
+		});
+		if (!wanted || event.items.empty()) {
+			return;
+		}
+		const auto session = not_null<Main::Session*>(
+			&event.items.front()->history()->session());
+		auto ids = std::vector<FullMsgId>();
+		ids.reserve(event.items.size());
+		for (const auto &item : event.items) {
+			ids.push_back(item->fullId());
+		}
+		const auto own = event.own;
+		crl::on_main(session.get(), [=] {
+			DispatchKept(session, ids, own);
+		});
+	}, registry.lifetime);
+}
+
+[[nodiscard]] JSValue AddListener(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv,
+		ListenerKind kind,
+		const char *what) {
+	if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "%s(callback)", what);
+	}
+	const auto id = KeepFunction(instance, argv[0]);
+	if (!id) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	auto &registry = Get();
+	const auto raw = instance.get();
+	if (!registry.hooked.contains(raw)) {
+		registry.hooked.insert(raw);
+		ScriptLifetime(instance).add([=] {
+			ForgetInstance(raw);
+		});
+	}
+	auto &listener = registry.listeners[id];
+	listener.owner = raw;
+	listener.instance = base::make_weak(raw);
+	listener.session = instance->session();
+	listener.kind = kind;
+	if (kind == ListenerKind::Bookmarks) {
+		const auto weak = listener.instance;
+		BookmarksChanges(
+		) | rpl::on_next([=] {
+			crl::on_main(weak, [=] {
+				CallKept(weak, id, [](JSContext*) {
+					return JS_UNDEFINED;
+				}, u"tg.tele.bookmarks.onChange"_q);
+			});
+		}, listener.lifetime);
+	} else {
+		EnsureKeptSubscription();
+	}
+	return JS_NewInt32(ctx, id);
+}
+
+JSValue RemoveListener(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto id = std::int32_t();
+	if (argc < 1 || JS_ToInt32(ctx, &id, argv[0]) < 0) {
+		return JS_ThrowTypeError(ctx, "needs a listener id");
+	}
+	auto &listeners = Get().listeners;
+	const auto i = listeners.find(id);
+	if (i != end(listeners) && i->second.owner == instance.get()) {
+		listeners.erase(i);
+		ForgetKept(base::make_weak(instance.get()), id);
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue ChatsArray(
+		JSContext *ctx,
+		const std::vector<PeerId> &ids) {
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	for (const auto id : ids) {
+		JS_SetPropertyUint32(
+			ctx,
+			result,
+			index++,
+			JS_NewBigInt64(ctx, MarkedOf(id)));
+	}
+	return result;
+}
