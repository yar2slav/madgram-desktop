+[[nodiscard]] std::optional<ScriptState> FindScript(
+		not_null<Main::Session*> session,
+		const QString &id) {
+	auto scripts = Scripts(session);
+	const auto i = ranges::find(scripts, id, &ScriptState::id);
+	return (i != end(scripts)) ? std::make_optional(*i) : std::nullopt;
