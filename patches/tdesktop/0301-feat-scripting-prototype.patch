+		std::shared_ptr<Ui::Show> show,
+		const QString &script,
+		not_null<rpl::variable<PageRow>*> state,
+		Fn<void(QVariant)> event,
+		Fn<QString(double)> label) {
+	const auto &row = state->current();
+	const auto text = state->value() | rpl::map([](const PageRow &row) {
+		return row.text;
+	});
+	const auto addSubtitle = [&] {
+		if (!row.subtitle.isEmpty()) {
+			inner->add(
+				object_ptr<Ui::FlatLabel>(
+					inner,
+					state->value() | rpl::map([](const PageRow &row) {
+						return row.subtitle;
+					}),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+			Ui::AddSkip(inner);
+		}
+	};
+	if (row.type == u"header"_q) {
+		Ui::AddSkip(inner);
+		Ui::AddSubsectionTitle(inner, rpl::duplicate(text));
+	} else if (row.type == u"separator"_q) {
+		Ui::AddSkip(inner);
+		if (row.text.isEmpty()) {
+			Ui::AddDivider(inner);
+		} else {
+			Ui::AddDividerText(inner, rpl::duplicate(text));
+		}
+		Ui::AddSkip(inner);
+	} else if (row.type == u"button"_q) {
+		const auto button = row.value.isEmpty()
+			? Settings::AddButtonWithIcon(
+				inner,
+				rpl::duplicate(text),
+				st::settingsButtonNoIcon)
+			: Settings::AddButtonWithLabel(
+				inner,
+				rpl::duplicate(text),
+				state->value() | rpl::map([](const PageRow &row) {
+					return row.value;
+				}),
+				st::settingsButtonNoIcon);
+		button->setClickedCallback([=] { event(QVariant()); });
+		addSubtitle();
+	} else if (row.type == u"item"_q) {
+		const auto button = Settings::AddButtonWithLabel(
+			inner,
+			state->value() | rpl::map([](const PageRow &row) {
+				return row.icon.isEmpty()
+					? row.text
+					: (row.icon + u"  "_q + row.text);
+			}),
+			state->value() | rpl::map([](const PageRow &row) {
+				return row.value;
+			}),
+			st::settingsButtonNoIcon);
+		button->setClickedCallback([=] { event(QVariant()); });
+		addSubtitle();
+	} else if (row.type == u"color"_q) {
+		Settings::AddButtonWithLabel(
+			inner,
+			rpl::duplicate(text),
+			state->value() | rpl::map([](const PageRow &row) {
+				return row.value;
+			}),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			const auto now = state->current();
+			const auto current = ParseScriptColor(now.value).value_or(
+				st::windowFg->c);
+			show->show(Box([=](not_null<Ui::GenericBox*> box) {
+				box->setTitle(rpl::single(now.text.isEmpty()
+					? script
+					: now.text));
+				const auto editor = box->addRow(object_ptr<ColorEditor>(
+					box,
+					ColorEditor::Mode::RGBA,
+					current));
+				const auto save = [=] {
+					const auto value = ScriptColorText(editor->color());
+					box->closeBox();
+					if (value != state->current().value) {
+						event(value);
+					}
+				};
+				editor->submitRequests(
+				) | rpl::on_next(save, editor->lifetime());
+				box->setFocusCallback([=] {
+					editor->setInnerFocus();
+				});
+				box->addButton(tr::lng_settings_save(), save);
+				box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+				box->setWidth(editor->width());
+			}));
+		});
+		addSubtitle();
+	} else if (row.type == u"keybind"_q) {
+		Settings::AddButtonWithLabel(
+			inner,
+			rpl::duplicate(text),
+			state->value() | rpl::map([](const PageRow &row) {
+				return row.value.isEmpty() ? Lower(u"Not set"_q) : row.value;
+			}),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			const auto now = state->current();
+			show->show(Box([=](not_null<Ui::GenericBox*> box) {
+				box->setTitle(rpl::single(now.text.isEmpty()
+					? script
+					: now.text));
+				box->addRow(object_ptr<Ui::FlatLabel>(
+					box,
+					Lower(u"Press a key combination. Backspace clears it, "
+						"Escape cancels."_q),
+					st::boxLabel));
+				base::install_event_filter(box, [=](not_null<QEvent*> e) {
+					if (e->type() != QEvent::KeyPress) {
+						return base::EventFilterResult::Continue;
+					}
+					const auto key = static_cast<QKeyEvent*>(e.get());
+					const auto code = key->key();
+					if (code == Qt::Key_Escape) {
+						return base::EventFilterResult::Continue;
+					} else if (code == Qt::Key_Shift
+						|| code == Qt::Key_Control
+						|| code == Qt::Key_Alt
+						|| code == Qt::Key_Meta
+						|| code == Qt::Key_unknown) {
+						return base::EventFilterResult::Cancel;
+					}
+					const auto value = (code == Qt::Key_Backspace
+						&& key->modifiers() == Qt::NoModifier)
+						? QString()
+						: QKeySequence(
+							int(key->modifiers()) | code).toString(
+								QKeySequence::PortableText);
+					box->closeBox();
+					if (value != state->current().value) {
+						event(value);
+					}
+					return base::EventFilterResult::Cancel;
+				});
+				box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+			}));
+		});
+		addSubtitle();
+	} else if (row.type == u"check"_q) {
+		const auto button = Settings::AddButtonWithIcon(
+			inner,
+			rpl::duplicate(text),
+			st::settingsButtonNoIcon);
+		button->toggleOn(state->value() | rpl::map([](const PageRow &row) {
+			return row.checked;
+		}));
+		button->toggledChanges(
+		) | rpl::filter([=](bool value) {
+			return value != state->current().checked;
+		}) | rpl::on_next([=](bool value) {
+			event(value);
+		}, button->lifetime());
+		addSubtitle();
+	} else if (row.type == u"select"_q) {
+		Settings::AddButtonWithLabel(
+			inner,
+			rpl::duplicate(text),
+			state->value() | rpl::map([](const PageRow &row) {
+				const auto index = row.selected;
+				return (index >= 0 && index < int(row.options.size()))
+					? row.options[index]
+					: QString();
+			}),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			const auto now = state->current();
+			ShowScriptChooser(show, {
+				.script = script,
+				.title = now.text,
+				.items = now.options,
+				.selected = (now.selected >= 0)
+					? std::vector<int>{ now.selected }
+					: std::vector<int>(),
+			}, [=](std::optional<std::vector<int>> result) {
+				if (result
+					&& !result->empty()
+					&& result->front() != state->current().selected) {
+					event(result->front());
+				}
+			});
+		});
+		addSubtitle();
+	} else if (row.type == u"input"_q) {
+		Settings::AddButtonWithLabel(
+			inner,
+			rpl::duplicate(text),
+			state->value() | rpl::map([](const PageRow &row) {
+				return row.value.isEmpty() ? row.placeholder : row.value;
+			}),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			const auto now = state->current();
+			ShowScriptPrompt(show, {
+				.script = script,
+				.title = now.text,
+				.placeholder = now.placeholder,
+				.value = now.value,
+				.maxLength = now.maxLength,
+				.multiline = now.multiline,
+			}, [=](std::optional<QString> result) {
+				if (result && *result != state->current().value) {
+					event(*result);
+				}
+			});
+		});
+		addSubtitle();
+	} else if (row.type == u"slider"_q) {
+		if (!row.text.isEmpty()) {
+			inner->add(
+				object_ptr<Ui::FlatLabel>(inner, rpl::duplicate(text), st::boxLabel),
+				st::boxRowPadding);
+			Ui::AddSkip(inner);
+		}
+		const auto step = (row.step > 0.) ? row.step : 1.;
+		const auto steps = std::clamp(
+			int(std::floor((row.max - row.min) / step)) + 1,
+			2,
+			kMaxSliderSteps);
+		const auto min = row.min;
+		const auto index = std::clamp(
+			int(std::round((row.number - min) / step)),
+			0,
+			steps - 1);
+		const auto &labelSt = st::settingsScaleLabel;
+		auto slider = Settings::MakeSliderWithLabel(
+			inner,
+			st::settingsScale,
+			labelSt,
+			st::normalFont->spacew * 2,
+			labelSt.style.font->width(label(row.max)),
+			true);
+		const auto shown = slider.label;
+		shown->setText(label(min + index * step));
+		slider.slider->setPseudoDiscrete(
+			steps,
+			[](int value) { return value; },
+			index,
+			[=](int value) {
+				const auto number = min + value * step;
+				shown->setText(label(number));
+				event(number);
+			});
+		inner->add(std::move(slider.widget), st::boxRowPadding);
+		Ui::AddSkip(inner);
+		addSubtitle();
+	} else if (row.type == u"text"_q) {
+		inner->add(
+			object_ptr<Ui::FlatLabel>(
+				inner,
+				state->value() | rpl::map([](const PageRow &row) {
+					return TextUtilities::ParseEntities(
+						row.text,
+						TextParseLinks | TextParseMarkdown);
+				}),
+				st::boxLabel),
+			st::boxRowPadding);
+		Ui::AddSkip(inner);
+	} else if (row.type == u"progress"_q) {
+		if (!row.text.isEmpty()) {
+			inner->add(
+				object_ptr<Ui::FlatLabel>(inner, rpl::duplicate(text), st::boxLabel),
+				st::boxRowPadding);
+			Ui::AddSkip(inner);
+		}
+		const auto bar = inner->add(
+			object_ptr<Ui::RpWidget>(inner),
+			st::boxRowPadding);
+		bar->resize(bar->width(), st::lineWidth * 6);
+		bar->paintRequest() | rpl::on_next([=] {
+			auto p = QPainter(bar);
+			auto hq = PainterHighQualityEnabler(p);
+			const auto radius = bar->height() / 2.;
+			p.setPen(Qt::NoPen);
+			p.setBrush(st::windowBgOver);
+			p.drawRoundedRect(bar->rect(), radius, radius);
+			const auto value = state->current().progress;
+			if (value >= 0.) {
+				const auto filled = QRect(
+					0,
+					0,
+					int(std::round(bar->width() * std::clamp(value, 0., 1.))),
+					bar->height());
+				p.setBrush(st::activeButtonBg);
+				p.drawRoundedRect(filled, radius, radius);
+			}
+		}, bar->lifetime());
+		state->value() | rpl::on_next([=] {
+			bar->update();
+		}, bar->lifetime());
+		Ui::AddSkip(inner);
+		addSubtitle();
+	} else if (row.type == u"image"_q) {
+		const auto image = inner->add(
+			object_ptr<Ui::AbstractButton>(inner),
+			st::boxRowPadding);
+		const auto picture = image->lifetime().make_state<QImage>();
+		state->value() | rpl::on_next([=](const PageRow &row) {
+			*picture = QImage::fromData(row.bytes);
+			image->update();
+		}, image->lifetime());
+		const auto maxHeight = (row.height > 0)
+			? style::ConvertScale(row.height)
+			: style::ConvertScale(240);
+		image->widthValue() | rpl::on_next([=](int width) {
+			const auto size = picture->isNull()
+				? QSize()
+				: picture->size().scaled(
+					width,
+					maxHeight,
+					Qt::KeepAspectRatio);
+			image->resize(width, size.isEmpty() ? 0 : size.height());
+		}, image->lifetime());
+		image->paintRequest() | rpl::on_next([=] {
+			if (picture->isNull()) {
+				return;
+			}
+			auto p = QPainter(image);
+			auto hq = PainterHighQualityEnabler(p);
+			const auto size = picture->size().scaled(
+				image->width(),
+				image->height(),
+				Qt::KeepAspectRatio);
+			const auto target = QRect(
+				QPoint((image->width() - size.width()) / 2, 0),
+				size);
+			p.drawImage(target, *picture);
+		}, image->lifetime());
+		image->setClickedCallback([=] { event(QVariant()); });
+		Ui::AddSkip(inner);
+		addSubtitle();
+	} else if (row.type == u"peer"_q) {
+		const auto session = std::dynamic_pointer_cast<Main::SessionShow>(show);
+		const auto peer = (session && row.peer)
+			? session->session().data().peerLoaded(PeerId(row.peer))
+			: nullptr;
+		const auto button = inner->add(object_ptr<Ui::AbstractButton>(inner));
+		const auto size = st::defaultPeerListItem.photoSize;
+		const auto skip = st::defaultPeerListItem.photoPosition.y();
+		button->resize(button->width(), size + 2 * skip);
+		const auto userpic = button->lifetime().make_state<
+			Ui::PeerUserpicView>();
+		const auto over = button->lifetime().make_state<bool>(false);
+		button->events() | rpl::on_next([=](not_null<QEvent*> e) {
+			if (e->type() == QEvent::Enter || e->type() == QEvent::Leave) {
+				*over = (e->type() == QEvent::Enter);
+				button->update();
+			}
+		}, button->lifetime());
+		if (peer) {
+			peer->session().downloaderTaskFinished() | rpl::on_next([=] {
+				button->update();
+			}, button->lifetime());
+		}
+		button->paintRequest() | rpl::on_next([=] {
+			auto p = Painter(button);
+			if (*over) {
+				p.fillRect(button->rect(), st::windowBgOver);
+			}
+			const auto left = st::boxRowPadding.left();
+			const auto textLeft = left + size + st::defaultPeerListItem.namePosition.x() - st::defaultPeerListItem.photoPosition.x();
+			const auto available = button->width() - textLeft - st::boxRowPadding.right();
+			if (peer) {
+				peer->paintUserpicLeft(p, *userpic, left, skip, button->width(), size);
+			}
+			const auto &current = state->current();
+			const auto name = !current.text.isEmpty()
+				? current.text
+				: peer
+				? peer->name()
+				: QString::number(current.peer);
+			p.setPen(st::windowBoldFg);
+			p.setFont(st::semiboldFont);
+			p.drawTextLeft(
+				textLeft,
+				skip + st::defaultPeerListItem.namePosition.y() - st::defaultPeerListItem.photoPosition.y(),
+				button->width(),
+				st::semiboldFont->elided(name, available));
+			if (!current.subtitle.isEmpty()) {
+				p.setPen(st::windowSubTextFg);
+				p.setFont(st::normalFont);
+				p.drawTextLeft(
+					textLeft,
+					skip + st::defaultPeerListItem.statusPosition.y() - st::defaultPeerListItem.photoPosition.y(),
+					button->width(),
+					st::normalFont->elided(current.subtitle, available));
+			}
+		}, button->lifetime());
+		state->value() | rpl::on_next([=] {
+			button->update();
+		}, button->lifetime());
+		button->setClickedCallback([=] { event(QVariant()); });
+	}
+}
