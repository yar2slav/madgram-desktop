+[[nodiscard]] ParticipantState StateOf(
+		const Data::GroupCallParticipant &participant,
+		not_null<PeerData*> self) {
+	return {
+		.peer = participant.peer->id,
+		.self = (participant.peer == self),
+		.speaking = bool(participant.speaking),
+		.muted = bool(participant.muted),
+		.mutedByAdmin = (participant.muted && !participant.canSelfUnmute),
+		.raisedHand = (participant.raisedHandRating != 0),
+		.video = !participant.cameraEndpoint().empty(),
+		.screen = !participant.screenEndpoint().empty(),
+	};
+}
+
+[[nodiscard]] ParticipantState StateOf(
+		const MTPDgroupCallParticipant &data) {
+	return {
+		.peer = peerFromMTP(data.vpeer()),
+		.self = data.is_self(),
+		.speaking = false,
+		.muted = data.is_muted(),
+		.mutedByAdmin = (data.is_muted() && !data.is_can_self_unmute()),
+		.raisedHand = (data.vraise_hand_rating().value_or_empty() != 0),
+		.video = data.vvideo().has_value(),
+		.screen = data.vpresentation().has_value(),
+	};
+}
+
+[[nodiscard]] std::vector<ParticipantState> CurrentParticipants(
+		not_null<Calls::GroupCall*> call) {
+	auto result = std::vector<ParticipantState>();
+	if (const auto real = call->lookupReal()) {
+		const auto self = call->joinAs();
+		const auto &list = real->participants();
+		result.reserve(list.size());
+		for (const auto &participant : list) {
+			result.push_back(StateOf(participant, self));
+		}
+	}
+	return result;
+}
