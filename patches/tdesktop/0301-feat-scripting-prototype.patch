+void AddStoriesNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "storiesUpload", NativeStories, 2, kUpload },
+		{ "storiesGhost", NativeStories, 2, kGhost },
+		{ "storiesApplyRead", NativeStories, 2, kApplyRead },
+		{ "storiesApplyDeleted", NativeStories, 2, kApplyDeleted },
+		{ "storiesSources", NativeStories, 0, kSources },
+		{ "storiesAction", NativeStories, 3, kAction },
+		{ "storiesIntercept", NativeStories, 1, kIntercept },
+		{ "storiesWatch", NativeStories, 1, kWatch },
+		{ "storiesUnregister", NativeStories, 1, kUnregister },
+		{ "storiesAnswer", NativeStories, 2, kAnswer },
+	});
+}
