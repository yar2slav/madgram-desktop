+};
+
+class Stripper final {
+public:
+	Stripper();
+	~Stripper();
+
+	[[nodiscard]] std::optional<Stripped> strip(
+		const QByteArray &code,
+		const QString &file,
+		QString &error);
+
+private:
+	JSRuntime *_rt = nullptr;
+	JSContext *_ctx = nullptr;
+	JSValue _function = JS_UNDEFINED;
+	QString _error;
+
+};
+
+Stripper::Stripper()
+: _rt(JS_NewRuntime()) {
+	JS_SetMaxStackSize(_rt, kStripStackLimit);
+	_ctx = JS_NewContext(_rt);
+	auto file = QFile(u":/tele/scripting/strip.js"_q);
+	if (!file.open(QIODevice::ReadOnly)) {
+		_error = u"the TypeScript stripper is missing"_q;
+		return;
+	}
+	const auto code = file.readAll();
+	JS_UpdateStackTop(_rt);
+	auto result = JS_Eval(
+		_ctx,
+		code.constData(),
+		code.size(),
+		"strip.js",
+		JS_EVAL_TYPE_GLOBAL);
+	if (JS_IsException(result)) {
+		_error = u"the TypeScript stripper failed to start"_q;
+		JS_FreeValue(_ctx, JS_GetException(_ctx));
+		return;
+	}
+	JS_FreeValue(_ctx, result);
+	auto global = JS_GetGlobalObject(_ctx);
+	_function = JS_GetPropertyStr(_ctx, global, "__teleStrip");
+	JS_FreeValue(_ctx, global);
+	if (!JS_IsFunction(_ctx, _function)) {
+		_error = u"the TypeScript stripper is broken"_q;
+	}
+}
+
+Stripper::~Stripper() {
+	JS_FreeValue(_ctx, _function);
+	JS_FreeContext(_ctx);
+	JS_FreeRuntime(_rt);
+}
+
+std::optional<Stripped> Stripper::strip(
+		const QByteArray &code,
+		const QString &file,
+		QString &error) {
+	if (!_error.isEmpty()) {
+		error = _error;
+		return std::nullopt;
+	}
+	JS_UpdateStackTop(_rt);
+	const auto name = file.toUtf8();
+	JSValue args[] = {
+		JS_NewStringLen(_ctx, code.constData(), code.size()),
+		JS_NewStringLen(_ctx, name.constData(), name.size()),
+	};
+	auto result = JS_Call(_ctx, _function, JS_UNDEFINED, 2, args);
+	JS_FreeValue(_ctx, args[0]);
+	JS_FreeValue(_ctx, args[1]);
+	if (JS_IsException(result)) {
+		auto exception = JS_GetException(_ctx);
+		auto message = JS_GetPropertyStr(_ctx, exception, "message");
+		auto size = std::size_t();
+		const auto text = JS_ToCStringLen(_ctx, &size, message);
+		error = text
+			? QString::fromUtf8(text, int(size))
+			: u"can't strip types"_q;
+		if (text) {
+			JS_FreeCString(_ctx, text);
+		}
+		JS_FreeValue(_ctx, message);
+		JS_FreeValue(_ctx, exception);
+		return std::nullopt;
+	}
+	const auto property = [&](const char *name) {
+		auto value = JS_GetPropertyStr(_ctx, result, name);
+		auto size = std::size_t();
+		const auto text = JS_IsString(value)
+			? JS_ToCStringLen(_ctx, &size, value)
+			: nullptr;
+		auto bytes = text ? QByteArray(text, int(size)) : QByteArray();
+		if (text) {
+			JS_FreeCString(_ctx, text);
+		}
+		JS_FreeValue(_ctx, value);
+		return bytes;
+	};
+	auto stripped = Stripped{
+		.code = property("code"),
+		.map = property("map"),
+	};
+	JS_FreeValue(_ctx, result);
+	return stripped;
+}
+
+void PromiseRejected(
+		JSContext *ctx,
+		JSValueConst promise,
+		JSValueConst reason,
+		bool handled,
+		void *opaque) {
+	static_cast<Engine*>(opaque)->rejected(promise, reason, handled);
+}
