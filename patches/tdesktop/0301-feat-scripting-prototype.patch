+		expireDate: raw.expireDate,
+		caption: raw.caption ?? '',
+		entities: raw.entities ?? [],
+		media: mediaOf(raw.media),
+		views: raw.views
+			? {
+				count: raw.views.viewsCount,
+				reactions: raw.views.reactionsCount ?? 0,
+				forwards: raw.views.forwardsCount ?? 0,
+				recentViewers: raw.views.recentViewers ?? [],
+			}
+			: null,
+		privacy: privacyOf(raw),
+		pinned: raw.pinned === true,
+		closeFriends: raw.closeFriends === true,
+		out: raw.out === true,
+		edited: raw.edited === true,
+		noForwards: raw.noforwards === true,
+		sentReaction: reactionOf(raw.sentReaction),
+		raw,
+	});
+
+	const textOf = (text, what) => {
+		if (typeof text === 'string') {
+			return { text, entities: [] };
