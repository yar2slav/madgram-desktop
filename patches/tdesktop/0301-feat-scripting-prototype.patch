@@ -0,0 +1,62 @@
+(() => {
+	globalThis.__teleExtensions.push({
+		name: 'mediaviewer',
+		globals() {
+		},
+		tg(tg, natives, { resolvePeer }) {
+			const define = (name, value) => {
+				Object.defineProperty(tg.ui, name, { value, enumerable: true });
+			};
+			define('openMedia', async (target, options = {}) => {
+				if (target === null || typeof target !== 'object') {
+					throw new TypeError('tg.ui.openMedia(message | { peer, id }, options?): pass a Message or { peer, id }');
+				} else if (!Number.isInteger(target.id) || target.id <= 0) {
+					throw new TypeError('tg.ui.openMedia: id must be a positive integer message id');
+				} else if (options === null || typeof options !== 'object') {
+					throw new TypeError('tg.ui.openMedia: options must be an object');
+				} else if (options.index !== undefined && (!Number.isInteger(options.index) || options.index < 0)) {
+					throw new TypeError('tg.ui.openMedia: index must be a non-negative integer');
+				}
+				const peer = await resolvePeer(('peer' in target) ? target.peer : target);
+				return natives.mediaviewerOpen(peer, target.id, options.index ?? -1);
+			});
+			define('onMediaOpened', (callback) => {
+				if (typeof callback !== 'function') {
+					throw new TypeError('tg.ui.onMediaOpened(function)');
+				}
+				const id = natives.mediaviewerListen(callback);
+				return __teleDisposer(() => natives.mediaviewerRemove(id));
+			});
+			define('registerMediaAction', (options) => {
+				if (options === null || typeof options !== 'object') {
+					throw new TypeError('tg.ui.registerMediaAction needs an options object');
+				} else if (typeof options.text !== 'string' || !options.text.trim()) {
+					throw new TypeError('tg.ui.registerMediaAction needs a text');
+				} else if (options.emoji !== undefined && typeof options.emoji !== 'string') {
+					throw new TypeError('tg.ui.registerMediaAction: emoji must be a string');
+				} else if (typeof options.onClick !== 'function') {
+					throw new TypeError('tg.ui.registerMediaAction: onClick must be a function');
+				} else if (options.filter !== undefined && typeof options.filter !== 'function') {
+					throw new TypeError('tg.ui.registerMediaAction: filter must be a function');
+				}
+				const { filter } = options;
+				const id = natives.mediaviewerAction({
+					text: options.text,
+					emoji: options.emoji ?? '',
+					onClick: options.onClick,
+					filter: filter && (async ({ callId, context }) => {
+						let shown = false;
+						try {
+							shown = Boolean(await filter(context));
+						} catch (error) {
+							console.error('tg.ui.registerMediaAction filter:', error);
+						}
+						natives.mediaviewerAnswer(callId, shown);
+					}),
+				});
+				return __teleDisposer(() => natives.mediaviewerRemove(id));
+			});
+			define('mediaViewer', () => natives.mediaviewerState());
+		},
+	});
+})();
