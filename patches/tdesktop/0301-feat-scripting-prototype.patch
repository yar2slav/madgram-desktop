+
+bool Host::interceptSendMessage(
+		const Api::MessageToSend &message,
+		std::optional<MsgId> localMessageId) {
+	const auto peer = message.action.history->peer;
+	if (!holds(peer, u"text"_q)) {
+		return false;
+	}
+	const auto original = std::make_shared<Api::MessageToSend>(message);
+	const auto session = _session;
+	const auto replyTo = ReplyInChat(message.action, peer->id);
+	hold(peer->id, std::make_shared<HeldSend>(HeldSend{
+		.data = SendData{
+			.kind = u"text"_q,
+			.text = message.textWithTags,
+			.peer = peer,
+			.replyTo = replyTo,
+			.scheduled = message.action.options.scheduled,
+			.silent = message.action.options.silent,
+		},
+		.initialReplyTo = replyTo,
+		.replay = [=](const SendData &data) {
+			auto copy = Api::MessageToSend(*original);
+			copy.textWithTags = data.text;
+			ApplySend(copy.action, data, replyTo);
+			session->api().sendMessage(std::move(copy), localMessageId);
+		},
+	}));
+	return true;
+}
