+		lifetime.destroy();
+		if (finished) {
+			return;
+		} else if (const auto strong = uploader.get()) {
+			strong->cancel(fakeId);
+		}
+	}
+
+	base::weak_ptr<Storage::Uploader> uploader;
+	FullMsgId fakeId;
+	rpl::lifetime lifetime;
+	bool finished = false;
+};
