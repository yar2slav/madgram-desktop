+	JS_SetPropertyStr(ctx, result, "peer", PeerValue(ctx, peer));
+	JS_SetPropertyStr(ctx, result, "self", JS_NewBool(ctx, state.self));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"speaking",
