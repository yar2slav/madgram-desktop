+const auto kFolderFlags = std::array<std::pair<const char*, Flag>, 8>{ {
+	{ "contacts", Flag::Contacts },
+	{ "nonContacts", Flag::NonContacts },
+	{ "groups", Flag::Groups },
+	{ "channels", Flag::Channels },
+	{ "bots", Flag::Bots },
+	{ "excludeMuted", Flag::NoMuted },
+	{ "excludeRead", Flag::NoRead },
+	{ "excludeArchived", Flag::NoArchived },
+} };
+
+enum class ListenerKind {
+	Bookmarks,
+	Kept,
+	Intercept,
+};
+
+struct Listener {
+	const Instance *owner = nullptr;
+	base::weak_ptr<Instance> instance;
+	Main::Session *session = nullptr;
+	ListenerKind kind = ListenerKind::Bookmarks;
+	rpl::lifetime lifetime;
+};
+
+struct Verdict {
+	const Instance *owner = nullptr;
+	base::weak_ptr<Main::Session> session;
+	FullMsgId id;
+};
+
+struct Registry {
+	std::map<int, Listener> listeners;
+	std::set<const Instance*> hooked;
+	std::map<int, Verdict> verdicts;
+	int verdictId = 0;
+	bool subscribed = false;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] Registry &Get() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] std::int64_t MarkedOf(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] std::optional<PeerId> PeerOf(
+		JSContext *ctx,
+		JSValueConst value) {
+	auto id = std::int64_t();
+	if (JS_IsBigInt(value)) {
+		if (JS_ToBigInt64(ctx, &id, value) < 0) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			return std::nullopt;
+		}
+	} else if (JS_IsNumber(value)) {
+		auto number = 0.;
+		JS_ToFloat64(ctx, &number, value);
+		if (number != std::floor(number)) {
+			return std::nullopt;
+		}
+		id = std::int64_t(number);
+	} else {
+		return std::nullopt;
+	}
+	if (id > 0) {
+		return peerFromUser(UserId(std::uint64_t(id)));
+	} else if (id <= -kChannelShift) {
+		return peerFromChannel(ChannelId(std::uint64_t(-id - kChannelShift)));
+	} else if (id < 0) {
+		return peerFromChat(ChatId(std::uint64_t(-id)));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<PeerId> PeerAt(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv,
+		int index) {
+	return (argc > index) ? PeerOf(ctx, argv[index]) : std::nullopt;
+}
+
+[[nodiscard]] std::optional<MsgId> MsgIdAt(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv,
+		int index) {
+	auto number = 0.;
+	if (argc <= index
+		|| !JS_IsNumber(argv[index])
+		|| JS_ToFloat64(ctx, &number, argv[index]) < 0
+		|| number != std::floor(number)
+		|| number <= 0.) {
+		return std::nullopt;
+	}
+	return MsgId(std::int64_t(number));
+}
+
+[[nodiscard]] std::optional<FilterId> FolderAt(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv,
+		int index) {
+	if (argc <= index
+		|| JS_IsUndefined(argv[index])
+		|| JS_IsNull(argv[index])) {
+		return FilterId();
+	}
+	auto number = 0.;
+	if (!JS_IsNumber(argv[index])
+		|| JS_ToFloat64(ctx, &number, argv[index]) < 0
+		|| number != std::floor(number)
+		|| number < 0.
+		|| number > 2147483647.) {
+		return std::nullopt;
+	}
+	return FilterId(std::int32_t(number));
+}
