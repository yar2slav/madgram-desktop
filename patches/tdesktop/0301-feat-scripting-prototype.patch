diff --git a/Telegram/Resources/tele_html/mtp_console.css b/Telegram/Resources/tele_html/mtp_console.css
index ae5326624d1179e5efb16d4979bb540bac905b9b..4ad2af2e3ec2b77b81483e12016f1ed8bfb738d4 100644
--- a/Telegram/Resources/tele_html/mtp_console.css
+++ b/Telegram/Resources/tele_html/mtp_console.css
@@ -1,4 +1,6 @@
-html[data-lower="1"] #method::placeholder {
+html[data-lower="1"] #method::placeholder,
+html[data-lower="1"] #log-search::placeholder,
+html[data-lower="1"] #console-filter::placeholder {
 	text-transform: lowercase;
 }
 [hidden] {
@@ -622,3 +624,628 @@ input[type="checkbox"].form-control {
 #confirm-text {
 	overflow-wrap: anywhere;
 }
+#tabs {
+	padding-right: 12px;
+	margin-right: 4px;
+	border-right: 1px solid var(--divider);
+}
+body.tab-scripts .requests-only {
+	display: none !important;
+}
+#scripts {
+	flex: 1 1 0;
+	display: flex;
+	min-height: 0;
+}
+#script-side {
+	flex: 0 0 260px;
+	display: flex;
+	flex-direction: column;
+	min-height: 0;
+	border-right: 1px solid var(--divider);
+}
+#script-side-head {
+	flex: 0 0 auto;
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	padding: 6px 10px;
+	font-size: 12px;
+	color: var(--dim);
+	border-bottom: 1px solid var(--divider);
+}
+#script-list {
+	flex: 1 1 auto;
+	overflow: auto;
+	min-height: 0;
+}
+.srow {
+	display: grid;
+	grid-template-columns: 28px minmax(0, 1fr) auto;
+	column-gap: 8px;
+	align-items: center;
+	padding: 6px 10px;
+	border-bottom: 1px solid var(--divider);
+	font-size: 12px;
+	cursor: pointer;
+	user-select: none;
+}
+.srow:hover {
+	background: var(--bg-over);
+}
+.srow.selected {
+	background: var(--active-bg);
+	color: var(--active-fg);
+}
+.srow-lead {
+	grid-column: 1;
+	grid-row: 1 / span 2;
+	justify-self: center;
+}
+.srow-icon {
+	color: var(--accent);
+	font-weight: 600;
+}
+.srow-name {
+	grid-column: 2;
+	grid-row: 1;
+	font-weight: 600;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.srow-sub {
+	grid-column: 2;
+	grid-row: 2;
+	color: var(--dim);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.srow-state {
+	grid-column: 3;
+	grid-row: 1;
+	justify-self: end;
+}
+.srow-actions {
+	grid-column: 3;
+	grid-row: 2;
+	justify-self: end;
+	display: flex;
+	gap: 4px;
+	margin-top: 3px;
+}
+.srow-actions:empty {
+	display: none;
+}
+.srow-actions button {
+	padding: 0 6px;
+	font-size: 11px;
+}
+.srow.selected .srow-sub,
+.srow.selected .srow-icon,
+.srow.selected .badge {
+	color: var(--active-fg);
+}
+.state-running {
+	color: var(--syntax-type);
+}
+.state-off,
+.state-starting {
+	color: var(--dim);
+}
+.state-approval {
+	color: var(--syntax-invisible);
+}
+.state-error {
+	color: var(--attention);
+}
+.state-repl {
+	color: var(--accent);
+}
+.switch {
+	position: relative;
+	display: inline-block;
+	width: 26px;
+	height: 14px;
+	cursor: pointer;
+}
+.switch input {
+	position: absolute;
+	inset: 0;
+	width: 100%;
+	height: 100%;
+	margin: 0;
+	opacity: 0;
+	cursor: pointer;
+}
+.switch-track {
+	position: absolute;
+	inset: 0;
+	border-radius: 7px;
+	background: var(--border);
+	transition: background .15s;
+	pointer-events: none;
+}
+.switch-track::after {
+	content: '';
+	position: absolute;
+	left: 2px;
+	top: 2px;
+	width: 10px;
+	height: 10px;
+	border-radius: 50%;
+	background: var(--bg);
+	transition: transform .15s;
+}
+.switch input:checked + .switch-track {
+	background: var(--accent);
+}
+.switch input:checked + .switch-track::after {
+	transform: translateX(12px);
+}
+.switch input:focus-visible + .switch-track {
+	outline: 1px solid var(--accent);
+	outline-offset: 2px;
+}
+.srow.selected .switch input:checked + .switch-track {
+	background: var(--active-fg);
+}
+.srow.selected .switch input:checked + .switch-track::after {
+	background: var(--active-bg);
+}
+.script-empty {
+	padding: 16px 12px;
+	color: var(--dim);
+	font-size: 12px;
+	overflow-wrap: anywhere;
+}
+.script-empty .link {
+	display: inline-block;
+	margin-top: 8px;
+}
+#script-work {
+	flex: 1 1 0;
+	display: flex;
+	flex-direction: column;
+	min-width: 0;
+	min-height: 0;
+}
+#script-pane {
+	flex: 1 1 0;
+	display: flex;
+	flex-direction: column;
+	min-height: 0;
+}
+#script-head {
+	flex: 0 0 auto;
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 6px 10px;
+	padding: 10px 16px 0;
+}
+.shead-name {
+	font-weight: 600;
+	overflow-wrap: anywhere;
+}
+.shead-id {
+	color: var(--dim);
+	font-size: 12px;
+}
+#script-details {
+	flex: 0 0 auto;
+	max-height: 30%;
+	overflow: auto;
+	padding: 6px 16px 8px;
+	font-size: 12px;
+	border-bottom: 1px solid var(--divider);
+}
+.sdetail-row {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 4px 6px;
+}
+.sdetail-key {
+	color: var(--dim);
+	margin-right: 4px;
+}
+.sdetail-note {
+	color: var(--dim);
+}
+.perm {
+	padding: 0 6px;
+	font-size: 11px;
+	line-height: 18px;
+	border: 1px solid currentColor;
+	border-radius: 3px;
+}
+.perm.granted {
+	color: var(--syntax-type);
+}
+.perm.pending {
+	color: var(--syntax-invisible);
+}
+.sdetail-error {
+	margin-top: 8px;
+	padding: 6px 10px;
+	border-left: 3px solid var(--attention);
+	background: var(--bg-over);
+	color: var(--attention);
+	white-space: pre-wrap;
+	overflow-wrap: anywhere;
+}
+#log-tools {
+	flex: 0 0 auto;
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 6px 8px;
+	padding: 6px 16px;
+	border-bottom: 1px solid var(--divider);
+}
+#log-search {
+	flex: 0 1 260px;
+	min-width: 120px;
+	font: inherit;
+	font-size: 12px;
+	color: var(--text);
+	background: var(--td-filter-input-inactive-bg);
+	border: 1px solid var(--border);
+	padding: 2px 8px;
+	outline: none;
+}
+#log-search:focus,
+#console-filter:focus,
+#repl-target:focus {
+	border-color: var(--accent);
+}
+#log-count {
+	font-size: 12px;
+	color: var(--dim);
+	white-space: nowrap;
+}
+#log-box {
+	position: relative;
