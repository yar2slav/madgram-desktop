+constexpr auto kCommonPrefix
+	= "(function (exports, require, module, __filename, __dirname) {";
+constexpr auto kCommonSuffix = "\n})";
+
+[[nodiscard]] bool Inside(const QString &path, const QString &folder) {
+	return (path == folder) || path.startsWith(folder + '/');
+}
+
+[[nodiscard]] bool InModules(const QString &path) {
+	return (path + '/').contains(u"/node_modules/"_q);
+}
+
+[[nodiscard]] const NodeBuiltin *FindBuiltin(const QString &name) {
+	const auto first = name.section('/', 0, 0).toStdString();
+	const auto i = ranges::find(kNodeBuiltins, first, &NodeBuiltin::name);
+	return (i != end(kNodeBuiltins)) ? &*i : nullptr;
+}
+
+[[nodiscard]] QString BuiltinError(
+		const QString &name,
+		const NodeBuiltin *builtin) {
+	const auto instead = builtin ? builtin->instead : std::string_view();
+	return u"'"_q
+		+ name
+		+ u"' is a node built-in, and tele scripts don't run on node: "_q
+		+ (instead.empty()
+			? u"tele has no equivalent"_q
+			: (u"use "_q
+				+ QString::fromUtf8(instead.data(), int(instead.size()))
+				+ u" instead"_q));
+}
+
+[[nodiscard]] std::optional<QString> FindFile(
+		const QString &path,
+		std::span<const char* const> suffixes) {
+	for (const auto suffix : suffixes) {
+		const auto candidate = path + QString::fromLatin1(suffix);
+		if (QFileInfo(candidate).isFile()) {
+			return candidate;
+		}
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<QString> MatchKey(
+		const QJsonObject &map,
+		const QString &key,
+		QString &match) {
+	if (!key.contains('*') && map.contains(key)) {
+		return key;
+	}
+	auto result = std::optional<QString>();
+	auto longest = -1;
+	for (const auto &pattern : map.keys()) {
+		const auto star = int(pattern.indexOf('*'));
+		if (star < 0 || pattern.indexOf('*', star + 1) >= 0) {
+			continue;
+		}
+		const auto prefix = pattern.left(star);
+		const auto suffix = pattern.mid(star + 1);
+		if (key.size() < pattern.size()
+			|| !key.startsWith(prefix)
+			|| !key.endsWith(suffix)) {
+			continue;
+		} else if (result
+			&& (star < longest
+				|| (star == longest && pattern.size() <= result->size()))) {
+			continue;
+		}
+		result = pattern;
+		longest = star;
+		match = key.mid(star, key.size() - star - suffix.size());
+	}
+	return result;
+}
