+Host::Host(not_null<Main::Session*> session)
+: _session(session)
+, _mtp(&session->mtp())
+, _storage(session)
+, _api(&session->mtp())
+, _refreshTimer([=] { refresh(); })
+, _pollTimer([=] { poll(); }) {
+	Registry().emplace(_mtp, this);
+	read();
+	Folder().changes.events() | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+	refresh();
+	_pollTimer.callEach(kPollInterval);
+}
