+
+constexpr auto kChannelShift = std::int64_t(1000000000000);
+
+struct Shown {
+	Main::Session *session = nullptr;
+	FullMsgId id;
+	const void *media = nullptr;
+	int index = 0;
+	QString type;
+};
+
+struct Listener {
+	int id = 0;
+	base::weak_ptr<Instance> instance;
+	const Instance *owner = nullptr;
+	Main::Session *session = nullptr;
+	int kept = 0;
+};
+
+struct Action {
+	int id = 0;
+	base::weak_ptr<Instance> instance;
+	const Instance *owner = nullptr;
+	Main::Session *session = nullptr;
+	QString text;
+	QString emoji;
+	int click = 0;
+	int filter = 0;
+};
+
+struct MediaRegistry {
+	std::vector<Listener> listeners;
+	std::vector<Action> actions;
+	std::optional<Shown> shown;
+	base::flat_map<int, int> questions;
+	base::flat_set<int> visible;
+	base::flat_set<const Instance*> watched;
+	int nextId = 0;
+	int nextCall = 0;
+};
+
+[[nodiscard]] MediaRegistry &Registry() {
+	static auto result = MediaRegistry();
+	return result;
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] std::optional<std::uint64_t> IdField(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::optional<std::uint64_t>();
+	if (JS_IsBigInt(value)) {
+		auto number = std::int64_t();
+		if (!JS_ToBigInt64(ctx, &number, value)) {
+			result = std::uint64_t(number);
+		}
+	} else if (JS_IsNumber(value)) {
+		auto number = std::int64_t();
+		if (!JS_ToInt64(ctx, &number, value) && number > 0) {
+			result = std::uint64_t(number);
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] std::optional<PeerId> PeerFromInput(
+		JSContext *ctx,
+		JSValueConst value,
+		PeerId self) {
+	if (!JS_IsObject(value)) {
+		return std::nullopt;
+	}
+	auto name = JS_GetPropertyStr(ctx, value, "_");
+	const auto type = ToStd(ctx, name);
+	JS_FreeValue(ctx, name);
+	if (type == "inputPeerSelf") {
+		return self;
+	} else if (const auto user = IdField(ctx, value, "userId")) {
+		return peerFromUser(UserId(*user));
+	} else if (const auto chat = IdField(ctx, value, "chatId")) {
+		return peerFromChat(ChatId(*chat));
+	} else if (const auto channel = IdField(ctx, value, "channelId")) {
+		return peerFromChannel(ChannelId(*channel));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] Window::SessionController *WindowOf(
+		not_null<Main::Session*> session) {
+	auto result = (Window::SessionController*)nullptr;
+	for (const auto &window : session->windows()) {
+		if (window->isPrimary()) {
+			return window;
+		} else if (!result) {
+			result = window;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString TypeOf(PhotoData *photo, DocumentData *document) {
+	if (photo) {
+		return u"photo"_q;
+	} else if (!document) {
+		return u"other"_q;
+	} else if (document->isVideoMessage()) {
+		return u"roundVideo"_q;
+	} else if (document->isAnimation()) {
+		return u"gif"_q;
+	} else if (document->isVideoFile()) {
+		return u"video"_q;
+	} else if (document->isVoiceMessage()) {
+		return u"voice"_q;
+	} else if (document->isAudioFile()) {
+		return u"music"_q;
+	} else if (document->sticker()) {
+		return u"sticker"_q;
+	}
+	return u"document"_q;
+}
+
+[[nodiscard]] bool Viewable(not_null<DocumentData*> document) {
+	return !document->sticker()
+		&& (document->isVideoMessage()
+			|| document->isAnimation()
+			|| document->isVideoFile()
+			|| document->isImage());
+}
+
+[[nodiscard]] int IndexOf(
+		not_null<HistoryItem*> item,
+		PhotoData *photo,
+		DocumentData *document) {
+	const auto media = item->media();
+	const auto invoice = media ? media->invoice() : nullptr;
+	if (invoice && !invoice->extendedMedia.empty()) {
+		const auto &list = invoice->extendedMedia;
+		for (auto i = 0, count = int(list.size()); i != count; ++i) {
+			const auto &entry = list[i];
+			if ((photo && entry->photo() == photo)
+				|| (document && entry->document() == document)) {
+				return i;
+			}
+		}
+		return 0;
+	}
+	if (const auto group = item->history()->owner().groups().find(item)) {
+		const auto &items = group->items;
+		for (auto i = 0, count = int(items.size()); i != count; ++i) {
+			if (items[i] == item) {
+				return i;
+			}
+		}
+	}
+	return 0;
+}
+
+[[nodiscard]] JSValue ShownValue(JSContext *ctx, const Shown &shown) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(shown.id.peer)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"messageId",
+		JS_NewInt64(ctx, shown.id.msg.bare));
+	JS_SetPropertyStr(ctx, result, "index", JS_NewInt32(ctx, shown.index));
+	JS_SetPropertyStr(ctx, result, "type", NewString(ctx, shown.type));
+	return result;
+}
+
+[[nodiscard]] QString ItemText(const Action &action) {
+	return action.emoji.isEmpty()
+		? action.text
+		: (action.emoji + QChar(' ') + action.text);
+}
+
+void Notify(const Shown &shown, bool open) {
+	for (const auto &listener : Registry().listeners) {
+		if (listener.session != shown.session) {
+			continue;
+		}
+		const auto instance = listener.instance;
+		const auto kept = listener.kept;
+		crl::on_main([=] {
+			CallKept(instance, kept, [=](JSContext *ctx) {
+				auto result = ShownValue(ctx, shown);
+				JS_SetPropertyStr(ctx, result, "open", JS_NewBool(ctx, open));
+				return result;
+			}, u"tg.ui.onMediaOpened"_q);
+		});
+	}
+}
+
+void Ask(const Action &action, const Shown &shown) {
+	if (!action.filter || action.session != shown.session) {
+		return;
+	}
+	auto &registry = Registry();
+	const auto call = ++registry.nextCall;
+	registry.questions.emplace(call, action.id);
+	const auto instance = action.instance;
+	const auto kept = action.filter;
+	crl::on_main([=] {
+		CallKept(instance, kept, [=](JSContext *ctx) {
+			auto result = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, result, "callId", JS_NewInt32(ctx, call));
+			JS_SetPropertyStr(ctx, result, "context", ShownValue(ctx, shown));
+			return result;
+		}, u"tg.ui.registerMediaAction filter"_q);
+	});
+}
+
+void Click(int id, const Shown &shown) {
+	const auto &actions = Registry().actions;
+	const auto i = ranges::find(actions, id, &Action::id);
+	if (i == end(actions)) {
+		return;
+	}
+	CallKept(i->instance, i->click, [=](JSContext *ctx) {
+		return ShownValue(ctx, shown);
+	}, u"tg.ui.registerMediaAction"_q);
+}
+
+void RemoveOwner(const Instance *owner) {
+	auto &registry = Registry();
+	registry.watched.remove(owner);
+	registry.listeners.erase(
+		ranges::remove(registry.listeners, owner, &Listener::owner),
+		end(registry.listeners));
+	for (const auto &action : registry.actions) {
+		if (action.owner == owner) {
+			registry.visible.remove(action.id);
+		}
+	}
+	registry.actions.erase(
+		ranges::remove(registry.actions, owner, &Action::owner),
+		end(registry.actions));
+}
+
+void Watch(not_null<Instance*> instance) {
+	auto &registry = Registry();
+	const auto owner = instance.get();
+	if (registry.watched.contains(owner)) {
+		return;
+	}
+	registry.watched.emplace(owner);
+	ScriptLifetime(instance).add([=] {
+		RemoveOwner(owner);
+	});
+}
+
+void Remove(not_null<Instance*> instance, int id) {
+	auto &registry = Registry();
+	const auto weak = base::make_weak(instance.get());
+	const auto owner = instance.get();
+	const auto listener = ranges::find(registry.listeners, id, &Listener::id);
+	if (listener != end(registry.listeners) && listener->owner == owner) {
+		ForgetKept(weak, listener->kept);
+		registry.listeners.erase(listener);
+		return;
+	}
+	const auto action = ranges::find(registry.actions, id, &Action::id);
+	if (action != end(registry.actions) && action->owner == owner) {
+		ForgetKept(weak, action->click);
+		ForgetKept(weak, action->filter);
+		registry.visible.remove(id);
+		registry.actions.erase(action);
+	}
+}
+
+void Open(
+		not_null<Main::Session*> session,
+		FullMsgId id,
+		int index,
+		Pending pending) {
+	const auto item = session->data().message(id);
+	if (!item) {
+		Reject(
+			pending,
+			"not-found",
+			u"tg.ui.openMedia: there's no message %1 in this chat"_q.arg(
+				id.msg.bare));
+		return;
+	}
+	const auto window = WindowOf(session);
+	if (!window) {
+		Reject(pending, "unsupported", u"this account has no window"_q);
+		return;
+	}
+	const auto media = item->media();
+	if (media && media->storyId()) {
+		Reject(
+			pending,
+			"unsupported",
+			u"tg.ui.openMedia: a shared story opens in the story viewer"_q);
+		return;
+	}
+	auto target = not_null<HistoryItem*>(item);
+	auto photo = (PhotoData*)nullptr;
+	auto document = (DocumentData*)nullptr;
+	const auto invoice = media ? media->invoice() : nullptr;
+	if (invoice && !invoice->extendedMedia.empty()) {
+		if (Data::HasUnpaidMedia(*invoice)) {
+			Reject(
+				pending,
+				"unsupported",
+				u"tg.ui.openMedia: this paid media isn't bought"_q);
+			return;
+		}
+		const auto count = int(invoice->extendedMedia.size());
+		const auto at = std::max(index, 0);
+		if (at >= count) {
+			Reject(
+				pending,
+				"not-found",
+				u"tg.ui.openMedia: this message has %1 items"_q.arg(count));
+			return;
+		}
+		const auto &entry = invoice->extendedMedia[at];
+		photo = entry->photo();
+		document = entry->document();
+	} else {
+		if (index >= 0) {
+			const auto group = session->data().groups().find(item);
+			const auto count = group ? int(group->items.size()) : 1;
+			if (index >= count) {
+				Reject(
+					pending,
+					"not-found",
+					u"tg.ui.openMedia: the album has %1 items"_q.arg(count));
+				return;
+			} else if (group) {
+				target = group->items[index];
+			}
+		}
+		if (const auto shown = target->media()) {
+			photo = shown->photo();
+			document = shown->document();
+		}
+	}
+	if (photo && photo->isNull()) {
+		photo = nullptr;
+	}
+	if (!photo && (!document || !Viewable(document))) {
+		Reject(
+			pending,
+			"unsupported",
+			(document
+				? u"tg.ui.openMedia: a %1 doesn't open in the media viewer"_q.arg(
+					TypeOf(nullptr, document))
+				: u"tg.ui.openMedia: this message has no photo or video"_q));
+		return;
+	}
+	const auto context = Window::SessionController::MessageContext{
+		.id = target->fullId(),
+		.topicRootId = target->topicRootId(),
+	};
+	if (photo) {
+		window->openPhoto(photo, context);
+	} else {
+		window->openDocument(document, true, context);
+	}
+	Resolve(pending, [](JSContext*) { return JS_UNDEFINED; });
+}
+
+JSValue NativeMediaViewer(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return (magic == 4)
+			? JS_UNDEFINED
+			: JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	auto &registry = Registry();
+	const auto session = ScriptSession(instance);
+	switch (magic) {
+	case 0: {
+		const auto peerId = (argc > 0)
+			? PeerFromInput(ctx, argv[0], session->userPeerId())
+			: std::nullopt;
+		auto msg = std::int64_t();
+		auto index = std::int64_t(-1);
+		if (!peerId
+			|| argc < 2
+			|| !JS_IsNumber(argv[1])
+			|| JS_ToInt64(ctx, &msg, argv[1])
+			|| msg <= 0
+			|| (argc > 2 && JS_ToInt64(ctx, &index, argv[2]))) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.openMedia(message | { peer, id }, { index? })");
+		}
+		const auto peer = session->data().peerLoaded(*peerId);
+		if (!peer) {
+			return ThrowTeleError(
+				ctx,
+				"not-found",
+				u"tg.ui.openMedia: this chat isn't in tele's cache"_q);
+		}
+		auto created = NewPending(ctx);
+		const auto pending = created.first;
+		const auto promise = created.second;
+		if (JS_IsException(promise)) {
+			return promise;
+		}
+		const auto id = FullMsgId(peer->id, MsgId(msg));
+		const auto at = int(std::min(index, std::int64_t(1 << 20)));
+		const auto open = [=] {
+			Open(session, id, at, pending);
+		};
+		if (session->data().message(id)) {
+			crl::on_main(session, open);
+		} else {
+			session->api().requestMessageData(
+				peer,
+				MsgId(msg),
+				crl::guard(session, open));
+		}
+		return promise;
+	}
+	case 1: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.ui.onMediaOpened(function)");
+		}
+		const auto kept = KeepFunction(instance, argv[0]);
+		if (!kept) {
+			return JS_ThrowInternalError(ctx, "the script was stopped");
+		}
+		Watch(instance);
+		const auto id = ++registry.nextId;
+		registry.listeners.push_back({
+			.id = id,
+			.instance = base::make_weak(instance),
+			.owner = instance,
+			.session = session,
+			.kept = kept,
+		});
+		return JS_NewInt32(ctx, id);
+	}
+	case 2: {
+		if (argc < 1 || !JS_IsObject(argv[0])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.registerMediaAction needs an options object");
+		}
+		const auto options = argv[0];
+		const auto text = StringProperty(ctx, options, "text").trimmed();
+		const auto emoji = StringProperty(ctx, options, "emoji").trimmed();
+		if (text.isEmpty()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.registerMediaAction needs a text");
+		}
+		auto click = JS_GetPropertyStr(ctx, options, "onClick");
+		auto filter = JS_GetPropertyStr(ctx, options, "filter");
+		const auto valid = JS_IsFunction(ctx, click)
+			&& (JS_IsUndefined(filter) || JS_IsFunction(ctx, filter));
+		const auto clickKept = valid ? KeepFunction(instance, click) : 0;
+		const auto filterKept = (valid && JS_IsFunction(ctx, filter))
+			? KeepFunction(instance, filter)
+			: 0;
+		JS_FreeValue(ctx, click);
+		JS_FreeValue(ctx, filter);
+		if (!valid) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.registerMediaAction: onClick must be a function, "
+				"filter a function if given");
+		}
+		Watch(instance);
+		const auto id = ++registry.nextId;
+		registry.actions.push_back({
+			.id = id,
+			.instance = base::make_weak(instance),
+			.owner = instance,
+			.session = session,
+			.text = text,
+			.emoji = emoji,
+			.click = clickKept,
+			.filter = filterKept,
+		});
+		if (registry.shown) {
+			Ask(registry.actions.back(), *registry.shown);
+		}
+		return JS_NewInt32(ctx, id);
+	}
+	case 3: {
+		auto id = 0;
+		if (argc > 0 && !JS_ToInt32(ctx, &id, argv[0])) {
+			Remove(instance, id);
+		}
+		return JS_UNDEFINED;
+	}
+	case 4: {
+		auto call = 0;
+		if (argc < 1 || JS_ToInt32(ctx, &call, argv[0])) {
+			return JS_UNDEFINED;
+		}
+		const auto i = registry.questions.find(call);
+		if (i == end(registry.questions)) {
+			return JS_UNDEFINED;
+		}
+		const auto actionId = i->second;
+		registry.questions.erase(i);
+		const auto action = ranges::find(
+			registry.actions,
+			actionId,
+			&Action::id);
+		if (action != end(registry.actions)
+			&& action->owner == instance
+			&& argc > 1
+			&& JS_ToBool(ctx, argv[1]) > 0) {
+			registry.visible.emplace(actionId);
+		}
+		return JS_UNDEFINED;
+	}
+	case 5:
+		return (registry.shown && registry.shown->session == session)
+			? ShownValue(ctx, *registry.shown)
+			: JS_NULL;
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddMediaViewerNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "mediaviewerOpen", NativeMediaViewer, 3, 0 },
+		{ "mediaviewerListen", NativeMediaViewer, 1, 1 },
+		{ "mediaviewerAction", NativeMediaViewer, 1, 2 },
+		{ "mediaviewerRemove", NativeMediaViewer, 1, 3 },
+		{ "mediaviewerAnswer", NativeMediaViewer, 2, 4 },
+		{ "mediaviewerState", NativeMediaViewer, 0, 5 },
+	});
+}
+
+void MediaViewerShown(
+		Main::Session *session,
+		HistoryItem *item,
+		PhotoData *photo,
+		DocumentData *document) {
+	if (!session
+		|| !item
+		|| item->isSponsored()
+		|| (&item->history()->session() != session)
+		|| (!photo && !document)) {
+		MediaViewerHidden();
+		return;
+	}
+	const auto media = photo
+		? static_cast<const void*>(photo)
+		: static_cast<const void*>(document);
+	auto &registry = Registry();
+	if (registry.shown
+		&& registry.shown->session == session
+		&& registry.shown->id == item->fullId()
+		&& registry.shown->media == media) {
+		return;
+	}
+	registry.shown = Shown{
+		.session = session,
+		.id = item->fullId(),
+		.media = media,
+		.index = IndexOf(item, photo, document),
+		.type = TypeOf(photo, document),
+	};
+	registry.questions.clear();
+	registry.visible.clear();
+	const auto shown = *registry.shown;
+	for (const auto &action : registry.actions) {
+		Ask(action, shown);
+	}
+	Notify(shown, true);
+}
+
+void MediaViewerHidden() {
+	auto &registry = Registry();
+	if (!registry.shown) {
+		return;
+	}
+	const auto shown = *base::take(registry.shown);
+	registry.questions.clear();
+	registry.visible.clear();
+	Notify(shown, false);
+}
+
+void AddMediaActions(
+		const Ui::Menu::MenuCallback &addAction,
+		HistoryItem *item) {
+	const auto &registry = Registry();
+	if (!item
+		|| !registry.shown
+		|| registry.shown->id != item->fullId()
+		|| registry.shown->session != &item->history()->session()) {
+		return;
+	}
+	const auto shown = *registry.shown;
+	for (const auto &action : registry.actions) {
+		if (action.session != shown.session
+			|| (action.filter && !registry.visible.contains(action.id))) {
+			continue;
+		}
+		const auto id = action.id;
+		addAction(ItemText(action), [=] {
+			crl::on_main([=] {
+				Click(id, shown);
+			});
+		}, &st::mediaMenuIconExperimental);
+	}
+}
+
+std::string_view MediaViewerTypings() {
+	return R"TS(
+declare module 'tele' {
+  export interface MediaViewerItem {
+    chatId: bigint
+    messageId: number
+    index: number
+    type: MediaType
+  }
+
+  export interface MediaViewerEvent extends MediaViewerItem {
+    open: boolean
+  }
+
+  export interface MediaActionOptions {
+    text: string
+    emoji?: string
+    filter?(context: MediaViewerItem): boolean | Promise<boolean>
+    onClick(context: MediaViewerItem): unknown
+  }
+
+  export interface Ui {
+    openMedia(
+      message: Message | { peer: InputPeerLike, id: number },
+      options?: { index?: number },
+    ): Promise<void>
+    onMediaOpened(callback: (event: MediaViewerEvent) => unknown): Disposer
+    registerMediaAction(options: MediaActionOptions): Disposer
+    mediaViewer(): MediaViewerItem | null
+  }
+}
+)TS";
+}
+
+} // namespace Tele::Scripting
