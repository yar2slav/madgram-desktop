+[[nodiscard]] Window::SessionController *WindowOf(
+		not_null<Main::Session*> session) {
+	auto result = (Window::SessionController*)nullptr;
+	for (const auto &window : session->windows()) {
+		if (window->isPrimary()) {
+			return window;
+		} else if (!result) {
+			result = window;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Css(const style::color &color) {
+	const auto value = color->c;
+	if (value.alpha() == 255) {
+		return value.name(QColor::HexRgb);
+	}
+	return u"rgba(%1,%2,%3,%4)"_q
+		.arg(value.red())
+		.arg(value.green())
+		.arg(value.blue())
+		.arg(value.alpha() / 255.);
+}
+
+[[nodiscard]] QByteArray ThemeJson() {
+	return QJsonDocument(QJsonObject{
+		{ u"--tele-bg"_q, Css(st::windowBg) },
+		{ u"--tele-text"_q, Css(st::windowFg) },
+		{ u"--tele-accent"_q, Css(st::activeButtonBg) },
+		{ u"--tele-secondary-bg"_q, Css(st::windowBgOver) },
+		{ u"--tele-hint"_q, Css(st::windowSubTextFg) },
+		{ u"--tele-link"_q, Css(st::windowActiveTextFg) },
+	}).toJson(QJsonDocument::Compact);
+}
+
+[[nodiscard]] QByteArray BridgeScript(bool restricted) {
+	auto result = QByteArray(kBridge);
+	result.replace("__TELE_RESTRICTED__", restricted ? "true" : "false");
+	result.replace("__TELE_THEME__", ThemeJson());
+	return result;
+}
+
+[[nodiscard]] QByteArray PolicyFor(const Permissions &permissions) {
+	auto sources = QByteArray();
+	for (const auto &grant : permissions.grants()) {
+		if (grant.capability != Capability::Fetch) {
+			continue;
+		} else if (grant.scope.empty()) {
+			sources += " https: http: wss: ws:";
+			continue;
+		}
+		const auto host = QByteArray::fromStdString(grant.scope);
+		for (const auto scheme : { "https://", "http://", "wss://", "ws://" }) {
+			sources += ' ' + QByteArray(scheme) + host;
+			sources += ' ' + QByteArray(scheme) + "*." + host;
+		}
+	}
+	return "default-src 'self' data: blob: 'unsafe-inline' 'unsafe-eval'"
+		+ sources
+		+ "; base-uri 'self'; form-action 'none'";
+}
+
+[[nodiscard]] QByteArray WithPolicy(
+		QByteArray html,
+		const QByteArray &policy) {
+	const auto head = QByteArray("<meta http-equiv=\"x-dns-prefetch-control\" "
+		"content=\"off\"><meta http-equiv=\"Content-Security-Policy\" "
+		"content=\"")
+		+ Ui::EscapeForAttribute(policy)
+		+ "\">";
+	auto start = 0;
+	if (html.startsWith("\xEF\xBB\xBF")) {
+		start = 3;
+	}
+	while (start < html.size() && QChar::isSpace(uint(uchar(html[start])))) {
+		++start;
+	}
+	auto position = 0;
+	if (html.mid(start, 9).toLower() == "<!doctype") {
+		const auto end = html.indexOf('>', start);
+		if (end >= 0) {
+			position = end + 1;
+		}
+	}
+	html.insert(position, head);
+	return html;
+}
+
+[[nodiscard]] Webview::StorageId StorageFor(not_null<Instance*> instance) {
+	const auto key = QCryptographicHash::hash(
+		(u"tele-script-webview:"_q + ScriptId(instance)).toUtf8(),
+		QCryptographicHash::Md5);
+	auto result = ScriptSession(instance)->local().resolveStorageIdOther();
+	result.path += u"-scripts/"_q + QString::fromLatin1(key.toHex());
+	result.token = key;
+	return result;
+}
+
+void PlaceOver(
+		not_null<Ui::SeparatePanel*> panel,
+		not_null<QWidget*> parent) {
+	if (!parent->isVisible() || parent->isMinimized()) {
+		return;
+	}
+	const auto screen = parent->screen();
+	const auto available = screen ? screen->availableGeometry() : QRect();
+	auto rect = panel->geometry();
+	rect.moveCenter(parent->geometry().center());
+	if (!available.isEmpty()) {
+		rect.moveLeft(std::max(
+			available.left(),
+			std::min(
+				rect.left(),
+				available.left() + available.width() - rect.width())));
+		rect.moveTop(std::max(
+			available.top(),
+			std::min(
+				rect.top(),
+				available.top() + available.height() - rect.height())));
+	}
+	Ui::SetGeometryAndScreen(panel, rect);
+}
