+[[nodiscard]] QString SettingsPath() {
+	return cWorkingDir() + u"tdata/tele_scripts.json"_q;
+}
+
+struct SourceSetting {
+	QString url;
+	QString etag;
+	QString latest;
+};
+
+struct GlobalSettings {
+	QString value;
+	base::flat_map<QString, SourceSetting> sources;
+	bool loaded = false;
+	rpl::event_stream<> changes;
+	rpl::event_stream<> sourcesChanged;
+};
+
+[[nodiscard]] GlobalSettings &Folder() {
+	static auto result = GlobalSettings();
+	if (!result.loaded) {
+		result.loaded = true;
+		auto file = QFile(SettingsPath());
+		if (file.open(QIODevice::ReadOnly)) {
+			const auto object = QJsonDocument::fromJson(
+				file.readAll()).object();
+			result.value = object.value(u"folder"_q).toString();
+			const auto sources = object.value(u"sources"_q).toObject();
+			for (auto i = sources.begin(); i != sources.end(); ++i) {
+				const auto entry = i.value().toObject();
+				const auto url = entry.value(u"url"_q).toString();
+				if (!i.key().isEmpty() && !url.isEmpty()) {
+					result.sources.emplace(i.key(), SourceSetting{
+						.url = url,
+						.etag = entry.value(u"etag"_q).toString(),
+						.latest = entry.value(u"latest"_q).toString(),
+					});
+				}
+			}
+		}
+	}
+	return result;
+}
+
+void WriteSettings() {
+	const auto &settings = Folder();
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	auto object = QJsonObject();
+	if (!settings.value.isEmpty()) {
+		object.insert(u"folder"_q, settings.value);
+	}
+	auto sources = QJsonObject();
+	for (const auto &[id, source] : settings.sources) {
+		auto entry = QJsonObject();
+		entry.insert(u"url"_q, source.url);
+		if (!source.etag.isEmpty()) {
+			entry.insert(u"etag"_q, source.etag);
+		}
+		if (!source.latest.isEmpty()) {
+			entry.insert(u"latest"_q, source.latest);
+		}
+		sources.insert(id, entry);
+	}
+	if (!sources.isEmpty()) {
+		object.insert(u"sources"_q, sources);
+	}
+	auto file = QFile(SettingsPath());
+	if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		file.write(QJsonDocument(object).toJson(QJsonDocument::Indented));
+	}
+}
