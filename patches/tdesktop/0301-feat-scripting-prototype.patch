+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kAnswerTimeout = crl::time(2000);
+constexpr auto kDebounce = crl::time(400);
+constexpr auto kMaxResults = 50;
+constexpr auto kMaxTitle = 256;
+constexpr auto kMaxDescription = 1024;
+constexpr auto kMaxError = 200;
+constexpr auto kMaxThumbBytes = 4 * 1024 * 1024;
+constexpr auto kMaxThumbArea = 4096 * 4096;
+constexpr auto kThumbSide = 160;
+constexpr auto kKeptAnswers = 16;
+constexpr auto kMinTrigger = 2;
+constexpr auto kMaxTrigger = 32;
+constexpr auto kChannelShift = std::int64_t(1000000000000);
+
+struct Entry {
+	Instance *owner = nullptr;
+	base::weak_ptr<Instance> instance;
+	Main::Session *session = nullptr;
+	int function = 0;
+	QString trigger;
+	QString title;
+};
+
+struct Waiting {
+	Instance *owner = nullptr;
+	Fn<void(JSContext*, JSValueConst, int)> answer;
+	Fn<void(int)> fallback;
+};
+
+struct Item {
+	int index = 0;
+	QString title;
+	QString description;
+	QImage thumb;
+	QByteArray thumbBytes;
+};
+
+struct Reply {
+	std::vector<Item> items;
+	QString error;
+};
+
+struct Cached {
+	int callId = 0;
+	InlineBots::Layout::CacheEntry entry;
+	QString error;
+};
+
+class Surface;
+
+struct Registry {
+	base::flat_map<int, Entry> entries;
+	base::flat_map<int, Waiting> waiting;
+	base::flat_map<not_null<const QWidget*>, Surface*> fields;
+	base::flat_map<not_null<const QWidget*>, Surface*> panels;
+	base::flat_set<Instance*> tracked;
+	int nextEntry = 0;
+	int nextCall = 0;
+};
+
+[[nodiscard]] Registry &State() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] bool ValidTrigger(const QString &trigger) {
+	const auto size = int(trigger.size());
+	if (size < kMinTrigger || size > kMaxTrigger) {
+		return false;
+	} else if (trigger[0] < QChar('a') || trigger[0] > QChar('z')) {
+		return false;
+	}
+	for (const auto ch : trigger) {
+		const auto letter = (ch >= QChar('a') && ch <= QChar('z'));
+		const auto digit = (ch >= QChar('0') && ch <= QChar('9'));
+		if (!letter && !digit && ch != QChar('_')) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] int FindEntry(
+		not_null<Main::Session*> session,
+		const QString &username) {
+	const auto trigger = username.toLower();
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.session == session
+			&& entry.trigger == trigger
+			&& entry.instance.get()) {
+			return id;
+		}
+	}
+	return 0;
+}
+
+[[nodiscard]] JSValue CallPayload(
+		JSContext *ctx,
+		const char *kind,
+		int callId) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "kind", JS_NewString(ctx, kind));
+	JS_SetPropertyStr(ctx, result, "callId", JS_NewInt32(ctx, callId));
+	return result;
+}
+
+[[nodiscard]] std::optional<Waiting> Take(int callId) {
+	auto &waiting = State().waiting;
+	const auto i = waiting.find(callId);
+	if (i == end(waiting)) {
+		return std::nullopt;
+	}
+	auto result = std::move(i->second);
+	waiting.erase(i);
+	return result;
+}
+
+int Ask(
+		const Entry &entry,
+		Fn<JSValue(JSContext*, int)> payload,
+		Fn<void(JSContext*, JSValueConst, int)> answer,
+		Fn<void(int)> fallback) {
+	auto &data = State();
+	const auto callId = ++data.nextCall;
+	data.waiting.emplace(callId, Waiting{
+		.owner = entry.owner,
+		.answer = std::move(answer),
+		.fallback = std::move(fallback),
+	});
+	base::call_delayed(kAnswerTimeout, [=] {
+		if (const auto waiting = Take(callId)) {
+			waiting->fallback(callId);
+		}
+	});
+	CallKept(entry.instance, entry.function, [=](JSContext *ctx) {
+		return payload(ctx, callId);
+	}, u"tg.registerInline"_q);
+	return callId;
+}
+
+void SendCancel(int entryId, int callId) {
+	crl::on_main([=] {
+		const auto &entries = State().entries;
+		const auto i = entries.find(entryId);
+		if (i == end(entries)) {
+			return;
+		}
+		CallKept(i->second.instance, i->second.function, [=](JSContext *ctx) {
+			return CallPayload(ctx, "cancel", callId);
+		}, u"tg.registerInline"_q);
+	});
+}
+
+[[nodiscard]] QImage ReadThumb(const QByteArray &bytes) {
+	auto copy = bytes;
+	auto buffer = QBuffer(&copy);
+	if (!buffer.open(QIODevice::ReadOnly)) {
+		return QImage();
+	}
+	auto reader = QImageReader(&buffer);
+	reader.setAutoTransform(true);
+	const auto size = reader.size();
+	if (!size.isValid()
+		|| size.isEmpty()
+		|| std::int64_t(size.width()) * size.height() > kMaxThumbArea) {
+		return QImage();
+	}
+	auto image = reader.read();
+	if (image.isNull()) {
+		return QImage();
+	} else if (image.width() > kThumbSide || image.height() > kThumbSide) {
+		image = image.scaled(
+			kThumbSide,
+			kThumbSide,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation);
+	}
+	return image;
+}
+
+[[nodiscard]] Reply ParseReply(JSContext *ctx, JSValueConst value) {
+	auto result = Reply();
+	if (!JS_IsObject(value)) {
+		result.error = u"no answer"_q;
+		return result;
+	}
+	result.error = StringProperty(ctx, value, "error").left(kMaxError);
+	if (!result.error.isEmpty()) {
+		return result;
+	}
+	auto list = JS_GetPropertyStr(ctx, value, "results");
+	auto length = std::int64_t();
+	if (!JS_IsArray(list)) {
+		JS_FreeValue(ctx, list);
+		return result;
+	} else if (JS_GetLength(ctx, list, &length) < 0) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		JS_FreeValue(ctx, list);
+		return result;
+	}
+	const auto count = int(std::min(length, std::int64_t(kMaxResults)));
+	for (auto i = 0; i != count; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, list, std::uint32_t(i));
+		if (JS_IsObject(item)) {
+			auto title = StringProperty(ctx, item, "title").left(kMaxTitle);
+			if (!title.trimmed().isEmpty()) {
+				auto entry = Item{
+					.index = i,
+					.title = std::move(title),
+					.description = StringProperty(
+						ctx,
+						item,
+						"description").left(kMaxDescription),
+				};
+				auto thumb = JS_GetPropertyStr(ctx, item, "thumb");
+				if (JS_IsObject(thumb)) {
+					if (auto bytes = BytesFrom(ctx, thumb)
+						; bytes && !bytes->isEmpty()
+						&& bytes->size() <= kMaxThumbBytes) {
+						entry.thumbBytes = std::move(*bytes);
+					}
+				}
+				JS_FreeValue(ctx, thumb);
+				result.items.push_back(std::move(entry));
+			}
+		}
+		JS_FreeValue(ctx, item);
+	}
+	JS_FreeValue(ctx, list);
+	return result;
+}
+
+[[nodiscard]] PhotoId ThumbPhoto(
+		not_null<Main::Session*> session,
+		const Item &item) {
+	const auto hash = QCryptographicHash::hash(
+		item.thumbBytes,
+		QCryptographicHash::Sha256);
+	auto id = PhotoId();
+	std::memcpy(&id, hash.constData(), sizeof(id));
+	id |= (PhotoId(1) << 62);
+	const auto photo = session->data().photo(id);
+	if (photo->isNull()) {
+		const auto image = Images::FromImageInMemory(item.thumb, "PNG");
+		[[maybe_unused]] const auto filled = session->data().photo(
+			id,
+			uint64(0),
+			QByteArray(),
+			base::unixtime::now(),
+			0,
+			false,
+			QByteArray(),
+			ImageWithLocation(),
+			image,
+			image,
+			ImageWithLocation(),
+			ImageWithLocation(),
+			crl::time(0));
+	}
+	return id;
+}
+
+[[nodiscard]] InlineBots::Layout::CacheEntry BuildEntry(
+		not_null<Main::Session*> session,
+		int callId,
+		const std::vector<Item> &items) {
+	using Flag = MTPDbotInlineMediaResult::Flag;
+	auto result = InlineBots::Layout::CacheEntry();
+	result.results.reserve(items.size());
+	for (const auto &item : items) {
+		auto flags = MTPDbotInlineMediaResult::Flags(Flag::f_title);
+		auto photo = MTPPhoto();
+		if (!item.description.isEmpty()) {
+			flags |= Flag::f_description;
+		}
+		if (!item.thumb.isNull()) {
+			flags |= Flag::f_photo;
+			photo = MTP_photoEmpty(MTP_long(ThumbPhoto(session, item)));
+		}
+		auto created = InlineBots::Result::Create(
+			session,
+			uint64(callId),
+			MTP_botInlineMediaResult(
+				MTP_flags(flags),
+				MTP_string(QString::number(item.index)),
+				MTP_string(u"article"_q),
+				photo,
+				MTPDocument(),
+				MTP_string(item.title),
+				MTP_string(item.description),
+				MTP_botInlineMessageText(
+					MTP_flags(0),
+					MTP_string(item.title),
+					MTPVector<MTPMessageEntity>(),
+					MTPReplyMarkup())));
+		if (created) {
+			result.results.push_back(std::move(created));
+		}
+	}
+	return result;
+}
+
+} // namespace
+
+struct InlineAccess {
+	using Panel = InlineBots::Layout::Widget;
+	using CacheEntry = InlineBots::Layout::CacheEntry;
+
+	[[nodiscard]] static not_null<InlineBots::Layout::Inner*> Inner(
+			not_null<Panel*> panel) {
+		return panel->_inner.data();
+	}
+
+	static void ShowResults(not_null<Panel*> panel, const CacheEntry &entry) {
+		panel->_inlineCache.clear();
+		panel->_inlineCache.emplace(
+			QString(),
+			std::make_unique<CacheEntry>(entry));
+		panel->_inlineQuery = panel->_inlineNextQuery = QString();
+		panel->_inlineQueryPeer = nullptr;
+		panel->showInlineRows(true);
+	}
+
+	static void ShowMessage(not_null<Panel*> panel) {
+		panel->_inlineCache.clear();
+		panel->_inlineQuery = panel->_inlineNextQuery = QString();
+		panel->_inlineQueryPeer = nullptr;
+		const auto inner = panel->_inner.data();
+		inner->refreshInlineRows(nullptr, nullptr, nullptr, true);
+		inner->resize(inner->width(), inner->countHeight());
+		panel->recountContentMaxHeight();
+		inner->update();
+		panel->showAnimated();
+	}
+
+	static void Hide(not_null<Panel*> panel) {
+		panel->_inlineCache.clear();
+		panel->hideAnimated();
+	}
+};
