+JSValue BookmarksList(JSContext *ctx) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"messages",
+		"tg.tele.bookmarks.list");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	for (const auto &bookmark : AllBookmarks(instance->session())) {
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"chatId",
+			JS_NewBigInt64(ctx, MarkedOf(bookmark.id.peer)));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"messageId",
+			JS_NewInt64(ctx, bookmark.id.msg.bare));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"topicId",
+			(bookmark.topicRootId.bare
+				? JS_NewInt64(ctx, bookmark.topicRootId.bare)
+				: JS_NULL));
+		JS_SetPropertyStr(ctx, item, "name", NewString(ctx, bookmark.name));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"preview",
+			NewString(ctx, bookmark.preview));
+		JS_SetPropertyStr(ctx, item, "date", JS_NewInt64(ctx, bookmark.date));
+		JS_SetPropertyUint32(ctx, result, index++, item);
+	}
+	return result;
+}
+
+JSValue BookmarksAdd(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Options,
+		{},
+		"tg.tele.bookmarks.add");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->session();
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto msgId = MsgIdAt(ctx, argc, argv, 1);
+	const auto peer = peerId ? session->data().peerLoaded(*peerId) : nullptr;
+	if (!peer || !msgId) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.bookmarks.add needs a chat in tele's cache and a "
+			"message id");
+	} else if (!MessageBookmarks()) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"tg.tele.bookmarks.add: bookmarks are off in tele's settings"_q);
+	}
+	const auto name = (argc > 2 && JS_IsString(argv[2]))
+		? FromStd(ToStd(ctx, argv[2]))
+		: QString();
+	auto created = NewPending(ctx);
+	if (JS_IsException(created.second)) {
+		return created.second;
+	}
+	const auto pending = created.first;
+	const auto id = FullMsgId(peer->id, *msgId);
+	const auto add = [=] {
+		const auto item = session->data().message(id);
+		if (!item) {
+			Reject(
+				pending,
+				"not-found",
+				u"tg.tele.bookmarks.add: no message %1 in that chat"_q.arg(
+					id.msg.bare));
+		} else if (!AddBookmark(item, name)) {
+			Reject(
+				pending,
+				"unsupported",
+				u"tg.tele.bookmarks.add: this message can't be bookmarked"_q);
+		} else {
+			Resolve(pending, [](JSContext*) {
+				return JS_UNDEFINED;
+			});
+		}
+	};
+	if (session->data().message(id)) {
+		add();
+	} else {
+		session->api().requestMessageData(
+			peer,
+			id.msg,
+			crl::guard(session.get(), add));
+	}
+	return created.second;
+}
+
+JSValue BookmarksRemove(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Options,
+		{},
+		"tg.tele.bookmarks.remove");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto msgId = MsgIdAt(ctx, argc, argv, 1);
+	if (!peerId || !msgId) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.bookmarks.remove needs a chat and a message id");
+	}
+	const auto session = instance->session();
+	const auto id = FullMsgId(*peerId, *msgId);
+	const auto had = ranges::contains(
+		AllBookmarks(session),
+		id,
+		&Bookmark::id);
+	if (had) {
+		RemoveBookmark(session, id);
+	}
+	return JS_NewBool(ctx, had);
+}
