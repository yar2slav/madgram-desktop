--- /dev/null
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_stories.cpp
@@ -0,0 +1,1022 @@
+#include "tele/scripting/tele_script_stories.h"
+
+#include "tele/scripting/tele_script_instance.h"
+#include "tele/scripting/tele_script_native.h"
+#include "tele/scripting/tele_script_tl.h"
+#include "tele/tele_ghost.h"
+#include "tele/tele_invisible_stories.h"
+#include "base/call_delayed.h"
+#include "base/random.h"
+#include "base/unixtime.h"
+#include "data/data_peer.h"
+#include "data/data_peer_id.h"
+#include "data/data_session.h"
+#include "data/data_stories.h"
+#include "data/data_story.h"
+#include "main/main_session.h"
+#include "storage/file_download.h"
+#include "storage/file_upload.h"
+#include "storage/localimageloader.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+
+#include <cmath>
+#include <map>
+#include <memory>
+#include "styles/style_menu_icons.h"
+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kChannelShift = std::int64_t(1000000000000);
+constexpr auto kVerdictTimeout = crl::time(2000);
+constexpr auto kUploadTimeout = crl::time(120000);
+
+enum Magic {
+	kUpload,
+	kGhost,
+	kApplyRead,
+	kApplyDeleted,
+	kSources,
+	kAction,
+	kIntercept,
+	kWatch,
+	kUnregister,
+	kAnswer,
+};
+
+struct Owned {
+	Instance *owner = nullptr;
+	base::weak_ptr<Instance> weak;
+	int id = 0;
+	int kept = 0;
+};
+
+struct Action {
+	Owned owned;
+	QString text;
+};
+
+struct Watcher {
+	Owned owned;
+	TimeId since = 0;
+	base::flat_map<PeerId, base::flat_set<StoryId>> known;
+	rpl::lifetime lifetime;
+};
+
+struct Verdict {
+	Instance *owner = nullptr;
+	Fn<void(bool)> done;
+};
+
+struct Transfer {
+	Instance *owner = nullptr;
+	Pending pending;
+	FullMsgId fullId;
+	base::weak_ptr<Main::Session> session;
+	rpl::lifetime lifetime;
+};
+
+struct Registry {
+	std::vector<Action> actions;
+	std::vector<Owned> interceptors;
+	std::vector<std::unique_ptr<Watcher>> watchers;
+	std::map<int, Verdict> verdicts;
+	std::map<int, Transfer> transfers;
+	base::flat_set<Instance*> tracked;
+	int next = 0;
+};
+
+struct StoryInfo {
+	std::int64_t peer = 0;
+	StoryId id = 0;
+	TimeId date = 0;
+	TimeId expires = 0;
+	bool pinned = false;
+	QString privacy = u"other"_q;
+	QString caption;
+	QString media = u"other"_q;
+};
+
+struct ViewChain {
+	std::vector<Owned> list;
+	StoryInfo info;
+	Fn<void(bool)> done;
+};
+
+[[nodiscard]] Registry &StoriesRegistry() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] std::optional<PeerId> PeerArgument(
+		JSContext *ctx,
+		JSValueConst value) {
+	auto id = std::int64_t();
+	if (JS_IsBigInt(value)) {
+		if (JS_ToBigInt64(ctx, &id, value) < 0) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			return std::nullopt;
+		}
+	} else if (JS_IsNumber(value)) {
+		auto number = 0.;
+		if (JS_ToFloat64(ctx, &number, value) < 0
+			|| number != std::floor(number)) {
+			return std::nullopt;
+		}
+		id = std::int64_t(number);
+	} else {
+		return std::nullopt;
+	}
+	if (id > 0) {
+		return peerFromUser(UserId(std::uint64_t(id)));
+	} else if (id <= -kChannelShift) {
+		return peerFromChannel(ChannelId(std::uint64_t(-id - kChannelShift)));
+	} else if (id < 0) {
+		return peerFromChat(ChatId(std::uint64_t(-id)));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<int> IntArgument(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv,
+		int index) {
+	if (argc <= index || !JS_IsNumber(argv[index])) {
+		return std::nullopt;
+	}
+	auto value = int32_t();
+	if (JS_ToInt32(ctx, &value, argv[index]) < 0) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return std::nullopt;
+	}
+	return int(value);
+}
+
+[[nodiscard]] QString PrivacyName(Data::StoryPrivacy privacy) {
+	switch (privacy) {
+	case Data::StoryPrivacy::Public: return u"everyone"_q;
+	case Data::StoryPrivacy::CloseFriends: return u"close"_q;
+	case Data::StoryPrivacy::Contacts: return u"contacts"_q;
+	case Data::StoryPrivacy::SelectedContacts: return u"selected"_q;
+	case Data::StoryPrivacy::Other: return u"other"_q;
+	}
+	return u"other"_q;
+}
+
+[[nodiscard]] StoryInfo InfoOf(
+		not_null<Main::Session*> session,
+		FullStoryId id) {
+	auto result = StoryInfo{ .peer = MarkedId(id.peer), .id = id.story };
+	const auto maybe = session->data().stories().lookup(id);
+	if (!maybe) {
+		return result;
+	}
+	const auto story = *maybe;
+	result.date = story->date();
+	result.expires = story->expires();
+	result.pinned = story->inProfile();
+	result.privacy = PrivacyName(story->privacy());
+	result.caption = story->caption().text;
+	result.media = story->photo()
+		? u"photo"_q
+		: story->document()
+		? u"video"_q
+		: story->call()
+		? u"live"_q
+		: u"other"_q;
+	return result;
+}
+
+[[nodiscard]] JSValue ViewPayload(
+		JSContext *ctx,
+		const StoryInfo &info,
+		int callId) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "callId", JS_NewInt32(ctx, callId));
+	JS_SetPropertyStr(ctx, result, "peer", JS_NewBigInt64(ctx, info.peer));
+	JS_SetPropertyStr(ctx, result, "storyId", JS_NewInt32(ctx, info.id));
+	JS_SetPropertyStr(ctx, result, "date", JS_NewInt32(ctx, info.date));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"expireDate",
+		JS_NewInt32(ctx, info.expires));
+	JS_SetPropertyStr(ctx, result, "pinned", JS_NewBool(ctx, info.pinned));
+	JS_SetPropertyStr(ctx, result, "privacy", NewString(ctx, info.privacy));
+	JS_SetPropertyStr(ctx, result, "caption", NewString(ctx, info.caption));
+	JS_SetPropertyStr(ctx, result, "media", NewString(ctx, info.media));
+	return result;
+}
+
+void ApplyRead(
+		not_null<Main::Session*> session,
+		PeerId peer,
+		StoryId maxId) {
+	session->data().stories().apply(MTP_updateReadStories(
+		peerToMTP(peer),
+		MTP_int(maxId)).c_updateReadStories());
+}
+
+void Settle(int callId, bool skip, Instance *owner = nullptr) {
+	auto &verdicts = StoriesRegistry().verdicts;
+	const auto i = verdicts.find(callId);
+	if (i == end(verdicts) || (owner && i->second.owner != owner)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	verdicts.erase(i);
+	if (done) {
+		crl::on_main([=] {
+			done(skip);
+		});
+	}
+}
+
+void FinishUpload(
+		int key,
+		std::optional<MTPInputFile> file,
+		const QString &error) {
+	auto &transfers = StoriesRegistry().transfers;
+	const auto i = transfers.find(key);
+	if (i == end(transfers)) {
+		return;
+	}
+	const auto pending = i->second.pending;
+	const auto fullId = i->second.fullId;
+	const auto session = i->second.session.get();
+	transfers.erase(i);
+	if (!file) {
+		if (session) {
+			session->uploader().cancel(fullId);
+		}
+		Reject(
+			pending,
+			(error == u"timed out"_q) ? "timed-out" : "network",
+			u"tg.stories.post: "_q + error);
+		return;
+	}
+	const auto strong = pending.instance.get();
+	const auto ctx = strong ? strong->context() : nullptr;
+	if (!ctx) {
+		return;
+	}
+	auto buffer = mtpBuffer();
+	file->write(buffer);
+	auto decoded = DecodeTl(
+		ctx,
+		std::string_view(
+			reinterpret_cast<const char*>(buffer.constData()),
+			std::size_t(buffer.size()) * sizeof(mtpPrime)),
+		"InputFile");
+	if (!decoded.error.empty()) {
+		Reject(
+			pending,
+			"internal",
+			u"tg.stories.post: "_q + FromStd(decoded.error));
+		return;
+	}
+	const auto value = decoded.value;
+	Resolve(pending, [=](JSContext*) {
+		return value;
+	});
+}
+
+void RemoveOwner(Instance *owner) {
+	auto &registry = StoriesRegistry();
+	registry.tracked.remove(owner);
+	registry.actions.erase(
+		ranges::remove(registry.actions, owner, [](const Action &action) {
+			return action.owned.owner;
+		}),
+		end(registry.actions));
+	registry.interceptors.erase(
+		ranges::remove(registry.interceptors, owner, &Owned::owner),
+		end(registry.interceptors));
+	registry.watchers.erase(
+		ranges::remove(registry.watchers, owner, [](
+				const std::unique_ptr<Watcher> &watcher) {
+			return watcher->owned.owner;
+		}),
+		end(registry.watchers));
+	auto calls = std::vector<int>();
+	for (const auto &[callId, verdict] : registry.verdicts) {
+		if (verdict.owner == owner) {
+			calls.push_back(callId);
+		}
+	}
+	for (const auto callId : calls) {
+		Settle(callId, false);
+	}
+	for (auto i = begin(registry.transfers); i != end(registry.transfers);) {
+		if (i->second.owner != owner) {
+			++i;
+			continue;
+		}
+		if (const auto session = i->second.session.get()) {
+			session->uploader().cancel(i->second.fullId);
+		}
+		i = registry.transfers.erase(i);
+	}
+}
+
+void Track(not_null<Instance*> instance) {
+	auto &registry = StoriesRegistry();
+	const auto raw = instance.get();
+	if (registry.tracked.contains(raw)) {
+		return;
+	}
+	registry.tracked.emplace(raw);
+	ScriptLifetime(instance).add([=] {
+		RemoveOwner(raw);
+	});
+}
+
+void Remove(Instance *owner, int id) {
+	auto &registry = StoriesRegistry();
+	const auto matches = [&](const Owned &owned) {
+		if (owned.owner != owner || owned.id != id) {
+			return false;
+		}
+		ForgetKept(owned.weak, owned.kept);
+		return true;
+	};
+	registry.actions.erase(
+		ranges::remove_if(registry.actions, [&](const Action &action) {
+			return matches(action.owned);
+		}),
+		end(registry.actions));
+	registry.interceptors.erase(
+		ranges::remove_if(registry.interceptors, matches),
+		end(registry.interceptors));
+	registry.watchers.erase(
+		ranges::remove_if(registry.watchers, [&](
+				const std::unique_ptr<Watcher> &watcher) {
+			return matches(watcher->owned);
+		}),
+		end(registry.watchers));
+}
+
+void Ask(std::shared_ptr<const ViewChain> chain, int index) {
+	if (index >= int(chain->list.size())) {
+		chain->done(false);
+		return;
+	}
+	auto &registry = StoriesRegistry();
+	const auto &entry = chain->list[index];
+	const auto alive = entry.weak.get()
+		&& ranges::any_of(registry.interceptors, [&](const Owned &owned) {
+			return owned.owner == entry.owner && owned.id == entry.id;
+		});
+	if (!alive) {
+		Ask(chain, index + 1);
+		return;
+	}
+	const auto callId = ++registry.next;
+	registry.verdicts.emplace(callId, Verdict{
+		.owner = entry.owner,
+		.done = [=](bool skip) {
+			if (skip) {
+				chain->done(true);
+			} else {
+				Ask(chain, index + 1);
+			}
+		},
+	});
+	const auto info = chain->info;
+	CallKept(entry.weak, entry.kept, [=](JSContext *ctx) {
+		return ViewPayload(ctx, info, callId);
+	}, u"tg.stories.interceptStoryView"_q);
+	base::call_delayed(kVerdictTimeout, [=] {
+		Settle(callId, false);
+	});
+}
+
+[[nodiscard]] JSValue Upload(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountWrite,
+		"stories",
+		"tg.stories.post");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto bytes = (argc > 0)
+		? BytesFrom(ctx, argv[0])
+		: std::optional<QByteArray>();
+	if (!bytes) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.stories.post: media must be a Uint8Array or an InputMedia");
+	} else if (bytes->isEmpty()) {
+		return JS_ThrowTypeError(ctx, "tg.stories.post: the media is empty");
+	} else if (bytes->size() > Storage::kMaxFileInMemory) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"tg.stories.post: the media is over 10 MB"_q);
+	}
+	const auto name = (argc > 1 && JS_IsString(argv[1]))
+		? FromStd(ToStd(ctx, argv[1]))
+		: u"story.jpg"_q;
+	auto [pending, promise] = NewPending(ctx);
+	if (JS_IsException(promise)) {
+		return promise;
+	}
+	Track(instance);
+	const auto session = ScriptSession(instance);
+	const auto fullId = FullMsgId(
+		session->userPeerId(),
+		session->data().nextLocalMessageId());
+	auto prepared = MakePreparedFile({
+		.id = base::RandomValue<uint64>(),
+		.type = SendMediaType::SecondaryFile,
+	});
+	prepared->filename = name;
+	prepared->filesize = int64(bytes->size());
+	prepared->setFileData(*bytes);
+	auto &registry = StoriesRegistry();
+	const auto key = ++registry.next;
+	auto &transfer = registry.transfers[key];
+	transfer.owner = instance;
+	transfer.pending = pending;
+	transfer.fullId = fullId;
+	transfer.session = base::make_weak(session);
+	auto &uploader = session->uploader();
+	rpl::merge(
+		uploader.secondaryFileReady(),
+		uploader.documentReady()
+	) | rpl::filter([=](const Storage::UploadedMedia &media) {
+		return media.fullId == fullId;
+	}) | rpl::take(1) | rpl::on_next([=](const Storage::UploadedMedia &media) {
+		const auto file = media.info.file;
+		crl::on_main([=] {
+			FinishUpload(key, file, QString());
+		});
+	}, transfer.lifetime);
+	rpl::merge(
+		uploader.secondaryFileFailed(),
+		uploader.documentFailed()
+	) | rpl::filter([=](const FullMsgId &failed) {
+		return failed == fullId;
+	}) | rpl::take(1) | rpl::on_next([=] {
+		crl::on_main([=] {
+			FinishUpload(key, std::nullopt, u"the upload failed"_q);
+		});
+	}, transfer.lifetime);
+	uploader.upload(fullId, prepared);
+	base::call_delayed(kUploadTimeout, [=] {
+		FinishUpload(key, std::nullopt, u"timed out"_q);
+	});
+	return promise;
+}
+
+[[nodiscard]] JSValue Ghost(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountWrite,
+		"stories",
+		"tg.stories.markRead");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto peerId = (argc > 0)
+		? PeerArgument(ctx, argv[0])
+		: std::optional<PeerId>();
+	const auto maxId = IntArgument(ctx, argc, argv, 1);
+	if (!peerId || !maxId) {
+		return JS_ThrowTypeError(ctx, "tg.stories.markRead(peer, maxId)");
+	}
+	const auto session = ScriptSession(instance);
+	const auto peer = session->data().peer(*peerId);
+	if (peer->isSelf() || !Tele::InvisibleStories(peer)) {
+		return JS_FALSE;
+	}
+	Tele::RememberStoryRead(session, { .peer = *peerId, .story = *maxId });
+	ApplyRead(session, *peerId, *maxId);
+	return JS_TRUE;
+}
+
+[[nodiscard]] JSValue ApplyReadNative(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountWrite,
+		"stories",
+		"tg.stories.markRead");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto peerId = (argc > 0)
+		? PeerArgument(ctx, argv[0])
+		: std::optional<PeerId>();
+	const auto maxId = IntArgument(ctx, argc, argv, 1);
+	if (peerId && maxId) {
+		ApplyRead(ScriptSession(instance), *peerId, *maxId);
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue ApplyDeleted(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountWrite,
+		"stories",
+		"tg.stories.delete");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto peerId = (argc > 0)
+		? PeerArgument(ctx, argv[0])
+		: std::optional<PeerId>();
+	if (!peerId || argc < 2 || !JS_IsArray(argv[1])) {
+		return JS_UNDEFINED;
+	}
+	auto length = JS_GetPropertyStr(ctx, argv[1], "length");
+	auto count = uint32_t();
+	JS_ToUint32(ctx, &count, length);
+	JS_FreeValue(ctx, length);
+	auto &stories = ScriptSession(instance)->data().stories();
+	for (auto i = uint32_t(); i != count; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, argv[1], i);
+		auto id = int32_t();
+		const auto valid = JS_IsNumber(item)
+			&& JS_ToInt32(ctx, &id, item) >= 0
+			&& id > 0;
+		JS_FreeValue(ctx, item);
+		if (valid) {
+			stories.apply(MTP_updateStory(
+				peerToMTP(*peerId),
+				MTP_storyItemDeleted(MTP_int(id))).c_updateStory());
+		}
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue Sources(JSContext *ctx) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"stories",
+		"tg.stories.sources");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto &stories = ScriptSession(instance)->data().stories();
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	for (const auto list : {
+		Data::StorySourcesList::NotHidden,
+		Data::StorySourcesList::Hidden,
+	}) {
+		for (const auto &info : stories.sources(list)) {
+			auto entry = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				entry,
+				"peer",
+				JS_NewBigInt64(ctx, MarkedId(info.id)));
+			JS_SetPropertyStr(
+				ctx,
+				entry,
+				"count",
+				JS_NewInt32(ctx, int(info.count)));
+			JS_SetPropertyStr(
+				ctx,
+				entry,
+				"unread",
+				JS_NewInt32(ctx, int(info.unreadCount)));
+			JS_SetPropertyStr(ctx, entry, "last", JS_NewInt32(ctx, info.last));
+			JS_SetPropertyStr(
+				ctx,
+				entry,
+				"hidden",
+				JS_NewBool(ctx, list == Data::StorySourcesList::Hidden));
+			JS_SetPropertyStr(
+				ctx,
+				entry,
+				"live",
+				JS_NewBool(ctx, info.hasVideoStream != 0));
+			JS_SetPropertyUint32(ctx, result, index++, entry);
+		}
+	}
+	return result;
+}
