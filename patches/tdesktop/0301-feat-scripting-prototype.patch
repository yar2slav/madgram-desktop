+JSValue DeletedAnswer(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto callId = std::int32_t();
+	if (argc < 2 || JS_ToInt32(ctx, &callId, argv[0]) < 0) {
+		return JS_ThrowTypeError(ctx, "needs a call id and a verdict");
+	}
+	auto &verdicts = Get().verdicts;
+	const auto i = verdicts.find(callId);
+	if (i == end(verdicts) || i->second.owner != instance.get()) {
+		return JS_FALSE;
+	}
+	const auto verdict = i->second;
+	verdicts.erase(i);
+	if (ToStd(ctx, argv[1]) == "discard") {
+		if (const auto session = verdict.session.get()) {
+			const auto id = verdict.id;
+			crl::on_main(session, [=] {
+				Discard(session, id);
+			});
+		}
+	}
+	return JS_TRUE;
+}
