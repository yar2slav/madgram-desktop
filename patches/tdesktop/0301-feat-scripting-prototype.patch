+		}
+		item(entry);
+	});
+	if (entries.length > kPreviewEntries || node[3] > 0) {
+		box.appendChild(span('v-punct', entries.length ? ', \u2026' : '\u2026'));
+	}
+	box.appendChild(span('v-punct', close));
