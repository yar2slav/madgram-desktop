+class StripWorker final {
+public:
+	StripWorker();
+	~StripWorker();
+
+	[[nodiscard]] static std::shared_ptr<StripWorker> Shared();
+
+	[[nodiscard]] std::optional<Stripped> strip(
+		const QByteArray &code,
+		const QString &file,
+		QString &error);
+
+private:
+	QThread _thread;
+	std::unique_ptr<QObject> _context;
+	std::unique_ptr<Stripper> _stripper;
+
+};
+
+StripWorker::StripWorker()
+: _context(std::make_unique<QObject>()) {
+	_thread.setStackSize(kStripThreadStack);
+	_context->moveToThread(&_thread);
+	_thread.start();
+}
+
+StripWorker::~StripWorker() {
+	QMetaObject::invokeMethod(_context.get(), [&] {
+		_stripper = nullptr;
+	}, Qt::BlockingQueuedConnection);
+	_thread.quit();
+	_thread.wait();
+}
+
+std::shared_ptr<StripWorker> StripWorker::Shared() {
+	static auto weak = std::weak_ptr<StripWorker>();
+	if (auto result = weak.lock()) {
+		return result;
+	}
+	auto result = std::make_shared<StripWorker>();
+	weak = result;
+	return result;
+}
+
+std::optional<Stripped> StripWorker::strip(
+		const QByteArray &code,
+		const QString &file,
+		QString &error) {
+	auto result = std::optional<Stripped>();
+	QMetaObject::invokeMethod(_context.get(), [&] {
+		if (!_stripper) {
+			_stripper = std::make_unique<Stripper>();
+		}
+		result = _stripper->strip(code, file, error);
+	}, Qt::BlockingQueuedConnection);
+	return result;
+}
