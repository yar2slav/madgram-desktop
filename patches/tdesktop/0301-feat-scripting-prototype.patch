+[[nodiscard]] std::optional<QUrl> ParseLink(const QString &text) {
+	const auto url = QUrl(text.trimmed());
+	const auto scheme = url.scheme().toLower();
+	return (url.isValid() && (scheme == u"http"_q || scheme == u"https"_q))
+		? std::make_optional(url)
+		: std::nullopt;
+}
