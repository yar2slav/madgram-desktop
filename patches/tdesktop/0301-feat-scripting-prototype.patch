+[[nodiscard]] TextWithTags ExtractMarkdownLinks(const QString &text) {
+	static const auto expression = QRegularExpression(
+		uR"(\[([^\[\]\n]+)\]\(([^()\s]+)\))"_q);
+	auto result = TextWithTags();
+	auto from = 0;
+	auto iterator = expression.globalMatch(text);
+	while (iterator.hasNext()) {
+		const auto match = iterator.next();
+		const auto url = match.captured(2);
+		if (!Ui::InputField::IsValidMarkdownLink(url)) {
+			continue;
+		}
+		const auto label = match.captured(1);
+		result.text.append(text.mid(from, match.capturedStart() - from));
+		result.tags.push_back({
+			int(result.text.size()),
+			int(label.size()),
+			url,
+		});
+		result.text.append(label);
+		from = match.capturedEnd();
+	}
+	result.text.append(text.mid(from));
+	return result;
+}
+
+[[nodiscard]] TextWithTags ApplyMarkdown(const QString &text) {
+	auto field = Ui::InputField(
+		nullptr,
+		st::defaultInputField,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(QString()),
+		QString());
+	field.setMarkdownReplacesEnabled(true);
+	field.setTextWithTags(ExtractMarkdownLinks(text));
+	return field.getTextWithAppliedMarkdown();
+}
+
+void FeedPeers(
+		not_null<Main::Session*> session,
+		const QByteArray &bytes,
+		std::string_view type) {
+	auto users = QVector<MTPUser>();
+	auto chats = QVector<MTPChat>();
+	ForEachObject(
+		std::string_view(bytes.constData(), bytes.size()),
+		type,
+		[&](std::string_view kind, std::string_view span) {
+			auto from = reinterpret_cast<const mtpPrime*>(span.data());
+			const auto end = from + (span.size() / sizeof(mtpPrime));
+			if (kind == "User") {
+				auto user = MTPUser();
+				if (user.read(from, end)) {
+					users.push_back(user);
+				}
+			} else {
+				auto chat = MTPChat();
+				if (chat.read(from, end)) {
+					chats.push_back(chat);
+				}
+			}
+		});
+	if (!users.isEmpty()) {
+		session->data().processUsers(MTP_vector<MTPUser>(std::move(users)));
+	}
+	if (!chats.isEmpty()) {
+		session->data().processChats(MTP_vector<MTPChat>(std::move(chats)));
+	}
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] std::vector<int> IndexesProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::vector<int>();
+	auto length = std::int64_t();
+	if (JS_IsNumber(value)) {
+		auto index = 0;
+		JS_ToInt32(ctx, &index, value);
+		result.push_back(index);
+	} else if (JS_IsArray(value) && JS_GetLength(ctx, value, &length) >= 0) {
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, value, std::uint32_t(i));
+			auto index = 0;
+			JS_ToInt32(ctx, &index, item);
+			JS_FreeValue(ctx, item);
+			result.push_back(index);
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
