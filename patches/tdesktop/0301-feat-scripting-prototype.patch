+	const signParams = (params, slot) => {
+		switch (params.name) {
+		case 'ECDSA':
+			return [hashOf(params.hash), 0];
+		case 'RSA-PSS': {
+			const { saltLength } = params;
+			if (!Number.isInteger(saltLength) || saltLength < 0) {
+				throw new TypeError('saltLength must be a non-negative integer');
+			}
+			return [slot.algorithm.hash.name, saltLength];
+		}
+		case 'Ed25519':
+			return ['', 0];
+		}
+		return [slot.algorithm.hash.name, 0];
+	};
+
+	const derive = (params, slot, length) => {
+		const bits = (length === null || length === undefined) ? null : length;
+		if (bits !== null && (!Number.isInteger(bits) || bits < 0)) {
+			throw new TypeError('length must be a non-negative integer or null');
+		}
+		switch (params.name) {
+		case 'PBKDF2': {
+			const hash = hashOf(params.hash);
+			const salt = bytesOf(params.salt, 'salt');
+			const { iterations } = params;
+			if (bits === null || bits === 0 || bits % 8) {
+				throw fail('OperationError', 'PBKDF2 derives a non-zero multiple of 8 bits');
+			} else if (!Number.isInteger(iterations) || iterations < 1) {
+				throw fail('OperationError', 'iterations must be at least 1');
+			}
+			return natives.cryptoDerive('PBKDF2', slot.handle, bits, hash, salt, iterations);
+		}
+		case 'HKDF': {
+			const hash = hashOf(params.hash);
+			const salt = bytesOf(params.salt, 'salt');
+			const info = bytesOf(params.info, 'info');
+			if (bits === null || bits % 8) {
+				throw fail('OperationError', 'HKDF derives a multiple of 8 bits');
+			} else if (bits === 0) {
+				return Promise.resolve(new ArrayBuffer(0));
+			}
+			return natives.cryptoDerive('HKDF', slot.handle, bits, hash, salt, info);
+		}
+		case 'ECDH':
+		case 'X25519': {
+			const other = slots.get(params.public);
+			if (!other) {
+				throw new TypeError('public must be a CryptoKey');
+			} else if (other.type !== 'public') {
+				throw fail('InvalidAccessError', 'public must be a public key');
+			} else if (other.algorithm.name !== params.name) {
+				throw fail('InvalidAccessError', `public must be a ${params.name} key`);
+			} else if (params.name === 'ECDH' && other.algorithm.namedCurve !== slot.algorithm.namedCurve) {
+				throw fail('InvalidAccessError', 'both keys must be on the same curve');
+			}
+			return natives.cryptoDerive(params.name, slot.handle, bits ?? -1, other.handle);
+		}
+		}
