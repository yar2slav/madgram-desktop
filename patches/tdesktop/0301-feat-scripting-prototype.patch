+void Host::beforeResult(const MTP::Response &response) {
+	if (!_listened.remove(response.requestId)) {
+		return;
+	}
+	const auto bytes = View(response.reply.constData(), response.reply.size());
+	if (LeadingId(bytes) != kRpcErrorId) {
+		feed(bytes);
+	}
+}
+
+bool Host::beforeUpdate(
+		const MTP::Response &message,
+		Fn<void(const MTP::Response&)> deliver) {
+	if (Sending > 0) {
+		return false;
+	} else if (_updates.empty() && interceptors().empty()) {
+		feed(View(message.reply.constData(), message.reply.size()));
+		return false;
+	}
+	_updates.push_back({ .message = message, .deliver = std::move(deliver) });
+	if (_updates.size() == 1) {
+		processUpdates();
+	}
+	return true;
+}
+
+void Host::appendActions(
+		not_null<Ui::PopupMenu*> menu,
+		MenuKind kind,
+		const ActionContext &context) {
+	const auto index = (kind == MenuKind::Message)
+		? 0
+		: (kind == MenuKind::Chat)
+		? 1
+		: (kind == MenuKind::ChatRow)
+		? 2
+		: (kind == MenuKind::Profile)
+		? 3
+		: -1;
+	if (index < 0) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	for (const auto &entry : _entries) {
+		const auto instance = entry.instance.get();
+		if (!instance) {
+			continue;
+		}
+		const auto script = entry.file.id;
+		for (const auto &action : instance->actions(index)) {
+			if (!instance->actionVisible(action.id, context)) {
+				continue;
+			}
+			const auto id = action.id;
+			TagMenuAction(menu->addAction(action.text, [=] {
+				crl::on_main(weak, [=] {
+					if (const auto strong = weak.get()) {
+						if (const auto target = strong->instanceOf(script)) {
+							target->runAction(id, context);
+						}
+					}
+				});
+			}, &st::menuIconExperimental), action.key);
+		}
+	}
+}
