+	if (const auto chat = peer->asChat()) {
+		chat->setGroupCallDefaultJoinAs(joinAs);
+	} else if (const auto channel = peer->asChannel()) {
+		channel->setGroupCallDefaultJoinAs(joinAs);
+	}
+}
+
+void FindCall(
+		not_null<PeerData*> peer,
+		Fn<void(Data::GroupCall*)> done,
+		Fn<void(const MTP::Error&)> fail) {
+	if (const auto real = peer->groupCall()) {
+		done(real);
+		return;
+	}
+	const auto api = &peer->session().api();
+	const auto got = [=](const MTPmessages_ChatFull &result) {
+		api->processFullPeer(peer, result);
+		done(peer->groupCall());
+	};
+	const auto failed = [=](const MTP::Error &error) {
+		fail(error);
+	};
+	if (const auto chat = peer->asChat()) {
+		api->request(MTPmessages_GetFullChat(
+			chat->inputChat()
+		)).done(got).fail(failed).send();
+	} else if (const auto channel = peer->asChannel()) {
+		api->request(MTPchannels_GetFullChannel(
+			channel->inputChannel()
+		)).done(got).fail(failed).send();
+	} else {
+		done(nullptr);
+	}
+}
+
+struct FetchState {
+	MTPInputGroupCall input;
+	int limit = 0;
+	std::vector<ParticipantState> list;
+	Fn<void(std::vector<ParticipantState>)> done;
+	Fn<void(const MTP::Error&)> fail;
+};
+
+void FetchPage(
+		not_null<Main::Session*> session,
+		std::shared_ptr<FetchState> state,
+		const QString &offset) {
+	const auto count = std::min(
+		kPage,
+		state->limit - int(state->list.size()));
+	session->api().request(MTPphone_GetGroupParticipants(
+		state->input,
+		MTP_vector<MTPInputPeer>(),
+		MTP_vector<MTPint>(),
+		MTP_string(offset),
+		MTP_int(count)
+	)).done([=](const MTPphone_GroupParticipants &result) {
+		auto next = QString();
+		auto received = 0;
+		result.match([&](const MTPDphone_groupParticipants &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			next = qs(data.vnext_offset());
+			received = data.vparticipants().v.size();
+			for (const auto &participant : data.vparticipants().v) {
+				participant.match([&](const MTPDgroupCallParticipant &fields) {
+					if (!fields.is_left()
+						&& int(state->list.size()) < state->limit) {
+						state->list.push_back(StateOf(fields));
+					}
+				});
+			}
+		});
+		if (next.isEmpty()
+			|| !received
+			|| int(state->list.size()) >= state->limit) {
+			state->done(base::take(state->list));
+		} else {
+			FetchPage(session, state, next);
+		}
+	}).fail([=](const MTP::Error &error) {
+		state->fail(error);
+	}).send();
+}
+
+void LoadParticipants(
+		Pending pending,
+		not_null<Main::Session*> session,
+		PeerData *peer,
+		int limit) {
+	const auto current = CurrentCall(session);
+	if (current
+		&& (!peer || current->peer() == peer)
+		&& current->lookupReal()) {
+		auto list = CurrentParticipants(current);
+		if (int(list.size()) > limit) {
+			list.resize(limit);
+		}
+		Resolve(pending, [=](JSContext *ctx) {
+			return ParticipantsValue(ctx, session, list);
+		});
+		return;
+	} else if (!peer) {
+		Reject(
+			pending,
+			"not-found",
+			Lower(u"There's no video chat right now."_q));
+		return;
+	}
+	const auto name = peer->name();
+	FindCall(peer, [=](Data::GroupCall *real) {
+		if (!real) {
+			Reject(
+				pending,
+				"not-found",
+				Lower(u"%1 has no video chat."_q).arg(name));
+			return;
+		}
+		const auto state = std::make_shared<FetchState>(FetchState{
+			.input = real->input(),
+			.limit = limit,
+			.done = [=](std::vector<ParticipantState> list) {
+				Resolve(pending, [=](JSContext *ctx) {
+					return ParticipantsValue(ctx, session, list);
+				});
+			},
+			.fail = [=](const MTP::Error &error) {
+				RejectRpc(pending, error);
+			},
+		});
+		FetchPage(session, state, QString());
+	}, [=](const MTP::Error &error) {
+		RejectRpc(pending, error);
+	});
+}
+
+void WaitJoined(
+		Pending pending,
+		base::weak_ptr<Instance> weak,
+		not_null<PeerData*> peer,
+		bool muted) {
+	using State = Calls::GroupCall::State;
+	const auto session = &peer->session();
+	const auto lifetime = std::make_shared<rpl::lifetime>();
+	const auto settled = std::make_shared<bool>(false);
+	const auto settle = [=](Fn<void()> action) {
+		if (*settled) {
+			return;
+		}
+		*settled = true;
+		action();
+		crl::on_main([lifetime] {
+			lifetime->destroy();
+		});
+	};
+	Core::App().calls().currentGroupCallValue(
+	) | rpl::map([=](Calls::GroupCall *call) -> rpl::producer<int> {
+		if (!call || call->peer() != peer) {
+			return rpl::single(-1);
+		}
+		return call->stateValue() | rpl::map([](State state) {
+			return int(state);
+		});
+	}) | rpl::flatten_latest(
+	) | rpl::on_next([=](int state) {
+		const auto call = Core::App().calls().currentGroupCall();
+		if (!call || call->peer() != peer) {
+			return;
+		} else if (state == int(State::Joined)
+			|| (state == int(State::Waiting) && call->scheduleDate())) {
+			const auto guard = base::make_weak(call);
+			settle([=] {
+				crl::on_main([=] {
+					if (const auto strong = guard.get()) {
+						ApplyMuted(strong, muted);
+					}
+					if (CurrentCall(session)) {
+						Resolve(pending, [=](JSContext *ctx) {
+							return GroupValue(ctx, session);
+						});
+					} else {
+						Reject(
+							pending,
+							"internal",
+							Lower(u"The video chat ended right after joining."_q));
+					}
+				});
+			});
+		} else if (state == int(State::Failed)
+			|| state == int(State::FailedHangingUp)) {
+			settle([=] {
+				Reject(
+					pending,
+					"internal",
+					Lower(u"Couldn't join the video chat."_q));
+			});
+		} else if (state == int(State::HangingUp)
+			|| state == int(State::Ended)) {
+			settle([=] {
+				Reject(
+					pending,
+					"internal",
+					Lower(u"The video chat ended before joining."_q));
+			});
+		}
+	}, *lifetime);
+	base::timer_once(kJoinTimeout) | rpl::on_next([=] {
+		settle([=] {
+			Reject(
+				pending,
+				"timed-out",
+				Lower(u"Not joined within 60 seconds."_q));
+		});
+	}, *lifetime);
+	if (const auto strong = weak.get()) {
+		const auto weakLifetime = std::weak_ptr<rpl::lifetime>(lifetime);
+		ScriptLifetime(strong).add([=] {
+			if (const auto owned = weakLifetime.lock()) {
+				owned->destroy();
+			}
+		});
+	}
+}
+
+void StartJoin(
+		Pending pending,
+		base::weak_ptr<Instance> weak,
+		not_null<PeerData*> peer,
+		PeerData *joinAs,
+		bool muted) {
+	const auto session = &peer->session();
+	const auto name = peer->name();
+	FindCall(peer, [=](Data::GroupCall *real) {
+		if (!real) {
+			Reject(
+				pending,
+				"not-found",
+				Lower(u"%1 has no video chat."_q).arg(name));
+			return;
+		}
+		if (const auto current = CurrentCall(session)
+			; current && current->peer() == peer) {
+			ApplyMuted(current, muted);
+			Resolve(pending, [=](JSContext *ctx) {
+				return GroupValue(ctx, session);
+			});
+			return;
+		}
+		const auto window = session->tryResolveWindow(peer);
+		if (!window) {
+			Reject(
+				pending,
+				"unsupported",
+				Lower(u"This account has no window to join from."_q));
+			return;
+		}
+		if (joinAs) {
+			SetDefaultJoinAs(peer, joinAs->id);
+		}
+		WaitJoined(pending, weak, peer, muted);
+		window->startOrJoinGroupCall(peer, {});
+	}, [=](const MTP::Error &error) {
+		RejectRpc(pending, error);
+	});
+}
+
+JSValue NativeGroupCalls(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto op = Op(magic);
+	if (op == Op::Off) {
+		const auto instance = Instance::From(ctx);
+		if (!instance) {
+			return JS_ThrowInternalError(ctx, "the script was stopped");
+		}
+		auto id = 0;
+		if (argc < 1 || JS_ToInt32(ctx, &id, argv[0]) < 0) {
+			return JS_EXCEPTION;
+		}
+		const auto i = AllWatchers().find(instance);
+		if (i != end(AllWatchers())) {
+			i->second->callbacks.remove(id);
+		}
+		ForgetKept(base::make_weak(instance), id);
+		return JS_UNDEFINED;
+	}
+	const auto instance = Permitted(
+		ctx,
+		Capability::Calls,
+		{},
+		kNames[magic]);
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = ScriptSession(instance);
+	switch (op) {
+	case Op::Current:
+		return GroupValue(ctx, session);
+	case Op::OnChange: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.calls.onGroupChange(function)");
+		}
+		const auto watcher = EnsureWatcher(instance);
+		const auto id = KeepFunction(instance, argv[0]);
+		watcher->callbacks.emplace(id);
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::Join: {
+		const auto peer = PeerAt(ctx, session, argc, argv, 0);
+		if (!peer || peer->isUser()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.calls.join needs a group or a channel tele has loaded");
+		}
+		const auto muted = (argc < 2) || (JS_ToBool(ctx, argv[1]) > 0);
+		auto joinAs = (PeerData*)nullptr;
+		if (Present(argc, argv, 2)) {
+			joinAs = PeerAt(ctx, session, argc, argv, 2);
+			if (!joinAs) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.calls.join: joinAs must be a peer tele has loaded");
+			}
+		}
+		auto created = NewPending(ctx);
+		if (JS_IsException(created.second)) {
+			return created.second;
+		}
+		const auto pending = created.first;
+		const auto weak = base::make_weak(instance);
+		const auto chat = not_null<PeerData*>(peer);
+		crl::on_main(session, [=] {
+			StartJoin(pending, weak, chat, joinAs, muted);
+		});
+		return created.second;
+	}
+	case Op::Leave: {
+		const auto call = CurrentCall(session);
+		if (!call) {
+			return JS_FALSE;
+		}
+		call->hangup();
+		return JS_TRUE;
+	}
+	case Op::SetMuted: {
+		const auto call = CurrentCall(session);
+		const auto muted = (argc > 0) && (JS_ToBool(ctx, argv[0]) > 0);
+		if (!call || (!muted && call->mutedByAdmin())) {
+			return JS_FALSE;
+		}
+		ApplyMuted(call, muted);
+		return JS_TRUE;
+	}
+	case Op::RaiseHand: {
+		using Calls::MuteState;
+		const auto call = CurrentCall(session);
+		if (!call) {
+			return JS_FALSE;
+		}
+		const auto raised = (argc > 0) && (JS_ToBool(ctx, argv[0]) > 0);
+		const auto now = call->muted();
+		if (raised) {
+			if (now == MuteState::RaisedHand) {
+				return JS_TRUE;
+			} else if (now != MuteState::ForceMuted
+				|| call->conference()
+				|| call->rtmp()) {
+				return JS_FALSE;
+			}
+			call->setMutedAndUpdate(MuteState::RaisedHand);
+		} else if (now == MuteState::RaisedHand) {
+			call->setMutedAndUpdate(MuteState::ForceMuted);
+		}
+		return JS_TRUE;
+	}
+	case Op::Participants: {
+		auto limit = kDefaultLimit;
+		if (argc > 1 && JS_IsNumber(argv[1])) {
+			auto value = 0.;
+			JS_ToFloat64(ctx, &value, argv[1]);
+			if (value != std::floor(value) || value < 1.) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.calls.participants: limit must be a positive integer");
+			}
+			limit = int(std::min(value, double(kMaxLimit)));
+		}
+		auto peer = (PeerData*)nullptr;
+		if (Present(argc, argv, 0)) {
+			peer = PeerAt(ctx, session, argc, argv, 0);
+			if (!peer || peer->isUser()) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.calls.participants needs a group or a channel tele has loaded");
+			}
+		}
+		auto created = NewPending(ctx);
+		if (JS_IsException(created.second)) {
+			return created.second;
+		}
+		const auto pending = created.first;
+		crl::on_main(session, [=] {
+			LoadParticipants(pending, session, peer, limit);
+		});
+		return created.second;
+	}
+	case Op::Off:
+		break;
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = std::string_view(R"TS(
+declare module 'tele' {
+  export type GroupCallState =
+    | 'creating'
+    | 'waiting'
+    | 'joining'
+    | 'connecting'
+    | 'joined'
+    | 'failedHangingUp'
+    | 'failed'
+    | 'hangingUp'
+    | 'ended'
+    | 'unknown'
+
+  export type GroupCallMute = 'active' | 'pushToTalk' | 'muted' | 'forceMuted' | 'raisedHand'
+
+  export type GroupCallChange = 'state' | 'participants' | 'raisedHand' | 'speaking'
+
+  export interface GroupCallParticipant {
+    peer: PeerInfo
+    self: boolean
+    speaking: boolean
+    muted: boolean
+    mutedByAdmin: boolean
+    raisedHand: boolean
+    video: boolean
+    screen: boolean
+  }
+
+  export interface GroupCallInfo {
+    peer: PeerInfo
+    title: string
+    state: GroupCallState
+    joined: boolean
+    joinAs: PeerInfo
+    mute: GroupCallMute
+    muted: boolean
+    mutedByAdmin: boolean
+    raisedHand: boolean
+    stream: boolean
+    count: number
+    recording: boolean
+    scheduled: number | null
+    participants: GroupCallParticipant[]
+  }
+
+  export interface Calls {
+    group(): GroupCallInfo | null
+    onGroupChange(callback: (call: GroupCallInfo | null, changes: GroupCallChange[]) => unknown): Disposer
+    join(chat: InputPeerLike, options?: { muted?: boolean, joinAs?: InputPeerLike }): Promise<GroupCallInfo>
+    leave(): boolean
+    raiseHand(raised: boolean): boolean
+    participants(chat?: InputPeerLike, options?: { limit?: number }): Promise<GroupCallParticipant[]>
+  }
+}
+)TS");
+
+} // namespace
+
+void AddGroupCallsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "groupcallsCurrent", NativeGroupCalls, 0, int(Op::Current) },
+		{ "groupcallsOnChange", NativeGroupCalls, 1, int(Op::OnChange) },
+		{ "groupcallsOff", NativeGroupCalls, 1, int(Op::Off) },
+		{ "groupcallsJoin", NativeGroupCalls, 3, int(Op::Join) },
+		{ "groupcallsLeave", NativeGroupCalls, 0, int(Op::Leave) },
+		{ "groupcallsSetMuted", NativeGroupCalls, 1, int(Op::SetMuted) },
+		{ "groupcallsRaiseHand", NativeGroupCalls, 1, int(Op::RaiseHand) },
+		{
+			"groupcallsParticipants",
+			NativeGroupCalls,
+			2,
+			int(Op::Participants),
+		},
+	});
+}
+
+std::string_view GroupCallsTypings() {
+	return kTypings;
+}
