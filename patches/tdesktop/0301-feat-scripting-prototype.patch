+			const fields = JWK_FIELDS[kind][(slot.type === 'private') ? 1 : 0];
+			fields.forEach((field, index) => {
+				jwk[field] = toBase64Url(parts[index]);
+			});
+			if (kind === 'RSA') {
+				jwk.alg = rsaAlg(algorithm.name, algorithm.hash.name);
+			} else if (algorithm.name === 'Ed25519') {
+				jwk.alg = 'Ed25519';
+			}
+		}
+		jwk.key_ops = [...slot.usages];
+		jwk.ext = slot.extractable;
+		return jwk;
+	};
+
+	const cipher = (encrypt, params, slot, data) => {
+		const run = encrypt ? natives.cryptoEncrypt : natives.cryptoDecrypt;
+		switch (params.name) {
+		case 'AES-GCM': {
+			const iv = bytesOf(params.iv, 'iv');
+			const tagLength = params.tagLength ?? 128;
+			const additional = (params.additionalData === undefined)
+				? undefined
+				: bytesOf(params.additionalData, 'additionalData');
+			if (!TAG_LENGTHS.includes(tagLength)) {
+				throw fail('OperationError', `tagLength is ${TAG_LENGTHS.join(', ')}`);
+			} else if (iv.length === 0) {
+				throw fail('OperationError', 'the iv is empty');
+			}
+			return run('AES-GCM', slot.handle, data, iv, additional, tagLength);
+		}
+		case 'AES-CBC': {
+			const iv = bytesOf(params.iv, 'iv');
+			if (iv.length !== 16) {
+				throw fail('OperationError', 'the AES-CBC iv has 16 bytes');
+			}
+			return run('AES-CBC', slot.handle, data, iv);
+		}
+		case 'AES-CTR': {
+			const counter = bytesOf(params.counter, 'counter');
+			const { length } = params;
+			if (counter.length !== 16) {
+				throw fail('OperationError', 'the AES-CTR counter has 16 bytes');
+			} else if (!Number.isInteger(length) || length < 1 || length > 128) {
+				throw fail('OperationError', 'the AES-CTR length is from 1 to 128');
+			}
+			return run('AES-CTR', slot.handle, data, counter, length);
+		}
+		case 'AES-KW':
+			return run('AES-KW', slot.handle, data);
+		case 'RSA-OAEP': {
+			const label = (params.label === undefined) ? undefined : bytesOf(params.label, 'label');
+			return run('RSA-OAEP', slot.handle, data, slot.algorithm.hash.name, label);
+		}
+		}
+		throw fail('NotSupportedError', `${params.name} doesn't encrypt`);
+	};
