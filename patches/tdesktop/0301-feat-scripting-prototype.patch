+[[nodiscard]] JSValue RegisterAction(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 3
+		|| !JS_IsString(argv[0])
+		|| !JS_IsFunction(ctx, argv[2])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.stories.registerStoryAction needs a text and onClick");
+	}
+	const auto text = FromStd(ToStd(ctx, argv[0])).trimmed();
+	const auto emoji = JS_IsString(argv[1])
+		? FromStd(ToStd(ctx, argv[1])).trimmed()
+		: QString();
+	if (text.isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.stories.registerStoryAction needs a text");
+	}
+	const auto kept = KeepFunction(instance, argv[2]);
+	Track(instance);
+	auto &registry = StoriesRegistry();
+	const auto id = ++registry.next;
+	registry.actions.push_back({
+		.owned = { instance, base::make_weak(instance), id, kept },
+		.text = emoji.isEmpty() ? text : (emoji + QChar(' ') + text),
+	});
+	return JS_NewInt32(ctx, id);
+}
+
+[[nodiscard]] JSValue RegisterInterceptor(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"stories",
+		"tg.stories.interceptStoryView");
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.stories.interceptStoryView(function)");
+	}
+	const auto kept = KeepFunction(instance, argv[0]);
+	Track(instance);
+	auto &registry = StoriesRegistry();
+	const auto id = ++registry.next;
+	registry.interceptors.push_back({
+		instance,
+		base::make_weak(instance),
+		id,
+		kept,
+	});
+	return JS_NewInt32(ctx, id);
+}
+
+[[nodiscard]] JSValue RegisterWatcher(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"stories",
+		"tg.stories.onStory");
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.stories.onStory(function)");
+	}
+	const auto kept = KeepFunction(instance, argv[0]);
+	Track(instance);
+	auto &registry = StoriesRegistry();
+	const auto id = ++registry.next;
+	auto watcher = std::make_unique<Watcher>();
+	watcher->owned = { instance, base::make_weak(instance), id, kept };
+	watcher->since = base::unixtime::now();
+	const auto raw = watcher.get();
+	const auto stories = &ScriptSession(instance)->data().stories();
+	stories->sourceChanged() | rpl::on_next([=](PeerId peerId) {
+		const auto source = stories->source(peerId);
+		if (!source) {
+			return;
+		}
+		auto &known = raw->known[peerId];
+		auto fresh = std::vector<Data::StoryIdDates>();
+		for (const auto &entry : source->ids) {
+			if (entry.date >= raw->since && !known.contains(entry.id)) {
+				known.emplace(entry.id);
+				fresh.push_back(entry);
+			}
+		}
+		if (fresh.empty()) {
+			return;
+		}
+		const auto weak = raw->owned.weak;
+		const auto kept = raw->owned.kept;
+		const auto marked = MarkedId(peerId);
+		crl::on_main([=] {
+			for (const auto &entry : fresh) {
+				CallKept(weak, kept, [=](JSContext *ctx) {
+					auto result = JS_NewObject(ctx);
+					JS_SetPropertyStr(
+						ctx,
+						result,
+						"peer",
+						JS_NewBigInt64(ctx, marked));
+					JS_SetPropertyStr(
+						ctx,
+						result,
+						"storyId",
+						JS_NewInt32(ctx, entry.id));
+					JS_SetPropertyStr(
+						ctx,
+						result,
+						"date",
+						JS_NewInt32(ctx, entry.date));
+					JS_SetPropertyStr(
+						ctx,
+						result,
+						"expireDate",
+						JS_NewInt32(ctx, entry.expires));
+					return result;
+				}, u"tg.stories.onStory"_q);
+			}
+		});
+	}, raw->lifetime);
+	registry.watchers.push_back(std::move(watcher));
+	return JS_NewInt32(ctx, id);
+}
+
+JSValue NativeStories(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case kUpload: return Upload(ctx, argc, argv);
+	case kGhost: return Ghost(ctx, argc, argv);
+	case kApplyRead: return ApplyReadNative(ctx, argc, argv);
+	case kApplyDeleted: return ApplyDeleted(ctx, argc, argv);
+	case kSources: return Sources(ctx);
+	case kAction: return RegisterAction(ctx, argc, argv);
+	case kIntercept: return RegisterInterceptor(ctx, argc, argv);
+	case kWatch: return RegisterWatcher(ctx, argc, argv);
+	case kUnregister: {
+		const auto id = IntArgument(ctx, argc, argv, 0);
+		if (const auto instance = Instance::From(ctx); instance && id) {
+			Remove(instance, *id);
+		}
+		return JS_UNDEFINED;
+	}
+	case kAnswer: {
+		const auto callId = IntArgument(ctx, argc, argv, 0);
+		const auto instance = Instance::From(ctx);
+		if (instance && callId) {
+			const auto skip = (argc > 1)
+				&& JS_IsString(argv[1])
+				&& (ToStd(ctx, argv[1]) == "skip");
+			Settle(*callId, skip, instance);
+		}
+		return JS_UNDEFINED;
+	}
+	}
+	return JS_UNDEFINED;
+}
