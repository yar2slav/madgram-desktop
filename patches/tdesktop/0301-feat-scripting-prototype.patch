+constexpr auto kExtensionsRegistry = "Object.defineProperty(globalThis, "
+	"'__teleExtensions', { value: [] });";
+
+void Engine::installGlobals() {
+	auto scope = JS_GetGlobalObject(_ctx);
+	JS_DefinePropertyValueStr(
+		_ctx,
+		scope,
+		"__teleSourceColumn",
+		JS_NewCFunction(_ctx, MapColumn, "__teleSourceColumn", 3),
+		0);
+	JS_FreeValue(_ctx, scope);
+	auto prelude = JS_Eval(
+		_ctx,
+		kPrelude,
+		std::strlen(kPrelude),
+		"<tele>",
+		JS_EVAL_TYPE_GLOBAL);
+	JS_FreeValue(_ctx, prelude);
+	const auto evaluate = [&](const QString &path, const char *name) {
+		auto file = QFile(path);
+		if (!file.open(QIODevice::ReadOnly)) {
+			return;
+		}
+		const auto code = file.readAll();
+		auto value = JS_Eval(
+			_ctx,
+			code.constData(),
+			code.size(),
+			name,
+			JS_EVAL_TYPE_GLOBAL);
+		if (JS_IsException(value)) {
+			report(QString::fromUtf8(name));
+		}
+		JS_FreeValue(_ctx, value);
+	};
+	auto registry = JS_Eval(
+		_ctx,
+		kExtensionsRegistry,
+		std::strlen(kExtensionsRegistry),
+		"<tele extensions>",
+		JS_EVAL_TYPE_GLOBAL);
+	JS_FreeValue(_ctx, registry);
+	const auto worker = (_kind == EngineKind::Worker);
+	for (const auto &path : worker ? WorkerScripts() : ExtensionScripts()) {
+		const auto name = (u"<tele "_q + path.section('/', -1) + '>').toUtf8();
+		evaluate(path, name.constData());
+	}
+	auto file = QFile(u":/tele/scripting/runtime.js"_q);
+	if (!worker && file.open(QIODevice::ReadOnly)) {
+		const auto code = file.readAll();
+		auto runtime = JS_Eval(
+			_ctx,
+			code.constData(),
+			code.size(),
+			"<tele runtime>",
+			JS_EVAL_TYPE_GLOBAL);
+		if (JS_IsException(runtime)) {
+			report(u"the runtime"_q);
+		}
+		JS_FreeValue(_ctx, runtime);
+	}
+
+	auto global = JS_GetGlobalObject(_ctx);
+	auto console = JS_NewObject(_ctx);
+	const auto level = [&](const char *name, LogLevel value) {
+		JS_SetPropertyStr(
+			_ctx,
+			console,
+			name,
+			JS_NewCFunctionMagic(
+				_ctx,
+				Console,
+				name,
+				1,
+				JS_CFUNC_generic_magic,
+				int(value)));
+	};
+	level("log", LogLevel::Info);
+	level("info", LogLevel::Info);
+	level("debug", LogLevel::Info);
+	level("warn", LogLevel::Warning);
+	level("error", LogLevel::Error);
+	JS_SetPropertyStr(_ctx, global, "console", console);
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"setTimeout",
+		JS_NewCFunctionMagic(
+			_ctx,
+			SetTimer,
+			"setTimeout",
+			2,
+			JS_CFUNC_generic_magic,
+			0));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"setInterval",
+		JS_NewCFunctionMagic(
+			_ctx,
+			SetTimer,
+			"setInterval",
+			2,
+			JS_CFUNC_generic_magic,
+			1));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"clearTimeout",
+		JS_NewCFunction(_ctx, ClearTimer, "clearTimeout", 1));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"clearInterval",
+		JS_NewCFunction(_ctx, ClearTimer, "clearInterval", 1));
+	if (!worker) {
+		JS_SetPropertyStr(
+			_ctx,
+			global,
+			"defineScript",
+			JS_NewCFunction(_ctx, DefineScript, "defineScript", 1));
+	}
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"__teleUtf8Encode",
+		JS_NewCFunction(_ctx, Utf8Encode, "__teleUtf8Encode", 1));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"__teleUtf8Decode",
+		JS_NewCFunction(_ctx, Utf8Decode, "__teleUtf8Decode", 2));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"__teleRandomFill",
+		JS_NewCFunction(_ctx, RandomFill, "__teleRandomFill", 1));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"__teleDigest",
+		JS_NewCFunction(_ctx, Digest, "__teleDigest", 2));
+	JS_SetPropertyStr(
+		_ctx,
+		global,
+		"__teleHmac",
+		JS_NewCFunction(_ctx, Hmac, "__teleHmac", 3));
+	JS_FreeValue(_ctx, global);
+}
