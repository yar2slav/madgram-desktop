+}
+
+[[nodiscard]] Outcome PairOutcome(KeyPointer publicKey, KeyPointer privateKey) {
+	auto result = Outcome();
+	result.type = Outcome::Type::Pair;
+	result.key = std::move(publicKey);
+	result.second = std::move(privateKey);
+	return result;
+}
+
+[[nodiscard]] Outcome PartsOutcome(std::vector<QByteArray> parts) {
+	auto result = Outcome();
+	result.type = Outcome::Type::List;
+	result.parts = std::move(parts);
