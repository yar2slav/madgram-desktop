+QString Engine::stringify(JSValueConst value) {
+	auto global = JS_GetGlobalObject(_ctx);
+	auto format = JS_GetPropertyStr(_ctx, global, "__teleFormat");
+	JS_FreeValue(_ctx, global);
+	auto result = JS_Call(
+		_ctx,
+		format,
+		JS_UNDEFINED,
+		1,
+		const_cast<JSValue*>(&value));
+	JS_FreeValue(_ctx, format);
+	if (JS_IsException(result)) {
+		JS_FreeValue(_ctx, JS_GetException(_ctx));
+		return u"[unprintable]"_q;
+	}
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(_ctx, &size, result);
+	auto string = text ? QString::fromUtf8(text, int(size)) : QString();
+	if (text) {
+		JS_FreeCString(_ctx, text);
+	}
+	JS_FreeValue(_ctx, result);
+	return string;
+}
+
+QString Engine::describe(JSValueConst error) {
+	if (JS_IsUncatchableError(error)) {
+		return u"took too long and was stopped"_q;
+	}
+	return stringify(error);
+}
+
+void Engine::report(const QString &where) {
+	++_errors;
+	auto exception = JS_GetException(_ctx);
+	_lastError = describe(exception);
+	if (_fault) {
+		_fault(exception);
+	} else {
+		log(LogLevel::Fault, where + u": "_q + _lastError);
+	}
+	JS_FreeValue(_ctx, exception);
+}
+
+JSValue Engine::call(
+		JSValueConst function,
+		JSValueConst self,
+		std::span<JSValueConst> args,
+		crl::time budget,
+		const QString &where) {
+	enter(budget);
+	auto result = JS_Call(
+		_ctx,
+		function,
+		self,
+		int(args.size()),
+		const_cast<JSValue*>(args.data()));
+	leave();
+	if (JS_IsException(result)) {
+		report(where);
+		return JS_UNDEFINED;
+	}
+	return result;
+}
+
+void Engine::drain(bool flush) {
+	enter(kDrainBudget);
+	const auto bounded = (_kind == EngineKind::Script);
+	for (auto i = 0; i != kMaxJobs; i += bounded ? 1 : 0) {
+		if (_interrupted) {
+			break;
+		} else if (_deadline && crl::now() > _deadline) {
+			log(LogLevel::Fault, u"promise jobs took too long"_q);
+			break;
+		}
+		auto ctx = (JSContext*)nullptr;
+		const auto result = JS_ExecutePendingJob(_rt, &ctx);
+		if (!result) {
+			break;
+		} else if (result < 0) {
+			report(u"async code"_q);
+		}
+	}
+	leave();
+	if (flush) {
+		flushRejections();
+	}
+}
+
+void Engine::rejected(JSValueConst promise, JSValueConst reason, bool handled) {
+	if (!handled) {
+		_rejected.emplace_back(
+			JS_DupValue(_ctx, promise),
+			JS_DupValue(_ctx, reason));
+		return;
+	}
+	const auto i = ranges::find_if(_rejected, [&](const auto &pair) {
+		return JS_VALUE_GET_PTR(pair.first) == JS_VALUE_GET_PTR(promise);
+	});
+	if (i != end(_rejected)) {
+		JS_FreeValue(_ctx, i->first);
+		JS_FreeValue(_ctx, i->second);
+		_rejected.erase(i);
+	}
+}
+
+void Engine::flushRejections() {
+	for (auto &[promise, reason] : base::take(_rejected)) {
+		log(
+			LogLevel::Fault,
+			u"unhandled promise rejection: "_q + describe(reason));
+		JS_FreeValue(_ctx, promise);
+		JS_FreeValue(_ctx, reason);
+	}
+}
