+}
+
+[[nodiscard]] TextWithEntities Describe(
+		const QString &name,
+		const QStringList &requested) {
+	auto error = QString();
+	const auto permissions = Permissions::Parse(requested, error);
+	const auto groups = Groups();
+	auto result = TextWithEntities{
+		Lower(u"%1 asks to:"_q).arg(name),
+	};
+	auto dangerous = QStringList();
+	for (const auto &group : groups) {
+		auto everything = false;
+		auto some = QStringList();
+		auto risky = QStringList();
+		for (const auto &grant : permissions.grants()) {
+			if (grant.capability != group.capability) {
+				continue;
+			} else if (grant.scope.empty()) {
+				everything = true;
+			} else if (DangerousName(grant.capability, grant.scope)) {
+				risky.push_back(QString::fromStdString(grant.scope));
+			} else {
+				some.push_back(ScopeTitle(grant.capability, grant.scope));
+			}
+		}
+		if (everything) {
+			result.append(u"\n\u2022 "_q).append(group.everything);
+		} else if (!some.isEmpty()) {
+			result.append(u"\n\u2022 "_q).append(
+				group.some.arg(some.join(u", "_q)));
+		}
+		if (!risky.isEmpty()) {
+			dangerous.push_back(group.danger + ' ' + risky.join(u", "_q));
+		}
+	}
+	if (permissions.any(Capability::DisableApiFiltering)) {
+		dangerous.push_back(ProtectionText());
+	}
+	if (permissions.any(Capability::Exec)) {
+		dangerous.push_back(Lower(u"run any program on your computer, "
+			"with your rights"_q));
+	}
+	if (permissions.any(Capability::Automate)) {
+		dangerous.push_back(Lower(u"press any button in tele for you"_q));
+	}
+	for (const auto &grant : permissions.grants()) {
+		if (grant.capability == Capability::AccountWrite
+			&& grant.scope == "gifts") {
+			dangerous.push_back(Lower(u"transfer, sell, convert and upgrade "
+				"your gifts"_q));
+		}
+		if (!grant.scope.empty()) {
+			continue;
+		} else if (grant.capability == Capability::FsRead) {
+			dangerous.push_back(Lower(u"read any file on your computer"_q));
+		} else if (grant.capability == Capability::FsWrite) {
+			dangerous.push_back(Lower(u"create, change and delete any file "
+				"on your computer"_q));
+		}
+	}
+	if (!dangerous.isEmpty()) {
+		result.append(u"\n\n"_q).append(
+			Ui::Text::Bold(Lower(u"Dangerous: %1."_q).arg(
+				dangerous.join(u"; "_q))));
+	}
+	return result;
+}
+
+} // namespace
+
+void ShowScriptApproval(
+		std::shared_ptr<Ui::Show> show,
+		not_null<Main::Session*> session,
+		const QString &id) {
+	const auto scripts = Scripts(session);
+	const auto i = ranges::find(scripts, id, &ScriptState::id);
+	if (i == end(scripts) || !i->approval) {
+		return;
+	}
+	show->show(Ui::MakeConfirmBox({
+		.text = Describe(i->name, i->requested),
+		.confirmed = [=](Fn<void()> close) {
+			ApproveScript(session, id);
+			close();
+		},
+		.cancelled = [=](Fn<void()> close) {
+			SetScriptEnabled(session, id, false);
+			close();
+		},
+		.confirmText = Lower(u"Allow"_q),
+		.title = Lower(u"Script permissions"_q),
+	}));
+}
+
+QString DescribeGrant(const QString &grant) {
+	auto error = QString();
+	const auto permissions = Permissions::Parse({ grant }, error);
+	if (!error.isEmpty() || permissions.grants().empty()) {
+		return grant;
+	}
+	const auto &parsed = permissions.grants().front();
+	if (parsed.capability == Capability::Exec) {
+		return Lower(u"Run any program on your computer, with your rights."_q);
+	} else if (parsed.capability == Capability::Automate) {
+		return Lower(u"Press any button in tele for you."_q);
+	} else if (parsed.capability == Capability::DisableApiFiltering) {
+		auto text = ProtectionText();
+		if (!text.isEmpty()) {
+			text[0] = text[0].toUpper();
+		}
+		return text + '.';
+	}
+	const auto groups = Groups();
+	const auto i = ranges::find(groups, parsed.capability, &Group::capability);
+	if (i == end(groups)) {
+		return grant;
+	} else if (parsed.scope.empty() || i->some.isEmpty()) {
+		return i->everything;
+	}
+	const auto scope = DangerousName(parsed.capability, parsed.scope)
+		? QString::fromStdString(parsed.scope)
+		: ScopeTitle(parsed.capability, parsed.scope);
+	return i->some.arg(scope);
+}
+
