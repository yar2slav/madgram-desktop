+[[nodiscard]] JSValue ParticipantsValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		const std::vector<ParticipantState> &list) {
+	auto result = JS_NewArray(ctx);
+	auto index = std::uint32_t();
+	for (const auto &state : list) {
+		if (const auto peer = session->data().peerLoaded(state.peer)) {
+			JS_SetPropertyUint32(
+				ctx,
+				result,
+				index++,
+				ParticipantValue(ctx, peer, state));
+		}
+	}
+	return result;
+}
