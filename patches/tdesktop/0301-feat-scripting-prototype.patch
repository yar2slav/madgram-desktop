+constexpr auto kPrefix = std::string_view("tele-script/");
+constexpr auto kPage = std::string_view("index.html");
+constexpr auto kPanelName = "TeleMtpPanel";
+constexpr auto kMinSize = 120;
+constexpr auto kMaxSize = 4096;
+constexpr auto kDefaultWidth = 480;
+constexpr auto kDefaultHeight = 600;
+constexpr auto kWhere = "tg.ui.webview";
+
+constexpr auto kBridge = R"js((() => {
+const lock = (name) => {
+	try {
+		Object.defineProperty(window, name, {
+			value: undefined,
+			configurable: false,
+			writable: false,
+		});
+	} catch (error) {
+	}
+};
+if (__TELE_RESTRICTED__) {
+	for (const name of ['RTCPeerConnection', 'webkitRTCPeerConnection', 'RTCDataChannel']) {
+		lock(name);
+	}
+}
+if (window !== window.top || window.tele) {
+	return;
+}
+let theme = __TELE_THEME__;
+let handler = null;
+let pending = [];
+const report = (error) => {
+	setTimeout(() => {
+		throw error;
+	});
+};
+const run = (callback, data) => {
+	try {
+		callback(data);
+	} catch (error) {
+		report(error);
+	}
+};
+const apply = () => {
+	const root = document.documentElement;
+	if (!root) {
+		return false;
+	}
+	for (const name of Object.keys(theme)) {
+		root.style.setProperty(name, theme[name]);
+	}
+	return true;
+};
+if (!apply()) {
+	const observer = new MutationObserver(() => {
+		if (apply()) {
+			observer.disconnect();
+		}
+	});
+	observer.observe(document, { childList: true });
+}
+const hidden = (name, value) => {
+	Object.defineProperty(window, name, { value });
+};
+hidden('__teleTheme', (value) => {
+	theme = value;
+	apply();
+});
+hidden('__teleDeliver', (text) => {
+	const data = JSON.parse(text);
+	if (handler) {
+		run(handler, data);
+	} else if (pending.length < 1000) {
+		pending.push(data);
+	}
+	try {
+		window.dispatchEvent(new CustomEvent('tele-message', { detail: data }));
+	} catch (error) {
+		report(error);
+	}
+});
+const tele = {};
+Object.defineProperties(tele, {
+	postMessage: {
+		enumerable: true,
+		value: (data) => {
+			const text = JSON.stringify(data);
+			if (typeof text !== 'string') {
+				throw new TypeError('tele.postMessage needs JSON-serializable data');
+			}
+			window.external.invoke(text);
+		},
+	},
+	onMessage: {
+		enumerable: true,
+		get: () => handler,
+		set: (value) => {
+			handler = (typeof value === 'function') ? value : null;
+			if (handler) {
+				const list = pending;
+				pending = [];
+				for (const data of list) {
+					run(handler, data);
+				}
+			}
+		},
+	},
+});
+hidden('tele', Object.seal(tele));
+})();)js";
+
+struct Options {
+	QString title;
+	QByteArray html;
+	QString url;
+	QSize size;
+	bool resizable = true;
+};
