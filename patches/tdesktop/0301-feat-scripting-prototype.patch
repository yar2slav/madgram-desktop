+JSValue Instance::NativeApp(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto window = WindowOf(session);
+	const auto given = [&](int index) {
+		return argc > index
+			&& !JS_IsNull(argv[index])
+			&& !JS_IsUndefined(argv[index]);
+	};
+	const auto peerAt = [&](int index) -> PeerData* {
+		const auto id = given(index)
+			? PeerFromValue(ctx, argv[index], session->user()->id)
+			: std::nullopt;
+		return id ? session->data().peerLoaded(*id) : nullptr;
+	};
+	const auto activePeer = [&]() -> PeerData* {
+		return window ? window->activeChatCurrent().peer() : nullptr;
+	};
+	const auto later = [&](Fn<void(not_null<Window::SessionController*>)> fn) {
+		if (!window) {
+			return ThrowTeleError(
+				ctx,
+				"unsupported",
+				u"this account has no window"_q);
+		}
+		const auto weak = base::make_weak(window);
+		crl::on_main(weak, [=] {
+			if (const auto strong = weak.get()) {
+				fn(strong);
+			}
+		});
+		return JS_UNDEFINED;
+	};
+	const auto enroll = [&](Kind kind, JSValueConst fn) {
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = kind,
+			.fn = JS_DupValue(ctx, fn),
+		});
+		return id;
+	};
+	switch (magic) {
+	case 0:
+	case 1: {
+		const auto peer = peerAt(0);
+		if (!peer) {
+			return JS_ThrowTypeError(ctx, "this peer isn't in tele's cache");
+		}
+		auto msg = std::int64_t();
+		if (magic == 0 && given(1) && JS_ToInt64(ctx, &msg, argv[1])) {
+			return JS_EXCEPTION;
+		}
+		const auto peerId = peer->id;
+		return later([=](not_null<Window::SessionController*> window) {
+			if (magic == 0) {
+				window->showPeerHistory(
+					peerId,
+					Window::SectionShow::Way::ClearStack,
+					msg ? MsgId(msg) : ShowAtUnreadMsgId);
+			} else {
+				window->showPeerInfo(peerId);
+			}
+		});
+	}
+	case 2: {
+		using Factory = Settings::Type (*)();
+		static const auto sections = std::array<
+			std::pair<std::string_view, Factory>,
+			13>{ {
+			{ "main", Settings::MainId },
+			{ "chat", Settings::ChatId },
+			{ "notifications", Settings::NotificationsId },
+			{ "privacy", Settings::PrivacySecurityId },
+			{ "advanced", Settings::AdvancedId },
+			{ "folders", Settings::FoldersId },
+			{ "calls", Settings::CallsId },
+			{ "information", Settings::InformationId },
+			{ "premium", Settings::PremiumId },
+			{ "sessions", Settings::SessionsId },
+			{ "blocked", Settings::BlockedPeersId },
+			{ "shortcuts", Settings::ShortcutsId },
+			{ "tele", Settings::TeleNewSectionId },
+		} };
+		const auto name = given(0) ? ToStd(ctx, argv[0]) : std::string("main");
+		const auto i = ranges::find(sections, name, [](const auto &pair) {
+			return pair.first;
+		});
+		if (i == end(sections)) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.openSettings: %s isn't a settings section",
+				name.c_str());
+		}
+		const auto factory = i->second;
+		return later([=](not_null<Window::SessionController*> window) {
+			window->showSettings(factory());
+		});
+	}
+	case 3:
+		return later([](not_null<Window::SessionController*> window) {
+			window->showBackFromStack();
+		});
+	case 4: {
+		auto result = JS_NewObject(ctx);
+		const auto peer = activePeer();
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"chatId",
+			peer ? JS_NewBigInt64(ctx, MarkedId(peer->id)) : JS_NULL);
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"windowActive",
+			JS_NewBool(ctx, window && window->widget()->isActive()));
+		return result;
+	}
+	case 5:
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.ui.onChatOpened(function)");
+		} else {
+			const auto id = enroll(Kind::ChatOpened, argv[0]);
+			instance->watchChats();
+			return instance->disposer(id);
+		}
+	case 6:
+	case 7:
+	case 8: {
+		const auto reading = (magic == 6);
+		const auto what = reading
+			? "tg.compose.get"
+			: (magic == 7)
+			? "tg.compose.set"
+			: "tg.compose.insert";
+		const auto capability = reading
+			? Capability::AccountRead
+			: Capability::AccountWrite;
+		if (!instance->_permissions.allows(capability, "draft")) {
+			return ThrowNotGranted(
+				ctx,
+				QString::fromLatin1(what),
+				GrantText(capability, "draft"));
+		}
+		const auto index = reading ? 0 : 1;
+		const auto peer = given(index) ? peerAt(index) : activePeer();
+		const auto found = peer
+			? FindComposeField(not_null(peer))
+			: std::optional<ComposeField>();
+		if (!found) {
+			return reading ? JS_NULL : JS_FALSE;
+		}
+		const auto field = found->field;
+		if (reading) {
+			auto text = TextValue(ctx, session, field->getTextWithTags());
+			auto result = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				result,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(found->peer->id)));
+			JS_SetPropertyStr(ctx, result, "text", text);
+			return result;
+		}
+		auto text = (argc > 0)
+			? instance->textFromValue(argv[0], QString::fromLatin1(what))
+			: std::optional<TextWithTags>();
+		if (!text) {
+			return JS_ThrowTypeError(
+				ctx,
+				"%s needs a string or { text, entities }",
+				what);
+		}
+		if (magic == 7) {
+			field->setTextWithTags(*text);
+			field->setCursorPosition(int(text->text.size()));
+		} else {
+			const auto position = field->textCursor().position();
+			auto result = field->getTextWithTagsPart(0, position);
+			AppendTextWithTags(result, *text);
+			const auto cursor = int(result.text.size());
+			AppendTextWithTags(result, field->getTextWithTagsPart(position));
+			field->setTextWithTags(result);
+			field->setCursorPosition(cursor);
+		}
+		return JS_TRUE;
+	}
+	case 9:
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.compose.onInput(function)");
+		} else if (!instance->_permissions.allows(
+				Capability::AccountRead,
+				"draft")) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.compose.onInput"_q,
+				GrantText(Capability::AccountRead, "draft"));
+		} else {
+			const auto id = enroll(Kind::ComposeInput, argv[0]);
+			instance->watchCompose();
+			return instance->disposer(id);
+		}
+	case 10: {
+		if (argc < 2 || !JS_IsString(argv[0]) || !JS_IsFunction(ctx, argv[1])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.registerShortcut(keys, function)");
+		}
+		const auto keys = FromStd(ToStd(ctx, argv[0]));
+		const auto sequence = QKeySequence::fromString(
+			keys,
+			QKeySequence::PortableText);
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+		const auto first = sequence.isEmpty()
+			? 0
+			: sequence[0].toCombined();
+#else // Qt >= 6.0.0
+		const auto first = sequence.isEmpty() ? 0 : sequence[0];
+#endif // Qt < 6.0.0
+		if (sequence.isEmpty() || first == Qt::Key_unknown) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.registerShortcut: '%s' isn't a key sequence like "
+				"'Ctrl+Shift+K'",
+				keys.toUtf8().constData());
+		}
+		const auto id = enroll(Kind::Shortcut, argv[1]);
+		instance->_registrations[id].key = sequence.toString(
+			QKeySequence::PortableText);
+		instance->attachShortcut(id);
+		return instance->disposer(id);
+	}
+	case 11:
+	case 12: {
+		const auto link = (magic == 11);
+		const auto what = link
+			? "tg.interceptLink"
+			: "tg.interceptNotification";
+		const auto capability = link
+			? Capability::InterceptLink
+			: Capability::InterceptNotification;
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "%s(function)", what);
+		} else if (!instance->_permissions.any(capability)) {
+			return ThrowNotGranted(
+				ctx,
+				QString::fromLatin1(what),
+				GrantText(capability, {}));
+		}
+		const auto id = enroll(
+			link ? Kind::Link : Kind::Notification,
+			argv[0]);
+		return instance->disposer(id);
+	}
+	case 13:
+	case 14: {
+		const auto saving = (magic == 14);
+		const auto options = given(saving ? 1 : 0)
+			? argv[saving ? 1 : 0]
+			: JS_UNDEFINED;
+		const auto object = JS_IsObject(options);
+		const auto title = object
+			? StringProperty(ctx, options, "title")
+			: QString();
+		const auto filterText = object
+			? StringProperty(ctx, options, "filter")
+			: QString();
+		auto bytes = QByteArray();
+		if (saving) {
+			if (argc > 0 && JS_IsString(argv[0])) {
+				bytes = QByteArray::fromStdString(ToStd(ctx, argv[0]));
+			} else if (argc > 0
+				&& JS_GetTypedArrayType(argv[0]) == JS_TYPED_ARRAY_UINT8) {
+				auto size = std::size_t();
+				const auto data = JS_GetUint8Array(ctx, &size, argv[0]);
+				bytes = QByteArray(
+					reinterpret_cast<const char*>(data),
+					int(size));
+			} else {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.ui.saveFile needs a Uint8Array or a string");
+			}
+		}
+		if (!window) {
+			return ThrowTeleError(
+				ctx,
+				"unsupported",
+				u"this account has no window"_q);
+		}
+		auto created = instance->newPromise();
+		const auto key = created.first;
+		if (!key) {
+			return created.second;
+		}
+		const auto caption = title.isEmpty() ? instance->_name : title;
+		const auto filter = filterText.isEmpty()
+			? FileDialog::AllFilesFilter()
+			: filterText;
+		const auto parent = QPointer<QWidget>(window->widget().get());
+		const auto weak = base::make_weak(instance);
+		const auto cancel = [=] {
+			if (const auto strong = weak.get(); strong && strong->_engine) {
+				strong->settle(key, true, JS_NULL);
+			}
+		};
+		if (saving) {
+			const auto name = object
+				? StringProperty(ctx, options, "name")
+				: QString();
+			crl::on_main(weak, [=] {
+				FileDialog::GetWritePath(parent, caption, filter, name, [=](
+						QString &&path) {
+					const auto strong = weak.get();
+					if (!strong || !strong->_engine) {
+						return;
+					} else if (path.isEmpty()) {
+						strong->settle(key, true, JS_NULL);
+						return;
+					}
+					auto file = QFile(path);
+					const auto ctx = strong->_engine->ctx();
+					if (!file.open(QIODevice::WriteOnly)
+						|| file.write(bytes) != bytes.size()) {
+						strong->settle(key, false, MakeTypeError(
+							ctx,
+							u"tg.ui.saveFile: can't write "_q + path));
+						return;
+					}
+					strong->settle(key, true, NewString(ctx, path));
+				}, cancel);
+			});
+		} else {
+			const auto multiple = object
+				&& BoolProperty(ctx, options, "multiple");
+			const auto done = [=](FileDialog::OpenResult &&result) {
+				const auto strong = weak.get();
+				if (!strong || !strong->_engine) {
+					return;
+				}
+				const auto ctx = strong->_engine->ctx();
+				auto list = JS_NewArray(ctx);
+				auto index = std::uint32_t();
+				const auto add = [&](
+						const QString &name,
+						const QString &path,
+						const QByteArray &content) {
+					auto entry = JS_NewObject(ctx);
+					JS_SetPropertyStr(ctx, entry, "name", NewString(ctx, name));
+					JS_SetPropertyStr(ctx, entry, "path", NewString(ctx, path));
+					JS_SetPropertyStr(
+						ctx,
+						entry,
+						"bytes",
+						JS_NewUint8ArrayCopy(
+							ctx,
+							reinterpret_cast<const uint8_t*>(
+								content.constData()),
+							content.size()));
+					JS_SetPropertyUint32(ctx, list, index++, entry);
+				};
+				for (const auto &path : result.paths) {
+					auto file = QFile(path);
+					if (file.open(QIODevice::ReadOnly)) {
+						add(QFileInfo(path).fileName(), path, file.readAll());
+					}
+				}
+				if (result.paths.isEmpty() && !result.remoteContent.isEmpty()) {
+					add(QString(), QString(), result.remoteContent);
+				}
+				if (!index) {
+					JS_FreeValue(ctx, list);
+					strong->settle(key, true, JS_NULL);
+					return;
+				}
+				strong->settle(key, true, list);
+			};
+			crl::on_main(weak, [=] {
+				if (multiple) {
+					FileDialog::GetOpenPaths(parent, caption, filter, done, cancel);
+				} else {
+					FileDialog::GetOpenPath(parent, caption, filter, done, cancel);
+				}
+			});
+		}
+		return created.second;
+	}
+	case 15:
+	case 16: {
+		const auto button = (magic == 15);
+		const auto what = button
+			? "tg.registerButton"
+			: "tg.registerProfileRow";
+		if (argc < 1 || !JS_IsObject(argv[0])) {
+			return JS_ThrowTypeError(ctx, "%s needs an options object", what);
+		}
+		const auto options = argv[0];
+		const auto label = StringProperty(
+			ctx,
+			options,
+			button ? "icon" : "label");
+		auto first = JS_GetPropertyStr(
+			ctx,
+			options,
+			button ? "onClick" : "value");
+		auto second = JS_GetPropertyStr(ctx, options, "onClick");
+		const auto valid = !label.isEmpty()
+			&& JS_IsFunction(ctx, first)
+			&& (button
+				|| JS_IsUndefined(second)
+				|| JS_IsFunction(ctx, second));
+		if (!valid) {
+			JS_FreeValue(ctx, first);
+			JS_FreeValue(ctx, second);
+			return JS_ThrowTypeError(
+				ctx,
+				button
+					? "tg.registerButton needs an icon and an onClick function"
+					: "tg.registerProfileRow needs a label, a value "
+						"function and maybe an onClick function");
+		}
+		auto place = ButtonPlace::Header;
+		auto chats = std::vector<std::string>();
+		if (button) {
+			const auto where = StringProperty(ctx, options, "place");
+			if (where == u"compose"_q) {
+				place = ButtonPlace::Compose;
+			} else if (!where.isEmpty() && where != u"header"_q) {
+				JS_FreeValue(ctx, first);
+				JS_FreeValue(ctx, second);
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.registerButton: place is 'header' or 'compose'");
+			}
+			auto list = JS_GetPropertyStr(ctx, options, "chats");
+			auto length = std::int64_t();
+			if (JS_IsArray(list) && JS_GetLength(ctx, list, &length) >= 0) {
+				for (auto i = std::int64_t(); i != length; ++i) {
+					auto item = JS_GetPropertyUint32(
+						ctx,
+						list,
+						std::uint32_t(i));
+					chats.push_back(ToStd(ctx, item));
+					JS_FreeValue(ctx, item);
+				}
+			}
+			JS_FreeValue(ctx, list);
+			for (const auto &chat : chats) {
+				if (chat != "all"
+					&& chat != "private"
+					&& chat != "groups"
+					&& chat != "channels") {
+					JS_FreeValue(ctx, first);
+					JS_FreeValue(ctx, second);
+					return JS_ThrowTypeError(
+						ctx,
+						"tg.registerButton: %s is not all, private, groups "
+						"or channels",
+						chat.c_str());
+				}
+			}
+		}
+		const auto id = enroll(
+			button ? Kind::Button : Kind::ProfileRow,
+			first);
+		auto &registration = instance->_registrations[id];
+		registration.text = label;
+		if (!button && JS_IsFunction(ctx, second)) {
+			registration.visible = JS_DupValue(ctx, second);
+		}
+		JS_FreeValue(ctx, first);
+		JS_FreeValue(ctx, second);
+		if (button) {
+			const auto weak = base::make_weak(instance);
+			RegisterScriptButton(session, {
+				.owner = instance,
+				.id = QString::number(id),
+				.place = place,
+				.icon = label,
+				.tooltip = StringProperty(ctx, options, "tooltip"),
+				.chats = std::move(chats),
+				.click = [=](not_null<PeerData*> peer) {
+					const auto alive = weak.get();
+					if (!alive) {
+						return;
+					}
+					const auto peerId = peer->id;
+					crl::on_main(alive, [=] {
+						const auto strong = weak.get();
+						if (!strong || !strong->_engine) {
+							return;
+						}
+						const auto target = strong->_session->data().peer(
+							peerId);
+						strong->callOne(
+							id,
+							false,
+							strong->actionContext({ .peer = target }),
+							u"button"_q);
+					});
+				},
+			});
+		}
+		return instance->disposer(id);
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+void Instance::callOne(
+		int id,
+		bool second,
+		JSValue payload,
+		const QString &where) {
+	const auto i = _registrations.find(id);
+	if (!_engine || i == end(_registrations)) {
+		if (_engine) {
+			JS_FreeValue(_engine->ctx(), payload);
+		}
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto fn = JS_DupValue(ctx, second ? i->second.visible : i->second.fn);
+	JSValueConst args[] = { payload };
+	JS_FreeValue(ctx, invoke(fn, args, kListenerBudget, where));
+	if (_engine) {
+		JS_FreeValue(ctx, fn);
+		JS_FreeValue(ctx, payload);
+		_engine->drain();
+	}
+}
+
+std::vector<Instance::ProfileRowSpec> Instance::profileRows() const {
+	auto result = std::vector<ProfileRowSpec>();
+	if (!_started) {
+		return result;
+	}
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::ProfileRow) {
+			result.push_back({
+				.id = id,
+				.label = registration.text,
+				.clickable = JS_IsFunction(
+					_engine->ctx(),
+					registration.visible),
+			});
+		}
+	}
+	return result;
+}
+
+void Instance::profileRowValue(
+		int id,
+		not_null<PeerData*> peer,
+		Fn<void(std::optional<QString>)> done) {
+	if (!_engine || !_registrations.contains(id)) {
+		done(std::nullopt);
+		return;
+	}
+	runGate(
+		Kind::ProfileRow,
+		"__teleRunProfileRow",
+		peerInfo(peer),
+		u"profile row"_q,
+		QString(),
+		std::move(done),
+		id);
+}
+
+void Instance::profileRowClick(int id, not_null<PeerData*> peer) {
+	if (!_engine) {
+		return;
+	}
+	callOne(id, true, peerInfo(peer), u"profile row"_q);
+}
+
+void Instance::callRegistered(
+		Kind kind,
+		JSValue payload,
+		const QString &where) {
+	if (!_engine) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto fns = std::vector<JSValue>();
+	for (const auto &[key, registration] : _registrations) {
+		if (registration.kind == kind) {
+			fns.push_back(JS_DupValue(ctx, registration.fn));
+		}
+	}
+	for (const auto fn : fns) {
+		if (!_engine) {
+			break;
+		}
+		JSValueConst args[] = { payload };
+		JS_FreeValue(ctx, invoke(fn, args, kListenerBudget, where));
+	}
+	if (_engine) {
+		release(fns);
+		JS_FreeValue(ctx, payload);
+		_engine->drain();
+	}
+}
+
+void Instance::watchChats() {
+	if (_watchingChats || !_engine) {
+		return;
+	}
+	const auto window = WindowOf(_session);
+	if (!window) {
+		base::call_delayed(1000, this, [=] {
+			watchChats();
+		});
+		return;
+	}
+	_watchingChats = true;
+	window->activeChatValue(
+	) | rpl::skip(1) | rpl::on_next([=](Dialogs::Key key) {
+		const auto peer = key.peer();
+		const auto peerId = peer ? peer->id : PeerId();
+		crl::on_main(this, [=] {
+			if (!_engine) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			const auto loaded = peerId
+				? _session->data().peerLoaded(peerId)
+				: nullptr;
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"chatId",
+				loaded ? JS_NewBigInt64(ctx, MarkedId(peerId)) : JS_NULL);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"chat",
+				loaded ? peerInfo(loaded) : JS_NULL);
+			callRegistered(Kind::ChatOpened, payload, u"onChatOpened"_q);
+		});
+	}, _chatsLifetime);
+}
+
+JSValue Instance::NativeData(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	static constexpr auto names = std::array{
+		"tg.local.dialogs",
+		"tg.local.unread",
+		"tg.local.folders",
+		"tg.local.draft",
+	};
+	const auto local = (magic < int(names.size()));
+	const auto instance = !local
+		? From(ctx)
+		: Permitted(
+			ctx,
+			Capability::AccountRead,
+			(magic == 3) ? "draft" : "dialogs",
+			names[magic]);
+	if (!instance) {
+		return local
+			? JS_EXCEPTION
+			: JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto owner = &session->data();
+	const auto setInt = [&](JSValueConst object, const char *name, int value) {
+		JS_SetPropertyStr(ctx, object, name, JS_NewInt32(ctx, value));
+	};
+	if ((magic == 9 || magic == 10)
+		&& !instance->_permissions.allows(Capability::Scripts, {})) {
+		return ThrowNotGranted(
+			ctx,
+			(magic == 9) ? u"tg.scripts.emit"_q : u"tg.scripts.on"_q,
+			GrantText(Capability::Scripts, {}));
+	}
+	switch (magic) {
+	case 0: {
+		const auto options = (argc > 0) ? argv[0] : JS_UNDEFINED;
+		auto folder = JS_IsObject(options)
+			? JS_GetPropertyStr(ctx, options, "folder")
+			: JS_UNDEFINED;
+		auto limitValue = JS_IsObject(options)
+			? JS_GetPropertyStr(ctx, options, "limit")
+			: JS_UNDEFINED;
+		auto limit = int64_t(-1);
+		if (!JS_IsUndefined(limitValue)
+			&& (JS_ToInt64(ctx, &limit, limitValue) < 0 || limit < 0)) {
+			limit = -2;
+		}
+		JS_FreeValue(ctx, limitValue);
+		auto filterId = FilterId();
+		auto archive = false;
+		auto valid = (limit != -2);
+		if (JS_IsString(folder)) {
+			const auto name = FromStd(ToStd(ctx, folder));
+			archive = (name == u"archive"_q);
+			valid = valid && (archive || name == u"main"_q);
+		} else if (JS_IsNumber(folder)) {
+			auto id = int32_t();
+			JS_ToInt32(ctx, &id, folder);
+			filterId = FilterId(id);
+			valid = valid && ranges::contains(
+				owner->chatsFilters().list(),
+				filterId,
+				&Data::ChatFilter::id);
+		} else if (!JS_IsUndefined(folder)) {
+			valid = false;
+		}
+		JS_FreeValue(ctx, folder);
+		if (!valid) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.local.dialogs: folder is 'main', 'archive' or a folder "
+				"id from tg.local.folders(), limit is a number");
+		}
+		const auto list = filterId
+			? owner->chatsFilters().chatsList(filterId)
+			: owner->chatsList(archive
+				? owner->folderLoaded(Data::Folder::kId)
+				: nullptr);
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &row : *list->indexed()) {
+			if (limit >= 0 && index >= uint64_t(limit)) {
+				break;
+			}
+			const auto history = row->history();
+			if (!history) {
+				continue;
+			}
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"chat",
+				instance->peerInfo(history->peer));
+			setInt(item, "unread", history->unreadCount());
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"unreadMark",
+				JS_NewBool(ctx, history->unreadMark()));
+			setInt(item, "mentions", history->unreadMentions().count(0));
+			setInt(item, "reactions", history->unreadReactions().count(0));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"muted",
+				JS_NewBool(ctx, history->muted()));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"pinned",
+				JS_NewBool(ctx, history->isPinnedDialog(filterId)));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"archived",
+				JS_NewBool(ctx, history->folder() != nullptr));
+			setInt(item, "date", int(history->chatListTimeId()));
+			if (const auto last = history->chatListMessage()) {
+				JS_SetPropertyStr(
+					ctx,
+					item,
+					"lastMessageId",
+					JS_NewInt64(ctx, last->id.bare));
+			}
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 1: {
+		const auto state = owner->chatsList()->unreadState();
+		auto result = JS_NewObject(ctx);
+		setInt(result, "messages", state.messages);
+		setInt(result, "messagesMuted", state.messagesMuted);
+		setInt(result, "chats", state.chats);
+		setInt(result, "chatsMuted", state.chatsMuted);
+		setInt(result, "marks", state.marks);
+		setInt(result, "mentions", state.mentions);
+		setInt(result, "reactions", state.reactions);
+		setInt(result, "badge", owner->unreadBadge());
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"badgeMuted",
+			JS_NewBool(ctx, owner->unreadBadgeMuted()));
+		return result;
+	}
+	case 2: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &filter : owner->chatsFilters().list()) {
+			if (!filter.id()) {
+				continue;
+			}
+			auto item = JS_NewObject(ctx);
+			setInt(item, "id", int(filter.id()));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"title",
+				NewString(ctx, filter.title().text.text));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"emoji",
+				NewString(ctx, filter.iconEmoji()));
+			auto chats = JS_NewArray(ctx);
+			auto count = uint32_t();
+			const auto list = owner->chatsFilters().chatsList(filter.id());
+			for (const auto &row : *list->indexed()) {
+				if (const auto history = row->history()) {
+					JS_SetPropertyUint32(
+						ctx,
+						chats,
+						count++,
+						JS_NewBigInt64(ctx, MarkedId(history->peer->id)));
+				}
+			}
+			JS_SetPropertyStr(ctx, item, "chats", chats);
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 3: {
+		const auto id = (argc > 0)
+			? PeerFromValue(ctx, argv[0], session->user()->id)
+			: std::nullopt;
+		if (!id) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.local.draft needs a peer, an input peer or a marked id");
+		}
+		const auto history = owner->historyLoaded(*id);
+		const auto draft = history
+			? history->localDraft(MsgId(), PeerId())
+			: nullptr;
+		return (draft && !draft->textWithTags.text.isEmpty())
+			? TextValue(ctx, session, draft->textWithTags)
+			: JS_UNDEFINED;
+	}
+	case 4:
+	case 5: {
+		const auto toObject = [&](const SettingInfo &info) {
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, item, "id", NewString(ctx, info.id));
+			JS_SetPropertyStr(ctx, item, "name", NewString(ctx, info.name));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"description",
+				NewString(ctx, info.description));
+			JS_SetPropertyStr(ctx, item, "kind", NewString(ctx, info.kind));
+			if (!info.choices.isEmpty()) {
+				auto choices = JS_NewArray(ctx);
+				for (auto i = 0; i != info.choices.size(); ++i) {
+					JS_SetPropertyUint32(
+						ctx,
+						choices,
+						uint32_t(i),
+						NewString(ctx, info.choices[i]));
+				}
+				JS_SetPropertyStr(ctx, item, "choices", choices);
+			}
+			JS_SetPropertyStr(ctx, item, "value", SettingValue(ctx, info));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"restartRequired",
+				JS_NewBool(ctx, info.restartRequired));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"group",
+				NewString(ctx, GroupName(info.group)));
+			return item;
+		};
+		if (magic == 4) {
+			auto result = JS_NewArray(ctx);
+			auto index = uint32_t();
+			for (const auto &info : SettingsList()) {
+				JS_SetPropertyUint32(ctx, result, index++, toObject(info));
+			}
+			return result;
+		}
+		const auto found = (argc > 0 && JS_IsString(argv[0]))
+			? FindSetting(FromStd(ToStd(ctx, argv[0])))
+			: std::nullopt;
+		return found ? toObject(*found) : JS_UNDEFINED;
+	}
+	case 6: {
+		if (!instance->_permissions.allows(Capability::Options, {})) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.options.set"_q,
+				GrantText(Capability::Options, {}));
+		} else if (argc < 2 || !JS_IsString(argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.options.set(id, value)");
+		}
+		const auto id = FromStd(ToStd(ctx, argv[0]));
+		const auto value = JS_IsBool(argv[1])
+			? QJsonValue(JS_ToBool(ctx, argv[1]) != 0)
+			: JS_IsString(argv[1])
+			? QJsonValue(FromStd(ToStd(ctx, argv[1])))
+			: QJsonValue(QJsonValue::Undefined);
+		if (value.isUndefined()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.options.set: the value is a boolean or a string");
+		}
+		auto restart = false;
+		const auto error = ChangeSetting(id, value, restart);
+		if (!error.isEmpty()) {
+			const auto text = (u"tg.options.set: "_q + error).toStdString();
+			return JS_ThrowTypeError(ctx, "%s", text.c_str());
+		}
+		auto result = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, result, "restart", JS_NewBool(ctx, restart));
+		return result;
+	}
+	case 8: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &script : Scripts(session)) {
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, item, "id", NewString(ctx, script.id));
+			JS_SetPropertyStr(ctx, item, "name", NewString(ctx, script.name));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"version",
+				NewString(ctx, script.version));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"running",
+				JS_NewBool(ctx, script.running));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"self",
+				JS_NewBool(ctx, script.id == instance->_file.id));
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 9: {
+		if (argc < 1 || !JS_IsString(argv[0])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.scripts.emit(event, data?, { to? })");
+		}
+		const auto event = FromStd(ToStd(ctx, argv[0]));
+		JSValueConst args[] = { (argc > 1) ? argv[1] : JS_NULL };
+		auto text = CallGlobal(ctx, "__teleStore", args);
+		if (JS_IsException(text)) {
+			return text;
+		}
+		auto size = std::size_t();
+		const auto chars = JS_ToCStringLen(ctx, &size, text);
+		auto bytes = chars ? QByteArray(chars, int(size)) : QByteArray();
+		if (chars) {
+			JS_FreeCString(ctx, chars);
+		}
+		JS_FreeValue(ctx, text);
+		const auto target = (argc > 2 && JS_IsString(argv[2]))
+			? FromStd(ToStd(ctx, argv[2]))
+			: QString();
+		return JS_NewInt32(
+			ctx,
+			EmitScriptEvent(
+				session,
+				instance->_file.id,
+				instance->_name,
+				event,
+				bytes,
+				target));
+	}
+	case 10: {
+		if (argc < 2 || !JS_IsString(argv[0]) || !JS_IsFunction(ctx, argv[1])) {
+			return JS_ThrowTypeError(ctx, "tg.scripts.on(event, function)");
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::ScriptEvent,
+			.fn = JS_DupValue(ctx, argv[1]),
+			.key = FromStd(ToStd(ctx, argv[0])),
+		});
+		return instance->disposer(id);
+	}
+	case 11:
+		return instance->connectionValue(ctx);
+	case 14:
+		return JS_NewBool(ctx, owner->chatsListLoaded());
+	case 15: {
+		const auto id = (argc > 0)
+			? PeerFromValue(ctx, argv[0], session->user()->id)
+			: std::nullopt;
+		const auto peer = id ? owner->peerLoaded(*id) : nullptr;
+		if (!peer) {
+			return JS_UNDEFINED;
+		}
+		auto buffer = mtpBuffer();
+		peer->input().write(buffer);
+		auto decoded = DecodeTl(ctx, Bytes(buffer), "InputPeer");
+		if (!decoded.error.empty()) {
+			return JS_UNDEFINED;
+		}
+		auto result = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, result, "input", decoded.value);
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"kind",
+			JS_NewString(ctx, peer->isUser()
+				? (peer->asUser()->isBot() ? "bot" : "user")
+				: peer->isChat()
+				? "chat"
+				: (peer->isMegagroup() || peer->isGigagroup())
+				? "supergroup"
+				: "channel"));
+		return result;
+	}
+	case 12:
+	case 13: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(
+				ctx,
+				(magic == 12)
+					? "tg.onConnectionChange(function)"
+					: "tg.onWake(function)");
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = (magic == 12) ? Kind::Connection : Kind::Wake,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		if (magic == 12) {
+			instance->watchConnection();
+		} else {
+			instance->watchWake();
+		}
+		return instance->disposer(id);
+	}
+	case 7: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.options.onChange(function)");
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::OptionChange,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		instance->watchOptions();
+		return instance->disposer(id);
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::connectionValue(JSContext *ctx) const {
+	const auto state = _session->account().mtp().dcstate();
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"state",
+		NewString(ctx, (state == MTP::ConnectedState)
+			? u"connected"_q
+			: (state < 0)
+			? u"waiting"_q
+			: u"connecting"_q));
+	if (state < 0) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"retryIn",
+			JS_NewInt32(ctx, ((-state) / 1000) + 1));
+	}
+	return result;
+}
+
+void Instance::watchConnection() {
+	if (_watchingConnection) {
+		return;
+	}
+	_watchingConnection = true;
+	const auto name = [=] {
+		const auto state = _session->account().mtp().dcstate();
+		return (state == MTP::ConnectedState)
+			? u"connected"_q
+			: (state < 0)
+			? u"waiting"_q
+			: u"connecting"_q;
+	};
+	_lastConnection = name();
+	Core::App().settings().proxy().connectionTypeChanges(
+	) | rpl::on_next([=] {
+		crl::on_main(this, [=] {
+			const auto now = name();
+			if (!_engine || now == _lastConnection) {
+				return;
+			}
+			_lastConnection = now;
+			callRegistered(
+				Kind::Connection,
+				connectionValue(_engine->ctx()),
+				u"onConnectionChange"_q);
+		});
+	}, _connectionLifetime);
+}
+
+void Instance::watchWake() {
+	if (_wakeTimer) {
+		return;
+	}
+	_lastBeat = QDateTime::currentMSecsSinceEpoch();
+	_wakeTimer = std::make_unique<base::Timer>([=] { checkWake(); });
+	_wakeTimer->callEach(kWakeBeat);
+	Core::App().systemSleepEvents(
+	) | rpl::on_next([=] {
+		crl::on_main(this, [=] {
+			checkWake();
+		});
+	}, _connectionLifetime);
+}
+
+void Instance::checkWake() {
+	const auto now = QDateTime::currentMSecsSinceEpoch();
+	const auto slept = now - _lastBeat - kWakeBeat;
+	_lastBeat = now;
+	if (slept < kWakeGap || !_engine) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto payload = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, payload, "sleptFor", JS_NewInt64(ctx, slept));
+	callRegistered(Kind::Wake, payload, u"onWake"_q);
+}
