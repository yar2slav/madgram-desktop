+constexpr auto kOwnSuffixes = std::array<const char*, 5>{
+	"",
+	".ts",
+	".js",
+	"/index.ts",
+	"/index.js",
+};
+
+constexpr auto kPackageSuffixes = std::array<const char*, 8>{
+	"",
+	".js",
+	".mjs",
+	".ts",
+	".json",
+	"/index.js",
+	"/index.mjs",
+	"/index.ts",
+};
