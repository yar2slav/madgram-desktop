+constexpr auto kMemoryLimit = std::size_t(256 * 1024 * 1024);
+constexpr auto kStackLimit = std::size_t(256 * 1024);
+constexpr auto kStripStackLimit = std::size_t(8 * 1024 * 1024);
+constexpr auto kStripThreadStack = uint(16 * 1024 * 1024);
+constexpr auto kLoadBudget = crl::time(3000);
+constexpr auto kDrainBudget = crl::time(1000);
+constexpr auto kTimerBudget = crl::time(500);
+constexpr auto kMinInterval = crl::time(10);
+constexpr auto kMaxJobs = 100000;
+
+constexpr auto kModuleExports = std::array<std::pair<const char*, const char*>, 3>{ {
+	{ "Message", "__teleMessage" },
+	{ "md", "__teleMd" },
+	{ "html", "__teleHtml" },
+} };
+
+constexpr auto kPrelude = R"js((() => {
+	const seen = new WeakSet();
+	const hex = (bytes) => Array.from(
+		bytes.subarray(0, 32),
+		(byte) => byte.toString(16).padStart(2, '0')).join('')
+		+ (bytes.length > 32 ? '\u2026' : '');
+	const format = (value, depth) => {
+		if (typeof value === 'string') {
+			return depth ? JSON.stringify(value) : value;
+		} else if (typeof value === 'bigint') {
+			return value + 'n';
+		} else if (typeof value === 'function') {
+			return '[function ' + (value.name || 'anonymous') + ']';
+		} else if (value === null || typeof value !== 'object') {
+			return String(value);
+		} else if (value instanceof Error) {
+			return value.name + ': ' + value.message
+				+ (value.stack ? '\n' + value.stack : '');
+		} else if (value instanceof Uint8Array) {
+			return 'Uint8Array(' + value.length + ') ' + hex(value);
+		} else if (seen.has(value)) {
+			return '[circular]';
+		} else if (depth > 6) {
+			return Array.isArray(value) ? '[\u2026]' : '{\u2026}';
+		}
+		seen.add(value);
+		try {
+			if (Array.isArray(value)) {
+				return '[' + value.map((item) => format(item, depth + 1)).join(', ') + ']';
+			}
+			return '{ ' + Object.keys(value).map(
+				(key) => key + ': ' + format(value[key], depth + 1)).join(', ') + ' }';
+		} finally {
+			seen.delete(value);
+		}
+	};
+	Object.defineProperty(globalThis, '__teleFormat', {
+		value: (...args) => args.map((arg) => format(arg, 0)).join(' '),
+	});
+	class TeleError extends Error {
+		constructor(code, message, grant) {
+			super(message);
+			this.name = 'TeleError';
+			this.code = code;
+			if (grant !== undefined) {
+				this.grant = grant;
+			}
+		}
+	}
+	class RpcError extends Error {
+		constructor(code, type) {
+			super(type);
+			this.name = 'RpcError';
+			this.code = code;
+			this.type = type;
+			const flood = /^(?:FLOOD_WAIT|FLOOD_PREMIUM_WAIT|SLOWMODE_WAIT)_(\d+)$/
+				.exec(type);
+			if (flood) {
+				this.seconds = Number(flood[1]);
+			}
+		}
+	}
+	const hidden = (name, value) => Object.defineProperty(globalThis, name, {
+		value,
+	});
+	hidden('__teleTeleError', TeleError);
+	hidden('__teleRpcError', RpcError);
+	globalThis.TeleError = TeleError;
+	globalThis.RpcError = RpcError;
+	hidden('__teleDisposer', (release) => {
+		let done = false;
+		const dispose = () => {
+			if (!done) {
+				done = true;
+				release();
+			}
+		};
+		dispose[Symbol.dispose] = dispose;
+		return dispose;
+	});
+	const sourceColumn = globalThis.__teleSourceColumn;
+	Error.prepareStackTrace = (error, sites) => sites.map((site) => {
+		const file = site.getFileName() ?? '<null>';
+		const line = site.getLineNumber();
+		const where = (line === null)
+			? file
+			: (file + ':' + line + ':'
+				+ sourceColumn(file, line, site.getColumnNumber()));
+		if (site.getFunction() === null) {
+			return '    at ' + where + '\n';
+		}
+		return '    at ' + (site.getFunctionName() || '<anonymous>')
