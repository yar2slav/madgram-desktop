+void FillScriptPage(
+		not_null<Ui::VerticalLayout*> container,
+		std::shared_ptr<Ui::Show> show,
+		ScriptPageView view,
+		Fn<void()> close) {
+	const auto state = std::make_shared<ScriptPageView>(std::move(view));
+	const auto inner = container->add(
+		object_ptr<Ui::VerticalLayout>(container));
+	const auto rows = inner->lifetime().make_state<
+		std::vector<std::unique_ptr<rpl::variable<PageRow>>>>();
+	const auto structure = inner->lifetime().make_state<
+		std::vector<QString>>();
+	const auto rebuild = std::make_shared<Fn<void()>>();
+	*rebuild = [=] {
+		const auto rendered = state->render();
+		if (!rendered) {
+			close();
+			return;
+		}
+		auto keys = std::vector<QString>();
+		for (const auto &row : *rendered) {
+			keys.push_back(StructureKey(row));
+		}
+		if (keys == *structure) {
+			for (auto i = 0; i != int(rendered->size()); ++i) {
+				*(*rows)[i] = (*rendered)[i];
+			}
+			return;
+		}
+		*structure = std::move(keys);
+		inner->clear();
+		rows->clear();
+		for (auto i = 0; i != int(rendered->size()); ++i) {
+			rows->push_back(
+				std::make_unique<rpl::variable<PageRow>>((*rendered)[i]));
+			AddPageRow(
+				inner,
+				show,
+				state->script,
+				rows->back().get(),
+				[=](QVariant value) { state->event(i, value); },
+				[=](double value) { return state->label(i, value); });
+		}
+		inner->resizeToWidth(container->width());
+	};
+	(*rebuild)();
+	std::move(state->invalidated) | rpl::on_next([=] {
+		crl::on_main(inner, [=] {
+			(*rebuild)();
+		});
+	}, inner->lifetime());
+	std::move(state->closed) | rpl::on_next(close, inner->lifetime());
+}
+
+void ShowScriptPage(
+		std::shared_ptr<Ui::Show> show,
+		ScriptPageView view) {
+	auto shared = std::make_shared<ScriptPageView>(std::move(view));
+	show->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setWidth(st::boxWideWidth);
+		box->setTitle(rpl::single(shared->title.isEmpty()
+			? shared->script
+			: shared->title));
+		const auto inner = box->addRow(
+			object_ptr<Ui::VerticalLayout>(box),
+			style::margins());
+		const auto weak = base::make_weak(box);
+		FillScriptPage(inner, show, std::move(*shared), [=] {
+			if (const auto strong = weak.get()) {
+				strong->closeBox();
+			}
+		});
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	}));
+}
+
+void ShowScriptDialog(
+		std::shared_ptr<Ui::Show> show,
+		ScriptDialog descriptor,
+		Fn<void(QString)> done) {
+	show->show(Box([=](not_null<Ui::GenericBox*> box) {
+		AddHeader(box, descriptor.script, descriptor.title, descriptor.message);
+		const auto answer = Once(box, [=] { done(u"dismissed"_q); });
+		const auto add = [&](const QString &text, const QString &result) {
+			if (text.isEmpty()) {
+				return;
+			}
+			const auto button = box->addButton(rpl::single(text), [=] {
+				answer();
+				done(result);
+				box->closeBox();
+			});
+			if (descriptor.danger && result == u"positive"_q) {
+				button->setTextFgOverride(st::attentionButtonFg->c);
+			}
+		};
+		add(
+			descriptor.positive.isEmpty()
+				? tr::lng_box_ok(tr::now)
+				: descriptor.positive,
+			u"positive"_q);
+		add(descriptor.negative, u"negative"_q);
+		add(descriptor.neutral, u"neutral"_q);
+	}));
+}
+
+void ShowScriptPrompt(
+		std::shared_ptr<Ui::Show> show,
+		ScriptPrompt descriptor,
+		Fn<void(std::optional<QString>)> done) {
+	show->show(Box([=](not_null<Ui::GenericBox*> box) {
+		AddHeader(box, descriptor.script, descriptor.title, descriptor.message);
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			descriptor.multiline
+				? Ui::InputField::Mode::MultiLine
+				: Ui::InputField::Mode::SingleLine,
+			rpl::single(descriptor.placeholder),
+			descriptor.value));
+		if (descriptor.maxLength > 0) {
+			field->setMaxLength(descriptor.maxLength);
+		}
+		box->setFocusCallback([=] {
+			field->setFocusFast();
+			field->selectAll();
+		});
+		const auto answer = Once(box, [=] { done(std::nullopt); });
+		const auto submit = [=] {
+			answer();
+			done(field->getLastText());
+			box->closeBox();
+		};
+		field->submits() | rpl::on_next(submit, field->lifetime());
+		box->addButton(tr::lng_box_ok(), submit);
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
+
+void ShowScriptChooser(
+		std::shared_ptr<Ui::Show> show,
+		ScriptChooser descriptor,
+		Fn<void(std::optional<std::vector<int>>)> done) {
+	show->show(Box([=](not_null<Ui::GenericBox*> box) {
+		AddHeader(box, descriptor.script, descriptor.title, QString());
+		const auto answer = Once(box, [=] { done(std::nullopt); });
+		const auto count = int(descriptor.items.size());
+		if (descriptor.multiple) {
+			auto checks = std::vector<not_null<Ui::Checkbox*>>();
+			for (auto i = 0; i != count; ++i) {
+				checks.push_back(box->addRow(object_ptr<Ui::Checkbox>(
+					box,
+					descriptor.items[i],
+					ranges::contains(descriptor.selected, i),
+					st::defaultBoxCheckbox)));
+				Ui::AddSkip(box->verticalLayout());
+			}
+			box->addButton(tr::lng_box_ok(), [=] {
+				auto result = std::vector<int>();
+				for (auto i = 0; i != count; ++i) {
+					if (checks[i]->checked()) {
+						result.push_back(i);
+					}
+				}
+				answer();
+				done(std::move(result));
+				box->closeBox();
+			});
+			box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+			return;
+		}
+		const auto initial = descriptor.selected.empty()
+			? -1
+			: descriptor.selected.front();
+		const auto group = std::make_shared<Ui::RadiobuttonGroup>(initial);
+		for (auto i = 0; i != count; ++i) {
+			box->addRow(object_ptr<Ui::Radiobutton>(
+				box,
+				group,
+				i,
+				descriptor.items[i],
+				st::defaultBoxCheckbox));
+			Ui::AddSkip(box->verticalLayout());
+		}
+		group->setChangedCallback([=](int value) {
+			answer();
+			done(std::vector<int>{ value });
+			box->closeBox();
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
