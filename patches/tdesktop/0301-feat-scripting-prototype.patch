+[[nodiscard]] bool HasProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	const auto result = !JS_IsUndefined(value);
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] JSValue CallGlobal(
+		JSContext *ctx,
+		const char *name,
+		std::span<JSValueConst> args) {
+	auto global = JS_GetGlobalObject(ctx);
+	auto function = JS_GetPropertyStr(ctx, global, name);
+	JS_FreeValue(ctx, global);
+	auto result = JS_Call(
+		ctx,
+		function,
+		JS_UNDEFINED,
+		int(args.size()),
+		const_cast<JSValue*>(args.data()));
+	JS_FreeValue(ctx, function);
+	return result;
+}
+
+[[nodiscard]] QByteArray Tree(JSContext *ctx, JSValueConst value) {
+	if (JS_IsUncatchableError(value)) {
+		return QByteArray();
+	}
+	JSValueConst args[] = { value };
+	auto json = CallGlobal(ctx, "__teleTree", args);
+	if (JS_IsException(json)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return QByteArray();
+	}
+	const auto text = ToStd(ctx, json);
+	JS_FreeValue(ctx, json);
+	return QByteArray::fromStdString(text);
+}
+
+[[nodiscard]] JSValue MakeTypeError(JSContext *ctx, const QString &text) {
+	JS_ThrowTypeError(ctx, "%s", text.toUtf8().constData());
+	return JS_GetException(ctx);
+}
