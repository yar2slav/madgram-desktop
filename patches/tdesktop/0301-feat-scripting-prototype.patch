+struct PeekedScript {
+	QString name;
+	ScriptMeta meta;
+	QStringList grants;
+};
+
+[[nodiscard]] QString ReadLiteral(const QString &text, int &i) {
+	const auto quote = text[i];
+	const auto size = int(text.size());
+	auto result = QString();
+	for (++i; i < size && text[i] != quote; ++i) {
+		if (text[i] != '\\' || i + 1 >= size) {
+			if (quote == '`' && text[i] == '$' && i + 1 < size
+				&& text[i + 1] == '{') {
+				return QString();
+			}
+			result += text[i];
+			continue;
+		}
+		const auto escaped = text[++i];
+		if (escaped == 'n') {
+			result += '\n';
+		} else if (escaped == 't') {
+			result += '\t';
+		} else if (escaped == 'u') {
+			const auto braced = (i + 1 < size) && (text[i + 1] == '{');
+			const auto from = i + (braced ? 2 : 1);
+			const auto till = braced ? int(text.indexOf('}', from)) : (from + 4);
+			auto ok = false;
+			const auto code = (till > from && till <= size)
+				? text.mid(from, till - from).toUInt(&ok, 16)
+				: 0U;
+			if (ok) {
+				const auto point = char32_t(code);
+				result += QString::fromUcs4(&point, 1);
+				i = braced ? till : (till - 1);
+			}
+		} else if (escaped != 'r') {
+			result += escaped;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] PeekedScript PeekText(const QByteArray &bytes) {
+	const auto text = QString::fromUtf8(bytes.left(kMaxPeekSize));
+	const auto start = text.indexOf(u"defineScript("_q);
+	const auto open = (start < 0) ? -1 : int(text.indexOf('{', start));
+	if (open < 0) {
+		return {};
+	}
+	auto result = PeekedScript();
+	const auto assign = [&](const QString &key, const QString &value) {
+		if (key == u"name"_q) {
+			result.name = value;
+		} else if (key == u"version"_q) {
+			result.meta.version = value;
+		} else if (key == u"description"_q) {
+			result.meta.description = value;
+		} else if (key == u"author"_q) {
+			result.meta.author = value;
+		} else if (key == u"icon"_q) {
+			result.meta.icon = value;
+		} else if (key == u"homepage"_q) {
+			result.meta.homepage = value;
+		}
+	};
+	const auto size = int(text.size());
+	const auto nextSolid = [&](int from) {
+		while (from < size && text[from].isSpace()) {
+			++from;
+		}
+		return from;
+	};
+	auto depth = 0;
+	auto key = QString();
+	auto expectValue = false;
+	auto inGrants = false;
+	auto previous = QChar('(');
+	for (auto i = open; i < size; ++i) {
+		const auto c = text[i];
+		if (c.isSpace()) {
+			continue;
+		} else if (c == '/' && i + 1 < size && text[i + 1] == '/') {
+			i = int(text.indexOf('\n', i));
+			if (i < 0) {
+				break;
+			}
+			continue;
+		} else if (c == '/' && i + 1 < size && text[i + 1] == '*') {
+			i = int(text.indexOf(u"*/"_q, i + 2));
+			if (i < 0) {
+				break;
+			}
+			++i;
+			continue;
+		} else if (c == '/' && QString(u"(,=:[!&|?{};"_q).contains(previous)) {
+			auto inClass = false;
+			for (++i; i < size; ++i) {
+				if (text[i] == '\\') {
+					++i;
+				} else if (text[i] == '[') {
+					inClass = true;
+				} else if (text[i] == ']') {
+					inClass = false;
+				} else if (text[i] == '/' && !inClass) {
+					break;
+				}
+			}
+			previous = 'x';
+			continue;
+		} else if (c == '\'' || c == '"' || c == '`') {
+			const auto value = ReadLiteral(text, i);
+			previous = 'x';
+			if (depth == 1 && !expectValue) {
+				const auto colon = nextSolid(i + 1);
+				if (colon < size && text[colon] == ':') {
+					key = value;
+					expectValue = true;
+					previous = ':';
+					i = colon;
+				}
+			} else if (depth == 1 && expectValue) {
+				assign(key, value);
+				expectValue = false;
+			} else if (depth == 2 && inGrants && !value.isEmpty()) {
+				result.grants.push_back(value);
+			}
+			continue;
+		} else if (depth == 1 && (c.isLetter() || c == '_' || c == '$')) {
+			auto end = i;
+			while (end < size
+				&& (text[end].isLetterOrNumber()
+					|| text[end] == '_'
+					|| text[end] == '$')) {
+				++end;
+			}
+			const auto word = text.mid(i, end - i);
+			const auto colon = nextSolid(end);
+			if (!expectValue && colon < size && text[colon] == ':') {
+				key = word;
+				expectValue = true;
+				previous = ':';
+				i = colon;
+			} else {
+				expectValue = false;
+				previous = 'x';
+				i = end - 1;
+			}
+			continue;
+		} else if (c == '{' || c == '[' || c == '(') {
+			if (depth == 1 && c == '[' && expectValue && key == u"grants"_q) {
+				inGrants = true;
+			}
+			++depth;
+			expectValue = false;
+		} else if (c == '}' || c == ']' || c == ')') {
+			if (--depth <= 0) {
+				break;
+			} else if (depth == 1) {
+				inGrants = false;
+			}
+		} else if (c == ',' && depth == 1) {
+			expectValue = false;
+		}
+		previous = c;
+	}
+	return result;
+}
+
+[[nodiscard]] PeekedScript PeekScript(const QString &path) {
+	auto file = QFile(path);
+	return file.open(QIODevice::ReadOnly)
+		? PeekText(file.read(kMaxPeekSize))
+		: PeekedScript();
+}
+
+struct ParsedVersion {
+	std::vector<qint64> numbers;
+	QStringList prerelease;
+};
+
+[[nodiscard]] std::optional<ParsedVersion> ParseVersion(QString text) {
+	text = text.trimmed();
+	if (text.startsWith('v') || text.startsWith('V')) {
+		text = text.mid(1);
+	}
+	if (const auto plus = text.indexOf('+'); plus >= 0) {
+		text = text.left(plus);
+	}
+	const auto dash = text.indexOf('-');
+	auto result = ParsedVersion();
+	for (const auto &part : (dash >= 0 ? text.left(dash) : text).split('.')) {
+		auto ok = false;
+		const auto number = part.toLongLong(&ok);
+		if (!ok || number < 0) {
+			return std::nullopt;
+		}
+		result.numbers.push_back(number);
+	}
+	if (dash >= 0) {
+		result.prerelease = text.mid(dash + 1).split('.');
+	}
+	return result;
+}
+
+[[nodiscard]] int ComparePrerelease(const QString &a, const QString &b) {
+	auto aNumeric = false;
+	auto bNumeric = false;
+	const auto x = a.toLongLong(&aNumeric);
+	const auto y = b.toLongLong(&bNumeric);
+	if (aNumeric && bNumeric) {
+		return (x < y) ? -1 : (x > y) ? 1 : 0;
+	} else if (aNumeric != bNumeric) {
+		return aNumeric ? -1 : 1;
+	}
+	const auto compared = a.compare(b);
+	return (compared < 0) ? -1 : (compared > 0) ? 1 : 0;
+}
+
+[[nodiscard]] int CompareVersions(
+		const ParsedVersion &a,
+		const ParsedVersion &b) {
+	const auto count = std::max(a.numbers.size(), b.numbers.size());
+	for (auto i = std::size_t(); i != count; ++i) {
+		const auto x = (i < a.numbers.size()) ? a.numbers[i] : qint64();
+		const auto y = (i < b.numbers.size()) ? b.numbers[i] : qint64();
+		if (x != y) {
+			return (x < y) ? -1 : 1;
+		}
+	}
+	if (a.prerelease.isEmpty() || b.prerelease.isEmpty()) {
+		return a.prerelease.isEmpty()
+			? (b.prerelease.isEmpty() ? 0 : 1)
+			: -1;
+	}
+	const auto common = std::min(a.prerelease.size(), b.prerelease.size());
+	for (auto i = 0; i != int(common); ++i) {
+		if (const auto result = ComparePrerelease(
+				a.prerelease[i],
+				b.prerelease[i])) {
+			return result;
+		}
+	}
+	return (a.prerelease.size() < b.prerelease.size())
+		? -1
+		: (a.prerelease.size() > b.prerelease.size())
+		? 1
+		: 0;
+}
+
+void Fetch(
+		not_null<QNetworkAccessManager*> network,
+		const QUrl &url,
+		const QString &etag,
+		qint64 limit,
+		Fn<void(ScriptDownload)> done) {
+	auto request = QNetworkRequest(url);
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTransferTimeout));
+	if (!etag.isEmpty()) {
+		request.setRawHeader("If-None-Match", etag.toUtf8());
+	}
+	const auto reply = network->get(request);
+	const auto large = std::make_shared<bool>(false);
+	const auto tooLarge = [=] {
+		return Lower(u"It's bigger than %1 MB."_q).arg(
+			limit / (1024 * 1024));
+	};
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 received,
+			qint64 total) {
+		if (received > limit || total > limit) {
+			*large = true;
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		if (*large) {
+			done({ .error = tooLarge() });
+			return;
+		} else if (reply->error() != QNetworkReply::NoError) {
+			done({ .error = reply->errorString() });
+			return;
+		}
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (status == 304) {
+			done({ .notModified = true });
+			return;
+		}
+		auto content = reply->readAll();
+		if (content.size() > limit) {
+			done({ .error = tooLarge() });
+			return;
+		}
+		done({
+			.content = std::move(content),
+			.name = reply->url().fileName(),
+			.etag = QString::fromLatin1(reply->rawHeader("ETag")),
+		});
+	});
+}
