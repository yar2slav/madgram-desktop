index 0000000000000000000000000000000000000000..6da1e1f086af3239a1c771f1e8141eae871cfd90
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/data.js
@@ -0,0 +1,200 @@
+(() => {
+	const kDefaultMaxSize = 64 * 1024 * 1024;
+	const kMaxSize = 256 * 1024 * 1024;
+	const kMaxArea = 100_000_000;
+	const kMaxDimension = 1_000_000;
+	const kFits = ['contain', 'cover', 'fill', 'inside', 'outside'];
+	const kKinds = { gzip: 0, deflate: 1, deflateRaw: 2 };
+	const kUnpack = { gzip: 'gunzip', deflate: 'inflate', deflateRaw: 'inflateRaw' };
+	const kOps = { resize: 0, crop: 1, rotate: 2, convert: 3 };
+	let encoder = null;
+
+	const options = (what, value) => {
+		if (value === undefined || value === null) {
+			return {};
+		} else if (typeof value !== 'object') {
+			throw new TypeError(`${what}: options is an object`);
+		}
+		return value;
+	};
+	const integer = (what, field, value, min, max, fallback) => {
+		if (value === undefined) {
+			if (fallback === undefined) {
+				throw new TypeError(`${what} needs ${field}`);
+			}
+			return fallback;
+		} else if (!Number.isInteger(value) || value < min || value > max) {
+			throw new TypeError(`${what}: ${field} is an integer from ${min} to ${max}`);
+		}
+		return value;
+	};
+	const compressionInput = (what, value) => {
+		if (typeof value === 'string') {
+			encoder ??= new TextEncoder();
+			return encoder.encode(value);
+		} else if (value instanceof Uint8Array || value instanceof ArrayBuffer) {
+			return value;
+		}
+		throw new TypeError(`${what} needs a Uint8Array, an ArrayBuffer or a string`);
+	};
+	const imageInput = (what, value) => {
+		if (value instanceof Uint8Array || value instanceof ArrayBuffer) {
+			return value;
+		}
+		throw new TypeError(`${what} needs the image as a Uint8Array or an ArrayBuffer`);
+	};
+	const format = (what, value) => {
+		if (value === undefined) {
+			return '';
+		} else if (typeof value !== 'string' || !/^[a-z0-9]+$/i.test(value)) {
+			throw new TypeError(`${what}: format is a name like 'jpeg', 'png', 'webp' or 'bmp'`);
+		}
+		const lower = value.toLowerCase();
+		return (lower === 'jpg') ? 'jpeg' : lower;
+	};
+	const encoding = (what, given) => ({
+		format: format(what, given.format),
+		quality: integer(what, 'quality', given.quality, 0, 100, -1),
+	});
+	const color = (what, value) => {
+		if (value === undefined) {
+			return undefined;
+		} else if (value === 'transparent') {
+			return 0;
+		}
+		const match = (typeof value === 'string')
+			? /^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$/i.exec(value)
+			: null;
+		if (!match) {
+			throw new TypeError(`${what}: background is a color like '#ffffff', '#00000080' or 'transparent'`);
+		}
+		let hex = match[1];
+		if (hex.length <= 4) {
+			hex = [...hex].map((digit) => digit + digit).join('');
+		}
+		if (hex.length === 6) {
+			hex += 'ff';
+		}
+		return Number.parseInt(hex, 16);
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'data',
+		globals(natives) {
+			const compression = {};
+			for (const [name, kind] of Object.entries(kKinds)) {
+				compression[name] = (input, settings) => {
+					const what = `compression.${name}`;
+					const bytes = compressionInput(what, input);
+					const level = integer(what, 'level', options(what, settings).level, 0, 9, -1);
+					return natives.dataCompress(kind, bytes, level);
+				};
+				const unpack = kUnpack[name];
+				compression[unpack] = (input, settings) => {
+					const what = `compression.${unpack}`;
+					const bytes = compressionInput(what, input);
+					const maxSize = integer(what, 'maxSize', options(what, settings).maxSize, 1, kMaxSize, kDefaultMaxSize);
+					return natives.dataDecompress(kind, bytes, maxSize);
+				};
+			}
+			Object.defineProperty(globalThis, 'compression', {
+				value: Object.freeze(compression),
+				writable: true,
+				configurable: true,
+			});
+		},
+		tg(tg, natives) {
+			const transform = (bytes, request) => natives.dataImageTransform(bytes, request);
+			const image = Object.freeze({
+				info(bytes) {
+					return natives.dataImageInfo(imageInput('tg.image.info', bytes));
+				},
+				resize(bytes, settings) {
+					const what = 'tg.image.resize';
+					const input = imageInput(what, bytes);
+					if (settings === undefined) {
+						throw new TypeError(`${what} needs { width, height, fit }`);
+					}
+					const given = options(what, settings);
+					const width = integer(what, 'width', given.width, 1, kMaxDimension, 0);
+					const height = integer(what, 'height', given.height, 1, kMaxDimension, 0);
+					if (!width && !height) {
+						throw new TypeError(`${what} needs a width, a height or both`);
+					}
+					const fit = given.fit ?? 'cover';
+					if (!kFits.includes(fit)) {
+						throw new TypeError(`${what}: fit is 'contain', 'cover', 'fill', 'inside' or 'outside'`);
+					}
+					return transform(input, {
+						op: kOps.resize,
+						width,
+						height,
+						fit: kFits.indexOf(fit),
+						background: color(what, given.background),
+						...encoding(what, given),
+					});
+				},
+				crop(bytes, settings) {
+					const what = 'tg.image.crop';
+					const input = imageInput(what, bytes);
+					const given = options(what, settings);
+					return transform(input, {
+						op: kOps.crop,
+						x: integer(what, 'x', given.x, 0, kMaxDimension),
+						y: integer(what, 'y', given.y, 0, kMaxDimension),
+						width: integer(what, 'width', given.width, 1, kMaxDimension),
+						height: integer(what, 'height', given.height, 1, kMaxDimension),
+						...encoding(what, given),
+					});
+				},
+				rotate(bytes, degrees, settings) {
+					const what = 'tg.image.rotate';
+					const input = imageInput(what, bytes);
+					if (degrees !== 90 && degrees !== 180 && degrees !== 270) {
+						throw new TypeError(`${what}: degrees is 90, 180 or 270`);
+					}
+					return transform(input, {
+						op: kOps.rotate,
+						degrees,
+						...encoding(what, options(what, settings)),
+					});
+				},
+				convert(bytes, settings) {
+					const what = 'tg.image.convert';
+					const input = imageInput(what, bytes);
+					const given = options(what, settings);
+					if (given.format === undefined) {
+						throw new TypeError(`${what} needs { format }`);
+					}
+					return transform(input, {
+						op: kOps.convert,
+						...encoding(what, given),
+					});
+				},
+				toPixels(bytes) {
+					return natives.dataImageToPixels(imageInput('tg.image.toPixels', bytes));
+				},
+				fromPixels(pixels, settings) {
+					const what = 'tg.image.fromPixels';
+					if (pixels === null || typeof pixels !== 'object') {
+						throw new TypeError(`${what} needs { width, height, data }`);
+					}
+					const width = integer(what, 'width', pixels.width, 1, kMaxDimension);
+					const height = integer(what, 'height', pixels.height, 1, kMaxDimension);
+					if (width * height > kMaxArea) {
+						throw new TeleError('quota-exceeded', `${what}: ${width}x${height} is over 100 megapixels`);
+					}
+					const { data } = pixels;
+					if (!(data instanceof Uint8Array) && !(data instanceof Uint8ClampedArray)) {
+						throw new TypeError(`${what}: data is a Uint8Array of RGBA bytes`);
+					} else if (data.length !== width * height * 4) {
+						throw new TypeError(`${what}: data has ${data.length} bytes, ${width}x${height} RGBA needs ${width * height * 4}`);
+					}
+					const { format, quality } = encoding(what, options(what, settings));
+					return natives.dataImageFromPixels(width, height, data, format || 'png', quality);
+				},
+			});
+			Object.defineProperty(tg, 'image', { value: image, enumerable: true });
+		},
+	});
+})();
