+			throw fail('NotSupportedError', `${target.name} keys can't be derived`);
+		} else if (target.name === 'HMAC') {
+			const hash = hashOf(target.hash);
+			if (target.length === undefined) {
+				return BLOCK_BITS[hash];
+			} else if (!Number.isInteger(target.length) || target.length <= 0) {
+				throw new TypeError('the HMAC length must be a positive integer');
+			}
+			return target.length;
+		} else if (target.name === 'PBKDF2' || target.name === 'HKDF') {
+			return null;
+		} else if (![128, 192, 256].includes(target.length)) {
+			throw fail('OperationError', 'the AES length is 128, 192 or 256');
+		}
+		return target.length;
+	};
+
+	const exponentValue = (bytes) => bytes.reduce((value, byte) => value * 256 + byte, 0);
+
+	class SubtleCrypto {
+		constructor(given) {
+			if (given !== token) {
+				throw new TypeError('Illegal constructor');
+			}
+		}
+
+		async digest(algorithm, data) {
+			const hash = hashOf(algorithm);
+			return natives.cryptoDigest(hash, bytesOf(data, 'data'));
+		}
+
+		async encrypt(algorithm, key, data) {
+			const params = normalize('encrypt', algorithm);
+			const bytes = bytesOf(data, 'data');
+			const slot = useKey(key, params.name, 'encrypt', 'encrypt');
+			return cipher(true, params, slot, bytes);
+		}
+
+		async decrypt(algorithm, key, data) {
+			const params = normalize('encrypt', algorithm);
+			const bytes = bytesOf(data, 'data');
+			const slot = useKey(key, params.name, 'decrypt', 'decrypt');
+			return cipher(false, params, slot, bytes);
+		}
+
+		async sign(algorithm, key, data) {
+			const params = normalize('sign', algorithm);
+			const bytes = bytesOf(data, 'data');
+			const slot = useKey(key, params.name, 'sign', 'sign');
+			const [hash, salt] = signParams(params, slot);
+			return natives.cryptoSign(params.name, slot.handle, bytes, hash, salt);
+		}
+
+		async verify(algorithm, key, signature, data) {
+			const params = normalize('sign', algorithm);
+			const given = bytesOf(signature, 'signature');
+			const bytes = bytesOf(data, 'data');
+			const slot = useKey(key, params.name, 'verify', 'verify');
+			const [hash, salt] = signParams(params, slot);
+			return natives.cryptoVerify(params.name, slot.handle, given, bytes, hash, salt);
+		}
+
+		async generateKey(algorithm, extractable, usages) {
+			const params = normalize('generateKey', algorithm);
+			const { name } = params;
+			const kind = KIND[name];
+			if (kind === 'secret') {
+				const list = usagesOf(name, ['secret'], usages);
+				let generated;
+				let size;
+				if (name === 'HMAC') {
+					const hash = hashOf(params.hash);
+					const length = params.length ?? BLOCK_BITS[hash];
+					if (!Number.isInteger(length) || length <= 0 || length % 8) {
+						throw fail('OperationError', 'the HMAC length is a positive multiple of 8');
+					}
+					generated = { name, hash: { name: hash }, length };
+					size = length / 8;
+				} else {
+					if (![128, 192, 256].includes(params.length)) {
+						throw fail('OperationError', 'the AES length is 128, 192 or 256');
+					}
+					generated = { name, length: params.length };
+					size = params.length / 8;
+				}
+				needUsages(list);
+				const handle = await natives.cryptoGenerate('secret', size);
+				return makeKey(handle, 'secret', extractable, generated, list);
+			}
+			const list = usagesOf(name, ['public', 'private'], usages);
+			const privateUsages = list.filter((usage) => ALLOWED[name].private.includes(usage));
+			const publicUsages = list.filter((usage) => ALLOWED[name].public.includes(usage));
+			const generated = { name };
+			let pair;
+			if (kind === 'EC') {
+				if (!CURVES.includes(params.namedCurve)) {
+					throw fail('NotSupportedError', 'the namedCurve is P-256, P-384 or P-521');
+				}
+				generated.namedCurve = params.namedCurve;
+				needUsages(privateUsages);
+				pair = await natives.cryptoGenerate('EC', params.namedCurve);
+			} else if (kind === 'RSA') {
+				const hash = hashOf(params.hash);
+				const { modulusLength } = params;
+				const exponent = bytesOf(params.publicExponent, 'publicExponent').slice();
+				if (!Number.isInteger(modulusLength) || modulusLength < 1024 || modulusLength > 16384 || modulusLength % 8) {
+					throw fail('OperationError', 'modulusLength is a multiple of 8 from 1024 to 16384');
+				} else if (![3, 65537].includes(exponentValue(exponent))) {
+					throw fail('OperationError', 'publicExponent is 3 or 65537');
+				}
+				Object.assign(generated, { modulusLength, publicExponent: exponent, hash: { name: hash } });
+				needUsages(privateUsages);
+				pair = await natives.cryptoGenerate('RSA', modulusLength, exponent);
+			} else {
+				needUsages(privateUsages);
+				pair = await natives.cryptoGenerate(kind);
+			}
+			return {
+				publicKey: makeKey(pair[0], 'public', true, copyAlgorithm(generated), publicUsages),
+				privateKey: makeKey(pair[1], 'private', extractable, generated, privateUsages),
+			};
+		}
+
+		async deriveKey(algorithm, baseKey, derivedKeyType, extractable, usages) {
+			const params = normalize('deriveBits', algorithm);
+			const target = normalize('importKey', derivedKeyType);
+			const length = derivedLength(target);
+			const slot = useKey(baseKey, params.name, 'deriveKey', 'deriveKey');
+			const bits = await derive(params, slot, length);
+			return importAs('raw', bits, target, extractable, usages);
+		}
+
+		async deriveBits(algorithm, baseKey, length = null) {
+			const params = normalize('deriveBits', algorithm);
+			const slot = useKey(baseKey, params.name, 'deriveBits', 'deriveBits');
+			return derive(params, slot, length);
+		}
+
+		async importKey(format, keyData, algorithm, extractable, usages) {
+			const params = normalize('importKey', algorithm);
+			return importAs(String(format), keyData, params, extractable, usages);
+		}
+
+		async exportKey(format, key) {
+			const slot = slotOf(key, 'exportKey');
+			if (!slot.extractable) {
+				throw fail('InvalidAccessError', 'the key is not extractable');
+			}
+			return exportAs(String(format), slot);
+		}
+
+		async wrapKey(format, key, wrappingKey, wrapAlgorithm) {
+			const params = normalize('wrapKey', wrapAlgorithm);
+			const wrapping = useKey(wrappingKey, params.name, 'wrapKey', 'wrapKey');
+			const slot = slotOf(key, 'wrapKey');
+			if (!slot.extractable) {
+				throw fail('InvalidAccessError', 'the key is not extractable');
+			}
+			const exported = await exportAs(String(format), slot);
+			const bytes = (format === 'jwk')
+				? new TextEncoder().encode(JSON.stringify(exported))
+				: new Uint8Array(exported);
+			return cipher(true, params, wrapping, bytes);
+		}
+
+		async unwrapKey(format, wrappedKey, unwrappingKey, unwrapAlgorithm, unwrappedKeyAlgorithm, extractable, usages) {
+			const params = normalize('wrapKey', unwrapAlgorithm);
+			const target = normalize('importKey', unwrappedKeyAlgorithm);
+			const given = bytesOf(wrappedKey, 'wrappedKey');
+			const slot = useKey(unwrappingKey, params.name, 'unwrapKey', 'unwrapKey');
+			const bytes = new Uint8Array(await cipher(false, params, slot, given));
+			if (String(format) !== 'jwk') {
+				return importAs(String(format), bytes, target, extractable, usages);
+			}
+			let jwk;
+			try {
+				jwk = JSON.parse(new TextDecoder().decode(bytes));
+			} catch {
+				throw fail('DataError', 'the unwrapped data is not a jwk');
+			}
+			return importAs('jwk', jwk, target, extractable, usages);
+		}
+	}
+	Object.defineProperty(SubtleCrypto.prototype, Symbol.toStringTag, {
+		value: 'SubtleCrypto',
+		configurable: true,
+	});
+
+	Object.defineProperty(globalThis, 'CryptoKey', {
+		value: CryptoKey,
+		writable: true,
+		configurable: true,
+	});
+	Object.defineProperty(globalThis, 'SubtleCrypto', {
+		value: SubtleCrypto,
+		writable: true,
+		configurable: true,
+	});
+
+	globalThis.__teleExtensions.push({
+		name: 'crypto',
+		globals(given) {
+			natives = given;
+			Object.defineProperty(globalThis.crypto, 'subtle', {
+				value: Object.freeze(new SubtleCrypto(token)),
+				enumerable: true,
+				configurable: true,
+			});
+		},
+	});
+})();
diff --git a/Telegram/Resources/tele/scripting/data.js b/Telegram/Resources/tele/scripting/data.js
