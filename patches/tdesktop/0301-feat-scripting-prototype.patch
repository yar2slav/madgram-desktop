+
+constexpr auto kTsConfig = R"json({
+  "compilerOptions": {
+    "target": "ESNext",
+    "module": "ESNext",
+    "moduleResolution": "Bundler",
+    "lib": ["ESNext"],
+    "types": [],
+    "strict": true,
+    "noEmit": true,
+    "allowJs": true,
+    "allowImportingTsExtensions": true,
+    "isolatedModules": true,
+    "resolveJsonModule": true,
+    "skipLibCheck": true
+  }
+}
+)json";
+
+constexpr auto kHelpers = R"ts(
+  interface TlObject {
+    _: string
+  }
+
+  type RpcMethod = keyof RpcMethods
+  type AnyRequest = RpcMethods[RpcMethod]['request']
+  type RpcResult<N extends RpcMethod> = RpcMethods[N]['result']
+
+  type AnyUpdate =
+    | tl.TypeUpdate
+    | tl.RawUpdateShortMessage
+    | tl.RawUpdateShortChatMessage
+    | tl.RawUpdateShortSentMessage
+  type UpdateName = AnyUpdate['_']
+  type UpdateOf<N extends UpdateName> = Extract<AnyUpdate, { _: N }>
+)ts";
+
+constexpr auto kModule = R"ts(
+declare module 'tele' {
+  export interface Peers {
+    users: tl.TypeUser[]
+    chats: tl.TypeChat[]
+  }
+
+  type Some<T extends string> = T | `${T}, ${string}`
+
+  export type Grant =
+    | 'call'
+    | `call(${Some<tl.RpcMethod | `${string}*`>})`
+    | 'onUpdate'
+    | `onUpdate(${Some<
+      tl.UpdateName | 'new_message' | 'edit_message' | 'delete_message'
+    >})`
+    | 'interceptRpc'
+    | `interceptRpc(${Some<tl.RpcMethod | `${string}*`>})`
+    | 'interceptUpdate'
+    | `interceptUpdate(${Some<tl.UpdateName>})`
+    | 'interceptSendMessage'
+    | 'account.read'
+    | `account.read(${Some<
+      'self' | 'peers' | 'messages' | 'dialogs' | 'history' | 'draft' | 'stories' | 'gifts'
+    >})`
+    | 'account.write'
+    | `account.write(${Some<
+      | 'send'
+      | 'edit'
+      | 'delete'
+      | 'forward'
+      | 'react'
+      | 'read'
+      | 'typing'
+      | 'draft'
+      | 'notify'
+      | 'stories'
+      | 'gifts'
+    >})`
+    | 'fetch'
+    | `fetch(${string})`
+    | 'clipboard.read'
+    | 'clipboard.write'
+    | 'openUrl'
+    | 'notify'
+    | 'interceptLink'
+    | 'interceptNotification'
+    | 'options'
