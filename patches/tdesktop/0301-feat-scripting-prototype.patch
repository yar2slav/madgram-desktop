+class ModuleResolver final {
+public:
+	ModuleResolver(
+		QString root,
+		QString limit,
+		std::vector<QString> &files);
+
+	[[nodiscard]] std::optional<QString> resolve(
+		const QString &directory,
+		const QString &name,
+		QString &error);
+
+private:
+	[[nodiscard]] std::optional<QString> relative(
+		const QString &directory,
+		const QString &name,
+		QString &error);
+	[[nodiscard]] std::optional<QString> package(
+		const QString &directory,
+		const QString &name,
+		QString &error);
+	[[nodiscard]] std::optional<QString> internal(
+		const QString &directory,
+		const QString &name,
+		QString &error);
+	[[nodiscard]] std::optional<QString> entry(
+		const QString &folder,
+		const QString &owner,
+		const QString &subpath,
+		QString &error);
+	[[nodiscard]] std::optional<QString> target(
+		const QString &folder,
+		const QJsonValue &value,
+		const QString &match,
+		const QString &name,
+		bool imports,
+		QString &error);
+	[[nodiscard]] std::optional<QJsonObject> manifest(
+		const QString &folder,
+		QString &error);
+	[[nodiscard]] QString shown(const QString &path) const;
+	void watch(const QString &path);
+
+	const QString _root;
+	const QString _limit;
+	const QString _modules;
+	std::vector<QString> &_files;
+
+};
+
+ModuleResolver::ModuleResolver(
+	QString root,
+	QString limit,
+	std::vector<QString> &files)
+: _root(std::move(root))
+, _limit(std::move(limit))
+, _modules(_limit + u"/node_modules"_q)
+, _files(files) {
+}
+
+std::optional<QString> ModuleResolver::resolve(
+		const QString &directory,
+		const QString &name,
+		QString &error) {
+	if (name == u"."_q
+		|| name == u".."_q
+		|| name.startsWith(u"./"_q)
+		|| name.startsWith(u"../"_q)) {
+		return relative(directory, name, error);
+	} else if (name.startsWith('#')) {
+		return internal(directory, name, error);
+	} else if (name.startsWith(u"node:"_q)) {
+		error = BuiltinError(name, FindBuiltin(name.mid(5)));
+		return std::nullopt;
+	} else if (name.isEmpty()
+		|| name.startsWith('/')
+		|| name.contains(':')
+		|| name.contains('\\')) {
+		error = u"only relative imports, 'tele' and packages from "
+			"node_modules work, not '"_q
+			+ name
+			+ '\'';
+		return std::nullopt;
+	}
+	return package(directory, name, error);
+}
+
+std::optional<QString> ModuleResolver::relative(
+		const QString &directory,
+		const QString &name,
+		QString &error) {
+	const auto path = QDir::cleanPath(directory + '/' + name);
+	if (!Inside(path, _root) && !Inside(path, _modules)) {
+		error = u"'"_q + name + u"' is outside the script"_q;
+		return std::nullopt;
+	}
+	const auto found = InModules(directory)
+		? FindFile(path, kPackageSuffixes)
+		: FindFile(path, kOwnSuffixes);
+	if (!found) {
+		error = u"can't find '"_q + name + '\'';
+	}
+	return found;
+}
+
+std::optional<QString> ModuleResolver::package(
+		const QString &directory,
+		const QString &name,
+		QString &error) {
+	const auto parts = name.split('/');
+	const auto scoped = name.startsWith('@');
+	const auto count = scoped ? 2 : 1;
+	const auto invalid = (parts.size() < count)
+		|| ranges::any_of(parts, [](const QString &part) {
+			return part.isEmpty() || part == u"."_q || part == u".."_q;
+		});
+	if (invalid) {
+		error = u"'"_q + name + u"' is not a valid package name"_q;
+		return std::nullopt;
+	}
+	const auto packageName = QStringList(parts.mid(0, count)).join('/');
+	const auto subpath = (parts.size() > count)
+		? (u"./"_q + QStringList(parts.mid(count)).join('/'))
+		: u"."_q;
+	auto probed = std::vector<QString>();
+	for (auto folder = directory; ; folder = QFileInfo(folder).path()) {
+		if (QFileInfo(folder).fileName() != u"node_modules"_q) {
+			const auto candidate = folder + u"/node_modules/"_q + packageName;
+			if (QFileInfo(candidate).isDir()) {
+				return entry(candidate, packageName, subpath, error);
+			}
+			probed.push_back(candidate);
+		}
+		if (folder == _limit || !Inside(folder, _limit)) {
+			break;
+		}
+	}
+	for (const auto &path : probed) {
+		watch(path);
+	}
+	if (const auto builtin = scoped ? nullptr : FindBuiltin(packageName)) {
+		error = BuiltinError(name, builtin);
+	} else {
+		error = u"can't find package '"_q
+			+ packageName
+			+ u"' in node_modules: install it in the scripts folder "
+			"(npm install "_q
+			+ packageName
+			+ ')';
+	}
+	return std::nullopt;
+}
+
+std::optional<QString> ModuleResolver::internal(
+		const QString &directory,
+		const QString &name,
+		QString &error) {
+	for (auto folder = directory; ; folder = QFileInfo(folder).path()) {
+		const auto file = folder + u"/package.json"_q;
+		if (QFileInfo(file).isFile()) {
+			const auto json = manifest(folder, error);
+			if (!json) {
+				return std::nullopt;
+			}
+			const auto imports = json->value(u"imports"_q).toObject();
+			auto match = QString();
+			const auto key = MatchKey(imports, name, match);
+			if (!key) {
+				error = u"'"_q
+					+ name
+					+ u"' is not in the \"imports\" of "_q
+					+ shown(file);
+				return std::nullopt;
+			}
+			const auto path = target(
+				folder,
+				imports.value(*key),
+				match,
+				name,
+				true,
+				error);
+			if (path && !QFileInfo(*path).isFile()) {
+				error = u"can't find '"_q
+					+ shown(*path)
+					+ u"' that "_q
+					+ shown(file)
+					+ u" maps '"_q
+					+ name
+					+ u"' to"_q;
+				return std::nullopt;
+			}
+			return path;
+		} else if (folder == _limit || !Inside(folder, _limit)) {
+			break;
+		}
+	}
+	error = u"'"_q + name + u"' needs an \"imports\" field in a package.json"_q;
+	return std::nullopt;
+}
+
+std::optional<QString> ModuleResolver::entry(
+		const QString &folder,
+		const QString &owner,
+		const QString &subpath,
+		QString &error) {
+	const auto json = manifest(folder, error);
+	if (!json) {
+		return std::nullopt;
+	}
+	const auto name = (subpath == u"."_q)
+		? owner
+		: (owner + subpath.mid(1));
+	const auto exports = json->value(u"exports"_q);
+	if (!exports.isUndefined() && !exports.isNull()) {
+		const auto object = exports.toObject();
+		const auto sugar = !exports.isObject()
+			|| ranges::none_of(object.keys(), [](const QString &key) {
+				return key.startsWith('.');
+			});
+		auto map = sugar ? QJsonObject() : object;
+		if (sugar) {
+			map.insert(u"."_q, exports);
+		}
+		auto match = QString();
+		const auto key = MatchKey(map, subpath, match);
+		if (!key) {
+			error = u"package '"_q
+				+ owner
+				+ u"' doesn't export '"_q
+				+ subpath
+				+ '\'';
+			return std::nullopt;
+		}
+		const auto path = target(
+			folder,
+			map.value(*key),
+			match,
+			name,
+			false,
+			error);
+		if (path && !QFileInfo(*path).isFile()) {
+			error = u"can't find '"_q
+				+ shown(*path)
+				+ u"' that package '"_q
+				+ owner
+				+ u"' exports as '"_q
+				+ subpath
+				+ '\'';
+			return std::nullopt;
+		}
+		return path;
+	} else if (subpath == u"."_q) {
+		for (const auto &field : { u"module"_q, u"main"_q }) {
+			const auto value = json->value(field).toString();
+			const auto path = QDir::cleanPath(folder + '/' + value);
+			if (value.isEmpty() || !Inside(path, folder)) {
+				continue;
+			} else if (auto found = FindFile(path, kPackageSuffixes)) {
+				return found;
+			}
+		}
+		if (auto found = FindFile(folder + u"/index"_q, kPackageSuffixes)) {
+			return found;
+		}
+		error = u"package '"_q
+			+ owner
+			+ u"' has no entry file: no exports, module, main or index.js"_q;
+		return std::nullopt;
+	}
+	const auto path = QDir::cleanPath(folder + '/' + subpath.mid(2));
+	if (Inside(path, folder)) {
+		if (auto found = FindFile(path, kPackageSuffixes)) {
+			return found;
+		}
+	}
+	error = u"can't find '"_q + name + '\'';
+	return std::nullopt;
+}
+
+std::optional<QString> ModuleResolver::target(
+		const QString &folder,
+		const QJsonValue &value,
+		const QString &match,
+		const QString &name,
+		bool imports,
+		QString &error) {
+	const auto file = shown(folder + u"/package.json"_q);
+	if (value.isString()) {
+		auto text = value.toString();
+		if (text.startsWith(u"./"_q)) {
+			const auto path = QDir::cleanPath(
+				folder + '/' + text.mid(2).replace('*', match));
+			if (Inside(path, folder)) {
+				return path;
+			}
+		} else if (imports
+			&& !text.startsWith('/')
+			&& !text.startsWith(u"../"_q)
+			&& !text.contains(':')) {
+			return package(folder, text.replace('*', match), error);
+		}
+		error = u"'"_q
+			+ name
+			+ u"': "_q
+			+ file
+			+ u" has an invalid target '"_q
+			+ value.toString()
+			+ '\'';
+		return std::nullopt;
+	} else if (value.isArray()) {
+		const auto array = value.toArray();
+		for (auto i = 0; i != int(array.size()); ++i) {
+			auto path = target(
+				folder,
+				array.at(i),
+				match,
+				name,
+				imports,
+				error);
+			if (path) {
+				return path;
+			}
+		}
+		return std::nullopt;
+	} else if (value.isObject()) {
+		const auto object = value.toObject();
+		auto tried = false;
+		for (const auto condition : kConditions) {
+			const auto key = QString::fromLatin1(condition);
+			if (!object.contains(key)) {
+				continue;
+			}
+			tried = true;
+			const auto path = target(
+				folder,
+				object.value(key),
+				match,
+				name,
+				imports,
+				error);
+			if (path) {
+				return path;
+			}
+		}
+		if (!tried) {
+			error = u"'"_q
+				+ name
+				+ u"': "_q
+				+ file
+				+ u" has no condition tele uses (import, module, browser "
+				"or default), only "_q
+				+ object.keys().join(u", "_q);
+		}
+		return std::nullopt;
+	}
+	error = u"'"_q + name + u"' is not exported by "_q + file;
+	return std::nullopt;
+}
+
+std::optional<QJsonObject> ModuleResolver::manifest(
+		const QString &folder,
+		QString &error) {
+	const auto path = folder + u"/package.json"_q;
+	watch(path);
+	auto file = QFile(path);
+	if (!file.exists()) {
+		return QJsonObject();
+	} else if (!file.open(QIODevice::ReadOnly)) {
+		error = u"can't read "_q + shown(path);
+		return std::nullopt;
+	}
+	auto failure = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(file.readAll(), &failure);
+	if (failure.error != QJsonParseError::NoError) {
+		error = shown(path) + u" is not valid json: "_q + failure.errorString();
+		return std::nullopt;
+	} else if (!document.isObject()) {
+		error = shown(path) + u" is not a json object"_q;
+		return std::nullopt;
+	}
+	return document.object();
+}
+
+QString ModuleResolver::shown(const QString &path) const {
+	return Inside(path, _limit) ? QDir(_limit).relativeFilePath(path) : path;
+}
+
+void ModuleResolver::watch(const QString &path) {
+	if (!ranges::contains(_files, path)) {
+		_files.push_back(path);
+	}
+}
+
+[[nodiscard]] bool CommonJs(const QString &path, const QByteArray &code) {
+	if (path.endsWith(u".cjs"_q, Qt::CaseInsensitive)) {
+		return true;
+	} else if (!InModules(path)
+		|| !path.endsWith(u".js"_q, Qt::CaseInsensitive)) {
+		return false;
+	}
+	static const auto esm = QRegularExpression(
+		uR"re((?:^|[;}])\s*(?:import\b\s*[\w{*'"]|export\b\s*[\w{*]))re"_q,
+		QRegularExpression::MultilineOption);
+	static const auto commonjs = QRegularExpression(
+		uR"re(\bmodule\.exports\b|\bexports\.[A-Za-z_$][\w$]*\s*=|\brequire\s*\()re"_q);
+	const auto text = QString::fromUtf8(code);
+	return !esm.match(text).hasMatch() && commonjs.match(text).hasMatch();
+}
+
+[[nodiscard]] bool JsonRequested(
+		JSContext *ctx,
+		const QString &path,
+		JSValueConst attributes) {
+	if (path.endsWith(u".json"_q, Qt::CaseInsensitive)) {
+		return true;
+	} else if (!JS_IsObject(attributes)) {
+		return false;
+	}
+	auto type = JS_GetPropertyStr(ctx, attributes, "type");
+	const auto text = JS_IsString(type) ? JS_ToCString(ctx, type) : nullptr;
+	const auto result = text && !std::strcmp(text, "json");
+	if (text) {
+		JS_FreeCString(ctx, text);
+	}
+	JS_FreeValue(ctx, type);
+	return result;
+}
+
+int InitDefaultExport(JSContext *ctx, JSModuleDef *module) {
+	return JS_SetModuleExport(
+		ctx,
+		module,
+		"default",
+		JS_GetModulePrivateValue(ctx, module));
+}
+
+int InitCommonModule(JSContext *ctx, JSModuleDef *module) {
+	auto body = JS_GetModulePrivateValue(ctx, module);
+	const auto atom = JS_GetModuleName(ctx, module);
+	auto file = JS_AtomToString(ctx, atom);
+	JS_FreeAtom(ctx, atom);
+	auto global = JS_GetGlobalObject(ctx);
+	auto run = JS_GetPropertyStr(ctx, global, "__teleCommonJs");
+	JS_FreeValue(ctx, global);
+	JSValueConst args[] = { body, file };
+	auto exports = JS_Call(ctx, run, JS_UNDEFINED, 2, args);
+	JS_FreeValue(ctx, run);
+	JS_FreeValue(ctx, file);
+	JS_FreeValue(ctx, body);
+	if (JS_IsException(exports)) {
+		return -1;
+	}
+	return JS_SetModuleExport(ctx, module, "default", exports);
+}
+
+[[nodiscard]] JSModuleDef *ValueModule(
+		JSContext *ctx,
+		const char *name,
+		JSValue value,
+		JSModuleInitFunc *init) {
+	if (JS_IsException(value)) {
+		return nullptr;
+	}
+	const auto module = JS_NewCModule(ctx, name, init);
+	if (!module) {
+		JS_FreeValue(ctx, value);
+		return nullptr;
+	}
+	JS_AddModuleExport(ctx, module, "default");
+	JS_SetModulePrivateValue(ctx, module, value);
+	return module;
+}
+
+[[nodiscard]] JSModuleDef *JsonModule(
+		JSContext *ctx,
+		const char *name,
+		const QByteArray &code) {
+	return ValueModule(
+		ctx,
+		name,
+		JS_ParseJSON(ctx, code.constData(), code.size(), name),
+		InitDefaultExport);
+}
+
+[[nodiscard]] JSModuleDef *CommonModule(
+		JSContext *ctx,
+		const char *name,
+		const QByteArray &code) {
+	const auto wrapped = QByteArray(kCommonPrefix) + code + kCommonSuffix;
+	return ValueModule(
+		ctx,
+		name,
+		JS_Eval(
+			ctx,
+			wrapped.constData(),
+			wrapped.size(),
+			name,
+			JS_EVAL_TYPE_GLOBAL),
+		InitCommonModule);
+}
+
+[[nodiscard]] int Base64Digit(char c) {
+	return (c >= 'A' && c <= 'Z') ? (c - 'A')
+		: (c >= 'a' && c <= 'z') ? (c - 'a' + 26)
+		: (c >= '0' && c <= '9') ? (c - '0' + 52)
+		: (c == '+') ? 62
+		: (c == '/') ? 63
+		: -1;
+}
