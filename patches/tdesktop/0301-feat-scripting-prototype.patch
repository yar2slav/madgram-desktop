+JSValue HiddenWordsList(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	auto value = NormalizeHiddenWords(HiddenWords());
+	if (argc > 0 && !JS_IsNull(argv[0]) && !JS_IsUndefined(argv[0])) {
+		const auto id = PeerOf(ctx, argv[0]);
+		const auto peer = id
+			? instance->session()->data().peerLoaded(*id)
+			: nullptr;
+		if (!peer) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.tele.hiddenWords.list needs a chat in tele's cache");
+		}
+		value = ChatHiddenWords(peer);
+	}
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	for (const auto &line : RuleLines(value)) {
+		JS_SetPropertyUint32(ctx, result, index++, NewString(ctx, line));
+	}
+	return result;
+}
+
+JSValue HiddenWordsChange(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto add = (argc > 2) && JS_ToBool(ctx, argv[2]) > 0;
+	const auto what = add
+		? "tg.tele.hiddenWords.add"
+		: "tg.tele.hiddenWords.remove";
+	const auto instance = Permitted(ctx, Capability::Options, {}, what);
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 2 || !JS_IsString(argv[1])) {
+		return JS_ThrowTypeError(ctx, "%s(rule, chat?): rule is a string", what);
+	}
+	const auto rule = FromStd(ToStd(ctx, argv[1])).trimmed();
+	if (rule.isEmpty()
+		|| rule.contains(QChar('\n'))
+		|| NormalizeHiddenWords(rule) != rule) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: a rule is one line of text or a valid /regex/",
+			what);
+	}
+	auto peer = (PeerData*)nullptr;
+	if (!JS_IsNull(argv[0]) && !JS_IsUndefined(argv[0])) {
+		const auto id = PeerOf(ctx, argv[0]);
+		peer = id ? instance->session()->data().peerLoaded(*id) : nullptr;
+		if (!peer) {
+			return JS_ThrowTypeError(ctx, "%s needs a chat in tele's cache", what);
+		}
+	}
+	auto lines = RuleLines(peer
+		? ChatHiddenWords(peer)
+		: NormalizeHiddenWords(HiddenWords()));
+	if (add) {
+		if (lines.contains(rule)) {
+			return JS_FALSE;
+		}
+		lines.push_back(rule);
+	} else if (!lines.removeOne(rule)) {
+		return JS_FALSE;
+	}
+	const auto value = lines.join(QChar('\n'));
+	if (peer) {
+		SetChatHiddenWords(peer, value);
+	} else {
+		SetHiddenWords(value);
+	}
+	return JS_TRUE;
+}
+
+JSValue EditHistoryOf(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"messages",
+		"tg.tele.editHistory");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto msgId = MsgIdAt(ctx, argc, argv, 1);
+	if (!peerId || !msgId) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.editHistory needs a chat and a message id");
+	}
+	auto result = JS_NewArray(ctx);
+	const auto item = instance->session()->data().message(
+		FullMsgId(*peerId, *msgId));
+	if (!item) {
+		return result;
+	}
+	auto index = uint32_t();
+	for (const auto &version : EditVersions(item)) {
+		auto raw = DecodeMessage(
+			ctx,
+			instance,
+			Synthesized(
+				item,
+				version.item->originalText(),
+				version.original ? TimeId() : version.date));
+		if (JS_IsNull(raw)) {
+			continue;
+		}
+		auto entry = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, entry, "date", JS_NewInt64(ctx, version.date));
+		JS_SetPropertyStr(
+			ctx,
+			entry,
+			"original",
+			JS_NewBool(ctx, version.original));
+		JS_SetPropertyStr(
+			ctx,
+			entry,
+			"current",
+			JS_NewBool(ctx, version.current));
+		JS_SetPropertyStr(ctx, entry, "raw", raw);
+		JS_SetPropertyUint32(ctx, result, index++, entry);
+	}
+	return result;
+}
