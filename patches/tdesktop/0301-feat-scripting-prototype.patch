+[[nodiscard]] QString ArrayString(
+		JSContext *ctx,
+		JSValueConst array,
+		int index) {
+	auto item = JS_GetPropertyUint32(ctx, array, std::uint32_t(index));
+	auto result = JS_IsString(item) ? FromStd(ToStd(ctx, item)) : QString();
+	JS_FreeValue(ctx, item);
+	return result;
+}
+
+[[nodiscard]] int ArrayLength(JSContext *ctx, JSValueConst array) {
+	auto value = JS_GetPropertyStr(ctx, array, "length");
+	auto result = std::int64_t();
+	if (JS_ToInt64(ctx, &result, value)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		result = 0;
+	}
+	JS_FreeValue(ctx, value);
+	return int(std::clamp(result, std::int64_t(0), std::int64_t(1 << 20)));
+}
+
+[[nodiscard]] std::optional<std::vector<AttachedFile>> FilesFrom(
+		JSContext *ctx,
+		JSValueConst value) {
+	if (!JS_IsArray(value)) {
+		return std::nullopt;
+	}
+	const auto length = ArrayLength(ctx, value);
+	if (length < 1 || length > kMaxFiles) {
+		return std::nullopt;
+	}
+	auto result = std::vector<AttachedFile>();
+	result.reserve(length);
+	for (auto i = 0; i != length; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, value, std::uint32_t(i));
+		if (!JS_IsObject(item)) {
+			JS_FreeValue(ctx, item);
+			return std::nullopt;
+		}
+		auto name = StringProperty(ctx, item, "name");
+		auto bytes = JS_GetPropertyStr(ctx, item, "bytes");
+		auto content = BytesFrom(ctx, bytes);
+		JS_FreeValue(ctx, bytes);
+		JS_FreeValue(ctx, item);
+		if (name.isEmpty() || !content || content->isEmpty()) {
+			return std::nullopt;
+		}
+		result.push_back({
+			.name = std::move(name),
+			.bytes = std::move(*content),
+		});
+	}
+	return result;
+}
+
+void FinishAnswer(int callId, PasteVerdict verdict) {
+	auto &answers = Answers();
+	const auto i = answers.find(callId);
+	if (i == end(answers)) {
+		return;
+	}
+	const auto done = std::move(i->second.done);
+	answers.erase(i);
+	if (done) {
+		done(std::move(verdict));
+	}
+}
+
+void Forget(not_null<Instance*> instance) {
+	auto &banners = Banners();
+	const auto before = banners.size();
+	banners.erase(
+		ranges::remove(banners, instance, &Banner::owner),
+		end(banners));
+	if (banners.size() != before) {
+		BannerChanges().fire({});
+	}
+	auto &listeners = Listeners();
+	for (auto i = begin(listeners); i != end(listeners);) {
+		if (i->second->owner == instance) {
+			i = listeners.erase(i);
+		} else {
+			++i;
+		}
+	}
+	auto &interceptors = Interceptors();
+	interceptors.erase(
+		ranges::remove(interceptors, instance, &Interceptor::owner),
+		end(interceptors));
+	auto pending = std::vector<int>();
+	for (const auto &[id, answer] : Answers()) {
+		if (answer.owner == instance) {
+			pending.push_back(id);
+		}
+	}
+	if (!pending.empty()) {
+		crl::on_main([=] {
+			for (const auto id : pending) {
+				FinishAnswer(id, PasteVerdict());
+			}
+		});
+	}
+}
+
+void Track(not_null<Instance*> instance) {
+	if (!Tracked().emplace(instance).second) {
+		return;
+	}
+	ScriptLifetime(instance).add([=] {
+		Tracked().remove(instance);
+		Forget(instance);
+	});
+}
+
+[[nodiscard]] not_null<Listener*> AddListener(
+		int id,
+		not_null<Instance*> instance,
+		JSValueConst fn,
+		ListenerKind kind) {
+	Track(instance);
+	auto &slot = Listeners()[id];
+	slot = std::make_unique<Listener>(Listener{
+		.owner = instance,
+		.instance = base::make_weak(instance.get()),
+		.kept = KeepFunction(instance, fn),
+		.kind = kind,
+	});
+	return slot.get();
+}
+
+void Later(int id, Fn<void(not_null<Listener*>)> callback) {
+	crl::on_main([=] {
+		const auto &listeners = Listeners();
+		const auto i = listeners.find(id);
+		if (i != end(listeners)) {
+			callback(i->second.get());
+		}
+	});
+}
+
+[[nodiscard]] bool HasComposeListeners() {
+	return ranges::any_of(Listeners(), [](const auto &pair) {
+		return (pair.second->kind == ListenerKind::Compose);
+	});
+}
