+void Instance::forget(int id) {
+	const auto i = _registrations.find(id);
+	if (i != end(_registrations)) {
+		auto registration = std::move(i->second);
+		_registrations.erase(i);
+		release(registration);
+	}
+}
+
+JSValue Instance::Dispose(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_registrations.find(magic);
+	if (i != end(instance->_registrations)) {
+		auto registration = std::move(i->second);
+		instance->_registrations.erase(i);
+		if (registration.kind == Kind::Decorator) {
+			RemoveMessageDecorations(instance, magic);
+		} else if (registration.kind == Kind::Shortcut) {
+			instance->_shortcuts.erase(magic);
+		} else if (registration.kind == Kind::Button) {
+			UnregisterScriptButton(instance, QString::number(magic));
+		} else if (registration.kind == Kind::MenuItem
+			|| registration.kind == Kind::SettingsEntry
+			|| registration.kind == Kind::QuickAction) {
+			instance->syncSurfaces();
+		} else if (registration.kind == Kind::WidgetObserve) {
+			instance->_widgetObservers.erase(magic);
+		} else if (registration.kind == Kind::WidgetChange) {
+			RemoveWidgetChange(instance, magic);
+		} else if (registration.kind == Kind::Colors) {
+			const auto owner = instance->_colorOwners.find(magic);
+			if (owner != end(instance->_colorOwners)) {
+				RemoveScriptColors(owner->second.get());
+				instance->_colorOwners.erase(owner);
+			}
+		}
+		instance->release(registration);
+	}
+	return JS_UNDEFINED;
+}
