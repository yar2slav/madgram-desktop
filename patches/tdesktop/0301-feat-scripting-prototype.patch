+[[nodiscard]] JSValue GroupValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session) {
+	const auto call = CurrentCall(session);
+	if (!call) {
+		return JS_NULL;
+	}
+	const auto real = call->lookupReal();
+	const auto state = call->state();
+	const auto mute = call->muted();
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "peer", PeerValue(ctx, call->peer()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"title",
+		NewString(ctx, real ? real->title() : QString()));
+	JS_SetPropertyStr(ctx, result, "state", NewString(ctx, StateName(state)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"joined",
+		JS_NewBool(ctx, state == Calls::GroupCall::State::Joined));
+	JS_SetPropertyStr(ctx, result, "joinAs", PeerValue(ctx, call->joinAs()));
+	JS_SetPropertyStr(ctx, result, "mute", NewString(ctx, MuteName(mute)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"muted",
+		JS_NewBool(
+			ctx,
+			(mute != Calls::MuteState::Active)
+				&& (mute != Calls::MuteState::PushToTalk)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"mutedByAdmin",
+		JS_NewBool(ctx, call->mutedByAdmin()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"raisedHand",
+		JS_NewBool(ctx, mute == Calls::MuteState::RaisedHand));
+	JS_SetPropertyStr(ctx, result, "stream", JS_NewBool(ctx, call->rtmp()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"count",
+		JS_NewInt32(ctx, real ? real->fullCount() : 0));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"recording",
+		JS_NewBool(ctx, real && (real->recordStartDate() != 0)));
+	const auto scheduled = call->scheduleDate();
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"scheduled",
+		scheduled ? JS_NewInt64(ctx, scheduled) : JS_NULL);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"participants",
+		ParticipantsValue(ctx, session, CurrentParticipants(call)));
+	return result;
+}
+
+[[nodiscard]] Snapshot TakeSnapshot(not_null<Main::Session*> session) {
+	auto result = Snapshot();
+	const auto call = CurrentCall(session);
+	if (!call) {
+		return result;
+	}
+	const auto real = call->lookupReal();
+	result.present = true;
+	result.peer = call->peer()->id;
+	result.joinAs = call->joinAs()->id;
+	result.title = real ? real->title() : QString();
+	result.state = int(call->state());
+	result.mute = int(call->muted());
+	result.recording = real && (real->recordStartDate() != 0);
+	result.scheduled = call->scheduleDate();
+	result.count = real ? real->fullCount() : 0;
+	result.participants = CurrentParticipants(call);
+	ranges::sort(result.participants, [](
+			const ParticipantState &a,
+			const ParticipantState &b) {
+		return a.peer < b.peer;
+	});
+	return result;
+}
+
+[[nodiscard]] std::vector<Change> Changes(
+		const Snapshot &was,
+		const Snapshot &now) {
+	const auto state = (was.present != now.present)
+		|| (was.peer != now.peer)
+		|| (was.joinAs != now.joinAs)
+		|| (was.title != now.title)
+		|| (was.state != now.state)
+		|| (was.mute != now.mute)
+		|| (was.recording != now.recording)
+		|| (was.scheduled != now.scheduled);
+	auto participants = (was.count != now.count);
+	auto hands = false;
+	auto speaking = false;
+	const auto &a = was.participants;
+	const auto &b = now.participants;
+	auto i = std::size_t();
+	auto j = std::size_t();
+	while (i < a.size() || j < b.size()) {
+		if (j == b.size() || (i < a.size() && a[i].peer < b[j].peer)) {
+			participants = true;
+			hands = hands || a[i].raisedHand;
+			++i;
+		} else if (i == a.size() || b[j].peer < a[i].peer) {
+			participants = true;
+			hands = hands || b[j].raisedHand;
+			++j;
+		} else {
+			participants = participants
+				|| (a[i].muted != b[j].muted)
+				|| (a[i].mutedByAdmin != b[j].mutedByAdmin)
+				|| (a[i].video != b[j].video)
+				|| (a[i].screen != b[j].screen)
+				|| (a[i].self != b[j].self);
+			hands = hands || (a[i].raisedHand != b[j].raisedHand);
+			speaking = speaking || (a[i].speaking != b[j].speaking);
+			++i;
+			++j;
+		}
+	}
+	auto result = std::vector<Change>();
+	if (state) {
+		result.push_back(Change::State);
+	}
+	if (participants) {
+		result.push_back(Change::Participants);
+	}
+	if (hands) {
+		result.push_back(Change::RaisedHand);
+	}
+	if (speaking) {
+		result.push_back(Change::Speaking);
+	}
+	return result;
+}
+
+[[nodiscard]] JSValue ChangeValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		const std::vector<Change> &changes) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "call", GroupValue(ctx, session));
+	auto list = JS_NewArray(ctx);
+	auto index = std::uint32_t();
+	for (const auto change : changes) {
+		JS_SetPropertyUint32(
+			ctx,
+			list,
+			index++,
+			JS_NewString(ctx, ChangeName(change)));
+	}
+	JS_SetPropertyStr(ctx, result, "changes", list);
+	return result;
+}
+
+[[nodiscard]] rpl::producer<> CallChanges(not_null<Calls::GroupCall*> call) {
+	auto real = call->real(
+	) | rpl::map([](not_null<Data::GroupCall*> real) {
+		return rpl::merge(
+			real->participantUpdated() | rpl::to_empty,
+			real->participantsReloaded(),
+			real->titleValue() | rpl::to_empty,
+			real->recordStartDateValue() | rpl::to_empty,
+			real->scheduleDateValue() | rpl::to_empty,
+			real->fullCountValue() | rpl::to_empty);
+	}) | rpl::flatten_latest();
+	return rpl::merge(
+		call->stateValue() | rpl::to_empty,
+		call->mutedValue() | rpl::to_empty,
+		call->joinAsValue() | rpl::to_empty,
+		call->titleChanged(),
+		std::move(real));
+}
+
+void Fire(not_null<Instance*> instance) {
+	const auto i = AllWatchers().find(instance);
+	if (i == end(AllWatchers())) {
+		return;
+	}
+	const auto watcher = i->second.get();
+	if (watcher->callbacks.empty()) {
+		return;
+	}
+	const auto session = ScriptSession(instance);
+	auto now = TakeSnapshot(session);
+	const auto changes = Changes(watcher->last, now);
+	if (changes.empty()) {
+		return;
+	}
+	const auto when = crl::now();
+	const auto speaking = ranges::contains(changes, Change::Speaking);
+	if (speaking
+		&& (changes.size() == 1)
+		&& (when - watcher->lastSpeaking < kSpeakingInterval)) {
+		watcher->timer.callOnce(
+			kSpeakingInterval - (when - watcher->lastSpeaking));
+		return;
+	}
+	if (speaking) {
+		watcher->lastSpeaking = when;
+	}
+	watcher->last = std::move(now);
+	const auto ids = std::vector<int>(
+		watcher->callbacks.begin(),
+		watcher->callbacks.end());
+	const auto weak = base::make_weak(instance.get());
+	for (const auto id : ids) {
+		CallKept(weak, id, [=](JSContext *ctx) {
+			return ChangeValue(ctx, session, changes);
+		}, u"calls.onGroupChange"_q);
+	}
+}
+
+[[nodiscard]] not_null<Watcher*> EnsureWatcher(not_null<Instance*> instance) {
+	auto &watchers = AllWatchers();
+	if (const auto i = watchers.find(instance); i != end(watchers)) {
+		return i->second.get();
+	}
+	auto owned = std::make_unique<Watcher>([=] { Fire(instance); });
+	const auto watcher = owned.get();
+	watcher->last = TakeSnapshot(ScriptSession(instance));
+	Core::App().calls().currentGroupCallValue(
+	) | rpl::map([](Calls::GroupCall *call) -> rpl::producer<> {
+		if (!call) {
+			return rpl::single(rpl::empty);
+		}
+		return CallChanges(call);
+	}) | rpl::flatten_latest(
+	) | rpl::on_next([=] {
+		if (!watcher->timer.isActive()
+			|| watcher->timer.remainingTime() > kDebounce) {
+			watcher->timer.callOnce(kDebounce);
+		}
+	}, watcher->lifetime);
+	watchers.emplace(instance, std::move(owned));
+	ScriptLifetime(instance).add([=] {
+		AllWatchers().remove(instance);
+	});
+	return watcher;
+}
+
+void ApplyMuted(not_null<Calls::GroupCall*> call, bool muted) {
+	using Calls::MuteState;
+	const auto now = call->muted();
+	if (muted) {
+		if (now == MuteState::Active || now == MuteState::PushToTalk) {
+			call->setMutedAndUpdate(MuteState::Muted);
+		}
+	} else if (now == MuteState::Muted || now == MuteState::PushToTalk) {
+		call->setMutedAndUpdate(MuteState::Active);
+	}
+}
