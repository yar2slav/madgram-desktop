+.v-label {
+	color: var(--accent);
+	font-weight: 600;
+}
+.v-fn {
+	font-style: italic;
+}
+.v-fn-mark {
+	color: var(--syntax-bool);
+}
+.v-error {
+	color: var(--attention);
+}
+.v-symbol,
+.v-regexp {
+	color: var(--syntax-number);
+}
+.v-date {
+	color: var(--syntax-invisible);
+}
