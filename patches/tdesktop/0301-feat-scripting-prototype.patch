+		"<repl>",
+		JS_EVAL_TYPE_GLOBAL | JS_EVAL_FLAG_ASYNC);
+	leave();
+	return result;
+}
+
+std::optional<QByteArray> Engine::source(const QString &path) {
+	if (!ranges::contains(_files, path)) {
+		_files.push_back(path);
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		_lastError = u"can't read "_q + path;
+		return std::nullopt;
+	}
+	const auto code = file.readAll();
+	if (!path.endsWith(u".ts"_q, Qt::CaseInsensitive)
+		&& !path.endsWith(u".mts"_q, Qt::CaseInsensitive)) {
+		return code;
+	}
+	if (!_stripper) {
+		_stripper = StripWorker::Shared();
+	}
+	auto error = QString();
+	auto result = _stripper->strip(code, path, error);
+	if (!result) {
+		_lastError = QFileInfo(path).fileName() + u": "_q + error;
+		return std::nullopt;
+	}
+	_sourceLines[path] = ParseSourceMap(result->code, result->map);
+	return std::move(result->code);
+}
+
+Engine::SourceLines Engine::ParseSourceMap(
+		const QByteArray &code,
+		const QByteArray &map) {
+	auto result = SourceLines();
+	auto segments = std::vector<SourceSegment>();
+	auto fields = std::array<int, 5>();
+	auto field = 0;
+	auto value = 0;
+	auto shift = 0;
+	auto generated = 0;
+	auto originalLine = 0;
+	auto originalColumn = 0;
+	auto start = 0;
+	const auto segment = [&] {
+		if (field > 0) {
+			generated += fields[0];
+		}
+		if (field > 3) {
+			originalLine += fields[2];
+			originalColumn += fields[3];
+			if (originalLine == int(result.size())) {
+				segments.push_back({
+					.generated = generated,
+					.original = originalColumn,
+				});
+			}
+		}
+		field = 0;
+	};
+	const auto line = [&] {
+		segment();
+		const auto newline = int(code.indexOf('\n', start));
+		const auto till = (newline < 0) ? int(code.size()) : newline;
+		ranges::sort(segments, ranges::less(), &SourceSegment::generated);
+		auto units = 0;
+		auto bytes = start;
+		for (auto &entry : segments) {
+			while (units < entry.generated && bytes < till) {
+				const auto c = static_cast<unsigned char>(code[bytes]);
+				const auto length = (c < 0xC0) ? 1
+					: (c < 0xE0) ? 2
+					: (c < 0xF0) ? 3
+					: 4;
+				units += (length == 4) ? 2 : 1;
+				bytes += length;
+			}
+			entry.generated = bytes - start;
+		}
+		result.push_back(base::take(segments));
+		generated = 0;
+		start = (newline < 0) ? int(code.size()) : (newline + 1);
+	};
+	for (const auto c : map) {
+		if (c == ',') {
+			segment();
+			continue;
+		} else if (c == ';') {
+			line();
+			continue;
+		}
+		const auto digit = Base64Digit(c);
+		if (digit < 0 || shift > 25) {
+			return SourceLines();
+		}
+		value += (digit & 31) << shift;
+		if (digit & 32) {
+			shift += 5;
+			continue;
+		}
+		if (field < int(fields.size())) {
+			fields[field++] = (value & 1) ? -(value >> 1) : (value >> 1);
+		}
+		value = 0;
+		shift = 0;
+	}
+	line();
+	return result;
+}
+
+JSValue Engine::MapColumn(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto engine = EngineOf(ctx);
+	if (argc < 3 || !engine || !JS_IsString(argv[0])) {
+		return (argc > 2) ? JS_DupValue(ctx, argv[2]) : JS_UNDEFINED;
+	}
+	auto line = int32_t();
+	auto column = int32_t();
+	if (JS_ToInt32(ctx, &line, argv[1]) < 0
+		|| JS_ToInt32(ctx, &column, argv[2]) < 0) {
+		return JS_EXCEPTION;
+	}
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(ctx, &size, argv[0]);
+	if (!text) {
+		return JS_EXCEPTION;
+	}
+	const auto file = QString::fromUtf8(text, int(size));
+	JS_FreeCString(ctx, text);
+	const auto i = engine->_sourceLines.find(file);
+	if (i == end(engine->_sourceLines)
+		|| line < 1
+		|| column < 1
+		|| line > int(i->second.size())) {
+		return JS_NewInt32(ctx, column);
+	}
+	const auto &segments = i->second[line - 1];
+	const auto offset = column - 1;
+	const auto j = std::upper_bound(
+		begin(segments),
+		end(segments),
+		offset,
+		[](int value, const SourceSegment &segment) {
+			return value < segment.generated;
+		});
+	if (j == begin(segments)) {
+		return JS_NewInt32(ctx, column);
+	}
+	const auto &found = *(j - 1);
+	return JS_NewInt32(ctx, found.original + (offset - found.generated) + 1);
+}
+
+int Engine::CheckAttributes(
+		JSContext *ctx,
+		void *opaque,
+		JSValueConst attributes) {
+	if (!JS_IsObject(attributes)) {
+		return 0;
+	}
+	auto properties = (JSPropertyEnum*)nullptr;
+	auto count = uint32_t();
+	if (JS_GetOwnPropertyNames(
+			ctx,
+			&properties,
+			&count,
+			attributes,
+			JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY) < 0) {
+		return -1;
+	}
+	auto result = 0;
+	for (auto i = uint32_t(); i != count && !result; ++i) {
+		const auto key = JS_AtomToCString(ctx, properties[i].atom);
+		auto value = JS_GetProperty(ctx, attributes, properties[i].atom);
+		const auto text = JS_IsString(value)
+			? JS_ToCString(ctx, value)
+			: nullptr;
+		if (!key || std::strcmp(key, "type")) {
+			JS_ThrowTypeError(
+				ctx,
+				"the import attribute '%s' isn't supported, only type: 'json'",
+				key ? key : "?");
+			result = -1;
+		} else if (!text || std::strcmp(text, "json")) {
+			JS_ThrowTypeError(
+				ctx,
+				"import type '%s' isn't supported, only type: 'json'",
+				text ? text : "?");
+			result = -1;
+		}
+		if (text) {
+			JS_FreeCString(ctx, text);
+		}
+		if (key) {
+			JS_FreeCString(ctx, key);
+		}
+		JS_FreeValue(ctx, value);
+	}
+	JS_FreePropertyEnum(ctx, properties, count);
+	return result;
+}
+
+char *Engine::Normalize(
+		JSContext *ctx,
+		const char *base,
+		const char *name,
+		void *opaque) {
+	const auto engine = static_cast<Engine*>(opaque);
+	const auto result = engine->resolve(
+		QString::fromUtf8(base),
+		QString::fromUtf8(name));
+	if (!result) {
+		JS_ThrowReferenceError(
+			ctx,
+			"%s",
+			engine->_lastError.toUtf8().constData());
+		return nullptr;
+	}
+	return js_strdup(ctx, result->toUtf8().constData());
+}
+
+int Engine::InitTeleModule(JSContext *ctx, JSModuleDef *module) {
+	auto global = JS_GetGlobalObject(ctx);
+	for (const auto &[name, hidden] : kModuleExports) {
+		if (JS_SetModuleExport(
+				ctx,
+				module,
+				name,
+				JS_GetPropertyStr(ctx, global, hidden)) < 0) {
+			JS_FreeValue(ctx, global);
+			return -1;
+		}
+	}
+	JS_FreeValue(ctx, global);
+	return JS_SetModuleExport(
+		ctx,
+		module,
+		"defineScript",
+		JS_NewCFunction(ctx, DefineScript, "defineScript", 1));
+}
+
+JSModuleDef *Engine::Load(
+		JSContext *ctx,
+		const char *name,
+		void *opaque,
+		JSValueConst attributes) {
+	const auto engine = static_cast<Engine*>(opaque);
+	if (!std::strcmp(name, "tele")) {
+		const auto module = JS_NewCModule(ctx, "tele", InitTeleModule);
+		if (module) {
+			JS_AddModuleExport(ctx, module, "defineScript");
+			for (const auto &[name, hidden] : kModuleExports) {
+				JS_AddModuleExport(ctx, module, name);
+			}
+		}
+		return module;
+	}
+	const auto path = QString::fromUtf8(name);
+	const auto code = engine->source(path);
+	if (!code) {
+		JS_ThrowSyntaxError(
+			ctx,
+			"%s",
+			engine->_lastError.toUtf8().constData());
+		return nullptr;
+	} else if (JsonRequested(ctx, path, attributes)) {
+		return JsonModule(ctx, name, *code);
+	} else if (CommonJs(path, *code)) {
+		return CommonModule(ctx, name, *code);
+	}
+	auto compiled = JS_Eval(
+		ctx,
+		code->constData(),
+		code->size(),
+		name,
+		JS_EVAL_TYPE_MODULE | JS_EVAL_FLAG_COMPILE_ONLY);
+	if (JS_IsException(compiled)) {
+		return nullptr;
+	}
+	const auto module = static_cast<JSModuleDef*>(
+		JS_VALUE_GET_PTR(compiled));
+	JS_FreeValue(ctx, compiled);
+	return module;
+}
+
+JSValue Engine::load(QString &error) {
+	const auto code = source(_entry);
+	if (!code) {
+		error = _lastError;
+		return JS_UNDEFINED;
+	}
+	const auto name = _entry.toUtf8();
+	enter(kLoadBudget);
+	auto compiled = JS_Eval(
+		_ctx,
+		code->constData(),
+		code->size(),
+		name.constData(),
+		JS_EVAL_TYPE_MODULE | JS_EVAL_FLAG_COMPILE_ONLY);
+	if (JS_IsException(compiled)) {
+		leave();
+		report(u"loading"_q);
+		error = _lastError;
+		return JS_UNDEFINED;
+	}
+	const auto module = static_cast<JSModuleDef*>(
+		JS_VALUE_GET_PTR(compiled));
+	if (JS_ResolveModule(_ctx, compiled) < 0) {
+		JS_FreeValue(_ctx, compiled);
+		leave();
+		report(u"loading"_q);
+		error = _lastError;
+		return JS_UNDEFINED;
+	}
+	auto promise = JS_EvalFunction(_ctx, compiled);
+	leave();
+	if (JS_IsException(promise)) {
+		report(u"running"_q);
+		error = _lastError;
+		return JS_UNDEFINED;
+	}
+	drain();
+	if (JS_IsPromise(promise)) {
+		const auto state = JS_PromiseState(_ctx, promise);
+		if (state == JS_PROMISE_REJECTED) {
+			auto reason = JS_PromiseResult(_ctx, promise);
+			_lastError = describe(reason);
+			JS_FreeValue(_ctx, reason);
+			JS_FreeValue(_ctx, promise);
+			error = _lastError;
+			return JS_UNDEFINED;
+		} else if (state == JS_PROMISE_PENDING) {
+			JS_FreeValue(_ctx, promise);
+			error = u"top-level await never finished"_q;
+			return JS_UNDEFINED;
+		}
+	}
+	JS_FreeValue(_ctx, promise);
+	auto space = JS_GetModuleNamespace(_ctx, module);
+	auto result = JS_GetPropertyStr(_ctx, space, "default");
+	JS_FreeValue(_ctx, space);
+	return result;
+}
+
+JSValue Engine::Console(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto engine = EngineOf(ctx);
+	auto global = JS_GetGlobalObject(ctx);
+	auto format = JS_GetPropertyStr(ctx, global, "__teleFormat");
+	JS_FreeValue(ctx, global);
+	auto result = JS_Call(ctx, format, JS_UNDEFINED, argc, argv);
+	JS_FreeValue(ctx, format);
+	if (JS_IsException(result)) {
+		return result;
+	}
+	auto size = std::size_t();
+	const auto text = JS_ToCStringLen(ctx, &size, result);
+	auto line = text ? QString::fromUtf8(text, int(size)) : QString();
+	if (text) {
+		JS_FreeCString(ctx, text);
+	}
+	JS_FreeValue(ctx, result);
+	auto values = QByteArray();
+	const auto structured = ranges::any_of(
+		std::span<JSValueConst>(argv, argc),
+		[](JSValueConst value) { return JS_IsObject(value); });
+	if (structured) {
+		auto global = JS_GetGlobalObject(ctx);
+		auto function = JS_GetPropertyStr(ctx, global, "__teleValues");
+		JS_FreeValue(ctx, global);
+		auto json = JS_Call(ctx, function, JS_UNDEFINED, argc, argv);
+		JS_FreeValue(ctx, function);
+		if (JS_IsException(json)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+		} else if (const auto data = JS_ToCStringLen(ctx, &size, json)) {
+			values = QByteArray(data, int(size));
+			JS_FreeCString(ctx, data);
+		}
+		JS_FreeValue(ctx, json);
+	}
+	engine->log(LogLevel(magic), std::move(line), std::move(values));
+	return JS_UNDEFINED;
+}
+
+JSValue Engine::SetTimer(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "a timer needs a function");
+	}
+	auto delay = 0.;
+	if (argc > 1 && JS_ToFloat64(ctx, &delay, argv[1]) < 0) {
+		return JS_EXCEPTION;
+	}
+	const auto engine = EngineOf(ctx);
+	const auto repeat = (magic == 1);
+	const auto id = ++engine->_timerId;
+	auto &timer = engine->_timers[id];
+	timer.function = JS_DupValue(ctx, argv[0]);
+	timer.repeat = repeat;
+	timer.timer = std::make_unique<base::Timer>([=] { engine->fire(id); });
+	const auto ms = std::max(
+		crl::time(delay > 0 ? delay : 0),
+		repeat ? kMinInterval : crl::time(0));
+	if (repeat) {
+		timer.timer->callEach(ms);
+	} else {
+		timer.timer->callOnce(ms);
+	}
+	return JS_NewInt32(ctx, id);
+}
+
+JSValue Engine::ClearTimer(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	auto id = 0;
+	if (argc < 1 || JS_ToInt32(ctx, &id, argv[0]) < 0) {
+		return JS_UNDEFINED;
+	}
+	const auto engine = EngineOf(ctx);
+	const auto i = engine->_timers.find(id);
+	if (i != end(engine->_timers)) {
+		auto function = i->second.function;
+		engine->_timers.erase(i);
+		JS_FreeValue(ctx, function);
+	}
+	return JS_UNDEFINED;
+}
+
+void Engine::fire(int id) {
+	const auto i = _timers.find(id);
+	if (i == end(_timers)) {
+		return;
+	}
+	auto function = JS_DupValue(_ctx, i->second.function);
+	if (!i->second.repeat) {
+		auto released = i->second.function;
+		_timers.erase(i);
+		JS_FreeValue(_ctx, released);
+	}
+	auto result = call(
+		function,
+		JS_UNDEFINED,
+		{},
+		kTimerBudget,
+		u"a timer"_q);
+	JS_FreeValue(_ctx, result);
+	JS_FreeValue(_ctx, function);
+	drain();
+}
+
+JSValue Engine::DefineScript(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "defineScript needs an object");
+	}
+	auto setup = JS_GetPropertyStr(ctx, argv[0], "setup");
+	const auto callable = JS_IsFunction(ctx, setup);
+	JS_FreeValue(ctx, setup);
+	if (!callable) {
+		return JS_ThrowTypeError(ctx, "defineScript needs a setup function");
+	}
+	auto name = JS_GetPropertyStr(ctx, argv[0], "name");
+	const auto named = JS_IsString(name);
+	JS_FreeValue(ctx, name);
+	if (!named) {
+		return JS_ThrowTypeError(ctx, "defineScript needs a name");
+	}
+	return JS_DupValue(ctx, argv[0]);
+}
+
+} // namespace Tele::Scripting
