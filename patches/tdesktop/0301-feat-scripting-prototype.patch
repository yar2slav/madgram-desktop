@@ -0,0 +1,34 @@
+(() => {
+	const modes = ['compact', 'fullsize', 'fullscreen'];
+	globalThis.__teleExtensions.push({
+		name: 'miniapps',
+		tg(tg, natives, { resolvePeer }) {
+			Object.assign(tg.ui, {
+				async openWebApp(bot, options = {}) {
+					if (options === null || typeof options !== 'object') {
+						throw new TypeError('tg.ui.openWebApp(bot, { url?, startParam?, mode? })');
+					}
+					const { url = '', startParam = '', mode = '' } = options;
+					if (typeof url !== 'string') {
+						throw new TypeError('tg.ui.openWebApp: url must be a string');
+					} else if (typeof startParam !== 'string' || !/^[A-Za-z0-9_-]{0,512}$/.test(startParam)) {
+						throw new TypeError('tg.ui.openWebApp: startParam is up to 512 of A-Z, a-z, 0-9, _ and -');
+					} else if (mode !== '' && !modes.includes(mode)) {
+						throw new TypeError(`tg.ui.openWebApp: mode is 'compact', 'fullsize' or 'fullscreen', not '${String(mode)}'`);
+					}
+					await natives.miniAppsOpen(await resolvePeer(bot), { url, startParam, mode });
+				},
+				webApps() {
+					return natives.miniAppsList();
+				},
+				onWebAppEvent(callback) {
+					if (typeof callback !== 'function') {
+						throw new TypeError('tg.ui.onWebAppEvent(function)');
+					}
+					const id = natives.miniAppsListen(callback);
+					return __teleDisposer(() => natives.miniAppsUnlisten(id));
+				},
+			});
+		},
+	});
+})();
diff --git a/Telegram/Resources/tele/scripting/panels.js b/Telegram/Resources/tele/scripting/panels.js
new file mode 100644
