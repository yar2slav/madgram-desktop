+#pragma once
+
+#include "base/timer.h"
+
+#include <map>
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace Tele::Scripting {
+
+class ScriptStorage final {
+public:
+	explicit ScriptStorage(Fn<void()> changed);
+
+	[[nodiscard]] const QByteArray *find(const QString &key) const;
+	[[nodiscard]] bool set(const QString &key, QByteArray value);
+	bool remove(const QString &key);
+	void clear();
+	[[nodiscard]] QStringList keys() const;
+	[[nodiscard]] qint64 size() const;
+	[[nodiscard]] const std::map<QString, QByteArray> &values() const;
+	void load(std::map<QString, QByteArray> values);
+
+private:
+	[[nodiscard]] static qint64 SizeOf(
+		const QString &key,
+		const QByteArray &value);
+
+	const Fn<void()> _changed;
+	std::map<QString, QByteArray> _values;
+	qint64 _size = 0;
+
+};
+
+class StorageStore final {
+public:
+	explicit StorageStore(not_null<Main::Session*> session);
+	~StorageStore();
+
+	[[nodiscard]] not_null<ScriptStorage*> storage(const QString &id);
+
+private:
+	[[nodiscard]] QString directory() const;
+	void read();
+	void write();
+
+	const not_null<Main::Session*> _session;
+	std::map<QString, ScriptStorage> _scripts;
+	base::Timer _saveTimer;
+	bool _dirty = false;
+
+};
+
+inline constexpr auto kStorageQuota = qint64(16 * 1024 * 1024);
+
+} // namespace Tele::Scripting
