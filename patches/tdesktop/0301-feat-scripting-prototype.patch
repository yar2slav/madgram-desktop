+JSValue DeletedList(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"messages",
+		"tg.tele.deleted.list");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->session();
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto peer = peerId ? session->data().peerLoaded(*peerId) : nullptr;
+	if (!peer) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.deleted.list needs a chat in tele's cache");
+	}
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	const auto history = session->data().history(peer);
+	for (const auto &item : KeptDeletedItems(history)) {
+		auto raw = KeptRaw(ctx, instance, item);
+		if (!JS_IsNull(raw)) {
+			JS_SetPropertyUint32(ctx, result, index++, raw);
+		}
+	}
+	return result;
+}
