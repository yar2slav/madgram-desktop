+std::pair<int, JSValue> Instance::newPromise() {
+	const auto ctx = _engine->ctx();
+	JSValue functions[2];
+	auto promise = JS_NewPromiseCapability(ctx, functions);
+	if (JS_IsException(promise)) {
+		return { 0, promise };
+	}
+	const auto key = ++_callKey;
+	_calls.emplace(key, Call{
+		.resolve = functions[0],
+		.reject = functions[1],
+	});
+	return { key, promise };
+}
+
+JSValue Instance::peerInfo(not_null<PeerData*> peer) {
+	const auto ctx = _engine->ctx();
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "id", JS_NewBigInt64(ctx, MarkedId(peer->id)));
+	const auto kind = peer->isUser()
+		? (peer->asUser()->isBot() ? "bot" : "user")
+		: peer->isChat()
+		? "chat"
+		: (peer->isMegagroup() || peer->isGigagroup())
+		? "supergroup"
+		: "channel";
+	JS_SetPropertyStr(ctx, result, "kind", JS_NewString(ctx, kind));
+	JS_SetPropertyStr(ctx, result, "name", NewString(ctx, peer->name()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"verified",
+		JS_NewBool(ctx, peer->isVerified()));
+	JS_SetPropertyStr(ctx, result, "scam", JS_NewBool(ctx, peer->isScam()));
+	JS_SetPropertyStr(ctx, result, "fake", JS_NewBool(ctx, peer->isFake()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"premium",
+		JS_NewBool(ctx, peer->isPremium()));
+	const auto status = peer->emojiStatusId().documentId;
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"emojiStatus",
+		status ? JS_NewBigInt64(ctx, std::int64_t(status)) : JS_NULL);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"color",
+		JS_NewInt32(ctx, peer->colorIndex()));
+	if (const auto username = peer->username(); !username.isEmpty()) {
+		JS_SetPropertyStr(ctx, result, "username", NewString(ctx, username));
+	}
+	auto buffer = mtpBuffer();
+	peer->input().write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "InputPeer");
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"input",
+		decoded.error.empty() ? decoded.value : JS_UNDEFINED);
+	return result;
+}
+
+JSValue Instance::TgStorage(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto storage = instance->_storage;
+	if (magic == kStorageKeys) {
+		auto result = JS_NewArray(ctx);
+		auto index = std::uint32_t();
+		for (const auto &key : storage->keys()) {
+			JS_SetPropertyUint32(ctx, result, index++, NewString(ctx, key));
+		}
+		return result;
+	} else if (magic == kStorageClear) {
+		storage->clear();
+		return JS_UNDEFINED;
+	}
+	const auto key = (argc > 0 && JS_IsString(argv[0]))
+		? FromStd(ToStd(ctx, argv[0]))
+		: QString();
+	if (key.isEmpty() || key.size() > kMaxKeyLength) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.storage keys are strings of 1 to %d characters",
+			kMaxKeyLength);
+	}
+	switch (magic) {
+	case kStorageGet: {
+		const auto value = storage->find(key);
+		if (!value) {
+			return JS_UNDEFINED;
+		}
+		auto text = JS_NewStringLen(ctx, value->constData(), value->size());
+		JSValueConst args[] = { text };
+		auto result = CallGlobal(ctx, "__teleLoad", args);
+		JS_FreeValue(ctx, text);
+		return result;
+	}
+	case kStorageHas:
+		return JS_NewBool(ctx, storage->find(key) != nullptr);
+	case kStorageDelete:
+		return JS_NewBool(ctx, storage->remove(key));
+	case kStorageSet: {
+		if (argc < 2 || JS_IsUndefined(argv[1])) {
+			storage->remove(key);
+			return JS_UNDEFINED;
+		}
+		JSValueConst args[] = { argv[1] };
+		auto text = CallGlobal(ctx, "__teleStore", args);
+		if (JS_IsException(text)) {
+			return text;
+		}
+		auto size = std::size_t();
+		const auto data = JS_ToCStringLen(ctx, &size, text);
+		auto bytes = data ? QByteArray(data, int(size)) : QByteArray();
+		if (data) {
+			JS_FreeCString(ctx, data);
+		}
+		JS_FreeValue(ctx, text);
+		if (!storage->set(key, std::move(bytes))) {
+			return JS_ThrowRangeError(
+				ctx,
+				"tg.storage is over its 16 MB quota");
+		}
+		return JS_UNDEFINED;
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::TgPeersGet(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"peers",
+		"tg.peers.get");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->_session;
+	const auto id = (argc > 0)
+		? PeerFromValue(ctx, argv[0], session->user()->id)
+		: std::nullopt;
+	if (!id) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.peers.get needs a peer, an input peer or a marked id");
+	}
+	const auto peer = session->data().peerLoaded(*id);
+	return peer ? instance->peerInfo(peer) : JS_UNDEFINED;
+}
+
+JSValue Instance::TgPeersSelf(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"self",
+		"tg.peers.self");
+	return instance
+		? instance->peerInfo(instance->_session->user())
+		: JS_EXCEPTION;
+}
+
+JSValue Instance::TgPeersResolve(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"peers",
+		"tg.peers.resolve");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto username = (argc > 0 && JS_IsString(argv[0]))
+		? FromStd(ToStd(ctx, argv[0])).trimmed()
+		: QString();
+	if (username.startsWith('@')) {
+		username = username.mid(1);
+	}
+	if (username.isEmpty()) {
+		return JS_ThrowTypeError(ctx, "tg.peers.resolve needs a username");
+	}
+	return instance->resolve(username);
+}
+
+JSValue Instance::resolve(QString username) {
+	const auto ctx = _engine->ctx();
+	if (const auto peer = _session->data().peerByUsername(username)) {
+		JSValue functions[2];
+		auto promise = JS_NewPromiseCapability(ctx, functions);
+		auto value = peerInfo(peer);
+		JS_FreeValue(ctx, JS_Call(ctx, functions[0], JS_UNDEFINED, 1, &value));
+		JS_FreeValue(ctx, value);
+		JS_FreeValue(ctx, functions[0]);
+		JS_FreeValue(ctx, functions[1]);
+		return promise;
+	}
+	auto created = newPromise();
+	const auto key = created.first;
+	const auto promise = created.second;
+	if (key) {
+		resolveRemote(key, username);
+	}
+	return promise;
+}
+
+void Instance::resolveRemote(int key, QString username) {
+	const auto scope = SendingFromScript();
+	_api.request(MTPcontacts_ResolveUsername(
+		MTP_flags(0),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		if (!_engine) {
+			return;
+		}
+		const auto &data = result.data();
+		_session->data().processUsers(data.vusers());
+		_session->data().processChats(data.vchats());
+		const auto peer = _session->data().peerLoaded(
+			peerFromMTP(data.vpeer()));
+		settle(key, true, peer ? peerInfo(peer) : JS_UNDEFINED);
+	}).fail([=](const MTP::Error &error) {
+		if (!_engine) {
+			return;
+		}
+		const auto type = error.type();
+		const auto wait = FloodWaitSeconds(type);
+		if (wait > 0 && wait <= kFloodSleep) {
+			base::call_delayed(wait * crl::time(1000) + 10, this, [=] {
+				if (_engine && _calls.contains(key)) {
+					resolveRemote(key, username);
+				}
+			});
+		} else if (type == u"USERNAME_NOT_OCCUPIED"_q
+			|| type == u"USERNAME_INVALID"_q) {
+			settle(key, true, JS_UNDEFINED);
+		} else {
+			settle(key, false, rpcError(error.code(), type));
+		}
+	}).handleFloodErrors().send();
+}
+
+JSValue Instance::TgUi(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto what = (magic == kUiNotify) ? "tg.notify" : "tg.openUrl";
+	const auto instance = (magic == kUiToast || magic == kUiNotice)
+		? From(ctx)
+		: Permitted(
+			ctx,
+			(magic == kUiNotify) ? Capability::Notify : Capability::OpenUrl,
+			std::string_view(),
+			what);
+	if (!instance) {
+		return (magic == kUiToast || magic == kUiNotice)
+			? JS_ThrowInternalError(ctx, "the script was stopped")
+			: JS_EXCEPTION;
+	}
+	const auto argument = [&](int index) {
+		return (argc > index && !JS_IsUndefined(argv[index]))
+			? FromStd(ToStd(ctx, argv[index]))
+			: QString();
+	};
+	const auto session = instance->_session;
+	switch (magic) {
+	case kUiToast: {
+		const auto text = argument(0);
+		const auto options = (argc > 1 && JS_IsObject(argv[1]))
+			? argv[1]
+			: JS_UNDEFINED;
+		auto duration = crl::time(0);
+		auto buttonText = QString();
+		auto action = 0;
+		if (JS_IsObject(options)) {
+			auto value = JS_GetPropertyStr(ctx, options, "duration");
+			auto number = double();
+			if (JS_IsNumber(value)
+				&& !JS_ToFloat64(ctx, &number, value)
+				&& number > 0.) {
+				duration = crl::time(number);
+			}
+			JS_FreeValue(ctx, value);
+			auto button = JS_GetPropertyStr(ctx, options, "button");
+			if (JS_IsObject(button)) {
+				buttonText = StringProperty(ctx, button, "text");
+				auto click = JS_GetPropertyStr(ctx, button, "onClick");
+				if (!buttonText.isEmpty() && JS_IsFunction(ctx, click)) {
+					action = NextRegistrationId();
+					instance->_registrations.emplace(action, Registration{
+						.kind = Kind::ToastAction,
+						.fn = JS_DupValue(ctx, click),
+					});
+				}
+				JS_FreeValue(ctx, click);
+			}
+			JS_FreeValue(ctx, button);
+		}
+		ScriptNotice(
+			session,
+			instance->_name,
+			NoticeTone::None,
+			TextWithEntities{ text });
+		const auto weak = base::make_weak(instance);
+		crl::on_main(session, [=] {
+			const auto window = WindowOf(session);
+			if (!window) {
+				return;
+			}
+			auto marked = TextWithEntities{ text };
+			if (action) {
+				marked.append(u"  "_q);
+				const auto offset = int(marked.text.size());
+				marked.append(buttonText);
+				marked.entities.push_back(EntityInText(
+					EntityType::CustomUrl,
+					offset,
+					int(buttonText.size()),
+					u"internal:script-toast"_q));
+			}
+			const auto shown = duration
+				? duration
+				: action
+				? crl::time(5000)
+				: Ui::Toast::kDefaultDuration;
+			window->showToast(Ui::Toast::Config{
+				.text = std::move(marked),
+				.filter = [=](const ClickHandlerPtr &, Qt::MouseButton) {
+					if (const auto alive = weak.get(); alive && action) {
+						crl::on_main(alive, [=] {
+							const auto strong = weak.get();
+							if (!strong) {
+								return;
+							}
+							strong->callOne(
+								action,
+								false,
+								JS_UNDEFINED,
+								u"toast button"_q);
+							const auto i = strong->_registrations.find(action);
+							if (i != end(strong->_registrations)) {
+								auto registration = std::move(i->second);
+								strong->_registrations.erase(i);
+								strong->release(registration);
+							}
+						});
+					}
+					return false;
+				},
+				.duration = shown,
+			});
+			if (action) {
+				base::call_delayed(shown + 2000, session, [=] {
+					if (const auto strong = weak.get()) {
+						const auto i = strong->_registrations.find(action);
+						if (i != end(strong->_registrations)) {
+							auto registration = std::move(i->second);
+							strong->_registrations.erase(i);
+							strong->release(registration);
+						}
+					}
+				});
+			}
+		});
+	} break;
+	case kUiNotify: {
+		const auto title = argument(0);
+		const auto text = argument(1);
+		ScriptNotice(
+			session,
+			instance->_name,
+			NoticeTone::Info,
+			TextWithEntities{
+				title.isEmpty() ? text : (title + u"\n"_q + text),
+			});
+		crl::on_main(session, [=] {
+			ShowTeleNotification({
+				.user = session->user(),
+				.title = title,
+				.text = text,
+				.fallback = title.isEmpty()
+					? text
+					: (title + u": "_q + text),
+				.id = kScriptNotificationId,
+			});
+		});
+	} break;
+	case kUiNotice: {
+		const auto options = (argc > 0) ? argv[0] : JS_UNDEFINED;
+		auto title = QString();
+		auto tone = NoticeTone::None;
+		auto buttons = std::vector<NoticeButton>();
+		auto source = JS_DupValue(ctx, options);
+		if (JS_IsObject(options) && !JS_IsArray(options)) {
+			JS_FreeValue(ctx, source);
+			source = JS_GetPropertyStr(ctx, options, "text");
+			title = StringProperty(ctx, options, "title");
+			const auto name = StringProperty(ctx, options, "tone");
+			static const auto tones = std::array{
+				std::pair{ u""_q, NoticeTone::None },
+				std::pair{ u"info"_q, NoticeTone::Info },
+				std::pair{ u"success"_q, NoticeTone::Success },
+				std::pair{ u"warning"_q, NoticeTone::Warning },
+				std::pair{ u"critical"_q, NoticeTone::Critical },
+			};
+			const auto i = ranges::find(tones, name, [](const auto &pair) {
+				return pair.first;
+			});
+			if (i == end(tones)) {
+				JS_FreeValue(ctx, source);
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.ui.notice: tone is info, success, warning or critical");
+			}
+			tone = i->second;
+			auto list = JS_GetPropertyStr(ctx, options, "buttons");
+			auto length = std::int64_t();
+			if (JS_IsArray(list) && JS_GetLength(ctx, list, &length) >= 0) {
+				for (auto j = std::int64_t(); j != length && j < 2; ++j) {
+					auto item = JS_GetPropertyUint32(
+						ctx,
+						list,
+						std::uint32_t(j));
+					auto button = NoticeButton{
+						.text = StringProperty(ctx, item, "text"),
+						.url = StringProperty(ctx, item, "url"),
+					};
+					JS_FreeValue(ctx, item);
+					if (button.text.isEmpty() || button.url.isEmpty()) {
+						JS_FreeValue(ctx, list);
+						JS_FreeValue(ctx, source);
+						return JS_ThrowTypeError(
+							ctx,
+							"tg.ui.notice: a button is { text, url }");
+					}
+					buttons.push_back(std::move(button));
+				}
+			}
+			JS_FreeValue(ctx, list);
+		}
+		auto tagged = instance->textFromValue(source, u"tg.ui.notice"_q);
+		JS_FreeValue(ctx, source);
+		if (!tagged || tagged->text.trimmed().isEmpty()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.notice needs a text: a string or { title, text, "
+				"tone, buttons }");
+		}
+		ScriptNotice(
+			session,
+			title.isEmpty() ? instance->_name : title,
+			tone,
+			TextWithEntities{
+				tagged->text,
+				TextUtilities::ConvertTextTagsToEntities(tagged->tags),
+			},
+			std::move(buttons));
+	} break;
+	case kUiOpen: {
+		const auto link = argument(0).trimmed();
+		if (link.isEmpty()) {
+			return JS_ThrowTypeError(ctx, "tg.openUrl needs a link");
+		}
+		crl::on_main(session, [=] {
+			const auto window = WindowOf(session);
+			UrlClickHandler::Open(link, QVariant::fromValue(ClickHandlerContext{
+				.sessionWindow = window
+					? base::make_weak(window)
+					: base::weak_ptr<Window::SessionController>(),
+			}));
+		});
+	} break;
+	}
+	return JS_UNDEFINED;
+}
