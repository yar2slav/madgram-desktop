+bool Instance::run() {
+	const auto ctx = _engine->ctx();
+	_local->restore();
+	auto setup = JS_GetPropertyStr(ctx, _definition, "setup");
+	_tg = makeTg();
+	JSValueConst args[] = { _tg };
+	const auto errors = _engine->errors();
+	auto result = _engine->call(
+		setup,
+		_definition,
+		args,
+		kSetupBudget,
+		u"setup"_q);
+	JS_FreeValue(ctx, setup);
+	if (_engine->errors() != errors) {
+		JS_FreeValue(ctx, result);
+		_error = _engine->lastError();
+		return false;
+	}
+	_engine->drain(false);
+	if (JS_IsPromise(result)
+		&& JS_PromiseState(ctx, result) == JS_PROMISE_REJECTED) {
+		_engine->rejected(result, JS_UNDEFINED, true);
+	}
+	_engine->flushRejections();
+	if (JS_IsPromise(result)) {
+		const auto state = JS_PromiseState(ctx, result);
+		if (state == JS_PROMISE_PENDING) {
+			_setup = result;
+			result = JS_UNDEFINED;
+		} else {
+			auto value = JS_PromiseResult(ctx, result);
+			JS_FreeValue(ctx, result);
+			if (state == JS_PROMISE_REJECTED) {
+				_error = _engine->describe(value);
+				JS_FreeValue(ctx, value);
+				return false;
+			}
+			result = value;
+		}
+	}
+	if (JS_IsFunction(ctx, result)) {
+		_cleanup = result;
+	} else {
+		JS_FreeValue(ctx, result);
+	}
+	_started = true;
+	log(LogLevel::Info, u"started"_q);
+	return true;
+}
+
+void Instance::release(std::vector<JSValue> &values) {
+	if (!_engine) {
+		return;
+	}
+	for (const auto value : values) {
+		JS_FreeValue(_engine->ctx(), value);
+	}
+	values.clear();
+}
+
+void Instance::stop() {
+	if (!_engine) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	if (JS_IsPromise(_setup)
+		&& JS_PromiseState(ctx, _setup) == JS_PROMISE_FULFILLED) {
+		auto value = JS_PromiseResult(ctx, _setup);
+		if (JS_IsFunction(ctx, value)) {
+			JS_FreeValue(ctx, _cleanup);
+			_cleanup = value;
+		} else {
+			JS_FreeValue(ctx, value);
+		}
+	}
+	if (JS_IsFunction(ctx, _cleanup)) {
+		auto result = _engine->call(
+			_cleanup,
+			JS_UNDEFINED,
+			{},
+			kCleanupBudget,
+			u"cleanup"_q);
+		JS_FreeValue(ctx, result);
+		_engine->drain();
+	}
+	auto unloads = std::vector<JSValue>();
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::Unload) {
+			unloads.push_back(JS_DupValue(ctx, registration.fn));
+		}
+	}
+	for (const auto fn : unloads) {
+		auto result = _engine->call(
+			fn,
+			JS_UNDEFINED,
+			{},
+			kCleanupBudget,
+			u"onUnload"_q);
+		JS_FreeValue(ctx, result);
+	}
+	release(unloads);
+	_engine->drain();
+	for (auto &[id, registration] : base::take(_registrations)) {
+		release(registration);
+	}
+	for (auto &[key, middleware] : base::take(_middlewares)) {
+		middleware.finish({});
+	}
+	for (auto &[key, run] : base::take(_updateRuns)) {
+		run.done(std::nullopt);
+	}
+	for (auto &[key, run] : base::take(_sendRuns)) {
+		run.done(run.data);
+	}
+	for (auto &[key, run] : base::take(_commandRuns)) {
+		run.done(std::nullopt, true);
+	}
+	_settingsPage = 0;
+	for (auto &[id, page] : base::take(_pages)) {
+		page->closed.fire({});
+		JS_FreeValue(ctx, page->items);
+		JS_FreeValue(ctx, page->rendered);
+	}
+	for (auto &[key, transfer] : base::take(_transfers)) {
+		if (transfer.upload) {
+			_session->uploader().cancel(transfer.upload);
+		}
+	}
+	_network = nullptr;
+	_local = nullptr;
+	RemovePeerOverrides(this);
+	RemoveMessageDecorations(this, std::nullopt);
+	_decorateRuns.clear();
+	for (auto &[key, run] : base::take(_gateRuns)) {
+		run.done(run.fallback);
+	}
+	_shortcuts.clear();
+	UnregisterScriptButtons(this);
+	_chatsLifetime.destroy();
+	_composeLifetime.destroy();
+	_optionsLifetime.destroy();
+	_systemLifetime.destroy();
+	RemoveScriptAppOverrides(this);
+	SetScriptMainMenuItems(this, {});
+	SetScriptTrayMenuItems(this, {});
+	SetScriptSettingsEntries(this, {});
+	SetScriptQuickActions(this, {});
+	_widgetObservers.clear();
+	_extensionsLifetime.destroy();
+	RemoveWidgetChanges(this);
+	for (const auto &[id, owner] : base::take(_colorOwners)) {
+		RemoveScriptColors(owner.get());
+	}
+	for (const auto &[key, process] : base::take(_processes)) {
+		if (process) {
+			process->kill();
+			process->deleteLater();
+		}
+	}
+	_connectionLifetime.destroy();
+	_wakeTimer = nullptr;
+	for (auto &[key, call] : base::take(_calls)) {
+		JS_FreeValue(ctx, call.resolve);
+		JS_FreeValue(ctx, call.reject);
+	}
+	for (auto *value : { &_setup, &_cleanup, &_tg, &_definition, &_unwrap }) {
+		JS_FreeValue(ctx, *value);
+		*value = JS_UNDEFINED;
+	}
+	_engine = nullptr;
+	_evaluations.clear();
+	if (_started) {
+		_started = false;
+		log(LogLevel::Info, u"stopped"_q);
+	}
+}
+
+JSValue Instance::invoke(
+		JSValueConst function,
+		std::span<JSValueConst> args,
+		crl::time budget,
+		const QString &where) {
+	const auto errors = _engine->errors();
+	auto result = _engine->call(function, JS_UNDEFINED, args, budget, where);
+	if (_engine->errors() == errors) {
+		_failures = 0;
+		return result;
+	}
+	JS_FreeValue(_engine->ctx(), result);
+	countFailure();
+	return JS_EXCEPTION;
+}
+
+void Instance::countFailure() {
+	if (++_failures >= kMaxFailures && _started) {
+		_started = false;
+		log(
+			LogLevel::Fault,
+			u"failed %1 times in a row, turning it off"_q.arg(kMaxFailures));
+		if (_failed) {
+			_failed();
+		}
+	}
+}
+
+void Instance::fault(const QString &where, const QString &text) {
+	log(LogLevel::Fault, where + u": "_q + text);
+	countFailure();
+}
