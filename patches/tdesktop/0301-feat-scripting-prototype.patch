+#include "tele/scripting/tele_script_messages.h"
+
+#include "api/api_text_entities.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "history/history_item_reply_markup.h"
+#include "main/main_session.h"
+#include "tele/scripting/tele_script_hooks.h"
+#include "tele/scripting/tele_script_instance.h"
+#include "tele/scripting/tele_script_native.h"
+#include "tele/tele_shot.h"
+
+#include <deque>
+#include <map>
+
+namespace Tele::Scripting {
+
+struct DecorationCallback {
+	DecorationCallback(base::weak_ptr<Instance> instance, int id)
+	: instance(std::move(instance))
+	, id(id) {
+	}
+	DecorationCallback(const DecorationCallback &other) = delete;
+	DecorationCallback &operator=(const DecorationCallback &other) = delete;
+	~DecorationCallback() {
+		ForgetKept(instance, id);
+	}
+
+	base::weak_ptr<Instance> instance;
+	int id = 0;
+};
+
+namespace {
+
+constexpr auto kCacheLimit = std::size_t(20000);
+constexpr auto kMaxButtonRows = int64_t(8);
+constexpr auto kMaxButtonColumns = int64_t(8);
+constexpr auto kChannelShift = std::int64_t(1000000000000);
+
+using Key = std::tuple<const void*, uint64, int64>;
+
+struct Cached {
+	FullMsgId id;
+	std::string bytes;
+	uint64 generation = 0;
+};
+
+struct Cache {
+	std::map<Key, Cached> entries;
+	std::deque<std::pair<Key, uint64>> order;
+	uint64 generation = 0;
+};
+
+struct Layer {
+	const void *owner = nullptr;
+	int layer = 0;
+	MessageDecoration value;
+};
+
+struct Decorated {
+	std::vector<Layer> layers;
+	MessageDecoration merged;
+};
+
+[[nodiscard]] Cache &CacheState() {
+	static auto result = Cache();
+	return result;
+}
+
+[[nodiscard]] std::map<Key, Decorated> &Decorations() {
+	static auto result = std::map<Key, Decorated>();
+	return result;
+}
+
+[[nodiscard]] Key CacheKeyOf(
+		not_null<const Main::Session*> session,
+		PeerId peer,
+		MsgId id) {
+	return Key(
+		session.get(),
+		peerIsChannel(peer) ? peer.value : uint64(),
+		id.bare);
+}
+
+[[nodiscard]] Key ItemKey(not_null<const HistoryItem*> item) {
+	return Key(
+		&item->history()->session(),
+		item->history()->peer->id.value,
+		item->id.bare);
+}
+
+[[nodiscard]] const MessageDecoration *Find(
+		not_null<const HistoryItem*> item) {
+	const auto &decorations = Decorations();
+	if (decorations.empty()) {
+		return nullptr;
+	}
+	const auto i = decorations.find(ItemKey(item));
+	return (i != end(decorations)) ? &i->second.merged : nullptr;
+}
+
+[[nodiscard]] MessageDecoration Merge(const std::vector<Layer> &layers) {
+	auto result = MessageDecoration();
+	for (const auto &layer : layers) {
+		const auto &value = layer.value;
+		if (value.text) {
+			result.text = value.text;
+		}
+		if (value.footer) {
+			result.footer = value.footer;
+		}
+		if (value.opacity) {
+			result.opacity = value.opacity;
+		}
+		if (value.hidden) {
+			result.hidden = value.hidden;
+		}
+		if (value.badge) {
+			result.badge = value.badge;
+		}
+		if (value.buttons) {
+			result.buttons = value.buttons;
+		}
+	}
+	return result;
+}
+
+void Refresh(not_null<Main::Session*> session, FullMsgId id) {
+	auto &owner = session->data();
+	if (const auto item = owner.message(id)) {
+		owner.requestItemViewRefresh(item);
+		owner.requestItemResize(item);
+	}
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] HistoryMessageMarkupButton::Color ColorOf(
+		DecorationButtonStyle style) {
+	using Color = HistoryMessageMarkupButton::Color;
+	switch (style) {
+	case DecorationButtonStyle::Primary: return Color::Primary;
+	case DecorationButtonStyle::Danger: return Color::Danger;
+	case DecorationButtonStyle::Default: break;
+	}
+	return Color::Normal;
+}
+
+[[nodiscard]] std::optional<DecorationButtonStyle> StyleOf(
+		JSContext *ctx,
+		JSValueConst value) {
+	if (JS_IsUndefined(value)) {
+		return DecorationButtonStyle::Default;
+	} else if (!JS_IsString(value)) {
+		return std::nullopt;
+	}
+	const auto name = ToStd(ctx, value);
+	if (name == "default") {
+		return DecorationButtonStyle::Default;
+	} else if (name == "primary") {
+		return DecorationButtonStyle::Primary;
+	} else if (name == "danger") {
+		return DecorationButtonStyle::Danger;
+	}
+	return std::nullopt;
+}
+
+class ButtonClickHandler final : public ReplyMarkupClickHandler {
+public:
+	ButtonClickHandler(
+		not_null<Data::Session*> owner,
+		FullMsgId id,
+		std::shared_ptr<DecorationCallback> callback)
+	: ReplyMarkupClickHandler(owner, -1, -1, id)
+	, _id(id)
+	, _callback(std::move(callback)) {
+	}
+
+	QString tooltip() const override {
+		return QString();
+	}
+
+	void onClick(ClickContext context) const override {
+		if (context.button != Qt::LeftButton || !_callback) {
+			return;
+		}
+		const auto id = _id;
+		const auto callback = _callback;
+		CallKept(callback->instance, callback->id, [=](JSContext *ctx) {
+			auto result = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				result,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(id.peer)));
+			JS_SetPropertyStr(
+				ctx,
+				result,
+				"messageId",
+				JS_NewInt64(ctx, id.msg.bare));
+			return result;
+		}, u"decoration button"_q);
+	}
+
+private:
+	const FullMsgId _id;
+	const std::shared_ptr<DecorationCallback> _callback;
+
+};
+
+void Store(
+		not_null<Main::Session*> session,
+		not_null<HistoryItem*> item,
+		std::string bytes) {
+	auto &cache = CacheState();
+	const auto key = CacheKeyOf(session, item->history()->peer->id, item->id);
+	const auto generation = ++cache.generation;
+	cache.entries[key] = Cached{
+		.id = item->fullId(),
+		.bytes = std::move(bytes),
+		.generation = generation,
+	};
+	cache.order.emplace_back(key, generation);
+	while (cache.entries.size() > kCacheLimit && !cache.order.empty()) {
+		const auto [oldest, stamp] = cache.order.front();
+		cache.order.pop_front();
+		const auto i = cache.entries.find(oldest);
+		if (i != end(cache.entries) && i->second.generation == stamp) {
+			cache.entries.erase(i);
+		}
+	}
+	if (cache.order.size() > 4 * kCacheLimit) {
+		auto order = std::deque<std::pair<Key, uint64>>();
+		for (const auto &[key, stamp] : cache.order) {
+			const auto i = cache.entries.find(key);
+			if (i != end(cache.entries) && i->second.generation == stamp) {
+				order.emplace_back(key, stamp);
+			}
+		}
+		cache.order = std::move(order);
+	}
+}
+
+} // namespace
+
+void MessageArrived(
+		not_null<HistoryItem*> item,
+		const MTPMessage &message,
+		bool fresh) {
+	const auto session = &item->history()->session();
+	if (!CapturesMessages(session)) {
+		return;
+	}
+	auto buffer = mtpBuffer();
+	message.write(buffer);
+	auto bytes = std::string(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(mtpPrime));
+	Store(session, item, bytes);
+	if (fresh) {
+		DispatchMessage(session, item->fullId(), bytes);
+	}
+}
+
+void MessageApplied(
+		not_null<Main::Session*> session,
+		const MTPMessage &message) {
+	if (message.type() != mtpc_message || !CapturesMessages(session)) {
+		return;
+	}
+	const auto &data = message.c_message();
+	const auto item = session->data().message(
+		peerFromMTP(data.vpeer_id()),
+		data.vid().v);
+	if (item) {
+		MessageArrived(item, message, true);
+	}
+}
+
+void ShortSentArrived(
+		not_null<HistoryItem*> item,
+		const MTPDupdateShortSentMessage &data) {
+	const auto session = &item->history()->session();
+	if (!CapturesMessages(session)) {
+		return;
+	}
+	using Flag = MTPDmessage::Flag;
+	const auto &text = item->originalText();
+	const auto entities = Api::EntitiesToMTP(
+		session,
+		text.entities,
+		Api::ConvertOption::SkipLocal);
+	const auto media = data.vmedia();
+	const auto ttl = data.vttl_period();
+	const auto flags = Flag::f_out
+		| Flag::f_from_id
+		| (entities.v.isEmpty() ? Flag() : Flag::f_entities)
+		| (media ? Flag::f_media : Flag())
+		| (ttl ? Flag::f_ttl_period : Flag());
+	MessageArrived(item, MTP_message(
+		MTP_flags(flags),
+		data.vid(),
+		peerToMTP(session->userPeerId()),
+		MTPint(),
+		MTPstring(),
+		peerToMTP(item->history()->peer->id),
+		MTPPeer(),
+		MTPMessageFwdHeader(),
+		MTPlong(),
+		MTPlong(),
+		MTPPeer(),
+		MTPMessageReplyHeader(),
+		data.vdate(),
+		MTP_string(text.text),
+		media ? *media : MTPMessageMedia(),
+		MTPReplyMarkup(),
+		entities,
+		MTPint(),
+		MTPint(),
+		MTPMessageReplies(),
+		MTPint(),
+		MTPstring(),
+		MTPlong(),
+		MTPMessageReactions(),
+		MTPVector<MTPRestrictionReason>(),
+		ttl ? *ttl : MTPint(),
+		MTPint(),
+		MTPlong(),
+		MTPFactCheck(),
+		MTPint(),
+		MTPlong(),
+		MTPSuggestedPost(),
+		MTPint(),
+		MTPstring(),
+		MTPRichMessage()), true);
+}
+
+std::optional<std::string> CachedMessage(
+		not_null<Main::Session*> session,
+		PeerId peer,
+		MsgId id) {
+	const auto &entries = CacheState().entries;
+	const auto i = entries.find(CacheKeyOf(session, peer, id));
+	if (i == end(entries)) {
+		return std::nullopt;
+	}
+	return i->second.bytes;
+}
+
+std::vector<CachedEntry> LoadedCachedMessages(
+		not_null<Main::Session*> session) {
+	auto result = std::vector<CachedEntry>();
+	auto &owner = session->data();
+	for (const auto &[key, cached] : CacheState().entries) {
+		if (std::get<0>(key) == session.get() && owner.message(cached.id)) {
+			result.push_back({ .id = cached.id, .bytes = cached.bytes });
+		}
+	}
+	return result;
+}
+
+void ForgetMessages(not_null<Main::Session*> session) {
+	auto &cache = CacheState();
+	for (auto i = begin(cache.entries); i != end(cache.entries);) {
+		if (std::get<0>(i->first) == session.get()) {
+			i = cache.entries.erase(i);
+		} else {
+			++i;
+		}
+	}
+	auto &decorations = Decorations();
+	for (auto i = begin(decorations); i != end(decorations);) {
+		if (std::get<0>(i->first) == session.get()) {
+			i = decorations.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+void SetMessageDecoration(
+		not_null<Main::Session*> session,
+		FullMsgId id,
+		const void *owner,
+		int layer,
+		std::optional<MessageDecoration> value) {
+	auto &decorations = Decorations();
+	const auto key = Key(session.get(), id.peer.value, id.msg.bare);
+	auto i = decorations.find(key);
+	if (!value && i == end(decorations)) {
+		return;
+	} else if (i == end(decorations)) {
+		i = decorations.emplace(key, Decorated()).first;
+	}
+	auto &layers = i->second.layers;
+	const auto j = ranges::find_if(layers, [&](const Layer &existing) {
+		return existing.owner == owner && existing.layer == layer;
+	});
+	if (value) {
+		if (j != end(layers)) {
+			j->value = std::move(*value);
+		} else {
+			layers.push_back({
+				.owner = owner,
+				.layer = layer,
+				.value = std::move(*value),
+			});
+		}
+	} else if (j != end(layers)) {
+		layers.erase(j);
+	} else {
+		return;
+	}
+	if (layers.empty()) {
+		decorations.erase(i);
+	} else {
+		i->second.merged = Merge(layers);
+	}
+	Refresh(session, id);
+}
+
+void RemoveMessageDecorations(const void *owner, std::optional<int> layer) {
+	auto &decorations = Decorations();
+	auto changed = std::vector<std::pair<Main::Session*, FullMsgId>>();
+	for (auto i = begin(decorations); i != end(decorations);) {
+		auto &layers = i->second.layers;
+		const auto removed = ranges::remove_if(layers, [&](const Layer &l) {
+			return l.owner == owner && (!layer || l.layer == *layer);
+		});
+		if (removed == end(layers)) {
+			++i;
+			continue;
+		}
+		layers.erase(removed, end(layers));
+		const auto &[session, peer, msg] = i->first;
+		changed.emplace_back(
+			static_cast<Main::Session*>(const_cast<void*>(session)),
+			FullMsgId(PeerId(peer), MsgId(msg)));
+		if (layers.empty()) {
+			i = decorations.erase(i);
+		} else {
+			i->second.merged = Merge(layers);
+			++i;
+		}
+	}
+	for (const auto &[session, id] : changed) {
+		Refresh(session, id);
+	}
+}
+
+void ReadDecorationButtons(
+		not_null<Instance*> instance,
+		JSValueConst value,
+		MessageDecoration &decoration,
+		QString &error) {
+	const auto ctx = instance->context();
+	if (!ctx || !error.isEmpty()) {
+		return;
+	}
+	auto rows = JS_GetPropertyStr(ctx, value, "buttons");
+	if (JS_IsUndefined(rows)) {
+		return;
+	}
+	auto result = std::vector<std::vector<DecorationButton>>();
+	auto functions = std::vector<JSValue>();
+	auto count = int64_t();
+	if (!JS_IsArray(rows)
+		|| JS_GetLength(ctx, rows, &count)
+		|| count > kMaxButtonRows) {
+		error = u"buttons is an array of up to 8 rows"_q;
+	}
+	for (auto i = int64_t(); error.isEmpty() && i != count; ++i) {
+		const auto where = u"buttons[%1]"_q.arg(i);
+		auto row = JS_GetPropertyInt64(ctx, rows, i);
+		auto columns = int64_t();
+		if (!JS_IsArray(row)
+			|| JS_GetLength(ctx, row, &columns)
+			|| columns < 1
+			|| columns > kMaxButtonColumns) {
+			error = where + u" is an array of 1 to 8 buttons"_q;
+		}
+		auto &buttons = result.emplace_back();
+		for (auto j = int64_t(); error.isEmpty() && j != columns; ++j) {
+			const auto at = where + u"[%1]"_q.arg(j);
+			auto button = JS_GetPropertyInt64(ctx, row, j);
+			if (!JS_IsObject(button)) {
+				error = at + u" is { text, onClick, style? }"_q;
+				JS_FreeValue(ctx, button);
+				break;
+			}
+			auto text = JS_GetPropertyStr(ctx, button, "text");
+			auto onClick = JS_GetPropertyStr(ctx, button, "onClick");
+			auto style = JS_GetPropertyStr(ctx, button, "style");
+			const auto label = JS_IsString(text)
+				? FromStd(ToStd(ctx, text))
+				: QString();
+			const auto kind = StyleOf(ctx, style);
+			if (label.trimmed().isEmpty()) {
+				error = at + u".text is a non-empty string"_q;
+			} else if (!JS_IsFunction(ctx, onClick)) {
+				error = at + u".onClick is a function"_q;
+			} else if (!kind) {
+				error = at + u".style is 'default', 'primary' or 'danger'"_q;
+			} else {
+				buttons.push_back({ .text = label, .style = *kind });
+				functions.push_back(JS_DupValue(ctx, onClick));
+			}
+			for (const auto item : { text, onClick, style, button }) {
+				JS_FreeValue(ctx, item);
+			}
+		}
+		JS_FreeValue(ctx, row);
+	}
+	JS_FreeValue(ctx, rows);
+	if (error.isEmpty()) {
+		const auto weak = base::make_weak(instance.get());
+		auto next = begin(functions);
+		for (auto &row : result) {
+			for (auto &button : row) {
+				button.callback = std::make_shared<DecorationCallback>(
+					weak,
+					KeepFunction(instance, *next++));
+			}
+		}
+		decoration.buttons = std::move(result);
+	}
+	for (const auto function : functions) {
+		JS_FreeValue(ctx, function);
+	}
+}
+
+TextWithEntities DecoratedText(
+		not_null<const HistoryItem*> item,
+		TextWithEntities text) {
+	const auto decoration = Find(item);
+	if (!decoration) {
+		return text;
+	}
+	auto result = decoration->text ? *decoration->text : std::move(text);
+	const auto &footer = decoration->footer;
+	if (footer && !footer->text.isEmpty()) {
+		if (!result.text.isEmpty()) {
+			result.append(QChar('\n'));
+		}
+		auto piece = TextWithEntities{ footer->text };
+		piece.entities.push_back(EntityInText(
+			EntityType::Blockquote,
+			0,
+			int(footer->text.size())));
+		piece.entities.append(footer->entities);
+		result.append(std::move(piece));
+	}
+	return result;
+}
+
+bool DecoratedHidden(not_null<const HistoryItem*> item) {
+	const auto decoration = Find(item);
+	return decoration && decoration->hidden.value_or(false);
+}
+
+double DecoratedOpacity(not_null<const HistoryItem*> item) {
+	const auto decoration = Find(item);
+	return decoration ? decoration->opacity.value_or(1.) : 1.;
+}
+
+QString DecoratedBadge(not_null<const HistoryItem*> item, QString author) {
+	const auto decoration = Find(item);
+	if (!decoration || !decoration->badge || decoration->badge->isEmpty()) {
+		return author;
+	}
+	return author.isEmpty()
+		? *decoration->badge
+		: (author + u" \u00B7 "_q + *decoration->badge);
+}
+
+bool HasDecorationButtons(not_null<const HistoryItem*> item) {
+	if (ShotHidesInlineButtons() || item->isAdminLogEntry()) {
+		return false;
+	}
+	const auto decoration = Find(item);
+	return decoration && decoration->buttons && !decoration->buttons->empty();
+}
+
+void AppendDecorationButtons(
+		not_null<const HistoryItem*> item,
+		not_null<ReplyKeyboard*> keyboard) {
+	const auto decoration = Find(item);
+	if (!decoration || !decoration->buttons) {
+		return;
+	}
+	const auto owner = &item->history()->owner();
+	const auto id = item->fullId();
+	auto rows = std::vector<std::vector<ReplyKeyboard::ExtraButton>>();
+	rows.reserve(decoration->buttons->size());
+	for (const auto &row : *decoration->buttons) {
+		auto &buttons = rows.emplace_back();
+		buttons.reserve(row.size());
+		for (const auto &button : row) {
+			buttons.push_back({
+				.text = button.text,
+				.color = ColorOf(button.style),
+				.link = std::make_shared<ButtonClickHandler>(
+					owner,
+					id,
+					button.callback),
+			});
+		}
+	}
+	keyboard->appendRows(std::move(rows));
+}
+
+} // namespace Tele::Scripting
