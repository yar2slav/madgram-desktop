+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kSetIdBase = 0xFEC7'0000'0000'0000ULL;
+constexpr auto kMaxStickers = 200;
+constexpr auto kMaxEmoji = 200;
+constexpr auto kMaxResults = 50;
+constexpr auto kMaxQueries = 32;
+constexpr auto kStickerSide = 512;
+constexpr auto kGifSide = 256;
+constexpr auto kThumbnailSide = 100;
+
+enum class Kind : uchar {
+	Stickers,
+	Emoji,
+	Gifs,
+};
+
+struct Upload {
+	QByteArray bytes;
+	QString name;
+	QString mime;
+	QVector<MTPDocumentAttribute> attributes;
+	std::shared_ptr<Data::DocumentMedia> media;
+	DocumentData *uploaded = nullptr;
+	bool uploading = false;
+	rpl::lifetime lifetime;
+};
+
+struct Item {
+	not_null<DocumentData*> document;
+	std::optional<MTPDocument> mtp;
+	std::shared_ptr<Upload> upload;
+};
+
+struct Registration {
+	int id = 0;
+	Kind kind = Kind::Stickers;
+	not_null<Instance*> owner;
+	base::weak_ptr<Instance> weak;
+	not_null<Main::Session*> session;
+	QString title;
+	std::unique_ptr<Data::StickersSet> set;
+	std::vector<Item> items;
+	std::vector<DocumentId> emoji;
+	int search = 0;
+};
+
+struct GifEntry {
+	int registration = 0;
+	std::shared_ptr<InlineBots::Result> result;
+	Item item;
+};
+
+struct GifQuery {
+	not_null<Main::Session*> session;
+	QString query;
+	std::vector<GifEntry> entries;
+	base::flat_set<int> asked;
+};
+
+struct GifCall {
+	int registration = 0;
+	not_null<Main::Session*> session;
+	QString query;
+};
+
+struct GifsUpdate {
+	not_null<Main::Session*> session;
+	QString query;
+};
+
+struct Registry {
+	std::vector<std::unique_ptr<Registration>> list;
+	std::vector<GifQuery> queries;
+	std::map<int, GifCall> calls;
+	rpl::event_stream<> setsChanged;
+	rpl::event_stream<GifsUpdate> gifsUpdated;
+	int next = 0;
+	int nextCall = 0;
+	uint64 nextResult = 0;
+};
+
+[[nodiscard]] Registry &Panels() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] QString ResultPrefix() {
+	return u"tele-script-"_q;
+}
+
+[[nodiscard]] Registration *FindRegistration(int id) {
+	for (const auto &entry : Panels().list) {
+		if (entry->id == id) {
+			return entry.get();
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] Registration *FindSet(uint64 setId) {
+	for (const auto &entry : Panels().list) {
+		if (entry->set && entry->set->id == setId) {
+			return entry.get();
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] GifQuery *FindQuery(
+		not_null<Main::Session*> session,
+		const QString &query) {
+	for (auto &entry : Panels().queries) {
+		if (entry.session == session && entry.query == query) {
+			return &entry;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] bool Has(
+		const QByteArray &bytes,
+		int offset,
+		const QByteArray &magic) {
+	return (bytes.size() >= offset + magic.size())
+		&& (bytes.mid(offset, magic.size()) == magic);
+}
+
+[[nodiscard]] QString Sniff(const QByteArray &bytes) {
+	if (Has(bytes, 0, QByteArray("RIFF")) && Has(bytes, 8, QByteArray("WEBP"))) {
+		return u"image/webp"_q;
+	} else if (Has(bytes, 0, QByteArray("\x1f\x8b", 2))) {
+		return u"application/x-tgsticker"_q;
+	} else if (Has(bytes, 0, QByteArray("\x1a\x45\xdf\xa3", 4))) {
+		return u"video/webm"_q;
+	} else if (Has(bytes, 0, QByteArray("GIF8"))) {
+		return u"image/gif"_q;
+	} else if (Has(bytes, 4, QByteArray("ftyp"))) {
+		return u"video/mp4"_q;
+	}
+	return QString();
+}
+
+[[nodiscard]] int SideProperty(
+		JSContext *ctx,
+		JSValueConst value,
+		const char *name,
+		int fallback) {
+	const auto number = NumberProperty(ctx, value, name);
+	return (number && *number >= 1. && *number <= 4096.)
+		? int(*number)
+		: fallback;
+}
+
+[[nodiscard]] double DurationProperty(JSContext *ctx, JSValueConst value) {
+	const auto number = NumberProperty(ctx, value, "duration");
+	return (number && *number > 0. && *number <= 600.) ? *number : 1.;
+}
+
+[[nodiscard]] bool IsCustomEmoji(not_null<DocumentData*> document) {
+	const auto sticker = document->sticker();
+	return sticker && (sticker->setType == Data::StickersType::Emoji);
+}
+
+[[nodiscard]] bool Fits(not_null<DocumentData*> document, Kind kind) {
+	return (kind == Kind::Gifs)
+		? (document->isAnimation() || document->isVideoFile())
+		: (document->sticker() != nullptr);
+}
+
+[[nodiscard]] QByteArray PngBytes(const QImage &image) {
+	auto result = QByteArray();
+	auto buffer = QBuffer(&result);
+	image.save(&buffer, "PNG");
+	return result;
+}
+
+[[nodiscard]] Item LocalItem(
+		not_null<Main::Session*> session,
+		const QByteArray &bytes,
+		const QString &name,
+		const QString &mime,
+		QVector<MTPDocumentAttribute> attributes,
+		QImage thumbnail = QImage()) {
+	attributes.push_front(
+		MTP_documentAttributeFilename(MTP_string(name)));
+	auto thumbs = QVector<MTPPhotoSize>();
+	if (!thumbnail.isNull()) {
+		thumbs.push_back(MTP_photoCachedSize(
+			MTP_string("s"),
+			MTP_int(thumbnail.width()),
+			MTP_int(thumbnail.height()),
+			MTP_bytes(PngBytes(thumbnail))));
+	}
+	using Flag = MTPDdocument::Flag;
+	const auto mtp = MTPDocument(MTP_document(
+		MTP_flags(thumbs.isEmpty()
+			? MTPDdocument::Flags()
+			: MTPDdocument::Flags(Flag::f_thumbs)),
+		MTP_long(base::RandomValue<DocumentId>()),
+		MTP_long(base::RandomValue<uint64>() | 1ULL),
+		MTP_bytes(),
+		MTP_int(base::unixtime::now()),
+		MTP_string(mime),
+		MTP_long(bytes.size()),
+		MTP_vector<MTPPhotoSize>(thumbs),
+		MTPVector<MTPVideoSize>(),
+		MTP_int(session->mtp().mainDcId()),
+		MTP_vector<MTPDocumentAttribute>(attributes)));
+	const auto document = session->data().processDocument(mtp);
+	auto upload = std::make_shared<Upload>();
+	upload->bytes = bytes;
+	upload->name = name;
+	upload->mime = mime;
+	upload->attributes = std::move(attributes);
+	upload->media = document->createMediaView();
+	upload->media->setBytes(bytes);
+	if (!thumbnail.isNull()) {
+		upload->media->setThumbnail(std::move(thumbnail));
+	}
+	return Item{
+		.document = document,
+		.mtp = mtp,
+		.upload = std::move(upload),
+	};
+}
+
+[[nodiscard]] std::optional<Item> StickerFile(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		JSValueConst value,
+		const QByteArray &bytes,
+		QString &error) {
+	const auto mime = Sniff(bytes);
+	auto size = QSize(kStickerSide, kStickerSide);
+	auto thumbnail = QImage();
+	auto extension = QString();
+	if (mime == u"image/webp"_q) {
+		const auto read = Images::Read({ .content = bytes });
+		if (read.image.isNull()) {
+			error = u"is a webp file tele can't read"_q;
+			return std::nullopt;
+		}
+		size = read.image.size();
+		thumbnail = read.image.scaled(
+			kThumbnailSide,
+			kThumbnailSide,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation);
+		extension = u"webp"_q;
+	} else if (mime == u"application/x-tgsticker"_q) {
+		extension = u"tgs"_q;
+	} else if (mime == u"video/webm"_q) {
+		size = QSize(
+			SideProperty(ctx, value, "width", kStickerSide),
+			SideProperty(ctx, value, "height", kStickerSide));
+		extension = u"webm"_q;
+	} else {
+		error = u"is not a webp, tgs or webm file"_q;
+		return std::nullopt;
+	}
+	if (thumbnail.isNull()) {
+		thumbnail = QImage(
+			size.scaled(
+				kThumbnailSide,
+				kThumbnailSide,
+				Qt::KeepAspectRatio).expandedTo(QSize(1, 1)),
+			QImage::Format_ARGB32_Premultiplied);
+		thumbnail.fill(Qt::transparent);
+	}
+	if (bytes.size() > Storage::kMaxStickerBytesSize) {
+		error = u"is larger than 2 MB"_q;
+		return std::nullopt;
+	}
+	auto attributes = QVector<MTPDocumentAttribute>(
+		1,
+		MTP_documentAttributeSticker(
+			MTP_flags(0),
+			MTP_string(StringProperty(ctx, value, "emoji")),
+			MTP_inputStickerSetEmpty(),
+			MTPMaskCoords()));
+	if (extension == u"webp"_q) {
+		attributes.push_back(MTP_documentAttributeImageSize(
+			MTP_int(size.width()),
+			MTP_int(size.height())));
+	} else if (extension == u"webm"_q) {
+		attributes.push_back(MTP_documentAttributeVideo(
+			MTP_flags(MTPDdocumentAttributeVideo::Flag::f_nosound),
+			MTP_double(DurationProperty(ctx, value)),
+			MTP_int(size.width()),
+			MTP_int(size.height()),
+			MTPint(),
+			MTPdouble(),
+			MTPstring()));
+	}
+	const auto name = StringProperty(ctx, value, "name");
+	return LocalItem(
+		session,
+		bytes,
+		name.isEmpty() ? (u"sticker."_q + extension) : name,
+		mime,
+		std::move(attributes),
+		std::move(thumbnail));
+}
+
+[[nodiscard]] std::optional<Item> GifFile(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		JSValueConst value,
+		const QByteArray &bytes,
+		QString &error) {
+	const auto mime = Sniff(bytes);
+	auto size = QSize();
+	auto attributes = QVector<MTPDocumentAttribute>(
+		1,
+		MTP_documentAttributeAnimated());
+	auto extension = QString();
+	if (mime == u"image/gif"_q && bytes.size() >= 10) {
+		const auto data = reinterpret_cast<const uchar*>(bytes.constData());
+		size = QSize(
+			int(data[6]) | (int(data[7]) << 8),
+			int(data[8]) | (int(data[9]) << 8));
+		attributes.push_back(MTP_documentAttributeImageSize(
+			MTP_int(size.width()),
+			MTP_int(size.height())));
+		extension = u"gif"_q;
+	} else if (mime == u"video/mp4"_q) {
+		size = QSize(
+			SideProperty(ctx, value, "width", kGifSide),
+			SideProperty(ctx, value, "height", kGifSide));
+		attributes.push_back(MTP_documentAttributeVideo(
+			MTP_flags(MTPDdocumentAttributeVideo::Flag::f_nosound),
+			MTP_double(DurationProperty(ctx, value)),
+			MTP_int(size.width()),
+			MTP_int(size.height()),
+			MTPint(),
+			MTPdouble(),
+			MTPstring()));
+		extension = u"mp4"_q;
+	} else {
+		error = u"is not a gif or mp4 file"_q;
+		return std::nullopt;
+	}
+	if (size.isEmpty()) {
+		error = u"has no width or height"_q;
+		return std::nullopt;
+	} else if (bytes.size() > Storage::kMaxFileInMemory) {
+		error = u"is larger than 10 MB"_q;
+		return std::nullopt;
+	}
+	const auto name = StringProperty(ctx, value, "name");
+	return LocalItem(
+		session,
+		bytes,
+		name.isEmpty() ? (u"animation."_q + extension) : name,
+		mime,
+		std::move(attributes));
+}
+
+[[nodiscard]] std::optional<Item> ItemOf(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		JSValueConst value,
+		Kind kind,
+		QString &error) {
+	if (!JS_IsObject(value)) {
+		error = u"is not an object"_q;
+		return std::nullopt;
+	}
+	const auto type = StringProperty(ctx, value, "_");
+	if (type == u"document"_q) {
+		auto encoded = EncodeTl(ctx, value, "Document");
+		auto mtp = MTPDocument();
+		auto from = reinterpret_cast<const mtpPrime*>(encoded.bytes.data());
+		const auto till = from + (encoded.bytes.size() / sizeof(mtpPrime));
+		if (!encoded.error.empty()) {
+			error = u"is not a valid document: "_q + FromStd(encoded.error);
+			return std::nullopt;
+		} else if (!mtp.read(from, till)) {
+			error = u"is not a valid document"_q;
+			return std::nullopt;
+		}
+		const auto document = session->data().processDocument(mtp);
+		if (document->isNull() || !Fits(document, kind)) {
+			error = (kind == Kind::Gifs)
+				? u"is not an animation"_q
+				: u"is not a sticker"_q;
+			return std::nullopt;
+		}
+		return Item{ .document = document, .mtp = mtp };
+	} else if (type == u"inputDocument"_q && kind == Kind::Stickers) {
+		auto id = JS_GetPropertyStr(ctx, value, "id");
+		auto raw = int64_t();
+		const auto failed = JS_ToBigInt64(ctx, &raw, id);
+		JS_FreeValue(ctx, id);
+		if (failed) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			error = u"has no bigint id"_q;
+			return std::nullopt;
+		}
+		const auto document = session->data().document(DocumentId(raw));
+		if (document->isNull() || !Fits(document, kind)) {
+			return std::nullopt;
+		}
+		return Item{ .document = document };
+	} else if (!type.isEmpty()) {
+		error = (kind == Kind::Gifs)
+			? u"is a %1, not a document"_q.arg(type)
+			: u"is a %1, not a document or an inputDocument"_q.arg(type);
+		return std::nullopt;
+	}
+	auto field = JS_GetPropertyStr(ctx, value, "bytes");
+	const auto bytes = BytesFrom(ctx, field);
+	JS_FreeValue(ctx, field);
+	if (!bytes || bytes->isEmpty()) {
+		error = u"has no bytes (a Uint8Array or an ArrayBuffer)"_q;
+		return std::nullopt;
+	}
+	return (kind == Kind::Gifs)
+		? GifFile(ctx, session, value, *bytes, error)
+		: StickerFile(ctx, session, value, *bytes, error);
+}
+
+[[nodiscard]] std::optional<std::vector<Item>> ItemsOf(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		JSValueConst list,
+		Kind kind,
+		const char *what,
+		const char *noun,
+		int limit) {
+	if (!JS_IsArray(list)) {
+		JS_ThrowTypeError(ctx, "%s: expected an array", what);
+		return std::nullopt;
+	}
+	auto length = int64_t();
+	if (JS_GetLength(ctx, list, &length)) {
+		return std::nullopt;
+	}
+	auto result = std::vector<Item>();
+	const auto count = std::min(length, int64_t(limit));
+	for (auto i = int64_t(); i != count; ++i) {
+		auto value = JS_GetPropertyUint32(ctx, list, uint32_t(i));
+		auto error = QString();
+		auto item = ItemOf(ctx, session, value, kind, error);
+		JS_FreeValue(ctx, value);
+		if (!error.isEmpty()) {
+			JS_ThrowTypeError(
+				ctx,
+				"%s: %s %d %s",
+				what,
+				noun,
+				int(i),
+				error.toUtf8().constData());
+			return std::nullopt;
+		} else if (item) {
+			result.push_back(std::move(*item));
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<std::vector<DocumentId>> IdsOf(
+		JSContext *ctx,
+		JSValueConst list) {
+	if (!JS_IsArray(list)) {
+		JS_ThrowTypeError(ctx, "tg.ui.registerEmojiSet: expected an array");
+		return std::nullopt;
+	}
+	auto length = int64_t();
+	if (JS_GetLength(ctx, list, &length)) {
+		return std::nullopt;
+	}
+	auto result = std::vector<DocumentId>();
+	const auto count = std::min(length, int64_t(kMaxEmoji));
+	for (auto i = int64_t(); i != count; ++i) {
+		auto value = JS_GetPropertyUint32(ctx, list, uint32_t(i));
+		auto raw = int64_t();
+		const auto failed = JS_ToBigInt64(ctx, &raw, value);
+		JS_FreeValue(ctx, value);
+		if (failed) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			JS_ThrowTypeError(
+				ctx,
+				"tg.ui.registerEmojiSet: emoji %d is not a custom emoji id",
+				int(i));
+			return std::nullopt;
+		}
+		result.push_back(DocumentId(raw));
+	}
+	return result;
+}
+
+void Publish(
+		not_null<Registration*> registration,
+		const std::vector<not_null<DocumentData*>> &documents,
+		int icon) {
+	auto pack = Data::StickersPack();
+	pack.reserve(int(documents.size()));
+	for (const auto document : documents) {
+		pack.push_back(document.get());
+	}
+	const auto set = registration->set.get();
+	set->thumbnailDocumentId = (icon >= 0 && icon < pack.size())
+		? pack[icon]->id
+		: DocumentId();
+	set->count = int(pack.size());
+	set->stickers = std::move(pack);
+	Panels().setsChanged.fire({});
+}
+
+void ResolveEmoji(not_null<Registration*> registration, bool request) {
+	auto documents = std::vector<not_null<DocumentData*>>();
+	auto missing = QVector<MTPlong>();
+	auto &owner = registration->session->data();
+	for (const auto id : registration->emoji) {
+		const auto document = owner.document(id);
+		if (IsCustomEmoji(document)) {
+			documents.push_back(document);
+		} else {
+			missing.push_back(MTP_long(id));
+		}
+	}
+	Publish(registration, documents, 0);
+	if (!request || missing.isEmpty()) {
+		return;
+	}
+	const auto id = registration->id;
+	const auto session = registration->session;
+	session->api().request(MTPmessages_GetCustomEmojiDocuments(
+		MTP_vector<MTPlong>(missing)
+	)).done([=](const MTPVector<MTPDocument> &result) {
+		for (const auto &document : result.v) {
+			session->data().processDocument(document);
+		}
+		if (const auto again = FindRegistration(id)) {
+			ResolveEmoji(again, false);
+		}
+	}).send();
+}
+
+void Remove(int id, bool forget) {
+	auto &panels = Panels();
+	const auto i = ranges::find_if(panels.list, [&](const auto &entry) {
+		return entry->id == id;
+	});
+	if (i == end(panels.list)) {
+		return;
+	}
+	const auto taken = std::move(*i);
+	panels.list.erase(i);
+	if (taken->kind != Kind::Gifs) {
+		panels.setsChanged.fire({});
+		return;
+	}
+	if (forget) {
+		ForgetKept(taken->weak, taken->search);
+	}
+	for (auto j = begin(panels.calls); j != end(panels.calls);) {
+		j = (j->second.registration == id) ? panels.calls.erase(j) : next(j);
+	}
+	auto updates = std::vector<GifsUpdate>();
+	for (auto &query : panels.queries) {
+		const auto was = query.entries.size();
+		query.entries.erase(
+			ranges::remove(query.entries, id, &GifEntry::registration),
+			end(query.entries));
+		query.asked.remove(id);
+		if (query.entries.size() != was) {
+			updates.push_back({ query.session, query.query });
+		}
+	}
+	const auto session = taken->session;
+	const auto used = ranges::any_of(panels.list, [&](const auto &entry) {
+		return (entry->session == session) && (entry->kind == Kind::Gifs);
+	});
+	if (!used) {
+		panels.queries.erase(
+			ranges::remove(panels.queries, session, &GifQuery::session),
+			end(panels.queries));
+	}
+	for (const auto &update : updates) {
+		panels.gifsUpdated.fire_copy(update);
+	}
+}
+
+void Attach(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<Main::Session*> session,
+		QString title,
+		std::weak_ptr<Upload> weak,
+		MTPInputFile file,
+		Fn<void(not_null<DocumentData*>)> send) {
+	const auto strong = weak.lock();
+	if (!strong) {
+		return;
+	}
+	const auto failed = [=](const QString &reason) {
+		if (const auto upload = weak.lock()) {
+			upload->uploading = false;
+		}
+		show->showToast(
+			Lower(u"%1: couldn't upload the file (%2)."_q).arg(title, reason));
+	};
+	session->api().request(MTPmessages_UploadMedia(
+		MTP_flags(0),
+		MTPstring(),
+		MTP_inputPeerSelf(),
+		MTP_inputMediaUploadedDocument(
+			MTP_flags(0),
+			file,
+			MTPInputFile(),
+			MTP_string(strong->mime),
+			MTP_vector<MTPDocumentAttribute>(strong->attributes),
+			MTP_vector<MTPInputDocument>(),
+			MTPInputPhoto(),
+			MTP_int(0),
+			MTP_int(0)))
+	).done([=](const MTPMessageMedia &result) {
+		auto document = (DocumentData*)nullptr;
+		result.match([&](const MTPDmessageMediaDocument &data) {
+			if (const auto media = data.vdocument()) {
+				document = session->data().processDocument(*media).get();
+			}
+		}, [](const auto &) {
+		});
+		const auto upload = weak.lock();
+		if (!upload) {
+			return;
+		} else if (!document || document->isNull()) {
+			failed(u"no document"_q);
+			return;
+		}
+		upload->uploading = false;
+		upload->uploaded = document;
+		send(document);
+	}).fail([=](const MTP::Error &error) {
+		failed(error.type());
+	}).send();
+}
+
+void StartUpload(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<Main::Session*> session,
+		QString title,
+		std::shared_ptr<Upload> upload,
+		Fn<void(not_null<DocumentData*>)> send) {
+	upload->uploading = true;
+	upload->lifetime.destroy();
+	auto prepared = MakePreparedFile({
+		.id = base::RandomValue<uint64>(),
+		.type = SendMediaType::SecondaryFile,
+	});
+	prepared->filename = upload->name;
+	prepared->filemime = upload->mime;
+	prepared->filesize = int64(upload->bytes.size());
+	prepared->setFileData(upload->bytes);
+	const auto id = FullMsgId(
+		session->userPeerId(),
+		session->data().nextLocalMessageId());
+	const auto guard = base::make_weak(session.get());
+	const auto weak = std::weak_ptr<Upload>(upload);
+	auto &uploader = session->uploader();
+	rpl::merge(
+		uploader.secondaryFileReady(),
+		uploader.documentReady()
+	) | rpl::filter([=](const Storage::UploadedMedia &media) {
+		return media.fullId == id;
+	}) | rpl::take(1) | rpl::on_next([=](const Storage::UploadedMedia &media) {
+		crl::on_main(guard, [=, file = media.info.file] {
+			if (const auto strong = guard.get()) {
+				Attach(show, strong, title, weak, file, send);
+			}
+		});
+	}, upload->lifetime);
+	rpl::merge(
+		uploader.secondaryFileFailed(),
+		uploader.documentFailed()
+	) | rpl::filter([=](const FullMsgId &failed) {
+		return failed == id;
+	}) | rpl::take(1) | rpl::on_next([=] {
+		crl::on_main(guard, [=] {
+			if (const auto strong = weak.lock()) {
+				strong->uploading = false;
+			}
+			show->showToast(
+				Lower(u"%1: couldn't upload the file."_q).arg(title));
+		});
+	}, upload->lifetime);
+	uploader.upload(id, prepared);
+}
+
+void Choose(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<Registration*> registration,
+		Item item,
+		Fn<void(not_null<DocumentData*>)> send) {
+	const auto instance = registration->weak.get();
+	if (!instance) {
+		return;
+	} else if (!instance->permissions().allows(
+			Capability::AccountWrite,
+			"send")) {
+		show->showToast(Lower(
+			u"\"%1\" needs the grant %2 to send from the panel. "
+			"Allow it on the script's page in the Scripts manager."_q
+		).arg(
+			instance->name(),
+			GrantText(Capability::AccountWrite, "send")));
+		return;
+	}
+	const auto upload = item.upload;
+	if (!upload) {
+		send(item.document);
+	} else if (const auto uploaded = upload->uploaded) {
+		send(uploaded);
+	} else if (upload->uploading) {
+		show->showToast(Lower(u"Still uploading, a moment."_q));
+	} else {
+		StartUpload(
+			std::move(show),
+			registration->session,
+			registration->title,
+			upload,
+			std::move(send));
+	}
+}
+
+[[nodiscard]] JSValue Register(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto kind = 0;
+	if (argc < 2
+		|| !JS_IsNumber(argv[0])
+		|| JS_ToInt32(ctx, &kind, argv[0])
+		|| kind < 0
+		|| kind > 2
+		|| !JS_IsString(argv[1])) {
+		return JS_ThrowTypeError(ctx, "panelsRegister(kind, title, search)");
+	} else if (Kind(kind) == Kind::Gifs
+		&& (argc < 3 || !JS_IsFunction(ctx, argv[2]))) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.registerGifSource: search is a function");
+	}
+	auto &panels = Panels();
+	const auto id = ++panels.next;
+	const auto session = ScriptSession(instance);
+	auto registration = std::make_unique<Registration>(Registration{
+		.id = id,
+		.kind = Kind(kind),
+		.owner = instance,
+		.weak = base::make_weak(instance.get()),
+		.session = session,
+		.title = FromStd(ToStd(ctx, argv[1])),
+		.search = ((Kind(kind) == Kind::Gifs)
+			? KeepFunction(instance, argv[2])
+			: 0),
+	});
+	if (registration->kind != Kind::Gifs) {
+		using Flag = Data::StickersSetFlag;
+		registration->set = std::make_unique<Data::StickersSet>(
+			&session->data(),
+			kSetIdBase | uint64(id),
+			uint64(),
+			uint64(),
+			registration->title,
+			QString(),
+			0,
+			((registration->kind == Kind::Emoji)
+				? Data::StickersSetFlags(Flag::Emoji | Flag::Special)
+				: Data::StickersSetFlags(Flag::Special)),
+			TimeId());
+	}
+	panels.list.push_back(std::move(registration));
+	ScriptLifetime(instance).add([=] {
+		Remove(id, false);
+	});
+	return JS_NewInt32(ctx, id);
+}
+
+[[nodiscard]] JSValue Fill(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto id = 0;
+	if (argc < 2 || !JS_IsNumber(argv[0]) || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_ThrowTypeError(ctx, "panelsFill(id, list, icon)");
+	}
+	const auto registration = FindRegistration(id);
+	if (!registration || registration->owner != instance) {
+		return JS_NULL;
+	} else if (registration->kind == Kind::Emoji) {
+		auto ids = IdsOf(ctx, argv[1]);
+		if (!ids) {
+			return JS_EXCEPTION;
+		}
+		const auto again = FindRegistration(id);
+		if (!again) {
+			return JS_NULL;
+		}
+		again->emoji = std::move(*ids);
+		ResolveEmoji(again, true);
+		return JS_NewInt32(ctx, int(again->emoji.size()));
+	} else if (registration->kind != Kind::Stickers) {
+		return JS_ThrowTypeError(ctx, "a gif source has no list to fill");
+	}
+	auto icon = 0;
+	if (argc > 2 && JS_IsNumber(argv[2]) && JS_ToInt32(ctx, &icon, argv[2])) {
+		return JS_EXCEPTION;
+	}
+	auto items = ItemsOf(
+		ctx,
+		registration->session,
+		argv[1],
+		Kind::Stickers,
+		"tg.ui.registerStickerSet",
+		"sticker",
+		kMaxStickers);
+	if (!items) {
+		return JS_EXCEPTION;
+	}
+	const auto again = FindRegistration(id);
+	if (!again) {
+		return JS_NULL;
+	}
+	auto documents = std::vector<not_null<DocumentData*>>();
+	documents.reserve(items->size());
+	for (const auto &item : *items) {
+		documents.push_back(item.document);
+	}
+	again->items = std::move(*items);
+	Publish(again, documents, icon);
+	return JS_NewInt32(ctx, int(documents.size()));
+}
+
+[[nodiscard]] JSValue RemoveNative(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto id = 0;
+	if (argc < 1 || !JS_IsNumber(argv[0]) || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_ThrowTypeError(ctx, "panelsRemove(id)");
+	}
+	const auto registration = FindRegistration(id);
+	if (registration && registration->owner == instance) {
+		Remove(id, true);
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue Answer(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto callId = 0;
+	if (argc < 2
+		|| !JS_IsNumber(argv[0])
+		|| JS_ToInt32(ctx, &callId, argv[0])) {
+		return JS_ThrowTypeError(ctx, "panelsAnswer(callId, results)");
+	}
+	auto &panels = Panels();
+	const auto i = panels.calls.find(callId);
+	if (i == end(panels.calls)) {
+		return JS_NULL;
+	}
+	const auto call = i->second;
+	panels.calls.erase(i);
+	const auto registration = FindRegistration(call.registration);
+	if (!registration || registration->owner != instance) {
+		return JS_NULL;
+	}
+	auto items = ItemsOf(
+		ctx,
+		call.session,
+		argv[1],
+		Kind::Gifs,
+		"tg.ui.registerGifSource",
+		"result",
+		kMaxResults);
+	if (!items) {
+		return JS_EXCEPTION;
+	}
+	const auto query = FindQuery(call.session, call.query);
+	if (!query || !FindRegistration(call.registration)) {
+		return JS_NULL;
+	}
+	auto added = std::vector<GifEntry>();
+	for (auto &item : *items) {
+		if (!item.mtp) {
+			continue;
+		}
+		const auto resultId = ResultPrefix()
+			+ QString::number(++panels.nextResult);
+		auto result = InlineBots::Result::Create(
+			call.session,
+			uint64(),
+			MTP_botInlineMediaResult(
+				MTP_flags(MTPDbotInlineMediaResult::Flag::f_document),
+				MTP_string(resultId),
+				MTP_string(u"gif"_q),
+				MTPPhoto(),
+				*item.mtp,
+				MTPstring(),
+				MTPstring(),
+				MTP_botInlineMessageMediaAuto(
+					MTP_flags(0),
+					MTP_string(),
+					MTPVector<MTPMessageEntity>(),
+					MTPReplyMarkup())));
+		if (result) {
+			added.push_back(GifEntry{
+				.registration = call.registration,
+				.result = std::move(result),
+				.item = std::move(item),
+			});
+		}
+	}
+	auto &entries = query->entries;
+	entries.erase(
+		ranges::remove(entries, call.registration, &GifEntry::registration),
+		end(entries));
+	const auto count = int(added.size());
+	for (auto &entry : added) {
+		entries.push_back(std::move(entry));
+	}
+	ranges::stable_sort(entries, ranges::less(), &GifEntry::registration);
+	crl::on_main([update = GifsUpdate{ call.session, call.query }] {
+		Panels().gifsUpdated.fire_copy(update);
+	});
+	return JS_NewInt32(ctx, count);
+}
+
+JSValue NativePanels(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	switch (magic) {
+	case 0: return Register(ctx, instance, argc, argv);
+	case 1: return Fill(ctx, instance, argc, argv);
+	case 2: return RemoveNative(ctx, instance, argc, argv);
+	case 3: return Answer(ctx, instance, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = R"ts(
+declare module 'tele' {
+  export interface PanelStickerFile {
+    bytes: Uint8Array | ArrayBuffer
+    name?: string
+    emoji?: string
+    width?: number
+    height?: number
+    duration?: number
+  }
+
+  export type PanelSticker = tl.TypeDocument | tl.TypeInputDocument | PanelStickerFile
+
+  export interface PanelStickerSetOptions {
+    title: string
+    icon?: number
+    stickers(): PanelSticker[] | Promise<PanelSticker[]>
+  }
+
+  export interface PanelGifFile {
+    bytes: Uint8Array | ArrayBuffer
+    name?: string
+    width?: number
+    height?: number
+    duration?: number
+  }
+
+  export type PanelGif = tl.TypeDocument | PanelGifFile
+
+  export interface PanelGifSourceOptions {
+    title: string
+    search(query: string): PanelGif[] | Promise<PanelGif[]>
+  }
+
+  export interface PanelEmojiSetOptions {
+    title: string
+    emoji(): (bigint | string)[] | Promise<(bigint | string)[]>
+  }
+
+  export interface Ui {
+    registerStickerSet(options: PanelStickerSetOptions): Disposer
+    registerGifSource(options: PanelGifSourceOptions): Disposer
+    registerEmojiSet(options: PanelEmojiSetOptions): Disposer
+  }
+}
+)ts";
+
+} // namespace
+
+void AddPanelsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "panelsRegister", NativePanels, 3, 0 },
+		{ "panelsFill", NativePanels, 3, 1 },
+		{ "panelsRemove", NativePanels, 1, 2 },
+		{ "panelsAnswer", NativePanels, 2, 3 },
+	});
+}
+
+std::string_view PanelsTypings() {
+	return kTypings;
+}
+
+rpl::producer<> PanelSetsChanged() {
+	return Panels().setsChanged.events();
+}
+
+std::vector<not_null<Data::StickersSet*>> PanelStickerSets(
+		not_null<Main::Session*> session) {
+	auto result = std::vector<not_null<Data::StickersSet*>>();
+	for (const auto &entry : Panels().list) {
+		if (entry->kind == Kind::Stickers
+			&& entry->session == session
+			&& !entry->set->stickers.isEmpty()) {
+			result.push_back(entry->set.get());
+		}
+	}
+	return result;
+}
+
+std::vector<not_null<Data::StickersSet*>> PanelEmojiSets(
+		not_null<Main::Session*> session) {
+	auto result = std::vector<not_null<Data::StickersSet*>>();
+	for (const auto &entry : Panels().list) {
+		if (entry->kind == Kind::Emoji
+			&& entry->session == session
+			&& !entry->set->stickers.isEmpty()) {
+			result.push_back(entry->set.get());
+		}
+	}
+	return result;
+}
+
+bool IsPanelSet(uint64 setId) {
+	return FindSet(setId) != nullptr;
+}
+
+bool PanelStickerChosen(
+		std::shared_ptr<ChatHelpers::Show> show,
+		uint64 setId,
+		not_null<DocumentData*> document,
+		Fn<void(not_null<DocumentData*>)> send) {
+	const auto registration = FindSet(setId);
+	if (!registration) {
+		return false;
+	}
+	const auto &items = registration->items;
+	const auto i = ranges::find(items, document, &Item::document);
+	if (i != end(items)) {
+		Choose(std::move(show), registration, *i, std::move(send));
+	}
+	return true;
+}
+
+void SearchPanelGifs(not_null<Main::Session*> session, const QString &query) {
+	auto &panels = Panels();
+	auto sources = std::vector<not_null<Registration*>>();
+	for (const auto &entry : panels.list) {
+		if (entry->kind == Kind::Gifs && entry->session == session) {
+			sources.push_back(entry.get());
+		}
+	}
+	if (query.isEmpty() || sources.empty()) {
+		return;
+	}
+	auto found = FindQuery(session, query);
+	if (!found) {
+		if (int(panels.queries.size()) >= kMaxQueries) {
+			panels.queries.erase(begin(panels.queries));
+		}
+		panels.queries.push_back(GifQuery{
+			.session = session,
+			.query = query,
+		});
+		found = &panels.queries.back();
+	}
+	struct Ask {
+		int callId = 0;
+		base::weak_ptr<Instance> weak;
+		int search = 0;
+	};
+	auto asks = std::vector<Ask>();
+	for (const auto source : sources) {
+		if (found->asked.contains(source->id)) {
+			continue;
+		}
+		found->asked.emplace(source->id);
+		const auto callId = ++panels.nextCall;
+		panels.calls.emplace(callId, GifCall{
+			.registration = source->id,
+			.session = session,
+			.query = query,
+		});
+		asks.push_back({ callId, source->weak, source->search });
+	}
+	for (const auto &ask : asks) {
+		const auto callId = ask.callId;
+		CallKept(ask.weak, ask.search, [=](JSContext *ctx) {
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, payload, "callId", JS_NewInt32(ctx, callId));
+			JS_SetPropertyStr(ctx, payload, "query", NewString(ctx, query));
+			return payload;
+		}, u"tg.ui.registerGifSource"_q);
+	}
+}
+
+rpl::producer<QString> PanelGifsUpdated(not_null<Main::Session*> session) {
+	return Panels().gifsUpdated.events(
+	) | rpl::filter([=](const GifsUpdate &update) {
+		return (update.session == session);
+	}) | rpl::map([](const GifsUpdate &update) {
+		return update.query;
+	});
+}
+
+std::vector<std::shared_ptr<InlineBots::Result>> PanelGifResults(
+		not_null<Main::Session*> session,
+		const QString &query) {
+	auto result = std::vector<std::shared_ptr<InlineBots::Result>>();
+	if (const auto found = query.isEmpty()
+			? nullptr
+			: FindQuery(session, query)) {
+		result.reserve(found->entries.size());
+		for (const auto &entry : found->entries) {
+			result.push_back(entry.result);
+		}
+	}
+	return result;
+}
+
+bool IsPanelGif(const InlineBots::Result *result) {
+	return result && result->getId().startsWith(ResultPrefix());
+}
+
+bool PanelGifChosen(
+		std::shared_ptr<ChatHelpers::Show> show,
+		const InlineBots::Result *result,
+		Fn<void(not_null<DocumentData*>)> send) {
+	if (!IsPanelGif(result)) {
+		return false;
+	}
+	for (const auto &query : Panels().queries) {
+		for (const auto &entry : query.entries) {
+			if (entry.result.get() != result) {
+				continue;
+			} else if (const auto registration = FindRegistration(
+					entry.registration)) {
+				Choose(
+					std::move(show),
+					registration,
+					entry.item,
+					std::move(send));
+			}
+			return true;
+		}
+	}
+	show->showToast(Lower(u"This result is gone, search again."_q));
+	return true;
+}
+
+} // namespace Tele::Scripting
