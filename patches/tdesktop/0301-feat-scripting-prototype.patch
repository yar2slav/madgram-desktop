+JSValue NativeTeledata(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case kBookmarksList: return BookmarksList(ctx);
+	case kBookmarksAdd: return BookmarksAdd(ctx, argc, argv);
+	case kBookmarksRemove: return BookmarksRemove(ctx, argc, argv);
+	case kPinsList: return PinsList(ctx, argc, argv);
+	case kPinsSet: return PinsSet(ctx, argc, argv);
+	case kFoldersList: return FoldersList(ctx);
+	case kFoldersSave: return FoldersSave(ctx, argc, argv);
+	case kFoldersDelete: return FoldersDelete(ctx, argc, argv);
+	case kFoldersReorder: return FoldersReorder(ctx, argc, argv);
+	case kHiddenWordsList: return HiddenWordsList(ctx, argc, argv);
+	case kHiddenWordsChange: return HiddenWordsChange(ctx, argc, argv);
+	case kEditHistory: return EditHistoryOf(ctx, argc, argv);
+	case kDeletedList: return DeletedList(ctx, argc, argv);
+	}
+	const auto listening = (magic == kDeletedOnKept)
+		|| (magic == kDeletedIntercept);
+	const auto instance = listening
+		? Permitted(
+			ctx,
+			Capability::AccountRead,
+			"messages",
+			((magic == kDeletedOnKept)
+				? "tg.tele.deleted.onKept"
+				: "tg.tele.deleted.interceptKeep"))
+		: Instance::From(ctx);
+	if (!instance) {
+		return listening
+			? JS_EXCEPTION
+			: JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	switch (magic) {
+	case kBookmarksOnChange:
+		return AddListener(
+			ctx,
+			instance,
+			argc,
+			argv,
+			ListenerKind::Bookmarks,
+			"tg.tele.bookmarks.onChange");
+	case kOff:
+		return RemoveListener(ctx, instance, argc, argv);
+	case kDeletedOnKept:
+		return AddListener(
+			ctx,
+			instance,
+			argc,
+			argv,
+			ListenerKind::Kept,
+			"tg.tele.deleted.onKept");
+	case kDeletedIntercept:
+		if (!Permitted(
+				ctx,
+				Capability::Options,
+				{},
+				"tg.tele.deleted.interceptKeep")) {
+			return JS_EXCEPTION;
+		}
+		return AddListener(
+			ctx,
+			instance,
+			argc,
+			argv,
+			ListenerKind::Intercept,
+			"tg.tele.deleted.interceptKeep");
+	case kDeletedAnswer:
+		return DeletedAnswer(ctx, instance, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
