+		JS_ToInt32(ctx, &id, (argc > 0) ? argv[0] : JS_UNDEFINED);
+		if (magic == 36) {
+			SetWidgetVisible(
+				instance,
+				id,
+				(argc > 1) && JS_ToBool(ctx, argv[1]));
+			return JS_UNDEFINED;
+		} else if (magic == 37) {
+			return JS_NewBool(
+				ctx,
+				SetWidgetText(instance, id, string(1).value_or(QString())));
+		}
+		return JS_NewBool(ctx, ClickWidget(id));
+	}
+	case 38: {
+		auto id = int32_t();
+		auto pageId = int32_t();
+		JS_ToInt32(ctx, &id, (argc > 0) ? argv[0] : JS_UNDEFINED);
+		JS_ToInt32(ctx, &pageId, (argc > 2) ? argv[2] : JS_UNDEFINED);
+		const auto before = (argc > 1) && JS_ToBool(ctx, argv[1]);
+		auto view = instance->pageView(pageId);
+		const auto window = WindowOf(instance->_session);
+		if (!view || !window) {
+			return JS_UNDEFINED;
+		}
+		const auto key = NextRegistrationId();
+		const auto weak = base::make_weak(instance);
+		const auto block = InsertWidgetBlock(instance, key, id, before, [=] {
+			if (const auto strong = weak.get()) {
+				strong->forget(key);
+			}
+		});
+		if (!block) {
+			return JS_NULL;
+		}
+		instance->_registrations.emplace(key, Registration{
+			.kind = Kind::WidgetChange,
+		});
+		FillScriptPage(block, window->uiShow(), std::move(*view), [=] {
+			crl::on_main([=] {
+				if (const auto strong = weak.get()) {
+					RemoveWidgetChange(strong, key);
+				}
+			});
+		});
+		block->resizeToWidth(block->parentWidget()
+			? block->parentWidget()->width()
+			: block->width());
+		return instance->disposer(key);
+	}
+	case 41: {
+		auto id = int32_t();
+		JS_ToInt32(ctx, &id, (argc > 0) ? argv[0] : JS_UNDEFINED);
+		if (argc < 3 || !JS_IsFunction(ctx, argv[2])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"widget.addMenuItem({ text, onClick })");
+		}
+		const auto key = NextRegistrationId();
+		const auto weak = base::make_weak(instance);
+		const auto added = AddMenuAction(
+			instance,
+			key,
+			id,
+			string(1).value_or(QString()),
+			[=] {
+				crl::on_main([=] {
+					if (const auto strong = weak.get()) {
+						strong->clickRegistration(
+							key,
+							nullptr,
+							u"widget menu item"_q);
+					}
+				});
+			},
+			[=] {
+				if (const auto strong = weak.get()) {
+					strong->forget(key);
+				}
+			});
+		if (!added) {
+			return JS_NULL;
+		}
+		instance->_registrations.emplace(key, Registration{
+			.kind = Kind::WidgetChange,
+			.fn = JS_DupValue(ctx, argv[2]),
+		});
+		return instance->disposer(key);
+	}
+	case 39: {
+		auto id = int32_t();
+		auto index = int32_t(-1);
+		JS_ToInt32(ctx, &id, (argc > 0) ? argv[0] : JS_UNDEFINED);
+		if (argc > 1 && JS_IsNumber(argv[1])) {
+			JS_ToInt32(ctx, &index, argv[1]);
+		}
+		const auto click = (argc > 4) && JS_IsFunction(ctx, argv[4]);
+		const auto key = NextRegistrationId();
+		const auto weak = base::make_weak(instance);
+		const auto inserted = InsertTableRow(
+			instance,
+			key,
+			id,
+			index,
+			string(2).value_or(QString()),
+			string(3).value_or(QString()),
+			click ? Fn<void()>([=] {
+				if (const auto strong = weak.get()) {
+					strong->clickRegistration(
+						key,
+						nullptr,
+						u"widget row"_q);
+				}
+			}) : Fn<void()>(),
+			[=] {
+				if (const auto strong = weak.get()) {
+					strong->forget(key);
+				}
+			});
+		if (!inserted) {
+			return JS_NULL;
+		}
+		instance->_registrations.emplace(key, Registration{
+			.kind = Kind::WidgetChange,
+			.fn = click ? JS_DupValue(ctx, argv[4]) : JS_UNDEFINED,
+		});
+		return instance->disposer(key);
+	}
+	case 28: {
+		auto pageId = int32_t();
+		if (argc < 1 || JS_ToInt32(ctx, &pageId, argv[0]) < 0) {
+			return JS_ThrowTypeError(ctx, "tg.ui.openSection(page)");
+		}
+		const auto window = WindowOf(instance->_session);
+		auto view = instance->pageView(pageId);
+		if (!window || !view) {
+			return JS_FALSE;
+		}
+		const auto title = view->title;
+		ShowScriptSection(window, title, std::move(*view));
+		return JS_TRUE;
+	}
+	case 19: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto id : IgnoredUsers(instance->_session)) {
+			JS_SetPropertyUint32(
+				ctx,
+				result,
+				index++,
+				JS_NewBigInt64(ctx, MarkedId(peerFromUser(id))));
+		}
+		return result;
+	}
+	case 20:
+	case 22:
+	case 25: {
+		const auto peer = peerAt(0);
+		if (!peer) {
+			return JS_ThrowTypeError(
+				ctx,
+				"%s needs a peer in tele's cache",
+				names[magic]);
+		}
+		if (magic == 20) {
+			SetIgnored(peer, (argc > 1) && JS_ToBool(ctx, argv[1]));
+		} else if (magic == 22) {
+			const auto mode = string(1).value_or(QString()).toStdString();
+			const auto i = ranges::find(ghostModes, mode, [](const auto &pair) {
+				return std::string(pair.second);
+			});
+			if (i == end(ghostModes)) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.tele.ghost.set: the mode is 'default', 'always' or "
+					"'never'");
+			}
+			SetChatGhostOverride(peer, i->first);
+		} else {
+			const auto user = peer->asUser();
+			if (!user) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.tele.localNames.set works for users");
+			}
+			SetUserLocalName(user, string(1).value_or(QString()));
+		}
+		return JS_UNDEFINED;
+	}
+	case 21: {
+		const auto peer = peerAt(0);
+		return peer
+			? JS_NewString(ctx, ghostName(ChatGhostOverride(peer)))
+			: JS_UNDEFINED;
+	}
+	case 23: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &chat : GhostChats(instance->_session)) {
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(chat.id)));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"mode",
+				JS_NewString(ctx, ghostName(chat.mode)));
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 24: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &entry : LocalNames(instance->_session)) {
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(entry.id)));
+			JS_SetPropertyStr(ctx, item, "name", NewString(ctx, entry.name));
+			JS_SetPropertyUint32(ctx, result, index++, item);
+		}
+		return result;
+	}
+	case 17: {
+		const auto program = string(0);
+		if (!program || program->isEmpty()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.unsafe.exec(program, args?, { cwd, input, timeout, "
+				"detached })");
+		}
+		auto args = QStringList();
+		auto length = std::int64_t();
+		if (argc > 1
+			&& JS_IsArray(argv[1])
+			&& JS_GetLength(ctx, argv[1], &length) >= 0) {
+			for (auto i = std::int64_t(); i != length; ++i) {
+				auto item = JS_GetPropertyUint32(
+					ctx,
+					argv[1],
+					std::uint32_t(i));
+				args.push_back(FromStd(ToStd(ctx, item)));
+				JS_FreeValue(ctx, item);
+			}
+		}
+		const auto options = (argc > 2) ? argv[2] : JS_UNDEFINED;
+		const auto cwd = JS_IsObject(options)
+			? StringProperty(ctx, options, "cwd")
+			: QString();
+		const auto input = JS_IsObject(options)
+			? StringProperty(ctx, options, "input")
+			: QString();
+		auto timeout = int64_t();
+		auto detached = false;
+		if (JS_IsObject(options)) {
+			auto value = JS_GetPropertyStr(ctx, options, "timeout");
+			if (JS_IsNumber(value)) {
+				JS_ToInt64(ctx, &timeout, value);
+			}
+			JS_FreeValue(ctx, value);
+			value = JS_GetPropertyStr(ctx, options, "detached");
+			detached = JS_ToBool(ctx, value);
+			JS_FreeValue(ctx, value);
+		}
+		auto created = instance->newPromise();
+		const auto key = created.first;
+		if (!key) {
+			return created.second;
+		}
+		if (detached) {
+			auto pid = qint64();
+			const auto started = QProcess::startDetached(
+				*program,
+				args,
+				cwd,
+				&pid);
+			const auto weak = base::make_weak(instance);
+			const auto name = *program;
+			crl::on_main(instance, [=] {
+				const auto strong = weak.get();
+				if (!strong || !strong->_engine) {
+					return;
+				}
+				const auto ctx = strong->_engine->ctx();
+				strong->settle(key, started, started
+					? JS_NewInt64(ctx, pid)
+					: MakeTeleError(
+						ctx,
+						"internal",
+						u"tg.unsafe.exec: can't start "_q + name));
+			});
+			return created.second;
+		}
+		const auto process = new QProcess();
+		process->setProgram(*program);
+		process->setArguments(args);
+		if (!cwd.isEmpty()) {
+			process->setWorkingDirectory(cwd);
+		}
+		instance->_processes.emplace(key, process);
+		const auto weak = base::make_weak(instance);
+		const auto finish = [=](bool ok, QString error) {
+			const auto strong = weak.get();
+			if (!strong || !strong->_processes.contains(key)) {
+				return;
+			}
+			strong->_processes.erase(key);
+			if (!strong->_engine) {
+				process->deleteLater();
+				return;
+			}
+			const auto ctx = strong->_engine->ctx();
+			if (!ok) {
+				strong->settle(key, false, MakeTeleError(
+					ctx,
+					(error == u"timed out"_q) ? "timed-out" : "internal",
+					u"tg.unsafe.exec: "_q + error));
+			} else {
+				auto result = JS_NewObject(ctx);
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"code",
+					JS_NewInt32(ctx, process->exitCode()));
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"crashed",
+					JS_NewBool(
+						ctx,
+						process->exitStatus() == QProcess::CrashExit));
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"stdout",
+					NewString(
+						ctx,
+						QString::fromUtf8(process->readAllStandardOutput())));
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"stderr",
+					NewString(
+						ctx,
+						QString::fromUtf8(process->readAllStandardError())));
+				strong->settle(key, true, result);
+			}
+			process->deleteLater();
+		};
+		QObject::connect(process, qOverload<int, QProcess::ExitStatus>(
+				&QProcess::finished), process, [=](
+				int,
+				QProcess::ExitStatus) {
+			finish(true, QString());
+		});
+		QObject::connect(process, &QProcess::errorOccurred, process, [=](
+				QProcess::ProcessError error) {
+			if (error == QProcess::FailedToStart) {
+				crl::on_main(process, [=] {
+					finish(false, u"can't start "_q + *program);
+				});
+			}
+		});
+		process->start();
+		if (!input.isEmpty()) {
+			process->write(input.toUtf8());
+		}
+		process->closeWriteChannel();
+		if (timeout > 0) {
+			base::call_delayed(timeout, instance, [=] {
+				const auto strong = weak.get();
+				if (strong && strong->_processes.contains(key)) {
+					process->kill();
+					finish(false, u"timed out"_q);
+				}
+			});
+		}
+		return created.second;
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+bool Instance::listens(const QString &event) const {
+	return ranges::any_of(_registrations, [&](const auto &pair) {
+		return (pair.second.kind == Kind::ScriptEvent)
+			&& (pair.second.key == event);
+	});
+}
+
+void Instance::receive(
+		const QString &event,
+		const QByteArray &payload,
+		const QString &fromId,
+		const QString &fromName) {
+	crl::on_main(this, [=] {
+		if (!_engine) {
+			return;
+		}
+		const auto ctx = _engine->ctx();
+		auto fns = std::vector<JSValue>();
+		for (const auto &[key, registration] : _registrations) {
+			if (registration.kind == Kind::ScriptEvent
+				&& registration.key == event) {
+				fns.push_back(JS_DupValue(ctx, registration.fn));
+			}
+		}
+		if (fns.empty()) {
+			return;
+		}
+		auto text = JS_NewStringLen(ctx, payload.constData(), payload.size());
+		JSValueConst loadArgs[] = { text };
+		auto data = CallGlobal(ctx, "__teleLoad", loadArgs);
+		JS_FreeValue(ctx, text);
+		if (JS_IsException(data)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			data = JS_NULL;
+		}
+		auto from = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, from, "id", NewString(ctx, fromId));
+		JS_SetPropertyStr(ctx, from, "name", NewString(ctx, fromName));
+		for (const auto fn : fns) {
+			if (!_engine) {
+				break;
+			}
+			JSValueConst args[] = { data, from };
+			JS_FreeValue(ctx, invoke(fn, args, kListenerBudget, u"scripts.on"_q));
+		}
+		if (_engine) {
+			release(fns);
+			JS_FreeValue(ctx, data);
+			JS_FreeValue(ctx, from);
+			_engine->drain();
+		}
+	});
+}
+
+void Instance::watchOptions() {
+	if (_watchingOptions) {
+		return;
+	}
+	_watchingOptions = true;
+	SettingChanges(
+	) | rpl::on_next([=](const QString &id) {
+		crl::on_main(this, [=] {
+			const auto found = FindSetting(id);
+			if (!_engine || !found) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, payload, "id", NewString(ctx, id));
+			JS_SetPropertyStr(ctx, payload, "value", SettingValue(ctx, *found));
+			callRegistered(Kind::OptionChange, payload, u"options.onChange"_q);
+		});
+	}, _optionsLifetime);
+}
+
+void Instance::watchCompose() {
+	if (_watchingCompose) {
+		return;
+	}
+	_watchingCompose = true;
+	ComposeChanges(
+	) | rpl::filter([=](const ComposeField &field) {
+		return (&field.peer->session() == _session.get());
+	}) | rpl::on_next([=](const ComposeField &field) {
+		const auto peerId = field.peer->id;
+		const auto text = field.field->getLastText();
+		crl::on_main(this, [=] {
+			if (!_engine) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				payload,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(peerId)));
+			JS_SetPropertyStr(ctx, payload, "text", NewString(ctx, text));
+			callRegistered(Kind::ComposeInput, payload, u"compose.onInput"_q);
+		});
+	}, _composeLifetime);
+}
+
+void Instance::attachShortcut(int id) {
+	const auto i = _registrations.find(id);
+	if (i == end(_registrations) || !_engine) {
+		return;
+	}
+	const auto window = WindowOf(_session);
+	if (!window) {
+		base::call_delayed(1000, this, [=] {
+			attachShortcut(id);
+		});
+		return;
+	}
+	auto shortcut = base::make_unique_q<QShortcut>(
+		QKeySequence::fromString(i->second.key, QKeySequence::PortableText),
+		window->widget().get());
+	shortcut->setContext(Qt::WindowShortcut);
+	const auto keys = i->second.key;
+	QObject::connect(shortcut.get(), &QShortcut::activated, [=] {
+		crl::on_main(this, [=] {
+			const auto j = _registrations.find(id);
+			if (!_engine || j == end(_registrations)) {
+				return;
+			}
+			const auto ctx = _engine->ctx();
+			auto fn = JS_DupValue(ctx, j->second.fn);
+			JS_FreeValue(
+				ctx,
+				invoke(fn, {}, kListenerBudget, u"shortcut "_q + keys));
+			JS_FreeValue(ctx, fn);
+			if (_engine) {
+				_engine->drain();
+			}
+		});
+	});
+	_shortcuts[id] = std::move(shortcut);
+}
