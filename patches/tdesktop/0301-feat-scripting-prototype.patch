--- /dev/null
+++ b/Telegram/Resources/tele/scripting/groupcalls.js
@@ -0,0 +1,47 @@
+(() => {
+	globalThis.__teleExtensions.push({
+		name: 'groupcalls',
+		tg(tg, natives, { resolvePeer }) {
+			const calls = tg.calls;
+			const define = (name, value) => Object.defineProperty(calls, name, {
+				value,
+				enumerable: true,
+				writable: true,
+				configurable: true,
+			});
+			const setOneToOneMuted = calls.setMuted;
+			const optionsOf = (options, what) => {
+				if (options === undefined || options === null) {
+					return {};
+				} else if (typeof options !== 'object') {
+					throw new TypeError(what);
+				}
+				return options;
+			};
+			define('group', () => natives.groupcallsCurrent());
+			define('onGroupChange', (callback) => {
+				if (typeof callback !== 'function') {
+					throw new TypeError('tg.calls.onGroupChange(function)');
+				}
+				const id = natives.groupcallsOnChange((change) => callback(change.call, change.changes));
+				return __teleDisposer(() => natives.groupcallsOff(id));
+			});
+			define('join', async (chat, options) => {
+				const { muted, joinAs } = optionsOf(options, 'tg.calls.join(chat, { muted?, joinAs? })');
+				const as = (joinAs === undefined || joinAs === null) ? null : await resolvePeer(joinAs);
+				return natives.groupcallsJoin(await resolvePeer(chat), muted === undefined ? true : Boolean(muted), as);
+			});
+			define('leave', () => natives.groupcallsLeave());
+			define('setMuted', (muted) => setOneToOneMuted(muted) || natives.groupcallsSetMuted(Boolean(muted)));
+			define('raiseHand', (raised) => natives.groupcallsRaiseHand(Boolean(raised)));
+			define('participants', async (chat, options) => {
+				const { limit } = optionsOf(options, 'tg.calls.participants(chat?, { limit? })');
+				if (limit !== undefined && (!Number.isInteger(limit) || limit < 1)) {
+					throw new TypeError('tg.calls.participants: limit must be a positive integer');
+				}
+				const input = (chat === undefined || chat === null) ? null : await resolvePeer(chat);
+				return natives.groupcallsParticipants(input, limit ?? 100);
+			});
+		},
+	});
+})();
diff --git a/Telegram/Resources/tele/scripting/inline.js b/Telegram/Resources/tele/scripting/inline.js
new file mode 100644
index 0000000000000000000000000000000000000000..5922a29e371411fd0a54f6038e2452aabc892a14
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/inline.js
@@ -0,0 +1,201 @@
+(() => {
+	const kMaxResults = 50;
+	const kKeptAnswers = 64;
+	const kMaxError = 200;
+	const kTrigger = /^[a-z][a-z0-9_]{1,31}$/;
+
+	const report = (where, error) => {
+		console.error(`${where}: ${error?.stack ?? error}`);
+	};
+
+	const messageOf = (error) => {
+		const text = (error instanceof Error) ? error.message : String(error);
+		return text.slice(0, kMaxError);
+	};
+
+	const checkMessage = (message) => {
+		if (typeof message === 'string') {
+			return message.trim() ? null : 'message must not be empty';
+		} else if (message === null || typeof message !== 'object') {
+			return 'message must be InputText or { media, caption? }';
+		} else if ('media' in message) {
+			const { media, caption } = message;
+			const inputMedia = media !== null
+				&& typeof media === 'object'
+				&& typeof media._ === 'string'
+				&& media._.startsWith('inputMedia');
+			if (!(media instanceof Uint8Array) && !inputMedia) {
+				return 'message.media must be a Uint8Array or a TL InputMedia';
+			} else if (caption !== undefined
+				&& typeof caption !== 'string'
+				&& (caption === null || typeof caption !== 'object' || typeof caption.text !== 'string')) {
+				return 'message.caption must be InputText';
+			}
+			return null;
+		} else if (typeof message.text === 'string') {
+			return message.text.trim() ? null : 'message must not be empty';
+		}
+		return 'message must be InputText or { media, caption? }';
+	};
+
+	const checkResult = (item, ids) => {
+		if (item === null || typeof item !== 'object') {
+			return 'a result must be an object';
+		} else if (typeof item.id !== 'string' || !item.id) {
+			return 'a result needs a non-empty string id';
+		} else if (ids.has(item.id)) {
+			return `the id '${item.id}' is used twice`;
+		} else if (typeof item.title !== 'string' || !item.title.trim()) {
+			return 'a result needs a non-empty title';
+		} else if (item.description !== undefined && typeof item.description !== 'string') {
+			return 'description must be a string';
+		} else if (item.thumb !== undefined && !(item.thumb instanceof Uint8Array)) {
+			return 'thumb must be a Uint8Array';
+		}
+		return checkMessage(item.message);
+	};
+
+	const normalize = (found, where) => {
+		if (found === undefined || found === null) {
+			return [];
+		} else if (!Array.isArray(found)) {
+			throw new TypeError('results must return an array of results or nothing');
+		}
+		const ids = new Set();
+		const valid = [];
+		for (const item of found) {
+			const problem = checkResult(item, ids);
+			if (problem) {
+				report(where, new TypeError(problem));
+				continue;
+			}
+			ids.add(item.id);
+			valid.push(item);
+			if (valid.length === kMaxResults) {
+				break;
+			}
+		}
+		return valid;
+	};
+
+	const startsWith = (bytes, offset, values) => values.every((value, index) => bytes[offset + index] === value);
+
+	const fileOf = (bytes) => {
+		if (startsWith(bytes, 0, [0xFF, 0xD8, 0xFF])) {
+			return { fileName: 'photo.jpg', asPhoto: true };
+		} else if (startsWith(bytes, 0, [0x89, 0x50, 0x4E, 0x47])) {
+			return { fileName: 'photo.png', asPhoto: true };
+		} else if (startsWith(bytes, 0, [0x47, 0x49, 0x46, 0x38])) {
+			return { fileName: 'animation.gif' };
+		} else if (startsWith(bytes, 4, [0x66, 0x74, 0x79, 0x70])) {
+			return { fileName: 'video.mp4' };
+		}
+		return { fileName: 'file' };
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'inline',
+		tg(tg, natives) {
+			Object.defineProperty(tg, 'registerInline', {
+				enumerable: true,
+				value: (answerer) => {
+					if (answerer === null || typeof answerer !== 'object' || typeof answerer.results !== 'function') {
+						throw new TypeError('tg.registerInline({ trigger, title?, results })');
+					}
+					const { trigger, title = '' } = answerer;
+					if (typeof trigger !== 'string' || !kTrigger.test(trigger)) {
+						throw new TypeError('tg.registerInline: trigger is 2-32 characters of a-z, 0-9 and _, starting with a letter');
+					} else if (typeof title !== 'string') {
+						throw new TypeError('tg.registerInline: title must be a string');
+					}
+					const where = `inline @${trigger}`;
+					const results = answerer.results;
+					const queries = new Map();
+					const answered = new Map();
+
+					const remember = (callId, list) => {
+						answered.set(callId, list);
+						while (answered.size > kKeptAnswers) {
+							answered.delete(answered.keys().next().value);
+						}
+					};
+
+					const query = (payload) => {
+						const { callId } = payload;
+						const controller = new AbortController();
+						queries.set(callId, controller);
+						const context = Object.freeze({ chat: payload.chat, signal: controller.signal });
+						void (async () => {
+							let answer;
+							try {
+								const list = normalize(await Reflect.apply(results, answerer, [payload.query, context]), where);
+								remember(callId, list);
+								answer = {
+									results: list.map(({ title, description, thumb }) => ({
+										title,
+										description: description ?? '',
+										thumb,
+									})),
+								};
+							} catch (error) {
+								if (!controller.signal.aborted) {
+									report(where, error);
+								}
+								answer = { error: messageOf(error) || 'error' };
+							}
+							queries.delete(callId);
+							if (!controller.signal.aborted) {
+								natives.inlineAnswer(callId, answer);
+							}
+						})();
+					};
+
+					const choose = (payload) => {
+						const result = answered.get(payload.callId)?.[payload.index];
+						if (!result) {
+							tg.toast(`@${trigger}: this result is gone, type the query again`);
+							return;
+						}
+						const options = {
+							...((payload.replyTo !== undefined) ? { replyTo: Number(payload.replyTo) } : {}),
+							...((payload.topicId !== undefined) ? { topicId: Number(payload.topicId) } : {}),
+							...(payload.silent ? { silent: true } : {}),
+							...((payload.scheduleDate !== undefined) ? { scheduleDate: Number(payload.scheduleDate) } : {}),
+						};
+						const { message } = result;
+						void (async () => {
+							try {
+								if (message !== null && typeof message === 'object' && 'media' in message) {
+									const caption = (message.caption !== undefined) ? { caption: message.caption } : {};
+									if (message.media instanceof Uint8Array) {
+										await tg.sendFile(payload.chat, message.media, { ...options, ...caption, ...fileOf(message.media) });
+									} else {
+										await tg.sendMedia(payload.chat, message.media, { ...options, ...caption });
+									}
+								} else {
+									await tg.sendMessage(payload.chat, message, options);
+								}
+							} catch (error) {
+								report(where, error);
+								tg.toast(`@${trigger}: ${messageOf(error)}`);
+							}
+						})();
+					};
+
+					const handler = (payload) => {
+						if (payload.kind === 'cancel') {
+							queries.get(payload.callId)?.abort();
+							queries.delete(payload.callId);
+						} else if (payload.kind === 'query') {
+							query(payload);
+						} else if (payload.kind === 'choose') {
+							choose(payload);
+						}
+					};
+					const id = natives.inlineRegister(trigger, title.trim(), handler);
+					return __teleDisposer(() => natives.inlineRemove(id));
+				},
+			});
+		},
+	});
+})();
