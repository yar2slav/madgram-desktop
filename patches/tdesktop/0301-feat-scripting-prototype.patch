+bool Instance::load() {
+	_engine = std::make_unique<Engine>(
+		_file.entry,
+		_file.root,
+		[=](LogLevel level, QString text, QByteArray values) {
+			log(level, std::move(text), std::move(values));
+		});
+	_engine->setOwner(this);
+	const auto ctx = _engine->ctx();
+	_unwrap = JS_Eval(
+		ctx,
+		kUnwrap,
+		std::strlen(kUnwrap),
+		"<tele>",
+		JS_EVAL_TYPE_GLOBAL);
+	if (JS_IsException(_unwrap)) {
+		_unwrap = JS_UNDEFINED;
+		_engine->report(u"starting"_q);
+		_error = _engine->lastError();
+		return false;
+	}
+	auto failure = QString();
+	_definition = _engine->load(failure);
+	if (!failure.isEmpty()) {
+		_error = failure;
+		return false;
+	} else if (!JS_IsObject(_definition)) {
+		_error = u"the default export isn't defineScript({ ... })"_q;
+		return false;
+	}
+	auto name = JS_GetPropertyStr(ctx, _definition, "name");
+	if (JS_IsString(name)) {
+		_name = FromStd(ToStd(ctx, name));
+	}
+	JS_FreeValue(ctx, name);
+	_meta = ScriptMeta{
+		.version = StringProperty(ctx, _definition, "version"),
+		.description = StringProperty(ctx, _definition, "description"),
+		.author = StringProperty(ctx, _definition, "author"),
+		.icon = StringProperty(ctx, _definition, "icon"),
+		.homepage = StringProperty(ctx, _definition, "homepage"),
+	};
+	if (HasProperty(ctx, _definition, "permissions")) {
+		_error = u"'permissions' is now 'grants'"_q;
+		return false;
+	}
+	auto declared = JS_GetPropertyStr(ctx, _definition, "grants");
+	auto list = QStringList();
+	auto valid = JS_IsUndefined(declared);
+	auto length = std::int64_t();
+	if (JS_IsArray(declared) && JS_GetLength(ctx, declared, &length) >= 0) {
+		valid = true;
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, declared, std::uint32_t(i));
+			if (JS_IsString(item)) {
+				list.push_back(FromStd(ToStd(ctx, item)));
+			} else {
+				valid = false;
+			}
+			JS_FreeValue(ctx, item);
+		}
+	}
+	JS_FreeValue(ctx, declared);
+	if (!valid) {
+		_error = u"grants must be an array of strings"_q;
+		return false;
+	}
+	auto error = QString();
+	auto warnings = QStringList();
+	_permissions = Permissions::Parse(list, error, &warnings);
+	if (!error.isEmpty()) {
+		_error = error;
+		return false;
+	}
+	for (const auto &warning : warnings) {
+		log(LogLevel::Warning, warning);
+	}
+	return true;
+}
