+
+void Updates::check(const QString &only, Fn<void(QString)> done) {
+	if (OfflineForLaunch()) {
+		if (done) {
+			done(Lower(u"Updates are off for this launch."_q));
+		}
+		return;
+	}
+	const auto folder = QDir(ScriptsFolder());
+	const auto now = crl::now();
+	auto started = false;
+	for (const auto &pair : Folder().sources) {
+		const auto id = pair.first;
+		const auto &source = pair.second;
+		if ((!only.isEmpty() && id != only)
+			|| !QFileInfo(folder.absoluteFilePath(id)).isFile()) {
+			continue;
+		} else if (!done) {
+			const auto i = _checked.find(id);
+			if (_checking.contains(id)
+				|| (i != end(_checked) && now - i->second < kUpdatesThrottle)) {
+				continue;
+			}
+		}
+		_checking.emplace(id);
+		_checked[id] = now;
+		started = true;
+		const auto url = source.url;
+		Fetch(&_network, QUrl(url), source.etag, kMaxUpdateSize, crl::guard(
+			this,
+			[=](ScriptDownload result) {
+				_checking.remove(id);
+				if (!result.error.isEmpty()) {
+					LOG(("script %1: can't check for updates: %2"
+						).arg(id, result.error));
+				} else if (!result.notModified) {
+					auto &sources = Folder().sources;
+					const auto i = sources.find(id);
+					if (i != end(sources) && i->second.url == url) {
+						i->second.etag = result.etag;
+						i->second.latest = PeekText(
+							result.content).meta.version;
+						WriteSettings();
+						Folder().sourcesChanged.fire({});
+					}
+				}
+				if (done) {
+					done(result.error);
+				}
+			}));
+	}
+	if (!started && done) {
+		done(QString());
+	}
+}
+
+[[nodiscard]] std::weak_ptr<Updates> &UpdatesInstance() {
+	static auto result = std::weak_ptr<Updates>();
+	return result;
+}
