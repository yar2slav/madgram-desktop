+
+void AddGiftsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "giftsRead", NativeGifts, 1, int(Op::Read) },
+		{ "giftsWrite", NativeGifts, 1, int(Op::Write) },
+	});
+}
+
+std::string_view GiftsTypings() {
+	return kTypings;
+}
+
+std::vector<Grant> GiftPaymentGrants(
+		std::string_view method,
+		std::string_view bytes) {
+	const auto offset = (method == "payments.getPaymentForm")
+		? kFormInvoiceOffset
+		: (method == "payments.sendStarsForm")
+		? kSendInvoiceOffset
+		: std::size_t();
+	if (!offset || bytes.size() <= offset) {
+		return {};
+	}
+	switch (LeadingId(bytes.substr(offset))) {
+	case mtpc_inputInvoiceStarGiftUpgrade:
+	case mtpc_inputInvoiceStarGiftTransfer:
+		return { Grant{
+			.capability = Capability::AccountWrite,
+			.scope = "gifts",
+		} };
+	}
+	return {};
+}
