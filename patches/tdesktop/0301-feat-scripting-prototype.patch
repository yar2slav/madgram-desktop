+void Host::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(file, u"tele_scripts"_q, directory(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version < 1
+		|| version > kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxEntries) {
+		return;
+	}
+	auto grants = base::flat_map<QString, QStringList>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = QString();
+		auto granted = QStringList();
+		file.stream >> id;
+		if (version > 1) {
+			file.stream >> granted;
+		}
+		if (version == 2) {
+			granted = MigrateGrants(granted);
+		}
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (!id.isEmpty()
+			&& id.size() <= kMaxIdLength
+			&& granted.size() <= kMaxGranted) {
+			grants.emplace(id, granted);
+		}
+	}
+	_grants = std::move(grants);
+}
+
+void Host::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &[id, granted] : _grants) {
+		size += Serialize::stringSize(id) + sizeof(quint32);
+		for (const auto &permission : granted) {
+			size += Serialize::stringSize(permission);
+		}
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_grants.size());
+	for (const auto &[id, granted] : _grants) {
+		data.stream << id << granted;
+	}
+	auto file = FileWriteDescriptor(u"tele_scripts"_q, directory());
+	file.writeEncrypted(data, key);
+}
+
+void Host::scheduleRefresh() {
+	_refreshTimer.callOnce(kRefreshDelay);
+}
+
+void Host::rescan() {
+	_refreshTimer.cancel();
+	refresh();
+}
+
+void Host::poll() {
+	if (_refreshTimer.isActive()) {
+		return;
+	}
+	const auto files = Scan(ScriptsFolder());
+	auto same = (files.size() == _entries.size());
+	for (auto i = 0; same && i != int(files.size()); ++i) {
+		same = (files[i].id == _entries[i].file.id)
+			&& (files[i].entry == _entries[i].file.entry);
+	}
+	if (!same) {
+		scheduleRefresh();
+		return;
+	}
+	for (const auto &entry : _entries) {
+		if (entry.instance && Changed(entry.stamps)) {
+			scheduleRefresh();
+			return;
+		}
+	}
+}
+
+void Host::watch(const std::vector<ScriptFile> &files) {
+	_watcher = nullptr;
+	const auto folder = ScriptsFolder();
+	if (!QDir(folder).exists()) {
+		return;
+	}
+	auto paths = QStringList{ QDir(folder).absolutePath() };
+	auto iterator = QDirIterator(
+		folder,
+		QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot,
+		QDirIterator::Subdirectories);
+	while (iterator.hasNext() && paths.size() < kMaxWatched) {
+		iterator.next();
+		const auto info = iterator.fileInfo();
+		const auto relative = QDir(folder).relativeFilePath(
+			info.absoluteFilePath());
+		if (ranges::any_of(relative.split('/'), Ignored)) {
+			continue;
+		} else if (info.isDir() || IsScriptFile(info.fileName())) {
+			paths.push_back(info.absoluteFilePath());
+		}
+	}
+	for (const auto &entry : _entries) {
+		for (const auto &[path, stamp] : entry.stamps) {
+			const auto info = QFileInfo(path);
+			const auto watched = info.exists() ? path : info.absolutePath();
+			if (paths.size() < kMaxWatched
+				&& QFileInfo(watched).exists()
+				&& !paths.contains(watched)) {
+				paths.push_back(watched);
+			}
+		}
+	}
+	_watcher = std::make_unique<QFileSystemWatcher>(paths);
+	QObject::connect(
+		_watcher.get(),
+		&QFileSystemWatcher::directoryChanged,
+		[=] { scheduleRefresh(); });
+	QObject::connect(
+		_watcher.get(),
+		&QFileSystemWatcher::fileChanged,
+		[=] { scheduleRefresh(); });
+}
+
+void Host::refresh() {
+	WriteTypings(ScriptsFolder());
+	const auto files = Scan(ScriptsFolder());
+	auto entries = std::vector<Entry>();
+	entries.reserve(files.size());
+	for (const auto &file : files) {
+		const auto i = ranges::find(_entries, file.id, [](const Entry &e) {
+			return e.file.id;
+		});
+		if (i != end(_entries) && i->file.entry == file.entry) {
+			entries.push_back(std::move(*i));
+		} else {
+			entries.push_back({ .file = file });
+		}
+	}
+	for (auto &entry : _entries) {
+		entry.instance = nullptr;
+	}
+	_entries = std::move(entries);
+	for (auto &entry : _entries) {
+		if (!_grants.contains(entry.file.id)) {
+			entry.instance = nullptr;
+			entry.error = QString();
+			entry.approval = false;
+			entry.requested = QStringList();
+			entry.stamps = Stamps();
+			if (entry.metaStamps.empty() || Changed(entry.metaStamps)) {
+				peek(entry);
+			}
+		} else if (Changed(entry.stamps)
+			|| (!entry.instance
+				&& entry.error.isEmpty()
+				&& !entry.approval)) {
+			start(entry, false);
+		} else if (entry.instance) {
+			for (const auto &path : entry.instance->files()) {
+				entry.stamps.emplace(path, Stamp(path));
+			}
+		}
+	}
+	watch(files);
+	_changes.fire({});
+}
+
+void Host::start(Entry &entry, bool interactive) {
+	entry.instance = nullptr;
+	entry.error = QString();
+	entry.approval = false;
+	entry.requested = QStringList();
+	const auto id = entry.file.id;
+	auto instance = std::make_unique<Instance>(
+		_session,
+		entry.file,
+		_storage.storage(id),
+		_storage.storage(id + u"\n#local"_q),
+		outputFor(id),
+		[=] { failed(id); });
+	instance->setChangedCallback(crl::guard(this, [=] {
+		_changes.fire({});
+	}));
+	const auto loaded = instance->load();
+	entry.stamps = Collect(entry.file, instance->files());
+	remember(entry, instance.get());
+	if (loaded) {
+		auto ignored = QString();
+		const auto i = _grants.find(id);
+		const auto granted = Permissions::Parse(
+			(i != end(_grants)) ? i->second : QStringList(),
+			ignored);
+		if (!granted.covers(instance->permissions())) {
+			entry.approval = true;
+			entry.requested = instance->permissions().strings();
+			LOG(("script %1: waiting for approval of %2"
+				).arg(id, entry.requested.join(u", "_q)));
+			append(id, LogLevel::Warning, u"waiting for approval of %1"_q.arg(
+				entry.requested.join(u", "_q)));
+			if (!interactive) {
+				notify(id, Lower(u"Script %1 asks for more grants, "
+					"review them in Settings > tele > Scripts."_q
+				).arg(instance->name()));
+			}
+			return;
+		}
+	}
+	const auto started = loaded && instance->run();
+	entry.stamps = Collect(entry.file, instance->files());
+	if (started) {
+		entry.instance = std::move(instance);
+	} else {
+		entry.error = instance->error();
+		LOG(("script %1: can't start: %2").arg(id, entry.error));
+		append(id, LogLevel::Fault, u"can't start: "_q + entry.error);
+		notify(id, Lower(u"Script %1: %2"_q).arg(
+			instance->name(),
+			entry.error));
+	}
+}
+
+Fn<void(LogLevel, QString, QString, QByteArray)> Host::outputFor(
+		const QString &id) {
+	return [=](LogLevel level, QString name, QString text, QByteArray values) {
+		output(id, level, name, text, std::move(values));
+	};
+}
+
+void Host::output(
+		const QString &id,
+		LogLevel level,
+		const QString &name,
+		const QString &text,
+		QByteArray values) {
+	append(id, level, text, std::move(values));
+	if (level == LogLevel::Fault && !id.isEmpty()) {
+		notify(id, Lower(u"Script %1: %2"_q).arg(name, text));
+	}
+}
+
+void Host::append(
+		const QString &id,
+		LogLevel level,
+		const QString &text,
+		QByteArray values) {
+	auto line = ScriptLogLine{
+		.time = QDateTime::currentMSecsSinceEpoch(),
+		.level = LevelName(level),
+		.text = text,
+		.values = std::move(values),
+	};
+	auto &log = [&]() -> std::deque<ScriptLogLine>& {
+		if (id.isEmpty()) {
+			return _replLog;
+		}
+		const auto i = ranges::find(_entries, id, [](const Entry &e) {
+			return e.file.id;
+		});
+		return (i != end(_entries)) ? i->log : _replLog;
+	}();
+	if (!id.isEmpty() && &log == &_replLog) {
+		return;
+	}
+	log.push_back(line);
+	while (log.size() > kMaxLogLines) {
+		log.pop_front();
+	}
+	if (log.size() > kMaxStructuredLines) {
+		log[log.size() - kMaxStructuredLines - 1].values = QByteArray();
+	}
+	_logged.fire({ .id = id, .line = std::move(line) });
+}
+
+int Host::emit(
+		const QString &from,
+		const QString &fromName,
+		const QString &event,
+		const QByteArray &payload,
+		const QString &target) {
+	auto count = 0;
+	for (const auto &entry : _entries) {
+		const auto instance = entry.instance.get();
+		if (!instance
+			|| entry.file.id == from
+			|| (!target.isEmpty() && entry.file.id != target)
+			|| !instance->listens(event)) {
+			continue;
+		}
+		++count;
+		instance->receive(event, payload, from, fromName);
+	}
+	return count;
+}
