+					return this.#protocol;
+				}
+
+				get extensions() {
+					return '';
+				}
+
+				get readyState() {
+					return this.#readyState;
+				}
+
+				get bufferedAmount() {
+					const live = (this.#readyState === 3) ? 0 : natives.websocketBuffered(this.#id);
+					return live + this.#discarded;
+				}
+
+				get binaryType() {
+					return 'arraybuffer';
+				}
+
+				set binaryType(value) {
+					if (String(value) === 'blob') {
+						throw new Exception(
+							"WebSocket: binaryType 'blob' is not supported, binary messages arrive as ArrayBuffer",
+							'NotSupportedError');
+					}
+				}
+
+				send(data) {
+					if (arguments.length < 1) {
+						throw new TypeError('WebSocket: send needs the data argument');
+					} else if (this.#readyState === 0) {
+						throw new Exception('WebSocket: send() while still connecting', 'InvalidStateError');
+					}
+					const payload = (data instanceof ArrayBuffer)
+						? data
+						: ArrayBuffer.isView(data)
+						? new Uint8Array(data.buffer, data.byteOffset, data.byteLength)
+						: String(data).toWellFormed();
+					if (this.#readyState !== 1 || !natives.websocketSend(this.#id, payload)) {
+						this.#discarded += (typeof payload === 'string')
+							? encoder.encode(payload).length
+							: payload.byteLength;
+					}
+				}
+
+				close(code = undefined, reason = undefined) {
+					let number = 0;
+					if (code !== undefined) {
+						const value = Number(code);
+						number = Number.isNaN(value) ? 0 : Math.min(65535, Math.max(0, Math.round(value)));
+						if (number !== 1000 && (number < 3000 || number > 4999)) {
+							throw new Exception(
+								`WebSocket: the close code must be 1000 or 3000-4999, not ${number}`,
+								'InvalidAccessError');
+						}
+					}
+					const text = (reason === undefined) ? '' : String(reason).toWellFormed();
+					if (encoder.encode(text).length > 123) {
+						throw new Exception('WebSocket: the close reason is over 123 bytes', 'SyntaxError');
+					} else if (this.#readyState >= 2) {
+						return;
+					}
+					this.#readyState = 2;
+					natives.websocketClose(this.#id, number, text);
+				}
+
+				#handle(type, value) {
+					const handler = (typeof value === 'function') ? value : null;
+					const current = this.#handlers.get(type);
+					if (!handler) {
+						if (current) {
+							this.#handlers.delete(type);
+							unlisten.call(this, type, current.listener);
+						}
+						return;
+					} else if (current) {
+						current.value = handler;
+						return;
+					}
+					const entry = { value: handler, listener: null };
+					entry.listener = (event) => entry.value.call(this, event);
+					this.#handlers.set(type, entry);
+					listen.call(this, type, entry.listener);
+				}
+
+				#receive(event) {
+					switch (event.type) {
+					case 'open':
+						if (this.#readyState !== 0) {
+							return;
+						}
+						this.#readyState = 1;
+						this.#protocol = event.protocol;
+						dispatch.call(this, new Plain('open'));
+						return;
+					case 'message':
+						if (this.#readyState !== 1) {
+							return;
+						}
+						dispatch.call(this, new Message('message', {
+							data: event.data,
+							origin: this.#origin,
+						}));
+						return;
+					case 'error':
+						this.#readyState = 3;
+						dispatch.call(this, new Plain('error'));
+						return;
+					case 'close':
+						this.#readyState = 3;
+						dispatch.call(this, new Close('close', {
+							code: event.code,
+							reason: event.reason,
+							wasClean: event.wasClean,
+						}));
+						return;
+					}
+				}
+			}
+
+			for (const [name, value] of Object.entries(states)) {
+				Object.defineProperty(WebSocket, name, { value, enumerable: true });
+				Object.defineProperty(WebSocket.prototype, name, { value, enumerable: true });
+			}
+			tag(WebSocket, 'WebSocket');
+			define('WebSocket', WebSocket);
+		},
+	});
+})();
diff --git a/Telegram/Resources/tele/scripting/webview.js b/Telegram/Resources/tele/scripting/webview.js
new file mode 100644
index 0000000000000000000000000000000000000000..e2dc3db9959046654695b4722c1f24fa9f05c919
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/webview.js
@@ -0,0 +1,152 @@
+(() => {
+	const minSize = 120;
+	const maxSize = 4096;
+
+	const dispatch = (list, ...args) => {
+		let failure = null;
+		const waits = [];
+		for (const callback of [...list]) {
+			try {
+				const result = callback(...args);
+				if (result && typeof result.then === 'function') {
+					waits.push(result);
+				}
+			} catch (error) {
+				failure ??= { error };
+			}
+		}
+		if (failure) {
+			throw failure.error;
+		}
+		return waits.length ? Promise.all(waits) : undefined;
+	};
+
+	const open = (natives, options) => {
+		if (typeof options !== 'object' || options === null) {
+			throw new TypeError('tg.ui.webview needs { title, html | url }');
+		}
+		const { title, html, url, width, height, resizable } = options;
+		if (typeof title !== 'string' || !title) {
+			throw new TypeError('tg.ui.webview needs a title');
+		}
+		const hasHtml = (html !== undefined);
+		const hasUrl = (url !== undefined);
+		if (hasHtml === hasUrl) {
+			throw new TypeError('tg.ui.webview needs either html or url');
+		} else if (hasHtml && typeof html !== 'string') {
+			throw new TypeError('tg.ui.webview: html is a string');
+		} else if (hasUrl && (typeof url !== 'string' || !url)) {
+			throw new TypeError('tg.ui.webview: url is a string');
+		}
+		for (const [name, value] of [['width', width], ['height', height]]) {
+			if (value !== undefined
+				&& (typeof value !== 'number'
+					|| !Number.isFinite(value)
+					|| value < minSize
+					|| value > maxSize)) {
+				throw new TypeError(`tg.ui.webview: ${name} is a number from ${minSize} to ${maxSize}`);
+			}
+		}
+		if (resizable !== undefined && typeof resizable !== 'boolean') {
+			throw new TypeError('tg.ui.webview: resizable is a boolean');
+		}
+		const messages = new Set();
+		const closes = new Set();
+		let closed = false;
+		const finish = () => {
+			if (closed) {
+				return undefined;
+			}
+			closed = true;
+			messages.clear();
+			const list = [...closes];
+			closes.clear();
+			return dispatch(list);
+		};
+		const id = natives.webviewOpen({
+			title,
+			html: hasHtml ? html : undefined,
+			url: hasUrl ? url : undefined,
+			width,
+			height,
+			resizable,
+		}, (event) => {
+			if (event.type === 'close') {
+				return finish();
+			} else if (event.type !== 'message' || closed || !messages.size) {
+				return undefined;
+			}
+			let data;
+			try {
+				data = JSON.parse(event.text);
+			} catch {
+				return undefined;
+			}
+			return dispatch(messages, data);
+		});
+		return Object.freeze({
+			postMessage(data) {
+				let text;
+				try {
+					text = JSON.stringify(data);
+				} catch (error) {
+					throw new TypeError(`WebviewPanel.postMessage needs JSON-serializable data: ${error?.message ?? error}`);
+				}
+				if (typeof text !== 'string') {
+					throw new TypeError('WebviewPanel.postMessage needs JSON-serializable data');
+				}
+				if (!closed) {
+					natives.webviewPost(id, text);
+				}
+			},
+			onMessage(callback) {
+				if (typeof callback !== 'function') {
+					throw new TypeError('WebviewPanel.onMessage needs a function');
+				}
+				const entry = (data) => callback(data);
+				if (!closed) {
+					messages.add(entry);
+				}
+				return __teleDisposer(() => messages.delete(entry));
+			},
+			setTitle(text) {
+				if (typeof text !== 'string' || !text) {
+					throw new TypeError('WebviewPanel.setTitle needs a non-empty string');
+				}
+				if (!closed) {
+					natives.webviewTitle(id, text);
+				}
+			},
+			close() {
+				if (closed) {
+					return;
+				}
+				natives.webviewClose(id);
+				finish();
+			},
+			onClose(callback) {
+				if (typeof callback !== 'function') {
+					throw new TypeError('WebviewPanel.onClose needs a function');
+				}
+				const entry = () => callback();
+				if (!closed) {
+					closes.add(entry);
+				}
+				return __teleDisposer(() => closes.delete(entry));
+			},
+			get closed() {
+				return closed;
+			},
+		});
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'webview',
+		tg(tg, natives) {
+			Object.defineProperty(tg.ui, 'webview', {
+				enumerable: true,
+				value: (options) => open(natives, options),
+			});
+		},
+	});
+})();
diff --git a/Telegram/Resources/tele/scripting/worker.js b/Telegram/Resources/tele/scripting/worker.js
new file mode 100644
index 0000000000000000000000000000000000000000..ef4240bcedc045aa9a219273ad4d1dc65eb53f6f
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/worker.js
@@ -0,0 +1,220 @@
+(() => {
+	const define = (name, value) => Object.defineProperty(globalThis, name, {
+		value,
+		writable: true,
+		configurable: true,
+	});
+
+	const slot = (target, type, self) => {
+		let handler = null;
+		let wrapper = null;
+		return {
+			get: () => handler,
+			set(value) {
+				if (wrapper) {
+					target.removeEventListener(type, wrapper);
+					wrapper = null;
+				}
+				handler = (typeof value === 'function') ? value : null;
+				if (handler) {
+					const current = handler;
+					wrapper = (event) => current.call(self, event);
+					target.addEventListener(type, wrapper);
+				}
+			},
+		};
+	};
+
+	const cloned = (send) => (...args) => {
+		try {
+			return send(...args);
+		} catch (error) {
+			if (error instanceof TypeError) {
+				throw new DOMException(error.message, 'DataCloneError');
+			}
+			throw error;
+		}
+	};
+
+	class ErrorEvent extends Event {
+		#message;
+		#filename;
+		#lineno;
+		#colno;
+		#error;
+
+		constructor(type, init = undefined) {
+			super(type, init);
+			this.#message = String(init?.message ?? '');
+			this.#filename = String(init?.filename ?? '');
+			this.#lineno = Number(init?.lineno ?? 0) >>> 0;
+			this.#colno = Number(init?.colno ?? 0) >>> 0;
+			this.#error = init?.error;
+		}
+		get message() {
+			return this.#message;
+		}
+		get filename() {
+			return this.#filename;
+		}
+		get lineno() {
+			return this.#lineno;
+		}
+		get colno() {
+			return this.#colno;
+		}
+		get error() {
+			return this.#error;
+		}
+	}
+	if (globalThis.ErrorEvent === undefined) {
+		define('ErrorEvent', ErrorEvent);
+	}
+
+	const located = (line) => {
+		const inner = /\((.+):(\d+):(\d+)\)$/.exec(line);
+		const outer = inner ? null : /^at (.+):(\d+):(\d+)$/.exec(line);
+		const match = inner ?? outer;
+		return (match && !match[1].startsWith('<'))
+			? { filename: match[1], lineno: Number(match[2]), colno: Number(match[3]) }
+			: null;
+	};
+
+	const describe = (error) => {
+		const message = 'Uncaught ' + ((error instanceof Error)
+			? (error.name + ': ' + error.message)
+			: __teleFormat(error));
+		const stack = (error instanceof Error && typeof error.stack === 'string')
+			? error.stack
+			: '';
+		for (const line of stack.split('\n')) {
+			const place = located(line.trim());
+			if (place) {
+				return { message, ...place };
+			}
+		}
+		return { message, filename: '', lineno: 0, colno: 0 };
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'worker',
+		globals(natives) {
+			const post = cloned(natives.workerPost);
+			class Worker extends EventTarget {
+				#id = 0;
+				#label = '';
+				#handlers;
+
+				constructor(path, options = undefined) {
+					super();
+					const href = (path instanceof URL) ? path.href : String(path);
+					const name = (options?.name === undefined) ? '' : String(options.name);
+					this.#label = name || href.slice(href.lastIndexOf('/') + 1);
+					this.#handlers = {
+						message: slot(this, 'message', this),
+						messageerror: slot(this, 'messageerror', this),
+						error: slot(this, 'error', this),
+					};
+					this.#id = natives.workerStart(href, name, (packet) => this.#receive(packet));
+				}
+				postMessage(data) {
+					post(this.#id, data);
+				}
+				terminate() {
+					natives.workerTerminate(this.#id);
+				}
+				get onmessage() {
+					return this.#handlers.message.get();
+				}
+				set onmessage(value) {
+					this.#handlers.message.set(value);
+				}
+				get onmessageerror() {
+					return this.#handlers.messageerror.get();
+				}
+				set onmessageerror(value) {
+					this.#handlers.messageerror.set(value);
+				}
+				get onerror() {
+					return this.#handlers.error.get();
+				}
+				set onerror(value) {
+					this.#handlers.error.set(value);
+				}
+				#receive(packet) {
+					if (packet.type !== 'error') {
+						this.dispatchEvent(new MessageEvent(packet.type, { data: packet.data }));
+						return;
+					}
+					const event = new globalThis.ErrorEvent('error', {
+						cancelable: true,
+						message: packet.message,
+						filename: packet.filename,
+						lineno: packet.lineno,
+						colno: packet.colno,
+					});
+					this.dispatchEvent(event);
+					if (!event.defaultPrevented) {
+						console.error('[worker ' + this.#label + '] ' + packet.message
+							+ (packet.filename
+								? (' at ' + packet.filename + ':' + packet.lineno + ':' + packet.colno)
+								: ''));
+					}
+				}
+			}
+			define('Worker', Worker);
+		},
+		scope(natives) {
+			for (const extension of globalThis.__teleExtensions) {
+				if (extension.name !== 'intl') {
+					continue;
+				}
+				try {
+					extension.globals?.(natives);
+				} catch (error) {
+					console.error('Intl is unavailable in this worker:', error);
+				}
+			}
+			const target = new EventTarget();
+			const handlers = {
+				message: slot(target, 'message', globalThis),
+				messageerror: slot(target, 'messageerror', globalThis),
+			};
+			const post = cloned(natives.workerScopePost);
+			define('self', globalThis);
+			Object.defineProperty(globalThis, 'name', {
+				value: natives.workerScopeName,
+				configurable: true,
+				enumerable: true,
+			});
+			define('postMessage', (data) => {
+				post(data);
+			});
+			define('close', () => natives.workerScopeClose());
+			define('reportError', (error) => {
+				natives.workerScopeReport(error);
+			});
+			define('addEventListener', (type, listener, options) => {
+				target.addEventListener(type, listener, options);
+			});
+			define('removeEventListener', (type, listener, options) => {
+				target.removeEventListener(type, listener, options);
+			});
+			define('dispatchEvent', (event) => target.dispatchEvent(event));
+			for (const type of ['message', 'messageerror']) {
+				Object.defineProperty(globalThis, 'on' + type, {
+					get: () => handlers[type].get(),
+					set: (value) => handlers[type].set(value),
+					configurable: true,
+					enumerable: true,
+				});
+			}
+			return {
+				dispatch: (type, data) => {
+					target.dispatchEvent(new MessageEvent(type, { data }));
+				},
+				describe,
+			};
+		},
+	});
+})();
