+JSValue Instance::TgRegister(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	const auto kind = Kind(magic);
+	const auto what = (kind == Kind::Listener)
+		? "tg.onUpdate"
+		: (kind == Kind::Rpc)
+		? "tg.interceptRpc"
+		: "tg.interceptUpdate";
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 2 || !JS_IsFunction(ctx, argv[1])) {
+		return JS_ThrowTypeError(ctx, "%s(name or names, function)", what);
+	}
+	auto keys = std::vector<std::string>();
+	auto length = std::int64_t();
+	if (JS_IsString(argv[0])) {
+		keys.push_back(ToStd(ctx, argv[0]));
+	} else if (JS_IsArray(argv[0])
+		&& JS_GetLength(ctx, argv[0], &length) >= 0) {
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, argv[0], std::uint32_t(i));
+			const auto valid = JS_IsString(item);
+			if (valid) {
+				keys.push_back(ToStd(ctx, item));
+			}
+			JS_FreeValue(ctx, item);
+			if (!valid) {
+				return JS_ThrowTypeError(ctx, "%s takes names as strings", what);
+			}
+		}
+	}
+	if (keys.empty()) {
+		return JS_ThrowTypeError(ctx, "%s needs at least one name", what);
+	}
+	const auto capability = (kind == Kind::Listener)
+		? Capability::OnUpdate
+		: (kind == Kind::Rpc)
+		? Capability::InterceptRpc
+		: Capability::InterceptUpdate;
+	const auto &permissions = instance->_permissions;
+	for (const auto &key : keys) {
+		const auto all = (key == "*");
+		if (kind == Kind::Rpc) {
+			const auto pattern = !key.empty() && (key.back() == '*');
+			if (pattern) {
+			} else if (!TlRuntime::BundledSchema().method(std::string_view(key))) {
+				return JS_ThrowTypeError(
+					ctx,
+					"%s: %s is not a method or a prefix ending with *",
+					what,
+					key.c_str());
+			} else if (TakeoverMethod(key)
+				&& !permissions.any(Capability::DisableApiFiltering)) {
+				return ThrowTeleError(
+					ctx,
+					"forbidden",
+					u"%1 can take over the account, intercepting it needs "
+						"the grant 'unsafe.disableApiFiltering'"_q.arg(
+							FromStd(key)));
+			}
+		} else if (!all && !IsUpdateName(key)) {
+			return JS_ThrowTypeError(
+				ctx,
+				"%s: %s is not an update",
+				what,
+				key.c_str());
+		}
+		const auto scope = all ? std::string_view() : std::string_view(key);
+		if (!permissions.allows(capability, scope)) {
+			return ThrowNotGranted(
+				ctx,
+				u"%1('%2')"_q.arg(QString::fromLatin1(what), FromStd(key)),
+				GrantText(capability, scope));
+		}
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = kind,
+		.keys = std::move(keys),
+		.fn = JS_DupValue(ctx, argv[1]),
+	});
+	return instance->disposer(id);
+}
