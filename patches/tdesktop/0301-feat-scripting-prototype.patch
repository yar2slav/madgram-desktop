+					const limit = limitOf(options?.limit, what);
+					const offset = offsetOf(options?.offset, what);
+					const input = await resolvePeer((peer === undefined || peer === null) ? 'me' : peer);
+					const result = await tg.call({ _: 'payments.getSavedStarGifts', peer: input, offset, limit });
+					const names = namesOf(result);
+					const now = Math.floor(Date.now() / 1000);
+					return {
+						gifts: result.gifts.map((saved) => savedOf(saved, input, names, now)),
+						count: result.count,
+						nextOffset: result.nextOffset || null,
+					};
+				},
+				async get(slug) {
+					const what = 'tg.gifts.get';
+					read(what);
+					const name = slugOf(slug, what);
+					try {
+						const result = await tg.call({ _: 'payments.getUniqueStarGift', slug: name });
+						return giftOf(result.gift, namesOf(result));
+					} catch (error) {
+						if (error instanceof RpcError && error.type === 'STARGIFT_SLUG_INVALID') {
+							throw new TeleError('not-found', `${what}: there's no unique gift ${name}`);
+						}
+						throw error;
+					}
+				},
+				async catalog() {
+					read('tg.gifts.catalog');
+					const result = await tg.call({ _: 'payments.getStarGifts', hash: 0 });
+					if (result._ !== 'payments.starGifts') {
+						return [];
+					}
+					const names = namesOf(result);
+					return result.gifts.map((raw) => giftOf(raw, names));
+				},
+				async value(slug) {
+					const what = 'tg.gifts.value';
+					read(what);
+					const name = slugOf(slug, what);
+					try {
+						const raw = await tg.call({ _: 'payments.getUniqueStarGiftValueInfo', slug: name });
+						return {
+							currency: raw.currency,
+							value: raw.value,
+							isAverage: raw.valueIsAverage === true,
+							lastSaleOnFragment: raw.lastSaleOnFragment === true,
+							initialSaleDate: raw.initialSaleDate,
+							initialSaleStars: raw.initialSaleStars,
+							initialSalePrice: raw.initialSalePrice,
+							lastSaleDate: raw.lastSaleDate ?? null,
+							lastSalePrice: raw.lastSalePrice ?? null,
+							floorPrice: raw.floorPrice ?? null,
+							raw,
+						};
+					} catch (error) {
+						if (error instanceof RpcError && error.type === 'STARGIFT_SLUG_INVALID') {
+							throw new TeleError('not-found', `${what}: there's no unique gift ${name}`);
+						}
+						throw error;
+					}
+				},
+				async transfer(gift, to) {
+					const what = 'tg.gifts.transfer';
+					write(what);
+					const stargift = inputOf(gift, what);
+					if (to === undefined || to === null) {
+						throw new TypeError(`${what}(gift, to) needs the new owner`);
+					}
+					const toId = await resolvePeer(to);
+					return done(await pay(
+						{ _: 'inputInvoiceStarGiftTransfer', stargift, toId },
+						() => tg.call({ _: 'payments.transferStarGift', stargift, toId }),
+						what));
+				},
+				async convert(gift) {
+					const what = 'tg.gifts.convert';
+					write(what);
+					await tg.call({ _: 'payments.convertStarGift', stargift: inputOf(gift, what) });
+				},
+				async upgrade(gift, options = {}) {
+					const what = 'tg.gifts.upgrade';
+					write(what);
+					const stargift = inputOf(gift, what);
+					const keep = (options?.keepDetails === true) ? { keepOriginalDetails: true } : {};
+					const free = () => tg.call({ _: 'payments.upgradeStarGift', ...keep, stargift });
+					if (savedOrNull(gift)?.upgradePrepaid) {
+						return done({ stars: 0n, updates: await free() });
+					}
+					return done(await pay({ _: 'inputInvoiceStarGiftUpgrade', ...keep, stargift }, free, what));
+				},
+				async sell(gift, options) {
+					const what = 'tg.gifts.sell';
+					write(what);
+					const price = options?.price;
+					const amount = (typeof price === 'bigint')
+						? price
+						: Number.isSafeInteger(price)
+						? BigInt(price)
+						: 0n;
+					if (amount <= 0n) {
+						throw new TypeError(`${what}(gift, { price }) needs a price in whole stars above 0`);
+					}
+					await setPrice(gift, amount, what);
+				},
+				async unlist(gift) {
+					write('tg.gifts.unlist');
+					await setPrice(gift, 0n, 'tg.gifts.unlist');
+				},
+				async setPinned(list, peer) {
+					const what = 'tg.gifts.setPinned';
+					write(what);
+					if (!Array.isArray(list)) {
+						throw new TypeError(`${what}(gifts, peer?) needs an array of gifts ([] unpins all)`);
+					}
+					const stargift = list.map((gift) => inputOf(gift, what));
+					const owner = (peer === undefined || peer === null)
+						? (stargift.find((input) => input._ === 'inputSavedStarGiftChat')?.peer ?? { _: 'inputPeerSelf' })
+						: await resolvePeer(peer);
+					await tg.call({ _: 'payments.toggleStarGiftsPinnedToTop', peer: owner, stargift });
+				},
+				async setVisible(gift, visible) {
+					const what = 'tg.gifts.setVisible';
+					write(what);
+					const stargift = inputOf(gift, what);
+					await tg.call({ _: 'payments.saveStarGift', ...((visible === false) ? { unsave: true } : {}), stargift });
+				},
+			});
+
+			const stars = Object.freeze({
+				async balance() {
+					read('tg.stars.balance');
+					const raw = await tg.call({ _: 'payments.getStarsStatus', peer: { _: 'inputPeerSelf' } });
+					return { ...starsOf(raw.balance), raw };
+				},
+				async history(options = {}) {
+					const what = 'tg.stars.history';
+					read(what);
+					const limit = limitOf(options?.limit, what);
+					const offset = offsetOf(options?.offset, what);
+					const raw = await tg.call({
+						_: 'payments.getStarsTransactions',
+						peer: { _: 'inputPeerSelf' },
+						offset,
+						limit,
+					});
+					const names = namesOf(raw);
+					return {
+						transactions: (raw.history ?? []).map((transaction) => {
+							const peer = (transaction.peer._ === 'starsTransactionPeer') ? markedId(transaction.peer.peer) : null;
+							return {
+								id: transaction.id,
+								...starsOf(transaction.amount),
+								date: transaction.date,
+								source: SOURCES[transaction.peer._] ?? 'unsupported',
+								peer,
+								peerName: (peer === null) ? null : (names.get(peer) ?? null),
+								title: transaction.title ?? null,
+								description: transaction.description ?? null,
+								refund: transaction.refund === true,
+								pending: transaction.pending === true,
+								failed: transaction.failed === true,
+								gift: transaction.stargift ? giftOf(transaction.stargift, names) : null,
+								raw: transaction,
+							};
+						}),
+						nextOffset: raw.nextOffset || null,
+					};
+				},
+			});
+
+			Object.defineProperty(tg, 'gifts', { value: gifts, enumerable: true });
+			Object.defineProperty(tg, 'stars', { value: stars, enumerable: true });
+		},
+	});
+})();
diff --git a/Telegram/Resources/tele/scripting/groupcalls.js b/Telegram/Resources/tele/scripting/groupcalls.js
