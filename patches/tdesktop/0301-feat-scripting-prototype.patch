+	void interrupt();
+	void setFaultHandler(Fn<void(JSValueConst)> handler);
+
+	[[nodiscard]] JSValue load(QString &error);
+	[[nodiscard]] JSValue call(
+		JSValueConst function,
+		JSValueConst self,
+		std::span<JSValueConst> args,
+		crl::time budget,
+		const QString &where);
+	void drain(bool flush = true);
+	void report(const QString &where);
+	void log(LogLevel level, QString text, QByteArray values = {});
+	[[nodiscard]] QString describe(JSValueConst error);
+	[[nodiscard]] QString lastError() const;
+	[[nodiscard]] int errors() const;
+	[[nodiscard]] const std::vector<QString> &files() const;
+	[[nodiscard]] std::optional<QByteArray> transpile(
+		const QByteArray &code,
+		QString &error);
+	[[nodiscard]] JSValue evaluate(const QByteArray &code, crl::time budget);
+
+public:
+	void rejected(JSValueConst promise, JSValueConst reason, bool handled);
+	void flushRejections();
+
+private:
+	struct Timer {
+		std::unique_ptr<base::Timer> timer;
+		JSValue function = JS_UNDEFINED;
+		bool repeat = false;
+	};
+	struct SourceSegment {
+		int generated = 0;
+		int original = 0;
+	};
+	using SourceLines = std::vector<std::vector<SourceSegment>>;
+
+	static int Interrupt(JSContext *ctx, void *opaque);
+	static char *Normalize(
+		JSContext *ctx,
+		const char *base,
+		const char *name,
+		void *opaque);
+	static JSModuleDef *Load(
+		JSContext *ctx,
+		const char *name,
+		void *opaque,
+		JSValueConst attributes);
+	static int CheckAttributes(
+		JSContext *ctx,
+		void *opaque,
+		JSValueConst attributes);
+	static JSValue MapColumn(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv);
+	[[nodiscard]] static SourceLines ParseSourceMap(
+		const QByteArray &code,
+		const QByteArray &map);
+	static JSValue Console(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic);
+	static JSValue SetTimer(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic);
+	static JSValue ClearTimer(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv);
+	static JSValue DefineScript(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv);
+	static int InitTeleModule(JSContext *ctx, JSModuleDef *module);
+
+	[[nodiscard]] std::optional<QString> resolve(
+		const QString &base,
+		const QString &name);
+	[[nodiscard]] std::optional<QByteArray> source(const QString &path);
+	[[nodiscard]] QString modulesLimit() const;
+	void installGlobals();
+	void enter(crl::time budget);
+	void leave();
+	void fire(int id);
+	[[nodiscard]] QString stringify(JSValueConst value);
+
+	const QString _entry;
+	const QString _root;
+	const Fn<void(LogLevel, QString, QByteArray)> _log;
+	const EngineKind _kind;
+	JSRuntime *_rt = nullptr;
+	JSContext *_ctx = nullptr;
+	crl::time _deadline = 0;
+	std::vector<std::pair<JSValue, JSValue>> _rejected;
+	int _depth = 0;
+	std::map<int, Timer> _timers;
+	int _timerId = 0;
+	QString _lastError;
+	void *_owner = nullptr;
+	int _errors = 0;
+	std::shared_ptr<StripWorker> _stripper;
+	std::vector<QString> _files;
+	std::map<QString, SourceLines> _sourceLines;
+	std::atomic<bool> _interrupted = false;
+	Fn<void(JSValueConst)> _fault;
+
+};
+
+[[nodiscard]] Engine *EngineOf(JSContext *ctx);
+
+} // namespace Tele::Scripting
