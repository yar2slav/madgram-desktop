+JSValue PinsList(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"dialogs",
+		"tg.tele.pins.list");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->session();
+	const auto folder = FolderAt(ctx, argc, argv, 0);
+	if (!folder || (*folder && !FolderExists(session, *folder))) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.pins.list: folder is a folder id from "
+			"tg.tele.folders.list() or 0");
+	}
+	return ChatsArray(ctx, LocalPinnedChats(session, *folder));
+}
+
+JSValue PinsSet(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto pinned = (argc > 2) && JS_ToBool(ctx, argv[2]) > 0;
+	const auto what = pinned ? "tg.tele.pins.pin" : "tg.tele.pins.unpin";
+	const auto instance = Permitted(ctx, Capability::Options, {}, what);
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->session();
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto peer = peerId ? session->data().peerLoaded(*peerId) : nullptr;
+	const auto folder = FolderAt(ctx, argc, argv, 1);
+	if (!peer) {
+		return JS_ThrowTypeError(ctx, "%s needs a chat in tele's cache", what);
+	} else if (!folder || (*folder && !FolderExists(session, *folder))) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: folder is a folder id from tg.tele.folders.list() or 0",
+			what);
+	} else if (!LocalPins()) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"%1: local pins are off in tele's settings"_q.arg(
+				QString::fromLatin1(what)));
+	}
+	const auto history = session->data().history(peer);
+	if (!SetLocalPin(history, *folder, pinned)) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"%1: tele can't pin this chat in that list"_q.arg(
+				QString::fromLatin1(what)));
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue FoldersList(JSContext *ctx) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto chats = instance->permissions().allows(
+		Capability::AccountRead,
+		"dialogs");
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	const auto marked = [&](const auto &histories, const auto &skip) {
+		auto ids = std::vector<PeerId>();
+		for (const auto &history : histories) {
+			if (!ranges::contains(skip, history)) {
+				ids.push_back(history->peer->id);
+			}
+		}
+		return ChatsArray(ctx, ids);
+	};
+	const auto none = std::vector<not_null<History*>>();
+	for (const auto &filter : instance->session()->data().chatsFilters().list()) {
+		const auto id = filter.id();
+		if (!id) {
+			continue;
+		}
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, item, "id", JS_NewInt32(ctx, id));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"title",
+			NewString(ctx, filter.titleText().text));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"emoji",
+			NewString(ctx, filter.iconEmoji()));
+		const auto color = filter.colorIndex();
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"color",
+			color ? JS_NewInt32(ctx, *color) : JS_NULL);
+		auto flags = JS_NewObject(ctx);
+		for (const auto &[name, flag] : kFolderFlags) {
+			JS_SetPropertyStr(
+				ctx,
+				flags,
+				name,
+				JS_NewBool(ctx, bool(filter.flags() & flag)));
+		}
+		JS_SetPropertyStr(ctx, item, "flags", flags);
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"shared",
+			JS_NewBool(ctx, filter.chatlist()));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"local",
+			JS_NewBool(ctx, IsLocalFolder(id)));
+		if (chats) {
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"include",
+				marked(filter.always(), filter.pinned()));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"exclude",
+				marked(filter.never(), none));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"pinned",
+				marked(filter.pinned(), none));
+		}
+		JS_SetPropertyUint32(ctx, result, index++, item);
+	}
+	return result;
+}
+
+enum class Parsed {
+	Missing,
+	Done,
+	Bad,
+};
+
+[[nodiscard]] Parsed HistoriesProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name,
+		not_null<Data::Session*> owner,
+		std::vector<not_null<History*>> &result) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	if (JS_IsUndefined(value)) {
+		return Parsed::Missing;
+	}
+	auto length = std::int64_t();
+	if (!JS_IsArray(value) || JS_GetLength(ctx, value, &length) < 0) {
+		JS_FreeValue(ctx, value);
+		return Parsed::Bad;
+	}
+	result.clear();
+	for (auto i = std::int64_t(); i != length; ++i) {
+		auto entry = JS_GetPropertyUint32(ctx, value, uint32_t(i));
+		const auto id = PeerOf(ctx, entry);
+		JS_FreeValue(ctx, entry);
+		const auto peer = id ? owner->peerLoaded(*id) : nullptr;
+		if (!peer) {
+			JS_FreeValue(ctx, value);
+			return Parsed::Bad;
+		}
+		const auto history = owner->history(peer);
+		if (!ranges::contains(result, history)) {
+			result.push_back(history);
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return Parsed::Done;
+}
+
+[[nodiscard]] FilterId NextFolderId(not_null<Main::Session*> session) {
+	if (const auto local = NewFolderId(session)) {
+		return local;
+	}
+	const auto &list = session->data().chatsFilters().list();
+	auto id = FilterId(2);
+	while (ranges::contains(list, id, &Data::ChatFilter::id)) {
+		++id;
+	}
+	return id;
+}
+
+JSValue FoldersSave(JSContext *ctx, int argc, JSValueConst *argv) {
+	auto id = std::int32_t();
+	if (argc > 0) {
+		JS_ToInt32(ctx, &id, argv[0]);
+	}
+	const auto creating = (id == 0);
+	const auto what = creating
+		? "tg.tele.folders.create"
+		: "tg.tele.folders.edit";
+	const auto instance = Permitted(ctx, Capability::Options, {}, what);
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 2 || !JS_IsObject(argv[1]) || id < 0) {
+		return JS_ThrowTypeError(ctx, "%s needs a folder object", what);
+	}
+	const auto spec = argv[1];
+	const auto session = instance->session();
+	const auto owner = &session->data();
+	const auto &list = owner->chatsFilters().list();
+	const auto i = ranges::find(list, FilterId(id), &Data::ChatFilter::id);
+	if (!creating && i == end(list)) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"%1: no folder %2"_q.arg(QString::fromLatin1(what)).arg(id));
+	} else if (!creating && IsUnsortedFolder(id)) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"%1: tele's unsorted folder can't be edited"_q.arg(
+				QString::fromLatin1(what)));
+	}
+	const auto was = creating ? Data::ChatFilter() : *i;
+	auto error = QString();
+	auto title = creating ? Data::ChatFilterTitle() : was.title();
+	auto value = JS_GetPropertyStr(ctx, spec, "title");
+	if (JS_IsString(value)) {
+		const auto text = FromStd(ToStd(ctx, value)).trimmed();
+		if (text.isEmpty()) {
+			error = u"title can't be empty"_q;
+		} else if (text != title.text.text) {
+			title = Data::ChatFilterTitle{
+				.text = TextWithEntities{ .text = text },
+				.isStatic = title.isStatic,
+			};
+		}
+	} else if (!JS_IsUndefined(value)) {
+		error = u"title is a string"_q;
+	} else if (creating) {
+		error = u"a new folder needs a title"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto emoji = was.iconEmoji();
+	value = JS_GetPropertyStr(ctx, spec, "emoji");
+	if (JS_IsString(value)) {
+		emoji = FromStd(ToStd(ctx, value));
+	} else if (!JS_IsUndefined(value)) {
+		error = u"emoji is a string"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto color = was.colorIndex();
+	value = JS_GetPropertyStr(ctx, spec, "color");
+	if (JS_IsNull(value)) {
+		color = std::nullopt;
+	} else if (JS_IsNumber(value)) {
+		auto number = 0.;
+		JS_ToFloat64(ctx, &number, value);
+		if (number != std::floor(number) || number < 0. || number > 255.) {
+			error = u"color is a color index (0 to 255) or null"_q;
+		} else {
+			color = uint8(number);
+		}
+	} else if (!JS_IsUndefined(value)) {
+		error = u"color is a color index (0 to 255) or null"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto flags = was.flags();
+	value = JS_GetPropertyStr(ctx, spec, "flags");
+	if (JS_IsObject(value)) {
+		for (const auto &[name, flag] : kFolderFlags) {
+			auto one = JS_GetPropertyStr(ctx, value, name);
+			if (JS_IsBool(one)) {
+				if (JS_ToBool(ctx, one) > 0) {
+					flags |= flag;
+				} else {
+					flags &= ~flag;
+				}
+			} else if (!JS_IsUndefined(one)) {
+				error = u"flags.%1 is a boolean"_q.arg(
+					QString::fromLatin1(name));
+			}
+			JS_FreeValue(ctx, one);
+		}
+	} else if (!JS_IsUndefined(value)) {
+		error = u"flags is an object of booleans"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto include = std::vector<not_null<History*>>();
+	for (const auto &history : was.always()) {
+		if (!ranges::contains(was.pinned(), history)) {
+			include.push_back(history);
+		}
+	}
+	auto pinned = was.pinned();
+	auto exclude = std::vector<not_null<History*>>(
+		was.never().begin(),
+		was.never().end());
+	const auto lists = std::array<
+		std::pair<const char*, std::vector<not_null<History*>>*>,
+		3>{ {
+		{ "include", &include },
+		{ "exclude", &exclude },
+		{ "pinned", &pinned },
+	} };
+	for (const auto &[name, target] : lists) {
+		const auto parsed = HistoriesProperty(ctx, spec, name, owner, *target);
+		if (parsed == Parsed::Bad) {
+			error = u"%1 is an array of chats in tele's cache"_q.arg(
+				QString::fromLatin1(name));
+		}
+	}
+	if (!error.isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: %s",
+			what,
+			error.toUtf8().constData());
+	}
+	auto always = base::flat_set<not_null<History*>>(
+		include.begin(),
+		include.end());
+	for (const auto &history : pinned) {
+		always.emplace(history);
+	}
+	const auto never = base::flat_set<not_null<History*>>(
+		exclude.begin(),
+		exclude.end());
+	const auto folderId = creating ? NextFolderId(session) : FilterId(id);
+	const auto filter = Data::ChatFilter(
+		folderId,
+		title,
+		emoji,
+		color,
+		flags,
+		std::move(always),
+		std::move(pinned),
+		never);
+	auto created = NewPending(ctx);
+	if (JS_IsException(created.second)) {
+		return created.second;
+	}
+	const auto pending = created.first;
+	const auto done = [=] {
+		Resolve(pending, [=](JSContext *context) {
+			return JS_NewInt32(context, folderId);
+		});
+	};
+	if (SaveLocalFolder(session, filter)) {
+		done();
+		return created.second;
+	}
+	const auto tl = filter.tl();
+	owner->chatsFilters().apply(MTP_updateDialogFilter(
+		MTP_flags(MTPDupdateDialogFilter::Flag::f_filter),
+		MTP_int(folderId),
+		tl));
+	const auto name = QString::fromLatin1(what);
+	session->api().request(MTPmessages_UpdateDialogFilter(
+		MTP_flags(MTPmessages_UpdateDialogFilter::Flag::f_filter),
+		MTP_int(folderId),
+		tl
+	)).done(done).fail([=](const MTP::Error &failure) {
+		if (creating) {
+			owner->chatsFilters().remove(folderId);
+		} else {
+			owner->chatsFilters().set(was);
+		}
+		Reject(
+			pending,
+			RefusalCode(failure.type()),
+			u"%1: the server refused: %2"_q.arg(name, failure.type()));
+	}).send();
+	return created.second;
+}
+
+JSValue FoldersDelete(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Options,
+		{},
+		"tg.tele.folders.delete");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto id = std::int32_t();
+	if (argc < 1 || !JS_IsNumber(argv[0]) || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.tele.folders.delete(id)");
+	}
+	const auto session = instance->session();
+	const auto owner = &session->data();
+	const auto &list = owner->chatsFilters().list();
+	const auto i = ranges::find(list, FilterId(id), &Data::ChatFilter::id);
+	if (!id || i == end(list)) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tg.tele.folders.delete: no folder %1"_q.arg(id));
+	} else if (IsUnsortedFolder(id)) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"tg.tele.folders.delete: tele's unsorted folder is a setting"_q);
+	}
+	const auto was = *i;
+	auto created = NewPending(ctx);
+	if (JS_IsException(created.second)) {
+		return created.second;
+	}
+	const auto pending = created.first;
+	const auto done = [=] {
+		Resolve(pending, [](JSContext*) {
+			return JS_UNDEFINED;
+		});
+	};
+	owner->chatsFilters().apply(MTP_updateDialogFilter(
+		MTP_flags(MTPDupdateDialogFilter::Flag(0)),
+		MTP_int(id),
+		MTPDialogFilter()));
+	if (IsLocalFolder(id)) {
+		done();
+		return created.second;
+	}
+	session->api().request(MTPmessages_UpdateDialogFilter(
+		MTP_flags(MTPmessages_UpdateDialogFilter::Flag(0)),
+		MTP_int(id),
+		MTPDialogFilter()
+	)).done(done).fail([=](const MTP::Error &failure) {
+		owner->chatsFilters().set(was);
+		Reject(
+			pending,
+			RefusalCode(failure.type()),
+			u"tg.tele.folders.delete: the server refused: %1"_q.arg(
+				failure.type()));
+	}).send();
+	return created.second;
+}
