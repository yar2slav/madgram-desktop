+std::vector<JSValue> Instance::listenersFor(std::string_view name) const {
+	auto result = std::vector<JSValue>();
+	const auto ctx = _engine->ctx();
+	for (const auto &[id, registration] : _registrations) {
+		const auto matches = (registration.kind == Kind::Listener)
+			&& ranges::any_of(registration.keys, [&](const std::string &key) {
+				return (key == name) || (key == "*");
+			});
+		if (matches) {
+			result.push_back(JS_DupValue(ctx, registration.fn));
+		}
+	}
+	return result;
+}
+
+bool Instance::listens() const {
+	return _started
+		&& ranges::any_of(_registrations, [](const auto &pair) {
+			return pair.second.kind == Kind::Listener;
+		});
+}
+
+bool Instance::interceptsUpdates() const {
+	return _started
+		&& ranges::any_of(_registrations, [](const auto &pair) {
+			return pair.second.kind == Kind::Update;
+		});
+}
+
+std::vector<int> Instance::middlewares(std::string_view method) const {
+	auto result = std::vector<int>();
+	if (!_started) {
+		return result;
+	}
+	const auto matches = [&](const std::string &key) {
+		if (key == method) {
+			return true;
+		} else if (key.empty() || key.back() != '*') {
+			return false;
+		}
+		const auto prefix = std::string_view(key).substr(0, key.size() - 1);
+		return method.starts_with(prefix)
+			&& _permissions.allows(Capability::InterceptRpc, method);
+	};
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::Rpc
+			&& ranges::any_of(registration.keys, matches)) {
+			result.push_back(id);
+		}
+	}
+	return result;
+}
+
+bool Instance::hasRegistration(int id) const {
+	return _started && _registrations.contains(id);
+}
+
+JSValue Instance::then(JSValue promise, JSCFunctionMagic *function, int key) {
+	const auto ctx = _engine->ctx();
+	auto method = JS_GetPropertyStr(ctx, promise, "then");
+	JSValue handlers[] = {
+		JS_NewCFunctionMagic(
+			ctx,
+			function,
+			"settled",
+			1,
+			JS_CFUNC_generic_magic,
+			key * 2 + 1),
+		JS_NewCFunctionMagic(
+			ctx,
+			function,
+			"failed",
+			1,
+			JS_CFUNC_generic_magic,
+			key * 2),
+	};
+	auto result = JS_Call(ctx, method, promise, 2, handlers);
+	JS_FreeValue(ctx, handlers[0]);
+	JS_FreeValue(ctx, handlers[1]);
+	JS_FreeValue(ctx, method);
+	JS_FreeValue(ctx, promise);
+	return result;
+}
+
+void Instance::runMiddleware(
+		int id,
+		const TlRuntime::Combinator &method,
+		std::string request,
+		MiddlewareNext next,
+		MiddlewareFinish finish) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		finish({});
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	const auto where = u"interceptRpc %1"_q.arg(FromStd(method.name));
+	auto decoded = DecodeTl(ctx, request, "Object");
+	if (!decoded.error.empty()) {
+		log(
+			LogLevel::Warning,
+			where + u": can't read the request: "_q + FromStd(decoded.error));
+		finish({});
+		return;
+	}
+	const auto key = ++_middlewareKey;
+	_middlewares.emplace(key, Middleware{
+		.next = std::move(next),
+		.finish = std::move(finish),
+		.method = &method,
+		.where = where,
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleMiddleware");
+	JS_FreeValue(ctx, global);
+	auto fn = JS_DupValue(ctx, i->second.fn);
+	auto name = JS_NewStringLen(ctx, method.name.data(), method.name.size());
+	auto forward = JS_NewCFunctionMagic(
+		ctx,
+		NextCalled,
+		"next",
+		1,
+		JS_CFUNC_generic_magic,
+		key);
+	JSValueConst args[] = { fn, decoded.value, name, forward };
+	auto promise = invoke(runner, args, kListenerBudget, where);
+	for (const auto value : { runner, fn, name, forward, decoded.value }) {
+		JS_FreeValue(ctx, value);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishMiddleware(key, {});
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, MiddlewareSettled, key));
+	_engine->drain();
+	if (!_middlewares.contains(key)) {
+		return;
+	}
+	base::call_delayed(kMiddlewareBudget, this, [=] {
+		const auto j = _middlewares.find(key);
+		if (j == end(_middlewares)) {
+			return;
+		}
+		const auto called = j->second.nextCalled;
+		fault(where, u"took longer than 10 s"_q);
+		finishMiddleware(key, called
+			? MiddlewareOutcome()
+			: MiddlewareOutcome{ EncodeRpcError(400, "SCRIPT_TIMEOUT") });
+	});
+}
+
+JSValue Instance::NextCalled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto i = instance->_middlewares.find(magic);
+	if (i == end(instance->_middlewares)) {
+		return ThrowTeleError(
+			ctx,
+			"handle-expired",
+			u"next() was called after the request was answered"_q);
+	}
+	auto &middleware = i->second;
+	if (middleware.nextCalled) {
+		return JS_ThrowTypeError(ctx, "next() can only be called once");
+	}
+	auto encoded = EncodeMethod(ctx, (argc > 0) ? argv[0] : JS_UNDEFINED);
+	if (!encoded.error.empty()) {
+		return JS_ThrowTypeError(ctx, "next(): %s", encoded.error.c_str());
+	} else if (encoded.method != middleware.method->name) {
+		return JS_ThrowTypeError(
+			ctx,
+			"next() takes a %s request, not %s",
+			middleware.method->name.c_str(),
+			encoded.method.c_str());
+	}
+	auto created = instance->newPromise();
+	if (!created.first) {
+		return created.second;
+	}
+	middleware.nextCalled = true;
+	const auto call = created.first;
+	instance->_calls[call].type = middleware.method->type;
+	const auto weak = base::make_weak(instance);
+	middleware.next(std::move(encoded.bytes), [=](std::string result) {
+		if (const auto strong = weak.get()) {
+			strong->nextResult(magic, call, std::move(result));
+		}
+	});
+	return created.second;
+}
+
+void Instance::nextResult(int key, int call, std::string bytes) {
+	if (!_engine) {
+		return;
+	}
+	const auto i = _calls.find(call);
+	if (i == end(_calls)) {
+		return;
+	} else if (LeadingId(bytes) == kRpcErrorId) {
+		settle(call, false, rpcErrorFrom(bytes));
+		return;
+	}
+	auto decoded = DecodeTl(_engine->ctx(), bytes, i->second.type, filter());
+	if (!decoded.error.empty()) {
+		settle(
+			call,
+			false,
+			rpcError(0, u"can't read the result: "_q + FromStd(decoded.error)));
+		return;
+	}
+	if (decoded.filtered) {
+		if (const auto j = _middlewares.find(key); j != end(_middlewares)) {
+			j->second.filtered = true;
+		}
+	}
+	settle(call, true, decoded.value);
+}
+
+JSValue Instance::MiddlewareSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_middlewares.find(key);
+	if (i == end(instance->_middlewares)) {
+		return JS_UNDEFINED;
+	}
+	const auto where = i->second.where;
+	const auto filtered = i->second.filtered;
+	const auto type = i->second.method->type;
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		instance->finishMiddleware(key, {});
+		return JS_UNDEFINED;
+	}
+	auto kind = JS_GetPropertyStr(ctx, value, "kind");
+	const auto name = ToStd(ctx, kind);
+	JS_FreeValue(ctx, kind);
+	auto result = JS_GetPropertyStr(ctx, value, "value");
+	auto outcome = MiddlewareOutcome();
+	if (name == "value") {
+		if (filtered
+			&& !instance->_permissions.any(Capability::DisableApiFiltering)) {
+			instance->log(
+				LogLevel::Warning,
+				where
+					+ u": the result has hidden data, changing it needs "
+						"the grant 'unsafe.disableApiFiltering', "
+						"the original result is used"_q);
+		} else {
+			auto encoded = EncodeTl(ctx, result, type);
+			if (encoded.error.empty()) {
+				outcome.bytes = std::move(encoded.bytes);
+			} else {
+				instance->fault(
+					where,
+					u"the returned result is wrong, ignoring it: "_q
+						+ FromStd(encoded.error));
+			}
+		}
+	} else if (name == "error") {
+		auto code = JS_GetPropertyStr(ctx, result, "code");
+		auto text = JS_GetPropertyStr(ctx, result, "type");
+		auto number = 400;
+		if (JS_IsNumber(code)) {
+			JS_ToInt32(ctx, &number, code);
+		}
+		outcome.bytes = EncodeRpcError(number, ToStd(ctx, text));
+		JS_FreeValue(ctx, code);
+		JS_FreeValue(ctx, text);
+	} else if (name == "throw") {
+		instance->fault(where, instance->_engine->describe(result));
+		outcome.bytes = EncodeRpcError(400, "SCRIPT_FAILED");
+	} else if (name == "nothing" || name == "null") {
+		instance->fault(where, (name == "null")
+			? u"returned null"_q
+			: u"returned nothing without calling next()"_q);
+		outcome.bytes = EncodeRpcError(400, "SCRIPT_FAILED");
+	}
+	JS_FreeValue(ctx, result);
+	instance->finishMiddleware(key, std::move(outcome));
+	return JS_UNDEFINED;
+}
+
+void Instance::finishMiddleware(int key, MiddlewareOutcome outcome) {
+	const auto i = _middlewares.find(key);
+	if (i == end(_middlewares)) {
+		return;
+	}
+	auto finish = std::move(i->second.finish);
+	_middlewares.erase(i);
+	finish(std::move(outcome));
+}
+
+void Instance::interceptUpdates(
+		std::string bytes,
+		Fn<void(std::optional<std::string>)> done) {
+	if (!_engine || !interceptsUpdates()) {
+		done(std::nullopt);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto decoded = DecodeTl(ctx, bytes, "Object");
+	if (!decoded.error.empty()) {
+		log(
+			LogLevel::Warning,
+			u"interceptUpdate: can't read updates: "_q
+				+ FromStd(decoded.error));
+		done(std::nullopt);
+		return;
+	}
+	auto handlers = JS_NewObject(ctx);
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind != Kind::Update) {
+			continue;
+		}
+		for (const auto &key : registration.keys) {
+			auto list = JS_GetPropertyStr(ctx, handlers, key.c_str());
+			if (!JS_IsArray(list)) {
+				JS_FreeValue(ctx, list);
+				list = JS_NewArray(ctx);
+				JS_SetPropertyStr(
+					ctx,
+					handlers,
+					key.c_str(),
+					JS_DupValue(ctx, list));
+			}
+			auto length = std::int64_t();
+			JS_GetLength(ctx, list, &length);
+			JS_SetPropertyUint32(
+				ctx,
+				list,
+				std::uint32_t(length),
+				JS_DupValue(ctx, registration.fn));
+			JS_FreeValue(ctx, list);
+		}
+	}
+	auto options = JS_NewObject(ctx);
+	const auto current = filter();
+	JS_SetPropertyStr(
+		ctx,
+		options,
+		"unfiltered",
+		JS_NewBool(ctx, !current.sensitive));
+	JS_SetPropertyStr(ctx, options, "drafts", JS_NewBool(ctx, !current.drafts));
+	const auto key = ++_updateRunKey;
+	_updateRuns.emplace(key, UpdateRun{ .done = std::move(done) });
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunUpdates");
+	JS_FreeValue(ctx, global);
+	auto report = JS_NewCFunctionMagic(
+		ctx,
+		UpdateFault,
+		"fault",
+		2,
+		JS_CFUNC_generic_magic,
+		key);
+	JSValueConst args[] = { decoded.value, handlers, report, options };
+	auto promise = invoke(runner, args, kListenerBudget, u"interceptUpdate"_q);
+	for (const auto value : { runner, report, options, handlers }) {
+		JS_FreeValue(ctx, value);
+	}
+	JS_FreeValue(ctx, decoded.value);
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishUpdates(key, std::nullopt);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, UpdatesSettled, key));
+	_engine->drain();
+	if (!_updateRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kUpdateBudget, this, [=] {
+		if (_updateRuns.contains(key)) {
+			fault(
+				u"interceptUpdate"_q,
+				u"took longer than 2 s, the updates went through as they were"_q);
+			finishUpdates(key, std::nullopt);
+		}
+	});
+}
+
+JSValue Instance::UpdateFault(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (instance && argc > 1) {
+		instance->fault(
+			FromStd(ToStd(ctx, argv[0])),
+			instance->_engine->describe(argv[1]));
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::UpdatesSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	if (!instance->_updateRuns.contains(key)) {
+		return JS_UNDEFINED;
+	}
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(
+			u"interceptUpdate"_q,
+			instance->_engine->describe(value));
+		instance->finishUpdates(key, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto changed = JS_GetPropertyStr(ctx, value, "changed");
+	const auto touched = JS_ToBool(ctx, changed);
+	JS_FreeValue(ctx, changed);
+	if (!touched) {
+		instance->finishUpdates(key, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto container = JS_GetPropertyStr(ctx, value, "value");
+	auto encoded = EncodeTl(ctx, container, "Object");
+	JS_FreeValue(ctx, container);
+	if (!encoded.error.empty()) {
+		instance->fault(
+			u"interceptUpdate"_q,
+			u"the changed updates are wrong, the originals went through: "_q
+				+ FromStd(encoded.error));
+		instance->finishUpdates(key, std::nullopt);
+	} else {
+		instance->finishUpdates(key, std::move(encoded.bytes));
+	}
+	return JS_UNDEFINED;
+}
+
+void Instance::finishUpdates(int key, std::optional<std::string> result) {
+	const auto i = _updateRuns.find(key);
+	if (i == end(_updateRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_updateRuns.erase(i);
+	done(std::move(result));
+}
+
+JSValue Instance::rpcErrorFrom(std::string_view bytes) {
+	const auto ctx = _engine->ctx();
+	auto decoded = DecodeTl(ctx, bytes, "Object");
+	if (!decoded.error.empty()) {
+		return rpcError(0, u"can't read the error"_q);
+	}
+	auto code = JS_GetPropertyStr(ctx, decoded.value, "errorCode");
+	auto text = JS_GetPropertyStr(ctx, decoded.value, "errorMessage");
+	auto number = 0;
+	JS_ToInt32(ctx, &number, code);
+	auto result = rpcError(number, FromStd(ToStd(ctx, text)));
+	JS_FreeValue(ctx, code);
+	JS_FreeValue(ctx, text);
+	JS_FreeValue(ctx, decoded.value);
+	return result;
+}
+
+void Instance::updates(std::string_view reply) {
+	if (!listens()) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto decoded = DecodeTl(ctx, reply, "Object", filter());
+	if (!decoded.error.empty()) {
+		log(
+			LogLevel::Warning,
+			u"can't read updates: "_q + FromStd(decoded.error));
+		return;
+	}
+	const auto unfiltered = _permissions.any(Capability::DisableApiFiltering);
+	JSValueConst args[] = { decoded.value };
+	auto list = _engine->call(
+		_unwrap,
+		JS_UNDEFINED,
+		args,
+		kListenerBudget,
+		u"updates"_q);
+	JS_FreeValue(ctx, decoded.value);
+	auto length = std::int64_t();
+	if (JS_GetLength(ctx, list, &length) < 0) {
+		JS_FreeValue(ctx, list);
+		return;
+	}
+	for (auto i = std::int64_t(); i != length && listens(); ++i) {
+		auto pair = JS_GetPropertyUint32(ctx, list, std::uint32_t(i));
+		auto update = JS_GetPropertyUint32(ctx, pair, 0);
+		auto peers = JS_GetPropertyUint32(ctx, pair, 1);
+		auto type = JS_GetPropertyStr(ctx, update, "_");
+		const auto name = ToStd(ctx, type);
+		JS_FreeValue(ctx, type);
+		auto hooks = (unfiltered || name != "updateServiceNotification")
+			? listenersFor(name)
+			: std::vector<JSValue>();
+		const auto where = u"onUpdate %1"_q.arg(FromStd(name));
+		for (const auto hook : hooks) {
+			JSValueConst call[] = { update, peers };
+			JS_FreeValue(ctx, invoke(hook, call, kListenerBudget, where));
+		}
+		release(hooks);
+		JS_FreeValue(ctx, peers);
+		JS_FreeValue(ctx, update);
+		JS_FreeValue(ctx, pair);
+	}
+	JS_FreeValue(ctx, list);
+	_engine->drain();
+}
