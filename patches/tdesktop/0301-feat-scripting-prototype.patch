+	}
+	const label = String(node[1]);
+	if (kind !== 'o' || label !== 'Object') {
+		box.appendChild(labelSpan(label));
+		box.appendChild(document.createTextNode(' '));
+	}
+	if (kind === 'o') {
+		previewEntries(box, node, '{', '}', function (entry) {
