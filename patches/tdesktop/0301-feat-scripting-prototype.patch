diff --git a/Telegram/Resources/tele/scripting/fs.js b/Telegram/Resources/tele/scripting/fs.js
new file mode 100644
index 0000000000000000000000000000000000000000..1a470c7ec928af6bf0c64874cdb8b5a9e976a536
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/fs.js
@@ -0,0 +1,73 @@
+(() => {
+	const checkPath = (method, value, name = 'path') => {
+		if (typeof value !== 'string' || value === '') {
+			throw new TypeError(`tg.fs.${method}: ${name} is a non-empty string`);
+		}
+		return value;
+	};
+	const option = (method, options, name) => {
+		if (options === undefined || options === null) {
+			return false;
+		} else if (typeof options !== 'object') {
+			throw new TypeError(`tg.fs.${method}: options is an object`);
+		}
+		return Boolean(options[name]);
+	};
+	const bytesOf = (value) => {
+		if (value instanceof Uint8Array || value instanceof ArrayBuffer) {
+			return value;
+		} else if (ArrayBuffer.isView(value)) {
+			return new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
+		}
+		throw new TypeError('tg.fs.writeBytes: bytes are a Uint8Array, an ArrayBuffer or an ArrayBuffer view');
+	};
+	globalThis.__teleExtensions.push({
+		name: 'fs',
+		tg(tg, natives) {
+			const fs = {
+				root: natives.fsRoot(),
+				async readText(path) {
+					return natives.fsReadText(checkPath('readText', path));
+				},
+				async readBytes(path) {
+					return natives.fsReadBytes(checkPath('readBytes', path));
+				},
+				async writeText(path, text, options) {
+					checkPath('writeText', path);
+					if (typeof text !== 'string') {
+						throw new TypeError('tg.fs.writeText: text is a string');
+					}
+					return natives.fsWriteText(path, text, option('writeText', options, 'append'));
+				},
+				async writeBytes(path, bytes, options) {
+					checkPath('writeBytes', path);
+					return natives.fsWriteBytes(path, bytesOf(bytes), option('writeBytes', options, 'append'));
+				},
+				async list(path = '.') {
+					return natives.fsList(checkPath('list', path));
+				},
+				async stat(path) {
+					return natives.fsStat(checkPath('stat', path));
+				},
+				async exists(path) {
+					return natives.fsExists(checkPath('exists', path));
+				},
+				async mkdir(path, options) {
+					checkPath('mkdir', path);
+					return natives.fsMkdir(path, option('mkdir', options, 'recursive'));
+				},
+				async remove(path, options) {
+					checkPath('remove', path);
+					return natives.fsRemove(path, option('remove', options, 'recursive'));
+				},
+				async rename(from, to) {
+					return natives.fsRename(checkPath('rename', from, 'from'), checkPath('rename', to, 'to'));
+				},
+				async copy(from, to) {
+					return natives.fsCopy(checkPath('copy', from, 'from'), checkPath('copy', to, 'to'));
+				},
+			};
+			Object.defineProperty(tg, 'fs', { value: Object.freeze(fs), enumerable: true });
+		},
+	});
+})();
