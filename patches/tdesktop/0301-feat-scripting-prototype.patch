+[[nodiscard]] QString WithSlash(QString path) {
+	path = QDir::cleanPath(path);
+	return path.endsWith('/') ? path : (path + '/');
+}
+
+[[nodiscard]] bool IsScriptFile(const QString &name) {
+	const auto lower = name.toLower();
+	if (lower.endsWith(u".d.ts"_q) || lower.endsWith(u".d.mts"_q)) {
+		return false;
+	}
+	return lower.endsWith(u".ts"_q)
+		|| lower.endsWith(u".mts"_q)
+		|| lower.endsWith(u".js"_q)
+		|| lower.endsWith(u".mjs"_q);
+}
+
+[[nodiscard]] bool Ignored(const QString &name) {
+	return name.startsWith('.') || name == u"node_modules"_q;
+}
+
+[[nodiscard]] bool Hidden(const QString &name) {
+	return Ignored(name) || name.startsWith('_');
+}
+
+[[nodiscard]] std::vector<ScriptFile> Scan(const QString &folder) {
+	auto result = std::vector<ScriptFile>();
+	const auto root = QDir(folder).absolutePath();
+	const auto list = QDir(folder).entryInfoList(
+		QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot,
+		QDir::Name | QDir::IgnoreCase);
+	for (const auto &info : list) {
+		const auto name = info.fileName();
+		if (Hidden(name)) {
+			continue;
+		} else if (info.isDir()) {
+			for (const auto &index : { u"index.ts"_q, u"index.js"_q }) {
+				const auto entry = info.absoluteFilePath() + '/' + index;
+				if (QFileInfo(entry).isFile()) {
+					result.push_back({
+						.id = name,
+						.entry = entry,
+						.root = info.absoluteFilePath(),
+						.folder = true,
+					});
+					break;
+				}
+			}
+		} else if (IsScriptFile(name)) {
+			result.push_back({
+				.id = name,
+				.entry = info.absoluteFilePath(),
+				.root = root,
+			});
+		}
+	}
+	return result;
+}
