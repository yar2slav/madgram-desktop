+JSValue Instance::NativeRead(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (!instance->_permissions.allows(Capability::AccountWrite, "read")) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.readHistory"_q,
+			GrantText(Capability::AccountWrite, "read"));
+	}
+	const auto session = instance->_session;
+	const auto id = (argc > 0)
+		? PeerFromValue(ctx, argv[0], session->userPeerId())
+		: std::nullopt;
+	const auto history = id ? session->data().historyLoaded(*id) : nullptr;
+	if (!history) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tele has no such chat loaded"_q);
+	}
+	auto till = 0;
+	if (argc > 1) {
+		JS_ToInt32(ctx, &till, argv[1]);
+	}
+	auto &histories = session->data().histories();
+	if (till > 0) {
+		histories.readInboxTill(history, MsgId(till));
+	} else {
+		histories.readInbox(history);
+	}
+	return JS_UNDEFINED;
+}
