+bool Host::interceptSendFiles(
+		Ui::PreparedList &list,
+		SendMediaType type,
+		const std::shared_ptr<SendingAlbum> &album,
+		const Api::SendAction &action) {
+	const auto peer = action.history->peer;
+	if (list.files.empty() || !holds(peer, u"files"_q)) {
+		return false;
+	}
+	const auto captioned = ranges::find_if(list.files, [](const auto &file) {
+		return !file.caption.text.isEmpty();
+	});
+	const auto index = (captioned != end(list.files))
+		? int(captioned - begin(list.files))
+		: 0;
+	auto files = std::vector<SendFileInfo>();
+	for (const auto &file : list.files) {
+		using Type = Ui::PreparedFile::Type;
+		files.push_back({
+			.name = file.displayName.isEmpty()
+				? QFileInfo(file.path).fileName()
+				: file.displayName,
+			.size = file.size,
+			.type = (file.type == Type::Photo)
+				? u"photo"_q
+				: (file.type == Type::Video)
+				? u"video"_q
+				: (file.type == Type::Music)
+				? u"music"_q
+				: u"file"_q,
+		});
+	}
+	const auto replyTo = ReplyInChat(action, peer->id);
+	const auto stored = std::make_shared<Ui::PreparedList>(std::move(list));
+	const auto session = _session;
+	hold(peer->id, std::make_shared<HeldSend>(HeldSend{
+		.data = SendData{
+			.kind = u"files"_q,
+			.text = stored->files[index].caption,
+			.peer = peer,
+			.replyTo = replyTo,
+			.scheduled = action.options.scheduled,
+			.silent = action.options.silent,
+			.files = std::move(files),
+		},
+		.initialReplyTo = replyTo,
+		.replay = [=](const SendData &data) {
+			stored->files[index].caption = data.text;
+			auto copy = action;
+			ApplySend(copy, data, replyTo);
+			session->api().sendFiles(std::move(*stored), type, album, copy);
+		},
+	}));
+	return true;
+}
