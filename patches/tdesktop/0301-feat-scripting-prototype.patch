+
+void Instance::interceptNotification(
+		NotificationData data,
+		Fn<void(bool)> done) {
+	if (!_engine) {
+		done(true);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	static const auto kinds = std::array<const char*, 3>{
+		"message",
+		"reaction",
+		"pollVote",
+	};
+	auto payload = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(data.peer)));
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"kind",
+		JS_NewString(
+			ctx,
+			kinds[std::clamp(data.kind, 0, int(kinds.size()) - 1)]));
+	JS_SetPropertyStr(
+		ctx,
+		payload,
+		"fromId",
+		data.from ? JS_NewBigInt64(ctx, MarkedId(data.from)) : JS_NULL);
+	auto message = JS_NULL;
+	if (_permissions.allows(Capability::AccountRead, "messages")) {
+		if (const auto bytes = CachedMessage(_session, data.peer, data.msg)) {
+			auto decoded = DecodeTl(ctx, *bytes, "Message", filter());
+			if (decoded.error.empty()) {
+				message = decoded.value;
+			}
+		}
+	}
+	JS_SetPropertyStr(ctx, payload, "message", message);
+	runGate(
+		Kind::Notification,
+		"__teleRunNotifications",
+		payload,
+		u"interceptNotification"_q,
+		u"show"_q,
+		[=](std::optional<QString> result) { done(result.has_value()); });
+}
+
+void Instance::runGate(
+		Kind kind,
+		const char *runner,
+		JSValue payload,
+		QString where,
+		QString fallback,
+		Fn<void(std::optional<QString>)> done,
+		std::optional<int> only) {
+	const auto ctx = _engine->ctx();
+	auto handlers = JS_NewArray(ctx);
+	auto count = std::uint32_t();
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == kind && (!only || *only == id)) {
+			JS_SetPropertyUint32(
+				ctx,
+				handlers,
+				count++,
+				JS_DupValue(ctx, registration.fn));
+		}
+	}
+	const auto key = ++_gateRunKey;
+	_gateRuns.emplace(key, GateRun{
+		.done = std::move(done),
+		.where = where,
+		.fallback = fallback,
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto fn = JS_GetPropertyStr(ctx, global, runner);
+	JS_FreeValue(ctx, global);
+	auto report = JS_NewCFunctionMagic(
+		ctx,
+		UpdateFault,
+		"fault",
+		2,
+		JS_CFUNC_generic_magic,
+		0);
+	JSValueConst args[] = { payload, handlers, report };
+	auto promise = invoke(fn, args, kListenerBudget, where);
+	for (const auto value : { fn, report, handlers, payload }) {
+		JS_FreeValue(ctx, value);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishGate(key, fallback);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, GateSettled, key));
+	_engine->drain();
+	if (!_gateRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kMiddlewareBudget, this, [=] {
+		if (_gateRuns.contains(key)) {
+			fault(where, u"took longer than 10 s"_q);
+			finishGate(key, fallback);
+		}
+	});
+}
+
+void Instance::finishGate(int key, std::optional<QString> result) {
+	const auto i = _gateRuns.find(key);
+	if (i == end(_gateRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_gateRuns.erase(i);
+	done(std::move(result));
+}
+
+JSValue Instance::GateSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_gateRuns.find(key);
+	if (i == end(instance->_gateRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto where = i->second.where;
+	const auto fallback = i->second.fallback;
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		instance->finishGate(key, fallback);
+		return JS_UNDEFINED;
+	}
+	auto verdict = JS_GetPropertyStr(ctx, value, "verdict");
+	auto url = JS_GetPropertyStr(ctx, value, "url");
+	const auto drop = (ToStd(ctx, verdict) == "drop");
+	const auto result = JS_IsString(url)
+		? FromStd(ToStd(ctx, url))
+		: fallback;
+	JS_FreeValue(ctx, verdict);
+	JS_FreeValue(ctx, url);
+	instance->finishGate(
+		key,
+		drop ? std::optional<QString>() : std::optional<QString>(result));
+	return JS_UNDEFINED;
+}
+
+bool Instance::decorates() const {
+	return _started
+		&& ranges::any_of(_registrations, [](const auto &pair) {
+			return pair.second.kind == Kind::Decorator;
+		});
+}
+
+void Instance::decorate(FullMsgId id, std::string_view bytes) {
+	auto ids = std::vector<int>();
+	for (const auto &[key, registration] : _registrations) {
+		if (registration.kind == Kind::Decorator) {
+			ids.push_back(key);
+		}
+	}
+	for (const auto key : ids) {
+		decorateWith(key, id, bytes);
+	}
+}
+
+void Instance::decorateWith(
+		int registration,
+		FullMsgId id,
+		std::string_view bytes) {
+	const auto i = _registrations.find(registration);
+	if (!_engine || i == end(_registrations)) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto decoded = DecodeTl(ctx, bytes, "Message", filter());
+	if (!decoded.error.empty()) {
+		return;
+	}
+	const auto key = ++_decorateRunKey;
+	_decorateRuns.emplace(key, DecorateRun{
+		.id = id,
+		.registration = registration,
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunDecorator");
+	JS_FreeValue(ctx, global);
+	auto fn = JS_DupValue(ctx, i->second.fn);
+	JSValueConst call[] = { fn, decoded.value };
+	auto promise = invoke(runner, call, kListenerBudget, u"decorateMessages"_q);
+	for (const auto item : { runner, fn, decoded.value }) {
+		JS_FreeValue(ctx, item);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		_decorateRuns.erase(key);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, DecoratorSettled, key));
+	_engine->drain();
+}
+
+std::optional<MessageDecoration> Instance::decorationFromValue(
+		JSValueConst value,
+		QString &error) {
+	const auto ctx = _engine->ctx();
+	if (!JS_IsObject(value)) {
+		error = u"a decoration is an object"_q;
+		return std::nullopt;
+	}
+	auto result = MessageDecoration();
+	const auto readText = [&](
+			const char *name,
+			std::optional<TextWithEntities> &to) {
+		auto text = JS_GetPropertyStr(ctx, value, name);
+		if (JS_IsString(text)) {
+			to = TextWithEntities{ FromStd(ToStd(ctx, text)) };
+		} else if (JS_IsObject(text)) {
+			auto body = JS_GetPropertyStr(ctx, text, "text");
+			auto list = JS_GetPropertyStr(ctx, text, "entities");
+			auto parsed = TextWithEntities{
+				JS_IsString(body) ? FromStd(ToStd(ctx, body)) : QString(),
+			};
+			if (JS_IsArray(list)) {
+				auto encoded = EncodeTl(ctx, list, "Vector<MessageEntity>");
+				auto entities = MTPVector<MTPMessageEntity>();
+				auto from = reinterpret_cast<const mtpPrime*>(
+					encoded.bytes.data());
+				const auto till = from
+					+ (encoded.bytes.size() / sizeof(mtpPrime));
+				if (!encoded.error.empty() || !entities.read(from, till)) {
+					error = QString::fromLatin1(name)
+						+ u".entities are wrong: "_q
+						+ FromStd(encoded.error);
+				} else {
+					parsed.entities = Api::EntitiesFromMTP(
+						_session,
+						entities.v);
+				}
+			}
+			JS_FreeValue(ctx, body);
+			JS_FreeValue(ctx, list);
+			to = std::move(parsed);
+		} else if (!JS_IsUndefined(text)) {
+			error = QString::fromLatin1(name)
+				+ u" is a string or { text, entities }"_q;
+		}
+		JS_FreeValue(ctx, text);
+	};
+	readText("text", result.text);
+	readText("footer", result.footer);
+	auto opacity = JS_GetPropertyStr(ctx, value, "opacity");
+	auto number = double();
+	if (JS_IsNumber(opacity)
+		&& !JS_ToFloat64(ctx, &number, opacity)
+		&& number >= 0.
+		&& number <= 1.) {
+		result.opacity = number;
+	} else if (!JS_IsUndefined(opacity)) {
+		error = u"opacity is a number from 0 to 1"_q;
+	}
+	JS_FreeValue(ctx, opacity);
+	auto hidden = JS_GetPropertyStr(ctx, value, "hidden");
+	if (JS_IsBool(hidden)) {
+		result.hidden = (JS_ToBool(ctx, hidden) != 0);
+	} else if (!JS_IsUndefined(hidden)) {
+		error = u"hidden is a boolean"_q;
+	}
+	JS_FreeValue(ctx, hidden);
+	auto badge = JS_GetPropertyStr(ctx, value, "badge");
+	if (JS_IsString(badge)) {
+		result.badge = FromStd(ToStd(ctx, badge));
+	} else if (!JS_IsUndefined(badge)) {
+		error = u"badge is a string"_q;
+	}
+	JS_FreeValue(ctx, badge);
+	ReadDecorationButtons(this, value, result, error);
+	if (!error.isEmpty()) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+JSValue Instance::NativeDecorate(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = instance->_session;
+	const auto readable = instance->_permissions.allows(
+		Capability::AccountRead,
+		"messages");
+	if (magic != 2
+		&& !instance->_permissions.allows(Capability::Display, "messages")) {
+		return ThrowNotGranted(
+			ctx,
+			(magic == 0)
+				? u"tg.decorateMessages"_q
+				: u"tg.decorateMessage"_q,
+			GrantText(Capability::Display, "messages"));
+	}
+	if (magic == 0) {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.decorateMessages(function)");
+		} else if (!readable) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.decorateMessages"_q,
+				GrantText(Capability::AccountRead, "messages"));
+		}
+		const auto id = NextRegistrationId();
+		instance->_registrations.emplace(id, Registration{
+			.kind = Kind::Decorator,
+			.fn = JS_DupValue(ctx, argv[0]),
+		});
+		const auto weak = base::make_weak(instance);
+		crl::on_main(weak, [=] {
+			const auto strong = weak.get();
+			if (!strong || !strong->_engine) {
+				return;
+			}
+			for (const auto &entry : LoadedCachedMessages(strong->_session)) {
+				if (!strong->_engine || !strong->_registrations.contains(id)) {
+					return;
+				}
+				strong->decorateWith(id, entry.id, entry.bytes);
+			}
+		});
+		return instance->disposer(id);
+	}
+	const auto chat = (argc > 0 && !JS_IsNull(argv[0]))
+		? PeerFromValue(ctx, argv[0], session->user()->id)
+		: std::optional<PeerId>(PeerId());
+	auto id = std::int64_t();
+	if (!chat
+		|| (magic == 1 && !*chat)
+		|| argc < 2
+		|| !JS_IsNumber(argv[1])
+		|| JS_ToInt64(ctx, &id, argv[1])) {
+		return JS_ThrowTypeError(ctx, "needs a chat and a message id");
+	} else if (magic == 2) {
+		if (!readable) {
+			return JS_UNDEFINED;
+		}
+		const auto bytes = CachedMessage(session, *chat, MsgId(id));
+		if (!bytes) {
+			return JS_UNDEFINED;
+		}
+		auto decoded = DecodeTl(ctx, *bytes, "Message", instance->filter());
+		return decoded.error.empty() ? decoded.value : JS_UNDEFINED;
+	}
+	const auto full = FullMsgId(*chat, MsgId(id));
+	if (argc < 3 || JS_IsNull(argv[2]) || JS_IsUndefined(argv[2])) {
+		SetMessageDecoration(session, full, instance, 0, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto error = QString();
+	auto value = instance->decorationFromValue(argv[2], error);
+	if (!value) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.decorateMessage: %s",
+			error.toUtf8().constData());
+	}
+	SetMessageDecoration(session, full, instance, 0, std::move(*value));
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::DecoratorSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_decorateRuns.find(magic / 2);
+	if (i == end(instance->_decorateRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto run = i->second;
+	instance->_decorateRuns.erase(i);
+	if (!instance->_registrations.contains(run.registration)) {
+		return JS_UNDEFINED;
+	}
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	const auto where = u"decorateMessages"_q;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		return JS_UNDEFINED;
+	} else if (JS_IsNull(value) || JS_IsUndefined(value)) {
+		SetMessageDecoration(
+			instance->_session,
+			run.id,
+			instance,
+			run.registration,
+			std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto error = QString();
+	auto decoration = instance->decorationFromValue(value, error);
+	if (!decoration) {
+		instance->fault(where, error);
+		return JS_UNDEFINED;
+	}
+	SetMessageDecoration(
+		instance->_session,
+		run.id,
+		instance,
+		run.registration,
+		std::move(*decoration));
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::NativePeerOverride(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Display,
+		"peers",
+		"tg.overridePeer");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->_session;
+	const auto id = (argc > 0)
+		? PeerFromValue(ctx, argv[0], session->user()->id)
+		: std::nullopt;
+	const auto peer = id ? session->data().peerLoaded(*id) : nullptr;
+	if (!peer) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.overridePeer: this peer isn't in tele's cache");
+	} else if (argc < 2 || JS_IsNull(argv[1]) || JS_IsUndefined(argv[1])) {
+		SetPeerOverride(peer, instance, std::nullopt);
+		return JS_UNDEFINED;
+	} else if (!JS_IsObject(argv[1])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.overridePeer: an override is an object or null");
+	}
+	const auto object = argv[1];
+	auto value = PeerOverride();
+	auto wrong = std::string();
+	const auto field = [&](const char *name, auto &&read) {
+		auto property = JS_GetPropertyStr(ctx, object, name);
+		if (wrong.empty() && !JS_IsUndefined(property) && !read(property)) {
+			wrong = name;
+		}
+		JS_FreeValue(ctx, property);
+	};
+	const auto id64 = [&](JSValueConst from, uint64 &to) {
+		auto number = std::int64_t();
+		if (JS_IsBigInt(from)) {
+			JS_ToBigInt64(ctx, &number, from);
+		} else if (JS_IsNumber(from)) {
+			JS_ToInt64(ctx, &number, from);
+		} else {
+			return false;
+		}
+		to = uint64(number);
+		return true;
+	};
+	const auto flag = [&](const char *name, std::optional<bool> &to) {
+		field(name, [&](JSValueConst from) {
+			if (!JS_IsBool(from)) {
+				return false;
+			}
+			to = (JS_ToBool(ctx, from) != 0);
+			return true;
+		});
+	};
+	const auto string = [&](const char *name, std::optional<QString> &to) {
+		field(name, [&](JSValueConst from) {
+			if (!JS_IsString(from)) {
+				return false;
+			}
+			to = FromStd(ToStd(ctx, from));
+			return true;
+		});
+	};
+	string("name", value.name);
+	string("badge", value.badge);
+	string("label", value.label);
+	string("preview", value.preview);
+	flag("hidden", value.hidden);
+	flag("verified", value.verified);
+	flag("scam", value.scam);
+	flag("fake", value.fake);
+	flag("premium", value.premium);
+	field("botVerification", [&](JSValueConst from) {
+		if (JS_IsNull(from)) {
+			value.botVerifyIcon = 0;
+			return true;
+		} else if (!JS_IsObject(from)) {
+			return false;
+		}
+		auto icon = JS_GetPropertyStr(ctx, from, "icon");
+		auto bot = JS_GetPropertyStr(ctx, from, "bot");
+		auto description = JS_GetPropertyStr(ctx, from, "description");
+		auto iconId = uint64();
+		auto botId = uint64();
+		const auto ok = id64(icon, iconId)
+			&& (iconId != 0)
+			&& (JS_IsUndefined(bot) || id64(bot, botId))
+			&& (JS_IsUndefined(description) || JS_IsString(description));
+		if (ok) {
+			value.botVerifyIcon = iconId;
+			value.botVerifyBot = botId;
+			value.botVerifyDescription = JS_IsString(description)
+				? FromStd(ToStd(ctx, description))
+				: QString();
+		}
+		JS_FreeValue(ctx, icon);
+		JS_FreeValue(ctx, bot);
+		JS_FreeValue(ctx, description);
+		return ok;
+	});
+	field("emojiStatus", [&](JSValueConst from) {
+		auto documentId = uint64();
+		if (JS_IsNull(from)) {
+			value.emojiStatus = 0;
+			return true;
+		} else if (!id64(from, documentId)) {
+			return false;
+		}
+		value.emojiStatus = documentId;
+		return true;
+	});
+	field("color", [&](JSValueConst from) {
+		auto number = 0;
+		if (!JS_IsNumber(from)
+			|| JS_ToInt32(ctx, &number, from)
+			|| number < 0
+			|| number > 255) {
+			return false;
+		}
+		value.color = uint8(number);
+		return true;
+	});
+	if (!wrong.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.overridePeer: %s has the wrong type",
+			wrong.c_str());
+	}
+	SetPeerOverride(peer, instance, std::move(value));
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::NativeLocal(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance || !instance->_local) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (magic < 2
+		&& !instance->_permissions.allows(Capability::Display, "local")) {
+		return ThrowNotGranted(
+			ctx,
+			(magic == 0) ? u"tg.addLocalMessage"_q : u"localMessage.edit"_q,
+			GrantText(Capability::Display, "local"));
+	}
+	const auto local = instance->_local.get();
+	if (magic == 3) {
+		auto result = JS_NewArray(ctx);
+		auto index = std::uint32_t();
+		for (const auto &entry : local->list()) {
+			auto decoded = DecodeTl(
+				ctx,
+				entry.bytes,
+				"Message",
+				instance->filter());
+			if (!decoded.error.empty()) {
+				continue;
+			}
+			auto object = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, object, "key", JS_NewInt32(ctx, entry.key));
+			JS_SetPropertyStr(
+				ctx,
+				object,
+				"persist",
+				JS_NewBool(ctx, entry.persist));
+			JS_SetPropertyStr(
+				ctx,
+				object,
+				"opacity",
+				JS_NewFloat64(ctx, entry.opacity));
+			JS_SetPropertyStr(ctx, object, "message", decoded.value);
+			JS_SetPropertyUint32(ctx, result, index++, object);
+		}
+		return result;
+	}
+	auto key = 0;
+	if (magic != 0
+		&& (argc < 1 || !JS_IsNumber(argv[0]) || JS_ToInt32(ctx, &key, argv[0]))) {
+		return JS_ThrowTypeError(ctx, "a local message key is a number");
+	} else if (magic == 2) {
+		return JS_NewBool(ctx, local->remove(key));
+	}
+	const auto index = (magic == 0) ? 0 : 1;
+	if (argc <= index || !JS_IsObject(argv[index])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"a local message is a TL message or messageService");
+	}
+	auto encoded = EncodeTl(ctx, argv[index], "Message");
+	if (!encoded.error.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"local message: %s",
+			encoded.error.c_str());
+	}
+	auto opacity = 0.5;
+	if (argc > index + 1
+		&& !JS_IsUndefined(argv[index + 1])
+		&& (!JS_IsNumber(argv[index + 1])
+			|| JS_ToFloat64(ctx, &opacity, argv[index + 1]))) {
+		return JS_ThrowTypeError(ctx, "opacity is a number from 0 to 1");
+	}
+	auto error = QString();
+	if (magic == 1) {
+		if (!local->replace(key, std::move(encoded.bytes), opacity, error)) {
+			return JS_ThrowTypeError(ctx, "%s", error.toUtf8().constData());
+		} else if (!error.isEmpty()) {
+			instance->log(LogLevel::Warning, error);
+		}
+		return JS_UNDEFINED;
+	}
+	const auto persist = (argc > 2) && JS_ToBool(ctx, argv[2]);
+	const auto result = local->add(
+		std::move(encoded.bytes),
+		opacity,
+		persist,
+		error);
+	if (!result) {
+		return JS_ThrowTypeError(ctx, "%s", error.toUtf8().constData());
+	}
+	return JS_NewInt32(ctx, result);
+}
+
+JSValue Instance::NativeUpload(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (!instance->_permissions.allows(
+			Capability::AccountWrite,
+			"send")) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.uploadFile"_q,
+			GrantText(Capability::AccountWrite, "send"));
+	}
+	auto size = std::size_t();
+	const auto data = (argc > 0)
+		? JS_GetUint8Array(ctx, &size, argv[0])
+		: nullptr;
+	if (!data) {
+		return JS_ThrowTypeError(ctx, "tg.uploadFile needs a Uint8Array");
+	} else if (!size) {
+		return JS_ThrowTypeError(ctx, "tg.uploadFile: the file is empty");
+	}
+	const auto name = (argc > 1 && JS_IsString(argv[1]))
+		? FromStd(ToStd(ctx, argv[1]))
+		: u"file"_q;
+	const auto big = (size > std::size_t(Storage::kMaxFileInMemory));
+	auto prepared = MakePreparedFile({
+		.id = base::RandomValue<uint64>(),
+		.type = big ? SendMediaType::File : SendMediaType::SecondaryFile,
+	});
+	prepared->filename = name;
+	prepared->filesize = int64(size);
+	auto bytes = QByteArray(reinterpret_cast<const char*>(data), int(size));
+	if (big) {
+		prepared->content = std::move(bytes);
+	} else {
+		prepared->setFileData(bytes);
+	}
+	const auto session = instance->_session;
+	const auto id = FullMsgId(
+		session->userPeerId(),
+		session->data().nextLocalMessageId());
+	auto created = instance->newPromise();
+	const auto key = created.first;
+	if (!key) {
+		return created.second;
+	}
+	auto &transfer = instance->_transfers[key];
+	transfer.upload = id;
+	const auto weak = base::make_weak(instance);
+	auto &uploader = session->uploader();
+	rpl::merge(
+		uploader.secondaryFileReady(),
+		uploader.documentReady()
+	) | rpl::filter([=](const Storage::UploadedMedia &media) {
+		return media.fullId == id;
+	}) | rpl::take(1) | rpl::on_next([=](const Storage::UploadedMedia &media) {
+		crl::on_main(weak, [=, file = media.info.file] {
+			if (const auto strong = weak.get()) {
+				strong->finishUpload(key, file);
+			}
+		});
+	}, transfer.lifetime);
+	rpl::merge(
+		uploader.secondaryFileFailed(),
+		uploader.documentFailed()
+	) | rpl::filter([=](const FullMsgId &failed) {
+		return failed == id;
+	}) | rpl::take(1) | rpl::on_next([=] {
+		crl::on_main(weak, [=] {
+			if (const auto strong = weak.get()) {
+				strong->finishTransfer(key, QByteArray(), u"the upload failed"_q);
+			}
+		});
+	}, transfer.lifetime);
+	uploader.upload(id, prepared);
+	const auto timeout = std::max(
+		kTransferTimeout,
+		crl::time(int64(size) / kSlowestBytesPerMs));
+	base::call_delayed(timeout, instance, [=] {
+		if (const auto strong = weak.get()) {
+			strong->finishTransfer(key, QByteArray(), u"timed out"_q);
+		}
+	});
+	return created.second;
+}
+
+void Instance::finishTransfer(int key, QByteArray bytes, QString error) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers) || !_engine) {
+		return;
+	}
+	const auto upload = i->second.upload;
+	_transfers.erase(i);
+	const auto ctx = _engine->ctx();
+	if (!bytes.isEmpty()) {
+		settle(key, true, JS_NewUint8ArrayCopy(
+			ctx,
+			reinterpret_cast<const uint8_t*>(bytes.constData()),
+			bytes.size()));
+		return;
+	} else if (upload) {
+		_session->uploader().cancel(upload);
+	}
+	const auto timedOut = (error == u"timed out"_q);
+	settle(key, false, MakeTeleError(
+		ctx,
+		timedOut ? "timed-out" : "network",
+		(upload ? u"tg.uploadFile: "_q : u"tg.downloadMedia: "_q)
+			+ (error.isEmpty() ? u"the file came back empty"_q : error)));
+}
+
+void Instance::finishUpload(int key, const MTPInputFile &file) {
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers) || !_engine) {
+		return;
+	}
+	_transfers.erase(i);
+	auto buffer = mtpBuffer();
+	file.write(buffer);
+	auto decoded = DecodeTl(_engine->ctx(), Bytes(buffer), "InputFile");
+	if (!decoded.error.empty()) {
+		settle(key, false, rpcError(0, FromStd(decoded.error)));
+		return;
+	}
+	settle(key, true, decoded.value);
+}
+
+JSValue Instance::ParseText(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 2 || !JS_IsString(argv[0]) || !JS_IsString(argv[1])) {
+		return JS_ThrowTypeError(ctx, "a text parser needs a string");
+	}
+	const auto html = (ToStd(ctx, argv[0]) == "html");
+	const auto text = FromStd(ToStd(ctx, argv[1]));
+	const auto tagged = html
+		? TextUtilities::TextWithTagsFromHtml(text).value_or(
+			TextWithTags{ text, {} })
+		: ApplyMarkdown(text);
+	const auto entities = Api::EntitiesToMTP(
+		instance->_session,
+		TextUtilities::ConvertTextTagsToEntities(tagged.tags),
+		Api::ConvertOption::SkipLocal);
+	auto buffer = mtpBuffer();
+	entities.write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "Vector<MessageEntity>");
+	if (!decoded.error.empty()) {
+		return JS_ThrowInternalError(ctx, "%s", decoded.error.c_str());
+	}
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "text", NewString(ctx, tagged.text));
+	JS_SetPropertyStr(ctx, result, "entities", decoded.value);
+	return result;
+}
+
+JSValue Instance::Fetch(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsString(argv[0])) {
+		return JS_ThrowTypeError(ctx, "fetch needs a url string");
+	}
+	const auto url = QUrl(FromStd(ToStd(ctx, argv[0])));
+	const auto scheme = url.scheme().toLower();
+	if (!url.isValid()
+		|| (scheme != u"http"_q && scheme != u"https"_q)
+		|| url.host().isEmpty()) {
+		return JS_ThrowTypeError(ctx, "fetch only takes http and https urls");
+	}
+	const auto host = url.host().toLower().toStdString();
+	if (!instance->_permissions.allows(Capability::Fetch, host)) {
+		return ThrowNotGranted(
+			ctx,
+			u"fetch(%1)"_q.arg(url.toString()),
+			GrantText(Capability::Fetch, host));
+	}
+	auto method = QByteArray("GET");
+	auto headers = std::vector<std::pair<QByteArray, QByteArray>>();
+	auto body = QByteArray();
+	auto limits = FetchLimits();
+	if (argc > 1 && JS_IsObject(argv[1])) {
+		const auto init = argv[1];
+		for (const auto &[name, target] : {
+				std::pair{ "timeout", &limits.timeout },
+				std::pair{ "maxSize", &limits.size },
+			}) {
+			auto value = JS_GetPropertyStr(ctx, init, name);
+			auto number = double();
+			const auto given = !JS_IsUndefined(value);
+			const auto valid = !given
+				|| (JS_IsNumber(value)
+					&& !JS_ToFloat64(ctx, &number, value)
+					&& number >= 0.
+					&& std::isfinite(number));
+			JS_FreeValue(ctx, value);
+			if (!valid) {
+				return JS_ThrowTypeError(
+					ctx,
+					"fetch: %s is a number of %s, 0 for no limit",
+					name,
+					(target == &limits.timeout) ? "milliseconds" : "bytes");
+			} else if (given) {
+				*target = qint64(number);
+			}
+		}
+		auto abort = JS_GetPropertyStr(ctx, init, "__teleAbort");
+		if (JS_IsNumber(abort)) {
+			auto id = int32_t();
+			JS_ToInt32(ctx, &id, abort);
+			limits.abortId = id;
+		}
+		JS_FreeValue(ctx, abort);
+		auto value = JS_GetPropertyStr(ctx, init, "method");
+		if (JS_IsString(value)) {
+			method = QByteArray::fromStdString(ToStd(ctx, value)).toUpper();
+		}
+		JS_FreeValue(ctx, value);
+		value = JS_GetPropertyStr(ctx, init, "headers");
+		if (JS_IsObject(value)) {
+			JSPropertyEnum *properties = nullptr;
+			auto count = std::uint32_t();
+			if (!JS_GetOwnPropertyNames(
+					ctx,
+					&properties,
+					&count,
+					value,
+					JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY)) {
+				for (auto i = std::uint32_t(); i != count; ++i) {
+					const auto name = JS_AtomToCString(
+						ctx,
+						properties[i].atom);
+					auto item = JS_GetProperty(ctx, value, properties[i].atom);
+					if (name) {
+						headers.emplace_back(
+							QByteArray(name),
+							QByteArray::fromStdString(ToStd(ctx, item)));
+						JS_FreeCString(ctx, name);
+					}
+					JS_FreeValue(ctx, item);
+				}
+				JS_FreePropertyEnum(ctx, properties, count);
+			}
+		}
+		JS_FreeValue(ctx, value);
+		value = JS_GetPropertyStr(ctx, init, "body");
+		if (JS_IsString(value)) {
+			body = QByteArray::fromStdString(ToStd(ctx, value));
+		} else if (JS_GetTypedArrayType(value) == JS_TYPED_ARRAY_UINT8) {
+			auto size = std::size_t();
+			const auto data = JS_GetUint8Array(ctx, &size, value);
+			body = QByteArray(reinterpret_cast<const char*>(data), int(size));
+		} else if (!JS_IsUndefined(value) && !JS_IsNull(value)) {
+			JS_FreeValue(ctx, value);
+			return JS_ThrowTypeError(
+				ctx,
+				"fetch: body must be a string or a Uint8Array");
+		}
+		JS_FreeValue(ctx, value);
+	}
+	return instance->fetch(url, method, std::move(headers), body, limits);
+}
+
+JSValue Instance::FetchAbort(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	auto id = int32_t();
+	if (!instance
+		|| argc < 1
+		|| !JS_IsNumber(argv[0])
+		|| JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_abortable.find(id);
+	if (i != end(instance->_abortable)) {
+		if (const auto reply = i->second.data()) {
+			instance->_aborted.emplace(id);
+			reply->abort();
+		}
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::fetch(
+		QUrl url,
+		QByteArray method,
+		std::vector<std::pair<QByteArray, QByteArray>> headers,
+		QByteArray body,
+		FetchLimits limits) {
+	if (!_network) {
+		_network = std::make_unique<QNetworkAccessManager>();
+	}
+	auto request = QNetworkRequest(url);
+	for (const auto &[name, value] : headers) {
+		request.setRawHeader(name, value);
+	}
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::UserVerifiedRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(std::min(
+		limits.timeout,
+		qint64(std::numeric_limits<int>::max()))));
+	auto created = newPromise();
+	const auto key = created.first;
+	const auto promise = created.second;
+	if (!key) {
+		return promise;
+	}
+	const auto reply = _network->sendCustomRequest(request, method, body);
+	const auto abortId = limits.abortId;
+	if (abortId) {
+		_abortable[abortId] = reply;
+	}
+	const auto large = std::make_shared<bool>(false);
+	const auto refused = std::make_shared<QUrl>();
+	QObject::connect(reply, &QNetworkReply::redirected, reply, [=](
+			const QUrl &target) {
+		const auto host = target.host().toLower().toStdString();
+		const auto scheme = target.scheme().toLower();
+		if ((scheme == u"http"_q || scheme == u"https"_q)
+			&& _permissions.allows(Capability::Fetch, host)) {
+			Q_EMIT reply->redirectAllowed();
+		} else {
+			*refused = target;
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 received,
+			qint64 total) {
+		if (limits.size > 0 && received > limits.size && !*large) {
+			*large = true;
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, _network.get(), [=] {
+		reply->deleteLater();
+		const auto aborted = abortId && _aborted.remove(abortId);
+		if (abortId) {
+			_abortable.remove(abortId);
+		}
+		if (!_engine) {
+			return;
+		}
+		const auto ctx = _engine->ctx();
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (aborted) {
+			settle(key, false, MakeTeleError(
+				ctx,
+				"network",
+				u"fetch: aborted"_q));
+			return;
+		} else if (!refused->isEmpty()) {
+			const auto host = refused->host().toLower();
+			settle(key, false, MakeTeleError(
+				ctx,
+				"not-granted",
+				u"fetch: the redirect to %1 needs the grant fetch(%2)"_q.arg(
+					refused->toString(),
+					host),
+				u"fetch(%1)"_q.arg(host)));
+			return;
+		} else if (*large) {
+			settle(key, false, MakeTypeError(
+				ctx,
+				u"fetch: the response is over %1 bytes"_q.arg(limits.size)));
+			return;
+		} else if (!status) {
+			settle(key, false, MakeTypeError(
+				ctx,
+				u"fetch failed: "_q + reply->errorString()));
+			return;
+		}
+		const auto data = reply->readAll();
+		auto fields = JS_NewObject(ctx);
+		for (const auto &[name, value] : reply->rawHeaderPairs()) {
+			const auto lower = name.toLower();
+			auto previous = JS_GetPropertyStr(ctx, fields, lower.constData());
+			const auto joined = JS_IsString(previous)
+				? (QByteArray::fromStdString(ToStd(ctx, previous)) + ", " + value)
+				: value;
+			JS_FreeValue(ctx, previous);
+			JS_SetPropertyStr(
+				ctx,
+				fields,
+				lower.constData(),
+				JS_NewStringLen(ctx, joined.constData(), joined.size()));
+		}
+		JSValue args[] = {
+			JS_NewInt32(ctx, status),
+			NewString(ctx, reply->attribute(
+				QNetworkRequest::HttpReasonPhraseAttribute).toString()),
+			NewString(ctx, reply->url().toString()),
+			fields,
+			JS_NewUint8ArrayCopy(
+				ctx,
+				reinterpret_cast<const uint8_t*>(data.constData()),
+				data.size()),
+		};
+		auto response = CallGlobal(ctx, "__teleResponse", args);
+		for (auto &arg : args) {
+			JS_FreeValue(ctx, arg);
+		}
+		if (JS_IsException(response)) {
+			settle(key, false, JS_GetException(ctx));
+		} else {
+			settle(key, true, response);
+		}
+	});
+	return promise;
+}
+
+JSValue Instance::rpcError(int code, const QString &type) {
+	const auto ctx = _engine->ctx();
+	auto global = JS_GetGlobalObject(ctx);
+	auto constructor = JS_GetPropertyStr(ctx, global, "__teleRpcError");
+	JS_FreeValue(ctx, global);
+	const auto text = type.toUtf8();
+	JSValue args[] = {
+		JS_NewInt32(ctx, code),
+		JS_NewStringLen(ctx, text.constData(), text.size()),
+	};
+	auto result = JS_CallConstructor(ctx, constructor, 2, args);
+	JS_FreeValue(ctx, args[1]);
+	JS_FreeValue(ctx, constructor);
+	return result;
+}
+
+JSValue Instance::TgCall(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.call needs a request object");
+	}
+	auto encoded = EncodeMethod(ctx, argv[0]);
+	if (!encoded.error.empty()) {
+		return JS_ThrowTypeError(ctx, "%s", encoded.error.c_str());
+	} else if (TakeoverMethod(encoded.method)
+		&& !instance->_permissions.any(Capability::DisableApiFiltering)) {
+		return ThrowTeleError(
+			ctx,
+			"forbidden",
+			u"tg.call(%1) can take over the account, it needs the grant "
+				"'unsafe.disableApiFiltering'"_q.arg(FromStd(encoded.method)));
+	}
+	const auto &permissions = instance->_permissions;
+	auto account = AccountGrantsFor(encoded.method);
+	if (account.empty()) {
+		account = GiftPaymentGrants(encoded.method, encoded.bytes);
+	}
+	const auto covered = permissions.allows(Capability::Call, encoded.method)
+		|| ranges::any_of(account, [&](const Grant &grant) {
+			return permissions.allows(grant.capability, grant.scope);
+		});
+	if (!covered) {
+		const auto &needed = account.empty()
+			? Grant{ .capability = Capability::Call, .scope = encoded.method }
+			: account.front();
+		return ThrowNotGranted(
+			ctx,
+			u"tg.call(%1)"_q.arg(FromStd(encoded.method)),
+			GrantText(needed.capability, needed.scope));
+	}
+	auto dc = MTP::ShiftedDcId();
+	if (argc > 1 && JS_IsObject(argv[1])) {
+		auto value = JS_GetPropertyStr(ctx, argv[1], "dc");
+		auto number = int32_t();
+		const auto given = !JS_IsUndefined(value);
+		const auto valid = given
+			&& JS_IsNumber(value)
+			&& JS_ToInt32(ctx, &number, value) >= 0
+			&& number > 0
+			&& number < 1000;
+		JS_FreeValue(ctx, value);
+		if (given && !valid) {
+			return JS_ThrowTypeError(ctx, "tg.call: dc is a data center id");
+		} else if (valid) {
+			dc = BoolProperty(ctx, argv[1], "download")
+				? MTP::downloadDcId(MTP::DcId(number), 0)
+				: MTP::ShiftedDcId(number);
+		}
+	}
+	return instance->send(
+		std::move(encoded.bytes),
+		std::move(encoded.resultType),
+		dc);
+}
+
+JSValue Instance::send(std::string bytes, std::string resultType) {
+	return send(std::move(bytes), std::move(resultType), 0);
+}
+
+JSValue Instance::send(
+		std::string bytes,
+		std::string resultType,
+		MTP::ShiftedDcId dc) {
+	const auto ctx = _engine->ctx();
+	JSValue functions[2];
+	auto promise = JS_NewPromiseCapability(ctx, functions);
+	if (JS_IsException(promise)) {
+		return promise;
+	}
+	const auto key = ++_callKey;
+	_calls.emplace(key, Call{
+		.resolve = functions[0],
+		.reject = functions[1],
+		.type = std::move(resultType),
+		.dc = dc,
+	});
+	transmit(key, QByteArray(bytes.data(), int(bytes.size())));
+	return promise;
+}
+
+void Instance::transmit(int key, QByteArray bytes) {
+	const auto scope = SendingFromScript();
+	const auto call = _calls.find(key);
+	const auto dc = (call != end(_calls)) ? call->second.dc : 0;
+	_api.request(RawRequest(bytes)).toDC(dc).done([=](const RawResult &result) {
+		const auto i = _calls.find(key);
+		if (i == end(_calls) || !_engine) {
+			return;
+		}
+		applyResult(bytes, result.bytes);
+		FeedPeers(_session, result.bytes, i->second.type);
+		auto decoded = DecodeTl(
+			_engine->ctx(),
+			std::string_view(result.bytes.constData(), result.bytes.size()),
+			i->second.type,
+			filter());
+		if (!decoded.error.empty()) {
+			settle(
+				key,
+				false,
+				rpcError(0, u"can't read the result: "_q + FromStd(decoded.error)));
+		} else {
+			settle(key, true, decoded.value);
+		}
+	}).fail([=](const MTP::Error &error) {
+		if (!_engine) {
+			return;
+		}
+		const auto wait = FloodWaitSeconds(error.type());
+		if (wait > 0 && wait <= kFloodSleep) {
+			base::call_delayed(wait * crl::time(1000) + 10, this, [=] {
+				if (_engine && _calls.contains(key)) {
+					transmit(key, bytes);
+				}
+			});
+			return;
+		}
+		settle(key, false, rpcError(error.code(), error.type()));
+	}).handleFloodErrors().send();
+}
+
+void Instance::applyResult(const QByteArray &request, const QByteArray &result) {
+	const auto shortSent = (result.size() >= 4)
+		&& (LeadingId(std::string_view(result.constData(), result.size()))
+			== std::uint32_t(mtpc_updateShortSentMessage));
+	if (!shortSent || !_engine) {
+		ApplyRawUpdates(_session, result);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto sent = DecodeTl(
+		ctx,
+		std::string_view(request.constData(), request.size()),
+		"Object");
+	auto answer = DecodeTl(
+		ctx,
+		std::string_view(result.constData(), result.size()),
+		"Updates");
+	auto expanded = JS_UNDEFINED;
+	if (sent.error.empty() && answer.error.empty()) {
+		auto name = JS_GetPropertyStr(ctx, sent.value, "_");
+		const auto method = ToStd(ctx, name);
+		JS_FreeValue(ctx, name);
+		if (method == "messages.sendMessage") {
+			auto self = JS_NewBigInt64(
+				ctx,
+				std::int64_t(_session->userId().bare));
+			JSValueConst args[] = { sent.value, answer.value, self };
+			expanded = CallGlobal(ctx, "__teleExpandShortSent", args);
+			JS_FreeValue(ctx, self);
+		}
+	}
+	JS_FreeValue(ctx, sent.value);
+	JS_FreeValue(ctx, answer.value);
+	auto applied = false;
+	if (JS_IsObject(expanded)) {
+		auto encoded = EncodeTl(ctx, expanded, "Updates");
+		if (encoded.error.empty()) {
+			applied = ApplyRawUpdates(
+				_session,
+				QByteArray(encoded.bytes.data(), int(encoded.bytes.size())));
+		} else {
+			log(LogLevel::Warning, u"can't show the sent message: "_q
+				+ FromStd(encoded.error));
+		}
+	} else if (JS_IsException(expanded)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+	}
+	JS_FreeValue(ctx, expanded);
+	if (!applied) {
+		ApplyRawUpdates(_session, result);
+	}
+}
+
+void Instance::settle(int key, bool ok, JSValue value) {
+	const auto ctx = _engine->ctx();
+	const auto i = _calls.find(key);
+	if (i == end(_calls)) {
+		JS_FreeValue(ctx, value);
+		return;
+	}
+	auto call = i->second;
+	_calls.erase(i);
+	JSValueConst args[] = { value };
+	auto result = _engine->call(
+		ok ? call.resolve : call.reject,
+		JS_UNDEFINED,
+		args,
+		kListenerBudget,
+		u"tg.call"_q);
+	JS_FreeValue(ctx, result);
+	JS_FreeValue(ctx, value);
+	JS_FreeValue(ctx, call.resolve);
+	JS_FreeValue(ctx, call.reject);
+	_engine->drain();
