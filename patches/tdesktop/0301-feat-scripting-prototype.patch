+std::vector<ScriptLogLine> Host::log(const QString &id) const {
+	if (id.isEmpty()) {
+		return { begin(_replLog), end(_replLog) };
+	}
+	const auto i = ranges::find(_entries, id, [](const Entry &e) {
+		return e.file.id;
+	});
+	return (i != end(_entries))
+		? std::vector<ScriptLogLine>(begin(i->log), end(i->log))
+		: std::vector<ScriptLogLine>();
+}
