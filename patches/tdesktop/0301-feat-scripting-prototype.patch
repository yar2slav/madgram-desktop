+
+int BannerBar::resizeGetHeight(int newWidth) {
+	const auto skip = style::ConvertScale(12);
+	const auto gap = style::ConvertScale(8);
+	const auto right = _close ? _close->width() : skip;
+	const auto textWidth = std::max(newWidth - skip - right, 1);
+	if (_close) {
+		_close->moveToRight(0, 0, newWidth);
+	}
+	auto bottom = std::max(
+		skip + _text.countHeight(textWidth) + skip,
+		_close ? _close->height() : 0);
+	auto left = skip;
+	auto top = bottom;
+	auto row = 0;
+	for (const auto &button : _buttons) {
+		if (left > skip && left + button->width() > newWidth - skip) {
+			left = skip;
+			top += row + gap;
+			row = 0;
+		}
+		button->moveToLeft(left, top, newWidth);
+		left += button->width() + gap;
+		row = std::max(row, button->height());
+	}
+	if (row) {
+		bottom = top + row + skip;
+	}
+	return bottom;
+}
+
+void BannerBar::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	const auto skip = style::ConvertScale(12);
+	const auto right = _close ? _close->width() : skip;
+	p.fillRect(e->rect(), st::dialogsBg);
+	p.fillRect(
+		0,
+		height() - st::lineWidth,
+		width(),
+		st::lineWidth,
+		st::shadowFg);
+	p.setPen(st::windowFg);
+	_text.draw(p, {
+		.position = QPoint(skip, skip),
+		.outerWidth = width(),
+		.availableWidth = std::max(width() - skip - right, 1),
+	});
+}
+
+void PressBanner(int id, int index) {
+	const auto &entries = State().entries;
+	const auto i = entries.find(id);
+	if (i == end(entries)) {
+		return;
+	}
+	CallKept(i->second.instance, i->second.function, [=](JSContext *ctx) {
+		auto result = Payload(ctx, "button");
+		JS_SetPropertyStr(ctx, result, "index", JS_NewInt32(ctx, index));
+		return result;
+	}, u"tg.ui.banner"_q);
+}
+
+void CloseBanner(int id) {
+	auto &data = State();
+	const auto i = data.entries.find(id);
+	if (i == end(data.entries)) {
+		return;
+	}
+	const auto instance = i->second.instance;
+	const auto function = i->second.function;
+	data.entries.erase(i);
+	data.bannersChanged.fire({});
+	CallKept(instance, function, [=](JSContext *ctx) {
+		return Payload(ctx, "close");
+	}, u"tg.ui.banner"_q);
+	ForgetKept(instance, function);
+}
