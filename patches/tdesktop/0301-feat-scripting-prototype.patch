+JSValue Instance::NativePage(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	if (magic == 0) {
+		if (argc < 2 || !JS_IsFunction(ctx, argv[1])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.settingsPage needs an items function");
+		}
+		const auto id = ++instance->_pageKey;
+		auto page = std::make_unique<Page>();
+		page->items = JS_DupValue(ctx, argv[1]);
+		page->title = JS_IsString(argv[0])
+			? FromStd(ToStd(ctx, argv[0]))
+			: QString();
+		instance->_pages.emplace(id, std::move(page));
+		return JS_NewInt32(ctx, id);
+	}
+	auto id = 0;
+	if (argc < 1 || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_ThrowTypeError(ctx, "expected a page");
+	}
+	const auto i = instance->_pages.find(id);
+	if (i == end(instance->_pages)) {
+		return (magic == 2 || magic == 5)
+			? JS_UNDEFINED
+			: ThrowTeleError(
+				ctx,
+				"handle-expired",
+				u"this page was disposed"_q);
+	}
+	switch (magic) {
+	case 1:
+		i->second->invalidated.fire({});
+		break;
+	case 2:
+		instance->disposePage(id);
+		break;
+	case 3: {
+		const auto window = WindowOf(instance->_session);
+		if (!window) {
+			return ThrowTeleError(
+				ctx,
+				"unsupported",
+				u"tg.ui.openPage: this account has no window"_q);
+		}
+		instance->openPage(id, window->uiShow());
+	} break;
+	case 4:
+	case 5:
+		if (magic == 4 || instance->_settingsPage == id) {
+			instance->_settingsPage = (magic == 4) ? id : 0;
+			if (instance->_changed) {
+				instance->_changed();
+			}
+		}
+		break;
+	}
+	return JS_UNDEFINED;
+}
+
+void Instance::disposePage(int id) {
+	const auto i = _pages.find(id);
+	if (i == end(_pages)) {
+		return;
+	}
+	auto page = std::move(i->second);
+	_pages.erase(i);
+	page->closed.fire({});
+	if (_engine) {
+		JS_FreeValue(_engine->ctx(), page->items);
+		JS_FreeValue(_engine->ctx(), page->rendered);
+	}
+	if (_settingsPage == id) {
+		_settingsPage = 0;
+		if (_changed) {
+			_changed();
+		}
+	}
+}
+
+void Instance::openPage(int id, std::shared_ptr<Ui::Show> show) {
+	if (auto view = pageView(id)) {
+		ShowScriptPage(std::move(show), std::move(*view));
+	}
+}
+
+std::optional<ScriptPageView> Instance::pageView(int id) {
+	const auto i = _pages.find(id);
+	if (i == end(_pages)) {
+		return std::nullopt;
+	}
+	const auto weak = base::make_weak(this);
+	return ScriptPageView{
+		.script = _name,
+		.title = i->second->title,
+		.render = [=]() -> std::optional<std::vector<PageRow>> {
+			const auto strong = weak.get();
+			return strong ? strong->renderPage(id) : std::nullopt;
+		},
+		.event = [=](int index, QVariant value) {
+			if (const auto strong = weak.get()) {
+				strong->pageEvent(id, index, value);
+			}
+		},
+		.label = [=](int index, double value) {
+			const auto strong = weak.get();
+			return strong
+				? strong->pageLabel(id, index, value)
+				: QString::number(value);
+		},
+		.invalidated = i->second->invalidated.events(),
+		.closed = i->second->closed.events(),
+	};
+}
+
+std::optional<std::vector<PageRow>> Instance::renderPage(int id) {
+	const auto i = _pages.find(id);
+	if (!_engine || !_started || i == end(_pages)) {
+		return std::nullopt;
+	}
+	const auto page = i->second.get();
+	const auto ctx = _engine->ctx();
+	auto items = JS_DupValue(ctx, page->items);
+	auto list = invoke(items, {}, kListenerBudget, u"settings page"_q);
+	JS_FreeValue(ctx, items);
+	if (!_engine || !_pages.contains(id)) {
+		JS_FreeValue(ctx, list);
+		return std::nullopt;
+	}
+	auto length = std::int64_t();
+	if (JS_IsException(list)) {
+		return page->rows;
+	} else if (!JS_IsArray(list) || JS_GetLength(ctx, list, &length) < 0) {
+		JS_FreeValue(ctx, list);
+		fault(u"settings page"_q, u"items() must return an array"_q);
+		return page->rows;
+	}
+	const auto number = [&](JSValueConst object, const char *name, double fallback) {
+		auto value = JS_GetPropertyStr(ctx, object, name);
+		auto result = fallback;
+		if (JS_IsNumber(value)) {
+			JS_ToFloat64(ctx, &result, value);
+		}
+		JS_FreeValue(ctx, value);
+		return result;
+	};
+	auto rows = std::vector<PageRow>();
+	for (auto index = std::int64_t(); index != length; ++index) {
+		auto item = JS_GetPropertyUint32(ctx, list, std::uint32_t(index));
+		auto row = PageRow{
+			.type = StringProperty(ctx, item, "type"),
+			.text = StringProperty(ctx, item, "text"),
+			.subtitle = StringProperty(ctx, item, "subtitle"),
+			.value = StringProperty(ctx, item, "value"),
+			.checked = BoolProperty(ctx, item, "checked"),
+			.icon = StringProperty(ctx, item, "icon"),
+		};
+		if (row.type == u"select"_q) {
+			auto options = JS_GetPropertyStr(ctx, item, "items");
+			auto count = std::int64_t();
+			if (JS_IsArray(options) && JS_GetLength(ctx, options, &count) >= 0) {
+				for (auto j = std::int64_t(); j != count; ++j) {
+					auto option = JS_GetPropertyUint32(ctx, options, std::uint32_t(j));
+					row.options.push_back(FromStd(ToStd(ctx, option)));
+					JS_FreeValue(ctx, option);
+				}
+			}
+			JS_FreeValue(ctx, options);
+			row.selected = int(number(item, "selected", -1));
+		} else if (row.type == u"input"_q) {
+			row.placeholder = StringProperty(ctx, item, "placeholder");
+			row.multiline = BoolProperty(ctx, item, "multiline");
+			row.maxLength = int(number(item, "maxLength", 0.));
+		} else if (row.type == u"slider"_q) {
+			row.min = number(item, "min", 0.);
+			row.max = number(item, "max", 100.);
+			row.step = number(item, "step", 1.);
+			row.number = number(item, "value", row.min);
+		} else if (row.type == u"image"_q) {
+			auto bytes = JS_GetPropertyStr(ctx, item, "bytes");
+			row.bytes = BytesFrom(ctx, bytes).value_or(QByteArray());
+			JS_FreeValue(ctx, bytes);
+			row.height = int(number(item, "height", 0.));
+		} else if (row.type == u"progress"_q) {
+			row.progress = number(item, "value", -1.);
+		} else if (row.type == u"peer"_q) {
+			auto peer = JS_GetPropertyStr(ctx, item, "peer");
+			if (const auto id = PeerFromValue(
+					ctx,
+					peer,
+					_session->userPeerId())) {
+				row.peer = id->value;
+			}
+			JS_FreeValue(ctx, peer);
+		}
+		JS_FreeValue(ctx, item);
+		rows.push_back(std::move(row));
+	}
+	JS_FreeValue(ctx, page->rendered);
+	page->rendered = list;
+	page->rows = rows;
+	_engine->drain();
+	return rows;
+}
+
+void Instance::pageEvent(int id, int index, QVariant value) {
+	const auto i = _pages.find(id);
+	if (!_engine || !_started || i == end(_pages)) {
+		return;
+	}
+	const auto page = i->second.get();
+	const auto ctx = _engine->ctx();
+	auto item = JS_GetPropertyUint32(ctx, page->rendered, std::uint32_t(index));
+	const auto type = StringProperty(ctx, item, "type");
+	const auto click = (type == u"button"_q)
+		|| (type == u"item"_q)
+		|| (type == u"peer"_q)
+		|| (type == u"image"_q);
+	auto handler = JS_GetPropertyStr(ctx, item, click ? "onClick" : "onChange");
+	JS_FreeValue(ctx, item);
+	if (!JS_IsFunction(ctx, handler)) {
+		JS_FreeValue(ctx, handler);
+		return;
+	}
+	auto argument = click
+		? JS_UNDEFINED
+		: (value.userType() == QMetaType::Bool)
+		? JS_NewBool(ctx, value.toBool())
+		: (value.userType() == QMetaType::QString)
+		? NewString(ctx, value.toString())
+		: (type == u"select"_q)
+		? JS_NewInt32(ctx, value.toInt())
+		: JS_NewFloat64(ctx, value.toDouble());
+	JSValueConst args[] = { argument };
+	auto result = invoke(
+		handler,
+		std::span<JSValueConst>(args, click ? 0 : 1),
+		kListenerBudget,
+		u"settings page"_q);
+	JS_FreeValue(ctx, handler);
+	JS_FreeValue(ctx, argument);
+	JS_FreeValue(ctx, result);
+	if (!_engine) {
+		return;
+	}
+	_engine->drain();
+	if (type != u"slider"_q) {
+		if (const auto j = _pages.find(id); j != end(_pages)) {
+			j->second->invalidated.fire({});
+		}
+	}
+}
+
+QString Instance::pageLabel(int id, int index, double value) {
+	const auto fallback = QString::number(value);
+	const auto i = _pages.find(id);
+	if (!_engine || !_started || i == end(_pages)) {
+		return fallback;
+	}
+	const auto ctx = _engine->ctx();
+	auto item = JS_GetPropertyUint32(
+		ctx,
+		i->second->rendered,
+		std::uint32_t(index));
+	auto label = JS_GetPropertyStr(ctx, item, "label");
+	JS_FreeValue(ctx, item);
+	if (!JS_IsFunction(ctx, label)) {
+		JS_FreeValue(ctx, label);
+		return fallback;
+	}
+	auto argument = JS_NewFloat64(ctx, value);
+	JSValueConst args[] = { argument };
+	auto result = invoke(label, args, kListenerBudget, u"slider label"_q);
+	JS_FreeValue(ctx, label);
+	const auto text = JS_IsException(result)
+		? fallback
+		: FromStd(ToStd(ctx, result));
+	JS_FreeValue(ctx, result);
+	return text;
+}
+
+void Instance::release(Registration &registration) {
+	if (registration.kind == Kind::Action) {
+		UnreferenceAction(registration.menu, registration.key, registration.text);
+	}
+	if (_engine) {
+		JS_FreeValue(_engine->ctx(), registration.fn);
+		JS_FreeValue(_engine->ctx(), registration.visible);
+	}
+	registration.fn = JS_UNDEFINED;
+	registration.visible = JS_UNDEFINED;
+}
+
+JSValue Instance::NativeAction(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	static const auto names = std::array<const char*, 4>{
+		"tg.registerMessageAction",
+		"tg.registerChatAction",
+		"tg.registerChatAction",
+		"tg.registerProfileAction",
+	};
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (magic < 0 || magic > 3) {
+		return JS_UNDEFINED;
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "%s needs an options object", names[magic]);
+	}
+	const auto options = argv[0];
+	const auto id = StringProperty(ctx, options, "id");
+	const auto text = StringProperty(ctx, options, "text");
+	static const auto valid = QRegularExpression(u"^[a-z0-9_]{1,64}$"_q);
+	if (!valid.match(id).hasMatch()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: id must be 1 to 64 of a-z, 0-9 and _",
+			names[magic]);
+	} else if (text.trimmed().isEmpty()) {
+		return JS_ThrowTypeError(ctx, "%s needs a text", names[magic]);
+	}
+	auto click = JS_GetPropertyStr(ctx, options, "onClick");
+	auto visible = JS_GetPropertyStr(ctx, options, "visible");
+	const auto clickable = JS_IsFunction(ctx, click);
+	const auto checkable = JS_IsUndefined(visible)
+		|| JS_IsFunction(ctx, visible);
+	if (!clickable || !checkable) {
+		JS_FreeValue(ctx, click);
+		JS_FreeValue(ctx, visible);
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: onClick must be a function, visible a function if given",
+			names[magic]);
+	}
+	const auto key = u"script."_q
+		+ MenuKeyPart(instance->_file.id)
+		+ '.'
+		+ id;
+	const auto taken = ranges::any_of(
+		instance->_registrations,
+		[&](const auto &pair) {
+			return pair.second.kind == Kind::Action
+				&& pair.second.menu == magic
+				&& pair.second.key == key;
+		});
+	if (taken) {
+		JS_FreeValue(ctx, click);
+		JS_FreeValue(ctx, visible);
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: the id '%s' is already registered",
+			names[magic],
+			id.toUtf8().constData());
+	}
+	const auto registration = NextRegistrationId();
+	instance->_registrations.emplace(registration, Registration{
+		.kind = Kind::Action,
+		.fn = click,
+		.visible = visible,
+		.menu = magic,
+		.key = key,
+		.text = text,
+	});
+	ReferenceAction(magic, key, text);
+	return instance->disposer(registration);
+}
+
+std::vector<ScriptAction> Instance::actions(int menu) const {
+	auto result = std::vector<ScriptAction>();
+	if (!_started) {
+		return result;
+	}
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::Action && registration.menu == menu) {
+			result.push_back({
+				.id = id,
+				.key = registration.key,
+				.text = registration.text,
+			});
+		}
+	}
+	return result;
+}
+
+JSValue Instance::actionContext(const ActionContext &context) {
+	const auto ctx = _engine->ctx();
+	auto result = JS_NewObject(ctx);
+	if (context.peer) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"chatId",
+			JS_NewBigInt64(ctx, MarkedId(context.peer->id)));
+		JS_SetPropertyStr(ctx, result, "chat", peerInfo(context.peer));
+	}
+	if (context.messageId) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"messageId",
+			JS_NewInt64(ctx, context.messageId.bare));
+		JS_SetPropertyStr(ctx, result, "text", NewString(ctx, context.text));
+	}
+	return result;
+}
+
+bool Instance::actionVisible(int id, const ActionContext &context) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		return false;
+	} else if (JS_IsUndefined(i->second.visible)) {
+		return true;
+	}
+	const auto ctx = _engine->ctx();
+	auto visible = JS_DupValue(ctx, i->second.visible);
+	auto argument = actionContext(context);
+	JSValueConst args[] = { argument };
+	auto result = invoke(
+		visible,
+		args,
+		kListenerBudget,
+		u"action %1 visible"_q.arg(i->second.key));
+	JS_FreeValue(ctx, visible);
+	JS_FreeValue(ctx, argument);
+	const auto shown = !JS_IsException(result) && (JS_ToBool(ctx, result) > 0);
+	JS_FreeValue(ctx, result);
+	if (_engine) {
+		_engine->drain();
+	}
+	return shown;
+}
+
+void Instance::runAction(int id, const ActionContext &context) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	auto click = JS_DupValue(ctx, i->second.fn);
+	auto argument = actionContext(context);
+	JSValueConst args[] = { argument };
+	auto result = invoke(
+		click,
+		args,
+		kListenerBudget,
+		u"action %1"_q.arg(i->second.key));
+	JS_FreeValue(ctx, click);
+	JS_FreeValue(ctx, argument);
+	JS_FreeValue(ctx, result);
+	if (_engine) {
+		_engine->drain();
+	}
+}
+
+JSValue Instance::NativeSend(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.interceptSendMessage(filter?, function)");
+	} else if (!instance->_permissions.any(Capability::InterceptSendMessage)) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.interceptSendMessage"_q,
+			GrantText(Capability::InterceptSendMessage, {}));
+	}
+	static const auto known = std::array<std::string_view, 6>{
+		"text",
+		"files",
+		"document",
+		"photo",
+		"forward",
+		"inline",
+	};
+	auto kinds = std::vector<std::string>();
+	auto length = std::int64_t();
+	if (argc > 1
+		&& JS_IsArray(argv[1])
+		&& JS_GetLength(ctx, argv[1], &length) >= 0) {
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, argv[1], std::uint32_t(i));
+			auto name = ToStd(ctx, item);
+			JS_FreeValue(ctx, item);
+			if (!ranges::contains(known, std::string_view(name))) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.interceptSendMessage: kinds are 'text', 'files', "
+					"'document', 'photo', 'forward', 'inline' or 'all'");
+			}
+			kinds.push_back(std::move(name));
+		}
+	}
+	if (kinds.empty()) {
+		kinds.push_back("text");
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = Kind::Send,
+		.keys = std::move(kinds),
+		.fn = JS_DupValue(ctx, argv[0]),
+	});
+	return instance->disposer(id);
+}
+
+bool Instance::interceptsSends(const QString &kind) const {
+	const auto name = kind.toStdString();
+	return _started
+		&& ranges::any_of(_registrations, [&](const auto &pair) {
+			return (pair.second.kind == Kind::Send)
+				&& ranges::contains(pair.second.keys, name);
+		});
+}
+
+void Instance::interceptSend(
+		SendData data,
+		Fn<void(std::optional<SendData>)> done) {
+	if (!_engine || !interceptsSends(data.kind) || !data.peer) {
+		done(std::move(data));
+		return;
+	}
+	const auto kind = data.kind.toStdString();
+	const auto ctx = _engine->ctx();
+	const auto entities = Api::EntitiesToMTP(
+		_session,
+		TextUtilities::ConvertTextTagsToEntities(data.text.tags),
+		Api::ConvertOption::SkipLocal);
+	auto buffer = mtpBuffer();
+	entities.write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "Vector<MessageEntity>");
+	auto text = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, text, "text", NewString(ctx, data.text.text));
+	JS_SetPropertyStr(
+		ctx,
+		text,
+		"entities",
+		decoded.error.empty() ? decoded.value : JS_NewArray(ctx));
+	auto message = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, message, "text", text);
+	JS_SetPropertyStr(
+		ctx,
+		message,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(data.peer->id)));
+	JS_SetPropertyStr(ctx, message, "chat", peerInfo(data.peer));
+	JS_SetPropertyStr(
+		ctx,
+		message,
+		"replyTo",
+		data.replyTo ? JS_NewInt64(ctx, data.replyTo.bare) : JS_NULL);
+	JS_SetPropertyStr(ctx, message, "silent", JS_NewBool(ctx, data.silent));
+	JS_SetPropertyStr(
+		ctx,
+		message,
+		"scheduleDate",
+		data.scheduled ? JS_NewInt32(ctx, data.scheduled) : JS_NULL);
+	JS_SetPropertyStr(ctx, message, "kind", NewString(ctx, data.kind));
+	if (!data.files.empty()) {
+		auto files = JS_NewArray(ctx);
+		for (auto i = 0; i != int(data.files.size()); ++i) {
+			const auto &file = data.files[i];
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, item, "name", NewString(ctx, file.name));
+			JS_SetPropertyStr(ctx, item, "size", JS_NewInt64(ctx, file.size));
+			JS_SetPropertyStr(ctx, item, "type", NewString(ctx, file.type));
+			JS_SetPropertyUint32(ctx, files, std::uint32_t(i), item);
+		}
+		JS_SetPropertyStr(ctx, message, "files", files);
+	}
+	if (const auto document = data.document) {
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"id",
+			JS_NewBigInt64(ctx, int64(document->id)));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"name",
+			NewString(ctx, document->filename()));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"mimeType",
+			NewString(ctx, document->mimeString()));
+		JS_SetPropertyStr(ctx, item, "size", JS_NewInt64(ctx, document->size));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"sticker",
+			JS_NewBool(ctx, document->sticker() != nullptr));
+		JS_SetPropertyStr(ctx, item, "gif", JS_NewBool(ctx, document->isGifv()));
+		JS_SetPropertyStr(ctx, message, "document", item);
+	}
+	if (const auto photo = data.photo) {
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, item, "id", JS_NewBigInt64(ctx, int64(photo->id)));
+		JS_SetPropertyStr(ctx, message, "photo", item);
+	}
+	if (const auto &info = data.inlineResult) {
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"botId",
+			JS_NewBigInt64(ctx, MarkedId(info->bot)));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"queryId",
+			JS_NewBigInt64(ctx, int64(info->queryId)));
+		JS_SetPropertyStr(ctx, item, "id", NewString(ctx, info->id));
+		JS_SetPropertyStr(ctx, item, "title", NewString(ctx, info->title));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"description",
+			NewString(ctx, info->description));
+		JS_SetPropertyStr(ctx, message, "inline", item);
+	}
+	if (!data.forwards.empty()) {
+		auto messages = JS_NewArray(ctx);
+		for (auto i = 0; i != int(data.forwards.size()); ++i) {
+			const auto &id = data.forwards[i];
+			auto item = JS_NewObject(ctx);
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"chatId",
+				JS_NewBigInt64(ctx, MarkedId(id.peer)));
+			JS_SetPropertyStr(ctx, item, "id", JS_NewInt64(ctx, id.msg.bare));
+			JS_SetPropertyUint32(ctx, messages, std::uint32_t(i), item);
+		}
+		auto forward = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, forward, "messages", messages);
+		JS_SetPropertyStr(ctx, message, "forward", forward);
+	}
+	auto handlers = JS_NewArray(ctx);
+	auto count = std::uint32_t();
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind == Kind::Send
+			&& ranges::contains(registration.keys, kind)) {
+			JS_SetPropertyUint32(
+				ctx,
+				handlers,
+				count++,
+				JS_DupValue(ctx, registration.fn));
+		}
+	}
+	const auto key = ++_sendRunKey;
+	_sendRuns.emplace(key, SendRun{
+		.done = std::move(done),
+		.data = std::move(data),
+	});
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunSends");
+	JS_FreeValue(ctx, global);
+	auto report = JS_NewCFunctionMagic(
+		ctx,
+		UpdateFault,
+		"fault",
+		2,
+		JS_CFUNC_generic_magic,
+		0);
+	JSValueConst args[] = { message, handlers, report };
+	auto promise = invoke(runner, args, kListenerBudget, u"interceptSendMessage"_q);
+	for (const auto value : { runner, report, handlers, message }) {
+		JS_FreeValue(ctx, value);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishSend(key, std::nullopt);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, SendsSettled, key));
+	_engine->drain();
+	if (!_sendRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kSendBudget, this, [=] {
+		if (_sendRuns.contains(key)) {
+			fault(
+				u"interceptSendMessage"_q,
+				u"took longer than 60 s, the message was not sent"_q);
+			finishSend(key, std::nullopt);
+		}
+	});
+}
+
+std::optional<TextWithTags> Instance::textFromValue(
+		JSValueConst value,
+		const QString &where) {
+	const auto ctx = _engine->ctx();
+	if (JS_IsString(value)) {
+		return TextWithTags{ FromStd(ToStd(ctx, value)) };
+	} else if (!JS_IsObject(value)) {
+		return std::nullopt;
+	}
+	auto body = JS_GetPropertyStr(ctx, value, "text");
+	auto list = JS_GetPropertyStr(ctx, value, "entities");
+	const auto text = FromStd(ToStd(ctx, body));
+	JS_FreeValue(ctx, body);
+	auto tags = TextWithTags::Tags();
+	if (JS_IsArray(list)) {
+		auto encoded = EncodeTl(ctx, list, "Vector<MessageEntity>");
+		auto entities = MTPVector<MTPMessageEntity>();
+		auto from = reinterpret_cast<const mtpPrime*>(encoded.bytes.data());
+		const auto till = from + (encoded.bytes.size() / sizeof(mtpPrime));
+		if (!encoded.error.empty() || !entities.read(from, till)) {
+			JS_FreeValue(ctx, list);
+			fault(where, u"the entities are wrong: "_q + FromStd(encoded.error));
+			return std::nullopt;
+		}
+		tags = TextUtilities::ConvertEntitiesToTextTags(
+			Api::EntitiesFromMTP(_session, entities.v));
+	}
+	JS_FreeValue(ctx, list);
+	return TextWithTags{ text, std::move(tags) };
+}
+
+std::optional<SendData> Instance::readSend(
+		JSValueConst message,
+		SendData data) {
+	const auto ctx = _engine->ctx();
+	auto text = JS_GetPropertyStr(ctx, message, "text");
+	if (JS_IsString(text) || JS_IsObject(text)) {
+		auto value = textFromValue(text, u"interceptSendMessage"_q);
+		if (!value) {
+			JS_FreeValue(ctx, text);
+			return std::nullopt;
+		}
+		data.text = std::move(*value);
+	}
+	JS_FreeValue(ctx, text);
+	auto silent = JS_GetPropertyStr(ctx, message, "silent");
+	data.silent = JS_ToBool(ctx, silent);
+	JS_FreeValue(ctx, silent);
+	auto reply = JS_GetPropertyStr(ctx, message, "replyTo");
+	auto replyTo = 0;
+	data.replyTo = (JS_IsNumber(reply) && !JS_ToInt32(ctx, &replyTo, reply))
+		? MsgId(replyTo)
+		: MsgId();
+	JS_FreeValue(ctx, reply);
+	auto schedule = JS_GetPropertyStr(ctx, message, "scheduleDate");
+	auto scheduled = 0;
+	data.scheduled = (JS_IsNumber(schedule)
+		&& !JS_ToInt32(ctx, &scheduled, schedule))
+		? TimeId(scheduled)
+		: TimeId();
+	JS_FreeValue(ctx, schedule);
+	return data;
+}
+
+JSValue Instance::NativeCommand(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.registerCommand needs an options object");
+	}
+	const auto options = argv[0];
+	auto name = StringProperty(ctx, options, "name");
+	if (name.startsWith('/')) {
+		name = name.mid(1);
+	}
+	static const auto valid = QRegularExpression(u"^[a-z0-9_]{1,32}$"_q);
+	if (!valid.match(name).hasMatch()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerCommand: the name must be 1 to 32 of a-z, 0-9 and _");
+	}
+	auto chats = std::vector<std::string>();
+	auto list = JS_GetPropertyStr(ctx, options, "chats");
+	auto length = std::int64_t();
+	if (JS_IsString(list)) {
+		chats.push_back(ToStd(ctx, list));
+	} else if (JS_IsArray(list) && JS_GetLength(ctx, list, &length) >= 0) {
+		for (auto i = std::int64_t(); i != length; ++i) {
+			auto item = JS_GetPropertyUint32(ctx, list, std::uint32_t(i));
+			chats.push_back(ToStd(ctx, item));
+			JS_FreeValue(ctx, item);
+		}
+	} else if (!JS_IsUndefined(list)) {
+		JS_FreeValue(ctx, list);
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerCommand: chats is 'all', 'private', 'groups', "
+			"'channels' or an array of them");
+	}
+	JS_FreeValue(ctx, list);
+	for (const auto &chat : chats) {
+		if (chat != "all" && chat != "private" && chat != "groups" && chat != "channels") {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.registerCommand: unknown chats '%s'",
+				chat.c_str());
+		}
+	}
+	auto run = JS_GetPropertyStr(ctx, options, "run");
+	if (!JS_IsFunction(ctx, run)) {
+		JS_FreeValue(ctx, run);
+		return JS_ThrowTypeError(ctx, "tg.registerCommand needs a run function");
+	}
+	const auto &registrations = instance->_registrations;
+	const auto taken = ranges::any_of(registrations, [&](const auto &pair) {
+		return pair.second.kind == Kind::Command && pair.second.key == name;
+	});
+	if (taken) {
+		JS_FreeValue(ctx, run);
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerCommand: /%s is already registered",
+			name.toUtf8().constData());
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = Kind::Command,
+		.keys = std::move(chats),
+		.fn = run,
+		.key = name,
+		.text = StringProperty(ctx, options, "description"),
+		.extra = StringProperty(ctx, options, "args"),
+	});
+	if (instance->_changed) {
+		instance->_changed();
+	}
+	return instance->disposer(id);
+}
+
+std::vector<ScriptCommand> Instance::commands(not_null<PeerData*> peer) const {
+	auto result = std::vector<ScriptCommand>();
+	if (!_started) {
+		return result;
+	}
+	const auto kind = peer->isUser()
+		? "private"
+		: peer->isBroadcast()
+		? "channels"
+		: "groups";
+	for (const auto &[id, registration] : _registrations) {
+		if (registration.kind != Kind::Command) {
+			continue;
+		}
+		const auto &chats = registration.keys;
+		const auto fits = chats.empty()
+			|| ranges::contains(chats, std::string("all"))
+			|| ranges::contains(chats, std::string(kind));
+		if (fits) {
+			result.push_back({
+				.id = id,
+				.name = registration.key,
+				.description = registration.text,
+				.args = registration.extra,
+			});
+		}
+	}
+	return result;
+}
+
+void Instance::runCommand(
+		int id,
+		QString args,
+		QString full,
+		not_null<PeerData*> peer,
+		Fn<void(TextWithTags)> setText,
+		Fn<void(std::optional<TextWithTags>, bool)> done) {
+	const auto i = _registrations.find(id);
+	if (!_engine || !_started || i == end(_registrations)) {
+		done(std::nullopt, true);
+		return;
+	}
+	const auto ctx = _engine->ctx();
+	const auto where = u"command /%1"_q.arg(i->second.key);
+	const auto key = ++_commandRunKey;
+	_commandRuns.emplace(key, CommandRun{
+		.setText = std::move(setText),
+		.done = std::move(done),
+		.where = where,
+	});
+	auto context = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, context, "chat", peerInfo(peer));
+	JS_SetPropertyStr(
+		ctx,
+		context,
+		"chatId",
+		JS_NewBigInt64(ctx, MarkedId(peer->id)));
+	JS_SetPropertyStr(ctx, context, "text", NewString(ctx, full));
+	JS_SetPropertyStr(
+		ctx,
+		context,
+		"setText",
+		JS_NewCFunctionMagic(
+			ctx,
+			CommandSetText,
+			"setText",
+			1,
+			JS_CFUNC_generic_magic,
+			key));
+	auto global = JS_GetGlobalObject(ctx);
+	auto runner = JS_GetPropertyStr(ctx, global, "__teleRunCommand");
+	JS_FreeValue(ctx, global);
+	auto fn = JS_DupValue(ctx, i->second.fn);
+	auto value = NewString(ctx, args);
+	JSValueConst call[] = { fn, value, context };
+	auto promise = invoke(runner, call, kListenerBudget, where);
+	for (const auto item : { runner, fn, value, context }) {
+		JS_FreeValue(ctx, item);
+	}
+	if (!_engine) {
+		return;
+	} else if (JS_IsException(promise)) {
+		finishCommand(key, std::nullopt, true);
+		return;
+	}
+	JS_FreeValue(ctx, then(promise, CommandSettled, key));
+	_engine->drain();
+	if (!_commandRuns.contains(key)) {
+		return;
+	}
+	base::call_delayed(kCommandBudget, this, [=] {
+		if (_commandRuns.contains(key)) {
+			fault(where, u"took longer than 60 s"_q);
+			finishCommand(key, std::nullopt, true);
+		}
+	});
+}
+
+JSValue Instance::CommandSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_commandRuns.find(key);
+	if (i == end(instance->_commandRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto where = i->second.where;
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(where, instance->_engine->describe(value));
+		instance->finishCommand(key, std::nullopt, true);
+	} else if (JS_IsNull(value) || JS_IsUndefined(value)) {
+		instance->finishCommand(key, std::nullopt, false);
+	} else {
+		auto text = instance->textFromValue(value, where);
+		instance->finishCommand(key, std::move(text), !text);
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue Instance::CommandSetText(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto i = instance->_commandRuns.find(magic);
+	if (i == end(instance->_commandRuns)) {
+		return ThrowTeleError(
+			ctx,
+			"handle-expired",
+			u"ctx.setText was called after the command finished"_q);
+	}
+	auto text = instance->textFromValue(
+		(argc > 0) ? argv[0] : JS_UNDEFINED,
+		i->second.where);
+	if (!text) {
+		return JS_ThrowTypeError(ctx, "ctx.setText takes a string or { text, entities }");
+	}
+	i->second.setText(std::move(*text));
+	return JS_UNDEFINED;
+}
+
+void Instance::finishCommand(
+		int key,
+		std::optional<TextWithTags> text,
+		bool failed) {
+	const auto i = _commandRuns.find(key);
+	if (i == end(_commandRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_commandRuns.erase(i);
+	done(std::move(text), failed);
+}
+
+JSValue Instance::SendsSettled(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_UNDEFINED;
+	}
+	const auto key = magic / 2;
+	const auto i = instance->_sendRuns.find(key);
+	if (i == end(instance->_sendRuns)) {
+		return JS_UNDEFINED;
+	}
+	const auto value = (argc > 0) ? argv[0] : JS_UNDEFINED;
+	if (!(magic % 2)) {
+		instance->fault(
+			u"interceptSendMessage"_q,
+			instance->_engine->describe(value));
+		instance->finishSend(key, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto verdict = JS_GetPropertyStr(ctx, value, "verdict");
+	const auto send = (ToStd(ctx, verdict) == "send");
+	JS_FreeValue(ctx, verdict);
+	if (!send) {
+		instance->finishSend(key, std::nullopt);
+		return JS_UNDEFINED;
+	}
+	auto message = JS_GetPropertyStr(ctx, value, "message");
+	auto result = instance->readSend(message, i->second.data);
+	JS_FreeValue(ctx, message);
+	instance->finishSend(key, std::move(result));
+	return JS_UNDEFINED;
+}
+
+void Instance::finishSend(int key, std::optional<SendData> result) {
+	const auto i = _sendRuns.find(key);
+	if (i == end(_sendRuns)) {
+		return;
+	}
+	auto done = std::move(i->second.done);
+	_sendRuns.erase(i);
+	done(std::move(result));
+}
+
+JSValue Instance::NativeDownload(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (!instance->_permissions.allows(
+			Capability::AccountRead,
+			"messages")) {
+		return ThrowNotGranted(
+			ctx,
+			u"tg.downloadMedia"_q,
+			GrantText(Capability::AccountRead, "messages"));
+	} else if (argc < 1 || !JS_IsObject(argv[0])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia needs a Message, a message media, a photo "
+			"or a document");
+	}
+	const auto saveTo = (argc > 3 && JS_IsString(argv[3]))
+		? FromStd(ToStd(ctx, argv[3]))
+		: QString();
+	const auto toDownloads = (saveTo == u"downloads"_q);
+	if (!saveTo.isEmpty() && !toDownloads) {
+		if (!QFileInfo(saveTo).isAbsolute()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.downloadMedia: saveTo is 'downloads' or an absolute path");
+		} else if (!instance->_permissions.allows(
+				Capability::FilesWrite,
+				{})) {
+			return ThrowNotGranted(
+				ctx,
+				u"tg.downloadMedia({ saveTo })"_q,
+				GrantText(Capability::FilesWrite, {}));
+		}
+	}
+	const auto session = instance->_session;
+	auto &owner = session->data();
+	auto type = JS_GetPropertyStr(ctx, argv[0], "_");
+	const auto name = ToStd(ctx, type);
+	JS_FreeValue(ctx, type);
+	const auto tl = name.starts_with("messageMedia")
+		? std::string_view("MessageMedia")
+		: (name == "photo")
+		? std::string_view("Photo")
+		: (name == "document")
+		? std::string_view("Document")
+		: std::string_view();
+	if (tl.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia: %s is not a photo or a document",
+			name.c_str());
+	}
+	auto encoded = EncodeTl(ctx, argv[0], tl);
+	if (!encoded.error.empty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia: %s",
+			encoded.error.c_str());
+	}
+	auto from = reinterpret_cast<const mtpPrime*>(encoded.bytes.data());
+	const auto till = from + (encoded.bytes.size() / sizeof(mtpPrime));
+	auto photo = (PhotoData*)nullptr;
+	auto document = (DocumentData*)nullptr;
+	if (tl == "MessageMedia") {
+		auto media = MTPMessageMedia();
+		if (media.read(from, till)) {
+			media.match([&](const MTPDmessageMediaPhoto &data) {
+				if (const auto value = data.vphoto()) {
+					photo = owner.processPhoto(*value);
+				}
+			}, [&](const MTPDmessageMediaDocument &data) {
+				if (const auto value = data.vdocument()) {
+					document = owner.processDocument(
+						*value,
+						data.valt_documents());
+				}
+			}, [](const auto &) {
+			});
+		}
+	} else if (tl == "Photo") {
+		auto value = MTPPhoto();
+		if (value.read(from, till)) {
+			photo = owner.processPhoto(value);
+		}
+	} else {
+		auto value = MTPDocument();
+		if (value.read(from, till)) {
+			document = owner.processDocument(value);
+		}
+	}
+	if (!photo && !document) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.downloadMedia: this media has no photo or document");
+	} else if (document
+		&& saveTo.isEmpty()
+		&& document->size > Storage::kMaxFileInMemory) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"tg.downloadMedia: the file is over 10 MB, pass { saveTo } "
+			"to save it to disk"_q);
+	}
+	auto origin = Data::FileOrigin();
+	const auto peer = (argc > 1)
+		? PeerFromValue(ctx, argv[1], session->userPeerId())
+		: std::nullopt;
+	auto msgId = 0;
+	if (argc > 2) {
+		JS_ToInt32(ctx, &msgId, argv[2]);
+	}
+	if (peer && msgId > 0) {
+		origin = Data::FileOriginMessage(FullMsgId(*peer, MsgId(msgId)));
+	}
+	const auto target = [&] {
+		if (saveTo.isEmpty()) {
+			return QString();
+		}
+		auto folder = saveTo;
+		if (toDownloads) {
+			const auto path = Core::App().settings().downloadPath();
+			folder = (path.isEmpty() || path == u"tmp"_q)
+				? File::DefaultDownloadPath(session)
+				: path;
+			if (peer) {
+				folder = ChatDownloadPath(session, *peer, folder);
+			}
+		} else if (!QFileInfo(saveTo).isDir()) {
+			QDir().mkpath(QFileInfo(saveTo).absolutePath());
+			return saveTo;
+		}
+		QDir().mkpath(folder);
+		return document
+			? DocumentFileNameForSave(document, false, QString(), QDir(folder))
+			: QDir(folder).filePath(u"photo_%1.jpg"_q.arg(photo->id));
+	}();
+	auto created = instance->newPromise();
+	const auto key = created.first;
+	if (!key) {
+		return created.second;
+	}
+	auto &transfer = instance->_transfers[key];
+	const auto weak = base::make_weak(instance);
+	const auto finish = [=](QByteArray bytes, QString error) {
+		crl::on_main(weak, [=] {
+			const auto strong = weak.get();
+			if (!strong) {
+				return;
+			} else if (target.isEmpty() || bytes.isEmpty()) {
+				strong->finishTransfer(key, bytes, error);
+				return;
+			}
+			auto file = QFile(target);
+			const auto written = file.open(QIODevice::WriteOnly)
+				&& (file.write(bytes) == bytes.size());
+			strong->finishSave(
+				key,
+				written ? target : QString(),
+				u"can't write %1"_q.arg(QDir::toNativeSeparators(target)));
+		});
+	};
+	if (document && !target.isEmpty()) {
+		transfer.document = document->createMediaView();
+		const auto done = [=] {
+			crl::on_main(weak, [=] {
+				const auto info = QFileInfo(target);
+				if (const auto strong = weak.get()) {
+					strong->finishSave(
+						key,
+						(info.exists() && info.size() > 0) ? target : QString(),
+						u"the download failed"_q);
+				}
+			});
+		};
+		document->save(origin, target);
+		if (!document->loading()) {
+			done();
+		} else {
+			session->downloaderTaskFinished(
+			) | rpl::filter([=] {
+				return !document->loading();
+			}) | rpl::take(1) | rpl::on_next(done, transfer.lifetime);
+		}
+	} else if (document) {
+		const auto media = document->createMediaView();
+		transfer.document = media;
+		const auto read = [=] {
+			auto bytes = media->bytes();
+			if (bytes.isEmpty()) {
+				auto file = QFile(document->filepath(true));
+				if (file.open(QIODevice::ReadOnly)) {
+					bytes = file.readAll();
+				}
+			}
+			return bytes;
+		};
+		if (!media->loaded(true)) {
+			document->save(origin, QString());
+		}
+		if (media->loaded(true)) {
+			finish(read(), QString());
+		} else if (!document->loading()) {
+			finish(QByteArray(), u"tele couldn't start the download"_q);
+		} else {
+			session->downloaderTaskFinished(
+			) | rpl::filter([=] {
+				return media->loaded(true) || !document->loading();
+			}) | rpl::take(1) | rpl::on_next([=] {
+				finish(
+					media->loaded(true) ? read() : QByteArray(),
+					u"the download failed"_q);
+			}, transfer.lifetime);
+		}
+	} else {
+		const auto media = photo->createMediaView();
+		transfer.photo = media;
+		const auto read = [=] {
+			return media->imageBytes(Data::PhotoSize::Large);
+		};
+		media->wanted(Data::PhotoSize::Large, origin);
+		if (media->loaded()) {
+			finish(read(), QString());
+		} else {
+			session->downloaderTaskFinished(
+			) | rpl::filter([=] {
+				return media->loaded()
+					|| photo->failed(Data::PhotoSize::Large);
+			}) | rpl::take(1) | rpl::on_next([=] {
+				finish(
+					media->loaded() ? read() : QByteArray(),
+					u"the download failed"_q);
+			}, transfer.lifetime);
+		}
+	}
+	const auto timeout = (document && !target.isEmpty())
+		? std::max(kTransferTimeout, crl::time(document->size / kSlowestBytesPerMs))
+		: kTransferTimeout;
+	base::call_delayed(timeout, instance, [=] {
+		if (const auto strong = weak.get()) {
+			strong->finishTransfer(key, QByteArray(), u"timed out"_q);
+		}
+	});
+	return created.second;
+}
+
+void Instance::finishSave(int key, QString path, QString error) {
+	if (path.isEmpty()) {
+		finishTransfer(key, QByteArray(), error);
+		return;
+	}
+	const auto i = _transfers.find(key);
+	if (i == end(_transfers) || !_engine) {
+		return;
+	}
+	_transfers.erase(i);
+	settle(key, true, NewString(_engine->ctx(), path));
+}
+
+namespace {
+
+[[nodiscard]] JSValue TextValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		const TextWithTags &value) {
+	const auto entities = Api::EntitiesToMTP(
+		session,
+		TextUtilities::ConvertTextTagsToEntities(value.tags),
+		Api::ConvertOption::SkipLocal);
+	auto buffer = mtpBuffer();
+	entities.write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "Vector<MessageEntity>");
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "text", NewString(ctx, value.text));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"entities",
+		decoded.error.empty() ? decoded.value : JS_NewArray(ctx));
+	return result;
+}
+
+[[nodiscard]] QString GroupName(SettingsGroup group) {
+	switch (group) {
+	case SettingsGroup::Settings: return u"settings"_q;
+	case SettingsGroup::People: return u"people"_q;
+	case SettingsGroup::Device: return u"device"_q;
+	}
+	return u"settings"_q;
+}
+
+[[nodiscard]] JSValue SettingValue(JSContext *ctx, const SettingInfo &info) {
+	return (info.kind == u"toggle"_q)
+		? JS_NewBool(ctx, info.flag)
+		: NewString(ctx, info.text);
+}
