+JSValue Instance::TgOnUnload(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.onUnload(function)");
+	}
+	const auto id = NextRegistrationId();
+	instance->_registrations.emplace(id, Registration{
+		.kind = Kind::Unload,
+		.fn = JS_DupValue(ctx, argv[0]),
+	});
+	return instance->disposer(id);
+}
+
+JSValue Instance::disposer(int id) {
+	const auto ctx = _engine->ctx();
+	auto release = JS_NewCFunctionMagic(
+		ctx,
+		Dispose,
+		"dispose",
+		0,
+		JS_CFUNC_generic_magic,
+		id);
+	JSValueConst args[] = { release };
+	auto result = CallGlobal(ctx, "__teleDisposer", args);
+	JS_FreeValue(ctx, release);
+	return result;
+}
