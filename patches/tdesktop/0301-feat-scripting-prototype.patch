+constexpr auto kUnwrap = R"js((() => {
+	const peers = (u) => ({ users: u.users ?? [], chats: u.chats ?? [] });
+	const none = () => ({ users: [], chats: [] });
+	const messages = (list, type, p) => (list ?? []).map(
+		(message) => [{ _: type, message, pts: 0, ptsCount: 0 }, p]);
+	return (u) => {
+		switch (u?._) {
+		case 'updates':
+		case 'updatesCombined': {
+			const p = peers(u);
+			return u.updates.map((update) => [update, p]);
+		}
+		case 'updateShort':
+			return [[u.update, none()]];
+		case 'updateShortMessage':
+		case 'updateShortChatMessage':
+		case 'updateShortSentMessage':
+			return [[u, none()]];
+		case 'updates.difference':
+		case 'updates.differenceSlice': {
+			const p = peers(u);
+			return [
+				...messages(u.newMessages, 'updateNewMessage', p),
+				...(u.otherUpdates ?? []).map((update) => [update, p]),
+			];
+		}
+		case 'updates.channelDifference': {
+			const p = peers(u);
+			return [
+				...messages(u.newMessages, 'updateNewChannelMessage', p),
+				...(u.otherUpdates ?? []).map((update) => [update, p]),
+			];
+		}
+		}
+		return [];
+	};
+})())js";
