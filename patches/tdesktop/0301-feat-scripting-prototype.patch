index 0000000000000000000000000000000000000000..4792be3c1dfc7e0b1197cdc664ece97d9f2ef203
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/sound.js
@@ -0,0 +1,59 @@
+(() => {
+	const isBytes = (value) => (value instanceof Uint8Array) || (value instanceof ArrayBuffer);
+
+	const playSound = (natives, source, options) => {
+		if (source !== 'notification' && !isBytes(source)) {
+			throw new TypeError("tg.app.playSound: the source is audio bytes (Uint8Array or ArrayBuffer) or 'notification'");
+		} else if (isBytes(source) && source.byteLength === 0) {
+			throw new TypeError('tg.app.playSound: the audio is empty');
+		} else if (options !== undefined && (options === null || typeof options !== 'object')) {
+			throw new TypeError('tg.app.playSound: options must be an object');
+		}
+		const volume = options?.volume;
+		if (volume !== undefined && (typeof volume !== 'number' || !(volume >= 0 && volume <= 1))) {
+			throw new TypeError('tg.app.playSound: volume must be a number from 0 to 1');
+		}
+		const { id, done } = natives.soundPlay(source, volume);
+		const stop = () => {
+			natives.soundStop(id);
+		};
+		return Object.freeze({ done, stop, [Symbol.dispose]: stop });
+	};
+
+	const soundChoice = (sound) => {
+		if (sound === 'default' || sound === 'none') {
+			return sound;
+		} else if (sound !== null && typeof sound === 'object') {
+			const { bytes, name } = sound;
+			if (!isBytes(bytes) || bytes.byteLength === 0) {
+				throw new TypeError('tg.notifications.setSound: a custom sound needs non-empty bytes (Uint8Array or ArrayBuffer)');
+			} else if (typeof name !== 'string' || !name.trim()) {
+				throw new TypeError('tg.notifications.setSound: a custom sound needs a non-empty name');
+			}
+			return { bytes, name: name.trim() };
+		}
+		throw new TypeError("tg.notifications.setSound: the sound is 'default', 'none' or { bytes, name }");
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'sound',
+		tg(tg, natives, { resolvePeer }) {
+			Object.defineProperty(tg.app, 'playSound', {
+				enumerable: true,
+				value: (source, options) => playSound(natives, source, options),
+			});
+			Object.defineProperty(tg, 'notifications', {
+				enumerable: true,
+				value: Object.freeze({
+					async getSound(peer) {
+						return natives.soundGet(await resolvePeer(peer));
+					},
+					async setSound(peer, sound) {
+						const choice = soundChoice(sound);
+						return natives.soundSet(await resolvePeer(peer), choice);
+					},
+				}),
+			});
+		},
+	});
+})();
