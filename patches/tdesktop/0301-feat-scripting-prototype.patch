+[[nodiscard]] QString Stamp(const QString &path) {
+	const auto info = QFileInfo(path);
+	return info.exists()
+		? (QString::number(info.size())
+			+ ':'
+			+ QString::number(info.lastModified().toMSecsSinceEpoch()))
+		: QString();
+}
+
+[[nodiscard]] Stamps Collect(
+		const ScriptFile &file,
+		const std::vector<QString> &loaded) {
+	auto result = Stamps();
+	result.emplace(file.entry, Stamp(file.entry));
+	if (file.folder) {
+		auto iterator = QDirIterator(
+			file.root,
+			QDir::Files | QDir::NoDotAndDotDot,
+			QDirIterator::Subdirectories);
+		while (iterator.hasNext() && result.size() < kMaxStampedFiles) {
+			iterator.next();
+			const auto path = iterator.fileInfo().absoluteFilePath();
+			const auto relative = QDir(file.root).relativeFilePath(path);
+			if (IsScriptFile(iterator.fileInfo().fileName())
+				&& !ranges::any_of(relative.split('/'), Ignored)) {
+				result.emplace(path, Stamp(path));
+			}
+		}
+	}
+	for (const auto &path : loaded) {
+		result.emplace(path, Stamp(path));
+	}
+	return result;
+}
