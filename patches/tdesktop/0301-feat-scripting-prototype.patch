+bool Host::interceptForward(
+		Data::ResolvedForwardDraft &draft,
+		const Api::SendAction &action,
+		FnMut<void()> &done) {
+	const auto peer = action.history->peer;
+	if (draft.items.empty() || !holds(peer, u"forward"_q)) {
+		return false;
+	}
+	auto ids = std::vector<FullMsgId>();
+	for (const auto &item : draft.items) {
+		ids.push_back(item->fullId());
+	}
+	const auto options = draft.options;
+	const auto callback = std::make_shared<FnMut<void()>>(std::move(done));
+	const auto session = _session;
+	draft.items.clear();
+	hold(peer->id, std::make_shared<HeldSend>(HeldSend{
+		.data = SendData{
+			.kind = u"forward"_q,
+			.peer = peer,
+			.scheduled = action.options.scheduled,
+			.silent = action.options.silent,
+			.forwards = ids,
+		},
+		.replay = [=](const SendData &data) {
+			auto items = HistoryItemsList();
+			for (const auto &id : ids) {
+				if (const auto item = session->data().message(id)) {
+					items.push_back(item);
+				}
+			}
+			if (items.empty()) {
+				return;
+			}
+			auto copy = action;
+			ApplySend(copy, data, 0);
+			session->api().forwardMessages(
+				Data::ResolvedForwardDraft{
+					.items = std::move(items),
+					.options = options,
+				},
+				copy,
+				std::move(*callback));
+		},
+	}));
+	return true;
+}
+
+void Host::processSend(PeerId peerId) {
+	const auto i = _sends.find(peerId);
+	if (i == end(_sends) || i->second.empty()) {
+		return;
+	}
+	const auto held = i->second.front();
+	const auto weak = base::make_weak(this);
+	runSend(held, senders(held->data.kind), 0, [=](bool send) {
+		crl::on_main(weak, [=] {
+			const auto j = _sends.find(peerId);
+			if (j == end(_sends)
+				|| j->second.empty()
+				|| j->second.front() != held) {
+				return;
+			}
+			j->second.pop_front();
+			if (send) {
+				++Resending;
+				held->replay(held->data);
+				--Resending;
+			} else if (held->dropped) {
+				held->dropped();
+			}
+			if (j->second.empty()) {
+				_sends.erase(j);
+			} else {
+				processSend(peerId);
+			}
+		});
+	});
+}
+
+void Host::runSend(
+		std::shared_ptr<HeldSend> held,
+		std::vector<QString> scripts,
+		int index,
+		Fn<void(bool)> done) {
+	if (index >= int(scripts.size())) {
+		done(true);
+		return;
+	}
+	const auto instance = instanceOf(scripts[index]);
+	if (!instance) {
+		runSend(std::move(held), std::move(scripts), index + 1, done);
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	instance->interceptSend(held->data, [=](
+			std::optional<SendData> result) {
+		crl::on_main(weak, [=] {
+			if (!result) {
+				done(false);
+				return;
+			}
+			held->data = *result;
+			runSend(held, scripts, index + 1, done);
+		});
+	});
+}
+
+void Host::processUpdates() {
+	const auto &front = _updates.front();
+	const auto bytes = std::string(
+		View(front.message.reply.constData(), front.message.reply.size()));
+	intercept(bytes, interceptors(), 0, [=](std::string result) {
+		if (_updates.empty()) {
+			return;
+		}
+		feed(result);
+		auto queued = std::move(_updates.front());
+		_updates.pop_front();
+		if (result != bytes) {
+			queued.message.reply = ToBuffer(result);
+		}
+		queued.deliver(queued.message);
+		if (!_updates.empty()) {
+			processUpdates();
+		}
+	});
+}
