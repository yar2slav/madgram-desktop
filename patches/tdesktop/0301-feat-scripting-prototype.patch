+void AppendTextWithTags(TextWithTags &to, const TextWithTags &from) {
+	const auto shift = int(to.text.size());
+	to.text.append(from.text);
+	for (auto tag : from.tags) {
+		tag.offset += shift;
+		to.tags.push_back(tag);
+	}
+}
