+
+bool Host::beforeSend(
+		mtpRequestId requestId,
+		const mtpPrime *body,
+		int size,
+		MTP::ShiftedDcId shiftedDcId,
+		mtpRequestId afterRequestId,
+		crl::time msCanWait,
+		Fn<void(mtpBuffer)> deliver) {
+	if (size <= 0) {
+		return false;
+	}
+	const auto view = View(body, size);
+	const auto method = TlRuntime::BundledSchema().method(LeadingId(view));
+	if (!method) {
+		return false;
+	}
+	const auto listened = CarriesUpdates(*method)
+		&& ranges::any_of(_entries, [](const Entry &entry) {
+			return entry.instance && entry.instance->listens();
+		});
+	if (listened) {
+		_listened.emplace(requestId);
+		prune();
+	}
+	if (Sending > 0) {
+		return false;
+	}
+	auto chain = std::vector<Link>();
+	for (const auto &entry : _entries) {
+		if (entry.instance) {
+			for (const auto id : entry.instance->middlewares(method->name)) {
+				chain.push_back({ .script = entry.file.id, .id = id });
+			}
+		}
+	}
+	const auto difference = (method->name == "updates.getDifference"
+		|| method->name == "updates.getChannelDifference")
+		&& !interceptors().empty();
+	if (chain.empty() && !difference) {
+		return false;
+	}
+	auto held = std::make_shared<Held>(Held{
+		.requestId = requestId,
+		.method = method,
+		.chain = std::move(chain),
+		.shiftedDcId = shiftedDcId,
+		.afterRequestId = afterRequestId,
+		.msCanWait = msCanWait,
+		.deliver = std::move(deliver),
+	});
+	_held.emplace(requestId);
+	crl::on_main(this, [=, bytes = std::string(view)] {
+		step(held, 0, bytes, [=](std::string result) {
+			crl::on_main(this, [=] {
+				_held.remove(held->requestId);
+				held->deliver(ToBuffer(result));
+			});
+		});
+	});
+	return true;
+}
+
+bool Host::held(mtpRequestId requestId) const {
+	return _held.contains(requestId);
+}
+
+void Host::step(
+		std::shared_ptr<Held> held,
+		int index,
+		std::string bytes,
+		Done done) {
+	if (index >= int(held->chain.size())) {
+		forward(std::move(held), std::move(bytes), std::move(done));
+		return;
+	}
+	const auto &link = held->chain[index];
+	const auto instance = instanceOf(link.script);
+	if (!instance || !instance->hasRegistration(link.id)) {
+		step(std::move(held), index + 1, std::move(bytes), std::move(done));
+		return;
+	}
+	const auto state = std::make_shared<Step>();
+	const auto weak = base::make_weak(this);
+	const auto finish = [=](std::string result) {
+		if (!state->delivered) {
+			state->delivered = true;
+			done(std::move(result));
+		}
+	};
+	instance->runMiddleware(
+		link.id,
+		*held->method,
+		bytes,
+		[=](std::string next, Fn<void(std::string)> resolve) {
+			state->nextCalled = true;
+			crl::on_main(weak, [=] {
+				step(held, index + 1, next, [=](std::string result) {
+					state->result = result;
+					if (state->finished) {
+						finish(result);
+					} else {
+						resolve(result);
+					}
+				});
+			});
+		},
+		[=](MiddlewareOutcome outcome) {
+			if (state->finished) {
+				return;
+			}
+			state->finished = true;
+			crl::on_main(weak, [=] {
+				if (outcome.bytes) {
+					finish(*outcome.bytes);
+				} else if (state->result) {
+					finish(*state->result);
+				} else if (!state->nextCalled) {
+					state->delivered = true;
+					step(held, index + 1, bytes, done);
+				}
+			});
+		});
+}
+
+void Host::forward(std::shared_ptr<Held> held, std::string bytes, Done done) {
+	const auto weak = base::make_weak(this);
+	const auto difference = (held->method->name == "updates.getDifference")
+		|| (held->method->name == "updates.getChannelDifference");
+	const auto scope = SendingFromScript();
+	_api.request(RawRequest(
+		QByteArray(bytes.data(), int(bytes.size())))
+	).toDC(
+		held->shiftedDcId
+	).afterDelay(
+		held->msCanWait
+	).afterRequest(
+		held->afterRequestId
+	).done([=](const RawResult &result) {
+		auto reply = std::string(result.bytes.constData(), result.bytes.size());
+		if (!difference || !weak) {
+			done(std::move(reply));
+			return;
+		}
+		intercept(std::move(reply), interceptors(), 0, done);
+	}).fail([=](const MTP::Error &error) {
+		done(EncodeRpcError(error.code(), error.type().toStdString()));
+	}).send();
+}
+
+void Host::intercept(
+		std::string bytes,
+		std::vector<QString> scripts,
+		int index,
+		Done done) {
+	const auto instance = (index < int(scripts.size()))
+		? instanceOf(scripts[index])
+		: nullptr;
+	if (index >= int(scripts.size())) {
+		done(std::move(bytes));
+		return;
+	} else if (!instance) {
+		intercept(std::move(bytes), std::move(scripts), index + 1, done);
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	instance->interceptUpdates(bytes, [=](std::optional<std::string> result) {
+		crl::on_main(weak, [=] {
+			intercept(result.value_or(bytes), scripts, index + 1, done);
+		});
+	});
+}
