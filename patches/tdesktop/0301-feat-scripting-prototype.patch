+class Panel final : public base::has_weak_ptr {
+public:
+	Panel(
+		not_null<Instance*> instance,
+		not_null<Window::SessionController*> window,
+		int id,
+		int handler,
+		Options options);
+	~Panel();
+
+	[[nodiscard]] bool valid() const;
+	[[nodiscard]] int handler() const;
+	void post(QByteArray json);
+	void setTitle(const QString &title);
+
+private:
+	void createPanel(not_null<QWidget*> parent, const Options &options);
+	bool createWebview(not_null<Instance*> instance, Options options);
+	void activate();
+	void loaded();
+	void deliver(const QByteArray &json);
+	void updateTheme();
+	void closed();
+
+	const base::weak_ptr<Instance> _instance;
+	const int _id = 0;
+	const int _handler = 0;
+	rpl::variable<QString> _title;
+	std::unique_ptr<Ui::SeparatePanel> _panel;
+	Ui::RpWidget *_container = nullptr;
+	std::unique_ptr<Webview::Window> _webview;
+	std::vector<QByteArray> _queue;
+	bool _loaded = false;
+	bool _closing = false;
+
+};
+
+struct Panels {
+	explicit Panels(not_null<Instance*> instance);
+	~Panels();
+
+	const not_null<Instance*> instance;
+	base::flat_map<int, std::unique_ptr<Panel>> list;
+	int next = 0;
+};
+
+[[nodiscard]] base::flat_map<not_null<Instance*>, not_null<Panels*>> &All() {
+	static auto result = base::flat_map<
+		not_null<Instance*>,
+		not_null<Panels*>>();
+	return result;
+}
+
+Panels::Panels(not_null<Instance*> instance) : instance(instance) {
+	All().emplace(instance, this);
+}
+
+Panels::~Panels() {
+	All().remove(instance);
+}
+
+[[nodiscard]] Panels *FindPanels(not_null<Instance*> instance) {
+	const auto i = All().find(instance);
+	return (i != end(All())) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] not_null<Panels*> PanelsFor(not_null<Instance*> instance) {
+	if (const auto found = FindPanels(instance)) {
+		return found;
+	}
+	return ScriptLifetime(instance).make_state<Panels>(instance);
+}
+
+[[nodiscard]] Panel *FindPanel(not_null<Instance*> instance, int id) {
+	const auto panels = FindPanels(instance);
+	if (!panels) {
+		return nullptr;
+	}
+	const auto i = panels->list.find(id);
+	return (i != end(panels->list)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] std::unique_ptr<Panel> TakePanel(
+		not_null<Instance*> instance,
+		int id) {
+	const auto panels = FindPanels(instance);
+	if (!panels) {
+		return nullptr;
+	}
+	const auto i = panels->list.find(id);
+	if (i == end(panels->list)) {
+		return nullptr;
+	}
+	auto result = std::move(i->second);
+	panels->list.erase(i);
+	return result;
+}
+
+void ClosedByUser(base::weak_ptr<Instance> weak, int id) {
+	const auto strong = weak.get();
+	if (!strong) {
+		return;
+	}
+	auto panel = TakePanel(strong, id);
+	if (!panel) {
+		return;
+	}
+	const auto handler = panel->handler();
+	panel = nullptr;
+	CallKept(weak, handler, [](JSContext *ctx) {
+		auto result = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, result, "type", JS_NewString(ctx, "close"));
+		return result;
+	}, QString::fromLatin1(kWhere));
+	ForgetKept(weak, handler);
+}
