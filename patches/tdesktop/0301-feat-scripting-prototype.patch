+[[nodiscard]] QStringList GrantsBeyond(
+		const QStringList &from,
+		const QStringList &to) {
+	auto error = QString();
+	const auto was = Permissions::Parse(from, error);
+	auto result = QStringList();
+	for (const auto &grant : Permissions::Parse(to, error).strings()) {
+		if (!was.covers(Permissions::Parse(QStringList{ grant }, error))) {
+			result.push_back(u"\u2022 "_q + DescribeGrant(grant));
+		}
+	}
+	return result;
+}
