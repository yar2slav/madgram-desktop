+DecodeFilter Instance::filter() const {
+	const auto unfiltered = _permissions.any(Capability::DisableApiFiltering);
+	return {
+		.sensitive = !unfiltered,
+		.drafts = !unfiltered
+			&& !_permissions.allows(Capability::AccountRead, "draft"),
+	};
+}
+
+JSValue Instance::makeTg() {
+	const auto ctx = _engine->ctx();
+	auto tg = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		tg,
+		"call",
+		JS_NewCFunction(ctx, TgCall, "call", 1));
+	const auto registrar = [&](const char *name, Kind kind) {
+		JS_SetPropertyStr(
+			ctx,
+			tg,
+			name,
+			JS_NewCFunctionMagic(
+				ctx,
+				TgRegister,
+				name,
+				2,
+				JS_CFUNC_generic_magic,
+				int(kind)));
+	};
+	registrar("onUpdate", Kind::Listener);
+	registrar("interceptRpc", Kind::Rpc);
+	registrar("interceptUpdate", Kind::Update);
+	JS_SetPropertyStr(
+		ctx,
+		tg,
+		"onUnload",
+		JS_NewCFunction(ctx, TgOnUnload, "onUnload", 1));
+	const auto method = [&](
+			JSValueConst object,
+			const char *name,
+			JSCFunctionMagic *function,
+			int length,
+			int magic) {
+		JS_SetPropertyStr(
+			ctx,
+			object,
+			name,
+			JS_NewCFunctionMagic(
+				ctx,
+				function,
+				name,
+				length,
+				JS_CFUNC_generic_magic,
+				magic));
+	};
+	auto storage = JS_NewObject(ctx);
+	method(storage, "get", TgStorage, 1, kStorageGet);
+	method(storage, "set", TgStorage, 2, kStorageSet);
+	method(storage, "has", TgStorage, 1, kStorageHas);
+	method(storage, "delete", TgStorage, 1, kStorageDelete);
+	method(storage, "keys", TgStorage, 0, kStorageKeys);
+	method(storage, "clear", TgStorage, 0, kStorageClear);
+	JS_SetPropertyStr(ctx, tg, "storage", storage);
+	auto peers = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		peers,
+		"get",
+		JS_NewCFunction(ctx, TgPeersGet, "get", 1));
+	JS_SetPropertyStr(
+		ctx,
+		peers,
+		"resolve",
+		JS_NewCFunction(ctx, TgPeersResolve, "resolve", 1));
+	const auto selfAtom = JS_NewAtom(ctx, "self");
+	JS_DefinePropertyGetSet(
+		ctx,
+		peers,
+		selfAtom,
+		JS_NewCFunction(ctx, TgPeersSelf, "self", 0),
+		JS_UNDEFINED,
+		JS_PROP_ENUMERABLE | JS_PROP_CONFIGURABLE);
+	JS_FreeAtom(ctx, selfAtom);
+	JS_SetPropertyStr(ctx, tg, "peers", peers);
+	method(tg, "toast", TgUi, 1, kUiToast);
+	auto ui = JS_NewObject(ctx);
+	method(ui, "toast", TgUi, 1, kUiToast);
+	method(ui, "notice", TgUi, 1, kUiNotice);
+	method(ui, "dialog", TgDialog, 1, 0);
+	method(ui, "prompt", TgDialog, 1, 1);
+	method(ui, "chooser", TgDialog, 1, 2);
+	JS_SetPropertyStr(ctx, tg, "ui", ui);
+	method(tg, "notify", TgUi, 2, kUiNotify);
+	method(tg, "openUrl", TgUi, 1, kUiOpen);
+	auto clipboard = JS_NewObject(ctx);
+	method(clipboard, "read", TgClipboard, 0, 0);
+	method(clipboard, "write", TgClipboard, 1, 1);
+	JS_SetPropertyStr(ctx, tg, "clipboard", clipboard);
+	JS_SetPropertyStr(
+		ctx,
+		tg,
+		"randomId",
+		JS_NewCFunction(ctx, TgRandomId, "randomId", 0));
+	auto global = JS_GetGlobalObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		global,
+		"fetch",
+		JS_NewCFunction(ctx, Fetch, "fetch", 2));
+	JS_DefinePropertyValueStr(
+		ctx,
+		global,
+		"__teleParse",
+		JS_NewCFunction(ctx, ParseText, "__teleParse", 2),
+		0);
+	JS_FreeValue(ctx, global);
+	JS_SetPropertyStr(
+		ctx,
+		tg,
+		"selfId",
+		JS_NewBigInt64(ctx, std::int64_t(_session->userId().bare)));
+	const auto name = _name.toUtf8();
+	JS_SetPropertyStr(
+		ctx,
+		tg,
+		"scriptName",
+		JS_NewStringLen(ctx, name.constData(), name.size()));
+	auto natives = makeNatives();
+	AddExtensionNatives(ctx, natives);
+	JSValueConst globalArgs[] = { natives };
+	auto globals = CallGlobal(ctx, "__teleExtendGlobals", globalArgs);
+	if (JS_IsException(globals)) {
+		_engine->report(u"building the globals"_q);
+	}
+	JS_FreeValue(ctx, globals);
+	JSValueConst args[] = { tg, natives };
+	auto extended = CallGlobal(ctx, "__teleExtendTg", args);
+	if (JS_IsException(extended)) {
+		_engine->report(u"building tg"_q);
+	}
+	JS_FreeValue(ctx, extended);
+	JS_FreeValue(ctx, natives);
+	return tg;
+}
+
+JSValue Instance::makeNatives() {
+	const auto ctx = _engine->ctx();
+	auto natives = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"peer",
+		JS_NewCFunction(ctx, NativePeer, "peer", 1));
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"fetchAbort",
+		JS_NewCFunction(ctx, FetchAbort, "fetchAbort", 1));
+	const auto event = [&](const char *name, int kind) {
+		JS_SetPropertyStr(
+			ctx,
+			natives,
+			name,
+			JS_NewCFunctionMagic(
+				ctx,
+				NativeEvent,
+				name,
+				1,
+				JS_CFUNC_generic_magic,
+				kind));
+	};
+	event("listenNew", 0);
+	event("listenEdit", 1);
+	event("listenDelete", 2);
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"deleted",
+		JS_NewCFunction(ctx, NativeDeleted, "deleted", 4));
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"read",
+		JS_NewCFunction(ctx, NativeRead, "read", 2));
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"download",
+		JS_NewCFunction(ctx, NativeDownload, "download", 3));
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"listenSend",
+		JS_NewCFunction(ctx, NativeSend, "listenSend", 1));
+	JS_SetPropertyStr(
+		ctx,
+		natives,
+		"command",
+		JS_NewCFunction(ctx, NativeCommand, "command", 1));
+	const auto action = [&](const char *name, int menu) {
+		JS_SetPropertyStr(
+			ctx,
+			natives,
+			name,
+			JS_NewCFunctionMagic(
+				ctx,
+				NativeAction,
+				name,
+				1,
+				JS_CFUNC_generic_magic,
