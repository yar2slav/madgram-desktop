@@ -0,0 +1,86 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Tele::Scripting {
+
+enum class Capability : uchar {
+	Call,
+	OnUpdate,
+	InterceptRpc,
+	InterceptUpdate,
+	InterceptSendMessage,
+	AccountRead,
+	AccountWrite,
+	Fetch,
+	ClipboardRead,
+	ClipboardWrite,
+	OpenUrl,
+	Notify,
+	InterceptLink,
+	InterceptNotification,
+	Options,
+	Scripts,
+	FilesWrite,
+	App,
+	InterceptDrop,
+	Calls,
+	Accounts,
+	Exec,
+	UiRead,
+	UiWrite,
+	Display,
+	FsRead,
+	FsWrite,
+	Automate,
+	DisableApiFiltering,
+};
+
+enum class Tier : uchar {
+	Neutral,
+	Caution,
+	Dangerous,
+};
+
+struct Grant {
+	Capability capability = Capability::Call;
+	std::string scope;
+
+	friend inline bool operator==(const Grant &, const Grant &) = default;
+};
+
+class Permissions final {
+public:
+	[[nodiscard]] static Permissions Parse(
+		const QStringList &list,
+		QString &error,
+		QStringList *warnings = nullptr);
+
+	[[nodiscard]] bool allows(
+		Capability capability,
+		std::string_view name) const;
+	[[nodiscard]] bool any(Capability capability) const;
+	[[nodiscard]] bool covers(const Permissions &other) const;
+	[[nodiscard]] bool empty() const;
+	[[nodiscard]] QStringList strings() const;
+	[[nodiscard]] const std::vector<Grant> &grants() const;
+
+private:
+	std::vector<Grant> _grants;
+
+};
+
+[[nodiscard]] const char *CapabilityName(Capability capability);
+[[nodiscard]] QString GrantText(Capability capability, std::string_view scope);
+[[nodiscard]] QString ResolveScopeFolder(std::string_view scope);
+[[nodiscard]] bool PathInside(const QString &path, const QString &folder);
+[[nodiscard]] Tier GrantTier(const Grant &grant);
+[[nodiscard]] bool DangerousName(Capability capability, std::string_view name);
+[[nodiscard]] bool TakeoverMethod(std::string_view method);
+[[nodiscard]] std::vector<Grant> AccountGrantsFor(std::string_view method);
+[[nodiscard]] bool IsGlob(std::string_view pattern);
+[[nodiscard]] bool IsUpdateName(std::string_view name);
+
+} // namespace Tele::Scripting
