+++ b/Telegram/SourceFiles/tele/tele_peer_id.cpp
@@ -1,7 +1,9 @@
 #include "tele/tele_peer_id.h"
 
+#include "base/options.h"
 #include "data/data_changes.h"
 #include "data/data_peer.h"
+#include "info/profile/info_profile_actions.h"
 #include "lang/lang_tag.h"
 #include "main/main_session.h"
 #include "mtproto/mtp_instance.h"
@@ -76,6 +78,13 @@ private:
 	return QString();
 }
 
+[[nodiscard]] QString DcText(not_null<PeerData*> peer, int dc) {
+	const auto location = DcLocation(peer, dc);
+	return location.isEmpty()
+		? QString::number(dc)
+		: u"%1, %2"_q.arg(dc).arg(Lower(location));
+}
+
 [[nodiscard]] rpl::producer<int> PeerDcValue(not_null<PeerData*> peer) {
 	return peer->session().changes().peerFlagsValue(
 		peer,
@@ -85,6 +94,41 @@ private:
 	}) | rpl::distinct_until_changed();
 }
 
+[[nodiscard]] rpl::producer<bool> ShowPeerIdValue() {
+	const auto option = &base::options::lookup<bool>(
+		::Info::Profile::kOptionShowPeerIdBelowAbout);
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		option->changes()
+	) | rpl::map([=] {
+		return option->value();
+	});
+}
+
+[[nodiscard]] rpl::producer<int> MergedDcValue(not_null<PeerData*> peer) {
+	return rpl::combine(
+		MergeIdDcValue(),
+		ShowDcValue(),
+		PeerDcValue(peer)
+	) | rpl::map([](bool merge, bool show, int dc) {
+		return (merge && show) ? dc : 0;
+	}) | rpl::distinct_until_changed();
+}
+
+void CopyDc(
+		not_null<PeerData*> peer,
+		base::weak_ptr<Window::SessionController> weak) {
+	TextUtilities::SetClipboardText({ QString::number(PeerDc(peer)) });
+	if (const auto strong = weak.get()) {
+		strong->showToast({
+			.text = { Lower(u"DC copied to clipboard."_q) },
+			.iconLottie = u"toast/copy"_q,
+			.iconLottieSize = st::toastLottieIconSize,
+		});
+	}
+}
+
 } // namespace
 
 QString FormatPeerId(not_null<PeerData*> peer) {
@@ -102,8 +146,19 @@ QString FormatPeerId(not_null<PeerData*> peer) {
 }
 
 rpl::producer<TextWithEntities> PeerIdTextValue(not_null<PeerData*> peer) {
-	return PeerIdValue(peer) | rpl::map([](const QString &id) {
-		return Ui::Text::Link(id, kLinkIndex);
+	return rpl::combine(
+		ShowPeerIdValue(),
+		PeerIdValue(peer),
+		MergedDcValue(peer)
+	) | rpl::map([=](bool shown, const QString &id, int dc) {
+		if (!shown) {
+			return TextWithEntities();
+		}
+		return Ui::Text::Link(
+			(dc
+				? u"%1 (%2%3)"_q.arg(id, Lower(u"DC"_q), DcText(peer, dc))
+				: id),
+			kLinkIndex);
 	});
 }
 
@@ -122,15 +177,24 @@ void SetupPeerIdLabel(
 			});
 		}
 	};
-	PeerIdValue(peer) | rpl::on_next([=](const QString &id) {
+	PeerIdTextValue(peer) | rpl::on_next([=] {
 		label->setLink(
 			kLinkIndex,
-			std::make_shared<CopyClickHandler>(id, copy));
+			std::make_shared<CopyClickHandler>(FormatPeerId(peer), copy));
+	}, label->lifetime());
+	const auto mergedDc = label->lifetime().make_state<int>(0);
+	MergedDcValue(peer) | rpl::on_next([=](int dc) {
+		*mergedDc = dc;
 	}, label->lifetime());
 	label->setContextMenuHook([=](
 			Ui::FlatLabel::ContextMenuRequest request) {
 		if (request.selection.empty()) {
 			request.menu->addAction(Lower(u"Copy ID"_q), copy);
+			if (*mergedDc) {
+				request.menu->addAction(Lower(u"Copy DC"_q), [=] {
+					CopyDc(peer, weak);
+				});
+			}
 		} else {
 			label->fillContextMenu(request);
 		}
@@ -138,16 +202,16 @@ void SetupPeerIdLabel(
 }
 
 rpl::producer<TextWithEntities> PeerDcTextValue(not_null<PeerData*> peer) {
-	return PeerDcValue(peer) | rpl::map([=](int dc) {
-		if (!dc) {
+	return rpl::combine(
+		ShowDcValue(),
+		MergeIdDcValue(),
+		ShowPeerIdValue(),
+		PeerDcValue(peer)
+	) | rpl::map([=](bool shown, bool merge, bool idShown, int dc) {
+		if (!shown || (merge && idShown) || !dc) {
 			return TextWithEntities();
 		}
-		const auto location = DcLocation(peer, dc);
-		return Ui::Text::Link(
-			(location.isEmpty()
-				? QString::number(dc)
-				: u"%1, %2"_q.arg(dc).arg(Lower(location))),
-			kLinkIndex);
+		return Ui::Text::Link(DcText(peer, dc), kLinkIndex);
 	});
 }
 
