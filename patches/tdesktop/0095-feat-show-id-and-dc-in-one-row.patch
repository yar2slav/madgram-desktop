 base::options::toggle MessageIdMenuOption({
 	.id = kOptionMessageIdMenu,
 	.name = "Show message ID in the message menu",
@@ -914,8 +922,24 @@ rpl::producer<> PeerIdFormatChanges() {
 		BotApiPeerIdsOption.changes());
 }
 
-bool ShowDc() {
-	return ShowDcOption.value();
+rpl::producer<bool> ShowDcValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		ShowDcOption.changes()
+	) | rpl::map([] {
+		return ShowDcOption.value();
