Subject: [PATCH] feat: animate mad name effects in the profile title

---
 .../info/profile/info_profile_top_bar.cpp     | 11 +++++++--
 .../SourceFiles/ui/widgets/marquee_label.cpp  | 24 +++++++++++++++++++
 .../SourceFiles/ui/widgets/marquee_label.h    |  2 ++
 3 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/info/profile/info_profile_top_bar.cpp b/Telegram/SourceFiles/info/profile/info_profile_top_bar.cpp
index b90210de7591ca65ad35541d5ddbbb7fe04332f5..a6e7dce7563808090aeb9717a05a4c66a71b81ae 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_top_bar.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_top_bar.cpp
@@ -702,11 +702,18 @@ void TopBar::adjustColors(const std::optional<QColor> &edgeColor) {
 	const auto shouldOverrideTitle = shouldOverride(_title->st().textFg);
 	const auto shouldOverrideStatus = shouldOverrideTitle
 		|| shouldOverride(_status->st().textFg);
-	_title->setTextColorOverride(::Tele::MadTitleColor(_peer, collectible
+	const auto titleColor = collectible
 		? collectible->textColor
 		: shouldOverrideTitle
 		? std::optional<QColor>(st::groupCallMembersFg->c)
-		: std::nullopt));
+		: std::nullopt;
+	_title->setTextColorOverride(::Tele::MadTitleColor(_peer, titleColor));
+	const auto peer = _peer.get();
+	_title->setTextPenCallback(titleColor
+		? Fn<void(QPainter&, QRect)>()
+		: Fn<void(QPainter&, QRect)>([=](QPainter &p, QRect rect) {
+			::Tele::ApplyMadNameColor(p, peer, rect);
+		}));
 	_tabSubtitleOverride = collectible
 		? collectible->textColor
 		: shouldOverrideStatus
diff --git a/Telegram/SourceFiles/ui/widgets/marquee_label.cpp b/Telegram/SourceFiles/ui/widgets/marquee_label.cpp
index b5c0174c264b534d493becf0b12c8f16ce534e67..e58861c846d3dfc69d98741981265fa60dbb4e9a 100644
--- a/Telegram/SourceFiles/ui/widgets/marquee_label.cpp
+++ b/Telegram/SourceFiles/ui/widgets/marquee_label.cpp
@@ -68,6 +68,13 @@ void MarqueeLabel::setTextColorOverride(std::optional<QColor> color) {
 	update();
 }
 
+void MarqueeLabel::setTextPenCallback(
+		Fn<void(QPainter&, QRect)> callback) {
+	_textPenCallback = std::move(callback);
+	invalidateCache();
+	update();
+}
+
 void MarqueeLabel::setContextCopyText(const QString &copyText) {
 	_contextCopyText = copyText;
 }
@@ -265,6 +272,15 @@ void MarqueeLabel::paintEvent(QPaintEvent *e) {
 	} else {
 		p.setPen(_st.textFg);
 	}
+	if (_textPenCallback) {
+		const auto textWidth = std::min(width(), _text.maxWidth());
+		const auto textLeft = _st.align.testFlag(Qt::AlignHCenter)
+			? (width() - textWidth) / 2
+			: _st.align.testFlag(Qt::AlignRight)
+			? (width() - textWidth)
+			: 0;
+		_textPenCallback(p, QRect(textLeft, 0, textWidth, height()));
+	}
 	p.setTextPalette(_st.palette);
 	_text.draw(p, {
 		.position = { 0, 0 },
@@ -299,6 +315,9 @@ void MarqueeLabel::validateTape() {
 	} else {
 		q.setPen(_st.textFg);
 	}
+	if (_textPenCallback) {
+		_textPenCallback(q, QRect(0, 0, natural, height()));
+	}
 	q.setTextPalette(_st.palette);
 	_text.draw(q, {
 		.position = { 0, 0 },
@@ -377,6 +396,11 @@ void MarqueeLabel::validateFrame(float64 offset, TextSelection selection) {
 		} else {
 			q.setPen(_st.textFg);
 		}
+		if (_textPenCallback) {
+			_textPenCallback(
+				q,
+				QRect(int(-offset), 0, int(natural), height()));
+		}
 		q.setTextPalette(_st.palette);
 		const auto drawText = [&](float64 left) {
 			q.translate(left, 0);
diff --git a/Telegram/SourceFiles/ui/widgets/marquee_label.h b/Telegram/SourceFiles/ui/widgets/marquee_label.h
index b2623a32af81775016bed793ed4c31d66da81a24..188a21688a51ad23fbd5022a59843fcbf5c99098 100644
--- a/Telegram/SourceFiles/ui/widgets/marquee_label.h
+++ b/Telegram/SourceFiles/ui/widgets/marquee_label.h
@@ -35,6 +35,7 @@ public:
 	}
 
 	void setTextColorOverride(std::optional<QColor> color);
+	void setTextPenCallback(Fn<void(QPainter&, QRect)> callback);
 	void setContextCopyText(const QString &copyText);
 	void setSelectable(bool selectable);
 
@@ -87,6 +88,7 @@ private:
 	const style::FlatLabel &_st;
 	Text::String _text;
 	std::optional<QColor> _textColorOverride;
+	Fn<void(QPainter&, QRect)> _textPenCallback;
 	QString _contextCopyText;
 	base::unique_qptr<PopupMenu> _menu;
 
