+	return OnlineInBigGroupsOption.value();
+}
+
+rpl::producer<bool> OnlineInBigGroupsValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		OnlineInBigGroupsOption.changes()
+	) | rpl::map([] {
+		return OnlineInBigGroupsOption.value();
+	});
+}
+
 bool HideSponsored() {
 	return HideSponsoredOption.value();
 }
