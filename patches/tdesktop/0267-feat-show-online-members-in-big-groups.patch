diff --git a/Telegram/SourceFiles/tele/tele_onlines.cpp b/Telegram/SourceFiles/tele/tele_onlines.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e00602ce902537cc0537f3ffc2aa3508ce1856ac
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_onlines.cpp
@@ -0,0 +1,155 @@
+#include "tele/tele_onlines.h"
+
+#include "apiwrap.h"
+#include "base/timer.h"
+#include "data/data_changes.h"
+#include "data/data_channel.h"
+#include "main/main_session.h"
+#include "mtproto/mtproto_config.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kRefreshTimeout = crl::time(60 * 1000);
+constexpr auto kRefreshSlack = crl::time(1000);
+
+struct Entry {
+	int count = 0;
+	crl::time requested = 0;
+	mtpRequestId requestId = 0;
+};
+
+struct State {
+	base::flat_map<PeerId, Entry> entries;
+	rpl::event_stream<PeerId> updates;
+};
+
+std::map<not_null<Main::Session*>, std::unique_ptr<State>> States;
+
+[[nodiscard]] State *FindState(not_null<Main::Session*> session) {
+	const auto i = States.find(session);
+	return (i != end(States)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] not_null<State*> ResolveState(
+		not_null<Main::Session*> session) {
+	if (const auto state = FindState(session)) {
+		return state;
+	}
+	const auto result = States.emplace(
+		session,
+		std::make_unique<State>()).first->second.get();
+	session->lifetime().add([=] {
+		States.erase(session);
+	});
+	return result;
+}
+
+[[nodiscard]] bool Wanted(not_null<PeerData*> peer) {
+	if (!OnlineInBigGroups() || peer->isMonoforum()) {
+		return false;
+	}
+	const auto channel = peer->asChannel();
+	if (!channel
+		|| !(channel->isMegagroup() || channel->isGigagroup())
+		|| !channel->membersCountKnown()) {
+		return false;
+	}
+	return !channel->canViewMembers()
+		|| (channel->membersCount()
+			> channel->session().serverConfig().chatSizeMax);
+}
+
+void Request(not_null<PeerData*> peer) {
+	const auto session = &peer->session();
+	const auto state = ResolveState(session);
+	const auto peerId = peer->id;
+	auto &entry = state->entries[peerId];
+	const auto now = crl::now();
+	if (entry.requestId
+		|| (entry.requested
+			&& (now - entry.requested < kRefreshTimeout - kRefreshSlack))) {
+		return;
+	}
+	entry.requested = now;
+	const auto finish = [=](int count) {
+		const auto state = FindState(session);
+		if (!state) {
+			return;
+		}
+		const auto i = state->entries.find(peerId);
+		if (i == end(state->entries)) {
+			return;
+		}
+		i->second.requestId = 0;
+		if (i->second.count != count) {
+			i->second.count = count;
+			state->updates.fire_copy(peerId);
+		}
+	};
+	entry.requestId = session->api().request(MTPmessages_GetOnlines(
+		peer->input()
+	)).done([=](const MTPChatOnlines &result) {
+		finish(result.data().vonlines().v);
+	}).fail([=] {
+		finish(0);
+	}).send();
+}
+
+} // namespace
+
+int OnlinesCount(not_null<PeerData*> peer) {
+	if (!Wanted(peer)) {
+		return 0;
+	}
+	const auto state = FindState(&peer->session());
+	if (!state) {
+		return 0;
+	}
+	const auto i = state->entries.find(peer->id);
+	return (i != end(state->entries)) ? i->second.count : 0;
+}
+
+rpl::producer<> OnlinesChanges(not_null<PeerData*> peer) {
+	return [=](auto consumer) {
+		auto result = rpl::lifetime();
+		const auto timer = result.make_state<base::Timer>([=] {
+			if (Wanted(peer)) {
+				Request(peer);
+			}
+		});
+		const auto check = [=] {
+			if (Wanted(peer)) {
+				Request(peer);
+				if (!timer->isActive()) {
+					timer->callEach(kRefreshTimeout);
+				}
+			} else {
+				timer->cancel();
+			}
+		};
+		const auto id = peer->id;
+		ResolveState(&peer->session())->updates.events(
+		) | rpl::filter([=](PeerId value) {
+			return (value == id);
+		}) | rpl::on_next([=] {
+			consumer.put_next({});
+		}, result);
+		OnlineInBigGroupsValue(
+		) | rpl::skip(1) | rpl::on_next([=] {
+			check();
+			consumer.put_next({});
+		}, result);
+		using Flag = Data::PeerUpdate::Flag;
+		peer->session().changes().peerFlagsValue(
+			peer,
+			Flag::Members | Flag::Rights | Flag::FullInfo
+		) | rpl::on_next([=] {
+			check();
+		}, result);
+		return result;
+	};
+}
+
+} // namespace Tele
