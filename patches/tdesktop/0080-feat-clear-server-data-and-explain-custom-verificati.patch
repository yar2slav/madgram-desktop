 		if (!url) {
@@ -815,6 +835,15 @@ void RefreshBadges(Fn<void(QString)> done) {
 	}
 }
 
+void ClearBadgesCache(Fn<void(QString)> done) {
+	if (Instance) {
+		Instance->clearCache(std::move(done));
+	} else {
+		QFile::remove(CachePath());
+		done(u"cached server data cleared"_q);
+	}
+}
