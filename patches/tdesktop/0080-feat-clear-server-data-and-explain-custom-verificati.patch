diff --git a/Telegram/SourceFiles/tele/tele_verify_details.cpp b/Telegram/SourceFiles/tele/tele_verify_details.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2c5c62177c55364f6606afe92a600b1673f8a136
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_verify_details.cpp
@@ -0,0 +1,179 @@
+#include "tele/tele_verify_details.h"
+
+#include "base/timer.h"
+#include "base/unique_qptr.h"
+#include "core/ui_integration.h"
+#include "data/data_changes.h"
+#include "data/data_emoji_statuses.h"
+#include "data/data_peer.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "info/profile/info_profile_badge.h"
+#include "main/main_session.h"
+#include "ui/abstract_button.h"
+#include "ui/unread_badge.h"
+#include "ui/widgets/glare_tooltip.h"
+#include "ui/widgets/labels.h"
+#include "styles/style_info.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kTooltipGlares = 3;
+
+using Ui::GlareTooltip;
+
+struct TooltipState {
+	base::unique_qptr<GlareTooltip> shown;
+	std::vector<base::unique_qptr<GlareTooltip>> old;
+	std::unique_ptr<base::Timer> hideTimer;
+	float64 opacity = 1.;
+};
+
+[[nodiscard]] QString Description(not_null<PeerData*> peer) {
+	const auto details = peer->botVerifyDetails();
+	return details
+		? details->description.text.simplified()
+		: QString();
+}
+
+[[nodiscard]] std::shared_ptr<Data::EmojiStatusCollectible> Collectible(
+		not_null<Ui::RpWidget*> parent,
+		const QString &text) {
+	const auto &st = st::infoGiftTooltip;
+	const auto available = parent->width()
+		- 2 * st.padding.left()
+		- st.padding.left()
+		- st.padding.right()
+		- 4 * st::lineWidth;
+	const auto edge = st.bg->c;
+	auto result = std::make_shared<Data::EmojiStatusCollectible>();
+	result->title = st::infoGiftTooltipFont->elided(
+		text,
+		std::max(available, st::infoGiftTooltipFont->elidew));
+	result->edgeColor = edge;
+	result->centerColor = edge.lighter(170);
+	result->textColor = QColor(255, 255, 255);
+	return result;
+}
+
+void HideTooltip(not_null<TooltipState*> state) {
+	state->hideTimer->cancel();
+	auto old = base::take(state->shown);
+	const auto raw = old.get();
+	if (!raw) {
+		return;
+	}
+	state->old.push_back(std::move(old));
+	raw->fade(false);
+	raw->shownValue(
+	) | rpl::filter(
+		!rpl::mappers::_1
+	) | rpl::on_next([=] {
+		const auto i = ranges::find(
+			state->old,
+			raw,
+			&base::unique_qptr<GlareTooltip>::get);
+		if (i != end(state->old)) {
+			state->old.erase(i);
+		}
+	}, raw->lifetime());
+}
+
+void ShowTooltip(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Info::Profile::Badge*> badge,
+		not_null<PeerData*> peer,
+		not_null<TooltipState*> state) {
+	HideTooltip(state);
+	const auto widget = badge->widget();
+	const auto text = Description(peer);
+	if (!widget || text.isEmpty()) {
+		return;
+	}
+	const auto collectible = Collectible(parent, text);
+	state->shown = base::make_unique_q<GlareTooltip>(
+		parent,
+		st::infoGiftTooltip,
+		st::infoGiftTooltipFont,
+		collectible->title,
+		Ui::GlareTooltipColors{
+			.edge = collectible->edgeColor,
+			.center = collectible->centerColor,
+			.rim = collectible->textColor,
+			.text = QColor(255, 255, 255),
+		});
+	const auto raw = state->shown.get();
+	raw->trackWidget(widget);
+	raw->fade(true);
+	state->hideTimer->callOnce(raw->glaresDuration(kTooltipGlares));
+	raw->setOpacity(state->opacity);
+}
+
+} // namespace
+
+void SetupVerifyTooltip(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Info::Profile::Badge*> badge,
+		not_null<PeerData*> peer,
+		rpl::producer<float64> opacity) {
+	const auto state = parent->lifetime().make_state<TooltipState>();
+	state->hideTimer = std::make_unique<base::Timer>([=] {
+		HideTooltip(state);
+	});
+	std::move(
+		opacity
+	) | rpl::on_next([=](float64 value) {
+		state->opacity = value;
+		if (const auto raw = state->shown.get()) {
+			raw->setOpacity(value);
+		}
+	}, parent->lifetime());
+
+	const auto refresh = [=] {
+		const auto button = dynamic_cast<Ui::AbstractButton*>(
+			badge->widget());
+		const auto clickable = !Description(peer).isEmpty();
+		if (!clickable) {
+			HideTooltip(state);
+		}
+		if (!button) {
+			return;
+		}
+		button->setAttribute(Qt::WA_TransparentForMouseEvents, !clickable);
+		button->setClickedCallback(clickable
+			? Fn<void()>([=] { ShowTooltip(parent, badge, peer, state); })
+			: Fn<void()>());
+	};
+	badge->updated() | rpl::on_next([=] {
+		HideTooltip(state);
+		refresh();
+	}, parent->lifetime());
+	peer->session().changes().peerFlagsValue(
+		peer,
+		Data::PeerUpdate::Flag::VerifyInfo
+	) | rpl::on_next(refresh, parent->lifetime());
+}
+
+Fn<void(not_null<Ui::FlatLabel*>)> VerifyDescriptionSetup(
+		not_null<PeerData*> peer) {
+	return [=](not_null<Ui::FlatLabel*> label) {
+		peer->session().changes().peerFlagsValue(
+			peer,
+			Data::PeerUpdate::Flag::VerifyInfo
+		) | rpl::on_next([=] {
+			const auto details = peer->botVerifyDetails();
+			if (!details
+				|| !details->iconId
+				|| details->description.empty()) {
+				return;
+			}
+			label->setMarkedText(
+				Data::SingleCustomEmoji(
+					details->iconId
+				).append(' ').append(details->description),
+				Core::TextContext({ .session = &peer->session() }));
+		}, label->lifetime());
+	};
+}
+
+} // namespace Tele
