+void Badges::clearCache(Fn<void(QString)> done) {
+	cancel();
+	QFile::remove(CachePath());
+	_etag = QString();
+	setFeed(std::nullopt);
+	const auto url = NormalizeServerUrl(ServerUrl());
+	if (!url || url->isEmpty() || ServerOffForLaunch()) {
+		done(u"cached server data cleared"_q);
+		return;
+	}
+	_waiting.push_back(std::move(done));
+	fetch();
+}
+
+void Badges::cancel() {
+	_timer.cancel();
+	if (const auto reply = base::take(_reply).data()) {
+		reply->disconnect(this);
+		reply->abort();
+		reply->deleteLater();
+	}
+}
