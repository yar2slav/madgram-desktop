@@ -207,13 +208,12 @@ QString systemShortcutPath() {
 	return QString();
 }
 
-void CleanupShortcut() {
+void CleanupShortcutAt(const QString &path) {
 	const auto myid = MyExecutablePathId();
 	if (!myid) {
 		return;
 	}
 
-	QString path = systemShortcutPath() + u"Telegram.lnk"_q;
 	std::wstring p = QDir::toNativeSeparators(path).toStdWString();
 
 	DWORD attributes = GetFileAttributes(p.c_str());
@@ -242,6 +242,12 @@ void CleanupShortcut() {
 	}
 }
 
+void CleanupShortcut() {
+	const auto path = systemShortcutPath();
+	CleanupShortcutAt(path + Tele::LegacyStartMenuShortcutName());
+	CleanupShortcutAt(path + Tele::StartMenuShortcutName());
+}
+
 bool validateShortcutAt(const QString &path) {
 	const auto native = QDir::toNativeSeparators(path).toStdWString();
 
@@ -367,7 +373,8 @@ bool ValidateShortcut() {
 			return true;
 		}
 
-		path += u"Telegram.lnk"_q;
+		CleanupShortcutAt(path + Tele::LegacyStartMenuShortcutName());
+		path += Tele::StartMenuShortcutName();
 		if (validateShortcutAt(path)) {
 			return true;
 		}
diff --git a/Telegram/SourceFiles/tele/tele_start_menu.cpp b/Telegram/SourceFiles/tele/tele_start_menu.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a7c307f0c016a8cc4a8558654cd3dff96b0894d9
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_start_menu.cpp
@@ -0,0 +1,34 @@
+#include "tele/tele_start_menu.h"
+
+#include "tele/tele_build.h"
+
+#ifdef Q_OS_WIN
+#include "platform/win/windows_app_user_model_id.h"
+
+#include <objbase.h>
+#endif // Q_OS_WIN
+
+namespace Tele {
+
+QString StartMenuShortcutName() {
+	return BuildNumber() ? u"tele.lnk"_q : u"tele dev.lnk"_q;
+}
+
+QString LegacyStartMenuShortcutName() {
+	return u"Telegram.lnk"_q;
+}
+
+void StartStartMenuShortcut() {
+#ifdef Q_OS_WIN
+	// upstream makes it only for native notifications
+	const auto initialized = SUCCEEDED(CoInitialize(nullptr));
+	if (!Platform::AppUserModelId::ValidateShortcut()) {
+		LOG(("Tele Start Menu: could not create the shortcut."));
+	}
+	if (initialized) {
+		CoUninitialize();
+	}
+#endif // Q_OS_WIN
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_start_menu.h b/Telegram/SourceFiles/tele/tele_start_menu.h
new file mode 100644
index 0000000000000000000000000000000000000000..21ae6928e0fc0eea76bdbed0acd2174b64c78750
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_start_menu.h
@@ -0,0 +1,9 @@
+#pragma once
+
+namespace Tele {
+
+[[nodiscard]] QString StartMenuShortcutName();
+[[nodiscard]] QString LegacyStartMenuShortcutName();
+void StartStartMenuShortcut();
+
+} // namespace Tele
