 	return (i != end(_folders)) ? i->second : QString();
 }
 
+PeerId Store::peerByFolder(const QString &path) const {
+	const auto clean = QDir::cleanPath(path);
+	for (const auto &[peer, folder] : _folders) {
+		if (!QDir::cleanPath(folder).compare(clean, kPathCase)) {
+			return peer;
+		}
+	}
+	return PeerId();
+}
+
 void Store::setFolder(PeerId peer, const QString &path) {
 	if (path.isEmpty()) {
 		if (!_folders.remove(peer)) {
@@ -285,6 +306,13 @@ void ChooseFolder(
 	return native.left(head) + QChar(0x2026) + native.right(tail);
 }
 
+[[nodiscard]] bool InsideFolder(const QString &path, const QString &folder) {
+	return !folder.isEmpty()
+		&& QDir::cleanPath(path).startsWith(
+			WithSlash(QDir::cleanPath(folder)),
+			kPathCase);
+}
