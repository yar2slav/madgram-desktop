 } // namespace
 
 DownloadChat::DownloadChat(PeerId peer)
@@ -338,6 +366,67 @@ QString AutoDownloadFileName(
 		: filename;
 }
 
+void DownloadWriteFailed(
+		not_null<DocumentData*> document,
+		FileLoader *loader,
+		bool started) {
+	const auto session = &document->session();
+	const auto path = loader ? loader->fileName() : QString();
+	const auto origin = loader ? loader->fileOrigin() : Data::FileOrigin();
+	const auto reason = TakeDownloadError(loader);
+	auto details = QDir::toNativeSeparators(path);
+	if (!reason.isEmpty()) {
+		details += (details.isEmpty() ? QString() : u"\n"_q) + reason;
+	}
+	const auto withDetails = [=](const QString &text) {
+		return details.isEmpty() ? text : (text + u"\n\n"_q + details);
+	};
+	const auto peer = (started || path.isEmpty() || !DownloadsPerChat())
+		? PeerId()
+		: Store::Get(session).peerByFolder(QFileInfo(path).absolutePath());
+	const auto global = !started
+		&& !peer
+		&& !Core::App().settings().downloadPath().isEmpty()
+		&& InsideFolder(path, BaseDownloadPath(session));
+	if (global) {
+		Core::App().settings().setDownloadPathBookmark(QByteArray());
+		Core::App().settings().setDownloadPath(QString());
+		Core::App().saveSettingsDelayed();
+	}
+	InvokeQueued(qApp, crl::guard(session, [=] {
+		if (started) {
+			const auto retry = [=] {
+				Ui::hideLayer();
+				document->save(origin, path);
+			};
+			Ui::show(Ui::MakeConfirmBox({
+				withDetails(tr::lng_download_finish_failed(tr::now)),
+				crl::guard(session, retry),
+			}));
+		} else if (peer) {
+			const auto reset = [=](Fn<void()> close) {
+				Store::Get(session).setFolder(peer, QString());
+				close();
+			};
+			Ui::show(Ui::MakeConfirmBox({
+				.text = withDetails(Lower(
+					u"Couldn't save the file to this chat's download folder."_q))
+					+ u"\n\n"_q
+					+ Lower(u"Reset the folder? This chat's files will go "
+						"to the main download folder."_q),
+				.confirmed = crl::guard(session, reset),
+				.confirmText = Lower(u"Reset"_q),
+			}));
+		} else if (global) {
+			Ui::show(Ui::MakeInformBox(
+				withDetails(tr::lng_download_path_failed(tr::now))));
+		} else {
+			Ui::show(Ui::MakeInformBox(
+				withDetails(Lower(u"Couldn't save the file."_q))));
+		}
+	}));
+}
+
 void AddDownloadFolderAction(
 		not_null<Window::SessionController*> controller,
 		PeerData *peer,
