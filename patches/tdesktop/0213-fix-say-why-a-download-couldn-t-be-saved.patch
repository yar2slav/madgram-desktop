diff --git a/Telegram/SourceFiles/tele/tele_download_paths.cpp b/Telegram/SourceFiles/tele/tele_download_paths.cpp
index 689ee34b7545973f54ba46d28f7b4ddea208ed15..797c871fdcd75e6ff46ab6d59811759106ef9148 100644
--- a/Telegram/SourceFiles/tele/tele_download_paths.cpp
+++ b/Telegram/SourceFiles/tele/tele_download_paths.cpp
@@ -8,11 +8,17 @@ namespace {
 	return result;
 }
 
+[[nodiscard]] base::flat_map<const void*, QString> &Errors() {
+	static auto result = base::flat_map<const void*, QString>();
+	return result;
+}
+
 } // namespace
 
 void SetDownloadPath(const void *loader, const QString &path) {
 	if (path.isEmpty()) {
 		Paths().remove(loader);
+		Errors().remove(loader);
 	} else {
 		Paths()[loader] = QDir::cleanPath(path);
 	}
@@ -31,4 +37,22 @@ bool DownloadPathTaken(const QString &path) {
 	return false;
 }
 
+void SetDownloadError(const void *loader, const QString &error) {
+	if (error.isEmpty()) {
+		Errors().remove(loader);
+	} else {
+		Errors()[loader] = error;
+	}
+}
+
+QString TakeDownloadError(const void *loader) {
+	const auto i = Errors().find(loader);
+	if (i == end(Errors())) {
+		return QString();
+	}
+	auto result = std::move(i->second);
+	Errors().erase(i);
+	return result;
+}
+
 } // namespace Tele
