index 0000000000000000000000000000000000000000..8d6ab7f488b8a47727b8346d13d6e665d77a3596
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_code_lines.cpp
@@ -0,0 +1,410 @@
+#include "tele/tele_code_lines.h"
+
+#include "base/weak_ptr.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "iv/markdown/iv_markdown_article_layout_blocks.h"
+#include "tele/tele_options.h"
+#include "ui/text/text.h"
+#include "ui/text/text_entity.h"
+#include "styles/style_basic.h"
+#include "styles/style_chat.h"
+#include "styles/style_iv.h"
+
+#include <map>
+#include <unordered_map>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMinLines = 5;
+constexpr auto kCompactThreshold = 256;
+constexpr auto kMaxWrappedLines = 400;
+constexpr auto kOpacity = 0.4;
+
+struct Number {
+	int right = 0;
+	int baseline = 0;
+	int value = 0;
+};
+
+struct Entry {
+	base::weak_ptr<HistoryView::Element> weak;
+	const style::TextStyle *style = nullptr;
+	int width = -1;
+	std::vector<Number> numbers;
+};
+
+struct RichNumber {
+	int baseline = 0;
+	int value = 0;
+};
+
+struct RichEntry {
+	QString code;
+	int width = -1;
+	std::vector<RichNumber> numbers;
+};
+
+struct State {
+	State();
+
+	std::unordered_map<const HistoryView::Element*, Entry> views;
+	std::unordered_map<
+		const HistoryView::Element*,
+		base::weak_ptr<HistoryView::Element>> richViews;
+	std::unordered_map<const Ui::Text::String*, RichEntry> richNumbers;
+	std::map<int, style::TextStyle> styles;
+	size_t compactAt = kCompactThreshold;
+	rpl::lifetime lifetime;
+};
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+void RefreshAll(State &state) {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	for (const auto &[key, entry] : state.views) {
+		if (const auto view = entry.weak.get()) {
+			items.emplace(view->data());
+		}
+	}
+	for (const auto &[key, weak] : state.richViews) {
+		if (const auto view = weak.get()) {
+			items.emplace(view->data());
+		}
+	}
+	for (const auto &item : items) {
+		item->history()->owner().requestItemViewRefresh(item);
+	}
+}
+
+State::State() {
+	CodeLineNumbersChanges(
+	) | rpl::on_next([] {
+		RefreshAll(Get());
+	}, lifetime);
+}
+
+void Compact(State &state) {
+	if (state.views.size() + state.richViews.size() < state.compactAt) {
+		return;
+	}
+	std::erase_if(state.views, [](const auto &pair) {
+		return !pair.second.weak.get();
+	});
+	std::erase_if(state.richViews, [](const auto &pair) {
+		return !pair.second.get();
+	});
+	state.compactAt = std::max(
+		size_t(kCompactThreshold),
+		(state.views.size() + state.richViews.size()) * 2);
+}
+
+[[nodiscard]] int CountLines(QStringView code) {
+	while (!code.isEmpty() && code.front() == QChar::LineFeed) {
+		code = code.mid(1);
+	}
+	while (!code.isEmpty() && code.back() == QChar::LineFeed) {
+		code.chop(1);
+	}
+	return code.isEmpty() ? 0 : int(code.count(QChar::LineFeed)) + 1;
+}
+
+[[nodiscard]] int LongestCodeBlock(const TextWithEntities &text) {
+	auto result = 0;
+	for (const auto &entity : text.entities) {
+		if (entity.type() != EntityType::Pre) {
+			continue;
+		}
+		const auto lines = CountLines(QStringView(text.text).mid(
+			entity.offset(),
+			entity.length()));
+		if (lines >= kMinLines) {
+			result = std::max(result, lines);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] int GutterGap() {
+	return style::ConvertScale(8);
+}
+
+[[nodiscard]] const style::TextStyle &StyleFor(int digits) {
+	auto &styles = Get().styles;
+	const auto [i, inserted] = styles.try_emplace(
+		digits,
+		st::messageTextStyle);
+	if (inserted) {
+		const auto font = st::messageTextStyle.font->monospace();
+		auto &padding = i->second.pre.padding;
+		padding.setLeft(padding.left()
+			+ font->width(QString(digits, QChar('0')))
+			+ GutterGap());
+	}
+	return i->second;
+}
+
+[[nodiscard]] std::vector<Number> CollectNumbers(
+		const Ui::Text::String &text,
+		int width) {
+	const auto full = text.toTextWithEntities();
+	const auto &pre = text.style()->pre;
+	const auto codeLeft = pre.padding.left();
+	const auto closingShift = pre.padding.bottom() + pre.verticalSkip;
+	const auto gap = GutterGap();
+	auto request = Ui::Text::StateRequest();
+	request.flags = Ui::Text::StateRequest::Flag::LookupSymbol;
+
+	const auto lines = text.countLinesGeometry(width);
+	const auto count = int(lines.size());
+	auto symbols = std::vector<int>(count, -1);
+	auto blocks = std::vector<int>(count, -1);
+	for (auto k = 0; k != count; ++k) {
+		if (lines[k].left != codeLeft) {
+			continue;
+		}
+		const auto symbol = text.getState(
+			QPoint(0, lines[k].baseline - closingShift),
+			width,
+			request).symbol;
+		symbols[k] = symbol;
+		const auto i = ranges::find_if(full.entities, [&](
+				const EntityInText &entity) {
+			return (entity.type() == EntityType::Pre)
+				&& (symbol >= entity.offset())
+				&& (symbol < entity.offset() + entity.length());
+		});
+		if (i != full.entities.end()) {
+			blocks[k] = int(i - full.entities.begin());
+		}
+	}
+
+	auto result = std::vector<Number>();
+	auto current = -1;
+	auto counter = 0;
+	auto blockStart = size_t(0);
+	const auto finish = [&] {
+		if (current >= 0 && counter < kMinLines) {
+			result.erase(result.begin() + blockStart, result.end());
+		}
+	};
+	for (auto k = 0; k != count; ++k) {
+		const auto block = blocks[k];
+		if (block < 0) {
+			continue;
+		}
+		if (block != current) {
+			finish();
+			current = block;
+			counter = 0;
+			blockStart = result.size();
+		}
+		const auto &entity = full.entities[block];
+		const auto symbol = symbols[k];
+		const auto starts = (symbol == entity.offset())
+			|| (symbol > 0
+				&& symbol <= full.text.size()
+				&& full.text[symbol - 1] == QChar::LineFeed);
+		if (!starts) {
+			continue;
+		}
+		const auto next = k + 1;
+		const auto closes = (next < count)
+			&& (symbols[next] < entity.offset()
+				|| symbols[next] > entity.offset() + entity.length());
+		result.push_back({
+			.right = lines[k].left - gap,
+			.baseline = lines[k].baseline - (closes ? closingShift : 0),
+			.value = ++counter,
+		});
+	}
+	finish();
+	return result;
+}
+
+[[nodiscard]] std::vector<RichNumber> CollectRichNumbers(
+		const Ui::Text::String &leaf,
+		int width) {
+	const auto text = leaf.toString();
+	const auto lines = leaf.countLinesGeometry(width);
+	const auto count = int(lines.size());
+	auto result = std::vector<RichNumber>();
+	auto counter = 0;
+	if (count == int(ranges::count_if(text, Ui::Text::IsNewline)) + 1) {
+		result.reserve(count);
+		for (const auto &line : lines) {
+			result.push_back({
+				.baseline = line.baseline,
+				.value = ++counter,
+			});
+		}
+		return result;
+	} else if (count > kMaxWrappedLines) {
+		return result;
+	}
+	auto request = Ui::Text::StateRequest();
+	request.flags = Ui::Text::StateRequest::Flag::LookupSymbol;
+	for (const auto &line : lines) {
+		const auto symbol = leaf.getState(
+			QPoint(0, line.baseline),
+			width,
+			request).symbol;
+		const auto starts = (symbol <= 0)
+			|| (symbol <= text.size()
+				&& Ui::Text::IsNewline(text[symbol - 1]));
+		if (starts) {
+			result.push_back({
+				.baseline = line.baseline,
+				.value = ++counter,
+			});
+		}
+	}
+	return result;
+}
+
+} // namespace
+
+const style::TextStyle &CodeLinesTextStyle(
+		not_null<HistoryView::Element*> view,
+		const TextWithEntities &text) {
+	auto &state = Get();
+	const auto lines = LongestCodeBlock(text);
+	if (!lines) {
+		state.views.erase(view.get());
+		return st::messageTextStyle;
+	}
+	auto &entry = state.views[view.get()];
+	entry.weak = base::make_weak(view.get());
+	entry.width = -1;
+	entry.numbers.clear();
+	entry.style = CodeLineNumbers()
+		? &StyleFor(int(QString::number(lines).size()))
+		: nullptr;
+	const auto result = entry.style;
+	Compact(state);
+	return result ? *result : st::messageTextStyle;
+}
+
+void PaintCodeLineNumbers(
+		QPainter &p,
+		not_null<const HistoryView::Element*> view,
+		const Ui::Text::String &text,
+		QPoint position,
+		int width,
+		const QColor &color) {
+	auto &state = Get();
+	const auto i = state.views.find(view.get());
+	if (i == end(state.views)) {
+		return;
+	}
+	auto &entry = i->second;
+	if (!entry.style || text.style() != entry.style) {
+		return;
+	}
+	if (entry.width != width) {
+		entry.width = width;
+		entry.numbers = CollectNumbers(text, width);
+	}
+	if (entry.numbers.empty()) {
+		return;
+	}
+	const auto font = entry.style->font->monospace();
+	p.save();
+	p.setFont(font);
+	p.setPen(color);
+	p.setOpacity(p.opacity() * kOpacity);
+	for (const auto &number : entry.numbers) {
+		const auto label = QString::number(number.value);
+		p.drawText(
+			position.x() + number.right - font->width(label),
+			position.y() + number.baseline,
+			label);
+	}
+	p.restore();
+}
+
+QMargins RichCodeLinesPadding(
+		const QString &code,
+		const style::TextStyle &st) {
+	if (!CodeLineNumbers() || CountLines(code) < kMinLines) {
+		return QMargins();
+	}
+	const auto lines = int(ranges::count_if(code, Ui::Text::IsNewline)) + 1;
+	const auto digits = int(QString::number(lines).size());
+	const auto font = st.font->monospace();
+	return QMargins(
+		font->width(QString(digits, QChar('0'))) + GutterGap(),
+		0,
+		0,
+		0);
+}
+
+void TrackRichCodeLines(not_null<HistoryView::Element*> view) {
+	auto &state = Get();
+	state.richViews[view.get()] = base::make_weak(view.get());
+	Compact(state);
+}
+
+void PaintRichCodeLineNumbers(
+		QPainter &p,
+		const Iv::Markdown::LaidOutBlock &block,
+		const style::Markdown &st,
+		QRect clip,
+		const QColor &color) {
+	const auto &logical = block.logicalGeometry;
+	const auto gutter = logical.contentRect.x()
+		- logical.outer.x()
+		- Iv::Markdown::BlockquotePadding(st.code.pre).left();
+	if (gutter <= 0
+		|| clip.isEmpty()
+		|| block.leaf.isEmpty()
+		|| !CodeLineNumbers()) {
+		return;
+	}
+	auto &cache = Get().richNumbers;
+	auto i = cache.find(&block.leaf);
+	if (i == end(cache)) {
+		if (cache.size() >= kCompactThreshold) {
+			cache.clear();
+		}
+		i = cache.emplace(&block.leaf, RichEntry()).first;
+	}
+	auto &entry = i->second;
+	if (entry.width != block.textWidth || entry.code != block.codeText.text) {
+		entry.width = block.textWidth;
+		entry.code = block.codeText.text;
+		entry.numbers = CollectRichNumbers(block.leaf, block.textWidth);
+	}
+	if (entry.numbers.empty()) {
+		return;
+	}
+	const auto font = st.code.font->monospace();
+	const auto right = block.textRect.x()
+		+ block.horizontalScrollLeft
+		- GutterGap();
+	const auto top = block.textRect.y();
+	p.save();
+	p.setClipRect(clip);
+	p.setFont(font);
+	p.setPen(color);
+	p.setOpacity(p.opacity() * kOpacity);
+	for (const auto &number : entry.numbers) {
+		const auto baseline = top + number.baseline;
+		if (baseline + font->descent <= clip.y()) {
+			continue;
+		} else if (baseline - font->ascent >= clip.y() + clip.height()) {
+			break;
+		}
+		const auto label = QString::number(number.value);
+		p.drawText(right - font->width(label), baseline, label);
+	}
+	p.restore();
+}
+
+} // namespace Tele
