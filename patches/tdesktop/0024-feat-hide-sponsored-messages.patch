From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 05:03:47 +0300
Subject: [PATCH] feat: hide sponsored messages

---
 Telegram/SourceFiles/api/api_peer_search.cpp  |  4 +++-
 .../data/components/promo_suggestions.cpp     |  6 ++++-
 .../data/components/sponsored_messages.cpp    | 15 ++++++++++--
 .../data/components/sponsored_messages.h      |  1 +
 .../SourceFiles/settings/settings_tele.cpp    |  1 +
 Telegram/SourceFiles/tele/tele_options.cpp    | 23 +++++++++++++++++++
 Telegram/SourceFiles/tele/tele_options.h      |  3 +++
 7 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/Telegram/SourceFiles/api/api_peer_search.cpp b/Telegram/SourceFiles/api/api_peer_search.cpp
index 636d4bc8f29575e82b3d9a32160098b8b70b26c7..89bf865345ec5e5b29f0922d65aea664e2820299 100644
--- a/Telegram/SourceFiles/api/api_peer_search.cpp
+++ b/Telegram/SourceFiles/api/api_peer_search.cpp
@@ -12,6 +12,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "data/data_session.h"
 #include "dialogs/ui/chat_search_in.h" // IsHashOrCashtagSearchQuery
 #include "main/main_session.h"
+#include "tele/tele_options.h"
 
 namespace Api {
 namespace {
@@ -55,7 +56,8 @@ void PeerSearch::request(
 	cache.requested = true;
 	cache.result.query = _query;
 	if (_type != Type::WithSponsored
-		|| _query.size() < kMinSponsoredQueryLength) {
+		|| _query.size() < kMinSponsoredQueryLength
+		|| Tele::HideSponsored()) {
 		cache.sponsoredReady = true;
 	} else {
 		requestSponsored();
diff --git a/Telegram/SourceFiles/data/components/promo_suggestions.cpp b/Telegram/SourceFiles/data/components/promo_suggestions.cpp
index 9b91f8dbf3e4e4423317c5ca37f379daf9792a8c..4f8dfdf000a0fe8936edc8e43155546d8163e120 100644
--- a/Telegram/SourceFiles/data/components/promo_suggestions.cpp
+++ b/Telegram/SourceFiles/data/components/promo_suggestions.cpp
@@ -19,6 +19,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "history/history.h"
 #include "main/main_session.h"
 #include "main/main_session_settings.h"
+#include "tele/tele_options.h"
 
 namespace Data {
 namespace {
@@ -131,7 +132,10 @@ void PromoSuggestions::refreshTopPromotion() {
 					|= _dismissedSuggestions.emplace(qs(suggestion)).second;
 			}
 
-			if (const auto peer = data.vpeer()) {
+			const auto peer = (data.is_proxy() && Tele::HideSponsored())
+				? tl::conditional<MTPPeer>()
+				: data.vpeer();
+			if (peer) {
 				const auto peerId = peerFromMTP(*peer);
 				const auto history = _session->data().history(peerId);
 				setTopPromoted(
diff --git a/Telegram/SourceFiles/data/components/sponsored_messages.cpp b/Telegram/SourceFiles/data/components/sponsored_messages.cpp
index ef9712037b70cdda718d4a17e2b73ada9c04c7c6..5847579be901b6d7795edcfb75a085e2045dee40 100644
--- a/Telegram/SourceFiles/data/components/sponsored_messages.cpp
+++ b/Telegram/SourceFiles/data/components/sponsored_messages.cpp
@@ -23,6 +23,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "history/view/history_view_element.h"
 #include "lang/lang_keys.h"
 #include "main/main_session.h"
+#include "tele/tele_options.h"
 #include "ui/chat/sponsored_message_bar.h"
 #include "ui/text/text_utilities.h" // tr::rich.
 
@@ -63,6 +64,13 @@ SponsoredMessages::SponsoredMessages(not_null<Main::Session*> session)
 			clear();
 		}
 	}, _lifetime);
+	Tele::HideSponsoredValue(
+	) | rpl::filter(rpl::mappers::_1) | rpl::on_next([=] {
+		for (const auto &request : base::take(_requests)) {
+			_session->api().request(request.second.requestId).cancel();
+		}
+		base::take(_data);
+	}, _teleLifetime);
 }
 
 SponsoredMessages::~SponsoredMessages() {
@@ -302,7 +310,9 @@ HistoryItem *SponsoredMessages::injectItem(
 }
 
 bool SponsoredMessages::canHaveFor(not_null<History*> history) const {
-	if (history->peer->isChannel()) {
+	if (Tele::HideSponsored()) {
+		return false;
+	} else if (history->peer->isChannel()) {
 		return true;
 	} else if (const auto user = history->peer->asUser()) {
 		return user->isBot();
@@ -311,7 +321,8 @@ bool SponsoredMessages::canHaveFor(not_null<History*> history) const {
 }
 
 bool SponsoredMessages::canHaveFor(not_null<HistoryItem*> item) const {
-	return item->history()->peer->isBroadcast()
+	return !Tele::HideSponsored()
+		&& item->history()->peer->isBroadcast()
 		&& item->isRegular();
 }
 
diff --git a/Telegram/SourceFiles/data/components/sponsored_messages.h b/Telegram/SourceFiles/data/components/sponsored_messages.h
index 6f326f48c26ebb6d1f568b076ea0659f1d9aafa6..83a304dd208536bb94d92913c67a26d5a688b23a 100644
--- a/Telegram/SourceFiles/data/components/sponsored_messages.h
+++ b/Telegram/SourceFiles/data/components/sponsored_messages.h
@@ -251,6 +251,7 @@ private:
 	rpl::event_stream<FullMsgId> _itemRemoved;
 
 	rpl::lifetime _lifetime;
+	rpl::lifetime _teleLifetime;
 
 };
 
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index c733161b91159d64248199f155f7cb210f539015..616db2d1d3bd37e9af2d6164e667b623ee30a7bd 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -626,6 +626,7 @@ void TeleSection::setupContent() {
 	AddOptionToggle(content, controller(), ::Tele::kOptionGroupQuickReplies);
 	AddOptionToggle(content, controller(), ::Tele::kOptionBubbleBadges);
 	AddOptionToggle(content, controller(), ::Tele::kOptionHideCalls);
+	AddOptionToggle(content, controller(), ::Tele::kOptionHideSponsored);
 	Ui::AddSkip(content);
 	Ui::AddDivider(content);
 	Ui::AddSkip(content);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 95d34159a5bd562d32d72631a07b9e8e54eb856b..57fc16f29e79da0ece3dbb1ffaf745a3ee12a7c0 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -12,6 +12,7 @@ const char kOptionGroupQuickReplies[] = "tele-group-quick-replies";
 const char kOptionBubbleBadges[] = "tele-bubble-badges";
 const char kOptionHideCalls[] = "tele-hide-calls";
 const char kOptionLowercase[] = "tele-lowercase";
+const char kOptionHideSponsored[] = "tele-hide-sponsored";
 const char kOptionShowGiftIds[] = "tele-show-gift-ids";
 const char kOptionPeerIdsWithoutSpaces[] = "tele-peer-ids-without-spaces";
 const char kOptionBotApiPeerIds[] = "tele-bot-api-peer-ids";
@@ -92,6 +93,14 @@ base::options::toggle BubbleBadgesOption({
 		"sender names in message bubbles, where emoji statuses are.",
 });
 
+base::options::toggle HideSponsoredOption({
+	.id = kOptionHideSponsored,
+	.name = "Hide sponsored messages",
+	.description = "Don't load ads: no sponsored messages in channels "
+		"and bots, no ads in channel videos, no sponsored results "
+		"in search and no proxy sponsor channel in the chat list.",
+});
+
 base::options::toggle ShowGiftIdsOption({
 	.id = kOptionShowGiftIds,
 	.name = "Show gift IDs",
@@ -230,6 +239,20 @@ bool BubbleBadges() {
 	return BubbleBadgesOption.value();
 }
 
+bool HideSponsored() {
+	return HideSponsoredOption.value();
+}
+
+rpl::producer<bool> HideSponsoredValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		HideSponsoredOption.changes()
+	) | rpl::map([] {
+		return HideSponsoredOption.value();
+	});
+}
+
 bool ShowGiftIds() {
 	return ShowGiftIdsOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 08316b24f87ca9b8dfdaf1bf01a93b4b12d3f50f..c5a9e2dbbade43a0b9a333a6adee84a57cc256fa 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -10,6 +10,7 @@ extern const char kOptionGroupQuickReplies[];
 extern const char kOptionBubbleBadges[];
 extern const char kOptionHideCalls[];
 extern const char kOptionLowercase[];
+extern const char kOptionHideSponsored[];
 extern const char kOptionShowGiftIds[];
 extern const char kOptionPeerIdsWithoutSpaces[];
 extern const char kOptionBotApiPeerIds[];
@@ -33,6 +34,8 @@ extern const char kOptionTitleTemplate[];
 [[nodiscard]] bool HideCalls();
 [[nodiscard]] bool LowercaseStrings();
 [[nodiscard]] rpl::producer<> HideCallsChanges();
+[[nodiscard]] bool HideSponsored();
+[[nodiscard]] rpl::producer<bool> HideSponsoredValue();
 [[nodiscard]] bool ShowGiftIds();
 [[nodiscard]] bool PeerIdsWithoutSpaces();
 [[nodiscard]] bool BotApiPeerIds();
