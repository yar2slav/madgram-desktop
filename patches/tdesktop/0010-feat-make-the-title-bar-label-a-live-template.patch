index 0000000000000000000000000000000000000000..6789c2c3ec98af929c74aa5dff6730f29d79ebb2
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_title.cpp
@@ -0,0 +1,327 @@
+#include "tele/tele_title.h"
+
+#include "base/timer.h"
+#include "core/application.h"
+#include "core/version.h"
+#include "data/data_changes.h"
+#include "data/data_forum_topic.h"
+#include "data/data_thread.h"
+#include "data/data_user.h"
+#include "dialogs/dialogs_key.h"
+#include "history/history.h"
+#include "lang/lang_keys.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "mtproto/facade.h"
+#include "mtproto/mtp_instance.h"
+#include "tele/tele_build.h"
+#include "tele/tele_options.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+namespace {
+
+enum class Tick {
+	None,
+	Minute,
+	Second,
+};
+
+struct Token {
+	QString text;
+	QString name;
+	QString format;
+	std::vector<Token> group;
+	bool variable = false;
+	bool optional = false;
+};
+
+struct Template {
+	std::vector<Token> tokens;
+	Tick tick = Tick::None;
+};
+
+struct Context {
+	Window::SessionController *controller = nullptr;
+	QDateTime now;
+};
+
+[[nodiscard]] std::vector<Token> ParseTokens(
+		const QString &source,
+		int &position,
+		bool nested,
+		bool &closed) {
+	auto result = std::vector<Token>();
+	auto literal = QString();
+	const auto flush = [&] {
+		if (!literal.isEmpty()) {
+			result.push_back({ .text = base::take(literal) });
+		}
+	};
+	const auto size = int(source.size());
+	while (position < size) {
+		const auto ch = source[position];
+		const auto doubled = (position + 1 < size)
+			&& (source[position + 1] == ch);
+		if (doubled
+			&& (ch == '{' || ch == '}' || ch == '[' || ch == ']')) {
+			literal += ch;
+			position += 2;
+		} else if (ch == '{') {
+			const auto end = source.indexOf('}', position + 1);
+			if (end < 0) {
+				literal += source.mid(position);
+				position = size;
+				break;
+			}
+			const auto body = source.mid(position + 1, end - position - 1);
+			const auto colon = body.indexOf(':');
+			flush();
+			result.push_back({
+				.text = source.mid(position, end - position + 1),
+				.name = body.mid(0, colon).trimmed(),
+				.format = (colon < 0) ? QString() : body.mid(colon + 1),
+				.variable = true,
+			});
+			position = end + 1;
+		} else if (ch == '[') {
+			auto inner = position + 1;
+			auto innerClosed = false;
+			auto group = ParseTokens(source, inner, true, innerClosed);
+			if (!innerClosed) {
+				literal += ch;
+				flush();
+				for (auto &token : group) {
+					result.push_back(std::move(token));
+				}
+				position = inner;
+				break;
+			}
+			flush();
+			result.push_back({ .group = std::move(group), .optional = true });
+			position = inner;
+		} else if (ch == ']' && nested) {
+			++position;
+			flush();
+			closed = true;
+			return result;
+		} else {
+			literal += ch;
+			++position;
+		}
+	}
+	flush();
+	closed = false;
+	return result;
+}
+
+[[nodiscard]] Tick TickFor(const std::vector<Token> &tokens) {
+	auto result = Tick::None;
+	for (const auto &token : tokens) {
+		auto tick = Tick::None;
+		if (token.optional) {
+			tick = TickFor(token.group);
+		} else if (!token.variable) {
+			continue;
+		} else if (token.name == u"status"_q
+			|| token.name == u"chat_unread"_q) {
+			tick = Tick::Second;
+		} else if (token.name == u"time"_q || token.name == u"date"_q) {
+			tick = (token.format.contains('s') || token.format.contains('z'))
+				? Tick::Second
+				: Tick::Minute;
+		} else if (token.name == u"weekday"_q) {
+			tick = Tick::Minute;
+		}
+		result = std::max(result, tick);
+	}
+	return result;
+}
+
+[[nodiscard]] Template Parse(const QString &source) {
+	auto position = 0;
+	auto closed = false;
+	auto tokens = ParseTokens(source, position, false, closed);
+	const auto tick = TickFor(tokens);
+	return { .tokens = std::move(tokens), .tick = tick };
+}
+
+[[nodiscard]] Context MakeContext(not_null<Window::Controller*> window) {
+	return {
+		.controller = Core::App().passcodeLocked()
+			? nullptr
+			: window->sessionController(),
+		.now = QDateTime::currentDateTime(),
+	};
+}
+
+[[nodiscard]] QString ThreadName(not_null<Data::Thread*> thread) {
+	if (const auto topic = thread->asTopic()) {
+		return topic->title();
+	}
+	const auto peer = thread->owningHistory()->peer;
+	return peer->isSelf() ? tr::lng_saved_messages(tr::now) : peer->name();
+}
+
+[[nodiscard]] bool Connecting(not_null<Main::Session*> session) {
+	const auto state = session->account().mtp().dcstate();
+	return (state == MTP::ConnectingState)
+		|| (state == MTP::DisconnectedState)
+		|| (state < 0);
+}
+
+[[nodiscard]] std::optional<QString> Value(
+		const Token &token,
+		const Context &context) {
+	const auto &name = token.name;
+	const auto &format = token.format;
+	const auto controller = context.controller;
+	const auto user = controller
+		? controller->session().user().get()
+		: nullptr;
+	const auto key = controller
+		? controller->activeChatCurrent()
+		: Dialogs::Key();
+	const auto thread = key ? key.thread() : nullptr;
+	if (name == u"build"_q) {
+		return (BuildNumber() > 0)
+			? u"#%1"_q.arg(BuildNumber())
+			: u"DEV"_q;
+	} else if (name == u"version"_q) {
+		return QString::fromLatin1(AppVersionStr);
+	} else if (name == u"time"_q) {
+		return context.now.toString(format.isEmpty() ? u"HH:mm"_q : format);
+	} else if (name == u"date"_q) {
+		return format.isEmpty()
+			? QLocale().toString(context.now.date(), QLocale::ShortFormat)
+			: context.now.toString(format);
+	} else if (name == u"weekday"_q) {
+		return QLocale().dayName(context.now.date().dayOfWeek());
+	} else if (name == u"name"_q) {
+		return user ? user->name() : QString();
+	} else if (name == u"username"_q) {
+		return user ? user->username() : QString();
+	} else if (name == u"id"_q) {
+		return user
+			? QString::number(peerToUser(user->id).bare)
+			: QString();
+	} else if (name == u"accounts"_q) {
+		return controller
+			? QString::number(Core::App().domain().accountsAuthedCount())
+			: QString();
+	} else if (name == u"unread"_q) {
+		return controller
+			? QString::number(Core::App().unreadBadge())
+			: QString();
+	} else if (name == u"chat"_q) {
+		return thread ? ThreadName(thread) : QString();
+	} else if (name == u"chat_unread"_q) {
+		return thread
+			? QString::number(thread->chatListBadgesState().unreadCounter)
+			: QString();
+	} else if (name == u"status"_q) {
+		return (controller && Connecting(&controller->session()))
+			? u"connecting"_q
+			: QString();
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<QString> Render(
+		const std::vector<Token> &tokens,
+		const Context &context,
+		bool optional) {
+	auto result = QString();
+	for (const auto &token : tokens) {
+		if (token.optional) {
+			result += Render(token.group, context, true).value_or(QString());
+		} else if (!token.variable) {
+			result += token.text;
+		} else if (const auto value = Value(token, context)) {
+			if (optional && (value->isEmpty() || *value == u"0"_q)) {
+				return std::nullopt;
+			}
+			result += *value;
+		} else {
+			result += token.text;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] crl::time TickDelay(Tick tick) {
+	const auto period = (tick == Tick::Second) ? 1000 : 60 * 1000;
+	const auto now = QTime::currentTime().msecsSinceStartOfDay();
+	return period - (now % period) + 10;
+}
+
+} // namespace
+
+QString TitleText(not_null<Window::Controller*> window) {
+	return PreviewTitleText(window, TitleTemplate());
+}
+
+QString PreviewTitleText(
+		not_null<Window::Controller*> window,
+		const QString &source) {
+	return Render(Parse(source).tokens, MakeContext(window), false).value_or(
+		QString());
+}
+
+rpl::producer<QString> TitleTextValue(not_null<Window::Controller*> window) {
+	return [=](auto consumer) {
+		auto lifetime = rpl::lifetime();
+		struct State {
+			Template parsed;
+			base::Timer timer;
+			rpl::lifetime session;
+			std::optional<QString> last;
+		};
+		const auto state = lifetime.make_state<State>();
+		const auto push = [=] {
+			auto text = Render(
+				state->parsed.tokens,
+				MakeContext(window),
+				false).value_or(QString());
+			if (state->last != text) {
+				state->last = text;
+				consumer.put_next_copy(text);
+			}
+			if (state->parsed.tick != Tick::None) {
+				state->timer.callOnce(TickDelay(state->parsed.tick));
+			}
+		};
+		state->timer.setCallback(push);
+		TitleTemplateValue(
+		) | rpl::on_next([=](const QString &source) {
+			state->parsed = Parse(source);
+			state->timer.cancel();
+			push();
+		}, lifetime);
+		rpl::merge(
+			Core::App().unreadBadgeChanges(),
+			Core::App().domain().accountsChanges(),
+			Core::App().passcodeLockChanges() | rpl::to_empty
+		) | rpl::on_next(push, lifetime);
+		window->sessionControllerValue(
+		) | rpl::on_next([=](Window::SessionController *controller) {
+			state->session.destroy();
+			if (controller) {
+				using Flag = Data::PeerUpdate::Flag;
+				rpl::merge(
+					controller->activeChatChanges() | rpl::to_empty,
+					controller->session().changes().peerFlagsValue(
+						controller->session().user(),
+						Flag::Name | Flag::Username
+					) | rpl::skip(1) | rpl::to_empty
+				) | rpl::on_next(push, state->session);
+			}
+			push();
+		}, lifetime);
+		return lifetime;
+	};
+}
+
+} // namespace Tele
