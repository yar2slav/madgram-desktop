+[[nodiscard]] bool IsUsername(const QString &text, int minLength) {
+	const auto latin = [](QChar ch) {
+		return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
+	};
+	if (text.size() < minLength
+		|| text.size() > kMaxUsernameLength
+		|| !latin(text.front())) {
+		return false;
+	}
+	for (const auto ch : text) {
+		if (!latin(ch) && !(ch >= '0' && ch <= '9') && ch != '_') {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] std::vector<FeedUsername> ParseUsernames(
+		const QJsonValue &value) {
+	auto result = std::vector<FeedUsername>();
+	if (!Present(value)) {
+		return result;
+	} else if (!value.isObject()) {
+		LOG(("Tele Badges Error: bad usernames"));
+		return result;
+	}
+	const auto list = value.toObject();
+	auto aliases = base::flat_set<QString>();
+	auto skipped = 0;
+	for (auto i = list.begin(); i != list.end(); ++i) {
+		const auto alias = i.key();
+		const auto fields = i.value().toObject();
+		const auto username = fields.value(u"username"_q).toString();
+		const auto position = fields.value(u"position"_q);
+		const auto index = Present(position)
+			? ParseInt(position, 0, kMaxUsernames)
+			: std::make_optional(-1);
+		if (!i.value().isObject()
+			|| !IsUsername(alias, kMinAliasLength)
+			|| !fields.value(u"username"_q).isString()
+			|| !IsUsername(username, kMinUsernameLength)
+			|| !alias.compare(username, Qt::CaseInsensitive)
+			|| !index
+			|| int(result.size()) >= kMaxUsernames
+			|| !aliases.emplace(alias.toLower()).second) {
+			++skipped;
+			continue;
+		}
+		result.push_back({
+			.alias = alias,
+			.username = username,
+			.position = *index,
+		});
+	}
+	if (skipped) {
+		LOG(("Tele Badges Error: skipped %1 usernames").arg(skipped));
+	}
+	return result;
+}
