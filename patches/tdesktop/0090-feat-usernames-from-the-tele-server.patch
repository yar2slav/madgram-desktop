+		targets.emplace(entry.alias.toLower(), entry.username);
+		aliases[entry.username.toLower()].push_back({
+			.alias = entry.alias,
+			.position = entry.position,
+		});
+	}
+	for (auto &[username, list] : aliases) {
+		ranges::stable_sort(list, ranges::less(), &ServerAlias::position);
+	}
+}
