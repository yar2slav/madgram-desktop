+std::vector<QString> WithServerUsernames(
+		not_null<PeerData*> peer,
+		const std::vector<QString> &usernames) {
+	const auto session = &peer->session();
+	const auto &aliases = Server().aliases;
+	if (usernames.empty()
+		|| aliases.empty()
+		|| !ServerUsernamesOn(session)) {
+		return usernames;
+	}
+	auto found = std::vector<ServerAlias>();
+	for (const auto &username : usernames) {
+		const auto i = aliases.find(username.toLower());
+		if (i != end(aliases)) {
+			found.insert(end(found), begin(i->second), end(i->second));
+		}
+	}
+	if (found.empty()) {
+		return usernames;
+	}
+	ranges::stable_sort(found, ranges::less(), &ServerAlias::position);
+	auto result = usernames;
+	auto last = -1;
+	for (const auto &[alias, position] : found) {
+		const auto taken = ranges::any_of(result, [&](const QString &u) {
+			return !u.compare(alias, Qt::CaseInsensitive);
+		});
+		if (taken || AliasPeerId(session, alias)) {
+			continue;
+		}
+		const auto size = int(result.size());
+		if (position < 0) {
+			result.push_back(alias);
+			continue;
+		}
+		const auto index = std::max(std::min(position, size), last + 1);
+		result.insert(begin(result) + index, alias);
+		last = index;
+	}
 	return result;
 }
 
+bool IsServerUsername(
