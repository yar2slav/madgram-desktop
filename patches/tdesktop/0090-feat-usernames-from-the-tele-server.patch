+void NotifyServerUsernames(const base::flat_set<QString> &usernames) {
+	if (usernames.empty() || !Core::IsAppLaunched()) {
+		return;
+	}
+	const auto notify = [&](not_null<PeerData*> peer) {
+		for (const auto &username : peer->usernames()) {
+			if (usernames.contains(username.toLower())) {
+				peer->session().changes().peerUpdated(
+					peer,
+					Data::PeerUpdate::Flag::Usernames);
+				return;
+			}
+		}
+	};
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			session->data().enumerateUsers(notify);
+			session->data().enumerateGroups(notify);
+			session->data().enumerateBroadcasts(notify);
+		}
+	}
+}
