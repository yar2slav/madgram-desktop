+		auto usernames = base::flat_set<QString>();
+		for (const auto &[username, list] : aliases) {
+			usernames.emplace(username);
+		}
+		rebuild();
+		for (const auto &[username, list] : aliases) {
+			usernames.emplace(username);
+		}
+		NotifyServerUsernames(usernames);
+	}, lifetime);
