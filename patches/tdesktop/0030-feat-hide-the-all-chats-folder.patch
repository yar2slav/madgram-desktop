new file mode 100644
index 0000000000000000000000000000000000000000..ef9d0e1c1f667446feed9769f89a4816a26f3c29
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_folders.cpp
@@ -0,0 +1,128 @@
+#include "tele/tele_folders.h"
+
+#include "data/data_chat_filters.h"
+#include "data/data_session.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+namespace {
+
+using Tabs = std::vector<Data::ChatFilter>;
+
+[[nodiscard]] std::map<not_null<Main::Session*>, Tabs> &TabsCache() {
+	static auto result = std::map<not_null<Main::Session*>, Tabs>();
+	return result;
+}
+
+[[nodiscard]] bool SameTabs(const Tabs &tabs, const Tabs &list) {
+	auto i = begin(tabs);
+	for (const auto &filter : list) {
+		if (!filter.id()) {
+			continue;
+		} else if (i == end(tabs)
+			|| i->id() != filter.id()
+			|| *i != filter
+			|| i->pinned() != filter.pinned()) {
+			return false;
+		}
+		++i;
+	}
+	return (i == end(tabs));
+}
+
+} // namespace
+
+int HiddenFolderTabs(not_null<Main::Session*> session) {
+	const auto &list = session->data().chatsFilters().list();
+	return (HideAllChats()
+		&& list.size() > 1
+		&& ranges::contains(list, FilterId(), &Data::ChatFilter::id))
+		? 1
+		: 0;
+}
+
+const std::vector<Data::ChatFilter> &FolderTabs(
+		not_null<Main::Session*> session) {
+	const auto &list = session->data().chatsFilters().list();
+	if (!HiddenFolderTabs(session)) {
+		return list;
+	}
+	auto &cache = TabsCache();
+	auto i = cache.find(session);
+	if (i == end(cache)) {
+		i = cache.emplace(session, Tabs()).first;
+		session->lifetime().add([=] {
+			TabsCache().erase(session);
+		});
+	}
+	auto &tabs = i->second;
+	if (!SameTabs(tabs, list)) {
+		tabs.clear();
+		for (const auto &filter : list) {
+			if (filter.id()) {
+				tabs.push_back(filter);
+			}
+		}
+	}
+	return tabs;
+}
+
+std::optional<FilterId> FolderTabId(
+		not_null<Main::Session*> session,
+		int index) {
+	if (!HiddenFolderTabs(session)) {
+		return std::nullopt;
+	}
+	const auto &tabs = FolderTabs(session);
+	return tabs[std::clamp(index, 0, int(tabs.size()) - 1)].id();
+}
+
+void RestoreHiddenFolderTabs(
+		not_null<Main::Session*> session,
+		std::vector<FilterId> &order) {
+	if (ranges::contains(order, FilterId())) {
+		return;
+	}
+	const auto &list = session->data().chatsFilters().list();
+	const auto i = ranges::find(list, FilterId(), &Data::ChatFilter::id);
+	if (i == end(list)) {
+		return;
+	}
+	const auto position = std::min(
+		int(i - begin(list)),
+		int(order.size()));
+	order.insert(begin(order) + position, FilterId());
+}
+
+rpl::producer<> FolderTabsChanges(not_null<Main::Session*> session) {
+	return rpl::merge(
+		session->data().chatsFilters().changed(),
+		HideAllChatsChanges());
+}
+
+void SetupFolderTabs(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto check = [=] {
+		const auto filters = &session->data().chatsFilters();
+		if (controller->isPrimary()
+			&& filters->loaded()
+			&& !controller->activeChatsFilterCurrent()
+			&& !controller->openedFolder().current()
+			&& !controller->openedCommunity().current()
+			&& HiddenFolderTabs(session)) {
+			controller->setActiveChatsFilter(filters->defaultId());
+		}
+	};
+	rpl::merge(
+		FolderTabsChanges(session),
+		controller->activeChatsFilter() | rpl::to_empty,
+		controller->openedFolder().changes() | rpl::to_empty,
+		controller->openedCommunity().changes() | rpl::to_empty
+	) | rpl::on_next([=] {
+		crl::on_main(controller, check);
+	}, controller->lifetime());
+}
+
+} // namespace Tele
