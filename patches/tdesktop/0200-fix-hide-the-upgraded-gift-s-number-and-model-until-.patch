diff --git a/Telegram/SourceFiles/tele/tele_gift_roll_number.cpp b/Telegram/SourceFiles/tele/tele_gift_roll_number.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9cdc4fcf1508866c4605497ea3374f5b7e320239
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_roll_number.cpp
@@ -0,0 +1,146 @@
+#include "tele/tele_gift_roll_number.h"
+
+#include "base/random.h"
+#include "base/timer.h"
+#include "boxes/star_gift_cover_box.h"
+#include "data/data_star_gift.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kRollInterval = crl::time(60);
+
+using SpinnerState = Data::GiftUpgradeSpinner::State;
+
+[[nodiscard]] bool Spinning(SpinnerState state) {
+	return (state >= SpinnerState::Preparing)
+		&& (state < SpinnerState::Finished);
+}
+
+[[nodiscard]] QString Scramble(QString text) {
+	auto first = true;
+	for (auto &ch : text) {
+		if (ch < QChar('0') || ch > QChar('9')) {
+			continue;
+		}
+		ch = QChar('0' + (first
+			? (1 + base::RandomIndex(9))
+			: base::RandomIndex(10)));
+		first = false;
+	}
+	return text;
+}
+
+} // namespace
+
+rpl::producer<QString> RollGiftNumber(
+		rpl::producer<QString> text,
+		std::shared_ptr<Data::GiftUpgradeSpinner> spinner,
+		rpl::lifetime &lifetime) {
+	if (!spinner) {
+		return text;
+	}
+	struct State {
+		QString real;
+		rpl::variable<QString> shown;
+		base::Timer timer;
+		bool spinning = false;
+	};
+	const auto state = lifetime.make_state<State>();
+	const auto refresh = [=] {
+		if (state->spinning && !state->real.isEmpty()) {
+			state->shown = Scramble(state->real);
+			if (!state->timer.isActive()) {
+				state->timer.callEach(kRollInterval);
+			}
+		} else {
+			state->timer.cancel();
+			state->shown = state->real;
+		}
+	};
+	state->timer.setCallback([=] {
+		state->shown = Scramble(state->real);
+	});
+	std::move(text) | rpl::on_next([=](const QString &value) {
+		state->real = value;
+		refresh();
+	}, lifetime);
+	spinner->state.value() | rpl::on_next([=](SpinnerState now) {
+		const auto spinning = Spinning(now);
+		if (state->spinning != spinning) {
+			state->spinning = spinning;
+			refresh();
+		}
+	}, lifetime);
+	return state->shown.value();
+}
+
+rpl::producer<float64> RollGiftCount(
+		int count,
+		std::shared_ptr<Data::GiftUpgradeSpinner> spinner) {
+	if (!spinner) {
+		return rpl::single(count * 1.);
+	}
+	return [=](auto consumer) {
+		auto lifetime = rpl::lifetime();
+		const auto real = QString::number(count);
+		const auto timer = lifetime.make_state<base::Timer>([=] {
+			consumer.put_next(Scramble(real).toInt() * 1.);
+		});
+		spinner->state.value(
+		) | rpl::map(
+			Spinning
+		) | rpl::distinct_until_changed(
+		) | rpl::on_next([=](bool spinning) {
+			if (spinning) {
+				consumer.put_next(Scramble(real).toInt() * 1.);
+				timer->callEach(kRollInterval);
+			} else {
+				timer->cancel();
+				consumer.put_next(count * 1.);
+			}
+		}, lifetime);
+		return lifetime;
+	};
+}
+
+rpl::producer<Ui::UniqueGiftCover> RollGiftModel(
+		rpl::producer<Ui::UniqueGiftCover> data,
+		std::shared_ptr<Data::GiftUpgradeSpinner> spinner,
+		rpl::producer<DocumentData*> shown) {
+	if (!spinner) {
+		return data;
+	}
+	return rpl::combine(
+		std::move(data),
+		spinner->state.value(),
+		std::move(shown)
+	) | rpl::map([=](
+			Ui::UniqueGiftCover cover,
+			SpinnerState state,
+			DocumentData *document) {
+		if (!cover.spinner || !Spinning(state)) {
+			return cover;
+		}
+		const auto &models = spinner->attributes.models;
+		const auto target = cover.values.model.document;
+		const auto byDocument = [&](not_null<DocumentData*> value) {
+			return ranges::find(
+				models,
+				value,
+				&Data::UniqueGiftModel::document);
+		};
+		auto i = document ? byDocument(document) : end(models);
+		if (i == end(models) && document != target.get()) {
+			i = ranges::find_if(models, [&](const auto &model) {
+				return model.document != target;
+			});
+		}
+		if (i != end(models)) {
+			cover.values.model = *i;
+		}
+		return cover;
+	});
+}
+
+} // namespace Tele
