 #include "ui/chat/chat_style.h"
 #include "ui/painter.h"
 #include "main/main_session.h"
+#include "window/notifications_manager.h"
 #include "tele/tele_drafts_section.h"
 #include "tele/tele_kept_store.h"
 #include "tele/tele_options.h"
@@ -56,11 +63,90 @@ void RefreshAll() {
 	}
 }
 
+void LeaveLists(not_null<HistoryItem*> item) {
+	if (const auto thread = item->maybeNotificationThread()) {
+		thread->removeNotification(item);
+	}
+	if (CanHoldItemNotification(item)) {
+		Core::App().notifications().clearFromItem(item);
+	}
+	const auto history = item->history();
+	const auto topic = item->topic();
+	if (item->isUnreadMention()) {
+		history->unreadMentions().erase(item->id);
+		if (topic) {
+			topic->unreadMentions().erase(item->id);
+		}
+	}
+	if (item->hasUnreadReaction()) {
+		history->unreadReactions().erase(item->id);
+		if (topic) {
+			topic->unreadReactions().erase(item->id);
+		} else if (const auto sublist = item->savedSublist()) {
+			sublist->unreadReactions().erase(item->id);
+		}
+	}
+	if (item->hasUnreadPollVote()) {
+		history->unreadPollVotes().erase(item->id);
+		if (topic) {
+			topic->unreadPollVotes().erase(item->id);
+		}
+	}
+	if (topic) {
+		topic->applyItemRemoved(item->id);
+	}
+	if (const auto sublist = item->savedSublist()) {
+		sublist->applyItemRemoved(item->id);
+	}
+}
+
+void LeaveLists(const std::vector<not_null<HistoryItem*>> &items) {
+	auto histories = base::flat_set<not_null<History*>>();
+	auto topics = base::flat_set<not_null<Data::ForumTopic*>>();
+	for (const auto &item : items) {
+		const auto history = item->history();
+		const auto unread = !item->out() && item->unread(history);
+		if (unread
+			|| history->lastMessage() == item
+			|| history->chatListMessage() == item) {
+			histories.emplace(history);
+		}
+		if (const auto topic = item->topic(); topic && unread) {
+			topics.emplace(topic);
+		}
+		LeaveLists(item);
+	}
+	for (const auto &history : histories) {
+		history->owner().histories().requestDialogEntry(history);
+	}
+	for (const auto &topic : topics) {
+		topic->forum()->requestTopic(topic->rootId());
+	}
+}
+
+void LeaveAllLists() {
+	auto items = std::vector<not_null<HistoryItem*>>();
+	for (const auto &[session, histories] : Get().sessions) {
+		for (const auto &[history, kept] : histories) {
+			for (const auto &[id, item] : kept) {
+				items.push_back(item);
+			}
+		}
+	}
+	LeaveLists(items);
+}
+
 State::State() {
 	DeletedTrashIconValue(
 	) | rpl::skip(1) | rpl::on_next([] {
 		RefreshAll();
 	}, lifetime);
+	DeletedOutOfListsValue(
+	) | rpl::skip(1) | rpl::filter(
+		rpl::mappers::_1
+	) | rpl::on_next([] {
+		LeaveAllLists();
+	}, lifetime);
 }
 
 void Forget(
@@ -196,6 +282,9 @@ void Keep(std::vector<not_null<HistoryItem*>> &items, bool own) {
 	for (const auto &history : histories) {
 		Get().changes.fire_copy(history);
 	}
+	if (DeletedOutOfLists()) {
+		LeaveLists(kept);
+	}
 }
 
 void Restore(not_null<History*> history) {
@@ -243,6 +332,31 @@ bool IsKeptDeleted(not_null<const HistoryItem*> item) {
 	return (i != end(*items)) && (i->second.get() == item.get());
 }
 
+bool LeftOutOfLists(not_null<const HistoryItem*> item) {
+	return DeletedOutOfLists() && IsKeptDeleted(item);
+}
+
+std::optional<HistoryItem*> LastListedMessage(
+		not_null<const History*> history) {
+	if (!DeletedOutOfLists() || Get().sessions.empty()) {
+		return std::nullopt;
+	}
+	const auto kept = Find(const_cast<History*>(history.get()));
+	if (!kept || kept->empty()) {
+		return std::nullopt;
+	}
+	for (const auto &block : ranges::views::reverse(history->blocks)) {
+		for (const auto &view : ranges::views::reverse(block->messages)) {
+			const auto item = view->data();
+			const auto i = kept->find(item->id);
+			if (i == end(*kept) || i->second.get() != item.get()) {
+				return item.get();
+			}
+		}
+	}
+	return nullptr;
+}
+
 bool DeletedIconShown(not_null<const HistoryItem*> item) {
 	return DeletedTrashIcon() && IsKeptDeleted(item);
 }
