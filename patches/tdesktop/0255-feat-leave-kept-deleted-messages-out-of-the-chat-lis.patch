+	.description = "They stay in the chat itself.",
+});
+
 base::options::option<QString> DeletedReplyOption({
 	.id = kOptionDeletedReply,
 	.name = "Replies to deleted messages",
@@ -2266,6 +2273,21 @@ rpl::producer<bool> DeletedTrashIconValue() {
 	}) | rpl::distinct_until_changed();
 }
 
+bool DeletedOutOfLists() {
+	return KeepDeletedOption.value() && DeletedOutOfListsOption.value();
+}
+
+rpl::producer<bool> DeletedOutOfListsValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(rpl::merge(
+		KeepDeletedOption.changes(),
+		DeletedOutOfListsOption.changes()
+	)) | rpl::map([] {
+		return DeletedOutOfLists();
+	}) | rpl::distinct_until_changed();
+}
+
 QString DeletedReply() {
 	return DeletedReplyOption.value();
 }
