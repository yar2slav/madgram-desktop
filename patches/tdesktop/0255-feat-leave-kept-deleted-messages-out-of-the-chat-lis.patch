index 440237caadd132922105218947d35f31b09e196a..6e0310494ba0b1d082dae53dfa7f56228f8b22b3 100644
--- a/Telegram/SourceFiles/history/history.cpp
+++ b/Telegram/SourceFiles/history/history.cpp
@@ -280,7 +280,8 @@ void History::itemVanished(not_null<HistoryItem*> item) {
 	}
 	if ((!item->out() || item->isPost())
 		&& item->unread(this)
-		&& unreadCount() > 0) {
+		&& unreadCount() > 0
+		&& !Tele::LeftOutOfLists(item)) {
 		setUnreadCount(unreadCount() - 1);
 	}
 	if (const auto media = item->media()) {
@@ -2220,7 +2221,8 @@ std::optional<int> History::countStillUnreadLocal(MsgId readTillId) const {
 				for (const auto &message : block->messages) {
 					const auto item = message->data();
 					if (!item->isRegular()
-						|| (item->out() && !item->isFromScheduled())) {
+						|| (item->out() && !item->isFromScheduled())
+						|| Tele::LeftOutOfLists(item)) {
 						continue;
 					} else if (item->id > readTillId) {
 						break;
@@ -2254,7 +2256,7 @@ std::optional<int> History::countStillUnreadLocal(MsgId readTillId) const {
 			if (item->isRegular()) {
 				if (item->id <= readTillId) {
 					return result;
-				} else if (!item->out()) {
+				} else if (!item->out() && !Tele::LeftOutOfLists(item)) {
 					++result;
 				}
 			}
@@ -2275,7 +2277,8 @@ std::optional<int> History::countStillUnreadLocalFromMessages(
 		const auto item = owner().message(peer->id, id);
 		return item
 			&& item->isRegular()
-			&& !item->out();
+			&& !item->out()
+			&& !Tele::LeftOutOfLists(item);
 	});
 }
 
@@ -2364,6 +2367,9 @@ MsgId History::outboxReadTillId() const {
 }
 
 HistoryItem *History::lastAvailableMessage() const {
+	if (const auto listed = Tele::LastListedMessage(this)) {
+		return *listed;
+	}
 	return isEmpty() ? nullptr : blocks.back()->messages.back()->data().get();
 }
 
