diff --git a/Telegram/SourceFiles/tele/tele_silent.cpp b/Telegram/SourceFiles/tele/tele_silent.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7efb99ab7d5fd50232d695baac97cca6a78b03a0
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_silent.cpp
@@ -0,0 +1,266 @@
+#include "tele/tele_silent.h"
+
+#include "api/api_common.h"
+#include "data/data_chat_participant_status.h"
+#include "data/data_peer.h"
+#include "history/history.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "menu/menu_send_details.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/menu/menu_toggle.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E5117);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxPeers = 65536;
+
+class State final {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static not_null<State*> For(
+		not_null<Main::Session*> session);
+
+	[[nodiscard]] std::optional<bool> lookup(PeerId id) const;
+	void set(PeerId id, std::optional<bool> value);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<PeerId, bool> _overrides;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+not_null<State*> State::For(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	if (i != end(registry)) {
+		return i->second;
+	}
+	return session->lifetime().make_state<State>(session);
+}
+
+std::optional<bool> State::lookup(PeerId id) const {
+	const auto i = _overrides.find(id);
+	return (i != end(_overrides))
+		? std::make_optional(i->second)
+		: std::nullopt;
+}
+
+void State::set(PeerId id, std::optional<bool> value) {
+	if (value) {
+		_overrides[id] = *value;
+	} else if (!_overrides.remove(id)) {
+		return;
+	}
+	write();
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_silent"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxPeers) {
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto id = quint64();
+		auto silent = quint8();
+		file.stream >> id >> silent;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (id) {
+			_overrides[PeerId(id)] = (silent != 0);
+		}
+	}
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	const auto size = sizeof(quint32) * 3
+		+ sizeof(quint64)
+		+ _overrides.size() * (sizeof(quint64) + sizeof(quint8));
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_overrides.size());
+	for (const auto &[id, silent] : _overrides) {
+		data.stream << quint64(id.value) << quint8(silent ? 1 : 0);
+	}
+	auto file = FileWriteDescriptor(u"tele_silent"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+[[nodiscard]] rpl::event_stream<not_null<PeerData*>> &Changes() {
+	static auto result = rpl::event_stream<not_null<PeerData*>>();
+	return result;
+}
+
+[[nodiscard]] bool Enabled() {
+	return SilentByDefault() || SilentPerChat();
+}
+
+void SetSilentInChat(not_null<PeerData*> peer, bool silent) {
+	const auto value = (silent == SilentByDefault())
+		? std::nullopt
+		: std::make_optional(silent);
+	State::For(&peer->session())->set(peer->id, value);
+	Changes().fire_copy(peer);
+}
+
+[[nodiscard]] rpl::producer<bool> SilentValue(not_null<PeerData*> peer) {
+	return rpl::single(rpl::empty) | rpl::then(rpl::merge(
+		SilentByDefaultChanges(),
+		SilentPerChatChanges(),
+		Changes().events() | rpl::filter([=](not_null<PeerData*> changed) {
+			return (changed == peer);
+		}) | rpl::to_empty
+	)) | rpl::map([=] {
+		return SilentInChat(peer);
+	}) | rpl::distinct_until_changed();
+}
+
+} // namespace
+
+bool SilentInChat(not_null<PeerData*> peer) {
+	if (!Enabled() || peer->isSelf()) {
+		return false;
+	}
+	const auto state = State::For(&peer->session());
+	return state->lookup(peer->id).value_or(SilentByDefault());
+}
+
+std::optional<bool> SilentOverride(
+		not_null<PeerData*> peer,
+		const Api::SendOptions &options) {
+	if (options.teleWithSound) {
+		return false;
+	} else if (options.shortcutId || !SilentInChat(peer)) {
+		return std::nullopt;
+	}
+	return true;
+}
+
+rpl::producer<QString> SilentPlaceholder(
+		History *history,
+		rpl::producer<QString> placeholder) {
+	if (!history) {
+		return placeholder;
+	}
+	return rpl::combine(
+		std::move(placeholder),
+		SilentValue(history->peer)
+	) | rpl::map([](const QString &text, bool silent) {
+		if (!silent) {
+			return text;
+		} else if (text == tr::lng_message_ph(tr::now)) {
+			return Lower(u"Silent message..."_q);
+		} else if (text == tr::lng_broadcast_ph(tr::now)) {
+			return tr::lng_broadcast_silent_ph(tr::now);
+		}
+		return text;
+	});
+}
+
+QString SilentMenuText(const SendMenu::Details &details) {
+	return details.teleSilent
+		? Lower(u"Send with sound"_q)
+		: tr::lng_send_silent_message(tr::now);
+}
+
+Api::SendOptions SilentMenuOptions(const SendMenu::Details &details) {
+	return details.teleSilent
+		? Api::SendOptions{ .teleWithSound = true }
+		: Api::SendOptions{ .silent = true };
+}
+
+const style::icon *SilentMenuIcon(
+		const SendMenu::Details &details,
+		const style::icon *icon) {
+	return details.teleSilent ? &st::menuIconUnmute : icon;
+}
+
+void AddSilentChatAction(
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer
+		|| peer->isSelf()
+		|| !Enabled()
+		|| !Data::CanSendAnything(peer, false)) {
+		return;
+	}
+	const auto silent = SilentInChat(peer);
+	addAction({ .make = [=](not_null<Ui::PopupMenu*> menu) {
+		auto result = base::make_unique_q<Ui::Menu::Toggle>(
+			menu->menu(),
+			menu->st().menu,
+			Lower(u"Send silently"_q),
+			[=] { SetSilentInChat(peer, !silent); },
+			&st::menuIconMute,
+			&st::menuIconMute);
+		result->action()->setCheckable(true);
+		result->action()->setChecked(silent);
+		return base::unique_qptr<Ui::Menu::ItemBase>(std::move(result));
+	} });
+}
+
+} // namespace Tele
