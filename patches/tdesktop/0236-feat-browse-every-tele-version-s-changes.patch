+	for (const auto version : versions) {
+		tabs.push_back({
+			.id = TabId(version),
+			.text = { u"tele %1"_q.arg(version) },
+		});
+	}
+	_tabs->setTabs(std::move(tabs));
+	_tabs->setActiveTab(TabId(scope()));
+	if (_controls->width() > 0) {
+		_tabs->resizeToWidth(_controls->width());
+	}
