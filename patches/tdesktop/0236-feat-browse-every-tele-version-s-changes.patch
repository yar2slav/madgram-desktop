+[[nodiscard]] QString TabId(int version) {
+	return version ? QString::number(version) : kAllTab;
+}
+
+[[nodiscard]] QStringList QueryWords(const QString &query) {
+	static const auto spaces = QRegularExpression(u"\\s+"_q);
+	return query.split(spaces, Qt::SkipEmptyParts);
+}
+
+[[nodiscard]] bool Matches(
+		const ChangelogHistoryItem &item,
+		const QStringList &words) {
+	const auto haystack = item.text
+		+ '\n'
+		+ item.where
+		+ '\n'
+		+ item.category;
+	return ranges::all_of(words, [&](const QString &word) {
+		return haystack.contains(word, Qt::CaseInsensitive);
+	});
+}
+
+[[nodiscard]] TextWithEntities Highlighted(
+		const QString &text,
+		const QStringList &words) {
+	auto found = std::vector<std::pair<int, int>>();
+	for (const auto &word : words) {
+		auto from = 0;
+		while (true) {
+			const auto index = text.indexOf(word, from, Qt::CaseInsensitive);
+			if (index < 0) {
+				break;
+			}
+			from = index + int(word.size());
+			found.emplace_back(index, from);
+		}
+	}
+	ranges::sort(found);
+	auto result = TextWithEntities{ text };
+	auto start = -1;
+	auto till = -1;
+	const auto flush = [&] {
+		if (start < 0) {
+			return;
+		}
+		const auto length = till - start;
+		result.entities.push_back(
+			EntityInText(EntityType::Semibold, start, length));
+		result.entities.push_back(
+			EntityInText(EntityType::Colorized, start, length));
+	};
+	for (const auto &[from, to] : found) {
+		if (start >= 0 && from <= till) {
+			till = std::max(till, to);
+		} else {
+			flush();
+			start = from;
+			till = to;
+		}
+	}
+	flush();
+	return result;
+}
+
+[[nodiscard]] QString Details(const ChangelogHistoryItem &item) {
+	auto parts = QStringList();
+	if (item.number > 0) {
+		parts.push_back(u"#%1"_q.arg(item.number));
+	}
+	if (!item.category.isEmpty()) {
+		parts.push_back(item.category);
+	}
+	if (!item.where.isEmpty() && item.where != item.category) {
+		parts.push_back(item.where);
+	}
+	return Lower(parts.join(u" \u00B7 "_q));
+}
