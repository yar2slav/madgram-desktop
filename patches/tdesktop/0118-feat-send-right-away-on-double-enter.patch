diff --git a/Telegram/SourceFiles/tele/tele_send_order.cpp b/Telegram/SourceFiles/tele/tele_send_order.cpp
index 5dd28474eb9e395be0f7f5c11a680ba28709599e..d18599c4698ffe5b22068d7c4ddd9db81bae0930 100644
--- a/Telegram/SourceFiles/tele/tele_send_order.cpp
+++ b/Telegram/SourceFiles/tele/tele_send_order.cpp
@@ -12,6 +12,8 @@
 #include "storage/file_upload.h"
 #include "tele/tele_options.h"
 
+#include <QtWidgets/QApplication>
+
 namespace Tele {
 namespace {
 
@@ -134,6 +136,7 @@ struct Held {
 	not_null<History*> history;
 	std::vector<FullMsgId> ids;
 	FullMsgId reply;
+	crl::time at = 0;
 	Fn<void()> send;
 };
 
@@ -147,6 +150,8 @@ struct QueueState {
 	QueueState();
 
 	base::flat_map<not_null<Main::Session*>, Queue> sessions;
+	crl::time lastEnter = 0;
+	bool releasing = false;
 	rpl::lifetime lifetime;
 };
 
@@ -394,7 +399,7 @@ bool HoldBehindMedia(
 		uint64 randomId,
 		const Data::Histories::PreparedMessage &message,
 		Fn<void()> send) {
-	if (!QueueBehindMedia()) {
+	if (!QueueBehindMedia() || Queues().releasing) {
 		return false;
 	}
 	const auto session = &history->session();
@@ -425,9 +430,51 @@ bool HoldBehindMedia(
 		.history = history,
 		.ids = std::move(ids),
 		.reply = reply,
+		.at = crl::now(),
 		.send = std::move(send),
 	});
 	return true;
 }
 
+bool SendHeldOnDoubleEnter(History *history, bool empty) {
+	auto &state = Queues();
+	const auto now = crl::now();
+	const auto since = std::exchange(state.lastEnter, now);
+	if (!history
+		|| !empty
+		|| !DoubleEnterSend()
+		|| !QueueBehindMedia()
+		|| (now - since > QApplication::doubleClickInterval())) {
+		return false;
+	}
+	const auto session = &history->session();
+	const auto i = state.sessions.find(session);
+	if (i == end(state.sessions)) {
+		return false;
+	}
+	auto &held = i->second.held;
+	auto taken = std::vector<Held>();
+	for (auto j = begin(held); j != end(held);) {
+		if (j->history == history && j->at >= since) {
+			taken.push_back(std::move(*j));
+			j = held.erase(j);
+		} else {
+			++j;
+		}
+	}
+	if (taken.empty()) {
+		return false;
+	}
+	state.lastEnter = 0;
+	state.releasing = true;
+	for (const auto &entry : taken) {
+		if (AnyAlive(entry)) {
+			entry.send();
+		}
+	}
+	state.releasing = false;
+	Schedule(session);
+	return true;
+}
+
 } // namespace Tele
