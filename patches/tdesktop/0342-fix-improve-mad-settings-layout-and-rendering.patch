+Ui::FlatLabel *SetupSettingText(
+		not_null<Ui::SettingsButton*> button,
+		rpl::producer<TextWithEntities> text,
+		rpl::producer<QString> value,
+		int right) {
+	const auto title = Ui::CreateChild<Ui::FlatLabel>(button,
+		std::move(text), st::settingsExperimentalTitle);
+	title->setAttribute(Qt::WA_TransparentForMouseEvents);
+	title->show();
+	const auto label = value ? Ui::CreateChild<Ui::FlatLabel>(button,
+		std::move(value), st::settingsExperimentalAbout) : nullptr;
+	if (label) {
+		label->setAttribute(Qt::WA_TransparentForMouseEvents);
+		label->setBreakEverywhere(true);
+		label->show();
+	}
+	button->setProperty("mad-text-title", QVariant::fromValue<QObject*>(title));
+	button->setProperty("mad-text-label", QVariant::fromValue<QObject*>(label));
+	const auto busy = button->lifetime().make_state<bool>(false);
+	const auto layout = [=] {
+		if (*busy || button->width() <= 0) {
+			return;
+		}
+		*busy = true;
+		const auto &style = button->st();
+		const auto left = style.padding.left();
+		const auto reserved = right + button->property("mad-help-width").toInt();
+		const auto width = std::max(1, button->width() - left - reserved);
+		title->resizeToWidth(width);
+		title->moveToLeft(left, style.padding.top());
+		auto height = title->height();
+		if (label) {
+			label->resizeToWidth(width);
+			label->moveToLeft(left, style.padding.top() + height + st::lineWidth * 3);
+			height += label->height() + st::lineWidth * 3;
+		}
+		button->setPaddingOverride({ left, style.padding.top(), reserved,
+			style.padding.bottom() + std::max(0, height - style.height) });
+		button->setAccessibleName(title->accessibilityName());
+		*busy = false;
+	};
+	button->widthValue() | rpl::on_next([=] { layout(); }, button->lifetime());
+	title->heightValue() | rpl::on_next([=] { layout(); }, button->lifetime());
+	if (label) {
+		label->heightValue() | rpl::on_next([=] { layout(); }, button->lifetime());
+	}
+	base::install_event_filter(button, [=](not_null<QEvent*> event) {
+		if (event->type() == QEvent::DynamicPropertyChange) {
+			layout();
+		}
+		return base::EventFilterResult::Continue;
+	});
+	return title;
+}
+
+Ui::AbstractButton *AddSettingHelp(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Window::SessionController*> controller,
+		const QString &name,
+		const QString &description,
+		int right) {
+	if (description.isEmpty()) {
+		return nullptr;
+	}
+	const auto help = Ui::CreateChild<Ui::AbstractButton>(parent);
+	help->resize(st::madSettingHelpSize, st::madSettingHelpSize);
+	help->setAccessibleName(name + u": "_q + description);
+	help->setFocusPolicy(Qt::StrongFocus);
+	parent->sizeValue() | rpl::on_next([=](QSize size) {
+		help->moveToRight(right, (size.height() - help->height()) / 2);
+	}, help->lifetime());
+	help->paintRequest() | rpl::on_next([=] {
+		static auto image = QImage();
+		static auto color = QColor();
+		const auto scale = help->devicePixelRatioF();
+		const auto size = help->size() * scale;
+		const auto next = st::windowSubTextFg->c;
+		if (image.size() != size || image.devicePixelRatio() != scale || color != next) {
+			auto file = QFile(u":/gui/art/mad_help.svg"_q);
+			auto data = file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+			data.replace("currentColor", next.name().toLatin1());
+			image = QImage(size, QImage::Format_ARGB32_Premultiplied);
+			image.setDevicePixelRatio(scale);
+			image.fill(Qt::transparent);
+			auto painter = QPainter(&image);
+			auto svg = QSvgRenderer(data);
+			const auto skip = st::madSettingHelpInset;
+			svg.render(&painter, QRectF(help->rect().marginsRemoved({skip, skip, skip, skip})));
+			color = next;
+		}
+		auto painter = QPainter(help);
+		painter.drawImage(QPoint(), image);
+	}, help->lifetime());
+	struct State {
+		std::unique_ptr<Ui::ImportantTooltip> tooltip;
+		base::Timer timer;
+	};
+	const auto state = help->lifetime().make_state<State>();
+	const auto hide = [=] {
+		state->timer.cancel();
+		if (state->tooltip) {
+			state->tooltip->toggleAnimated(false);
+		}
+	};
+	state->timer.setCallback([=] {
+		if (!help->isVisible() || !help->window()->isActiveWindow()) {
+			return;
+		}
+		const auto window = help->window();
+		if (!state->tooltip) {
+			const auto preview = description.size() > 180
+				? description.left(177) + u"…"_q : description;
+			state->tooltip = std::make_unique<Ui::ImportantTooltip>(window,
+				Ui::MakeNiceTooltipLabel(window,
+					rpl::single(TextWithEntities::Simple(preview)),
+					st::boxWidth * 2 / 3, st::defaultImportantTooltipLabel),
+				st::defaultImportantTooltip);
+			state->tooltip->setAttribute(Qt::WA_TransparentForMouseEvents);
+		}
+		state->tooltip->pointAt(QRect(help->mapTo(window, QPoint()), help->size()));
+		state->tooltip->raise();
+		state->tooltip->toggleAnimated(true);
+	});
+	base::install_event_filter(help, [=](not_null<QEvent*> event) {
+		if (event->type() == QEvent::Enter || event->type() == QEvent::FocusIn) {
+			state->timer.callOnce(350);
+		} else if (event->type() == QEvent::Leave || event->type() == QEvent::FocusOut
+				|| event->type() == QEvent::Hide || event->type() == QEvent::MouseButtonPress) {
+			hide();
+		}
+		return base::EventFilterResult::Continue;
+	});
+	help->setClickedCallback([=] {
+		hide();
+		controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+			box->setTitle(rpl::single(name));
+			box->addRow(object_ptr<Ui::FlatLabel>(box, description, st::boxLabel));
+			box->addButton(rpl::single(Tr(u"Close"_q)), [=] { box->closeBox(); });
+		}));
+	});
+	help->show();
+	return help;
+}
+
+void AddSettingsMenuEntry(
+		not_null<Ui::VerticalLayout*> menu,
+		not_null<Window::SessionController*> controller) {
+	auto &option = base::options::lookup<bool>(kOptionHideMadSettingsMenu);
+	const auto wrap = menu->add(object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+		menu, object_ptr<Ui::VerticalLayout>(menu)));
+	const auto content = wrap->entity();
+	content->add(object_ptr<Ui::PlainShadow>(content),
+		{ 0, st::mainMenuSkip, 0, st::mainMenuSkip });
+	const auto button = Settings::AddButtonWithIcon(content,
+		rpl::single(Tr(u"mad settings"_q)), st::mainMenuButton, { &st::menuIconCustomize });
+	button->setClickedCallback([=] { controller->showSettings(Settings::TeleSectionId()); });
+	button->setAcceptBoth(true);
+	button->clicks() | rpl::filter([](Qt::MouseButton button) {
+		return button == Qt::RightButton;
+	}) | rpl::on_next([=, &option] {
+		const auto popup = Ui::CreateChild<Ui::PopupMenu>(button);
+		popup->addAction(Tr(u"Hide from side menu"_q), [&option] { option.set(true); });
+		popup->popup(QCursor::pos());
+	}, button->lifetime());
+	wrap->toggleOn(rpl::single(rpl::empty) | rpl::then(option.changes())
+		| rpl::map([&option] { return !option.value(); }));
+	wrap->finishAnimating();
+}
+
+}
