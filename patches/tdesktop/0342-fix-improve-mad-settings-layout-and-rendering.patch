 	return value;
 }
 
+QString InterfaceText(ushort key, QString value) {
+	struct Entry {
+		QString source;
+		QString result;
+		bool lowercase = false;
+	};
+	thread_local auto cache = QHash<ushort, Entry>();
+	const auto lowercase = LowercaseStrings();
+	const auto found = cache.constFind(key);
+	if (found != cache.cend() && found->source == value
+		&& found->lowercase == lowercase) {
+		return found->result;
+	}
+	auto result = Lower(AppName(key, value));
+	cache.insert(key, { std::move(value), result, lowercase });
+	return result;
+}
+
 } // namespace Tele
