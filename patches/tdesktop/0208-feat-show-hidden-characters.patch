+TextWithEntities WithHiddenChars(TextWithEntities text) {
+	EnsureHiddenState();
+	if (!ShowHiddenChars() || !IsInvisibleText(text.text)) {
+		return text;
+	}
+	const auto &original = text.entities;
+	const auto custom = ranges::any_of(original, [](const EntityInText &e) {
+		return (e.type() == EntityType::CustomEmoji);
+	});
+	if (custom) {
+		return text;
+	}
+	const auto linked = [&](int offset, int length) {
+		return ranges::any_of(original, [&](const EntityInText &e) {
+			return IsLinkEntity(e.type())
+				&& (e.offset() < offset + length)
+				&& (offset < e.offset() + e.length());
+		});
+	};
+	auto entities = EntitiesInText();
+	auto placeholder = QString();
+	placeholder.reserve(text.text.size());
+	EnumerateCodePoints(text.text, [&](int offset, int length, char32_t code) {
+		const auto hex = HexCode(code);
+		entities.push_back({
+			EntityType::Colorized,
+			offset,
+			length,
+			QString(QChar(char16_t(kKeepPenColorIndex))),
+		});
+		if (!linked(offset, length)) {
+			entities.push_back({
+				EntityType::CustomUrl,
+				offset,
+				length,
+				HiddenLinkPrefix() + hex,
+			});
+		}
+		entities.push_back({
+			EntityType::CustomEmoji,
+			offset,
+			length,
+			HiddenCharPrefix() + hex,
+		});
+		placeholder.append(
+			QString(length, QChar(QChar::ObjectReplacementCharacter)));
+		return true;
+	});
+	auto merged = original;
+	merged.append(entities);
+	std::stable_sort(
+		merged.begin(),
+		merged.end(),
+		[](const EntityInText &a, const EntityInText &b) {
+			return (a.offset() < b.offset())
+				|| (a.offset() == b.offset() && a.length() > b.length());
+		});
+	return { std::move(placeholder), std::move(merged) };
+}
+
+rpl::producer<TextWithEntities> WithHiddenCharsValue(
+		rpl::producer<TextWithEntities> text) {
+	return rpl::combine(
+		std::move(text),
+		ShowHiddenCharsValue()
+	) | rpl::map([](TextWithEntities text, bool) {
+		return WithHiddenChars(std::move(text));
+	});
+}
+
+Ui::Text::MarkedContext HiddenCharsContext() {
+	return {
+		.customEmojiFactory = [](
+				QStringView data,
+				const Ui::Text::MarkedContext &context) {
+			return MakeHiddenCharObject(data);
+		},
+	};
+}
+
+std::unique_ptr<Ui::Text::CustomEmoji> MakeHiddenCharObject(
+		QStringView data) {
+	const auto prefix = HiddenCharPrefix();
+	if (!data.startsWith(prefix)) {
+		return nullptr;
+	}
+	const auto code = ParseCode(data.mid(prefix.size()));
+	return code
+		? std::make_unique<HiddenCharObject>(data.toString(), *code)
+		: nullptr;
+}
+
+std::shared_ptr<ClickHandler> HiddenCharLink(const EntityLinkData &data) {
+	const auto prefix = HiddenLinkPrefix();
+	if (data.type != EntityType::CustomUrl
+		|| !data.data.startsWith(prefix)) {
+		return nullptr;
+	}
+	const auto code = ParseCode(QStringView(data.data).mid(prefix.size()));
+	if (!code) {
+		return nullptr;
+	}
+	InstallTooltips();
+	return std::make_shared<HiddenCharClickHandler>(*code);
+}
