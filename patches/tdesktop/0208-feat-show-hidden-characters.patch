+void InstallTooltips() {
+	static auto installed = false;
+	if (std::exchange(installed, true)) {
+		return;
+	}
+	static const auto shower = TooltipShower();
+	base::install_event_filter(QCoreApplication::instance(), [](
+			not_null<QEvent*> e) {
+		if (e->type() == QEvent::MouseMove && ActiveHiddenChar()) {
+			const auto widget = QApplication::widgetAt(QCursor::pos());
+			if (!dynamic_cast<Ui::AbstractTooltipShower*>(widget)) {
+				Ui::Tooltip::Show(kTooltipDelay, &shower);
+			}
+		}
+		return base::EventFilterResult::Continue;
+	});
+}
