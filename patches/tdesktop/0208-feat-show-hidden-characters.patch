+[[nodiscard]] std::optional<char32_t> ParseCode(QStringView hex) {
+	auto ok = false;
+	const auto code = hex.toString().toUInt(&ok, 16);
+	if (!ok || !IsInvisibleChar(char32_t(code))) {
+		return std::nullopt;
+	}
+	return char32_t(code);
+}
+
+[[nodiscard]] QString CodeString(char32_t code) {
+	if (QChar::requiresSurrogates(code)) {
+		const QChar pair[] = {
+			QChar(QChar::highSurrogate(code)),
+			QChar(QChar::lowSurrogate(code)),
+		};
+		return QString(pair, 2);
+	}
+	return QString(QChar(char16_t(code)));
+}
