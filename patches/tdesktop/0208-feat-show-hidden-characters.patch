+void HiddenCharObject::paint(QPainter &p, const Context &context) {
+	const auto height = _font->height + 2 * _margin;
+	const auto rect = QRect(
+		context.position.x() + _margin,
+		context.position.y() + (_lineHeight - height) / 2,
+		_width - 2 * _margin,
+		height);
+	const auto radius = st::roundRadiusSmall;
+	p.save();
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(anim::with_alpha(context.textColor, kHiddenBgOpacity));
+		p.drawRoundedRect(rect, radius, radius);
+	}
+	p.setPen(anim::with_alpha(context.textColor, kHiddenFgOpacity));
+	p.setFont(_font);
+	p.drawText(rect, Qt::AlignCenter, _hex);
+	p.restore();
+}
