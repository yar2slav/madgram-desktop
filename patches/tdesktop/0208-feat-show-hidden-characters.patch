+[[nodiscard]] bool HasInvisibleText(not_null<HistoryItem*> item) {
+	if (IsInvisibleText(item->originalText().text)) {
+		return true;
+	} else if (const auto group = item->history()->owner().groups().find(
+			item)) {
+		return ranges::any_of(group->items, [](not_null<HistoryItem*> item) {
+			return IsInvisibleText(item->originalText().text);
+		});
+	}
+	return false;
+}
+
+void RefreshMessages() {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	EnumerateViews([&](not_null<HistoryView::Element*> view) {
+		const auto item = view->data();
+		if (HasInvisibleText(item)) {
+			items.emplace(item);
+		}
+	});
+	for (const auto item : items) {
+		item->history()->owner().requestItemTextRefresh(item);
+	}
+}
