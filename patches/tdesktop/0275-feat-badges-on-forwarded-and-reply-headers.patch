 constexpr auto kVerifiedBit = uint64(1);
 
+[[nodiscard]] QString CheckData() {
+	return u"tele-badge-check"_q;
+}
+
 [[nodiscard]] DocumentId VerifyIcon(not_null<PeerData*> peer) {
 	const auto details = peer->botVerifyDetails();
 	return details ? details->iconId : DocumentId();
 }
 
+[[nodiscard]] QImage CheckFrame(const QColor &color, int ratio) {
+	static auto frames = base::flat_map<std::pair<QRgb, int>, QImage>();
+	if (frames.size() > 32) {
+		frames.clear();
+	}
+	auto &frame = frames[{ color.rgba(), ratio }];
+	if (frame.isNull()) {
+		const auto scale = style::Scale() * ratio;
+		frame = st::infoVerifiedStar.instance(color, scale, true);
+		auto q = QPainter(&frame);
+		q.setCompositionMode(QPainter::CompositionMode_DestinationOut);
+		q.drawImage(
+			0,
+			0,
+			st::infoVerifiedCheck.instance(QColor(0, 0, 0), scale, true));
+	}
+	return frame;
+}
+
+class CheckObject final : public Ui::Text::CustomEmoji {
+public:
+	explicit CheckObject(style::font font);
+
+	int width() override;
+	QString entityData() override;
+	std::optional<Ui::Text::CustomEmojiVerticalMetrics> vertical(
+		const style::TextStyle &st) override;
+	Ui::Text::CustomEmojiSemantics semantics() override;
+	void paint(QPainter &p, const Context &context) override;
+	void unload() override;
+	bool ready() override;
+	bool readyInDefaultState() override;
+
+private:
+	const style::font _font;
+	const int _size = 0;
+
+};
+
+CheckObject::CheckObject(style::font font)
+: _font(font)
+, _size(std::min(font->height, st::infoVerifiedStar.height())) {
+}
+
+int CheckObject::width() {
+	return _size;
+}
+
+QString CheckObject::entityData() {
+	return CheckData();
+}
+
+std::optional<Ui::Text::CustomEmojiVerticalMetrics> CheckObject::vertical(
+		const style::TextStyle &st) {
+	return Ui::Text::CustomEmojiVerticalMetrics{
+		.ascent = _font->ascent,
+		.descent = _font->descent,
+	};
+}
+
+Ui::Text::CustomEmojiSemantics CheckObject::semantics() {
+	return {
+		.isEmoji = false,
+		.isRealCustomEmoji = false,
+		.exportEntity = false,
+		.unloadPersistentAnimation = false,
+		.allowCustomEmojiClick = false,
+	};
+}
+
+void CheckObject::paint(QPainter &p, const Context &context) {
+	const auto sharp = ShotSharpRatio();
+	const auto ratio = sharp ? sharp : style::DevicePixelRatio();
+	const auto frame = CheckFrame(context.textColor, ratio);
+	const auto top = context.position.y() + (_font->height - _size) / 2.;
+	auto hq = PainterHighQualityEnabler(p);
+	p.drawImage(
+		QRectF(context.position.x(), top, _size, _size),
+		frame);
+}
+
+void CheckObject::unload() {
+}
+
+bool CheckObject::ready() {
+	return true;
+}
+
+bool CheckObject::readyInDefaultState() {
+	return true;
+}
