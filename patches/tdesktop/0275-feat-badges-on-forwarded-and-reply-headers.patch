 }
 
+TextWithEntities BadgedHeaderName(PeerData *peer, TextWithEntities name) {
+	if (!peer || !BubbleBadges()) {
+		return name;
+	}
+	auto result = TextWithEntities();
+	if (const auto icon = VerifyIcon(peer)) {
+		result.append(Data::SingleCustomEmoji(icon)).append(' ');
+	}
+	result.append(std::move(name));
+	if (peer->isVerified()) {
+		result.append(' ').append(Ui::Text::SingleCustomEmoji(CheckData()));
+	}
+	return result;
+}
+
+Ui::Text::MarkedContext WithBadgeObjects(
+		Ui::Text::MarkedContext context,
+		const style::TextStyle &st) {
+	if (!BubbleBadges()) {
+		return context;
+	}
+	const auto font = st.font;
+	auto original = std::move(context.customEmojiFactory);
+	context.customEmojiFactory = [=](
+			QStringView data,
+			const Ui::Text::MarkedContext &context)
+	-> std::unique_ptr<Ui::Text::CustomEmoji> {
+		if (data == CheckData()) {
+			return std::make_unique<CheckObject>(font);
+		}
+		return original ? original(data, context) : nullptr;
+	};
+	return context;
+}
