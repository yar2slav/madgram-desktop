diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index ac6e3f310ccc7375f58dc9658d06d0f4bf668ee6..b03aba4f5b256d35e97e9572df1dad30c94db0e2 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -69,6 +69,7 @@ const char kOptionInlineWithoutVia[] = "tele-inline-without-via";
 const char kOptionNoRichPastePrompt[] = "tele-no-rich-paste-prompt";
 const char kOptionChatBackgrounds[] = "tele-chat-backgrounds";
 const char kOptionUsernameAliases[] = "tele-username-aliases";
+const char kOptionNoPhoneInHeader[] = "tele-no-phone-in-header";
 
 namespace {
 
@@ -485,6 +486,14 @@ base::options::option<QString> UsernameAliasesOption({
 		"Clicking one opens the linked chat, sending one mentions it.",
 });
 
+base::options::toggle NoPhoneInHeaderOption({
+	.id = kOptionNoPhoneInHeader,
+	.name = "Names instead of phone numbers in chats",
+	.description = "People who shared their number with you but aren't in "
+		"your contacts keep their name in the chat header. The number stays "
+		"in their profile.",
+});
+
 void MigrateHideCalls() {
 	if (!HideCallsOption.value()) {
 		return;
@@ -1012,4 +1021,18 @@ rpl::producer<QString> UsernameAliasesValue() {
 	});
 }
 
+bool NoPhoneInHeader() {
+	return NoPhoneInHeaderOption.value();
+}
+
+rpl::producer<bool> NoPhoneInHeaderValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		NoPhoneInHeaderOption.changes()
+	) | rpl::map([] {
+		return NoPhoneInHeaderOption.value();
+	});
+}
+
 } // namespace Tele
