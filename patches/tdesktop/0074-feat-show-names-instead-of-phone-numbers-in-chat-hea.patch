+extern const char kOptionNoPhoneInHeader[];
 
 [[nodiscard]] bool HideStories();
 [[nodiscard]] bool InvisibleStories();
@@ -167,5 +168,7 @@ void SetChatBackgrounds(const QString &value);
 [[nodiscard]] rpl::producer<QString> ChatBackgroundsValue();
 void SetUsernameAliases(const QString &value);
 [[nodiscard]] rpl::producer<QString> UsernameAliasesValue();
+[[nodiscard]] bool NoPhoneInHeader();
+[[nodiscard]] rpl::producer<bool> NoPhoneInHeaderValue();
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_phones.cpp b/Telegram/SourceFiles/tele/tele_phones.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..706ace65492bf8d9cad4274c4418994c0ce2eebd
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_phones.cpp
@@ -0,0 +1,55 @@
+#include "tele/tele_phones.h"
+
+#include "core/application.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+void Refresh(not_null<UserData*> user) {
+	const auto phone = user->nameOrPhone;
+	if (phone.isEmpty()) {
+		return;
+	}
+	const auto username = user->editableUsername();
+	user->setName(user->firstName, user->lastName, QString(), username);
+	user->setName(user->firstName, user->lastName, phone, username);
+}
+
+void Track() {
+	static auto tracked = false;
+	if (tracked) {
+		return;
+	}
+	tracked = true;
+	static auto lifetime = rpl::lifetime();
+	NoPhoneInHeaderValue(
+	) | rpl::skip(1) | rpl::on_next([] {
+		if (!Core::IsAppLaunched()) {
+			return;
+		}
+		for (const auto &[index, account] : Core::App().domain().accounts()) {
+			if (const auto session = account->maybeSession()) {
+				session->data().enumerateUsers(Refresh);
+			}
+		}
+	}, lifetime);
+}
+
+} // namespace
+
+QString TopBarNameText(not_null<PeerData*> peer) {
+	Track();
+	const auto user = peer->asUser();
+	return (user && !user->isSelf() && NoPhoneInHeader())
+		? user->name()
+		: peer->topBarNameText();
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_phones.h b/Telegram/SourceFiles/tele/tele_phones.h
new file mode 100644
index 0000000000000000000000000000000000000000..42971452c3e0bc01859a16907f799eb3906baa89
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_phones.h
@@ -0,0 +1,9 @@
+#pragma once
+
+class PeerData;
+
+namespace Tele {
+
+[[nodiscard]] QString TopBarNameText(not_null<PeerData*> peer);
+
+} // namespace Tele
