diff --git a/Telegram/SourceFiles/tele/tele_mutual_contact.cpp b/Telegram/SourceFiles/tele/tele_mutual_contact.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3b6efbabf59ac9a082610b27f39fbd3b5ee6be9c
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mutual_contact.cpp
@@ -0,0 +1,30 @@
+#include "tele/tele_mutual_contact.h"
+
+#include "data/data_peer_values.h"
+#include "data/data_user.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+rpl::producer<TextWithEntities> MutualContactTextValue(
+		not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	if (!user || user->isSelf() || user->isBot()) {
+		return rpl::single(TextWithEntities());
+	}
+	using Flag = UserDataFlag;
+	return rpl::combine(
+		MutualContactValue(),
+		Data::PeerFlagsValue(user, Flag::Contact | Flag::MutualContact)
+	) | rpl::map([](bool shown, UserDataFlags flags) {
+		if (!shown || !(flags & Flag::Contact)) {
+			return TextWithEntities();
+		}
+		return TextWithEntities::Simple((flags & Flag::MutualContact)
+			? Tr(u"Mutual"_q)
+			: Tr(u"Not mutual"_q));
+	});
+}
+
+} // namespace Tele
