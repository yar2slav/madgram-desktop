diff --git a/Telegram/SourceFiles/history/view/history_view_element.cpp b/Telegram/SourceFiles/history/view/history_view_element.cpp
index de0f79f825b2fd272a2502ac2afe4c363a4445ba..b04a62bb745089e3fb0f98a3fc08cee8da6170c8 100644
--- a/Telegram/SourceFiles/history/view/history_view_element.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_element.cpp
@@ -2776,9 +2776,34 @@ QSize Element::countCurrentSize(int newWidth) {
 	if (_flags & Flag::NeedsResize) {
 		initDimensions();
 	}
+	if (isHidden()) {
+		_flags |= Flag::LaidOutHidden;
+	} else {
+		_flags &= ~Flag::LaidOutHidden;
+	}
 	return performCountCurrentSize(newWidth);
 }
 
+void Element::refreshIfHiddenChanged() const {
+	if ((_flags & Flag::NeedsResize)
+		|| (isHidden() == ((_flags & Flag::LaidOutHidden) != 0))) {
+		return;
+	}
+	static auto Pending = base::flat_set<FullMsgId>();
+	const auto item = data();
+	const auto id = item->fullId();
+	if (!Pending.emplace(id).second) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	crl::on_main(session, [=] {
+		Pending.remove(id);
+		if (const auto item = session->data().message(id)) {
+			session->data().requestItemViewRefresh(item);
+		}
+	});
+}
