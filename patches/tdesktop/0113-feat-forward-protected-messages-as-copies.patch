+enum class Kind {
+	Text,
+	Photo,
+	Visual,
+	File,
+	Sticker,
+	ExistingSticker,
+	Voice,
+	Round,
+	Poll,
+	Contact,
+	Location,
+	Venue,
+};
+
+struct Entry {
+	FullMsgId id;
+	Kind kind = Kind::Text;
+	DocumentData *document = nullptr;
+	PhotoData *photo = nullptr;
+	std::shared_ptr<Data::DocumentMedia> documentMedia;
+	std::shared_ptr<Data::PhotoMedia> photoMedia;
+	QString path;
+	QString temp;
+	QByteArray content;
+	bool memory = false;
+	bool started = false;
+	bool failed = false;
+};
+
+struct Step {
+	MessageGroupId groupId;
+	std::vector<Entry> entries;
+};
+
+struct Job {
+	Job(not_null<Main::Session*> session, const Api::SendAction &action);
+	~Job();
+
+	not_null<Main::Session*> session;
+	Api::SendAction action;
+	std::vector<Step> steps;
+	base::flat_set<HistoryItem*> known;
+	base::flat_set<HistoryItem*> mine;
+	crl::time changed = 0;
+	int index = 0;
+	int expected = 0;
+	int failed = 0;
+	bool dropCaptions = false;
+	bool waiting = false;
+	bool processing = false;
+	bool repeat = false;
+	bool finished = false;
+	base::Timer timer;
+	rpl::lifetime lifetime;
+};
+
+void RemoveTemp(Entry &entry) {
+	if (!entry.temp.isEmpty()) {
+		QDir(QFileInfo(entry.temp).absolutePath()).removeRecursively();
+		entry.temp = QString();
+	}
+	entry.documentMedia = nullptr;
+	entry.photoMedia = nullptr;
+}
+
+Job::Job(not_null<Main::Session*> session, const Api::SendAction &action)
+: session(session)
+, action(action) {
+}
+
+Job::~Job() {
+	for (auto &step : steps) {
+		for (auto &entry : step.entries) {
+			RemoveTemp(entry);
+		}
+	}
+}
+
+[[nodiscard]] std::vector<std::unique_ptr<Job>> &Jobs() {
+	static auto result = std::vector<std::unique_ptr<Job>>();
+	return result;
+}
+
+[[nodiscard]] base::flat_set<not_null<Main::Session*>> &Tracked() {
+	static auto result = base::flat_set<not_null<Main::Session*>>();
+	return result;
+}
+
+void Remove(not_null<Job*> job) {
+	auto &jobs = Jobs();
+	const auto i = ranges::find(jobs, job.get(), &std::unique_ptr<Job>::get);
+	if (i != end(jobs)) {
+		auto taken = std::move(*i);
+		jobs.erase(i);
+	}
+}
+
+[[nodiscard]] QString CopiesFolder(not_null<Main::Session*> session) {
+	return session->local().tempDirectory() + u"tele-copies"_q;
+}
+
+void Track(not_null<Main::Session*> session) {
+	if (!Tracked().emplace(session).second) {
+		return;
+	}
+	const auto folder = CopiesFolder(session);
+	const auto clear = [=] {
+		auto &jobs = Jobs();
+		auto taken = std::vector<std::unique_ptr<Job>>();
+		for (auto i = begin(jobs); i != end(jobs);) {
+			if ((*i)->session == session) {
+				taken.push_back(std::move(*i));
+				i = jobs.erase(i);
+			} else {
+				++i;
+			}
+		}
+	};
+	session->data().sessionDataAboutToBeCleared(
+	) | rpl::on_next(clear, session->lifetime());
+	session->lifetime().add([=] {
+		Tracked().remove(session);
+		clear();
+		QDir(folder).removeRecursively();
+	});
+}
+
+void ShowToast(not_null<Job*> job, const QString &text) {
+	const auto peer = job->action.history->peer;
+	if (const auto window = job->session->tryResolveWindow(peer)) {
+		window->showToast(Lower(text));
+	}
+}
+
+[[nodiscard]] bool Protected(not_null<const HistoryItem*> item) {
+	return item->forbidsForward() || !item->history()->peer->allowsForwarding();
+}
+
+[[nodiscard]] bool Copyable(not_null<const HistoryItem*> item) {
+	if (!CopyProtected()
+		|| !Protected(item)
+		|| item->isService()
+		|| !item->isRegular()
+		|| item->isSponsored()
+		|| IsKeptDeleted(item)) {
+		return false;
+	}
+	const auto media = item->media();
+	return !media || media->allowsForward();
+}
+
+[[nodiscard]] bool HasFileMedia(const PollMedia &media) {
+	return media.photo || media.document;
+}
+
+[[nodiscard]] std::optional<Kind> Classify(
+		not_null<HistoryItem*> item,
+		QString &skipped) {
+	const auto media = item->media();
+	if (!media || media->webpage()) {
+		if (item->originalText().empty()) {
+			return std::nullopt;
+		}
+		return Kind::Text;
+	} else if (const auto invoice = media->invoice()) {
+		skipped = Data::HasExtendedMedia(*invoice)
+			? u"paid media"_q
+			: u"invoices"_q;
+		return std::nullopt;
+	} else if (media->game()) {
+		skipped = u"games"_q;
+		return std::nullopt;
+	} else if (media->storyId()) {
+		skipped = u"stories"_q;
+		return std::nullopt;
+	} else if (media->photo()) {
+		return Kind::Photo;
+	} else if (const auto document = media->document()) {
+		if (const auto sticker = document->sticker()) {
+			return sticker->isWebm() ? Kind::ExistingSticker : Kind::Sticker;
+		} else if (document->isVoiceMessage()) {
+			return Kind::Voice;
+		} else if (document->isVideoMessage()) {
+			return Kind::Round;
+		} else if (document->isVideoFile() || document->isAnimation()) {
+			return Kind::Visual;
+		}
+		return Kind::File;
+	} else if (const auto poll = media->poll()) {
+		const auto answerMedia = ranges::any_of(
+			poll->answers,
+			[](const PollAnswer &answer) {
+				return HasFileMedia(answer.media);
+			});
+		if (answerMedia
+			|| HasFileMedia(poll->attachedMedia)
+			|| HasFileMedia(poll->solutionMedia)) {
+			skipped = u"polls with media"_q;
+			return std::nullopt;
+		} else if (poll->quiz()
+			&& ranges::none_of(poll->answers, &PollAnswer::correct)) {
+			skipped = u"unanswered quizzes"_q;
+			return std::nullopt;
+		}
+		return Kind::Poll;
+	} else if (media->sharedContact()) {
+		return Kind::Contact;
+	} else if (const auto location = dynamic_cast<const Data::MediaLocation*>(
+			media)) {
+		if (location->livePeriod()) {
+			skipped = u"live locations"_q;
+			return std::nullopt;
+		}
+		return location->title().isEmpty() ? Kind::Location : Kind::Venue;
+	}
+	skipped = dynamic_cast<const Data::MediaDice*>(media)
+		? u"dice"_q
+		: media->todolist()
+		? u"checklists"_q
+		: (media->giveawayStart() || media->giveawayResults())
+		? u"giveaways"_q
+		: media->gift()
+		? u"gifts"_q
+		: u"unsupported media"_q;
+	return std::nullopt;
+}
+
+[[nodiscard]] bool Visual(Kind kind) {
+	return (kind == Kind::Photo) || (kind == Kind::Visual);
+}
+
+[[nodiscard]] bool Groupable(Kind a, Kind b) {
+	return (Visual(a) && Visual(b)) || (a == Kind::File && b == Kind::File);
+}
+
+[[nodiscard]] QString TempPath(
+		not_null<Main::Session*> session,
+		not_null<DocumentData*> document) {
+	const auto sticker = document->sticker();
+	auto name = !sticker
+		? document->filename()
+		: sticker->isLottie()
+		? u"sticker.tgs"_q
+		: u"sticker.webp"_q;
+	name.replace(QRegularExpression(u"[\\\\/:*?\"<>|]"_q), u"_"_q);
+	if (name.isEmpty() || name.startsWith('.')) {
+		const auto patterns = Core::MimeTypeForName(
+			document->mimeString()).globPatterns();
+		auto suffix = patterns.isEmpty() ? QString() : patterns.front();
+		suffix.remove('*');
+		name = u"file"_q + (suffix.startsWith('.') ? suffix : QString());
+	}
+	const auto folder = CopiesFolder(session)
+		+ '/'
+		+ QString::number(base::RandomValue<uint64>(), 16);
+	return QDir().mkpath(folder) ? (folder + '/' + name) : QString();
+}
+
+[[nodiscard]] bool Ready(not_null<Main::Session*> session, Entry &entry) {
+	if (entry.failed) {
+		return true;
+	}
+	const auto origin = Data::FileOrigin(entry.id);
+	if (const auto photo = entry.photo) {
+		if (!entry.photoMedia) {
+			entry.photoMedia = photo->createMediaView();
+			entry.photoMedia->wanted(Data::PhotoSize::Large, origin);
+		}
+		if (entry.photoMedia->image(Data::PhotoSize::Large)) {
+			return true;
+		} else if (photo->failed(Data::PhotoSize::Large)) {
+			entry.failed = true;
+			return true;
+		}
+		return false;
+	}
+	const auto document = entry.document;
+	if (!document || entry.kind == Kind::ExistingSticker) {
+		return true;
+	}
+	if (!entry.started) {
+		entry.started = true;
+		entry.documentMedia = document->createMediaView();
+		entry.path = document->filepath(true);
+		if (!entry.path.isEmpty()) {
+			return true;
+		}
+		const auto sticker = document->sticker();
+		if (document->saveToCache() && !(sticker && sticker->isLottie())) {
+			entry.memory = true;
+			if (entry.documentMedia->bytes().isEmpty()) {
+				document->save(origin, QString());
+			}
+		} else {
+			entry.temp = TempPath(session, document);
+			if (entry.temp.isEmpty()) {
+				entry.failed = true;
+				return true;
+			}
+			document->save(origin, entry.temp);
+		}
+	}
+	if (!entry.path.isEmpty() || !entry.content.isEmpty()) {
+		return true;
+	} else if (entry.memory) {
+		entry.content = entry.documentMedia->bytes();
+		if (entry.content.isEmpty() && !document->loading()) {
+			entry.failed = true;
+		}
+		return entry.failed || !entry.content.isEmpty();
+	} else if (entry.temp.isEmpty()) {
+		return true;
+	} else if (document->loading()) {
+		return false;
+	}
+	const auto info = QFileInfo(entry.temp);
+	if (info.exists() && info.size() > 0) {
+		entry.path = entry.temp;
+	} else {
+		entry.failed = true;
+	}
+	return true;
+}
+
+[[nodiscard]] TextWithTags ToTags(const TextWithEntities &text) {
+	return {
+		text.text,
+		TextUtilities::ConvertEntitiesToTextTags(text.entities),
+	};
+}
+
+[[nodiscard]] std::optional<Ui::PreparedFile> PrepareFile(
+		not_null<Job*> job,
+		const Entry &entry,
+		not_null<HistoryItem*> item) {
+	auto list = Ui::PreparedList();
+	if (entry.photo) {
+		const auto image = entry.photoMedia
+			? entry.photoMedia->image(Data::PhotoSize::Large)
+			: nullptr;
+		if (!image) {
+			return std::nullopt;
+		}
+		auto copy = image->original();
+		list = Storage::PrepareMediaFromImage(
+			std::move(copy),
+			entry.photoMedia->imageBytes(Data::PhotoSize::Large),
+			st::sendMediaPreviewSize);
+	} else if (!entry.path.isEmpty()) {
+		list = Storage::PrepareMediaList(
+			QStringList(entry.path),
+			st::sendMediaPreviewSize,
+			job->session->premium());
+	} else if (!entry.content.isEmpty()) {
+		auto file = Ui::PreparedFile(QString());
+		file.content = entry.content;
+		file.size = entry.content.size();
+		Storage::PrepareDetails(
+			file,
+			st::sendMediaPreviewSize,
+			PhotoSideLimit());
+		list.files.push_back(std::move(file));
+	}
+	if (list.error != Ui::PreparedList::Error::None
+		|| list.files.size() != 1) {
+		return std::nullopt;
+	}
+	auto result = std::move(list.files.front());
+	if (!job->dropCaptions) {
+		result.caption = ToTags(item->originalText());
+	}
+	const auto media = item->media();
+	result.spoiler = media && media->hasSpoiler();
+	if (entry.photo) {
+		result.sendLargePhotos = true;
+	} else if (!entry.document->sticker()
+		&& !entry.document->filename().isEmpty()) {
+		result.displayName = entry.document->filename();
+	}
+	return result;
+}
+
+void Snapshot(not_null<Job*> job, int expected) {
+	job->known.clear();
+	job->mine.clear();
+	for (const auto &item : job->action.history->clientSideMessages()) {
+		job->known.emplace(item.get());
+	}
+	job->expected = expected;
+	job->changed = crl::now();
+	job->waiting = !job->action.options.scheduled
+		&& !job->action.options.shortcutId;
+}
+
+[[nodiscard]] bool Sent(not_null<Job*> job) {
+	const auto &list = job->action.history->clientSideMessages();
+	for (const auto &item : list) {
+		const auto raw = item.get();
+		if (raw->isSending()
+			&& !job->known.contains(raw)
+			&& job->mine.emplace(raw).second) {
+			job->changed = crl::now();
+		}
+	}
+	if (int(job->mine.size()) < job->expected
+		&& crl::now() - job->changed < kSendTimeout) {
+		return false;
+	}
+	for (const auto &item : list) {
+		if (item->isSending() && job->mine.contains(item.get())) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void SendUploads(
+		not_null<Job*> job,
+		Step &step,
+		const std::vector<not_null<HistoryItem*>> &items) {
+	auto list = Ui::PreparedList();
+	auto visual = false;
+	for (auto i = 0, count = int(items.size()); i != count; ++i) {
+		auto &entry = step.entries[i];
+		if (entry.failed) {
+			continue;
+		}
+		auto file = PrepareFile(job, entry, items[i]);
+		if (!file) {
+			++job->failed;
+			continue;
+		}
+		visual = Visual(entry.kind);
+		list.files.push_back(std::move(*file));
+	}
+	if (list.files.empty()) {
+		return;
+	}
+	const auto count = int(list.files.size());
+	auto action = job->action;
+	action.options.invertCaption = items.front()->invertMedia();
+	const auto album = (count > 1)
+		? std::make_shared<SendingAlbum>()
+		: nullptr;
+	Snapshot(job, count);
+	job->session->api().sendFiles(
+		std::move(list),
+		visual ? SendMediaType::Photo : SendMediaType::File,
+		album,
+		action);
+}
+
+void SendVoice(
+		not_null<Job*> job,
+		const Entry &entry,
+		not_null<HistoryItem*> item) {
+	auto bytes = entry.content;
+	if (bytes.isEmpty()) {
+		auto file = QFile(entry.path);
+		if (file.open(QIODevice::ReadOnly)) {
+			bytes = file.readAll();
+		}
+	}
+	if (bytes.isEmpty()) {
+		++job->failed;
+		return;
+	}
+	const auto document = entry.document;
+	const auto voice = document->voice();
+	Snapshot(job, 1);
+	job->session->api().sendVoiceMessage(
+		std::move(bytes),
+		voice ? voice->waveform : VoiceWaveform(),
+		document->duration(),
+		(entry.kind == Kind::Round),
+		job->action);
+}
+
+void SendPoll(not_null<Job*> job, not_null<HistoryItem*> item) {
+	const auto source = item->media()->poll();
+	auto poll = PollData(&source->owner(), base::RandomValue<PollId>());
+	poll.question = source->question;
+	poll.solution = source->solution;
+	poll.answers.reserve(source->answers.size());
+	for (const auto &answer : source->answers) {
+		poll.answers.push_back(PollAnswer{
+			.text = answer.text,
+			.option = answer.option,
+			.media = answer.media,
+			.correct = answer.correct,
+		});
+	}
+	poll.attachedMedia = source->attachedMedia;
+	poll.solutionMedia = source->solutionMedia;
+	using Flag = PollData::Flag;
+	poll.setFlags(source->flags()
+		& (Flag::PublicVotes
+			| Flag::MultiChoice
+			| Flag::Quiz
+			| Flag::ShuffleAnswers
+			| Flag::RevotingDisabled
+			| Flag::OpenAnswers));
+	job->session->api().polls().create(
+		poll,
+		item->originalText(),
+		job->action,
+		[] {},
+		[](bool) {});
+}
+
+void SendSingle(
+		not_null<Job*> job,
+		Entry &entry,
+		not_null<HistoryItem*> item) {
+	auto &api = job->session->api();
+	const auto &action = job->action;
+	const auto media = item->media();
+	switch (entry.kind) {
+	case Kind::Text: {
+		auto message = Api::MessageToSend(action);
+		message.textWithTags = ToTags(item->originalText());
+		message.webPage = Data::WebPageDraft::FromItem(item);
+		api.sendMessage(std::move(message));
+	} break;
+	case Kind::ExistingSticker:
+		Api::SendExistingDocument(Api::MessageToSend(action), entry.document);
+		break;
+	case Kind::Voice:
+	case Kind::Round:
+		SendVoice(job, entry, item);
+		break;
+	case Kind::Poll:
+		SendPoll(job, item);
+		break;
+	case Kind::Contact: {
+		const auto contact = media->sharedContact();
+		api.shareContact(
+			contact->phoneNumber,
+			contact->firstName,
+			contact->lastName,
+			action);
+	} break;
+	case Kind::Location:
+	case Kind::Venue: {
+		const auto location = static_cast<const Data::MediaLocation*>(media);
+		const auto &point = location->point();
+		if (entry.kind == Kind::Location) {
+			Api::SendLocation(action, point.lat(), point.lon());
+		} else {
+			Api::SendInputMedia(action, MTP_inputMediaVenue(
+				MTP_inputGeoPoint(
+					MTP_flags(0),
+					MTP_double(point.lat()),
+					MTP_double(point.lon()),
+					MTPint()),
+				MTP_string(location->title()),
+				MTP_string(location->description()),
+				MTPstring(),
+				MTPstring(),
+				MTPstring()));
+		}
+	} break;
+	default:
+		break;
+	}
+}
+
+void Send(not_null<Job*> job, Step &step) {
+	const auto &owner = job->session->data();
+	auto items = std::vector<not_null<HistoryItem*>>();
+	auto entries = std::vector<Entry>();
+	for (auto &entry : step.entries) {
+		const auto item = owner.message(entry.id);
+		if (!item || entry.failed) {
+			job->failed += (item && entry.failed) ? 1 : 0;
+			RemoveTemp(entry);
+			continue;
+		}
+		items.push_back(item);
+		entries.push_back(std::move(entry));
+	}
+	step.entries = std::move(entries);
+	if (items.empty()) {
+		return;
+	}
+	const auto kind = step.entries.front().kind;
+	if (Visual(kind) || kind == Kind::File || kind == Kind::Sticker) {
+		SendUploads(job, step, items);
+	} else {
+		SendSingle(job, step.entries.front(), items.front());
+	}
+}
+
+void Cleanup(Step &step, bool remove) {
+	for (auto &entry : step.entries) {
+		if (!remove) {
+			entry.temp = QString();
+		}
+		entry.content = QByteArray();
+		RemoveTemp(entry);
+	}
+}
+
+void Finish(not_null<Job*> job) {
+	job->finished = true;
+	job->timer.cancel();
+	if (job->failed) {
+		ShowToast(job, (job->failed == 1)
+			? u"One protected media could not be copied."_q
+			: (QString::number(job->failed)
+				+ u" protected media could not be copied."_q));
+	}
+	crl::on_main([=] {
+		Remove(job);
+	});
+}
+
+void Advance(not_null<Job*> job) {
+	while (job->index < int(job->steps.size())) {
+		auto &step = job->steps[job->index];
+		if (job->waiting) {
+			if (!Sent(job)) {
+				return;
+			}
+			job->waiting = false;
+			Cleanup(step, int(job->mine.size()) >= job->expected);
+			++job->index;
+			continue;
+		}
+		auto ready = true;
+		for (auto i = job->index, count = int(job->steps.size())
+			; i != count
+			; ++i) {
+			for (auto &entry : job->steps[i].entries) {
+				if (!Ready(job->session, entry) && i == job->index) {
+					ready = false;
+				}
+			}
+		}
+		if (!ready) {
+			return;
+		}
+		job->expected = 0;
+		Send(job, step);
+		if (!job->waiting) {
+			Cleanup(step, !job->expected);
+			++job->index;
+		}
+	}
+	Finish(job);
+}
+
+void Process(not_null<Job*> job) {
+	if (job->finished) {
+		return;
+	} else if (job->processing) {
+		job->repeat = true;
+		return;
+	}
+	job->processing = true;
+	do {
+		job->repeat = false;
+		Advance(job);
+	} while (job->repeat && !job->finished);
+	job->processing = false;
+}
+
+} // namespace
+
+void SetupProtectedCopies(not_null<Main::Session*> session) {
+	static auto legacy = true;
+	if (base::take(legacy)) {
+		QDir(QDir::tempPath() + u"/tele-copies"_q).removeRecursively();
+	}
+	if (!Tracked().contains(session)) {
+		QDir(CopiesFolder(session)).removeRecursively();
+	}
+}
+
+bool AllowsForwarding(not_null<PeerData*> peer) {
+	return CopyProtected() || peer->allowsForwarding();
+}
+
+bool ForbidsForward(not_null<const HistoryItem*> item) {
+	return !CopyProtected() && item->forbidsForward();
+}
+
+bool ForbidsSaving(not_null<const HistoryItem*> item) {
+	if (!CopyProtected() || !item->forbidsForward()) {
+		return item->forbidsSaving();
+	}
+	const auto media = item->media();
+	if (!media) {
+		return false;
+	} else if (media->ttlSeconds()) {
+		return true;
+	}
+	const auto invoice = media->invoice();
+	return invoice && Data::HasExtendedMedia(*invoice);
+}
+
+bool AllowsForward(not_null<const HistoryItem*> item) {
+	return item->allowsForward() || Copyable(item);
+}
+
+void SendProtectedCopies(
+		Data::ResolvedForwardDraft &draft,
+		const Api::SendAction &action) {
+	if (!CopyProtected()) {
+		return;
+	}
+	auto taken = std::vector<not_null<HistoryItem*>>();
+	for (auto i = begin(draft.items); i != end(draft.items);) {
+		const auto item = *i;
+		if (!item->allowsForward() && Copyable(item)) {
+			taken.push_back(item);
+			i = draft.items.erase(i);
+		} else {
+			++i;
+		}
+	}
+	if (taken.empty()) {
+		return;
+	}
+	const auto session = &action.history->session();
+	auto owned = std::make_unique<Job>(session, action);
+	const auto job = owned.get();
+	job->action.replyTo = FullReplyTo{
+		.topicRootId = action.replyTo.topicRootId,
+		.monoforumPeerId = action.replyTo.monoforumPeerId,
+	};
+	job->action.clearDraft = false;
+	job->dropCaptions = (draft.options
+		== Data::ForwardOptions::NoNamesAndCaptions);
+	auto skipped = QStringList();
+	for (const auto item : taken) {
+		auto reason = QString();
+		const auto kind = Classify(item, reason);
+		if (!kind) {
+			if (!reason.isEmpty() && !skipped.contains(reason)) {
+				skipped.push_back(reason);
+			}
+			continue;
+		}
+		const auto media = item->media();
+		auto entry = Entry{
+			.id = item->fullId(),
+			.kind = *kind,
+			.document = media ? media->document() : nullptr,
+			.photo = (media && *kind == Kind::Photo)
+				? media->photo()
+				: nullptr,
+		};
+		const auto groupId = item->groupId();
+		auto &steps = job->steps;
+		if (groupId
+			&& !steps.empty()
+			&& steps.back().groupId == groupId
+			&& Groupable(steps.back().entries.back().kind, *kind)) {
+			steps.back().entries.push_back(std::move(entry));
+		} else {
+			steps.push_back({ .groupId = groupId });
+			steps.back().entries.push_back(std::move(entry));
+		}
+	}
+	if (!skipped.isEmpty()) {
+		ShowToast(job, u"Not copied: "_q + skipped.join(u", "_q) + '.');
+	}
+	if (job->steps.empty()) {
+		return;
+	}
+	Track(session);
+	job->timer.setCallback([=] {
+		Process(job);
+	});
+	job->timer.callEach(kCheckInterval);
+	session->downloaderTaskFinished(
+	) | rpl::on_next([=] {
+		Process(job);
+	}, job->lifetime);
+	Jobs().push_back(std::move(owned));
+	Process(job);
+	if (!job->finished && !job->waiting) {
+		ShowToast(job, u"Downloading protected media to send copies."_q);
+	}
+}
+
+} // namespace Tele
