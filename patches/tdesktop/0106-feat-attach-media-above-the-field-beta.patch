+[[nodiscard]] std::vector<DockedSegment> Segments(
+		const Tray &tray,
+		bool slowmode) {
+	auto probes = Ui::PreparedList();
+	for (auto i = 0; i != int(tray.list.files.size()); ++i) {
+		const auto &file = tray.list.files[i];
+		auto probe = Ui::PreparedFile(QString());
+		probe.id = i;
+		probe.type = file.type;
+		probe.animationJob = file.animationJob;
+		if (const auto video = LookupVideo(file)) {
+			auto info = VideoInfo();
+			info.hasAudio = video->hasAudio;
+			info.modifications.gif = video->modifications.gif;
+			probe.information = std::make_unique<Ui::PreparedFileInformation>();
+			probe.information->media = std::move(info);
+		}
+		probes.files.push_back(std::move(probe));
+	}
+	auto result = std::vector<DockedSegment>();
+	auto groups = Ui::DivideByGroups(std::move(probes), tray.way, slowmode);
+	for (const auto &group : groups) {
+		const auto &files = group.list.files;
+		if (files.empty()) {
+			continue;
+		}
+		result.push_back({
+			.from = int(files.front().id),
+			.till = int(files.back().id) + 1,
+			.album = (group.type == Ui::AlbumType::PhotoVideo)
+				&& (files.size() > 1),
+		});
+	}
+	return result;
+}
+
+[[nodiscard]] DockedContent BuildContent(
+		const Tray &tray,
+		bool slowmode) {
+	auto result = DockedContent();
+	const auto compress = tray.way.sendImagesAsPhotos();
+	auto size = int64();
+	for (auto i = 0; i != int(tray.items.size()); ++i) {
+		const auto &file = tray.list.files[i];
+		const auto &item = tray.items[i];
+		size += file.size ? file.size : int64(file.content.size());
+		result.tiles.push_back({
+			.id = item.id,
+			.type = file.type,
+			.name = (!file.displayName.isEmpty()
+				? file.displayName
+				: QFileInfo(file.path).fileName()),
+			.image = PreviewImage(file),
+			.dimensions = file.shownDimensions,
+			.spoiler = file.spoiler && CanSpoiler(file, compress),
+			.spoilerAllowed = CanSpoiler(file, compress),
+			.loading = (item.stage == Stage::Pending
+				|| item.stage == Stage::Processing),
+			.editable = (item.stage == Stage::Ready
+				&& KindOf(file, compress) != EditKind::None),
+			.caption = file.caption,
+			.ttl = compress ? file.ttlSeconds : 0,
+			.quality = ((compress && LookupVideo(file))
+				? LookupVideo(file)->modifications.quality
+				: 0),
+			.large = (compress
+				&& tray.way.sendLargePhotos()
+				&& file.information
+				&& file.canUseHighQualityPhoto()),
+		});
+	}
+	result.title = TitleText(tray.list);
+	result.price = tray.price;
+	result.size = (size > 0) ? Ui::FormatSizeText(size) : QString();
+	result.group = tray.way.groupFiles();
+	if (Prepared(tray.list)) {
+		result.groupShown = tray.list.hasGroupOption(slowmode);
+		result.asFileShown = tray.list.hasSendImagesAsPhotosOption(slowmode);
+	} else if (tray.optionsKnown) {
+		result.groupShown = tray.groupShown;
+		result.asFileShown = tray.asFileShown;
+	} else {
+		const auto media = int(ranges::count_if(
+			tray.list.files,
+			[](const Ui::PreparedFile &file) {
+				return (file.type == FileType::Photo)
+					|| (file.type == FileType::Video);
+			}));
+		result.groupShown = !slowmode && (tray.items.size() > 1);
+		result.asFileShown = (media > 0);
+	}
+	result.asFile = !compress;
+	result.collapsed = tray.collapsed;
+	result.segments = Segments(tray, slowmode);
+	result.grid = DockedGrid();
+	result.gridAvailable = ranges::any_of(
+		result.segments,
+		&DockedSegment::album);
+	return result;
+}
