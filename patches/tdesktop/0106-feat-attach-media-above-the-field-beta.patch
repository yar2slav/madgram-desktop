+
+void DockedStore::replace(
+		DockedKey key,
+		uint64 id,
+		Ui::PreparedList &&list) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0) {
+		return;
+	}
+	auto file = std::optional<Ui::PreparedFile>();
+	if (!list.files.empty()) {
+		file.emplace(std::move(list.files.front()));
+	} else if (!list.filesToProcess.empty()) {
+		file.emplace(std::move(list.filesToProcess.front()));
+	}
+	if (!file) {
+		return;
+	}
+	auto &current = tray->list.files[index];
+	file->caption = current.caption;
+	auto previous = std::move(current);
+	current = std::move(*file);
+	auto &item = tray->items[index];
+	const auto wasItem = item;
+	item.stage = current.information ? Stage::Ready : Stage::Pending;
+	if (item.stage == Stage::Ready && !validate(key, *tray, index, false)) {
+		current = std::move(previous);
+		item = wasItem;
+		return;
+	}
+	item.saved = SavedDockedFile();
+	item.coverPath = QString();
+	item.baked = item.stale = item.coverDirty = false;
+	item.importFailed = false;
+	++item.revision;
+	++item.coverRevision;
+	refreshPrepared(key, *tray);
+	importItems(key);
+	persist(key);
+	processNext(key);
+	notify(key);
+}
