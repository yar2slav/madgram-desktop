+		return EditKind::None;
+	} else if (file.type == FileType::Photo && LookupImage(file)) {
+		return EditKind::Photo;
+	} else if (file.canEditVideo()) {
+		return EditKind::Video;
+	}
+	return EditKind::None;
+}
+
+[[nodiscard]] QByteArray SerializeVideoModifications(
+		const Ui::PreparedFile &file) {
+	const auto video = LookupVideo(file);
+	if (!video) {
+		return QByteArray();
+	}
+	const auto &mods = video->modifications;
+	const auto &geometry = mods.geometry;
+	if (!mods.from
+		&& !mods.till
+		&& !mods.cover
+		&& !mods.quality
+		&& !mods.gif
+		&& !geometry.angle
+		&& !geometry.flipped
+		&& geometry.crop.isEmpty()) {
+		return QByteArray();
+	}
+	auto result = QByteArray();
+	{
+		QDataStream stream(&result, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		stream
+			<< qint64(mods.from)
+			<< qint64(mods.till)
+			<< qint64(mods.cover)
+			<< qint32(mods.quality)
+			<< qint32(mods.gif ? 1 : 0)
+			<< qint32(geometry.angle)
+			<< qint32(geometry.flipped ? 1 : 0)
+			<< geometry.crop;
+	}
+	return result;
+}
+
+void ApplySavedVideo(
+		Ui::PreparedFile &file,
+		const QByteArray &serialized,
+		int sideLimit) {
+	const auto video = LookupVideo(file);
+	if (!video || serialized.isEmpty()) {
+		return;
+	}
+	QDataStream stream(serialized);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto from = qint64();
+	auto till = qint64();
+	auto cover = qint64();
+	auto quality = qint32();
+	auto gif = qint32();
+	auto angle = qint32();
+	auto flipped = qint32();
+	auto crop = QRect();
+	stream
+		>> from
+		>> till
+		>> cover
+		>> quality
+		>> gif
+		>> angle
+		>> flipped
+		>> crop;
+	if (stream.status() != QDataStream::Ok) {
+		return;
+	}
+	auto &mods = video->modifications;
+	mods.from = from;
+	mods.till = till;
+	mods.cover = cover;
+	mods.quality = quality;
+	mods.gif = (gif != 0);
+	mods.geometry.angle = angle;
+	mods.geometry.flipped = (flipped != 0);
+	mods.geometry.crop = crop;
+	if (cover) {
+		auto frame = Media::Video::ExtractFrame(
+			file.path,
+			file.content,
+			cover,
+			video->thumbnail.size());
+		if (!frame.isNull()) {
+			video->thumbnail = std::move(frame);
+		}
+	}
+	Storage::UpdateVideoDetails(file, st::sendMediaPreviewSize, sideLimit);
+}
+
+void AttachSavedCover(
+		Ui::PreparedFile &file,
+		const QString &path,
+		int sideLimit) {
+	if (path.isEmpty() || !LookupVideo(file)) {
+		return;
+	}
+	auto cover = std::make_unique<Ui::PreparedFile>(path);
+	cover->size = QFileInfo(path).size();
+	Storage::PrepareDetails(*cover, st::sendMediaPreviewSize, sideLimit);
+	if (LookupImage(*cover)) {
+		file.videoCover = std::move(cover);
+	}
+}
