+void DockedCaptionBox(
+		not_null<Ui::GenericBox*> box,
+		Window::SessionController *controller,
+		not_null<Main::Session*> session,
+		PeerData *peer,
+		TextWithTags current,
+		Fn<void(TextWithTags)> apply) {
+	box->setTitle(tr::lng_context_upload_edit_caption());
+	const auto &st = st::defaultComposeControls;
+	const auto wrap = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		st::boxRowPadding);
+	const auto field = Ui::CreateChild<Ui::InputField>(
+		wrap,
+		st.files.caption,
+		Ui::InputField::Mode::MultiLine,
+		tr::lng_photo_caption());
+	field->setMaxLength(Data::PremiumLimits(session).captionLengthCurrent());
+	field->setSubmitSettings(Core::App().settings().sendSubmitWay());
+	Ui::ResizeFitChild(wrap, field);
+	if (controller) {
+		const auto allow = [=](not_null<DocumentData*> emoji) {
+			return peer && Data::AllowEmojiWithoutPremium(peer, emoji);
+		};
+		Ui::SetupCaptionFieldInBox(
+			box,
+			controller,
+			field,
+			peer,
+			allow,
+			PremiumFeature::EmojiStatus);
+		const auto style = InitMessageFieldHandlers({
+			.session = session,
+			.show = controller->uiShow(),
+			.field = field,
+			.customEmojiPaused = [=] {
+				return controller->isGifPausedAtLeastFor(
+					Window::GifPauseReason::Layer);
+			},
+			.allowPremiumEmoji = allow,
+			.fieldStyle = &st.files.caption,
+		});
+		box->lifetime().add([style] {});
+	}
+	field->setTextWithTags(std::move(current));
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	const auto save = [=] {
+		apply(field->getTextWithAppliedMarkdown());
+		box->closeBox();
+	};
+	field->submits() | rpl::on_next([=] {
+		save();
+	}, box->lifetime());
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
