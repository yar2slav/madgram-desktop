+void DockedStore::persist(DockedKey key) {
+	auto docked = SavedDocked();
+	if (const auto tray = lookup(key)) {
+		docked.way = tray->way.serialize();
+		docked.collapsed = tray->collapsed;
+		docked.invert = tray->invert;
+		docked.price = int64(tray->price);
+		for (auto i = 0; i != int(tray->items.size()); ++i) {
+			const auto &item = tray->items[i];
+			if (item.saved.file.stored.isEmpty() && item.saved.path.isEmpty()) {
+				continue;
+			}
+			const auto &file = tray->list.files[i];
+			auto entry = item.saved;
+			entry.file.spoiler = file.spoiler;
+			entry.file.caption = file.caption;
+			entry.file.ttl = int32(file.ttlSeconds);
+			entry.type = int32(file.type);
+			if (item.stage == Stage::Ready) {
+				entry.modifications = SerializeVideoModifications(file);
+			}
+			docked.files.push_back(std::move(entry));
+		}
+	}
+	Drafts(_session).setDocked(key, std::move(docked));
+}
+
+void DockedStore::notify(DockedKey key) {
+	if (const auto tray = lookup(key)) {
+		refreshPrepared(key, *tray);
+	}
+	const auto had = _listDrafts.contains(key);
+	if (refreshListDraft(key)) {
+		repaintListRow(key);
+		if (had && !_listDrafts.contains(key)) {
+			if (const auto thread = ResolveDraftsThread(
+					_session,
+					key.thread)) {
+				_session->api().saveDraftToCloudDelayed(thread);
+			}
+		}
+	}
+	_changes.fire_copy(key);
+}
