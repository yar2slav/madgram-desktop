+void DockedTray::resizeEvent(QResizeEvent *e) {
+	layout();
+	setScroll(_scroll);
+}
+
+void DockedTray::layout() {
+	const auto top = HandleHeight();
+	const auto header = HeaderHeight();
+	_clearRect = QRect(
+		width() - header - Padding() / 2,
+		top,
+		header,
+		header);
+	const auto pillTop = top + (header - PillHeight()) / 2;
+	const auto skip = st::sendBoxAlbumGroupEditInternalSkip;
+	auto right = _clearRect.x() - Scaled(4);
+	_asFileRect = QRect();
+	_groupRect = QRect();
+	_gridRect = QRect();
+	if (_content.asFileShown) {
+		const auto w = PillWidth(AsFileIcon(), AsFileText());
+		_asFileRect = QRect(right - w, pillTop, w, PillHeight());
+		right = _asFileRect.x() - skip;
+	}
+	if (_content.groupShown) {
+		const auto w = PillWidth(GroupIcon(), GroupText());
+		_groupRect = QRect(right - w, pillTop, w, PillHeight());
+		right = _groupRect.x() - skip;
+	}
+	if (_content.gridAvailable) {
+		const auto w = PillHeight();
+		_gridRect = QRect(right - w, pillTop, w, PillHeight());
+		right = _gridRect.x() - skip;
+	}
+	_titleRect = QRect(
+		Padding(),
+		top,
+		std::max(right - Padding(), 0),
+		header);
+}
+
+void DockedTray::layoutRow() {
+	const auto count = int(_content.tiles.size());
+	_rects.assign(count, QRect());
+	_corners.assign(count, RectPart::AllCorners);
+	_rowHeight = ThumbSide();
+	_cap = grid() ? gridCap() : 0;
+	auto x = Padding();
+	const auto single = [&](int index) {
+		_rects[index] = QRect(x, 0, ThumbSide(), ThumbSide());
+		x += step();
+	};
+	if (!grid()) {
+		for (auto i = 0; i != count; ++i) {
+			single(i);
+		}
+	} else {
+		for (const auto &segment : _content.segments) {
+			const auto from = std::clamp(segment.from, 0, count);
+			const auto till = std::clamp(segment.till, from, count);
+			if (!segment.album || till - from < 2) {
+				for (auto i = from; i != till; ++i) {
+					single(i);
+				}
+				continue;
+			}
+			auto sizes = std::vector<QSize>();
+			for (auto i = from; i != till; ++i) {
+				sizes.push_back(TileDimensions(_content.tiles[i]));
+			}
+			const auto layout = Ui::LayoutMediaGroup(
+				sizes,
+				st::sendMediaPreviewSize,
+				st::historyGroupWidthMin / 2,
+				st::historyGroupSkip / 2);
+			auto full = QRect();
+			for (const auto &item : layout) {
+				full = full.united(item.geometry);
+			}
+			if (full.isEmpty() || int(layout.size()) != till - from) {
+				for (auto i = from; i != till; ++i) {
+					single(i);
+				}
+				continue;
+			}
+			const auto factor = std::min(1., _cap / double(full.height()));
+			const auto scale = [&](int value) {
+				return int(base::SafeRound(value * factor));
+			};
+			for (auto i = from; i != till; ++i) {
+				const auto &item = layout[i - from];
+				const auto &geometry = item.geometry;
+				const auto left = scale(geometry.x());
+				const auto top = scale(geometry.y());
+				_rects[i] = QRect(
+					x + left,
+					top,
+					scale(geometry.x() + geometry.width()) - left,
+					scale(geometry.y() + geometry.height()) - top);
+				_corners[i] = Ui::GetCornersFromSides(item.sides);
+			}
+			_rowHeight = std::max(_rowHeight, scale(full.height()));
+			x += scale(full.width()) + Gap();
+		}
+	}
+	_add = QRect(x, 0, ThumbSide(), ThumbSide());
+	_contentWidth = x + ThumbSide() + Padding();
+}
+
+int DockedTray::rowTop() const {
+	return HandleHeight() + HeaderHeight() + RowSkip();
+}
+
+int DockedTray::step() const {
+	return ThumbSide() + Gap();
+}
+
+QRect DockedTray::tileRect(int index) const {
+	return (index >= 0 && index < int(_rects.size()))
+		? _rects[index].translated(-_scroll, rowTop())
+		: QRect();
+}
+
+QRect DockedTray::stripRect(int slot) const {
+	return QRect(
+		Padding() + slot * step() - _scroll,
+		rowTop(),
+		ThumbSide(),
+		ThumbSide());
+}
+
+QRect DockedTray::addRect() const {
+	return _add.translated(-_scroll, rowTop());
+}
+
+bool DockedTray::hasControls(QRect tile) const {
+	const auto min = Scaled(56);
+	return (tile.width() >= min) && (tile.height() >= min);
+}
+
+QRect DockedTray::removeRect(QRect tile) const {
+	const auto size = Scaled(20);
+	const auto skip = Scaled(4);
+	return QRect(
+		tile.x() + tile.width() - skip - size,
+		tile.y() + skip,
+		size,
+		size);
+}
+
+QRect DockedTray::spoilerRect(QRect tile) const {
+	const auto size = Scaled(24);
+	const auto skip = Scaled(4);
+	return QRect(
+		tile.x() + skip,
+		tile.y() + tile.height() - skip - size,
+		size,
+		size);
+}
+
+QRect DockedTray::moreRect(QRect tile) const {
+	const auto size = Scaled(24);
+	const auto skip = Scaled(4);
+	return QRect(
+		tile.x() + tile.width() - skip - size,
+		tile.y() + tile.height() - skip - size,
+		size,
+		size);
+}
+
+QRect DockedTray::captionRect(QRect tile) const {
+	const auto size = Scaled(24);
+	const auto skip = Scaled(4);
+	return QRect(tile.x() + skip, tile.y() + skip, size, size);
+}
+
+int DockedTray::maxScroll() const {
+	return std::max(_contentWidth - width(), 0);
+}
+
+void DockedTray::setScroll(int value) {
+	const auto clamped = std::clamp(value, 0, maxScroll());
+	if (_scroll != clamped) {
+		_scroll = clamped;
+		update();
+	}
+}
+
+int DockedTray::dragIndex() const {
+	if (!_dragId) {
+		return -1;
+	}
+	const auto i = ranges::find(_content.tiles, _dragId, &DockedTile::id);
+	return (i != end(_content.tiles)) ? int(i - begin(_content.tiles)) : -1;
+}
+
+int DockedTray::dragTarget() const {
+	const auto count = int(_content.tiles.size());
+	if (count < 1) {
+		return 0;
+	} else if (grid()) {
+		for (auto i = 0; i != count; ++i) {
+			if (tileRect(i).contains(_dragPoint)) {
+				return i;
+			}
+		}
+		return dragIndex();
+	}
+	const auto left = _dragPoint.x() - _dragOffset.x();
+	const auto position = left + _scroll - Padding() + step() / 2;
+	const auto slot = (position < 0) ? 0 : (position / step());
+	return std::clamp(slot, 0, count - 1);
+}
+
+QRect DockedTray::dragRect(int index) const {
+	auto result = tileRect(index);
+	result.moveTopLeft(_dragPoint - _dragOffset);
+	if (!grid()) {
+		result.moveTop(rowTop());
+	}
+	return result;
+}
+
+DockedTray::Hit DockedTray::hitTest(QPoint point) const {
+	if (point.y() < HandleHeight() || _titleRect.contains(point)) {
+		return { Part::Handle };
+	} else if (_gridRect.contains(point)) {
+		return { Part::Grid };
+	} else if (_groupRect.contains(point)) {
+		return { Part::Group };
+	} else if (_asFileRect.contains(point)) {
+		return { Part::AsFile };
+	} else if (_clearRect.contains(point)) {
+		return { Part::Clear };
+	} else if (_content.collapsed) {
+		return {};
+	}
+	const auto count = int(_content.tiles.size());
+	for (auto i = 0; i != count; ++i) {
+		const auto rect = tileRect(i);
+		if (!rect.contains(point)) {
+			continue;
+		} else if (removeRect(rect).contains(point)) {
+			return { Part::Remove, i };
+		} else if (!hasControls(rect)) {
+			return { Part::Tile, i };
+		} else if (!_content.tiles[i].caption.text.isEmpty()
+			&& captionRect(rect).contains(point)) {
+			return { Part::Caption, i };
+		} else if (_content.tiles[i].spoilerAllowed
+			&& spoilerRect(rect).contains(point)) {
+			return { Part::Spoiler, i };
+		} else if (!_content.tiles[i].loading
+			&& moreRect(rect).contains(point)) {
+			return { Part::More, i };
+		}
+		return { Part::Tile, i };
+	}
+	if (addRect().contains(point)) {
+		return { Part::Add };
+	}
+	return {};
+}
+
+void DockedTray::updateHover(QPoint point) {
+	const auto hit = hitTest(point);
+	if (_over != hit) {
+		const auto tips = [](Part part) {
+			return (part == Part::Grid) || (part == Part::Caption);
+		};
+		const auto wasTip = tips(_over.part);
+		_over = hit;
+		setCursor((hit.part == Part::None)
+			? style::cur_default
+			: style::cur_pointer);
+		if (tips(hit.part)) {
+			Ui::Tooltip::Show(1000, this);
+		} else if (wasTip) {
+			Ui::Tooltip::Hide();
+		}
+		update();
+	}
+}
+
+void DockedTray::mouseMoveEvent(QMouseEvent *e) {
+	const auto point = e->pos();
+	if (!_dragId
+		&& _pressed.part == Part::Tile
+		&& _pressed.index < int(_content.tiles.size())
+		&& ((point - _pressPoint).manhattanLength()
+			>= QApplication::startDragDistance())) {
+		_dragId = _content.tiles[_pressed.index].id;
+	}
+	if (_dragId) {
+		_dragPoint = point;
+		if (point.x() < Padding()) {
+			setScroll(_scroll - Scaled(8));
+		} else if (point.x() > width() - Padding()) {
+			setScroll(_scroll + Scaled(8));
+		}
+		update();
+		return;
+	}
+	updateHover(point);
+}
+
+void DockedTray::mousePressEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	_pressPoint = e->pos();
+	_pressed = hitTest(_pressPoint);
+	if (_pressed.part == Part::Tile) {
+		const auto rect = tileRect(_pressed.index);
+		_dragOffset = _pressPoint - rect.topLeft();
+		_dragPoint = _pressPoint;
+	}
+}
+
+void DockedTray::mouseReleaseEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	const auto pressed = base::take(_pressed);
+	if (_dragId) {
+		const auto from = dragIndex();
+		const auto to = dragTarget();
+		_dragId = 0;
+		update();
+		updateHover(e->pos());
+		if (from >= 0 && to >= 0 && from != to && _callbacks.move) {
+			_callbacks.move(from, to);
+		}
+		return;
+	}
+	const auto hit = hitTest(e->pos());
+	if (hit != pressed) {
+		return;
+	}
+	const auto id = (hit.index >= 0 && hit.index < int(_content.tiles.size()))
+		? _content.tiles[hit.index].id
+		: uint64();
+	switch (hit.part) {
+	case Part::Handle: _callbacks.collapse(); break;
+	case Part::Grid: _callbacks.grid(); break;
+	case Part::Group: _callbacks.group(); break;
+	case Part::AsFile: _callbacks.asFile(); break;
+	case Part::Clear: _callbacks.clear(); break;
+	case Part::Remove: _callbacks.remove(id); break;
+	case Part::Spoiler: _callbacks.spoiler(id); break;
+	case Part::Add: _callbacks.add(); break;
+	case Part::More: _callbacks.menu(id, QCursor::pos()); break;
+	case Part::Caption: _callbacks.caption(id); break;
+	case Part::Tile:
+		if (_content.tiles[hit.index].editable) {
+			_callbacks.edit(id);
+		}
+		break;
+	case Part::None: break;
+	}
+}
+
+void DockedTray::contextMenuEvent(QContextMenuEvent *e) {
+	const auto hit = hitTest(e->pos());
+	if (_dragId
+		|| hit.index < 0
+		|| hit.index >= int(_content.tiles.size())) {
+		return;
+	}
+	_pressed = Hit();
+	_callbacks.menu(_content.tiles[hit.index].id, e->globalPos());
+	e->accept();
+}
+
+void DockedTray::wheelEvent(QWheelEvent *e) {
+	if (_content.collapsed || !maxScroll()) {
+		e->ignore();
+		return;
+	}
+	const auto delta = e->angleDelta();
+	const auto value = (std::abs(delta.x()) > std::abs(delta.y()))
+		? delta.x()
+		: delta.y();
+	setScroll(_scroll - (value * step()) / 120);
+	e->accept();
+}
+
+void DockedTray::leaveEventHook(QEvent *e) {
+	if (_over.part == Part::Grid || _over.part == Part::Caption) {
+		Ui::Tooltip::Hide();
+	}
+	if (!_dragId && _over != Hit()) {
+		_over = Hit();
+		update();
+	}
+}
+
+const QImage &DockedTray::prepared(const DockedTile &tile, QSize size) {
+	auto &cached = _cache[tile.id];
+	const auto key = tile.image.cacheKey();
+	if (cached.key != key || cached.size != size || cached.normal.isNull()) {
+		const auto ratio = style::DevicePixelRatio();
+		const auto target = size * ratio;
+		auto scaled = tile.image.scaled(
+			target,
+			Qt::KeepAspectRatioByExpanding,
+			Qt::SmoothTransformation);
+		scaled = scaled.copy(
+			(scaled.width() - target.width()) / 2,
+			(scaled.height() - target.height()) / 2,
+			target.width(),
+			target.height()
+		).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+		scaled.setDevicePixelRatio(ratio);
+		cached = Cached{
+			.key = key,
+			.size = size,
+			.normal = std::move(scaled),
+		};
+	}
+	return cached.normal;
+}
+
+const QPixmap &DockedTray::blurred(const DockedTile &tile, QSize size) {
+	const auto &normal = prepared(tile, size);
+	auto &cached = _cache[tile.id];
+	if (cached.blurred.isNull()) {
+		cached.blurred = Ui::BlurredPreviewFromPixmap(
+			Ui::PixmapFromImage(QImage(normal)),
+			RectPart::None);
+	}
+	return cached.blurred;
+}
+
+void DockedTray::paintSpoiler(Painter &p, QRect rect) {
+	if (!_spoiler) {
+		return;
+	}
+	const auto paused = On(PowerSaving::kChatSpoiler)
+		|| !window()->isActiveWindow();
+	Ui::FillSpoilerRect(
+		p,
+		rect,
+		Ui::DefaultImageSpoiler().frame(
+			_spoiler->index(crl::now(), paused)));
+}
+
+void DockedTray::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.fillRect(e->rect(), st::historyReplyBg);
+	p.fillRect(0, 0, width(), st::lineWidth, st::shadowFg);
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		const auto w = Scaled(32);
+		const auto h = Scaled(4);
+		p.setPen(Qt::NoPen);
+		p.setBrush((_over.part == Part::Handle)
+			? st::historyComposeIconFgOver
+			: st::historyComposeIconFg);
+		p.setOpacity(0.5);
+		p.drawRoundedRect(
+			QRect((width() - w) / 2, Scaled(6), w, h),
+			h / 2.,
+			h / 2.);
+		p.setOpacity(1.);
+	}
+	paintHeader(p);
+	if (_content.collapsed) {
+		return;
+	}
+	p.setClipRect(0, rowTop(), width(), _rowHeight + RowSkip());
+	const auto count = int(_content.tiles.size());
+	const auto dragging = dragIndex();
+	const auto target = (dragging >= 0) ? dragTarget() : -1;
+	for (auto i = 0; i != count; ++i) {
+		if (i == dragging) {
+			continue;
+		}
+		auto rect = tileRect(i);
+		if (dragging >= 0 && !grid()) {
+			auto slot = i;
+			if (dragging < target && i > dragging && i <= target) {
+				--slot;
+			} else if (dragging > target && i >= target && i < dragging) {
+				++slot;
+			}
+			rect = stripRect(slot);
+		}
+		paintTile(p, _content.tiles[i], i, rect, _corners[i]);
+		if (dragging >= 0 && grid() && i == target) {
+			auto hq = PainterHighQualityEnabler(p);
+			auto pen = st::activeButtonBg->p;
+			pen.setWidthF(Scaled(2));
+			p.setPen(pen);
+			p.setBrush(Qt::NoBrush);
+			p.drawPath(TilePath(
+				rect.marginsRemoved({ 1, 1, 1, 1 }),
+				_corners[i]));
+		}
+	}
+	paintAdd(p, addRect());
+	if (dragging >= 0) {
+		p.setOpacity(0.85);
+		paintTile(
+			p,
+			_content.tiles[dragging],
+			dragging,
+			dragRect(dragging),
+			RectPart::AllCorners);
+		p.setOpacity(1.);
+	}
+}
+
+void DockedTray::paintHeader(Painter &p) {
+	const auto &font = st::semiboldFont;
+	const auto &sub = st::normalFont;
+	const auto top = _titleRect.y() + (_titleRect.height() - font->height) / 2;
+	const auto available = _titleRect.width();
+	const auto title = font->elided(_content.title, available);
+	p.setPen(st::windowFg);
+	p.setFont(font);
+	p.drawTextLeft(_titleRect.x(), top, width(), title);
+	auto used = font->width(title);
+	auto parts = QStringList();
+	if (!_content.size.isEmpty()) {
+		parts.push_back(_content.size);
+	}
+	if (_content.price > 0) {
+		parts.push_back(Lower(u"%1 stars"_q).arg(_content.price));
+	}
+	const auto size = parts.isEmpty()
+		? QString()
+		: (u" \u00B7 "_q + parts.join(u" \u00B7 "_q));
+	if (!size.isEmpty() && used + sub->width(size) <= available) {
+		p.setPen(st::windowSubTextFg);
+		p.setFont(sub);
+		p.drawTextLeft(
+			_titleRect.x() + used,
+			top + font->ascent - sub->ascent,
+			width(),
+			size);
+		used += sub->width(size);
+	}
+	if (_content.overflow > 0) {
+		const auto over = u" \u2212"_q + QString::number(_content.overflow);
+		if (used + sub->width(over) <= available) {
+			p.setPen(st::boxTextFgError);
+			p.setFont(sub);
+			p.drawTextLeft(
+				_titleRect.x() + used,
+				top + font->ascent - sub->ascent,
+				width(),
+				over);
+		}
+	}
+	if (!_gridRect.isEmpty()) {
+		paintGridToggle(p);
+	}
+	if (!_groupRect.isEmpty()) {
+		paintPill(
+			p,
+			_groupRect,
+			GroupIcon(),
+			GroupText(),
+			_content.group,
+			_over.part == Part::Group);
+	}
+	if (!_asFileRect.isEmpty()) {
+		paintPill(
+			p,
+			_asFileRect,
+			AsFileIcon(),
+			AsFileText(),
+			_content.asFile,
+			_over.part == Part::AsFile);
+	}
+	const auto &cancel = st::historyReplyCancel;
+	const auto &icon = (_over.part == Part::Clear)
+		? cancel.iconOver
+		: cancel.icon;
+	icon.paint(
+		p,
+		_clearRect.x() + (_clearRect.width() - icon.width()) / 2,
+		_clearRect.y() + (_clearRect.height() - icon.height()) / 2,
+		width());
+}
+
+void DockedTray::paintGridToggle(Painter &p) {
+	const auto hovered = (_over.part == Part::Grid);
+	if (hovered) {
+		auto hq = PainterHighQualityEnabler(p);
+		const auto radius = _gridRect.height() / 2.;
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(_gridRect, radius, radius);
+	}
+	const auto &icon = grid()
+		? st::ivEditorMediaToSlideshowIcon
+		: st::ivEditorMediaToCollageIcon;
+	icon.paintInCenter(
+		p,
+		_gridRect,
+		(hovered ? st::windowFg : st::windowSubTextFg)->c);
+}
+
+void DockedTray::paintPill(
+		Painter &p,
+		QRect rect,
+		const style::IconEmoji &icon,
+		const QString &text,
+		bool active,
+		bool hovered) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto radius = rect.height() / 2.;
+	if (active) {
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::lightButtonBgOver);
+	} else {
+		auto pen = st::windowSubTextFg->p;
+		pen.setWidthF(st::lineWidth);
+		p.setPen(pen);
+		p.setBrush(hovered ? st::windowBgOver : st::historyReplyBg);
+	}
+	const auto half = st::lineWidth / 2.;
+	p.drawRoundedRect(
+		QRectF(rect).marginsRemoved({ half, half, half, half }),
+		radius,
+		radius);
+	const auto fg = active ? st::lightButtonFg : st::windowFg;
+	const auto iconLeft = rect.x() + PillPaddingLeft();
+	icon.icon.paint(
+		p,
+		iconLeft,
+		rect.y() + (rect.height() - icon.icon.height()) / 2,
+		width(),
+		fg->c);
+	p.setPen(fg);
+	p.setFont(st::normalFont);
+	p.drawTextLeft(
+		iconLeft + icon.icon.width() + PillIconSkip(),
+		rect.y() + (rect.height() - st::normalFont->height) / 2,
+		width(),
+		text);
+}
+
+void DockedTray::paintTile(
+		Painter &p,
+		const DockedTile &tile,
+		int index,
+		QRect rect,
+		RectParts corners) {
+	auto hq = PainterHighQualityEnabler(p);
+	p.save();
+	p.setClipPath(TilePath(rect, corners), Qt::IntersectClip);
+	if (!tile.image.isNull() && tile.spoiler) {
+		p.drawPixmap(rect, blurred(tile, rect.size()));
+	} else if (!tile.image.isNull()) {
+		p.drawImage(rect, prepared(tile, rect.size()));
+	} else {
+		p.fillRect(rect, st::windowBgOver);
+		const auto extension = QFileInfo(tile.name).suffix().toUpper();
+		const auto skip = Scaled(6);
+		const auto inner = rect.marginsRemoved({ skip, skip, skip, skip });
+		p.setPen(st::windowSubTextFg);
+		p.setFont(st::semiboldFont);
+		p.drawText(
+			inner,
+			st::semiboldFont->elided(
+				extension.isEmpty() ? Lower(u"File"_q) : extension,
+				inner.width()),
+			style::al_center);
+		p.setFont(st::normalFont);
+		p.drawText(
+			inner,
+			st::normalFont->elided(tile.name, inner.width()),
+			style::al_bottom);
+	}
+	if (tile.spoiler) {
+		paintSpoiler(p, rect);
+	}
+	if (tile.loading) {
+		p.fillRect(rect, st::msgDateImgBg);
+	} else if (hasControls(rect)) {
+		if (tile.large && tile.caption.text.isEmpty()) {
+			Ui::PaintHighQualityBadge(
+				p,
+				st::defaultComposeControls,
+				rect,
+				RectPart::TopLeft);
+		}
+		if (tile.ttl) {
+			Ui::PaintMediaTtlBadge(p, rect, tile.ttl);
+		}
+		if (tile.quality) {
+			Ui::PaintVideoQualityBadge(p, rect, tile.quality);
+		}
+	}
+	p.restore();
+
+	const auto overTile = (_over.index == index) && !_dragId;
+	const auto remove = removeRect(rect);
+	p.setPen(Qt::NoPen);
+	p.setBrush((overTile && _over.part == Part::Remove)
+		? st::msgDateImgBgOver
+		: st::msgDateImgBg);
+	p.drawEllipse(remove);
+	auto pen = st::msgDateImgFg->p;
+	pen.setWidthF(Scaled(2) * 0.75);
+	pen.setCapStyle(Qt::RoundCap);
+	p.setPen(pen);
+	const auto cross = remove.width() / 4.;
+	const auto center = QRectF(remove).center();
+	p.drawLine(
+		center + QPointF(-cross, -cross),
+		center + QPointF(cross, cross));
+	p.drawLine(
+		center + QPointF(cross, -cross),
+		center + QPointF(-cross, cross));
+
+	if (!hasControls(rect)) {
+		return;
+	}
+	if (!tile.caption.text.isEmpty()) {
+		const auto badge = captionRect(rect);
+		p.setPen(Qt::NoPen);
+		p.setBrush((overTile && _over.part == Part::Caption)
+			? st::msgDateImgBgOver
+			: st::msgDateImgBg);
+		p.drawEllipse(badge);
+		st::menuIconCaptionShow.paintInCenter(
+			p,
+			badge,
+			st::msgDateImgFg->c);
+	}
+	if (overTile && !tile.loading) {
+		const auto more = moreRect(rect);
+		p.setPen(Qt::NoPen);
+		p.setBrush((_over.part == Part::More)
+			? st::msgDateImgBgOver
+			: st::msgDateImgBg);
+		p.drawEllipse(more);
+		st::sendBoxAlbumButtonMediaMore.paintInCenter(p, more);
+	}
+
+	if (tile.spoilerAllowed) {
+		const auto spoiler = spoilerRect(rect);
+		const auto over = overTile && (_over.part == Part::Spoiler);
+		p.setPen(Qt::NoPen);
+		p.setBrush(tile.spoiler
+			? st::activeButtonBg
+			: over
+			? st::msgDateImgBgOver
+			: st::msgDateImgBg);
+		p.drawEllipse(spoiler);
+		const auto &icon = st::menuIconSpoiler;
+		icon.paint(
+			p,
+			spoiler.x() + (spoiler.width() - icon.width()) / 2,
+			spoiler.y() + (spoiler.height() - icon.height()) / 2,
+			width(),
+			(tile.spoiler ? st::activeButtonFg : st::msgDateImgFg)->c);
+	}
+}
+
+void DockedTray::paintAdd(Painter &p, QRect rect) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto over = (_over.part == Part::Add);
+	auto pen = st::windowSubTextFg->p;
+	pen.setWidthF(st::lineWidth);
+	pen.setStyle(Qt::DashLine);
+	p.setPen(pen);
+	p.setBrush(over ? st::windowBgOver : st::historyReplyBg);
+	const auto half = st::lineWidth / 2.;
+	p.drawRoundedRect(
+		QRectF(rect).marginsRemoved({ half, half, half, half }),
+		st::roundRadiusLarge,
+		st::roundRadiusLarge);
+	auto plus = st::windowSubTextFg->p;
+	plus.setWidthF(Scaled(2) * 0.75);
+	plus.setCapStyle(Qt::RoundCap);
+	p.setPen(plus);
+	const auto size = Scaled(7);
+	const auto center = QPointF(
+		rect.x() + rect.width() / 2.,
+		rect.y() + rect.height() / 2. - Scaled(8));
+	p.drawLine(center - QPointF(size, 0), center + QPointF(size, 0));
+	p.drawLine(center - QPointF(0, size), center + QPointF(0, size));
+	p.setPen(st::windowSubTextFg);
+	p.setFont(st::normalFont);
+	p.drawText(
+		QRect(
+			rect.x(),
+			int(center.y()) + size + Scaled(4),
+			rect.width(),
+			st::normalFont->height),
+		Lower(u"Add"_q),
+		style::al_top);
+}
