+std::unique_ptr<Ui::PreparedFile> DockedStore::copy(
+		DockedKey key,
+		uint64 id) const {
+	const auto file = this->file(key, id);
+	return file ? std::make_unique<Ui::PreparedFile>(Clone(*file)) : nullptr;
+}
+
+void DockedStore::applyEdited(
+		DockedKey key,
+		uint64 id,
+		Ui::PreparedFile &&file,
+		bool photo) {
+	const auto index = readyIndex(key, id);
+	if (index < 0) {
+		return;
+	}
+	const auto tray = lookup(key);
+	auto &current = tray->list.files[index];
+	file.spoiler = current.spoiler;
+	file.caption = current.caption;
+	file.ttlSeconds = current.ttlSeconds;
+	auto previous = std::move(current);
+	current = std::move(file);
+	if (!validate(key, *tray, index, false)) {
+		current = std::move(previous);
+		return;
+	}
+	auto &item = tray->items[index];
+	if (photo) {
+		item.stale = true;
+		item.baked = true;
+		item.importFailed = false;
+		++item.revision;
+	} else if (const auto preview = PreviewImage(current)
+		; !preview.isNull()) {
+		item.saved.file.thumbnail = DraftThumbnail(preview);
+	}
+	refreshPrepared(key, *tray);
+	importItems(key);
+	persist(key);
+	notify(key);
+}
