+	result.displayName = saved.file.name;
+	result.size = saved.file.size;
+	result.type = TypeFromInt(saved.type);
+	result.spoiler = saved.file.spoiler;
+	result.caption = saved.file.caption;
+	result.ttlSeconds = saved.file.ttl;
+	if (!saved.file.thumbnail.isEmpty()) {
+		result.preview = QImage::fromData(saved.file.thumbnail);
+	}
+	return result;
+}
