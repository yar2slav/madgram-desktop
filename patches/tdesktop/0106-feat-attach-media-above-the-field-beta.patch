+void ComposeDocked::changePrice() {
+	const auto key = currentKey();
+	const auto session = _session;
+	const auto now = Docked(session).price(key);
+	const auto limit = session->appConfig().get<int>(
+		u"stars_paid_post_amount_max"_q,
+		10'000);
+	_show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(tr::lng_paid_title());
+		const auto wrap = box->addRow(object_ptr<Ui::FixedHeightWidget>(
+			box,
+			st::editTagField.heightMin));
+		const auto field = Ui::CreateChild<Ui::NumberInput>(
+			wrap,
+			st::editTagField,
+			tr::lng_paid_cost_placeholder(),
+			now ? QString::number(now) : QString(),
+			limit);
+		wrap->widthValue() | rpl::on_next([=](int width) {
+			field->move(0, 0);
+			field->resize(width, field->height());
+			wrap->resize(width, field->height());
+		}, wrap->lifetime());
+		field->paintRequest() | rpl::on_next([=] {
+			auto p = QPainter(field);
+			st::paidStarIcon.paint(p, 0, st::paidStarIconTop, field->width());
+		}, field->lifetime());
+		field->selectAll();
+		box->setFocusCallback([=] {
+			field->setFocusFast();
+		});
+		box->addRow(
+			object_ptr<Ui::FlatLabel>(
+				box,
+				tr::lng_paid_about(
+					lt_link,
+					tr::lng_paid_about_link(tr::link),
+					tr::marked),
+				st::paidAmountAbout),
+			st::boxRowPadding + QMargins(0, st::sendMediaRowSkip, 0, 0));
+		const auto save = [=] {
+			const auto value = field->getLastText().toULongLong();
+			if (value > uint64(limit)) {
+				field->showError();
+				return;
+			}
+			Docked(session).setPrice(key, value);
+			box->closeBox();
+		};
+		QObject::connect(field, &Ui::NumberInput::submitted, box, save);
+		box->addButton(tr::lng_settings_save(), save);
+		box->addButton(tr::lng_cancel(), [=] {
+			box->closeBox();
+		});
+	}));
+}
+
+void ComposeDocked::fillMenuDetails(SendMenu::Details &details) const {
+	if (!shown()) {
+		return;
+	}
+	using namespace SendMenu;
+	const auto key = currentKey();
+	const auto &store = Docked(_session);
+	if (store.hasTtl(key)
+		&& (details.type == Type::Scheduled
+			|| details.type == Type::ScheduledToUser)) {
+		details.type = Type::SilentOnly;
+	}
+	details.spoiler = !store.hasSpoilerMenu(key)
+		? SpoilerState::None
+		: store.allSpoilers(key)
+		? SpoilerState::Enabled
+		: SpoilerState::Possible;
+	details.caption = !(store.canMoveCaption(key)
+			&& !_field->getLastText().trimmed().isEmpty())
+		? CaptionState::None
+		: store.invert(key)
+		? CaptionState::Above
+		: CaptionState::Below;
+	details.photoQuality = !store.hasLargePhotosOption(key)
+		? PhotoQualityState::None
+		: store.largePhotos(key)
+		? PhotoQualityState::High
+		: PhotoQualityState::Standard;
+	details.price = store.canChangePrice(key)
+		? std::make_optional(store.price(key))
+		: std::nullopt;
+}
+
+bool ComposeDocked::menuAction(const SendMenu::Action &action) {
+	if (!shown()) {
+		return false;
+	}
+	using Type = SendMenu::ActionType;
+	const auto key = currentKey();
+	auto &store = Docked(_session);
+	switch (action.type) {
+	case Type::SpoilerOn: store.setAllSpoilers(key, true); return true;
+	case Type::SpoilerOff: store.setAllSpoilers(key, false); return true;
+	case Type::CaptionUp: store.setInvert(key, true); return true;
+	case Type::CaptionDown: store.setInvert(key, false); return true;
+	case Type::PhotoQualityOn: store.setLargePhotos(key, true); return true;
+	case Type::PhotoQualityOff: store.setLargePhotos(key, false); return true;
+	case Type::ChangePrice:
+		if (store.canChangePrice(key)) {
+			changePrice();
+			return true;
+		}
+		return false;
+	default: return false;
+	}
+}
+
+void ComposeDocked::editCaption(uint64 id) {
+	const auto key = currentKey();
+	if (Docked(_session).firstId(key) == id) {
+		_field->setFocus();
+		return;
+	}
+	const auto current = Docked(_session).caption(key, id);
+	if (!current) {
+		return;
+	}
+	const auto session = _session;
+	const auto peer = session->data().peerLoaded(key.thread.peer);
+	const auto window = _show->resolveWindow();
+	const auto text = *current;
+	_show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		DockedCaptionBox(box, window, session, peer, text, [=](
+				TextWithTags caption) {
+			Docked(session).setCaption(key, id, std::move(caption));
+		});
+	}));
+}
+
+bool ComposeDocked::add(Ui::PreparedList &list) {
+	if (!DockedAttachments()
+		|| _editing()
+		|| _field->isHidden()
+		|| list.error != Ui::PreparedList::Error::None
+		|| (list.files.empty() && list.filesToProcess.empty())) {
+		return false;
+	}
+	const auto key = currentKey();
+	if (!key) {
+		return false;
+	}
+	Docked(_session).add(key, _show, std::move(list));
+	return true;
+}
+
+bool ComposeDocked::send(Api::SendOptions options) {
+	if (!shown() || !_send) {
+		return false;
+	}
+	const auto key = currentKey();
+	auto &store = Docked(_session);
+	if (!store.ready(key)) {
+		store.whenReady(key, crl::guard(_tray.get(), [=] {
+			if (currentKey() == key) {
+				send(options);
+			}
+		}));
+		return true;
+	}
+	if (_scheduled && !options.scheduled) {
+		const auto details = _sendMenuDetails
+			? _sendMenuDetails()
+			: SendMenu::Details();
+		const auto callback = crl::guard(_tray.get(), [=](
+				Api::SendOptions options) {
+			if (currentKey() == key) {
+				send(options);
+			}
+		});
+		_show->showBox(HistoryView::PrepareScheduleBox(
+			_tray.get(),
+			_show,
+			details,
+			callback));
+		return true;
+	}
+	auto caption = _field->getTextWithAppliedMarkdown();
+	const auto sentCaption = caption;
+	const auto limit = Data::PremiumLimits(_session).captionLengthCurrent();
+	const auto remove = std::max(
+		int(caption.text.size()) - limit,
+		store.captionOverflow(key));
+	if (remove > 0) {
+		_show->showBox(Box(CaptionLimitReachedBox, _session, remove, nullptr));
+		return true;
+	}
+	const auto bundle = store.prepareBundle(key, _show, std::move(caption));
+	const auto peer = _session->data().peerLoaded(key.thread.peer);
+	if (!bundle
+		|| !peer
+		|| Data::ShowSendError(
+			_show,
+			peer,
+			*bundle,
+			(options.scheduled != 0))) {
+		return true;
+	}
+	if (options.scheduled && store.hasTtl(key)) {
+		_show->showToast(tr::lng_ttl_no_schedule(tr::now));
+		return true;
+	}
+	options.invertCaption = store.canMoveCaption(key) && store.invert(key);
+	options.price = store.price(key);
+	{
+		auto way = Core::App().settings().sendFilesWay();
+		if (way.sendLargePhotos() != store.largePhotos(key)
+			&& store.hasLargePhotosOption(key)) {
+			way.setSendLargePhotos(store.largePhotos(key));
+			Core::App().settings().setSendFilesWay(way);
+			Core::App().saveSettingsDelayed();
+		}
+	}
+	const auto ids = store.ids(key);
+	const auto after = store.takeAfterSend(key);
+	const auto weak = base::make_weak(&store);
+	const auto clearField = crl::guard(_tray.get(), [=] {
+		if (currentKey() == key
+			&& _field->getTextWithAppliedMarkdown() == sentCaption) {
+			_field->setTextWithTags({}, Ui::InputField::HistoryAction::Clear);
+		}
+	});
+	const auto finished = [=](bool consumed) {
+		if (!consumed) {
+			return;
+		} else if (const auto strong = weak.get()) {
+			strong->sent(key, ids);
+		}
+		clearField();
+		if (after) {
+			after();
+		}
+	};
+	struct State {
+		bool inside = true;
+		std::optional<bool> result;
+	};
+	const auto state = std::make_shared<State>();
+	_send(WatchBundle(bundle, [=](bool consumed) {
+		if (state->inside) {
+			state->result = consumed;
+		} else {
+			crl::on_main([=] { finished(consumed); });
+		}
+	}), options);
+	state->inside = false;
+	if (state->result) {
+		finished(*state->result);
+	}
+	return true;
+}
+
+QByteArray DockedVideoState(const Ui::PreparedFile &file) {
+	return SerializeVideoModifications(file);
+}
+
+DockedVideoPreview DockedVideoView(
+		const QString &path,
+		const QString &coverPath,
+		const QByteArray &state,
+		int sideLimit) {
+	auto file = Ui::PreparedFile(path);
+	file.size = QFileInfo(path).size();
+	Storage::PrepareDetails(file, st::sendMediaPreviewSize, sideLimit);
+	const auto video = LookupVideo(file);
+	if (!video) {
+		return {};
+	}
+	ApplySavedVideo(file, state, sideLimit);
+	if (video->thumbnail.isNull()) {
+		return {};
+	}
+	const auto &mods = video->modifications;
+	const auto source = Editor::ComposeVideoSource(path, mods, {}, false);
+	const auto full = std::max(video->duration, crl::time());
+	auto frame = Editor::ImageModified(
+		base::duplicate(video->thumbnail),
+		mods.geometry);
+	auto size = Media::Encode::TranscodedSize(
+		source,
+		video->thumbnail.size());
+	if (size.isEmpty()) {
+		size = frame.size();
+	}
+	auto result = DockedVideoPreview{
+		.dimensions = size,
+		.duration = std::max(
+			Media::Encode::TranscodedDuration(source, full),
+			crl::time()),
+	};
+	if (!coverPath.isEmpty()) {
+		if (auto cover = QImage(coverPath); !cover.isNull()) {
+			frame = std::move(cover);
+		}
+	}
+	const auto side = st::maxMediaSize * style::DevicePixelRatio();
+	auto target = size;
+	if (target.width() > side || target.height() > side) {
+		target = target.scaled(side, side, Qt::KeepAspectRatio);
+	}
+	target = QSize(std::max(target.width(), 1), std::max(target.height(), 1));
+	frame = frame.scaled(
+		target,
+		Qt::KeepAspectRatioByExpanding,
+		Qt::SmoothTransformation);
+	frame = frame.copy(
+		(frame.width() - target.width()) / 2,
+		(frame.height() - target.height()) / 2,
+		target.width(),
+		target.height()
+	).convertToFormat(QImage::Format_RGB32);
+	frame.setDevicePixelRatio(1.);
+	result.preview = std::move(frame);
+	return result;
+}
+
+void ApplyDraftFileState(
+		std::shared_ptr<ChatHelpers::Show> show,
+		Ui::PreparedFile &file) {
+	if (file.path.isEmpty() || !file.information) {
+		return;
+	}
+	const auto edits = Drafts(&show->session()).exportedEdits(file.path);
+	if (!edits) {
+		return;
+	}
+	const auto &[saved, coverPath] = *edits;
+	if (saved.type == int32(FileType::Video)
+		&& file.type != FileType::Video
+		&& LookupImage(file)) {
+		ToggleSendAsGif(file, show);
+	}
+	const auto sideLimit = PhotoSideLimit(true);
+	ApplySavedVideo(file, saved.modifications, sideLimit);
+	AttachSavedCover(file, coverPath, sideLimit);
+}
+
+void ApplyDraftFileState(
+		std::shared_ptr<ChatHelpers::Show> show,
+		Ui::PreparedList &list) {
+	for (auto &file : list.files) {
+		ApplyDraftFileState(show, file);
+	}
+}
+
+void DockedApplyVideoState(
+		Ui::PreparedFile &file,
+		const QByteArray &state,
+		const QString &coverPath,
+		int sideLimit) {
+	ApplySavedVideo(file, state, sideLimit);
+	AttachSavedCover(file, coverPath, sideLimit);
+}
+
+const Data::Draft *DockedListDraft(not_null<Data::Thread*> thread) {
+	if (!DockedAttachments()) {
+		return nullptr;
+	}
+	return Docked(&thread->session()).listDraft({
+		.thread = DraftsThread::From(thread),
+	});
+}
+
+std::optional<DockedDraftMedia> DockedDraftFiles(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	if (!DockedAttachments()) {
+		return std::nullopt;
+	}
+	return Docked(session).draftMedia({ .thread = thread });
+}
+
+void DockedForgetFiles(
+		not_null<Main::Session*> session,
+		DraftsThread thread,
+		const std::vector<uint64> &ids) {
+	Docked(session).sent({ .thread = thread }, ids);
+}
+
+bool DockedLoadDraft(
+		not_null<Main::Session*> session,
+		const SavedDraft &draft) {
+	return DockedAttachments() && Docked(session).loadDraft(draft);
+}
+
+bool DockedRestoreDraft(
+		not_null<Main::Session*> session,
+		const SavedDraft &draft) {
+	return DockedAttachments() && Docked(session).restoreDraft(draft);
+}
+
+bool DockedKeepsDraftLocal(not_null<Data::Thread*> thread) {
+	return DockedHasFiles(
+		&thread->session(),
+		DraftsThread::From(thread));
+}
+
+bool DockedHasFiles(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	if (!DockedAttachments()) {
+		return false;
+	}
+	const auto tray = Docked(session).find({ .thread = thread });
+	return tray && !tray->items.empty();
+}
+
+void DockedAfterSend(
+		not_null<Main::Session*> session,
+		DraftsThread thread,
+		Fn<void()> callback) {
+	Docked(session).setAfterSend({ .thread = thread }, std::move(callback));
+}
+
+bool ComposeDockedAdd(ComposeDocked *docked, Ui::PreparedList &list) {
+	return docked && docked->add(list);
+}
+
+bool ComposeDockedSend(ComposeDocked *docked, Api::SendOptions options) {
+	return docked && docked->send(options);
+}
+
+bool ComposeDockedHasFiles(const ComposeDocked *docked) {
+	return docked && docked->hasFiles();
+}
+
+int ComposeDockedHeight(ComposeDocked *docked) {
+	return docked ? docked->height() : 0;
+}
+
+void ComposeDockedMenu(
+		const ComposeDocked *docked,
+		SendMenu::Details &details) {
+	if (docked) {
+		docked->fillMenuDetails(details);
+	}
+}
+
+bool ComposeDockedMenuAction(
+		ComposeDocked *docked,
+		const SendMenu::Action &action) {
+	return docked && docked->menuAction(action);
+}
+
+void ComposeDockedMove(ComposeDocked *docked, int width, int bottom) {
+	if (docked) {
+		docked->move(width, bottom);
+	}
+}
+
+} // namespace Tele
