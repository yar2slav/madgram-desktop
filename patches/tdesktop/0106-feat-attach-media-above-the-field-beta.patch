+bool DockedStore::refreshListDraft(DockedKey key) {
+	const auto tray = (key.scheduled || key.stashed) ? nullptr : find(key);
+	if (!tray || tray->items.empty()) {
+		return _listDrafts.remove(key);
+	}
+	const auto text = TitleText(tray->list);
+	auto &draft = _listDrafts[key];
+	if (draft && draft->textWithTags.text == text) {
+		return false;
+	} else if (!draft) {
+		draft = std::make_unique<Data::Draft>();
+	}
+	draft->textWithTags = { text };
+	return true;
+}
