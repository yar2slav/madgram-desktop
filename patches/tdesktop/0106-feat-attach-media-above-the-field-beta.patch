+void DockedTray::setContent(DockedContent &&content, bool reset) {
+	const auto was = int(_content.tiles.size());
+	const auto wasGrid = grid();
+	_content = std::move(content);
+	const auto spoilers = ranges::any_of(_content.tiles, &DockedTile::spoiler);
+	if (!spoilers) {
+		_spoiler = nullptr;
+	} else if (!_spoiler) {
+		_spoiler = std::make_unique<Ui::SpoilerAnimation>([=] { update(); });
+	}
+	for (auto i = begin(_cache); i != end(_cache);) {
+		const auto found = ranges::find(
+			_content.tiles,
+			i->first,
+			&DockedTile::id) != end(_content.tiles);
+		i = found ? (i + 1) : _cache.erase(i);
+	}
+	if (_dragId && dragIndex() < 0) {
+		_dragId = 0;
+	}
+	if (_pressed.index >= int(_content.tiles.size())) {
+		_pressed = Hit();
+	}
+	if (reset || wasGrid != grid()) {
+		_scroll = 0;
+		_dragId = 0;
+		_pressed = Hit();
+	}
+	layout();
+	layoutRow();
+	if (!reset && int(_content.tiles.size()) > was) {
+		setScroll(maxScroll());
+	} else {
+		setScroll(_scroll);
+	}
+	update();
+}
+
+void DockedTray::setOverflow(int overflow) {
+	if (_content.overflow != overflow) {
+		_content.overflow = overflow;
+		update();
+	}
+}
