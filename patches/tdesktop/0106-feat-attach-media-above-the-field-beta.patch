+		&& to
+		&& file->isVideoFile()
+		&& (to->isBroadcast() || to->isSelf() || to->isBot());
+}
+
+bool DockedStore::compressed(DockedKey key) const {
+	const auto tray = find(key);
+	return tray && tray->way.sendImagesAsPhotos();
+}
