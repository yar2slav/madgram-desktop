+ComposeDocked::ComposeDocked(ComposeDockedDescriptor &&descriptor)
+: _session(&descriptor.show->session())
+, _field(descriptor.field)
+, _show(std::move(descriptor.show))
+, _thread(std::move(descriptor.thread))
+, _editing(std::move(descriptor.editing))
+, _changed(std::move(descriptor.changed))
+, _attach(std::move(descriptor.attach))
+, _send(std::move(descriptor.send))
+, _sendMenuDetails(std::move(descriptor.sendMenuDetails))
+, _scheduled(descriptor.scheduled)
+, _tray(base::make_unique_q<DockedTray>(
+	descriptor.parent,
+	DockedCallbacks{
+		.remove = [=](uint64 id) {
+			Docked(_session).remove(currentKey(), id);
+		},
+		.spoiler = [=](uint64 id) {
+			Docked(_session).toggleSpoiler(currentKey(), id);
+		},
+		.move = [=](int from, int to) {
+			Docked(_session).move(currentKey(), from, to);
+		},
+		.add = [=] {
+			if (_attach) {
+				_attach();
+			}
+		},
+		.clear = [=] {
+			Docked(_session).discard(currentKey());
+		},
+		.collapse = [=] {
+			Docked(_session).toggleCollapsed(currentKey());
+		},
+		.group = [=] {
+			Docked(_session).toggleGroup(currentKey());
+		},
+		.asFile = [=] {
+			Docked(_session).toggleAsFile(currentKey(), _show);
+		},
+		.grid = [] {
+			SetDockedGrid(!DockedGrid());
+		},
+		.edit = [=](uint64 id) {
+			edit(id);
+		},
+		.menu = [=](uint64 id, QPoint position) {
+			showMenu(id, position);
+		},
+		.caption = [=](uint64 id) {
+			editCaption(id);
+		},
+	})) {
+	setupTray();
+}
+
+ComposeDocked::~ComposeDocked() = default;
+
+void ComposeDocked::setupTray() {
+	_tray->hide();
+	Docked(_session).changes(
+	) | rpl::filter([=](DockedKey key) {
+		return (key == currentKey());
+	}) | rpl::on_next([=] {
+		_dirty = true;
+		refreshAndNotify();
+	}, _tray->lifetime());
+	DockedAttachmentsChanges(
+	) | rpl::on_next([=] {
+		_dirty = true;
+		refreshAndNotify();
+	}, _tray->lifetime());
+	DockedGridChanges(
+	) | rpl::on_next([=] {
+		_dirty = true;
+		refreshAndNotify();
+	}, _tray->lifetime());
+	_field->shownValue(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		refreshAndNotify();
+	}, _tray->lifetime());
+	_field->changes(
+	) | rpl::on_next([=] {
+		refreshOverflow();
+	}, _tray->lifetime());
+}
+
+void ComposeDocked::refreshOverflow() {
+	const auto limit = Data::PremiumLimits(_session).captionLengthCurrent();
+	const auto field = int(_field->getLastText().size()) - limit;
+	_tray->setOverflow(std::max({
+		field,
+		Docked(_session).captionOverflow(currentKey()),
+		0,
+	}));
+}
+
+DockedKey ComposeDocked::currentKey() const {
+	const auto thread = _thread();
+	return thread
+		? DockedKey{ DraftsThread::From(thread), _scheduled }
+		: DockedKey();
+}
+
+bool ComposeDocked::shown() const {
+	if (!DockedAttachments() || _field->isHidden() || _editing()) {
+		return false;
+	}
+	const auto key = currentKey();
+	const auto tray = key ? Docked(_session).find(key) : nullptr;
+	return tray && !tray->items.empty();
+}
+
+bool ComposeDocked::hasFiles() const {
+	return shown();
+}
+
+bool ComposeDocked::refresh() {
+	const auto visible = shown();
+	const auto key = currentKey();
+	const auto wasHeight = _tray->isHidden() ? 0 : _tray->height();
+	if (visible && (_dirty || _contentKey != key)) {
+		const auto tray = Docked(_session).find(key);
+		const auto peer = _session->data().peerLoaded(key.thread.peer);
+		const auto slowmode = peer
+			&& bool(DefaultLimitsForPeer(peer) & SendFilesAllow::OnlyOne);
+		const auto reset = (_contentKey != key);
+		_dirty = false;
+		_contentKey = key;
+		_tray->setContent(BuildContent(*tray, slowmode), reset);
+		refreshOverflow();
+		Docked(_session).attachShow(key, _show);
+		if (ranges::any_of(tray->items, [](const Item &item) {
+			return (item.stage == Stage::Restored);
+		})) {
+			InvokeQueued(_tray.get(), [=] {
+				Docked(_session).materialize(key);
+			});
+		}
+	}
+	if (visible) {
+		const auto desired = _tray->desiredHeight();
+		if (_tray->height() != desired) {
+			_tray->resize(_tray->width(), desired);
+		}
+	}
+	if (_tray->isHidden() == visible) {
+		_tray->setVisible(visible);
+	}
+	const auto nowHeight = visible ? _tray->height() : 0;
+	return (nowHeight != wasHeight);
+}
+
+void ComposeDocked::refreshAndNotify() {
+	refresh();
+	if (_changed) {
+		_changed();
+	}
+}
+
+int ComposeDocked::height() {
+	if (refresh() && !_relayoutQueued) {
+		_relayoutQueued = true;
+		InvokeQueued(_tray.get(), [=] {
+			_relayoutQueued = false;
+			if (_changed) {
+				_changed();
+			}
+		});
+	}
+	return _tray->isHidden() ? 0 : _tray->height();
+}
+
+void ComposeDocked::move(int width, int bottom) {
+	const auto height = this->height();
+	if (height > 0) {
+		_tray->setGeometry(0, bottom - height, width, height);
+	}
+}
+
+void ComposeDocked::edit(uint64 id) {
+	const auto key = currentKey();
+	auto &store = Docked(_session);
+	const auto kind = store.editKind(key, id);
+	auto copy = (kind != EditKind::None) ? store.copy(key, id) : nullptr;
+	if (!copy) {
+		return;
+	}
+	if (kind == EditKind::Photo) {
+		const auto file = std::shared_ptr<Ui::PreparedFile>(std::move(copy));
+		Editor::OpenWithPreparedFile(
+			_tray.get(),
+			_show,
+			file.get(),
+			st::sendMediaPreviewSize,
+			crl::guard(_tray.get(), [=](bool ok) {
+				if (ok) {
+					Docked(_session).applyEdited(
+						key,
+						id,
+						std::move(*file),
+						true);
+				}
+			}),
+			PhotoSideLimit(true),
+			QSize(),
+			true);
+		return;
+	}
+	const auto list = std::make_shared<Ui::PreparedList>();
+	list->files.push_back(std::move(*copy));
+	Editor::OpenWithPreparedVideoFile(
+		_tray.get(),
+		_show,
+		list.get(),
+		0,
+		st::sendMediaPreviewSize,
+		crl::guard(_tray.get(), [=](bool ok) {
+			if (ok && !list->files.empty()) {
+				Docked(_session).applyEdited(
+					key,
+					id,
+					std::move(list->files.front()),
+					false);
+			}
+		}),
+		PhotoSideLimit(true));
+}
+
+void ComposeDocked::editCover(uint64 id) {
+	const auto key = currentKey();
+	const auto show = _show;
+	const auto session = _session;
+	const auto guard = _tray.get();
+	FileDialog::GetOpenPath(
+		guard,
+		tr::lng_choose_cover(tr::now),
+		FileDialog::ImagesFilter(),
+		crl::guard(guard, [=](FileDialog::OpenResult &&result) {
+			const auto checkResult = [=](const Ui::PreparedList &list) {
+				if (list.files.empty()) {
+					return true;
+				} else if (list.files.front().type != FileType::Photo) {
+					show->showToast(tr::lng_choose_cover_bad(tr::now));
+					return false;
+				}
+				return true;
+			};
+			const auto showError = [=](tr::phrase<> text) {
+				show->showToast(text(tr::now));
+			};
+			auto list = Storage::PreparedFileFromFilesDialog(
+				std::move(result),
+				checkResult,
+				showError,
+				st::sendMediaPreviewSize,
+				session->premium());
+			const auto file = Docked(session).file(key, id);
+			const auto video = file ? LookupVideo(*file) : nullptr;
+			if (!list || list->files.empty() || !video) {
+				return;
+			}
+			const auto size = video->thumbnail.size();
+			const auto cover = std::make_shared<Ui::PreparedFile>(
+				std::move(list->files.front()));
+			Editor::OpenWithPreparedFile(
+				guard,
+				show,
+				cover.get(),
+				st::sendMediaPreviewSize,
+				crl::guard(guard, [=](bool ok) {
+					if (ok) {
+						Docked(session).setCover(
+							key,
+							id,
+							std::make_unique<Ui::PreparedFile>(
+								std::move(*cover)));
+					}
+				}),
+				PhotoSideLimit(true),
+				size);
+		}));
+}
+
+void ComposeDocked::showMenu(uint64 id, QPoint position) {
+	const auto key = currentKey();
+	auto &store = Docked(_session);
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		_tray.get(),
+		st::popupMenuWithIcons);
+	const auto menu = _menu.get();
+	if (const auto file = store.file(key, id)) {
+		const auto compress = store.compressed(key);
+		const auto kind = store.editKind(key, id);
+		if (kind != EditKind::None) {
+			menu->addAction(
+				((kind == EditKind::Photo)
+					? tr::lng_context_draw(tr::now)
+					: tr::lng_context_edit_video(tr::now)),
+				[=] { edit(id); },
+				&st::menuIconDraw);
+		}
+		if (CanSpoiler(*file, compress)) {
+			Menu::AddCheckedAction(
+				menu,
+				tr::lng_context_spoiler_effect(tr::now),
+				[=] { Docked(_session).toggleSpoiler(key, id); },
+				&st::menuIconSpoiler,
+				file->spoiler);
+		}
+		AddSendAsGifAction(menu, *file, compress, store.album(key), [=] {
+			Docked(_session).toggleGif(key, id, _show);
+		});
+		if (store.canEditCover(key, id)) {
+			menu->addAction(
+				tr::lng_context_edit_cover(tr::now),
+				[=] { editCover(id); },
+				&st::menuIconEdit);
+			if (file->videoCover) {
+				menu->addAction(
+					tr::lng_context_clear_cover(tr::now),
+					[=] { Docked(_session).clearCover(key, id); },
+					&st::menuIconCancel);
+			}
+		}
+	}
+	if (store.file(key, id)) {
+		menu->addAction(tr::lng_attach_replace(tr::now), [=] {
+			replace(id);
+		}, &st::menuIconReplace);
+	}
+	if (store.canRename(key, id)) {
+		menu->addAction(tr::lng_rename_file(tr::now), [=] {
+			rename(id);
+		}, &st::menuIconEdit);
+	}
+	if (store.canSetTtl(key, id)) {
+		const auto current = store.file(key, id)
+			? store.file(key, id)->ttlSeconds
+			: crl::time();
+		auto submenu = std::make_unique<Ui::PopupMenu>(menu, menu->st());
+		const auto choose = [=](crl::time ttl) {
+			Docked(_session).setTtl(key, id, ttl);
+		};
+		const auto add = [&](const QString &label, crl::time value) {
+			submenu->addAction(
+				label,
+				[=] { choose(value); },
+				(current == value) ? &st::mediaPlayerMenuCheck : nullptr);
+		};
+		add(tr::lng_ttl_period_once(tr::now), Data::kTimeToLiveSingleView);
+		add(tr::lng_seconds(tr::now, lt_count, 3), 3);
+		add(tr::lng_seconds(tr::now, lt_count, 10), 10);
+		add(tr::lng_seconds(tr::now, lt_count, 30), 30);
+		add(tr::lng_ttl_period_keep(tr::now), 0);
+		const auto custom = (current > 0)
+			&& (current != Data::kTimeToLiveSingleView)
+			&& (current != 3)
+			&& (current != 10)
+			&& (current != 30);
+		const auto show = _show;
+		const auto chooseCustom = crl::guard(_tray.get(), [=] {
+			auto values = std::vector<TimeId>();
+			auto phrases = std::vector<QString>();
+			for (auto i = 1; i != 61; ++i) {
+				values.push_back(i);
+				phrases.push_back(tr::lng_seconds(tr::now, lt_count, i));
+			}
+			const auto initial = custom ? int(current) : 10;
+			show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+				box->setTitle(tr::lng_ttl_period_menu());
+				const auto take = Ui::TimePickerBox(
+					box,
+					values,
+					phrases,
+					initial);
+				box->addButton(tr::lng_settings_save(), [=] {
+					const auto value = take();
+					box->closeBox();
+					choose(value);
+				});
+				box->addButton(tr::lng_cancel(), [=] {
+					box->closeBox();
+				});
+			}));
+		});
+		submenu->addAction(
+			(custom
+				? tr::lng_ttl_period_custom_value(
+					tr::now,
+					lt_time,
+					tr::lng_seconds_tiny(tr::now, lt_count, current))
+				: tr::lng_ttl_period_custom(tr::now)),
+			chooseCustom,
+			custom ? &st::mediaPlayerMenuCheck : nullptr);
+		submenu->addSeparator();
+		submenu->addAction(base::make_unique_q<Ui::Menu::MultilineAction>(
+			submenu->menu(),
+			submenu->st().menu,
+			st::historyHasCustomEmoji,
+			st::historyHasCustomEmojiPosition,
+			TextWithEntities{ tr::lng_ttl_period_hint(tr::now) }));
+		menu->addAction(
+			tr::lng_ttl_period_menu(tr::now),
+			std::move(submenu),
+			&st::menuIconTTL);
+	}
+	if (store.firstId(key) == id) {
+		menu->addAction(Lower(u"Edit caption"_q), [=] {
+			_field->setFocus();
+		}, &st::menuIconCaptionShow);
+	} else if (const auto caption = store.caption(key, id)) {
+		menu->addAction(
+			(caption->text.isEmpty()
+				? Lower(u"Add caption"_q)
+				: Lower(u"Edit caption"_q)),
+			[=] { editCaption(id); },
+			&st::menuIconCaptionShow);
+	}
+	menu->addAction(
+		Lower(u"Remove"_q),
+		[=] { Docked(_session).remove(key, id); },
+		&st::menuIconDelete);
+	menu->popup(position);
+}
