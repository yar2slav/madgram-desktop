+[[nodiscard]] QString BakedName(const Ui::PreparedFile &file) {
+	const auto base = QFileInfo(!file.displayName.isEmpty()
+		? file.displayName
+		: file.path).completeBaseName();
+	return (base.isEmpty() ? u"image"_q : base) + u".png"_q;
+}
+
+[[nodiscard]] std::optional<DraftFileSource> BakedSource(
+		const Ui::PreparedFile &file,
+		const QString &name) {
+	const auto image = LookupImage(file);
+	if (!image || image->data.isNull()) {
+		return std::nullopt;
+	}
+	auto baked = image->modifications
+		? Editor::ImageModified(image->data, image->modifications)
+		: image->data;
+	if (baked.isNull()) {
+		return std::nullopt;
+	}
+	return DraftFileSource{
+		.image = baked,
+		.name = name,
+		.thumbnail = file.preview.isNull() ? baked : file.preview,
+		.spoiler = file.spoiler,
+	};
+}
