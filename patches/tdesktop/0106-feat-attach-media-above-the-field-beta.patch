+DockedStore::DockedStore(not_null<Main::Session*> session)
+: _session(session) {
+	for (const auto &[key, docked] : Drafts(session).docked()) {
+		auto &tray = _trays[key];
+		tray.way = Ui::SendFilesWay::FromSerialized(
+			docked.way
+		).value_or(DefaultSendFilesWay());
+		tray.collapsed = docked.collapsed;
+		tray.invert = docked.invert;
+		tray.price = uint64(std::max(docked.price, int64()));
+		for (const auto &entry : docked.files) {
+			tray.list.files.push_back(Placeholder(entry));
+			tray.items.push_back({
+				.id = ++_autoId,
+				.stage = Stage::Restored,
+				.saved = entry,
+			});
+		}
+		refreshListDraft(key);
+	}
+	DockedAttachmentsChanges(
+	) | rpl::on_next([=] {
+		for (const auto &[key, draft] : _listDrafts) {
+			repaintListRow(key);
+		}
+	}, _lifetime);
+	Drafts(session).editingChanges(
+	) | rpl::on_next([=] {
+		reconcileDrafting();
+	}, _lifetime);
+	crl::on_main(this, [=] {
+		reconcileDrafting();
+	});
+}
+
+std::pair<DockedKey, Tray*> DockedStore::locate(
+		uint64 id,
+		DockedKey fallback) {
+	for (auto &[key, tray] : _trays) {
+		if (IndexOf(tray, id) >= 0) {
+			return { key, &tray };
+		}
+	}
+	return { fallback, lookup(fallback) };
+}
+
+void DockedStore::moveTray(DockedKey from, DockedKey to) {
+	_trays.erase(to);
+	const auto i = _trays.find(from);
+	if (i != end(_trays)) {
+		auto tray = std::move(i->second);
+		_trays.erase(i);
+		_trays.emplace(to, std::move(tray));
+	}
+	persist(from);
+	persist(to);
+}
+
+void DockedStore::dropTray(DockedKey key) {
+	_afterSend.remove(key);
+	if (_trays.erase(key)) {
+		persist(key);
+		notify(key);
+	}
+}
+
+void DockedStore::beginDraft(DraftsThread thread, uint64 id) {
+	const auto key = DockedKey{ .thread = thread };
+	const auto stash = DockedKey{ .thread = thread, .stashed = true };
+	_drafting[thread] = id;
+	if (_trays.contains(key) && !_trays.contains(stash)) {
+		moveTray(key, stash);
+	}
+	notify(key);
+	notify(stash);
+}
+
+void DockedStore::endDraft(DraftsThread thread) {
+	const auto key = DockedKey{ .thread = thread };
+	const auto stash = DockedKey{ .thread = thread, .stashed = true };
+	_drafting.remove(thread);
+	_afterSend.remove(key);
+	moveTray(stash, key);
+	notify(key);
+	notify(stash);
+}
+
+void DockedStore::reconcileDrafting() {
+	const auto now = Drafts(_session).editingList();
+	const auto editingId = [&](DraftsThread thread) {
+		for (const auto &[editing, id] : now) {
+			if (editing == thread) {
+				return id;
+			}
+		}
+		return uint64();
+	};
+	const auto was = _drafting;
+	for (const auto &[thread, id] : was) {
+		const auto current = editingId(thread);
+		if (!current) {
+			endDraft(thread);
+		} else if (current != id) {
+			_drafting[thread] = current;
+			dropTray({ .thread = thread });
+		}
+	}
+	auto stale = std::vector<DraftsThread>();
+	for (const auto &[key, tray] : _trays) {
+		if (key.stashed && !_drafting.contains(key.thread)) {
+			stale.push_back(key.thread);
+		}
+	}
+	for (const auto thread : stale) {
+		endDraft(thread);
+	}
+	for (const auto &[thread, id] : now) {
+		if (!_drafting.contains(thread)) {
+			beginDraft(thread, id);
+		}
+	}
+}
+
+void DockedStore::appendSaved(
+		Tray &tray,
+		const std::vector<SavedDraftFile> &files) {
+	auto &store = Drafts(_session);
+	for (const auto &file : files) {
+		if (store.fileMissing(file)) {
+			continue;
+		}
+		const auto saved = SavedDockedFile{
+			.file = file,
+			.type = (file.type
+				? file.type
+				: int32(file.thumbnail.isEmpty()
+					? FileType::File
+					: FileType::Photo)),
+			.cover = SavedDraftFile{
+				.name = u"cover.png"_q,
+				.stored = file.cover,
+			},
+			.modifications = file.modifications,
+		};
+		tray.list.files.push_back(Placeholder(saved));
+		tray.items.push_back({
+			.id = ++_autoId,
+			.stage = Stage::Restored,
+			.saved = saved,
+		});
+	}
+}
+
+bool DockedStore::restoreDraft(const SavedDraft &draft) {
+	if (!ResolveDraftsThread(_session, draft.thread)) {
+		return false;
+	}
+	const auto key = DockedKey{ .thread = draft.thread };
+	auto &tray = _trays[key];
+	if (tray.items.empty()) {
+		tray.way = Ui::SendFilesWay::FromSerialized(
+			draft.filesWay
+		).value_or(DefaultSendFilesWay());
+		tray.price = draft.price;
+		tray.invert = draft.invertCaption;
+	}
+	tray.collapsed = false;
+	appendSaved(tray, draft.files);
+	if (tray.items.empty()) {
+		_trays.erase(key);
+		return false;
+	}
+	persist(key);
+	notify(key);
+	return true;
+}
+
+void DockedStore::discard(DockedKey key) {
+	const auto tray = find(key);
+	if (!tray) {
+		return;
+	}
+	const auto editor = !key.scheduled && _drafting.contains(key.thread);
+	const auto show = tray->show;
+	auto media = (editor || key.stashed || !show)
+		? std::optional<DockedDraftMedia>()
+		: draftMedia(key);
+	if (media && !media->sources.empty()) {
+		ImportMediaDraft(show, std::move(media->sources), {
+			.thread = key.thread,
+			.reply = NormalizeDraftReply(FullReplyTo(), key.thread),
+			.way = media->way,
+			.price = media->price,
+			.invert = media->invert,
+			.toast = false,
+			.discarded = true,
+		});
+		show->showToast(
+			Lower(u"Files moved to recently discarded drafts."_q));
+	}
+	clear(key);
+}
+
+bool DockedStore::loadDraft(const SavedDraft &draft) {
+	reconcileDrafting();
+	const auto i = _drafting.find(draft.thread);
+	if (i == end(_drafting) || i->second != draft.id) {
+		return false;
+	}
+	const auto key = DockedKey{ .thread = draft.thread };
+	auto tray = Tray();
+	tray.way = Ui::SendFilesWay::FromSerialized(
+		draft.filesWay
+	).value_or(DefaultSendFilesWay());
+	tray.invert = draft.invertCaption;
+	tray.price = draft.price;
+	appendSaved(tray, draft.files);
+	_afterSend.remove(key);
+	_trays.erase(key);
+	if (!tray.items.empty()) {
+		_trays.emplace(key, std::move(tray));
+	}
+	persist(key);
+	notify(key);
+	return true;
+}
+
+void DockedStore::setAfterSend(DockedKey key, Fn<void()> callback) {
+	_afterSend[key] = std::move(callback);
+}
+
+Fn<void()> DockedStore::takeAfterSend(DockedKey key) {
+	const auto i = _afterSend.find(key);
+	if (i == end(_afterSend)) {
+		return nullptr;
+	}
+	auto result = std::move(i->second);
+	_afterSend.erase(i);
+	return result;
+}
+
+std::optional<DockedDraftMedia> DockedStore::draftMedia(
+		DockedKey key) const {
+	const auto tray = find(key);
+	if (!tray || tray->items.empty()) {
+		return std::nullopt;
+	}
+	auto &store = Drafts(_session);
+	const auto compress = tray->way.sendImagesAsPhotos();
+	auto result = DockedDraftMedia{
+		.way = tray->way.serialize(),
+		.price = tray->price,
+		.invert = tray->invert,
+	};
+	for (auto i = 0; i != int(tray->items.size()); ++i) {
+		const auto &item = tray->items[i];
+		const auto &file = tray->list.files[i];
+		auto thumbnail = PreviewImage(file);
+		if (thumbnail.isNull() && !item.saved.file.thumbnail.isEmpty()) {
+			thumbnail = QImage::fromData(item.saved.file.thumbnail);
+		}
+		auto source = std::optional<DraftFileSource>();
+		if (!item.stale && !item.saved.file.stored.isEmpty()) {
+			source = DraftFileSource{
+				.path = item.saved.path,
+				.name = item.saved.file.name,
+				.reuse = item.saved.file.stored,
+				.size = item.saved.file.size,
+				.thumbnail = thumbnail,
+			};
+		} else if (item.baked && LookupImage(file)) {
+			source = BakedSource(file, BakedName(file));
+		} else if (!item.saved.path.isEmpty()) {
+			source = DraftFileSource{
+				.path = item.saved.path,
+				.name = item.saved.file.name,
+				.size = item.saved.file.size,
+				.thumbnail = thumbnail,
+			};
+		} else {
+			source = DraftSourceFromFile(file, store);
+		}
+		if (!source) {
+			result.failed = true;
+			continue;
+		}
+		source->spoiler = file.spoiler && CanSpoiler(file, compress);
+		source->caption = file.caption;
+		source->ttl = compress ? int32(file.ttlSeconds) : 0;
+		source->type = (item.stage == Stage::Ready)
+			? int32(file.type)
+			: item.saved.type;
+		source->modifications = (item.stage == Stage::Ready)
+			? SerializeVideoModifications(file)
+			: item.saved.modifications;
+		source->cover = nullptr;
+		if (!item.coverDirty
+			&& !item.saved.cover.stored.isEmpty()
+			&& !store.fileMissing(item.saved.cover)) {
+			source->cover = std::make_shared<DraftFileSource>(
+				DraftFileSource{
+					.name = u"cover.png"_q,
+					.reuse = item.saved.cover.stored,
+					.size = item.saved.cover.size,
+				});
+		} else if (file.videoCover) {
+			if (auto cover = BakedSource(*file.videoCover, u"cover.png"_q)) {
+				source->cover = std::make_shared<DraftFileSource>(
+					std::move(*cover));
+			}
+		}
+		result.ids.push_back(item.id);
+		result.sources.push_back(std::move(*source));
+	}
+	return result;
+}
+
+const Tray *DockedStore::find(DockedKey key) const {
+	const auto i = _trays.find(key);
+	return (i != end(_trays)) ? &i->second : nullptr;
+}
+
+Tray *DockedStore::lookup(DockedKey key) {
+	const auto i = _trays.find(key);
+	return (i != end(_trays)) ? &i->second : nullptr;
+}
+
+PeerData *DockedStore::peer(DockedKey key) const {
+	return _session->data().peerLoaded(key.thread.peer);
+}
+
+rpl::producer<DockedKey> DockedStore::changes() const {
+	return _changes.events();
+}
+
+bool DockedStore::ready(DockedKey key) const {
+	const auto tray = find(key);
+	return tray
+		&& !tray->items.empty()
+		&& ranges::all_of(tray->items, [](const Item &item) {
+			return (item.stage == Stage::Ready);
+		});
+}
+
+int DockedStore::IndexOf(const Tray &tray, uint64 id) {
+	const auto i = ranges::find(tray.items, id, &Item::id);
+	return (i != end(tray.items)) ? int(i - begin(tray.items)) : -1;
+}
+
+void DockedStore::RemoveIndex(Tray &tray, int index) {
+	tray.list.files.erase(begin(tray.list.files) + index);
+	tray.items.erase(begin(tray.items) + index);
+}
+
+bool DockedStore::validate(
+		DockedKey key,
+		Tray &tray,
+		int index,
+		bool silent) const {
+	const auto to = peer(key);
+	if (!to) {
+		return true;
+	}
+	const auto show = silent ? nullptr : tray.show;
+	if (!tray.list.files[index].information) {
+		return true;
+	} else if (DefaultLimitsForPeer(to) & SendFilesAllow::OnlyOne) {
+		tray.way.setGroupFiles(true);
+		if (!Prepared(tray.list) || tray.list.canBeSentInSlowmode()) {
+			return true;
+		} else if (show) {
+			Data::ShowSendErrorToast(
+				show,
+				to,
+				tr::lng_slowmode_no_many(tr::now));
+		}
+		return false;
+	}
+	const auto error = Data::FileRestrictionError(
+		to,
+		tray.list.files[index],
+		tray.way.sendImagesAsPhotos());
+	if (error && show) {
+		Data::ShowSendErrorToast(show, to, error);
+	}
+	return !error;
+}
+
+void DockedStore::refreshPrepared(DockedKey key, Tray &tray) const {
+	if (!Prepared(tray.list)) {
+		return;
+	}
+	const auto slowmode = Slowmode(peer(key));
+	tray.way.setHasCompressedStickers(tray.list.hasSticker());
+	tray.groupShown = tray.list.hasGroupOption(slowmode);
+	tray.asFileShown = tray.list.hasSendImagesAsPhotosOption(slowmode);
+	tray.optionsKnown = true;
+}
+
+bool DockedStore::fits(
+		DockedKey key,
+		const Tray &tray,
+		const Ui::PreparedList &added,
+		Ui::SendFilesWay way) const {
+	const auto to = peer(key);
+	if (!to) {
+		return true;
+	}
+	const auto compress = way.sendImagesAsPhotos();
+	const auto check = [&](const Ui::PreparedFile &file) {
+		return !file.information
+			|| !Data::FileRestrictionError(to, file, compress);
+	};
+	return ranges::all_of(tray.list.files, check)
+		&& ranges::all_of(added.files, check);
+}
+
+void DockedStore::add(
+		DockedKey key,
+		std::shared_ptr<ChatHelpers::Show> show,
+		Ui::PreparedList &&list) {
+	auto &tray = _trays[key];
+	const auto fresh = tray.items.empty();
+	tray.show = std::move(show);
+	tray.collapsed = false;
+	if (fresh) {
+		tray.way = DefaultSendFilesWay();
+	}
+	if (list.overrideSendImagesAsPhotos.has_value()) {
+		auto candidate = tray.way;
+		candidate.setSendImagesAsPhotos(*list.overrideSendImagesAsPhotos);
+		if (fits(key, tray, list, candidate)) {
+			tray.way = candidate;
+		}
+	} else if (fresh && !fits(key, tray, list, tray.way)) {
+		tray.way.setSendImagesAsPhotos(!tray.way.sendImagesAsPhotos());
+	}
+	auto silent = false;
+	for (auto &file : list.files) {
+		const auto stage = file.information ? Stage::Ready : Stage::Pending;
+		tray.list.files.push_back(std::move(file));
+		tray.items.push_back({ .id = ++_autoId, .stage = stage });
+		const auto index = int(tray.items.size()) - 1;
+		if (stage == Stage::Ready && !validate(key, tray, index, silent)) {
+			RemoveIndex(tray, index);
+			silent = true;
+		}
+	}
+	for (auto &file : list.filesToProcess) {
+		tray.list.files.push_back(std::move(file));
+		tray.items.push_back({ .id = ++_autoId, .stage = Stage::Pending });
+	}
+	refreshPrepared(key, tray);
+	if (tray.items.empty()) {
+		_trays.erase(key);
+		notify(key);
+		return;
+	}
+	importItems(key);
+	persist(key);
+	processNext(key);
+	notify(key);
+}
+
+void DockedStore::remove(DockedKey key, uint64 id) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0) {
+		return;
+	}
+	RemoveIndex(*tray, index);
+	if (tray->items.empty()) {
+		_trays.erase(key);
+	} else {
+		finish(key);
+	}
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::move(DockedKey key, int from, int to) {
+	const auto tray = lookup(key);
+	const auto count = tray ? int(tray->items.size()) : 0;
+	if (from == to || from < 0 || to < 0 || from >= count || to >= count) {
+		return;
+	}
+	auto file = std::move(tray->list.files[from]);
+	auto item = std::move(tray->items[from]);
+	RemoveIndex(*tray, from);
+	tray->list.files.insert(begin(tray->list.files) + to, std::move(file));
+	tray->items.insert(begin(tray->items) + to, std::move(item));
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::toggleSpoiler(DockedKey key, uint64 id) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0) {
+		return;
+	}
+	auto &file = tray->list.files[index];
+	if (!CanSpoiler(file, tray->way.sendImagesAsPhotos())) {
+		return;
+	}
+	file.spoiler = !file.spoiler;
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::toggleGroup(DockedKey key) {
+	const auto tray = lookup(key);
+	if (!tray) {
+		return;
+	}
+	tray->way.setGroupFiles(!tray->way.groupFiles());
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::toggleAsFile(
+		DockedKey key,
+		std::shared_ptr<ChatHelpers::Show> show) {
+	const auto tray = lookup(key);
+	const auto to = peer(key);
+	if (!tray || !to) {
+		return;
+	}
+	auto candidate = tray->way;
+	candidate.setSendImagesAsPhotos(!candidate.sendImagesAsPhotos());
+	const auto compress = candidate.sendImagesAsPhotos();
+	for (const auto &file : tray->list.files) {
+		if (!file.information) {
+			continue;
+		} else if (const auto error = Data::FileRestrictionError(
+				to,
+				file,
+				compress)) {
+			Data::ShowSendErrorToast(show, to, error);
+			return;
+		}
+	}
+	tray->way = candidate;
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::toggleCollapsed(DockedKey key) {
+	if (const auto tray = lookup(key)) {
+		tray->collapsed = !tray->collapsed;
+		persist(key);
+		notify(key);
+	}
+}
+
+void DockedStore::clear(DockedKey key) {
+	_afterSend.remove(key);
+	if (_trays.erase(key)) {
+		persist(key);
+		notify(key);
+	}
+}
+
+std::vector<uint64> DockedStore::ids(DockedKey key) const {
+	const auto tray = find(key);
+	return tray
+		? (tray->items | ranges::views::transform(&Item::id) | ranges::to_vector)
+		: std::vector<uint64>();
+}
+
+void DockedStore::sent(DockedKey key, const std::vector<uint64> &ids) {
+	const auto tray = lookup(key);
+	if (!tray) {
+		return;
+	}
+	for (const auto id : ids) {
+		const auto index = IndexOf(*tray, id);
+		if (index >= 0) {
+			RemoveIndex(*tray, index);
+		}
+	}
+	if (tray->items.empty()) {
+		_trays.erase(key);
+	} else {
+		finish(key);
+	}
+	persist(key);
+	notify(key);
+}
+
+const Data::Draft *DockedStore::listDraft(DockedKey key) const {
+	const auto i = _listDrafts.find(key);
+	return (i != end(_listDrafts)) ? i->second.get() : nullptr;
+}
+
+int DockedStore::readyIndex(DockedKey key, uint64 id) const {
+	const auto tray = find(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	return (index >= 0
+		&& tray->items[index].stage == Stage::Ready
+		&& tray->list.files[index].information)
+		? index
+		: -1;
+}
+
+const Ui::PreparedFile *DockedStore::file(DockedKey key, uint64 id) const {
+	const auto index = readyIndex(key, id);
+	return (index >= 0) ? &find(key)->list.files[index] : nullptr;
+}
+
+EditKind DockedStore::editKind(DockedKey key, uint64 id) const {
+	const auto file = this->file(key, id);
+	return file ? KindOf(*file, compressed(key)) : EditKind::None;
+}
+
+bool DockedStore::canEditCover(DockedKey key, uint64 id) const {
+	const auto file = this->file(key, id);
+	const auto to = peer(key);
