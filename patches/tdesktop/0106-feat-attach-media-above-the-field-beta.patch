+[[nodiscard]] QString CountText(int count, const QString &one, QString many) {
+	return (count == 1) ? one : many.arg(count);
+}
+
+[[nodiscard]] QString TitleText(const Ui::PreparedList &list) {
+	auto photos = 0;
+	auto videos = 0;
+	auto files = 0;
+	for (const auto &file : list.files) {
+		if (file.type == FileType::Photo) {
+			++photos;
+		} else if (file.type == FileType::Video) {
+			++videos;
+		} else {
+			++files;
+		}
+	}
+	auto parts = QStringList();
+	if (photos) {
+		parts.push_back(CountText(photos, u"1 photo"_q, u"%1 photos"_q));
+	}
+	if (videos) {
+		parts.push_back(CountText(videos, u"1 video"_q, u"%1 videos"_q));
+	}
+	if (files) {
+		parts.push_back(CountText(files, u"1 file"_q, u"%1 files"_q));
+	}
+	return Lower(parts.join(u", "_q));
+}
+
+[[nodiscard]] QImage PreviewImage(const Ui::PreparedFile &file) {
+	if (!file.preview.isNull()) {
+		return file.preview;
+	} else if (file.information) {
+		using Image = Ui::PreparedFileInformation::Image;
+		using Video = Ui::PreparedFileInformation::Video;
+		if (const auto image = std::get_if<Image>(&file.information->media)) {
+			return image->data;
+		} else if (const auto video = std::get_if<Video>(
+				&file.information->media)) {
+			return video->thumbnail;
+		}
+	}
+	return QImage();
+}
