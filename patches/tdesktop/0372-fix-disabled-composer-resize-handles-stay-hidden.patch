From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Wed, 11 Nov 2026 21:02:20 +0300
Subject: [PATCH] fix: disabled composer resize handles stay hidden

---
 .../SourceFiles/tele/tele_field_resize.cpp    | 22 +++++++++++++++++--
 Telegram/SourceFiles/tele/tele_field_resize.h |  4 +++-
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_field_resize.cpp b/Telegram/SourceFiles/tele/tele_field_resize.cpp
index b903ee1f313081103481ba87a03c714368a7d7d3..0b6902a64729448cbb4977ab779136a1aea2a9b6 100644
--- a/Telegram/SourceFiles/tele/tele_field_resize.cpp
+++ b/Telegram/SourceFiles/tele/tele_field_resize.cpp
@@ -37,12 +37,30 @@ constexpr auto kLineOpacity = 0.5;
 
 } // namespace
 
+class FieldResizeHandle final : public Ui::RpWidget {
+public:
+	using Ui::RpWidget::RpWidget;
+
+	void toggle(bool allowed) {
+		_allowed = allowed;
+		setVisible(allowed);
+	}
+
+protected:
+	void setVisibleHook(bool visible) override {
+		Ui::RpWidget::setVisibleHook(visible && _allowed);
+	}
+
+private:
+	bool _allowed = false;
+};
+
 FieldResize::FieldResize(FieldResizeDescriptor &&descriptor)
 : _parent(descriptor.parent)
 , _field(descriptor.field)
 , _apply(std::move(descriptor.apply))
 , _max(st::historyComposeFieldMaxHeight)
-, _handle(base::make_unique_q<Ui::RpWidget>(_parent)) {
+, _handle(base::make_unique_q<FieldResizeHandle>(_parent)) {
 	if (const auto above = descriptor.above) {
 		_handle->stackUnder(above);
 		above->stackUnder(_handle.get());
@@ -97,7 +115,7 @@ void FieldResize::setupHandle(
 		std::move(shown),
 		ResizableFieldValue()
 	) | rpl::on_next([=](bool shown, bool enabled) {
-		handle->setVisible(shown && enabled);
+		handle->toggle(shown && enabled);
 	}, handle->lifetime());
 
 	handle->paintRequest() | rpl::on_next([=] {
diff --git a/Telegram/SourceFiles/tele/tele_field_resize.h b/Telegram/SourceFiles/tele/tele_field_resize.h
index b9fbe96c38341f87dc6d4f29214cf21c8447c0cc..285745d4b6c26d984730f0046a4a4a3fd2be40ce 100644
--- a/Telegram/SourceFiles/tele/tele_field_resize.h
+++ b/Telegram/SourceFiles/tele/tele_field_resize.h
@@ -9,6 +9,8 @@ class RpWidget;
 
 namespace Tele {
 
+class FieldResizeHandle;
+
 struct FieldResizeDescriptor {
 	not_null<Ui::RpWidget*> parent;
 	not_null<Ui::InputField*> field;
@@ -40,7 +42,7 @@ private:
 	const not_null<Ui::RpWidget*> _parent;
 	const not_null<Ui::InputField*> _field;
 	const Fn<void()> _apply;
-	base::unique_qptr<Ui::RpWidget> _handle;
+	base::unique_qptr<FieldResizeHandle> _handle;
 	int _max = 0;
 	int _appliedChosen = 0;
 	int _dragStartY = 0;
