new file mode 100644
index 0000000000000000000000000000000000000000..7361c2dcf96a128fa07d73a94815140d6aedc868
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mention_search.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include "base/timer.h"
+
+class ChannelData;
+class UserData;
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace Tele {
+
+class MentionSearch final {
+public:
+	MentionSearch(not_null<Main::Session*> session, Fn<void()> refresh);
+	~MentionSearch();
+
+	void setTopicRootId(Fn<MsgId()> callback);
+
+	[[nodiscard]] std::vector<not_null<UserData*>> results(
+		not_null<ChannelData*> channel,
+		const QString &query);
+	void cancel();
+
+private:
+	struct Key {
+		ChannelData *channel = nullptr;
+		int64 topicRootId = 0;
+		QString query;
+
+		friend inline bool operator<(const Key &a, const Key &b) {
+			return std::tie(a.channel, a.topicRootId, a.query)
+				< std::tie(b.channel, b.topicRootId, b.query);
+		}
+		friend inline bool operator==(const Key &a, const Key &b) {
+			return (a.channel == b.channel)
+				&& (a.topicRootId == b.topicRootId)
+				&& (a.query == b.query);
+		}
+	};
+	struct Entry {
+		std::vector<not_null<UserData*>> users;
+		crl::time received = 0;
+		bool complete = false;
+	};
+
+	[[nodiscard]] MsgId topicRootId(not_null<ChannelData*> channel) const;
+	[[nodiscard]] const Entry *fresh(const Key &key) const;
+	void send();
+
+	const not_null<Main::Session*> _session;
+	const Fn<void()> _refresh;
+	Fn<MsgId()> _topicRootId;
+	base::Timer _timer;
+	std::map<Key, Entry> _cache;
+	base::flat_set<not_null<ChannelData*>> _failed;
+	std::optional<Key> _pending;
+	mtpRequestId _requestId = 0;
+
+};
+
+} // namespace Tele
