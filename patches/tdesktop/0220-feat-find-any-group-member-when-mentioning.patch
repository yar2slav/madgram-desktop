diff --git a/Telegram/SourceFiles/tele/tele_mention_search.cpp b/Telegram/SourceFiles/tele/tele_mention_search.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..472ca7e3a474a72f44def435d18fb8415e4b1eb8
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mention_search.cpp
@@ -0,0 +1,164 @@
+#include "tele/tele_mention_search.h"
+
+#include "api/api_chat_participants.h"
+#include "apiwrap.h"
+#include "data/data_channel.h"
+#include "data/data_forum_topic.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kDelay = crl::time(300);
+constexpr auto kLimit = 50;
+constexpr auto kCacheLimit = 128;
+constexpr auto kCacheLifetime = crl::time(10 * 60 * 1000);
+
+[[nodiscard]] bool LocalListComplete(not_null<ChannelData*> channel) {
+	const auto count = channel->membersCount();
+	return channel->canViewMembers()
+		&& !channel->lastParticipantsRequestNeeded()
+		&& (count > 0)
+		&& (int(channel->mgInfo->lastParticipants.size()) >= count);
+}
+
+} // namespace
+
+MentionSearch::MentionSearch(
+	not_null<Main::Session*> session,
+	Fn<void()> refresh)
+: _session(session)
+, _refresh(std::move(refresh))
+, _timer([=] { send(); }) {
+}
+
+MentionSearch::~MentionSearch() {
+	cancel();
+}
+
+void MentionSearch::setTopicRootId(Fn<MsgId()> callback) {
+	_topicRootId = std::move(callback);
+}
+
+MsgId MentionSearch::topicRootId(not_null<ChannelData*> channel) const {
+	if (!_topicRootId || !channel->isForum()) {
+		return MsgId();
+	}
+	const auto id = _topicRootId();
+	return (id == Data::ForumTopic::kGeneralId) ? MsgId() : id;
+}
+
+auto MentionSearch::fresh(const Key &key) const -> const Entry* {
+	const auto i = _cache.find(key);
+	return (i != end(_cache)
+		&& crl::now() - i->second.received < kCacheLifetime)
+		? &i->second
+		: nullptr;
+}
+
+std::vector<not_null<UserData*>> MentionSearch::results(
+		not_null<ChannelData*> channel,
+		const QString &query) {
+	if (query.isEmpty()
+		|| !channel->isMegagroup()
+		|| channel->isMonoforum()
+		|| _failed.contains(channel)
+		|| LocalListComplete(channel)) {
+		cancel();
+		return {};
+	}
+	const auto key = Key{
+		.channel = channel,
+		.topicRootId = topicRootId(channel).bare,
+		.query = query,
+	};
+	if (const auto entry = fresh(key)) {
+		if (_pending && !(*_pending == key)) {
+			cancel();
+		}
+		return entry->users;
+	}
+	auto fallback = std::vector<not_null<UserData*>>();
+	if (const auto i = _cache.find(key); i != end(_cache)) {
+		fallback = i->second.users;
+	} else {
+		for (auto length = query.size() - 1; length > 0; --length) {
+			auto prefix = key;
+			prefix.query = query.left(length);
+			if (const auto entry = fresh(prefix)) {
+				if (entry->complete) {
+					cancel();
+					return entry->users;
+				}
+				fallback = entry->users;
+				break;
+			}
+		}
+	}
+	if (!_pending || !(*_pending == key)) {
+		cancel();
+		_pending = key;
+		_timer.callOnce(kDelay);
+	}
+	return fallback;
+}
+
+void MentionSearch::cancel() {
+	_timer.cancel();
+	if (_requestId) {
+		_session->api().request(base::take(_requestId)).cancel();
+	}
+	_pending = std::nullopt;
+}
+
+void MentionSearch::send() {
+	if (!_pending || _requestId) {
+		return;
+	}
+	const auto key = *_pending;
+	const auto channel = not_null(key.channel);
+	using Flag = MTPDchannelParticipantsMentions::Flag;
+	_requestId = _session->api().request(MTPchannels_GetParticipants(
+		channel->inputChannel(),
+		MTP_channelParticipantsMentions(
+			MTP_flags(Flag::f_q
+				| (key.topicRootId ? Flag::f_top_msg_id : Flag(0))),
+			MTP_string(key.query),
+			MTP_int(key.topicRootId)),
+		MTP_int(0),
+		MTP_int(kLimit),
+		MTP_long(0)
+	)).done([=](const MTPchannels_ChannelParticipants &result) {
+		_requestId = 0;
+		_pending = std::nullopt;
+		auto entry = Entry{ .received = crl::now() };
+		result.match([&](const MTPDchannels_channelParticipants &data) {
+			using Type = Api::ChatParticipant::Type;
+			const auto parsed = Api::ChatParticipants::Parse(channel, data);
+			for (const auto &participant : parsed.list) {
+				const auto type = participant.type();
+				if (participant.isUser()
+					&& type != Type::Left
+					&& type != Type::Banned) {
+					entry.users.push_back(
+						channel->owner().user(participant.userId()));
+				}
+			}
+			entry.complete = (int(parsed.list.size()) < kLimit);
+		}, [](const MTPDchannels_channelParticipantsNotModified &) {
+		});
+		if (_cache.size() >= kCacheLimit) {
+			_cache.clear();
+		}
+		_cache[key] = std::move(entry);
+		_refresh();
+	}).fail([=] {
+		_requestId = 0;
+		_pending = std::nullopt;
+		_failed.emplace(channel);
+	}).send();
+}
+
+} // namespace Tele
