From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "hello, i am forgotten" <me@thisisforgotten.com>
Date: Wed, 11 Nov 2026 20:49:45 +0300
Subject: [PATCH] feat: copy usernames in profiles as links

---
 Telegram/Resources/langs/mad_ru.json                   |  1 +
 .../SourceFiles/info/profile/info_profile_values.cpp   |  3 ++-
 Telegram/SourceFiles/settings/settings_tele.cpp        |  4 ++++
 Telegram/SourceFiles/tele/tele_options.cpp             | 10 ++++++++++
 Telegram/SourceFiles/tele/tele_options.h               |  2 ++
 Telegram/SourceFiles/tele/tele_settings_io.cpp         |  1 +
 6 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/Telegram/Resources/langs/mad_ru.json b/Telegram/Resources/langs/mad_ru.json
index 27c10d07b0c869c0a16e8f3bcf44d9617a425bdf..d98fe78e2a32042b6369e5860edffdea755cf353 100644
--- a/Telegram/Resources/langs/mad_ru.json
+++ b/Telegram/Resources/langs/mad_ru.json
@@ -150,6 +150,7 @@
   "Mutual": "Взаимный",
   "Not mutual": "Не взаимный",
   "Show if contacts are mutual": "Показывать, взаимный ли контакт",
+  "Copy usernames in profiles as links": "Копировать юзернеймы в профилях ссылкой",
   "Show when you joined chats": "Показывать дату вступления в чаты",
   "Chats you're not in show when they were created.": "Для чатов, где тебя нет, показывается дата создания.",
   "You joined": "Вы вступили",
diff --git a/Telegram/SourceFiles/info/profile/info_profile_values.cpp b/Telegram/SourceFiles/info/profile/info_profile_values.cpp
index d5df0145c07b11ee6ad135dabbb701b547dcb0bf..f7c71d12bf25715c3af86d67249109f3d8b92187 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_values.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_values.cpp
@@ -38,6 +38,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "boxes/peers/edit_peer_permissions_box.h"
 #include "base/unixtime.h"
 #include "tele/tele_birthdays.h"
+#include "tele/tele_options.h"
 #include "tele/tele_streamer_mode.h"
 #include "tele/tele_username_aliases.h"
 
@@ -210,7 +211,7 @@ QString UsernameUrl(
 	const auto type = (!peer->isUsernameEditable(username)
 			&& !Tele::IsServerUsername(peer, username))
 		? u"collectible_username"_q
-		: link
+		: (link || Tele::CopyUsernameAsLink())
 		? u"username_link"_q
 		: u"username_regular"_q;
 	return u"internal:"_q
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 4b2fc0ae1d41659443ae8d18ab06d32cb8ffa20b..5f39646c3710dd5156e4aefb50b02bd07fa5b2bf 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -3730,6 +3730,10 @@ void FillProfiles(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionMutualContact,
 		{ u"contact"_q, u"added"_q, u"back"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionCopyUsernameLink,
+		{ u"username"_q, u"link"_q, u"copy"_q, u"t.me"_q });
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionMediaUploadDate,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index afda6201ec01534c7abdb828d879df156039541d..f2ca3552fcb9b1f08f679aa9faa66e01617db623 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -113,6 +113,7 @@ const char kOptionAccountAge[] = "tele-account-age";
 const char kOptionChatJoinDate[] = "tele-chat-join-date";
 const char kOptionMemberJoinDate[] = "tele-member-join-date";
 const char kOptionMutualContact[] = "tele-mutual-contact";
+const char kOptionCopyUsernameLink[] = "tele-copy-username-link";
 const char kOptionMergeIdDc[] = "tele-merge-id-dc";
 const char kOptionMediaUploadDate[] = "tele-media-upload-date";
 const char kOptionMessageIdMenu[] = "tele-message-id-menu";
@@ -925,6 +926,11 @@ base::options::toggle MutualContactOption({
 	.name = "Show if contacts are mutual",
 });
 
+base::options::toggle CopyUsernameLinkOption({
+	.id = kOptionCopyUsernameLink,
+	.name = "Copy usernames in profiles as links",
+});
+
 base::options::toggle MergeIdDcOption({
 	.id = kOptionMergeIdDc,
 	.name = "ID and DC in one row",
@@ -2782,6 +2788,10 @@ rpl::producer<bool> MutualContactValue() {
 	});
 }
 
+bool CopyUsernameAsLink() {
+	return CopyUsernameLinkOption.value();
+}
+
 rpl::producer<bool> MergeIdDcValue() {
 	return rpl::single(
 		rpl::empty
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 762260aad275711d051777092c279f366ee18bf9..4c7e3e3d74163217e19972fd32543415c915e582 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -108,6 +108,7 @@ extern const char kOptionAccountAge[];
 extern const char kOptionChatJoinDate[];
 extern const char kOptionMemberJoinDate[];
 extern const char kOptionMutualContact[];
+extern const char kOptionCopyUsernameLink[];
 extern const char kOptionMergeIdDc[];
 extern const char kOptionMediaUploadDate[];
 extern const char kOptionMessageIdMenu[];
@@ -431,6 +432,7 @@ void SetMoneyHideBalances(bool hidden);
 [[nodiscard]] rpl::producer<bool> ChatJoinDateValue();
 [[nodiscard]] bool MemberJoinDate();
 [[nodiscard]] rpl::producer<bool> MutualContactValue();
+[[nodiscard]] bool CopyUsernameAsLink();
 [[nodiscard]] rpl::producer<bool> MergeIdDcValue();
 [[nodiscard]] bool MessageIdMenu();
 [[nodiscard]] bool MessageDetailsMenu();
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index 57f27081ead77df21ee521256be8c7b1b0c3c09c..e79a9881b2b7f50ab5df85d86dfa9ce9bffe3ef3 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
+++ b/Telegram/SourceFiles/tele/tele_settings_io.cpp
@@ -198,6 +198,7 @@ struct Spec {
 		Toggle(kOptionChatJoinDate),
 		Toggle(kOptionMemberJoinDate),
 		Toggle(kOptionMutualContact),
+		Toggle(kOptionCopyUsernameLink),
 		Toggle(kOptionMergeIdDc),
 		Toggle(kOptionMediaUploadDate),
 		Toggle(kOptionMessageIdMenu),
