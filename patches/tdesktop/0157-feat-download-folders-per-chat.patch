+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1ED0F1);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxEntries = quint32(65536);
+constexpr auto kMaxPathLength = 4096;
+constexpr auto kMaxNameLength = 64;
+constexpr auto kShownPathLength = 48;
+
+PeerId CurrentChat;
+
+class Store final {
+public:
+	explicit Store(not_null<Main::Session*> session);
+	~Store();
+
+	[[nodiscard]] static Store &Get(not_null<Main::Session*> session);
+
+	[[nodiscard]] QString folder(PeerId peer) const;
+	void setFolder(PeerId peer, const QString &path);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Registry();
+
+	[[nodiscard]] QString directory() const;
+	void read();
+	void write() const;
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<PeerId, QString> _folders;
+
+};
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+}
+
+Store::~Store() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Store::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>>();
+	return result;
+}
+
+Store &Store::Get(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry))
+		? *i->second
+		: *session->lifetime().make_state<Store>(session);
+}
+
+QString Store::folder(PeerId peer) const {
+	const auto i = _folders.find(peer);
+	return (i != end(_folders)) ? i->second : QString();
+}
+
+void Store::setFolder(PeerId peer, const QString &path) {
+	if (path.isEmpty()) {
+		if (!_folders.remove(peer)) {
+			return;
+		}
+	} else if (folder(peer) == path) {
+		return;
+	} else {
+		_folders[peer] = path;
+	}
+	write();
+}
+
+QString Store::directory() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void Store::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(
+			file,
+			u"tele_download_folders"_q,
+			directory(),
+			key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxEntries) {
+		return;
+	}
+	auto folders = base::flat_map<PeerId, QString>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto peer = quint64();
+		auto path = QString();
+		file.stream >> peer >> path;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (peer && !path.isEmpty() && path.size() <= kMaxPathLength) {
+			folders.emplace(PeerId(PeerIdHelper(peer)), path);
+		}
+	}
+	_folders = std::move(folders);
+}
+
+void Store::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &[peer, path] : _folders) {
+		size += sizeof(quint64) + sizeof(quint32);
+		size += path.size() * sizeof(ushort);
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_folders.size());
+	for (const auto &[peer, path] : _folders) {
+		data.stream << quint64(peer.value) << path;
+	}
+	auto file = FileWriteDescriptor(u"tele_download_folders"_q, directory());
+	file.writeEncrypted(data, key);
+}
+
+[[nodiscard]] QString WithSlash(const QString &path) {
+	return (path.isEmpty() || path.endsWith('/')) ? path : (path + '/');
+}
+
+[[nodiscard]] QString WithoutSlash(const QString &path) {
+	return path.endsWith('/') ? path.chopped(1) : path;
+}
+
+[[nodiscard]] bool IsReservedName(const QString &name) {
+	const auto base = name.section('.', 0, 0).trimmed().toUpper();
+	if (base == u"CON"_q
+		|| base == u"PRN"_q
+		|| base == u"AUX"_q
+		|| base == u"NUL"_q) {
+		return true;
+	}
+	return (base.size() == 4)
+		&& (base.startsWith(u"COM"_q) || base.startsWith(u"LPT"_q))
+		&& (base[3] >= QChar('1') && base[3] <= QChar('9'));
+}
+
+[[nodiscard]] QString SanitizeName(const QString &name) {
+	const auto illegal = u"<>:\"/\\|?*"_q;
+	auto result = QString();
+	result.reserve(name.size());
+	for (const auto &ch : name) {
+		const auto category = ch.category();
+		if (ch.unicode() < 0x20
+			|| category == QChar::Other_Control
+			|| category == QChar::Other_Format
+			|| illegal.contains(ch)) {
+			continue;
+		}
+		result.append(ch);
+	}
+	result = result.simplified();
+	if (result.size() > kMaxNameLength) {
+		result.truncate(kMaxNameLength);
+		if (result.at(result.size() - 1).isHighSurrogate()) {
+			result.chop(1);
+		}
+	}
+	auto from = 0;
+	while (from < result.size() && result[from] == QChar('.')) {
+		++from;
+	}
+	auto till = result.size();
+	while (till > from
+		&& (result[till - 1] == QChar('.')
+			|| result[till - 1] == QChar(' '))) {
+		--till;
+	}
+	result = result.mid(from, till - from).trimmed();
+	return IsReservedName(result) ? (result + '_') : result;
+}
+
+[[nodiscard]] QString ChatFolderName(
+		not_null<Main::Session*> session,
+		PeerId peer) {
+	const auto loaded = session->data().peerLoaded(peer);
+	const auto name = loaded ? SanitizeName(loaded->name()) : QString();
+	return name.isEmpty()
+		? QString::number(int64(peer.value & PeerId::kChatTypeMask))
+		: name;
+}
+
+[[nodiscard]] QString CustomFolder(
+		not_null<Main::Session*> session,
+		PeerId peer) {
+	const auto path = Store::Get(session).folder(peer);
+	return (!path.isEmpty() && QDir().mkpath(path)) ? path : QString();
+}
+
+[[nodiscard]] QString BaseDownloadPath(not_null<Main::Session*> session) {
+	const auto path = Core::App().settings().downloadPath();
+	return path.isEmpty()
+		? File::DefaultDownloadPath(session)
+		: (path == FileDialog::Tmp())
+		? session->local().tempDirectory()
+		: path;
+}
+
+void ChooseFolder(
+		not_null<Window::SessionController*> controller,
+		PeerId peer) {
+	const auto session = &controller->session();
+	const auto current = Store::Get(session).folder(peer);
+	const auto initial = current.isEmpty()
+		? BaseDownloadPath(session)
+		: current;
+	FileDialog::GetFolder(
+		controller->window().widget().get(),
+		tr::lng_download_path_choose(tr::now),
+		WithoutSlash(initial),
+		crl::guard(session, [=](QString &&result) {
+			if (!result.isEmpty()) {
+				Store::Get(session).setFolder(peer, WithSlash(result));
+			}
+		}));
+}
+
+[[nodiscard]] QString ShownPath(const QString &path) {
+	const auto native = QDir::toNativeSeparators(WithoutSlash(path));
+	if (native.size() <= kShownPathLength) {
+		return native;
+	}
+	const auto tail = kShownPathLength * 2 / 3;
+	const auto head = kShownPathLength - tail - 1;
+	return native.left(head) + QChar(0x2026) + native.right(tail);
+}
+
+} // namespace
+
+DownloadChat::DownloadChat(PeerId peer)
+: _was(std::exchange(CurrentChat, peer)) {
+}
+
+DownloadChat::DownloadChat(const Data::FileOrigin &origin)
+: DownloadChat([&] {
+	const auto message = std::get_if<Data::FileOriginMessage>(&origin.data);
+	return message ? message->peer : PeerId();
+}()) {
+}
+
+DownloadChat::~DownloadChat() {
+	CurrentChat = _was;
+}
+
+QString ChatDownloadPath(
+		not_null<Main::Session*> session,
+		const QString &path) {
+	return ChatDownloadPath(session, CurrentChat, path);
+}
+
+QString ChatDownloadPath(
+		not_null<Main::Session*> session,
+		PeerId peer,
+		const QString &path) {
+	if (!peer || path.isEmpty()) {
+		return path;
+	}
+	const auto custom = CustomFolder(session, peer);
+	if (!custom.isEmpty()) {
+		return custom;
+	} else if (!DownloadsPerChat()
+		|| (WithSlash(path) == WithSlash(session->local().tempDirectory()))) {
+		return path;
+	}
+	return WithSlash(path) + ChatFolderName(session, peer) + '/';
+}
+
+QString AutoDownloadFileName(
+		not_null<DocumentData*> document,
+		const Data::FileOrigin &origin,
+		const QString &filename,
+		bool fromCloud) {
+	if (filename.isEmpty() || !fromCloud) {
+		return filename;
+	}
+	const auto chat = DownloadChat(origin);
+	const auto session = &document->session();
+	const auto applies = CurrentChat
+		&& (DownloadsPerChat()
+			|| !Store::Get(session).folder(CurrentChat).isEmpty());
+	return applies ? DocumentFileNameForSave(document) : filename;
+}
+
+void AddDownloadFolderAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer) {
+		return;
+	}
+	const auto id = peer->id;
+	const auto current = Store::Get(&peer->session()).folder(id);
+	const auto weak = base::make_weak(controller);
+	const auto choose = [=] {
+		if (const auto strong = weak.get()) {
+			ChooseFolder(strong, id);
+		}
+	};
+	const auto text = Lower(u"Download folder"_q);
+	if (current.isEmpty()) {
+		addAction(text + QChar(0x2026), choose, &st::menuIconDownload);
+		return;
+	}
+	addAction({
+		.text = text,
+		.handler = nullptr,
+		.icon = &st::menuIconDownload,
+		.fillSubmenu = [=](not_null<Ui::PopupMenu*> menu) {
+			menu->addAction(ShownPath(current), [=] {
+				QDesktopServices::openUrl(QUrl::fromLocalFile(current));
+			}, &st::menuIconShowInFolder);
+			menu->addAction(
+				Lower(u"Change folder"_q) + QChar(0x2026),
+				choose,
+				&st::menuIconEdit);
+			menu->addAction(Lower(u"Reset"_q), [=] {
+				if (const auto strong = weak.get()) {
+					Store::Get(&strong->session()).setFolder(id, QString());
+				}
+			}, &st::menuIconRestore);
+		},
+	});
+}
+
+} // namespace Tele
