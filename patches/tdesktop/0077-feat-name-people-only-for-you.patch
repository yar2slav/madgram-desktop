@@ -0,0 +1,325 @@
+#include "tele/tele_local_names.h"
+
+#include "core/application.h"
+#include "data/data_changes.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "lang/lang_keys.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/text/text_entity.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtCore/QUrl>
+
+namespace Tele {
+namespace {
+
+constexpr auto kTestBit = BareId(1) << 63;
+constexpr auto kMaxNameLength = 64;
+
+using Key = BareId;
+using Map = base::flat_map<Key, QString>;
+
+struct State {
+	State();
+
+	Map names;
+	bool loaded = false;
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+};
+
+template <typename Callback>
+void EnumerateSessions(Callback &&callback) {
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			callback(not_null<Main::Session*>(session));
+		}
+	}
+}
+
+[[nodiscard]] Key MakeKey(PeerId id, bool test) {
+	return id.value | (test ? kTestBit : Key());
+}
+
+[[nodiscard]] PeerId KeyPeer(Key key) {
+	return PeerId(key & ~kTestBit);
+}
+
+[[nodiscard]] QString NormalizeName(const QString &name) {
+	return TextUtilities::SingleLine(name).trimmed();
+}
+
+[[nodiscard]] bool IsValidName(const QString &name) {
+	return !name.isEmpty() && name.size() <= kMaxNameLength;
+}
+
+[[nodiscard]] Map Parse(const QString &value) {
+	auto result = Map();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto entry = part.trimmed();
+		const auto test = entry.startsWith(u"test:"_q);
+		if (test) {
+			entry = entry.mid(5);
+		}
+		const auto pair = entry.split(QChar('='));
+		if (pair.size() != 2) {
+			continue;
+		}
+		auto ok = false;
+		const auto id = pair[0].trimmed().toLongLong(&ok);
+		const auto name = NormalizeName(QString::fromUtf8(
+			QByteArray::fromPercentEncoding(pair[1].trimmed().toLatin1())));
+		if (ok && id > 0 && IsValidName(name)) {
+			result[MakeKey(peerFromUser(UserId(uint64(id))), test)] = name;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Serialize(const Map &names) {
+	auto list = QStringList();
+	list.reserve(int(names.size()));
+	for (const auto &[key, name] : names) {
+		list.push_back(((key & kTestBit) ? u"test:"_q : QString())
+			+ QString::number(peerToUser(KeyPeer(key)).bare)
+			+ '='
+			+ QString::fromLatin1(QUrl::toPercentEncoding(name)));
+	}
+	return list.join(QChar(','));
+}
+
+void Refresh(not_null<UserData*> user) {
+	user->setName(
+		user->firstName,
+		user->lastName,
+		user->nameOrPhone,
+		user->editableUsername());
+}
+
+void RefreshChanged(const Map &was, const Map &now) {
+	auto keys = base::flat_set<Key>();
+	for (const auto &[key, name] : was) {
+		const auto i = now.find(key);
+		if (i == end(now) || i->second != name) {
+			keys.emplace(key);
+		}
+	}
+	for (const auto &[key, name] : now) {
+		if (!was.contains(key)) {
+			keys.emplace(key);
+		}
+	}
+	if (keys.empty()) {
+		return;
+	}
+	EnumerateSessions([&](not_null<Main::Session*> session) {
+		const auto test = session->isTestMode();
+		for (const auto key : keys) {
+			if (bool(key & kTestBit) != test) {
+				continue;
+			}
+			const auto id = peerToUser(KeyPeer(key));
+			if (const auto user = session->data().userLoaded(id)) {
+				Refresh(user);
+			}
+		}
+	});
+}
+
+State::State() {
+	LocalNamesValue(
+	) | rpl::on_next([=](const QString &value) {
+		auto now = Parse(value);
+		const auto was = std::exchange(names, std::move(now));
+		if (loaded) {
+			RefreshChanged(was, names);
+		}
+		loaded = true;
+		changes.fire({});
+	}, lifetime);
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+[[nodiscard]] const QString *Lookup(not_null<const UserData*> user) {
+	const auto &names = Get().names;
+	if (names.empty()) {
+		return nullptr;
+	}
+	const auto &session = user->session();
+	if (user->id == session.userPeerId()) {
+		return nullptr;
+	}
+	const auto i = names.find(MakeKey(user->id, session.isTestMode()));
+	return (i != end(names)) ? &i->second : nullptr;
+}
+
+[[nodiscard]] QString RealName(not_null<const UserData*> user) {
+	return langFullName(user->firstName, user->lastName);
+}
+
+void Save(Map names) {
+	SetLocalNames(Serialize(names));
+}
+
+void SetLocalName(not_null<UserData*> user, const QString &name) {
+	auto names = Get().names;
+	const auto key = MakeKey(user->id, user->session().isTestMode());
+	if (name.isEmpty() || name == RealName(user)) {
+		if (!names.remove(key)) {
+			return;
+		}
+	} else {
+		names[key] = name;
+	}
+	Save(std::move(names));
+}
+
+void LocalNameBox(not_null<Ui::GenericBox*> box, not_null<UserData*> user) {
+	const auto has = HasLocalName(user);
+	box->setTitle(rpl::single(Lower(u"Name only you see"_q)));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Name"_q)),
+		user->name()));
+	field->setMaxLength(kMaxNameLength);
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Real name: "_q)
+			+ RealName(user)
+			+ u"\n"_q
+			+ Lower(u"Nothing is sent to Telegram, only this app shows "
+				"the name."_q),
+		st::boxDividerLabel));
+	const auto save = [=] {
+		const auto name = NormalizeName(field->getLastText());
+		if (name.isEmpty()) {
+			field->showError();
+			return;
+		}
+		SetLocalName(user, name);
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+		field->selectAll();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	if (has) {
+		box->addLeftButton(rpl::single(Lower(u"Reset"_q)), [=] {
+			SetLocalName(user, QString());
+			box->closeBox();
+		});
+	}
+}
+
+} // namespace
+
+QString ApplyLocalName(
+		not_null<const UserData*> user,
+		const QString &name) {
+	const auto local = Lookup(user);
+	return local ? *local : name;
+}
+
+bool HasLocalName(not_null<const UserData*> user) {
+	return Lookup(user) != nullptr;
+}
+
+QString LocalRealName(not_null<const UserData*> user) {
+	return HasLocalName(user) ? RealName(user) : QString();
+}
+
+rpl::producer<TextWithEntities> LocalRealNameValue(
+		not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	if (!user) {
+		return rpl::single(TextWithEntities());
+	}
+	return rpl::merge(
+		peer->session().changes().peerFlagsValue(
+			peer,
+			Data::PeerUpdate::Flag::Name
+		) | rpl::to_empty,
+		LocalNamesChanges()
+	) | rpl::map([=] {
+		return TextWithEntities{ LocalRealName(user) };
+	});
+}
+
+std::vector<LocalNameEntry> LocalNames(not_null<Main::Session*> session) {
+	auto result = std::vector<LocalNameEntry>();
+	const auto test = session->isTestMode();
+	for (const auto &[key, name] : Get().names) {
+		if (bool(key & kTestBit) == test) {
+			result.push_back({ KeyPeer(key), name });
+		}
+	}
+	return result;
+}
+
+rpl::producer<> LocalNamesChanges() {
+	return Get().changes.events();
+}
+
+rpl::producer<int> LocalNamesCountValue(not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		LocalNamesChanges()
+	) | rpl::map([=] {
+		return int(LocalNames(session).size());
+	});
+}
+
+void RemoveLocalName(not_null<Main::Session*> session, PeerId id) {
+	auto names = Get().names;
+	if (names.remove(MakeKey(id, session->isTestMode()))) {
+		Save(std::move(names));
+	}
+}
+
+void AddLocalNameAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	if (!user || user->isSelf()) {
+		return;
+	}
+	const auto weak = base::make_weak(controller);
+	addAction(Lower(u"Set a name for me"_q) + QChar(0x2026), [=] {
+		if (const auto strong = weak.get()) {
+			strong->show(Box(LocalNameBox, not_null(user)));
+		}
+	}, &st::menuIconEdit);
+}
+
+} // namespace Tele
