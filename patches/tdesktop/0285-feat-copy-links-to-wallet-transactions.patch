+#include "tele/tele_wallet_links.h"
+
+#include "base/unique_qptr.h"
+#include "lang/lang_keys.h"
+#include "main/session/session_show.h"
+#include "tele/tele_notices.h"
+#include "ui/basic_click_handlers.h"
+#include "ui/text/text_entity.h"
+#include "ui/text/text_utilities.h"
+#include "ui/widgets/popup_menu.h"
+#include "ui/rp_widget.h"
+#include "wallet/wallet_palette.h"
+#include "styles/style_chat_helpers.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_widgets.h"
+
+#include <QtGui/QCursor>
+
+namespace Tele {
+
+QString WalletTransactionUrl(const QByteArray &hash) {
+	return hash.isEmpty()
+		? QString()
+		: (u"https://tonscan.org/tx/"_q + QString::fromLatin1(hash.toHex()));
+}
+
+QString WalletAddressUrl(const QString &friendly) {
+	return friendly.isEmpty()
+		? QString()
+		: (u"https://tonscan.org/address/"_q + friendly);
+}
+
+void AddWalletTransactionCopyLink(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		const QString &url) {
+	menu->addAction(tr::lng_context_copy_link(tr::now), [=] {
+		TextUtilities::SetClipboardText(TextForMimeData::Simple(url));
+		ShowCopiedToast(show, {
+			.text = { tr::lng_background_link_copied(tr::now) },
+			.iconLottie = u"toast/voip_invite"_q,
+			.iconLottieSize = st::toastLottieIconSize,
+		}, { url });
+	}, &st::menuIconLink);
+}
+
+void SetupWalletTransactionMenu(
+		not_null<Ui::RpWidget*> row,
+		std::shared_ptr<Main::SessionShow> show,
+		Fn<QByteArray()> hash) {
+	const auto menu = row->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	row->events(
+	) | rpl::filter([](not_null<QEvent*> e) {
+		return e->type() == QEvent::ContextMenu;
+	}) | rpl::on_next([=](not_null<QEvent*> e) {
+		const auto url = WalletTransactionUrl(hash());
+		if (url.isEmpty()) {
+			return;
+		}
+		*menu = base::make_unique_q<Ui::PopupMenu>(
+			row,
+			st::popupMenuWithIcons);
+		const auto raw = menu->get();
+		AddWalletTransactionCopyLink(raw, show, url);
+		raw->addAction(
+			Ui::Text::FixAmpersandInAction(
+				tr::lng_channel_earn_history_out_button(tr::now)),
+			[=] { UrlClickHandler::Open(url); },
+			&st::menuIconSearch);
+		const auto scope = Wallet::WindowPaletteScope(row);
+		raw->popup(QCursor::pos());
+		e->accept();
+	}, row->lifetime());
+}
+
+} // namespace Tele
