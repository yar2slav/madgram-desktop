+namespace Tele {
+namespace {
+
+[[nodiscard]] ChannelData *RestrictChannel(
+		PeerData *group,
+		not_null<PeerData*> participant) {
+	const auto channel = group ? group->asMegagroup() : nullptr;
+	const auto user = participant->asUser();
+	if (!RestrictMenu()
+		|| !channel
+		|| !user
+		|| user->isSelf()
+		|| !channel->canBanMembers()) {
+		return nullptr;
+	}
+	const auto info = channel->mgInfo.get();
+	if (info && info->creator == user) {
+		return nullptr;
+	} else if (info
+		&& info->lastAdmins.contains(user)
+		&& !channel->canEditAdmin(user)) {
+		return nullptr;
+	}
+	return channel;
+}
+
+void ShowRestrictBox(
+		not_null<Window::SessionController*> controller,
+		not_null<ChannelData*> channel,
+		not_null<UserData*> user) {
+	const auto weak = base::make_weak(controller);
+	const auto show = [=](
+			bool hasAdminRights,
+			ChatRestrictionsInfo currentRights,
+			UserData *by,
+			TimeId since) {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		auto box = Box<EditRestrictedBox>(
+			channel,
+			user,
+			hasAdminRights,
+			currentRights,
+			QString(),
+			by,
+			since);
+		const auto weakBox = std::make_shared<
+			base::weak_qptr<Ui::BoxContent>>();
+		const auto close = [=] {
+			if (const auto box = weakBox->get()) {
+				box->closeBox();
+			}
+		};
+		if (!hasAdminRights) {
+			box->setSaveCallback(SaveRestrictedCallback(
+				strong->uiShow(),
+				channel,
+				user,
+				[=](ChatRestrictionsInfo) { close(); },
+				close));
+		}
+		*weakBox = strong->show(std::move(box));
+	};
+	channel->session().api().request(MTPchannels_GetParticipant(
+		channel->inputChannel(),
+		user->input()
+	)).done([=](const MTPchannels_ChannelParticipant &result) {
+		channel->owner().processUsers(result.data().vusers());
+		const auto participant = Api::ChatParticipant(
+			result.data().vparticipant(),
+			user);
+		using Type = Api::ChatParticipant::Type;
+		if (participant.type() == Type::Creator
+			|| participant.type() == Type::Admin) {
+			show(true, {}, nullptr, 0);
+		} else {
+			show(
+				false,
+				participant.restrictions(),
+				channel->owner().userLoaded(participant.by()),
+				participant.restrictedSince());
+		}
+	}).fail([=] {
+		show(false, {}, nullptr, 0);
+	}).send();
+}
+
+} // namespace
+
+UserData *LoadedUserById(
+		not_null<Main::Session*> session,
+		const QString &query) {
+	auto digits = query.trimmed();
+	digits.remove(' ');
+	if (digits.isEmpty() || digits.size() > 20) {
+		return nullptr;
+	}
+	for (const auto ch : digits) {
+		if (!ch.isDigit()) {
+			return nullptr;
+		}
+	}
+	auto ok = false;
+	const auto id = digits.toULongLong(&ok);
+	return (ok && id) ? session->data().userLoaded(UserId(id)) : nullptr;
+}
+
+void AddRestrictAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *group,
+		not_null<PeerData*> participant,
+		const Window::PeerMenuCallback &addAction) {
+	const auto channel = RestrictChannel(group, participant);
+	if (!channel) {
+		return;
+	}
+	const auto user = participant->asUser();
+	addAction(tr::lng_context_restrict_user(tr::now), [=] {
+		ShowRestrictBox(controller, channel, user);
+	}, &st::menuIconPermissions);
+}
+
+void AddRestrictAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionController*> controller,
+		not_null<HistoryItem*> item) {
+	const auto from = item->from();
+	const auto channel = item->isRegular()
+		? RestrictChannel(item->history()->peer, from)
+		: nullptr;
+	if (!channel) {
+		return;
+	}
+	const auto user = from->asUser();
+	menu->addAction(tr::lng_context_restrict_user(tr::now), [=] {
+		ShowRestrictBox(controller, channel, user);
+	}, &st::menuIconPermissions);
+	TagLastMenuAction(menu, u"restrict"_q);
+}
+
+} // namespace Tele
