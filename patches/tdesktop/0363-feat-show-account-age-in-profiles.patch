diff --git a/Telegram/SourceFiles/tele/tele_account_age.cpp b/Telegram/SourceFiles/tele/tele_account_age.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cb40680c266bec40c852aa0285d237dfddeba4ab
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_account_age.cpp
@@ -0,0 +1,79 @@
+#include "tele/tele_account_age.h"
+
+#include "data/data_user.h"
+#include "lang/lang_keys.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+struct Anchor {
+	uint64 id = 0;
+	int months = 0;
+};
+
+[[nodiscard]] constexpr int Months(int year, int month) {
+	return year * 12 + (month - 1);
+}
+
+constexpr auto kAnchors = std::array{
+	Anchor{ 0ULL, Months(2013, 8) },
+	Anchor{ 10'000'000ULL, Months(2013, 12) },
+	Anchor{ 50'000'000ULL, Months(2014, 8) },
+	Anchor{ 100'000'000ULL, Months(2015, 3) },
+	Anchor{ 150'000'000ULL, Months(2016, 1) },
+	Anchor{ 200'000'000ULL, Months(2016, 5) },
+	Anchor{ 300'000'000ULL, Months(2016, 12) },
+	Anchor{ 400'000'000ULL, Months(2017, 7) },
+	Anchor{ 600'000'000ULL, Months(2018, 6) },
+	Anchor{ 800'000'000ULL, Months(2019, 1) },
+	Anchor{ 950'000'000ULL, Months(2019, 8) },
+	Anchor{ 1'100'000'000ULL, Months(2020, 3) },
+	Anchor{ 1'400'000'000ULL, Months(2020, 10) },
+	Anchor{ 1'700'000'000ULL, Months(2021, 4) },
+	Anchor{ 2'000'000'000ULL, Months(2021, 9) },
+	Anchor{ 2'147'483'647ULL, Months(2022, 1) },
+	Anchor{ 5'000'000'000ULL, Months(2022, 2) },
+	Anchor{ 6'000'000'000ULL, Months(2023, 2) },
+	Anchor{ 7'000'000'000ULL, Months(2024, 2) },
+	Anchor{ 8'000'000'000ULL, Months(2025, 3) },
+};
+
+[[nodiscard]] int Interpolate(const Anchor &from, const Anchor &to, uint64 id) {
+	const auto progress = double(id - from.id) / double(to.id - from.id);
+	return from.months
+		+ int(std::round(progress * (to.months - from.months)));
+}
+
+[[nodiscard]] int EstimateMonths(uint64 id) {
+	for (auto i = 1; i != int(kAnchors.size()); ++i) {
+		if (id <= kAnchors[i].id) {
+			return Interpolate(kAnchors[i - 1], kAnchors[i], id);
+		}
+	}
+	const auto now = QDate::currentDate();
+	return std::min(
+		Interpolate(kAnchors[kAnchors.size() - 2], kAnchors.back(), id),
+		Months(now.year(), now.month()));
+}
+
+} // namespace
+
+rpl::producer<TextWithEntities> AccountAgeTextValue(
+		not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	if (!user || user->isServiceUser()) {
+		return rpl::single(TextWithEntities());
+	}
+	const auto id = peerToUser(user->id).bare;
+	return AccountAgeValue() | rpl::map([=](bool shown) {
+		if (!shown) {
+			return TextWithEntities();
+		}
+		const auto months = EstimateMonths(id);
+		return TextWithEntities::Simple(u"≈ "_q
+			+ langMonthOfYearFull(months % 12 + 1, months / 12));
+	});
+}
+
+} // namespace Tele
