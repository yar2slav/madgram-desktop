+[[nodiscard]] bool UpdatedFromOlderTele() {
+	return (ChangelogShown() > 0) || !ChangelogAccounts().isEmpty();
+}
+
+[[nodiscard]] std::vector<QString> CurrentIds() {
+	auto result = SettingIds();
+	for (const auto &id : ::Settings::TeleCategoryIds()) {
+		result.push_back(id);
+	}
+	return result;
+}
+
+[[nodiscard]] base::flat_set<QString> ParseIds(const QJsonValue &value) {
+	auto result = base::flat_set<QString>();
+	for (const auto &id : value.toArray()) {
+		if (id.isString()) {
+			result.emplace(id.toString());
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QJsonArray SerializeIds(const std::vector<QString> &ids) {
+	auto result = QJsonArray();
+	for (const auto &id : ids) {
+		result.push_back(id);
+	}
+	return result;
+}
+
+void Write(const std::vector<QString> &fresh, bool seen) {
+	auto object = QJsonObject();
+	object.insert(u"known"_q, SerializeIds(CurrentIds()));
+	object.insert(u"new"_q, SerializeIds(fresh));
+	object.insert(u"seen"_q, seen);
+	SetKnownSettings(QString::fromUtf8(
+		QJsonDocument(object).toJson(QJsonDocument::Compact)));
+}
+
+} // namespace
+
+void StartNewSettings() {
+	auto &state = Current();
+	if (state.started) {
+		return;
+	}
+	state.started = true;
+	const auto document = QJsonDocument::fromJson(KnownSettings().toUtf8());
+	const auto object = document.object();
+	if (!document.isObject() || !object.value(u"known"_q).isArray()) {
+		if (UpdatedFromOlderTele()) {
+			for (const auto &id : CurrentIds()) {
+				const auto known = ranges::contains(
+					kTele10Settings,
+					id,
+					[](const char *value) { return QString::fromLatin1(value); });
+				if (!known) {
+					state.fresh.push_back(id);
+				}
+			}
+		}
+		Write(state.fresh, false);
+		return;
+	}
+	const auto known = ParseIds(object.value(u"known"_q));
+	const auto previous = object.value(u"seen"_q).toBool()
+		? base::flat_set<QString>()
+		: ParseIds(object.value(u"new"_q));
+	for (const auto &id : CurrentIds()) {
+		if (!known.contains(id) || previous.contains(id)) {
+			state.fresh.push_back(id);
+		}
+	}
+	Write(state.fresh, false);
+}
+
+const std::vector<QString> &NewSettings() {
+	StartNewSettings();
+	return Current().fresh;
+}
+
+QString NewSettingsTitle() {
+	return Lower((BuildNumber() > 0)
+		? u"New in tele %1"_q.arg(BuildNumber())
+		: u"New in tele"_q);
+}
+
+QString NewSettingsLink() {
+	return u"tg://settings/tele/new"_q;
+}
+
+rpl::producer<bool> NewSettingsSeenValue() {
+	return Current().seen.value();
+}
+
+void MarkNewSettingsSeen() {
+	auto &state = Current();
+	if (state.seen.current() || NewSettings().empty()) {
+		return;
+	}
+	state.seen = true;
+	Write(state.fresh, true);
+}
