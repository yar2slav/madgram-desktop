+			}
+		}
+	}
+	const auto group = [&](
+			const QString &title,
+			Type section,
+			const BuildHelper &helper,
+			void (*fill)(SectionBuilder&)) {
+		auto picked = base::flat_set<QString>();
+		auto highlight = QString();
+		for (const auto &entry : helper.index(session)) {
+			if (ids.contains(entry.id)) {
+				if (highlight.isEmpty()) {
+					highlight = entry.id;
+				}
+				picked.emplace(entry.id);
