+	if (!pages.empty()) {
+		AddNewGroupDivider(builder, first);
+		builder.addSubsectionTitle(rpl::single(
+			::Tele::Lower(u"New pages"_q)));
+		for (const auto &page : pages) {
+			const auto button = builder.addSectionButton({
+				.title = rpl::single(::Tele::Lower(page->title)),
+				.targetSection = page->id,
