+[[nodiscard]] QMargins CodeLinesPadding(
+		const QString &code,
+		int total,
+		const style::TextStyle &st) {
+	if (!CodeLineNumbers()
+		|| (total <= 0 && CountLines(code) < kMinLines)) {
+		return QMargins();
+	}
+	const auto lines = (total > 0)
+		? total
+		: (int(ranges::count_if(code, Ui::Text::IsNewline)) + 1);
+	const auto digits = int(QString::number(lines).size());
+	const auto font = st.font->monospace();
+	return QMargins(
+		font->width(QString(digits, QChar('0'))) + GutterGap(),
+		0,
+		0,
+		0);
+}
