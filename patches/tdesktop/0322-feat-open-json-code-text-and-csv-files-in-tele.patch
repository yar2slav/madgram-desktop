+		{ u"ini"_q, u"ini"_q },
+		{ u"cfg"_q, u"ini"_q },
+		{ u"conf"_q, u"ini"_q },
+		{ u"properties"_q, u"properties"_q },
+		{ u"diff"_q, u"diff"_q },
+		{ u"patch"_q, u"diff"_q },
+		{ u"gradle"_q, u"groovy"_q },
+		{ u"groovy"_q, u"groovy"_q },
+		{ u"cmake"_q, u"cmake"_q },
+		{ u"tex"_q, u"latex"_q },
+		{ u"proto"_q, u"protobuf"_q },
+		{ u"tf"_q, u"hcl"_q },
+		{ u"jsonc"_q, u"json"_q },
+		{ u"json5"_q, u"json"_q },
+		{ u"jsonl"_q, u"json"_q },
+		{ u"ndjson"_q, u"json"_q },
+		{ u"geojson"_q, u"json"_q },
+		{ u"webmanifest"_q, u"json"_q },
+	};
+	return result;
+}
+
+[[nodiscard]] std::optional<Format> Lookup(const QString &fileName) {
+	const auto lower = fileName.toLower();
+	if (lower == u"dockerfile"_q) {
+		return Format{ .kind = Kind::Code, .language = u"docker"_q };
+	} else if (lower == u"makefile"_q || lower == u"gnumakefile"_q) {
+		return Format{ .kind = Kind::Code, .language = u"makefile"_q };
+	} else if (lower == u"cmakelists.txt"_q) {
+		return Format{ .kind = Kind::Code, .language = u"cmake"_q };
+	}
+	const auto dot = lower.lastIndexOf(QChar('.'));
+	if (dot < 0) {
+		return std::nullopt;
+	}
+	const auto suffix = lower.mid(dot + 1);
+	if (suffix == u"json"_q) {
+		return Format{ .kind = Kind::Json, .language = u"json"_q };
+	} else if (suffix == u"txt"_q
+		|| suffix == u"text"_q
+		|| suffix == u"log"_q
+		|| suffix == u"out"_q
+		|| suffix == u"err"_q
+		|| suffix == u"nfo"_q) {
+		return Format{ .kind = Kind::Text };
+	} else if (suffix == u"csv"_q) {
+		return Format{ .kind = Kind::Table };
+	} else if (suffix == u"tsv"_q || suffix == u"tab"_q) {
+		return Format{ .kind = Kind::Table, .delimiter = QChar('\t') };
+	}
+	const auto &languages = CodeLanguages();
+	const auto i = languages.find(suffix);
+	if (i != end(languages)) {
+		return Format{ .kind = Kind::Code, .language = i->second };
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QString FromUtf16(const QByteArray &bytes, bool big) {
+	auto result = QString();
+	result.reserve(bytes.size() / 2);
+	for (auto i = 2; i + 1 < bytes.size(); i += 2) {
+		const auto first = uchar(bytes[i]);
+		const auto second = uchar(bytes[i + 1]);
+		result.append(QChar(big
+			? ushort((first << 8) | second)
+			: ushort((second << 8) | first)));
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QString> DecodeText(const QByteArray &bytes) {
+	if (bytes.startsWith("\xFF\xFE")) {
+		return FromUtf16(bytes, false);
+	} else if (bytes.startsWith("\xFE\xFF")) {
+		return FromUtf16(bytes, true);
+	} else if (bytes.contains('\0')) {
+		return std::nullopt;
+	}
+	return QString::fromUtf8(bytes.startsWith("\xEF\xBB\xBF")
+		? bytes.mid(3)
+		: bytes);
+}
+
+[[nodiscard]] QString NormalizeLines(QString text) {
+	text.replace(u"\r\n"_q, u"\n"_q);
+	text.replace(QChar('\r'), QChar('\n'));
+	return text;
+}
+
+[[nodiscard]] QString Fence(QStringView text, const QString &info) {
+	auto longest = 0;
+	auto run = 0;
+	for (const auto ch : text) {
+		if (ch == QChar('`')) {
+			longest = std::max(longest, ++run);
+		} else {
+			run = 0;
+		}
+	}
+	const auto fence = QString(std::max(3, longest + 1), QChar('`'));
+	auto result = fence + info + QChar('\n');
+	result.append(text.data(), int(text.size()));
+	if (!text.endsWith(QChar('\n'))) {
+		result += QChar('\n');
+	}
+	return result + fence + QChar('\n');
+}
+
+[[nodiscard]] int PartLength(QStringView text) {
+	const auto count = int(text.size());
+	auto width = 0;
+	auto lines = 0;
+	auto cut = 0;
+	auto blank = 0;
+	auto i = 0;
+	for (; i != count; ++i) {
+		const auto ch = text[i];
+		width += (ch == QChar::Tabulation) ? kTabWidth : 1;
+		if (width > kPartLength) {
+			break;
+		} else if (ch == QChar('\n')) {
+			if (i > 0 && text[i - 1] == QChar('\n')) {
+				blank = i + 1;
+			}
+			cut = i + 1;
+			if (++lines == kPartLines) {
+				break;
+			}
+		}
+	}
+	if (i == count) {
+		return count;
+	} else if (!cut) {
+		return text[i - 1].isHighSurrogate() ? (i - 1) : i;
+	}
+	return (blank > cut - cut / 4) ? blank : cut;
+}
+
+[[nodiscard]] QString CodeBlock(const QString &text, const QString &language) {
+	auto parts = std::vector<QStringView>();
+	for (auto rest = QStringView(text); !rest.isEmpty();) {
+		const auto length = PartLength(rest);
+		parts.push_back(rest.left(length));
+		rest = rest.mid(length);
+	}
+	if (parts.size() < 2) {
+		return Fence(text, language);
+	}
+	const auto total = int(text.count(QChar('\n')))
+		+ (text.endsWith(QChar('\n')) ? 0 : 1);
+	auto result = QString();
+	auto start = 1;
+	for (const auto part : parts) {
+		const auto lines = CodeLinesInfo(start, total);
+		if (!result.isEmpty()) {
+			result += QChar('\n');
+		}
+		result += Fence(
+			part,
+			language.isEmpty() ? lines : (language + QChar(' ') + lines));
+		start += int(ranges::count(part, QChar('\n')));
+	}
+	return result;
+}
+
+[[nodiscard]] bool IsJsonSpace(QChar ch) {
+	return (ch == QChar(' '))
+		|| (ch == QChar('\t'))
+		|| (ch == QChar('\n'))
+		|| (ch == QChar('\r'));
+}
+
+[[nodiscard]] QString PrettyJson(const QString &text) {
+	auto result = QString();
+	result.reserve(text.size() + text.size() / 2);
+	auto indent = 0;
+	auto string = false;
+	auto escape = false;
+	const auto newline = [&] {
+		result += QChar('\n');
+		result += QString(indent * 2, QChar(' '));
+	};
+	for (auto i = 0; i != text.size(); ++i) {
+		const auto ch = text[i];
+		if (string) {
+			result += ch;
+			if (escape) {
+				escape = false;
+			} else if (ch == QChar('\\')) {
+				escape = true;
+			} else if (ch == QChar('"')) {
+				string = false;
+			}
+			continue;
+		} else if (IsJsonSpace(ch)) {
+			continue;
+		}
+		switch (ch.unicode()) {
+		case '"':
+			string = true;
+			result += ch;
+			break;
+		case '{':
+		case '[': {
+			const auto close = QChar((ch == QChar('{')) ? '}' : ']');
+			auto next = i + 1;
+			while (next < text.size() && IsJsonSpace(text[next])) {
+				++next;
+			}
+			result += ch;
+			if (next < text.size() && text[next] == close) {
+				result += close;
+				i = next;
+			} else {
+				++indent;
+				newline();
+			}
+		} break;
+		case '}':
+		case ']':
+			indent = std::max(indent - 1, 0);
+			newline();
+			result += ch;
+			break;
+		case ',':
+			result += ch;
+			newline();
+			break;
+		case ':':
+			result += u": "_q;
+			break;
+		default:
+			result += ch;
+			break;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Json(const QString &text) {
+	auto error = QJsonParseError();
+	const auto valid = !QJsonDocument::fromJson(text.toUtf8(), &error).isNull()
+		&& (error.error == QJsonParseError::NoError);
+	return CodeBlock(valid ? PrettyJson(text) : text, u"json"_q);
+}
+
+[[nodiscard]] QChar GuessDelimiter(const QString &text) {
+	const auto end = text.indexOf(QChar('\n'));
+	const auto line = text.left((end < 0) ? text.size() : end);
+	auto best = QChar(',');
+	auto most = line.count(best);
+	for (const auto candidate : { QChar(';'), QChar('\t'), QChar('|') }) {
+		const auto count = line.count(candidate);
+		if (count > most) {
+			most = count;
+			best = candidate;
+		}
+	}
+	return best;
+}
+
+[[nodiscard]] std::vector<std::vector<QString>> ParseTable(
+		const QString &text,
+		QChar delimiter) {
+	auto rows = std::vector<std::vector<QString>>();
+	auto row = std::vector<QString>();
+	auto field = QString();
+	auto quoted = false;
+	auto started = false;
+	const auto finishField = [&] {
+		row.push_back(std::move(field));
+		field = QString();
+		started = false;
+	};
+	const auto finishRow = [&] {
+		finishField();
+		if (row.size() > 1 || !row.front().isEmpty()) {
+			rows.push_back(std::move(row));
+		}
+		row = std::vector<QString>();
+	};
+	for (auto i = 0; i != text.size(); ++i) {
+		const auto ch = text[i];
+		if (quoted) {
+			if (ch != QChar('"')) {
+				field += ch;
+			} else if (i + 1 < text.size() && text[i + 1] == QChar('"')) {
+				field += ch;
+				++i;
+			} else {
+				quoted = false;
+			}
+		} else if (ch == QChar('"') && !started) {
+			quoted = true;
+			started = true;
+		} else if (ch == delimiter) {
+			finishField();
+		} else if (ch == QChar('\n')) {
+			finishRow();
+		} else {
+			field += ch;
+			started = true;
+		}
+	}
+	if (started || !field.isEmpty() || !row.empty()) {
+		finishRow();
+	}
+	return rows;
+}
+
+[[nodiscard]] QString EscapeCell(const QString &text) {
+	auto result = QString();
+	result.reserve(text.size() + 8);
+	for (const auto ch : text) {
+		const auto code = ch.unicode();
+		if (ch == QChar('\n')) {
+			result += QChar(' ');
+		} else if (code < 128 && QChar(code).isPunct()) {
+			result += QChar('\\');
+			result += ch;
+		} else if (code < 128 && QChar(code).isSymbol()) {
+			result += QChar('\\');
+			result += ch;
+		} else {
+			result += ch;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Table(const QString &text, QChar delimiter) {
+	auto rows = ParseTable(text, delimiter.isNull()
+		? GuessDelimiter(text)
+		: delimiter);
+	if (rows.empty()) {
+		return CodeBlock(text, QString());
+	}
+	auto columns = 0;
+	for (const auto &row : rows) {
+		columns = std::max(columns, int(row.size()));
+	}
+	const auto total = int(rows.size());
+	const auto shownColumns = std::min(columns, kMaxColumns);
+	const auto rowLimit = std::max(
+		std::min(kMaxRows, kMaxCells / std::max(shownColumns, 1)),
+		1);
+	const auto shownRows = std::min(total, rowLimit);
+	auto result = QString();
+	const auto line = [&](const std::vector<QString> &row) {
+		result += QChar('|');
+		for (auto column = 0; column != shownColumns; ++column) {
+			result += QChar(' ');
+			if (column < int(row.size())) {
+				result += EscapeCell(row[column]);
+			}
+			result += u" |"_q;
+		}
+		result += QChar('\n');
+	};
+	line(rows.front());
+	result += QChar('|');
+	for (auto column = 0; column != shownColumns; ++column) {
+		result += u" --- |"_q;
+	}
+	result += QChar('\n');
+	for (auto i = 1; i < shownRows; ++i) {
+		line(rows[i]);
+	}
+	if (shownRows < total || shownColumns < columns) {
+		result += QChar('\n');
+		result += Lower(u"Showing %1 of %2 rows and %3 of %4 columns."_q
+			.arg(shownRows)
+			.arg(total)
+			.arg(shownColumns)
+			.arg(columns));
+		result += QChar('\n');
+	}
+	return result;
+}
+
+} // namespace
+
+bool QuickViewSupports(const QString &fileName) {
+	return QuickView() && Lookup(fileName).has_value();
+}
+
+std::optional<QByteArray> QuickViewMarkdown(
+		const QString &fileName,
+		const QByteArray &bytes) {
+	const auto format = Lookup(fileName);
+	if (!format || bytes.size() > kMaxBytes) {
+		return std::nullopt;
+	}
+	const auto decoded = DecodeText(bytes);
+	if (!decoded) {
+		return std::nullopt;
+	}
+	const auto text = NormalizeLines(*decoded);
+	switch (format->kind) {
+	case Kind::Json: return Json(text).toUtf8();
+	case Kind::Code: return CodeBlock(text, format->language).toUtf8();
+	case Kind::Text: return CodeBlock(text, QString()).toUtf8();
+	case Kind::Table: return Table(text, format->delimiter).toUtf8();
+	}
+	return std::nullopt;
+}
+
+} // namespace Tele
