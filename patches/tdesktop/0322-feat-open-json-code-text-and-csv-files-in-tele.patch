 	const auto [i, inserted] = styles.try_emplace(
@@ -329,20 +352,36 @@ void PaintCodeLineNumbers(
 	p.restore();
 }
 
+QString CodeLinesInfo(int start, int total) {
+	return u"tele-lines=%1/%2"_q.arg(start).arg(total);
+}
+
+QString TakeCodeLines(QString info, int *start, int *total) {
+	static const auto token = QRegularExpression(
+		u"(?:^|\\s)tele-lines=(\\d{1,9})/(\\d{1,9})(?=\\s|$)"_q);
+	const auto match = token.match(info);
+	if (!match.hasMatch()) {
+		return info;
+	}
+	const auto first = match.captured(1).toInt();
+	const auto last = match.captured(2).toInt();
+	if (first > 0 && first <= last) {
+		*start = first;
+		*total = last;
+	}
+	return info.remove(match.capturedStart(), match.capturedLength());
+}
+
