+[[nodiscard]] QString MimeFor(const QString &name) {
+	return QMimeDatabase().mimeTypeForFile(
+		name,
+		QMimeDatabase::MatchExtension).name();
+}
+
+[[nodiscard]] FileKind ComputeKind(const SavedDraftFile &file, bool compress) {
+	if (!compress) {
+		return FileKind::File;
+	}
+	const auto mime = MimeFor(file.name);
+	if (mime == u"image/jpeg"_q
+		|| mime == u"image/png"_q
+		|| mime == u"image/webp"_q
+		|| mime == u"image/bmp"_q) {
+		return FileKind::Photo;
+	} else if (mime.startsWith(u"video/"_q)) {
+		return FileKind::Video;
+	}
+	return FileKind::File;
+}
+
+[[nodiscard]] uint64 MediaId(const QString &stored, int stage) {
+	const auto value = stored.toULongLong(nullptr, 16);
+	return ((value & ~uint64(3)) | uint64(stage)) ^ 0x5445'4C45'4452'4654ULL;
+}
