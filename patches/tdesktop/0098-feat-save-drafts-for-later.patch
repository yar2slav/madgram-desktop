+WebPageData *DraftsWidget::resolvePage(const Data::WebPageDraft &page) {
+	if (page.removed || page.url.isEmpty()) {
+		return nullptr;
+	}
+	const auto ready = [](WebPageData *data) {
+		return data
+			&& !data->url.isEmpty()
+			&& !data->failed
+			&& !data->pendingTill;
+	};
+	if (page.id) {
+		const auto data = session().data().webpage(page.id).get();
+		if (ready(data)) {
+			return data;
+		}
+	}
+	if (const auto found = _resolver->lookup(page.url)) {
+		return ready(*found) ? *found : nullptr;
+	} else if (_resolving.isEmpty()) {
+		_resolving = page.url;
+		_resolver->request(page.url);
+	}
+	return nullptr;
+}
+
+void DraftsWidget::addText(
+		const SavedDraft &draft,
+		const TextWithEntities &text,
+		bool webpage) {
+	using PageFlag = MTPDmessageMediaWebPage::Flag;
+	using PendingFlag = MTPDwebPagePending::Flag;
+	auto media = MTPMessageMedia(MTP_messageMediaEmpty());
+	auto itemFields = fields(draft, 0);
+	if (const auto page = webpage ? resolvePage(draft.webpage) : nullptr) {
+		const auto &fields = draft.webpage;
+		media = MTP_messageMediaWebPage(
+			MTP_flags(PageFlag()
+				| (fields.manual ? PageFlag::f_manual : PageFlag())
+				| (fields.forceLargeMedia
+					? PageFlag::f_force_large_media
+					: PageFlag())
+				| (fields.forceSmallMedia
+					? PageFlag::f_force_small_media
+					: PageFlag())),
+			MTP_webPagePending(
+				MTP_flags(PendingFlag::f_url),
+				MTP_long(page->id),
+				MTP_string(page->url),
+				MTP_int(0)));
+		if (fields.invert) {
+			itemFields.flags |= MessageFlag::InvertMedia;
+		}
+	}
+	push(_history->makeMessage(std::move(itemFields), text, media), draft);
+}
+
+PhotoData *DraftsWidget::photoFor(const SavedDraftFile &file) {
+	auto image = Drafts(&session()).viewPreview(file.stored);
+	const auto full = !image.isNull();
+	if (!full) {
+		image = QImage::fromData(file.thumbnail);
+	}
+	if (image.isNull()) {
+		return nullptr;
+	}
+	auto medium = (image.width() > 320 || image.height() > 320)
+		? image.scaled(320, 320, Qt::KeepAspectRatio, Qt::SmoothTransformation)
+		: image;
+	auto thumbs = PreparedPhotoThumbs();
+	thumbs.emplace('m', PreparedPhotoThumb{ .image = medium });
+	thumbs.emplace('y', PreparedPhotoThumb{ .image = image });
+	auto sizes = QVector<MTPPhotoSize>{
+		MTP_photoSize(
+			MTP_string("m"),
+			MTP_int(medium.width()),
+			MTP_int(medium.height()),
+			MTP_int(0)),
+		MTP_photoSize(
+			MTP_string("y"),
+			MTP_int(image.width()),
+			MTP_int(image.height()),
+			MTP_int(0)),
+	};
+	return session().data().processPhoto(MTP_photo(
+		MTP_flags(0),
+		MTP_long(MediaId(file.stored, full ? 1 : 0)),
+		MTP_long(0),
+		MTP_bytes(),
+		MTP_int(base::unixtime::now()),
+		MTP_vector<MTPPhotoSize>(sizes),
+		MTPVector<MTPVideoSize>(),
+		MTP_int(0)), thumbs);
+}
+
+not_null<DocumentData*> DraftsWidget::documentFor(
+		const SavedDraftFile &file,
+		FileKind kind) {
+	const auto path = Drafts(&session()).viewPath(file.stored);
+	const auto thumb = QImage::fromData(file.thumbnail);
+	auto attributes = QVector<MTPDocumentAttribute>(
+		1,
+		MTP_documentAttributeFilename(MTP_string(file.name)));
+	if (kind == FileKind::Video && !thumb.isNull()) {
+		attributes.push_back(MTP_documentAttributeVideo(
+			MTP_flags(0),
+			MTP_double(0),
+			MTP_int(thumb.width()),
+			MTP_int(thumb.height()),
+			MTPint(),
+			MTPdouble(),
+			MTPstring()));
+	}
+	auto thumbs = QVector<MTPPhotoSize>();
+	if (!thumb.isNull()) {
+		thumbs.push_back(MTP_photoSize(
+			MTP_string("m"),
+			MTP_int(thumb.width()),
+			MTP_int(thumb.height()),
+			MTP_int(0)));
+	}
+	const auto data = MTP_document(
+		MTP_flags(0),
+		MTP_long(MediaId(file.stored, (kind == FileKind::Video) ? 2 : 3)),
+		MTP_long(0),
+		MTP_bytes(),
+		MTP_int(base::unixtime::now()),
+		MTP_string(MimeFor(file.name)),
+		MTP_long(file.size),
+		MTP_vector<MTPPhotoSize>(thumbs),
+		MTPVector<MTPVideoSize>(),
+		MTP_int(0),
+		MTP_vector<MTPDocumentAttribute>(attributes));
+	const auto result = thumb.isNull()
+		? session().data().processDocument(data)
+		: session().data().processDocument(
+			data,
+			Images::FromImageInMemory(thumb, "JPG", file.thumbnail));
+	if (!path.isEmpty()) {
+		result->setLocation(Core::FileLocation(path));
+	}
+	return result;
+}
+
+void DraftsWidget::addMedia(
+		const SavedDraft &draft,
+		const std::vector<const SavedDraftFile*> &files,
+		TextWithEntities caption) {
+	const auto way = Ui::SendFilesWay::FromSerialized(
+		draft.filesWay
+	).value_or(Ui::SendFilesWay());
+	const auto compress = way.sendImagesAsPhotos();
+	auto groups = std::vector<Group>();
+	for (const auto file : files) {
+		auto kind = ComputeKind(*file, compress);
+		if (kind == FileKind::Photo && !photoFor(*file)) {
+			kind = FileKind::File;
+		}
+		const auto visual = (kind != FileKind::File);
+		const auto join = way.groupFiles()
+			&& !groups.empty()
+			&& (groups.back().album == visual)
+			&& (groups.back().files.size() < kMaxAlbum);
+		if (!join) {
+			groups.push_back({ .album = visual });
+		}
+		groups.back().files.emplace_back(file, kind);
+	}
+	for (auto g = 0; g != int(groups.size()); ++g) {
+		const auto &group = groups[g];
+		const auto count = int(group.files.size());
+		const auto groupedId = (count > 1)
+			? base::RandomValue<uint64>()
+			: uint64();
+		const auto captioned = (g + 1 != int(groups.size()))
+			? -1
+			: group.album
+			? 0
+			: (count - 1);
+		for (auto i = 0; i != count; ++i) {
+			const auto &[file, kind] = group.files[i];
+			auto itemFields = fields(draft, groupedId);
+			auto text = TextWithEntities();
+			if (i == captioned) {
+				text = caption;
+				if (draft.invertCaption) {
+					itemFields.flags |= MessageFlag::InvertMedia;
+				}
+			}
+			if (kind != FileKind::File) {
+				itemFields.mediaSpoiler = file->spoiler;
+			}
+			if (kind == FileKind::Photo) {
+				push(_history->makeMessage(
+					std::move(itemFields),
+					not_null<PhotoData*>(photoFor(*file)),
+					text), draft);
+			} else {
+				push(_history->makeMessage(
+					std::move(itemFields),
+					documentFor(*file, kind),
+					text), draft);
+			}
+		}
+	}
+}
+
+void DraftsWidget::addDraft(const SavedDraft &draft) {
+	auto &store = Drafts(&session());
+	auto present = std::vector<const SavedDraftFile*>();
+	auto missing = 0;
+	for (const auto &file : draft.files) {
+		if (store.fileMissing(file)) {
+			++missing;
+		} else {
+			present.push_back(&file);
+			if (store.viewPath(file.stored).isEmpty()) {
+				_viewNeeded.push_back(file);
+			}
+		}
+	}
+	auto labels = QStringList();
+	if (!draft.name.isEmpty()) {
+		labels.push_back(draft.name);
+	}
+	if (!draft.richData.isEmpty() && !draft.rich) {
+		labels.push_back(Lower(u"The rich message can't be read"_q));
+	}
+	if (missing) {
+		labels.push_back((missing == 1)
+			? Lower(u"1 file is missing"_q)
+			: Lower(u"%1 files are missing"_q).arg(missing));
+	}
+	if (!labels.isEmpty()) {
+		addService(labels.join(u" \u00B7 "_q), draft.edited, draft.id);
+	}
+	if (draft.rich) {
+		const auto item = _history->makeMessage(
+			fields(draft, 0),
+			TextWithEntities(),
+			MTP_messageMediaEmpty());
+		item->applyLocalRichPage(draft.rich);
+		push(item, draft);
+		return;
+	}
+	auto text = ToEntities(draft.text);
+	if (present.empty()) {
+		if (text.text.isEmpty()) {
+			text.text = Lower(u"Empty draft"_q);
+		}
+		addText(draft, text, true);
+		return;
+	}
+	const auto limit = Data::PremiumLimits(&session()).captionLengthCurrent();
+	if (text.text.size() > limit) {
+		addText(draft, text, false);
+		text = TextWithEntities();
+	}
+	addMedia(draft, present, std::move(text));
+}
+
+void DraftsWidget::build() {
+	auto &store = Drafts(&session());
+	auto saved = std::vector<const SavedDraft*>();
+	auto discarded = std::vector<const SavedDraft*>();
+	for (const auto &draft : store.list()) {
+		if (draft.thread == _thread) {
+			(draft.discarded ? discarded : saved).push_back(&draft);
+		}
+	}
+	const auto byDate = [](const SavedDraft *a, const SavedDraft *b) {
+		return a->edited < b->edited;
+	};
+	ranges::sort(saved, byDate);
+	ranges::sort(discarded, byDate);
+	_resolving = QString();
+	for (const auto draft : saved) {
+		addDraft(*draft);
+	}
+	if (!discarded.empty()) {
+		addService(
+			Lower(u"Recently discarded, kept for 7 days"_q),
+			discarded.front()->edited,
+			0);
+		for (const auto draft : discarded) {
+			addDraft(*draft);
+		}
+	}
+	if (saved.empty() && discarded.empty()) {
+		addService(
+			Lower(u"No drafts here yet. Type below and press Enter to "
+				"save one."_q),
+			base::unixtime::now(),
+			0);
+	}
+	if (!_viewNeeded.empty()) {
+		store.prepareView(
+			base::take(_viewNeeded),
+			crl::guard(this, [=] { scheduleRebuild(); }));
+	}
+}
+
+void DraftsWidget::destroyItems(std::vector<FullMsgId> ids) {
+	auto &faded = FadedItems();
+	for (const auto &id : ids) {
+		faded.remove(id);
+		if (const auto item = _history->owner().message(id)) {
+			item->destroy();
+		}
+	}
+}
+
+void DraftsWidget::scheduleRebuild() {
+	if (_rebuildScheduled) {
+		return;
+	}
+	_rebuildScheduled = true;
+	crl::on_main(this, [=] {
+		_rebuildScheduled = false;
+		rebuild();
+	});
+}
+
+void DraftsWidget::rebuild() {
+	const auto atBottom = _scrollToBottom
+		|| (_scroll->scrollTop() >= _scroll->scrollTopMax());
+	_scrollToBottom = false;
+	const auto old = base::take(_ids);
+	_drafts.clear();
+	_services.clear();
+	_draftItems.clear();
+	_selecting = true;
+	build();
+	_refreshes.fire({});
+	destroyItems(old);
+	for (auto i = begin(_selectedDrafts); i != end(_selectedDrafts);) {
+		if (_draftItems.contains(*i)) {
+			++i;
+		} else {
+			i = _selectedDrafts.erase(i);
+		}
+	}
+	_selecting = false;
+	applySelection();
+	updateSelectionBar();
+	if (atBottom) {
+		crl::on_main(this, [=] {
+			listScrollTo(_scroll->scrollTopMax());
+		});
+	}
+}
