+QByteArray SerializeRichDraft(
+		not_null<Main::Session*> session,
+		const Iv::RichPage &page) {
+	const auto serialized = Iv::SerializeInputRichMessage(
+		session,
+		page,
+		Iv::SerializeInputRichMessageMode::Draft);
+	if (serialized.status != Iv::SerializeInputRichMessageStatus::Success
+		|| !serialized.value
+		|| serialized.value->type() != mtpc_inputRichMessage) {
+		return QByteArray();
+	}
+	const auto &input = serialized.value->c_inputRichMessage();
+	auto photos = QVector<MTPPhoto>();
+	if (const auto list = input.vphotos()) {
+		for (const auto &photo : list->v) {
+			if (photo.type() != mtpc_inputPhoto) {
+				continue;
+			}
+			const auto id = photo.c_inputPhoto().vid().v;
+			if (const auto mtp = PhotoToMTP(session->data().photo(id))) {
+				photos.push_back(*mtp);
+			}
+		}
+	}
+	auto documents = QVector<MTPDocument>();
+	if (const auto list = input.vdocuments()) {
+		for (const auto &document : list->v) {
+			if (document.type() != mtpc_inputDocument) {
+				continue;
+			}
+			const auto id = document.c_inputDocument().vid().v;
+			const auto data = session->data().document(id);
+			if (const auto mtp = DocumentToMTP(data)) {
+				documents.push_back(*mtp);
+			}
+		}
+	}
+	using Flag = MTPDrichMessage::Flag;
+	const auto message = MTP_richMessage(
+		MTP_flags(input.is_rtl() ? Flag::f_rtl : Flag()),
+		MTP_vector<MTPPageBlock>(ConvertBlocks(input.vblocks().v)),
+		MTP_vector<MTPPhoto>(photos),
+		MTP_vector<MTPDocument>(documents));
+	auto buffer = mtpBuffer();
+	message.write(buffer);
+	return QByteArray(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(mtpPrime));
+}
+
+std::shared_ptr<const Iv::RichPage> ParseRichDraft(
+		not_null<Main::Session*> session,
+		const QByteArray &serialized) {
+	if (serialized.isEmpty() || (serialized.size() % sizeof(mtpPrime))) {
+		return nullptr;
+	}
+	auto from = reinterpret_cast<const mtpPrime*>(serialized.constData());
+	const auto end = from + (serialized.size() / sizeof(mtpPrime));
+	auto message = MTPrichMessage();
+	if (!message.read(from, end, mtpc_richMessage) || from != end) {
+		return nullptr;
+	}
+	auto result = Iv::ParseRichPage(session, MTPRichMessage(message));
+	return (result && !result->blocks.empty()) ? result : nullptr;
+}
