+bool ComposeDrafts::savesDraft() const {
+	return !_sendingThrough && (editingId() != 0);
+}
+
+bool ComposeDrafts::intercept() {
+	if (!savesDraft()) {
+		return false;
+	} else if (save(false)) {
+		finishEditing();
+	}
+	return true;
+}
+
+void ComposeDrafts::finishEditing() {
+	if (const auto thread = currentThread()) {
+		_previous = std::nullopt;
+		FinishDraftEditing(_session, thread);
+	}
+}
+
+void ComposeDrafts::sendThrough(Api::SendOptions options) {
+	const auto thread = currentThread();
+	const auto id = editingId();
+	if (!thread || !id || !_send) {
+		return;
+	}
+	_sendingThrough = true;
+	_send(options);
+	_sendingThrough = false;
+	if (!_field->getLastText().isEmpty() || richShown()) {
+		return;
+	}
+	auto &store = Drafts(_session);
+	const auto before = store.editingBefore(thread);
+	const auto beforeRich = store.editingBeforeRich(thread);
+	store.stopEditing(thread);
+	store.remove(id);
+	if (before || beforeRich) {
+		_previous = std::nullopt;
+		RestoreFieldDraft(_session, thread, before, beforeRich);
+	}
+}
+
+void ComposeDrafts::fieldChanged() {
+	const auto thread = currentThread();
+	const auto &text = _field->getLastText();
+	if (!thread || _editing()) {
+		_previous = std::nullopt;
+		_snapshot = std::nullopt;
+		return;
+	}
+	if (_previous
+		&& _previous->thread == thread
+		&& DiscardLost(_previous->text.text, text)) {
+		auto snapshot = std::move(*_previous);
+		if (_snapshot
+			&& _snapshot->thread == thread
+			&& _snapshot->text.text == snapshot.text.text) {
+			snapshot = *_snapshot;
+		}
+		_pending.push_back({ std::move(snapshot), crl::now() });
+		_pendingTimer.callOnce(kPendingDelay);
+	}
+	if (DiscardMeaningful(text)) {
+		_previous = Snapshot{
+			.thread = thread,
+			.text = { text, {} },
+			.reply = (_snapshot && _snapshot->thread == thread)
+				? _snapshot->reply
+				: FullReplyTo(),
+		};
+		_snapshotTimer.callOnce(kSnapshotDelay);
+	} else {
+		_previous = std::nullopt;
+	}
+}
+
+void ComposeDrafts::takeSnapshot() {
+	const auto thread = currentThread();
+	if (!thread || _editing() || !DiscardMeaningful(_field->getLastText())) {
+		return;
+	}
+	_snapshot = Snapshot{
+		.thread = thread,
+		.text = _field->getTextWithTags(),
+		.reply = _reply(),
+		.webpage = _webpage(),
+	};
+	if (_previous && _previous->thread == thread) {
+		_previous->reply = _snapshot->reply;
+		_previous->webpage = _snapshot->webpage;
+	}
+}
+
+void ComposeDrafts::checkPending() {
+	if (_pending.empty()) {
+		return;
+	}
+	const auto window = _show->resolveWindow();
+	if (window && window->isLayerShown()) {
+		_pendingTimer.callOnce(kPendingDelay);
+		return;
+	}
+	auto &store = Drafts(_session);
+	const auto current = currentThread();
+	const auto editing = _editing();
+	const auto field = NormalizedDiscardText(_field->getLastText());
+	for (auto &pending : base::take(_pending)) {
+		const auto &snapshot = pending.snapshot;
+		const auto text = NormalizedDiscardText(snapshot.text.text);
+		if (store.sentSince(snapshot.thread.peer, pending.when - kSentWindow)) {
+			continue;
+		} else if (current == snapshot.thread && !editing) {
+			if (field.contains(text)) {
+				continue;
+			}
+		} else if (LocalDraftContains(_session, snapshot.thread, text)) {
+			continue;
+		}
+		store.addDiscarded(
+			snapshot.thread,
+			snapshot.text,
+			snapshot.reply,
+			snapshot.webpage);
+	}
+}
+
+bool ComposeDrafts::refresh() {
+	const auto thread = currentThread();
+	if (const auto resolved = thread ? _thread() : nullptr) {
+		Drafts(_session).trackScheduled(resolved->owningHistory());
+	}
+	const auto count = thread ? Drafts(_session).savedCount(thread) : 0;
+	_button->setCount(count);
+	const auto shown = _allowed
+		&& (count > 0)
+		&& !_field->isHidden()
+		&& !_editing();
+	if (_button->isHidden() != shown) {
+		return false;
+	}
+	_button->setVisible(shown);
+	return true;
+}
+
+void ComposeDrafts::refreshAndRelayout() {
+	if (refresh()) {
+		_relayout();
+	}
+}
+
+int ComposeDrafts::shownWidth() {
+	refresh();
+	return _button->isHidden() ? 0 : _button->width();
+}
+
+int ComposeDrafts::moveToRight(int right, int top) {
+	refresh();
+	_button->moveToRight(right, top);
+	return _button->isHidden() ? 0 : _button->width();
+}
+
+bool ComposeDrafts::setAllowed(bool allowed) {
+	if (_allowed == allowed) {
+		return false;
+	}
+	_allowed = allowed;
+	return refresh();
+}
+
+void ComposeDrafts::fillMenuDetails(SendMenu::Details &details) {
+	if (!currentThread() || _editing()) {
+		return;
+	}
+	details.teleMenu = crl::guard(_button.get(), [=](
+			not_null<Ui::PopupMenu*> menu) {
+		fillMenu(menu);
+	});
+}
+
+void ComposeDrafts::fillMenu(not_null<Ui::PopupMenu*> menu) {
+	const auto thread = currentThread();
+	if (!thread) {
+		return;
+	}
+	const auto &store = Drafts(_session);
+	const auto guard = _button.get();
+	if (!menu->empty()) {
+		menu->addSeparator();
+	}
+	if (editingId()) {
+		AddSendThroughActions(
+			menu,
+			guard,
+			_show,
+			_sendDetails ? _sendDetails() : SendMenu::Details(),
+			crl::guard(guard, [=](Api::SendOptions options) {
+				sendThrough(options);
+			}));
+		menu->addAction(Lower(u"Save as new draft"_q), crl::guard(guard, [=] {
+			if (save(true)) {
+				finishEditing();
+			}
+		}), &st::menuIconArchive);
+	} else {
+		menu->addAction(Lower(u"Save as draft"_q), crl::guard(guard, [=] {
+			save(true);
+		}), &st::menuIconArchive);
+	}
+	const auto open = crl::guard(guard, [=] {
+		if (const auto window = _show->resolveWindow()) {
+			ShowDraftsSection(window, thread);
+		}
+	});
+	if (const auto count = store.savedCount(thread)) {
+		menu->addAction(
+			Lower(u"Saved drafts (%1)"_q).arg(count),
+			open,
+			&st::menuIconArchiveOpen);
+	}
+	if (const auto count = store.discardedCount(thread)) {
+		menu->addAction(
+			Lower(u"Recently discarded (%1)"_q).arg(count),
+			open,
+			&st::menuIconRestore);
+	}
+}
+
+void ComposeDrafts::setupShortcut() {
+	base::install_event_filter(
+		_button.get(),
+		_field->rawTextEdit(),
+		[=](not_null<QEvent*> e) {
+			if (e->type() != QEvent::KeyPress) {
+				return base::EventFilterResult::Continue;
+			}
+			const auto event = static_cast<QKeyEvent*>(e.get());
+			if (IsCancelShortcut(event) && editingId()) {
+				finishEditing();
+				return base::EventFilterResult::Cancel;
+			} else if (!IsSaveShortcut(event)
+				|| !currentThread()
+				|| _editing()) {
+				return base::EventFilterResult::Continue;
+			} else if (!intercept()) {
+				save(true);
+			}
+			return base::EventFilterResult::Cancel;
+		});
+	InvokeQueued(_button.get(), [=] {
+		base::install_event_filter(
+			_button.get(),
+			_button->window(),
+			[=](not_null<QEvent*> e) {
+				if (e->type() != QEvent::KeyPress
+					|| !richShown()
+					|| !_button->parentWidget()->isVisible()
+					|| !currentThread()
+					|| _editing()) {
+					return base::EventFilterResult::Continue;
+				}
+				const auto event = static_cast<QKeyEvent*>(e.get());
+				if (IsCancelShortcut(event) && editingId()) {
+					finishEditing();
+					return base::EventFilterResult::Cancel;
+				} else if (!IsSaveShortcut(event)) {
+					return base::EventFilterResult::Continue;
+				} else if (!intercept()) {
+					save(true);
+				}
+				return base::EventFilterResult::Cancel;
+			});
+	});
+}
+
+bool ComposeDrafts::save(bool asNew) {
+	const auto thread = currentThread();
+	if (!thread || _editing()) {
+		return false;
+	}
+	auto text = _field->getTextWithAppliedMarkdown();
+	const auto page = Data::DraftStringIsEmpty(text.text)
+		? richShown()
+		: nullptr;
+	if (!page && Data::DraftStringIsEmpty(text.text)) {
+		_show->showToast(Lower(u"Type something to save it as a draft."_q));
+		return false;
+	}
+	auto &store = Drafts(_session);
+	const auto reply = NormalizeDraftReply(_reply(), thread);
+	const auto webpage = page ? Data::WebPageDraft() : _webpage();
+	const auto updating = asNew ? uint64() : store.editing(thread);
+	const auto existing = updating ? store.find(updating) : nullptr;
+	auto draft = existing ? *existing : SavedDraft{ .thread = thread };
+	draft.text = std::move(text);
+	draft.reply = reply;
+	draft.webpage = webpage;
+	draft.files.clear();
+	draft.filesWay = 0;
+	draft.invertCaption = false;
+	if (!AssignRichDraft(_session, draft, page)) {
+		_show->showToast(Lower(
+			u"This rich message can't be saved as a draft yet, "
+			"wait until its media is uploaded."_q));
+		return false;
+	}
+	if (existing) {
+		store.update(std::move(draft));
+		ShowDraftSavedToast(_show, thread, true);
+		return true;
+	}
+	store.add(std::move(draft));
+	ShowDraftSavedToast(_show, thread, false);
+	if (!editingId()) {
+		_previous = std::nullopt;
+		if (page && _clearRich) {
+			_clearRich();
+		} else {
+			RestoreFieldDraft(_session, thread, nullptr, nullptr);
+		}
+	}
+	return true;
+}
