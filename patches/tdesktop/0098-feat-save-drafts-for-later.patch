+void DraftsButton::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	paintRipple(p, _st.rippleAreaPosition);
+
+	const auto &icon = st::menuIconEdit;
+	const auto color = isOver()
+		? st::historyComposeIconFgOver->c
+		: st::historyComposeIconFg->c;
+	const auto iconLeft = (width() - icon.width()) / 2;
+	const auto iconTop = (height() - icon.height()) / 2;
+	icon.paint(p, iconLeft, iconTop, width(), color);
+
+	if (_count <= 0) {
+		return;
+	}
+	const auto &font = st::dialogsUnreadFont;
+	const auto text = (_count > 99) ? u"99+"_q : QString::number(_count);
+	const auto textWidth = font->width(text);
+	const auto badgeHeight = font->height;
+	const auto badgeWidth = std::max(badgeHeight, textWidth + badgeHeight / 2);
+	const auto badgeLeft = std::min(
+		iconLeft + icon.width() - badgeWidth / 2,
+		width() - badgeWidth);
+	const auto badgeTop = std::max(iconTop - badgeHeight / 3, 0);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::activeButtonBg);
+	p.drawRoundedRect(
+		QRect(badgeLeft, badgeTop, badgeWidth, badgeHeight),
+		badgeHeight / 2.,
+		badgeHeight / 2.);
+	p.setFont(font);
+	p.setPen(st::activeButtonFg);
+	p.drawText(
+		QRect(badgeLeft, badgeTop, badgeWidth, badgeHeight),
+		text,
+		style::al_center);
+}
