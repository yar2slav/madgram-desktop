+namespace {
+
+[[nodiscard]] std::optional<DraftFileSource> SourceFromFile(
+		const Ui::PreparedFile &file,
+		const DraftsStore &store) {
+	const auto image = file.information
+		? std::get_if<Ui::PreparedFileInformation::Image>(
+			&file.information->media)
+		: nullptr;
+	auto source = DraftFileSource{
+		.name = (!file.displayName.isEmpty()
+			? file.displayName
+			: !file.path.isEmpty()
+			? QFileInfo(file.path).fileName()
+			: QString()),
+		.size = file.size,
+		.thumbnail = ((image && !image->data.isNull())
+			? image->data
+			: file.preview),
+		.spoiler = file.spoiler,
+	};
+	if (!file.path.isEmpty()) {
+		source.path = file.path;
+		source.reuse = store.storedForExported(file.path);
+	} else if (!file.content.isEmpty()) {
+		source.bytes = file.content;
+	} else if (image && !image->data.isNull()) {
+		source.image = image->data;
+		source.name = u"image.png"_q;
+	} else {
+		return std::nullopt;
+	}
+	if (source.name.isEmpty()) {
+		source.name = (file.type == Ui::PreparedFile::Type::Photo)
+			? u"image.png"_q
+			: u"file"_q;
+	}
+	return source;
+}
+
+struct MediaDraft {
+	DraftsThread thread;
+	TextWithTags text;
+	FullReplyTo reply;
+	int32 way = 0;
+	bool invert = false;
+	uint64 editingId = 0;
+	bool finishEditing = false;
+	bool toast = true;
+};
+
+void ImportMediaDraft(
+		std::shared_ptr<ChatHelpers::Show> show,
+		std::vector<DraftFileSource> sources,
+		MediaDraft draft) {
+	const auto session = &show->session();
+	Drafts(session).importFiles(std::move(sources), [=](
+			std::optional<std::vector<SavedDraftFile>> files) {
+		if (!files) {
+			show->showToast(Lower(u"Couldn't copy the files into the draft."_q));
+			return;
+		}
+		auto &store = Drafts(session);
+		const auto editingId = draft.editingId;
+		if (const auto existing = editingId ? store.find(editingId) : nullptr) {
+			auto copy = *existing;
+			AssignRichDraft(session, copy, nullptr);
+			copy.text = draft.text;
+			copy.reply = draft.reply;
+			copy.webpage = Data::WebPageDraft();
+			copy.files = std::move(*files);
+			copy.filesWay = draft.way;
+			copy.invertCaption = draft.invert;
+			store.update(std::move(copy));
+			if (draft.toast) {
+				ShowDraftSavedToast(show, draft.thread, true);
+			}
+		} else {
+			store.add({
+				.thread = draft.thread,
+				.text = draft.text,
+				.reply = draft.reply,
+				.files = std::move(*files),
+				.filesWay = draft.way,
+				.invertCaption = draft.invert,
+			});
+			if (draft.toast) {
+				ShowDraftSavedToast(show, draft.thread, false);
+			}
+		}
+		if (draft.finishEditing) {
+			FinishDraftEditing(session, draft.thread);
+		}
+	});
+}
