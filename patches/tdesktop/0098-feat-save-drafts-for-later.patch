+void DraftsWidget::push(
+		not_null<HistoryItem*> item,
+		const SavedDraft &draft) {
+	const auto id = item->fullId();
+	_ids.push_back(id);
+	_drafts.emplace(id, draft.id);
+	_draftItems[draft.id].push_back(id);
+	if (draft.discarded) {
+		FadedItems().emplace(id);
+	}
+}
