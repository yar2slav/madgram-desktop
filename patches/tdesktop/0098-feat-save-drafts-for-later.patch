+}
+
+bool DraftsStore::broken(const SavedDraft &draft) const {
+	return (!draft.richData.isEmpty() && !draft.rich)
+		|| ranges::any_of(draft.files, [&](const SavedDraftFile &file) {
+		return fileMissing(file);
+	});
+}
