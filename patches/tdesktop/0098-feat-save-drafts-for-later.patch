+			? Lower(u"Delete %1 drafts?"_q).arg(ids.size())
+			: Lower(u"Delete this draft?"_q)),
+		.confirmed = [=](Fn<void()> close) {
+			for (const auto id : ids) {
+				Drafts(session).remove(id);
+			}
+			if (done) {
+				done();
+			}
+			close();
+		},
+		.confirmText = Lower(u"Delete"_q),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+void EditDraft(
+		not_null<Window::SessionController*> controller,
+		uint64 id) {
+	const auto session = &controller->session();
+	const auto draft = Drafts(session).find(id);
+	if (!draft) {
+		return;
+	}
+	const auto copy = *draft;
+	if (!ResolveDraftsThread(session, copy.thread)) {
+		controller->showToast(Lower(u"This chat is unavailable."_q));
+		return;
+	}
+	StartDraftEditing(session, copy.thread, copy.id);
+	if (!LoadDraftIntoField(controller, copy, false)) {
+		Drafts(session).stopEditing(copy.thread);
+		return;
+	}
+	if (copy.files.empty()) {
+		return;
+	}
+	auto files = std::vector<SavedDraftFile>();
+	for (const auto &file : copy.files) {
+		if (!Drafts(session).fileMissing(file)) {
+			files.push_back(file);
+		}
+	}
+	if (files.size() != copy.files.size()) {
+		controller->showToast(Lower(
+			u"Some files of this draft are missing."_q));
+	}
+	if (files.empty()) {
+		return;
+	}
+	Drafts(session).exportFiles(files, crl::guard(controller, [=](
+			QStringList paths) {
+		const auto thread = ResolveDraftsThread(session, copy.thread);
+		if (paths.isEmpty() || !thread) {
+			controller->showToast(Lower(
+				u"Couldn't read the files of this draft."_q));
+			return;
+		}
+		controller->content()->sendPaths(thread, paths);
+	}));
+}
+
+void RestoreDraft(
+		not_null<Window::SessionController*> controller,
+		uint64 id) {
+	const auto session = &controller->session();
+	const auto draft = Drafts(session).find(id);
+	if (!draft) {
+		return;
+	}
+	const auto copy = *draft;
+	if (LoadDraftIntoField(controller, copy, true)) {
+		Drafts(session).remove(copy.id);
+	}
+}
+
+void KeepDraft(not_null<Main::Session*> session, uint64 id) {
+	if (const auto draft = Drafts(session).find(id)) {
+		auto copy = *draft;
+		copy.discarded = false;
+		Drafts(session).update(std::move(copy));
+	}
+}
+
+void ShowAllDraftsBox(not_null<Window::SessionController*> controller) {
+	auto init = [=](not_null<PeerListBox*> box) {
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	};
+	controller->show(Box<PeerListBox>(
+		std::make_unique<ChatsController>(controller),
+		std::move(init)));
+}
+
+void ShowDraftSavedToast(
+		std::shared_ptr<ChatHelpers::Show> show,
+		DraftsThread thread,
+		bool updated) {
+	auto text = TextWithEntities{ Lower(updated
+		? u"Draft updated. "_q
+		: u"Saved as draft. "_q) };
+	text.append(Ui::Text::Link(Lower(u"Open"_q)));
+	const auto weak = std::weak_ptr<ChatHelpers::Show>(show);
+	show->showToast({
+		.text = std::move(text),
+		.filter = [=](const ClickHandlerPtr &, Qt::MouseButton button) {
+			if (button != Qt::LeftButton) {
+				return false;
+			} else if (const auto strong = weak.lock()) {
+				if (const auto window = strong->resolveWindow()) {
+					ShowDraftsSection(window, thread);
+				}
+			}
+			return true;
+		},
+		.duration = 3 * crl::time(1000),
+	});
+}
+
+bool LoadDraftIntoField(
+		not_null<Window::SessionController*> controller,
+		const SavedDraft &draft,
+		bool noteReplaced) {
+	const auto session = &controller->session();
+	const auto thread = ResolveDraftsThread(session, draft.thread);
+	if (!thread) {
+		controller->showToast(Lower(u"This chat is unavailable."_q));
+		return false;
+	}
+	const auto history = thread->owningHistory();
+	const auto reply = NormalizeDraftReply(draft.reply, draft.thread);
+	if (noteReplaced) {
+		NoteLocalDraftReplace(
+			history,
+			reply.topicRootId,
+			reply.monoforumPeerId,
+			&draft.text);
+	}
+	if (draft.rich) {
+		history->setLocalDraft(std::make_unique<Data::Draft>(
+			TextWithTags(),
+			reply,
+			SuggestOptions(),
+			MessageCursor(),
+			Data::WebPageDraft()));
+		auto rich = Data::Draft(
+			TextWithTags(),
+			reply,
+			SuggestOptions(),
+			MessageCursor(),
+			Data::WebPageDraft());
+		rich.richMessage = draft.rich;
+		rich.richMessageSummary = Iv::FlattenRichPageSummary(draft.rich);
+		history->createCloudDraft(
+			reply.topicRootId,
+			reply.monoforumPeerId,
+			&rich);
+	} else {
+		const auto size = int(draft.text.text.size());
+		history->setLocalDraft(std::make_unique<Data::Draft>(
+			draft.text,
+			reply,
+			SuggestOptions(),
+			MessageCursor{ size, size, Ui::kQFixedMax },
+			draft.webpage));
+		const auto cloud = history->cloudDraft(
+			reply.topicRootId,
+			reply.monoforumPeerId);
+		if (!noteReplaced && cloud && cloud->hasRichMessage()) {
+			history->clearCloudDraft(
+				reply.topicRootId,
+				reply.monoforumPeerId);
+		}
+	}
+	history->clearLocalEditDraft(reply.topicRootId, reply.monoforumPeerId);
+	session->changes().entryUpdated(
+		thread,
+		Data::EntryUpdate::Flag::LocalDraftSet);
+	return true;
+}
+
