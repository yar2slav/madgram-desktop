+void RenameDraftBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		uint64 id) {
+	const auto draft = Drafts(session).find(id);
+	box->setTitle(rpl::single(Lower(u"Draft name"_q)));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Name"_q)),
+		draft ? draft->name : QString()));
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	const auto save = [=] {
+		if (const auto current = Drafts(session).find(id)) {
+			auto copy = *current;
+			copy.name = field->getLastText().trimmed();
+			Drafts(session).update(std::move(copy));
+		}
+		box->closeBox();
+	};
+	field->submits() | rpl::on_next(save, field->lifetime());
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
