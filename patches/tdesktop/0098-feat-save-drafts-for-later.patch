+void SendDraftsBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		std::vector<uint64> ids,
+		DraftsThread target,
+		Fn<void()> done) {
+	const auto session = &controller->session();
+	const auto thread = ResolveDraftsThread(session, target);
+	auto drafts = std::vector<SavedDraft>();
+	for (const auto id : ids) {
+		if (const auto draft = Drafts(session).find(id)) {
+			drafts.push_back(*draft);
+		}
+	}
+	ranges::sort(drafts, ranges::less(), &SavedDraft::edited);
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single((drafts.size() > 1)
+		? Lower(u"Send %1 drafts"_q).arg(drafts.size())
+		: Lower(u"Send draft"_q)));
+	const auto container = box->verticalLayout();
+	if (drafts.empty() || !thread) {
+		AddInfoLine(container, Lower(u"This chat is unavailable."_q));
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+		return;
+	}
+	AddInfoLine(
+		container,
+		Lower(u"To: %1"_q).arg(DraftsThreadName(session, target)));
+	if (drafts.size() == 1) {
+		const auto &draft = drafts.front();
+		if (draft.thread == target && draft.reply.replying()) {
+			AddInfoLine(
+				container,
+				Lower(u"Reply to: %1"_q).arg(ReplyText(session, draft.reply)));
+		}
+		if (const auto webpage = WebPageText(draft.webpage)
+			; !webpage.isEmpty()) {
+			AddInfoLine(container, webpage);
+		}
+		if (draft.rich) {
+			AddInfoLine(container, Lower(u"Rich message"_q));
+		}
+		if (!draft.files.empty()) {
+			AddInfoLine(container, FilesLine(draft));
+			if (Drafts(session).broken(draft)) {
+				AddInfoLine(
+					container,
+					Lower(u"Some files are missing, the draft can't be "
+						"sent."_q));
+			}
+		}
+		Ui::AddSkip(container);
+		Ui::AddDivider(container);
+		Ui::AddSkip(container);
+		const auto text = container->add(
+			object_ptr<Ui::FlatLabel>(container, st::boxLabel),
+			st::boxRowPadding);
+		text->setMarkedText(TextWithEntities{
+			draft.text.text,
+			TextUtilities::ConvertTextTagsToEntities(draft.text.tags),
+		});
+		text->setSelectable(true);
+	} else {
+		AddInfoLine(
+			container,
+			Lower(u"They go out one by one, oldest first."_q));
+	}
+	Ui::AddSkip(container);
+	Ui::AddDivider(container);
+	Ui::AddSkip(container);
+
+	const auto peer = thread->peer();
+	const auto silent = peer->isSelf()
+		? nullptr
+		: container->add(
+			object_ptr<Ui::Checkbox>(
+				container,
+				Lower(u"Send without sound"_q),
+				false,
+				st::defaultBoxCheckbox),
+			st::boxRowPadding);
+	if (silent) {
+		Ui::AddSkip(container);
+	}
+	const auto remove = container->add(
+		object_ptr<Ui::Checkbox>(
+			container,
+			Lower((drafts.size() > 1)
+				? u"Delete the drafts after sending"_q
+				: u"Delete the draft after sending"_q),
+			true,
+			st::defaultBoxCheckbox),
+		st::boxRowPadding);
+
+	auto ordered = std::vector<uint64>();
+	for (const auto &draft : drafts) {
+		ordered.push_back(draft.id);
+	}
+	const auto send = [=](Api::SendOptions options) {
+		options.silent = options.silent || (silent && silent->checked());
+		const auto deleting = remove->checked();
+		auto any = false;
+		for (const auto id : ordered) {
+			const auto sent = [=] {
+				if (deleting) {
+					Drafts(session).remove(id);
+				}
+			};
+			if (SendDraft(controller, id, target, options, sent)) {
+				any = true;
+			}
+		}
+		if (any) {
+			if (done) {
+				done();
+			}
+			box->closeBox();
+		}
+	};
+	box->addButton(rpl::single(Lower(u"Send"_q)), [=] {
+		send({});
+	});
+	box->addButton(rpl::single(Lower(u"Schedule"_q)), [=] {
+		const auto details = SendMenu::Details{
+			.type = (peer->isSelf()
+				? SendMenu::Type::Reminder
+				: SendMenu::Type::Scheduled),
+			.barePeerId = peer->id.value,
+		};
+		controller->show(HistoryView::PrepareScheduleBox(
+			box,
+			controller->uiShow(),
+			details,
+			send));
+	});
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+}
