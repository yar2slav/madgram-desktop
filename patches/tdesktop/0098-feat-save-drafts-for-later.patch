+#include "main/main_session.h"
+#include "ui/image/image_location.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] int32 DcFromMediaKey(MediaKey key) {
+	return int32(uint32(key.first & 0xFFFF'FFFFULL));
+}
+
+[[nodiscard]] QString ThumbLetter(
+		const ImageLocation &location,
+		UserId self) {
+	if (!location.valid()) {
+		return QString();
+	}
+	const auto storage = std::get_if<StorageFileLocation>(
+		&location.file().data);
+	if (!storage || !storage->valid()) {
+		return QString();
+	}
+	return storage->tl(self).match([](const MTPDinputPhotoFileLocation &d) {
+		return qs(d.vthumb_size());
+	}, [](const MTPDinputDocumentFileLocation &d) {
+		return qs(d.vthumb_size());
+	}, [](const auto &) {
+		return QString();
+	});
+}
+
+[[nodiscard]] std::optional<MTPPhoto> PhotoToMTP(
+		not_null<PhotoData*> photo) {
+	const auto input = photo->mtpInput();
+	if (input.type() != mtpc_inputPhoto) {
+		return std::nullopt;
+	}
+	const auto &fields = input.c_inputPhoto();
+	const auto self = photo->session().userId();
+	auto sizes = QVector<MTPPhotoSize>();
+	if (const auto bytes = photo->inlineThumbnailBytes(); !bytes.isEmpty()) {
+		sizes.push_back(MTP_photoStrippedSize(
+			MTP_string("i"),
+			MTP_bytes(bytes)));
+	}
+	auto letters = base::flat_set<QString>();
+	for (const auto size : {
+			Data::PhotoSize::Small,
+			Data::PhotoSize::Thumbnail,
+			Data::PhotoSize::Large }) {
+		const auto &location = photo->location(size);
+		const auto letter = ThumbLetter(location, self);
+		if (letter.isEmpty() || !letters.emplace(letter).second) {
+			continue;
+		}
+		sizes.push_back(MTP_photoSize(
+			MTP_string(letter),
+			MTP_int(location.width()),
+			MTP_int(location.height()),
+			MTP_int(photo->imageByteSize(size))));
+	}
+	using Flag = MTPDphoto::Flag;
+	return MTP_photo(
+		MTP_flags(photo->hasAttachedStickers()
+			? Flag::f_has_stickers
+			: Flag()),
+		fields.vid(),
+		fields.vaccess_hash(),
+		fields.vfile_reference(),
+		MTP_int(photo->date()),
+		MTP_vector<MTPPhotoSize>(sizes),
+		MTPVector<MTPVideoSize>(),
+		MTP_int(DcFromMediaKey(photo->mediaKey())));
+}
+
+[[nodiscard]] QVector<MTPDocumentAttribute> DocumentAttributes(
+		not_null<DocumentData*> document) {
+	auto result = QVector<MTPDocumentAttribute>();
+	if (const auto name = document->filename(); !name.isEmpty()) {
+		result.push_back(MTP_documentAttributeFilename(MTP_string(name)));
+	}
+	const auto duration = document->hasDuration()
+		? document->duration()
+		: crl::time(0);
+	const auto &size = document->dimensions;
+	if (const auto sticker = document->sticker()) {
+		const auto set = sticker->set
+			? Data::InputStickerSet(sticker->set)
+			: MTP_inputStickerSetEmpty();
+		if (sticker->setType == Data::StickersType::Emoji) {
+			using Flag = MTPDdocumentAttributeCustomEmoji::Flag;
+			result.push_back(MTP_documentAttributeCustomEmoji(
+				MTP_flags(document->emojiUsesTextColor()
+					? Flag::f_text_color
+					: Flag()),
+				MTP_string(sticker->alt),
+				set));
+		} else {
+			result.push_back(MTP_documentAttributeSticker(
+				MTP_flags(0),
+				MTP_string(sticker->alt),
+				set,
+				MTPMaskCoords()));
+		}
+		if (size.width() > 0 && size.height() > 0) {
+			result.push_back(MTP_documentAttributeImageSize(
+				MTP_int(size.width()),
+				MTP_int(size.height())));
+		}
+	} else if (document->isVideoFile()
+		|| document->isVideoMessage()
+		|| document->isGifv()) {
+		using Flag = MTPDdocumentAttributeVideo::Flag;
+		result.push_back(MTP_documentAttributeVideo(
+			MTP_flags((document->isVideoMessage()
+				? Flag::f_round_message
+				: Flag())
+				| (document->supportsStreaming()
+					? Flag::f_supports_streaming
+					: Flag())),
+			MTP_double(duration / 1000.),
+			MTP_int(size.width()),
+			MTP_int(size.height()),
+			MTPint(),
+			MTPdouble(),
+			MTPstring()));
+		if (document->isGifv()) {
+			result.push_back(MTP_documentAttributeAnimated());
+		}
+	} else if (document->isAnimation()) {
+		result.push_back(MTP_documentAttributeAnimated());
+		if (size.width() > 0 && size.height() > 0) {
+			result.push_back(MTP_documentAttributeImageSize(
+				MTP_int(size.width()),
+				MTP_int(size.height())));
+		}
+	} else if (const auto song = document->song()) {
+		using Flag = MTPDdocumentAttributeAudio::Flag;
+		result.push_back(MTP_documentAttributeAudio(
+			MTP_flags(Flag::f_title | Flag::f_performer),
+			MTP_int(duration / 1000),
+			MTP_string(song->title),
+			MTP_string(song->performer),
+			MTPbytes()));
+	} else if (document->isVoiceMessage()) {
+		using Flag = MTPDdocumentAttributeAudio::Flag;
+		result.push_back(MTP_documentAttributeAudio(
+			MTP_flags(Flag::f_voice),
+			MTP_int(duration / 1000),
+			MTPstring(),
+			MTPstring(),
+			MTPbytes()));
+	} else if (size.width() > 0 && size.height() > 0) {
+		result.push_back(MTP_documentAttributeImageSize(
+			MTP_int(size.width()),
+			MTP_int(size.height())));
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<MTPDocument> DocumentToMTP(
+		not_null<DocumentData*> document) {
+	const auto input = document->mtpInput();
+	if (input.type() != mtpc_inputDocument) {
+		return std::nullopt;
+	}
+	const auto &fields = input.c_inputDocument();
+	auto thumbs = QVector<MTPPhotoSize>();
+	if (const auto bytes = document->inlineThumbnailBytes()
+		; !bytes.isEmpty()) {
+		thumbs.push_back(document->inlineThumbnailIsPath()
+			? MTP_photoPathSize(MTP_string("j"), MTP_bytes(bytes))
+			: MTP_photoStrippedSize(MTP_string("i"), MTP_bytes(bytes)));
+	}
+	const auto &thumbnail = document->thumbnailLocation();
+	const auto letter = ThumbLetter(
+		thumbnail,
+		document->session().userId());
+	if (!letter.isEmpty()) {
+		thumbs.push_back(MTP_photoSize(
+			MTP_string(letter),
+			MTP_int(thumbnail.width()),
+			MTP_int(thumbnail.height()),
+			MTP_int(document->thumbnailByteSize())));
+	}
+	using Flag = MTPDdocument::Flag;
+	return MTP_document(
+		MTP_flags(thumbs.isEmpty() ? Flag() : Flag::f_thumbs),
+		fields.vid(),
+		fields.vaccess_hash(),
+		fields.vfile_reference(),
+		MTP_int(document->date),
+		MTP_string(document->mimeString()),
+		MTP_long(document->size),
+		MTP_vector<MTPPhotoSize>(thumbs),
+		MTPVector<MTPVideoSize>(),
+		MTP_int(DcFromMediaKey(document->mediaKey())),
+		MTP_vector<MTPDocumentAttribute>(DocumentAttributes(document)));
+}
+
+[[nodiscard]] QVector<MTPPageBlock> ConvertBlocks(
+	const QVector<MTPPageBlock> &blocks);
+
+[[nodiscard]] MTPPageBlock ConvertBlock(const MTPPageBlock &block) {
+	return block.match([&](const MTPDinputPageBlockMap &data) -> MTPPageBlock {
+		return data.vgeo().match([&](const MTPDinputGeoPoint &geo) -> MTPPageBlock {
+			return MTP_pageBlockMap(
+				MTP_geoPoint(
+					MTP_flags(0),
+					geo.vlong(),
+					geo.vlat(),
+					MTP_long(0),
+					MTPint()),
+				data.vzoom(),
+				data.vw(),
+				data.vh(),
+				data.vcaption());
+		}, [&](const auto &) -> MTPPageBlock {
+			return block;
+		});
+	}, [&](const MTPDpageBlockDetails &data) -> MTPPageBlock {
+		return MTP_pageBlockDetails(
+			data.vflags(),
+			MTP_vector<MTPPageBlock>(ConvertBlocks(data.vblocks().v)),
+			data.vtitle());
+	}, [&](const MTPDpageBlockBlockquoteBlocks &data) -> MTPPageBlock {
+		return MTP_pageBlockBlockquoteBlocks(
+			MTP_vector<MTPPageBlock>(ConvertBlocks(data.vblocks().v)),
+			data.vcaption());
+	}, [&](const MTPDpageBlockList &data) -> MTPPageBlock {
+		auto items = QVector<MTPPageListItem>();
+		for (const auto &item : data.vitems().v) {
+			items.push_back(item.match([&](
+					const MTPDpageListItemBlocks &data) -> MTPPageListItem {
+				return MTP_pageListItemBlocks(
+					data.vflags(),
+					MTP_vector<MTPPageBlock>(
+						ConvertBlocks(data.vblocks().v)));
+			}, [&](const auto &) -> MTPPageListItem {
+				return item;
+			}));
+		}
+		return MTP_pageBlockList(MTP_vector<MTPPageListItem>(items));
+	}, [&](const MTPDpageBlockOrderedList &data) -> MTPPageBlock {
+		auto items = QVector<MTPPageListOrderedItem>();
+		for (const auto &item : data.vitems().v) {
+			items.push_back(item.match([&](
+					const MTPDpageListOrderedItemBlocks &data) -> MTPPageListOrderedItem {
+				return MTP_pageListOrderedItemBlocks(
+					data.vflags(),
+					data.vnum() ? *data.vnum() : MTPstring(),
+					MTP_vector<MTPPageBlock>(
+						ConvertBlocks(data.vblocks().v)),
+					data.vvalue() ? *data.vvalue() : MTPint(),
+					data.vtype() ? *data.vtype() : MTPstring());
+			}, [&](const auto &) -> MTPPageListOrderedItem {
+				return item;
+			}));
+		}
+		return MTP_pageBlockOrderedList(
+			data.vflags(),
+			MTP_vector<MTPPageListOrderedItem>(items),
+			data.vstart() ? *data.vstart() : MTPint(),
+			data.vtype() ? *data.vtype() : MTPstring());
+	}, [&](const auto &) -> MTPPageBlock {
+		return block;
+	});
+}
+
+QVector<MTPPageBlock> ConvertBlocks(const QVector<MTPPageBlock> &blocks) {
+	auto result = QVector<MTPPageBlock>();
+	result.reserve(blocks.size());
+	for (const auto &block : blocks) {
+		result.push_back(ConvertBlock(block));
+	}
+	return result;
+}
