+void DraftsStore::addDiscarded(
+		DraftsThread thread,
+		TextWithTags text,
+		FullReplyTo reply,
+		Data::WebPageDraft webpage) {
+	const auto trimmed = text.text.trimmed();
+	if (!thread || trimmed.isEmpty()) {
+		return;
+	}
+	for (const auto &draft : _list) {
+		if (draft.thread == thread && draft.text.text.trimmed() == trimmed) {
+			if (draft.discarded) {
+				update(draft);
+			}
+			return;
+		}
+	}
+	const auto now = base::unixtime::now();
+	_list.insert(begin(_list), SavedDraft{
+		.id = generateId(),
+		.thread = thread,
+		.text = std::move(text),
+		.reply = NormalizeDraftReply(reply, thread),
+		.webpage = webpage,
+		.discarded = true,
+		.created = now,
+		.edited = now,
+	});
+	prune();
+	changed();
+}
+
+void DraftsStore::noteSent(PeerId peer) {
+	_sent[peer] = crl::now();
+}
+
+bool DraftsStore::sentSince(PeerId peer, crl::time when) const {
+	const auto i = _sent.find(peer);
+	return (i != end(_sent)) && (i->second >= when);
+}
+
+void DraftsStore::trackScheduled(not_null<History*> history) {
+	if (_scheduled.contains(history)) {
+		return;
+	}
+	auto &scheduled = _session->scheduledMessages();
+	_scheduled.emplace(history, scheduled.count(history));
+	scheduled.updates(history) | rpl::on_next([=] {
+		const auto now = _session->scheduledMessages().count(history);
+		auto &was = _scheduled[history];
+		if (now > was) {
+			noteSent(history->peer->id);
+		}
+		was = now;
+	}, _lifetime);
+}
+
+bool DraftsStore::prune() {
+	const auto now = base::unixtime::now();
+	auto counts = base::flat_map<DraftsThread, int>();
+	const auto was = _list.size();
+	_list.erase(ranges::remove_if(_list, [&](const SavedDraft &draft) {
+		if (!draft.discarded) {
+			return false;
+		} else if (draft.edited + kDiscardedLifetime < now) {
+			return true;
+		}
+		return (++counts[draft.thread] > kDiscardedPerChat);
+	}), end(_list));
+	return (_list.size() != was);
+}
+
+int DraftsStore::savedCount(DraftsThread thread) const {
+	return int(ranges::count_if(_list, [&](const SavedDraft &draft) {
+		return !draft.discarded && draft.thread == thread;
+	}));
+}
+
+int DraftsStore::savedCount() const {
+	return int(ranges::count(_list, false, &SavedDraft::discarded));
+}
