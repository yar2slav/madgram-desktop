+HistoryItemCommonFields DraftsWidget::fields(
+		const SavedDraft &draft,
+		uint64 groupedId) {
+	auto flags = MessageFlag::FakeHistoryItem | MessageFlag::Outgoing;
+	auto reply = FullReplyTo();
+	if (draft.reply.replying()) {
+		flags |= MessageFlag::HasReplyInfo;
+		reply = draft.reply;
+	}
+	return {
+		.id = _history->nextNonHistoryEntryId(),
+		.flags = flags,
+		.from = session().userPeerId(),
+		.replyTo = reply,
+		.date = draft.edited,
+		.groupedId = groupedId,
+	};
+}
