+[[nodiscard]] bool IsStoredName(const QString &name) {
+	if (name.size() != 16) {
+		return false;
+	}
+	for (const auto ch : name) {
+		const auto code = ch.unicode();
+		if (!((code >= '0' && code <= '9') || (code >= 'a' && code <= 'f'))) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString RandomHex() {
+	return u"%1"_q.arg(base::RandomValue<uint64>(), 16, 16, QChar('0'));
+}
+
+[[nodiscard]] QString SafeName(QString name) {
+	for (auto &ch : name) {
+		if (ch < QChar(32) || u"\\/:*?\"<>|"_q.contains(ch)) {
+			ch = QChar('_');
+		}
+	}
+	name = name.trimmed();
+	while (name.startsWith('.')) {
+		name = name.mid(1);
+	}
+	return name.isEmpty() ? u"file"_q : name;
+}
+
+[[nodiscard]] QString UniqueName(
+		const QString &name,
+		base::flat_set<QString> &used) {
+	const auto info = QFileInfo(name);
+	const auto base = info.completeBaseName();
+	const auto suffix = info.suffix();
+	auto result = name;
+	for (auto i = 2; used.contains(result.toLower()); ++i) {
+		result = suffix.isEmpty()
+			? u"%1 (%2)"_q.arg(base).arg(i)
+			: u"%1 (%2).%3"_q.arg(base).arg(i).arg(suffix);
+	}
+	used.emplace(result.toLower());
+	return result;
+}
+
+[[nodiscard]] QByteArray PrepareThumbnail(QImage image) {
+	if (image.isNull()) {
+		return QByteArray();
+	}
+	if (image.width() > kThumbnailSize || image.height() > kThumbnailSize) {
+		image = image.scaled(
+			kThumbnailSize,
+			kThumbnailSize,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation);
+	}
+	auto flat = QImage(image.size(), QImage::Format_RGB32);
+	flat.fill(Qt::white);
+	{
+		auto p = QPainter(&flat);
+		p.drawImage(0, 0, image);
+	}
+	auto result = QByteArray();
+	auto buffer = QBuffer(&result);
+	buffer.open(QIODevice::WriteOnly);
+	flat.save(&buffer, "JPG", 80);
+	return result;
+}
+
+[[nodiscard]] int64 WriteEncryptedFile(
+		const DraftFileSource &source,
+		const QString &path,
+		const MTP::AuthKeyPtr &key) {
+	auto bytes = source.bytes;
+	if (source.path.isEmpty() && bytes.isEmpty() && !source.image.isNull()) {
+		auto buffer = QBuffer(&bytes);
+		buffer.open(QIODevice::WriteOnly);
+		source.image.save(&buffer, "PNG");
+	}
+	auto input = std::unique_ptr<QIODevice>();
+	if (!source.path.isEmpty()) {
+		input = std::make_unique<QFile>(source.path);
+	} else {
+		input = std::make_unique<QBuffer>(&bytes);
+	}
+	if (!input->open(QIODevice::ReadOnly)) {
+		return -1;
+	}
+	auto output = QFile(path);
+	if (!output.open(QIODevice::WriteOnly)) {
+		return -1;
+	}
+	auto stream = QDataStream(&output);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << kFileMagic << kFileVersion;
+	auto total = int64();
+	while (stream.status() == QDataStream::Ok) {
+		const auto chunk = input->read(kChunkSize);
+		if (chunk.isEmpty()) {
+			break;
+		}
+		auto data = EncryptedDescriptor(chunk.size());
+		data.stream.writeRawData(chunk.constData(), chunk.size());
+		stream << PrepareEncrypted(data, key);
+		total += chunk.size();
+	}
+	const auto ok = (stream.status() == QDataStream::Ok)
+		&& input->atEnd()
+		&& output.flush();
+	output.close();
+	if (!ok) {
+		QFile::remove(path);
+		return -1;
+	}
+	return total;
+}
+
+[[nodiscard]] bool DecryptStoredFile(
+		const QString &from,
+		const QString &to,
+		const MTP::AuthKeyPtr &key) {
+	auto input = QFile(from);
+	if (!input.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	auto stream = QDataStream(&input);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto magic = quint32();
+	auto version = qint32();
+	stream >> magic >> version;
+	if (stream.status() != QDataStream::Ok
+		|| magic != kFileMagic
+		|| version != kFileVersion) {
+		return false;
+	}
+	auto output = QFile(to);
+	if (!output.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	auto ok = true;
+	while (ok && !stream.atEnd()) {
+		auto encrypted = QByteArray();
+		stream >> encrypted;
+		auto data = EncryptedDescriptor();
+		const auto skip = int(sizeof(uint32));
+		ok = (stream.status() == QDataStream::Ok)
+			&& DecryptLocal(data, encrypted, key)
+			&& (data.data.size() >= skip);
+		if (ok) {
+			const auto size = data.data.size() - skip;
+			ok = (output.write(data.data.constData() + skip, size) == size);
+		}
+	}
+	ok = ok && output.flush();
+	output.close();
+	if (!ok) {
+		QFile::remove(to);
+	}
+	return ok;
+}
+
+[[nodiscard]] qint32 WebPageFlags(const Data::WebPageDraft &webpage) {
+	return (webpage.forceLargeMedia ? 1 : 0)
+		| (webpage.forceSmallMedia ? 2 : 0)
+		| (webpage.invert ? 4 : 0)
+		| (webpage.manual ? 8 : 0)
+		| (webpage.removed ? 16 : 0);
+}
+
+void ApplyWebPageFlags(Data::WebPageDraft &webpage, qint32 flags) {
+	webpage.forceLargeMedia = (flags & 1) != 0;
+	webpage.forceSmallMedia = (flags & 2) != 0;
+	webpage.invert = (flags & 4) != 0;
+	webpage.manual = (flags & 8) != 0;
+	webpage.removed = (flags & 16) != 0;
+}
+
+void Serialize(QDataStream &stream, const SavedDraft &draft) {
+	const auto quoteTags = TextUtilities::ConvertEntitiesToTextTags(
+		draft.reply.quote.entities);
+	stream
+		<< quint64(draft.id)
+		<< SerializePeerId(draft.thread.peer)
+		<< qint64(draft.thread.topicRootId.bare)
+		<< SerializePeerId(draft.thread.monoforumPeerId)
+		<< draft.name
+		<< draft.text.text
+		<< TextUtilities::SerializeTags(draft.text.tags)
+		<< SerializePeerId(draft.reply.messageId.peer)
+		<< qint64(draft.reply.messageId.msg.bare)
+		<< draft.reply.quote.text
+		<< TextUtilities::SerializeTags(quoteTags)
+		<< qint32(draft.reply.quoteOffset)
+		<< SerializePeerId(draft.reply.storyId.peer)
+		<< qint32(draft.reply.storyId.story)
+		<< qint32(draft.reply.todoItemId)
+		<< draft.reply.pollOption
+		<< quint64(draft.webpage.id)
+		<< draft.webpage.url
+		<< WebPageFlags(draft.webpage)
+		<< qint32(draft.filesWay)
+		<< qint32((draft.invertCaption ? 1 : 0) | (draft.discarded ? 2 : 0))
+		<< qint32(draft.created)
+		<< qint32(draft.edited)
+		<< quint32(draft.files.size());
+	for (const auto &file : draft.files) {
+		stream
+			<< file.name
+			<< file.stored
+			<< qint64(file.size)
+			<< file.thumbnail
+			<< qint32(file.spoiler ? 1 : 0);
+	}
+	stream << draft.richData;
+}
+
+[[nodiscard]] std::optional<SavedDraft> Deserialize(
+		QDataStream &stream,
+		qint32 version) {
+	auto id = quint64();
+	auto peer = quint64();
+	auto topicRootId = qint64();
+	auto monoforumPeerId = quint64();
+	auto name = QString();
+	auto text = QString();
+	auto tags = QByteArray();
+	auto replyPeer = quint64();
+	auto replyMsg = qint64();
+	auto quote = QString();
+	auto quoteTags = QByteArray();
+	auto quoteOffset = qint32();
+	auto storyPeer = quint64();
+	auto storyId = qint32();
+	auto todoItemId = qint32();
+	auto pollOption = QByteArray();
+	auto webpageId = quint64();
+	auto webpageUrl = QString();
+	auto webpageFlags = qint32();
+	auto filesWay = qint32();
+	auto flags = qint32();
+	auto created = qint32();
+	auto edited = qint32();
+	auto filesCount = quint32();
+	stream
+		>> id
+		>> peer
+		>> topicRootId
+		>> monoforumPeerId
+		>> name
+		>> text
+		>> tags
+		>> replyPeer
+		>> replyMsg
+		>> quote
+		>> quoteTags
+		>> quoteOffset
+		>> storyPeer
+		>> storyId
+		>> todoItemId
+		>> pollOption
+		>> webpageId
+		>> webpageUrl
+		>> webpageFlags
+		>> filesWay
+		>> flags
+		>> created
+		>> edited
+		>> filesCount;
+	if (!CheckStreamStatus(stream) || filesCount > 1024) {
+		return std::nullopt;
+	}
+	auto result = SavedDraft{
+		.id = id,
+		.thread = {
+			.peer = DeserializePeerId(peer),
+			.topicRootId = MsgId(topicRootId),
+			.monoforumPeerId = DeserializePeerId(monoforumPeerId),
+		},
+		.name = name,
+		.text = {
+			text,
+			TextUtilities::DeserializeTags(tags, int(text.size())),
+		},
+		.filesWay = filesWay,
+		.invertCaption = (flags & 1) != 0,
+		.discarded = (flags & 2) != 0,
+		.created = TimeId(created),
+		.edited = TimeId(edited),
+	};
+	result.reply.messageId = FullMsgId(
+		DeserializePeerId(replyPeer),
+		MsgId(replyMsg));
+	result.reply.quote = TextWithEntities{
+		quote,
+		TextUtilities::ConvertTextTagsToEntities(
+			TextUtilities::DeserializeTags(quoteTags, int(quote.size()))),
+	};
+	result.reply.quoteOffset = quoteOffset;
+	result.reply.storyId = FullStoryId{
+		DeserializePeerId(storyPeer),
+		StoryId(storyId),
+	};
+	result.reply.todoItemId = todoItemId;
+	result.reply.pollOption = pollOption;
+	result.reply.topicRootId = result.thread.topicRootId;
+	result.reply.monoforumPeerId = result.thread.monoforumPeerId;
+	result.webpage.id = WebPageId(webpageId);
+	result.webpage.url = webpageUrl;
+	ApplyWebPageFlags(result.webpage, webpageFlags);
+	for (auto i = quint32(); i != filesCount; ++i) {
+		auto file = SavedDraftFile();
+		auto size = qint64();
+		auto spoiler = qint32();
+		stream
+			>> file.name
+			>> file.stored
+			>> size
+			>> file.thumbnail
+			>> spoiler;
+		if (!CheckStreamStatus(stream)) {
+			return std::nullopt;
+		}
+		file.size = size;
+		file.spoiler = (spoiler != 0);
+		result.files.push_back(std::move(file));
+	}
+	if (version >= 2) {
+		stream >> result.richData;
+		if (!CheckStreamStatus(stream)) {
+			return std::nullopt;
+		}
+	}
+	return result;
+}
