+
+void DraftsWidget::normalizeSelection() {
+	auto selected = base::flat_set<FullMsgId>();
+	for (const auto &item : _inner->getSelectedItems()) {
+		selected.emplace(item.msgId);
+	}
+	auto result = base::flat_set<uint64>();
+	auto changed = false;
+	auto known = 0;
+	for (const auto &[draft, items] : _draftItems) {
+		const auto count = int(ranges::count_if(items, [&](FullMsgId id) {
+			return selected.contains(id);
+		}));
+		known += count;
+		if (!count) {
+			continue;
+		} else if (count == int(items.size())) {
+			result.emplace(draft);
+		} else {
+			changed = true;
+			if (!_selectedDrafts.contains(draft)) {
+				result.emplace(draft);
+			}
+		}
+	}
+	if (known != int(selected.size())) {
+		changed = true;
+	}
+	_selectedDrafts = std::move(result);
+	if (changed) {
+		applySelection();
+	}
+	updateSelectionBar();
+}
+
+void DraftsWidget::applySelection() {
+	if (!_inner) {
+		return;
+	}
+	_selecting = true;
+	_inner->cancelSelection();
+	for (const auto draft : _selectedDrafts) {
+		const auto i = _draftItems.find(draft);
+		if (i == end(_draftItems)) {
+			continue;
+		}
+		for (const auto &id : i->second) {
+			if (const auto item = _history->owner().message(id)) {
+				_inner->selectItem(item);
+			}
+		}
+	}
+	_selecting = false;
+}
+
+void DraftsWidget::updateSelectionBar() {
+	const auto sendable = ranges::any_of(_selectedDrafts, [&](uint64 id) {
+		const auto draft = Drafts(&session()).find(id);
+		return draft && !draft->discarded;
+	});
+	_topBar->setSelected(int(_selectedDrafts.size()), sendable);
+}
+
+void DraftsWidget::clearDraftSelection() {
+	_selectedDrafts.clear();
+	applySelection();
+	updateSelectionBar();
+}
+
+void DraftsWidget::sendSelected() {
+	auto ids = std::vector<uint64>();
+	for (const auto id : selectedDrafts()) {
+		const auto draft = Drafts(&session()).find(id);
+		if (draft && !draft->discarded) {
+			ids.push_back(id);
+		}
+	}
+	if (!ids.empty()) {
+		ShowSendDraftsBox(
+			controller(),
+			std::move(ids),
+			_thread,
+			crl::guard(this, [=] { clearDraftSelection(); }));
+	}
+}
+
+void DraftsWidget::deleteSelected() {
+	if (auto ids = selectedDrafts(); !ids.empty()) {
+		ConfirmDeleteDrafts(
+			controller(),
+			std::move(ids),
+			crl::guard(this, [=] { clearDraftSelection(); }));
+	}
+}
