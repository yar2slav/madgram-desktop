+void DraftsStore::importFiles(
+		std::vector<DraftFileSource> sources,
+		Fn<void(std::optional<std::vector<SavedDraftFile>>)> done) {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		done(std::nullopt);
+		return;
+	}
+	const auto path = folder();
+	auto names = std::vector<QString>();
+	for (auto &source : sources) {
+		if (!source.reuse.isEmpty() && !QFile::exists(path + source.reuse)) {
+			source.reuse = QString();
+		}
+		const auto name = source.reuse.isEmpty()
+			? generateStoredName()
+			: source.reuse;
+		_importing.emplace(name);
+		names.push_back(name);
+	}
+	crl::async([=, sources = std::move(sources)] {
+		QDir().mkpath(path);
+		auto result = std::vector<SavedDraftFile>();
+		auto failed = false;
+		for (auto i = 0; i != int(sources.size()); ++i) {
+			const auto &source = sources[i];
+			auto file = SavedDraftFile{
+				.name = source.name,
+				.stored = names[i],
+				.size = source.size,
+				.thumbnail = PrepareThumbnail(source.thumbnail),
+				.spoiler = source.spoiler,
+			};
+			if (source.reuse.isEmpty()) {
+				const auto size = WriteEncryptedFile(
+					source,
+					path + names[i],
+					key);
+				if (size < 0) {
+					failed = true;
+					break;
+				}
+				file.size = size;
+			}
+			result.push_back(std::move(file));
+		}
+		crl::on_main(this, [=, result = std::move(result)]() mutable {
+			for (const auto &name : names) {
+				_importing.remove(name);
+			}
+			if (failed) {
+				collectGarbage();
+				done(std::nullopt);
+			} else {
+				done(std::move(result));
+			}
+		});
+	});
+}
+
+void DraftsStore::exportFiles(
+		std::vector<SavedDraftFile> files,
+		Fn<void(QStringList)> done) {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		done(QStringList());
+		return;
+	}
+	const auto from = folder();
+	const auto to = tempFolder() + RandomHex() + '/';
+	crl::async([=] {
+		auto result = QStringList();
+		auto used = base::flat_set<QString>();
+		QDir().mkpath(to);
+		for (const auto &file : files) {
+			const auto target = to + UniqueName(SafeName(file.name), used);
+			if (!DecryptStoredFile(from + file.stored, target, key)) {
+				result.clear();
+				break;
+			}
+			result.push_back(target);
+		}
+		crl::on_main(this, [=] {
+			for (auto i = 0; i != int(result.size()); ++i) {
+				_exported[result[i]] = files[i].stored;
+			}
+			done(result);
+		});
+	});
+}
+
+void DraftsStore::prepareView(
+		std::vector<SavedDraftFile> files,
+		Fn<void()> done) {
+	const auto key = _session->local().peekLegacyLocalKey();
+	files.erase(ranges::remove_if(files, [&](const SavedDraftFile &file) {
+		return _viewPaths.contains(file.stored)
+			|| _viewPreparing.contains(file.stored)
+			|| fileMissing(file);
+	}), end(files));
+	if (!key || files.empty()) {
+		return;
+	}
+	for (const auto &file : files) {
+		_viewPreparing.emplace(file.stored);
+	}
+	const auto from = folder();
+	const auto to = tempFolder() + u"view/"_q;
+	crl::async([=] {
+		auto paths = base::flat_map<QString, QString>();
+		auto previews = base::flat_map<QString, QImage>();
+		for (const auto &file : files) {
+			const auto folder = to + file.stored + '/';
+			const auto target = folder + SafeName(file.name);
+			QDir().mkpath(folder);
+			if (!DecryptStoredFile(from + file.stored, target, key)) {
+				continue;
+			}
+			paths.emplace(file.stored, target);
+			auto reader = QImageReader(target);
+			reader.setAutoTransform(true);
+			const auto size = reader.size();
+			if (!reader.canRead()
+				|| size.isEmpty()
+				|| size.width() * int64(size.height()) > kPreviewPixels) {
+				continue;
+			}
+			auto image = reader.read();
+			if (image.isNull()) {
+				continue;
+			} else if (image.width() > kPreviewSide
+				|| image.height() > kPreviewSide) {
+				image = image.scaled(
+					kPreviewSide,
+					kPreviewSide,
+					Qt::KeepAspectRatio,
+					Qt::SmoothTransformation);
+			}
+			previews.emplace(
+				file.stored,
+				image.convertToFormat(QImage::Format_ARGB32_Premultiplied));
+		}
+		crl::on_main(this, [=] {
+			for (const auto &[stored, path] : paths) {
+				_viewPaths[stored] = path;
+			}
+			for (const auto &[stored, image] : previews) {
+				_viewPreviews[stored] = image;
+			}
+			done();
+		});
+	});
+}
+
+QString DraftsStore::viewPath(const QString &stored) const {
+	const auto i = _viewPaths.find(stored);
+	return (i != end(_viewPaths)) ? i->second : QString();
+}
