+constexpr auto kPreviewLength = 1024;
+
+[[nodiscard]] QString Flatten(QString text) {
+	for (auto &ch : text) {
+		if (ch == QChar('\n')
+			|| ch == QChar::LineSeparator
+			|| ch == QChar::ParagraphSeparator) {
+			ch = QChar(' ');
+		}
+	}
+	return text.simplified();
+}
+
+void AddInfoLine(
+		not_null<Ui::VerticalLayout*> container,
+		const QString &text) {
+	container->add(
+		object_ptr<Ui::FlatLabel>(
+			container,
+			text,
+			st::boxDividerLabel),
+		st::boxRowPadding);
+}
+
+[[nodiscard]] QString ReplyText(
+		not_null<Main::Session*> session,
+		const FullReplyTo &reply) {
+	if (!reply.quote.empty()) {
+		return Flatten(reply.quote.text.left(kPreviewLength));
+	} else if (const auto item = session->data().message(reply.messageId)) {
+		const auto text = Flatten(item->originalText().text.left(
+			kPreviewLength));
+		return text.isEmpty() ? Lower(u"a message"_q) : text;
+	}
+	return Lower(u"a message"_q);
+}
+
+[[nodiscard]] QString WebPageText(const Data::WebPageDraft &webpage) {
+	if (webpage.removed) {
+		return Lower(u"Link preview: off"_q);
+	} else if (!webpage.url.isEmpty()) {
+		return Lower(u"Link preview: %1"_q).arg(webpage.url);
+	}
+	return QString();
+}
