+bool ComposeDrafts::refreshBar() {
+	const auto id = editingId();
+	const auto shown = (id != 0) && (!_field->isHidden() || richShown());
+	if (shown) {
+		const auto draft = Drafts(_session).find(id);
+		const auto subtitle = BarSubtitle(draft);
+		_bar->setSubtitle((draft && !draft->files.empty() && !richShown())
+			? Lower(u"%1 \u00B7 saved without media"_q).arg(subtitle)
+			: subtitle);
