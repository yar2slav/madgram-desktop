+TopBar::TopBar(
+	QWidget *parent,
+	not_null<Main::Session*> session,
+	DraftsThread thread,
+	Fn<void()> back)
+: RpWidget(parent)
+, _session(session)
+, _thread(thread)
+, _back(this, st::historyTopBarBack)
+, _send(this, rpl::single(Lower(u"Send"_q)), st::defaultActiveButton)
+, _delete(this, rpl::single(Lower(u"Delete"_q)), st::defaultActiveButton)
+, _clear(this, tr::lng_selected_clear(), st::topBarClearButton) {
+	_back->setClickedCallback(std::move(back));
+	_back->setAccessibleName(tr::lng_go_back(tr::now));
+	_back->moveToLeft(0, 0);
+	_send->hide();
+	_delete->hide();
+	_clear->hide();
+	session->changes().peerUpdates(
+		Data::PeerUpdate::Flag::Name
+	) | rpl::filter([=](const Data::PeerUpdate &update) {
+		return (update.peer->id == _thread.peer);
+	}) | rpl::on_next([=] {
+		update();
+	}, lifetime());
+}
+
+void TopBar::setSelected(int count, bool sendable) {
+	_selected = count;
+	_back->setVisible(!count);
+	_send->setVisible(count && sendable);
+	_delete->setVisible(count > 0);
+	_clear->setVisible(count > 0);
+	if (count) {
+		_send->setNumbersText(count);
+		_delete->setNumbersText(count);
+	}
+	updateControlsGeometry(width());
+	update();
+}
+
+rpl::producer<> TopBar::sendRequests() const {
+	return _send->clicks() | rpl::to_empty;
+}
+
+rpl::producer<> TopBar::deleteRequests() const {
+	return _delete->clicks() | rpl::to_empty;
+}
+
+rpl::producer<> TopBar::clearRequests() const {
+	return _clear->clicks() | rpl::to_empty;
+}
+
+int TopBar::resizeGetHeight(int newWidth) {
+	updateControlsGeometry(newWidth);
+	return st::topBarHeight;
+}
+
+void TopBar::updateControlsGeometry(int newWidth) {
+	const auto top = (st::topBarHeight - _delete->height()) / 2;
+	auto left = st::topBarActionSkip;
+	if (!_send->isHidden()) {
+		_send->moveToLeft(left, top, newWidth);
+		left += _send->width() + st::topBarActionSkip;
+	}
+	_delete->moveToLeft(left, top, newWidth);
+	_clear->moveToRight(st::topBarActionSkip, top, newWidth);
+}
+
+void TopBar::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.fillRect(e->rect(), st::topBarBg);
+	if (_selected) {
+		return;
+	}
+	const auto left = _back->width();
+	const auto available = std::max(
+		width() - left - st::topBarArrowPadding.right(),
+		0);
+	const auto title = Lower(u"Drafts"_q);
+	const auto subtitle = DraftsThreadName(_session, _thread);
+	p.setPen(st::dialogsNameFg);
+	p.setFont(st::semiboldFont);
+	p.drawTextLeft(
+		left,
+		st::topBarArrowPadding.top(),
+		width(),
+		st::semiboldFont->elided(title, available));
+	p.setPen(st::historyStatusFg);
+	p.setFont(st::dialogsTextFont);
+	p.drawTextLeft(
+		left,
+		(st::topBarHeight
+			- st::topBarArrowPadding.bottom()
+			- st::dialogsTextFont->height),
+		width(),
+		st::dialogsTextFont->elided(subtitle, available));
+}
