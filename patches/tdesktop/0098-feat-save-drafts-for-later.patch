+[[nodiscard]] QString FilesLine(const SavedDraft &draft) {
+	auto names = QStringList();
+	for (const auto &file : draft.files) {
+		names.push_back(file.name);
+	}
+	return Lower(u"Files: %1"_q).arg(names.join(u", "_q));
+}
