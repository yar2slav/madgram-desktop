+bool DraftsWidget::confirmSendingFiles(const QStringList &files) {
+	return confirmSendingFiles(Storage::PrepareMediaList(
+		files,
+		st::sendMediaPreviewSize,
+		session().premium()));
+}
+
+bool DraftsWidget::confirmSendingFiles(not_null<const QMimeData*> data) {
+	if (const auto urls = Core::ReadMimeUrls(data); !urls.empty()) {
+		auto list = Storage::PrepareMediaList(
+			urls,
+			st::sendMediaPreviewSize,
+			session().premium());
+		if (list.error == Ui::PreparedList::Error::None) {
+			return confirmSendingFiles(std::move(list));
+		}
+	}
+	if (auto read = Core::ReadMimeImage(data)) {
+		return confirmSendingFiles(Storage::PrepareMediaFromImage(
+			std::move(read.image),
+			std::move(read.content),
+			st::sendMediaPreviewSize));
+	}
+	return false;
+}
+
+bool DraftsWidget::confirmSendingFiles(Ui::PreparedList &&list) {
+	if (list.error != Ui::PreparedList::Error::None || list.files.empty()) {
+		controller()->showToast(Lower(u"Couldn't read these files."_q));
+		return false;
+	}
+	auto box = Box<SendFilesBox>(
+		controller(),
+		std::move(list),
+		_composeControls->getTextWithAppliedMarkdown(),
+		_history->peer,
+		Api::SendType::Normal,
+		SendMenu::Details());
+	SetSendFilesBoxSavesDraft(box.data());
+	const auto show = _show;
+	const auto thread = _thread;
+	box->setConfirmedCallback(crl::guard(this, [=](
+			std::shared_ptr<Ui::PreparedBundle> bundle,
+			Api::SendOptions options,
+			FullReplyTo) {
+		if (SaveBundleAsDraft(show, thread, bundle, options.invertCaption)) {
+			_scrollToBottom = true;
+			_composeControls->clear();
+		}
+	}));
+	box->setCancelledCallback(_composeControls->restoreTextCallback(
+		QString()));
+	box->takeTextWithTagsRequests(
+	) | rpl::on_next([=](TextWithTags &&text) {
+		_composeControls->setText(std::move(text));
+	}, box->lifetime());
+	_composeControls->setText({});
+	controller()->show(std::move(box));
+	return true;
+}
