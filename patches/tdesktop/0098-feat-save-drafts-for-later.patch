+void ChatsController::refreshRows() {
+	const auto session = &this->session();
+	for (auto i = delegate()->peerListFullRowsCount(); i != 0;) {
+		delegate()->peerListRemoveRow(delegate()->peerListRowAt(--i));
+	}
+	struct Counts {
+		int saved = 0;
+		int discarded = 0;
+		TimeId edited = 0;
+	};
+	auto threads = base::flat_map<DraftsThread, Counts>();
+	for (const auto &draft : Drafts(session).list()) {
+		auto &counts = threads[draft.thread];
+		++(draft.discarded ? counts.discarded : counts.saved);
+		counts.edited = std::max(counts.edited, draft.edited);
+	}
+	auto ordered = std::vector<std::pair<DraftsThread, Counts>>();
+	for (const auto &[thread, counts] : threads) {
+		ordered.emplace_back(thread, counts);
+	}
+	ranges::sort(ordered, ranges::greater(), [](const auto &pair) {
+		return pair.second.edited;
+	});
+	auto id = PeerListRowId();
+	for (const auto &[thread, counts] : ordered) {
+		const auto peer = session->data().peerLoaded(thread.peer);
+		if (!peer) {
+			continue;
+		}
+		auto row = std::make_unique<Row>(
+			peer,
+			++id,
+			thread,
+			DraftsThreadName(session, thread));
+		auto status = QStringList();
+		if (counts.saved) {
+			status.push_back((counts.saved == 1)
+				? Lower(u"1 draft"_q)
+				: Lower(u"%1 drafts"_q).arg(counts.saved));
+		}
+		if (counts.discarded) {
+			status.push_back(Lower(u"%1 discarded"_q).arg(counts.discarded));
+		}
+		row->setCustomStatus(status.join(u", "_q));
+		delegate()->peerListAppendRow(std::move(row));
+	}
+	setDescriptionText(!id
+		? Lower(u"No saved drafts yet. Right-click the send button or "
+			"press Ctrl+S in the message field to save one."_q)
+		: QString());
+	delegate()->peerListRefreshRows();
+}
