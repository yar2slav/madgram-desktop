+Data::MessagesSlice DraftsWidget::buildSlice() const {
+	auto result = Data::MessagesSlice();
+	result.ids = _ids;
+	result.fullCount = int(_ids.size());
+	result.skippedBefore = result.skippedAfter = 0;
+	if (!_ids.empty()) {
+		result.nearestToAround = _ids.back();
+	}
+	return result;
+}
