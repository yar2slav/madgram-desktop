+rpl::producer<> DraftsStore::changes() const {
+	return _changes.events();
+}
+
+uint64 DraftsStore::generateId() const {
+	while (true) {
+		const auto result = base::RandomValue<uint64>();
+		if (result && !find(result)) {
+			return result;
+		}
+	}
+}
+
+uint64 DraftsStore::add(SavedDraft draft) {
+	const auto now = base::unixtime::now();
+	draft.id = generateId();
+	draft.created = draft.edited = now;
+	_list.insert(begin(_list), std::move(draft));
+	const auto result = _list.front().id;
+	changed();
+	return result;
+}
+
+void DraftsStore::update(SavedDraft draft) {
+	const auto i = ranges::find(_list, draft.id, &SavedDraft::id);
+	if (i == end(_list)) {
+		return;
+	}
+	draft.edited = base::unixtime::now();
+	_list.erase(i);
+	_list.insert(begin(_list), std::move(draft));
+	changed();
+}
+
+void DraftsStore::remove(uint64 id) {
+	const auto i = ranges::find(_list, id, &SavedDraft::id);
+	if (i == end(_list)) {
+		return;
+	}
+	_list.erase(i);
+	auto editing = false;
+	for (auto j = begin(_editing); j != end(_editing);) {
+		if (j->second.id == id) {
+			j = _editing.erase(j);
+			editing = true;
+		} else {
+			++j;
+		}
+	}
+	changed();
+	if (editing) {
+		_editingChanges.fire({});
+	}
+}
+
+uint64 DraftsStore::duplicate(uint64 id) {
+	const auto existing = find(id);
+	if (!existing) {
+		return 0;
+	}
+	auto copy = *existing;
+	copy.discarded = false;
+	if (!copy.name.isEmpty()) {
+		copy.name = Lower(u"%1 (copy)"_q).arg(copy.name);
+	}
+	return add(std::move(copy));
+}
