+struct SendFilesBoxAccess {
+	[[nodiscard]] static DraftsThread Thread(not_null<SendFilesBox*> box);
+	[[nodiscard]] static bool SavesOnly(not_null<SendFilesBox*> box);
+	[[nodiscard]] static bool Allowed(not_null<SendFilesBox*> box);
+	[[nodiscard]] static uint64 Editing(not_null<SendFilesBox*> box);
+	static void Save(not_null<SendFilesBox*> box, bool asNew);
+	static void SendThrough(
+		not_null<SendFilesBox*> box,
+		Api::SendOptions options);
+	static bool Intercept(not_null<SendFilesBox*> box);
+	static void FillMenu(
+		not_null<SendFilesBox*> box,
+		not_null<Ui::PopupMenu*> menu,
+		SendMenu::Details details);
+	static void Setup(not_null<SendFilesBox*> box);
+	static void AddButton(not_null<SendFilesBox*> box);
+};
+
+DraftsThread SendFilesBoxAccess::Thread(not_null<SendFilesBox*> box) {
+	return {
+		.peer = box->_toPeer->id,
+		.topicRootId = box->_replyTo.topicRootId,
+		.monoforumPeerId = box->_replyTo.monoforumPeerId,
+	};
+}
+
+bool SendFilesBoxAccess::SavesOnly(not_null<SendFilesBox*> box) {
+	return box->property("teleDraftsSave").toBool();
+}
+
+bool SendFilesBoxAccess::Allowed(not_null<SendFilesBox*> box) {
+	return (box->_sendType == Api::SendType::Normal)
+		&& (box->_confirmedCallback != nullptr)
+		&& !SavesOnly(box);
+}
+
+uint64 SendFilesBoxAccess::Editing(not_null<SendFilesBox*> box) {
+	return Allowed(box)
+		? Drafts(&box->_show->session()).editing(Thread(box))
+		: 0;
+}
+
+bool SendFilesBoxAccess::Intercept(not_null<SendFilesBox*> box) {
+	if (!Editing(box) || box->property("teleDraftsThrough").toBool()) {
+		return false;
+	}
+	Save(box, false);
+	return true;
+}
+
+void SendFilesBoxAccess::SendThrough(
+		not_null<SendFilesBox*> box,
+		Api::SendOptions options) {
+	const auto id = Editing(box);
+	if (!id) {
+		return;
+	}
+	const auto session = &box->_show->session();
+	const auto thread = Thread(box);
+	box->setProperty("teleDraftsThrough", true);
+	box->send(options, false);
+	if (!box->_confirmed) {
+		return;
+	}
+	auto &store = Drafts(session);
+	const auto before = store.editingBefore(thread);
+	const auto beforeRich = store.editingBeforeRich(thread);
+	store.stopEditing(thread);
+	store.remove(id);
+	RestoreFieldDraft(session, thread, before, beforeRich);
+}
+
+void SendFilesBoxAccess::Save(not_null<SendFilesBox*> box, bool asNew) {
+	if (!Allowed(box)) {
+		return;
+	} else if (box->_preparing) {
+		box->showToast(Lower(u"Wait until the files are ready."_q));
+		return;
+	}
+	const auto thread = Thread(box);
+	const auto show = box->_show;
+	auto &store = Drafts(&show->session());
+	for (auto &item : box->_list.files) {
+		item.spoiler = false;
+	}
+	box->applyBlockChanges();
+	Storage::ApplyModifications(box->_list, false);
+	auto sources = std::vector<DraftFileSource>();
+	for (const auto &file : box->_list.files) {
+		auto source = SourceFromFile(file, store);
+		if (!source) {
+			box->showToast(Lower(u"This file can't be kept in a draft."_q));
+			return;
+		}
+		sources.push_back(std::move(*source));
+	}
+	auto draft = MediaDraft{
+		.thread = thread,
+		.text = box->fieldText(),
+		.reply = NormalizeDraftReply(box->_replyTo, thread),
+		.way = box->_sendWay.current().serialize(),
+		.invert = box->_invertCaption,
+		.editingId = asNew ? uint64() : store.editing(thread),
+		.finishEditing = (store.editing(thread) != 0),
+	};
+	box->_confirmed = true;
+	box->closeBox();
+	ImportMediaDraft(show, std::move(sources), std::move(draft));
+}
+
+void SendFilesBoxAccess::FillMenu(
+		not_null<SendFilesBox*> box,
+		not_null<Ui::PopupMenu*> menu,
+		SendMenu::Details details) {
+	if (!menu->empty()) {
+		menu->addSeparator();
+	}
+	if (Editing(box)) {
+		AddSendThroughActions(
+			menu,
+			box,
+			box->_show,
+			details,
+			crl::guard(box, [=](Api::SendOptions options) {
+				SendThrough(box, options);
+			}));
+		menu->addAction(Lower(u"Save as new draft"_q), crl::guard(box, [=] {
+			Save(box, true);
+		}), &st::menuIconArchive);
+	} else {
+		menu->addAction(Lower(u"Save as draft"_q), crl::guard(box, [=] {
+			Save(box, true);
+		}), &st::menuIconArchive);
+	}
+}
+
+void SendFilesBoxAccess::Setup(not_null<SendFilesBox*> box) {
+	const auto session = &box->_show->session();
+	const auto peer = box->_toPeer->id;
+	if (SavesOnly(box)) {
+		return;
+	}
+	box->boxClosing() | rpl::on_next([=] {
+		if (box->_confirmed) {
+			Drafts(session).noteSent(peer);
+		}
+	}, box->lifetime());
+	if (!Allowed(box)) {
+		return;
+	}
+	base::install_event_filter(
+		box,
+		box->_caption->rawTextEdit(),
+		[=](not_null<QEvent*> e) {
+			if (e->type() == QEvent::KeyPress
+				&& IsSaveShortcut(static_cast<QKeyEvent*>(e.get()))) {
+				Save(box, false);
+				return base::EventFilterResult::Cancel;
+			}
+			return base::EventFilterResult::Continue;
+		});
+}
+
+void SendFilesBoxAccess::AddButton(not_null<SendFilesBox*> box) {
+	if (!box->property("teleDrafts").toBool()) {
+		box->setProperty("teleDrafts", true);
+		Setup(box);
+	}
+	if ((SavesOnly(box) || Editing(box)) && box->_send) {
+		box->_send->setText(rpl::single(Lower(u"Save draft"_q)));
+	}
+	if (!Allowed(box)) {
+		return;
+	}
+	const auto button = box->addTopButton(box->_st.files.menu, [=] {
+		Save(box, false);
+	});
+	button->setIconOverride(&st::menuIconArchive, &st::menuIconArchive);
+	button->setAccessibleName(Lower(u"Save as draft"_q));
+}
+
+void SendFilesDraftMenu(
+		not_null<SendFilesBox*> box,
+		SendMenu::Details &details) {
+	if (!SendFilesBoxAccess::Allowed(box)) {
+		return;
+	}
+	const auto normal = details;
+	if (SendFilesBoxAccess::Editing(box)) {
+		details.type = SendMenu::Type::Disabled;
+		details.effectAllowed = false;
+	}
+	details.teleMenu = crl::guard(box, [=](not_null<Ui::PopupMenu*> menu) {
+		SendFilesBoxAccess::FillMenu(box, menu, normal);
+	});
+}
+
+bool SendFilesDraftIntercept(not_null<SendFilesBox*> box) {
+	return SendFilesBoxAccess::Intercept(box);
+}
+
+void AddSendFilesDraftButton(not_null<SendFilesBox*> box) {
+	SendFilesBoxAccess::AddButton(box);
+}
+
+void SetSendFilesBoxSavesDraft(not_null<SendFilesBox*> box) {
+	box->setProperty("teleDraftsSave", true);
+}
+
+bool SaveBundleAsDraft(
+		std::shared_ptr<ChatHelpers::Show> show,
+		DraftsThread thread,
+		std::shared_ptr<Ui::PreparedBundle> bundle,
+		bool invertCaption) {
+	const auto &store = Drafts(&show->session());
+	auto sources = std::vector<DraftFileSource>();
+	auto text = TextWithTags();
+	for (const auto &group : bundle->groups) {
+		for (const auto &file : group.list.files) {
+			auto source = SourceFromFile(file, store);
+			if (!source) {
+				show->showToast(
+					Lower(u"This file can't be kept in a draft."_q));
+				return false;
+			}
+			if (!file.caption.text.isEmpty()) {
+				text = file.caption;
+			}
+			sources.push_back(std::move(*source));
+		}
+	}
+	ImportMediaDraft(show, std::move(sources), {
+		.thread = thread,
+		.text = std::move(text),
+		.reply = NormalizeDraftReply(FullReplyTo(), thread),
+		.way = bundle->way.serialize(),
+		.invert = invertCaption,
+		.toast = false,
+	});
+	return true;
+}
+
+void NoteLocalDraftReplace(
+		not_null<History*> history,
+		MsgId topicRootId,
+		PeerId monoforumPeerId,
+		const TextWithTags *replacement) {
+	const auto session = &history->session();
+	const auto thread = DraftsThread{
+		.peer = history->peer->id,
+		.topicRootId = topicRootId,
+		.monoforumPeerId = monoforumPeerId,
+	};
+	for (const auto instance : Instances()) {
+		if (instance->shows(session, thread)) {
+			return;
+		}
+	}
+	const auto existing = history->localDraft(topicRootId, monoforumPeerId);
+	if (!existing
+		|| !DiscardMeaningful(existing->textWithTags.text)
+		|| (replacement
+			&& !DiscardLost(existing->textWithTags.text, replacement->text))) {
+		return;
+	}
+	auto &store = Drafts(session);
+	if (store.sentSince(thread.peer, crl::now() - kSentWindow)) {
+		return;
+	}
+	store.addDiscarded(
+		thread,
+		existing->textWithTags,
+		existing->reply,
+		existing->webpage);
+}
+
+void NoteCloudDraftReplace(
+		not_null<History*> history,
+		MsgId topicRootId,
+		PeerId monoforumPeerId) {
+	const auto existing = history->localDraft(topicRootId, monoforumPeerId);
+	const auto cloud = history->cloudDraft(topicRootId, monoforumPeerId);
+	if (Data::DraftIsNull(existing) || existing == cloud) {
+		return;
+	} else if (!cloud) {
+		NoteLocalDraftReplace(history, topicRootId, monoforumPeerId, nullptr);
+	} else if (!Data::DraftIsNull(cloud)
+		&& cloud->date
+		&& !cloud->hasRichMessage()
+		&& (!existing->date || cloud->date >= existing->date)) {
+		NoteLocalDraftReplace(
+			history,
+			topicRootId,
+			monoforumPeerId,
+			&cloud->textWithTags);
+	}
+}
+
+void StartDraftEditing(
+		not_null<Main::Session*> session,
+		DraftsThread thread,
+		uint64 id) {
+	Core::App().materializeLocalDrafts();
+	auto &store = Drafts(session);
+	const auto already = (store.editing(thread) != 0);
+	auto before = already
+		? store.editingBefore(thread)
+		: CopyLocalDraft(session, thread);
+	auto beforeRich = already
+		? store.editingBeforeRich(thread)
+		: CopyRichCloudDraft(session, thread);
+	store.startEditing(thread, id, std::move(before), std::move(beforeRich));
+}
+
+void FinishDraftEditing(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	auto &store = Drafts(session);
+	if (!store.editing(thread)) {
+		store.stopEditing(thread);
+		return;
+	}
+	const auto before = store.editingBefore(thread);
+	const auto beforeRich = store.editingBeforeRich(thread);
+	store.stopEditing(thread);
+	RestoreFieldDraft(session, thread, before, beforeRich);
+}
+
+std::optional<bool> SaveEditedRichDraft(
+		not_null<History*> history,
+		MsgId topicRootId,
+		PeerId monoforumPeerId,
+		const Iv::RichPage &page) {
+	const auto session = &history->session();
+	const auto thread = DraftsThread{
+		.peer = history->peer->id,
+		.topicRootId = topicRootId,
+		.monoforumPeerId = monoforumPeerId,
+	};
+	auto &store = Drafts(session);
+	const auto id = store.editing(thread);
+	const auto existing = id ? store.find(id) : nullptr;
+	if (!existing) {
+		return std::nullopt;
+	}
+	const auto show = ShowForHistory(history);
+	auto copy = *existing;
+	if (auto simple = Iv::SerializeAsSimple(page, session)) {
+		AssignRichDraft(session, copy, nullptr);
+		copy.text = TextWithTags{
+			simple->text,
+			TextUtilities::ConvertEntitiesToTextTags(simple->entities),
+		};
+		copy.webpage = Data::WebPageDraft{ .removed = true };
+		copy.files.clear();
+		copy.filesWay = 0;
+		copy.invertCaption = false;
+	} else if (!AssignRichDraft(
+			session,
+			copy,
+			std::make_shared<const Iv::RichPage>(page))) {
+		if (show) {
+			show->showToast(Lower(
+				u"This rich message can't be saved as a draft yet, "
+				"wait until its media is uploaded."_q));
+		}
+		return false;
+	}
+	store.update(std::move(copy));
+	if (show) {
+		ShowDraftSavedToast(show, thread, true);
+	}
+	crl::on_main(session, [=] {
+		crl::on_main(session, [=] {
+			FinishDraftEditing(session, thread);
+		});
+	});
+	return true;
+}
+
+int ComposeDraftsBarHeight(ComposeDrafts *drafts) {
+	return drafts ? drafts->barHeight() : 0;
+}
+
+void ComposeDraftsMoveBar(ComposeDrafts *drafts, int width, int bottom) {
+	if (drafts) {
+		drafts->moveBar(width, bottom);
+	}
+}
+
+bool ComposeDraftsSaves(const ComposeDrafts *drafts) {
+	return drafts && drafts->savesDraft();
+}
+
+bool ComposeDraftsIntercept(ComposeDrafts *drafts) {
+	return drafts && drafts->intercept();
+}
+
+int ComposeDraftsWidth(ComposeDrafts *drafts) {
+	return drafts ? drafts->shownWidth() : 0;
+}
+
+int ComposeDraftsMove(ComposeDrafts *drafts, int right, int top) {
+	return drafts ? drafts->moveToRight(right, top) : 0;
+}
+
+bool ComposeDraftsAllow(ComposeDrafts *drafts, bool allowed) {
+	return drafts && drafts->setAllowed(allowed);
+}
+
+void ComposeDraftsMenu(ComposeDrafts *drafts, SendMenu::Details &details) {
+	if (drafts) {
+		drafts->fillMenuDetails(details);
+	}
+}
+
+} // namespace Tele
