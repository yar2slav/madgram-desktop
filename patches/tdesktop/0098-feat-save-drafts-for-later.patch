+constexpr auto kMinDiscardLength = 30;
+constexpr auto kSnapshotDelay = crl::time(300);
+constexpr auto kPendingDelay = crl::time(1500);
+constexpr auto kSentWindow = crl::time(2000);
+
+[[nodiscard]] std::vector<ComposeDrafts*> &Instances() {
+	static auto result = std::vector<ComposeDrafts*>();
+	return result;
+}
+
+[[nodiscard]] QString NormalizedDiscardText(const QString &text) {
+	return text.simplified();
+}
+
+[[nodiscard]] bool DiscardMeaningful(const QString &text) {
+	return text.trimmed().size() > kMinDiscardLength;
+}
+
+[[nodiscard]] bool DiscardLost(const QString &was, const QString &now) {
+	if (!DiscardMeaningful(was)) {
+		return false;
+	}
+	const auto limit = int(std::min(was.size(), now.size()));
+	auto prefix = 0;
+	while (prefix < limit && was[prefix] == now[prefix]) {
+		++prefix;
+	}
+	auto suffix = 0;
+	while (suffix < limit - prefix
+		&& was[was.size() - 1 - suffix] == now[now.size() - 1 - suffix]) {
+		++suffix;
+	}
+	return ((prefix + suffix) * 2 < was.size())
+		&& !now.contains(was.trimmed());
+}
+
+[[nodiscard]] bool LocalDraftContains(
+		not_null<Main::Session*> session,
+		DraftsThread thread,
+		const QString &normalized) {
+	const auto resolved = ResolveDraftsThread(session, thread);
+	const auto draft = resolved
+		? resolved->owningHistory()->localDraft(
+			thread.topicRootId,
+			thread.monoforumPeerId)
+		: nullptr;
+	return draft
+		&& NormalizedDiscardText(draft->textWithTags.text).contains(
+			normalized);
+}
+
+[[nodiscard]] bool IsSaveShortcut(not_null<QKeyEvent*> event) {
+	const auto modifiers = event->modifiers()
+		& ~(Qt::KeypadModifier | Qt::GroupSwitchModifier);
+#ifdef Q_OS_WIN
+	const auto key = (event->nativeVirtualKey() == 'S')
+		|| (event->key() == Qt::Key_S);
+#else
+	const auto key = (event->key() == Qt::Key_S);
+#endif
+	return key && (modifiers == Qt::ControlModifier);
+}
+
+[[nodiscard]] bool IsCancelShortcut(not_null<QKeyEvent*> event) {
+	const auto modifiers = event->modifiers()
+		& ~(Qt::KeypadModifier | Qt::GroupSwitchModifier);
+	return (event->key() == Qt::Key_Escape) && !modifiers;
+}
+
+[[nodiscard]] QString BarSubtitle(const SavedDraft *draft) {
+	if (!draft) {
+		return QString();
+	} else if (!draft->name.isEmpty()) {
+		return draft->name;
+	}
+	const auto text = draft->text.text.trimmed();
+	const auto newline = text.indexOf('\n');
+	const auto line = (newline >= 0) ? text.left(newline) : text;
+	if (!line.trimmed().isEmpty()) {
+		return line.simplified();
+	}
+	const auto count = int(draft->files.size());
+	return (count == 1)
+		? Lower(u"1 file"_q)
+		: Lower(u"%1 files"_q).arg(count);
+}
+
+[[nodiscard]] std::shared_ptr<Data::Draft> CopyLocalDraft(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	const auto resolved = ResolveDraftsThread(session, thread);
+	const auto draft = resolved
+		? resolved->owningHistory()->localDraft(
+			thread.topicRootId,
+			thread.monoforumPeerId)
+		: nullptr;
+	if (Data::DraftIsNull(draft)) {
+		return nullptr;
+	}
+	auto result = std::make_shared<Data::Draft>(*draft);
+	result->saveRequestId = 0;
+	return result;
+}
+
+[[nodiscard]] std::shared_ptr<Data::Draft> CopyRichCloudDraft(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	const auto resolved = ResolveDraftsThread(session, thread);
+	const auto draft = resolved
+		? resolved->owningHistory()->cloudDraft(
+			thread.topicRootId,
+			thread.monoforumPeerId)
+		: nullptr;
+	if (!draft || !draft->hasRichMessage()) {
+		return nullptr;
+	}
+	auto result = std::make_shared<Data::Draft>(*draft);
+	result->saveRequestId = 0;
+	return result;
+}
+
+void RestoreFieldDraft(
+		not_null<Main::Session*> session,
+		DraftsThread thread,
+		std::shared_ptr<Data::Draft> before,
+		std::shared_ptr<Data::Draft> beforeRich) {
+	const auto resolved = ResolveDraftsThread(session, thread);
+	if (!resolved) {
+		return;
+	}
+	const auto history = resolved->owningHistory();
+	if (before) {
+		auto draft = std::make_unique<Data::Draft>(*before);
+		draft->reply.topicRootId = thread.topicRootId;
+		draft->reply.monoforumPeerId = thread.monoforumPeerId;
+		history->setLocalDraft(std::move(draft));
+	} else {
+		history->clearLocalDraft(thread.topicRootId, thread.monoforumPeerId);
+	}
+	const auto cloud = history->cloudDraft(
+		thread.topicRootId,
+		thread.monoforumPeerId);
+	if (beforeRich) {
+		auto copy = Data::Draft(*beforeRich);
+		copy.saveRequestId = 0;
+		if (const auto restored = history->createCloudDraft(
+				thread.topicRootId,
+				thread.monoforumPeerId,
+				&copy)) {
+			session->api().saveDraftToCloud(resolved, *restored);
+		}
+	} else if (cloud && cloud->hasRichMessage()) {
+		history->clearCloudDraft(thread.topicRootId, thread.monoforumPeerId);
+	}
+	const auto shown = ranges::any_of(Instances(), [&](ComposeDrafts *i) {
+		return i->shows(session, thread);
+	});
+	if (shown) {
+		session->changes().entryUpdated(
+			resolved,
+			Data::EntryUpdate::Flag::LocalDraftSet);
+	} else {
+		session->local().writeDrafts(history);
+	}
+	session->api().saveDraftToCloudDelayed(resolved);
+}
+
+[[nodiscard]] std::shared_ptr<ChatHelpers::Show> ShowForHistory(
+		not_null<History*> history) {
+	const auto peer = history->peer;
+	if (const auto window = Core::App().windowFor(peer)) {
+		if (const auto controller = window->sessionController()) {
+			if (&controller->session() == &peer->session()) {
+				return controller->uiShow();
+			}
+		}
+	}
+	return nullptr;
+}
+
+void AddSendThroughActions(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<QWidget*> guard,
+		std::shared_ptr<ChatHelpers::Show> show,
+		SendMenu::Details details,
+		Fn<void(Api::SendOptions)> send) {
+	using Type = SendMenu::Type;
+	menu->addAction(
+		Lower(u"Send and remove draft"_q),
+		crl::guard(guard, [=] { send({}); }),
+		&st::menuIconSend);
+	if (details.type != Type::Disabled && details.type != Type::Reminder) {
+		menu->addAction(
+			Lower(u"Send without sound and remove draft"_q),
+			crl::guard(guard, [=] { send({ .silent = true }); }),
+			&st::menuIconMute);
+	}
+	if (details.type == Type::Scheduled
+		|| details.type == Type::ScheduledToUser
+		|| details.type == Type::Reminder) {
+		menu->addAction(
+			Lower(u"Schedule and remove draft"_q),
+			crl::guard(guard, [=] {
+				show->showBox(HistoryView::PrepareScheduleBox(
+					guard.get(),
+					show,
+					details,
+					send));
+			}),
+			&st::menuIconSchedule);
+	}
+}
