+base::unique_qptr<Ui::PopupMenu> DraftsWidget::fillMenu(
+		const ContextMenuRequest &request) {
+	auto result = base::make_unique_q<Ui::PopupMenu>(
+		_inner,
+		st::popupMenuWithIcons);
+	const auto menu = result.get();
+	const auto window = controller();
+	const auto session = &this->session();
+	const auto thread = _thread;
+	if (request.overSelection && !request.selectedItems.empty()) {
+		const auto ids = selectedDrafts();
+		menu->addAction(Lower(u"Send selected"_q), crl::guard(this, [=] {
+			sendSelected();
+		}), &st::menuIconSend);
+		menu->addAction(Lower(u"Delete selected"_q), [=] {
+			ConfirmDeleteDrafts(
+				window,
+				ids,
+				crl::guard(this, [=] { clearDraftSelection(); }));
+		}, &st::menuIconDelete);
+		menu->addAction(
+			tr::lng_context_clear_selection(tr::now),
+			crl::guard(this, [=] { _inner->cancelSelection(); }),
+			&st::menuIconSelect);
+		return result;
+	}
+	const auto item = request.item;
+	const auto id = item ? draftFor(item) : 0;
+	const auto draft = id ? Drafts(session).find(id) : nullptr;
+	if (!draft) {
+		return result;
+	}
+	const auto text = draft->text;
+	const auto list = _inner;
+	const auto itemId = item->fullId();
+	const auto select = [=] {
+		if (const auto item = session->data().message(itemId)) {
+			if (list) {
+				list->selectItemAsGroup(item);
+			}
+		}
+	};
+	if (draft->discarded) {
+		menu->addAction(Lower(u"Restore"_q), [=] {
+			RestoreDraft(window, id);
+		}, &st::menuIconRestore);
+		menu->addAction(Lower(u"Keep as draft"_q), [=] {
+			KeepDraft(session, id);
+		}, &st::menuIconArchive);
+	} else {
+		menu->addAction(Lower(u"Edit"_q), [=] {
+			EditDraft(window, id);
+		}, &st::menuIconEdit);
+		menu->addAction(Lower(u"Send now..."_q), [=] {
+			ShowSendDraftsBox(window, { id }, thread);
+		}, &st::menuIconSend);
+		menu->addAction(Lower(u"Send to another chat..."_q), [=] {
+			ShowSendDraftElsewhere(window, id);
+		}, &st::menuIconForward);
+		menu->addAction(Lower(u"Duplicate"_q), [=] {
+			Drafts(session).duplicate(id);
+		}, &st::menuIconCopy);
+		menu->addAction(Lower(u"Rename"_q), [=] {
+			ShowRenameDraftBox(window, id);
+		}, &st::menuIconManage);
+	}
+	if (!text.text.isEmpty()) {
+		menu->addAction(tr::lng_context_copy_text(tr::now), [=] {
+			TextUtilities::SetClipboardText(
+				TextForMimeData::Rich(ToEntities(text)));
+		}, &st::menuIconCopy);
+	}
+	if (!_services.contains(itemId)) {
+		menu->addAction(
+			tr::lng_context_select_msg(tr::now),
+			select,
+			&st::menuIconSelect);
+	}
+	if (draft->discarded) {
+		menu->addAction(Lower(u"Delete"_q), [=] {
+			Drafts(session).remove(id);
+		}, &st::menuIconDelete);
+	} else {
+		menu->addAction(Lower(u"Delete"_q), [=] {
+			ConfirmDeleteDrafts(window, { id });
+		}, &st::menuIconDelete);
+	}
+	return result;
+}
