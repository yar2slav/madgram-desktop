+, _rich(std::move(descriptor.rich))
+, _clearRich(std::move(descriptor.clearRich))
+, _button(base::make_unique_q<DraftsButton>(
+	descriptor.parent,
+	*descriptor.st))
+, _bar(base::make_unique_q<DraftsBar>(descriptor.parent)) {
+	_button->hide();
+	_bar->hide();
+	_bar->cancelRequests(
+	) | rpl::on_next([=] {
+		finishEditing();
+	}, _bar->lifetime());
+	Drafts(_session).editingChanges(
+	) | rpl::on_next([=] {
+		_previous = std::nullopt;
+		barStateChanged();
+	}, _bar->lifetime());
+	_button->setClickedCallback([=] {
+		if (const auto thread = currentThread()) {
+			if (const auto window = _show->resolveWindow()) {
+				ShowDraftsSection(window, thread);
+			}
+		}
+	});
+	Drafts(_session).changes(
+	) | rpl::on_next([=] {
+		refreshAndRelayout();
+		barStateChanged();
+	}, _button->lifetime());
+	_field->shownValue(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		refreshAndRelayout();
+		barStateChanged();
+	}, _button->lifetime());
+	_field->changes(
+	) | rpl::on_next([=] {
+		fieldChanged();
+	}, _button->lifetime());
+	_snapshotTimer.setCallback([=] { takeSnapshot(); });
+	_pendingTimer.setCallback([=] { checkPending(); });
+	setupShortcut();
+	Instances().push_back(this);
+}
+
+ComposeDrafts::~ComposeDrafts() {
+	Instances().erase(ranges::remove(Instances(), this), end(Instances()));
+}
