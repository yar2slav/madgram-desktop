+		},
+		.mode = ComposeControls::Mode::TeleDrafts,
+		.sendMenuDetails = [] { return SendMenu::Details(); },
+		.regularWindow = controller,
+		.customPlaceholder = rpl::single(
+			Lower(u"Write a draft, Enter saves it"_q)),
+		.features = {
+			.sendAs = false,
+			.ttlInfo = false,
+			.botCommandSend = false,
+			.silentBroadcastToggle = false,
+			.attachBotsMenu = false,
+			.inlineBots = false,
+			.megagroupSet = false,
+			.stickersSettings = false,
+			.openStickerSets = false,
+			.autocompleteCommands = false,
+			.suggestStickersByEmoji = false,
+			.commonTabbedPanel = false,
+			.recordMediaMessage = false,
+			.emojiOnlyPanel = true,
+			.richEditor = false,
+		},
+	}))
+, _resolver(std::make_shared<Controls::WebpageResolver>(
+	&history->session())) {
+	controller->chatStyle()->paletteChanged(
+	) | rpl::on_next([=] {
+		_scroll->updateBars();
+	}, _scroll->lifetime());
+
+	Window::ChatThemeValueFromPeer(
+		controller,
+		history->peer
+	) | rpl::on_next([=](std::shared_ptr<Ui::ChatTheme> &&theme) {
+		_theme = std::move(theme);
+		controller->setChatStyleTheme(_theme);
+	}, lifetime());
+
+	setupTopBar();
+
+	_scroll->setHandleTouch(false);
+	_inner = _scroll->setOwnedWidget(object_ptr<ListWidget>(
+		this,
+		&controller->session(),
+		static_cast<ListDelegate*>(this)));
+	_inner->lower();
+	_scroll->move(0, _topBar->height());
+	_scroll->show();
+	_scroll->setOverscrollBg(QColor(0, 0, 0, 0));
+	_scroll->setOverscrollEdges([=] {
+		return _inner->loadedAtTopKnown() && _inner->loadedAtTop();
+	}, [=] {
+		return _inner->loadedAtBottomKnown() && _inner->loadedAtBottom();
+	});
+	_scroll->scrolls(
+	) | rpl::on_next([=] {
+		onScroll();
+	}, lifetime());
+
+	setupComposeControls();
+
+	Drafts(&controller->session()).changes(
+	) | rpl::on_next([=] {
+		scheduleRebuild();
+	}, lifetime());
+	_resolver->resolved(
+	) | rpl::on_next([=] {
+		scheduleRebuild();
+	}, lifetime());
+
+	build();
+
+	Window::SetupSwipeBackSection(this, _scroll.get(), _inner);
+}
