+#include "tele/tele_drafts_rich.h"
+
+#include "data/data_document.h"
+#include "data/data_photo.h"
+#include "data/data_session.h"
+#include "data/stickers/data_stickers.h"
+#include "data/stickers/data_stickers_set.h"
