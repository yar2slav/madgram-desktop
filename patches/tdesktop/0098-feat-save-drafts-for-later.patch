+
+void DraftsStore::changed() {
+	write();
+	collectGarbage();
+	_changes.fire({});
+}
+
+void DraftsStore::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"index"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (!CheckStreamStatus(file.stream)
+		|| magic != kMagic
+		|| version < 1
+		|| version > kVersion) {
+		return;
+	} else if (owner != _session->uniqueId()) {
+		wipe();
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto draft = Deserialize(file.stream, version);
+		if (!draft) {
+			break;
+		} else if (draft->id && draft->thread && !find(draft->id)) {
+			if (!draft->richData.isEmpty()) {
+				draft->rich = ParseRichDraft(_session, draft->richData);
+			}
+			_list.push_back(std::move(*draft));
+		}
+	}
+	ranges::stable_sort(_list, ranges::greater(), &SavedDraft::edited);
+	if (prune() || version != kVersion) {
+		write();
+	}
+	collectGarbage();
+}
+
+void DraftsStore::write() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &draft : _list) {
+		size += 256 + draft.text.text.size() * sizeof(QChar);
+		for (const auto &file : draft.files) {
+			size += 64 + file.thumbnail.size();
+		}
+		size += 4 + draft.richData.size();
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_list.size());
+	for (const auto &draft : _list) {
+		Serialize(data.stream, draft);
+	}
+	auto file = FileWriteDescriptor(u"index"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+void DraftsStore::wipe() {
+	QDir(folder()).removeRecursively();
+}
+
+void DraftsStore::collectGarbage() {
+	auto used = _importing;
+	for (const auto &draft : _list) {
+		for (const auto &file : draft.files) {
+			used.emplace(file.stored);
+		}
+	}
+	const auto path = folder();
+	for (const auto &name : QDir(path).entryList(QDir::Files)) {
+		if (IsStoredName(name) && !used.contains(name)) {
+			QFile::remove(path + name);
+		}
+	}
+	for (auto i = begin(_viewPaths); i != end(_viewPaths);) {
+		if (used.contains(i->first)) {
+			++i;
+			continue;
+		}
+		QDir(QFileInfo(i->second).absolutePath()).removeRecursively();
+		_viewPreviews.remove(i->first);
+		i = _viewPaths.erase(i);
+	}
+}
+
+DraftsStore &Drafts(not_null<Main::Session*> session) {
+	auto &stores = Stores();
+	const auto i = stores.find(session);
+	if (i != end(stores)) {
+		return *i->second;
+	}
+	session->lifetime().add([=] {
+		Stores().erase(session);
+	});
+	return *stores.emplace(
+		session,
+		std::make_unique<DraftsStore>(session)).first->second;
+}
+
+Data::Thread *ResolveDraftsThread(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	const auto peer = thread ? session->data().peerLoaded(thread.peer) : nullptr;
+	if (!peer) {
+		return nullptr;
+	}
+	const auto history = session->data().history(peer);
+	return history->threadFor(thread.topicRootId, thread.monoforumPeerId);
+}
+
+QString DraftsThreadName(
+		not_null<Main::Session*> session,
+		DraftsThread thread) {
+	const auto peer = session->data().peerLoaded(thread.peer);
+	if (!peer) {
+		return Lower(u"Unknown chat"_q);
+	}
+	auto result = peer->name();
+	const auto separator = u" \u203A "_q;
+	if (thread.topicRootId) {
+		const auto resolved = ResolveDraftsThread(session, thread);
+		result += separator + (resolved
+			? resolved->chatListName()
+			: Lower(u"Topic"_q));
+	} else if (thread.monoforumPeerId) {
+		const auto sublist = session->data().peerLoaded(
+			thread.monoforumPeerId);
+		result += separator + (sublist
+			? sublist->name()
+			: Lower(u"Unknown chat"_q));
+	}
+	return result;
+}
+
+bool AssignRichDraft(
+		not_null<Main::Session*> session,
+		SavedDraft &draft,
+		std::shared_ptr<const Iv::RichPage> page) {
+	if (!page) {
+		draft.rich = nullptr;
+		draft.richData = QByteArray();
+		return true;
+	}
+	auto data = SerializeRichDraft(session, *page);
+	if (data.isEmpty()) {
+		return false;
+	}
+	const auto summary = Iv::FlattenRichPageSummary(*page, false);
+	draft.text = TextWithTags{ summary.text, {} };
+	draft.files.clear();
+	draft.webpage = Data::WebPageDraft();
+	draft.rich = std::move(page);
+	draft.richData = std::move(data);
+	return true;
+}
+
+FullReplyTo NormalizeDraftReply(FullReplyTo reply, DraftsThread thread) {
+	if (reply.messageId.msg == thread.topicRootId
+		&& reply.quote.empty()) {
+		reply.messageId = FullMsgId();
+	}
+	reply.topicRootId = thread.topicRootId;
+	reply.monoforumPeerId = thread.monoforumPeerId;
+	return reply;
+}
