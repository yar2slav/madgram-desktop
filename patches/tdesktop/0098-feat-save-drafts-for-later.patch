+
+QString DraftsStore::generateStoredName() const {
+	const auto path = folder();
+	while (true) {
+		const auto result = RandomHex();
+		if (!_importing.contains(result) && !QFile::exists(path + result)) {
+			return result;
+		}
+	}
+}
