+bool SendDraftFiles(
+		not_null<Main::Session*> session,
+		const SavedDraft &draft,
+		const QStringList &paths,
+		Api::SendAction action) {
+	auto list = Storage::PrepareMediaList(
+		paths,
+		st::sendMediaPreviewSize,
+		session->premium());
+	if (list.error != Ui::PreparedList::Error::None
+		|| list.files.size() != draft.files.size()) {
+		return false;
+	}
+	const auto way = Ui::SendFilesWay::FromSerialized(
+		draft.filesWay
+	).value_or(Ui::SendFilesWay());
+	for (auto i = 0; i != int(list.files.size()); ++i) {
+		list.files[i].spoiler = draft.files[i].spoiler;
+		list.files[i].sendLargePhotos = way.sendLargePhotos();
+	}
+	auto caption = draft.text;
+	const auto limit = Data::PremiumLimits(session).captionLengthCurrent();
+	if (caption.text.size() > limit) {
+		auto message = Api::MessageToSend(action);
+		message.textWithTags = base::take(caption);
+		message.webPage = draft.webpage;
+		session->api().sendMessage(std::move(message));
+	}
+	auto bundle = Ui::PrepareFilesBundle(
+		Ui::DivideByGroups(std::move(list), way, false),
+		way,
+		false);
+	if (!bundle->groups.empty()) {
+		auto &group = bundle->groups.back();
+		auto &files = group.list.files;
+		if (!files.empty()) {
+			auto &captioned = (group.type == Ui::AlbumType::PhotoVideo)
+				? files.front()
+				: files.back();
+			if (!captioned.isSticker() || way.sendImagesAsPhotos()) {
+				captioned.caption = std::move(caption);
+			}
+		}
+	}
+	action.options.invertCaption = draft.invertCaption;
+	const auto type = way.sendImagesAsPhotos()
+		? SendMediaType::Photo
+		: SendMediaType::File;
+	for (auto &group : bundle->groups) {
+		const auto album = (group.type != Ui::AlbumType::None)
+			? std::make_shared<SendingAlbum>()
+			: nullptr;
+		session->api().sendFiles(std::move(group.list), type, album, action);
+	}
+	return true;
+}
+
+bool SendDraft(
+		not_null<Window::SessionController*> controller,
+		uint64 id,
+		DraftsThread target,
+		Api::SendOptions options,
+		Fn<void()> sent) {
+	const auto session = &controller->session();
+	const auto draft = Drafts(session).find(id);
+	const auto thread = ResolveDraftsThread(session, target);
+	if (!draft || !thread) {
+		controller->showToast(Lower(u"This chat is unavailable."_q));
+		return false;
+	}
+	const auto peer = thread->peer();
+	const auto files = !draft->files.empty();
+	if (peer->starsPerMessageChecked() > 0) {
+		controller->showToast(Lower(
+			u"This chat charges for messages, send the draft from the "
+			"chat itself."_q));
+		return false;
+	} else if (files
+		? !Data::CanSendAnyOf(thread, Data::FilesSendRestrictions())
+		: !Data::CanSendTexts(thread)) {
+		controller->showToast(Lower(
+			u"You can't send this to the chat."_q));
+		return false;
+	} else if (Drafts(session).broken(*draft)) {
+		controller->showToast(Lower(draft->files.empty()
+			? u"This rich message draft can't be read."_q
+			: u"Some files of this draft are missing."_q));
+		return false;
+	}
+	if (session->sendAsPeers().chosen(peer)) {
+		options.sendAs = session->sendAsPeers().resolveChosen(peer);
+	}
+	auto action = Api::SendAction(thread, options);
+	action.clearDraft = false;
+	action.replyTo.monoforumPeerId = thread->monoforumPeerId();
+	if (draft->thread == target && draft->reply.replying()) {
+		action.replyTo.messageId = draft->reply.messageId;
+		action.replyTo.quote = draft->reply.quote;
+		action.replyTo.quoteOffset = draft->reply.quoteOffset;
+		action.replyTo.storyId = draft->reply.storyId;
+		action.replyTo.todoItemId = draft->reply.todoItemId;
+		action.replyTo.pollOption = draft->reply.pollOption;
+	}
+	if (const auto page = draft->rich) {
+		if (!session->premium() && Iv::RichPageUsesPremiumFormatting(*page)) {
+			Iv::Editor::ShowRichMessagesPremiumToast(controller->uiShow());
+			return false;
+		}
+		const auto serialized = Iv::SerializeInputRichMessage(
+			session,
+			*page,
+			Iv::SerializeInputRichMessageMode::FinalSubmit);
+		using Status = Iv::SerializeInputRichMessageStatus;
+		if (serialized.status != Status::Success || !serialized.value) {
+			controller->showToast((serialized.status == Status::EmptyContent)
+				? tr::lng_article_submit_empty(tr::now)
+				: tr::lng_attach_failed(tr::now));
+			return false;
+		}
+		session->api().sendRichMessage(page, *serialized.value, action);
+		sent();
+		return true;
+	} else if (!files) {
+		auto message = Api::MessageToSend(action);
+		message.textWithTags = draft->text;
+		message.webPage = draft->webpage;
+		session->api().sendMessage(std::move(message));
+		sent();
+		return true;
+	}
+	const auto copy = *draft;
+	Drafts(session).exportFiles(copy.files, crl::guard(controller, [=](
+			QStringList paths) {
+		if (paths.size() != int(copy.files.size())) {
+			controller->showToast(Lower(
+				u"Couldn't read the files of this draft."_q));
+			return;
+		}
+		if (!SendDraftFiles(session, copy, paths, action)) {
+			controller->showToast(Lower(
+				u"Couldn't prepare the files of this draft."_q));
+			return;
+		}
+		sent();
+	}));
+	return true;
+}
