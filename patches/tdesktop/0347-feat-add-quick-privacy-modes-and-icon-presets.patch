+#include "tele/tele_streamer_mode.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/popup_menu.h"
+#include "ui/widgets/shadow.h"
+#include "ui/wrap/slide_wrap.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_window.h"
+#include "styles/style_window_main_menu.h"
+#include <QtGui/QCursor>
+
+namespace Tele {
+namespace {
+
+rpl::producer<bool> OptionValue(const char *id) {
+	auto &option = base::options::lookup<bool>(id);
+	return rpl::single(rpl::empty)
+		| rpl::then(option.changes())
+		| rpl::map([&option] { return option.value(); });
+}
+
+}
+
+void ApplyQuickModesAtStartup() {
+	if (GhostAtStartup()) {
+		SetGhost(true);
+	}
+	if (StreamerAtStartup()) {
+		SetStreamerMode(true);
+	}
+}
+
+void AddQuickModeButton(
+		not_null<Ui::VerticalLayout*> menu,
+		const char *modeId,
+		const char *visibilityId,
+		const QString &title,
+		const style::icon &icon) {
+	const auto wrap = menu->add(object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+		menu, object_ptr<Ui::VerticalLayout>(menu)));
+	const auto button = Settings::AddButtonWithIcon(wrap->entity(),
+		rpl::single(title), st::mainMenuButton, { &icon });
+	auto &mode = base::options::lookup<bool>(modeId);
+	button->toggleOn(OptionValue(modeId));
+	button->toggledChanges(
+	) | rpl::filter([&mode](bool enabled) {
+		return enabled != mode.value();
+	}) | rpl::on_next([&mode](bool enabled) {
+		mode.set(enabled);
+	}, button->lifetime());
+	base::install_event_filter(button, [=](not_null<QEvent*> event) {
+		if (event->type() != QEvent::ContextMenu) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto popup = Ui::CreateChild<Ui::PopupMenu>(button);
+		popup->addAction(Tr(u"Hide from side menu"_q), [=] {
+			base::options::lookup<bool>(visibilityId).set(false);
+		});
+		popup->popup(QCursor::pos());
+		return base::EventFilterResult::Cancel;
+	});
+	wrap->toggleOn(OptionValue(visibilityId));
+	wrap->finishAnimating();
+}
+
+void AddQuickModesMenu(not_null<Ui::VerticalLayout*> menu) {
+	const auto wrap = menu->add(object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+		menu, object_ptr<Ui::VerticalLayout>(menu)));
+	const auto content = wrap->entity();
+	content->add(object_ptr<Ui::PlainShadow>(content),
+		{ 0, st::mainMenuSkip, 0, st::mainMenuSkip });
+	AddGhostMenuToggle(content);
+	AddStreamerMenuToggle(content);
+	wrap->toggleOn(rpl::combine(
+		OptionValue(kOptionGhostInMenu),
+		OptionValue(kOptionStreamerModeInMenu)
+	) | rpl::map([](bool ghost, bool streamer) { return ghost || streamer; }));
+	wrap->finishAnimating();
+}
+
+void FillQuickModesTray(Platform::Tray &tray) {
+	if (Core::App().passcodeLocked()) {
+		return;
+	}
+	const auto add = [&](const char *id, QString enable, QString disable) {
+		tray.addAction(rpl::combine(
+			OptionValue(id),
+			rpl::single(rpl::empty) | rpl::then(Lang::GetInstance().updated())
+		) | rpl::map([=](bool active, auto) {
+			return Tr(active ? disable : enable);
+		}), [=] {
+			auto &option = base::options::lookup<bool>(id);
+			option.set(!option.value());
+		});
+	};
+	add(kOptionGhost,
+		u"Enable ghost mode"_q, u"Disable ghost mode"_q);
+	add(kOptionStreamerMode,
+		u"Enable streamer mode"_q, u"Disable streamer mode"_q);
+}
+
+}
