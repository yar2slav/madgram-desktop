---
 Telegram/SourceFiles/data/data_histories.cpp |  1 +
 Telegram/SourceFiles/tele/tele_deleted.cpp   | 16 ++++++++++++----
 Telegram/SourceFiles/tele/tele_deleted.h     |  1 +
 Telegram/SourceFiles/tele/tele_options.cpp   |  2 +-
 4 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/Telegram/SourceFiles/data/data_histories.cpp b/Telegram/SourceFiles/data/data_histories.cpp
index dbab84a581125bf309d44fede97af0e79c1f2140..c3c284d68d7ddd6ff43ba3d13ab7071a217f107a 100644
--- a/Telegram/SourceFiles/data/data_histories.cpp
+++ b/Telegram/SourceFiles/data/data_histories.cpp
@@ -1055,6 +1055,7 @@ void Histories::deleteMessages(const MessageIdsList &ids, bool revoke) {
 		document->owner().savedMusic().remove(document);
 	}
 
+	Tele::KeepOwnDeleted(remove);
 	if (!remove.empty()) {
 		_owner->notifyItemsAboutToBeDestroyed(remove);
 	}
diff --git a/Telegram/SourceFiles/tele/tele_deleted.cpp b/Telegram/SourceFiles/tele/tele_deleted.cpp
index cbc9e673a7289f74489c13b1c580733ea414c41b..38ea269a14a9899c4a5fcceb0c51991bc9a33f87 100644
--- a/Telegram/SourceFiles/tele/tele_deleted.cpp
+++ b/Telegram/SourceFiles/tele/tele_deleted.cpp
@@ -150,15 +150,13 @@ void Forget(
 	return st::msgDateFont->height;
 }
 
-} // namespace
-
-void KeepDeleted(std::vector<not_null<HistoryItem*>> &items) {
+void Keep(std::vector<not_null<HistoryItem*>> &items, bool own) {
 	if (!KeepDeletedMessages()) {
 		return;
 	}
 	auto kept = std::vector<not_null<HistoryItem*>>();
 	items.erase(ranges::remove_if(items, [&](not_null<HistoryItem*> item) {
-		if (!Keepable(item)) {
+		if (!Keepable(item) || (own && IsKeptDeleted(item))) {
 			return false;
 		}
 		const auto history = item->history();
@@ -179,6 +177,16 @@ void KeepDeleted(std::vector<not_null<HistoryItem*>> &items) {
 	}
 }
 
+} // namespace
+
+void KeepDeleted(std::vector<not_null<HistoryItem*>> &items) {
+	Keep(items, false);
+}
+
+void KeepOwnDeleted(std::vector<not_null<HistoryItem*>> &items) {
+	Keep(items, true);
+}
+
 bool IsKeptDeleted(not_null<const HistoryItem*> item) {
 	if (Get().sessions.empty()) {
 		return false;
diff --git a/Telegram/SourceFiles/tele/tele_deleted.h b/Telegram/SourceFiles/tele/tele_deleted.h
index 20baf8a0dc9712f6f972ba8a6f0e9f5b9348877f..07b6c00ea326f3340f73bd9e1e5a521d31e630f8 100644
--- a/Telegram/SourceFiles/tele/tele_deleted.h
+++ b/Telegram/SourceFiles/tele/tele_deleted.h
@@ -14,6 +14,7 @@ struct ChatPaintContext;
 namespace Tele {
 
 void KeepDeleted(std::vector<not_null<HistoryItem*>> &items);
+void KeepOwnDeleted(std::vector<not_null<HistoryItem*>> &items);
 [[nodiscard]] bool IsKeptDeleted(not_null<const HistoryItem*> item);
 [[nodiscard]] bool DeletedIconShown(not_null<const HistoryItem*> item);
 [[nodiscard]] int DeletedIconWidth();
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 63cd6fb62fb8c50581be8c7182cc296553210917..9ad55566f969546b75087c550d7dd2aba0f6b8c3 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -307,7 +307,7 @@ base::options::toggle EditHistoryOption({
 base::options::toggle KeepDeletedOption({
 	.id = kOptionKeepDeleted,
 	.name = "Keep deleted messages",
-	.description = "Kept until tele restarts, marked as deleted.",
+	.description = "Kept until tele restarts, including ones you delete yourself.",
 });
 
 base::options::toggle DeletedIconOption({
