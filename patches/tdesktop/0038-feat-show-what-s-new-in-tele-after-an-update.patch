+
+base::options::option<int> ChangelogShownOption({
+	.id = kOptionChangelogShown,
+	.name = "Last shown changelog",
+	.description = "The tele build whose changes were shown last.",
+});
+
 base::options::toggle GroupQuickRepliesOption({
 	.id = kOptionGroupQuickReplies,
 	.name = "Quick replies in groups and channels",
@@ -442,6 +459,18 @@ rpl::producer<bool> AutoUpdateValue() {
 	});
 }
 
+bool ShowChangelog() {
+	return ShowChangelogOption.value();
+}
+
+int ChangelogShown() {
+	return ChangelogShownOption.value();
+}
+
