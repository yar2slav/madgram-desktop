new file mode 100644
index 0000000000000000000000000000000000000000..f5ff4a56afd34ad1cc4e7d56ae3f44155fabd618
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_changelog.cpp
@@ -0,0 +1,226 @@
+#include "tele/tele_changelog.h"
+
+#include "core/application.h"
+#include "core/version.h"
+#include "data/data_session.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "tele/tele_build.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/text/text.h"
+#include "ui/text/text_utilities.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QPointer>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele {
+namespace {
+
+constexpr auto kTransferTimeout = 60 * 1000;
+constexpr auto kMaxSize = qint64(256 * 1024);
+constexpr auto kMaxItems = 100;
+constexpr auto kMaxTitleLength = 64;
+constexpr auto kMaxItemLength = 1024;
+constexpr auto kReleasesPrefix = "https://github.com/nitreojs/tele/releases/";
+
+class Changelog final : public QObject {
+public:
+	Changelog();
+
+private:
+	[[nodiscard]] std::vector<not_null<Main::Session*>> sessions() const;
+	void fetch();
+	void fetched(const QByteArray &data);
+	void show(const TextWithEntities &text);
+	void fail(const QString &error);
+
+	QNetworkAccessManager _manager;
+	rpl::lifetime _lifetime;
+
+};
+
+QPointer<Changelog> Instance;
+
+[[nodiscard]] QString Tag() {
+	return u"v%1-tele.%2"_q.arg(
+		QString::fromLatin1(AppVersionStr),
+		QString::number(BuildNumber()));
+}
+
+[[nodiscard]] QString Url() {
+	return QString::fromLatin1(kReleasesPrefix)
+		+ u"download/"_q
+		+ Tag()
+		+ u"/tele-changelog.json"_q;
+}
+
+[[nodiscard]] std::optional<TextWithEntities> Parse(const QByteArray &data) {
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(data, &error);
+	if (error.error != QJsonParseError::NoError || !document.isObject()) {
+		return std::nullopt;
+	}
+	const auto object = document.object();
+	const auto items = object.value(u"items"_q);
+	if (object.value(u"tag"_q).toString() != Tag() || !items.isArray()) {
+		return std::nullopt;
+	}
+	auto title = object.value(u"title"_q).toString().trimmed();
+	if (title.isEmpty() || title.size() > kMaxTitleLength) {
+		title = u"tele %1"_q.arg(BuildNumber());
+	}
+	auto url = object.value(u"url"_q).toString();
+	if (!url.startsWith(QString::fromLatin1(kReleasesPrefix))) {
+		url = QString::fromLatin1(kReleasesPrefix) + u"tag/"_q + Tag();
+	}
+	auto result = Ui::Text::Bold(Lower(title + u" is here"_q));
+	result.append(u"\n\n"_q);
+	auto count = 0;
+	for (const auto &value : items.toArray()) {
+		const auto item = value.toObject();
+		const auto text = item.value(u"text"_q).toString().trimmed();
+		if (text.isEmpty()) {
+			continue;
+		} else if (++count > kMaxItems) {
+			break;
+		}
+		const auto where = item.value(u"where"_q).toString().trimmed();
+		result.append(Ui::kQBullet + ' ' + Lower(text.left(kMaxItemLength)));
+		if (!where.isEmpty()) {
+			result.append(' ').append(Ui::Text::Italic(
+				'(' + Lower(where.left(kMaxItemLength)) + ')'));
+		}
+		result.append('\n');
+	}
+	if (count) {
+		result.append('\n');
+	}
+	result.append(Ui::Text::Link(Lower(u"Full changelog"_q), url));
+	return result;
+}
+
+Changelog::Changelog()
+: QObject(QCoreApplication::instance()) {
+	const auto domain = &Core::App().domain();
+	domain->activeValue(
+	) | rpl::to_empty | rpl::filter([=] {
+		return domain->started();
+	}) | rpl::take(1) | rpl::on_next([=] {
+		if (sessions().empty()) {
+			SetChangelogShown(BuildNumber());
+			deleteLater();
+		} else {
+			fetch();
+		}
+	}, _lifetime);
+}
+
+std::vector<not_null<Main::Session*>> Changelog::sessions() const {
+	auto result = std::vector<not_null<Main::Session*>>();
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			result.push_back(session);
+		}
+	}
+	return result;
+}
+
+void Changelog::fetch() {
+	auto request = QNetworkRequest(QUrl(Url()));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTransferTimeout));
+	const auto reply = _manager.get(request);
+	const auto tooLarge = std::make_shared<bool>(false);
+	connect(reply, &QNetworkReply::downloadProgress, this, [=](
+			qint64 ready,
+			qint64 total) {
+		if (ready > kMaxSize || total > kMaxSize) {
+			*tooLarge = true;
+			reply->abort();
+		}
+	});
+	connect(reply, &QNetworkReply::finished, this, [=] {
+		reply->deleteLater();
+		const auto code = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (*tooLarge) {
+			fail(u"response is too large"_q);
+		} else if (reply->error() != QNetworkReply::NoError) {
+			fail(u"network error: %1"_q.arg(reply->errorString()));
+		} else if (code != 200) {
+			fail(u"unexpected http status %1"_q.arg(code));
+		} else {
+			fetched(reply->readAll());
+		}
+	});
+}
+
+void Changelog::fetched(const QByteArray &data) {
+	const auto text = Parse(data);
+	if (!text) {
+		fail(u"malformed changelog"_q);
+		return;
+	}
+	show(*text);
+}
+
+void Changelog::show(const TextWithEntities &text) {
+	const auto build = BuildNumber();
+	const auto sessions = this->sessions();
+	if (sessions.empty()) {
+		SetChangelogShown(build);
+	}
+	const auto left = std::make_shared<int>(int(sessions.size()));
+	for (const auto &session : sessions) {
+		const auto data = &session->data();
+		const auto add = [=] {
+			data->serviceNotification(text);
+			if (!--*left) {
+				SetChangelogShown(build);
+			}
+		};
+		if (data->chatsListLoaded()) {
+			add();
+		} else {
+			data->chatsListLoadedEvents(
+			) | rpl::filter([](Data::Folder *folder) {
+				return !folder;
+			}) | rpl::take(1) | rpl::on_next(add, session->lifetime());
+		}
+	}
+	deleteLater();
+}
+
+void Changelog::fail(const QString &error) {
+	LOG(("Tele Changelog Error: %1").arg(error));
+	deleteLater();
+}
+
+} // namespace
+
+void StartChangelog() {
+	const auto build = BuildNumber();
+	if (build <= 0 || Instance) {
+		return;
+	}
+	const auto shown = ChangelogShown();
+	if (shown >= build) {
+		return;
+	} else if (!ShowChangelog()) {
+		SetChangelogShown(build);
+		return;
+	}
+	Instance = new Changelog();
+}
+
+} // namespace Tele
