+++ b/Telegram/SourceFiles/tele/tele_gifts.h
@@ -5,6 +5,7 @@ class Show;
 } // namespace ChatHelpers
 
 namespace Data {
+struct CreditsHistoryEntry;
 struct UniqueGift;
 } // namespace Data
 
@@ -18,7 +19,7 @@ namespace Tele {
 void AddGiftIdRow(
 	std::shared_ptr<ChatHelpers::Show> show,
 	not_null<Ui::TableLayout*> table,
-	const Data::UniqueGift *gift);
+	const Data::CreditsHistoryEntry &entry);
 
 void AddSeeTgButton(
 	std::shared_ptr<ChatHelpers::Show> show,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index fe1954902b58dd84aee3abdad5291ac11edef92c..92fa3c62388ca5760ea7393ae12029d8cfebb841 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -36,6 +36,7 @@ const char kOptionJumpToFirst[] = "tele-jump-to-first";
 const char kOptionStaticUserpicsList[] = "tele-static-userpics-list";
 const char kOptionStaticUserpicsChats[] = "tele-static-userpics-chats";
 const char kOptionShowGiftIds[] = "tele-show-gift-ids";
+const char kOptionShowRegularGiftIds[] = "tele-show-regular-gift-ids";
 const char kOptionSeeTgButton[] = "tele-seetg-button";
 const char kOptionPeerIdsWithoutSpaces[] = "tele-peer-ids-without-spaces";
 const char kOptionBotApiPeerIds[] = "tele-bot-api-peer-ids";
@@ -269,6 +270,12 @@ base::options::toggle ShowGiftIdsOption({
 	.description = "In collectible gift cards, click to copy.",
 });
 
+base::options::toggle ShowRegularGiftIdsOption({
+	.id = kOptionShowRegularGiftIds,
+	.name = "IDs on regular gifts",
+	.description = "The gift type ID on non-collectible gifts, click to copy.",
+});
+
 base::options::toggle SeeTgButtonOption({
 	.id = kOptionSeeTgButton,
 	.name = "See.tg button on collectible gifts",
@@ -651,6 +658,10 @@ bool ShowGiftIds() {
 	return ShowGiftIdsOption.value();
 }
 
+bool ShowRegularGiftIds() {
+	return ShowRegularGiftIdsOption.value();
+}
+
 bool SeeTgButton() {
 	return SeeTgButtonOption.value();
 }
