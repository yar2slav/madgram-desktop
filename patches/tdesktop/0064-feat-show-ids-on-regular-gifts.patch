From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 22:22:20 +0300
Subject: [PATCH] feat: show ids on regular gifts

---
 .../SourceFiles/boxes/gift_premium_box.cpp    |  2 +-
 .../SourceFiles/settings/settings_tele.cpp    |  1 +
 Telegram/SourceFiles/tele/tele_gifts.cpp      | 27 ++++++++++++++-----
 Telegram/SourceFiles/tele/tele_gifts.h        |  3 ++-
 Telegram/SourceFiles/tele/tele_options.cpp    | 11 ++++++++
 Telegram/SourceFiles/tele/tele_options.h      |  2 ++
 6 files changed, 38 insertions(+), 8 deletions(-)

diff --git a/Telegram/SourceFiles/boxes/gift_premium_box.cpp b/Telegram/SourceFiles/boxes/gift_premium_box.cpp
index db08ae30662372c6ce8b9b6399802e2b4ba65411..5696e76b64a0180abc9d9f958e1f6d602e893416 100644
--- a/Telegram/SourceFiles/boxes/gift_premium_box.cpp
+++ b/Telegram/SourceFiles/boxes/gift_premium_box.cpp
@@ -1512,7 +1512,7 @@ void AddStarGiftTable(
 		&& (entry.in || entry.bareGiftOwnerId == selfBareId);
 	const auto giftToChannel = entry.giftChannelSavedId
 		&& peerIsChannel(PeerId(entry.bareEntryOwnerId));
-	Tele::AddGiftIdRow(show, table, unique);
+	Tele::AddGiftIdRow(show, table, entry);
 
 	const auto tooltip = std::make_shared<TableRowTooltipData>(
 		TableRowTooltipData{ .parent = container });
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 1ad81f81d5e34588a87207326d0547c3f6a16195..b1fa391b6fbe352ee58d497a5fc78c509e06f064 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1137,6 +1137,7 @@ void FillProfiles(SectionBuilder &builder) {
 	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Gifts"_q);
 	AddOptionToggle(builder, ::Tele::kOptionShowGiftIds);
+	AddOptionToggle(builder, ::Tele::kOptionShowRegularGiftIds);
 	AddOptionToggle(builder, ::Tele::kOptionSeeTgButton);
 	builder.addSkip();
 }
diff --git a/Telegram/SourceFiles/tele/tele_gifts.cpp b/Telegram/SourceFiles/tele/tele_gifts.cpp
index a7879ec3e8c3b6a8bb39ab82c9d00cda551b09a3..5bb1651da3a209d6081780cfa67c6f619a30c493 100644
--- a/Telegram/SourceFiles/tele/tele_gifts.cpp
+++ b/Telegram/SourceFiles/tele/tele_gifts.cpp
@@ -3,6 +3,7 @@
 #include "base/qthelp_url.h"
 #include "chat_helpers/compose/compose_show.h"
 #include "core/click_handler_types.h"
+#include "data/data_credits.h"
 #include "data/data_star_gift.h"
 #include "lang/lang_text_entity.h"
 #include "tele/tele_lowercase.h"
@@ -23,14 +24,13 @@
 
 namespace Tele {
 
-void AddGiftIdRow(
+namespace {
+
+void AddIdRow(
 		std::shared_ptr<ChatHelpers::Show> show,
 		not_null<Ui::TableLayout*> table,
-		const Data::UniqueGift *gift) {
-	if (!gift || !gift->id || !ShowGiftIds()) {
-		return;
-	}
-	const auto id = QString::number(gift->id);
+		uint64 value) {
+	const auto id = QString::number(value);
 	auto label = object_ptr<Ui::FlatLabel>(
 		table,
 		rpl::single(Ui::Text::Wrapped({ id }, EntityType::Code)),
@@ -47,6 +47,21 @@ void AddGiftIdRow(
 	Ui::AddTableRow(table, rpl::single(Lower(u"Gift ID"_q)), std::move(label));
 }
 
+} // namespace
+
+void AddGiftIdRow(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<Ui::TableLayout*> table,
+		const Data::CreditsHistoryEntry &entry) {
+	if (const auto unique = entry.uniqueGift.get()) {
+		if (unique->id && ShowGiftIds()) {
+			AddIdRow(show, table, unique->id);
+		}
+	} else if (entry.stargiftId && ShowRegularGiftIds()) {
+		AddIdRow(show, table, entry.stargiftId);
+	}
+}
+
 void AddSeeTgButton(
 		std::shared_ptr<ChatHelpers::Show> show,
 		not_null<Ui::GenericBox*> box,
diff --git a/Telegram/SourceFiles/tele/tele_gifts.h b/Telegram/SourceFiles/tele/tele_gifts.h
