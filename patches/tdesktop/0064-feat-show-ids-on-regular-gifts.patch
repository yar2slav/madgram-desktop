 extern const char kOptionBotApiPeerIds[];
@@ -103,6 +104,7 @@ void SetGroupCallButton(const QString &value);
 [[nodiscard]] bool StaticUserpicsChats();
 [[nodiscard]] rpl::producer<> StaticUserpicsChatsChanges();
 [[nodiscard]] bool ShowGiftIds();
