+#include "ui/image/image_location.h"
+#include "ui/text/format_values.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtCore/QLocale>
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+
+namespace Tele {
+namespace {
+
+constexpr auto kShownLength = 48;
+
+struct Line {
+	QString label;
+	QString value;
+};
+
+[[nodiscard]] QString ExactDate(TimeId date) {
+	const auto parsed = base::unixtime::parse(date);
+	return QLocale().toString(parsed.date(), QLocale::ShortFormat)
+		+ u" "_q
+		+ parsed.time().toString(u"HH:mm:ss"_q);
+}
+
+[[nodiscard]] QString Resolution(int width, int height) {
+	return QString::number(width)
+		+ QChar(0x00D7)
+		+ QString::number(height);
+}
+
+[[nodiscard]] int PhotoDc(not_null<PhotoData*> photo) {
+	for (const auto size : {
+		Data::PhotoSize::Large,
+		Data::PhotoSize::Thumbnail,
+		Data::PhotoSize::Small,
+	}) {
+		const auto &data = photo->location(size).file().data;
+		if (const auto file = std::get_if<StorageFileLocation>(&data)) {
+			if (const auto dc = file->dcId()) {
+				return dc;
+			}
+		}
+	}
+	return 0;
+}
+
+void AddDocumentLines(
+		std::vector<Line> &lines,
+		not_null<DocumentData*> document) {
+	if (const auto name = document->filename(); !name.isEmpty()) {
+		lines.push_back({ Tr(u"File name"_q), name });
+	}
+	const auto size = document->size;
+	if (size > 0) {
+		lines.push_back({ Tr(u"Size"_q), Ui::FormatSizeText(size) });
+	}
+	const auto dimensions = document->dimensions;
+	if (dimensions.width() > 0 && dimensions.height() > 0) {
+		lines.push_back({
+			Tr(u"Resolution"_q),
+			Resolution(dimensions.width(), dimensions.height()),
+		});
+	}
+	const auto seconds = document->duration() / 1000;
+	if (seconds > 0) {
+		lines.push_back({
+			Tr(u"Duration"_q),
+			Ui::FormatDurationText(seconds),
+		});
+		if (size > 0) {
+			lines.push_back({
+				Tr(u"Bitrate"_q),
+				Tr(u"%1 kbps"_q).arg(size * 8 / seconds / 1000),
+			});
+		}
+	}
+	if (const auto mime = document->mimeString(); !mime.isEmpty()) {
+		lines.push_back({ Tr(u"Type"_q), mime });
+	}
+	if (const auto dc = document->videoPreloadLocation().dcId()) {
+		lines.push_back({ Tr(u"DC"_q), QString::number(dc) });
+	}
+}
+
+void AddPhotoLines(std::vector<Line> &lines, not_null<PhotoData*> photo) {
+	const auto size = photo->imageByteSize(Data::PhotoSize::Large);
+	if (size > 0) {
+		lines.push_back({ Tr(u"Size"_q), Ui::FormatSizeText(size) });
+	}
+	if (photo->width() > 0 && photo->height() > 0) {
+		lines.push_back({
+			Tr(u"Resolution"_q),
+			Resolution(photo->width(), photo->height()),
+		});
+	}
+	if (const auto dc = PhotoDc(photo)) {
+		lines.push_back({ Tr(u"DC"_q), QString::number(dc) });
+	}
+}
+
+[[nodiscard]] std::vector<Line> CollectLines(not_null<HistoryItem*> item) {
+	auto result = std::vector<Line>();
+	result.push_back({ Tr(u"Date"_q), ExactDate(item->date()) });
+	if (const auto forwarded = item->Get<HistoryMessageForwarded>()) {
+		if (forwarded->originalDate) {
+			result.push_back({
+				Tr(u"Original date"_q),
+				ExactDate(forwarded->originalDate),
+			});
+		}
+	}
+	if (const auto views = item->Get<HistoryMessageViews>()) {
+		if (views->views.count > 0) {
+			result.push_back({
+				Tr(u"Views"_q),
+				QString::number(views->views.count),
+			});
+		}
+		if (views->forwardsCount > 0) {
+			result.push_back({
+				Tr(u"Forwards"_q),
+				QString::number(views->forwardsCount),
+			});
+		}
+	}
+	if (const auto media = item->media()) {
+		if (const auto document = media->document()) {
+			AddDocumentLines(result, document);
+		} else if (const auto photo = media->photo()) {
+			AddPhotoLines(result, photo);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Shown(const QString &value) {
+	return (value.size() > kShownLength)
+		? (value.left(kShownLength - 1) + QChar(0x2026))
+		: value;
+}
+
+void CopyValue(
+		const std::shared_ptr<Main::SessionShow> &show,
+		const QString &value) {
+	QGuiApplication::clipboard()->setText(value);
+	ShowCopiedToast(show, tr::lng_text_copied(tr::now), { value });
+}
+
+} // namespace
+
+void AddMessageDetailsAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<HistoryItem*> item) {
+	if (!MessageDetailsMenu()
+		|| item->isService()
+		|| !IsServerMsgId(item->id)) {
+		return;
+	}
+	auto submenu = std::make_unique<Ui::PopupMenu>(
+		menu.get(),
+		menu->st());
+	for (const auto &line : CollectLines(item)) {
+		const auto value = line.value;
+		submenu->addAction(
+			line.label + u": "_q + Shown(value),
+			[=] { CopyValue(show, value); });
+	}
+	menu->addAction(
+		Tr(u"Details"_q),
+		std::move(submenu),
+		&st::menuIconInfo);
+}
+
+} // namespace Tele
