+void Bar::showActionsMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(this, st::popupMenuWithIcons);
+	_menu->addAction(
+		Tr(u"Stop bots"_q),
+		[=] { stopBots(); },
+		&st::menuIconBlock);
+	_menu->addAction(
+		tr::lng_profile_clear_and_exit(tr::now),
+		[=] { deleteAndLeave(); },
+		&st::menuIconDelete);
+	popup(_delete);
+}
+
+void Bar::stopBots() {
+	if (_controller->showFrozenError()) {
+		return;
+	}
+	auto bots = std::vector<not_null<PeerData*>>();
+	for (const auto &history : _state->chats) {
+		if (CanStopBot(history->peer)) {
+			bots.push_back(history->peer);
+		}
+	}
+	if (bots.empty()) {
+		return;
+	}
+	const auto count = int(bots.size());
+	const auto clear = crl::guard(this, [=] { Clear(_state); });
+	_controller->show(Ui::MakeConfirmBox({
+		.text = TrCount(count, u"Stop %1 bot?"_q, u"Stop %1 bots?"_q),
+		.confirmed = [=](Fn<void()> close) {
+			for (const auto &bot : bots) {
+				if (CanStopBot(bot)) {
+					bot->session().api().blockedPeers().block(bot);
+				}
+			}
+			clear();
+			close();
+		},
+		.confirmText = rpl::single(Tr(u"Stop bots"_q)),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
