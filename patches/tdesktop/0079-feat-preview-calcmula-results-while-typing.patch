index 0000000000000000000000000000000000000000..55ff95be1d78c7cd7355e9545b3bb6229892165a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_calcmula_preview.cpp
@@ -0,0 +1,309 @@
+#include "tele/tele_calcmula_preview.h"
+
+#include "base/event_filter.h"
+#include "base/invoke_queued.h"
+#include "base/timer.h"
+#include "base/unique_qptr.h"
+#include "tele/tele_calcmula.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/painter.h"
+#include "ui/rp_widget.h"
+#include "ui/text/text.h"
+#include "ui/text/text_entity.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/shadow.h"
+#include "styles/style_chat_helpers.h"
+#include "styles/style_overview.h"
+
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+constexpr auto kDelay = crl::time(350);
+
+class Preview final : public Ui::RpWidget {
+public:
+	explicit Preview(CalcmulaPreviewDescriptor &&descriptor);
+
+protected:
+	void setVisibleHook(bool visible) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+
+private:
+	enum class Title {
+		Value,
+		Pending,
+		Error,
+	};
+
+	void setupField();
+	void refresh();
+	void request();
+	void apply(const QString &text, Title title);
+	void cancel();
+	void updatePosition();
+	void setOver(bool over);
+	[[nodiscard]] bool allowed() const;
+	[[nodiscard]] QRect inner() const;
+
+	const not_null<Ui::InputField*> _field;
+	const not_null<Main::Session*> _session;
+	const Fn<bool()> _blocked;
+	const Fn<void()> _send;
+	const Ui::BoxShadow _shadow;
+	base::Timer _timer;
+	Ui::Text::String _title;
+	Ui::Text::String _description;
+	Title _titleState = Title::Value;
+	QPoint _bottomLeft;
+	QString _query;
+	std::optional<QString> _dismissed;
+	uint64 _requestId = 0;
+	bool _over = false;
+	bool _wanted = false;
+	bool _pressed = false;
+
+};
+
+Preview::Preview(CalcmulaPreviewDescriptor &&descriptor)
+: RpWidget(descriptor.parent.get())
+, _field(descriptor.field)
+, _session(descriptor.session)
+, _blocked(std::move(descriptor.blocked))
+, _send(std::move(descriptor.send))
+, _shadow(st::emojiPanAnimation.shadow)
+, _timer([=] { request(); }) {
+	hide();
+	setMouseTracking(true);
+	std::move(
+		descriptor.bottomLeft
+	) | rpl::on_next([=](QPoint point) {
+		_bottomLeft = point;
+		updatePosition();
+	}, lifetime());
+	setupField();
+}
+
+void Preview::setupField() {
+	_field->changes(
+	) | rpl::on_next([=] {
+		refresh();
+	}, lifetime());
+
+	const auto raw = _field->rawTextEdit().get();
+	QObject::connect(raw, &QTextEdit::cursorPositionChanged, this, [=] {
+		InvokeQueued(this, [=] { refresh(); });
+	}, Qt::QueuedConnection);
+
+	base::install_event_filter(this, raw, [=](not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type == QEvent::Hide) {
+			cancel();
+		} else if (type == QEvent::Show) {
+			InvokeQueued(this, [=] { refresh(); });
+		} else if (type == QEvent::KeyPress && !isHidden()) {
+			const auto key = static_cast<QKeyEvent*>(e.get());
+			const auto modifiers = key->modifiers()
+				& ~(Qt::KeypadModifier | Qt::GroupSwitchModifier);
+			if (key->key() == Qt::Key_Escape && !modifiers) {
+				_dismissed = _field->getLastText();
+				cancel();
+				return base::EventFilterResult::Cancel;
+			}
+		}
+		return base::EventFilterResult::Continue;
+	});
+}
+
+bool Preview::allowed() const {
+	return Calcmula()
+		&& CalcmulaPreview()
+		&& _field->isVisibleTo(parentWidget())
+		&& !_blocked();
+}
+
+void Preview::refresh() {
+	const auto text = _field->getLastText();
+	if (_dismissed && *_dismissed != text) {
+		_dismissed = std::nullopt;
+	}
+	const auto query = allowed() ? CalcmulaQuery(text) : QString();
+	if (query.isEmpty() || _dismissed) {
+		cancel();
+		return;
+	} else if (query == _query) {
+		return;
+	}
+	_query = query;
+	++_requestId;
+	_description.setText(
+		st::defaultTextStyle,
+		TextUtilities::SingleLine(query));
+	const auto cached = CalcmulaCached(query);
+	if (!cached.isEmpty()) {
+		_timer.cancel();
+		apply(cached, Title::Value);
+		return;
+	}
+	_timer.callOnce(kDelay);
+	if (!isHidden()) {
+		_titleState = Title::Pending;
+		update();
+	}
+}
+
+void Preview::request() {
+	if (_query.isEmpty() || !allowed()) {
+		cancel();
+		return;
+	}
+	const auto id = ++_requestId;
+	CalcmulaCompute(_session, _query, crl::guard(this, [=](
+			QString value,
+			QString error) {
+		if (id != _requestId) {
+			return;
+		} else if (!error.isEmpty()) {
+			apply(Lower(error), Title::Error);
+		} else {
+			apply(value, Title::Value);
+		}
+	}));
+}
+
+void Preview::apply(const QString &text, Title title) {
+	if (!allowed()) {
+		cancel();
+		return;
+	}
+	_title.setText(st::semiboldTextStyle, TextUtilities::SingleLine(text));
+	_titleState = title;
+	if (isHidden()) {
+		updatePosition();
+		_wanted = true;
+		show();
+		raise();
+	}
+	update();
+}
+
+void Preview::cancel() {
+	_timer.cancel();
+	++_requestId;
+	_query = QString();
+	_pressed = false;
+	setOver(false);
+	_wanted = false;
+	hide();
+}
+
+void Preview::setVisibleHook(bool visible) {
+	RpWidget::setVisibleHook(visible && _wanted);
+}
+
+void Preview::updatePosition() {
+	const auto &margins = st::emojiPanMargins;
+	const auto height = margins.top()
+		+ st::stickerPanPadding * 2
+		+ st::inlineFileSize
+		+ margins.bottom();
+	const auto width = std::min(
+		margins.left() + st::emojiPanWidth + margins.right(),
+		parentWidget()->width() - _bottomLeft.x());
+	setGeometry(
+		_bottomLeft.x(),
+		_bottomLeft.y() - height,
+		std::max(width, 0),
+		height);
+}
+
+QRect Preview::inner() const {
+	return rect().marginsRemoved(st::emojiPanMargins);
+}
+
+void Preview::setOver(bool over) {
+	if (_over == over) {
+		return;
+	}
+	_over = over;
+	setCursor(over ? style::cur_pointer : style::cur_default);
+}
+
+void Preview::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	const auto inner = this->inner();
+	_shadow.paint(p, inner, st::roundRadiusSmall);
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::emojiPanBg);
+		p.drawRoundedRect(inner, st::roundRadiusSmall, st::roundRadiusSmall);
+	}
+	const auto skip = st::stickerPanPadding;
+	const auto size = st::inlineFileSize;
+	const auto thumb = QRect(inner.x() + skip, inner.y() + skip, size, size);
+	p.fillRect(thumb, st::msgFile1Bg);
+	p.setFont(st::linksLetterFont);
+	p.setPen(st::linksLetterFg);
+	p.drawText(thumb, u"="_q, style::al_center);
+
+	const auto left = thumb.x() + size + st::inlineThumbSkip;
+	const auto available = inner.x() + inner.width() - skip - left;
+	p.setPen((_titleState == Title::Error)
+		? st::attentionButtonFg
+		: (_titleState == Title::Pending)
+		? st::inlineDescriptionFg
+		: st::inlineTitleFg);
+	_title.drawLeftElided(
+		p,
+		left,
+		thumb.y() + st::inlineRowFileNameTop,
+		available,
+		width());
+	p.setPen(st::inlineDescriptionFg);
+	_description.drawLeftElided(
+		p,
+		left,
+		thumb.y() + st::inlineRowFileDescriptionTop,
+		available,
+		width());
+}
+
+void Preview::mouseMoveEvent(QMouseEvent *e) {
+	setOver(inner().contains(e->pos()));
+}
+
+void Preview::mousePressEvent(QMouseEvent *e) {
+	_pressed = _over && (e->button() == Qt::LeftButton);
+}
+
+void Preview::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = _pressed;
+	_pressed = false;
+	if (pressed
+		&& _over
+		&& (e->button() == Qt::LeftButton)
+		&& allowed()) {
+		_send();
+	}
+}
+
+void Preview::leaveEventHook(QEvent *e) {
+	setOver(false);
+}
+
+} // namespace
+
+void SetupCalcmulaPreview(CalcmulaPreviewDescriptor &&descriptor) {
+	const auto field = descriptor.field;
+	field->lifetime().make_state<base::unique_qptr<Preview>>(
+		base::make_unique_q<Preview>(std::move(descriptor)));
+}
+
+} // namespace Tele
