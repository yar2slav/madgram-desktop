+constexpr auto kCacheSize = 32;
+constexpr auto kCacheLifetime = 5 * 60 * crl::time(1000);
 
 struct Result {
 	QString value;
 	QString error;
 };
 
+struct Cached {
+	QString query;
+	QString value;
+	crl::time when = 0;
+};
+
 bool Resending = false;
 
 [[nodiscard]] QString Query(const QString &text) {
@@ -141,6 +150,7 @@ void ShowError(not_null<History*> history, const QString &error) {
 }
 
 void RestoreDraft(const Api::MessageToSend &message) {
+	Core::App().materializeLocalDrafts();
 	const auto history = message.action.history;
 	const auto topicRootId = message.action.replyTo.topicRootId;
 	const auto monoforumPeerId = message.action.replyTo.monoforumPeerId;
@@ -188,6 +198,49 @@ void Resend(FnMut<void()> callback) {
 	Resending = false;
 }
 
+[[nodiscard]] std::vector<Cached> &Cache() {
+	static auto result = std::vector<Cached>();
+	return result;
+}
+
+[[nodiscard]] QString CachedValue(const QString &query) {
+	auto &cache = Cache();
+	const auto now = crl::now();
+	cache.erase(ranges::remove_if(cache, [&](const Cached &entry) {
+		return (now - entry.when) > kCacheLifetime;
+	}), end(cache));
+	const auto i = ranges::find(cache, query, &Cached::query);
+	return (i != end(cache)) ? i->value : QString();
+}
+
+void Remember(const QString &query, const QString &value) {
+	auto &cache = Cache();
+	cache.erase(ranges::remove(cache, query, &Cached::query), end(cache));
+	cache.push_back({ .query = query, .value = value, .when = crl::now() });
+	if (int(cache.size()) > kCacheSize) {
+		cache.erase(begin(cache));
+	}
+}
+
+void ComputeCached(
+		not_null<Main::Session*> session,
+		const QString &query,
+		Fn<void(Result)> done) {
+	const auto value = CachedValue(query);
+	if (!value.isEmpty()) {
+		crl::on_main(session.get(), [=] {
+			done(Result{ .value = value });
+		});
+		return;
+	}
+	Compute(session, query, [=](Result result) {
+		if (!result.value.isEmpty()) {
+			Remember(query, result.value);
+		}
+		done(std::move(result));
+	});
+}
+
 } // namespace
 
 bool CalcmulaMessage(const Api::MessageToSend &message) {
@@ -205,7 +258,7 @@ bool CalcmulaMessage(const Api::MessageToSend &message) {
 		return false;
 	}
 	const auto original = std::make_shared<Api::MessageToSend>(message);
-	Compute(session, query, [=](Result result) {
+	ComputeCached(session, query, [=](Result result) {
 		if (!result.error.isEmpty()) {
 			ShowError(history, result.error);
 			RestoreDraft(*original);
@@ -232,7 +285,7 @@ bool CalcmulaCaption(
 	}
 	const auto history = message.action.history;
 	const auto original = std::make_shared<Api::MessageToSend>(message);
-	Compute(&history->session(), query, [=](Result result) {
+	ComputeCached(&history->session(), query, [=](Result result) {
 		auto copy = *original;
 		if (!result.error.isEmpty()) {
 			ShowError(history, result.error);
@@ -277,7 +330,7 @@ bool CalcmulaFiles(
 	for (const auto &entry : queries) {
 		const auto index = entry.first;
 		const auto query = entry.second;
-		Compute(session, query, [=](Result result) {
+		ComputeCached(session, query, [=](Result result) {
 			if (!result.error.isEmpty()) {
 				state->error = result.error;
 			} else {
@@ -302,4 +355,21 @@ bool CalcmulaFiles(
 	return true;
 }
 
+QString CalcmulaQuery(const QString &text) {
+	return Query(text);
+}
+
+QString CalcmulaCached(const QString &query) {
+	return CachedValue(query);
+}
+
+void CalcmulaCompute(
+		not_null<Main::Session*> session,
+		const QString &query,
+		Fn<void(QString value, QString error)> done) {
+	ComputeCached(session, query, [=](Result result) {
+		done(result.value, result.error);
+	});
+}
+
 } // namespace Tele
