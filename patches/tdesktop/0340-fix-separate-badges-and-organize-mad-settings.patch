+[[nodiscard]] Ui::AbstractButton *AddSettingHelp(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Window::SessionController*> controller,
+		const QString &name,
+		const QString &description,
+		int right) {
+	if (description.isEmpty()) {
+		return nullptr;
+	}
+	const auto help = Ui::CreateChild<Ui::AbstractButton>(parent);
+	help->resize(st::madSettingHelpSize, st::madSettingHelpSize);
+	help->setToolTip(description);
+	help->setAccessibleName(::Tele::Tr(u"About this setting"_q) + u": "_q + name);
+	help->setFocusPolicy(Qt::StrongFocus);
+	parent->sizeValue() | rpl::on_next([=](QSize size) {
+		help->moveToRight(right, (size.height() - help->height()) / 2);
+	}, help->lifetime());
+	help->paintRequest() | rpl::on_next([=] {
+		static const auto source = [] {
+			auto file = QFile(u":/gui/art/mad_help.svg"_q);
+			return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+		}();
+		auto data = source;
+		data.replace("currentColor", st::windowSubTextFg->c.name().toLatin1());
+		auto svg = QSvgRenderer(data);
+		auto painter = QPainter(help);
+		const auto skip = st::madSettingHelpInset;
+		svg.render(&painter, QRectF(help->rect().marginsRemoved({ skip, skip, skip, skip })));
+	}, help->lifetime());
+	help->setClickedCallback([=] {
+		controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+			box->setTitle(rpl::single(name));
+			box->addRow(object_ptr<Ui::FlatLabel>(box, description, st::boxLabel));
+			box->addButton(rpl::single(::Tele::Tr(u"Close"_q)), [=] { box->closeBox(); });
+		}));
+	});
+	help->show();
+	return help;
+}
