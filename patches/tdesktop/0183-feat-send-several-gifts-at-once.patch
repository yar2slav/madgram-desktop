+#include "styles/style_layers.h"
+#include "styles/style_settings.h"
+#include "styles/style_widgets.h"
+
+namespace Tele {
+
+struct GiftCounter : base::has_weak_ptr {
+	explicit GiftCounter(not_null<Ui::GenericBox*> box) : box(box) {
+	}
+
+	not_null<Ui::GenericBox*> box;
+	rpl::variable<int> count = 1;
+	rpl::variable<int> sending = 0;
+	int total = 0;
+};
+
+namespace {
+
+using Info::PeerGifts::GiftDescriptor;
+using Info::PeerGifts::GiftSendDetails;
+using Info::PeerGifts::GiftTypeStars;
+
+[[nodiscard]] const style::RoundButton &StepButtonStyle() {
+	static const auto result = [] {
+		auto copy = st::defaultLightButton;
+		copy.width = copy.height;
+		return copy;
+	}();
+	return result;
+}
+
+[[nodiscard]] const style::InputField &CountFieldStyle() {
+	static const auto result = [] {
+		auto copy = st::defaultInputField;
+		const auto height = st::defaultLightButton.height;
+		const auto font = copy.style.font->height;
+		const auto top = (height - font) / 2;
+		copy.textMargins = QMargins(0, top, 0, height - font - top);
+		copy.textAlign = style::al_top;
+		copy.placeholderScale = 0.;
+		copy.heightMin = height;
+		return copy;
+	}();
+	return result;
+}
+
+[[nodiscard]] int64 GiftPrice(const GiftSendDetails &details) {
+	const auto stars = std::get_if<GiftTypeStars>(&details.descriptor);
+	return stars
+		? (std::abs(stars->info.stars)
+			+ (details.upgraded ? stars->info.starsToUpgrade : 0))
+		: 0;
+}
+
+void AddCounterRow(
+		not_null<Ui::VerticalLayout*> container,
+		not_null<GiftCounter*> counter) {
+	const auto &padding = st::settingsButtonNoIcon.padding;
+	const auto height = st::defaultLightButton.height
+		+ padding.top()
+		+ padding.bottom();
+	const auto row = container->add(
+		object_ptr<Ui::FixedHeightWidget>(container, height));
+	const auto label = Ui::CreateChild<Ui::FlatLabel>(
+		row,
+		Lower(u"Quantity"_q),
+		st::boxLabel);
+	const auto minus = Ui::CreateChild<Ui::RoundButton>(
+		row,
+		rpl::single(QString(QChar(0x2212))),
+		StepButtonStyle());
+	const auto plus = Ui::CreateChild<Ui::RoundButton>(
+		row,
+		rpl::single(u"+"_q),
+		StepButtonStyle());
+	const auto field = Ui::CreateChild<Ui::NumberInput>(
+		row,
+		CountFieldStyle(),
+		rpl::single(u"1"_q),
+		u"1"_q,
+		std::numeric_limits<int>::max());
+	minus->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	plus->setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+	const auto fieldWidth = st::defaultLightButton.height * 2;
+	field->resize(fieldWidth, st::defaultLightButton.height);
+
+	const auto set = [=](int value) {
+		counter->count = std::max(value, 1);
+		const auto text = QString::number(counter->count.current());
+		if (field->getLastText() != text) {
+			field->setText(text);
+		}
+	};
+	QObject::connect(field, &Ui::NumberInput::changed, [=] {
+		counter->count = std::max(field->getLastText().toInt(), 1);
+	});
+	QObject::connect(field, &Ui::NumberInput::blurred, [=] {
+		set(counter->count.current());
+	});
+	minus->setClickedCallback([=] {
+		set(counter->count.current() - 1);
+	});
+	plus->setClickedCallback([=] {
+		const auto now = counter->count.current();
+		set((now < std::numeric_limits<int>::max()) ? (now + 1) : now);
+	});
+	counter->count.value() | rpl::on_next([=](int value) {
+		minus->setDisabled(value <= 1);
+	}, minus->lifetime());
+
+	row->widthValue() | rpl::on_next([=](int width) {
+		const auto top = padding.top();
+		auto right = width - padding.right();
+		right -= plus->width();
+		plus->moveToLeft(right, top, width);
+		right -= field->width();
+		field->moveToLeft(right, top, width);
+		right -= minus->width();
+		minus->moveToLeft(right, top, width);
+		label->resizeToWidth(std::max(right - padding.left(), 1));
+		label->moveToLeft(
+			padding.left(),
+			(height - label->height()) / 2,
+			width);
+	}, row->lifetime());
+}
+
+[[nodiscard]] MTPInputInvoice GiftInvoice(
+		not_null<PeerData*> peer,
+		const GiftSendDetails &details) {
+	const auto &gift = v::get<GiftTypeStars>(details.descriptor).info;
+	using Flag = MTPDinputInvoiceStarGift::Flag;
+	return MTP_inputInvoiceStarGift(
+		MTP_flags((details.anonymous ? Flag::f_hide_name : Flag(0))
+			| (details.text.empty() ? Flag(0) : Flag::f_message)
+			| (details.upgraded ? Flag::f_include_upgrade : Flag(0))),
+		peer->input(),
+		MTP_long(gift.id),
+		MTP_textWithEntities(
+			MTP_string(details.text.text),
+			Api::EntitiesToMTP(
+				&peer->session(),
+				details.text.entities,
+				Api::ConvertOption::SkipLocal)));
+}
+
+[[nodiscard]] TextWithEntities ErrorText(
+		const QString &type,
+		const Data::StarGift &gift) {
+	if (type == u"STARGIFT_USAGE_LIMITED"_q) {
+		return { tr::lng_gift_sold_out_title(tr::now) };
+	} else if (type == u"STARGIFT_USER_USAGE_LIMITED"_q) {
+		return tr::lng_gift_sent_finished(
+			tr::now,
+			lt_count,
+			std::max(gift.perUserTotal, 1),
+			tr::rich);
+	} else if (type == u"USER_DISALLOWED_STARGIFTS"_q) {
+		return { tr::lng_edit_privacy_gifts_restricted(tr::now) };
+	} else if (type == u"STARGIFT_MESSAGE_INVALID"_q) {
+		return { tr::lng_gift_send_message_restricted(tr::now) };
+	}
+	return { type };
+}
+
+void SendOne(
+		not_null<Main::Session*> session,
+		MTPInputInvoice invoice,
+		Data::StarGift gift,
+		Fn<void(std::optional<TextWithEntities>)> done) {
+	const auto fail = [=](const MTP::Error &error) {
+		done(ErrorText(error.type(), gift));
+	};
+	session->api().request(MTPpayments_GetPaymentForm(
+		MTP_flags(0),
+		invoice,
+		MTPDataJSON()
+	)).done([=](const MTPpayments_PaymentForm &result) {
+		const auto formId = result.match([](
+				const MTPDpayments_paymentFormStarGift &data) {
+			return data.vform_id().v;
+		}, [](const MTPDpayments_paymentFormStars &data) {
+			return data.vform_id().v;
+		}, [](const auto &) {
+			return uint64();
+		});
+		if (!formId) {
+			done(ErrorText(u"PAYMENT_FORM_INVALID"_q, gift));
+			return;
+		}
+		session->api().request(MTPpayments_SendStarsForm(
+			MTP_long(formId),
+			invoice
+		)).done([=](const MTPpayments_PaymentResult &result) {
+			result.match([&](const MTPDpayments_paymentResult &data) {
+				session->api().applyUpdates(data.vupdates());
+				done(std::nullopt);
+			}, [&](const MTPDpayments_paymentVerificationNeeded &) {
+				done(ErrorText(u"PAYMENT_VERIFICATION_NEEDED"_q, gift));
+			});
+		}).fail(fail).send();
+	}).fail(fail).send();
+}
+
+void SendAll(
+		not_null<GiftCounter*> counter,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		GiftSendDetails details,
+		int count) {
+	struct State {
+		int sent = 0;
+		Fn<void()> next;
+	};
+	const auto state = std::make_shared<State>();
+	const auto session = &peer->session();
+	const auto show = window->uiShow();
+	const auto weak = base::make_weak(counter);
+	const auto weakWindow = base::make_weak(window);
+	const auto invoice = GiftInvoice(peer, details);
+	const auto gift = v::get<GiftTypeStars>(details.descriptor).info;
+	const auto finish = [=](std::optional<TextWithEntities> error) {
+		state->next = nullptr;
+		const auto sent = state->sent;
+		session->credits().load(true);
+		if (sent > 0) {
+			if (const auto strong = weakWindow.get()) {
+				strong->showPeerHistory(peer);
+			}
+		}
+		auto toast = Ui::Toast::Config();
+		if (!error && sent == count) {
+			toast.title = tr::lng_gift_sent_title(tr::now);
+			toast.text = { Lower(u"Sent %1 gifts."_q).arg(sent) };
+		} else {
+			toast.title = Lower(u"Sent %1 of %2 gifts"_q).arg(sent).arg(count);
+			toast.text = error.value_or(TextWithEntities());
+		}
+		show->showToast(std::move(toast));
+		if (const auto strong = weak.get()) {
+			strong->sending = 0;
+			strong->box->closeBox();
+		}
+	};
+	state->next = [=] {
+		const auto strong = weak.get();
+		if (!strong) {
+			finish(std::nullopt);
+			return;
+		} else if (state->sent >= count) {
+			finish(std::nullopt);
+			return;
+		}
+		strong->sending = state->sent + 1;
+		SendOne(session, invoice, gift, [=](
+				std::optional<TextWithEntities> error) {
+			if (error) {
+				finish(std::move(error));
+				return;
+			}
+			++state->sent;
+			if (const auto next = state->next) {
+				next();
+			}
+		});
+	};
+	counter->total = count;
+	const auto first = state->next;
+	first();
+}
+
+} // namespace
+
+GiftCounter *AddGiftQuantity(
+		not_null<Ui::GenericBox*> box,
+		not_null<Ui::VerticalLayout*> container,
+		const GiftDescriptor &descriptor,
+		bool auction) {
+	const auto stars = std::get_if<GiftTypeStars>(&descriptor);
+	if (!GiftQuantity()
+		|| !stars
+		|| auction
+		|| stars->info.auction()
+		|| stars->info.unique) {
+		return nullptr;
+	}
+	const auto counter = box->lifetime().make_state<GiftCounter>(box);
+	AddCounterRow(container, counter);
+	return counter;
+}
+
+rpl::producer<TextWithEntities> GiftQuantitySendLabel(
+		GiftCounter *counter,
+		bool self,
+		rpl::producer<GiftSendDetails> details,
+		rpl::producer<TextWithEntities> cost) {
+	const auto phrase = self
+		? tr::lng_gift_send_button_self
+		: tr::lng_gift_send_button;
+	if (!counter) {
+		return phrase(lt_cost, std::move(cost), tr::marked);
+	}
+	return rpl::combine(
+		counter->count.value(),
+		counter->sending.value(),
+		std::move(details),
+		std::move(cost)
+	) | rpl::map([=](
+			int count,
+			int sending,
+			const GiftSendDetails &details,
+			const TextWithEntities &cost) {
+		if (sending) {
+			return TextWithEntities{
+				Lower(u"Sending %1 of %2\u2026"_q)
+					.arg(sending)
+					.arg(counter->total),
+			};
+		} else if (count <= 1) {
+			return phrase(tr::now, lt_cost, cost, tr::marked);
+		}
+		return TextWithEntities{
+			Lower(self
+				? u"Buy %1 gifts for "_q
+				: u"Send %1 gifts for "_q).arg(
+					Lang::FormatCountDecimal(count)),
+		}.append(Ui::CreditsEmojiSmall()).append(
+			Lang::FormatCountDecimal(GiftPrice(details) * count));
+	});
+}
+
+bool SendGiftQuantity(
+		GiftCounter *counter,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		const GiftSendDetails &details,
+		Fn<void()> cancelled) {
+	const auto count = counter ? counter->count.current() : 1;
+	if (count <= 1 || !v::is<GiftTypeStars>(details.descriptor)) {
+		return false;
+	}
+	const auto total = GiftPrice(details) * count;
+	const auto show = window->uiShow();
+	const auto weak = base::make_weak(counter);
+	const auto weakWindow = base::make_weak(window);
+	const auto start = [=] {
+		const auto strong = weak.get();
+		const auto strongWindow = weakWindow.get();
+		if (!strong) {
+			return;
+		} else if (!strongWindow) {
+			cancelled();
+			return;
+		}
+		SendAll(strong, strongWindow, peer, details, count);
+	};
+	const auto confirmed = [=](Fn<void()> close) {
+		close();
+		Settings::MaybeRequestBalanceIncrease(
+			show,
+			uint64(total),
+			Settings::SmallBalanceStarGift{ .recipientId = peer->id },
+			[=](Settings::SmallBalanceResult result) {
+				using Result = Settings::SmallBalanceResult;
+				if (result == Result::Already || result == Result::Success) {
+					start();
+				} else if (weak) {
+					cancelled();
+				}
+			});
+	};
+	const auto text = TextWithEntities{
+		Lower(u"Send %1 gifts for %2 "_q)
+			.arg(Lang::FormatCountDecimal(count))
+			.arg(Lang::FormatCountDecimal(total)),
+	}.append(
+		Ui::Text::IconEmoji(&st::starIconEmojiColored)
+	).append(u"?"_q);
+	show->show(Ui::MakeConfirmBox({
+		.text = text,
+		.confirmed = confirmed,
+		.cancelled = [=](Fn<void()> close) {
+			if (weak) {
+				cancelled();
+			}
+			close();
+		},
+		.confirmText = tr::lng_send_button(),
+	}));
+	return true;
+}
+
+} // namespace Tele
