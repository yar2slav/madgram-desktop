diff --git a/Telegram/SourceFiles/tele/tele_pin_sets.cpp b/Telegram/SourceFiles/tele/tele_pin_sets.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b68586c9e1643934e859d2be6617a6bee57e099b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_pin_sets.cpp
@@ -0,0 +1,330 @@
+#include "tele/tele_pin_sets.h"
+
+#include "data/data_session.h"
+#include "data/stickers/data_stickers.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E5E75);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxSets = 4096;
+
+enum class Kind : uchar {
+	Stickers,
+	Emoji,
+};
+constexpr auto kKinds = 2;
+
+QPointer<Ui::PopupMenu> ShownMenu;
+
+class State final : public base::has_weak_ptr {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static not_null<State*> Get(
+		not_null<Main::Session*> session);
+
+	[[nodiscard]] const QList<uint64> &ordered(
+		Kind kind,
+		const QList<uint64> &order);
+	[[nodiscard]] std::vector<uint64> shown(Kind kind);
+	void toggle(Kind kind, uint64 setId);
+	void move(Kind kind, uint64 setId, int delta);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	[[nodiscard]] const QList<uint64> &order(Kind kind) const;
+	void load();
+	void read();
+	void write() const;
+	void changed(Kind kind);
+	void notify(Kind kind) const;
+
+	const not_null<Main::Session*> _session;
+	std::array<std::vector<uint64>, kKinds> _pinned;
+	std::array<QList<uint64>, kKinds> _ordered;
+	bool _loaded = false;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+
+	PinSetsChanges(
+	) | rpl::on_next([=] {
+		notify(Kind::Stickers);
+		notify(Kind::Emoji);
+	}, _lifetime);
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+not_null<State*> State::Get(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	if (i != end(registry)) {
+		return i->second;
+	}
+	return session->lifetime().make_state<State>(session);
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+const QList<uint64> &State::order(Kind kind) const {
+	const auto &stickers = _session->data().stickers();
+	return (kind == Kind::Emoji)
+		? stickers.emojiSetsOrder()
+		: stickers.setsOrder();
+}
+
+void State::load() {
+	if (!_loaded) {
+		_loaded = true;
+		read();
+	}
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_pin_sets"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	file.stream >> magic >> version >> owner;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()) {
+		return;
+	}
+	auto result = std::array<std::vector<uint64>, kKinds>();
+	for (auto &pinned : result) {
+		auto count = quint32();
+		file.stream >> count;
+		if (file.stream.status() != QDataStream::Ok || count > kMaxSets) {
+			return;
+		}
+		pinned.reserve(count);
+		for (auto i = quint32(); i != count; ++i) {
+			auto id = quint64();
+			file.stream >> id;
+			if (file.stream.status() != QDataStream::Ok) {
+				return;
+			} else if (!ranges::contains(pinned, uint64(id))) {
+				pinned.push_back(id);
+			}
+		}
+	}
+	_pinned = std::move(result);
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) + sizeof(qint32) + sizeof(quint64);
+	for (const auto &pinned : _pinned) {
+		size += sizeof(quint32) + pinned.size() * sizeof(quint64);
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId());
+	for (const auto &pinned : _pinned) {
+		data.stream << quint32(pinned.size());
+		for (const auto id : pinned) {
+			data.stream << quint64(id);
+		}
+	}
+	auto file = FileWriteDescriptor(u"tele_pin_sets"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+const QList<uint64> &State::ordered(
+		Kind kind,
+		const QList<uint64> &order) {
+	load();
+	const auto &pinned = _pinned[int(kind)];
+	auto &result = _ordered[int(kind)];
+	result.clear();
+	for (const auto id : pinned) {
+		if (order.contains(id)) {
+			result.push_back(id);
+		}
+	}
+	if (result.isEmpty()) {
+		return order;
+	}
+	result.reserve(order.size());
+	for (const auto id : order) {
+		if (!ranges::contains(pinned, id)) {
+			result.push_back(id);
+		}
+	}
+	return result;
+}
+
+std::vector<uint64> State::shown(Kind kind) {
+	load();
+	const auto &all = order(kind);
+	auto result = std::vector<uint64>();
+	for (const auto id : _pinned[int(kind)]) {
+		if (all.contains(id)) {
+			result.push_back(id);
+		}
+	}
+	return result;
+}
+
+void State::toggle(Kind kind, uint64 setId) {
+	load();
+	auto &pinned = _pinned[int(kind)];
+	const auto i = ranges::find(pinned, setId);
+	if (i != end(pinned)) {
+		pinned.erase(i);
+	} else if (pinned.size() < kMaxSets) {
+		pinned.push_back(setId);
+	} else {
+		return;
+	}
+	changed(kind);
+}
+
+void State::move(Kind kind, uint64 setId, int delta) {
+	const auto list = shown(kind);
+	const auto i = ranges::find(list, setId);
+	if (i == end(list)) {
+		return;
+	}
+	const auto index = int(i - begin(list)) + delta;
+	if (index < 0 || index >= int(list.size())) {
+		return;
+	}
+	auto &pinned = _pinned[int(kind)];
+	const auto from = ranges::find(pinned, setId);
+	const auto to = ranges::find(pinned, list[index]);
+	std::iter_swap(from, to);
+	changed(kind);
+}
+
+void State::changed(Kind kind) {
+	write();
+	notify(kind);
+}
+
+void State::notify(Kind kind) const {
+	_session->data().stickers().notifyUpdated((kind == Kind::Emoji)
+		? Data::StickersType::Emoji
+		: Data::StickersType::Stickers);
+}
+
+[[nodiscard]] std::optional<Kind> KindOf(
+		not_null<Main::Session*> session,
+		uint64 setId) {
+	const auto &stickers = session->data().stickers();
+	if (stickers.setsOrder().contains(setId)) {
+		return Kind::Stickers;
+	} else if (stickers.emojiSetsOrder().contains(setId)) {
+		return Kind::Emoji;
+	}
+	return std::nullopt;
+}
+
+} // namespace
+
+const QList<uint64> &PinnedSetsFirst(
+		not_null<Main::Session*> session,
+		const QList<uint64> &order) {
+	const auto state = State::Get(session);
+	if (!PinSets()) {
+		return order;
+	}
+	const auto &stickers = session->data().stickers();
+	if (&order == &stickers.setsOrder()) {
+		return state->ordered(Kind::Stickers, order);
+	} else if (&order == &stickers.emojiSetsOrder()) {
+		return state->ordered(Kind::Emoji, order);
+	}
+	return order;
+}
+
+bool ShowPinSetMenu(
+		not_null<QWidget*> parent,
+		const style::PopupMenu &st,
+		not_null<Main::Session*> session,
+		uint64 setId) {
+	if (!PinSets()) {
+		return false;
+	}
+	const auto kind = KindOf(session, setId);
+	if (!kind) {
+		return false;
+	}
+	const auto state = State::Get(session);
+	const auto list = state->shown(*kind);
+	const auto index = int(ranges::find(list, setId) - begin(list));
+	const auto pinned = (index < int(list.size()));
+	const auto menu = Ui::CreateChild<Ui::PopupMenu>(parent.get(), st);
+	menu->addAction(
+		Lower(pinned ? u"Unpin"_q : u"Pin"_q),
+		crl::guard(state.get(), [=] { state->toggle(*kind, setId); }),
+		pinned ? &st::menuIconUnpin : &st::menuIconPin);
+	if (pinned && index > 0) {
+		menu->addAction(
+			Lower(u"Move left"_q),
+			crl::guard(state.get(), [=] { state->move(*kind, setId, -1); }),
+			&st::menuIconReorder);
+	}
+	if (pinned && index + 1 < int(list.size())) {
+		menu->addAction(
+			Lower(u"Move right"_q),
+			crl::guard(state.get(), [=] { state->move(*kind, setId, 1); }),
+			&st::menuIconReorder);
+	}
+	ShownMenu = menu;
+	menu->popup(QCursor::pos());
+	return true;
+}
+
+bool PinSetMenuShown(not_null<const QWidget*> selector) {
+	const auto menu = ShownMenu.data();
+	return menu && selector->isAncestorOf(menu->parentWidget());
+}
+
+} // namespace Tele
