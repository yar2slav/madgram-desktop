+namespace Main {
+class Session;
+} // namespace Main
+
+namespace style {
+struct PopupMenu;
+} // namespace style
+
+namespace Tele {
+
+[[nodiscard]] const QList<uint64> &PinnedSetsFirst(
+	not_null<Main::Session*> session,
+	const QList<uint64> &order);
+[[nodiscard]] bool ShowPinSetMenu(
+	not_null<QWidget*> parent,
+	const style::PopupMenu &st,
+	not_null<Main::Session*> session,
+	uint64 setId);
+[[nodiscard]] bool PinSetMenuShown(not_null<const QWidget*> selector);
+
+} // namespace Tele
