diff --git a/Telegram/SourceFiles/tele/tele_member_dates.cpp b/Telegram/SourceFiles/tele/tele_member_dates.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6d741ac2cf2260642726cecda61071bbcfb9c401
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_member_dates.cpp
@@ -0,0 +1,82 @@
+#include "tele/tele_member_dates.h"
+
+#include "api/api_chat_participants.h"
+#include "base/unixtime.h"
+#include "boxes/peers/prepare_short_info_box.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "lang/lang_keys.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/menu/menu_multiline_action.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/window_session_controller.h"
+#include "styles/style_chat.h"
+
+namespace Tele {
+namespace {
+
+struct Joined {
+	TimeId date = 0;
+	UserId inviter = 0;
+};
+
+[[nodiscard]] base::flat_map<std::pair<PeerId, PeerId>, Joined> &Dates() {
+	static auto result = base::flat_map<std::pair<PeerId, PeerId>, Joined>();
+	return result;
+}
+
+} // namespace
+
+void RememberMemberDate(
+		not_null<PeerData*> chat,
+		const Api::ChatParticipant &data) {
+	const auto date = data.memberSince();
+	if (!MemberJoinDate() || (date <= 0)) {
+		return;
+	}
+	Dates()[{ chat->id, data.id() }] = Joined{
+		.date = date,
+		.inviter = data.by(),
+	};
+}
+
+void AddMemberDateAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<PeerData*> chat,
+		not_null<PeerData*> participant,
+		Window::SessionNavigation *navigation) {
+	if (!MemberJoinDate()) {
+		return;
+	}
+	const auto i = Dates().find({ chat->id, participant->id });
+	if (i == end(Dates())) {
+		return;
+	}
+	const auto joined = i->second;
+	const auto inviter = joined.inviter
+		? chat->owner().userLoaded(joined.inviter)
+		: nullptr;
+	auto text = TextWithEntities::Simple(Tr(u"Joined: %1"_q).arg(
+		langDateTimeFull(base::unixtime::parse(joined.date))));
+	if (inviter) {
+		text.append('\n').append(Tr(u"Invited by %1"_q).arg(inviter->name()));
+	}
+	auto button = base::make_unique_q<Ui::Menu::MultilineAction>(
+		menu->menu(),
+		menu->st().menu,
+		st::historyHasCustomEmoji,
+		st::historyHasCustomEmojiPosition,
+		std::move(text));
+	if (inviter && navigation) {
+		button->setActionTriggered([=] {
+			navigation->parentController()->show(
+				PrepareShortInfoBox(inviter, navigation));
+		});
+	}
+	menu->addSeparator();
+	menu->addAction(std::move(button));
+}
+
+} // namespace Tele
