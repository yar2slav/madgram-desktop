+	return _items.empty() ? nullptr : _items.front().get();
+}
+
+void ShotRenderer::subscribe() {
+	const auto session = &_controller->session();
+	auto &owner = session->data();
+	const auto ours = [=](not_null<const HistoryItem*> item) {
+		return ranges::any_of(_items, [&](not_null<HistoryItem*> mine) {
+			return (mine.get() == item.get());
+		});
+	};
+
+	owner.viewRepaintRequest(
+	) | rpl::filter([=](const Data::RequestViewRepaint &data) {
+		return _viewSet.contains(data.view.get());
+	}) | rpl::on_next([=](const Data::RequestViewRepaint &) {
+		_repaints.fire({});
+	}, _lifetime);
+
+	owner.itemRepaintRequest(
+	) | rpl::filter(ours) | rpl::on_next([=](
+			not_null<const HistoryItem*>) {
+		_repaints.fire({});
+	}, _lifetime);
+
+	session->downloaderTaskFinished(
+	) | rpl::on_next([=] {
+		_repaints.fire({});
+	}, _lifetime);
+
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		_background = std::nullopt;
+		_repaints.fire({});
+	}, _lifetime);
+
+	owner.viewResizeRequest(
+	) | rpl::filter([=](not_null<Element*> view) {
+		return !_layingOut && _viewSet.contains(view.get());
+	}) | rpl::on_next([=](not_null<Element*> view) {
+		_dirty.emplace(view);
+		schedule(false);
+	}, _lifetime);
+
+	owner.itemResizeRequest(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return !_layingOut && ours(item);
+	}) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		for (const auto &view : _views) {
+			if (view->data() == item) {
+				_dirty.emplace(view.get());
+			}
+		}
+		schedule(false);
+	}, _lifetime);
+
+	owner.itemViewRefreshRequest(
+	) | rpl::filter(ours) | rpl::on_next([=](
+			not_null<const HistoryItem*>) {
+		schedule(true);
+	}, _lifetime);
+
+	owner.itemRemoved(
+	) | rpl::filter(ours) | rpl::on_next([=](
+			not_null<const HistoryItem*>) {
+		clear();
+		_items.clear();
+		_removals.fire({});
+	}, _lifetime);
+}
+
+void ShotRenderer::schedule(bool full) {
+	if (full) {
+		_pendingRebuild = true;
+	}
+	if (_scheduled) {
+		return;
+	}
+	_scheduled = true;
+	crl::on_main(this, [=] {
+		_scheduled = false;
+		if (base::take(_pendingRebuild)) {
+			rebuild();
+		} else {
+			relayout();
+		}
+	});
+}
+
+void ShotRenderer::clear() {
+	_dirty.clear();
+	_viewSet.clear();
+	_tops.clear();
+	_shown = 0;
+	base::take(_views);
+}
+
+void ShotRenderer::rebuild() {
+	clear();
+	for (const auto &item : _items) {
+		auto view = item->createView(_delegate.get());
+		_viewSet.emplace(view.get());
+		_views.push_back(std::move(view));
+	}
+	relayout();
+}
+
+void ShotRenderer::refreshAttachments(int till) {
+	Element *previous = nullptr;
+	for (auto i = 0; i != till; ++i) {
+		const auto view = _views[i].get();
+		if (view->isHidden()) {
+			view->setDisplayDate(false);
+			continue;
+		} else if (!previous) {
+			view->setDisplayDate(_options.dates);
+			view->setAttachToPrevious(false);
+		} else {
+			view->setDisplayDate(_options.dates
+				&& ((view->dateTime().date()
+					!= previous->dateTime().date())
+					|| previous->data()->hideDisplayDate()));
+			const auto attached = view->computeIsAttachToPrevious(previous);
+			view->setAttachToPrevious(attached, previous);
+			previous->setAttachToNext(attached, view);
+		}
+		previous = view;
+	}
+	if (previous) {
+		previous->setAttachToNext(false);
+	}
+}
+
+void ShotRenderer::relayout() {
+	_layingOut = true;
+	for (const auto &view : base::take(_dirty)) {
+		view->initDimensions();
+	}
+	_width = LayoutWidth(_chatWidth);
+	const auto limit = kMaxSide / ExportRatio();
+	const auto count = int(_views.size());
+	refreshAttachments(count);
+	auto top = TopPadding();
+	auto shown = 0;
+	for (; shown != count; ++shown) {
+		const auto height = _views[shown]->resizeGetHeight(_width);
+		if (shown > 0 && top + height + BottomPadding() > limit) {
+			break;
+		}
+		top += height;
+	}
+	if (shown < count) {
+		refreshAttachments(shown);
+	}
+	_tops.clear();
+	top = TopPadding();
+	for (auto i = 0; i != shown; ++i) {
+		_tops.push_back(top);
+		top += _views[i]->resizeGetHeight(_width);
+	}
+	_shown = shown;
+	_height = std::min(top + BottomPadding(), limit);
+	computeBounds();
+	_layingOut = false;
+	_layoutVersion = _layoutVersion.current() + 1;
+}
+
+void ShotRenderer::computeBounds() {
+	auto left = _width;
+	auto right = 0;
+	const auto add = [&](int from, int till) {
+		if (from < till) {
+			left = std::min(left, from);
+			right = std::max(right, till);
+		}
+	};
+	auto badge = 0;
+	for (auto i = 0; i != _shown; ++i) {
+		const auto view = _views[i].get();
+		if (view->isHidden()) {
+			continue;
+		}
+		const auto inner = view->innerGeometry();
+		add(inner.x(), inner.x() + inner.width());
+		if (view->hasFromPhoto()) {
+			add(st::historyPhotoLeft, st::historyPhotoLeft + st::msgPhotoSize);
+		}
+		if (const auto date = view->Get<HistoryView::DateBadge>()) {
+			badge = std::max(
+				badge,
+				date->width
+					+ st::msgServicePadding.left()
+					+ st::msgServicePadding.right());
+		}
+	}
+	scanBounds(left, right);
+	if (left >= right) {
+		left = 0;
+		right = _width;
+	}
+	left = std::max(left - Padding(), 0);
+	right = std::min(right + Padding(), _width);
+	const auto need = std::min(badge + 2 * Padding(), _width);
+	if (right - left < need) {
+		const auto add = need - (right - left);
+		left = std::max(left - add / 2, 0);
+		right = std::min(left + need, _width);
+		left = right - need;
+	}
+	_cropLeft = left;
+	_cropWidth = std::max(right - left, 1);
+}
+
+void ShotRenderer::scanBounds(int &left, int &right) {
+	if (_width <= 0 || _height <= 0) {
+		return;
+	}
+	auto image = QImage(
+		QSize(_width, kScanStrip),
+		QImage::Format_ARGB32_Premultiplied);
+	for (auto y = 0; y < _height; y += kScanStrip) {
+		image.fill(Qt::transparent);
+		{
+			auto p = Painter(&image);
+			p.translate(0, -y);
+			paintContent(p, QRect(0, y, _width, kScanStrip));
+		}
+		const auto rows = std::min(kScanStrip, _height - y);
+		for (auto row = 0; row != rows; ++row) {
+			const auto line = reinterpret_cast<const QRgb*>(
+				image.constScanLine(row));
+			for (auto x = 0; x < left; ++x) {
+				if (qAlpha(line[x]) > kScanAlpha) {
+					left = x;
+					break;
+				}
+			}
+			for (auto x = _width; x > right; --x) {
+				if (qAlpha(line[x - 1]) > kScanAlpha) {
+					right = x;
+					break;
+				}
+			}
+		}
+	}
+}
+
+void ShotRenderer::paint(Painter &p, QRect clip, int ratio) {
+	clip = clip.intersected(QRect(QPoint(), size()));
+	if (clip.isEmpty() || _views.empty()) {
+		return;
+	}
+	const auto st = _controller->chatStyle();
+	if (_options.background) {
+		paintBackground(p, clip, ratio);
+	} else if (!_options.transparent) {
+		p.fillRect(clip, st->windowBg()->c);
+	}
+	p.translate(-_cropLeft, 0);
+	paintContent(p, clip.translated(_cropLeft, 0));
+	p.translate(_cropLeft, 0);
+	paintDates(p, clip);
+}
+
+QImage ShotRenderer::render() {
+	const auto ratio = ExportRatio();
+	const auto full = size();
+	auto result = QImage(full * ratio, QImage::Format_ARGB32_Premultiplied);
+	result.setDevicePixelRatio(ratio);
+	result.fill(Qt::transparent);
+	{
+		auto p = Painter(&result);
+		paint(p, QRect(QPoint(), full), ratio);
+	}
+	result.setDevicePixelRatio(1.);
+	return result;
+}
+
+void ShotRenderer::paintContent(Painter &p, QRect clip) {
+	const auto st = _controller->chatStyle();
+	const auto theme = _controller->currentChatTheme();
+	const auto viewport = std::max(_height, _liveHeight);
+	auto context = Ui::ChatPaintContext{
+		.st = st,
+		.bubblesPattern = theme->bubblesBackgroundPattern(),
+		.viewport = QRect(0, _height - viewport, _width, viewport),
+		.area = QRect(0, 0, _width, _height),
+		.clip = clip,
+		.now = crl::now(),
+	};
+	const auto till = clip.y() + clip.height();
+	for (auto i = 0; i != _shown; ++i) {
+		const auto view = _views[i].get();
+		const auto top = _tops[i];
+		const auto height = view->height();
+		if (top >= till) {
+			break;
+		} else if (top + height <= clip.y() || view->isHidden()) {
+			continue;
+		}
+		context.outbg = view->hasOutLayout();
+		p.translate(0, top);
+		view->draw(p, context.translated(0, -top));
+		p.translate(0, -top);
+	}
+	for (auto i = 0; i != _shown; ++i) {
+		const auto view = _views[i].get();
+		if (view->isHidden() || !view->displayFromPhoto()) {
+			continue;
+		}
+		const auto top = _tops[i]
+			+ view->height()
+			- view->marginBottom()
+			- st::msgPhotoSize;
+		if (top < till && top + st::msgPhotoSize > clip.y()) {
+			paintUserpic(p, view, top);
+		}
+	}
+}
+
+void ShotRenderer::paintUserpic(
+		Painter &p,
+		not_null<Element*> view,
+		int top) {
+	const auto item = view->data();
+	if (const auto from = view->displayFrom()) {
+		from->paintUserpicLeft(
+			p,
+			_userpics[from],
+			st::historyPhotoLeft,
+			top,
+			_width,
+			st::msgPhotoSize);
+	} else if (const auto info = item->displayHiddenSenderInfo()) {
+		if (info->customUserpic.empty()) {
+			info->emptyUserpic.paintCircle(
+				p,
+				st::historyPhotoLeft,
+				top,
+				_width,
+				st::msgPhotoSize);
+		} else {
+			const auto valid = info->paintCustomUserpic(
+				p,
+				_hiddenUserpics[item->fullId()],
+				st::historyPhotoLeft,
+				top,
+				_width,
+				st::msgPhotoSize);
+			if (!valid) {
+				info->customUserpic.load(
+					&item->history()->session(),
+					item->fullId());
+			}
+		}
+	}
+}
+
+void ShotRenderer::paintDates(Painter &p, QRect clip) {
+	const auto st = _controller->chatStyle();
+	const auto till = clip.y() + clip.height();
+	for (auto i = 0; i != _shown; ++i) {
+		const auto view = _views[i].get();
+		const auto top = _tops[i];
+		if (top >= till) {
+			break;
+		} else if (const auto date = view->Get<HistoryView::DateBadge>()) {
+			if (top + date->height() > clip.y()) {
+				date->paint(p, st, top, _cropWidth, false);
+			}
+		}
+	}
+}
+
+void ShotRenderer::paintBackground(Painter &p, QRect clip, int ratio) {
+	const auto theme = _controller->currentChatTheme();
+	if (const auto color = theme->background().colorForFill) {
+		p.fillRect(clip, *color);
+		return;
+	}
+	const auto chunk = std::max(
+		std::min(_height, std::max(_liveHeight, _cropWidth)),
+		1);
+	validateBackground(theme, QSize(_cropWidth, chunk), ratio);
+	if (!_background || _background->image.isNull()) {
+		p.fillRect(clip, _controller->chatStyle()->windowBg()->c);
+		return;
+	}
+	const auto &image = _background->image;
+	auto hq = PainterHighQualityEnabler(p);
+	for (auto y = 0, index = 0; y < _height; y += chunk, ++index) {
+		const auto rect = QRect(0, y, _cropWidth, chunk);
+		const auto fill = rect.intersected(clip);
+		if (fill.isEmpty()) {
+			continue;
+		}
+		p.save();
+		p.setClipRect(fill, Qt::IntersectClip);
+		if (index % 2) {
+			p.translate(0, y + chunk);
+			p.scale(1., -1.);
+			p.drawImage(QRect(0, 0, _cropWidth, chunk), image);
+		} else {
+			p.drawImage(rect, image);
+		}
+		p.restore();
+	}
+}
+
+void ShotRenderer::validateBackground(
+		not_null<Ui::ChatTheme*> theme,
+		QSize size,
+		int ratio) {
+	const auto &background = theme->background();
+	const auto prepared = background.prepared.cacheKey();
+	const auto gradient = background.gradientForFill.cacheKey();
+	if (_background
+		&& _background->theme == theme
+		&& _background->key == background.key
+		&& _background->prepared == prepared
+		&& _background->gradient == gradient
+		&& _background->size == size
+		&& _background->ratio == ratio) {
+		return;
+	}
+	const auto styleRatio = style::DevicePixelRatio();
+	const auto area = QSize(
+		(size.width() * ratio + styleRatio - 1) / styleRatio,
+		(size.height() * ratio + styleRatio - 1) / styleRatio);
+	auto image = QImage(size * ratio, QImage::Format_ARGB32_Premultiplied);
+	image.fill(_controller->chatStyle()->windowBg()->c);
+	if (const auto request = theme->cacheBackgroundRequest(area)) {
+		auto cached = Ui::CacheBackground(request);
+		cached.image.setDevicePixelRatio(1.);
+		auto q = QPainter(&image);
+		q.drawImage(
+			cached.x * styleRatio,
+			cached.y * styleRatio,
+			cached.image);
+	}
+	image.setDevicePixelRatio(ratio);
+	_background = Background{
+		.theme = theme,
+		.key = background.key,
+		.prepared = prepared,
+		.gradient = gradient,
+		.size = size,
+		.ratio = ratio,
+		.image = std::move(image),
+	};
+}
+
+void PaintChecker(QPainter &p, QRect rect) {
+	static const auto brush = [] {
+		const auto cell = style::ConvertScale(8);
+		auto image = QImage(
+			QSize(cell, cell) * 2,
+			QImage::Format_ARGB32_Premultiplied);
+		image.fill(QColor(255, 255, 255));
+		auto q = QPainter(&image);
+		q.fillRect(0, 0, cell, cell, QColor(204, 204, 204));
+		q.fillRect(cell, cell, cell, cell, QColor(204, 204, 204));
+		q.end();
+		return QBrush(image);
+	}();
+	p.fillRect(rect, brush);
+}
+
+void CopyShot(
+		not_null<ShotRenderer*> shot,
+		std::shared_ptr<Main::SessionShow> show) {
+	auto image = shot->render();
+	if (image.isNull()) {
+		return;
+	}
+	auto mime = std::make_unique<QMimeData>();
+	mime->setData(u"image/png"_q, PngBytes(image));
+	mime->setImageData(std::move(image));
+	QGuiApplication::clipboard()->setMimeData(mime.release());
+	show->showToast({
+		.text = { Lower(u"Shot copied to clipboard."_q) },
+		.iconLottie = u"toast/copy"_q,
+		.iconLottieSize = st::toastLottieIconSize,
+	});
+}
+
+void SaveShot(
+		not_null<Ui::GenericBox*> box,
+		not_null<ShotRenderer*> shot,
+		std::shared_ptr<Main::SessionShow> show) {
+	FileDialog::GetWritePath(
+		Core::App().getFileDialogParent(),
+		Lower(u"Save shot"_q),
+		u"PNG Image (*.png);;"_q + FileDialog::AllFilesFilter(),
+		filedialogDefaultName(u"shot"_q, u".png"_q),
+		crl::guard(box, [=](const QString &path) {
+			if (path.isEmpty()) {
+				return;
+			}
+			const auto image = shot->render();
+			if (image.isNull() || !image.save(path, "PNG")) {
+				show->showToast(Lower(u"Couldn't save the shot."_q));
+			}
+		}));
+}
+
+void SendConfirmed(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread,
+		FullMsgId replyTo,
+		std::shared_ptr<Ui::PreparedBundle> bundle,
+		Api::SendOptions options) {
+	if (!bundle) {
+		return;
+	}
+	const auto payment = std::make_shared<SendPaymentHelper>();
+	const auto weak = base::make_weak(thread);
+	const auto withPaymentApproved = crl::guard(controller, [=](
+			int approved) {
+		payment->clear();
+		if (const auto strong = weak.get()) {
+			auto copy = options;
+			copy.starsApproved = approved;
+			SendConfirmed(controller, strong, replyTo, bundle, copy);
+		}
+	});
+	const auto checked = payment->check(
+		controller,
+		thread->peer(),
+		options,
+		bundle->totalCount,
+		withPaymentApproved);
+	if (!checked) {
+		return;
+	}
+	const auto type = bundle->way.sendImagesAsPhotos()
+		? SendMediaType::Photo
+		: SendMediaType::File;
+	auto action = Api::SendAction(thread, options);
+	action.clearDraft = false;
+	action.replyTo = FullReplyTo{
+		.messageId = replyTo,
+		.topicRootId = thread->topicRootId(),
+		.monoforumPeerId = thread->monoforumPeerId(),
+	};
+	auto &api = controller->session().api();
+	for (auto &group : bundle->groups) {
+		const auto album = (group.type != Ui::AlbumType::None)
+			? std::make_shared<SendingAlbum>()
+			: nullptr;
+		api.sendFiles(std::move(group.list), type, album, action);
+	}
+}
+
+void SendShot(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread,
+		QImage &&image,
+		bool asFile,
+		Fn<void()> sent) {
+	auto content = PngBytes(image);
+	auto list = Storage::PrepareMediaFromImage(
+		std::move(image),
+		std::move(content),
+		st::sendMediaPreviewSize);
+	if (asFile) {
+		list.overrideSendImagesAsPhotos = false;
+	}
+	const auto weak = base::make_weak(thread);
+	const auto peer = thread->peer();
+	const auto show = controller->uiShow();
+	show->show(Box<SendFilesBox>(SendFilesBoxDescriptor{
+		.show = show,
+		.list = std::move(list),
+		.caption = TextWithTags(),
+		.toPeer = peer,
+		.limits = DefaultLimitsForPeer(peer),
+		.check = DefaultCheckForPeer(show, peer),
+		.sendType = Api::SendType::Normal,
+		.confirmed = crl::guard(controller, [=](
+				std::shared_ptr<Ui::PreparedBundle> bundle,
+				Api::SendOptions options,
+				FullReplyTo currentReplyTo) {
+			if (const auto strong = weak.get()) {
+				SendConfirmed(
+					controller,
+					strong,
+					currentReplyTo.messageId,
+					std::move(bundle),
+					options);
+				sent();
+			}
+		}),
+		.replyTo = FullReplyTo{
+			.topicRootId = thread->topicRootId(),
+			.monoforumPeerId = thread->monoforumPeerId(),
+		},
+	}));
+}
+
+void ShotBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		std::vector<not_null<HistoryItem*>> items,
+		Context context,
+		int chatWidth) {
+	const auto shot = box->lifetime().make_state<ShotRenderer>(
+		controller,
+		std::move(items),
+		context,
+		chatWidth);
+	const auto show = controller->uiShow();
+	const auto padding = st::boxRowPadding.left();
+
+	box->setTitle(rpl::single(Lower(u"Shot"_q)));
+	box->setWidth(std::clamp(
+		shot->size().width() + 2 * padding,
+		st::boxWideWidth,
+		std::max(st::boxWideWidth, controller->content()->width() * 9 / 10)));
+	box->addTopButton(st::boxTitleClose, [=] { box->closeBox(); });
+
+	shot->removals() | rpl::on_next([=] {
+		box->closeBox();
+	}, box->lifetime());
+
+	const auto preview = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		style::margins());
+	const auto scale = [=] {
+		const auto size = shot->size();
+		const auto available = preview->width() - 2 * padding;
+		return (size.width() > available && available > 0)
+			? (available / float64(size.width()))
+			: 1.;
+	};
+	rpl::combine(
+		preview->widthValue(),
+		shot->layoutVersionValue()
+	) | rpl::on_next([=](int width, int) {
+		const auto height = int(std::ceil(shot->size().height() * scale()));
+		preview->resize(width, height);
+		preview->update();
+	}, preview->lifetime());
+	shot->repaints() | rpl::on_next([=] {
+		preview->update();
+	}, preview->lifetime());
+	preview->paintRequest() | rpl::on_next([=](QRect clip) {
+		const auto size = shot->size();
+		if (size.isEmpty()) {
+			return;
+		}
+		const auto k = scale();
+		const auto left = (k < 1.)
+			? ((preview->width() - size.width() * k) / 2.)
+			: float64((preview->width() - size.width()) / 2);
+		const auto mapped = QRectF(clip).translated(-left, 0.);
+		const auto inner = QRectF(
+			mapped.x() / k,
+			mapped.y() / k,
+			mapped.width() / k,
+			mapped.height() / k
+		).toAlignedRect().intersected(QRect(QPoint(), size));
+		if (inner.isEmpty()) {
+			return;
+		}
+		auto p = Painter(preview);
+		p.translate(left, 0.);
+		if (k < 1.) {
+			p.scale(k, k);
+			p.setRenderHint(QPainter::SmoothPixmapTransform);
+		}
+		p.setClipRect(inner);
+		const auto &options = shot->options();
+		if (!options.background && options.transparent) {
+			PaintChecker(p, inner);
+		}
+		shot->paint(p, inner, style::DevicePixelRatio());
+	}, preview->lifetime());
+
+	const auto bottom = box->setPinnedToBottomContent(
+		object_ptr<Ui::VerticalLayout>(box));
+	const auto note = bottom->add(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			bottom,
+			object_ptr<Ui::FlatLabel>(
+				bottom,
+				shot->layoutVersionValue() | rpl::map([=](int) {
+					return Lower(u"Too tall for one picture: only the "
+						"first %1 of %2 messages fit."_q).arg(
+							shot->shownCount()).arg(shot->totalCount());
+				}),
+				st::boxDividerLabel),
+			st::boxRowPadding));
+	note->toggleOn(shot->layoutVersionValue() | rpl::map([=](int) {
+		return shot->shownCount() < shot->totalCount();
+	}));
+	note->finishAnimating();
+	Ui::AddSkip(bottom);
+
+	const auto addToggle = [&](const QString &text, bool value) {
+		auto result = object_ptr<Ui::SettingsButton>(
+			bottom,
+			rpl::single(Lower(text)),
+			st::settingsButtonNoIcon);
+		result->toggleOn(rpl::single(value));
+		return result;
+	};
+	const auto background = bottom->add(
+		addToggle(u"Show background"_q, shot->options().background));
+	const auto dates = bottom->add(
+		addToggle(u"Show dates"_q, shot->options().dates));
+	const auto transparentWrap = bottom->add(
+		object_ptr<Ui::SlideWrap<Ui::SettingsButton>>(
+			bottom,
+			addToggle(u"Transparent"_q, shot->options().transparent)));
+	const auto transparent = transparentWrap->entity();
+	transparentWrap->toggleOn(background->toggledValue(
+	) | rpl::map([](bool shown) {
+		return !shown;
+	}));
+	transparentWrap->finishAnimating();
+	Ui::AddSkip(bottom);
+
+	background->toggledChanges() | rpl::on_next([=](bool value) {
+		auto options = shot->options();
+		options.background = value;
+		shot->setOptions(options);
+	}, background->lifetime());
+	dates->toggledChanges() | rpl::on_next([=](bool value) {
+		auto options = shot->options();
+		options.dates = value;
+		shot->setOptions(options);
+	}, dates->lifetime());
+	transparent->toggledChanges() | rpl::on_next([=](bool value) {
+		auto options = shot->options();
+		options.transparent = value;
+		shot->setOptions(options);
+	}, transparent->lifetime());
+
+	box->addButton(rpl::single(Lower(u"Copy"_q)), [=] {
+		CopyShot(shot, show);
+	});
+	box->addButton(rpl::single(Lower(u"Save"_q)), [=] {
+		SaveShot(box, shot, show);
+	});
+	const auto first = shot->firstItem();
+	const auto target = first ? SendThread(controller, first) : nullptr;
+	if (target && CanSendShot(target)) {
+		box->addLeftButton(rpl::single(Lower(u"Send"_q)), [=] {
+			const auto item = shot->firstItem();
+			if (!item) {
+				return;
+			}
+			const auto thread = SendThread(controller, item);
+			auto image = shot->render();
+			if (image.isNull()) {
+				return;
+			}
+			const auto &options = shot->options();
+			const auto asFile = (!options.background && options.transparent)
+				|| !FitsPhoto(image.size());
+			SendShot(
+				controller,
+				thread,
+				std::move(image),
+				asFile,
+				crl::guard(box, [=] { box->closeBox(); }));
+		});
+	}
+}
+
+void InsertShotAction(
+		not_null<Ui::PopupMenu*> menu,
+		Fn<void()> callback) {
+	const auto text = Lower(u"Shot"_q);
+	const auto icon = &st::menuIconPhoto;
+	const auto select = tr::lng_context_select_msg(tr::now);
+	const auto clear = tr::lng_context_clear_selection(tr::now);
+	const auto &actions = menu->actions();
+	auto position = -1;
+	for (auto i = int(actions.size()); i != 0;) {
+		const auto label = actions[--i]->text();
+		if (label == select || label == clear) {
+			position = i + 1;
+			break;
+		}
+	}
+	if (position < 0) {
+		menu->addAction(text, std::move(callback), icon);
+		return;
+	}
+	const auto raw = menu->menu();
+	menu->insertAction(position, base::make_unique_q<Ui::Menu::Action>(
+		raw,
+		menu->st().menu,
+		Ui::Menu::CreateAction(raw, text, std::move(callback)),
+		icon,
+		icon));
+}
+
+void AddShot(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionController*> controller,
+		std::vector<FullMsgId> ids,
+		Context context,
+		int chatWidth) {
+	const auto session = &controller->session();
+	const auto items = CollectItems(session, ids);
+	if (items.empty() || ranges::any_of(items, Restricted)) {
+		return;
+	}
+	InsertShotAction(menu, [=] {
+		auto items = CollectItems(session, ids);
+		if (!items.empty()) {
+			controller->show(Box(
+				ShotBox,
+				controller,
+				std::move(items),
+				context,
+				chatWidth));
+		}
+	});
+}
+
+} // namespace
+
+bool ShotHidesBottomInfo(not_null<const HistoryView::Element*> view) {
+	const auto &hiding = Hiding();
+	return !hiding.empty() && hiding.contains(view->delegate().get());
+}
+
+void AddShotAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionController*> controller,
+		std::vector<FullMsgId> selected,
+		HistoryItem *item,
+		int chatWidth) {
+	if (!ShotInMenu() || menu->empty()) {
+		return;
+	}
+	if (selected.empty() && item) {
+		selected.push_back(item->fullId());
+	}
+	if (!selected.empty()) {
+		AddShot(
+			menu,
+			controller,
+			std::move(selected),
+			Context::History,
+			chatWidth);
+	}
+}
+
+void AddShotAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<HistoryView::ListWidget*> list,
+		const HistoryView::ContextMenuRequest &request) {
+	if (!ShotInMenu() || menu->empty()) {
+		return;
+	}
+	auto ids = std::vector<FullMsgId>();
+	if (request.overSelection && !request.selectedItems.empty()) {
+		ids = list->getSelectedIds();
+	} else if (request.item) {
+		ids.push_back(request.item->fullId());
+	}
+	if (!ids.empty()) {
+		AddShot(
+			menu,
+			list->controller(),
+			std::move(ids),
+			list->delegate()->listContext(),
+			list->width());
+	}
+}
+
+} // namespace Tele
