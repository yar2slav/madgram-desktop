+[[nodiscard]] bool Restricted(not_null<HistoryItem*> item) {
+	return !item->history()->peer->allowsForwarding()
+		|| item->forbidsForward()
+		|| item->forbidsSaving();
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> CollectItems(
+		not_null<Main::Session*> session,
+		const std::vector<FullMsgId> &ids) {
+	auto &owner = session->data();
+	auto result = std::vector<not_null<HistoryItem*>>();
+	const auto add = [&](not_null<HistoryItem*> item) {
+		if (!ranges::contains(result, item)) {
+			result.push_back(item);
+		}
+	};
+	for (const auto &id : ids) {
+		const auto item = owner.message(id);
+		if (!item || !item->isHistoryEntry() || item->isSponsored()) {
+			continue;
+		} else if (const auto group = owner.groups().find(item)) {
+			for (const auto &part : group->items) {
+				add(part);
+			}
+		} else {
+			add(item);
+		}
+	}
+	ranges::sort(result, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return a->position() < b->position();
+	});
+	return result;
+}
+
+[[nodiscard]] QByteArray PngBytes(const QImage &image) {
+	auto result = QByteArray();
+	auto buffer = QBuffer(&result);
+	buffer.open(QIODevice::WriteOnly);
+	image.save(&buffer, "PNG");
+	return result;
+}
+
+[[nodiscard]] bool FitsPhoto(QSize size) {
+	const auto limit = PhotoSideLimit();
+	return (size.width() <= limit)
+		&& (size.height() <= limit)
+		&& Ui::ValidateThumbDimensions(size.width(), size.height());
+}
+
+[[nodiscard]] Data::Thread *SendThread(
+		not_null<Window::SessionController*> controller,
+		not_null<HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	if (const auto thread = controller->activeChatCurrent().thread()) {
+		if (thread->peer() == peer) {
+			return thread;
+		}
+	}
+	if (const auto topic = item->topic()) {
+		return topic;
+	} else if (const auto sublist = item->savedSublist()) {
+		return sublist;
+	}
+	return item->history();
+}
+
+[[nodiscard]] bool CanSendShot(not_null<Data::Thread*> thread) {
+	return !OfflineForLaunch()
+		&& Data::CanSendAnyOf(
+			thread,
+			ChatRestriction::SendPhotos | ChatRestriction::SendFiles);
+}
