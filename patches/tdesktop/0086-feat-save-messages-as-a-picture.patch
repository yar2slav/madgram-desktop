+	void paint(Painter &p, QRect clip, int ratio);
+	[[nodiscard]] QImage render();
+
+private:
+	struct Background {
+		not_null<Ui::ChatTheme*> theme;
+		QString key;
+		qint64 prepared = 0;
+		qint64 gradient = 0;
+		QSize size;
+		int ratio = 0;
+		QImage image;
+	};
+
+	void subscribe();
+	void schedule(bool full);
+	void clear();
+	void rebuild();
+	void relayout();
+	void refreshAttachments(int till);
+	void computeBounds();
+	void scanBounds(int &left, int &right);
+	void paintContent(Painter &p, QRect clip);
+	void paintUserpic(Painter &p, not_null<Element*> view, int top);
+	void paintDates(Painter &p, QRect clip);
+	void paintBackground(Painter &p, QRect clip, int ratio);
+	void validateBackground(
+		not_null<Ui::ChatTheme*> theme,
+		QSize size,
+		int ratio);
+
+	const not_null<Window::SessionController*> _controller;
+	std::vector<not_null<HistoryItem*>> _items;
+	const int _chatWidth = 0;
+	const int _liveHeight = 0;
+	const std::unique_ptr<ShotDelegate> _delegate;
+	std::vector<std::unique_ptr<Element>> _views;
+	base::flat_set<const Element*> _viewSet;
+	base::flat_set<not_null<Element*>> _dirty;
+	std::vector<int> _tops;
+	base::flat_map<not_null<PeerData*>, Ui::PeerUserpicView> _userpics;
+	base::flat_map<FullMsgId, Ui::PeerUserpicView> _hiddenUserpics;
+	std::optional<Background> _background;
+	ShotOptions _options;
+	int _width = 0;
+	int _height = 0;
+	int _shown = 0;
+	int _cropLeft = 0;
+	int _cropWidth = 0;
+	bool _scheduled = false;
+	bool _pendingRebuild = false;
+	bool _layingOut = false;
+	rpl::event_stream<> _repaints;
+	rpl::event_stream<> _removals;
+	rpl::variable<int> _layoutVersion = 0;
+	rpl::lifetime _lifetime;
+
+};
+
+ShotRenderer::ShotRenderer(
+	not_null<Window::SessionController*> controller,
+	std::vector<not_null<HistoryItem*>> items,
+	Context context,
+	int chatWidth)
+: _controller(controller)
+, _items(std::move(items))
+, _chatWidth(chatWidth)
+, _liveHeight(controller->content()->height())
+, _delegate(std::make_unique<ShotDelegate>(
+	controller->chatStyle(),
+	context,
+	[=] { _repaints.fire({}); })) {
+	_delegate->setHideBottomInfo(!_options.dates);
+	subscribe();
+	rebuild();
+}
+
+ShotRenderer::~ShotRenderer() {
+	clear();
+}
