+}
+
+void ShotRenderer::setOptions(ShotOptions options) {
+	const auto datesChanged = (_options.dates != options.dates);
+	_options = options;
+	if (datesChanged) {
+		_delegate->setHideBottomInfo(!_options.dates);
+		rebuild();
+	} else {
+		_repaints.fire({});
+	}
+}
