diff --git a/Telegram/SourceFiles/tele/tele_reminders.cpp b/Telegram/SourceFiles/tele/tele_reminders.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0b6857b0050efe1395b8b5de040de7606855599f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_reminders.cpp
@@ -0,0 +1,82 @@
+#include "tele/tele_reminders.h"
+
+#include "api/api_common.h"
+#include "apiwrap.h"
+#include "base/unixtime.h"
+#include "data/data_session.h"
+#include "data/data_types.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "main/session/session_show.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/choose_date_time.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kMinDelay = TimeId(60);
+constexpr auto kDefaultDelay = TimeId(3600);
+constexpr auto kMaxDelay = TimeId(365 * 24 * 3600 - 60);
+
+void Remind(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<HistoryItem*> item,
+		TimeId when) {
+	const auto session = &item->history()->session();
+	auto action = Api::SendAction(session->data().history(session->userPeerId()));
+	action.options.scheduled = when;
+	session->api().forwardMessages(
+		Data::ResolvedForwardDraft{ .items = { item } },
+		action,
+		[=] {
+			show->showToast(Tr(u"Reminder set for %1"_q).arg(
+				langDateTime(base::unixtime::parse(when))));
+		});
+}
+
+void ReminderBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show,
+		FullMsgId id) {
+	const auto session = &show->session();
+	Ui::ChooseDateTimeBox(box, {
+		.title = rpl::single(Tr(u"Remind me"_q)),
+		.submit = rpl::single(Tr(u"Remind"_q)),
+		.done = [=](TimeId when) {
+			if (const auto item = session->data().message(id)) {
+				Remind(show, item, when);
+			}
+			box->closeBox();
+		},
+		.min = [] { return base::unixtime::now() + kMinDelay; },
+		.time = base::unixtime::now() + kDefaultDelay,
+		.max = [] { return base::unixtime::now() + kMaxDelay; },
+		.description = rpl::single(Tr(u"The message comes back in Saved Messages at this time, with a notification on all your devices."_q)),
+	});
+}
+
+}
+
+void AddRemindAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<HistoryItem*> item) {
+	if (!MessageReminders()
+		|| item->isService()
+		|| !IsServerMsgId(item->id)
+		|| !item->allowsForward()) {
+		return;
+	}
+	const auto id = item->fullId();
+	menu->addAction(Tr(u"Remind me"_q), [=] {
+		show->showBox(Box(ReminderBox, show, id));
+	}, &st::menuIconSchedule);
+}
+
+}
