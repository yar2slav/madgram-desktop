@@ -223,6 +223,14 @@ void KeepOwnDeleted(std::vector<not_null<HistoryItem*>> &items) {
 	Keep(items, true);
 }
 
+void UnkeepDeleted(not_null<HistoryItem*> item) {
+	if (!IsKeptDeleted(item)) {
+		return;
+	}
+	Forget(&item->history()->session(), item);
+	item->history()->owner().requestItemViewRefresh(item);
+}
+
 bool IsKeptDeleted(not_null<const HistoryItem*> item) {
 	if (Get().sessions.empty()) {
 		return false;
