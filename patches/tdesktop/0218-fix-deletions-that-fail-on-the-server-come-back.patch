index 0000000000000000000000000000000000000000..b97d1627e50ea6dcfad70ca017725ee930c32943
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_delete_fail.cpp
@@ -0,0 +1,88 @@
+#include "tele/tele_delete_fail.h"
+
+#include "apiwrap.h"
+#include "data/data_changes.h"
+#include "data/data_groups.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "main/main_session.h"
+#include "tele/tele_deleted.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_notices.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+
+void ReinsertDeleted(not_null<HistoryItem*> item) {
+	const auto history = item->history();
+	if (item->mainView()
+		|| !item->isRegular()
+		|| !item->isHistoryEntry()
+		|| history->isEmpty()
+		|| history->isBuildingFrontBlock()) {
+		return;
+	}
+	HistoryView::Element *before = nullptr;
+	HistoryView::Element *after = nullptr;
+	for (const auto &block : history->blocks) {
+		for (const auto &view : block->messages) {
+			const auto data = view->data();
+			if (!data->isRegular()) {
+				continue;
+			} else if (data->id > item->id) {
+				before = view.get();
+				break;
+			}
+			after = view.get();
+		}
+		if (before) {
+			break;
+		}
+	}
+	if (before && (after || history->loadedAtTop())) {
+		history->addNewInTheMiddle(
+			item,
+			before->block()->indexInHistory(),
+			before->indexInBlock());
+	} else if (!before && after && history->loadedAtBottom()) {
+		history->addNewInTheMiddle(
+			item,
+			after->block()->indexInHistory(),
+			after->indexInBlock() + 1);
+	} else {
+		return;
+	}
+	history->owner().groups().refreshMessage(item, true);
+	history->owner().notifyHistoryChangeDelayed(history);
+	history->session().changes().messageUpdated(
+		item,
+		Data::MessageUpdate::Flag::NewMaybeAdded);
+}
+
+void DeleteFailed(
+		not_null<History*> history,
+		const QVector<MTPint> &ids,
+		const QString &error) {
+	const auto session = &history->session();
+	const auto peer = history->peer;
+	for (const auto &id : ids) {
+		const auto msgId = MsgId(id.v);
+		if (const auto item = session->data().message(peer->id, msgId)) {
+			UnkeepDeleted(item);
+		}
+		session->api().requestMessageData(peer, msgId, [=] {
+			if (const auto item = session->data().message(peer->id, msgId)) {
+				ReinsertDeleted(item);
+			}
+		});
+	}
+	if (const auto window = session->tryResolveWindow(peer)) {
+		ShowTeleToast(
+			window,
+			Lower(u"Couldn't delete messages: "_q) + error);
+	}
+}
+
+} // namespace Tele
