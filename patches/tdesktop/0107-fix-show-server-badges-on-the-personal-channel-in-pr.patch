diff --git a/Telegram/SourceFiles/tele/tele_name_badges.cpp b/Telegram/SourceFiles/tele/tele_name_badges.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..aaa9860c541f3aab02517c6c3e65f85fa69f7a7e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_name_badges.cpp
@@ -0,0 +1,231 @@
+#include "tele/tele_name_badges.h"
+
+#include "data/data_channel.h"
+#include "data/data_peer.h"
+#include "info/profile/info_profile_badge.h"
+#include "info/profile/info_profile_values.h"
+#include "main/main_session.h"
+#include "ui/text/text.h"
+#include "ui/text/text_options.h"
+#include "ui/widgets/labels.h"
+#include "window/window_session_controller.h"
+#include "styles/style_basic.h"
+#include "styles/style_settings.h"
+
+namespace Tele {
+namespace {
+
+using Info::Profile::Badge;
+using Info::Profile::BadgeType;
+
+[[nodiscard]] int BadgeWidth(const Badge &badge) {
+	const auto widget = badge.widget();
+	return widget ? widget->width() : 0;
+}
+
+class NameBadges final {
+public:
+	NameBadges(
+		not_null<QWidget*> parent,
+		not_null<PeerData*> peer,
+		Fn<bool()> paused);
+
+	[[nodiscard]] rpl::producer<> updated() const;
+	[[nodiscard]] int leftSkip() const;
+	[[nodiscard]] int rightWidth() const;
+	void moveLeft(int nameLeft, int top, int bottom);
+	void moveRight(int nameRight, int top, int bottom);
+
+private:
+	Badge _botVerify;
+	Badge _badge;
+	Badge _verified;
+
+};
+
+NameBadges::NameBadges(
+	not_null<QWidget*> parent,
+	not_null<PeerData*> peer,
+	Fn<bool()> paused)
+: _botVerify(
+	parent,
+	st::settingsInfoPeerBadge,
+	&peer->session(),
+	Info::Profile::BotVerifyBadgeForPeer(peer),
+	nullptr,
+	paused,
+	0,
+	BadgeType::BotVerified)
+, _badge(
+	parent,
+	st::settingsInfoPeerBadge,
+	&peer->session(),
+	Info::Profile::BadgeContentForPeer(peer),
+	nullptr,
+	paused)
+, _verified(
+	parent,
+	st::settingsInfoPeerBadge,
+	&peer->session(),
+	Info::Profile::VerifiedContentForPeer(peer),
+	nullptr,
+	paused,
+	0,
+	BadgeType::Verified) {
+}
+
+rpl::producer<> NameBadges::updated() const {
+	return rpl::merge(
+		_botVerify.updated(),
+		_badge.updated(),
+		_verified.updated());
+}
+
+int NameBadges::leftSkip() const {
+	const auto width = BadgeWidth(_botVerify);
+	return width ? (width + st::semiboldFont->spacew) : 0;
+}
+
+int NameBadges::rightWidth() const {
+	const auto width = BadgeWidth(_badge) + BadgeWidth(_verified);
+	return width ? (width + st::semiboldFont->spacew) : 0;
+}
+
+void NameBadges::moveLeft(int nameLeft, int top, int bottom) {
+	_botVerify.move(nameLeft - leftSkip(), top, bottom);
+}
+
+void NameBadges::moveRight(int nameRight, int top, int bottom) {
+	const auto left = nameRight + st::semiboldFont->spacew;
+	_badge.move(left, top, bottom);
+	_verified.move(left + BadgeWidth(_badge), top, bottom);
+}
+
+[[nodiscard]] Fn<bool()> Paused(not_null<Window::SessionController*> window) {
+	return [=] {
+		return window->isGifPausedAtLeastFor(Window::GifPauseReason::Layer);
+	};
+}
+
+struct NameState {
+	NameState(
+		not_null<QWidget*> parent,
+		not_null<PeerData*> peer,
+		Fn<bool()> paused)
+	: badges(parent, peer, std::move(paused)) {
+	}
+
+	NameBadges badges;
+	int left = 0;
+	int top = 0;
+	int available = -1;
+};
+
+struct LabelState {
+	std::unique_ptr<NameBadges> badges;
+	Ui::Text::String measure;
+	rpl::lifetime lifetime;
+};
+
+} // namespace
+
+Fn<void(int left, int top, int available)> SetupNameBadges(
+		not_null<Ui::RpWidget*> name,
+		not_null<PeerData*> peer,
+		not_null<Window::SessionController*> window) {
+	const auto state = name->lifetime().make_state<NameState>(
+		name->parentWidget(),
+		peer,
+		Paused(window));
+	const auto place = [=] {
+		if (state->available < 0) {
+			return;
+		}
+		const auto skip = state->badges.leftSkip();
+		name->resizeToNaturalWidth(std::max(
+			state->available - skip - state->badges.rightWidth(),
+			0));
+		const auto left = state->left + skip;
+		const auto top = state->top;
+		name->moveToLeft(left, top);
+		const auto bottom = top + name->heightNoMargins();
+		state->badges.moveLeft(left, top, bottom);
+		state->badges.moveRight(left + name->widthNoMargins(), top, bottom);
+	};
+	rpl::merge(
+		state->badges.updated(),
+		name->naturalWidthValue() | rpl::to_empty
+	) | rpl::on_next(place, name->lifetime());
+	return [=](int left, int top, int available) {
+		state->left = left;
+		state->top = top;
+		state->available = available;
+		place();
+	};
+}
+
+void SetupLabelBadges(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Ui::FlatLabel*> label,
+		rpl::producer<ChannelData*> channel,
+		not_null<Window::SessionController*> window) {
+	const auto state = label->lifetime().make_state<LabelState>();
+	const auto paused = Paused(window);
+	const auto place = [=] {
+		const auto badges = state->badges.get();
+		const auto right = badges ? badges->rightWidth() : 0;
+		const auto &style = label->st().style;
+		const auto lineHeight = std::max(style.lineHeight, style.font->height);
+		label->setSkipBlock(right, right ? lineHeight : 0);
+		if (!badges) {
+			return;
+		}
+		if (right) {
+			state->measure.updateSkipBlock(right, lineHeight);
+		} else {
+			state->measure.removeSkipBlock();
+		}
+		const auto width = label->widthNoMargins();
+		if (width <= 0) {
+			return;
+		}
+		const auto lines = state->measure.countLineWidths(width);
+		const auto margins = label->getMargins();
+		const auto origin = label->mapTo(
+			parent.get(),
+			QPoint(margins.left(), margins.top()));
+		badges->moveLeft(origin.x(), origin.y(), origin.y() + lineHeight);
+		const auto last = lines.empty() ? right : lines.back();
+		const auto top = origin.y()
+			+ std::max(int(lines.size()) - 1, 0) * lineHeight;
+		badges->moveRight(origin.x() + last - right, top, top + lineHeight);
+	};
+	std::move(
+		channel
+	) | rpl::on_next([=](ChannelData *channel) {
+		state->lifetime.destroy();
+		state->badges = nullptr;
+		if (channel) {
+			state->badges = std::make_unique<NameBadges>(
+				parent,
+				channel,
+				paused);
+			Info::Profile::NameValue(
+				channel
+			) | rpl::on_next([=](const QString &name) {
+				state->measure.setText(
+					label->st().style,
+					name,
+					Ui::NameTextOptions());
+				place();
+			}, state->lifetime);
+			state->badges->updated(
+			) | rpl::on_next(place, state->lifetime);
+		}
+		place();
+	}, label->lifetime());
+	label->geometryValue(
+	) | rpl::on_next(place, label->lifetime());
+}
+
+} // namespace Tele
