+void ServerBox(not_null<Ui::GenericBox*> box) {
+	box->setTitle(rpl::single(u"tele server"_q));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(u"Server URL"_q),
+		::Tele::ServerUrl()));
+	const auto save = [=] {
+		const auto url = ::Tele::NormalizeServerUrl(field->getLastText());
+		if (!url) {
+			field->showError();
+			return;
+		}
+		::Tele::SetServerUrl(*url);
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(u"Reset"_q), [=] {
+		::Tele::SetServerUrl(base::options::lookup<QString>(
+			::Tele::kOptionServerUrl).defaultValue());
+		box->closeBox();
+	});
+}
+
+void AddServer(
+		not_null<Ui::VerticalLayout*> container,
+		not_null<Window::SessionController*> controller) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionServerUrl);
+	AddButtonWithLabel(
+		container,
+		rpl::single(u"Server"_q),
+		::Tele::ServerUrlValue() | rpl::map([](const QString &url) {
+			return url.isEmpty() ? u"off"_q : url;
+		}),
+		st::settingsButtonNoIcon
+	)->setClickedCallback([=] {
+		controller->show(Box(ServerBox));
+	});
+	container->add(object_ptr<Button>(
+		container,
+		rpl::single(u"Refresh now"_q),
+		st::settingsButtonNoIcon
+	))->setClickedCallback([=] {
+		::Tele::RefreshBadges(crl::guard(controller, [=](QString text) {
+			controller->showToast(text);
+		}));
+	});
+	container->add(
+		object_ptr<Ui::FlatLabel>(
+			container,
+			option.description(),
+			st::settingsExperimentalAbout),
+		st::settingsExperimentalAboutPadding);
+}
