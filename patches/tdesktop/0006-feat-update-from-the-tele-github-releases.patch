+}
+
+[[nodiscard]] QByteArray Sha256Hex(const QByteArray &data) {
+	return QCryptographicHash::hash(
+		data,
+		QCryptographicHash::Sha256).toHex();
+}
+
+[[nodiscard]] QByteArray FileSha256Hex(const QString &path) {
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return QByteArray();
+	}
+	auto hash = QCryptographicHash(QCryptographicHash::Sha256);
+	if (!hash.addData(&file)) {
+		return QByteArray();
+	}
+	return hash.result().toHex();
+}
+
+[[nodiscard]] QString InstallPath() {
+	return cExeDir() + cExeName();
+}
+
+[[nodiscard]] QString MainExePath() {
+#ifdef Q_OS_MAC
+	return InstallPath() + '/' + QString::fromLatin1(kExeInBundle);
+#else
+	return InstallPath();
+#endif
+}
+
+[[nodiscard]] QString FeedUrl() {
+	return QString::fromLatin1(kFeedUrlPrefix)
+		+ QString::fromLatin1(kPlatform)
+		+ u".json"_q;
+}
+
+[[nodiscard]] QString PartName(const Release &release) {
+	return QUrl(release.url).fileName() + u".part"_q;
+}
+
+void RemoveParts(const QString &keep) {
+	const auto mask = u"*-"_q + QString::fromLatin1(kPlatform) + u".zip.part"_q;
+	const auto dir = QDir(cExeDir());
+	for (const auto &name : dir.entryList({ mask }, QDir::Files)) {
+		if (name != keep) {
+			QFile::remove(dir.filePath(name));
+		}
+	}
+}
+
+[[nodiscard]] std::optional<qint64> ContentRangeStart(QNetworkReply *reply) {
+	const auto header = reply->rawHeader("Content-Range");
+	const auto prefix = QByteArray("bytes ");
+	const auto dash = header.indexOf('-');
+	if (!header.startsWith(prefix) || dash <= prefix.size()) {
+		return std::nullopt;
+	}
+	auto ok = false;
+	const auto result = header.mid(
+		prefix.size(),
+		dash - prefix.size()).trimmed().toLongLong(&ok);
+	return ok ? std::make_optional(result) : std::nullopt;
+}
+
+[[nodiscard]] std::optional<QString> DisabledReason() {
+	if (BuildNumber() <= 0) {
+		return QString();
+	} else if (!*kPlatform) {
+		return u"There are no tele builds for this platform."_q;
+	}
+#if !defined Q_OS_WIN && !defined Q_OS_MAC
+	if (KSandbox::isInside()) {
+		return u"Sandboxed installs don't update themselves."_q;
+	}
+#endif
+	return std::nullopt;
+}
+
+[[nodiscard]] bool CanWriteNextToInstall() {
+	const auto probe = InstallPath() + u".probe"_q;
+	auto file = QFile(probe);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	file.close();
+	return QFile::remove(probe);
+}
+
+#ifdef Q_OS_WIN
+[[nodiscard]] bool RenameWithRetries(const QString &from, const QString &to) {
+	for (auto attempt = 0; attempt != kRenameAttempts; ++attempt) {
+		if (QFile::rename(from, to)) {
+			return true;
+		}
+		QThread::msleep(kRenameRetryDelay);
+	}
+	return false;
+}
+#endif
+
+#ifdef Q_OS_MAC
+[[nodiscard]] QString ErrnoText() {
+	return QString::fromLocal8Bit(std::strerror(errno));
+}
+
+void RemoveQuarantine(const QString &root) {
+	const auto strip = [](const QString &path) {
+		removexattr(
+			QFile::encodeName(path).constData(),
+			"com.apple.quarantine",
+			XATTR_NOFOLLOW);
+	};
+	strip(root);
+	auto i = QDirIterator(
+		root,
+		QDir::AllEntries | QDir::Hidden | QDir::System | QDir::NoDotAndDotDot,
+		QDirIterator::Subdirectories);
+	while (i.hasNext()) {
+		strip(i.next());
+	}
+}
+
+[[nodiscard]] bool SafeRelativePath(const QString &path) {
+	if (path.contains('\\')) {
+		return false;
+	}
+	for (const auto &part : path.split('/')) {
+		if (part.isEmpty() || part == u"."_q || part == u".."_q) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString Unpack(const Release &release, const QByteArray &zip) {
+	const auto target = InstallPath() + u".new"_q;
+	base::Platform::DeleteDirectory(target);
+	const auto fail = [&](const QString &error) {
+		base::Platform::DeleteDirectory(target);
+		return error;
+	};
+	if (!QDir().mkpath(target)) {
+		return fail(u"can't create %1"_q.arg(target));
+	}
+	auto archive = zlib::FileToRead(zip);
+	auto global = unz_global_info();
+	if (archive.getGlobalInfo(&global) != UNZ_OK) {
+		return fail(u"can't read the archive"_q);
+	}
+	const auto prefix = QString::fromLatin1(kBundleInZip);
+	const auto exeInBundle = QString::fromLatin1(kExeInBundle);
+	auto sawExe = false;
+	for (auto i = uLong(0); i != global.number_entry; ++i) {
+		const auto moved = (i == 0)
+			? archive.goToFirstFile()
+			: archive.goToNextFile();
+		auto info = unz_file_info();
+		char name[1024] = { 0 };
+		if (moved != UNZ_OK
+			|| archive.getCurrentFileInfo(
+				&info,
+				name,
+				sizeof(name) - 1,
+				nullptr,
+				0,
+				nullptr,
+				0) != UNZ_OK
+			|| info.size_filename >= sizeof(name)) {
+			return fail(u"can't read the archive"_q);
+		}
+		const auto entry = QString::fromUtf8(name, int(info.size_filename));
+		if (!entry.startsWith(prefix)) {
+			return fail(u"unexpected %1 in the archive"_q.arg(entry));
+		}
+		auto relative = entry.mid(prefix.size());
+		const auto madeOnUnix = ((info.version >> 8) == 3);
+		const auto mode = madeOnUnix
+			? mode_t(info.external_fa >> 16)
+			: mode_t(0);
+		const auto directory = relative.isEmpty()
+			|| relative.endsWith('/')
+			|| S_ISDIR(mode);
+		if (relative.endsWith('/')) {
+			relative.chop(1);
+		}
+		if (!relative.isEmpty() && !SafeRelativePath(relative)) {
+			return fail(u"unsafe path %1 in the archive"_q.arg(entry));
+		}
+		const auto path = relative.isEmpty()
+			? target
+			: (target + '/' + relative);
+		const auto encoded = QFile::encodeName(path);
+		const auto permissions = mode & 0777;
+		if (directory) {
+			if (!QDir().mkpath(path)) {
+				return fail(u"can't create %1"_q.arg(path));
+			}
+			::chmod(encoded.constData(), permissions ? permissions : 0755);
+			continue;
+		}
+		QDir().mkpath(QFileInfo(path).path());
+		if (S_ISLNK(mode)) {
+			const auto link = archive.readCurrentFileContent(4096);
+			const auto resolved = QDir::cleanPath(
+				QFileInfo(path).path() + '/' + QString::fromUtf8(link));
+			if (archive.error() != UNZ_OK
+				|| link.isEmpty()
+				|| link.startsWith('/')
+				|| link.split('/').contains(QByteArray(".."))
+				|| !resolved.startsWith(target + '/')) {
+				return fail(u"unsafe link %1 in the archive"_q.arg(entry));
+			} else if (::symlink(link.constData(), encoded.constData())) {
+				return fail(u"can't create %1: %2"_q.arg(path, ErrnoText()));
+			}
+			continue;
+		}
+		const auto content = archive.readCurrentFileContent(kMaxExeSize);
+		if (archive.error() != UNZ_OK
+			|| (content.isEmpty() && info.uncompressed_size > 0)) {
+			return fail(u"can't unpack %1 from the archive"_q.arg(entry));
+		} else if (relative == exeInBundle) {
+			if (Sha256Hex(content) != release.exeSha256) {
+				return fail(u"unpacked app doesn't match the feed"_q);
+			}
+			sawExe = true;
+		}
+		auto file = QFile(path);
+		if (!file.open(QIODevice::WriteOnly)
+			|| file.write(content) != content.size()
+			|| !file.flush()) {
+			return fail(u"can't write %1"_q.arg(path));
+		}
+		base::Platform::FlushFileData(file);
+		file.close();
+		::chmod(encoded.constData(), permissions ? permissions : 0644);
+	}
+	if (!sawExe) {
+		return fail(u"the archive has no %1"_q.arg(prefix + exeInBundle));
+	}
+	RemoveQuarantine(target);
+	return QString();
+}
+#else
+[[nodiscard]] QString Unpack(const Release &release, const QByteArray &zip) {
+	auto archive = zlib::FileToRead(zip);
+	const auto exe = archive.readFileContent(kExeInZip, 0, kMaxExeSize);
+	if (exe.isEmpty() || archive.error() != UNZ_OK) {
+		return u"can't unpack %1 from the archive"_q.arg(kExeInZip);
+	} else if (Sha256Hex(exe) != release.exeSha256) {
+		return u"unpacked exe doesn't match the feed"_q;
+	}
+	const auto newPath = InstallPath() + u".new"_q;
+	QFile::remove(newPath);
+	auto file = QFile(newPath);
+	if (!file.open(QIODevice::WriteOnly)
+		|| file.write(exe) != exe.size()
+		|| !file.flush()) {
+		file.close();
+		QFile::remove(newPath);
+		return u"can't write %1"_q.arg(newPath);
+	}
+#ifndef Q_OS_WIN
+	file.setPermissions(QFile::permissions(InstallPath())
+		| QFileDevice::ReadOwner
+		| QFileDevice::WriteOwner
+		| QFileDevice::ExeOwner);
+	base::Platform::FlushFileData(file);
+#endif
+	return QString();
+}
+#endif
+
+class Updater final : public QObject, public base::has_weak_ptr {
+public:
+	Updater();
+
+	void check();
+
+	[[nodiscard]] UpdateStatus status() const;
+	[[nodiscard]] rpl::producer<UpdateStatus> statusValue() const;
+
+private:
+	using Done = Fn<void(QByteArray)>;
+
+	void scheduleCheck(crl::time delay);
+	void get(const QString &url, qint64 limit, Done done);
+	void verifyFeed(const QByteArray &envelope);
+	void download(const Release &release);
+	void unpack(const Release &release, const QString &path);
+	void install(const Release &release);
+	void fail(const QString &error, bool network = false);
+	void finish(UpdateStatus status, crl::time delay = kCheckInterval);
+
+	QNetworkAccessManager _manager;
+	base::Timer _timer;
+	bool _busy = false;
+	int _networkFailures = 0;
+	rpl::variable<UpdateStatus> _status;
+	rpl::lifetime _lifetime;
+
+};
+
+QPointer<Updater> Instance;
+
+Updater::Updater()
+: QObject(QCoreApplication::instance())
+, _timer([=] { check(); }) {
+	if (const auto reason = DisabledReason()) {
+		_status = UpdateStatus{
+			.state = UpdateState::Disabled,
+			.error = *reason,
+		};
+		return;
+	}
+	_status = UpdateStatus{ .state = UpdateState::Idle };
+#ifdef Q_OS_MAC
+	crl::async([path = InstallPath()] {
+		base::Platform::DeleteDirectory(path + u".old"_q);
+		base::Platform::DeleteDirectory(path + u".new"_q);
+	});
+#else
+	QFile::remove(InstallPath() + u".old"_q);
+	QFile::remove(InstallPath() + u".new"_q);
+#endif
+	AutoUpdateValue() | rpl::on_next([=](bool enabled) {
+		if (!enabled) {
+			_timer.cancel();
+		} else if (!_busy
+			&& _status.current().state != UpdateState::Ready) {
+			scheduleCheck(kFirstCheckDelay);
+		}
+	}, _lifetime);
+}
+
+void Updater::scheduleCheck(crl::time delay) {
+	if (AutoUpdate() && _status.current().state != UpdateState::Ready) {
+		_timer.callOnce(delay);
+	}
+}
+
+UpdateStatus Updater::status() const {
+	return _status.current();
+}
+
+rpl::producer<UpdateStatus> Updater::statusValue() const {
+	return _status.value();
+}
+
+void Updater::check() {
+	const auto state = _status.current().state;
+	if (state == UpdateState::Disabled
+		|| state == UpdateState::Ready
+		|| _busy) {
+		return;
+	}
+	_busy = true;
+	_timer.cancel();
+	_status = UpdateStatus{ .state = UpdateState::Checking };
+	get(FeedUrl(), kMaxFeedSize, [=](QByteArray envelope) {
+		verifyFeed(envelope);
+	});
+}
+
+void Updater::get(const QString &url, qint64 limit, Done done) {
+	auto request = QNetworkRequest(QUrl(url));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTransferTimeout));
+	const auto reply = _manager.get(request);
+	const auto tooLarge = std::make_shared<bool>(false);
+	connect(reply, &QNetworkReply::downloadProgress, this, [=](
+			qint64 ready,
+			qint64 total) {
+		if (ready > limit || total > limit) {
+			*tooLarge = true;
+			reply->abort();
+		}
+	});
+	connect(reply, &QNetworkReply::finished, this, [=] {
+		reply->deleteLater();
+		const auto code = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (*tooLarge) {
+			fail(u"response is too large"_q);
+		} else if (reply->error() != QNetworkReply::NoError) {
+			fail(u"network error: %1"_q.arg(reply->errorString()), true);
+		} else if (code != 200) {
+			fail(u"unexpected http status %1"_q.arg(code), true);
+		} else {
+			done(reply->readAll());
+		}
+	});
+}
+
+void Updater::verifyFeed(const QByteArray &envelope) {
+	const auto outer = QJsonDocument::fromJson(envelope).object();
+	const auto feed = QByteArray::fromBase64(
+		outer.value(u"feed"_q).toString().toLatin1());
+	const auto signature = QByteArray::fromBase64(
+		outer.value(u"signature"_q).toString().toLatin1());
+	auto error = QString();
+	const auto key = Core::Updates::ManifestKey{
+		.ed25519 = true,
+		.x = QByteArray::fromHex(kPublicKeyHex),
+	};
+	if (!Core::Updates::VerifySignature(key, feed, signature, &error)) {
+		fail(u"bad feed signature: %1"_q.arg(error));
+		return;
+	}
+	const auto object = QJsonDocument::fromJson(feed).object();
+	const auto base = object.value(u"base"_q).toVariant().toULongLong();
+	const auto counter = object.value(u"counter"_q).toVariant().toULongLong();
+	const auto release = Release{
+		.tag = object.value(u"tag"_q).toString(),
+		.url = object.value(u"url"_q).toString(),
+		.zipSha256 = object.value(u"zip_sha256"_q).toString().toLatin1(),
+		.exeSha256 = object.value(u"exe_sha256"_q).toString().toLatin1(),
+	};
+	if (!base
+		|| !counter
+		|| base > 0xFFFFFFFFULL
+		|| counter > 0xFFFFFFFFULL
+		|| release.tag.isEmpty()
+		|| !release.url.startsWith(QString::fromLatin1(kDownloadPrefix))
+		|| !release.url.endsWith(
+			u"-"_q + QString::fromLatin1(kPlatform) + u".zip"_q)
+		|| release.zipSha256.size() != 64
+		|| release.exeSha256.size() != 64) {
+		fail(u"malformed feed"_q);
+		return;
+	}
+	const auto version = Core::Updates::MakeUpdateVersion(
+		quint32(base),
+		quint32(counter));
+	if (version <= RunningVersion()) {
+		RemoveParts(QString());
+		finish({ .state = UpdateState::Latest });
+		return;
+	} else if (!CanWriteNextToInstall()) {
+		fail(u"can't write to the tele folder, "
+			"download %1 from GitHub by hand"_q.arg(release.tag));
+		return;
+	}
+	_status = UpdateStatus{
+		.state = UpdateState::Downloading,
+		.tag = release.tag,
+	};
+	crl::async([=, weak = base::make_weak(this), path = MainExePath()] {
+		const auto installed = (FileSha256Hex(path) == release.exeSha256);
+		crl::on_main(weak, [=] {
+			if (installed) {
+				finish({ .state = UpdateState::Ready, .tag = release.tag });
+			} else {
+				download(release);
+			}
+		});
+	});
+}
+
+void Updater::download(const Release &release) {
+	const auto name = PartName(release);
+	const auto path = cExeDir() + name;
+	RemoveParts(name);
+	struct Transfer {
+		QFile file;
+		qint64 offset = 0;
+		bool started = false;
+		bool network = false;
+		QString error;
+	};
+	const auto state = std::make_shared<Transfer>();
+	state->file.setFileName(path);
+	if (!state->file.open(QIODevice::ReadWrite)) {
+		fail(u"can't write %1"_q.arg(path));
+		return;
+	}
+	state->offset = state->file.size();
+	if (state->offset >= kMaxZipSize) {
+		state->file.resize(0);
+		state->offset = 0;
+	}
+	state->file.seek(state->offset);
+	auto request = QNetworkRequest(QUrl(release.url));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTransferTimeout));
+	if (state->offset > 0) {
+		request.setRawHeader(
+			"Range",
+			"bytes=" + QByteArray::number(state->offset) + '-');
+	}
+	const auto reply = _manager.get(request);
+	const auto stop = [=](const QString &error, bool network) {
+		if (state->error.isEmpty()) {
+			state->error = error;
+			state->network = network;
+		}
+		reply->abort();
+	};
+	const auto restart = [=] {
+		state->file.resize(0);
+		state->file.seek(0);
+		state->offset = 0;
+	};
+	const auto write = [=] {
+		if (!state->error.isEmpty()) {
+			reply->readAll();
+			return;
+		}
+		if (!state->started) {
+			const auto code = reply->attribute(
+				QNetworkRequest::HttpStatusCodeAttribute).toInt();
+			if (code == 200) {
+				restart();
+			} else if (code != 206) {
+				reply->readAll();
+				return;
+			} else if (ContentRangeStart(reply) != state->offset) {
+				restart();
+				stop(u"server resumed the download at a wrong offset"_q, true);
+				return;
+			}
+			state->started = true;
+		}
+		const auto data = reply->readAll();
+		if (state->file.pos() + data.size() > kMaxZipSize) {
+			restart();
+			stop(u"response is too large"_q, false);
+		} else if (state->file.write(data) != data.size()) {
+			stop(u"can't write %1"_q.arg(path), false);
+		}
+	};
+	connect(reply, &QNetworkReply::readyRead, this, write);
+	connect(reply, &QNetworkReply::downloadProgress, this, [=](
+			qint64 ready,
+			qint64 total) {
+		if (!state->started || !state->error.isEmpty()) {
+			return;
+		}
+		auto status = _status.current();
+		status.ready = state->offset + ready;
+		status.total = (total > 0) ? (state->offset + total) : 0;
+		_status = std::move(status);
+	});
+	connect(reply, &QNetworkReply::finished, this, [=] {
+		reply->deleteLater();
+		const auto code = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (reply->error() == QNetworkReply::NoError) {
+			write();
+		}
+		const auto flushed = state->file.flush();
+		state->file.close();
+		if (!state->error.isEmpty()) {
+			fail(state->error, state->network);
+		} else if (code == 416 && state->offset > 0) {
+			unpack(release, path);
+		} else if (reply->error() != QNetworkReply::NoError) {
+			fail(u"network error: %1"_q.arg(reply->errorString()), true);
+		} else if (code != 200 && code != 206) {
+			fail(u"unexpected http status %1"_q.arg(code), true);
+		} else if (!flushed) {
+			fail(u"can't write %1"_q.arg(path));
+		} else {
+			unpack(release, path);
+		}
+	});
+}
+
+void Updater::unpack(const Release &release, const QString &path) {
+	crl::async([=, weak = base::make_weak(this)] {
+		auto zip = QByteArray();
+		auto file = QFile(path);
+		if (file.open(QIODevice::ReadOnly)) {
+			zip = file.readAll();
+			file.close();
+		}
+		auto error = QString();
+		if (Sha256Hex(zip) != release.zipSha256) {
+			QFile::remove(path);
+			error = u"downloaded archive doesn't match the feed"_q;
+		} else {
+			error = Unpack(release, zip);
+			if (error.isEmpty()) {
+				QFile::remove(path);
+			}
+		}
+		crl::on_main(weak, [=] {
+			if (!error.isEmpty()) {
+				fail(error);
+			} else {
+				install(release);
+			}
+		});
+	});
+}
+
+void Updater::install(const Release &release) {
+	const auto path = InstallPath();
+	const auto newPath = path + u".new"_q;
+	const auto oldPath = path + u".old"_q;
+#if defined Q_OS_MAC
+	const auto from = QFile::encodeName(newPath);
+	const auto to = QFile::encodeName(path);
+	const auto old = QFile::encodeName(oldPath);
+	base::Platform::DeleteDirectory(oldPath);
+	if (!renamex_np(from.constData(), to.constData(), RENAME_SWAP)) {
+		::rename(from.constData(), old.constData());
+	} else if (::rename(to.constData(), old.constData())) {
+		const auto error = ErrnoText();
+		base::Platform::DeleteDirectory(newPath);
+		fail(u"can't move the running app aside: %1"_q.arg(error));
+		return;
+	} else if (::rename(from.constData(), to.constData())) {
+		const auto error = ErrnoText();
+		if (::rename(old.constData(), to.constData())) {
+			fail(u"%1 is missing, rename %2 back to it"_q.arg(path, oldPath));
+			return;
+		}
+		base::Platform::DeleteDirectory(newPath);
+		fail(u"can't put the new app in place: %1"_q.arg(error));
+		return;
+	}
+#elif defined Q_OS_WIN
+	QFile::remove(oldPath);
+	if (!RenameWithRetries(path, oldPath)) {
+		QFile::remove(newPath);
+		fail(u"can't move the running exe aside"_q);
+		return;
+	} else if (!RenameWithRetries(newPath, path)) {
+		if (!RenameWithRetries(oldPath, path)) {
+			fail(u"%1 is missing, rename %2 back to it"_q.arg(path, oldPath));
+			return;
+		}
+		QFile::remove(newPath);
+		fail(u"can't put the new exe in place"_q);
+		return;
+	}
+#else
+	if (!base::Platform::RenameWithOverwrite(newPath, path)) {
+		QFile::remove(newPath);
+		fail(u"can't put the new binary in place"_q);
+		return;
+	}
+#endif
+	finish({ .state = UpdateState::Ready, .tag = release.tag });
+}
+
+void Updater::fail(const QString &error, bool network) {
+	LOG(("Tele Updater Error: %1").arg(error));
+	auto delay = kCheckInterval;
+	if (!network) {
+		_networkFailures = 0;
+	} else if (_networkFailures < int(std::size(kRetryDelays))) {
+		delay = kRetryDelays[_networkFailures++];
+	}
+	finish({ .state = UpdateState::Failed, .error = error }, delay);
+}
+
+void Updater::finish(UpdateStatus status, crl::time delay) {
+	if (status.state != UpdateState::Failed) {
+		_networkFailures = 0;
+	}
+	_busy = false;
+	_status = std::move(status);
+	scheduleCheck(delay);
+}
+
+} // namespace
+
+void StartUpdater() {
+	if (!Instance) {
+		Instance = new Updater();
+	}
+}
+
+void CheckForUpdates() {
+	if (Instance) {
+		Instance->check();
+	}
+}
+
+void RestartToUpdate() {
+	if (UpdateReady()) {
+		cSetRestarting(true);
+		Core::Quit();
+	}
+}
+
+UpdateStatus CurrentUpdateStatus() {
+	return Instance
+		? Instance->status()
+		: UpdateStatus{ .state = UpdateState::Disabled };
+}
+
+rpl::producer<UpdateStatus> UpdateStatusValue() {
+	return Instance
+		? Instance->statusValue()
+		: rpl::single(UpdateStatus{ .state = UpdateState::Disabled });
+}
+
+bool UpdateReady() {
+	return CurrentUpdateStatus().state == UpdateState::Ready;
+}
+
+rpl::producer<bool> UpdateReadyValue() {
+	return UpdateStatusValue(
+	) | rpl::map([](const UpdateStatus &status) {
+		return status.state == UpdateState::Ready;
+	}) | rpl::distinct_until_changed();
+}
+
+} // namespace Tele
