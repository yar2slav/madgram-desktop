+#pragma once
+
+namespace Tele {
+
+enum class UpdateState {
+	Disabled,
+	Idle,
+	Checking,
+	Latest,
+	Downloading,
+	Ready,
+	Failed,
+};
+
+struct UpdateStatus {
+	UpdateState state = UpdateState::Idle;
+	QString tag;
+	int64 ready = 0;
+	int64 total = 0;
+	QString error;
+
+	friend inline bool operator==(
+		const UpdateStatus &,
+		const UpdateStatus &) = default;
+};
+
+void StartUpdater();
+void CheckForUpdates();
+void RestartToUpdate();
+
+[[nodiscard]] UpdateStatus CurrentUpdateStatus();
+[[nodiscard]] rpl::producer<UpdateStatus> UpdateStatusValue();
+[[nodiscard]] bool UpdateReady();
+[[nodiscard]] rpl::producer<bool> UpdateReadyValue();
+
