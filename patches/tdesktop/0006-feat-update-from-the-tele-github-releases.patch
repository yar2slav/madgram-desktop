+[[nodiscard]] QString UpdateStatusText(const ::Tele::UpdateStatus &status) {
+	using State = ::Tele::UpdateState;
+	switch (status.state) {
+	case State::Disabled:
+		return status.error.isEmpty()
+			? u"Local builds don't update themselves."_q
+			: status.error;
+	case State::Idle:
+		return u"Not checked yet."_q;
+	case State::Checking:
+		return u"Checking for updates..."_q;
+	case State::Latest:
+		return u"You have the latest build."_q;
+	case State::Downloading:
+		return (status.total > 0)
+			? u"Downloading %1: %2%"_q.arg(status.tag).arg(
+				status.ready * 100 / status.total)
+			: u"Downloading %1..."_q.arg(status.tag);
+	case State::Ready:
+		return u"%1 is ready, restart to update."_q.arg(status.tag);
+	case State::Failed:
+		return u"Update failed: %1"_q.arg(status.error);
+	}
+	return QString();
+}
+
+void AddUpdates(not_null<Ui::VerticalLayout*> container) {
+	const auto button = container->add(object_ptr<Button>(
+		container,
+		::Tele::UpdateReadyValue() | rpl::map([](bool ready) {
+			return ready ? u"Restart to update"_q : u"Check for updates"_q;
+		}),
+		st::settingsButtonNoIcon));
+	button->setClickedCallback([] {
+		if (::Tele::UpdateReady()) {
+			::Tele::RestartToUpdate();
+		} else {
+			::Tele::CheckForUpdates();
+		}
+	});
+}
