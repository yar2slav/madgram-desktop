diff --git a/Telegram/SourceFiles/tele/tele_calcmula_inline.cpp b/Telegram/SourceFiles/tele/tele_calcmula_inline.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..58bbedaa8149ba93fb70eb8c5d84bfeef2a70e46
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_calcmula_inline.cpp
@@ -0,0 +1,396 @@
+#include "tele/tele_calcmula_inline.h"
+
+#include "base/event_filter.h"
+#include "base/invoke_queued.h"
+#include "base/timer.h"
+#include "tele/tele_calcmula.h"
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_options.h"
+#include "ui/painter.h"
+#include "ui/rp_widget.h"
+#include "ui/text/text_entity.h"
+#include "ui/widgets/fields/input_field.h"
+#include "styles/style_basic.h"
+
+#include <QtGui/QAbstractTextDocumentLayout>
+#include <QtGui/QKeyEvent>
+#include <QtGui/QTextBlock>
+#include <QtGui/QTextLayout>
+#include <QtWidgets/QScrollBar>
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+constexpr auto kDelay = crl::time(250);
+constexpr auto kMaxToken = 100;
+
+[[nodiscard]] bool IsOperator(QChar ch) {
+	return QStringView(u"+-*/^%()!\u00D7\u00F7\u2212").contains(ch);
+}
+
+[[nodiscard]] bool PlainNumber(const QString &token) {
+	auto from = 0;
+	if (!token.isEmpty() && (token[0] == '-' || token[0] == '+')) {
+		from = 1;
+	}
+	for (auto i = from; i != token.size(); ++i) {
+		const auto ch = token[i];
+		if (!ch.isDigit() && ch != '.' && ch != ',') {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] bool Evaluable(const QString &token) {
+	if (token.isEmpty()
+		|| token.size() > kMaxToken
+		|| token.contains(u"://"_q)
+		|| PlainNumber(token)) {
+		return false;
+	}
+	auto word = false;
+	auto operation = false;
+	for (const auto ch : token) {
+		if (ch == '=' || ch == '@' || ch == QChar::ObjectReplacementCharacter) {
+			return false;
+		} else if (ch.isLetterOrNumber()) {
+			word = true;
+		} else if (IsOperator(ch)) {
+			operation = true;
+		}
+	}
+	return word && operation;
+}
+
+[[nodiscard]] bool TypedEquals(
+		const QString &was,
+		const QString &now,
+		int position) {
+	return (now.size() == was.size() + 1)
+		&& (position > 0)
+		&& (position <= now.size())
+		&& (now[position - 1] == '=')
+		&& (QStringView(now).left(position - 1)
+			== QStringView(was).left(position - 1))
+		&& (QStringView(now).mid(position)
+			== QStringView(was).mid(position - 1));
+}
+
+[[nodiscard]] bool IsModifierKey(int key) {
+	return (key == Qt::Key_Shift)
+		|| (key == Qt::Key_Control)
+		|| (key == Qt::Key_Alt)
+		|| (key == Qt::Key_AltGr)
+		|| (key == Qt::Key_Meta);
+}
+
+class Inline final : public Ui::RpWidget {
+public:
+	Inline(
+		not_null<Ui::InputField*> field,
+		not_null<Main::Session*> session,
+		Fn<bool()> blocked);
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+
+private:
+	void setupField();
+	[[nodiscard]] base::EventFilterResult handleKey(
+		not_null<QKeyEvent*> e);
+	[[nodiscard]] bool allowed() const;
+	[[nodiscard]] bool showing() const;
+	[[nodiscard]] bool inCode(int from, int till) const;
+	void queueRefresh();
+	void refresh();
+	void trigger(const QString &text, const QTextCursor &cursor);
+	void request();
+	void apply(const CalcmulaResult &result);
+	void accept();
+	void dismiss();
+	void updateGeometry();
+
+	const not_null<Ui::InputField*> _field;
+	const not_null<QTextEdit*> _raw;
+	const not_null<Main::Session*> _session;
+	const Fn<bool()> _blocked;
+	base::Timer _timer;
+	QString _text;
+	QString _query;
+	QString _result;
+	uint64 _requestId = 0;
+	int _anchor = -1;
+	bool _queued = false;
+
+};
+
+Inline::Inline(
+	not_null<Ui::InputField*> field,
+	not_null<Main::Session*> session,
+	Fn<bool()> blocked)
+: RpWidget(field->rawTextEdit().get())
+, _field(field)
+, _raw(field->rawTextEdit())
+, _session(session)
+, _blocked(std::move(blocked))
+, _timer([=] { request(); })
+, _text(_raw->document()->toPlainText()) {
+	setAttribute(Qt::WA_TransparentForMouseEvents);
+	hide();
+	setupField();
+}
+
+void Inline::setupField() {
+	const auto document = _raw->document();
+	QObject::connect(document, &QTextDocument::contentsChanged, this, [=] {
+		queueRefresh();
+	});
+	QObject::connect(_raw, &QTextEdit::cursorPositionChanged, this, [=] {
+		queueRefresh();
+	});
+	const auto repaint = [=] {
+		if (showing()) {
+			update();
+		}
+	};
+	QObject::connect(
+		_raw->verticalScrollBar(),
+		&QScrollBar::valueChanged,
+		this,
+		repaint);
+	QObject::connect(
+		_raw->horizontalScrollBar(),
+		&QScrollBar::valueChanged,
+		this,
+		repaint);
+	QObject::connect(
+		document->documentLayout(),
+		&QAbstractTextDocumentLayout::documentSizeChanged,
+		this,
+		repaint);
+	base::install_event_filter(this, _raw->viewport(), [=](
+			not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type == QEvent::Resize || type == QEvent::Move) {
+			updateGeometry();
+		}
+		return base::EventFilterResult::Continue;
+	});
+	base::install_event_filter(this, _raw, [=](not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type == QEvent::KeyPress) {
+			return handleKey(static_cast<QKeyEvent*>(e.get()));
+		} else if (type == QEvent::FocusOut || type == QEvent::Hide) {
+			dismiss();
+		}
+		return base::EventFilterResult::Continue;
+	});
+}
+
+base::EventFilterResult Inline::handleKey(not_null<QKeyEvent*> e) {
+	using Result = base::EventFilterResult;
+	const auto key = e->key();
+	if (_anchor < 0 || IsModifierKey(key)) {
+		return Result::Continue;
+	}
+	const auto modifiers = e->modifiers()
+		& ~(Qt::KeypadModifier | Qt::GroupSwitchModifier);
+	const auto shown = showing()
+		&& allowed()
+		&& (_raw->textCursor().position() == _anchor)
+		&& !_raw->textCursor().hasSelection();
+	if (shown && !modifiers) {
+		if (key == Qt::Key_Right || key == Qt::Key_Tab) {
+			accept();
+			return Result::Cancel;
+		} else if (key == Qt::Key_Escape) {
+			dismiss();
+			return Result::Cancel;
+		}
+	}
+	dismiss();
+	return Result::Continue;
+}
+
+bool Inline::allowed() const {
+	return Calcmula()
+		&& CalcmulaInline()
+		&& !OfflineForLaunch()
+		&& _raw->hasFocus()
+		&& !_blocked();
+}
+
+bool Inline::showing() const {
+	return (_anchor >= 0) && !_result.isEmpty() && !isHidden();
+}
+
+bool Inline::inCode(int from, int till) const {
+	const auto part = _field->getTextWithTagsPart(from, till);
+	for (const auto &tag : part.tags) {
+		for (const auto &id : TextUtilities::SplitTags(tag.id)) {
+			if (id == Ui::InputField::kTagCode
+				|| id.startsWith(Ui::InputField::kTagPre)) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+void Inline::queueRefresh() {
+	if (_queued) {
+		return;
+	}
+	_queued = true;
+	InvokeQueued(this, [=] {
+		_queued = false;
+		refresh();
+	});
+}
+
+void Inline::refresh() {
+	const auto text = _raw->document()->toPlainText();
+	const auto cursor = _raw->textCursor();
+	const auto position = cursor.position();
+	const auto was = std::exchange(_text, text);
+	if (_anchor >= 0
+		&& (text != was || position != _anchor || cursor.hasSelection())) {
+		dismiss();
+	}
+	if (text != was
+		&& !cursor.hasSelection()
+		&& TypedEquals(was, text, position)) {
+		trigger(text, cursor);
+	}
+}
+
+void Inline::trigger(const QString &text, const QTextCursor &cursor) {
+	if (!allowed()
+		|| !cursor.atBlockEnd()
+		|| text.startsWith(u"= "_q)) {
+		return;
+	}
+	const auto position = cursor.position();
+	auto start = position - 1;
+	while (start > 0 && !text[start - 1].isSpace()) {
+		--start;
+	}
+	const auto token = text.mid(start, position - 1 - start);
+	if (!Evaluable(token) || inCode(start, position)) {
+		return;
+	}
+	_anchor = position;
+	_query = token;
+	++_requestId;
+	const auto cached = CalcmulaCached(token);
+	if (!cached.value.isEmpty()) {
+		apply(cached);
+	} else {
+		_timer.callOnce(kDelay);
+	}
+}
+
+void Inline::request() {
+	if (_anchor < 0 || !allowed()) {
+		dismiss();
+		return;
+	}
+	const auto id = ++_requestId;
+	CalcmulaCompute(_session, _query, crl::guard(this, [=](
+			CalcmulaResult result) {
+		if (id == _requestId) {
+			apply(result);
+		}
+	}));
+}
+
+void Inline::apply(const CalcmulaResult &result) {
+	const auto value = TextUtilities::SingleLine(result.value).trimmed();
+	const auto cursor = _raw->textCursor();
+	if (!result.error.isEmpty()
+		|| value.isEmpty()
+		|| value == _query
+		|| !allowed()
+		|| cursor.position() != _anchor
+		|| cursor.hasSelection()) {
+		dismiss();
+		return;
+	}
+	_result = value;
+	updateGeometry();
+	show();
+	raise();
+	update();
+}
+
+void Inline::accept() {
+	const auto value = _result;
+	auto cursor = _raw->textCursor();
+	dismiss();
+	cursor.beginEditBlock();
+	cursor.insertText(value);
+	cursor.endEditBlock();
+	_raw->setTextCursor(cursor);
+	_raw->ensureCursorVisible();
+}
+
+void Inline::dismiss() {
+	_timer.cancel();
+	++_requestId;
+	_anchor = -1;
+	_query = QString();
+	_result = QString();
+	hide();
+}
+
+void Inline::updateGeometry() {
+	setGeometry(_raw->viewport()->geometry());
+}
+
+void Inline::paintEvent(QPaintEvent *e) {
+	if (!showing()) {
+		return;
+	}
+	const auto cursor = _raw->textCursor();
+	if (cursor.position() != _anchor) {
+		return;
+	}
+	const auto block = cursor.block();
+	const auto layout = block.layout();
+	if (!layout) {
+		return;
+	}
+	const auto inBlock = cursor.positionInBlock();
+	const auto line = layout->lineForTextPosition(inBlock);
+	if (!line.isValid()) {
+		return;
+	}
+	const auto rect = _raw->cursorRect(cursor);
+	const auto right = rect.x() + qRound(
+		line.x() + line.width() - line.cursorToX(inBlock));
+	const auto available = std::min(right, width()) - rect.x();
+	if (available <= 0) {
+		return;
+	}
+	auto p = QPainter(this);
+	p.setClipRect(QRect(rect.x(), rect.y(), available, rect.height()));
+	p.setFont(_raw->font());
+	p.setPen(st::windowSubTextFg);
+	p.drawText(
+		rect.x(),
+		rect.y() + qRound(line.ascent()),
+		_result);
+}
+
+} // namespace
+
+void SetupCalcmulaInline(
+		not_null<Ui::InputField*> field,
+		not_null<Main::Session*> session,
+		Fn<bool()> blocked) {
+	new Inline(field, session, std::move(blocked));
+}
+
+} // namespace Tele
