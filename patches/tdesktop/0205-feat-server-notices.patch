+constexpr auto kPlatform = "windows";
+#elif defined Q_OS_MAC
+constexpr auto kPlatform = "macos";
+#else
+constexpr auto kPlatform = "linux";
+#endif
+
+[[nodiscard]] bool Present(const QJsonValue &value) {
+	return !value.isUndefined() && !value.isNull();
+}
+
+[[nodiscard]] std::optional<int> Number(const QJsonValue &value) {
+	if (!value.isDouble()) {
+		return std::nullopt;
+	}
+	const auto number = value.toDouble();
+	if (number < 0 || number > 2147483647. || number != std::floor(number)) {
+		return std::nullopt;
+	}
+	return int(number);
+}
+
+[[nodiscard]] bool LinkAllowed(const QString &url) {
+	return url.startsWith(u"https://"_q, Qt::CaseInsensitive)
+		|| url.startsWith(u"http://"_q, Qt::CaseInsensitive)
+		|| url.startsWith(u"tg://"_q, Qt::CaseInsensitive);
+}
+
+[[nodiscard]] bool IdAllowed(const QString &id) {
+	if (id.isEmpty() || id.size() > kMaxIdLength) {
+		return false;
+	}
+	for (const auto ch : id) {
+		if (!(ch >= 'a' && ch <= 'z')
+			&& !(ch >= 'A' && ch <= 'Z')
+			&& !(ch >= '0' && ch <= '9')
+			&& ch != '-') {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] std::optional<NoticeTone> ParseTone(const QString &type) {
+	if (type == u"info"_q) {
+		return NoticeTone::Info;
+	} else if (type == u"success"_q) {
+		return NoticeTone::Success;
+	} else if (type == u"warning"_q) {
+		return NoticeTone::Warning;
+	} else if (type == u"critical"_q) {
+		return NoticeTone::Critical;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<EntityInText> ParseEntity(
+		const QJsonObject &fields) {
+	const auto type = fields.value(u"type"_q).toString();
+	const auto offset = Number(fields.value(u"offset"_q));
+	const auto length = Number(fields.value(u"length"_q));
+	if (!offset || !length || !*length) {
+		return std::nullopt;
+	}
+	const auto make = [&](EntityType type, QString data = QString()) {
+		return std::make_optional(EntityInText(
+			type,
+			*offset,
+			*length,
+			std::move(data)));
+	};
+	if (type == u"bold"_q) {
+		return make(EntityType::Bold);
+	} else if (type == u"italic"_q) {
+		return make(EntityType::Italic);
+	} else if (type == u"underline"_q) {
+		return make(EntityType::Underline);
+	} else if (type == u"strikethrough"_q) {
+		return make(EntityType::StrikeOut);
+	} else if (type == u"spoiler"_q) {
+		return make(EntityType::Spoiler);
+	} else if (type == u"code"_q) {
+		return make(EntityType::Code);
+	} else if (type == u"pre"_q) {
+		return make(EntityType::Pre, fields.value(u"language"_q).toString());
+	} else if (type == u"blockquote"_q) {
+		return make(EntityType::Blockquote);
+	} else if (type == u"url"_q) {
+		return make(EntityType::Url);
+	} else if (type == u"text_link"_q) {
+		const auto url = fields.value(u"url"_q).toString();
+		return LinkAllowed(url)
+			? make(EntityType::CustomUrl, url)
+			: std::nullopt;
+	} else if (type == u"custom_emoji"_q) {
+		auto ok = false;
+		const auto id = fields.value(u"custom_emoji_id"_q).toString();
+		const auto document = id.toULongLong(&ok);
+		return (ok && document)
+			? make(
+				EntityType::CustomEmoji,
+				Data::SerializeCustomEmojiId(DocumentId(document)))
+			: std::nullopt;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<FeedNotice> ParseNotice(const QJsonValue &value) {
+	if (!value.isObject()) {
+		return std::nullopt;
+	}
+	const auto fields = value.toObject();
+	const auto id = fields.value(u"id"_q).toString();
+	const auto rev = Number(fields.value(u"rev"_q));
+	const auto tone = ParseTone(fields.value(u"type"_q).toString());
+	const auto title = fields.value(u"title"_q);
+	const auto text = fields.value(u"text"_q);
+	if (!IdAllowed(id)
+		|| !rev
+		|| !tone
+		|| (Present(title) && !title.isString())
+		|| (Present(text) && !text.isString())) {
+		return std::nullopt;
+	}
+	auto result = FeedNotice{
+		.id = id,
+		.rev = *rev,
+		.tone = *tone,
+		.title = title.toString().trimmed(),
+		.text = { text.toString().left(kMaxTextLength) },
+		.toast = fields.value(u"toast"_q).toBool(),
+	};
+	if (result.title.isEmpty() && result.text.text.trimmed().isEmpty()) {
+		return std::nullopt;
+	}
+	const auto size = int(result.text.text.size());
+	for (const auto &entity : fields.value(u"entities"_q).toArray()) {
+		if (result.text.entities.size() >= kMaxEntities) {
+			break;
+		}
+		const auto parsed = ParseEntity(entity.toObject());
+		if (parsed && parsed->offset() + parsed->length() <= size) {
+			result.text.entities.push_back(*parsed);
+		}
+	}
+	std::stable_sort(
+		result.text.entities.begin(),
+		result.text.entities.end(),
+		[](const EntityInText &a, const EntityInText &b) {
+			return a.offset() < b.offset();
+		});
+	const auto photo = fields.value(u"photo"_q).toObject();
+	const auto url = photo.value(u"url"_q).toString();
+	if (url.startsWith('/') && !url.startsWith(u"//"_q)) {
+		result.photo = url;
+	}
+	for (const auto &button : fields.value(u"buttons"_q).toArray()) {
+		const auto object = button.toObject();
+		const auto text = object.value(u"text"_q).toString().trimmed();
+		const auto link = object.value(u"url"_q).toString();
+		if (!text.isEmpty() && LinkAllowed(link)) {
+			result.buttons.push_back({ text, link });
+			if (result.buttons.size() == 2) {
+				break;
+			}
+		}
+	}
+	const auto builds = fields.value(u"builds"_q);
+	if (builds.isObject()) {
+		const auto range = builds.toObject();
+		result.buildsMin = Number(range.value(u"min"_q));
+		result.buildsMax = Number(range.value(u"max"_q));
+	}
+	const auto platforms = fields.value(u"platforms"_q);
+	if (platforms.isArray()) {
+		auto &list = result.platforms.emplace();
+		for (const auto &platform : platforms.toArray()) {
+			list.push_back(platform.toString());
+		}
+	}
+	const auto users = fields.value(u"users"_q);
+	if (users.isArray()) {
+		auto &list = result.users.emplace();
+		for (const auto &user : users.toArray()) {
+			const auto decoded = QByteArray::fromBase64Encoding(
+				user.toString().toLatin1(),
+				(QByteArray::Base64UrlEncoding
+					| QByteArray::OmitTrailingEquals
+					| QByteArray::AbortOnBase64DecodingErrors));
+			if (decoded && decoded.decoded.size() == kTagSize) {
+				list.push_back(decoded.decoded);
+			}
+			if (int(list.size()) >= kMaxUsers) {
+				break;
+			}
+		}
+	}
+	result.from = Number(fields.value(u"from"_q)).value_or(0);
+	result.until = Number(fields.value(u"until"_q)).value_or(0);
+	return result;
+}
+
+[[nodiscard]] bool Targeted(const FeedNotice &notice) {
+	const auto build = BuildNumber();
+	if ((notice.buildsMin && build < *notice.buildsMin)
+		|| (notice.buildsMax && build > *notice.buildsMax)) {
+		return false;
+	} else if (notice.platforms
+		&& !ranges::contains(
+			*notice.platforms,
+			QString::fromLatin1(kPlatform))) {
+		return false;
+	}
+	return true;
+}
+
+[[nodiscard]] bool Enabled() {
+	return NoticesCentre() && NoticesServer() && !ServerOffForLaunch();
+}
+
+[[nodiscard]] const style::color &ToneColor(NoticeTone tone) {
+	switch (tone) {
+	case NoticeTone::Success: return st::settingsIconBg2;
+	case NoticeTone::Warning: return st::settingsIconBg3;
+	case NoticeTone::Critical: return st::settingsIconBg1;
+	case NoticeTone::None:
+	case NoticeTone::Info: break;
+	}
+	return st::settingsIconBg4;
+}
+
+[[nodiscard]] QString PhotoName(const FeedNotice &notice) {
+	return u"tele_notice_%1_%2"_q.arg(notice.id).arg(notice.rev);
+}
+
+[[nodiscard]] QByteArray UserAgent() {
+	return u"tele/%1-tele.%2"_q.arg(
+		QString::fromLatin1(AppVersionStr)).arg(BuildNumber()).toLatin1();
+}
+
+class State final : public base::has_weak_ptr {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State *Find(not_null<Main::Session*> session);
+
+	void apply(std::vector<FeedNotice> list);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	void refresh();
+	void show(const FeedNotice &notice);
+	void fetch(const FeedNotice &notice);
+	void fetched(const FeedNotice &notice, const QByteArray &bytes);
+	void add(const FeedNotice &notice, const QString &photo, QSize size);
+	void toast(const FeedNotice &notice);
+	void pumpToasts();
+	void showToast(const FeedNotice &notice);
+
+	const not_null<Main::Session*> _session;
+	std::vector<FeedNotice> _list;
+	base::flat_set<QString> _fetching;
+	std::vector<QPointer<QNetworkReply>> _replies;
+	std::unique_ptr<QNetworkAccessManager> _manager;
+	base::Timer _timer;
+	std::vector<FeedNotice> _toastQueue;
+	base::weak_ptr<Ui::Toast::Instance> _currentToast;
+	base::Timer _toastTimer;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session)
+, _timer([=] { refresh(); })
+, _toastTimer([=] { pumpToasts(); }) {
+	Registry().emplace(session, this);
+	rpl::merge(
+		NoticesCentreValue() | rpl::to_empty,
+		NoticesServerChanges()
+	) | rpl::skip(1) | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+	crl::on_main(this, [=] {
+		RequestFeedNotices(_session);
+	});
+}
+
+State::~State() {
+	for (const auto &reply : base::take(_replies)) {
+		if (const auto raw = reply.data()) {
+			raw->disconnect();
+			raw->abort();
+			raw->deleteLater();
+		}
+	}
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State *State::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+void State::apply(std::vector<FeedNotice> list) {
+	_list = std::move(list);
+	refresh();
+}
+
+void State::refresh() {
+	_timer.cancel();
+	if (!Enabled()) {
+		return;
+	}
+	const auto now = base::unixtime::now();
+	auto next = TimeId();
+	for (const auto &notice : _list) {
+		if (!Targeted(notice) || (notice.until && now >= notice.until)) {
+			continue;
+		} else if (notice.from && now < notice.from) {
+			next = next ? std::min(next, notice.from) : notice.from;
+			continue;
+		}
+		show(notice);
+	}
+	if (next && !_timer.isActive()) {
+		_timer.callOnce((next - now) * crl::time(1000) + 500);
+	}
+}
+
+void State::show(const FeedNotice &notice) {
+	if (ServerNoticeRev(_session, notice.id) == notice.rev) {
+		toast(notice);
+	} else if (_fetching.contains(notice.id)) {
+		return;
+	} else if (notice.photo.isEmpty()) {
+		add(notice, QString(), QSize());
+	} else {
+		fetch(notice);
+	}
+}
+
+void State::fetch(const FeedNotice &notice) {
+	const auto base = NormalizeServerUrl(ServerUrl());
+	if (!base || base->isEmpty() || ServerOffForLaunch()) {
+		add(notice, QString(), QSize());
+		return;
+	}
+	if (!_manager) {
+		_manager = std::make_unique<QNetworkAccessManager>();
+	}
+	_fetching.emplace(notice.id);
+	auto request = QNetworkRequest(QUrl(*base + notice.photo));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::SameOriginRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTransferTimeout));
+	request.setRawHeader("User-Agent", UserAgent());
+	const auto reply = _manager->get(request);
+	_replies.push_back(reply);
+	const auto body = std::make_shared<QByteArray>();
+	const auto tooLarge = std::make_shared<bool>(false);
+	const auto take = [=] {
+		if (!*tooLarge) {
+			body->append(reply->read(kMaxPhotoSize + 1 - body->size()));
+			*tooLarge = (body->size() > kMaxPhotoSize);
+		}
+	};
+	QObject::connect(reply, &QNetworkReply::readyRead, reply, [=] {
+		take();
+		if (*tooLarge) {
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		_replies.erase(
+			ranges::remove(_replies, QPointer<QNetworkReply>(reply)),
+			end(_replies));
+		take();
+		const auto code = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		const auto ok = !*tooLarge
+			&& (reply->error() == QNetworkReply::NoError)
+			&& (code == 200);
+		if (!ok) {
+			LOG(("Tele Notices Error: photo %1, http %2, %3"
+				).arg(notice.id
+				).arg(code
+				).arg(*tooLarge ? u"too large"_q : reply->errorString()));
+		}
+		fetched(notice, ok ? *body : QByteArray());
+	});
+}
+
+void State::fetched(const FeedNotice &notice, const QByteArray &bytes) {
+	_fetching.remove(notice.id);
+	const auto i = ranges::find(_list, notice.id, &FeedNotice::id);
+	if (i == end(_list) || i->rev != notice.rev || !Enabled()) {
+		return;
+	}
+	auto buffer = QBuffer();
+	buffer.setData(bytes);
+	auto reader = QImageReader(&buffer);
+	const auto format = reader.format();
+	auto image = QImage();
+	if (!bytes.isEmpty()
+		&& (format == "jpeg" || format == "png")
+		&& reader.read(&image)
+		&& !image.isNull()) {
+		const auto name = PhotoName(notice);
+		SaveNoticePhoto(_session, name, bytes);
+		add(notice, name, image.size());
+	} else {
+		add(notice, QString(), QSize());
+	}
+}
+
+void State::add(const FeedNotice &notice, const QString &photo, QSize size) {
+	SetServerNoticeRev(_session, notice.id, notice.rev);
+	Notify(_session, {
+		.kind = NoticeKind::Server,
+		.tone = notice.tone,
+		.key = u"server:"_q + notice.id,
+		.rev = notice.rev,
+		.title = notice.title,
+		.text = notice.text,
+		.buttons = notice.buttons,
+		.photo = photo,
+		.photoSize = size,
+	});
+	toast(notice);
+}
+
+void State::toast(const FeedNotice &notice) {
+	if (!notice.toast
+		|| ServerNoticeToasted(_session, notice.id)
+		|| ranges::contains(_toastQueue, notice.id, &FeedNotice::id)) {
+		return;
+	}
+	_toastQueue.push_back(notice);
+	LastServerToastQueued() = crl::now();
+	crl::on_main(this, [=] {
+		pumpToasts();
+	});
+}
+
+void State::pumpToasts() {
+	if (_currentToast.get() || _toastQueue.empty()) {
+		return;
+	}
+	const auto window = _session->tryResolveWindow();
+	if (!window || !window->widget()->isActiveWindow()) {
+		_toastTimer.callOnce(window ? crl::time(1000) : kRetryDelay);
+		return;
+	}
+	const auto notice = _toastQueue.front();
+	_toastQueue.erase(begin(_toastQueue));
+	if (!Enabled() || ServerNoticeToasted(_session, notice.id)) {
+		pumpToasts();
+		return;
+	}
+	showToast(notice);
+	_toastTimer.callOnce(kToastDuration + crl::time(400));
+}
+
+void State::showToast(const FeedNotice &notice) {
+	const auto window = _session->tryResolveWindow();
+	SetServerNoticeToasted(_session, notice.id);
+	const auto size = style::ConvertScale(kToastIconSize);
+	auto icon = object_ptr<Ui::RpWidget>((QWidget*)nullptr);
+	const auto raw = icon.data();
+	raw->resize(size, size);
+	raw->setAttribute(Qt::WA_TransparentForMouseEvents);
+	const auto tone = notice.tone;
+	raw->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(raw);
+		{
+			auto hq = PainterHighQualityEnabler(p);
+			p.setPen(Qt::NoPen);
+			p.setBrush(ToneColor(tone));
+			p.drawEllipse(raw->rect());
+		}
+		const auto &glyph = st::menuIconInfo;
+		glyph.paint(
+			p,
+			(size - glyph.width()) / 2,
+			(size - glyph.height()) / 2,
+			size,
+			st::settingsIconFg->c);
+	}, raw->lifetime());
+	_currentToast = window->showToast(Ui::Toast::Config{
+		.title = notice.title,
+		.text = notice.text,
+		.textContext = Core::TextContext({ .session = _session }),
+		.iconContent = std::move(icon),
+		.duration = kToastDuration,
+	});
+}
+
+} // namespace
+
+std::vector<FeedNotice> ParseFeedNotices(const QJsonValue &value) {
+	auto result = std::vector<FeedNotice>();
+	if (!value.isArray()) {
+		return result;
+	}
+	auto skipped = 0;
+	for (const auto &entry : value.toArray()) {
+		if (int(result.size()) >= kMaxNotices) {
+			++skipped;
+		} else if (auto notice = ParseNotice(entry)) {
+			result.push_back(std::move(*notice));
+		} else {
+			++skipped;
+		}
+	}
+	if (skipped) {
+		LOG(("Tele Notices Error: skipped %1 notices").arg(skipped));
+	}
+	return result;
+}
+
+bool ServerNoticeToastRecent() {
+	const auto queued = LastServerToastQueued();
+	return queued && (crl::now() - queued < crl::time(3000));
+}
+
+void SetupServerNotices(not_null<Main::Session*> session) {
+	session->lifetime().make_state<State>(session);
+}
+
+void ApplyFeedNotices(
+		not_null<Main::Session*> session,
+		std::vector<FeedNotice> list) {
+	if (const auto state = State::Find(session)) {
+		state->apply(std::move(list));
+	}
+}
+
+} // namespace Tele
