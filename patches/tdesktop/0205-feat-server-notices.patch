+void Badges::pushNotices() {
+	EnumerateSessions([&](not_null<Main::Session*> session) {
+		notices(session);
+	});
+}
+
+void Badges::notices(not_null<Main::Session*> session) {
+	auto list = std::vector<FeedNotice>();
+	if (!_feed) {
+		ApplyFeedNotices(session, std::move(list));
+		return;
+	}
+	const auto key = Key(session->user());
+	const auto targeted = ranges::any_of(
+		_feed->notices,
+		[](const FeedNotice &notice) { return notice.users.has_value(); });
+	auto self = QByteArray();
+	if (targeted) {
+		const auto i = _selfTags.find(key);
+		if (i == end(_selfTags)) {
+			deriveSelf(key);
+			return;
+		} else if (const auto &tag = i->second) {
+			self = QByteArray(
+				reinterpret_cast<const char*>(tag->data()),
+				int(tag->size()));
+		}
+	}
+	for (const auto &notice : _feed->notices) {
+		if (!notice.users
+			|| (!self.isEmpty() && ranges::contains(*notice.users, self))) {
+			list.push_back(notice);
+		}
+	}
+	ApplyFeedNotices(session, std::move(list));
+}
+
+void Badges::deriveSelf(PeerKey key) {
+	if (!_feed || !_selfHashing.emplace(key).second) {
+		return;
+	}
+	crl::async([
+		=,
+		weak = base::make_weak(this),
+		params = _feed->params,
+		password = Password(key)
+	] {
+		auto tags = DeriveAll(params, { password });
+		crl::on_main(weak, [=, tag = tags.front()] {
+			_selfHashing.erase(key);
+			if (_feed && _feed->params == params) {
+				_selfTags[key] = tag;
+			}
+			EnumerateSessions([&](not_null<Main::Session*> session) {
+				if (Key(session->user()) == key) {
+					notices(session);
+				}
+			});
+		});
+	});
+}
