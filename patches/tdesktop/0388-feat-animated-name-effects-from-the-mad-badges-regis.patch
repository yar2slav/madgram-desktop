 		QPainter &p,
@@ -14,21 +150,27 @@ void ApplyMadNameColor(
 	if (skip || !peer || rect.width() <= 0) {
 		return;
 	}
-	const auto colors = MadNameColors(peer);
-	if (colors.empty()) {
+	auto name = MadNameStyle(peer);
+	if (name.colors.empty()) {
 		return;
-	} else if (colors.size() == 1) {
-		p.setPen(colors.front());
+	} else if (!Animated(name)) {
+		name.effect = MadNameEffect::Static;
+	}
+	if (name.effect == MadNameEffect::Static && name.colors.size() == 1) {
+		p.setPen(name.colors.front());
 		return;
 	}
 	auto gradient = QLinearGradient(
 		QPointF(rect.left(), 0.),
 		QPointF(rect.left() + rect.width(), 0.));
-	const auto last = int(colors.size()) - 1;
-	for (auto i = 0; i <= last; ++i) {
-		gradient.setColorAt(float64(i) / last, colors[i]);
+	for (auto i = 0; i <= kStops; ++i) {
+		const auto x = float64(i) / kStops;
+		gradient.setColorAt(x, ColorAt(name, x));
 	}
 	p.setPen(QPen(QBrush(gradient), 1.));
+	if (name.effect != MadNameEffect::Static) {
+		Schedule(p, rect);
+	}
 }
 
 std::optional<QColor> MadTitleColor(
@@ -37,10 +179,10 @@ std::optional<QColor> MadTitleColor(
 	if (upstream || !peer) {
 		return upstream;
 	}
-	const auto colors = MadNameColors(peer);
-	return colors.empty()
+	const auto name = MadNameStyle(peer);
+	return name.colors.empty()
 		? upstream
-		: std::optional<QColor>(colors.front());
+		: std::optional<QColor>(name.colors.front());
 }
 
