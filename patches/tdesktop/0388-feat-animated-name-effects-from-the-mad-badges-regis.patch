 #include "tele/tele_mad_names.h"
 
+#include "base/timer.h"
 #include "tele/tele_mad_badges.h"
+#include "ui/effects/animation_value.h"
+#include "ui/power_saving.h"
 
+#include <QtCore/QPointer>
 #include <QtGui/QPainter>
+#include <QtWidgets/QWidget>
+
+#include <cmath>
+#include <numbers>
 
 namespace Tele {
+namespace {
+
+constexpr auto kStops = 24;
+constexpr auto kFrame = crl::time(33);
+constexpr auto kFlowPeriod = crl::time(2600);
+constexpr auto kRainbowPeriod = crl::time(3200);
+constexpr auto kShimmerPeriod = crl::time(2400);
+constexpr auto kPulsePeriod = crl::time(2400);
+
+struct Target {
+	QPointer<QWidget> widget;
+	QRect rect;
+};
+
+std::vector<Target> Targets;
+
+[[nodiscard]] float64 Phase(crl::time period) {
+	return float64(crl::now() % period) / period;
+}
+
+[[nodiscard]] float64 Fraction(float64 value) {
+	return value - std::floor(value);
+}
+
+[[nodiscard]] QColor Mix(const QColor &a, const QColor &b, float64 ratio) {
+	const auto r = std::clamp(ratio, 0., 1.);
+	return QColor::fromRgbF(
+		a.redF() + (b.redF() - a.redF()) * r,
+		a.greenF() + (b.greenF() - a.greenF()) * r,
+		a.blueF() + (b.blueF() - a.blueF()) * r,
+		a.alphaF() + (b.alphaF() - a.alphaF()) * r);
+}
+
+[[nodiscard]] QColor Along(const std::vector<QColor> &colors, float64 x) {
+	if (colors.size() == 1) {
+		return colors.front();
+	}
+	const auto last = int(colors.size()) - 1;
+	const auto position = std::clamp(x, 0., 1.) * last;
+	const auto index = std::min(int(position), last - 1);
+	return Mix(colors[index], colors[index + 1], position - index);
+}
+
+[[nodiscard]] QColor Loop(const std::vector<QColor> &colors, float64 x) {
+	if (colors.size() == 1) {
+		return colors.front();
+	}
+	const auto count = int(colors.size());
+	const auto position = Fraction(x) * count;
+	const auto index = std::min(int(position), count - 1);
+	return Mix(colors[index], colors[(index + 1) % count], position - index);
+}
+
+[[nodiscard]] QColor Rainbow(float64 x) {
+	return QColor::fromHsvF(Fraction(x), 0.72, 0.96);
+}
+
+[[nodiscard]] QColor Lighter(const QColor &color, float64 amount) {
+	return Mix(color, QColor(255, 255, 255, color.alpha()), amount);
+}
+
+[[nodiscard]] QColor ColorAt(const MadName &name, float64 x) {
+	switch (name.effect) {
+	case MadNameEffect::Flow:
+		return Loop(name.colors, x - Phase(kFlowPeriod));
+	case MadNameEffect::Rainbow:
+		return Rainbow(x * 0.75 - Phase(kRainbowPeriod));
+	case MadNameEffect::Shimmer: {
+		const auto center = -0.35 + 1.7 * Phase(kShimmerPeriod);
+		const auto distance = std::abs(x - center) / 0.22;
+		const auto glow = std::max(1. - distance, 0.);
+		return Lighter(Along(name.colors, x), 0.7 * glow * glow);
+	}
+	case MadNameEffect::Pulse: {
+		const auto phase = Phase(kPulsePeriod);
+		if (name.colors.size() > 1) {
+			return Loop(name.colors, phase + x * 0.15);
+		}
+		const auto wave = 0.5 - 0.5 * std::cos(phase * 2. * std::numbers::pi);
+		return Lighter(name.colors.front(), 0.38 * wave);
+	}
+	case MadNameEffect::Static:
+		break;
+	}
+	return Along(name.colors, x);
+}
+
+void Tick() {
+	for (const auto &target : base::take(Targets)) {
+		if (const auto widget = target.widget.data()) {
+			widget->update(target.rect);
+		}
+	}
+}
+
+[[nodiscard]] base::Timer &Ticker() {
+	static const auto timer = new base::Timer(Tick);
+	return *timer;
+}
+
+void Schedule(QPainter &p, QRect rect) {
+	const auto widget = dynamic_cast<QWidget*>(p.device());
+	if (!widget) {
+		return;
+	}
+	const auto mapped = p.transform().mapRect(rect).marginsAdded(
+		{ 2, 2, 2, 2 });
+	const auto i = ranges::find(Targets, widget, [](const Target &target) {
+		return target.widget.data();
+	});
+	if (i != end(Targets)) {
+		i->rect = i->rect.united(mapped);
+	} else {
+		Targets.push_back({ widget, mapped });
+	}
+	auto &ticker = Ticker();
+	if (!ticker.isActive()) {
+		ticker.callOnce(kFrame);
+	}
+}
+
+[[nodiscard]] bool Animated(const MadName &name) {
+	return (name.effect != MadNameEffect::Static)
+		&& !anim::Disabled()
+		&& !PowerSaving::On(PowerSaving::kChatEffects);
+}
+
+} // namespace
 
