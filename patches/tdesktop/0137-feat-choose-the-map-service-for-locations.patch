+bool OpenMapsInApp(
+		const QString &lat,
+		const QString &lon,
+		const QString &title,
+		const QString &url) {
+	const auto &services = AppLinkServices();
+	const auto service = ranges::find(
+		services,
+		u"maps"_q,
+		&AppLinkService::id);
+	if (service == end(services)) {
+		return false;
+	}
+	const auto choice = AppLinkChoiceFor(service->id);
+	const auto uri = u"geo:%1,%2"_q.arg(lat, lon);
+	switch (choice.mode) {
+	case AppLinkMode::Site: {
+		const auto &sites = service->sites;
+		const auto i = ranges::find(sites, choice.app, &AppLinkSite::id);
+		if (i == end(sites)) {
+			return false;
+		}
+		const auto label = QString::fromUtf8(QUrl::toPercentEncoding(
+			title.isEmpty() ? u"Point"_q : title));
+		return QDesktopServices::openUrl(QUrl(QString(i->url)
+			.replace(u"{lat}"_q, lat)
+			.replace(u"{lon}"_q, lon)
+			.replace(u"{title}"_q, label)));
+	}
+	case AppLinkMode::App: return LaunchApp(*service, choice.app, uri);
+	case AppLinkMode::Custom: return LaunchCustom(choice, url, uri);
+	case AppLinkMode::Browser:
+	case AppLinkMode::Default: break;
+	}
+	return false;
+}
+
 } // namespace Tele
