diff --git a/Telegram/SourceFiles/tele/tele_maps.cpp b/Telegram/SourceFiles/tele/tele_maps.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..be81337747b5a7caf44c1d16602d5a6eb35c2d5b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_maps.cpp
@@ -0,0 +1,58 @@
+#include "tele/tele_maps.h"
+
+#include "data/data_location.h"
+#include "history/history_location_manager.h"
+#include "platform/platform_specific.h"
+#include "tele/tele_app_links.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool OpenMaps(
+		const Data::LocationPoint &point,
+		const QString &title) {
+	return OpenMapsInApp(
+		point.latAsString(),
+		point.lonAsString(),
+		title,
+		LocationClickHandler::Url(point));
+}
+
+class VenueClickHandler final : public LocationClickHandler {
+public:
+	VenueClickHandler(const Data::LocationPoint &point, const QString &title)
+	: LocationClickHandler(point)
+	, _point(point)
+	, _title(title) {
+	}
+
+	void onClick(ClickContext context) const override {
+		if (!OpenMaps(_point, _title)) {
+			LocationClickHandler::onClick(context);
+		}
+	}
+
+private:
+	Data::LocationPoint _point;
+	QString _title;
+
+};
+
+} // namespace
+
+void LaunchMaps(const Data::LocationPoint &point, Fn<void()> fail) {
+	if (!OpenMaps(point, QString())) {
+		Platform::LaunchMaps(point, std::move(fail));
+	}
+}
+
+ClickHandlerPtr LocationLink(
+		const Data::LocationPoint &point,
+		const QString &title) {
+	if (title.isEmpty()) {
+		return std::make_shared<LocationClickHandler>(point);
+	}
+	return std::make_shared<VenueClickHandler>(point, title);
+}
+
+} // namespace Tele
