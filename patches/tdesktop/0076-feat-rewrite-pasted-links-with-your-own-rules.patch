+#include "tele/tele_link_rewrites_box.h"
+
+#include "lang/lang_keys.h"
+#include "settings/settings_common.h"
+#include "tele/tele_link_rewrites.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/layers/show.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/popup_menu.h"
+#include "ui/wrap/slide_wrap.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_boxes.h"
+#include "styles/style_edit_peer_members.h"
+#include "styles/style_layers.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_settings.h"
+#include "styles/style_widgets.h"
+
+#include <QtCore/QRegularExpression>
+#include <QtGui/QCursor>
+
+namespace Tele {
+namespace {
+
+using Type = LinkRewriteType;
+
+struct DomainList {
+	QStringList list;
+	bool valid = true;
+};
+
+[[nodiscard]] DomainList ReadDomains(const QString &text) {
+	static const auto Separators = QRegularExpression(u"[\\s,]+"_q);
+	auto result = DomainList();
+	for (const auto &entry : text.split(Separators, Qt::SkipEmptyParts)) {
+		if (const auto domain = NormalizeRewriteDomain(entry)) {
+			if (!result.list.contains(*domain)) {
+				result.list.push_back(*domain);
+			}
+		} else {
+			result.valid = false;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Arrow() {
+	return u" "_q + QChar(0x2192) + u" "_q;
+}
+
+[[nodiscard]] QString RuleTitle(const LinkRewriteRule &rule) {
+	if (rule.type == Type::Pattern) {
+		return Lower(u"Pattern: "_q) + rule.match;
+	}
+	auto result = rule.from.join(u", "_q) + Arrow() + rule.to.value(0);
+	if (rule.to.size() > 1) {
+		result += u" +"_q
+			+ QString::number(rule.to.size() - 1)
+			+ u" "_q
+			+ QChar(0x00B7)
+			+ u" "_q
+			+ (rule.random ? u"random"_q : u"first"_q);
+	}
+	return result;
+}
+
+[[nodiscard]] not_null<Ui::InputField*> AddField(
+		not_null<Ui::VerticalLayout*> container,
+		const QString &placeholder,
+		const QString &value,
+		bool multiline = false) {
+	const auto result = container->add(multiline
+		? object_ptr<Ui::InputField>(
+			container,
+			st::newGroupDescription,
+			Ui::InputField::Mode::MultiLine,
+			rpl::single(Lower(placeholder)),
+			value)
+		: object_ptr<Ui::InputField>(
+			container,
+			st::defaultInputField,
+			rpl::single(Lower(placeholder)),
+			value));
+	Ui::AddSkip(container);
+	return result;
+}
+
+void RuleBox(
+		not_null<Ui::GenericBox*> box,
+		LinkRewriteRule rule,
+		bool existing,
+		Fn<void(std::optional<LinkRewriteRule>)> done) {
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(existing
+		? u"Edit rule"_q
+		: u"New rule"_q)));
+
+	const auto type = std::make_shared<Ui::RadioenumGroup<Type>>(rule.type);
+	box->addRow(object_ptr<Ui::Radioenum<Type>>(
+		box,
+		type,
+		Type::Domains,
+		Lower(u"Replace the domain"_q),
+		st::defaultBoxCheckbox));
+	Ui::AddSkip(box->verticalLayout());
+	box->addRow(object_ptr<Ui::Radioenum<Type>>(
+		box,
+		type,
+		Type::Pattern,
+		Lower(u"Pattern, for advanced rewrites"_q),
+		st::defaultBoxCheckbox));
+	Ui::AddSkip(box->verticalLayout());
+
+	const auto domains = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			box,
+			object_ptr<Ui::VerticalLayout>(box)));
+	const auto domainsInner = domains->entity();
+	const auto from = AddField(
+		domainsInner,
+		u"From, one domain per line"_q,
+		rule.from.join('\n'),
+		true);
+	const auto to = AddField(
+		domainsInner,
+		u"To, one domain per line"_q,
+		rule.to.join('\n'),
+		true);
+	domainsInner->add(object_ptr<Ui::FlatLabel>(
+		domainsInner,
+		Lower(u"Subdomains match too, www., m. and mobile. are dropped. "
+			"Only the domain changes, the rest of the link stays."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(domainsInner);
+	const auto pick = std::make_shared<Ui::RadiobuttonGroup>(
+		rule.random ? 0 : 1);
+	domainsInner->add(object_ptr<Ui::Radiobutton>(
+		domainsInner,
+		pick,
+		0,
+		Lower(u"Random replacement each time"_q),
+		st::defaultBoxCheckbox));
+	Ui::AddSkip(domainsInner);
+	domainsInner->add(object_ptr<Ui::Radiobutton>(
+		domainsInner,
+		pick,
+		1,
+		Lower(u"Always the first one"_q),
+		st::defaultBoxCheckbox));
+	Ui::AddSkip(domainsInner);
+
+	const auto pattern = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			box,
+			object_ptr<Ui::VerticalLayout>(box)));
+	const auto patternInner = pattern->entity();
+	const auto match = not_null<Ui::InputField*>(
+		patternInner->add(object_ptr<Ui::InputField>(
+			patternInner,
+			st::defaultInputField,
+			rpl::single(Lower(u"Match, a regular expression"_q)),
+			rule.match)));
+	const auto error = patternInner->add(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			patternInner,
+			object_ptr<Ui::FlatLabel>(
+				patternInner,
+				QString(),
+				st::boxAttentionDividerLabel)));
+	Ui::AddSkip(patternInner);
+	const auto replace = AddField(
+		patternInner,
+		u"Replace with"_q,
+		rule.replace);
+	patternInner->add(object_ptr<Ui::FlatLabel>(
+		patternInner,
+		Lower(u"The first match in the link is replaced. $1 to $9 insert "
+			"the groups, $0 the whole match, $$ a dollar sign."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(patternInner);
+
+	const auto test = not_null<Ui::InputField*>(
+		box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(Lower(u"Test a link"_q)),
+			QString())));
+	Ui::AddSkip(box->verticalLayout());
+	const auto result = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		QString(),
+		st::boxDividerLabel));
+
+	const auto collect = [=] {
+		auto current = LinkRewriteRule{
+			.enabled = rule.enabled,
+			.type = type->current(),
+		};
+		if (current.type == Type::Domains) {
+			current.from = ReadDomains(from->getLastText()).list;
+			current.to = ReadDomains(to->getLastText()).list;
+			current.random = (pick->current() == 0);
+		} else {
+			current.match = match->getLastText();
+			current.replace = replace->getLastText();
+		}
+		return current;
+	};
+	const auto refresh = [=] {
+		const auto current = collect();
+		const auto invalid = (current.type == Type::Pattern)
+			? LinkRewritePatternError(current.match)
+			: QString();
+		error->entity()->setText(invalid);
+		error->toggle(!invalid.isEmpty(), anim::type::instant);
+		if (invalid.isEmpty()) {
+			match->hideError();
+		} else {
+			match->showErrorNoFocus();
+		}
+		const auto url = test->getLastText().trimmed();
+		result->setText([&] {
+			if (url.isEmpty()) {
+				return Lower(u"Paste a link above to see what it turns into."_q);
+			} else if (!invalid.isEmpty()) {
+				return Lower(u"Fix the pattern first."_q);
+			}
+			const auto rewritten = RewriteLinkWith(current, url);
+			return !rewritten
+				? Lower(u"No match, the link stays as it is."_q)
+				: (*rewritten == url)
+				? Lower(u"Matches, but nothing changes."_q)
+				: (QString(QChar(0x2192)) + ' ' + *rewritten);
+		}());
+	};
+	for (const auto field : { from, to, match, replace, test }) {
+		field->changes() | rpl::on_next(refresh, field->lifetime());
+	}
+	const auto toggleSections = [=](Type value, anim::type animated) {
+		domains->toggle(value == Type::Domains, animated);
+		pattern->toggle(value == Type::Pattern, animated);
+	};
+	type->setChangedCallback([=](Type value) {
+		toggleSections(value, anim::type::normal);
+		refresh();
+	});
+	pick->setChangedCallback([=](int) {
+		refresh();
+	});
+	toggleSections(rule.type, anim::type::instant);
+	refresh();
+
+	const auto save = [=] {
+		const auto current = collect();
+		if (current.type == Type::Domains) {
+			const auto fromList = ReadDomains(from->getLastText());
+			const auto toList = ReadDomains(to->getLastText());
+			if (!fromList.valid || fromList.list.isEmpty()) {
+				from->showError();
+				return;
+			} else if (!toList.valid || toList.list.isEmpty()) {
+				to->showError();
+				return;
+			}
+		} else if (current.match.isEmpty()
+			|| !LinkRewritePatternError(current.match).isEmpty()) {
+			match->showError();
+			return;
+		}
+		done(current);
+		box->closeBox();
+	};
+	for (const auto field : { from, to, match, replace }) {
+		field->submits(
+		) | rpl::on_next([=](Qt::KeyboardModifiers) {
+			save();
+		}, field->lifetime());
+	}
+	box->setFocusCallback([=] {
+		((type->current() == Type::Domains) ? from : match)->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	if (existing) {
+		box->addLeftButton(tr::lng_box_delete(), [=] {
+			done(std::nullopt);
+			box->closeBox();
+		});
+	}
+}
+
+} // namespace
+
+void LinkRewritesBox(not_null<Ui::GenericBox*> box) {
+	struct State {
+		std::vector<LinkRewriteRule> rules;
+		base::unique_qptr<Ui::PopupMenu> menu;
+		bool toggling = false;
+	};
+	const auto state = box->lifetime().make_state<State>();
+	const auto show = box->uiShow();
+
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Link rewrites"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Links you paste into a message are rewritten by the first "
+			"matching rule, Ctrl+Z brings the original back. Opened links, "
+			"incoming messages and typed text stay as they are."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(box->verticalLayout());
+	const auto list = box->addRow(
+		object_ptr<Ui::VerticalLayout>(box),
+		style::margins());
+	const auto actions = box->addRow(
+		object_ptr<Ui::VerticalLayout>(box),
+		style::margins());
+
+	const auto apply = [=](std::vector<LinkRewriteRule> rules) {
+		SetLinkRewriteRules(rules);
+	};
+	const auto edit = [=](int index) {
+		const auto existing = (index >= 0)
+			&& (index < int(state->rules.size()));
+		const auto done = [=](std::optional<LinkRewriteRule> result) {
+			auto rules = state->rules;
+			if (existing && index < int(rules.size())) {
+				if (result) {
+					rules[index] = std::move(*result);
+				} else {
+					rules.erase(begin(rules) + index);
+				}
+			} else if (result) {
+				rules.push_back(std::move(*result));
+			}
+			apply(std::move(rules));
+		};
+		show->showBox(Box(
+			RuleBox,
+			existing ? state->rules[index] : LinkRewriteRule(),
+			existing,
+			crl::guard(box, done)));
+	};
+	const auto remove = [=](int index) {
+		auto rules = state->rules;
+		if (index >= 0 && index < int(rules.size())) {
+			rules.erase(begin(rules) + index);
+			apply(std::move(rules));
+		}
+	};
+	const auto showMenu = [=](int index) {
+		state->menu = base::make_unique_q<Ui::PopupMenu>(
+			box,
+			st::popupMenuWithIcons);
+		state->menu->addAction(Lower(u"Edit"_q), [=] {
+			edit(index);
+		}, &st::menuIconEdit);
+		state->menu->addAction(Lower(u"Delete"_q), [=] {
+			remove(index);
+		}, &st::menuIconDelete);
+		state->menu->popup(QCursor::pos());
+	};
+	const auto addRow = [=](int index) {
+		const auto &rule = state->rules[index];
+		const auto wrap = list->add(object_ptr<Ui::VerticalLayout>(list));
+		const auto button = Settings::AddButtonWithIcon(
+			wrap,
+			rpl::single(RuleTitle(rule)),
+			st::settingsButton,
+			{ (rule.type == Type::Domains)
+				? &st::menuIconLink
+				: &st::menuIconReplace });
+		auto padding = st::settingsButton.padding;
+		padding.setRight(padding.right() + st::rightsButtonToggleWidth);
+		button->setPaddingOverride(padding);
+		const auto [toggle, checkView] = Settings::AddSeparatedToggle(
+			button,
+			st::settingsButton,
+			rule.enabled);
+		toggle->clicks() | rpl::on_next([=, view = checkView] {
+			const auto enabled = !view->checked();
+			view->setChecked(enabled, anim::type::normal);
+			if (index < int(state->rules.size())) {
+				state->rules[index].enabled = enabled;
+				state->toggling = true;
+				apply(state->rules);
+				state->toggling = false;
+			}
+		}, toggle->lifetime());
+		button->setAcceptBoth(true);
+		button->clicks() | rpl::on_next([=](Qt::MouseButton which) {
+			if (which == Qt::RightButton) {
+				showMenu(index);
+			} else {
+				edit(index);
+			}
+		}, button->lifetime());
+	};
+	const auto rebuild = [=] {
+		list->clear();
+		if (state->rules.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"No rules yet. Add your own or start from a "
+						"preset."_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+			Ui::AddSkip(list);
+		}
+		for (auto i = 0; i != int(state->rules.size()); ++i) {
+			addRow(i);
+		}
+	};
+	LinkRewritesValue(
+	) | rpl::on_next([=](const QString &value) {
+		if (state->toggling) {
+			return;
+		}
+		state->rules = ParseLinkRewrites(value);
+		rebuild();
+	}, box->lifetime());
+
+	const auto addIcon = [] {
+		return Settings::IconDescriptor{
+			&st::settingsIconAdd,
+			Settings::IconType::Round,
+			&st::windowBgActive,
+		};
+	};
+	Settings::AddButtonWithIcon(
+		actions,
+		rpl::single(Lower(u"Add rule"_q)),
+		st::settingsButtonActive,
+		addIcon()
+	)->setClickedCallback([=] {
+		edit(-1);
+	});
+	Settings::AddButtonWithIcon(
+		actions,
+		rpl::single(Lower(u"Add preset"_q)),
+		st::settingsButtonActive,
+		addIcon()
+	)->setClickedCallback([=] {
+		state->menu = base::make_unique_q<Ui::PopupMenu>(
+			box,
+			st::popupMenuWithIcons);
+		for (const auto &preset : LinkRewritePresets()) {
+			const auto rule = preset.rule;
+			state->menu->addAction(Lower(preset.name), [=] {
+				auto rules = state->rules;
+				rules.push_back(rule);
+				apply(std::move(rules));
+			}, &st::menuIconLink);
+		}
+		state->menu->popup(QCursor::pos());
+	});
+
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace Tele
