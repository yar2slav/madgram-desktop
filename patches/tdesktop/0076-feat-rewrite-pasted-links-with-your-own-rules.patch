diff --git a/Telegram/SourceFiles/tele/tele_link_rewrites.cpp b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a061f12c6d784583569c883e2db54ff73c92b82a
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_link_rewrites.cpp
@@ -0,0 +1,654 @@
+#include "tele/tele_link_rewrites.h"
+
+#include "base/random.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/text/text_entity.h"
+#include "ui/toast/toast.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QMimeData>
+#include <QtCore/QRegularExpression>
+#include <QtCore/QUrl>
+#include <QtGui/QTextDocument>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxToastLines = 3;
+
+struct Compiled {
+	LinkRewriteRule rule;
+	QRegularExpression regex;
+};
+
+struct HostChange {
+	QString from;
+	QString to;
+
+	friend inline bool operator==(
+		const HostChange &,
+		const HostChange &) = default;
+};
+
+struct UrlRewrite {
+	int offset = 0;
+	int length = 0;
+	QString url;
+	QString result;
+};
+
+using Memo = base::flat_map<QString, std::optional<QString>>;
+
+[[nodiscard]] const QRegularExpression &HttpPrefix() {
+	static const auto result = QRegularExpression(
+		u"^https?://([^/?#@\\s]*@)?([^/?#:@\\s]+)"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	return result;
+}
+
+[[nodiscard]] bool IsHttpLink(QStringView url) {
+	return url.startsWith(u"http://"_q, Qt::CaseInsensitive)
+		|| url.startsWith(u"https://"_q, Qt::CaseInsensitive);
+}
+
+[[nodiscard]] QString AceHost(QString host) {
+	host = host.toLower();
+	while (host.endsWith('.')) {
+		host.chop(1);
+	}
+	const auto ace = QUrl::toAce(host);
+	return ace.isEmpty() ? host : QString::fromLatin1(ace).toLower();
+}
+
+[[nodiscard]] QString HostOf(const QString &url) {
+	const auto match = HttpPrefix().match(url);
+	return match.hasMatch() ? AceHost(match.captured(2)) : QString();
+}
+
+[[nodiscard]] QString ExpandTemplate(
+		const QString &replace,
+		const QRegularExpressionMatch &match) {
+	auto result = QString();
+	result.reserve(replace.size());
+	for (auto i = 0, count = int(replace.size()); i != count; ++i) {
+		const auto ch = replace[i];
+		if (ch == '$' && i + 1 < count) {
+			const auto next = replace[i + 1];
+			if (next == '$') {
+				result.append(ch);
+				++i;
+				continue;
+			} else if (next >= '0' && next <= '9') {
+				result.append(match.captured(next.unicode() - '0'));
+				++i;
+				continue;
+			}
+		}
+		result.append(ch);
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QString> ApplyDomains(
+		const LinkRewriteRule &rule,
+		const QString &url) {
+	const auto match = HttpPrefix().match(url);
+	if (!match.hasMatch() || rule.to.isEmpty()) {
+		return std::nullopt;
+	}
+	const auto host = AceHost(match.captured(2));
+	for (const auto &domain : rule.from) {
+		auto prefix = QString();
+		if (host == domain) {
+		} else if (host.endsWith('.' + domain)) {
+			prefix = host.left(host.size() - domain.size());
+		} else {
+			continue;
+		}
+		if (prefix == u"www."_q
+			|| prefix == u"m."_q
+			|| prefix == u"mobile."_q) {
+			prefix = QString();
+		}
+		const auto &target = rule.random
+			? rule.to[base::RandomIndex(rule.to.size())]
+			: rule.to.front();
+		return url.left(match.capturedStart(2))
+			+ prefix
+			+ target
+			+ url.mid(match.capturedEnd(2));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] std::optional<QString> ApplyPattern(
+		const QRegularExpression &regex,
+		const QString &replace,
+		const QString &url) {
+	if (!regex.isValid()) {
+		return std::nullopt;
+	}
+	const auto match = regex.match(url);
+	if (!match.hasMatch()) {
+		return std::nullopt;
+	}
+	return url.left(match.capturedStart(0))
+		+ ExpandTemplate(replace, match)
+		+ url.mid(match.capturedEnd(0));
+}
+
+[[nodiscard]] QStringList ParseDomains(const QJsonValue &value) {
+	auto result = QStringList();
+	const auto add = [&](const QString &entry) {
+		const auto domain = NormalizeRewriteDomain(entry);
+		if (domain && !result.contains(*domain)) {
+			result.push_back(*domain);
+		}
+	};
+	if (value.isArray()) {
+		for (const auto &entry : value.toArray()) {
+			add(entry.toString());
+		}
+	} else if (value.isString()) {
+		static const auto Separators = QRegularExpression(u"[\\s,]+"_q);
+		for (const auto &entry : value.toString().split(
+				Separators,
+				Qt::SkipEmptyParts)) {
+			add(entry);
+		}
+	}
+	return result;
+}
+
+// Rewrite targets that shut down, with the live service that replaces them.
+[[nodiscard]] QStringList ReplaceGoneTargets(QStringList targets) {
+	static const auto gone = base::flat_map<QString, QString>{
+		{ u"vxtiktok.com"_q, u"tnktok.com"_q },
+	};
+	auto result = QStringList();
+	for (const auto &target : targets) {
+		const auto i = gone.find(target);
+		const auto live = (i != end(gone)) ? i->second : target;
+		if (!result.contains(live)) {
+			result.push_back(live);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<LinkRewriteRule> ParseRule(
+		const QJsonObject &object) {
+	auto result = LinkRewriteRule{
+		.enabled = object.value(u"on"_q).toBool(true),
+	};
+	const auto type = object.value(u"type"_q).toString();
+	if (type == u"domains"_q) {
+		result.type = LinkRewriteType::Domains;
+		result.from = ParseDomains(object.value(u"from"_q));
+		result.to = ReplaceGoneTargets(
+			ParseDomains(object.value(u"to"_q)));
+		result.random = (object.value(u"pick"_q).toString() != u"first"_q);
+		if (result.from.isEmpty() || result.to.isEmpty()) {
+			return std::nullopt;
+		}
+	} else if (type == u"pattern"_q) {
+		result.type = LinkRewriteType::Pattern;
+		result.match = object.value(u"match"_q).toString();
+		result.replace = object.value(u"replace"_q).toString();
+		if (result.match.isEmpty()
+			|| !LinkRewritePatternError(result.match).isEmpty()) {
+			return std::nullopt;
+		}
+	} else {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] const std::vector<Compiled> &ActiveRules() {
+	static auto source = QString();
+	static auto ready = false;
+	static auto rules = std::vector<Compiled>();
+	const auto value = LinkRewrites();
+	if (!ready || source != value) {
+		ready = true;
+		source = value;
+		rules.clear();
+		for (auto &rule : ParseLinkRewrites(value)) {
+			if (!rule.enabled) {
+				continue;
+			}
+			auto regex = (rule.type == LinkRewriteType::Pattern)
+				? QRegularExpression(rule.match)
+				: QRegularExpression();
+			rules.push_back({ std::move(rule), std::move(regex) });
+		}
+	}
+	return rules;
+}
+
+[[nodiscard]] std::optional<QString> Rewrite(
+		const QString &url,
+		Memo &memo) {
+	if (const auto i = memo.find(url); i != memo.end()) {
+		return i->second;
+	}
+	auto result = std::optional<QString>();
+	for (const auto &compiled : ActiveRules()) {
+		const auto &rule = compiled.rule;
+		const auto rewritten = (rule.type == LinkRewriteType::Domains)
+			? ApplyDomains(rule, url)
+			: ApplyPattern(compiled.regex, rule.replace, url);
+		if (rewritten) {
+			if (!rewritten->isEmpty() && *rewritten != url) {
+				result = *rewritten;
+			}
+			break;
+		}
+	}
+	memo.emplace(url, result);
+	return result;
+}
+
+void AddChange(
+		std::vector<HostChange> &changes,
+		const QString &from,
+		const QString &to) {
+	const auto change = HostChange{ HostOf(from), HostOf(to) };
+	if (!ranges::contains(changes, change)) {
+		changes.push_back(change);
+	}
+}
+
+[[nodiscard]] bool InCode(
+		const TextWithTags::Tags &tags,
+		int from,
+		int till) {
+	for (const auto &tag : tags) {
+		if (tag.offset >= till || tag.offset + tag.length <= from) {
+			continue;
+		}
+		for (const auto &part : TextUtilities::SplitTags(tag.id)) {
+			if (part == Ui::InputField::kTagCode
+				|| part.startsWith(Ui::InputField::kTagPre)) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] int MapPosition(
+		int position,
+		int from,
+		int till,
+		int length,
+		bool start) {
+	if (start ? (position < from) : (position <= from)) {
+		return position;
+	} else if (position >= till) {
+		return position + length - (till - from);
+	}
+	return start ? from : (from + std::min(position - from, length));
+}
+
+void ReplaceText(
+		TextWithTags &text,
+		int offset,
+		int length,
+		const QString &with) {
+	const auto limit = std::min(length, int(with.size()));
+	auto prefix = 0;
+	while (prefix < limit && text.text[offset + prefix] == with[prefix]) {
+		++prefix;
+	}
+	auto suffix = 0;
+	while (suffix < limit - prefix
+		&& (text.text[offset + length - 1 - suffix]
+			== with[with.size() - 1 - suffix])) {
+		++suffix;
+	}
+	const auto from = offset + prefix;
+	const auto till = offset + length - suffix;
+	const auto middle = with.mid(prefix, with.size() - prefix - suffix);
+	text.text.replace(from, till - from, middle);
+	auto tags = TextWithTags::Tags();
+	tags.reserve(text.tags.size());
+	for (const auto &tag : text.tags) {
+		const auto start = MapPosition(
+			tag.offset,
+			from,
+			till,
+			middle.size(),
+			true);
+		const auto end = MapPosition(
+			tag.offset + tag.length,
+			from,
+			till,
+			middle.size(),
+			false);
+		if (end > start) {
+			tags.push_back({ start, end - start, tag.id });
+		}
+	}
+	text.tags = std::move(tags);
+}
+
+bool RewriteTags(
+		TextWithTags &text,
+		int from,
+		int till,
+		Memo &memo,
+		std::vector<HostChange> &changes) {
+	auto changed = false;
+	for (auto &tag : text.tags) {
+		if (tag.offset < from || tag.offset + tag.length > till) {
+			continue;
+		}
+		auto parts = TextUtilities::SplitTags(tag.id);
+		auto storage = std::vector<QString>();
+		storage.reserve(parts.size());
+		for (auto &part : parts) {
+			if (!IsHttpLink(part)
+				|| !Ui::InputField::IsValidMarkdownLink(part)) {
+				continue;
+			}
+			const auto url = part.toString();
+			if (const auto result = Rewrite(url, memo)) {
+				storage.push_back(*result);
+				part = storage.back();
+				AddChange(changes, url, *result);
+			}
+		}
+		if (!storage.empty()) {
+			tag.id = TextUtilities::JoinTag(parts);
+			changed = true;
+		}
+	}
+	return changed;
+}
+
+bool RewriteUrls(
+		TextWithTags &text,
+		int from,
+		int till,
+		Memo &memo,
+		std::vector<HostChange> &changes) {
+	auto parsed = TextWithEntities{ text.text.mid(from, till - from) };
+	TextUtilities::ParseEntities(parsed, TextParseLinks);
+	auto rewrites = std::vector<UrlRewrite>();
+	for (const auto &entity : parsed.entities) {
+		if (entity.type() != EntityType::Url) {
+			continue;
+		}
+		const auto offset = from + entity.offset();
+		const auto length = entity.length();
+		const auto url = text.text.mid(offset, length);
+		if (!IsHttpLink(url) || InCode(text.tags, offset, offset + length)) {
+			continue;
+		}
+		if (const auto result = Rewrite(url, memo)) {
+			AddChange(changes, url, *result);
+			rewrites.push_back({ offset, length, url, *result });
+		}
+	}
+	ranges::sort(rewrites, ranges::greater(), &UrlRewrite::offset);
+	for (const auto &rewrite : rewrites) {
+		ReplaceText(text, rewrite.offset, rewrite.length, rewrite.result);
+	}
+	return !rewrites.empty();
+}
+
+void ShowChangesToast(
+		not_null<Ui::InputField*> field,
+		const std::vector<HostChange> &changes) {
+	auto lines = QStringList();
+	for (const auto &change : changes) {
+		if (lines.size() == kMaxToastLines) {
+			break;
+		}
+		lines.push_back((change.from != change.to && !change.to.isEmpty())
+			? (change.from + ' ' + QChar(0x2192) + ' ' + change.to)
+			: Lower(u"Rewrote a %1 link"_q).arg(change.from));
+	}
+	if (!lines.isEmpty()) {
+		Ui::Toast::Show(field->window(), lines.join('\n'));
+	}
+}
+
+void RewritePasted(
+		not_null<Ui::InputField*> field,
+		int start,
+		int selected,
+		int before) {
+	const auto document = field->document();
+	const auto cursor = field->textCursor();
+	const auto end = cursor.position();
+	const auto after = document->characterCount();
+	if (cursor.hasSelection()
+		|| end <= start
+		|| (end - start) != (after - before + selected)
+		|| ActiveRules().empty()) {
+		return;
+	}
+	auto full = field->getTextWithTagsPart(0, -1);
+	const auto head = start
+		? int(field->getTextWithTagsPart(0, start).text.size())
+		: 0;
+	const auto pasted = field->getTextWithTagsPart(start, end).text;
+	const auto till = head + int(pasted.size());
+	if (full.text.mid(head, pasted.size()) != pasted) {
+		return;
+	}
+	auto memo = Memo();
+	auto changes = std::vector<HostChange>();
+	const auto tags = RewriteTags(full, head, till, memo, changes);
+	const auto urls = RewriteUrls(full, head, till, memo, changes);
+	if (!tags && !urls) {
+		return;
+	}
+	const auto tail = after - end;
+	field->setTextWithTags(full, Ui::InputField::HistoryAction::NewEntry);
+	field->setCursorPosition(document->characterCount() - tail);
+	field->ensureCursorVisible();
+	ShowChangesToast(field, changes);
+}
+
+void SchedulePasteRewrite(not_null<Ui::InputField*> field) {
+	if (ActiveRules().empty()) {
+		return;
+	}
+	const auto cursor = field->textCursor();
+	const auto start = cursor.selectionStart();
+	const auto selected = cursor.selectionEnd() - start;
+	const auto before = field->document()->characterCount();
+	crl::on_main(field.get(), [=] {
+		RewritePasted(field, start, selected, before);
+	});
+}
+
+[[nodiscard]] LinkRewriteRule DomainsPreset(
+		QStringList from,
+		QStringList to,
+		bool random) {
+	return {
+		.type = LinkRewriteType::Domains,
+		.from = std::move(from),
+		.to = std::move(to),
+		.random = random,
+	};
+}
+
+} // namespace
+
+std::vector<LinkRewriteRule> ParseLinkRewrites(const QString &value) {
+	auto result = std::vector<LinkRewriteRule>();
+	if (value.trimmed().isEmpty()) {
+		return result;
+	}
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(value.toUtf8(), &error);
+	if (error.error != QJsonParseError::NoError || !document.isArray()) {
+		return result;
+	}
+	for (const auto &entry : document.array()) {
+		if (!entry.isObject()) {
+			continue;
+		} else if (auto rule = ParseRule(entry.toObject())) {
+			result.push_back(std::move(*rule));
+		}
+	}
+	return result;
+}
+
+QString SerializeLinkRewrites(const std::vector<LinkRewriteRule> &rules) {
+	auto array = QJsonArray();
+	for (const auto &rule : rules) {
+		auto object = QJsonObject();
+		object.insert(u"on"_q, rule.enabled);
+		if (rule.type == LinkRewriteType::Domains) {
+			object.insert(u"type"_q, u"domains"_q);
+			object.insert(u"from"_q, QJsonArray::fromStringList(rule.from));
+			object.insert(u"to"_q, QJsonArray::fromStringList(rule.to));
+			object.insert(
+				u"pick"_q,
+				rule.random ? u"random"_q : u"first"_q);
+		} else {
+			object.insert(u"type"_q, u"pattern"_q);
+			object.insert(u"match"_q, rule.match);
+			object.insert(u"replace"_q, rule.replace);
+		}
+		array.push_back(object);
+	}
+	return QString::fromUtf8(
+		QJsonDocument(array).toJson(QJsonDocument::Compact));
+}
+
+std::vector<LinkRewriteRule> LinkRewriteRules() {
+	return ParseLinkRewrites(LinkRewrites());
+}
+
+void SetLinkRewriteRules(const std::vector<LinkRewriteRule> &rules) {
+	SetLinkRewrites(rules.empty() ? QString() : SerializeLinkRewrites(rules));
+}
+
+rpl::producer<int> LinkRewritesEnabledCountValue() {
+	return LinkRewritesValue() | rpl::map([](const QString &value) {
+		return int(ranges::count(
+			ParseLinkRewrites(value),
+			true,
+			&LinkRewriteRule::enabled));
+	});
+}
+
+const std::vector<LinkRewritePreset> &LinkRewritePresets() {
+	static const auto result = std::vector<LinkRewritePreset>{
+		{
+			u"X / Twitter"_q,
+			DomainsPreset(
+				{ u"x.com"_q, u"twitter.com"_q },
+				{
+					u"fixupx.com"_q,
+					u"fxtwitter.com"_q,
+					u"vxtwitter.com"_q,
+					u"fixvx.com"_q,
+					u"samekosabax.com"_q,
+				},
+				true),
+		},
+		{
+			u"Instagram"_q,
+			DomainsPreset(
+				{ u"instagram.com"_q },
+				{ u"ddinstagram.com"_q, u"kkinstagram.com"_q },
+				false),
+		},
+		{
+			u"TikTok"_q,
+			DomainsPreset(
+				{ u"tiktok.com"_q },
+				{ u"tnktok.com"_q },
+				false),
+		},
+		{
+			u"Reddit"_q,
+			DomainsPreset(
+				{ u"reddit.com"_q },
+				{ u"rxddit.com"_q, u"vxreddit.com"_q },
+				false),
+		},
+		{
+			u"Bluesky"_q,
+			DomainsPreset(
+				{ u"bsky.app"_q },
+				{ u"fxbsky.app"_q, u"bskx.app"_q },
+				false),
+		},
+		{
+			u"Pixiv"_q,
+			DomainsPreset({ u"pixiv.net"_q }, { u"phixiv.net"_q }, false),
+		},
+	};
+	return result;
+}
+
+std::optional<QString> NormalizeRewriteDomain(const QString &value) {
+	static const auto Scheme = QRegularExpression(
+		u"^[a-z][a-z0-9+.\\-]*://"_q);
+	static const auto Tail = QRegularExpression(u"[/?#]"_q);
+	static const auto Valid = QRegularExpression(
+		u"^(?:[a-z0-9](?:[a-z0-9\\-]*[a-z0-9])?\\.)+[a-z0-9\\-]{2,}$"_q);
+	auto result = value.trimmed().toLower();
+	result.remove(Scheme);
+	if (const auto index = result.indexOf(Tail); index >= 0) {
+		result = result.left(index);
+	}
+	if (const auto index = result.lastIndexOf('@'); index >= 0) {
+		result = result.mid(index + 1);
+	}
+	if (const auto index = result.indexOf(':'); index >= 0) {
+		result = result.left(index);
+	}
+	if (result.startsWith(u"*."_q)) {
+		result = result.mid(2);
+	}
+	result = AceHost(result);
+	if (!Valid.match(result).hasMatch()) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+QString LinkRewritePatternError(const QString &pattern) {
+	const auto regex = QRegularExpression(pattern);
+	return regex.isValid() ? QString() : regex.errorString();
+}
+
+std::optional<QString> RewriteLinkWith(
+		const LinkRewriteRule &rule,
+		const QString &url) {
+	if (!IsHttpLink(url)) {
+		return std::nullopt;
+	} else if (rule.type == LinkRewriteType::Domains) {
+		return ApplyDomains(rule, url);
+	}
+	return ApplyPattern(QRegularExpression(rule.match), rule.replace, url);
+}
+
+Ui::InputField::MimeDataHook WithLinkRewrites(
+		not_null<Ui::InputField*> field,
+		Ui::InputField::MimeDataHook hook) {
+	return [=](
+			not_null<const QMimeData*> data,
+			Ui::InputField::MimeAction action) {
+		if (action == Ui::InputField::MimeAction::Insert && data->hasText()) {
+			SchedulePasteRewrite(field);
+		}
+		return hook ? hook(data, action) : false;
+	};
+}
+
+} // namespace Tele
