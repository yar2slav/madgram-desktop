diff --git a/Telegram/SourceFiles/tele/tele_chat_dates.cpp b/Telegram/SourceFiles/tele/tele_chat_dates.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..841a9a5d3e17ad3eae15fae891cde6c122160f33
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_chat_dates.cpp
@@ -0,0 +1,40 @@
+#include "tele/tele_chat_dates.h"
+
+#include "base/unixtime.h"
+#include "data/data_channel.h"
+#include "data/data_chat.h"
+#include "lang/lang_keys.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] TimeId ChatDate(not_null<PeerData*> peer) {
+	if (const auto channel = peer->asChannel()) {
+		return channel->date;
+	} else if (const auto chat = peer->asChat()) {
+		return chat->date;
+	}
+	return 0;
+}
+
+} // namespace
+
+QString ChatDateLabel(not_null<PeerData*> peer) {
+	const auto channel = peer->asChannel();
+	return Tr((channel && channel->amIn()) ? u"You joined"_q : u"Created"_q);
+}
+
+rpl::producer<TextWithEntities> ChatDateTextValue(
+		not_null<PeerData*> peer) {
+	return ChatJoinDateValue() | rpl::map([=](bool shown) {
+		const auto date = shown ? ChatDate(peer) : TimeId();
+		return date
+			? TextWithEntities::Simple(
+				langDayOfMonthFull(base::unixtime::parse(date).date()))
+			: TextWithEntities();
+	});
+}
+
+} // namespace Tele
