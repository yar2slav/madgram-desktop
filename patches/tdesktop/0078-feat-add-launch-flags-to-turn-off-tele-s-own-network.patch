diff --git a/Telegram/SourceFiles/tele/tele_launch_flags.cpp b/Telegram/SourceFiles/tele/tele_launch_flags.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2cfeb8a0e62b814a4f46736070bda37921c7cea
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_launch_flags.cpp
@@ -0,0 +1,47 @@
+#include "tele/tele_launch_flags.h"
+
+namespace Tele {
+namespace {
+
+bool NoServer = false;
+bool NoUpdate = false;
+bool Offline = false;
+QStringList Arguments;
+
+} // namespace
+
+void ApplyLaunchFlags(const QMap<QByteArray, QStringList> &parsed) {
+	Offline = parsed.contains("-teleoffline");
+	NoServer = Offline || parsed.contains("-noteleserver");
+	NoUpdate = Offline || parsed.contains("-noteleupdate");
+	Arguments.clear();
+	for (const auto flag : { "-noteleserver", "-noteleupdate", "-teleoffline" }) {
+		if (parsed.contains(flag)) {
+			Arguments.push_back(QString::fromLatin1(flag));
+		}
+	}
+	if (NoServer || NoUpdate) {
+		LOG(("Tele: launch flags, server %1, updates %2, offline %3"
+			).arg(NoServer ? "off" : "on"
+			).arg(NoUpdate ? "off" : "on"
+			).arg(Offline ? "yes" : "no"));
+	}
+}
+
+bool ServerOffForLaunch() {
+	return NoServer;
+}
+
+bool UpdatesOffForLaunch() {
+	return NoUpdate;
+}
+
+bool OfflineForLaunch() {
+	return Offline;
+}
+
+QStringList LaunchFlagArguments() {
+	return Arguments;
+}
+
+} // namespace Tele
