index 0000000000000000000000000000000000000000..fe79dde3e9d6f18f6949a77a5eca54e904438436
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_edit_history.cpp
@@ -0,0 +1,342 @@
+#include "tele/tele_edit_history.h"
+
+#include "base/unixtime.h"
+#include "core/ui_integration.h"
+#include "data/data_document.h"
+#include "data/data_groups.h"
+#include "data/data_media_types.h"
+#include "data/data_photo.h"
+#include "data/data_poll.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/window_session_controller.h"
+#include "styles/style_layers.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+struct Version {
+	EditContent content;
+	TimeId date = 0;
+	bool original = false;
+};
+
+struct Record {
+	std::vector<Version> versions;
+	TimeId since = 0;
+	bool original = false;
+};
+
+struct SessionState {
+	base::flat_map<not_null<const HistoryItem*>, Record> records;
+	rpl::lifetime lifetime;
+};
+
+struct State {
+	State();
+
+	base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<SessionState>> sessions;
+	rpl::lifetime lifetime;
+};
+
+struct Entry {
+	QString header;
+	TextWithEntities text;
+};
+
+[[nodiscard]] State &Get() {
+	static State state;
+	return state;
+}
+
+State::State() {
+	EditHistoryValue(
+	) | rpl::on_next([=](bool enabled) {
+		if (!enabled) {
+			sessions.clear();
+		}
+	}, lifetime);
+}
+
+[[nodiscard]] SessionState &Sessions(not_null<Main::Session*> session) {
+	auto &sessions = Get().sessions;
+	const auto i = sessions.find(session);
+	if (i != end(sessions)) {
+		return *i->second;
+	}
+	const auto state = sessions.emplace(
+		session,
+		std::make_unique<SessionState>()).first->second.get();
+	session->data().itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		state->records.remove(item);
+	}, state->lifetime);
+	session->lifetime().add([=] {
+		Get().sessions.remove(session);
+	});
+	return *state;
+}
+
+[[nodiscard]] Record *FindRecord(not_null<const HistoryItem*> item) {
+	auto &sessions = Get().sessions;
+	const auto session = not_null<Main::Session*>(
+		&item->history()->session());
+	const auto i = sessions.find(session);
+	if (i == end(sessions)) {
+		return nullptr;
+	}
+	auto &records = i->second->records;
+	const auto j = records.find(item);
+	return (j != end(records)) ? &j->second : nullptr;
+}
+
+[[nodiscard]] QString DocumentDescription(not_null<DocumentData*> document) {
+	if (document->isVideoMessage()) {
+		return u"video message"_q;
+	} else if (document->isVoiceMessage()) {
+		return u"voice message"_q;
+	} else if (document->sticker()) {
+		return u"sticker"_q;
+	} else if (document->isAnimation()) {
+		return u"GIF"_q;
+	} else if (document->isVideoFile()) {
+		return u"video"_q;
+	}
+	const auto name = document->filename();
+	return !name.isEmpty()
+		? name
+		: document->isAudioFile()
+		? u"audio"_q
+		: u"file"_q;
+}
+
+[[nodiscard]] EditContent Read(not_null<const HistoryItem*> item) {
+	auto result = EditContent{ .text = item->originalText() };
+	const auto media = item->media();
+	if (!media || media->webpage()) {
+		return result;
+	} else if (const auto photo = media->photo()) {
+		result.media = u"photo"_q;
+		result.mediaId = photo->id;
+	} else if (const auto document = media->document()) {
+		result.media = DocumentDescription(document);
+		result.mediaId = document->id;
+	} else if (const auto poll = media->poll()) {
+		result.media = u"poll"_q;
+		result.mediaId = poll->id;
+	} else if (media->location()) {
+		result.media = u"location"_q;
+	} else if (media->sharedContact()) {
+		result.media = u"contact"_q;
+	} else if (media->todolist()) {
+		result.media = u"checklist"_q;
+	} else {
+		result.media = u"media"_q;
+	}
+	return result;
+}
+
+[[nodiscard]] bool SameMedia(const EditContent &a, const EditContent &b) {
+	return (a.media == b.media) && (a.mediaId == b.mediaId);
+}
+
+[[nodiscard]] bool Same(const EditContent &a, const EditContent &b) {
+	return SameMedia(a, b) && (a.text == b.text);
+}
+
+[[nodiscard]] TimeId EditDate(not_null<const HistoryItem*> item) {
+	const auto edited = item->Get<HistoryMessageEdited>();
+	return edited ? edited->date : TimeId();
+}
+
+[[nodiscard]] Record *Versions(not_null<const HistoryItem*> item) {
+	if (!EditHistory()) {
+		return nullptr;
+	}
+	const auto record = FindRecord(item);
+	if (!record) {
+		return nullptr;
+	}
+	const auto current = Read(item);
+	auto &versions = record->versions;
+	while (!versions.empty() && Same(versions.back().content, current)) {
+		record->since = versions.back().date;
+		record->original = versions.back().original;
+		versions.pop_back();
+	}
+	return versions.empty() ? nullptr : record;
+}
+
+[[nodiscard]] HistoryItem *FindTarget(not_null<HistoryItem*> item) {
+	if (Versions(item)) {
+		return item;
+	}
+	const auto group = item->history()->owner().groups().find(item);
+	if (group) {
+		for (const auto &part : group->items) {
+			if (Versions(part)) {
+				return part;
+			}
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] QString FormatDate(TimeId date) {
+	const auto parsed = base::unixtime::parse(date);
+	const auto time = parsed.time().toString(u"HH:mm:ss"_q);
+	return (parsed.date() == QDate::currentDate())
+		? time
+		: (QLocale().toString(parsed.date(), QLocale::ShortFormat)
+			+ QChar(' ')
+			+ time);
+}
+
+[[nodiscard]] std::vector<Entry> Entries(
+		not_null<const HistoryItem*> item,
+		const Record &record) {
+	auto list = record.versions;
+	list.push_back({
+		.content = Read(item),
+		.date = record.since,
+		.original = record.original,
+	});
+	auto result = std::vector<Entry>();
+	result.reserve(list.size());
+	for (auto i = 0, count = int(list.size()); i != count; ++i) {
+		const auto &version = list[i];
+		const auto &content = version.content;
+		const auto date = FormatDate(version.date);
+		auto header = (i + 1 < count)
+			? (version.original
+				? u"Original, %1"_q.arg(date)
+				: u"Edited %1"_q.arg(date))
+			: (version.original
+				? u"Current, original, %1"_q.arg(date)
+				: u"Current, edited %1"_q.arg(date));
+		const auto mediaChanged = (i > 0
+				&& !SameMedia(list[i - 1].content, content))
+			|| (i + 1 < count
+				&& !SameMedia(list[i + 1].content, content));
+		if (!content.media.isEmpty()
+			&& (content.text.empty() || mediaChanged)) {
+			header += u" \u00B7 "_q + content.media;
+		}
+		result.push_back({
+			.header = std::move(header),
+			.text = content.text,
+		});
+	}
+	return result;
+}
+
+void EditHistoryBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		std::vector<Entry> entries) {
+	box->setTitle(rpl::single(u"Edit history"_q));
+	box->setWidth(st::boxWideWidth);
+	const auto padding = style::margins(
+		st::boxRowPadding.left(),
+		st::defaultSubsectionTitlePadding.top(),
+		st::boxRowPadding.right(),
+		st::defaultSubsectionTitlePadding.bottom());
+	for (const auto &entry : entries) {
+		box->addRow(
+			object_ptr<Ui::FlatLabel>(
+				box,
+				entry.header,
+				st::defaultSubsectionTitle),
+			padding);
+		if (!entry.text.empty()) {
+			const auto label = box->addRow(
+				object_ptr<Ui::FlatLabel>(
+					box,
+					rpl::single(entry.text),
+					st::boxLabel,
+					st::defaultPopupMenu,
+					Core::TextContext({ .session = session })));
+			label->setSelectable(true);
+		}
+	}
+	box->addSkip(st::boxLittleSkip);
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace
+
+EditCapture::EditCapture(not_null<HistoryItem*> item) {
+	if (!EditHistory() || item->isService() || item->isEditingMedia()) {
+		return;
+	}
+	_item = item;
+	_before = Read(item);
+	_editDate = EditDate(item);
+}
+
+EditCapture::~EditCapture() {
+	if (!_item || !EditHistory() || _item->isService()) {
+		return;
+	}
+	const auto item = not_null<HistoryItem*>(_item);
+	if (Same(_before, Read(item))) {
+		return;
+	}
+	auto &records = Sessions(&item->history()->session()).records;
+	auto i = records.find(item);
+	if (i == end(records)) {
+		i = records.emplace(item, Record{
+			.since = _editDate ? _editDate : item->date(),
+			.original = !_editDate,
+		}).first;
+	}
+	auto &record = i->second;
+	record.versions.push_back({
+		.content = std::move(_before),
+		.date = record.since,
+		.original = record.original,
+	});
+	const auto editDate = EditDate(item);
+	record.since = (editDate > 0 && editDate != _editDate)
+		? editDate
+		: base::unixtime::now();
+	record.original = false;
+}
+
+void AddEditHistoryAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionNavigation*> navigation,
+		HistoryItem *item) {
+	const auto target = item ? FindTarget(item) : nullptr;
+	if (!target) {
+		return;
+	}
+	const auto session = &target->history()->session();
+	const auto itemId = target->fullId();
+	const auto controller = navigation->parentController();
+	menu->addAction(u"Edit history"_q, [=] {
+		const auto item = session->data().message(itemId);
+		const auto record = item ? Versions(item) : nullptr;
+		if (record) {
+			controller->show(Box(
+				EditHistoryBox,
+				session,
+				Entries(item, *record)));
+		}
+	}, &st::menuIconGroupLog);
+}
+
+} // namespace Tele
