+#pragma once
+
+#include "ui/text/text_entity.h"
+
+class HistoryItem;
+
+namespace Ui {
+class PopupMenu;
+} // namespace Ui
+
+namespace Window {
+class SessionNavigation;
+} // namespace Window
+
+namespace Tele {
+
+struct EditContent {
+	TextWithEntities text;
+	QString media;
+	uint64 mediaId = 0;
+};
+
+class EditCapture final {
+public:
+	explicit EditCapture(not_null<HistoryItem*> item);
+	EditCapture(const EditCapture &) = delete;
+	EditCapture &operator=(const EditCapture &) = delete;
+	~EditCapture();
+
+private:
+	HistoryItem *_item = nullptr;
+	EditContent _before;
+	TimeId _editDate = 0;
+
+};
+
+void AddEditHistoryAction(
+	not_null<Ui::PopupMenu*> menu,
+	not_null<Window::SessionNavigation*> navigation,
+	HistoryItem *item);
+
+} // namespace Tele
