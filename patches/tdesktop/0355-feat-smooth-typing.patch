-	_closingAsyncWindows.remove(window);
-	for (auto i = begin(_windows); i != end(_windows);) {
-		if (i->second.get() == window) {
-			Assert(_lastActiveWindow != window);
-			Assert(_lastActivePrimaryWindow != window);
-			Assert(_windowInSettings != window);
-			i = _windows.erase(i);
-		} else {
-			++i;
-		}
