-	if (entry.text == u"custom"_q) {
-		if (!SetCustomIcon(slot, QString(), entry.image)) {
-			return;
-		}
-	} else if (CurrentText(spec) != entry.text) {
-		SetIconPreset(slot, entry.text);
-	}
