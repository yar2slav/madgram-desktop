+	rpl::merge(
+		settings().systemDarkModeChanges() | rpl::to_empty,
+		settings().systemDarkModeEnabledChanges() | rpl::to_empty
+	) | rpl::on_next([=] {
+		checkSystemDarkMode();
+	}, _lifetime);
+}
