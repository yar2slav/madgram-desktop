+void Parser::skip(const Spec &spec, const QString &reason) {
+	_result.skipped.push_back({ QString::fromLatin1(spec.id), reason });
+}
+
+void Parser::add(const Spec &spec, SettingsImportEntry entry) {
+	entry.id = QString::fromLatin1(spec.id);
+	_result.entries.push_back(std::move(entry));
+}
+
+void Parser::parse(const Spec &spec, const QJsonValue &value) {
+	if (spec.kind == Kind::Internal) {
+		skip(spec, Tr(u"Internal state, never imported."_q));
+	} else if (spec.kind == Kind::Toggle) {
+		if (!value.isBool()) {
+			skip(spec, Tr(u"Expected on or off."_q));
+		} else {
+			add(spec, { .group = spec.group, .flag = value.toBool() });
+		}
+	} else if (!value.isString()) {
+		skip(spec, Tr(u"Expected text."_q));
+	} else {
+		parseText(spec, value.toString());
+	}
+}
+
+void Parser::parseText(const Spec &spec, const QString &value) {
+	const auto text = [&](QString text) {
+		add(spec, { .group = spec.group, .text = std::move(text) });
+	};
+	switch (spec.kind) {
+	case Kind::Choice:
+		if (spec.choices.contains(value)) {
+			text(value);
+		} else {
+			skip(spec, Tr(u"Unknown value \"%1\"."_q).arg(value));
+		}
+		return;
+	case Kind::Title:
+	case Kind::WindowTitle: {
+		const auto errors = Titles::Parse(
+			value,
+			(spec.kind == Kind::WindowTitle)).errors;
+		if (errors.isEmpty()) {
+			text(value);
+		} else {
+			skip(spec, errors.front());
+		}
+	} return;
+	case Kind::MenuLayouts:
+		if (const auto layouts = NormalizeMenuLayouts(value)) {
+			text(*layouts);
+		} else {
+			skip(spec, Tr(u"No known menus."_q));
+		}
+		return;
+	case Kind::ServerUrl:
+		if (const auto url = NormalizeServerUrl(value)) {
+			text(*url);
+		} else {
+			skip(spec, Tr(u"Not an https address."_q));
+		}
+		return;
+	case Kind::LinkRewrites: parseLinkRewrites(spec, value); return;
+	case Kind::AppLinks: parseAppLinks(spec, value); return;
+	case Kind::AppIcon:
+	case Kind::TrayIcon: parseIcon(spec, value); return;
+	case Kind::List: parseList(spec, value); return;
+	case Kind::Lines:
+	case Kind::Plain: text(spec.normalize(value)); return;
+	case Kind::Backgrounds: parseBackgrounds(spec, value); return;
+	case Kind::Toggle:
+	case Kind::Internal: break;
+	}
+	Unexpected("Kind in Tele::Parser::parseText.");
+}
+
+void Parser::checkCount(const Spec &spec, int was, int now, QString what) {
+	if (now < was) {
+		skip(spec, Tr(u"%1 of %2 %3 were invalid or repeated and were dropped."_q)
+			.arg(was - now)
+			.arg(was)
+			.arg(Tr(what)));
+	}
+}
+
+void Parser::parseList(const Spec &spec, const QString &value) {
+	const auto normalized = spec.normalize(value);
+	const auto was = CountParts(value);
+	const auto now = CountParts(normalized);
+	if (was > 0 && !now) {
+		skip(spec, Tr(u"No valid entries."_q));
+		return;
+	}
+	checkCount(spec, was, now, u"entries"_q);
+	add(spec, { .group = spec.group, .text = normalized });
+}
+
+void Parser::parseBackgrounds(const Spec &spec, const QString &value) {
+	auto files = base::flat_map<QString, QByteArray>();
+	for (const auto &name : ChatBackgroundFiles(value)) {
+		if (SafeFileName(name)) {
+			auto image = DecodeImage(_backgrounds.value(name));
+			if (!image.isEmpty()) {
+				files.emplace(name, std::move(image));
+			}
+		}
+	}
+	const auto normalized = NormalizeChatBackgrounds(value, HasFile(files));
+	const auto was = CountParts(value);
+	const auto now = CountParts(normalized);
+	if (was > 0 && !now) {
+		skip(spec, Tr(u"No valid backgrounds, images may be missing."_q));
+		return;
+	}
+	checkCount(spec, was, now, u"backgrounds"_q);
+	const auto used = ChatBackgroundFiles(normalized);
+	for (auto i = begin(files); i != end(files);) {
+		if (used.contains(i->first)) {
+			++i;
+		} else {
+			i = files.erase(i);
+		}
+	}
+	add(spec, {
+		.group = spec.group,
+		.text = normalized,
+		.files = std::move(files),
+	});
+}
+
+void Parser::parseLinkRewrites(const Spec &spec, const QString &value) {
+	if (value.trimmed().isEmpty()) {
+		add(spec, { .group = spec.group });
+		return;
+	}
+	const auto document = QJsonDocument::fromJson(value.toUtf8());
+	if (!document.isArray()) {
+		skip(spec, Tr(u"Not a list of rules."_q));
+		return;
+	}
+	const auto rules = ParseLinkRewrites(value);
+	if (rules.empty()) {
+		skip(spec, Tr(u"No valid rules."_q));
+		return;
+	}
+	checkCount(spec, document.array().size(), int(rules.size()), u"rules"_q);
+	add(spec, { .group = spec.group, .text = SerializeLinkRewrites(rules) });
+}
+
+void Parser::parseAppLinks(const Spec &spec, const QString &value) {
+	if (value.trimmed().isEmpty()) {
+		return;
+	}
+	const auto document = QJsonDocument::fromJson(value.toUtf8());
+	if (!document.isObject()) {
+		skip(spec, Tr(u"Not a list of link apps."_q));
+		return;
+	}
+	auto settings = QJsonObject();
+	auto device = QJsonObject();
+	const auto object = document.object();
+	const auto &services = AppLinkServices();
+	for (auto i = object.begin(); i != object.end(); ++i) {
+		if (!ranges::contains(services, i.key(), &AppLinkService::id)) {
+			++_result.unknown;
+			continue;
+		}
+		const auto choice = i.value().toString();
+		const auto group = AppLinkGroup(choice);
+		if (!group) {
+			skip(spec, Tr(u"Unknown choice for %1."_q).arg(i.key()));
+		} else {
+			((*group == SettingsGroup::Device) ? device : settings).insert(
+				i.key(),
+				choice);
+		}
+	}
+	if (!settings.isEmpty()) {
+		add(spec, {
+			.group = SettingsGroup::Settings,
+			.text = Compact(settings),
+		});
+	}
+	if (!device.isEmpty()) {
+		add(spec, { .group = SettingsGroup::Device, .text = Compact(device) });
+	}
+}
+
+void Parser::parseIcon(const Spec &spec, const QString &value) {
+	const auto custom = u"custom"_q;
+	const auto allowed = (spec.kind == Kind::AppIcon)
+		? QStringList{ QString(), custom, u"red"_q, u"white"_q, u"telegram"_q }
+		: QStringList{ QString(), custom, u"default"_q,
+			u"red"_q, u"white"_q, u"telegram"_q };
+	if (!allowed.contains(value)) {
+		skip(spec, Tr(u"Unknown value \"%1\"."_q).arg(value));
+		return;
+	}
+	auto image = QByteArray();
+	if (value == custom) {
+		image = DecodeImage(_icons.value((spec.kind == Kind::AppIcon)
+			? u"app"_q
+			: u"tray"_q));
+		if (image.isEmpty()) {
+			skip(spec, Tr(u"The image is missing or broken."_q));
+			return;
+		}
+	}
+	add(spec, {
+		.group = spec.group,
+		.text = value,
+		.image = std::move(image),
+	});
+}
+
+} // namespace
+
+QByteArray ExportSettings(SettingsGroups groups) {
+	LogUnclassified();
+	auto options = QJsonObject();
+	auto icons = QJsonObject();
+	auto backgrounds = QJsonObject();
+	for (const auto &spec : Specs()) {
+		const auto id = QString::fromLatin1(spec.id);
+		if (spec.kind == Kind::Internal) {
+			continue;
+		} else if (spec.kind == Kind::AppLinks) {
+			const auto value = ExportAppLinks(groups);
+			if (!value.isEmpty()) {
+				options.insert(id, value);
+			}
+			continue;
+		} else if (!(groups & spec.group)) {
+			continue;
+		} else if (spec.kind == Kind::Toggle) {
+			options.insert(id, CurrentFlag(spec));
+			continue;
+		}
+		auto value = CurrentText(spec);
+		if (spec.kind == Kind::AppIcon || spec.kind == Kind::TrayIcon) {
+			if (value == u"custom"_q) {
+				const auto bytes = CustomIconContent(Slot(spec));
+				if (bytes.isEmpty()) {
+					value = QString();
+				} else {
+					icons.insert(
+						(spec.kind == Kind::AppIcon) ? u"app"_q : u"tray"_q,
+						Encode(bytes));
+				}
+			}
+		} else if (spec.kind == Kind::List || spec.kind == Kind::Lines) {
+			value = spec.normalize(value);
+		} else if (spec.kind == Kind::Backgrounds) {
+			value = NormalizeChatBackgrounds(value, HasFile({}));
+			ExportBackgrounds(value, backgrounds);
+		}
+		if (spec.group == SettingsGroup::People && value.isEmpty()) {
+			continue;
+		}
+		options.insert(id, value);
+	}
+	auto names = QJsonArray();
+	for (const auto group : {
+			SettingsGroup::Settings,
+			SettingsGroup::People,
+			SettingsGroup::Device }) {
+		if (groups & group) {
+			names.push_back(GroupKey(group));
+		}
+	}
+	auto root = QJsonObject();
+	root.insert(u"format"_q, QString::fromLatin1(kFormat));
+	root.insert(u"version"_q, kVersion);
+	root.insert(u"tele"_q, u"%1 (Telegram Desktop %2)"_q.arg(
+		TitleLabel(),
+		QString::fromLatin1(AppVersionStr)));
+	root.insert(u"build"_q, BuildNumber());
+	root.insert(u"exported"_q, QDateTime::currentSecsSinceEpoch());
+	root.insert(u"groups"_q, names);
+	root.insert(u"options"_q, options);
+	if (!icons.isEmpty()) {
+		root.insert(u"icons"_q, icons);
+	}
+	if (!backgrounds.isEmpty()) {
+		root.insert(u"backgrounds"_q, backgrounds);
+	}
+	return QJsonDocument(root).toJson(QJsonDocument::Indented);
+}
+
+SettingsImport ParseSettings(const QByteArray &data) {
+	auto result = SettingsImport();
+	const auto fail = [&](const QString &error) {
+		result.error = error;
+		return std::move(result);
+	};
+	if (data.size() > kMaxSize) {
+		return fail(Tr(u"The file is too big."_q));
+	}
+	auto bytes = data.trimmed();
+	if (bytes.startsWith("\xEF\xBB\xBF")) {
+		bytes = bytes.mid(3);
+	}
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(bytes, &error);
+	const auto root = document.object();
+	if (error.error != QJsonParseError::NoError
+		|| !document.isObject()
+		|| root.value(u"format"_q).toString() != QLatin1String(kFormat)) {
+		return fail(Tr(u"This isn't a tele settings file."_q));
+	}
+	result.version = root.value(u"version"_q).toInt();
+	if (result.version < 1) {
+		return fail(Tr(u"Unknown settings file version."_q));
+	}
+	result.newer = (result.version > kVersion);
+	result.tele = root.value(u"tele"_q).toString();
+	result.exported = qint64(root.value(u"exported"_q).toDouble());
+	const auto options = root.value(u"options"_q).toObject();
+	const auto icons = root.value(u"icons"_q).toObject();
+	const auto backgrounds = root.value(u"backgrounds"_q).toObject();
+	auto parser = Parser(result, icons, backgrounds);
+	for (const auto &spec : Specs()) {
+		const auto i = options.find(QString::fromLatin1(spec.id));
+		if (i != options.end()) {
+			parser.parse(spec, *i);
+		}
+	}
+	for (auto i = options.begin(); i != options.end(); ++i) {
+		if (!FindSpec(i.key())) {
+			++result.unknown;
+		}
+	}
+	if (result.entries.empty()
+		&& result.skipped.empty()
+		&& !result.unknown) {
+		return fail(Tr(u"There are no settings in this file."_q));
+	}
+	return result;
+}
+
+int CountImportEntries(const SettingsImport &data, SettingsGroup group) {
+	return int(ranges::count(
+		data.entries,
+		group,
+		&SettingsImportEntry::group));
+}
+
+SettingsChanges CountSettingsChanges(
+		const SettingsImport &data,
+		SettingsGroups groups) {
+	auto result = SettingsChanges();
+	auto texts = base::flat_map<QString, QString>();
+	for (const auto &entry : data.entries) {
+		const auto spec = FindSpec(entry.id);
+		if (!spec || !(groups & entry.group)) {
+			continue;
+		}
+		auto changed = false;
+		if (spec->kind == Kind::Toggle) {
+			changed = (entry.flag != CurrentFlag(*spec));
+		} else if (spec->kind == Kind::AppIcon
+			|| spec->kind == Kind::TrayIcon) {
+			changed = IconChanges(*spec, entry);
+		} else {
+			const auto i = texts.find(entry.id);
+			const auto current = (i != end(texts))
+				? i->second
+				: CurrentText(*spec);
+			const auto next = NextText(*spec, entry, current);
+			texts[entry.id] = next;
+			changed = (next != current);
+		}
+		if (changed) {
+			++result.count;
+			result.restart = result.restart || RestartRequired(*spec);
+		}
+	}
+	return result;
+}
+
+SettingsChanges ApplySettings(
+		const SettingsImport &data,
+		SettingsGroups groups) {
+	auto result = SettingsChanges();
+	const auto draftsBefore = LocalDrafts();
+	for (const auto &entry : data.entries) {
+		const auto spec = FindSpec(entry.id);
+		if (!spec || !(groups & entry.group)) {
+			continue;
+		}
+		auto changed = false;
+		if (spec->kind == Kind::Toggle) {
+			auto &option = base::options::lookup<bool>(spec->id);
+			changed = (option.value() != entry.flag);
+			if (changed) {
+				option.set(entry.flag);
+			}
+		} else if (spec->kind == Kind::AppIcon
+			|| spec->kind == Kind::TrayIcon) {
+			changed = IconChanges(*spec, entry);
+			if (changed) {
+				ApplyIcon(*spec, entry);
+			}
+		} else {
+			if (spec->kind == Kind::Backgrounds) {
+				WriteFiles(entry.files);
+			}
+			const auto current = CurrentText(*spec);
+			const auto next = NextText(*spec, entry, current);
+			changed = (next != current);
+			if (changed) {
+				SetText(*spec, next);
+			}
+		}
+		if (changed) {
+			++result.count;
+			result.restart = result.restart || RestartRequired(*spec);
+		}
+	}
+	if (!draftsBefore && LocalDrafts()) {
+		PersistLocalDrafts();
+	}
+	return result;
+}
+
+QString SettingName(const QString &id) {
+	const auto spec = FindSpec(id);
+	if (!spec || spec->kind == Kind::Internal) {
+		return id;
+	}
+	const auto &name = base::options::details::Lookup(spec->id).name();
+	return name.isEmpty() ? id : Tr(name);
+}
+
+std::vector<QString> SettingIds() {
+	auto result = std::vector<QString>();
+	for (const auto &spec : Specs()) {
+		if (spec.kind != Kind::Internal) {
+			result.push_back(QString::fromLatin1(spec.id));
+		}
+	}
+	return result;
+}
+
+namespace {
+
+[[nodiscard]] SettingInfo Info(const Spec &spec) {
+	const auto &option = base::options::details::Lookup(spec.id);
+	auto result = SettingInfo{
+		.id = QString::fromLatin1(spec.id),
+		.name = option.name(),
+		.description = option.description(),
+		.kind = (spec.kind == Kind::Toggle)
+			? u"toggle"_q
+			: (spec.kind == Kind::Choice)
+			? u"choice"_q
+			: u"text"_q,
+		.choices = spec.choices,
+		.restartRequired = option.restartRequired(),
+		.group = spec.group,
+	};
+	if (spec.kind == Kind::Toggle) {
+		result.flag = CurrentFlag(spec);
+	} else {
+		result.text = CurrentText(spec);
+	}
+	return result;
+}
+
+} // namespace
+
+std::vector<SettingInfo> SettingsList() {
+	auto result = std::vector<SettingInfo>();
+	for (const auto &spec : Specs()) {
+		if (spec.kind != Kind::Internal) {
+			result.push_back(Info(spec));
+		}
+	}
+	return result;
+}
+
+std::optional<SettingInfo> FindSetting(const QString &id) {
+	const auto spec = FindSpec(id);
+	return (spec && spec->kind != Kind::Internal)
+		? std::make_optional(Info(*spec))
+		: std::nullopt;
+}
+
+QString ChangeSetting(
+		const QString &id,
+		const QJsonValue &value,
+		bool &restart) {
+	const auto spec = FindSpec(id);
+	if (!spec || spec->kind == Kind::Internal) {
+		return u"Unknown setting %1."_q.arg(id);
+	}
+	auto data = SettingsImport();
+	const auto empty = QJsonObject();
+	auto parser = Parser(data, empty, empty);
+	parser.parse(*spec, value);
+	if (!data.skipped.empty()) {
+		return data.skipped.front().reason;
+	}
+	restart = ApplySettings(
+		data,
+		SettingsGroup::Settings
+			| SettingsGroup::People
+			| SettingsGroup::Device).restart;
+	return QString();
+}
+
+rpl::producer<QString> SettingChanges() {
+	return rpl::make_producer<QString>([](auto consumer) {
+		auto lifetime = rpl::lifetime();
+		for (const auto &spec : Specs()) {
+			if (spec.kind == Kind::Internal) {
+				continue;
+			}
+			const auto id = QString::fromLatin1(spec.id);
+			base::options::details::Lookup(
+				spec.id
+			).changes() | rpl::on_next([=] {
+				consumer.put_next_copy(id);
+			}, lifetime);
+		}
+		return lifetime;
+	});
+}
+
+} // namespace Tele
