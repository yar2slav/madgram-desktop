-
-	if (_lastActivePrimaryWindow == window) {
-		_lastActivePrimaryWindow = next;
-	}
-	if (_windowInSettings == window) {
-		_windowInSettings = next;
-	}
-	if (stackIt != end(_windowStack)) {
-		_windowStack.erase(stackIt);
