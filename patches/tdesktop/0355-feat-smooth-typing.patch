-void Parser::parse(const Spec &spec, const QJsonValue &value) {
-	if (spec.kind == Kind::Internal) {
-		skip(spec, Tr(u"Internal state, never imported."_q));
-	} else if (spec.kind == Kind::Toggle) {
-		if (!value.isBool()) {
-			skip(spec, Tr(u"Expected on or off."_q));
-		} else {
-			add(spec, { .group = spec.group, .flag = value.toBool() });
-		}
-	} else if (!value.isString()) {
-		skip(spec, Tr(u"Expected text."_q));
-	} else {
-		parseText(spec, value.toString());
-	}
-}
-
-void Parser::parseText(const Spec &spec, const QString &value) {
-	const auto text = [&](QString text) {
-		add(spec, { .group = spec.group, .text = std::move(text) });
-	};
-	switch (spec.kind) {
-	case Kind::Choice:
-		if (spec.choices.contains(value)) {
-			text(value);
-		} else {
-			skip(spec, Tr(u"Unknown value \"%1\"."_q).arg(value));
-		}
-		return;
-	case Kind::Title:
-	case Kind::WindowTitle: {
-		const auto errors = Titles::Parse(
-			value,
-			(spec.kind == Kind::WindowTitle)).errors;
-		if (errors.isEmpty()) {
-			text(value);
-		} else {
-			skip(spec, errors.front());
-		}
-	} return;
-	case Kind::MenuLayouts:
-		if (const auto layouts = NormalizeMenuLayouts(value)) {
-			text(*layouts);
-		} else {
-			skip(spec, Tr(u"No known menus."_q));
-		}
-		return;
-	case Kind::ServerUrl:
-		if (const auto url = NormalizeServerUrl(value)) {
-			text(*url);
-		} else {
-			skip(spec, Tr(u"Not an https address."_q));
-		}
-		return;
-	case Kind::LinkRewrites: parseLinkRewrites(spec, value); return;
-	case Kind::AppLinks: parseAppLinks(spec, value); return;
-	case Kind::AppIcon:
-	case Kind::TrayIcon: parseIcon(spec, value); return;
-	case Kind::List: parseList(spec, value); return;
-	case Kind::Lines:
-	case Kind::Plain: text(spec.normalize(value)); return;
-	case Kind::Backgrounds: parseBackgrounds(spec, value); return;
-	case Kind::Toggle:
-	case Kind::Internal: break;
-	}
-	Unexpected("Kind in Tele::Parser::parseText.");
-}
-
-void Parser::checkCount(const Spec &spec, int was, int now, QString what) {
-	if (now < was) {
-		skip(spec, Tr(u"%1 of %2 %3 were invalid or repeated and were dropped."_q)
-			.arg(was - now)
-			.arg(was)
-			.arg(Tr(what)));
-	}
-}
-
-void Parser::parseList(const Spec &spec, const QString &value) {
-	const auto normalized = spec.normalize(value);
-	const auto was = CountParts(value);
-	const auto now = CountParts(normalized);
-	if (was > 0 && !now) {
-		skip(spec, Tr(u"No valid entries."_q));
-		return;
-	}
-	checkCount(spec, was, now, u"entries"_q);
-	add(spec, { .group = spec.group, .text = normalized });
-}
-
-void Parser::parseBackgrounds(const Spec &spec, const QString &value) {
-	auto files = base::flat_map<QString, QByteArray>();
-	for (const auto &name : ChatBackgroundFiles(value)) {
-		if (SafeFileName(name)) {
-			auto image = DecodeImage(_backgrounds.value(name));
-			if (!image.isEmpty()) {
-				files.emplace(name, std::move(image));
-			}
-		}
-	}
-	const auto normalized = NormalizeChatBackgrounds(value, HasFile(files));
-	const auto was = CountParts(value);
-	const auto now = CountParts(normalized);
-	if (was > 0 && !now) {
-		skip(spec, Tr(u"No valid backgrounds, images may be missing."_q));
-		return;
-	}
-	checkCount(spec, was, now, u"backgrounds"_q);
-	const auto used = ChatBackgroundFiles(normalized);
-	for (auto i = begin(files); i != end(files);) {
-		if (used.contains(i->first)) {
-			++i;
-		} else {
-			i = files.erase(i);
-		}
-	}
-	add(spec, {
-		.group = spec.group,
-		.text = normalized,
-		.files = std::move(files),
-	});
-}
-
-void Parser::parseLinkRewrites(const Spec &spec, const QString &value) {
-	if (value.trimmed().isEmpty()) {
-		add(spec, { .group = spec.group });
-		return;
-	}
-	const auto document = QJsonDocument::fromJson(value.toUtf8());
-	if (!document.isArray()) {
-		skip(spec, Tr(u"Not a list of rules."_q));
-		return;
-	}
-	const auto rules = ParseLinkRewrites(value);
-	if (rules.empty()) {
-		skip(spec, Tr(u"No valid rules."_q));
-		return;
-	}
-	checkCount(spec, document.array().size(), int(rules.size()), u"rules"_q);
-	add(spec, { .group = spec.group, .text = SerializeLinkRewrites(rules) });
-}
-
-void Parser::parseAppLinks(const Spec &spec, const QString &value) {
-	if (value.trimmed().isEmpty()) {
-		return;
-	}
-	const auto document = QJsonDocument::fromJson(value.toUtf8());
-	if (!document.isObject()) {
-		skip(spec, Tr(u"Not a list of link apps."_q));
-		return;
-	}
-	auto settings = QJsonObject();
-	auto device = QJsonObject();
-	const auto object = document.object();
-	const auto &services = AppLinkServices();
-	for (auto i = object.begin(); i != object.end(); ++i) {
-		if (!ranges::contains(services, i.key(), &AppLinkService::id)) {
-			++_result.unknown;
-			continue;
-		}
-		const auto choice = i.value().toString();
-		const auto group = AppLinkGroup(choice);
-		if (!group) {
-			skip(spec, Tr(u"Unknown choice for %1."_q).arg(i.key()));
-		} else {
-			((*group == SettingsGroup::Device) ? device : settings).insert(
-				i.key(),
-				choice);
-		}
-	}
-	if (!settings.isEmpty()) {
-		add(spec, {
-			.group = SettingsGroup::Settings,
-			.text = Compact(settings),
-		});
-	}
-	if (!device.isEmpty()) {
-		add(spec, { .group = SettingsGroup::Device, .text = Compact(device) });
-	}
-}
-
-void Parser::parseIcon(const Spec &spec, const QString &value) {
-	const auto custom = u"custom"_q;
-	const auto allowed = (spec.kind == Kind::AppIcon)
-		? QStringList{ QString(), custom, u"red"_q, u"white"_q, u"telegram"_q }
-		: QStringList{ QString(), custom, u"default"_q,
-			u"red"_q, u"white"_q, u"telegram"_q };
-	if (!allowed.contains(value)) {
-		skip(spec, Tr(u"Unknown value \"%1\"."_q).arg(value));
-		return;
-	}
-	auto image = QByteArray();
-	if (value == custom) {
-		image = DecodeImage(_icons.value((spec.kind == Kind::AppIcon)
-			? u"app"_q
-			: u"tray"_q));
-		if (image.isEmpty()) {
-			skip(spec, Tr(u"The image is missing or broken."_q));
-			return;
-		}
-	}
-	add(spec, {
-		.group = spec.group,
-		.text = value,
-		.image = std::move(image),
-	});
-}
