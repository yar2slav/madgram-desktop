+[[nodiscard]] const Spec *FindSpec(const QString &id) {
+	const auto &specs = Specs();
+	const auto i = ranges::find_if(specs, [&](const Spec &spec) {
+		return (id == QLatin1String(spec.id));
+	});
+	return (i != end(specs)) ? &*i : nullptr;
+}
+
+[[nodiscard]] QString GroupKey(SettingsGroup group) {
+	switch (group) {
+	case SettingsGroup::Settings: return u"settings"_q;
+	case SettingsGroup::People: return u"people"_q;
+	case SettingsGroup::Device: return u"device"_q;
+	}
+	Unexpected("Group in Tele::GroupKey.");
+}
+
+[[nodiscard]] bool CurrentFlag(const Spec &spec) {
+	return base::options::lookup<bool>(spec.id).value();
+}
+
+[[nodiscard]] QString CurrentText(const Spec &spec) {
+	return spec.get
+		? spec.get()
+		: base::options::lookup<QString>(spec.id).value();
+}
+
+void SetText(const Spec &spec, const QString &value) {
+	if (spec.set) {
+		spec.set(value);
+	} else {
+		base::options::lookup<QString>(spec.id).set(value);
+	}
+}
+
+[[nodiscard]] bool RestartRequired(const Spec &spec) {
+	return base::options::details::Lookup(spec.id).restartRequired();
+}
+
+[[nodiscard]] QString Compact(const QJsonObject &object) {
+	return object.isEmpty()
+		? QString()
+		: QString::fromUtf8(
+			QJsonDocument(object).toJson(QJsonDocument::Compact));
+}
+
+[[nodiscard]] QJsonObject ParseObject(const QString &value) {
+	const auto document = QJsonDocument::fromJson(value.toUtf8());
+	return document.isObject() ? document.object() : QJsonObject();
+}
+
+[[nodiscard]] QString Encode(const QByteArray &bytes) {
+	return QString::fromLatin1(bytes.toBase64());
+}
+
+[[nodiscard]] QByteArray DecodeImage(const QJsonValue &value) {
+	if (!value.isString()) {
+		return QByteArray();
+	}
+	const auto decoded = QByteArray::fromBase64Encoding(
+		value.toString().toLatin1(),
+		QByteArray::AbortOnBase64DecodingErrors);
+	return (decoded && !QImage::fromData(decoded.decoded).isNull())
+		? decoded.decoded
+		: QByteArray();
+}
+
+[[nodiscard]] QByteArray ReadFile(const QString &path) {
+	auto file = QFile(path);
+	return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+}
+
+[[nodiscard]] bool SafeFileName(const QString &name) {
+	static const auto Regex = QRegularExpression(
+		u"^[A-Za-z0-9_\\-]{1,128}\\.(png|jpg)$"_q);
+	return Regex.match(name).hasMatch();
+}
+
+[[nodiscard]] int CountParts(const QString &value) {
+	return int(ranges::count_if(
+		value.split(QChar(','), Qt::SkipEmptyParts),
+		[](const QString &part) { return !part.trimmed().isEmpty(); }));
+}
+
+[[nodiscard]] Fn<bool(const QString&)> HasFile(
+		base::flat_map<QString, QByteArray> files) {
+	return [files = std::move(files)](const QString &name) {
+		return SafeFileName(name)
+			&& (files.contains(name)
+				|| QFile::exists(ChatBackgroundFilePath(name)));
+	};
+}
+
+[[nodiscard]] const QString &BrowserChoice() {
+	static const auto result = u"browser"_q;
+	return result;
+}
+
+[[nodiscard]] std::optional<SettingsGroup> AppLinkGroup(
+		const QString &value) {
+	if (value == BrowserChoice()) {
+		return SettingsGroup::Settings;
+	}
+	switch (ParseAppLinkChoice(value).mode) {
+	case AppLinkMode::Default:
+	case AppLinkMode::Site: return SettingsGroup::Settings;
+	case AppLinkMode::App:
+	case AppLinkMode::Custom: return SettingsGroup::Device;
+	case AppLinkMode::Browser: break;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QString ExportAppLinks(SettingsGroups groups) {
+	auto object = QJsonObject();
+	for (const auto &service : AppLinkServices()) {
+		const auto choice = AppLinkChoiceFor(service.id);
+		const auto value = (choice.mode == AppLinkMode::Browser)
+			? BrowserChoice()
+			: SerializeAppLinkChoice(choice);
+		const auto group = AppLinkGroup(value);
+		if (group && (groups & *group)) {
+			object.insert(service.id, value);
+		}
+	}
+	return Compact(object);
+}
+
+[[nodiscard]] QString MergeAppLinks(
+		const QString &current,
+		const QString &imported) {
+	auto object = ParseObject(current);
+	const auto incoming = ParseObject(imported);
+	for (auto i = incoming.begin(); i != incoming.end(); ++i) {
+		const auto value = i.value().toString();
+		const auto group = AppLinkGroup(value);
+		if (!group) {
+			continue;
+		} else if (*group == SettingsGroup::Device) {
+			object.insert(i.key(), value);
+			continue;
+		}
+		const auto now = object.value(i.key()).toString();
+		if (AppLinkGroup(now) == SettingsGroup::Device) {
+			continue;
+		} else if (value == BrowserChoice()) {
+			object.remove(i.key());
+		} else {
+			object.insert(i.key(), value);
+		}
+	}
+	return Compact(object);
+}
+
+[[nodiscard]] QString NextText(
+		const Spec &spec,
+		const SettingsImportEntry &entry,
+		const QString &current) {
+	switch (spec.kind) {
+	case Kind::List:
+		return spec.normalize(current + QChar(',') + entry.text);
+	case Kind::Lines:
+		return spec.normalize(current + QChar('\n') + entry.text);
+	case Kind::Backgrounds:
+		return NormalizeChatBackgrounds(
+			current + QChar(',') + entry.text,
+			HasFile(entry.files));
+	case Kind::AppLinks:
+		return MergeAppLinks(current, entry.text);
+	default:
+		return entry.text;
+	}
+}
+
+[[nodiscard]] IconSlot Slot(const Spec &spec) {
+	return (spec.kind == Kind::AppIcon) ? IconSlot::App : IconSlot::Tray;
+}
+
+[[nodiscard]] bool IconChanges(
+		const Spec &spec,
+		const SettingsImportEntry &entry) {
+	return (entry.text != CurrentText(spec))
+		|| (entry.text == u"custom"_q
+			&& entry.image != CustomIconContent(Slot(spec)));
+}
+
+void ApplyIcon(const Spec &spec, const SettingsImportEntry &entry) {
+	const auto slot = Slot(spec);
+	if (entry.text == u"custom"_q) {
+		if (!SetCustomIcon(slot, QString(), entry.image)) {
+			return;
+		}
+	} else if (CurrentText(spec) != entry.text) {
+		SetIconPreset(slot, entry.text);
+	}
+}
+
+void WriteFiles(const base::flat_map<QString, QByteArray> &files) {
+	for (const auto &[name, bytes] : files) {
+		const auto path = ChatBackgroundFilePath(name);
+		if (ReadFile(path) == bytes) {
+			continue;
+		}
+		QDir().mkpath(QFileInfo(path).absolutePath());
+		auto file = QFile(path);
+		if (!file.open(QIODevice::WriteOnly)
+			|| file.write(bytes) != bytes.size()) {
+			LOG(("Tele Settings Error: Could not write '%1'.").arg(path));
+		}
+	}
+}
+
+void LogUnclassified() {
+	const auto changed = QJsonDocument::fromJson(
+		base::options::serialize().toUtf8()).object();
+	for (auto i = changed.begin(); i != changed.end(); ++i) {
+		if (i.key().startsWith(u"tele-"_q) && !FindSpec(i.key())) {
+			LOG(("Tele Settings: '%1' is not classified for export."
+				).arg(i.key()));
+		}
+	}
+}
+
+void ExportBackgrounds(const QString &value, QJsonObject &files) {
+	for (const auto &name : ChatBackgroundFiles(value)) {
+		if (!SafeFileName(name)) {
+			continue;
+		}
+		const auto bytes = ReadFile(ChatBackgroundFilePath(name));
+		if (!bytes.isEmpty()) {
+			files.insert(name, Encode(bytes));
+		}
+	}
+}
