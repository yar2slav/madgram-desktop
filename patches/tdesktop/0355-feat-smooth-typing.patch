-[[nodiscard]] std::optional<SettingsGroup> AppLinkGroup(
-		const QString &value) {
-	if (value == BrowserChoice()) {
-		return SettingsGroup::Settings;
-	}
-	switch (ParseAppLinkChoice(value).mode) {
-	case AppLinkMode::Default:
-	case AppLinkMode::Site: return SettingsGroup::Settings;
-	case AppLinkMode::App:
-	case AppLinkMode::Custom: return SettingsGroup::Device;
-	case AppLinkMode::Browser: break;
-	}
-	return std::nullopt;
-}
