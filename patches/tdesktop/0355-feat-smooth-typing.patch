+#include "tele/tele_smooth_typing.h"
+
+#include "base/timer.h"
+#include "tele/tele_options.h"
+#include "ui/effects/animations.h"
+#include "ui/widgets/fields/input_field.h"
+#include "styles/style_widgets.h"
+
+#include <QtCore/QPointer>
+#include <QtGui/QAbstractTextDocumentLayout>
+#include <QtGui/QPainter>
+#include <QtGui/QTextCursor>
+#include <QtGui/QTextDocument>
+#include <QtWidgets/QApplication>
+#include <QtWidgets/QScrollBar>
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+constexpr auto kGlideDuration = crl::time(110);
+constexpr auto kFadeDuration = crl::time(160);
+constexpr auto kMaxFadedCharacters = 2;
+constexpr auto kAttachedProperty = "mad_smooth_caret";
+
+class SmoothCaret final : public QWidget {
+public:
+	explicit SmoothCaret(not_null<QTextEdit*> edit)
+	: QWidget(edit->viewport())
+	, _edit(edit.get())
+	, _width(std::max(edit->cursorWidth(), 1))
+	, _blink([=] { toggleBlink(); })
+	, _fading([=](crl::time now) { return fadeStep(now); }) {
+		if (const auto field = dynamic_cast<Ui::InputField*>(edit->parentWidget())) {
+			_background = field->st().textBg->c;
+		}
+		setAttribute(Qt::WA_TransparentForMouseEvents);
+		setAttribute(Qt::WA_NoSystemBackground);
+		setAttribute(Qt::WA_TranslucentBackground);
+		edit->setCursorWidth(0);
+		edit->setProperty(kAttachedProperty, true);
+		edit->installEventFilter(this);
+		edit->viewport()->installEventFilter(this);
+		connect(edit, &QTextEdit::cursorPositionChanged, this, [=] {
+			move(true);
+		});
+		connect(edit, &QTextEdit::textChanged, this, [=] {
+			QMetaObject::invokeMethod(this, [=] { move(true); }, Qt::QueuedConnection);
+		});
+		connect(edit->document(), &QTextDocument::contentsChange, this, [=](int position, int removed, int added) {
+			if (removed || added < 1 || added > kMaxFadedCharacters || !edit->hasFocus()) {
+				return;
+			}
+			QMetaObject::invokeMethod(this, [=] { fadeIn(position, added); }, Qt::QueuedConnection);
+		});
+		connect(edit->verticalScrollBar(), &QScrollBar::valueChanged, this, [=] {
+			move(false);
+		});
+		connect(edit->horizontalScrollBar(), &QScrollBar::valueChanged, this, [=] {
+			move(false);
+		});
+		connect(edit->document()->documentLayout(), &QAbstractTextDocumentLayout::documentSizeChanged, this, [=] {
+			move(false);
+		});
+		setGeometry(edit->viewport()->rect());
+		raise();
+		show();
+		move(false);
+	}
+
+	~SmoothCaret() {
+		if (const auto edit = _edit.data()) {
+			edit->setCursorWidth(_width);
+			edit->setProperty(kAttachedProperty, QVariant());
+		}
+	}
+
+protected:
+	bool eventFilter(QObject *watched, QEvent *e) override {
+		const auto edit = _edit.data();
+		if (!edit) {
+			return false;
+		} else if (watched == edit->viewport() && e->type() == QEvent::Resize) {
+			setGeometry(edit->viewport()->rect());
+			move(false);
+		} else if (watched == edit
+			&& (e->type() == QEvent::FocusIn || e->type() == QEvent::FocusOut)) {
+			restartBlink();
+		}
+		return false;
+	}
+
+	void paintEvent(QPaintEvent *e) override {
+		const auto edit = _edit.data();
+		if (!edit) {
+			return;
+		}
+		auto p = QPainter(this);
+		const auto now = crl::now();
+		for (const auto &fade : _fades) {
+			const auto progress = std::clamp((now - fade.start) / float64(kFadeDuration), 0., 1.);
+			auto color = _background;
+			color.setAlphaF(1. - anim::easeOutCubic(1., progress));
+			p.fillRect(fade.rect, color);
+		}
+		if (!edit->hasFocus() || edit->isReadOnly() || !_shown) {
+			return;
+		}
+		p.fillRect(current(), edit->palette().color(QPalette::Text));
+	}
+
+private:
+	[[nodiscard]] QRectF current() const {
+		const auto progress = _glide.value(1.);
+		const auto mix = [&](qreal from, qreal to) {
+			return from + (to - from) * progress;
+		};
+		return QRectF(
+			mix(_from.x(), _to.x()),
+			mix(_from.y(), _to.y()),
+			_width,
+			mix(_from.height(), _to.height()));
+	}
+
+	void move(bool animated) {
+		const auto edit = _edit.data();
+		if (!edit) {
+			return;
+		}
+		const auto target = QRectF(edit->cursorRect());
+		if (_placed && target == _to) {
+			restartBlink();
+			return;
+		} else if (animated && _placed) {
+			_from = current();
+			_to = target;
+			_glide.stop();
+			_glide.start([=] { update(); }, 0., 1., kGlideDuration, anim::easeOutCubic);
+		} else {
+			_glide.stop();
+			_from = _to = target;
+			_placed = true;
+		}
+		restartBlink();
+	}
+
+	void restartBlink() {
+		_shown = true;
+		const auto period = QApplication::cursorFlashTime() / 2;
+		if (period > 0) {
+			_blink.callEach(period);
+		} else {
+			_blink.cancel();
+		}
+		update();
+	}
+
+	void toggleBlink() {
+		_shown = !_shown;
+		update();
+	}
+
+	void fadeIn(int position, int added) {
+		const auto edit = _edit.data();
+		if (!edit || _background.alpha() < 255) {
+			return;
+		}
+		auto cursor = QTextCursor(edit->document());
+		cursor.setPosition(position);
+		const auto from = edit->cursorRect(cursor);
+		cursor.setPosition(position + added);
+		const auto till = edit->cursorRect(cursor);
+		if (from.top() != till.top() || till.x() <= from.x()) {
+			return;
+		}
+		_fades.push_back({
+			.rect = QRectF(from.x(), from.y(), till.x() - from.x(), from.height()),
+			.start = crl::now(),
+		});
+		if (!_fading.animating()) {
+			_fading.start();
+		}
+		update();
+	}
+
+	bool fadeStep(crl::time now) {
+		_fades.erase(
+			ranges::remove_if(_fades, [&](const Fade &fade) {
+				return now - fade.start >= kFadeDuration;
+			}),
+			end(_fades));
+		update();
+		return !_fades.empty();
+	}
+
+	QPointer<QTextEdit> _edit;
+	int _width = 1;
+	QRectF _from;
+	QRectF _to;
+	bool _placed = false;
+	bool _shown = true;
+	Ui::Animations::Simple _glide;
+	base::Timer _blink;
+	struct Fade {
+		QRectF rect;
+		crl::time start = 0;
+	};
+	std::vector<Fade> _fades;
+	QColor _background;
+	Ui::Animations::Basic _fading;
+
+};
+
+class FocusWatcher final : public QObject {
+public:
+	FocusWatcher() : QObject(qApp) {
+		qApp->installEventFilter(this);
+		if (const auto focused = QApplication::focusWidget()) {
+			attach(focused);
+		}
+	}
+
+	~FocusWatcher() {
+		for (const auto &caret : _carets) {
+			delete caret.data();
+		}
+	}
+
+protected:
+	bool eventFilter(QObject *watched, QEvent *e) override {
+		if (e->type() == QEvent::FocusIn && watched->isWidgetType()) {
+			attach(static_cast<QWidget*>(watched));
+		}
+		return false;
+	}
+
+private:
+	void attach(not_null<QWidget*> widget) {
+		const auto edit = qobject_cast<QTextEdit*>(widget.get());
+		if (!edit
+			|| edit->property(kAttachedProperty).toBool()
+			|| !dynamic_cast<Ui::InputField*>(edit->parentWidget())) {
+			return;
+		}
+		_carets.erase(
+			ranges::remove_if(_carets, [](const QPointer<SmoothCaret> &caret) {
+				return !caret;
+			}),
+			end(_carets));
+		_carets.push_back(new SmoothCaret(edit));
+	}
+
+	std::vector<QPointer<SmoothCaret>> _carets;
+
+};
+
+} // namespace
+
+void StartSmoothTyping() {
+	static auto lifetime = rpl::lifetime();
+	static auto watcher = QPointer<FocusWatcher>();
+	SmoothTypingValue(
+	) | rpl::on_next([](bool enabled) {
+		if (!enabled) {
+			delete watcher.data();
+		} else if (!watcher) {
+			watcher = new FocusWatcher();
+		}
+	}, lifetime);
+}
+
+} // namespace Tele
