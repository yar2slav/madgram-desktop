-[[nodiscard]] QByteArray DecodeImage(const QJsonValue &value) {
-	if (!value.isString()) {
-		return QByteArray();
-	}
-	const auto decoded = QByteArray::fromBase64Encoding(
-		value.toString().toLatin1(),
-		QByteArray::AbortOnBase64DecodingErrors);
-	return (decoded && !QImage::fromData(decoded.decoded).isNull())
-		? decoded.decoded
-		: QByteArray();
-}
