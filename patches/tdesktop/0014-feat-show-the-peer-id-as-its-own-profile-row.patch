index 0000000000000000000000000000000000000000..bceff86574c906665766197febbcc10019224135
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_peer_id.cpp
@@ -0,0 +1,103 @@
+#include "tele/tele_peer_id.h"
+
+#include "data/data_peer.h"
+#include "lang/lang_tag.h"
+#include "tele/tele_options.h"
+#include "ui/text/text_utilities.h"
+#include "ui/toast/toast.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/window_session_controller.h"
+#include "styles/style_chat_helpers.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kLinkIndex = uint16(1);
+constexpr auto kChannelShift = int64(1000000000000LL);
+
+class PeerIdClickHandler final : public ClickHandler {
+public:
+	PeerIdClickHandler(QString id, Fn<void()> copy)
+	: _id(std::move(id))
+	, _copy(std::move(copy)) {
+	}
+
+	void onClick(ClickContext context) const override {
+		if (context.button == Qt::LeftButton) {
+			_copy();
+		}
+	}
+	QString dragText() const override {
+		return _id;
+	}
+
+private:
+	const QString _id;
+	const Fn<void()> _copy;
+
+};
+
+[[nodiscard]] rpl::producer<QString> PeerIdValue(not_null<PeerData*> peer) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		PeerIdFormatChanges()
+	) | rpl::map([=] {
+		return FormatPeerId(peer);
+	});
+}
+
+} // namespace
+
+QString FormatPeerId(not_null<PeerData*> peer) {
+	const auto bare = int64(peer->id.value & PeerId::kChatTypeMask);
+	const auto id = !BotApiPeerIds()
+		? bare
+		: peer->isChat()
+		? -bare
+		: peer->isChannel()
+		? -(kChannelShift + bare)
+		: bare;
+	return PeerIdsWithoutSpaces()
+		? QString::number(id)
+		: Lang::FormatCountDecimal(id);
+}
+
+rpl::producer<TextWithEntities> PeerIdTextValue(not_null<PeerData*> peer) {
+	return PeerIdValue(peer) | rpl::map([](const QString &id) {
+		return Ui::Text::Link(id, kLinkIndex);
+	});
+}
+
+void SetupPeerIdLabel(
+		not_null<Ui::FlatLabel*> label,
+		not_null<PeerData*> peer,
+		not_null<Window::SessionController*> controller) {
+	const auto weak = base::make_weak(controller);
+	const auto copy = [=] {
+		TextUtilities::SetClipboardText({ FormatPeerId(peer) });
+		if (const auto strong = weak.get()) {
+			strong->showToast({
+				.text = { u"ID copied to clipboard."_q },
+				.iconLottie = u"toast/copy"_q,
+				.iconLottieSize = st::toastLottieIconSize,
+			});
+		}
+	};
+	PeerIdValue(peer) | rpl::on_next([=](const QString &id) {
+		label->setLink(
+			kLinkIndex,
+			std::make_shared<PeerIdClickHandler>(id, copy));
+	}, label->lifetime());
+	label->setContextMenuHook([=](
+			Ui::FlatLabel::ContextMenuRequest request) {
+		if (request.selection.empty()) {
+			request.menu->addAction(u"Copy ID"_q, copy);
+		} else {
+			label->fillContextMenu(request);
+		}
+	});
+}
+
+} // namespace Tele
