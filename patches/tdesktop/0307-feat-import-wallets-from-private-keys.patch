+
+void CopySecret(const QString &text) {
+	const auto windows = [](const char *name) {
+		return u"application/x-qt-windows-mime;value=\"%1\""_q.arg(
+			QString::fromLatin1(name));
+	};
+	auto data = std::make_unique<QMimeData>();
+	data->setText(text);
+	data->setData(
+		windows("ExcludeClipboardContentFromMonitorProcessing"),
+		QByteArray(1, '\0'));
+	data->setData(
+		windows("CanIncludeInClipboardHistory"),
+		QByteArray(4, '\0'));
+	data->setData(
+		windows("CanUploadToCloudClipboard"),
+		QByteArray(4, '\0'));
+	data->setData(u"x-kde-passwordManagerHint"_q, "secret");
+	QGuiApplication::clipboard()->setMimeData(data.release());
+	base::call_delayed(kClipboardClearDelay, qApp, [=] {
+		const auto clipboard = QGuiApplication::clipboard();
+		if (clipboard->text() == text) {
+			clipboard->clear();
+		}
+	});
+}
