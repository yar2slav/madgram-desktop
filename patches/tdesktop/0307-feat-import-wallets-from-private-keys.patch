+WalletKeyImport AddWalletKeyImport(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		not_null<Ui::SlideWrap<Ui::VerticalLayout>*> words,
+		not_null<Ui::SettingsSlider*> toggle,
+		std::vector<QString> sections,
+		Fn<void()> submit,
+		Fn<void()> changed) {
+	struct State {
+		rpl::variable<bool> active = false;
+		rpl::variable<QString> address;
+		rpl::variable<QString> status;
+		int wordSection = 0;
+	};
+	const auto state = box->lifetime().make_state<State>();
+	const auto keySection = int(sections.size());
+
+	const auto keyWrap = box->verticalLayout()->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			box->verticalLayout(),
+			object_ptr<Ui::VerticalLayout>(box->verticalLayout())),
+		style::margins(),
+		style::al_justify);
+	const auto inner = keyWrap->entity();
+	const auto field = inner->add(
+		object_ptr<Ui::InputField>(
+			inner,
+			KeyFieldStyle(),
+			Ui::InputField::Mode::MultiLine,
+			rpl::single(Lower(u"Private key, or address and 12 words"_q))),
+		st::walletImportFieldMargin);
+	field->setSubmitSettings(Ui::InputField::SubmitSettings::Enter);
+	AddGreyLine(inner, rpl::single(Lower(u"Only this key can restore "
+		"this wallet; Telegram backup doesn't keep it."_q)));
+	const auto preview = inner->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			inner,
+			object_ptr<Ui::VerticalLayout>(inner)),
+		style::margins(),
+		style::al_justify);
+	AddGreyLine(preview->entity(), rpl::single(Lower(u"Wallet address"_q)));
+	AddAddress(preview->entity(), box->uiShow(), state->address.value());
+	preview->toggleOn(state->address.value() | rpl::map([](
+			const QString &value) {
+		return !value.isEmpty();
+	}), anim::type::instant);
+	const auto status = inner->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			inner,
+			object_ptr<Ui::VerticalLayout>(inner)),
+		style::margins(),
+		style::al_justify);
+	AddGreyLine(status->entity(), state->status.value());
+	status->toggleOn(state->status.value() | rpl::map([](
+			const QString &value) {
+		return !value.isEmpty();
+	}), anim::type::instant);
+	keyWrap->hide(anim::type::instant);
+
+	const auto focusField = [=] {
+		crl::on_main(field, [=] {
+			field->setFocus();
+			field->setCursorPosition(field->getLastText().size());
+		});
+	};
+	const auto switchTo = [=](bool key) {
+		if (state->active.current() == key) {
+			return;
+		}
+		state->active = key;
+		words->toggle(!key, anim::type::instant);
+		keyWrap->toggle(key, anim::type::instant);
+		if (changed) {
+			changed();
+		}
+		if (key) {
+			focusField();
+		}
+	};
+	WalletPrivateKeysValue(
+	) | rpl::on_next([=](bool on) {
+		auto list = sections;
+		if (on) {
+			list.push_back(Lower(u"Private Key"_q));
+		}
+		toggle->setSections(list);
+		if (!on && state->active.current()) {
+			switchTo(false);
+			toggle->setActiveSectionFast(state->wordSection);
+		}
+	}, keyWrap->lifetime());
+
+	field->changes() | rpl::on_next([=] {
+		state->address = ParseKeyInput(field->getLastText()).address;
+		if (changed) {
+			changed();
+		}
+	}, field->lifetime());
+	field->submits() | rpl::on_next([=] {
+		if (submit) {
+			submit();
+		}
+	}, field->lifetime());
+	field->lifetime().add([weak = base::make_weak(session)] {
+		if (const auto strong = weak.get()) {
+			strong->wallet().cancelRotatedSecretRecovery();
+		}
+	});
+
+	const auto prepare = [=](
+			Fn<void(std::vector<QString>)> ready,
+			Fn<void(QString)> fail) {
+		auto input = ParseKeyInput(field->getLastText());
+		if (input.address.isEmpty()) {
+			fail(Lower(u"This isn't a private key or an address "
+				"with 12 words."_q));
+			return;
+		} else if (input.recover.isEmpty()) {
+			ready(std::move(input.words));
+			return;
+		}
+		state->status = Lower(u"Searching the wallet's history…"_q);
+		session->wallet().recoverRotatedSecret(
+			input.recover,
+			std::move(input.words),
+			crl::guard(field, [=](const QString &phrase) {
+				state->status = QString();
+				auto list = WalletKeyWords(phrase);
+				if (IsWalletKeySecret(list)) {
+					ready(std::move(list));
+				} else {
+					fail(WalletRecoverErrorText(QString()));
+				}
+			}),
+			crl::guard(field, [=](const QString &error) {
+				state->status = QString();
+				fail(WalletRecoverErrorText(error));
+			}));
+	};
+
+	return {
+		.active = [=] {
+			return state->active.current() && WalletPrivateKeys();
+		},
+		.select = [=](int section) {
+			if (section == keySection && WalletPrivateKeys()) {
+				switchTo(true);
+				return true;
+			}
+			state->wordSection = section;
+			switchTo(false);
+			return false;
+		},
+		.prepare = prepare,
+		.paste = [=](const QString &text, bool check) {
+			if (!WalletPrivateKeys()
+				|| ParseKeyInput(text).address.isEmpty()) {
+				return false;
+			} else if (!check) {
+				field->setText(text.trimmed());
+				field->forceProcessContentsChanges();
+				switchTo(true);
+				toggle->setActiveSection(keySection);
+				focusField();
+			}
+			return true;
+		},
+		.focus = [=] {
+			if (!state->active.current()) {
+				return false;
+			}
+			field->setFocusFast();
+			return true;
+		},
+	};
+}
+
+QString WalletRecoverErrorText(const QString &error) {
+	return Lower((error == u"RECOVER_INVALID_WORDS"_q)
+		? u"These aren't 12 valid words."_q
+		: (error == u"RECOVER_BUSY"_q)
+		? u"The wallet's history is still being searched."_q
+		: (error == u"RECOVER_NOT_FOUND"_q)
+		? u"Couldn't find a key change to these words in this wallet's "
+			"history. Try again later."_q
+		: (error == u"RECOVER_MISMATCH"_q)
+		? u"These aren't the newest 12 words of this wallet."_q
+		: u"Couldn't search the wallet's history."_q);
+}
+
+rpl::producer<QString> WalletKeyTitle(const std::vector<QString> &words) {
+	return (Tokens(words).size() > 1)
+		? tr::lng_wallet_phrase_title()
+		: rpl::single(Lower(u"Your Private Key"_q));
+}
+
+rpl::producer<TextWithEntities> WalletKeyText(
+		const std::vector<QString> &words) {
+	return rpl::single(TextWithEntities{ Lower((Tokens(words).size() > 1)
+		? u"Your wallet address and these 12 words restore the wallet."_q
+		: u"Only this key restores the wallet. Keep it secret."_q) });
+}
+
+bool AddWalletKeyPhrase(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Main::SessionShow> show,
+		const std::vector<QString> &words,
+		Fn<void(const std::vector<QString> &)> grid) {
+	if (!IsWalletKeySecret(words)) {
+		return false;
+	}
+	const auto tokens = Tokens(words);
+	const auto key = tokens.front();
+	const auto container = box->verticalLayout();
+	if (tokens.size() == 1) {
+		const auto label = box->addRow(
+			object_ptr<Ui::FlatLabel>(box, key, KeyLabelStyle()),
+			st::walletPhraseTextMargin,
+			style::al_top);
+		label->setTryMakeSimilarLines(true);
+		AddCopy(container, show, key);
+		return true;
+	}
+	if (grid) {
+		grid(std::vector<QString>(tokens.begin() + 1, tokens.end()));
+	}
+	AddGreyLine(container, rpl::single(Lower(u"Wallet address"_q)));
+	AddAddress(container, show, rpl::single(KeyAddress({ key })));
+	AddGreyLine(
+		container,
+		rpl::single(Lower(u"Original key, not needed to restore"_q)));
+	const auto label = box->addRow(
+		object_ptr<Ui::FlatLabel>(box, key, OldKeyLabelStyle()),
+		st::walletPhraseTextMargin,
+		style::al_top);
+	label->setTryMakeSimilarLines(true);
+	AddCopy(container, show, key);
+	return true;
+}
+
+std::vector<QString> WalletQuizWords(std::vector<QString> words) {
+	if (words.size() > kQuizWords && IsWalletKeySecret(words)) {
+		words.erase(words.begin());
+	}
+	return words;
+}
+
+rpl::producer<QString> WalletRevealLabel(
+		not_null<Main::Session*> session,
+		rpl::producer<QString> label) {
+	return rpl::combine(
+		IsUnrotatedKeyWalletValue(session),
+		std::move(label)
+	) | rpl::map([](bool key, const QString &label) {
+		return key ? Lower(u"Show Private Key"_q) : label;
+	});
+}
+
+TextWithEntities WalletKeyRotationText(
+		not_null<Main::Session*> session,
+		TextWithEntities text) {
+	return IsUnrotatedKeyWallet(session)
+		? TextWithEntities{ Lower(u"The long key stops working. Your "
+			"address and the 12 new words restore the wallet."_q) }
+		: std::move(text);
+}
+
+rpl::producer<QString> WalletRotationTitle(
+		not_null<Main::Session*> session,
+		rpl::producer<QString> title) {
+	return rpl::combine(
+		IsUnrotatedKeyWalletValue(session),
+		std::move(title)
+	) | rpl::map([](bool key, const QString &title) {
+		return key ? WalletReplaceKeyLabel() : title;
+	});
+}
+
+rpl::producer<QString> WalletBackupAbout(
+		not_null<Main::Session*> session,
+		rpl::producer<QString> text) {
+	return rpl::combine(
+		IsKeyWalletValue(session),
+		std::move(text)
+	) | rpl::map([](bool key, const QString &text) {
+		return key ? WalletKeyBackupText() : text;
+	});
+}
+
+QString WalletKeyBackupText() {
+	return Lower(u"Telegram backup keeps only secret words; "
+		"save your key yourself."_q);
+}
+
+} // namespace Tele
