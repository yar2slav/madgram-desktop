+			"After this the long key stops working, and your address "
+			"and 12 new words restore the wallet."_q),
+		st::boxLabel));
+	box->addButton(rpl::single(Lower(u"Replace"_q)), [=] {
+		replace();
+	});
+	box->addButton(rpl::single(Lower(u"Later"_q)), [=] {
+		box->closeBox();
+	});
+}
