+const auto kMarkerKey = u"tele/private-key-wallets"_q;
+constexpr auto kKeySize = 32;
+constexpr auto kHalfWords = 12;
+constexpr auto kQuizWords = 3;
+constexpr auto kClipboardClearDelay = crl::time(60000);
+
+struct MarkerEntry {
+	QByteArray anchor;
+	bool offered = false;
+};
+
+struct Marker {
+	base::flat_map<QString, MarkerEntry> wallets;
+	rpl::event_stream<> changes;
+};
+
+base::flat_map<not_null<Main::Session*>, std::unique_ptr<Marker>> Markers;
+
+[[nodiscard]] Marker &MarkerFor(not_null<Main::Session*> session) {
+	auto i = Markers.find(session);
+	if (i == end(Markers)) {
+		auto marker = std::make_unique<Marker>();
+		using State = Storage::WalletEngineValue::State;
+		const auto value = session->local().readWalletEngineValue(
+			kMarkerKey);
+		if (value.state == State::Read) {
+			const auto lines = QString::fromUtf8(value.bytes).split(
+				QChar('\n'),
+				Qt::SkipEmptyParts);
+			for (const auto &line : lines) {
+				const auto parts = line.split(QChar(' '));
+				if (parts.size() == 3) {
+					marker->wallets.emplace(parts[0], MarkerEntry{
+						.anchor = QByteArray::fromHex(parts[1].toLatin1()),
+						.offered = (parts[2] == u"1"_q),
+					});
+				}
+			}
+		}
+		i = Markers.emplace(session, std::move(marker)).first;
+		session->lifetime().add([=] {
+			Markers.remove(session);
+		});
+	}
+	return *i->second;
+}
+
+void WriteMarker(not_null<Main::Session*> session, Marker &marker) {
+	auto list = QStringList();
+	for (const auto &[address, entry] : marker.wallets) {
+		list.push_back(address
+			+ QChar(' ')
+			+ QString::fromLatin1(entry.anchor.toHex())
+			+ QChar(' ')
+			+ (entry.offered ? u"1"_q : u"0"_q));
+	}
+	if (!session->local().writeWalletEngineValue(
+			kMarkerKey,
+			list.join(QChar('\n')).toUtf8())) {
+		LOG(("Wallet Error: tele private key marker write failed."));
+	}
+	marker.changes.fire({});
+}
+
+[[nodiscard]] const MarkerEntry *CurrentEntry(
+		not_null<Main::Session*> session) {
+	const auto address = session->wallet().address();
+	if (!address) {
+		return nullptr;
+	}
+	const auto &wallets = MarkerFor(session).wallets;
+	const auto i = wallets.find(Wallet::CanonicalAddress(*address));
+	return (i != end(wallets)) ? &i->second : nullptr;
+}
+
+[[nodiscard]] std::string JoinWords(const std::vector<QString> &words) {
+	return QStringList(words.begin(), words.end()).join(
+		QChar(' ')).toStdString();
+}
+
+[[nodiscard]] std::vector<QString> Tokens(const std::vector<QString> &words) {
+	return WalletKeyWords(QStringList(words.begin(), words.end()).join(
+		QChar(' ')));
+}
+
+[[nodiscard]] QByteArray KeyBytes(const std::vector<uint8_t> &key) {
+	return QByteArray(
+		reinterpret_cast<const char*>(key.data()),
+		int(key.size()));
+}
+
+[[nodiscard]] QString KeyAddress(const std::vector<QString> &words) {
+	if (!IsWalletKeySecret(words)) {
+		return QString();
+	}
+	try {
+		return QString::fromStdString(wallet_engine::private_key_address(
+			JoinWords(words),
+			wallet_engine::Network::kMainnet));
+	} catch (...) {
+		return QString();
+	}
+}
+
+struct KeyInput {
+	std::vector<QString> words;
+	QString address;
+	QString recover;
+};
+
+[[nodiscard]] KeyInput ParseKeyInput(const QString &text) {
+	auto result = KeyInput{ .words = WalletKeyWords(text) };
+	if (IsWalletKeySecret(result.words)) {
+		result.address = KeyAddress(result.words);
+		return result;
+	}
+	const auto tokens = text.simplified().split(
+		QChar(' '),
+		Qt::SkipEmptyParts);
+	if (tokens.size() != kHalfWords + 1) {
+		return {};
+	}
+	auto address = QString();
+	auto words = std::vector<QString>();
+	for (const auto &token : tokens) {
+		if (Wallet::IsWordlistWord(token)) {
+			words.push_back(token.toLower());
+		} else if (address.isEmpty() && Wallet::ParseAddress(token)) {
+			address = token;
+		} else {
+			return {};
+		}
+	}
+	if (address.isEmpty() || words.size() != kHalfWords) {
+		return {};
+	}
+	return { .words = std::move(words), .address = address, .recover = address };
+}
