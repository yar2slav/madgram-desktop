+
+bool IsWalletKeySecret(const std::vector<QString> &words) {
+	if (words.empty()) {
+		return false;
+	}
+	auto list = std::vector<std::string>();
+	list.reserve(words.size());
+	for (const auto &word : words) {
+		list.push_back(word.trimmed().toStdString());
+	}
+	try {
+		return wallet_engine::detect_private_key(list);
+	} catch (...) {
+		return false;
+	}
+}
+
+std::vector<QString> WalletKeyWords(const QString &text) {
+	const auto list = text.simplified().split(
+		QChar(' '),
+		Qt::SkipEmptyParts);
+	auto result = std::vector<QString>();
+	result.reserve(list.size());
+	for (const auto &word : list) {
+		result.push_back(result.empty() ? word : word.toLower());
+	}
+	return result;
+}
+
+std::optional<Wallet::PhraseIdentity> WalletKeyIdentity(
+		const std::vector<QString> &words) {
+	const auto tokens = Tokens(words);
+	if (tokens.empty()) {
+		return std::nullopt;
+	}
+	try {
+		const auto anchor = KeyBytes(wallet_engine::private_key_public_key(
+			JoinWords(tokens)));
+		if (anchor.size() != kKeySize) {
+			return std::nullopt;
+		}
+		auto result = Wallet::PhraseIdentity{
+			.anchor = anchor,
+			.signing = anchor,
+		};
+		if (tokens.size() > 1) {
+			const auto half = std::vector<QString>(
+				tokens.begin() + 1,
+				tokens.end());
+			result.signing = KeyBytes(
+				wallet_engine::rotation_mnemonic_public_key(
+					JoinWords(half)));
+			if (result.signing.size() != kKeySize) {
+				return std::nullopt;
+			}
+		}
+		return result;
+	} catch (...) {
+		return std::nullopt;
+	}
+}
+
+void NoteWalletSecret(
+		not_null<Main::Session*> session,
+		const QString &address,
+		const QByteArray &anchor,
+		const std::vector<QString> &words) {
+	const auto canonical = Wallet::CanonicalAddress(address);
+	if (canonical.isEmpty()) {
+		return;
+	}
+	auto &marker = MarkerFor(session);
+	if (!IsWalletKeySecret(words)) {
+		if (marker.wallets.remove(canonical)) {
+			WriteMarker(session, marker);
+		}
+		return;
+	} else if (anchor.size() != kKeySize) {
+		return;
+	}
+	auto &entry = marker.wallets[canonical];
+	if (entry.anchor == anchor) {
+		return;
+	}
+	entry.anchor = anchor;
+	WriteMarker(session, marker);
+}
+
+bool IsKeyWallet(not_null<Main::Session*> session) {
+	return CurrentEntry(session) != nullptr;
+}
+
+bool IsUnrotatedKeyWallet(not_null<Main::Session*> session) {
+	const auto entry = CurrentEntry(session);
+	return entry && (entry->anchor == session->wallet().publicKey());
+}
+
+rpl::producer<bool> IsKeyWalletValue(not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(rpl::merge(
+		MarkerFor(session).changes.events(),
+		session->wallet().transferWalletIdentityChanges(),
+		session->wallet().presenceValue() | rpl::to_empty
+	)) | rpl::map([=] {
+		return IsKeyWallet(session);
+	}) | rpl::distinct_until_changed();
+}
+
+[[nodiscard]] rpl::producer<bool> IsUnrotatedKeyWalletValue(
+		not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(rpl::merge(
+		MarkerFor(session).changes.events(),
+		session->wallet().transferWalletIdentityChanges(),
+		session->wallet().presenceValue() | rpl::to_empty,
+		session->wallet().capabilitiesValue() | rpl::to_empty
+	)) | rpl::map([=] {
+		return IsUnrotatedKeyWallet(session);
+	}) | rpl::distinct_until_changed();
+}
+
+rpl::producer<bool> WalletReplaceKeyShown(
+		not_null<Main::Session*> session) {
+	return rpl::combine(
+		WalletPrivateKeysValue(),
+		IsUnrotatedKeyWalletValue(session)
+	) | rpl::map(rpl::mappers::_1 && rpl::mappers::_2);
+}
+
+QString WalletReplaceKeyLabel() {
+	return Lower(u"Replace the Key with 12 Words"_q);
+}
+
+bool TakeWalletReplaceKeyOffer(not_null<Main::Session*> session) {
+	if (!WalletPrivateKeys() || !IsUnrotatedKeyWallet(session)) {
+		return false;
+	}
+	const auto address = session->wallet().address();
+	auto &marker = MarkerFor(session);
+	const auto i = marker.wallets.find(Wallet::CanonicalAddress(*address));
+	if (i == end(marker.wallets) || i->second.offered) {
+		return false;
+	}
+	i->second.offered = true;
+	WriteMarker(session, marker);
+	return true;
+}
+
+void FillWalletReplaceKeyOffer(
+		not_null<Ui::GenericBox*> box,
+		Fn<void()> replace) {
+	box->setTitle(rpl::single(Lower(u"Replace the key with 12 words?"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
