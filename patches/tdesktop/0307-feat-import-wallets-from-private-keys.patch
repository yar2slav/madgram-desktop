+void Session::recoverRotatedSecret(
+		const QString &address,
+		std::vector<QString> words,
+		Fn<void(const QString &phrase)> done,
+		Fn<void(const QString &error)> fail) {
+	if (_recoveringSecret) {
+		fail(u"RECOVER_BUSY"_q);
+		return;
+	}
+	auto normalized = QStringList();
+	auto list = std::vector<std::string>();
+	for (const auto &word : words) {
+		normalized.push_back(NormalizeWord(word));
+		list.push_back(normalized.back().toStdString());
+	}
+	const auto key = RotationMnemonicKey(normalized);
+	const auto parsed = ParseAddress(address);
+	if (!key || !parsed) {
+		fail(u"RECOVER_INVALID_WORDS"_q);
+		return;
+	}
+	_engine->cancelRecovery();
+	auto client = std::shared_ptr<engine::WalletClient>();
+	try {
+		client = _engine->recoveryClient(engine::WalletClientConfig{
+			.record_id = "tele-recovery",
+			.address = FormatFriendly(parsed->raw, false).toStdString(),
+			.public_key = std::vector<uint8_t>(
+				key->constData(),
+				key->constData() + key->size()),
+			.local_secret_ref = std::nullopt,
+			.network = engine::Network::kMainnet,
+			.send_validity_seconds = kClientSendValiditySeconds,
+			.resolution_margin_seconds = kClientResolutionMarginSeconds,
+			.providers = engine::ProviderConfig{
+				.toncenter_base_url = "https://toncenter.com",
+				.dns_root_address = std::nullopt,
+				.request_timeout_ms = kClientRequestTimeoutMs,
+			},
+		});
+	} catch (...) {
+		fail(u"RECOVER_FAILED"_q);
+		return;
+	}
+	_recoveringSecret = true;
+	_engine->run([client, list] {
+		auto phrase = std::string();
+		auto error = std::exception_ptr();
+		try {
+			phrase = client->recover_wallet_secret(list).phrase;
+		} catch (...) {
+			error = std::current_exception();
+		}
+		try {
+			client->shutdown();
+		} catch (...) {
+		}
+		if (error) {
+			std::rethrow_exception(error);
+		}
+		return QString::fromStdString(phrase);
+	}, [=, this](const QString &phrase) {
+		_recoveringSecret = false;
+		done(phrase);
+	}, [=, this](EngineError error) {
+		_recoveringSecret = false;
+		LOG(("Wallet Error: rotated secret recovery failed: %1"
+			).arg(error.message));
+		auto code = u"RECOVER_FAILED"_q;
+		try {
+			if (error.underlying) {
+				std::rethrow_exception(error.underlying);
+			}
+		} catch (const engine::wallet_client_error::InvalidProtectedSecret &) {
+			code = u"RECOVER_INVALID_WORDS"_q;
+		} catch (const engine::wallet_client_error
+				::EncryptedCommentLookupFailed &) {
+			code = u"RECOVER_NOT_FOUND"_q;
+		} catch (const engine::wallet_client_error::WalletIdentityMismatch &) {
+			code = u"RECOVER_MISMATCH"_q;
+		} catch (...) {
+		}
+		fail(code);
+	});
+}
+
+void Session::cancelRotatedSecretRecovery() {
+	if (_recoveringSecret) {
+		_engine->cancelRecovery();
+	}
+}
