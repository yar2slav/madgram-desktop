+StickerCaption::StickerCaption(not_null<HistoryView::Element*> view)
+: _view(view) {
+}
+
+void StickerCaption::invalidate() {
+	_dirty = true;
+}
+
+void StickerCaption::refresh() {
+	if (!_dirty) {
+		return;
+	}
+	_dirty = false;
+	const auto item = _view->data();
+	const auto view = _view;
+	_text = Ui::Text::String(st::msgMinWidth);
+	_text.setMarkedText(
+		st::messageTextStyle,
+		item->translatedTextWithLocalEntities(),
+		Ui::ItemTextOptions(item),
+		Core::TextContext({
+			.session = &item->history()->session(),
+			.repaint = [=] { view->customEmojiRepaint(); },
+		}));
+	HistoryView::InitElementTextPart(_view, _text);
+	RevealElementSpoilers(_view, _text);
+}
+
+int StickerCaption::optimalWidth() const {
+	const auto &padding = st::msgPadding;
+	return std::min(
+		padding.left() + _text.maxWidth() + padding.right(),
+		int(st::msgMaxWidth));
+}
+
+int StickerCaption::heightFor(int width) const {
+	const auto &padding = st::msgPadding;
+	const auto inner = std::max(width - padding.left() - padding.right(), 1);
+	return st::mediaInBubbleSkip
+		+ padding.top()
+		+ _text.countHeight(inner)
+		+ padding.bottom();
+}
+
+QSize StickerCaption::resize(QSize body) {
+	const auto &padding = st::msgPadding;
+	_outer = body.width();
+	_top = body.height();
+	const auto available = std::max(
+		std::min(optimalWidth(), _outer) - padding.left() - padding.right(),
+		1);
+	auto real = 0;
+	for (const auto width : _text.countLineWidths(available)) {
+		accumulate_max(real, width);
+	}
+	_textWidth = std::clamp(real, 1, available);
+	_blockHeight = heightFor(available + padding.left() + padding.right());
+	return { body.width(), body.height() + _blockHeight };
+}
+
+int StickerCaption::bodyHeight(int full) const {
+	return full - _blockHeight;
+}
+
+bool StickerCaption::covers(QPoint point) const {
+	return (point.y() >= _top);
+}
+
+QRect StickerCaption::bubble() const {
+	const auto &padding = st::msgPadding;
+	const auto width = padding.left() + _textWidth + padding.right();
+	auto left = _view->hasRightLayout() ? (_outer - width) : 0;
+	if (rtl()) {
+		left = _outer - left - width;
+	}
+	return QRect(
+		left,
+		_top + st::mediaInBubbleSkip,
+		width,
+		_blockHeight - st::mediaInBubbleSkip);
+}
+
+QPoint StickerCaption::textPosition() const {
+	return bubble().topLeft()
+		+ QPoint(st::msgPadding.left(), st::msgPadding.top());
+}
+
+void StickerCaption::draw(
+		Painter &p,
+		const Ui::ChatPaintContext &context) const {
+	using Corner = Ui::BubbleCornerRounding;
+	const auto right = _view->hasRightLayout();
+	const auto tail = _view->isBubbleAttachedToNext()
+		? Corner::Small
+		: Corner::Tail;
+	Ui::PaintBubble(p, Ui::SimpleBubble{
+		.st = context.st,
+		.geometry = bubble(),
+		.pattern = context.bubblesPattern,
+		.patternViewport = context.viewport,
+		.outerWidth = _outer,
+		.selected = context.selected(),
+		.outbg = context.outbg,
+		.rounding = {
+			.topLeft = Corner::Large,
+			.topRight = Corner::Large,
+			.bottomLeft = right ? Corner::Large : tail,
+			.bottomRight = right ? tail : Corner::Large,
+		},
+	});
+	const auto stm = context.messageStyle();
+	p.setPen(stm->historyTextFg);
+	_view->prepareCustomEmojiPaint(p, context, _text);
+	auto highlightRequest = context.computeHighlightCache();
+	_text.draw(p, {
+		.position = textPosition(),
+		.availableWidth = _textWidth,
+		.palette = &stm->textPalette,
+		.pre = stm->preCache.get(),
+		.blockquote = context.quoteCache(
+			_view->contentColorCollectible(),
+			_view->contentColorIndex()),
+		.colors = context.st->highlightColors(),
+		.spoiler = Ui::Text::DefaultSpoilerCache(),
+		.now = context.now,
+		.pausedEmoji = context.paused || On(PowerSaving::kEmojiChat),
+		.pausedSpoiler = context.paused || On(PowerSaving::kChatSpoiler),
+		.selection = context.selection,
+		.highlight = highlightRequest ? &*highlightRequest : nullptr,
+		.useFullWidth = true,
+	});
+}
+
+HistoryView::PointState StickerCaption::pointState(QPoint point) const {
+	return bubble().contains(point)
+		? HistoryView::PointState::Inside
+		: HistoryView::PointState::Outside;
+}
+
+HistoryView::TextState StickerCaption::textState(
+		QPoint point,
+		const HistoryView::StateRequest &request) const {
+	return HistoryView::TextState(_view, _text.getState(
+		point - textPosition(),
+		_textWidth,
+		request.forText()));
+}
+
+TextForMimeData StickerCaption::selectedText(TextSelection selection) const {
+	return _text.toTextForMimeData(selection);
+}
+
+HistoryView::SelectedQuote StickerCaption::selectedQuote(
+		TextSelection selection) const {
+	return HistoryView::Element::FindSelectedQuote(
+		_text,
+		selection,
+		_view->data());
+}
+
+TextSelection StickerCaption::selectionFromQuote(
+		const HistoryView::SelectedQuote &quote) const {
+	return HistoryView::Element::FindSelectionFromQuote(_text, quote);
+}
+
+TextSelection StickerCaption::adjustSelection(
+		TextSelection selection,
+		TextSelectType type) const {
+	return _text.adjustSelection(selection, type);
+}
+
+uint16 StickerCaption::length() const {
+	return _text.length();
+}
+
+void RefreshStickerCaption(
+		std::unique_ptr<StickerCaption> &caption,
+		not_null<HistoryView::Element*> view,
+		bool beside,
+		int &maxWidth,
+		int &minHeight) {
+	if (!IsCaptionedSticker(view->data())) {
+		caption = nullptr;
+		return;
+	}
+	Track(view);
+	if (!StickerCaptionsShow()) {
+		caption = nullptr;
+		return;
+	}
+	if (!caption) {
+		caption = std::make_unique<StickerCaption>(view);
+	}
+	caption->refresh();
+	if (!beside) {
+		accumulate_max(maxWidth, caption->optimalWidth());
+	}
+	minHeight += caption->heightFor(
+		std::min(maxWidth, caption->optimalWidth()));
+}
+
+QSize ResizeStickerCaption(StickerCaption *caption, QSize body) {
+	return caption ? caption->resize(body) : body;
+}
+
+TextWithEntities StickerCaptionText(not_null<const HistoryItem*> item) {
+	return StickerCaptionsShow() ? item->originalText() : TextWithEntities();
+}
+
+HistoryView::ItemPreview StickerPreview(
+		not_null<const Data::Media*> media,
+		const HistoryView::ToPreviewOptions &options) {
+	Get();
+	const auto document = media->document();
+	if (!StickerCaptionsShow()
+		|| !document
+		|| !document->sticker()
+		|| !(options.hideCaption || options.ignoreMessageText)) {
+		return media->Data::Media::toPreview(options);
+	}
+	return { .text = Ui::Text::Colorized(StickerLabel(document)) };
+}
+
+bool StickerCaptionEditable(not_null<const DocumentData*> document) {
+	return StickerCaptionsSend() && document->sticker();
+}
+
+StickerCaptionTake TakeStickerCaption(
+		Api::MessageToSend &message,
+		not_null<DocumentData*> document,
+		Ui::InputField *field,
+		bool editing,
+		const std::shared_ptr<ChatHelpers::Show> &show) {
+	const auto sticker = document->sticker();
+	if (!StickerCaptionsSend()
+		|| !sticker
+		|| (sticker->setType == Data::StickersType::Emoji)
+		|| !field
+		|| field->isHidden()
+		|| editing
+		|| !message.textWithTags.text.isEmpty()
+		|| IsEmojiQuery(field->getTextWithTags().text)) {
+		return StickerCaptionTake::None;
+	}
+	auto text = field->getTextWithAppliedMarkdown();
+	if (text.text.trimmed().isEmpty()) {
+		return StickerCaptionTake::None;
+	}
+	const auto remove = Ui::ComputeFieldCharacterCount(field)
+		- Data::PremiumLimits(&show->session()).captionLengthCurrent();
+	if (remove > 0) {
+		show->showToast(
+			tr::lng_edit_limit_reached(tr::now, lt_count, remove));
+		return StickerCaptionTake::TooLong;
+	}
+	message.textWithTags = std::move(text);
+	return StickerCaptionTake::Taken;
+}
+
+void AddStickerCaptionAction(
+		not_null<Ui::PopupMenu*> menu,
+		const SendMenu::Details &details,
+		const style::ComposeIcons &icons,
+		Fn<void()> callback) {
+	if (!StickerCaptionsSend()
+		|| (details.type == SendMenu::Type::Disabled)) {
+		return;
+	}
+	menu->addAction(
+		Lower(u"Send with caption\u2026"_q),
+		std::move(callback),
+		&icons.menuGifCaption);
+}
+
+void SendStickerWithCaptionBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<DocumentData*> document,
+		not_null<PeerData*> peer,
+		const SendMenu::Details &details,
+		TextWithTags initialText,
+		Fn<void(Api::SendOptions, TextWithTags, Ui::PreparedList&&)> done,
+		Fn<void(TextWithTags)> cancelled) {
+	const auto window = Core::App().findWindow(box);
+	const auto controller = window ? window->sessionController() : nullptr;
+	if (!controller) {
+		return;
+	}
+	const auto show = controller->uiShow();
+	box->setTitle(rpl::single(Lower(u"Send with caption"_q)));
+	box->setWidth(st::boxWidth);
+
+	const auto input = box->addRow(
+		object_ptr<Ui::InputField>(
+			box,
+			st::defaultComposeFiles.caption,
+			Ui::InputField::Mode::MultiLine,
+			tr::lng_photo_caption()),
+		st::boxRowPadding);
+	Ui::SetupCaptionFieldInBox(
+		box,
+		controller,
+		input,
+		controller->session().user(),
+		[](not_null<DocumentData*>) { return false; },
+		PremiumFeature::AnimatedEmoji);
+	box->setFocusCallback([=] {
+		input->setFocus();
+	});
+	input->setTextWithTags(std::move(initialText));
+	input->setSubmitSettings(Core::App().settings().sendSubmitWay());
+	InitMessageField(
+		controller,
+		input,
+		[](not_null<DocumentData*>) { return true; });
+
+	const auto confirmed = box->lifetime().make_state<bool>(false);
+	const auto send = [=](Api::SendOptions options) {
+		const auto remove = Ui::ComputeFieldCharacterCount(input)
+			- Data::PremiumLimits(&show->session()).captionLengthCurrent();
+		if (remove > 0) {
+			show->showToast(
+				tr::lng_edit_limit_reached(tr::now, lt_count, remove));
+			return;
+		}
+		*confirmed = true;
+		done(
+			std::move(options),
+			input->getTextWithAppliedMarkdown(),
+			Ui::PreparedList());
+	};
+	if (cancelled) {
+		box->boxClosing() | rpl::on_next([=] {
+			if (!*confirmed) {
+				cancelled(input->getTextWithTags());
+			}
+		}, box->lifetime());
+	}
+	const auto confirm = box->addButton(
+		tr::lng_send_button(),
+		[=] { send({}); });
+	SendMenu::SetupMenuAndShortcuts(
+		confirm,
+		show,
+		[details] { return details; },
+		SendMenu::DefaultCallback(show, send));
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	input->submits() | rpl::on_next([=] {
+		send({});
+	}, input->lifetime());
+}
