+constexpr auto kCompactThreshold = 256;
+
+using Element = HistoryView::Element;
+
+struct State {
+	State();
+
+	std::unordered_map<const Element*, base::weak_ptr<Element>> views;
+	size_t compactAt = kCompactThreshold;
+	rpl::lifetime lifetime;
+};
+
+void RefreshAll(State &state) {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	for (const auto &[key, weak] : base::take(state.views)) {
+		if (const auto view = weak.get()) {
+			items.emplace(view->data());
+		}
+	}
+	state.compactAt = kCompactThreshold;
+	for (const auto &item : items) {
+		item->history()->owner().requestItemViewRefresh(item);
+	}
+	InvalidateAllPreviews();
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+State::State() {
+	StickerCaptionsShowChanges() | rpl::on_next([] {
+		RefreshAll(Get());
+	}, lifetime);
+}
+
+void Track(not_null<Element*> view) {
+	auto &state = Get();
+	auto &weak = state.views[view.get()];
+	if (weak.get() == view.get()) {
+		return;
+	}
+	weak = base::make_weak(view.get());
+	if (state.views.size() < state.compactAt) {
+		return;
+	}
+	for (auto i = begin(state.views); i != end(state.views);) {
+		if (i->second.get()) {
+			++i;
+		} else {
+			i = state.views.erase(i);
+		}
+	}
+	state.compactAt = std::max(
+		size_t(kCompactThreshold),
+		state.views.size() * 2);
+}
+
+[[nodiscard]] bool IsCaptionedSticker(not_null<const HistoryItem*> item) {
+	if (item->isService() || item->emptyText()) {
+		return false;
+	}
+	const auto media = item->media();
+	const auto document = media ? media->document() : nullptr;
+	return document && document->sticker();
+}
+
+[[nodiscard]] bool IsEmojiQuery(const QString &text) {
+	auto length = 0;
+	return Ui::Emoji::Find(text, &length) && (text.size() <= length);
+}
+
+[[nodiscard]] QString StickerLabel(not_null<const DocumentData*> document) {
+	auto emoji = document->sticker()->alt;
+	if (const auto found = Ui::Emoji::Find(emoji)) {
+		emoji = found->text();
+	}
+	return emoji.isEmpty()
+		? tr::lng_in_dlg_sticker(tr::now)
+		: tr::lng_in_dlg_sticker_emoji(tr::now, lt_emoji, emoji);
+}
