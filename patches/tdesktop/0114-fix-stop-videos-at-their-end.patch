diff --git a/Telegram/SourceFiles/tele/tele_streaming_audio.cpp b/Telegram/SourceFiles/tele/tele_streaming_audio.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d19e95401b197021a50a80f7dbe60a6370ef82fd
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_streaming_audio.cpp
@@ -0,0 +1,13 @@
+#include "tele/tele_streaming_audio.h"
+
+#include "data/data_audio_msg_id.h"
+#include "media/audio/media_audio.h"
+
+namespace Tele {
+
+bool MixerDroppedAudio(const AudioMsgId &audio) {
+	const auto mixer = Media::Player::mixer();
+	return !mixer || (mixer->currentState(audio.type()).id != audio);
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_streaming_audio.h b/Telegram/SourceFiles/tele/tele_streaming_audio.h
new file mode 100644
index 0000000000000000000000000000000000000000..f21b26a63b4c385f706cd195b380fe039b9ac1ac
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_streaming_audio.h
@@ -0,0 +1,9 @@
+#pragma once
+
+class AudioMsgId;
+
+namespace Tele {
+
+[[nodiscard]] bool MixerDroppedAudio(const AudioMsgId &audio);
+
+} // namespace Tele
