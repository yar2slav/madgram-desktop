diff --git a/Telegram/SourceFiles/tele/tele_gifts.cpp b/Telegram/SourceFiles/tele/tele_gifts.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ec8564599dec4ebedfc8512504b404f0473f8e1d
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gifts.cpp
@@ -0,0 +1,40 @@
+#include "tele/tele_gifts.h"
+
+#include "chat_helpers/compose/compose_show.h"
+#include "data/data_star_gift.h"
+#include "tele/tele_options.h"
+#include "ui/controls/table_rows.h"
+#include "ui/text/text_utilities.h"
+#include "ui/toast/toast.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/table_layout.h"
+#include "styles/style_chat_helpers.h"
+#include "styles/style_widgets.h"
+
+namespace Tele {
+
+void AddGiftIdRow(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<Ui::TableLayout*> table,
+		const Data::UniqueGift *gift) {
+	if (!gift || !gift->id || !ShowGiftIds()) {
+		return;
+	}
+	const auto id = QString::number(gift->id);
+	auto label = object_ptr<Ui::FlatLabel>(
+		table,
+		rpl::single(Ui::Text::Wrapped({ id }, EntityType::Code)),
+		table->st().defaultValue);
+	label->setClickHandlerFilter([=](const auto &...) {
+		TextUtilities::SetClipboardText(TextForMimeData::Simple(id));
+		show->showToast({
+			.text = { u"Gift ID copied to clipboard."_q },
+			.iconLottie = u"toast/copy"_q,
+			.iconLottieSize = st::toastLottieIconSize,
+		});
+		return false;
+	});
+	Ui::AddTableRow(table, rpl::single(u"Gift ID"_q), std::move(label));
+}
+
+} // namespace Tele
