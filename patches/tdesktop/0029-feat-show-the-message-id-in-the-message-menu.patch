+++ b/Telegram/SourceFiles/tele/tele_message_menu.cpp
@@ -0,0 +1,70 @@
+#include "tele/tele_message_menu.h"
+
+#include "history/history_item.h"
+#include "main/session/session_show.h"
+#include "tele/tele_options.h"
+#include "ui/toast/toast.h"
+#include "ui/widgets/menu/menu_action.h"
+#include "ui/widgets/menu/menu_common.h"
+#include "ui/widgets/menu/menu_separator.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_chat_helpers.h"
+
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeIdAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		MsgId id) {
+	const auto text = QString::number(id.bare);
+	const auto parent = menu->menu();
+	const auto action = Ui::Menu::CreateAction(
+		parent,
+		u"ID: "_q + text,
+		[=] {
+			QGuiApplication::clipboard()->setText(text);
+			show->showToast({
+				.text = { u"Message ID copied to clipboard."_q },
+				.iconLottie = u"toast/copy"_q,
+				.iconLottieSize = st::toastLottieIconSize,
+			});
+		});
+	return base::make_unique_q<Ui::Menu::Action>(
+		parent,
+		st::whoSentItem,
+		action,
+		nullptr,
+		nullptr);
+}
+
+} // namespace
+
+void InsertMessageTools(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		HistoryItem *item) {
+	if (!item || menu->empty() || !IsServerMsgId(item->id)) {
+		return;
+	}
+	auto position = 0;
+	if (MessageIdMenu()) {
+		menu->insertAction(position++, MakeIdAction(menu, show, item->id));
+	}
+	if (!position) {
+		return;
+	}
+	const auto parent = menu->menu();
+	const auto separator = new QAction(parent);
+	separator->setSeparator(true);
+	menu->insertAction(position, base::make_unique_q<Ui::Menu::Separator>(
+		parent,
+		menu->st().menu,
+		menu->st().menu.separator,
+		separator));
+}
+
+} // namespace Tele
