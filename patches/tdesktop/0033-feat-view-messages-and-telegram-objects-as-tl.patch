+	std::shared_ptr<Main::SessionShow> show,
+	const Dialogs::EntryState &request);
+void AddViewTlAction(
+	const Ui::Menu::MenuCallback &addAction,
+	std::shared_ptr<Main::SessionShow> show,
+	not_null<PeerData*> peer);
+void AddViewTlAction(
+	const Ui::Menu::MenuCallback &addAction,
+	std::shared_ptr<Main::SessionShow> show,
+	DocumentData *document);
+void AddViewTlAction(
+	const Ui::Menu::MenuCallback &addAction,
+	std::shared_ptr<Main::SessionShow> show,
+	const StickerSetIdentifier &set);
+void AddViewTlAction(
+	const Ui::Menu::MenuCallback &addAction,
