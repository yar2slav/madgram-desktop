+template <typename Value>
+[[nodiscard]] QByteArray SerializeTl(const Value &value) {
+	auto buffer = mtpBuffer();
+	value.write(buffer);
+	return QByteArray(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(buffer.front()));
+}
+
+void OpenTl(const QByteArray &bytes);
+
+[[nodiscard]] MTP::Sender &TlSender(
+	const std::shared_ptr<Main::SessionShow> &show);
+void OpenTlResult(
+	const std::shared_ptr<Main::SessionShow> &show,
+	const QByteArray &bytes);
+void ShowTlError(
+	const std::shared_ptr<Main::SessionShow> &show,
+	const MTP::Error &error);
+
+template <typename Request, typename Extract>
+void RequestTl(
+		std::shared_ptr<Main::SessionShow> show,
+		Request request,
+		Extract extract) {
+	using Result = typename Request::ResponseType;
+	TlSender(show).request(
+		std::move(request)
+	).done([=](const Result &result) {
+		OpenTlResult(show, extract(result));
+	}).fail([=](const MTP::Error &error) {
+		ShowTlError(show, error);
+	}).send();
+}
+
+template <typename Request>
+void RequestTl(std::shared_ptr<Main::SessionShow> show, Request request) {
+	RequestTl(std::move(show), std::move(request), [](const auto &result) {
+		return SerializeTl(result);
+	});
+}
+
