+		MsgId id) {
+	const auto extract = [=](const MTPmessages_Messages &result) {
+		const auto list = result.match([](
+				const MTPDmessages_messagesNotModified &) {
+			return QVector<MTPMessage>();
+		}, [](const auto &data) {
+			return data.vmessages().v;
+		});
+		for (const auto &message : list) {
+			if (message.type() != mtpc_messageEmpty
+				&& IdFromMessage(message) == id) {
+				return SerializeTl(message);
+			}
+		}
+		return QByteArray();
+	};
+	const auto ids = MTP_vector<MTPInputMessage>(
+		1,
+		MTP_inputMessageID(MTP_int(id)));
+	if (const auto channel = peer->asChannel()) {
+		RequestTl(
+			show,
+			MTPchannels_GetMessages(channel->inputChannel(), ids),
+			extract);
+	} else {
+		RequestTl(show, MTPmessages_GetMessages(ids), extract);
+	}
+}
+
+void AddViewTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		const Dialogs::EntryState &request) {
+	using Section = Dialogs::EntryState::Section;
+	const auto section = request.section;
+	if (!ViewAsTl()
+		|| section == Section::Scheduled
+		|| section == Section::Pinned
+		|| section == Section::ShortcutMessages
+		|| section == Section::WelcomeMessages) {
+		return;
+	}
+	const auto &key = request.key;
+	if (const auto topic = key.topic()) {
+		const auto peer = topic->peer();
+		const auto rootId = topic->rootId();
+		addAction(ViewTlText(), [=] {
+			ViewTopicTl(show, peer, rootId);
+		}, &st::menuIconInfo);
+	} else if (section == Section::Replies) {
+		return;
+	} else if (const auto sublist = key.sublist()) {
+		AddViewTlAction(addAction, show, sublist->sublistPeer());
+	} else if (const auto history = key.history()) {
+		AddViewTlAction(addAction, show, history->peer);
+	}
+}
+
+void AddViewTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<PeerData*> peer) {
+	if (!ViewAsTl()) {
+		return;
+	}
+	addAction(ViewTlText(), [=] {
+		ViewPeerTl(show, peer);
+	}, &st::menuIconInfo);
+}
+
+void AddViewTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		DocumentData *document) {
+	if (!ViewAsTl() || !document) {
+		return;
+	}
+	const auto strong = not_null<DocumentData*>(document);
+	addAction(ViewTlText(), [=] {
+		ViewDocumentTl(show, strong);
+	}, &st::menuIconInfo);
+}
+
+void AddViewTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		const StickerSetIdentifier &set) {
+	if (!ViewAsTl() || !set) {
+		return;
+	}
+	addAction(ViewTlText(), [=] {
+		RequestTl(show, MTPmessages_GetStickerSet(
+			Data::InputStickerSet(set),
+			MTP_int(0)));
+	}, &st::menuIconInfo);
+}
+
+void AddViewTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		Data::Story *story,
+		HistoryItem *item) {
+	if (!ViewAsTl()) {
+		return;
+	} else if (story) {
+		const auto peer = story->peer();
+		const auto id = story->id();
+		addAction(ViewTlText(), [=] {
+			ViewStoryTl(show, peer, id);
+		}, &st::mediaMenuIconInfo);
+	} else if (item && item->isRegular() && IsServerMsgId(item->id)) {
+		const auto peer = item->history()->peer;
+		const auto id = item->id;
+		addAction(ViewTlText(), [=] {
+			ViewMessageTl(show, peer, id);
+		}, &st::mediaMenuIconInfo);
+	}
+}
+
+void AddViewTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		const std::shared_ptr<Data::UniqueGift> &unique,
+		const Data::SavedStarGiftId &savedId) {
+	if (!ViewAsTl()) {
+		return;
+	} else if (unique && !unique->slug.isEmpty()) {
+		const auto slug = unique->slug;
+		addAction(ViewTlText(), [=] {
+			RequestTl(show, MTPpayments_GetUniqueStarGift(MTP_string(slug)));
+		}, &st::menuIconInfo);
+	} else if (savedId) {
+		const auto input = Api::InputSavedStarGiftId(savedId);
+		addAction(ViewTlText(), [=] {
+			RequestTl(show, MTPpayments_GetSavedStarGift(
+				MTP_vector<MTPInputSavedStarGift>(1, input)));
+		}, &st::menuIconInfo);
+	}
+}
+
+void AddViewFolderTlAction(
+		const Ui::Menu::MenuCallback &addAction,
+		std::shared_ptr<Main::SessionShow> show,
+		FilterId id) {
+	if (!ViewAsTl()) {
+		return;
+	}
+	const auto extract = [=](const MTPmessages_DialogFilters &result) {
+		for (const auto &filter : result.data().vfilters().v) {
+			const auto found = filter.match([&](
+					const MTPDdialogFilterDefault &) {
+				return !id;
+			}, [&](const auto &data) {
+				return (data.vid().v == id);
+			});
+			if (found) {
+				return SerializeTl(filter);
+			}
+		}
+		return QByteArray();
+	};
+	addAction(ViewTlText(), [=] {
+		RequestTl(show, MTPmessages_GetDialogFilters(), extract);
+	}, &st::menuIconInfo);
+}
+
+} // namespace Tele
