+void ViewPeerTl(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<PeerData*> peer) {
+	if (const auto user = peer->asUser()) {
+		RequestTl(show, MTPusers_GetFullUser(user->inputUser()));
+	} else if (const auto chat = peer->asChat()) {
+		RequestTl(show, MTPmessages_GetFullChat(chat->inputChat()));
+	} else if (const auto channel = peer->asChannel()) {
+		RequestTl(show, MTPchannels_GetFullChannel(channel->inputChannel()));
+	}
+}
+
+void ViewTopicTl(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<PeerData*> peer,
+		MsgId rootId) {
+	RequestTl(show, MTPmessages_GetForumTopicsByID(
+		peer->input(),
+		MTP_vector<MTPint>(1, MTP_int(rootId))));
+}
+
+[[nodiscard]] QByteArray FindDocument(
+		const QVector<MTPDocument> &list,
+		DocumentId id) {
+	for (const auto &document : list) {
+		if (document.type() == mtpc_document
+			&& document.c_document().vid().v == id) {
+			return SerializeTl(document);
+		}
+	}
+	return QByteArray();
+}
+
+void ViewDocumentTl(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<DocumentData*> document) {
+	const auto id = document->id;
+	const auto sticker = document->sticker();
+	if (sticker
+		&& sticker->set
+		&& sticker->setType != Data::StickersType::Emoji) {
+		RequestTl(show, MTPmessages_GetStickerSet(
+			Data::InputStickerSet(sticker->set),
+			MTP_int(0)
+		), [=](const MTPmessages_StickerSet &result) {
+			return result.match([&](const MTPDmessages_stickerSet &data) {
+				return FindDocument(data.vdocuments().v, id);
+			}, [](const MTPDmessages_stickerSetNotModified &) {
+				return QByteArray();
+			});
+		});
+	} else {
+		RequestTl(show, MTPmessages_GetCustomEmojiDocuments(
+			MTP_vector<MTPlong>(1, MTP_long(id))
+		), [=](const MTPVector<MTPDocument> &result) {
+			return FindDocument(result.v, id);
+		});
+	}
+}
+
+void ViewStoryTl(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<PeerData*> peer,
+		StoryId id) {
+	RequestTl(show, MTPstories_GetStoriesByID(
+		peer->input(),
+		MTP_vector<MTPint>(1, MTP_int(id))));
+}
+
+[[nodiscard]] QByteArray RawDeflate(const QByteArray &bytes) {
+	auto stream = z_stream();
+	if (deflateInit2(
+			&stream,
+			Z_BEST_COMPRESSION,
+			Z_DEFLATED,
+			-MAX_WBITS,
+			9,
+			Z_DEFAULT_STRATEGY) != Z_OK) {
+		return QByteArray();
+	}
+	const auto guard = gsl::finally([&] { deflateEnd(&stream); });
+	auto result = QByteArray(
+		int(deflateBound(&stream, uLong(bytes.size()))),
+		Qt::Uninitialized);
+	stream.next_in = reinterpret_cast<Bytef*>(
+		const_cast<char*>(bytes.constData()));
+	stream.avail_in = uInt(bytes.size());
+	stream.next_out = reinterpret_cast<Bytef*>(result.data());
+	stream.avail_out = uInt(result.size());
+	if (deflate(&stream, Z_FINISH) != Z_STREAM_END) {
+		return QByteArray();
+	}
+	result.resize(int(stream.total_out));
+	return result;
+}
+
+[[nodiscard]] QString WriteRedirectPage(const QString &url) {
+	const auto folder = QDir(QDir::tempPath());
+	for (const auto &old : folder.entryInfoList(
+			{ u"tele-tl-*.html"_q },
+			QDir::Files)) {
+		if (old.lastModified().secsTo(QDateTime::currentDateTime()) > 60) {
+			QFile::remove(old.absoluteFilePath());
+		}
+	}
+	const auto path = folder.absoluteFilePath(u"tele-tl-%1.html"_q.arg(
+		base::RandomValue<uint32>()));
+	auto file = QFile(path);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return QString();
+	}
+	file.write((u"<!doctype html><meta charset=\"utf-8\"><title>tele</title>"
+		"<script>location.replace(\"%1\")</script>"
+		"<a href=\"%1\">open</a>"_q).arg(url).toUtf8());
+	return path;
+}
+
+} // namespace
+
+void OpenTl(const QByteArray &bytes) {
+	const auto packed = (bytes.size() > kPackFrom)
+		? RawDeflate(bytes)
+		: QByteArray();
+	const auto compressed = !packed.isEmpty() && packed.size() < bytes.size();
+	const auto data = (compressed ? packed : bytes).toBase64(
+		QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals);
+	const auto url = u"https://schema.jppgr.am/embed#layer=%1&theme=%2%3&data=%4"_q
+		.arg(int(MTP::details::kCurrentLayer))
+		.arg(Window::Theme::IsNightMode() ? u"dark"_q : u"light"_q)
+		.arg(compressed ? u"&z=1"_q : QString())
+		.arg(QString::fromLatin1(data));
+	if (url.size() <= kDirectUrlLength) {
+		UrlClickHandler::Open(url);
+	} else if (const auto page = WriteRedirectPage(url); !page.isEmpty()) {
+		QDesktopServices::openUrl(QUrl::fromLocalFile(page));
+	}
+}
+
+MTP::Sender &TlSender(const std::shared_ptr<Main::SessionShow> &show) {
+	return show->session().api();
+}
+
+void OpenTlResult(
+		const std::shared_ptr<Main::SessionShow> &show,
+		const QByteArray &bytes) {
+	if (bytes.isEmpty()) {
+		show->showToast(u"The server didn't return this object."_q);
+	} else {
+		OpenTl(bytes);
+	}
+}
