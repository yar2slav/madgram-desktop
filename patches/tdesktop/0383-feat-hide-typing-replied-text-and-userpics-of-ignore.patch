@@ -96,6 +97,16 @@ struct State {
 	return list.join(QChar(','));
 }
 
+[[nodiscard]] bool Affected(
+		not_null<HistoryItem*> item,
+		const base::flat_set<Key> &changed,
+		bool words) {
+	const auto from = item->from();
+	return (from->isUser() && (changed.contains(PeerKey(from))
+			|| changed.contains(PeerKey(from) | kHiddenBit)))
+		|| (words && HiddenByWords(item));
+}
+
 void Refresh(
 		const State &state,
 		const base::flat_set<Key> &changed,
@@ -106,10 +117,10 @@ void Refresh(
 	auto items = base::flat_set<not_null<HistoryItem*>>();
 	for (const auto &view : state.views) {
 		const auto item = view->data();
-		const auto from = item->from();
-		if ((from->isUser() && (changed.contains(PeerKey(from))
-				|| changed.contains(PeerKey(from) | kHiddenBit)))
-			|| (words && HiddenByWords(item))) {
+		const auto reply = item->Get<HistoryMessageReply>();
+		const auto to = reply ? reply->resolvedMessage.get() : nullptr;
+		if (Affected(item, changed, words)
+			|| (to && Affected(to, changed, words))) {
 			items.emplace(item);
 		}
 	}
@@ -294,6 +305,15 @@ bool IgnoredHidden(not_null<const HistoryView::Element*> view) {
 		|| (HideIgnored() && IgnoredItem(view->data())));
 }
 
+bool IgnoredUserpic(not_null<const HistoryView::Element*> view) {
+	const auto item = view->data();
+	if (!Applies(view->context()) || item->isService()) {
+		return false;
+	}
+	const auto from = item->from();
+	return (item->history()->peer != from) && IsIgnored(from);
+}
+
 bool IgnoredItem(const HistoryItem *item) {
 	if (!item || item->isService() || item->isSponsored()) {
 		return false;
