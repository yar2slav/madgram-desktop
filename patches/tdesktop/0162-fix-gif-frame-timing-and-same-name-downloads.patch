+++ b/Telegram/SourceFiles/media/streaming/media_streaming_video_track.cpp
@@ -1132,8 +1132,11 @@ not_null<VideoTrack::Frame*> VideoTrack::Shared::frameForPaint() {
 }
 
 VideoTrack::FrameWithIndex VideoTrack::Shared::frameForPaintWithIndex() {
-	const auto index = counter() / 2;
-	const auto frame = getFrame(index);
+	const auto value = counter();
+	const auto next = getFrame(((value + 1) % (2 * kFramesCount)) / 2);
+	const auto frame = ((value % 2) && next->displayed != kTimeUnknown)
+		? next
+		: getFrame(value / 2);
 	Assert(frame->format != FrameFormat::None);
 	Assert(frame->position != kTimeUnknown);
 	Assert(frame->displayed != kTimeUnknown);
