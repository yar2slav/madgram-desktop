diff --git a/Telegram/SourceFiles/tele/tele_download_paths.cpp b/Telegram/SourceFiles/tele/tele_download_paths.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..689ee34b7545973f54ba46d28f7b4ddea208ed15
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_download_paths.cpp
@@ -0,0 +1,34 @@
+#include "tele/tele_download_paths.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] base::flat_map<const void*, QString> &Paths() {
+	static auto result = base::flat_map<const void*, QString>();
+	return result;
+}
+
+} // namespace
+
+void SetDownloadPath(const void *loader, const QString &path) {
+	if (path.isEmpty()) {
+		Paths().remove(loader);
+	} else {
+		Paths()[loader] = QDir::cleanPath(path);
+	}
+}
+
+bool DownloadPathTaken(const QString &path) {
+	if (QFileInfo::exists(path)) {
+		return true;
+	}
+	const auto clean = QDir::cleanPath(path);
+	for (const auto &[loader, taken] : Paths()) {
+		if (!taken.compare(clean, Qt::CaseInsensitive)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_download_paths.h b/Telegram/SourceFiles/tele/tele_download_paths.h
new file mode 100644
index 0000000000000000000000000000000000000000..2dab6b965daa5ff3adcdaa5b7c7ce7e7738b54df
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_download_paths.h
@@ -0,0 +1,8 @@
+#pragma once
+
+namespace Tele {
+
+void SetDownloadPath(const void *loader, const QString &path);
+[[nodiscard]] bool DownloadPathTaken(const QString &path);
+
+} // namespace Tele
