 constexpr auto kTestBit = BareId(1) << 63;
 
 using Key = BareId;
@@ -155,22 +160,7 @@ State::State() {
 }
 
 [[nodiscard]] bool IgnoredView(not_null<const Element*> view) {
-	const auto &state = Get();
-	if (!Applies(view->context())) {
-		return false;
-	}
-	const auto item = view->data();
-	if (item->isService() || item->isSponsored()) {
-		return false;
-	} else if (HiddenByWords(item)) {
-		return true;
-	} else if (state.keys.empty()) {
-		return false;
-	}
-	const auto from = item->from();
-	return from->isUser()
-		&& (item->history()->peer != from)
-		&& state.keys.contains(PeerKey(from));
+	return Applies(view->context()) && IgnoredItem(view->data());
 }
 
 [[nodiscard]] UserData *Ignorable(not_null<PeerData*> peer) {
@@ -263,6 +253,74 @@ bool IgnoredHidden(not_null<const HistoryView::Element*> view) {
 	return HideIgnored() && IgnoredView(view);
 }
 
+bool IgnoredItem(const HistoryItem *item) {
+	if (!item || item->isService() || item->isSponsored()) {
+		return false;
+	} else if (HiddenByWords(item)) {
+		return true;
+	}
+	const auto &state = Get();
+	if (state.keys.empty()) {
+		return false;
+	}
+	const auto from = item->from();
+	return from->isUser()
+		&& (item->history()->peer != from)
+		&& state.keys.contains(PeerKey(from));
+}
+
+bool MutedIgnored(not_null<const HistoryItem*> item) {
+	return MuteIgnored() && IgnoredItem(item);
+}
+
+HistoryItem *ShownChatListMessage(
+		not_null<Dialogs::Entry*> entry,
+		HistoryItem *item) {
+	if (!IgnoredItem(item)) {
+		return item;
+	}
+	const auto topic = entry->asTopic();
+	const auto sublist = entry->asSublist();
+	auto view = item->mainView();
+	for (auto i = 0; view && i != kMaxPreviewWalk; ++i) {
+		view = view->previousInBlocks();
+		if (!view) {
+			break;
+		}
+		const auto candidate = view->data();
+		if ((!topic || candidate->topic() == topic)
+			&& (!sublist || candidate->savedSublist() == sublist)
+			&& !IgnoredItem(candidate)) {
+			return candidate;
+		}
+	}
+	return nullptr;
+}
+
+MsgId FirstShownUnread(
+		not_null<Data::Thread*> thread,
+		const base::flat_set<MsgId> &ids) {
+	if (ids.empty() || !HideIgnored()) {
+		return ids.empty() ? MsgId() : ids.front();
+	}
+	const auto peer = thread->owningHistory()->peer;
+	auto skipped = base::flat_set<not_null<HistoryItem*>>();
+	auto result = MsgId();
+	for (const auto id : ids) {
+		const auto item = thread->owner().message(peer, id);
+		if (!item || !IgnoredItem(item)) {
+			result = id;
+			break;
+		} else if (!item->isUnreadMedia()) {
+			skipped.emplace(item);
+		}
+	}
+	if (!skipped.empty()) {
+		thread->session().api().markContentsRead(skipped);
+	}
+	return result;
+}
+
 IgnoredFade::IgnoredFade(
 		QPainter &p,
 		not_null<const HistoryView::Element*> view) {
