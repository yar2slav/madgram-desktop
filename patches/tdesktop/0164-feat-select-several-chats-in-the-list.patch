+constexpr auto kMuteForever = std::numeric_limits<TimeId>::max();
+constexpr auto kHour = TimeId(3600);
+constexpr auto kMutePeriods = std::array{ kHour, 8 * kHour, 48 * kHour };
+
+struct State {
+	State(
+		not_null<Window::SessionController*> controller,
+		not_null<Ui::RpWidget*> list);
+	~State();
+
+	const not_null<Window::SessionController*> controller;
+	const not_null<Ui::RpWidget*> list;
+	std::vector<not_null<History*>> chats;
+	History *anchor = nullptr;
+	rpl::event_stream<> changes;
+	base::unique_qptr<Ui::RpWidget> bar;
+};
+
+[[nodiscard]] base::flat_map<
+	not_null<Ui::RpWidget*>,
+	not_null<State*>> &Registry() {
+	static auto result = base::flat_map<
+		not_null<Ui::RpWidget*>,
+		not_null<State*>>();
+	return result;
+}
+
+State::State(
+	not_null<Window::SessionController*> controller,
+	not_null<Ui::RpWidget*> list)
+: controller(controller)
+, list(list) {
+	Registry().emplace(list, this);
+}
+
+State::~State() {
+	Registry().remove(list);
+}
+
+[[nodiscard]] State *Find(not_null<Ui::RpWidget*> list) {
+	const auto &registry = Registry();
+	const auto i = registry.find(list);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+void Changed(not_null<State*> state) {
+	state->list->update();
+	state->changes.fire({});
+}
+
+void Clear(not_null<State*> state) {
+	if (state->chats.empty() && !state->anchor) {
+		return;
+	}
+	state->chats.clear();
+	state->anchor = nullptr;
+	Changed(state);
+}
+
+void Add(not_null<State*> state, not_null<History*> history) {
+	if (!ranges::contains(state->chats, history)) {
+		state->chats.push_back(history);
+	}
+}
+
+void Toggle(not_null<State*> state, not_null<History*> history) {
+	auto &chats = state->chats;
+	const auto i = ranges::find(chats, history);
+	if (i != end(chats)) {
+		chats.erase(i);
+	} else {
+		chats.push_back(history);
+	}
+}
+
+void SelectRange(
+		not_null<State*> state,
+		not_null<Dialogs::IndexedList*> rows,
+		History *anchor,
+		not_null<History*> history) {
+	auto from = -1;
+	auto till = -1;
+	auto index = 0;
+	for (const auto &row : *rows) {
+		const auto current = row->history();
+		if (current == anchor) {
+			from = index;
+		}
+		if (current == history) {
+			till = index;
+		}
+		++index;
+	}
+	if (from < 0 || till < 0) {
+		Add(state, history);
+		return;
+	}
+	if (from > till) {
+		std::swap(from, till);
+	}
+	index = 0;
+	for (const auto &row : *rows) {
+		if (index >= from && index <= till) {
+			if (const auto current = row->history()) {
+				Add(state, current);
+			}
+		}
+		++index;
+	}
+}
+
+[[nodiscard]] QString ChatsCount(int count) {
+	return (count == 1)
+		? Lower(u"1 chat"_q)
+		: Lower(u"%1 chats"_q).arg(count);
+}
+
+class Bar final : public Ui::RpWidget {
+public:
+	Bar(not_null<Ui::RpWidget*> area, not_null<State*> state);
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+
+	not_null<Ui::IconButton*> addAction(
+		const style::icon &icon,
+		const QString &name,
+		Fn<void()> callback);
+	void refresh();
+	void updateControlsGeometry();
+	void toggleEscape(bool enabled);
+	[[nodiscard]] bool allArchived() const;
+	[[nodiscard]] not_null<Main::Session*> session() const;
+
+	void markAsRead();
+	void toggleArchived();
+	void showMuteMenu();
+	void mute(TimeId period);
+	void showFoldersMenu();
+	void addToFolder(FilterId id);
+	void deleteAndLeave();
+	void popup(not_null<Ui::IconButton*> button);
+
+	const not_null<Ui::RpWidget*> _area;
+	const not_null<State*> _state;
+	const not_null<Window::SessionController*> _controller;
+	object_ptr<Ui::IconButton> _clear;
+	std::vector<not_null<Ui::IconButton*>> _actions;
+	Ui::IconButton *_archive = nullptr;
+	Ui::IconButton *_mute = nullptr;
+	Ui::IconButton *_folder = nullptr;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+	rpl::lifetime _escape;
+	QString _text;
+	QString _count;
+	int _textLeft = 0;
+	int _textRight = 0;
+	bool _fits = false;
+
+};
+
+Bar::Bar(not_null<Ui::RpWidget*> area, not_null<State*> state)
+: RpWidget(area->parentWidget())
+, _area(area)
+, _state(state)
+, _controller(state->controller)
+, _clear(this, st::dialogsMenuToggle) {
+	_clear->setIconOverride(
+		&st::boxTitleCloseIcon,
+		&st::boxTitleCloseIconOver);
+	_clear->setAccessibleName(tr::lng_selected_clear(tr::now));
+	_clear->setClickedCallback([=] { Clear(_state); });
+	addAction(
+		st::menuIconMarkRead,
+		tr::lng_context_mark_read(tr::now),
+		[=] { markAsRead(); });
+	_archive = addAction(
+		st::menuIconArchive,
+		tr::lng_archived_add(tr::now),
+		[=] { toggleArchived(); });
+	_mute = addAction(
+		st::menuIconMute,
+		tr::lng_mute_menu_mute(tr::now),
+		[=] { showMuteMenu(); });
+	_folder = addAction(
+		st::menuIconAddToFolder,
+		tr::lng_filters_menu_add(tr::now),
+		[=] { showFoldersMenu(); });
+	addAction(
+		st::menuIconDelete,
+		tr::lng_profile_clear_and_exit(tr::now),
+		[=] { deleteAndLeave(); });
+
+	hide();
+	sizeValue() | rpl::on_next([=] {
+		refresh();
+	}, lifetime());
+	_state->changes.events() | rpl::on_next([=] {
+		refresh();
+	}, lifetime());
+}
+
+not_null<Ui::IconButton*> Bar::addAction(
+		const style::icon &icon,
+		const QString &name,
+		Fn<void()> callback) {
+	const auto button = Ui::CreateChild<Ui::IconButton>(
+		this,
+		st::dialogsMenuToggle);
+	button->setIconOverride(&icon, &icon);
+	button->setAccessibleName(name);
+	button->setClickedCallback(std::move(callback));
+	_actions.push_back(button);
+	return button;
+}
+
+not_null<Main::Session*> Bar::session() const {
+	return &_controller->session();
+}
+
+bool Bar::allArchived() const {
+	return !_state->chats.empty()
+		&& ranges::all_of(_state->chats, &Window::IsArchived);
+}
+
+void Bar::refresh() {
+	const auto count = int(_state->chats.size());
+	if (count) {
+		setGeometry(_area->geometry());
+		_folder->setVisible(session()->data().chatsFilters().has());
+		updateControlsGeometry();
+	}
+	if (!count || !_fits) {
+		toggleEscape(false);
+		hide();
+		return;
+	}
+	_count = QString::number(count);
+	_text = Lower(u"%1 selected"_q).arg(_count);
+	const auto archived = allArchived();
+	const auto &archive = archived
+		? st::menuIconUnarchive
+		: st::menuIconArchive;
+	_archive->setIconOverride(&archive, &archive);
+	_archive->setAccessibleName(archived
+		? tr::lng_archived_remove(tr::now)
+		: tr::lng_archived_add(tr::now));
+	toggleEscape(true);
+	if (isHidden()) {
+		show();
+	}
+	raise();
+	update();
+}
+
+void Bar::updateControlsGeometry() {
+	const auto skip = st::dialogsFilterPadding;
+	_clear->moveToLeft(skip.x(), skip.y());
+	auto right = width() - skip.x();
+	for (const auto &button : ranges::views::reverse(_actions)) {
+		if (!button->isHidden()) {
+			right -= button->width();
+			button->moveToLeft(right, skip.y());
+		}
+	}
+	_textLeft = _clear->x() + _clear->width();
+	_textRight = right;
+	_fits = (_textRight >= _textLeft);
+	update();
+}
+
+void Bar::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.fillRect(e->rect(), st::dialogsBg);
+	const auto available = _textRight - _textLeft;
+	if (available <= 0) {
+		return;
+	}
+	const auto &font = st::semiboldFont;
+	const auto &text = (font->width(_text) <= available) ? _text : _count;
+	if (font->width(text) > available) {
+		return;
+	}
+	p.setFont(font);
+	p.setPen(st::windowBoldFg);
+	p.drawTextLeft(
+		_textLeft,
+		(height() - font->height) / 2,
+		width(),
+		text);
+}
+
+void Bar::toggleEscape(bool enabled) {
+	if (!enabled) {
+		_escape.destroy();
+		return;
+	} else if (_escape) {
+		return;
+	}
+	base::install_event_filter(qApp, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::KeyPress) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto key = static_cast<QKeyEvent*>(e.get());
+		if (key->key() != Qt::Key_Escape
+			|| (key->modifiers() != Qt::NoModifier)
+			|| (QApplication::activeWindow() != window())
+			|| QApplication::activePopupWidget()
+			|| _controller->isLayerShown()) {
+			return base::EventFilterResult::Continue;
+		}
+		Clear(_state);
+		return base::EventFilterResult::Cancel;
+	}, _escape);
+}
+
+void Bar::popup(not_null<Ui::IconButton*> button) {
+	_menu->popup(button->mapToGlobal(QPoint(0, button->height())));
+}
+
+void Bar::markAsRead() {
+	for (const auto &history : _state->chats) {
+		const auto channel = history->peer->asChannel();
+		const auto info = (channel && channel->isCommunity())
+			? channel->communityInfo()
+			: nullptr;
+		if (info) {
+			MarkAsReadMenu::MarkAsReadChatList(info->chatsList());
+		} else if (MarkAsReadMenu::IsUnreadThread(history)) {
+			MarkAsReadMenu::MarkAsReadThread(history);
+		}
+	}
+	Clear(_state);
+}
+
+void Bar::toggleArchived() {
+	const auto archive = !allArchived();
+	auto list = std::vector<not_null<History*>>();
+	for (const auto &history : _state->chats) {
+		if (Window::CanArchive(history, history->peer)
+			&& (Window::IsArchived(history) != archive)) {
+			list.push_back(history);
+		}
+	}
+	if (!list.empty()) {
+		const auto last = list.back();
+		list.pop_back();
+		for (const auto &history : list) {
+			history->session().api().toggleHistoryArchived(
+				history,
+				archive,
+				[] {});
+		}
+		Window::ToggleHistoryArchived(_controller->uiShow(), last, archive);
+	}
+	Clear(_state);
+}
+
+void Bar::showMuteMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	for (const auto period : kMutePeriods) {
+		_menu->addAction(
+			tr::lng_mute_menu_duration_any(
+				tr::now,
+				lt_duration,
+				Ui::FormatMuteFor(period)),
+			[=] { mute(period); },
+			&st::menuIconMuteFor);
+	}
+	_menu->addAction(
+		tr::lng_mute_menu_duration_forever(tr::now),
+		[=] { mute(kMuteForever); },
+		&st::menuIconMute);
+	_menu->addAction(
+		tr::lng_mute_menu_duration_unmute(tr::now),
+		[=] { mute(0); },
+		&st::menuIconUnmute);
+	popup(_mute);
+}
+
+void Bar::mute(TimeId period) {
+	for (const auto &history : _state->chats) {
+		if (!history->peer->isSelf() && !history->isForum()) {
+			MuteMenu::ThreadDescriptor(history).updateMutePeriod(period);
+		}
+	}
+	Clear(_state);
+}
+
+void Bar::showFoldersMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	for (const auto &filter : session()->data().chatsFilters().list()) {
+		const auto id = filter.id();
+		if (!id) {
+			continue;
+		}
+		const auto contains = [&](not_null<History*> history) {
+			return filter.contains(history);
+		};
+		const auto all = ranges::all_of(_state->chats, contains);
+		const auto action = _menu->addAction(
+			Ui::Text::FixAmpersandInAction(filter.title().text.text),
+			[=] { addToFolder(id); },
+			all ? &st::mediaPlayerMenuCheck : nullptr);
+		action->setEnabled(!all);
+	}
+	if (_menu->empty()) {
+		_menu = nullptr;
+		return;
+	}
+	popup(_folder);
+}
+
+void Bar::addToFolder(FilterId id) {
+	const auto owner = &session()->data();
+	const auto &list = owner->chatsFilters().list();
+	const auto i = ranges::find(list, id, &Data::ChatFilter::id);
+	if (i == end(list)) {
+		return;
+	}
+	const auto was = *i;
+	auto add = std::vector<not_null<History*>>();
+	for (const auto &history : _state->chats) {
+		if (ChooseFilterValidator(history).canAdd(id)) {
+			add.push_back(history);
+		}
+	}
+	if (add.empty()) {
+		Clear(_state);
+		return;
+	}
+	auto always = base::duplicate(was.always());
+	auto never = base::duplicate(was.never());
+	for (const auto &history : add) {
+		never.remove(history);
+	}
+	const auto without = Data::ChatFilter(
+		id,
+		was.title(),
+		was.iconEmoji(),
+		was.colorIndex(),
+		was.flags(),
+		base::duplicate(always),
+		was.pinned(),
+		base::duplicate(never));
+	for (const auto &history : add) {
+		if (!without.contains(history)) {
+			always.insert(history);
+		}
+	}
+	const auto count = int(was.always().size());
+	if (int(always.size()) > std::max(owner->pinnedChatsLimit(id), count)) {
+		_controller->show(Box(FilterChatsLimitBox, session(), count, true));
+		return;
+	}
+	const auto filter = Data::ChatFilter(
+		id,
+		was.title(),
+		was.iconEmoji(),
+		was.colorIndex(),
+		was.flags(),
+		std::move(always),
+		was.pinned(),
+		std::move(never));
+	owner->chatsFilters().set(filter);
+	if (!IsLocalFolder(id)) {
+		session()->api().request(MTPmessages_UpdateDialogFilter(
+			MTP_flags(MTPmessages_UpdateDialogFilter::Flag::f_filter),
+			MTP_int(id),
+			filter.tl()
+		)).fail([=] {
+			owner->chatsFilters().set(was);
+		}).send();
+	}
+	Clear(_state);
+}
+
+void Bar::deleteAndLeave() {
+	if (_controller->showFrozenError()) {
+		return;
+	}
+	auto peers = std::vector<not_null<PeerData*>>();
+	auto owned = false;
+	for (const auto &history : _state->chats) {
+		const auto peer = history->peer;
+		if (const auto channel = peer->asChannel()) {
+			if (!channel->amIn()) {
+				continue;
+			} else if (channel->amCreator()) {
+				owned = true;
+				continue;
+			}
+		} else if (const auto chat = peer->asChat()) {
+			if (chat->amCreator()) {
+				owned = true;
+				continue;
+			}
+		}
+		peers.push_back(peer);
+	}
+	const auto skipped = owned
+		? Lower(u"Groups and channels you own are skipped."_q)
+		: QString();
+	if (peers.empty()) {
+		if (owned) {
+			_controller->showToast(skipped);
+		}
+		return;
+	}
+	auto text = Lower(u"Delete and leave %1?"_q).arg(
+		ChatsCount(int(peers.size())));
+	if (owned) {
+		text += u"\n\n"_q + skipped;
+	}
+	const auto clear = crl::guard(this, [=] { Clear(_state); });
+	_controller->show(Ui::MakeConfirmBox({
+		.text = text,
+		.confirmed = [=](Fn<void()> close) {
+			for (const auto &peer : peers) {
+				Core::App().closeChatFromWindows(peer);
+				peer->session().api().deleteConversation(peer, false);
+			}
+			clear();
+			close();
+		},
+		.confirmText = tr::lng_profile_clear_and_exit(),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+} // namespace
+
+void SetupChatsSelection(
+		not_null<Window::SessionController*> controller,
+		not_null<Ui::RpWidget*> list,
+		not_null<Ui::RpWidget*> area) {
+	const auto state = list->lifetime().make_state<State>(controller, list);
+	auto bar = base::make_unique_q<Bar>(area, state);
+	const auto raw = bar.get();
+	state->bar = std::move(bar);
+	area->geometryValue() | rpl::on_next([=](QRect geometry) {
+		raw->setGeometry(geometry);
+	}, raw->lifetime());
+	SelectChatsValue() | rpl::filter(
+		!rpl::mappers::_1
+	) | rpl::on_next([=] {
+		Clear(state);
+	}, raw->lifetime());
+}
+
+bool ChatsSelectionClick(
+		not_null<Ui::RpWidget*> list,
+		not_null<Dialogs::IndexedList*> rows,
+		Dialogs::Row *row,
+		Qt::MouseButton button,
+		Qt::KeyboardModifiers modifiers) {
+	const auto state = Find(list);
+	const auto history = row ? row->history() : nullptr;
+	if (!state
+		|| !history
+		|| (button != Qt::LeftButton)
+		|| modifiers.testFlag(Qt::ControlModifier)
+		|| !SelectChats()) {
+		return false;
+	}
+	const auto range = modifiers.testFlag(Qt::ShiftModifier);
+	if (!range && !modifiers.testFlag(Qt::AltModifier)) {
+		return false;
+	}
+	if (range) {
+		const auto active = state->controller->activeChatEntryCurrent();
+		const auto anchor = state->anchor
+			? state->anchor
+			: state->chats.empty()
+			? active.key.history()
+			: nullptr;
+		SelectRange(state, rows, anchor, history);
+	} else {
+		Toggle(state, history);
+	}
+	state->anchor = history;
+	Changed(state);
+	return true;
+}
+
+bool ChatsSelectionActive(
+		not_null<Ui::RpWidget*> list,
+		not_null<Dialogs::Row*> row,
+		bool active) {
+	const auto state = Find(list);
+	if (!state || state->chats.empty()) {
+		return active;
+	}
+	const auto history = row->history();
+	return history && ranges::contains(state->chats, not_null(history));
+}
+
+void ClearChatsSelection(not_null<Ui::RpWidget*> list) {
+	if (const auto state = Find(list)) {
+		Clear(state);
+	}
+}
+
+} // namespace Tele
