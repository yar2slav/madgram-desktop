From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 11 Oct 2026 18:35:22 +0300
Subject: [PATCH] feat: scroll to zoom in the media viewer

---
 .../media/view/media_view_overlay_widget.cpp          |  6 ++++--
 Telegram/SourceFiles/settings/settings_tele.cpp       |  4 ++++
 Telegram/SourceFiles/tele/tele_options.cpp            | 11 +++++++++++
 Telegram/SourceFiles/tele/tele_options.h              |  2 ++
 Telegram/SourceFiles/tele/tele_settings_io.cpp        |  1 +
 5 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp b/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
index 7106d64fae4ccb5d2570b034419b0490f514e938..a4789941f02fdda72e5ea152d41e20fbe6b8c803 100644
--- a/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
+++ b/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
@@ -7652,18 +7652,20 @@ void OverlayWidget::handleWheelEvent(not_null<QWheelEvent*> e) {
 		&& ((e->source() == Qt::MouseEventNotSynthesized)
 			|| (e->source() == Qt::MouseEventSynthesizedBySystem));
 	const auto anchor = zoomAnchor(e->globalPosition());
+	const auto zoom = (e->modifiers().testFlag(Qt::ControlModifier)
+		!= (Tele::ScrollZoom() && !_stories));
 	_verticalWheelDelta += angle.y();
 	while (std::abs(_verticalWheelDelta) >= step) {
 		if (_verticalWheelDelta < 0) {
 			_verticalWheelDelta += step;
-			if (e->modifiers().testFlag(Qt::ControlModifier)) {
+			if (zoom) {
 				zoomOut(anchor);
 			} else if (acceptForJump) {
 				moveToNext(1);
 			}
 		} else {
 			_verticalWheelDelta -= step;
-			if (e->modifiers().testFlag(Qt::ControlModifier)) {
+			if (zoom) {
 				zoomIn(anchor);
 			} else if (acceptForJump) {
 				moveToNext(-1);
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 3f1c925fcbacd18a2d7761b9c606a7942e75ea3f..425357c8983838fde279ca1224e912b9600a6816 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -2793,6 +2793,10 @@ void FillInterface(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionSmoothScroll,
 		{ u"wheel"_q, u"mouse"_q, u"animation"_q, u"scroll"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionScrollZoom,
+		{ u"trackpad"_q, u"touchpad"_q, u"wheel"_q, u"photo"_q });
 	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Chat list"_q);
 	AddOptionToggle(builder, ::Tele::kOptionHideAllChats);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 54092d4f6e361e736e3f5858da987a1bf5afc44d..92a95b83586757bf45304a429276fdb9e53a7b77 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -63,6 +63,7 @@ const char kOptionReduceMotion[] = "tele-reduce-motion";
 const char kOptionReduceMotionSaved[] = "tele-reduce-motion-saved";
 const char kOptionListKeys[] = "tele-list-keys";
 const char kOptionSmoothScroll[] = "tele-smooth-scroll";
+const char kOptionScrollZoom[] = "tele-scroll-zoom";
 const char kOptionStaticUserpicsChats[] = "tele-static-userpics-chats";
 const char kOptionHideMentionsButton[] = "tele-hide-mentions-button";
 const char kOptionHideReactionsButton[] = "tele-hide-reactions-button";
@@ -620,6 +621,12 @@ base::options::toggle SmoothScrollOption({
 	.description = "Eases each mouse wheel step, like profiles already do.",
 });
 
+base::options::toggle ScrollZoomOption({
+	.id = kOptionScrollZoom,
+	.name = "Scroll to zoom in the media viewer",
+	.description = "Hold Ctrl or Cmd while scrolling to switch photos.",
+});
+
 base::options::toggle StaticUserpicsChatsOption({
 	.id = kOptionStaticUserpicsChats,
 	.name = "Static userpics in chats and profiles",
@@ -3475,6 +3482,10 @@ bool ViewerLoop() {
 	return ViewerLoopOption.value();
 }
 
+bool ScrollZoom() {
+	return ScrollZoomOption.value();
+}
+
 void SetViewerLoop(bool enabled) {
 	ViewerLoopOption.set(enabled);
 }
