+bool ComposerEditing::indentSelectedLines(bool backward) {
+	auto cursor = _field->textCursor();
+	const auto from = cursor.selectionStart();
+	const auto till = cursor.selectionEnd();
+	const auto reverse = cursor.position() < cursor.anchor();
+	auto firstBreak = from;
+	while (firstBreak < till
+		&& !IsNewline(_document->characterAt(firstBreak))) {
+		++firstBreak;
+	}
+	if (firstBreak == till) {
+		return false;
+	}
+	auto start = from;
+	while (start > 0 && !IsNewline(_document->characterAt(start - 1))) {
+		--start;
+	}
+	auto starts = std::vector<int>{ start };
+	for (auto i = firstBreak; i + 1 < till; ++i) {
+		if (IsNewline(_document->characterAt(i))) {
+			starts.push_back(i + 1);
+		}
+	}
+	const auto mode = ComposerIndentation();
+	const auto width = (mode == u"2"_q) ? 2 : 4;
+	const auto prefix = backward
+		? QString()
+		: (mode == u"tab"_q)
+		? QString(QChar('\t'))
+		: QString(width, QChar(' '));
+	auto mappedFrom = from;
+	auto mappedTill = till;
+	_pairs.clear();
+	_handling = true;
+	cursor.beginEditBlock();
+	// Work backwards so stored line starts and selection endpoints stay in
+	// the original document's coordinates throughout the operation.
+	for (auto i = int(starts.size()); i > 0; --i) {
+		const auto at = starts[i - 1];
+		cursor.setPosition(at);
+		if (backward) {
+			auto removed = 0;
+			if (_document->characterAt(at) == QChar('\t')) {
+				removed = 1;
+			} else {
+				while (removed < width
+					&& _document->characterAt(at + removed) == QChar(' ')) {
+					++removed;
+				}
+			}
+			if (!removed) {
+				continue;
+			}
+			cursor.setPosition(at + removed, QTextCursor::KeepAnchor);
+			cursor.removeSelectedText();
+			mappedFrom -= std::min(removed, std::max(from - at, 0));
+			mappedTill -= std::min(removed, std::max(till - at, 0));
+		} else {
+			// A fresh format prevents links or custom emoji at the line's
+			// beginning from turning the indentation into tagged content.
+			cursor.insertText(prefix, QTextCharFormat());
+			if (from >= at) {
+				mappedFrom += prefix.size();
+			}
+			if (till >= at) {
+				mappedTill += prefix.size();
+			}
+		}
+	}
+	cursor.endEditBlock();
+	cursor.setPosition(reverse ? mappedTill : mappedFrom);
+	cursor.setPosition(
+		reverse ? mappedFrom : mappedTill,
+		QTextCursor::KeepAnchor);
+	_field->setTextCursor(cursor);
+	_handling = false;
+	return true;
+}
+
 void ComposerEditing::wrap(QChar opening, QChar closing) {
 	_pairs.clear();
 	_handling = true;
