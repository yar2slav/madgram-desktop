From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Wed, 7 Oct 2026 20:52:07 +0300
Subject: [PATCH] feat: fix fonts picked in chat settings

---
 Telegram/SourceFiles/core/application.cpp       |  2 ++
 Telegram/SourceFiles/settings/settings_tele.cpp |  6 ++++++
 Telegram/SourceFiles/tele/tele_options.cpp      | 13 +++++++++++++
 Telegram/SourceFiles/tele/tele_options.h        |  2 ++
 Telegram/SourceFiles/tele/tele_settings_io.cpp  |  1 +
 5 files changed, 24 insertions(+)

diff --git a/Telegram/SourceFiles/core/application.cpp b/Telegram/SourceFiles/core/application.cpp
index 25141c423c5774c35ccd14bd60770083bbe378f5..2364d5b563c750abb57d389c3ca5558d08d99aa0 100644
--- a/Telegram/SourceFiles/core/application.cpp
+++ b/Telegram/SourceFiles/core/application.cpp
@@ -114,6 +114,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "tele/tele_counters.h"
 #include "tele/tele_bubble_padding.h"
 #include "tele/tele_freeze_watchdog.h"
+#include "tele/tele_options.h"
 #include "tele/tele_start_menu.h"
 
 #include <QtCore/QStandardPaths>
@@ -327,6 +328,7 @@ void Application::run() {
 	startLocalStorage();
 
 	style::SetCustomFont(settings().customFontFamily());
+	style::SetCustomFontFix(Tele::FontFix());
 	style::internal::StartFonts();
 
 	Test::ApplyStartupOverrides();
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index c9eceeb9eef194a3c059e43863c6fc655a8d865d..8be2bfde6a4b4acf15fe989d369a0850894a88a4 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -4005,6 +4005,12 @@ void FillDebug(SectionBuilder &builder) {
 	AddGroupTitle(builder, u"MTProto"_q);
 	AddMtpInspector(builder);
 	AddMtpConsole(builder);
+	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Fonts"_q);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionFontFix,
+		{ u"font family"_q, u"cut off"_q, u"directwrite"_q, u"google sans"_q });
 	AddSkip(builder);
 }
 
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index d3747418f43699162d3aa53e3f0c351dd959acf3..7ef37fbdc4db36587e35291eeeecea38f46eb88e 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -35,6 +35,7 @@ const char kOptionGroupCallButton[] = "tele-group-call-button";
 const char kOptionLowercase[] = "tele-lowercase";
 const char kOptionScaleOnePercent[] = "tele-scale-1";
 const char kOptionSmallWindow[] = "tele-small-window";
+const char kOptionFontFix[] = "tele-font-fix";
 const char kOptionHideSponsored[] = "tele-hide-sponsored";
 const char kOptionHideProxySponsor[] = "tele-hide-proxy-sponsor";
 const char kOptionNoLinkWarning[] = "tele-no-link-warning";
@@ -398,6 +399,14 @@ base::options::toggle SmallWindowOption({
 	.description = "256x256 px instead of 380x480.",
 });
 
+base::options::toggle FontFixOption({
+	.id = kOptionFontFix,
+	.name = "Fix fonts picked in chat settings",
+	.description = "For fonts that come out shifted or cut off.",
+	.scope = base::options::windows,
+	.restartRequired = true,
+});
+
 base::options::toggle HideCallsOption({
 	.id = kOptionHideCalls,
 });
@@ -1841,6 +1850,10 @@ rpl::producer<> SmallWindowChanges() {
 	return SmallWindowOption.changes() | rpl::to_empty;
 }
 
+bool FontFix() {
+	return FontFixOption.value();
+}
+
 QString CallButton() {
 	MigrateHideCalls();
 	return CallButtonOption.value();
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 5877ac0505c18f678170054deaa558110b524cf6..8ec3e810ecd0c91a892259db9af8026acca1ba40 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -30,6 +30,7 @@ extern const char kOptionGroupCallButton[];
 extern const char kOptionLowercase[];
 extern const char kOptionScaleOnePercent[];
 extern const char kOptionSmallWindow[];
+extern const char kOptionFontFix[];
 extern const char kOptionHideSponsored[];
 extern const char kOptionHideProxySponsor[];
 extern const char kOptionNoLinkWarning[];
@@ -269,6 +270,7 @@ void SetKnownSettings(const QString &value);
 [[nodiscard]] bool ScaleOnePercent();
 [[nodiscard]] bool SmallWindow();
 [[nodiscard]] rpl::producer<> SmallWindowChanges();
+[[nodiscard]] bool FontFix();
 [[nodiscard]] QString CallButton();
 void SetCallButton(const QString &value);
 [[nodiscard]] rpl::producer<QString> CallButtonValue();
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index 8c04f19ecbd4b76ef4fd61fed55d4636afea50cc..e95df488a3729bd8bece38d3d9afea147fb3ce77 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
+++ b/Telegram/SourceFiles/tele/tele_settings_io.cpp
@@ -123,6 +123,7 @@ struct Spec {
 		Toggle(kOptionLowercase),
 		Toggle(kOptionScaleOnePercent),
 		Toggle(kOptionSmallWindow),
+		Toggle(kOptionFontFix),
 		Toggle(kOptionHideSponsored),
 		Toggle(kOptionHideProxySponsor),
 		Toggle(kOptionNoLinkWarning),
