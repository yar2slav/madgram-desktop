diff --git a/Telegram/SourceFiles/tele/tele_message_menu.cpp b/Telegram/SourceFiles/tele/tele_message_menu.cpp
index d07df405b20a1569f376a0387355becbb113a9b2..cea38f1190b6fcad7455c77a5166b0baa1125bf5 100644
--- a/Telegram/SourceFiles/tele/tele_message_menu.cpp
+++ b/Telegram/SourceFiles/tele/tele_message_menu.cpp
@@ -25,6 +25,7 @@
 
 #include <QtGui/QClipboard>
 #include <QtGui/QGuiApplication>
+#include <QtCore/QDir>
 
 namespace Tele {
 namespace {
@@ -207,4 +208,23 @@ void AddCopyEmojiIdAction(
 		&st::menuIconCopy);
 }
 
+void AddCopyFilePathAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<DocumentData*> document,
+		Fn<bool()> showCopyRestriction) {
+	if (!CopyFilePath()) {
+		return;
+	}
+	const auto path = document->filepath(true);
+	if (path.isEmpty()) {
+		return;
+	}
+	const auto text = QDir::toNativeSeparators(path);
+	menu->addAction(Lower(u"Copy file path"_q), [=] {
+		if (!showCopyRestriction()) {
+			QGuiApplication::clipboard()->setText(text);
+		}
+	}, &st::menuIconCopy);
+}
+
 } // namespace Tele
