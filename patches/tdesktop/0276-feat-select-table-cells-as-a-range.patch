@@ -0,0 +1,285 @@
+#include "tele/tele_table_selection.h"
+
+#include "iv/markdown/iv_markdown_article.h"
+#include "iv/markdown/iv_markdown_article_selection.h"
+#include "ui/painter.h"
+
+#include <QtGui/QPainterPath>
+
+#include <algorithm>
+
+namespace Tele {
+
+using namespace Iv::Markdown;
+
+namespace {
+
+struct CellSpan {
+	int row = 0;
+	int column = 0;
+	int rowspan = 1;
+	int colspan = 1;
+};
+
+[[nodiscard]] int CellRow(
+		const LaidOutBlock &block,
+		const LaidOutTableCell *cell) {
+	for (auto i = 0, count = int(block.tableRows.size()); i != count; ++i) {
+		for (const auto &current : block.tableRows[i].cells) {
+			if (&current == cell) {
+				return i;
+			}
+		}
+	}
+	return -1;
+}
+
+[[nodiscard]] CellSpan SpanOf(const LaidOutTableCell &cell, int row) {
+	return {
+		.row = row,
+		.column = std::max(cell.column, 0),
+		.rowspan = std::max(cell.rowspan, 1),
+		.colspan = std::max(cell.colspan, 1),
+	};
+}
+
+[[nodiscard]] bool Intersects(const CellSpan &span, const TableCellRange &range) {
+	return (span.row < range.rowTill)
+		&& (range.rowFrom < span.row + span.rowspan)
+		&& (span.column < range.columnTill)
+		&& (range.columnFrom < span.column + span.colspan);
+}
+
+[[nodiscard]] const Iv::RichPage::Block *ResolveBlock(
+		const Iv::RichPage &page,
+		const PreparedEditBlockPath &path) {
+	auto blocks = &page.blocks;
+	for (const auto &step : path.container.steps) {
+		if (step.kind == PreparedEditBlockContainerKind::Root) {
+			blocks = &page.blocks;
+			continue;
+		} else if (step.blockIndex < 0
+			|| step.blockIndex >= int(blocks->size())) {
+			return nullptr;
+		}
+		const auto &parent = (*blocks)[step.blockIndex];
+		if (step.kind == PreparedEditBlockContainerKind::BlockChildren) {
+			blocks = &parent.blocks;
+		} else if (step.listItemIndex >= 0
+			&& step.listItemIndex < int(parent.listItems.size())) {
+			blocks = &parent.listItems[step.listItemIndex].blocks;
+		} else {
+			return nullptr;
+		}
+	}
+	return (path.index >= 0 && path.index < int(blocks->size()))
+		? &(*blocks)[path.index]
+		: nullptr;
+}
+
+} // namespace
+
+int TableCellRangeTable(const PaintSelectionState &state) {
+	if (!state.segments
+		|| state.hasStructuralSelection()
+		|| state.selection.empty()) {
+		return -1;
+	}
+	const auto first = state.selection.from.segment;
+	const auto second = state.selection.to.segment;
+	if (first == second) {
+		return -1;
+	}
+	if (state.endpoints) {
+		const auto &from = state.endpoints->from;
+		const auto &to = state.endpoints->to;
+		const auto same = ((first == from.segment) && (second == to.segment))
+			|| ((first == to.segment) && (second == from.segment));
+		if (!from.direct || !to.direct || !same) {
+			return -1;
+		}
+	}
+	const auto a = FindSegment(state.segments, first);
+	const auto b = FindSegment(state.segments, second);
+	if (!a
+		|| !b
+		|| !a->cell
+		|| !b->cell
+		|| !a->block
+		|| (a->block != b->block)
+		|| (a->tableSegmentIndex < 0)
+		|| (a->tableSegmentIndex != b->tableSegmentIndex)) {
+		return -1;
+	}
+	return a->tableSegmentIndex;
+}
+
+std::optional<TableCellRange> FindTableCellRange(
+		const PaintSelectionState &state) {
+	const auto table = TableCellRangeTable(state);
+	if (table < 0) {
+		return std::nullopt;
+	}
+	const auto a = FindSegment(state.segments, state.selection.from.segment);
+	const auto b = FindSegment(state.segments, state.selection.to.segment);
+	const auto &block = *a->block;
+	const auto rowA = CellRow(block, a->cell);
+	const auto rowB = CellRow(block, b->cell);
+	if (rowA < 0 || rowB < 0) {
+		return std::nullopt;
+	}
+	const auto spanA = SpanOf(*a->cell, rowA);
+	const auto spanB = SpanOf(*b->cell, rowB);
+	auto result = TableCellRange{
+		.block = &block,
+		.tableSegmentIndex = table,
+		.rowFrom = std::min(spanA.row, spanB.row),
+		.rowTill = std::max(
+			spanA.row + spanA.rowspan,
+			spanB.row + spanB.rowspan),
+		.columnFrom = std::min(spanA.column, spanB.column),
+		.columnTill = std::max(
+			spanA.column + spanA.colspan,
+			spanB.column + spanB.colspan),
+	};
+	auto changed = true;
+	while (changed) {
+		changed = false;
+		for (auto i = 0, count = int(block.tableRows.size()); i != count; ++i) {
+			for (const auto &cell : block.tableRows[i].cells) {
+				const auto span = SpanOf(cell, i);
+				if (!Intersects(span, result)) {
+					continue;
+				}
+				const auto rowFrom = std::min(result.rowFrom, span.row);
+				const auto rowTill = std::max(
+					result.rowTill,
+					span.row + span.rowspan);
+				const auto columnFrom = std::min(
+					result.columnFrom,
+					span.column);
+				const auto columnTill = std::max(
+					result.columnTill,
+					span.column + span.colspan);
+				if (rowFrom != result.rowFrom
+					|| rowTill != result.rowTill
+					|| columnFrom != result.columnFrom
+					|| columnTill != result.columnTill) {
+					result.rowFrom = rowFrom;
+					result.rowTill = rowTill;
+					result.columnFrom = columnFrom;
+					result.columnTill = columnTill;
+					changed = true;
+				}
+			}
+		}
+	}
+	result.rowTill = std::min(result.rowTill, int(block.tableRows.size()));
+	return result;
+}
+
+std::optional<bool> TableCellRangeContains(
+		const PaintSelectionState &state,
+		int segmentIndex) {
+	const auto range = FindTableCellRange(state);
+	if (!range) {
+		return std::nullopt;
+	}
+	const auto segment = FindSegment(state.segments, segmentIndex);
+	if (!segment
+		|| !segment->cell
+		|| (segment->tableSegmentIndex != range->tableSegmentIndex)) {
+		return false;
+	}
+	const auto row = CellRow(*range->block, segment->cell);
+	return (row >= 0) && Intersects(SpanOf(*segment->cell, row), *range);
+}
+
+std::optional<std::vector<Iv::RichPage::Block>> TableCellRangeBlocks(
+		const Iv::RichPage &page,
+		const PaintSelectionState &state) {
+	const auto range = FindTableCellRange(state);
+	if (!range) {
+		return std::nullopt;
+	}
+	const auto fail = std::vector<Iv::RichPage::Block>();
+	const auto &block = *range->block;
+	auto source = (const Iv::RichPage::Block*)nullptr;
+	auto rows = std::vector<Iv::RichPage::TableRow>();
+	for (auto i = range->rowFrom; i != range->rowTill; ++i) {
+		auto &row = rows.emplace_back();
+		if (i < 0 || i >= int(block.tableRows.size())) {
+			continue;
+		}
+		for (const auto &cell : block.tableRows[i].cells) {
+			if (!Intersects(SpanOf(cell, i), *range)) {
+				continue;
+			} else if (!cell.editCell) {
+				return fail;
+			}
+			const auto &edit = *cell.editCell;
+			if (!source) {
+				source = ResolveBlock(page, edit.block);
+				if (!source || source->kind != Iv::RichPage::BlockKind::Table) {
+					return fail;
+				}
+			}
+			if (edit.tableRowIndex < 0
+				|| edit.tableRowIndex >= int(source->tableRows.size())) {
+				return fail;
+			}
+			const auto &cells = source->tableRows[edit.tableRowIndex].cells;
+			if (edit.tableCellIndex < 0
+				|| edit.tableCellIndex >= int(cells.size())) {
+				return fail;
+			}
+			auto copy = cells[edit.tableCellIndex];
+			copy.colspan = std::max(cell.colspan, 1);
+			copy.rowspan = std::max(cell.rowspan, 1);
+			row.cells.push_back(std::move(copy));
+		}
+	}
+	if (!source) {
+		return fail;
+	}
+	auto result = *source;
+	result.anchorId = QString();
+	result.caption = Iv::RichPage::RichText();
+	result.tableRows = std::move(rows);
+	return std::vector<Iv::RichPage::Block>{ std::move(result) };
+}
+
+void PaintTableCellRange(
+		Painter &p,
+		const LaidOutBlock &block,
+		const QPainterPath &shape,
+		QRect clip,
+		const PaintSelectionState &state) {
+	if (clip.isEmpty()
+		|| (block.segmentIndex < 0)
+		|| (block.segmentIndex != TableCellRangeTable(state))) {
+		return;
+	}
+	const auto range = FindTableCellRange(state);
+	if (!range || (range->block != &block)) {
+		return;
+	}
+	auto united = QRect();
+	for (auto i = 0, count = int(block.tableRows.size()); i != count; ++i) {
+		for (const auto &cell : block.tableRows[i].cells) {
+			if (!cell.outer.isEmpty() && Intersects(SpanOf(cell, i), *range)) {
+				united = united.united(cell.outer);
+			}
+		}
+	}
+	if (united.isEmpty() || !united.intersects(clip)) {
+		return;
+	}
+	p.save();
+	p.setClipRect(clip, Qt::IntersectClip);
+	p.setClipPath(shape, Qt::IntersectClip);
+	p.fillRect(united, p.textPalette().selectOverlay);
+	p.restore();
+}
+
+} // namespace Tele
