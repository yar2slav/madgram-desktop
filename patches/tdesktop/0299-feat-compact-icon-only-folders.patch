new file mode 100644
index 0000000000000000000000000000000000000000..7aa7fe9d0fac9b0e99fccfb92c4accb195e2c88e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_compact_folders.cpp
@@ -0,0 +1,504 @@
+#include "tele/tele_compact_folders.h"
+
+#include "base/event_filter.h"
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "tele/tele_options.h"
+#include "ui/painter.h"
+#include "ui/widgets/chat_filters_tabs_mode.h"
+#include "ui/widgets/side_bar_button.h"
+#include "styles/style_widgets.h"
+#include "styles/style_window.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kBarIconScale = 0.6;
+constexpr auto kBarHeightScale = 30. / 54.;
+constexpr auto kBadgeFontScale = 0.75;
+constexpr auto kTabIconScale = 0.75;
+constexpr auto kTabSkipScale = 0.25;
+constexpr auto kLockedOpacity = 0.6;
+constexpr auto kMaxTabIcons = 256;
+
+struct BarStyle {
+	not_null<const style::SideBarButton*> original;
+	std::unique_ptr<style::SideBarButton> compact;
+};
+
+struct BarCache {
+	QImage image;
+	const style::icon *icon = nullptr;
+	QSize size;
+	int badgeWidth = 0;
+	bool locked = false;
+};
+
+struct BarButton {
+	not_null<const style::SideBarButton*> st;
+	Fn<bool()> active;
+	const style::icon *icon = nullptr;
+	const style::icon *iconActive = nullptr;
+	Ui::Text::String badge;
+	bool badgeMuted = false;
+	int badgeWidth = 0;
+	BarCache cache[2];
+	QImage lock[2];
+};
+
+struct TabsStyle {
+	not_null<const style::SettingsSlider*> original;
+	std::unique_ptr<style::SettingsSlider> copy;
+};
+
+[[nodiscard]] int Scaled(int value, float64 scale) {
+	return int(base::SafeRound(value * scale));
+}
+
+[[nodiscard]] QSize Scaled(QSize size, float64 scale) {
+	return QSize(Scaled(size.width(), scale), Scaled(size.height(), scale));
+}
+
+[[nodiscard]] bool IconsOnly(Ui::ChatsFiltersTabsMode mode) {
+	return (mode == Ui::ChatsFiltersTabsMode::IconsOnly);
+}
+
+[[nodiscard]] std::vector<BarStyle> &BarStyles() {
+	static auto result = std::vector<BarStyle>();
+	return result;
+}
+
+[[nodiscard]] auto BarButtons()
+-> base::flat_map<not_null<Ui::SideBarButton*>, std::shared_ptr<BarButton>>& {
+	static auto result = base::flat_map<
+		not_null<Ui::SideBarButton*>,
+		std::shared_ptr<BarButton>>();
+	return result;
+}
+
+[[nodiscard]] std::vector<TabsStyle> &TabsStyles() {
+	static auto result = std::vector<TabsStyle>();
+	return result;
+}
+
+[[nodiscard]] auto TabIcons()
+-> base::flat_map<std::pair<const style::icon*, QRgb>, QImage>& {
+	static auto result = base::flat_map<
+		std::pair<const style::icon*, QRgb>,
+		QImage>();
+	return result;
+}
+
+[[nodiscard]] base::flat_map<const style::icon*, QSize> &TabIconSizes() {
+	static auto result = base::flat_map<const style::icon*, QSize>();
+	return result;
+}
+
+[[nodiscard]] std::unique_ptr<style::SideBarButton> MakeCompact(
+		const style::SideBarButton &st) {
+	auto result = std::make_unique<style::SideBarButton>(st);
+	const auto &font = st.badgeStyle.font;
+	result->badgeStyle.font = style::font(
+		std::max(Scaled(font->size(), kBadgeFontScale), 1),
+		font->flags(),
+		font->family());
+	result->minHeight = Scaled(st.minHeight, kBarHeightScale);
+	result->badgeHeight = result->badgeStyle.font->height;
+	result->badgeSkip = Scaled(st.badgeSkip, 0.5);
+	result->badgeStroke = std::max(Scaled(st.badgeStroke, 0.5), 1);
+	result->badgePosition = QPoint(
+		Scaled(st.badgePosition.x(), kBarIconScale),
+		(result->minHeight / 2)
+			- Scaled((st.minHeight / 2) - st.badgePosition.y(), kBarIconScale));
+	return result;
+}
+
+[[nodiscard]] bool IsCompactStyle(const style::SideBarButton &st) {
+	return ranges::any_of(BarStyles(), [&](const BarStyle &entry) {
+		return (entry.compact.get() == &st);
+	});
+}
+
+[[nodiscard]] QImage ScaledIcon(const style::icon &icon, float64 scale) {
+	const auto ratio = style::DevicePixelRatio();
+	auto full = QImage(
+		icon.size() * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	full.setDevicePixelRatio(ratio);
+	full.fill(Qt::transparent);
+	{
+		auto p = QPainter(&full);
+		icon.paint(p, 0, 0, icon.width());
+	}
+	auto result = full.scaled(
+		Scaled(icon.size(), scale) * ratio,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+	result.setDevicePixelRatio(ratio);
+	return result;
+}
+
+[[nodiscard]] const style::icon &ComputeIcon(
+		const BarButton &state,
+		bool active) {
+	const auto &st = *state.st;
+	return active
+		? (state.iconActive
+			? *state.iconActive
+			: !st.iconActive.empty()
+			? st.iconActive
+			: state.icon
+			? *state.icon
+			: st.icon)
+		: (state.icon ? *state.icon : st.icon);
+}
+
+[[nodiscard]] int LockShift() {
+	return Scaled(st::sideBarButtonLockCornerShift, kBarIconScale);
+}
+
+[[nodiscard]] int BadgeLeft(const BarButton &state, int width) {
+	const auto desired = (width / 2) + state.st->badgePosition.x();
+	return std::clamp(desired, 0, std::max(width - state.badgeWidth, 0));
+}
+
+void ValidateBarCache(
+		not_null<Ui::SideBarButton*> button,
+		BarButton &state,
+		const style::icon &icon,
+		bool active,
+		bool locked) {
+	auto &cache = state.cache[active ? 1 : 0];
+	const auto size = button->size();
+	if (!cache.image.isNull()
+		&& cache.icon == &icon
+		&& cache.size == size
+		&& cache.badgeWidth == state.badgeWidth
+		&& cache.locked == locked) {
+		return;
+	}
+	cache.icon = &icon;
+	cache.size = size;
+	cache.badgeWidth = state.badgeWidth;
+	cache.locked = locked;
+	cache.image = ScaledIcon(icon, kBarIconScale);
+	if (!state.badgeWidth && !locked) {
+		return;
+	}
+	const auto &st = *state.st;
+	const auto ratio = cache.image.devicePixelRatio();
+	const auto iconSize = cache.image.size() / ratio;
+	const auto iconLeft = (size.width() - iconSize.width()) / 2;
+	const auto iconTop = (size.height() - iconSize.height()) / 2;
+	auto p = QPainter(&cache.image);
+	p.setCompositionMode(QPainter::CompositionMode_Source);
+	auto hq = PainterHighQualityEnabler(p);
+	if (state.badgeWidth) {
+		p.setBrush(Qt::transparent);
+		auto pen = QPen(Qt::transparent);
+		pen.setWidth(2 * st.badgeStroke);
+		p.setPen(pen);
+		const auto radius = st.badgeHeight / 2.;
+		p.drawRoundedRect(
+			BadgeLeft(state, size.width()) - iconLeft,
+			st.badgePosition.y() - iconTop,
+			state.badgeWidth,
+			st.badgeHeight,
+			radius,
+			radius);
+	}
+	if (locked) {
+		p.setPen(Qt::NoPen);
+		p.setBrush(Qt::transparent);
+		const auto shift = LockShift();
+		const auto radius = (st::sideBarButtonLockSize.height() / 2)
+			+ st.badgeStroke;
+		p.drawEllipse(
+			QPoint(iconSize.width() - shift, iconSize.height() - shift),
+			radius,
+			radius);
+	}
+}
+
+void PaintBarButton(
+		not_null<Ui::SideBarButton*> button,
+		BarButton &state,
+		QRect clip) {
+	auto p = Painter(button.get());
+	const auto &st = *state.st;
+	const auto active = state.active && state.active();
+	const auto &bg = active ? st.textBgActive : st.textBg;
+	p.fillRect(clip, bg);
+
+	button->paintRipple(p, 0, 0);
+
+	const auto locked = button->locked();
+	if (locked) {
+		p.setOpacity(kLockedOpacity);
+	}
+	const auto width = button->width();
+	const auto height = button->height();
+	const auto &icon = ComputeIcon(state, active);
+	auto iconRect = QRect();
+	if (!icon.empty()) {
+		ValidateBarCache(button, state, icon, active, locked);
+		const auto &image = state.cache[active ? 1 : 0].image;
+		const auto size = image.size() / image.devicePixelRatio();
+		iconRect = QRect(
+			QPoint((width - size.width()) / 2, (height - size.height()) / 2),
+			size);
+		p.drawImage(iconRect.topLeft(), image);
+	}
+	if (state.badgeWidth) {
+		const auto x = BadgeLeft(state, width);
+		const auto y = st.badgePosition.y();
+		{
+			auto hq = PainterHighQualityEnabler(p);
+			p.setPen(Qt::NoPen);
+			p.setBrush(active
+				? (state.badgeMuted
+					? st.badgeBgMutedActive
+					: st.badgeBgActive)
+				: (state.badgeMuted ? st.badgeBgMuted : st.badgeBg));
+			const auto radius = st.badgeHeight / 2;
+			p.drawRoundedRect(
+				x,
+				y,
+				state.badgeWidth,
+				st.badgeHeight,
+				radius,
+				radius);
+		}
+		p.setPen(st.badgeFg);
+		state.badge.draw(
+			p,
+			x + (state.badgeWidth - state.badge.maxWidth()) / 2,
+			y + (st.badgeHeight - st.badgeStyle.font->height) / 2,
+			width);
+	}
+	if (locked && !iconRect.isEmpty()) {
+		auto &lock = state.lock[active ? 1 : 0];
+		if (lock.isNull()) {
+			lock = Ui::SideBarLockIcon(st.textFg);
+		}
+		const auto size = lock.size() / style::DevicePixelRatio();
+		const auto shift = LockShift();
+		p.drawImage(
+			iconRect.x() + iconRect.width() - shift - size.width() / 2,
+			iconRect.y() + iconRect.height() - shift - size.height() / 2,
+			lock);
+	}
+}
+
+void ApplyTabs(const TabsStyle &entry, bool compact) {
+	const auto &st = *entry.original;
+	entry.copy->padding = compact ? Scaled(st.padding, 0.5) : st.padding;
+	entry.copy->strictSkip = compact
+		? std::max(Scaled(st.strictSkip, kTabSkipScale), 2)
+		: st.strictSkip;
+}
+
+[[nodiscard]] const QImage &TabIcon(const style::icon &icon, QColor color) {
+	auto &cache = TabIcons();
+	const auto key = std::make_pair(&icon, color.rgba());
+	const auto i = cache.find(key);
+	if (i != end(cache)) {
+		return i->second;
+	}
+	if (int(cache.size()) >= kMaxTabIcons) {
+		cache.clear();
+	}
+	auto image = icon.instance(
+		color,
+		Scaled(style::Scale(), kTabIconScale));
+	TabIconSizes()[&icon] = image.size() / image.devicePixelRatio();
+	return cache.emplace(key, std::move(image)).first->second;
+}
+
+} // namespace
+
+bool CompactFolderBar() {
+	return CompactFolders()
+		&& IconsOnly(Ui::VerticalChatsFiltersTabsMode(
+			Core::App().settings().chatFiltersTabsMode()));
+}
+
+rpl::producer<bool> CompactFolderBarValue() {
+	return rpl::combine(
+		CompactFoldersValue(),
+		Core::App().settings().chatFiltersTabsModeValue()
+	) | rpl::map([](bool compact, Ui::ChatsFiltersTabsMode mode) {
+		return compact && IconsOnly(Ui::VerticalChatsFiltersTabsMode(mode));
+	}) | rpl::distinct_until_changed();
+}
+
+bool CompactFolderTabs() {
+	return CompactFolders()
+		&& IconsOnly(Ui::HorizontalChatsFiltersTabsMode(
+			Core::App().settings().chatFiltersTabsMode()));
+}
+
+rpl::producer<bool> CompactFolderTabsValue() {
+	return rpl::combine(
+		CompactFoldersValue(),
+		Core::App().settings().chatFiltersTabsModeValue()
+	) | rpl::map([](bool compact, Ui::ChatsFiltersTabsMode mode) {
+		return compact
+			&& IconsOnly(Ui::HorizontalChatsFiltersTabsMode(mode));
+	}) | rpl::distinct_until_changed();
+}
+
+int FiltersWidth() {
+	return CompactFolderBar()
+		? (st::windowFiltersWidth / 2)
+		: st::windowFiltersWidth;
+}
+
+const style::SideBarButton &FolderBarStyle(const style::SideBarButton &st) {
+	if (!CompactFolderBar()) {
+		return st;
+	}
+	auto &list = BarStyles();
+	const auto i = ranges::find(list, &st, [](const BarStyle &entry) {
+		return entry.original.get();
+	});
+	if (i != end(list)) {
+		return *i->compact;
+	}
+	list.push_back({ &st, MakeCompact(st) });
+	return *list.back().compact;
+}
+
+int FolderBarIconSize(int size) {
+	return CompactFolderBar() ? Scaled(size, kBarIconScale) : size;
+}
+
+void SetupFolderBarButton(
+		not_null<Ui::SideBarButton*> button,
+		const style::SideBarButton &st,
+		Fn<bool()> active) {
+	if (!IsCompactStyle(st)) {
+		return;
+	}
+	const auto state = std::make_shared<BarButton>(BarButton{
+		.st = &st,
+		.active = std::move(active),
+	});
+	BarButtons()[button] = state;
+	button->lifetime().add([=] {
+		BarButtons().remove(button);
+	});
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		for (auto &cache : state->cache) {
+			cache.image = QImage();
+		}
+		for (auto &lock : state->lock) {
+			lock = QImage();
+		}
+	}, button->lifetime());
+	base::install_event_filter(button, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::Paint) {
+			return base::EventFilterResult::Continue;
+		}
+		PaintBarButton(
+			button,
+			*state,
+			static_cast<QPaintEvent*>(e.get())->rect());
+		return base::EventFilterResult::Cancel;
+	});
+}
+
+void SetFolderBarIcon(
+		not_null<Ui::SideBarButton*> button,
+		const style::icon *icon,
+		const style::icon *iconActive) {
+	button->setIconOverride(icon, iconActive);
+	const auto i = BarButtons().find(button);
+	if (i == end(BarButtons())) {
+		return;
+	}
+	i->second->icon = icon;
+	i->second->iconActive = iconActive;
+	button->update();
+}
+
+void SetFolderBarBadge(
+		not_null<Ui::SideBarButton*> button,
+		const QString &badge,
+		bool muted) {
+	button->setBadge(badge, muted);
+	const auto i = BarButtons().find(button);
+	if (i == end(BarButtons())) {
+		return;
+	}
+	const auto state = i->second.get();
+	const auto &st = *state->st;
+	if (state->badge.toString() != badge) {
+		state->badge.setText(st.badgeStyle, badge);
+	}
+	state->badgeMuted = muted;
+	state->badgeWidth = badge.isEmpty()
+		? 0
+		: std::max(st.badgeHeight, state->badge.maxWidth() + 2 * st.badgeSkip);
+	button->update();
+}
+
+const style::SettingsSlider &FolderTabsStyle(
+		const style::SettingsSlider &st) {
+	auto &list = TabsStyles();
+	auto i = ranges::find(list, &st, [](const TabsStyle &entry) {
+		return entry.original.get();
+	});
+	if (i == end(list)) {
+		list.push_back({
+			&st,
+			std::make_unique<style::SettingsSlider>(st),
+		});
+		i = end(list) - 1;
+	}
+	ApplyTabs(*i, CompactFolderTabs());
+	return *i->copy;
+}
+
+void SyncFolderTabsStyles() {
+	const auto compact = CompactFolderTabs();
+	for (const auto &entry : TabsStyles()) {
+		ApplyTabs(entry, compact);
+	}
+}
+
+int FolderTabIconWidth(const style::icon &icon) {
+	if (!CompactFolderTabs()) {
+		return icon.width();
+	}
+	const auto i = TabIconSizes().find(&icon);
+	if (i != end(TabIconSizes())) {
+		return i->second.width();
+	}
+	return TabIcon(icon, QColor(255, 255, 255)).width()
+		/ style::DevicePixelRatio();
+}
+
+bool PaintFolderTabIcon(
+		QPainter &p,
+		const style::icon &icon,
+		QPoint position,
+		int lineHeight,
+		int outerWidth,
+		QColor color) {
+	if (!CompactFolderTabs()) {
+		return false;
+	}
+	const auto &image = TabIcon(icon, color);
+	const auto size = image.size() / image.devicePixelRatio();
+	p.drawImage(
+		(style::RightToLeft()
+			? (outerWidth - position.x() - size.width())
+			: position.x()),
+		position.y() + (lineHeight - size.height()) / 2,
+		image);
+	return true;
+}
+
+} // namespace Tele
