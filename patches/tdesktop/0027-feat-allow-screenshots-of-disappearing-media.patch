diff --git a/Telegram/SourceFiles/tele/tele_secret_media.cpp b/Telegram/SourceFiles/tele/tele_secret_media.cpp
index 3e7969dbb0202f8d065bbf065067b39b03d65227..5f22f21a24b75fbe54a17d5bf4a0d72206418d60 100644
--- a/Telegram/SourceFiles/tele/tele_secret_media.cpp
+++ b/Telegram/SourceFiles/tele/tele_secret_media.cpp
@@ -26,6 +26,16 @@ bool KeepsSecretMedia(not_null<const HistoryItem*> item) {
 	return media && media->ttlSeconds();
 }
 
+bool ForbidsCapture(not_null<const HistoryItem*> item) {
+	if (ScreenshotSecretMedia() && !item->forbidsForward()) {
+		const auto media = item->media();
+		if (media && media->ttlSeconds()) {
+			return false;
+		}
+	}
+	return item->forbidsSaving();
+}
+
 void AddMarkViewedAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
 	if (!item
 		|| !item->isRegular()
diff --git a/Telegram/SourceFiles/tele/tele_secret_media.h b/Telegram/SourceFiles/tele/tele_secret_media.h
