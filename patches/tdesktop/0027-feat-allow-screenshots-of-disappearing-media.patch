 	AddOptionToggle(content, controller(), ::Tele::kOptionDeletedIcon);
 	AddOptionToggle(content, controller(), ::Tele::kOptionKeepSecretMedia);
+	AddOptionToggle(content, controller(), ::Tele::kOptionScreenshotSecretMedia);
 	Ui::AddSkip(content);
