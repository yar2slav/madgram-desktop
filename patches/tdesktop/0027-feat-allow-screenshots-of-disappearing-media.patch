+	.name = "Allow screenshots of disappearing media",
+	.description = "The media viewer and the voice and video message "
+		"player no longer hide view-once and timed media from screen "
+		"capture. Chats that forbid saving stay protected.",
+});
+
 base::options::option<QString> ServerUrlOption({
