 	.name = "tele server",
@@ -376,6 +385,10 @@ bool KeepSecretMedia() {
 	return KeepSecretMediaOption.value();
 }
 
+bool ScreenshotSecretMedia() {
+	return ScreenshotSecretMediaOption.value();
+}
+
 QString ServerUrl() {
 	return ServerUrlOption.value();
 }
