 		return story->forbidsForward();
 	}
 	return (_history && !_history->peer->allowsForwarding())
-		|| (_message && _message->forbidsSaving());
+		|| (_message && Tele::ForbidsCapture(_message));
 }
 
 void OverlayWidget::refreshScreenshotProtection() {
