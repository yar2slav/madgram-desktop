index 0000000000000000000000000000000000000000..cdbad6fbaae89167530052abeda42fa4965acdc5
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_live_markdown.cpp
@@ -0,0 +1,672 @@
+#include "tele/tele_live_markdown.h"
+
+#include "base/event_filter.h"
+#include "base/qt_signal_producer.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/chat/chat_style.h"
+#include "ui/text/text.h"
+#include "ui/text/text_entity.h"
+#include "ui/widgets/fields/input_field.h"
+#include "styles/style_basic.h"
+#include "styles/style_widgets.h"
+
+#include <QtCore/QRegularExpression>
+#include <QtGui/QAbstractTextDocumentLayout>
+#include <QtGui/QPainter>
+#include <QtGui/QTextBlock>
+#include <QtGui/QTextDocument>
+#include <QtGui/QTextLayout>
+#include <QtWidgets/QScrollBar>
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMarkerProperty = QTextFormat::UserProperty + 0x7e1e;
+constexpr auto kSoftLine = QChar(QChar::LineSeparator);
+constexpr auto kHardLine = QChar(QChar::ParagraphSeparator);
+
+using Field = Ui::InputField;
+
+enum class Kind {
+	Dim,
+	Bold,
+	Italic,
+	Strike,
+	Spoiler,
+	Code,
+	Count,
+};
+
+struct Span {
+	int from = 0;
+	int till = 0;
+	Kind kind = Kind::Dim;
+};
+
+struct Area {
+	int from = 0;
+	int till = 0;
+	bool pre = false;
+	bool collapsed = false;
+
+	friend inline bool operator==(const Area &, const Area &) = default;
+};
+
+struct Applied {
+	int from = 0;
+	int till = 0;
+	int open = 0;
+	int close = 0;
+	QString tag;
+};
+
+[[nodiscard]] int QuotePrefix(QStringView line) {
+	const auto size = line.startsWith(u">! "_q)
+		? 3
+		: line.startsWith(u"> "_q)
+		? 2
+		: 0;
+	return (line.size() > size) ? size : 0;
+}
+
+[[nodiscard]] bool IsLineBreak(QChar ch) {
+	return (ch == kSoftLine) || (ch == kHardLine) || (ch == QChar('\n'));
+}
+
+[[nodiscard]] style::QuoteStyle PreStyle(not_null<const Ui::InputField*> field) {
+	auto result = field->st().style.pre;
+	result.header = 0;
+	return result;
+}
+
+[[nodiscard]] int PreLanguageLength(const QString &text, int from, int length) {
+	static const auto expression = QRegularExpression(
+		"^([a-zA-Z0-9\\+\\-]+)[\\r\\n]");
+	const auto match = expression.match(QStringView(text).mid(from, length));
+	return match.hasMatch() ? int(match.capturedLength(1)) : 0;
+}
+
+[[nodiscard]] std::optional<Kind> InnerKind(const QString &tag) {
+	if (tag == Field::kTagBold) {
+		return Kind::Bold;
+	} else if (tag == Field::kTagItalic) {
+		return Kind::Italic;
+	} else if (tag == Field::kTagStrikeOut) {
+		return Kind::Strike;
+	} else if (tag == Field::kTagSpoiler) {
+		return Kind::Spoiler;
+	} else if (tag == Field::kTagCode || tag == Field::kTagPre) {
+		return Kind::Code;
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] bool IsBlockTag(QStringView id) {
+	for (const auto &tag : TextUtilities::SplitTags(id)) {
+		if (tag == Field::kTagBlockquote
+			|| tag == Field::kTagBlockquoteCollapsed
+			|| tag.startsWith(Field::kTagPre)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] bool Covered(
+		const TextWithTags::Tags &tags,
+		int from,
+		int till) {
+	return ranges::any_of(tags, [&](const TextWithTags::Tag &tag) {
+		return (tag.offset < till) && (tag.offset + tag.length > from);
+	});
+}
+
+[[nodiscard]] std::vector<Applied> AppliedTags(
+		not_null<const Field*> field) {
+	auto result = std::vector<Applied>();
+	const auto &markdown = field->getMarkdownTags();
+	if (!field->markdownEnabledState().typedTagsEnabled()
+		|| markdown.empty()) {
+		return result;
+	}
+	const auto &text = field->getTextWithTags();
+	const auto links = TextUtilities::ParseEntities(text.text, 0).entities;
+	auto original = text.tags.begin();
+	const auto originalEnd = text.tags.end();
+	auto link = links.begin();
+	const auto linksEnd = links.end();
+	auto from = 0;
+	for (const auto &tag : markdown) {
+		const auto edge = int(tag.tag.size());
+		if (!tag.closed
+			|| tag.adjustedStart < from
+			|| tag.adjustedLength <= 2 * edge) {
+			continue;
+		}
+		const auto end = tag.adjustedStart + tag.adjustedLength;
+		while (original != originalEnd
+			&& original->offset + original->length <= tag.adjustedStart) {
+			++original;
+		}
+		if (original != originalEnd && original->offset < end) {
+			continue;
+		}
+		while (link != linksEnd
+			&& link->offset() + link->length() <= tag.adjustedStart) {
+			++link;
+		}
+		if (link != linksEnd
+			&& link->offset() < end
+			&& (link->offset() + link->length() > end
+				|| link->offset() < tag.adjustedStart)) {
+			continue;
+		}
+		const auto language = (tag.tag == Field::kTagPre)
+			? PreLanguageLength(
+				text.text,
+				tag.adjustedStart + edge,
+				tag.adjustedLength - 2 * edge)
+			: 0;
+		result.push_back({
+			.from = tag.internalStart,
+			.till = tag.internalStart + tag.internalLength,
+			.open = edge + language,
+			.close = edge,
+			.tag = tag.tag,
+		});
+		from = end;
+	}
+	return result;
+}
+
+[[nodiscard]] TextWithTags::Tags WithTagAdded(
+		const TextWithTags::Tags &tags,
+		int from,
+		int till,
+		const QString &id) {
+	auto result = TextWithTags::Tags();
+	auto position = from;
+	const auto fill = [&](int upto) {
+		if (upto > position) {
+			result.push_back({ position, upto - position, id });
+			position = upto;
+		}
+	};
+	for (const auto &tag : tags) {
+		const auto start = tag.offset;
+		const auto end = tag.offset + tag.length;
+		if (end <= from || start >= till) {
+			if (start >= till) {
+				fill(till);
+			}
+			result.push_back(tag);
+			continue;
+		}
+		if (start < from) {
+			result.push_back({ start, from - start, tag.id });
+		}
+		const auto a = std::max(start, from);
+		const auto b = std::min(end, till);
+		fill(a);
+		result.push_back({
+			a,
+			b - a,
+			TextUtilities::TagWithAdded(tag.id, id),
+		});
+		position = b;
+		if (end > till) {
+			result.push_back({ till, end - till, tag.id });
+		}
+	}
+	fill(till);
+	return result;
+}
+
+[[nodiscard]] TextWithTags WithQuotes(TextWithTags text) {
+	struct Line {
+		int from = 0;
+		int till = 0;
+		int prefix = 0;
+	};
+	auto lines = std::vector<Line>();
+	const auto &original = text.text;
+	const auto size = int(original.size());
+	for (auto from = 0; from <= size;) {
+		auto till = int(original.indexOf(QChar('\n'), from));
+		if (till < 0) {
+			till = size;
+		}
+		const auto prefix = QuotePrefix(
+			QStringView(original).mid(from, till - from));
+		if (prefix && !Covered(text.tags, from, from + prefix)) {
+			lines.push_back({ from, till, prefix });
+		}
+		from = till + 1;
+	}
+	if (lines.empty()) {
+		return text;
+	}
+	const auto shifted = [&](int position) {
+		auto result = position;
+		for (const auto &line : lines) {
+			if (line.from >= position) {
+				break;
+			}
+			result -= line.prefix;
+		}
+		return result;
+	};
+	auto result = TextWithTags();
+	result.text.reserve(size);
+	auto copied = 0;
+	for (const auto &line : lines) {
+		result.text.append(QStringView(original).mid(copied, line.from - copied));
+		copied = line.from + line.prefix;
+	}
+	result.text.append(QStringView(original).mid(copied));
+	result.tags = std::move(text.tags);
+	for (auto &tag : result.tags) {
+		tag.offset = shifted(tag.offset);
+	}
+	for (auto i = begin(lines); i != end(lines);) {
+		const auto collapsed = (i->prefix == 3);
+		auto j = i + 1;
+		while (j != end(lines)
+			&& j->from == (j - 1)->till + 1
+			&& (j->prefix == 3) == collapsed) {
+			++j;
+		}
+		result.tags = WithTagAdded(
+			result.tags,
+			shifted(i->from + i->prefix),
+			shifted((j - 1)->till),
+			(collapsed
+				? Field::kTagBlockquoteCollapsed
+				: Field::kTagBlockquote));
+		i = j;
+	}
+	result.tags = TextUtilities::SimplifyTags(std::move(result.tags));
+	return result;
+}
+
+class LiveMarkdown final {
+public:
+	LiveMarkdown(
+		not_null<Field*> field,
+		std::shared_ptr<Ui::ChatStyle> style,
+		not_null<Main::Session*> session);
+	~LiveMarkdown();
+
+	void enableQuotes();
+	[[nodiscard]] bool quotes() const;
+
+private:
+	void setup();
+	void prepareFormats();
+	void refresh();
+	void applyFormats(const std::vector<Span> &spans);
+	void collectQuotes(
+		const std::vector<Applied> &applied,
+		std::vector<Span> &spans,
+		std::vector<Area> &areas) const;
+	void paint(not_null<QPaintEvent*> e);
+	[[nodiscard]] int lineTop(int position) const;
+	[[nodiscard]] int lineBottom(int position) const;
+
+	const not_null<Field*> _field;
+	const not_null<QTextDocument*> _document;
+	const std::shared_ptr<Ui::ChatStyle> _style;
+	const not_null<Main::Session*> _session;
+	std::array<QTextCharFormat, int(Kind::Count)> _formats;
+	const style::QuoteStyle _preSt;
+	Ui::Text::QuotePaintCache _preCache;
+	std::vector<Area> _areas;
+	bool _enabled = false;
+	bool _quotes = false;
+	rpl::lifetime _lifetime;
+
+};
+
+base::flat_map<not_null<const Field*>, not_null<LiveMarkdown*>> &Registry() {
+	static auto result = base::flat_map<
+		not_null<const Field*>,
+		not_null<LiveMarkdown*>>();
+	return result;
+}
+
+LiveMarkdown::LiveMarkdown(
+	not_null<Field*> field,
+	std::shared_ptr<Ui::ChatStyle> style,
+	not_null<Main::Session*> session)
+: _field(field)
+, _document(field->document())
+, _style(std::move(style))
+, _session(session)
+, _preSt(PreStyle(field)) {
+	Registry().emplace(_field, this);
+	prepareFormats();
+	setup();
+}
+
+LiveMarkdown::~LiveMarkdown() {
+	Registry().remove(_field);
+}
+
+void LiveMarkdown::enableQuotes() {
+	if (!_quotes) {
+		_quotes = true;
+		refresh();
+	}
+}
+
+bool LiveMarkdown::quotes() const {
+	return _enabled && _quotes;
+}
+
+void LiveMarkdown::setup() {
+	LiveMarkdownValue(
+	) | rpl::on_next([=](bool enabled) {
+		_enabled = enabled;
+		refresh();
+	}, _lifetime);
+
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		prepareFormats();
+		refresh();
+	}, _lifetime);
+
+	base::qt_signal_producer(
+		_document.get(),
+		&QTextDocument::contentsChanged
+	) | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+
+	const auto viewport = _field->rawTextEdit()->viewport();
+	base::install_event_filter(viewport, [=](not_null<QEvent*> e) {
+		if (e->type() == QEvent::Paint && !_areas.empty()) {
+			paint(static_cast<QPaintEvent*>(e.get()));
+		}
+		return base::EventFilterResult::Continue;
+	}, _lifetime);
+}
+
+void LiveMarkdown::prepareFormats() {
+	const auto &font = _field->st().style.font;
+	const auto make = [&](Kind kind) {
+		auto result = QTextCharFormat();
+		result.setProperty(kMarkerProperty, true);
+		switch (kind) {
+		case Kind::Dim:
+			result.setForeground(_field->st().placeholderFg->c);
+			break;
+		case Kind::Bold:
+			result.setFont(font->bold()->f);
+			break;
+		case Kind::Italic:
+			result.setFont(font->italic()->f);
+			break;
+		case Kind::Strike:
+			result.setFont(font->strikeout()->f);
+			break;
+		case Kind::Spoiler:
+			result.setBackground(st::windowBgOver->c);
+			break;
+		case Kind::Code:
+			result.setFont(font->monospace()->f);
+			result.setForeground(st::defaultTextPalette.monoFg->c);
+			break;
+		case Kind::Count:
+			break;
+		}
+		return result;
+	};
+	for (auto i = 0; i != int(Kind::Count); ++i) {
+		_formats[i] = make(Kind(i));
+	}
+}
+
+void LiveMarkdown::refresh() {
+	auto spans = std::vector<Span>();
+	auto areas = std::vector<Area>();
+	if (_enabled) {
+		const auto applied = AppliedTags(_field);
+		for (const auto &tag : applied) {
+			spans.push_back({ tag.from, tag.from + tag.open, Kind::Dim });
+			if (const auto kind = InnerKind(tag.tag)) {
+				spans.push_back({
+					tag.from + tag.open,
+					tag.till - tag.close,
+					*kind,
+				});
+			}
+			spans.push_back({ tag.till - tag.close, tag.till, Kind::Dim });
+			const auto inner = tag.from + tag.open;
+			const auto outer = tag.till - tag.close - 1;
+			if (tag.tag == Field::kTagPre
+				&& outer > inner + 1
+				&& IsLineBreak(_document->characterAt(inner))
+				&& IsLineBreak(_document->characterAt(outer))) {
+				areas.push_back({ inner + 1, outer, true });
+			}
+		}
+		if (_quotes) {
+			collectQuotes(applied, spans, areas);
+		}
+		ranges::sort(spans, ranges::less(), &Span::from);
+		ranges::sort(areas, ranges::less(), &Area::from);
+	}
+	applyFormats(spans);
+	if (_areas != areas) {
+		_areas = std::move(areas);
+		_field->rawTextEdit()->viewport()->update();
+	}
+}
+
+void LiveMarkdown::collectQuotes(
+		const std::vector<Applied> &applied,
+		std::vector<Span> &spans,
+		std::vector<Area> &areas) const {
+	auto last = -1;
+	for (auto block = _document->begin(); block.isValid(); block = block.next()) {
+		const auto position = block.position();
+		const auto text = block.text();
+		auto blockChecked = false;
+		auto realBlock = false;
+		for (auto from = 0; from <= text.size();) {
+			auto till = int(text.indexOf(kSoftLine, from));
+			if (till < 0) {
+				till = int(text.size());
+			}
+			const auto line = QStringView(text).mid(from, till - from);
+			const auto start = position + from;
+			const auto end = position + till;
+			from = till + 1;
+			const auto prefix = QuotePrefix(line);
+			if (!prefix) {
+				last = -1;
+				continue;
+			}
+			if (!blockChecked) {
+				blockChecked = true;
+				const auto tags = _field->getTextWithTagsPart(
+					position,
+					position + block.length() - 1).tags;
+				realBlock = ranges::any_of(tags, [](const auto &tag) {
+					return IsBlockTag(tag.id);
+				});
+			}
+			const auto inMarkdown = ranges::any_of(applied, [&](
+					const Applied &tag) {
+				return (tag.from < start + prefix) && (tag.till > start);
+			});
+			if (realBlock
+				|| inMarkdown
+				|| !_field->getTextWithTagsPart(
+					start,
+					start + prefix).tags.isEmpty()) {
+				last = -1;
+				continue;
+			}
+			const auto collapsed = (prefix == 3);
+			spans.push_back({ start, start + prefix, Kind::Dim });
+			if (last >= 0
+				&& areas[last].collapsed == collapsed
+				&& areas[last].till + 1 == start) {
+				areas[last].till = end;
+			} else {
+				last = int(areas.size());
+				areas.push_back({ start, end, false, collapsed });
+			}
+		}
+	}
+}
+
+void LiveMarkdown::applyFormats(const std::vector<Span> &spans) {
+	auto span = begin(spans);
+	const auto spansEnd = end(spans);
+	for (auto block = _document->begin(); block.isValid(); block = block.next()) {
+		const auto from = block.position();
+		const auto till = from + block.length() - 1;
+		const auto layout = block.layout();
+		if (!layout) {
+			continue;
+		}
+		const auto preeditStart = layout->preeditAreaPosition();
+		const auto preeditLength = int(layout->preeditAreaText().size());
+		auto existing = layout->formats();
+		auto mine = decltype(existing)();
+		auto others = decltype(existing)();
+		for (const auto &range : existing) {
+			(range.format.hasProperty(kMarkerProperty)
+				? mine
+				: others).push_back(range);
+		}
+		auto wanted = decltype(existing)();
+		while (span != spansEnd && span->till <= from) {
+			++span;
+		}
+		for (auto i = span; i != spansEnd && i->from < till; ++i) {
+			const auto a = std::max(i->from, from) - from;
+			const auto b = std::min(i->till, till) - from;
+			if (b <= a) {
+				continue;
+			}
+			auto range = QTextLayout::FormatRange();
+			range.start = a;
+			range.length = b - a;
+			range.format = _formats[int(i->kind)];
+			if (preeditLength > 0) {
+				if (range.start >= preeditStart) {
+					range.start += preeditLength;
+				} else if (range.start + range.length >= preeditStart) {
+					range.length += preeditLength;
+				}
+			}
+			wanted.push_back(range);
+		}
+		if (mine == wanted) {
+			continue;
+		}
+		others.append(wanted);
+		layout->setFormats(others);
+		_document->markContentsDirty(from, block.length());
+	}
+}
+
+int LiveMarkdown::lineTop(int position) const {
+	const auto block = _document->findBlock(position);
+	const auto rect = _document->documentLayout()->blockBoundingRect(block);
+	const auto layout = block.layout();
+	const auto line = layout
+		? layout->lineForTextPosition(position - block.position())
+		: QTextLine();
+	return int(std::floor(rect.top() + (line.isValid() ? line.y() : 0.)));
+}
+
+int LiveMarkdown::lineBottom(int position) const {
+	const auto block = _document->findBlock(position);
+	const auto rect = _document->documentLayout()->blockBoundingRect(block);
+	const auto layout = block.layout();
+	const auto line = layout
+		? layout->lineForTextPosition(position - block.position())
+		: QTextLine();
+	const auto next = line.lineNumber() + 1;
+	return (line.isValid() && next < layout->lineCount())
+		? int(std::ceil(rect.top() + layout->lineAt(next).y()))
+		: int(std::ceil(rect.bottom()));
+}
+
+void LiveMarkdown::paint(not_null<QPaintEvent*> e) {
+	const auto raw = _field->rawTextEdit();
+	const auto viewport = raw->viewport();
+	const auto shift = -raw->verticalScrollBar()->value();
+	const auto clip = e->rect();
+	auto p = std::optional<QPainter>();
+	for (const auto &area : _areas) {
+		const auto top = lineTop(area.from) + shift;
+		const auto bottom = lineBottom(std::max(area.till, area.from))
+			+ shift;
+		const auto rect = QRect(0, top, viewport->width(), bottom - top);
+		if (rect.isEmpty() || !rect.intersects(clip)) {
+			continue;
+		}
+		if (!p) {
+			p.emplace(viewport);
+		}
+		const auto &st = area.pre
+			? _preSt
+			: _field->st().style.blockquote;
+		if (area.pre) {
+			const auto shared = _style->messageStyle(
+				false,
+				false).preCache.get();
+			_preCache.bg = shared->bg;
+			_preCache.outlines = shared->outlines;
+			_preCache.header = shared->header;
+			_preCache.icon = shared->icon;
+		}
+		const auto cache = area.pre
+			? &_preCache
+			: _style->coloredQuoteCache(
+				false,
+				_session->user()->colorIndex()).get();
+		Ui::Text::ValidateQuotePaintCache(*cache, st);
+		Ui::Text::FillQuotePaint(*p, rect, *cache, st, {
+			.expandIcon = area.collapsed,
+		});
+	}
+}
+
+} // namespace
+
+void SetupLiveMarkdown(
+		not_null<Ui::InputField*> field,
+		std::shared_ptr<Ui::ChatStyle> style,
+		not_null<Main::Session*> session) {
+	field->lifetime().make_state<LiveMarkdown>(
+		field,
+		std::move(style),
+		session);
+}
+
+void SetupLiveQuotes(not_null<Ui::InputField*> field) {
+	const auto i = Registry().find(field);
+	if (i != end(Registry())) {
+		i->second->enableQuotes();
+	}
+}
+
+TextWithTags LiveMarkdownText(not_null<const Ui::InputField*> field) {
+	auto result = field->getTextWithAppliedMarkdown();
+	const auto i = Registry().find(field);
+	return (i != end(Registry()) && i->second->quotes())
+		? WithQuotes(std::move(result))
+		: result;
+}
+
+} // namespace Tele
