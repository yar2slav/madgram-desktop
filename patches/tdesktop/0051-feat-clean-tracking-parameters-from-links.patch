+[[nodiscard]] Filtered FilterParams(const QString &list, const Rules &rules) {
+	auto result = Filtered();
+	auto kept = QStringList();
+	for (const auto &part : list.split('&', Qt::SkipEmptyParts)) {
+		const auto name = QUrl::fromPercentEncoding(
+			part.section('=', 0, 0).toUtf8());
+		const auto tracking = ranges::any_of(rules, [&](
+				const QRegularExpression *rule) {
+			return rule->match(name).hasMatch();
+		});
+		if (tracking) {
+			result.removed = true;
+		} else {
+			kept.push_back(part);
+		}
+	}
+	result.value = kept.join('&');
+	return result;
+}
+
+struct UrlRange {
+	int offset = 0;
+	int length = 0;
+};
+
+[[nodiscard]] QString StripTrackingLoose(const QString &url) {
+	static const auto Scheme = QRegularExpression(
+		u"^[a-z][a-z0-9+.\\-]*:(?!\\d)"_q,
+		kCaseInsensitive);
+	if (Scheme.match(url).hasMatch()) {
+		return StripTracking(url);
+	}
+	const auto scheme = u"http://"_q;
+	const auto prefixed = scheme + url;
+	const auto result = StripTracking(prefixed);
+	return (result == prefixed) ? url : result.mid(scheme.size());
+}
+
+[[nodiscard]] std::vector<UrlRange> CollectUrls(
+		const TextWithEntities &text) {
+	auto result = std::vector<UrlRange>();
+	const auto collect = [&](const EntitiesInText &entities) {
+		for (const auto &entity : entities) {
+			if (entity.type() == EntityType::Url) {
+				result.push_back({ entity.offset(), entity.length() });
+			}
+		}
+	};
+	collect(text.entities);
+	if (result.empty()) {
+		auto parsed = text;
+		TextUtilities::ParseEntities(parsed, TextParseLinks);
+		collect(parsed.entities);
+	}
+	ranges::sort(result, ranges::greater(), &UrlRange::offset);
+	return result;
+}
+
+[[nodiscard]] bool CanReplace(
+		const EntitiesInText &entities,
+		UrlRange range) {
+	const auto end = range.offset + range.length;
+	for (const auto &entity : entities) {
+		const auto from = entity.offset();
+		const auto till = from + entity.length();
+		if (till <= range.offset || from >= end) {
+			continue;
+		} else if (from > range.offset || till < end) {
+			return false;
+		} else if (entity.type() == EntityType::Code
+			|| entity.type() == EntityType::Pre) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void ReplaceRange(
+		TextWithEntities &text,
+		UrlRange range,
+		const QString &value) {
+	const auto end = range.offset + range.length;
+	const auto delta = int(value.size()) - range.length;
+	text.text.replace(range.offset, range.length, value);
+	for (auto &entity : text.entities) {
+		const auto from = entity.offset();
+		const auto length = entity.length();
+		if (from >= end) {
+			entity = EntityInText(
+				entity.type(),
+				from + delta,
+				length,
+				entity.data());
+		} else if (from + length >= end) {
+			entity = EntityInText(
+				entity.type(),
+				from,
+				length + delta,
+				entity.data());
+		}
+	}
+}
+
+} // namespace
+
+QString StripTracking(const QString &url) {
+	static const auto Scheme = QRegularExpression(
+		u"^https?://"_q,
+		kCaseInsensitive);
+	const auto scheme = Scheme.match(url);
+	if (!scheme.hasMatch()) {
+		return url;
+	}
+	const auto start = scheme.capturedEnd();
+	auto end = int(url.size());
+	for (const auto ch : { '/', '?', '#' }) {
+		const auto index = url.indexOf(QChar(ch), start);
+		if (index >= 0) {
+			end = std::min(end, int(index));
+		}
+	}
+	auto host = url.mid(start, end - start);
+	host = host.mid(host.lastIndexOf('@') + 1);
+	if (host.startsWith('[')) {
+		return url;
+	}
+	host = host.section(':', 0, 0).toLower();
+	while (host.endsWith('.')) {
+		host.chop(1);
+	}
+	if (host.isEmpty() || IsTelegramHost(host)) {
+		return url;
+	}
+
+	auto rules = Rules{ &GlobalRule() };
+	auto paths = std::vector<const QRegularExpression*>();
+	for (const auto &provider : Providers()) {
+		if (provider.host.match(host).hasMatch()) {
+			rules.push_back(&provider.params);
+			for (const auto &path : provider.paths) {
+				paths.push_back(&path);
+			}
+		}
+	}
+
+	const auto hash = url.indexOf('#', end);
+	const auto beforeHash = (hash >= 0) ? int(hash) : int(url.size());
+	const auto question = url.indexOf('?', end);
+	const auto hasQuery = (question >= 0) && (question < beforeHash);
+	const auto pathEnd = hasQuery ? int(question) : beforeHash;
+	auto path = url.mid(end, pathEnd - end);
+	auto query = hasQuery
+		? url.mid(question + 1, beforeHash - question - 1)
+		: QString();
+	auto fragment = (hash >= 0) ? url.mid(hash + 1) : QString();
+	auto hasFragment = (hash >= 0);
+	auto changed = false;
+
+	for (const auto rule : paths) {
+		const auto was = path.size();
+		path.replace(*rule, QString());
+		changed = changed || (path.size() != was);
+	}
+	if (hasQuery) {
+		const auto filtered = FilterParams(query, rules);
+		if (filtered.removed) {
+			query = filtered.value;
+			changed = true;
+		}
+	}
+	if (hasFragment
+		&& fragment.contains('=')
+		&& !fragment.contains('/')) {
+		const auto filtered = FilterParams(fragment, rules);
+		if (filtered.removed) {
+			fragment = filtered.value;
+			hasFragment = !fragment.isEmpty();
+			changed = true;
+		}
+	}
+	if (!changed) {
+		return url;
+	}
+	auto result = url.left(end) + path;
+	if (!query.isEmpty()) {
+		result += '?' + query;
+	}
+	if (hasFragment) {
+		result += '#' + fragment;
+	}
+	return result;
+}
+
+QString PrepareOpenedLink(const QString &url) {
+	return (CleanOpenedLinks() && !SkipCleaning) ? StripTracking(url) : url;
+}
+
+void AddOpenUncleanedAction(
+		not_null<Ui::PopupMenu*> menu,
+		const std::shared_ptr<ClickHandler> &link) {
+	if (!link || !CleanOpenedLinks()) {
+		return;
+	}
+	const auto url = link->url();
+	if (url.isEmpty() || StripTracking(url) == url) {
+		return;
+	}
+	menu->addAction(Lower(u"Open without cleaning"_q), [=] {
+		SkipCleaning = true;
+		UrlClickHandler::Open(url);
+		SkipCleaning = false;
+	}, &st::menuIconLink);
+}
+
+void PrepareSentLinks(TextWithEntities &text) {
+	if (!CleanSentLinks()) {
+		return;
+	}
+	for (const auto &range : CollectUrls(text)) {
+		const auto url = text.text.mid(range.offset, range.length);
+		const auto cleaned = StripTrackingLoose(url);
+		if (cleaned != url && CanReplace(text.entities, range)) {
+			ReplaceRange(text, range, cleaned);
+		}
+	}
+	for (auto &entity : text.entities) {
+		if (entity.type() != EntityType::CustomUrl) {
+			continue;
+		}
+		const auto cleaned = StripTrackingLoose(entity.data());
+		if (cleaned != entity.data()) {
+			entity = EntityInText(
+				entity.type(),
+				entity.offset(),
+				entity.length(),
+				cleaned);
+		}
+	}
+}
+
+} // namespace Tele
