+namespace Tele {
+namespace {
+
+constexpr auto kLoadTimeout = 15 * crl::time(1000);
+constexpr auto kActionableProperty = "teleShortcutsActionable";
+
+enum class Kind {
+	Text,
+	Rich,
+	Media,
+	Poll,
+	TodoList,
+	Contact,
+	Location,
+	Dice,
+	Skip,
+};
+
+struct Unit {
+	Kind kind = Kind::Skip;
+	HistoryItemsList items;
+};
+
+struct MediaEntry {
+	PhotoData *photo = nullptr;
+	DocumentData *document = nullptr;
+	PhotoData *cover = nullptr;
+	TimeId timestamp = 0;
+	bool spoiler = false;
+	FullMsgId origin;
+	TextWithEntities caption;
+	FullMsgId localId;
+	uint64 randomId = 0;
+};
+
+struct Waiter {
+	rpl::lifetime lifetime;
+	bool finished = false;
+};
+
+struct Sending {
+	std::shared_ptr<ChatHelpers::Show> show;
+	Api::SendAction action;
+	FullReplyTo rest;
+	std::vector<Unit> units;
+	std::vector<QString> skipped;
+	size_t next = 0;
+};
+
+void AddSkipped(std::vector<QString> &skipped, const QString &label) {
+	if (!ranges::contains(skipped, label)) {
+		skipped.push_back(label);
+	}
+}
+
+[[nodiscard]] Kind Classify(not_null<HistoryItem*> item, QString &skipped) {
+	if (item->richPage()) {
+		return Kind::Rich;
+	}
+	const auto media = item->media();
+	if (!media || media->webpage()) {
+		return Kind::Text;
+	} else if (const auto invoice = media->invoice()) {
+		skipped = invoice->isPaidMedia ? u"paid media"_q : u"invoices"_q;
+	} else if (media->game()) {
+		skipped = u"games"_q;
+	} else if (media->storyId()) {
+		skipped = u"stories"_q;
+	} else if (media->giveawayStart() || media->giveawayResults()) {
+		skipped = u"giveaways"_q;
+	} else if (media->photo() || media->document()) {
+		return Kind::Media;
+	} else if (media->poll()) {
+		return Kind::Poll;
+	} else if (media->todolist()) {
+		return Kind::TodoList;
+	} else if (media->sharedContact()) {
+		return Kind::Contact;
+	} else if (media->location()) {
+		// venue titles and live periods aren't exposed by Data::MediaLocation
+		if (media->notificationText().text == tr::lng_maps_point(tr::now)) {
+			return Kind::Location;
+		}
+		skipped = u"venues"_q;
+	} else if (dynamic_cast<const Data::MediaDice*>(media)) {
+		return Kind::Dice;
+	} else {
+		skipped = u"unsupported messages"_q;
+	}
+	return Kind::Skip;
+}
+
+[[nodiscard]] std::vector<Unit> CollectUnits(
+		const HistoryItemsList &items,
+		std::vector<QString> &skipped) {
+	auto result = std::vector<Unit>();
+	for (const auto &item : items) {
+		auto label = QString();
+		const auto kind = Classify(item, label);
+		if (kind == Kind::Skip) {
+			AddSkipped(skipped, label);
+			continue;
+		}
+		const auto groupId = item->groupId();
+		if (kind == Kind::Media
+			&& groupId
+			&& !result.empty()
+			&& result.back().kind == Kind::Media
+			&& result.back().items.back()->groupId() == groupId) {
+			result.back().items.push_back(item);
+			continue;
+		}
+		result.push_back(Unit{ .kind = kind, .items = { item } });
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<HistoryItemsList> LoadedItems(
+		not_null<Main::Session*> session,
+		BusinessShortcutId id) {
+	const auto messages = &session->data().shortcutMessages();
+	if (!messages->shortcuts().list.contains(id)) {
+		return HistoryItemsList();
+	}
+	const auto slice = messages->list(id);
+	auto result = HistoryItemsList();
+	for (const auto &fullId : slice.ids) {
+		if (const auto item = session->data().message(fullId)) {
+			if (!item->isSending() && !item->hasFailed()) {
+				result.push_back(item);
+			}
+		}
+	}
+	const auto count = messages->lookupShortcut(id).count;
+	if (count < 1 || int(result.size()) < count) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] MTPInputMedia PrepareInputMedia(const MediaEntry &entry) {
+	if (const auto photo = entry.photo) {
+		using Flag = MTPDinputMediaPhoto::Flag;
+		return MTP_inputMediaPhoto(
+			MTP_flags(entry.spoiler ? Flag::f_spoiler : Flag(0)),
+			photo->mtpInput(),
+			MTPint(),
+			MTPInputDocument());
+	}
+	using Flag = MTPDinputMediaDocument::Flag;
+	return MTP_inputMediaDocument(
+		MTP_flags(Flag(0)
+			| (entry.spoiler ? Flag::f_spoiler : Flag(0))
+			| (entry.cover ? Flag::f_video_cover : Flag(0))
+			| (entry.timestamp ? Flag::f_video_timestamp : Flag(0))),
+		entry.document->mtpInput(),
+		(entry.cover ? entry.cover->mtpInput() : MTPInputPhoto()),
+		MTP_int(entry.timestamp),
+		MTPint(),
+		MTPstring());
+}
+
+[[nodiscard]] QByteArray FileReferences(
+		const std::vector<MediaEntry> &entries) {
+	auto result = QByteArray();
+	for (const auto &entry : entries) {
+		result += entry.photo
+			? entry.photo->fileReference()
+			: entry.document->fileReference();
+		if (entry.cover) {
+			result += entry.cover->fileReference();
+		}
+	}
+	return result;
+}
+
+void SendMedia(
+		Api::SendAction action,
+		const HistoryItemsList &items,
+		Fn<void()> finished) {
+	const auto history = action.history;
+	const auto peer = history->peer;
+	const auto session = &history->session();
+	const auto api = &session->api();
+	const auto multi = (items.size() > 1);
+	const auto groupId = multi ? base::RandomValue<uint64>() : uint64(0);
+	auto invert = false;
+	for (const auto &item : items) {
+		invert = invert || item->invertMedia();
+	}
+
+	api->sendAction(action);
+
+	auto flags = NewMessageFlags(peer);
+	if (action.replyTo) {
+		flags |= MessageFlag::HasReplyInfo;
+	}
+	Api::FillMessagePostFlags(action, peer, flags);
+	if (action.options.scheduled) {
+		flags |= MessageFlag::IsOrWasScheduled;
+	}
+	if (invert) {
+		flags |= MessageFlag::InvertMedia;
+	}
+
+	auto entries = std::vector<MediaEntry>();
+	entries.reserve(items.size());
+	for (const auto &item : items) {
+		const auto media = item->media();
+		auto entry = MediaEntry{
+			.photo = media->photo(),
+			.document = media->document(),
+			.cover = media->videoCover(),
+			.timestamp = media->videoTimestamp(),
+			.spoiler = media->hasSpoiler(),
+			.origin = item->fullId(),
+			.caption = item->originalText(),
+			.localId = FullMsgId(
+				peer->id,
+				session->data().nextLocalMessageId()),
+			.randomId = base::RandomValue<uint64>(),
+		};
+		session->data().registerMessageRandomId(
+			entry.randomId,
+			entry.localId);
+		auto fields = HistoryItemCommonFields{
+			.id = entry.localId.msg,
+			.flags = flags,
+			.from = NewMessageFromId(action),
+			.replyTo = action.replyTo,
+			.date = NewMessageDate(action.options),
+			.postAuthor = NewMessagePostAuthor(action),
+			.groupedId = groupId,
+			.mediaSpoiler = entry.spoiler,
+		};
+		if (const auto photo = entry.photo) {
+			history->addNewLocalMessage(
+				std::move(fields),
+				not_null<PhotoData*>(photo),
+				entry.caption);
+		} else {
+			history->addNewLocalMessage(
+				std::move(fields),
+				not_null<DocumentData*>(entry.document),
+				entry.caption);
+		}
+		entries.push_back(std::move(entry));
+	}
+
+	const auto state = std::make_shared<std::vector<MediaEntry>>(
+		std::move(entries));
+	const auto fail = [=](const MTP::Error &error) {
+		for (const auto &entry : *state) {
+			api->sendMessageFail(error, peer, entry.randomId, entry.localId);
+		}
+		finished();
+	};
+	const auto perform = [=](const auto &self, bool refreshed) -> void {
+		const auto used = FileReferences(*state);
+		const auto retry = [=](
+				const MTP::Error &error,
+				const MTP::Response &response) {
+			if (refreshed
+				|| (error.code() != 400)
+				|| !error.type().startsWith(u"FILE_REFERENCE_"_q)) {
+				fail(error);
+				return;
+			}
+			const auto left = std::make_shared<int>(int(state->size()));
+			for (const auto &entry : *state) {
+				api->refreshFileReference(
+					Data::FileOriginMessage(entry.origin),
+					[=](const auto &) {
+						if (--*left) {
+							return;
+						} else if (FileReferences(*state) != used) {
+							self(self, true);
+						} else {
+							fail(error);
+						}
+					});
+			}
+		};
+		const auto done = [=](
+				const MTPUpdates &result,
+				const MTP::Response &response) {
+			finished();
+		};
+		const auto sendAs = action.options.sendAs;
+		const auto silent = ShouldSendSilent(peer, action.options);
+		auto &histories = history->owner().histories();
+		if (!multi) {
+			const auto &entry = state->front();
+			const auto entities = Api::EntitiesToMTP(
+				session,
+				entry.caption.entities,
+				Api::ConvertOption::SkipLocal);
+			using Flag = MTPmessages_SendMedia::Flag;
+			const auto sendFlags = Flag(0)
+				| (action.replyTo ? Flag::f_reply_to : Flag(0))
+				| (silent ? Flag::f_silent : Flag(0))
+				| (entities.v.isEmpty() ? Flag(0) : Flag::f_entities)
+				| (action.options.scheduled
+					? Flag::f_schedule_date
+					: Flag(0))
+				| (sendAs ? Flag::f_send_as : Flag(0))
+				| (invert ? Flag::f_invert_media : Flag(0));
+			histories.sendPreparedMessage(
+				history,
+				action.replyTo,
+				entry.randomId,
+				Data::Histories::PrepareMessage<MTPmessages_SendMedia>(
+					MTP_flags(sendFlags),
+					peer->input(),
+					Data::Histories::ReplyToPlaceholder(),
+					PrepareInputMedia(entry),
+					MTP_string(entry.caption.text),
+					MTP_long(entry.randomId),
+					MTPReplyMarkup(),
+					entities,
+					MTP_int(action.options.scheduled),
+					MTPint(),
+					(sendAs ? sendAs->input() : MTP_inputPeerEmpty()),
+					MTPInputQuickReplyShortcut(),
+					MTP_long(0),
+					MTP_long(0),
+					MTPSuggestedPost()),
+				done,
+				retry);
+			return;
+		}
+		auto media = QVector<MTPInputSingleMedia>();
+		media.reserve(state->size());
+		for (const auto &entry : *state) {
+			const auto entities = Api::EntitiesToMTP(
+				session,
+				entry.caption.entities,
+				Api::ConvertOption::SkipLocal);
+			using Flag = MTPDinputSingleMedia::Flag;
+			media.push_back(MTP_inputSingleMedia(
+				MTP_flags(entities.v.isEmpty() ? Flag(0) : Flag::f_entities),
+				PrepareInputMedia(entry),
+				MTP_long(entry.randomId),
+				MTP_string(entry.caption.text),
+				entities));
+		}
+		using Flag = MTPmessages_SendMultiMedia::Flag;
+		const auto sendFlags = Flag(0)
+			| (action.replyTo ? Flag::f_reply_to : Flag(0))
+			| (silent ? Flag::f_silent : Flag(0))
+			| (action.options.scheduled ? Flag::f_schedule_date : Flag(0))
+			| (sendAs ? Flag::f_send_as : Flag(0))
+			| (invert ? Flag::f_invert_media : Flag(0));
+		histories.sendPreparedMessage(
+			history,
+			action.replyTo,
+			uint64(0),
+			Data::Histories::PrepareMessage<MTPmessages_SendMultiMedia>(
+				MTP_flags(sendFlags),
+				peer->input(),
+				Data::Histories::ReplyToPlaceholder(),
+				MTP_vector<MTPInputSingleMedia>(std::move(media)),
+				MTP_int(action.options.scheduled),
+				(sendAs ? sendAs->input() : MTP_inputPeerEmpty()),
+				MTPInputQuickReplyShortcut(),
+				MTP_long(0),
+				MTP_long(0)),
+			done,
+			retry);
+	};
+	perform(perform, false);
+}
+
+[[nodiscard]] bool SendUnit(
+		const Api::SendAction &action,
+		const Unit &unit,
+		std::vector<QString> &skipped) {
+	const auto session = &action.history->session();
+	const auto api = &session->api();
+	const auto item = unit.items.front();
+	const auto media = item->media();
+	switch (unit.kind) {
+	case Kind::Text: {
+		const auto &text = item->originalText();
+		if (text.text.isEmpty()) {
+			return false;
+		}
+		auto message = Api::MessageToSend(action);
+		message.textWithTags = TextWithTags{
+			text.text,
+			TextUtilities::ConvertEntitiesToTextTags(text.entities),
+		};
+		message.webPage = Data::WebPageDraft::FromItem(item);
+		api->sendMessage(std::move(message));
+		return true;
+	}
+	case Kind::Rich: {
+		const auto full = item->fullRichPage();
+		const auto page = full ? full : item->richPage();
+		const auto serialized = Iv::SerializeInputRichMessage(
+			session,
+			*page,
+			Iv::SerializeInputRichMessageMode::FinalSubmit);
+		if (serialized.status != Iv::SerializeInputRichMessageStatus::Success
+			|| !serialized.value) {
+			AddSkipped(skipped, u"rich messages"_q);
+			return false;
+		}
+		api->sendRichMessage(page, *serialized.value, action);
+		return true;
+	}
+	case Kind::Media:
+		return false;
+	case Kind::Poll:
+		api->polls().create(
+			*media->poll(),
+			item->originalText(),
+			action,
+			[] {},
+			[](bool) {});
+		return true;
+	case Kind::TodoList:
+		api->todoLists().create(
+			*media->todolist(),
+			action,
+			[] {},
+			[](QString) {});
+		return true;
+	case Kind::Contact: {
+		const auto contact = media->sharedContact();
+		api->shareContact(
+			contact->phoneNumber,
+			contact->firstName,
+			contact->lastName,
+			action);
+		return true;
+	}
+	case Kind::Location: {
+		const auto point = std::get_if<GeoPointLocation>(
+			&media->location()->location().file().data);
+		if (!point) {
+			AddSkipped(skipped, u"locations"_q);
+			return false;
+		}
+		Api::SendLocation(action, point->lat, point->lon);
+		return true;
+	}
+	case Kind::Dice: {
+		const auto dice = static_cast<const Data::MediaDice*>(media);
+		auto message = Api::MessageToSend(action);
+		message.textWithTags.text = dice->emoji();
+		if (!Api::SendDice(message)) {
+			AddSkipped(skipped, u"dice"_q);
+			return false;
+		}
+		return true;
+	}
+	case Kind::Skip:
+		return false;
+	}
+	Unexpected("Kind in Tele::SendUnit.");
+}
+
+void SendNext(std::shared_ptr<Sending> state) {
+	while (state->next != state->units.size()) {
+		const auto &unit = state->units[state->next++];
+		if (unit.kind == Kind::Media) {
+			SendMedia(state->action, unit.items, [=] { SendNext(state); });
+			state->action.replyTo = state->rest;
+			return;
+		} else if (SendUnit(state->action, unit, state->skipped)) {
+			state->action.replyTo = state->rest;
+		}
+	}
+	if (!state->skipped.empty()) {
+		state->show->showToast(u"not sent from this quick reply: "_q
+			+ QStringList(
+				begin(state->skipped),
+				end(state->skipped)).join(u", "_q));
+	}
+}
+
+void SendItems(
+		std::shared_ptr<ChatHelpers::Show> show,
+		Api::SendAction action,
+		const HistoryItemsList &items) {
+	const auto peer = action.history->peer;
+	auto skipped = std::vector<QString>();
+	auto units = CollectUnits(items, skipped);
+	auto sending = HistoryItemsList();
+	for (const auto &unit : units) {
+		sending.insert(end(sending), begin(unit.items), end(unit.items));
+	}
+	if (!sending.empty()) {
+		const auto error = GetErrorForSending(peer, {
+			.topicRootId = action.replyTo.topicRootId,
+			.forward = &sending,
+		});
+		if (error) {
+			Data::ShowSendErrorToast(show, peer, error);
+			return;
+		}
+	}
+	const auto topicRootId = action.replyTo.topicRootId;
+	auto rest = FullReplyTo{
+		.messageId = (topicRootId
+			? FullMsgId(peer->id, topicRootId)
+			: FullMsgId()),
+		.topicRootId = topicRootId,
+		.monoforumPeerId = action.replyTo.monoforumPeerId,
+	};
+	SendNext(std::make_shared<Sending>(Sending{
+		.show = std::move(show),
+		.action = std::move(action),
+		.rest = std::move(rest),
+		.units = std::move(units),
+		.skipped = std::move(skipped),
+	}));
+}
+
+[[nodiscard]] bool GroupShortcutsAllowed(
+		ChatData *chat,
+		ChannelData *channel) {
+	if (!GroupQuickReplies()) {
+		return false;
+	} else if (chat) {
+		return !chat->starsPerMessageChecked();
+	}
+	return channel
+		&& (channel->isMegagroup() || channel->isBroadcast())
+		&& !channel->starsPerMessageChecked();
+}
+
+} // namespace
+
+void MarkShortcutsActionable(not_null<QObject*> autocomplete) {
+	autocomplete->setProperty(kActionableProperty, true);
+}
+
+bool ShortcutsInChat(
+		not_null<const QObject*> autocomplete,
+		ChatData *chat,
+		ChannelData *channel) {
+	return autocomplete->property(kActionableProperty).toBool()
+		&& GroupShortcutsAllowed(chat, channel);
+}
+
+bool SendShortcut(
+		std::shared_ptr<ChatHelpers::Show> show,
+		Api::SendAction action,
+		BusinessShortcutId id) {
+	const auto peer = action.history->peer;
+	const auto session = &action.history->session();
+	if (!GroupShortcutsAllowed(peer->asChat(), peer->asChannel())) {
+		session->api().sendShortcutMessages(peer, id);
+		return false;
+	}
+	action.clearDraft = false;
+	action.options.effectId = 0;
+	if (const auto items = LoadedItems(session, id)) {
+		SendItems(show, action, *items);
+		return true;
+	}
+	const auto waiter = std::make_shared<Waiter>();
+	session->data().shortcutMessages().updates(
+		id
+	) | rpl::map([=] {
+		return LoadedItems(session, id);
+	}) | rpl::filter([](const std::optional<HistoryItemsList> &items) {
+		return items.has_value();
+	}) | rpl::take(
+		1
+	) | rpl::on_next([=, weak = std::weak_ptr<Waiter>(waiter)](
+			const std::optional<HistoryItemsList> &items) {
+		if (const auto strong = weak.lock()) {
+			strong->finished = true;
+		}
+		SendItems(show, action, *items);
+	}, waiter->lifetime);
+	base::call_delayed(kLoadTimeout, session, [=] {
+		if (!waiter->finished) {
+			waiter->finished = true;
+			waiter->lifetime.destroy();
+			show->showToast(u"couldn't load this quick reply"_q);
+		}
+	});
+	return true;
+}
+
