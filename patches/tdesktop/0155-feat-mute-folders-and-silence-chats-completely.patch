+++ b/Telegram/SourceFiles/tele/tele_mute.cpp
@@ -0,0 +1,400 @@
+#include "tele/tele_mute.h"
+
+#include "core/application.h"
+#include "data/data_channel.h"
+#include "data/data_chat_filters.h"
+#include "data/data_forum.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_thread.h"
+#include "data/data_user.h"
+#include "data/notify/data_notify_settings.h"
+#include "dialogs/dialogs_key.h"
+#include "history/history.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/tele_lowercase.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/menu/menu_toggle.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/notifications_manager.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E3C7E);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxFolders = 1024;
+constexpr auto kMaxPeers = 65536;
+
+class State final : public base::has_weak_ptr {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] bool folderMuted(FilterId id) const;
+	void toggleFolder(FilterId id);
+	[[nodiscard]] bool mutedByFolder(not_null<const PeerData*> peer) const;
+	[[nodiscard]] bool silenced(PeerId id) const;
+	void setSilenced(not_null<History*> history, bool silenced);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+	void rebuild();
+	void forgetRemoved();
+	void schedule(History *history);
+	void flush();
+	void refresh(not_null<History*> history);
+
+	const not_null<Main::Session*> _session;
+	base::flat_set<FilterId> _folders;
+	base::flat_set<PeerId> _silenced;
+	std::vector<Data::ChatFilter> _filters;
+	base::flat_set<not_null<History*>> _pending;
+	bool _refreshAll = false;
+	bool _scheduled = false;
+	bool _cleared = false;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+	rebuild();
+
+	const auto owner = &session->data();
+	owner->chatsFilters().changed(
+	) | rpl::on_next([=] {
+		forgetRemoved();
+		if (!_folders.empty() || !_filters.empty()) {
+			rebuild();
+			schedule(nullptr);
+		}
+	}, _lifetime);
+
+	owner->chatListEntryRefreshes(
+	) | rpl::on_next([=](const Data::Session::ChatListEntryRefresh &event) {
+		if (!_filters.empty() && event.existenceChanged) {
+			if (const auto history = event.key.history()) {
+				schedule(history);
+			}
+		}
+	}, _lifetime);
+
+	owner->sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		_cleared = true;
+		_filters.clear();
+		_pending.clear();
+	}, _lifetime);
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State *State::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+bool State::folderMuted(FilterId id) const {
+	return _folders.contains(id);
+}
+
+void State::toggleFolder(FilterId id) {
+	if (!_folders.remove(id)) {
+		_folders.emplace(id);
+	}
+	write();
+	rebuild();
+	schedule(nullptr);
+}
+
+bool State::mutedByFolder(not_null<const PeerData*> peer) const {
+	if (_filters.empty()) {
+		return false;
+	}
+	const auto history = _session->data().historyLoaded(peer->id);
+	if (!history) {
+		return false;
+	}
+	for (const auto &filter : _filters) {
+		if (filter.contains(history)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool State::silenced(PeerId id) const {
+	return _silenced.contains(id);
+}
+
+void State::setSilenced(not_null<History*> history, bool silenced) {
+	if (silenced) {
+		_silenced.emplace(history->peer->id);
+		Core::App().notifications().clearIncomingFromHistory(history);
+	} else {
+		_silenced.remove(history->peer->id);
+	}
+	write();
+}
+
+void State::rebuild() {
+	using Flag = Data::ChatFilter::Flag;
+	_filters.clear();
+	if (_cleared || _folders.empty()) {
+		return;
+	}
+	for (const auto &filter : _session->data().chatsFilters().list()) {
+		if (!filter.id() || !_folders.contains(filter.id())) {
+			continue;
+		}
+		_filters.push_back(Data::ChatFilter(
+			filter.id(),
+			filter.title(),
+			filter.iconEmoji(),
+			filter.colorIndex(),
+			filter.flags() & ~Flag::NoMuted,
+			filter.always(),
+			filter.pinned(),
+			filter.never()));
+	}
+}
+
+void State::forgetRemoved() {
+	const auto filters = &_session->data().chatsFilters();
+	if (_folders.empty() || !filters->loaded()) {
+		return;
+	}
+	const auto &list = filters->list();
+	auto removed = false;
+	for (auto i = begin(_folders); i != end(_folders);) {
+		if (ranges::contains(list, *i, &Data::ChatFilter::id)) {
+			++i;
+		} else {
+			i = _folders.erase(i);
+			removed = true;
+		}
+	}
+	if (removed) {
+		write();
+	}
+}
+
+void State::schedule(History *history) {
+	if (_cleared) {
+		return;
+	} else if (history) {
+		_pending.emplace(history);
+	} else {
+		_refreshAll = true;
+	}
+	if (_scheduled) {
+		return;
+	}
+	_scheduled = true;
+	crl::on_main(this, [=] {
+		flush();
+	});
+}
+
+void State::flush() {
+	_scheduled = false;
+	if (_cleared) {
+		return;
+	}
+	auto pending = base::take(_pending);
+	if (base::take(_refreshAll)) {
+		const auto owner = &_session->data();
+		const auto add = [&](auto peer) {
+			if (const auto history = owner->historyLoaded(peer->id)) {
+				pending.emplace(history);
+			}
+		};
+		owner->enumerateUsers(add);
+		owner->enumerateGroups(add);
+		owner->enumerateBroadcasts(add);
+	}
+	for (const auto &history : pending) {
+		refresh(history);
+	}
+}
+
+void State::refresh(not_null<History*> history) {
+	const auto settings = &_session->data().notifySettings();
+	const auto muted = settings->isMuted(history->peer);
+	const auto was = history->muted();
+	history->setMuted(muted);
+	if (was != muted) {
+		if (muted) {
+			Core::App().notifications().clearIncomingFromHistory(history);
+		}
+	} else if (const auto forum = history->peer->forum()) {
+		settings->forumParentMuteUpdated(forum);
+	}
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_mute"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto folders = quint32();
+	file.stream >> magic >> version >> owner >> folders;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| folders > kMaxFolders) {
+		return;
+	}
+	auto folderIds = base::flat_set<FilterId>();
+	for (auto i = quint32(); i != folders; ++i) {
+		auto id = qint32();
+		file.stream >> id;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (id) {
+			folderIds.emplace(FilterId(id));
+		}
+	}
+	auto peers = quint32();
+	file.stream >> peers;
+	if (file.stream.status() != QDataStream::Ok || peers > kMaxPeers) {
+		return;
+	}
+	auto peerIds = base::flat_set<PeerId>();
+	for (auto i = quint32(); i != peers; ++i) {
+		auto id = quint64();
+		file.stream >> id;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (id) {
+			peerIds.emplace(PeerId(id));
+		}
+	}
+	_folders = std::move(folderIds);
+	_silenced = std::move(peerIds);
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	const auto size = sizeof(quint32) * 4
+		+ sizeof(quint64)
+		+ _folders.size() * sizeof(qint32)
+		+ _silenced.size() * sizeof(quint64);
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_folders.size());
+	for (const auto id : _folders) {
+		data.stream << qint32(id);
+	}
+	data.stream << quint32(_silenced.size());
+	for (const auto id : _silenced) {
+		data.stream << quint64(id.value);
+	}
+	auto file = FileWriteDescriptor(u"tele_mute"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+} // namespace
+
+void SetupMute(not_null<Main::Session*> session) {
+	session->lifetime().make_state<State>(session);
+}
+
+bool MutedByFolder(not_null<const PeerData*> peer) {
+	const auto state = State::Find(&peer->session());
+	return state && state->mutedByFolder(peer);
+}
+
+bool SilencedCompletely(not_null<const Data::Thread*> thread) {
+	const auto state = State::Find(&thread->session());
+	return state && state->silenced(thread->peer()->id);
+}
+
+void AddMuteFolderAction(
+		not_null<Main::Session*> session,
+		FilterId id,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto state = State::Find(session);
+	if (!id || !state) {
+		return;
+	}
+	const auto muted = state->folderMuted(id);
+	addAction(
+		Lower(muted ? u"Unmute folder"_q : u"Mute folder"_q),
+		crl::guard(session, [=] {
+			if (const auto state = State::Find(session)) {
+				state->toggleFolder(id);
+			}
+		}),
+		muted ? &st::menuIconUnmute : &st::menuIconMute);
+}
+
+void AddSilenceAction(not_null<Ui::PopupMenu*> menu, Data::Thread *thread) {
+	const auto history = thread ? thread->asHistory() : nullptr;
+	const auto state = history ? State::Find(&history->session()) : nullptr;
+	if (!state) {
+		return;
+	}
+	const auto session = &history->session();
+	const auto silenced = state->silenced(history->peer->id);
+	auto item = base::make_unique_q<Ui::Menu::Toggle>(
+		menu->menu(),
+		menu->st().menu,
+		Lower(u"Silence completely"_q),
+		crl::guard(session, [=] {
+			if (const auto state = State::Find(session)) {
+				state->setSilenced(history, !silenced);
+			}
+		}),
+		&st::menuIconBlock,
+		&st::menuIconBlock);
+	item->action()->setCheckable(true);
+	item->action()->setChecked(silenced);
+	menu->addAction(std::move(item));
+}
+
+} // namespace Tele
