+constexpr auto kTestBit = BareId(1) << 63;
+constexpr auto kChannelShift = int64(1000000000000LL);
+constexpr auto kThemesInMemory = 4;
+constexpr auto kJpegQuality = 90;
+
+using Key = BareId;
+using Themes = std::deque<std::shared_ptr<Ui::ChatTheme>>;
+
+struct Custom {
+	Data::WallPaper paper;
+	QString file;
+};
+
+struct State {
+	State();
+
+	base::flat_map<Key, QString> specs;
+	rpl::event_stream<> changes;
+	int paletteGeneration = 0;
+	bool paletteScheduled = false;
+	rpl::event_stream<> paletteChanges;
+	base::flat_map<QString, std::weak_ptr<Ui::ChatTheme>> themes;
+	base::flat_set<QString> creating;
+	rpl::event_stream<std::shared_ptr<Ui::ChatTheme>> created;
+	base::flat_map<
+		not_null<Window::SessionController*>,
+		not_null<Themes*>> lastUsed;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] QString NoneSpec() {
+	return u"none"_q;
+}
+
+[[nodiscard]] QString Folder() {
+	return cWorkingDir() + u"tdata/tele_backgrounds/"_q;
+}
+
+[[nodiscard]] Key MakeKey(PeerId id, bool test) {
+	return id.value | (test ? kTestBit : Key());
+}
+
+[[nodiscard]] Key PeerKey(not_null<PeerData*> peer) {
+	return MakeKey(peer->id, peer->session().isTestMode());
+}
+
+[[nodiscard]] PeerId KeyPeer(Key key) {
+	return PeerId(key & ~kTestBit);
+}
+
+[[nodiscard]] PeerId ParseBotApiId(const QString &text) {
+	auto ok = false;
+	const auto id = text.toLongLong(&ok);
+	if (!ok || !id) {
+		return PeerId();
+	} else if (id > 0) {
+		return peerFromUser(UserId(uint64(id)));
+	} else if (id > -kChannelShift) {
+		return peerFromChat(ChatId(uint64(-id)));
+	}
+	return peerFromChannel(ChannelId(uint64(-id - kChannelShift)));
+}
+
+[[nodiscard]] QString BotApiId(PeerId id) {
+	const auto bare = int64(id.value & PeerId::kChatTypeMask);
+	return QString::number(peerIsChat(id)
+		? -bare
+		: peerIsChannel(id)
+		? -(kChannelShift + bare)
+		: bare);
+}
+
+[[nodiscard]] QString SpecFile(const QString &spec) {
+	const auto separator = spec.indexOf(QChar('@'));
+	return (separator < 0) ? QString() : spec.mid(separator + 1);
+}
+
+[[nodiscard]] QString MakeSpec(
+		const Data::WallPaper &paper,
+		const QString &file) {
+	const auto encoded = QString::fromLatin1(paper.serialize().toBase64(
+		QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals));
+	return file.isEmpty() ? encoded : (encoded + '@' + file);
+}
+
+[[nodiscard]] std::optional<Custom> ParseCustom(const QString &spec) {
+	if (spec.isEmpty() || spec == NoneSpec()) {
+		return std::nullopt;
+	}
+	const auto separator = spec.indexOf(QChar('@'));
+	const auto encoded = (separator < 0) ? spec : spec.mid(0, separator);
+	const auto paper = Data::WallPaper::FromSerialized(
+		QByteArray::fromBase64(
+			encoded.toLatin1(),
+			(QByteArray::Base64UrlEncoding
+				| QByteArray::OmitTrailingEquals)));
+	if (!paper) {
+		return std::nullopt;
+	}
+	const auto file = SpecFile(spec);
+	if (file.isEmpty()) {
+		if (paper->isPattern() || paper->backgroundColors().empty()) {
+			return std::nullopt;
+		}
+	} else if (!QFile::exists(Folder() + file)) {
+		return std::nullopt;
+	}
+	return Custom{ *paper, file };
+}
+
+[[nodiscard]] base::flat_map<Key, QString> Parse(const QString &value) {
+	auto result = base::flat_map<Key, QString>();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto entry = part.trimmed();
+		const auto test = entry.startsWith(u"test:"_q);
+		if (test) {
+			entry = entry.mid(5);
+		}
+		const auto separator = entry.indexOf(QChar('='));
+		if (separator <= 0) {
+			continue;
+		}
+		const auto id = ParseBotApiId(entry.mid(0, separator).trimmed());
+		const auto spec = entry.mid(separator + 1).trimmed();
+		if (id && !spec.isEmpty()) {
+			result[MakeKey(id, test)] = spec;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Serialize(const base::flat_map<Key, QString> &specs) {
+	auto list = QStringList();
+	list.reserve(int(specs.size()));
+	for (const auto &[key, spec] : specs) {
+		list.push_back(((key & kTestBit) ? u"test:"_q : QString())
+			+ BotApiId(KeyPeer(key))
+			+ '='
+			+ spec);
+	}
+	return list.join(QChar(','));
+}
+
+void RemoveUnusedFiles(const base::flat_map<Key, QString> &specs) {
+	auto used = base::flat_set<QString>();
+	for (const auto &[key, spec] : specs) {
+		if (const auto file = SpecFile(spec); !file.isEmpty()) {
+			used.emplace(file);
+		}
+	}
+	const auto folder = Folder();
+	for (const auto &file : QDir(folder).entryList(QDir::Files)) {
+		if (!used.contains(file)) {
+			QFile::remove(folder + file);
+		}
+	}
+}
+
+State &Get();
+
+State::State() {
+	ChatBackgroundsValue(
+	) | rpl::on_next([=](const QString &value) {
+		specs = Parse(value);
+		changes.fire({});
+	}, lifetime);
+	RemoveUnusedFiles(specs);
+
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		if (paletteScheduled) {
+			return;
+		}
+		paletteScheduled = true;
+		crl::on_main([] {
+			auto &state = Get();
+			state.paletteScheduled = false;
+			++state.paletteGeneration;
+			state.paletteChanges.fire({});
+		});
+	}, lifetime);
+}
+
+State &Get() {
+	static auto result = State();
+	return result;
+}
+
+[[nodiscard]] QString PeerSpec(not_null<PeerData*> peer) {
+	const auto &specs = Get().specs;
+	const auto i = specs.find(PeerKey(peer));
+	return (i != end(specs)) ? i->second : QString();
+}
+
+void SetPeerSpec(not_null<PeerData*> peer, const QString &spec) {
+	auto specs = Get().specs;
+	const auto key = PeerKey(peer);
+	if (spec.isEmpty()) {
+		if (!specs.remove(key)) {
+			return;
+		}
+	} else if (const auto i = specs.find(key); i != end(specs)) {
+		if (i->second == spec) {
+			return;
+		}
+		i->second = spec;
+	} else {
+		specs.emplace(key, spec);
+	}
+	SetChatBackgrounds(Serialize(specs));
+	RemoveUnusedFiles(specs);
+}
+
+[[nodiscard]] rpl::producer<QString> PeerSpecValue(
+		not_null<PeerData*> peer) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		Get().changes.events()
+	) | rpl::map([=] {
+		return PeerSpec(peer);
+	}) | rpl::distinct_until_changed();
+}
+
+[[nodiscard]] rpl::producer<int> PaletteGenerationValue() {
+	return rpl::single(
+		Get().paletteGeneration
+	) | rpl::then(Get().paletteChanges.events(
+	) | rpl::map([] {
+		return Get().paletteGeneration;
+	}));
+}
+
+void PushLastUsed(
+		not_null<Window::SessionController*> controller,
+		const std::shared_ptr<Ui::ChatTheme> &theme) {
+	auto &map = Get().lastUsed;
+	auto i = map.find(controller);
+	if (i == end(map)) {
+		const auto list = controller->lifetime().make_state<Themes>();
+		controller->lifetime().add([=] {
+			Get().lastUsed.remove(controller);
+		});
+		i = map.emplace(controller, list).first;
+	}
+	auto &list = *i->second;
+	const auto j = ranges::find(list, theme);
+	if (j != end(list)) {
+		list.erase(j);
+	}
+	list.push_front(theme);
+	if (int(list.size()) > kThemesInMemory) {
+		list.pop_back();
+	}
+}
+
+void CreateTheme(const QString &key, const Custom &custom, bool dark) {
+	const auto &paper = custom.paper;
+	auto descriptor = Ui::ChatThemeDescriptor{
+		.key = Ui::ChatThemeKey{ 0, dark },
+		.preparePalette = Window::Theme::PrepareCurrentPaletteCallback(),
+		.backgroundData = {
+			.key = key,
+			.path = (custom.file.isEmpty()
+				? QString()
+				: (Folder() + custom.file)),
+			.colors = paper.backgroundColors(),
+			.isPattern = paper.isPattern(),
+			.patternOpacity = paper.patternOpacity(),
+			.darkModeDimming = (paper.isPattern()
+				? 100
+				: std::clamp(paper.patternIntensity(), 0, 100)),
+			.isBlurred = paper.isBlurred(),
+			.forDarkMode = dark,
+			.generateGradient = true,
+			.gradientRotation = paper.gradientRotation(),
+		},
+		.basedOnDark = dark,
+	};
+	crl::async([descriptor = std::move(descriptor)]() mutable {
+		auto result = std::make_shared<Ui::ChatTheme>(std::move(descriptor));
+		crl::on_main([result = std::move(result)] {
+			result->finishCreateOnMain();
+			auto &state = Get();
+			const auto key = result->background().key;
+			state.creating.remove(key);
+			for (auto i = begin(state.themes); i != end(state.themes);) {
+				if (i->second.expired()) {
+					i = state.themes.erase(i);
+				} else {
+					++i;
+				}
+			}
+			state.themes[key] = result;
+			state.created.fire_copy(result);
+		});
+	});
+}
+
+[[nodiscard]] auto CachedThemeValue(
+	not_null<Window::SessionController*> controller,
+	const QString &spec,
+	const Custom &custom,
+	bool dark,
+	int generation)
+-> rpl::producer<std::shared_ptr<Ui::ChatTheme>> {
+	auto &state = Get();
+	const auto key = u"tele/"_q
+		+ spec
+		+ (dark ? u"/dark/"_q : u"/light/"_q)
+		+ QString::number(generation);
+	if (const auto i = state.themes.find(key); i != end(state.themes)) {
+		if (auto strong = i->second.lock()) {
+			PushLastUsed(controller, strong);
+			return rpl::single(std::move(strong));
+		}
+	}
+	if (!state.creating.contains(key)) {
+		state.creating.emplace(key);
+		CreateTheme(key, custom, dark);
+	}
+	return rpl::single(
+		controller->defaultChatTheme()
+	) | rpl::then(state.created.events(
+	) | rpl::filter([=](const std::shared_ptr<Ui::ChatTheme> &theme) {
+		return (theme->background().key == key);
+	}) | rpl::take(1) | rpl::map([=](std::shared_ptr<Ui::ChatTheme> theme) {
+		PushLastUsed(controller, theme);
+		return theme;
+	}));
+}
+
+[[nodiscard]] auto LocalThemeValue(
+	not_null<Window::SessionController*> controller,
+	const QString &spec)
+-> rpl::producer<std::shared_ptr<Ui::ChatTheme>> {
+	if (spec == NoneSpec()) {
+		return rpl::single(controller->defaultChatTheme());
+	}
+	const auto custom = ParseCustom(spec);
+	if (!custom) {
+		return rpl::single(std::shared_ptr<Ui::ChatTheme>());
+	}
+	return rpl::combine(
+		Window::Theme::IsThemeDarkValue() | rpl::distinct_until_changed(),
+		PaletteGenerationValue()
+	) | rpl::map([=](bool dark, int generation) {
+		return CachedThemeValue(controller, spec, *custom, dark, generation);
+	}) | rpl::flatten_latest();
+}
+
+bool SaveCustom(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer,
+		const Data::WallPaper &paper,
+		const QImage &full) {
+	auto file = QString();
+	if (paper.isPattern() || paper.backgroundColors().empty()) {
+		auto image = full;
+		if (image.isNull()) {
+			if (const auto thumbnail = paper.localThumbnail()) {
+				image = thumbnail->original();
+			}
+		}
+		if (image.isNull()) {
+			controller->showToast(
+				Lower(u"The background is still loading."_q));
+			return false;
+		}
+		const auto pattern = paper.isPattern();
+		file = BotApiId(peer->id)
+			+ (peer->session().isTestMode() ? u"_test_"_q : u"_"_q)
+			+ QString::number(QDateTime::currentMSecsSinceEpoch(), 16)
+			+ (pattern ? u".png"_q : u".jpg"_q);
+		const auto folder = Folder();
+		QDir().mkpath(folder);
+		image = Ui::PreprocessBackgroundImage(std::move(image));
+		if (!image.save(
+				folder + file,
+				pattern ? "PNG" : "JPG",
+				pattern ? -1 : kJpegQuality)) {
+			controller->showToast(
+				Lower(u"Couldn't save the background."_q));
+			return false;
+		}
+	}
+	SetPeerSpec(peer, MakeSpec(paper, file));
+	return true;
+}
+
+void ChooseBackground(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer) {
+	const auto box = std::make_shared<base::weak_qptr<Ui::BoxContent>>();
+	*box = controller->show(Box<BackgroundBox>(
+		controller,
+		nullptr,
+		[=](const Data::WallPaper &paper, const QImage &image) {
+			if (!SaveCustom(controller, peer, paper, image)) {
+				return false;
+			}
+			if (const auto strong = box->get()) {
+				strong->closeBox();
+			}
+			return true;
+		}));
+}
+
+} // namespace
+
+auto ChatBackgroundThemeValue(
+	not_null<Window::SessionController*> controller,
+	not_null<PeerData*> peer,
+	rpl::producer<std::shared_ptr<Ui::ChatTheme>> cloud)
+-> rpl::producer<std::shared_ptr<Ui::ChatTheme>> {
+	auto local = PeerSpecValue(
+		peer
+	) | rpl::map([=](const QString &spec) {
+		return LocalThemeValue(controller, spec);
+	}) | rpl::flatten_latest();
+	return rpl::combine(
+		std::move(cloud),
+		std::move(local)
+	) | rpl::map([](
+			std::shared_ptr<Ui::ChatTheme> &&cloud,
+			std::shared_ptr<Ui::ChatTheme> &&local) {
+		return local ? std::move(local) : std::move(cloud);
+	}) | rpl::distinct_until_changed();
+}
+
+void AddChatBackgroundAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer) {
+		return;
+	}
+	const auto now = PeerSpec(peer);
+	const auto weak = base::make_weak(controller);
+	addAction({
+		.text = Lower(u"Background for me"_q),
+		.handler = nullptr,
+		.icon = &st::menuIconPhoto,
+		.fillSubmenu = [=](not_null<Ui::PopupMenu*> menu) {
+			const auto check = [](bool checked) {
+				return checked ? &st::mediaPlayerMenuCheck : nullptr;
+			};
+			const auto add = [&](const QString &text, const QString &spec) {
+				menu->addAction(text, [=] {
+					SetPeerSpec(peer, spec);
+				}, check(now == spec));
+			};
+			add(Lower(u"Chat's own background"_q), QString());
+			add(Lower(u"My default background"_q), NoneSpec());
+			menu->addAction(
+				Lower(u"Choose a background"_q) + QChar(0x2026),
+				[=] {
+					if (const auto strong = weak.get()) {
+						ChooseBackground(strong, peer);
+					}
+				},
+				check(!now.isEmpty() && now != NoneSpec()));
+		},
+	});
+}
+
+std::vector<ChatBackground> ChatBackgrounds(
+		not_null<Main::Session*> session) {
+	const auto test = session->isTestMode();
+	auto result = std::vector<ChatBackground>();
+	for (const auto &[key, spec] : Get().specs) {
+		if (((key & kTestBit) != 0) == test) {
+			result.push_back({ KeyPeer(key), (spec == NoneSpec()) });
+		}
+	}
+	return result;
+}
+
+rpl::producer<> ChatBackgroundsChanges() {
+	return Get().changes.events();
+}
+
+rpl::producer<int> ChatBackgroundsCountValue(
+		not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		ChatBackgroundsChanges()
+	) | rpl::map([=] {
+		return int(ChatBackgrounds(session).size());
+	});
+}
+
+void ResetChatBackground(not_null<PeerData*> peer) {
+	SetPeerSpec(peer, QString());
+}
+
+} // namespace Tele
