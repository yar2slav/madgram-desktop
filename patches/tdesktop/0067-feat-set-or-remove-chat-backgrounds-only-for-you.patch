+class ChatBackgroundsController final : public PeerListController {
+public:
+	explicit ChatBackgroundsController(
+		not_null<Window::SessionController*> window);
+
+	Main::Session &session() const override;
+	void prepare() override;
+	void rowClicked(not_null<PeerListRow*> row) override;
+	void rowRightActionClicked(not_null<PeerListRow*> row) override;
+
+private:
+	void refreshRows();
+
+	const not_null<Window::SessionController*> _window;
+
+};
+
+ChatBackgroundsController::ChatBackgroundsController(
+	not_null<Window::SessionController*> window)
+: _window(window) {
+}
+
+Main::Session &ChatBackgroundsController::session() const {
+	return _window->session();
+}
+
+void ChatBackgroundsController::prepare() {
+	delegate()->peerListSetTitle(
+		rpl::single(::Tele::Lower(u"Chat backgrounds"_q)));
+	::Tele::ChatBackgroundsChanges(
+	) | rpl::on_next([=] {
+		refreshRows();
+	}, lifetime());
+	refreshRows();
+}
+
+void ChatBackgroundsController::refreshRows() {
+	const auto chats = ::Tele::ChatBackgrounds(&session());
+	auto keep = base::flat_set<PeerListRowId>();
+	for (const auto &chat : chats) {
+		keep.emplace(chat.id.value);
+	}
+	for (auto i = delegate()->peerListFullRowsCount(); i != 0;) {
+		const auto row = delegate()->peerListRowAt(--i);
+		if (!keep.contains(row->id())) {
+			delegate()->peerListRemoveRow(row);
+		}
+	}
+	for (const auto &chat : chats) {
+		auto row = delegate()->peerListFindRow(chat.id.value);
+		if (!row) {
+			auto created = std::make_unique<GhostChatRow>(
+				session().data().peer(chat.id));
+			created->setActionLink(::Tele::Lower(u"Reset"_q));
+			row = created.get();
+			delegate()->peerListAppendRow(std::move(created));
+		}
+		row->setCustomStatus(chat.none
+			? ::Tele::Lower(u"My default background"_q)
+			: ::Tele::Lower(u"Chosen background"_q));
+	}
+	setDescriptionText(chats.empty()
+		? ::Tele::Lower(u"No chats yet. Pick Background for me in a chat's "
+			"menu."_q)
+		: QString());
+	delegate()->peerListRefreshRows();
+}
+
+void ChatBackgroundsController::rowClicked(not_null<PeerListRow*> row) {
+	const auto peer = row->peer();
+	if (!peer->isMinimalLoaded()) {
+		return;
+	}
+	const auto window = _window;
+	crl::on_main(window, [=] {
+		window->showPeerHistory(peer);
+	});
+}
+
+void ChatBackgroundsController::rowRightActionClicked(
+		not_null<PeerListRow*> row) {
+	const auto peer = row->peer();
+	crl::on_main(_window, [=] {
+		::Tele::ResetChatBackground(peer);
+	});
+}
+
+void ShowChatBackgroundsBox(not_null<Window::SessionController*> window) {
+	auto initBox = [=](not_null<PeerListBox*> box) {
+		box->addButton(tr::lng_close(), [=] {
+			box->closeBox();
+		});
+	};
+	window->show(Box<PeerListBox>(
+		std::make_unique<ChatBackgroundsController>(window),
+		std::move(initBox)));
+}
+
+void AddChatBackgrounds(SectionBuilder &builder) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionChatBackgrounds);
+	const auto controller = builder.controller();
+	const auto description = ::Tele::Lower(option.description());
+	const auto button = builder.addButton({
+		.id = option.id(),
+		.title = rpl::single(::Tele::Lower(option.name())),
+		.st = &st::settingsButtonNoIcon,
+		.label = ::Tele::ChatBackgroundsCountValue(
+			builder.session()
+		) | rpl::map([](int count) {
+			return count ? QString::number(count) : u"none"_q;
+		}),
+		.onClick = [=] {
+			ShowChatBackgroundsBox(controller);
+		},
+		.keywords = { description },
+	});
+	if (button) {
+		SetupLink(button, option.id());
+	}
+	AddAbout(builder, description);
+}
