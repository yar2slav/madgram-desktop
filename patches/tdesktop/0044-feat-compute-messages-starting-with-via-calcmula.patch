index 0000000000000000000000000000000000000000..205d1f2734a702dc9c9bf7ebd949d34c7d794c90
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_calcmula.cpp
@@ -0,0 +1,295 @@
+#include "tele/tele_calcmula.h"
+
+#include "api/api_common.h"
+#include "apiwrap.h"
+#include "data/components/ephemeral_messages.h"
+#include "data/data_changes.h"
+#include "data/data_drafts.h"
+#include "data/data_thread.h"
+#include "history/history.h"
+#include "main/main_session.h"
+#include "storage/localimageloader.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/chat/attach/attach_prepare.h"
+#include "ui/text/text.h"
+#include "ui/text/text_entity.h"
+#include "window/window_session_controller.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele {
+namespace {
+
+constexpr auto kTransferTimeout = 10 * 1000;
+constexpr auto kMaxSize = qint64(64 * 1024);
+constexpr auto kUrl = "https://calcmula.app/api/calc?q=";
+
+struct Result {
+	QString value;
+	QString error;
+};
+
+bool Resending = false;
+
+[[nodiscard]] QString Query(const QString &text) {
+	return text.startsWith(u"= "_q) ? text.mid(2).trimmed() : QString();
+}
+
+[[nodiscard]] QNetworkAccessManager *Manager() {
+	static const auto result = new QNetworkAccessManager(
+		QCoreApplication::instance());
+	return result;
+}
+
+[[nodiscard]] Result Parse(const QByteArray &data) {
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(data, &error);
+	if (error.error != QJsonParseError::NoError || !document.isObject()) {
+		return {};
+	}
+	const auto object = document.object();
+	if (!object.value(u"ok"_q).toBool()) {
+		const auto text = object.value(u"error"_q).toString().trimmed();
+		return { .error = text.isEmpty() ? u"unknown error"_q : text };
+	}
+	const auto result = object.value(u"result"_q).toObject();
+	auto value = result.value(u"formatted"_q).toString().trimmed();
+	if (value.isEmpty()) {
+		value = result.value(
+			u"doc"_q
+		).toObject().value(u"summary"_q).toString().trimmed();
+	}
+	return value.isEmpty()
+		? Result{ .error = u"empty result"_q }
+		: Result{ .value = value };
+}
+
+void Compute(
+		not_null<Main::Session*> session,
+		const QString &query,
+		Fn<void(Result)> done) {
+	auto request = QNetworkRequest(QUrl::fromEncoded(
+		QByteArray(kUrl) + QUrl::toPercentEncoding(query)));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTransferTimeout));
+	const auto reply = Manager()->get(request);
+	const auto tooLarge = std::make_shared<bool>(false);
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 ready,
+			qint64 total) {
+		if (ready > kMaxSize || total > kMaxSize) {
+			*tooLarge = true;
+			reply->abort();
+		}
+	});
+	const auto guarded = crl::guard(session.get(), std::move(done));
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		auto result = *tooLarge
+			? Result{ .error = u"response is too large"_q }
+			: Parse(reply->readAll());
+		if (result.value.isEmpty() && result.error.isEmpty()) {
+			const auto error = reply->error();
+			result.error = (error == QNetworkReply::OperationCanceledError
+				|| error == QNetworkReply::TimeoutError)
+				? u"request timed out"_q
+				: (error != QNetworkReply::NoError)
+				? reply->errorString()
+				: u"malformed response"_q;
+		}
+		if (!result.error.isEmpty()) {
+			LOG(("Tele Calcmula Error: %1").arg(result.error));
+		}
+		guarded(std::move(result));
+	});
+}
+
+[[nodiscard]] TextWithTags Compose(
+		const QString &query,
+		const QString &value) {
+	return {
+		query + u"\n= "_q + value,
+		TextUtilities::ConvertEntitiesToTextTags({
+			EntityInText(EntityType::Blockquote, 0, int(query.size())),
+		}),
+	};
+}
+
+void ShowError(not_null<History*> history, const QString &error) {
+	const auto session = &history->session();
+	if (const auto window = session->tryResolveWindow(history->peer)) {
+		window->showToast(Lower(u"calcmula: "_q + error));
+	}
+}
+
+void RestoreDraft(const Api::MessageToSend &message) {
+	const auto history = message.action.history;
+	const auto topicRootId = message.action.replyTo.topicRootId;
+	const auto monoforumPeerId = message.action.replyTo.monoforumPeerId;
+	auto text = message.textWithTags;
+	auto reply = message.action.replyTo;
+	auto suggest = SuggestOptions();
+	auto webpage = message.webPage;
+	if (const auto existing = history->localDraft(
+			topicRootId,
+			monoforumPeerId)) {
+		if (!Data::DraftStringIsEmpty(existing->textWithTags.text)) {
+			const auto shift = int(text.text.size()) + 1;
+			text.text += '\n' + existing->textWithTags.text;
+			for (auto tag : existing->textWithTags.tags) {
+				tag.offset += shift;
+				text.tags.push_back(std::move(tag));
+			}
+			webpage = existing->webpage;
+		}
+		if (existing->reply.messageId) {
+			reply = existing->reply;
+		}
+		suggest = existing->suggest;
+	}
+	const auto size = int(text.text.size());
+	history->setLocalDraft(std::make_unique<Data::Draft>(
+		text,
+		reply,
+		suggest,
+		MessageCursor{ size, size, Ui::kQFixedMax },
+		webpage));
+	if (const auto thread = history->threadFor(
+			topicRootId,
+			monoforumPeerId)) {
+		history->session().api().saveDraftToCloudDelayed(thread);
+		history->session().changes().entryUpdated(
+			thread,
+			Data::EntryUpdate::Flag::LocalDraftSet);
+	}
+}
+
+void Resend(FnMut<void()> callback) {
+	Resending = true;
+	callback();
+	Resending = false;
+}
+
+} // namespace
+
+bool CalcmulaMessage(const Api::MessageToSend &message) {
+	const auto query = Query(message.textWithTags.text);
+	if (Resending
+		|| !Calcmula()
+		|| query.isEmpty()
+		|| message.action.options.suggest.exists
+		|| message.action.replaceMediaOf) {
+		return false;
+	}
+	const auto history = message.action.history;
+	const auto session = &history->session();
+	if (session->ephemeralMessages().wouldSend(message)) {
+		return false;
+	}
+	const auto original = std::make_shared<Api::MessageToSend>(message);
+	Compute(session, query, [=](Result result) {
+		if (!result.error.isEmpty()) {
+			ShowError(history, result.error);
+			RestoreDraft(*original);
+			return;
+		}
+		auto copy = *original;
+		copy.textWithTags = Compose(query, result.value);
+		Resend([&] {
+			session->api().sendMessage(std::move(copy));
+		});
+	});
+	return true;
+}
+
+bool CalcmulaCaption(
+		const Api::MessageToSend &message,
+		Fn<void(Api::MessageToSend&&)> send) {
+	const auto query = Query(message.textWithTags.text);
+	if (Resending
+		|| !Calcmula()
+		|| query.isEmpty()
+		|| message.action.replaceMediaOf) {
+		return false;
+	}
+	const auto history = message.action.history;
+	const auto original = std::make_shared<Api::MessageToSend>(message);
+	Compute(&history->session(), query, [=](Result result) {
+		auto copy = *original;
+		if (!result.error.isEmpty()) {
+			ShowError(history, result.error);
+		} else {
+			copy.textWithTags = Compose(query, result.value);
+		}
+		Resend([&] {
+			send(std::move(copy));
+		});
+	});
+	return true;
+}
+
+bool CalcmulaFiles(
+		Ui::PreparedList &list,
+		SendMediaType type,
+		const std::shared_ptr<SendingAlbum> &album,
+		const Api::SendAction &action) {
+	if (Resending || !Calcmula() || action.replaceMediaOf) {
+		return false;
+	}
+	auto queries = std::vector<std::pair<int, QString>>();
+	for (auto i = 0, count = int(list.files.size()); i != count; ++i) {
+		auto query = Query(list.files[i].caption.text);
+		if (!query.isEmpty()) {
+			queries.emplace_back(i, std::move(query));
+		}
+	}
+	if (queries.empty()) {
+		return false;
+	}
+	struct State {
+		Ui::PreparedList list;
+		int left = 0;
+		QString error;
+	};
+	const auto state = std::make_shared<State>();
+	state->list = std::move(list);
+	state->left = int(queries.size());
+	const auto history = action.history;
+	const auto session = &history->session();
+	for (const auto &entry : queries) {
+		const auto index = entry.first;
+		const auto query = entry.second;
+		Compute(session, query, [=](Result result) {
+			if (!result.error.isEmpty()) {
+				state->error = result.error;
+			} else {
+				state->list.files[index].caption = Compose(
+					query,
+					result.value);
+			}
+			if (--state->left) {
+				return;
+			} else if (!state->error.isEmpty()) {
+				ShowError(history, state->error);
+			}
+			Resend([&] {
+				session->api().sendFiles(
+					std::move(state->list),
+					type,
+					album,
+					action);
+			});
+		});
+	}
+	return true;
+}
+
+} // namespace Tele
