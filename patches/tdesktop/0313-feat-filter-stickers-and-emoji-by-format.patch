+struct FormatName {
+	StickerFormat format = StickerFormat::All;
+	const char *name = nullptr;
+};
+
+constexpr auto kSetFormats = std::array{
+	FormatName{ StickerFormat::All, "All" },
+	FormatName{ StickerFormat::Static, "Static" },
+	FormatName{ StickerFormat::Animated, "Animated" },
+	FormatName{ StickerFormat::Video, "Video" },
+	FormatName{ StickerFormat::Mixed, "Mixed" },
+};
+
+constexpr auto kSearchFormats = std::array{
+	FormatName{ StickerFormat::All, "All" },
+	FormatName{ StickerFormat::Static, "Static" },
+	FormatName{ StickerFormat::Animated, "Animated" },
+	FormatName{ StickerFormat::Video, "Video" },
+};
+
+[[nodiscard]] QString Name(StickerFormat format) {
+	for (const auto &entry : kSetFormats) {
+		if (entry.format == format) {
+			return Lower(QString::fromLatin1(entry.name));
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] QString SortName(StickerSetSort sort, bool emoji) {
+	switch (sort) {
+	case StickerSetSort::Upstream: return Lower(u"Upstream order"_q);
+	case StickerSetSort::Format: return Lower(u"Format"_q);
+	case StickerSetSort::Name: return Lower(u"Name"_q);
+	case StickerSetSort::Count: return emoji
+		? Lower(u"Emoji count"_q)
+		: Lower(u"Sticker count"_q);
+	}
+	return QString();
+}
+
+template <typename List>
+[[nodiscard]] StickerFormat FormatOf(const List &list) {
+	auto result = StickerFormat::Unknown;
+	for (const auto document : list) {
+		const auto format = DocumentFormat(document);
+		if (format == StickerFormat::Unknown) {
+			continue;
+		} else if (result == StickerFormat::Unknown) {
+			result = format;
+		} else if (result != format) {
+			return StickerFormat::Mixed;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] int Rank(StickerFormat format) {
+	switch (format) {
+	case StickerFormat::Static: return 0;
+	case StickerFormat::Animated: return 1;
+	case StickerFormat::Video: return 2;
+	case StickerFormat::Mixed: return 3;
+	case StickerFormat::All:
+	case StickerFormat::Unknown: break;
+	}
+	return 4;
+}
+
+[[nodiscard]] int CompareNames(
+		not_null<Data::StickersSet*> a,
+		not_null<Data::StickersSet*> b) {
+	return QString::localeAwareCompare(a->title.toLower(), b->title.toLower());
+}
