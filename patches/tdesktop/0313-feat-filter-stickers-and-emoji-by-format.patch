+	const auto shortcuts = _searchShortcutSets.size();
+	_searchShortcutSets.erase(
+		ranges::remove_if(_searchShortcutSets, [&](const Set &set) {
+			return (set.id != _searchSelectedSetId)
+				&& (!set.set
+					|| !Tele::FormatMatches(
+						format,
+						Tele::SearchSetFormat(set.set)));
+		}),
+		end(_searchShortcutSets));
+	if (_searchShortcutSets.size() != shortcuts) {
+		refreshSearchShortcutsScroll(width());
+	}
+	for (auto &set : _searchSets) {
+		set.stickers.erase(
+			ranges::remove_if(set.stickers, [&](const Sticker &sticker) {
+				return !Tele::FormatMatches(
+					format,
+					Tele::DocumentFormat(sticker.document));
+			}),
+			end(set.stickers));
+		set.count = int(set.stickers.size());
+	}
+	_searchSets.erase(
+		ranges::remove_if(_searchSets, [](const Set &set) {
+			return set.stickers.empty();
+		}),
+		end(_searchSets));
 }
 
