+void StickerSetsBar::confirmRemove() {
+	const auto count = _shownCount();
+	if (!count) {
+		_show->showToast(Lower(u"No sets to remove."_q));
+		return;
+	}
+	const auto sets = QString::number(count)
+		+ ((count == 1) ? u" set"_q : u" sets"_q);
+	const auto text = _emoji
+		? (u"Remove "_q + sets + '?')
+		: (u"Archive "_q
+			+ sets
+			+ u"? You can add them back from Archived."_q);
+	const auto weak = base::make_weak(this);
+	_show->showBox(Ui::MakeConfirmBox({
+		.text = Lower(text),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			if (weak) {
+				_removeShown();
+			}
+		},
+		.confirmText = Lower(_emoji ? u"Remove"_q : u"Archive"_q),
+		.confirmStyle = _emoji ? &st::attentionBoxButton : nullptr,
+	}));
+}
