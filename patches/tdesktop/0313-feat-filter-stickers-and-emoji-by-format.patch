+[[nodiscard]] int &SaveGeneration(
+		not_null<Main::Session*> session,
+		Data::StickersType type) {
+	static auto generations = base::flat_map<
+		std::pair<Main::Session*, Data::StickersType>,
+		int>();
+	const auto key = std::make_pair(session.get(), type);
+	if (!generations.contains(key)) {
+		session->lifetime().add([=] {
+			generations.remove(key);
+		});
+	}
+	return generations[key];
+}
+
+struct ArchiveState {
+	std::vector<MTPInputStickerSet> inputs;
+	Fn<void()> done;
+	int index = 0;
+	bool failed = false;
+	bool stickers = false;
+	bool masks = false;
+};
+
+void SendArchive(
+		not_null<Main::Session*> session,
+		std::shared_ptr<ArchiveState> state) {
+	if (state->index >= int(state->inputs.size())) {
+		if (const auto done = base::take(state->done)) {
+			done();
+		}
+		if (state->failed) {
+			auto &stickers = session->data().stickers();
+			if (state->stickers) {
+				stickers.setLastUpdate(0);
+				session->api().updateStickers();
+			}
+			if (state->masks) {
+				stickers.setLastMasksUpdate(0);
+				session->api().updateMasks();
+			}
+		}
+		return;
+	}
+	const auto input = state->inputs[state->index++];
+	session->api().request(MTPmessages_InstallStickerSet(
+		input,
+		MTP_boolTrue()
+	)).done([=] {
+		SendArchive(session, state);
+	}).fail([=] {
+		state->failed = true;
+		SendArchive(session, state);
+	}).send();
+}
