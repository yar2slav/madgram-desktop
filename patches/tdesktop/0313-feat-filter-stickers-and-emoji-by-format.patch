+	for (const auto sort : {
+			StickerSetSort::Upstream,
+			StickerSetSort::Format,
+			StickerSetSort::Name,
+			StickerSetSort::Count }) {
+		_menu->addAction(SortName(sort, _emoji), crl::guard(this, [=] {
+			if (_view.sort != sort) {
+				_view.sort = sort;
+				refreshLabels();
+				_changed(_view);
