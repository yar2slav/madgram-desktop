+	for (const auto &entry : kSetFormats) {
+		const auto format = entry.format;
+		_menu->addAction(Name(format), crl::guard(this, [=] {
+			if (_view.filter != format) {
+				_view.filter = format;
+				refreshLabels();
+				_changed(_view);
+			}
+		}), (_view.filter == format) ? &st::mediaPlayerMenuCheck : nullptr);
+	}
+	PopupBelow(_menu, _format);
