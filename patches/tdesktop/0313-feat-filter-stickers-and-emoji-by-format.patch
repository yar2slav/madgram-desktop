+SearchFormatButton::SearchFormatButton(
+	QWidget *parent,
+	not_null<Ui::RpWidget*> owner,
+	not_null<Ui::TabbedSearch*> search,
+	const style::EmojiPan &st,
+	Fn<void()> changed)
+: AbstractButton(parent)
+, _parent(owner)
+, _search(search)
+, _st(st)
+, _changed(std::move(changed)) {
+	resize(_st.search.height, _st.search.height);
+	setCursor(style::cur_pointer);
+	hide();
+	setClickedCallback([=] { showMenu(); });
+
+	rpl::combine(
+		_search->queryValue(),
+		StickerFormatsValue()
+	) | rpl::on_next([=](const std::vector<QString> &query, bool on) {
+		const auto searching = ranges::any_of(query, [](const QString &q) {
+			return !q.trimmed().isEmpty();
+		});
+		const auto shown = on && searching;
+		if (!shown && _format != StickerFormat::All) {
+			_format = StickerFormat::All;
+			if (searching) {
+				_changed();
+			}
+		}
+		setShown(shown);
+	}, lifetime());
+
+	_parent->widthValue(
+	) | rpl::on_next([=](int) {
+		updatePosition();
+	}, lifetime());
+}
+
+int SearchFormatButton::skip() const {
+	return _st.search.groupSkip;
+}
+
+void SearchFormatButton::setReserved(int reserved) {
+	_reserved = reserved;
+	applyReserved();
+}
+
+void SearchFormatButton::setShown(bool shown) {
+	if (_shown == shown) {
+		return;
+	}
+	_shown = shown;
+	if (!shown) {
+		_menu = nullptr;
+	}
+	setVisible(shown);
+	applyReserved();
+}
+
+void SearchFormatButton::applyReserved() {
+	_search->setRightReserved(_reserved
+		+ (_shown ? (width() + skip()) : 0));
+	updatePosition();
+}
+
+void SearchFormatButton::updatePosition() {
+	move(
+		_parent->width() - _st.searchMargin.right() - _reserved - width(),
+		_st.searchMargin.top());
+	raise();
+}
+
+void SearchFormatButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto active = (_format != StickerFormat::All);
+	p.setPen(Qt::NoPen);
+	p.setBrush((active || isOver()) ? _st.search.bgActive : _st.search.bg);
+	const auto radius = height() / 2.;
+	p.drawRoundedRect(rect(), radius, radius);
+	st::menuIconTagFilter.paintInCenter(
+		p,
+		rect(),
+		(active ? _st.search.fgActive : _st.search.fg)->c);
+}
+
+void SearchFormatButton::onStateChanged(
+		State was,
+		StateChangeSource source) {
+	update();
+}
+
+void SearchFormatButton::showMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		this,
+		st::popupMenuWithIcons);
+	for (const auto &entry : kSearchFormats) {
+		const auto format = entry.format;
+		_menu->addAction(Name(format), crl::guard(this, [=] {
+			if (_format != format) {
+				_format = format;
+				update();
+				_changed();
+			}
+		}), (_format == format) ? &st::mediaPlayerMenuCheck : nullptr);
+	}
+	PopupBelow(_menu, this);
+}
+
+StickerFormat DocumentFormat(not_null<DocumentData*> document) {
+	const auto sticker = document->sticker();
+	if (!sticker) {
+		return StickerFormat::Unknown;
+	}
+	switch (sticker->type) {
+	case StickerType::Webp: return StickerFormat::Static;
+	case StickerType::Tgs: return StickerFormat::Animated;
+	case StickerType::Webm: return StickerFormat::Video;
+	}
+	return StickerFormat::Unknown;
+}
+
+StickerFormat SetFormat(not_null<Data::StickersSet*> set) {
+	if ((set->flags & SetFlag::NotLoaded) || set->stickers.isEmpty()) {
+		return StickerFormat::Unknown;
+	}
+	return FormatOf(set->stickers);
+}
+
+StickerFormat SearchSetFormat(not_null<Data::StickersSet*> set) {
+	const auto result = SetFormat(set);
+	return (result != StickerFormat::Unknown)
+		? result
+		: FormatOf(set->covers);
+}
+
+bool FormatMatches(StickerFormat filter, StickerFormat format) {
+	return (filter == StickerFormat::All) || (filter == format);
+}
+
+bool SetSortedBefore(
+		StickerSetSort sort,
+		not_null<Data::StickersSet*> a,
+		int aCount,
+		not_null<Data::StickersSet*> b,
+		int bCount) {
+	switch (sort) {
+	case StickerSetSort::Upstream: return false;
+	case StickerSetSort::Name: return CompareNames(a, b) < 0;
+	case StickerSetSort::Format: {
+		const auto aRank = Rank(SetFormat(a));
+		const auto bRank = Rank(SetFormat(b));
+		return (aRank != bRank)
+			? (aRank < bRank)
+			: (CompareNames(a, b) < 0);
+	}
+	case StickerSetSort::Count:
+		return (aCount != bCount)
+			? (aCount > bCount)
+			: (CompareNames(a, b) < 0);
+	}
+	return false;
+}
+
+Ui::RpWidget *CreateStickerSetsBar(StickerSetsBarDescriptor &&descriptor) {
+	if (!StickerFormats()) {
+		return nullptr;
+	}
+	return Ui::CreateChild<StickerSetsBar>(
+		descriptor.parent.get(),
+		std::move(descriptor));
+}
+
+void ArchiveStickerSets(
+		not_null<Main::Session*> session,
+		Data::StickersType saveType,
+		const QList<uint64> &ids,
+		Fn<void()> done) {
+	auto &stickers = session->data().stickers();
+	const auto &sets = stickers.sets();
+	auto state = std::make_shared<ArchiveState>();
+	const auto generation = ++SaveGeneration(session, saveType);
+	state->done = [=] {
+		if (SaveGeneration(session, saveType) == generation) {
+			done();
+		}
+	};
+	for (const auto id : ids) {
+		const auto i = sets.find(id);
+		if (i == end(sets)) {
+			continue;
+		}
+		const auto set = i->second.get();
+		const auto type = set->type();
+		if (type == Data::StickersType::Emoji
+			|| (set->flags & SetFlag::Archived)) {
+			continue;
+		}
+		const auto masks = (type == Data::StickersType::Masks);
+		auto &order = masks
+			? stickers.maskSetsOrderRef()
+			: stickers.setsOrderRef();
+		order.removeAll(id);
+		auto &archived = masks
+			? stickers.archivedMaskSetsOrderRef()
+			: stickers.archivedSetsOrderRef();
+		if (!archived.contains(id)) {
+			archived.push_front(id);
+		}
+		set->flags |= SetFlag::Archived;
+		state->inputs.push_back(set->mtpInput());
+		(masks ? state->masks : state->stickers) = true;
+	}
+	if (state->stickers) {
+		session->local().writeInstalledStickers();
+		session->local().writeArchivedStickers();
+		stickers.notifyUpdated(Data::StickersType::Stickers);
+	}
+	if (state->masks) {
+		session->local().writeInstalledMasks();
+		session->local().writeArchivedMasks();
+		stickers.notifyUpdated(Data::StickersType::Masks);
+	}
+	SendArchive(session, state);
+}
+
+SearchFormatButton *AddSearchFormatButton(
+		not_null<Ui::RpWidget*> parent,
+		not_null<Ui::TabbedSearch*> search,
+		const style::EmojiPan &st,
+		Fn<void()> changed) {
+	return Ui::CreateChild<SearchFormatButton>(
+		parent.get(),
+		parent,
+		search,
+		st,
+		std::move(changed));
+}
+
+void SetSearchFormatReserved(SearchFormatButton *button, int reserved) {
+	if (button) {
+		button->setReserved(reserved);
+	}
+}
+
+StickerFormat SearchFormat(const SearchFormatButton *button) {
+	return (button && StickerFormats())
+		? button->format()
+		: StickerFormat::All;
+}
+
+void AddEmojiSetsButton(
+		not_null<Ui::VerticalLayout*> container,
+		not_null<Window::SessionController*> controller) {
+	const auto wrap = container->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			container,
+			object_ptr<Ui::VerticalLayout>(container)));
+	const auto button = Settings::AddButtonWithIcon(
+		wrap->entity(),
+		rpl::single(Lower(u"Emoji sets you have"_q)),
+		st::settingsButton,
+		{ &st::menuIconEmoji });
+	button->addClickHandler([=] {
+		controller->show(Box<StickersBox>(
+			controller->uiShow(),
+			Data::StickersType::Emoji));
+	});
+	wrap->toggleOn(StickerFormatsValue());
+	wrap->finishAnimating();
+}
+
+void AddEmojiSetsAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<ChatHelpers::Show> show) {
+	if (!StickerFormats()) {
+		return;
+	}
+	menu->addAction(Lower(u"Manage emoji sets"_q), [=] {
+		show->showBox(Box<StickersBox>(show, Data::StickersType::Emoji));
+	}, &st::menuIconEmoji);
+}
+
