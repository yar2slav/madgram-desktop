+std::vector<StickersBox::Inner::Row*> StickersBox::Inner::teleRows() const {
+	auto result = std::vector<Row*>();
+	result.reserve(_rows.size() + _teleHidden.size());
+	if (!_teleShown.active()) {
+		for (const auto &row : _rows) {
+			result.push_back(row.get());
+		}
+		return result;
+	}
+	auto shown = base::flat_set<uint64>();
+	auto hidden = base::flat_map<uint64, Row*>();
+	for (const auto &row : _rows) {
+		shown.emplace(row->set->id);
+	}
+	for (const auto &row : _teleHidden) {
+		hidden.emplace(row->set->id, row.get());
+	}
+	const auto inOrder = (_teleShown.sort == Tele::StickerSetSort::Upstream);
+	auto next = 0;
+	for (const auto setId : _teleOrder) {
+		if (const auto i = hidden.find(setId); i != end(hidden)) {
+			result.push_back(i->second);
+		} else if (shown.contains(setId) && next < int(_rows.size())) {
+			result.push_back(inOrder
+				? _rows[next++].get()
+				: _rows[getRowIndex(setId)].get());
+		}
+	}
+	return result;
+}
+
+bool StickersBox::Inner::teleRowMatches(not_null<Row*> row) const {
+	if (_teleView.filter == Tele::StickerFormat::All) {
+		return true;
+	} else if (row->isRecentSet()) {
+		return false;
+	}
+	return Tele::FormatMatches(_teleView.filter, Tele::SetFormat(row->set));
+}
+
+bool StickersBox::Inner::teleCanDrag() const {
+	return (_teleShown.sort == Tele::StickerSetSort::Upstream);
+}
+
+int StickersBox::Inner::teleShownCount() const {
+	return int(ranges::count_if(_rows, [](const std::unique_ptr<Row> &row) {
+		return !row->removed && !row->isRecentSet();
+	}));
+}
+
+void StickersBox::Inner::teleSetView(Tele::StickerSetView view) {
+	_teleView = view;
+	teleApplyView();
+}
+
+void StickersBox::Inner::teleResetState() {
+	setSelected(SelectedRow());
+	setPressed(SelectedRow());
+	setActionSel(-1);
+	setActionDown(-1);
+	_shiftingAnimation.stop();
+	_aboveShadowFadeStart = 0;
+	_aboveShadowFadeOpacity = anim::value();
+	_above = _dragging = _started = -1;
+	for (const auto &row : _rows) {
+		row->yShift = anim::value();
+	}
+}
+
+void StickersBox::Inner::teleUnview() {
+	if (!_teleShown.active()) {
+		return;
+	}
+	teleResetState();
+	const auto order = teleRows();
+	auto all = base::flat_map<Row*, std::unique_ptr<Row>>();
+	for (auto &row : _rows) {
+		const auto raw = row.get();
+		all.emplace(raw, std::move(row));
+	}
+	for (auto &row : _teleHidden) {
+		const auto raw = row.get();
+		all.emplace(raw, std::move(row));
+	}
+	_rows.clear();
+	_teleHidden.clear();
+	for (const auto row : order) {
+		if (const auto i = all.find(row); i != end(all) && i->second) {
+			_rows.push_back(std::move(i->second));
+		}
+	}
+	for (auto &[raw, row] : all) {
+		if (row) {
+			_rows.push_back(std::move(row));
+		}
+	}
+	_teleOrder.clear();
+	_teleShown = Tele::StickerSetView();
+	_shiftingStartTimes.assign(_rows.size(), 0);
+}
+
+void StickersBox::Inner::teleApplyView() {
+	teleUnview();
+	if (_teleView.active()) {
+		teleResetState();
+		for (const auto &row : _rows) {
+			_teleOrder.push_back(row->set->id);
+		}
+		auto shown = std::vector<std::unique_ptr<Row>>();
+		for (auto &row : _rows) {
+			if (teleRowMatches(row.get())) {
+				shown.push_back(std::move(row));
+			} else {
+				_teleHidden.push_back(std::move(row));
+			}
+		}
+		if (_teleView.sort != Tele::StickerSetSort::Upstream) {
+			const auto sort = _teleView.sort;
+			ranges::stable_sort(shown, [&](
+					const std::unique_ptr<Row> &a,
+					const std::unique_ptr<Row> &b) {
+				if (a->isRecentSet() != b->isRecentSet()) {
+					return a->isRecentSet();
+				}
+				return Tele::SetSortedBefore(
+					sort,
+					a->set,
+					a->count,
+					b->set,
+					b->count);
+			});
+		}
+		_rows = std::move(shown);
+		_shiftingStartTimes.assign(_rows.size(), 0);
+		_teleShown = _teleView;
+	}
+	updateSize();
+	update();
+}
+
+void StickersBox::Inner::teleRemoveShown() {
+	for (auto i = 0, count = int(_rows.size()); i != count; ++i) {
+		const auto row = _rows[i].get();
+		if (row->removed || row->isRecentSet()) {
+			continue;
+		} else if (!_megagroupSetEmoji) {
+			_teleArchive.emplace(row->set->id);
+		}
+		setRowRemoved(i, true);
+	}
+}
+
+void StickersBox::Inner::teleSetHiddenRemoved(uint64 setId, bool removed) {
+	for (const auto &row : _teleHidden) {
+		if (row->set->id == setId) {
+			row->removed = removed;
+		}
+	}
+}
+
+StickersSetsOrder StickersBox::Inner::teleArchived() const {
+	return collectSets([&](Row *row) {
+		return row->removed && _teleArchive.contains(row->set->id);
+	});
+}
+
 StickersBox::Inner::~Inner() {
 	clear();
 }
