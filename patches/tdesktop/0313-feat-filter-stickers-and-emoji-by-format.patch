+void EmojiListWidget::teleFilterSearch() {
+	const auto format = Tele::SearchFormat(_teleFormats);
+	if (format == Tele::StickerFormat::All) {
+		return;
+	}
+	const auto owner = &session().data();
+	_searchResults.erase(
+		ranges::remove_if(_searchResults, [&](const RecentOne &one) {
+			const auto id = std::get_if<RecentEmojiDocument>(&one.id.data);
+			return !id
+				|| !Tele::FormatMatches(
+					format,
+					Tele::DocumentFormat(owner->document(id->id)));
+		}),
+		end(_searchResults));
+	const auto shortcuts = _searchShortcutSets.size();
+	_searchShortcutSets.erase(
+		ranges::remove_if(_searchShortcutSets, [&](const CustomSet &set) {
+			return (set.id != _searchSelectedSetId)
+				&& !Tele::FormatMatches(
+					format,
+					Tele::SearchSetFormat(set.set));
+		}),
+		end(_searchShortcutSets));
+	if (_searchShortcutSets.size() != shortcuts) {
+		refreshSearchShortcutsScroll(width());
+	}
+	for (auto &set : _searchSets) {
+		set.list.erase(
+			ranges::remove_if(set.list, [&](const CustomOne &one) {
+				return !Tele::FormatMatches(
+					format,
+					Tele::DocumentFormat(one.document));
+			}),
+			end(set.list));
+	}
+	_searchSets.erase(
+		ranges::remove_if(_searchSets, [](const CustomSet &set) {
+			return set.list.empty();
+		}),
+		end(_searchSets));
 }
 
