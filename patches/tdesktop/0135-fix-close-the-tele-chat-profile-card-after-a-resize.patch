From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Wed, 30 Sep 2026 03:11:55 +0300
Subject: [PATCH] fix: close the tele chat profile card after a resize

---
 .../SourceFiles/tele/tele_changelog_chat.cpp  | 24 ++++++++++++++++---
 .../SourceFiles/tele/tele_changelog_chat.h    |  3 ++-
 .../window/window_session_controller.cpp      |  2 +-
 3 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_changelog_chat.cpp b/Telegram/SourceFiles/tele/tele_changelog_chat.cpp
index d9897cb95c1629953310d9f287e99334675938aa..b3caec8d8d1126a9da0dda844bdc77dcbe2bd4b4 100644
--- a/Telegram/SourceFiles/tele/tele_changelog_chat.cpp
+++ b/Telegram/SourceFiles/tele/tele_changelog_chat.cpp
@@ -185,10 +185,26 @@ void ProfileBox(not_null<Ui::GenericBox*> box, not_null<UserData*> user) {
 	});
 }
 
+[[nodiscard]] base::weak_qptr<Ui::BoxContent> &ShownProfile(
+		not_null<Window::SessionController*> controller) {
+	static auto shown = base::flat_map<
+		not_null<Window::SessionController*>,
+		base::weak_qptr<Ui::BoxContent>>();
+	if (!shown.contains(controller)) {
+		controller->lifetime().add([=] {
+			shown.remove(controller);
+		});
+	}
+	return shown[controller];
+}
+
 void ShowProfile(
 		not_null<Window::SessionController*> controller,
 		not_null<UserData*> user) {
-	controller->show(Box(ProfileBox, user));
+	auto &shown = ShownProfile(controller);
+	if (!shown) {
+		shown = controller->show(Box(ProfileBox, user));
+	}
 }
 
 } // namespace
@@ -290,7 +306,8 @@ void ShowChangelogHistory(
 
 bool ShowChangelogProfile(
 		not_null<Window::SessionController*> controller,
-		not_null<Window::SectionMemento*> memento) {
+		not_null<Window::SectionMemento*> memento,
+		const Window::SectionShow &params) {
 	const auto info = dynamic_cast<Info::Memento*>(memento.get());
 	if (!info || !info->stackSize()) {
 		return false;
@@ -298,8 +315,9 @@ bool ShowChangelogProfile(
 	const auto peer = info->content()->peer();
 	if (!IsChangelogPeer(peer)) {
 		return false;
+	} else if (!params.thirdColumn) {
+		ShowProfile(controller, peer->asUser());
 	}
-	ShowProfile(controller, peer->asUser());
 	return true;
 }
 
diff --git a/Telegram/SourceFiles/tele/tele_changelog_chat.h b/Telegram/SourceFiles/tele/tele_changelog_chat.h
index 660d43d8e89369a2acf2c4d65f1c88dbc3d5ea0a..20c1b2bca5d811c28b219352c9b0aeb50e77f1f5 100644
--- a/Telegram/SourceFiles/tele/tele_changelog_chat.h
+++ b/Telegram/SourceFiles/tele/tele_changelog_chat.h
@@ -66,7 +66,8 @@ void ShowChangelogHistory(
 	const Window::SectionShow &params);
 [[nodiscard]] bool ShowChangelogProfile(
 	not_null<Window::SessionController*> controller,
-	not_null<Window::SectionMemento*> memento);
+	not_null<Window::SectionMemento*> memento,
+	const Window::SectionShow &params);
 [[nodiscard]] bool FillChangelogMenu(
 	not_null<Window::SessionController*> controller,
 	const Dialogs::EntryState &request,
diff --git a/Telegram/SourceFiles/window/window_session_controller.cpp b/Telegram/SourceFiles/window/window_session_controller.cpp
index d46be943b0496ec549930f8e57bf6ec85a902cb1..ec95ccd381fb9edc01730695c5265bffca1c5702 100644
--- a/Telegram/SourceFiles/window/window_session_controller.cpp
+++ b/Telegram/SourceFiles/window/window_session_controller.cpp
@@ -3421,7 +3421,7 @@ void SessionController::cancelUploadLayer(not_null<HistoryItem*> item) {
 void SessionController::showSection(
 		std::shared_ptr<SectionMemento> memento,
 		const SectionShow &params) {
-	if (Tele::ShowChangelogProfile(this, memento.get())
+	if (Tele::ShowChangelogProfile(this, memento.get(), params)
 		|| Tele::BlocksCommunitySection(memento.get())) {
 		return;
 	} else if (!params.thirdColumn
