diff --git a/Telegram/SourceFiles/tele/tele_inline_via.cpp b/Telegram/SourceFiles/tele/tele_inline_via.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b4deb8bdcb1b6c3b64618bebdb88910740e1bcac
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_inline_via.cpp
@@ -0,0 +1,139 @@
+#include "tele/tele_inline_via.h"
+
+#include "api/api_common.h"
+#include "api/api_sending.h"
+#include "apiwrap.h"
+#include "data/data_document.h"
+#include "data/data_location.h"
+#include "history/history.h"
+#include "inline_bots/inline_bot_result.h"
+#include "inline_bots/inline_bot_send_data.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/text/text_entity.h"
+
+namespace Tele {
+
+struct InlineResultAccess {
+	[[nodiscard]] static auto Data(not_null<const InlineBots::Result*> result)
+	-> const InlineBots::internal::SendData* {
+		return result->sendData.get();
+	}
+	[[nodiscard]] static not_null<PhotoData*> Photo(
+			const InlineBots::internal::SendPhoto &data) {
+		return data._photo;
+	}
+	[[nodiscard]] static not_null<DocumentData*> Document(
+			const InlineBots::internal::SendFile &data) {
+		return data._document;
+	}
+	[[nodiscard]] static TextWithEntities Caption(
+			const InlineBots::internal::SendPhoto &data) {
+		return { data._message, data._entities };
+	}
+	[[nodiscard]] static TextWithEntities Caption(
+			const InlineBots::internal::SendFile &data) {
+		return { data._message, data._entities };
+	}
+};
+
+namespace {
+
+using namespace InlineBots::internal;
+
+[[nodiscard]] TextWithTags ToTags(const TextWithEntities &text) {
+	return {
+		text.text,
+		TextUtilities::ConvertEntitiesToTextTags(text.entities),
+	};
+}
+
+[[nodiscard]] bool SendCommon(
+		const SendDataCommon &data,
+		const Api::SendAction &action,
+		std::optional<MsgId> localMessageId) {
+	const auto fields = data.getSentMessageFields();
+	return fields.media.match([&](const MTPDmessageMediaEmpty &) {
+		auto message = Api::MessageToSend(action);
+		message.textWithTags = ToTags(fields.text);
+		message.action.clearDraft = true;
+		action.history->session().api().sendMessage(
+			std::move(message),
+			localMessageId);
+		return true;
+	}, [&](const MTPDmessageMediaGeo &media) {
+		return media.vgeo().match([&](const MTPDgeoPoint &point) {
+			Api::SendLocation(action, point.vlat().v, point.vlong().v);
+			return true;
+		}, [](const MTPDgeoPointEmpty &) {
+			return false;
+		});
+	}, [&](const MTPDmessageMediaVenue &media) {
+		return media.vgeo().match([&](const MTPDgeoPoint &point) {
+			Api::SendInputMedia(action, MTP_inputMediaVenue(
+				MTP_inputGeoPoint(
+					MTP_flags(0),
+					point.vlat(),
+					point.vlong(),
+					MTPint()),
+				media.vtitle(),
+				media.vaddress(),
+				media.vprovider(),
+				media.vvenue_id(),
+				media.vvenue_type()));
+			return true;
+		}, [](const MTPDgeoPointEmpty &) {
+			return false;
+		});
+	}, [&](const MTPDmessageMediaContact &media) {
+		action.history->session().api().shareContact(
+			qs(media.vphone_number()),
+			qs(media.vfirst_name()),
+			qs(media.vlast_name()),
+			action);
+		return true;
+	}, [](const auto &) {
+		return false;
+	});
+}
+
+} // namespace
+
+bool SendInlineWithoutVia(
+		not_null<InlineBots::Result*> result,
+		const Api::SendAction &action,
+		std::optional<MsgId> localMessageId,
+		const Fn<void(bool)> &done) {
+	if (done || !InlineWithoutVia()) {
+		return false;
+	}
+	const auto data = InlineResultAccess::Data(result);
+	if (const auto common = dynamic_cast<const SendDataCommon*>(data)) {
+		return SendCommon(*common, action, localMessageId);
+	} else if (!result->contentUrl().isEmpty()) {
+		return false;
+	}
+	auto message = Api::MessageToSend(action);
+	if (const auto photo = dynamic_cast<const SendPhoto*>(data)) {
+		message.textWithTags = ToTags(InlineResultAccess::Caption(*photo));
+		Api::SendExistingPhoto(
+			std::move(message),
+			InlineResultAccess::Photo(*photo),
+			localMessageId);
+		return true;
+	} else if (const auto file = dynamic_cast<const SendFile*>(data)) {
+		const auto document = InlineResultAccess::Document(*file);
+		if (!document->hasRemoteLocation()) {
+			return false;
+		}
+		message.textWithTags = ToTags(InlineResultAccess::Caption(*file));
+		Api::SendExistingDocument(
+			std::move(message),
+			document,
+			localMessageId);
+		return true;
+	}
+	return false;
+}
+
+} // namespace Tele
