 		&& !video->hasAudio;
 }
 
+void ApplySilentVideoDefault(Ui::PreparedFile &file) {
+	if (const auto video = LookupVideo(file)) {
+		const auto asVideo = GifVideo()
+			&& (SilentVideoAs() == u"video"_q);
+		SetSendAsGif(*video, !video->hasAudio && !asVideo);
+	}
+}
+
+void KeepSendingAsGif(Ui::PreparedFile &file) {
+	if (const auto video = LookupVideo(file)) {
+		SetSendAsGif(*video, !video->hasAudio);
+	}
+}
