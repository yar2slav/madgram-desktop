 	.name = "Send audio files as voice",
@@ -2634,6 +2641,24 @@ bool GifVideo() {
 	return GifVideoOption.value();
 }
 
+QString SilentVideoAs() {
+	return SilentVideoAsOption.value();
+}
+
+void SetSilentVideoAs(const QString &value) {
+	SilentVideoAsOption.set(value);
+}
+
+rpl::producer<QString> SilentVideoAsValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		SilentVideoAsOption.changes()
+	) | rpl::map([] {
+		return SilentVideoAsOption.value();
+	});
+}
+
 bool AudioVoice() {
 	return AudioVoiceOption.value();
 }
