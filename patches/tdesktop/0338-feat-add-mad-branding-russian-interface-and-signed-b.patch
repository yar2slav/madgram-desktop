+};
+
+struct MadRegistry {
+	qint64 revision = 0;
+	qint64 generatedAt = 0;
+	QMap<QString, MadBadge> badges;
+	QMap<QString, MadAssignment> assignments;
+};
+
+[[nodiscard]] std::optional<MadBadge> FindMadBadge(
+	const MadRegistry &registry, const QString &target, qint64 now);
