diff --git a/Telegram/SourceFiles/tele/tele_translations.cpp b/Telegram/SourceFiles/tele/tele_translations.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..19984408b64de3ec364d8d01fa877c66f339d1f1
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_translations.cpp
@@ -0,0 +1,76 @@
+#include "tele/tele_lowercase.h"
+
+#include "lang/lang_instance.h"
+#include <QtCore/QFile>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonObject>
+#include <QtCore/QLocale>
+#include <QtCore/QRegularExpression>
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool Russian() {
+	const auto &language = Lang::GetInstance();
+	return (!language.id().isEmpty()
+		&& QLocale(language.id()).language() == QLocale::Russian)
+		|| (!language.baseId().isEmpty()
+			&& QLocale(language.baseId()).language() == QLocale::Russian);
+}
+
+[[nodiscard]] const QJsonObject &Translations() {
+	static const auto result = [] {
+		auto file = QFile(u":/gui/langs/mad_ru.json"_q);
+		return file.open(QIODevice::ReadOnly)
+			? QJsonDocument::fromJson(file.readAll()).object()
+			: QJsonObject();
+	}();
+	return result;
+}
+
+}
+
+QString Tr(QString text) {
+	if (Russian()) {
+		const auto translation = Translations().value(text);
+		if (translation.isArray()) {
+			text = translation.toArray().last().toString();
+		} else if (translation.isString()) {
+			text = translation.toString();
+		}
+	}
+	static const auto brand = QRegularExpression(u"\\btele\\b"_q);
+	text.replace(brand, u"mad"_q);
+	return Lower(std::move(text));
+}
+
+QByteArray WebTranslationsScript() {
+	auto values = QJsonObject();
+	const auto &catalog = Translations();
+	for (auto i = catalog.begin(); i != catalog.end(); ++i) {
+		values.insert(i.key(), Tr(i.key()));
+	}
+	auto json = QJsonDocument(values).toJson(QJsonDocument::Compact);
+	json.replace("<", "\\u003c");
+	json.replace(">", "\\u003e");
+	json.replace("&", "\\u0026");
+	return "window.madTr = (function (values) { return function (text) { "
+		"return Object.prototype.hasOwnProperty.call(values, text) ? values[text] : text; }; })("
+		+ json + ");";
+}
+
+QString TrCount(qint64 count, QString one, QString many) {
+	auto text = count == 1 ? one : many;
+	if (Russian()) {
+		const auto forms = Translations().value(many).toArray();
+		const auto last = qAbs(count % 10);
+		const auto lastTwo = qAbs(count % 100);
+		const auto index = last == 1 && lastTwo != 11 ? 0
+			: last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14) ? 1 : 2;
+		text = forms.size() == 3 ? forms[index].toString() : Tr(text);
+	}
+	return Lower(text.contains(u"%1"_q) ? text.arg(count) : text);
+}
+
+}
