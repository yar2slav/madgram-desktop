+[[nodiscard]] std::optional<MadRegistry> DecodeMadRegistry(
+	const QByteArray &envelope,
+	const QByteArray &publicKey,
+	const QString &keyId);
+[[nodiscard]] QImage DecodeMadBadgeImage(
+	const QByteArray &bytes,
+	const QByteArray &hash,
+	int size);
+
+}
