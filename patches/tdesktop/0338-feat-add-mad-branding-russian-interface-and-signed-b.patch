index 0b2b6fbd137839d9b84bf4b7168addf35750ee99..83cd0bd5088cbdfc35c7c2f19fcd4502686d8c6d 100644
--- a/Telegram/Resources/tele_html/mtp_console.html
+++ b/Telegram/Resources/tele_html/mtp_console.html
@@ -7,6 +7,7 @@
 <title>MTProto console</title>
 <link rel="stylesheet" href="inspector.css">
 <link rel="stylesheet" href="console.css">
+<script>__MAD_I18N__</script>
 <script src="console.js"></script>
 </head>
 <body>
@@ -57,5 +58,24 @@
 <div id="popup"></div>
 <div id="help-panel" class="modal"><div id="help-box" class="modal-box help-box"></div></div>
 <div id="confirm" class="modal"><div class="modal-box"><div id="confirm-text"></div><div class="modal-buttons"><button id="confirm-cancel" class="ui" type="button">Cancel</button><button id="confirm-ok" class="ui danger" type="button">Send</button></div></div></div>
+<script>
+(function () {
+    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+    const nodes = [];
+    while (walker.nextNode()) {
+        if (!['SCRIPT', 'STYLE', 'TEXTAREA'].includes(walker.currentNode.parentElement.tagName)) nodes.push(walker.currentNode);
+    }
+    for (const node of nodes) {
+        const text = node.textContent.trim();
+        if (text) node.textContent = node.textContent.replace(text, madTr(text));
+    }
+    for (const element of document.querySelectorAll('[title], [placeholder]')) {
+        for (const key of ['title', 'placeholder']) {
+            if (element.hasAttribute(key)) element.setAttribute(key, madTr(element.getAttribute(key)));
+        }
+    }
+    document.title = madTr(document.title);
+})();
+</script>
 </body>
 </html>
