diff --git a/Telegram/SourceFiles/tele/tele_mad_registry.cpp b/Telegram/SourceFiles/tele/tele_mad_registry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ba9e5b9a517bde705e6f7d2d61e1dfad0423feaa
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mad_registry.cpp
@@ -0,0 +1,203 @@
+#include "tele/tele_mad_registry.h"
+
+#include <QtCore/QBuffer>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QUrlQuery>
+#include <QtGui/QImageReader>
+#include <openssl/evp.h>
+#include <memory>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxBytes = 2 * 1024 * 1024;
+
+[[nodiscard]] bool ValidHash(const QString &value) {
+	if (value.size() != 64) {
+		return false;
+	}
+	for (const auto ch : value) {
+		if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] qint64 Integer(const QJsonValue &value) {
+	if (value.isString()) {
+		auto ok = false;
+		const auto text = value.toString();
+		const auto result = text.toLongLong(&ok);
+		return ok && QString::number(result) == text ? result : -1;
+	}
+	return value.isDouble() ? value.toInteger(-1) : -1;
+}
+
+[[nodiscard]] bool Verify(
+		const QByteArray &payload,
+		const QByteArray &signature,
+		const QByteArray &key) {
+	if (key.size() != 32 || signature.size() != 64) {
+		return false;
+	}
+	const auto publicKey = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>(
+		EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr,
+			reinterpret_cast<const unsigned char*>(key.constData()), key.size()),
+		EVP_PKEY_free);
+	const auto context = std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)>(
+		EVP_MD_CTX_new(), EVP_MD_CTX_free);
+	return publicKey && context
+		&& EVP_DigestVerifyInit(context.get(), nullptr, nullptr, nullptr,
+			publicKey.get()) == 1
+		&& EVP_DigestVerify(context.get(),
+			reinterpret_cast<const unsigned char*>(signature.constData()), signature.size(),
+			reinterpret_cast<const unsigned char*>(payload.constData()), payload.size()) == 1;
+}
+
+}
+
+std::optional<MadBadge> FindMadBadge(const MadRegistry &registry, const QString &target, qint64 now) {
+	const auto i = registry.assignments.constFind(target);
+	if (i == registry.assignments.cend() || (i->expiresAt && i->expiresAt <= now)) {
+		return std::nullopt;
+	}
+	const auto badge = registry.badges.constFind(i->badgeId);
+	return badge == registry.badges.cend() ? std::nullopt : std::optional(*badge);
+}
+
+bool MadAssetUrlAllowed(const QUrl &url) {
+	const auto query = QUrlQuery(url).queryItems();
+	const auto versioned = query.size() == 1
+		&& query.front().first == QStringLiteral("v") && ValidHash(query.front().second);
+	return url.isValid()
+		&& url.scheme() == QStringLiteral("https")
+		&& url.host().compare(QStringLiteral("b.mad.tg"), Qt::CaseInsensitive) == 0
+		&& url.userInfo().isEmpty()
+		&& url.port(443) == 443
+		&& url.path().startsWith(QStringLiteral("/assets/"))
+		&& !url.path().contains(QStringLiteral(".."))
+		&& (!url.hasQuery() || versioned) && !url.hasFragment();
+}
+
+std::optional<MadRegistry> DecodeMadRegistry(
+		const QByteArray &envelope,
+		const QByteArray &publicKey,
+		const QString &keyId) {
+	if (envelope.isEmpty() || envelope.size() > kMaxBytes) {
+		return std::nullopt;
+	}
+	const auto document = QJsonDocument::fromJson(envelope);
+	if (!document.isObject()) {
+		return std::nullopt;
+	}
+	const auto object = document.object();
+	if (Integer(object["schemaVersion"]) != 1 || object["keyId"].toString() != keyId) {
+		return std::nullopt;
+	}
+	const auto payload = QByteArray::fromBase64(
+		object["payload"].toString().toLatin1(), QByteArray::AbortOnBase64DecodingErrors);
+	const auto signature = QByteArray::fromBase64(
+		object["signature"].toString().toLatin1(), QByteArray::AbortOnBase64DecodingErrors);
+	if (!Verify(payload, signature, publicKey)) {
+		return std::nullopt;
+	}
+	const auto decoded = QJsonDocument::fromJson(payload);
+	if (!decoded.isObject()) {
+		return std::nullopt;
+	}
+	const auto data = decoded.object();
+	auto result = MadRegistry();
+	result.revision = Integer(data["revision"]);
+	result.generatedAt = Integer(data["generatedAt"]);
+	if (result.revision < 0 || result.generatedAt <= 0
+		|| !data["badges"].isArray() || !data["assignments"].isArray()
+		|| data["badges"].toArray().size() > 10000
+		|| data["assignments"].toArray().size() > 100000) {
+		return std::nullopt;
+	}
+	for (const auto &value : data["badges"].toArray()) {
+		if (!value.isObject()) {
+			return std::nullopt;
+		}
+		const auto item = value.toObject();
+		auto badge = MadBadge();
+		badge.id = item["id"].toString();
+		badge.title = item["title"].toString();
+		badge.description = item["description"].toString();
+		badge.link = item["linkUrl"].toString();
+		if (badge.id.isEmpty() || badge.id.size() > 128 || badge.title.isEmpty()
+			|| badge.title.size() > 256 || badge.description.size() > 4096
+			|| badge.link.size() > 2048 || result.badges.contains(badge.id)) {
+			return std::nullopt;
+		}
+		const auto media = item["media"].toObject();
+		const auto kind = media["kind"].toString();
+		if (kind == QStringLiteral("customEmoji")) {
+			const auto id = Integer(media["documentId"]);
+			if (id <= 0) {
+				return std::nullopt;
+			}
+			badge.documentId = quint64(id);
+		} else if (kind == QStringLiteral("image")) {
+			badge.image64 = QUrl(media["image64"].toString());
+			badge.image128 = QUrl(media["image128"].toString());
+			const auto hash64 = media["image64Hash"].toString();
+			const auto hash128 = media["image128Hash"].toString();
+			if (!MadAssetUrlAllowed(badge.image64) || !MadAssetUrlAllowed(badge.image128)
+				|| !ValidHash(hash64) || !ValidHash(hash128)
+				|| (badge.image64.hasQuery() && QUrlQuery(badge.image64).queryItemValue(QStringLiteral("v")) != hash64)
+				|| (badge.image128.hasQuery() && QUrlQuery(badge.image128).queryItemValue(QStringLiteral("v")) != hash128)
+				|| !ValidHash(media["contentHash"].toString())) {
+				return std::nullopt;
+			}
+			badge.hash64 = hash64.toLatin1();
+			badge.hash128 = hash128.toLatin1();
+		} else {
+			return std::nullopt;
+		}
+		const auto id = badge.id;
+		result.badges.insert(id, std::move(badge));
+	}
+	for (const auto &value : data["assignments"].toArray()) {
+		if (!value.isObject()) {
+			return std::nullopt;
+		}
+		const auto item = value.toObject();
+		const auto type = item["peerType"].toString();
+		const auto id = Integer(item["peerId"]);
+		const auto key = type + ':' + QString::number(id);
+		const auto expires = item["expiresAt"];
+		const auto expiry = expires.isNull() || expires.isUndefined() ? 0 : Integer(expires);
+		const auto badgeId = item["badgeId"].toString();
+		if ((type != QStringLiteral("user") && type != QStringLiteral("legacyGroup")
+			&& type != QStringLiteral("channel")) || id <= 0 || expiry < 0
+			|| !result.badges.contains(badgeId) || result.assignments.contains(key)) {
+			return std::nullopt;
+		}
+		result.assignments.insert(key, { badgeId, expiry });
+	}
+	return result;
+}
+
+QImage DecodeMadBadgeImage(const QByteArray &bytes, const QByteArray &hash, int size) {
+	if (bytes.isEmpty() || bytes.size() > kMaxBytes || (size != 64 && size != 128)
+		|| QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex() != hash) {
+		return {};
+	}
+	auto buffer = QBuffer();
+	buffer.setData(bytes);
+	buffer.open(QIODevice::ReadOnly);
+	auto reader = QImageReader(&buffer, "webp");
+	reader.setAutoDetectImageFormat(false);
+	reader.setDecideFormatFromContent(false);
+	if (reader.size() != QSize(size, size) || reader.supportsAnimation()) {
+		return {};
+	}
+	return reader.read();
+}
+
+}
