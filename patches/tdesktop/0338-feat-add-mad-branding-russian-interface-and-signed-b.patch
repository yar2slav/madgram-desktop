@@ -6,6 +6,7 @@
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>MTProto inspector</title>
 <link rel="stylesheet" href="inspector.css">
+<script>__MAD_I18N__</script>
 <script src="inspector.js"></script>
 </head>
