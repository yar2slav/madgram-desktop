+#include "main/main_session.h"
+#include "settings.h"
+#include "tele/tele_launch_flags.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/abstract_button.h"
+#include "ui/layers/generic_box.h"
+#include "ui/text/text_utilities.h"
+#include "ui/text/text.h"
+#include "ui/ui_utility.h"
+#include "ui/widgets/labels.h"
+#include "styles/style_layers.h"
+#include "styles/style_boxes.h"
+#include "styles/style_basic.h"
+#include <QtCore/QCoreApplication>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDateTime>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QPointer>
+#include <QtCore/QSaveFile>
+#include <QtCore/QSet>
+#include <QtCore/QTimer>
+#include <QtGui/QDesktopServices>
+#include <QtGui/QPainter>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxBytes = qint64(2 * 1024 * 1024);
+constexpr auto kCacheBytes = qint64(25 * 1024 * 1024);
+
+[[nodiscard]] QString Prefix() {
+	return u"mad-badge:"_q;
+}
+
+[[nodiscard]] QString CacheDirectory() {
+	return cWorkingDir() + u"tdata/mad_badges/"_q;
+}
+
+[[nodiscard]] std::optional<MadRegistry> Decode(const QByteArray &bytes) {
+	return DecodeMadRegistry(bytes,
+		QByteArray::fromBase64("fu30bgNFntwaeXWD3dyTuMgWKM12eGKgqwRbgl/Soy0="),
+		u"mad-badges-1"_q);
+}
+
+[[nodiscard]] QString Target(not_null<PeerData*> peer) {
+	if (peer->isUser()) {
+		return u"user:%1"_q.arg(peerToUser(peer->id).bare);
+	} else if (peer->isChat()) {
+		return u"legacyGroup:%1"_q.arg(peerToChat(peer->id).bare);
+	}
+	return u"channel:%1"_q.arg(peerToChannel(peer->id).bare);
+}
+
+void WriteFile(const QString &path, const QByteArray &bytes) {
+	auto file = QSaveFile(path);
+	if (file.open(QIODevice::WriteOnly) && file.write(bytes) == bytes.size()) {
+		file.commit();
+	}
+}
+
+class RegistryStore final : public QObject {
+public:
+	RegistryStore();
+	[[nodiscard]] std::optional<MadBadge> lookup(not_null<PeerData*> peer);
+	[[nodiscard]] QImage image(const MadBadge &badge, int size);
+	[[nodiscard]] bool assigned(const QString &target, const QString &id) const;
+	[[nodiscard]] std::optional<MadBadge> badge(const QString &id) const;
+	void fetch(Fn<void(QString)> done = nullptr);
+	void clear();
+	rpl::event_stream<> changes;
+	uint64 version = 1;
+
+private:
+	void notify();
+	void notifyLater();
+	void trim();
+	void request(const QUrl &url, const QByteArray &etag,
+		Fn<void(int, QByteArray, QByteArray, QByteArray)> done);
+	[[nodiscard]] bool enabled() const;
+	MadRegistry _registry;
+	QByteArray _etag;
+	QNetworkAccessManager _network;
+	QTimer _timer;
+	QSet<QNetworkReply*> _requests;
+	QSet<QString> _imagesInFlight;
+	QMap<QString, QImage> _images;
+	QMap<QString, qint64> _imageRetryAt;
+	QSet<QString> _targets;
+	std::vector<Fn<void(QString)>> _waiting;
+	bool _fetching = false;
+	bool _notifyScheduled = false;
+	uint64 _generation = 0;
+	rpl::lifetime _lifetime;
+
+};
+
+QPointer<RegistryStore> Store;
+
+RegistryStore::RegistryStore() : QObject(QCoreApplication::instance()) {
+	QDir().mkpath(CacheDirectory());
+	auto file = QFile(CacheDirectory() + u"registry.json"_q);
+	if (file.open(QIODevice::ReadOnly) && file.size() <= kMaxBytes) {
+		const auto bytes = file.readAll();
+		if (auto registry = Decode(bytes)) {
+			_registry = std::move(*registry);
+			auto tagFile = QFile(CacheDirectory() + u"registry.etag"_q);
+			if (tagFile.open(QIODevice::ReadOnly) && tagFile.size() <= 512) {
+				const auto record = tagFile.readAll().split('\n');
+				if (record.size() == 2 && record[0] == QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex()) {
+					_etag = record[1];
+				}
+			}
+		}
+	}
+	QObject::connect(&_timer, &QTimer::timeout, this, [=] {
+		notify();
+		fetch();
+	});
+	_timer.start(60000);
+	base::options::lookup<bool>(kOptionMadBadges).changes()
+		| rpl::on_next([=] {
+			++_generation;
+			const auto requests = _requests;
+			for (const auto reply : requests) {
+				reply->abort();
+			}
+			notify();
+			if (enabled()) {
+				fetch();
+			}
+		}, _lifetime);
+	QTimer::singleShot(0, this, [=] { notify(); trim(); fetch(); });
+}
+
+bool RegistryStore::enabled() const {
+	return MadBadgesEnabled() && !OfflineForLaunch() && !ServerOffForLaunch();
+}
+
+std::optional<MadBadge> RegistryStore::lookup(not_null<PeerData*> peer) {
+	if (!MadBadgesEnabled() || peer->session().isTestMode()) {
+		return std::nullopt;
+	}
+	return FindMadBadge(_registry, Target(peer), QDateTime::currentSecsSinceEpoch());
+}
+
+bool RegistryStore::assigned(const QString &target, const QString &id) const {
+	const auto value = FindMadBadge(_registry, target, QDateTime::currentSecsSinceEpoch());
+	return value && value->id == id;
+}
+
+std::optional<MadBadge> RegistryStore::badge(const QString &id) const {
+	const auto i = _registry.badges.constFind(id);
+	return i == _registry.badges.cend() ? std::nullopt : std::optional(*i);
+}
+
+void RegistryStore::request(const QUrl &url, const QByteArray &etag,
+		Fn<void(int, QByteArray, QByteArray, QByteArray)> done) {
+	if (!enabled()) {
+		done(0, {}, {}, {});
+		return;
+	}
+	auto request = QNetworkRequest(url);
+	request.setTransferTimeout(15000);
+	request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+	request.setAttribute(QNetworkRequest::CookieLoadControlAttribute, QNetworkRequest::Manual);
+	request.setAttribute(QNetworkRequest::CookieSaveControlAttribute, QNetworkRequest::Manual);
+	request.setRawHeader("User-Agent", "mad/1");
+	if (!etag.isEmpty()) {
+		request.setRawHeader("If-None-Match", etag);
+	}
+	const auto reply = _network.get(request);
+	_requests.insert(reply);
+	const auto buffer = std::make_shared<QByteArray>();
+	QObject::connect(reply, &QIODevice::readyRead, this, [=] {
+		buffer->append(reply->read(kMaxBytes + 1 - buffer->size()));
+		if (buffer->size() > kMaxBytes || reply->bytesAvailable()) {
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+		_requests.remove(reply);
+		buffer->append(reply->read(kMaxBytes + 1 - buffer->size()));
+		const auto status = reply->error() == QNetworkReply::NoError && buffer->size() <= kMaxBytes
+			? reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt() : 0;
+		done(status, *buffer, reply->rawHeader("ETag"), reply->rawHeader("Content-Type"));
+		reply->deleteLater();
+	});
+}
+
+void RegistryStore::fetch(Fn<void(QString)> done) {
+	if (done) {
+		_waiting.push_back(std::move(done));
+	}
+	if (_fetching) {
+		return;
+	}
+	_fetching = true;
+	const auto generation = _generation;
+	request(QUrl(u"https://b.mad.tg/api/v1/registry"_q), _etag,
+		[=](int status, QByteArray bytes, QByteArray etag, QByteArray) {
+			_fetching = false;
+			auto success = status == 304 && generation == _generation && _registry.generatedAt > 0;
+			if (status == 200 && generation == _generation) {
+				if (auto registry = Decode(bytes);
+					registry && registry->revision >= _registry.revision) {
+					const auto changed = registry->badges != _registry.badges
+						|| registry->assignments != _registry.assignments;
+					_registry = std::move(*registry);
+					_etag = etag.size() <= 256 ? etag : QByteArray();
+					WriteFile(CacheDirectory() + u"registry.json"_q, bytes);
+					WriteFile(CacheDirectory() + u"registry.etag"_q,
+						QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex() + '\n' + _etag);
+					success = true;
+					if (changed) {
+						notify();
+					}
+				}
+			}
+			auto waiting = std::exchange(_waiting, {});
+			for (const auto &callback : waiting) {
+				callback(success ? Tr(u"Badges updated"_q) : Tr(u"Could not update badges"_q));
+			}
+		});
+}
+
+void RegistryStore::notifyLater() {
+	if (std::exchange(_notifyScheduled, true)) {
+		return;
+	}
+	QTimer::singleShot(0, this, [=] {
+		_notifyScheduled = false;
+		notify();
+	});
+}
+
+void RegistryStore::notify() {
+	auto targets = std::exchange(_targets, {});
+	for (auto i = _registry.assignments.cbegin(); i != _registry.assignments.cend(); ++i) {
+		_targets.insert(i.key());
+		targets.insert(i.key());
+	}
+	++version;
+	changes.fire({});
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		const auto session = account->maybeSession();
+		if (!session || session->isTestMode()) {
+			continue;
+		}
+		for (const auto &target : targets) {
+			const auto parts = target.split(':');
+			const auto id = parts.back().toULongLong();
+			const auto peerId = parts.front() == u"user"_q ? peerFromUser(UserId(id))
+				: parts.front() == u"legacyGroup"_q ? peerFromChat(ChatId(id))
+				: peerFromChannel(ChannelId(id));
+			if (const auto peer = session->data().peerLoaded(peerId)) {
+				session->changes().peerUpdated(peer, Data::PeerUpdate::Flag::EmojiStatus
+					| Data::PeerUpdate::Flag::VerifyInfo | Data::PeerUpdate::Flag::Name);
+			}
+		}
+	}
+}
+
+QImage RegistryStore::image(const MadBadge &badge, int size) {
+	const auto hash = size == 128 ? badge.hash128 : badge.hash64;
+	const auto key = QString::fromLatin1(hash) + u"-%1.webp"_q.arg(size);
+	if (const auto i = _images.constFind(key); i != _images.cend()) {
+		return *i;
+	}
+	const auto path = CacheDirectory() + key;
+	auto cached = QFile(path);
+	if (cached.open(QIODevice::ReadOnly) && cached.size() <= kMaxBytes) {
+		const auto image = DecodeMadBadgeImage(cached.readAll(), hash, size);
+		if (!image.isNull()) {
+			_images.insert(key, image);
+			return image;
+		}
+		cached.close();
+		cached.remove();
+	}
+	if (!enabled() || _imagesInFlight.contains(key)
+		|| _imageRetryAt.value(key) > QDateTime::currentSecsSinceEpoch()) {
+		return {};
+	}
+	_imagesInFlight.insert(key);
+	const auto generation = _generation;
+	request(size == 128 ? badge.image128 : badge.image64, {},
+		[=](int status, QByteArray bytes, QByteArray, QByteArray contentType) {
+			_imagesInFlight.remove(key);
+			_imageRetryAt[key] = QDateTime::currentSecsSinceEpoch() + 60;
+			if (status != 200 || generation != _generation
+				|| contentType.split(';').front().trimmed().toLower() != "image/webp") {
+				return;
+			}
+			const auto image = DecodeMadBadgeImage(bytes, hash, size);
+			if (image.isNull()) {
+				return;
+			}
+			if (_images.size() > 256) {
+				_images.clear();
+			}
+			_images.insert(key, image);
+			WriteFile(path, bytes);
+			trim();
+			notifyLater();
+		});
+	return {};
+}
+
+void RegistryStore::trim() {
+	const auto files = QDir(CacheDirectory()).entryInfoList({ u"*.webp"_q }, QDir::Files, QDir::Time);
+	auto total = qint64(0);
+	for (const auto &file : files) {
+		total += file.size();
+		if (total > kCacheBytes) {
+			QFile::remove(file.absoluteFilePath());
+		}
+	}
+}
+
+void RegistryStore::clear() {
+	++_generation;
+	const auto requests = _requests;
+	for (const auto reply : requests) {
+		reply->abort();
+	}
+	notify();
+	_registry = {};
+	_etag.clear();
+	_images.clear();
+	_imageRetryAt.clear();
+	const auto directory = QDir(CacheDirectory());
+	for (const auto &file : directory.entryInfoList(QDir::Files)) {
+		QFile::remove(file.absoluteFilePath());
+	}
+	notify();
+}
+
+class BadgeClickHandler final : public LambdaClickHandler {
+public:
+	using LambdaClickHandler::LambdaClickHandler;
+};
+
+class BadgeObject final : public Ui::Text::CustomEmoji {
+public:
+	BadgeObject(QString target, QString id, not_null<Main::Session*> session, Fn<void()> repaint, int size)
+	: _target(std::move(target)), _id(std::move(id)), _session(session), _repaint(std::move(repaint)), _size(size) {
+		MadBadgesChanges() | rpl::on_next([=] { _repaint(); }, _lifetime);
+	}
+	int width() override { return _size; }
+	QString entityData() override { return Prefix() + _target + '/' + _id; }
+	Ui::Text::CustomEmojiSemantics semantics() override {
+		return { false, false, false, false, false };
+	}
+	void paint(QPainter &p, const Context &context) override {
+		const auto badge = Store && MadBadgesEnabled() ? Store->badge(_id) : std::nullopt;
+		if (!badge || _session->isTestMode() || !Store->assigned(_target, _id)) {
+			return;
+		}
+		if (badge->documentId) {
+			if (!_emoji || _documentId != badge->documentId) {
+				_documentId = badge->documentId;
+				_emoji = _session->data().customEmojiManager().create(
+					Data::SerializeCustomEmojiId(DocumentId(_documentId)), _repaint,
+					Data::CustomEmojiSizeTag::Normal, _size);
+			}
+			if (_emoji) {
+				_emoji->paint(p, context);
+			}
+		} else {
+			const auto image = Store->image(*badge, _size * style::DevicePixelRatio() > 64 ? 128 : 64);
+			p.drawImage(QRect(context.position, QSize(_size, _size)), image);
+		}
+	}
+	void unload() override { if (_emoji) _emoji->unload(); }
+	bool ready() override { return true; }
+	bool readyInDefaultState() override { return true; }
+
+private:
+	QString _target;
+	QString _id;
+	not_null<Main::Session*> _session;
+	Fn<void()> _repaint;
+	int _size = 0;
+	uint64 _documentId = 0;
+	std::unique_ptr<Ui::Text::CustomEmoji> _emoji;
+	rpl::lifetime _lifetime;
+
+};
+
+}
+
+QString MadBadgeData(not_null<PeerData*> peer, const QString &id) {
+	return Prefix() + Target(peer) + '/' + id;
+}
+
+void StartMadBadges() {
+	if (!Store) {
+		Store = new RegistryStore();
+	}
+}
+
+void RefreshMadBadges(Fn<void(QString)> done) {
+	StartMadBadges();
+	Store->fetch(std::move(done));
+}
+
+void ClearMadBadges() {
+	if (Store) Store->clear();
+}
+
+rpl::producer<> MadBadgesChanges() {
+	StartMadBadges();
+	return Store->changes.events();
+}
+
+std::optional<MadBadge> MadBadgeForPeer(not_null<PeerData*> peer) {
+	return Store ? Store->lookup(peer) : std::nullopt;
+}
+
+uint64 MadBadgesVersion() {
+	return Store ? Store->version : 0;
+}
+
+TextWithEntities WithMadBadge(not_null<PeerData*> peer, TextWithEntities name) {
+	if (const auto badge = MadBadgeForPeer(peer)) {
+		auto mark = Ui::Text::SingleCustomEmoji(MadBadgeData(peer, badge->id));
+		mark.entities.push_back({ EntityType::CustomUrl, 0, int(mark.text.size()), MadBadgeData(peer, badge->id) });
+		name.append(' ').append(std::move(mark));
+	}
+	return name;
+}
+
+std::unique_ptr<Ui::Text::CustomEmoji> MakeMadBadgeObject(
+		QStringView data, not_null<Main::Session*> session, Fn<void()> repaint, int size) {
+	if (!data.startsWith(Prefix()) || session->isTestMode()) {
+		return nullptr;
+	}
+	const auto value = data.mid(Prefix().size());
+	const auto slash = value.indexOf('/');
+	if (slash <= 0) return nullptr;
+	return std::make_unique<BadgeObject>(value.left(slash).toString(),
+		value.mid(slash + 1).toString(), session, std::move(repaint), size);
+}
+
+void ShowMadBadge(const MadBadge &badge) {
+	Ui::show(Box([badge](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(badge.title));
+		box->addRow(object_ptr<Ui::FlatLabel>(box, badge.description, st::boxLabel));
+		const auto url = QUrl(badge.link);
+		if (url.isValid() && (url.scheme() == u"https"_q || url.scheme() == u"tg"_q)) {
+			box->addButton(rpl::single(Tr(u"Open link"_q)), [=] {
+				QDesktopServices::openUrl(url);
+			});
+		}
+		box->addButton(rpl::single(Tr(u"Close"_q)), [=] { box->closeBox(); });
+	}));
+}
+
+Ui::RpWidget *CreateMadBadgeWidget(not_null<QWidget*> parent,
+		not_null<PeerData*> peer, int size) {
+	const auto button = Ui::CreateChild<Ui::AbstractButton>(parent.get());
+	struct State {
+		std::unique_ptr<Ui::Text::CustomEmoji> icon;
+	};
+	const auto state = button->lifetime().make_state<State>();
+	const auto refresh = [=] {
+		const auto badge = MadBadgeForPeer(peer);
+		button->resize(badge ? size : 0, size);
+		button->setVisible(badge.has_value());
+		state->icon = badge ? MakeMadBadgeObject(MadBadgeData(peer, badge->id),
+			&peer->session(), [=] { button->update(); }, size) : nullptr;
+		button->update();
+	};
+	button->paintRequest() | rpl::on_next([=] {
+		auto painter = QPainter(button);
+		if (state->icon) {
+			state->icon->paint(painter, {
+				.textColor = st::windowFg->c,
+				.now = crl::now(),
+				.position = QPoint(),
+				.paused = !button->isVisible(),
+			});
+		}
+	}, button->lifetime());
+	button->setClickedCallback([=] {
+		if (const auto badge = MadBadgeForPeer(peer)) ShowMadBadge(*badge);
+	});
+	MadBadgesChanges() | rpl::on_next(refresh, button->lifetime());
+	refresh();
+	return button;
+}
+
+std::shared_ptr<ClickHandler> MadBadgeTextLink(
+		const Ui::Text::String &text, QPoint point, int width, int lines) {
+	auto request = Ui::Text::StateRequestElided();
+	request.lines = lines;
+	const auto state = text.getStateElided(point, width, request);
+	return dynamic_cast<BadgeClickHandler*>(state.link.get()) ? state.link : nullptr;
+}
+
+std::shared_ptr<ClickHandler> MadBadgeLink(const EntityLinkData &data) {
+	if (data.type != EntityType::CustomUrl || !data.data.startsWith(Prefix())) {
+		return nullptr;
+	}
+	const auto value = data.data.mid(Prefix().size());
+	const auto slash = value.indexOf('/');
+	if (slash <= 0) return nullptr;
+	const auto target = value.left(slash);
+	const auto id = value.mid(slash + 1);
+	return std::make_shared<BadgeClickHandler>([=] {
+		if (Store && MadBadgesEnabled() && Store->assigned(target, id)) {
+			if (const auto badge = Store->badge(id)) ShowMadBadge(*badge);
+		}
+	});
+}
+
+}
