--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mad_badges.cpp
@@ -0,0 +1,537 @@
+#include "tele/tele_mad_badges.h"
+
+#include "base/options.h"
+#include "boxes/abstract_box.h"
