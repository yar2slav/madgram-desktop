diff --git a/Telegram/SourceFiles/tele/tests/mad_registry_tests.cpp b/Telegram/SourceFiles/tele/tests/mad_registry_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0b6edf4c4a0fe8451b9a530705cbdd32a00feef6
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tests/mad_registry_tests.cpp
@@ -0,0 +1,126 @@
+#include "tele/tele_mad_registry.h"
+
+#include <QtCore/QBuffer>
+#include <QtCore/QCoreApplication>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QFile>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <openssl/evp.h>
+#include <memory>
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+
+void Require(bool ok, const char *name) {
+	if (!ok) {
+		std::fprintf(stderr, "failed: %s\n", name);
+		std::exit(1);
+	}
+}
+
+QByteArray Encode(const QJsonObject &value) {
+	return QJsonDocument(value).toJson(QJsonDocument::Compact);
+}
+
+}
+
+int main(int argc, char **argv) {
+	const auto app = QCoreApplication(argc, argv);
+	const auto seed = QByteArray(32, char(7));
+	const auto key = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>(
+		EVP_PKEY_new_raw_private_key(EVP_PKEY_ED25519, nullptr,
+			reinterpret_cast<const unsigned char*>(seed.data()), seed.size()), EVP_PKEY_free);
+	Require(bool(key), "test signing key");
+	auto publicKey = QByteArray(32, '\0');
+	auto keySize = size_t(publicKey.size());
+	Require(EVP_PKEY_get_raw_public_key(key.get(),
+		reinterpret_cast<unsigned char*>(publicKey.data()), &keySize) == 1, "test public key");
+	const auto sign = [&](const QByteArray &payload) {
+		const auto ctx = std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)>(
+			EVP_MD_CTX_new(), EVP_MD_CTX_free);
+		Require(EVP_DigestSignInit(ctx.get(), nullptr, nullptr, nullptr, key.get()) == 1, "sign init");
+		auto signature = QByteArray(64, '\0');
+		auto size = size_t(signature.size());
+		Require(EVP_DigestSign(ctx.get(), reinterpret_cast<unsigned char*>(signature.data()), &size,
+			reinterpret_cast<const unsigned char*>(payload.data()), payload.size()) == 1, "sign");
+		return QJsonObject{
+			{ "schemaVersion", 1 }, { "keyId", "test" },
+			{ "payload", QString::fromLatin1(payload.toBase64()) },
+			{ "signature", QString::fromLatin1(signature.toBase64()) },
+		};
+	};
+	const auto decode = [&](const QJsonObject &envelope) {
+		return Tele::DecodeMadRegistry(Encode(envelope), publicKey, QStringLiteral("test"));
+	};
+	const auto large = qint64(9007199254740993LL);
+	auto payload = QJsonObject{
+		{ "revision", 1 }, { "generatedAt", 1700000000 },
+		{ "badges", QJsonArray{ QJsonObject{
+			{ "id", "sample" }, { "title", "sample" },
+			{ "media", QJsonObject{ { "kind", "customEmoji" }, { "documentId", large } } },
+		} } },
+		{ "assignments", QJsonArray{
+			QJsonObject{ { "peerType", "user" }, { "peerId", large }, { "badgeId", "sample" } },
+			QJsonObject{ { "peerType", "legacyGroup" }, { "peerId", large }, { "badgeId", "sample" } },
+			QJsonObject{ { "peerType", "channel" }, { "peerId", large }, { "badgeId", "sample" }, { "expiresAt", 1700000010 } },
+		} },
+	};
+	const auto envelope = sign(Encode(payload));
+	const auto parsed = decode(envelope);
+	Require(parsed.has_value(), "valid signature");
+	Require(parsed->badges.value(QStringLiteral("sample")).documentId == quint64(large), "64 bit document id");
+	Require(parsed->assignments.contains(QStringLiteral("user:9007199254740993")), "64 bit peer id");
+	Require(parsed->assignments.size() == 3, "separate peer namespaces");
+	Require(parsed->assignments.value(QStringLiteral("channel:9007199254740993")).expiresAt == 1700000010, "expiry preserved");
+	Require(Tele::FindMadBadge(*parsed, QStringLiteral("channel:9007199254740993"), 1700000009).has_value(), "before expiry");
+	Require(!Tele::FindMadBadge(*parsed, QStringLiteral("channel:9007199254740993"), 1700000010), "at expiry");
+	Require(!Tele::FindMadBadge(*parsed, QStringLiteral("user:123"), 1700000000), "unassigned peer");
+	auto changed = envelope;
+	changed["payload"] = QString::fromLatin1((Encode(payload) + ' ').toBase64());
+	Require(!decode(changed), "signature covers original bytes");
+	changed = envelope;
+	changed["schemaVersion"] = 2;
+	Require(!decode(changed), "unknown schema");
+	changed = envelope;
+	changed["keyId"] = "unknown";
+	Require(!decode(changed), "unknown key");
+	Require(!Tele::DecodeMadRegistry(Encode(envelope), QByteArray(32, char(8)), QStringLiteral("test")), "wrong key");
+	changed = envelope;
+	changed["signature"] = "invalid";
+	Require(!decode(changed), "malformed signature");
+	Require(!Tele::DecodeMadRegistry(QByteArray(2 * 1024 * 1024 + 1, 'x'), publicKey, QStringLiteral("test")), "response bound");
+	for (const auto url : { "http://b.mad.tg/assets/x", "https://evil.test/assets/x", "https://b.mad.tg@evil.test/assets/x", "https://b.mad.tg/api/x", "https://b.mad.tg/assets/../x", "https://b.mad.tg/assets/x?redirect=evil", "https://b.mad.tg:444/assets/x" }) {
+		Require(!Tele::MadAssetUrlAllowed(QUrl(QString::fromLatin1(url))), "unsafe asset url");
+	}
+	Require(Tele::MadAssetUrlAllowed(QUrl(QStringLiteral("https://b.mad.tg/assets/example.webp"))), "safe asset url");
+	changed = payload;
+	changed["assignments"] = QJsonArray{ QJsonObject{ { "peerType", "user" }, { "peerId", 1.5 }, { "badgeId", "sample" } } };
+	Require(!decode(sign(Encode(changed))), "fractional peer id");
+	changed = payload;
+	changed["assignments"] = QJsonArray{ QJsonObject{ { "peerType", "user" }, { "peerId", 1 }, { "badgeId", "missing" } } };
+	Require(!decode(sign(Encode(changed))), "unknown badge assignment");
+	changed["assignments"] = QJsonArray();
+	Require(decode(sign(Encode(changed)))->assignments.isEmpty(), "revoked registry accepted");
+	auto picture = QImage(64, 64, QImage::Format_ARGB32);
+	picture.fill(Qt::red);
+	auto imageBytes = QByteArray();
+	auto buffer = QBuffer(&imageBytes);
+	buffer.open(QIODevice::WriteOnly);
+	Require(picture.save(&buffer, "WEBP"), "webp encoder");
+	const auto hash = QCryptographicHash::hash(imageBytes, QCryptographicHash::Sha256).toHex();
+	Require(!Tele::DecodeMadBadgeImage(imageBytes, hash, 64).isNull(), "valid image");
+	Require(Tele::DecodeMadBadgeImage(imageBytes + 'x', hash, 64).isNull(), "tampered image");
+	Require(Tele::DecodeMadBadgeImage(imageBytes, hash, 128).isNull(), "wrong image dimensions");
+	if (argc > 1) {
+		auto fixture = QFile(QString::fromLocal8Bit(argv[1]));
+		Require(fixture.open(QIODevice::ReadOnly), "production fixture");
+		Require(Tele::DecodeMadRegistry(fixture.readAll(),
+			QByteArray::fromBase64("fu30bgNFntwaeXWD3dyTuMgWKM12eGKgqwRbgl/Soy0="),
+			QStringLiteral("mad-badges-1")).has_value(), "production signature and schema");
+	}
+	std::puts("mad registry tests passed");
+	return 0;
+}
