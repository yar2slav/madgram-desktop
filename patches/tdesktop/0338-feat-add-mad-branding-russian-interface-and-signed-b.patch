 int PeerBadge::drawGetWidth(Painter &p, Descriptor &&descriptor) {
+	const auto badge = Tele::MadBadgeForPeer(descriptor.peer);
+	_madRect = {};
+	if (!badge) {
+		_madBadge = nullptr;
+		_madIcon = nullptr;
+		_madPeer = nullptr;
+		return drawTelegramBadges(p, std::move(descriptor));
+	}
+	const auto size = descriptor.rectForName.height();
+	const auto skip = st::semiboldFont->spacew;
+	const auto available = descriptor.rectForName.width();
+	if (available < size + skip) {
+		return drawTelegramBadges(p, std::move(descriptor));
+	}
+	if (!_madBadge || *_madBadge != *badge || _madPeer != descriptor.peer
+		|| !_madIcon || _madIcon->width() != size) {
+		_madBadge = std::make_unique<Tele::MadBadge>(*badge);
+		_madPeer = descriptor.peer;
+		_madIcon = Tele::MakeMadBadgeObject(Tele::MadBadgeData(descriptor.peer, badge->id),
+			&descriptor.peer->session(), descriptor.customEmojiRepaint, size);
+	}
+	descriptor.rectForName.setWidth(available - size - skip);
+	const auto x = descriptor.rectForName.x()
+		+ std::min(descriptor.nameWidth, descriptor.rectForName.width());
+	const auto remaining = descriptor.rectForName.width()
+		- std::min(descriptor.nameWidth, descriptor.rectForName.width());
+	auto nested = descriptor;
+	const auto otherWidth = drawTelegramBadges(p, std::move(nested));
+	const auto left = x + std::min(remaining, otherWidth) + skip;
+	_madRect = style::rtlrect(left, descriptor.rectForName.y(), size, size, descriptor.outerWidth);
+	if (_madIcon) {
+		_madIcon->paint(p, {
+			.textColor = p.pen().color(),
+			.now = descriptor.now,
+			.position = _madRect.topLeft(),
+			.paused = descriptor.paused,
+		});
+	}
+	return otherWidth + size + skip;
+}
+
+QRect PeerBadge::madBadgeRect() const {
+	return _madRect;
+}
+
+void PeerBadge::showMadBadge() const {
+	if (_madPeer) {
+		if (const auto badge = Tele::MadBadgeForPeer(_madPeer)) {
+			Tele::ShowMadBadge(*badge);
+		}
+	}
+}
