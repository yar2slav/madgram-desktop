diff --git a/Telegram/SourceFiles/tele/tests/mad_links_tests.cpp b/Telegram/SourceFiles/tele/tests/mad_links_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f3a2f35e341de27dc6ac6acc392cfe99158efbef
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tests/mad_links_tests.cpp
@@ -0,0 +1,74 @@
+#include "tele/tele_mad_links.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QStringList>
+#include <cstdio>
+#include <cstdlib>
+#include <utility>
+#include <vector>
+
+namespace {
+
+using namespace Qt::StringLiterals;
+
+void Require(bool condition, const char *name) {
+	if (!condition) {
+		std::fprintf(stderr, "failed: %s\n", name);
+		std::exit(1);
+	}
+}
+
+}
+
+int main(int argc, char *argv[]) {
+	QCoreApplication app(argc, argv);
+	using namespace Qt::StringLiterals;
+	const auto cases = std::vector<std::pair<QString, QString>>{
+		{ u"mad://settings"_s, u"tg://settings/tele"_s },
+		{ u" MAD://SETTINGS/PRIVACY/ "_s, u"tg://settings/tele/privacy"_s },
+		{ u"mad://settings/privacy?highlight=tele-ghost"_s, u"tg://settings/tele/privacy?highlight=tele-ghost"_s },
+		{ u"mad://settings/privacy#tele-ghost"_s, u"tg://settings/tele/privacy?highlight=tele-ghost"_s },
+		{ u"mad://ghost"_s, u"tg://settings/tele/privacy?highlight=tele-ghost"_s },
+		{ u"mad://streamer"_s, u"tg://settings/tele/privacy?highlight=tele-streamer-mode"_s },
+		{ u"mad://sync"_s, u"tg://settings/tele/server?highlight=tele-history-sync-accounts"_s },
+		{ u"mad://settings?highlight=tele%2Ftest"_s, u"tg://settings/tele?highlight=tele%2Ftest"_s },
+	};
+	for (const auto &[input, output] : cases) {
+		Require(Tele::LocalMadLink(input) == output, "route");
+		const auto publicLink = Tele::PublicMadLink(output);
+		Require(publicLink.startsWith(u"mad://settings"_s), "public scheme");
+		Require(Tele::LocalMadLink(publicLink) == output, "round trip");
+	}
+	for (const auto &category : QStringList{
+		u""_s, u"badges"_s, u"server"_s, u"backup"_s, u"interface"_s,
+		u"chats"_s, u"messages"_s, u"sending"_s, u"notifications"_s,
+		u"menus"_s, u"privacy"_s, u"profiles"_s, u"bots"_s, u"debug"_s, u"new"_s,
+	}) {
+		Require(!Tele::LocalMadLink(Tele::MadSettingsLink(category)).isEmpty(), "category");
+	}
+	for (const auto &input : QStringList{
+		u"https://settings/privacy"_s, u"tg://settings/tele"_s,
+		u"mad://settings.evil/privacy"_s, u"mad://user@settings/privacy"_s,
+		u"mad://@settings/privacy"_s, u"mad://settings:443/privacy"_s,
+		u"mad://settings/../privacy"_s, u"mad://settings/privacy/extra"_s,
+		u"mad://resolve?domain=example"_s, u"mad://settings/privacy?enabled=1"_s,
+		u"mad://settings/privacy?highlight=one&highlight=two"_s,
+		u"mad://settings/privacy?highlight=one#two"_s,
+		u"mad://settings/privacy?highlight=%ZZ"_s,
+		u"mad://settings/privacy?highlight=test%0A"_s,
+		u"mad://settings/privacy?highlight=%22%20-workdir"_s,
+		u"mad://ghost?enabled=1"_s, u"mad://sync/anything"_s,
+		u"mad://settings/unknown"_s, u"mad:settings/privacy"_s,
+		u"mad://settings?highlight="_s + QString(161, 'a'),
+		u"mad://settings?"_s + QString(2048, 'a'),
+	}) {
+		Require(Tele::LocalMadLink(input).isEmpty(), "reject unsupported input");
+	}
+	Require(Tele::IsMadLink(u"mad:invalid"_s), "consume invalid mad scheme");
+	Require(!Tele::IsMadLink(u"madness://settings"_s), "preserve unrelated scheme");
+	Require(Tele::PublicMadLink(u"tg://settings/privacy"_s) == u"tg://settings/privacy"_s, "preserve official settings link");
+	Require(Tele::PublicMadLink(u"https://t.me/maadgram"_s) == u"https://t.me/maadgram"_s, "preserve web link");
+	Require(Tele::MadSettingsLink(u"bad/path"_s).isEmpty(), "reject invalid generated category");
+	Require(Tele::MadSettingsLink(u"privacy"_s, u"unsafe&action=1"_s).isEmpty(), "reject invalid generated control");
+	std::puts("mad links tests passed");
+}
