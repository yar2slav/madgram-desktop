diff --git a/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp b/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1e5abcfead3d4085988b60ba7ef83a54158d34e8
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp
@@ -0,0 +1,116 @@
+#include "tele/tele_mad_links.h"
+
+#include <QtCore/QRegularExpression>
+#include <QtCore/QStringList>
+#include <QtCore/QUrl>
+#include <QtCore/QUrlQuery>
+
+namespace Tele {
+namespace {
+
+using namespace Qt::StringLiterals;
+
+bool ValidControl(const QString &control) {
+	static const auto pattern = QRegularExpression(
+		QRegularExpression::anchoredPattern(u"[a-zA-Z0-9][a-zA-Z0-9._/-]{0,159}"_s));
+	return control.isEmpty() || pattern.match(control).hasMatch();
+}
+
+bool ValidCategory(const QString &category) {
+	static const auto categories = QStringList{
+		u""_s, u"badges"_s, u"server"_s, u"backup"_s,
+		u"interface"_s, u"chats"_s, u"messages"_s, u"sending"_s,
+		u"notifications"_s, u"menus"_s, u"privacy"_s,
+		u"profiles"_s, u"bots"_s, u"debug"_s, u"new"_s,
+	};
+	return categories.contains(category);
+}
+
+QString Query(const QString &control) {
+	return control.isEmpty() ? QString()
+		: u"?highlight="_s + QString::fromLatin1(QUrl::toPercentEncoding(control));
+}
+
+}
+
+bool IsMadLink(const QString &url) {
+	return url.trimmed().startsWith(u"mad:"_s, Qt::CaseInsensitive);
+}
+
+QString LocalMadLink(const QString &value) {
+	const auto input = value.trimmed();
+	if (input.size() > 2048 || !IsMadLink(input)) {
+		return {};
+	}
+	const auto url = QUrl(input, QUrl::StrictMode);
+	if (!url.isValid() || url.userInfo().size() || url.port() != -1
+		|| url.authority().contains('@') || url.authority().contains(':')) {
+		return {};
+	}
+	auto category = url.path().toLower();
+	if (category.startsWith('/')) {
+		category.remove(0, 1);
+	}
+	if (category.endsWith('/')) {
+		category.chop(1);
+	}
+	auto control = QString();
+	const auto params = QUrlQuery(url).queryItems(QUrl::FullyDecoded);
+	if (params.size() > 1 || (!params.empty() && params.front().first != u"highlight"_s)) {
+		return {};
+	}
+	if (!params.empty()) {
+		control = params.front().second;
+	}
+	if (url.hasFragment()) {
+		if (url.hasQuery()) {
+			return {};
+		}
+		control = url.fragment(QUrl::FullyDecoded);
+	}
+	const auto host = url.host().toLower();
+	if (host == u"ghost"_s || host == u"streamer"_s || host == u"sync"_s) {
+		if (!category.isEmpty() || url.hasQuery() || url.hasFragment()) {
+			return {};
+		}
+		category = (host == u"sync"_s) ? u"server"_s : u"privacy"_s;
+		control = (host == u"ghost"_s) ? u"tele-ghost"_s
+			: (host == u"streamer"_s) ? u"tele-streamer-mode"_s
+			: u"tele-history-sync-accounts"_s;
+	} else if (host != u"settings"_s) {
+		return {};
+	}
+	if (!ValidCategory(category) || !ValidControl(control)) {
+		return {};
+	}
+	return u"tg://settings/tele"_s
+		+ (category.isEmpty() ? QString() : '/' + category)
+		+ Query(control);
+}
+
+QString MadSettingsLink(const QString &category, const QString &control) {
+	if (!ValidCategory(category) || !ValidControl(control)) {
+		return {};
+	}
+	return u"mad://settings"_s
+		+ (category.isEmpty() ? QString() : '/' + category)
+		+ Query(control);
+}
+
+QString PublicMadLink(const QString &value) {
+	const auto url = QUrl(value, QUrl::StrictMode);
+	if (url.scheme() != u"tg"_s || url.host() != u"settings"_s) {
+		return value;
+	}
+	const auto path = url.path();
+	if (path != u"/tele"_s && path != u"/mad"_s && !path.startsWith(u"/tele/"_s)) {
+		return value;
+	}
+	auto result = QUrl(url);
+	result.setScheme(u"mad"_s);
+	result.setPath(path.startsWith(u"/tele/"_s) ? path.mid(5) : QString());
+	const auto candidate = result.toString(QUrl::FullyEncoded);
+	return LocalMadLink(candidate).isEmpty() ? value : candidate;
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_mad_links.cpp b/Telegram/SourceFiles/tele/tele_mad_links.cpp
