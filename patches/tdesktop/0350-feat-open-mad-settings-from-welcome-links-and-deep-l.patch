--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_mad_links.cpp
@@ -0,0 +1,51 @@
+#include "tele/tele_mad_links.h"
+
+#include "base/options.h"
+#include "base/platform/base_platform_url_scheme.h"
+#include "core/application.h"
+#include "core/click_handler_types.h"
+#include "tele/tele_lowercase.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+#include <QtCore/QCoreApplication>
+#include <QtCore/QDir>
+
+namespace Tele {
+
+bool OpenMadLink(const QString &url, const QVariant &context) {
+	const auto local = LocalMadLink(url);
+	if (!local.isEmpty()) {
+		return Core::App().openLocalUrl(local, context);
+	}
+	const auto clicked = context.value<ClickHandlerContext>().sessionWindow.get();
+	const auto window = Core::App().activeWindow();
+	const auto controller = clicked ? clicked
+		: window ? window->sessionController() : nullptr;
+	if (controller && !Core::App().passcodeLocked()) {
+		controller->showToast(Tr(u"This mad link is invalid or unsupported."_q));
+	}
+	return true;
+}
+
+void RegisterMadUrlScheme() {
+#ifdef Q_OS_WIN
+	if (base::options::lookup<bool>(Core::kOptionSkipUrlSchemeRegister).value()) {
+		return;
+	}
+	const auto descriptor = base::Platform::UrlSchemeDescriptor{
+		.executable = QCoreApplication::applicationFilePath(),
+		.arguments = u"-workdir \"%1\""_q.arg(QDir::cleanPath(cWorkingDir())),
+		.protocol = u"mad"_q,
+		.protocolName = u"mad link"_q,
+		.shortAppName = u"mad"_q,
+		.longAppName = u"mad"_q,
+		.displayAppName = u"mad"_q,
+		.displayAppDescription = u"mad desktop"_q,
+	};
+	if (!base::Platform::CheckUrlScheme(descriptor)) {
+		base::Platform::RegisterUrlScheme(descriptor);
+	}
+#endif
+}
+
+}
