+[[nodiscard]] AppLinkChoice ParseChoice(const QString &value) {
+	if (value == u"official"_q) {
+		return { .mode = AppLinkMode::Default };
+	} else if (value.startsWith(u"alt:"_q) && value.size() > 4) {
+		return { .mode = AppLinkMode::App, .app = value.mid(4) };
+	} else if (value.startsWith(u"custom:"_q)) {
+		const auto rest = value.mid(7);
+		const auto separator = rest.indexOf('|');
+		const auto path = (separator < 0) ? rest : rest.left(separator);
+		if (!path.isEmpty()) {
+			return {
+				.mode = AppLinkMode::Custom,
+				.path = path,
+				.command = (separator < 0) ? QString() : rest.mid(separator + 1),
+			};
+		}
+	}
+	return {};
+}
+
+[[nodiscard]] QString SerializeChoice(const AppLinkChoice &choice) {
+	switch (choice.mode) {
+	case AppLinkMode::Default: return u"official"_q;
+	case AppLinkMode::App: return u"alt:"_q + choice.app;
+	case AppLinkMode::Custom:
+		return u"custom:"_q + choice.path + '|' + choice.command;
+	case AppLinkMode::Browser: break;
+	}
+	return QString();
+}
