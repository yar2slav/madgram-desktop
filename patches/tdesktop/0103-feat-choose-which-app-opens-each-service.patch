+[[nodiscard]] QString ReadString(
+		HKEY root,
+		const QString &path,
+		const QString &name) {
+	const auto key = path.toStdWString();
+	const auto value = name.toStdWString();
+	const auto valuePtr = name.isEmpty() ? nullptr : value.c_str();
+	auto size = DWORD(512 * sizeof(wchar_t));
+	for (auto attempt = 0; attempt != 3; ++attempt) {
+		auto buffer = std::wstring(size / sizeof(wchar_t) + 1, L'\0');
+		size = DWORD(buffer.size() * sizeof(wchar_t));
+		const auto status = RegGetValueW(
+			root,
+			key.c_str(),
+			valuePtr,
+			RRF_RT_REG_SZ,
+			nullptr,
+			buffer.data(),
+			&size);
+		if (status == ERROR_SUCCESS) {
+			return QString::fromWCharArray(buffer.c_str());
+		} else if (status != ERROR_MORE_DATA) {
+			break;
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] QStringList ValueNames(HKEY root, const QString &path) {
+	const auto wide = path.toStdWString();
+	auto key = HKEY();
+	if (RegOpenKeyExW(root, wide.c_str(), 0, KEY_READ, &key)
+		!= ERROR_SUCCESS) {
+		return {};
+	}
+	auto result = QStringList();
+	auto name = std::array<WCHAR, 16384>();
+	for (auto index = DWORD(); ; ++index) {
+		auto length = DWORD(name.size());
+		const auto status = RegEnumValueW(
+			key,
+			index,
+			name.data(),
+			&length,
+			nullptr,
+			nullptr,
+			nullptr,
+			nullptr);
+		if (status == ERROR_NO_MORE_ITEMS) {
+			break;
+		} else if (status == ERROR_SUCCESS) {
+			result.push_back(QString::fromWCharArray(name.data(), length));
+		}
+	}
+	RegCloseKey(key);
+	return result;
+}
+
+[[nodiscard]] QString IndirectString(const QString &value) {
+	if (!value.startsWith('@')) {
+		return value;
+	}
+	const auto wide = value.toStdWString();
+	auto buffer = std::array<WCHAR, 1024>();
+	return SUCCEEDED(SHLoadIndirectString(
+		wide.c_str(),
+		buffer.data(),
+		UINT(buffer.size()),
+		nullptr))
+		? QString::fromWCharArray(buffer.data())
+		: QString();
+}
+
+[[nodiscard]] QStringList SplitCommand(const QString &command) {
+	if (command.trimmed().isEmpty()) {
+		return {};
+	}
+	const auto wide = command.toStdWString();
+	auto count = 0;
+	const auto list = CommandLineToArgvW(wide.c_str(), &count);
+	if (!list) {
+		return {};
+	}
+	auto result = QStringList();
+	for (auto i = 0; i != count; ++i) {
+		result.push_back(QString::fromWCharArray(list[i]));
+	}
+	LocalFree(list);
+	return result;
+}
+
+[[nodiscard]] QString NormalizedPath(const QString &path) {
+	return QDir::cleanPath(QDir::fromNativeSeparators(path)).toLower();
+}
+
+[[nodiscard]] std::vector<Candidate> Candidates(
+		const AppLinkService &service) {
+	auto result = std::vector<Candidate>();
+	const auto known = [&](const QString &program) {
+		const auto normalized = NormalizedPath(program);
+		return ranges::any_of(result, [&](const Candidate &candidate) {
+			return NormalizedPath(candidate.program) == normalized;
+		});
+	};
+	for (const auto &app : KnownApps()) {
+		if (app.service != service.id) {
+			continue;
+		}
+		const auto program = KnownProgram(app);
+		if (!program.isEmpty()) {
+			result.push_back({
+				.handler = { .id = app.id, .name = app.name },
+				.program = program,
+				.arguments = app.arguments,
+			});
+		}
+	}
+	const auto roots = std::array<std::pair<HKEY, QString>, 3>{ {
+		{ HKEY_CURRENT_USER, u"Software\\RegisteredApplications"_q },
+		{ HKEY_LOCAL_MACHINE, u"Software\\RegisteredApplications"_q },
+		{
+			HKEY_LOCAL_MACHINE,
+			u"Software\\WOW6432Node\\RegisteredApplications"_q,
+		},
+	} };
+	for (const auto &[root, path] : roots) {
+		for (const auto &name : ValueNames(root, path)) {
+			const auto capabilities = ReadString(root, path, name);
+			if (capabilities.isEmpty()
+				|| ranges::contains(
+					result,
+					name,
+					[](const Candidate &c) { return c.handler.id; })) {
+				continue;
+			}
+			const auto progId = ReadString(
+				root,
+				capabilities + u"\\URLAssociations"_q,
+				service.scheme);
+			if (progId.isEmpty()) {
+				continue;
+			}
+			auto command = SplitCommand(ReadString(
+				HKEY_CLASSES_ROOT,
+				progId + u"\\shell\\open\\command"_q,
+				QString()));
+			if (command.isEmpty() || known(command.front())) {
+				continue;
+			}
+			const auto title = IndirectString(ReadString(
+				root,
+				capabilities,
+				u"ApplicationName"_q));
+			const auto program = command.takeFirst();
+			result.push_back({
+				.handler = {
+					.id = name,
+					.name = title.isEmpty() ? name : title,
+				},
+				.program = program,
+				.arguments = command,
+			});
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QStringList WithUri(QStringList arguments, const QString &uri) {
+	auto found = false;
+	for (auto &argument : arguments) {
+		for (const auto &token : { u"%1"_q, u"%l"_q, u"%L"_q }) {
+			if (argument.contains(token)) {
+				argument.replace(token, uri);
+				found = true;
+			}
+		}
+	}
+	if (!found) {
+		arguments.push_back(uri);
+	}
+	return arguments;
+}
