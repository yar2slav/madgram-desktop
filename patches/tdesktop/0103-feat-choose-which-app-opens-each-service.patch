+template <typename Callback>
+void ForEachApp(const QString &scheme, Callback &&callback) {
+	const auto type = (u"x-scheme-handler/"_q + scheme).toUtf8();
+	const auto list = g_app_info_get_all_for_type(type.constData());
+	for (auto i = list; i; i = i->next) {
+		const auto info = static_cast<GAppInfo*>(i->data);
+		const auto id = g_app_info_get_id(info);
+		if (id && callback(QString::fromUtf8(id), info)) {
+			break;
+		}
+	}
+	g_list_free_full(list, g_object_unref);
+}
