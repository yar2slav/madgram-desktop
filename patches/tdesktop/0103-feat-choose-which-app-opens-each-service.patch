+[[nodiscard]] QString Fill(
+		const QString &part,
+		const QString &app,
+		const QString &url,
+		const QString &uri) {
+	const auto values = std::array<std::pair<QString, QString>, 3>{ {
+		{ u"{app}"_q, app },
+		{ u"{url}"_q, url },
+		{ u"{uri}"_q, uri },
+	} };
+	auto result = QString();
+	auto i = 0;
+	while (i < part.size()) {
+		const auto rest = QStringView(part).mid(i);
+		const auto j = ranges::find_if(values, [&](const auto &value) {
+			return rest.startsWith(value.first);
+		});
+		if (j != end(values)) {
+			result += j->second;
+			i += j->first.size();
+		} else {
+			result += part[i++];
+		}
+	}
+	return result;
+}
+
+bool StartProcess(const QString &program, const QStringList &arguments) {
+	const auto info = QFileInfo(program);
+	return QProcess::startDetached(
+		program,
+		arguments,
+		info.isAbsolute() ? info.absolutePath() : QString());
+}
+
+[[nodiscard]] bool LaunchCustom(
+		const AppLinkChoice &choice,
+		const QString &url,
+		const QString &uri) {
+	const auto command = choice.command.trimmed().isEmpty()
+		? AppLinkDefaultCommand()
+		: choice.command;
+	auto parts = QProcess::splitCommand(command);
+	if (parts.isEmpty()) {
+		return false;
+	}
+	for (auto &part : parts) {
+		part = Fill(part, choice.path, url, uri);
+	}
+	const auto program = parts.takeFirst();
+	return !program.isEmpty() && StartProcess(program, parts);
+}
