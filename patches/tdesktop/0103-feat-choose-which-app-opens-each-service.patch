+[[nodiscard]] std::vector<AppLinkHandler> Handlers(
+		const AppLinkService &service) {
+	const auto candidates = Candidates(service);
+	return candidates
+		| ranges::views::transform(&Candidate::handler)
+		| ranges::to_vector;
+}
