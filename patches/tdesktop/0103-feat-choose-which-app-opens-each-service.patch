+[[nodiscard]] bool LaunchApp(
+		const AppLinkService &service,
+		const QString &id,
+		const QString &uri) {
+	const auto candidates = Candidates(service);
+	const auto i = ranges::find(
+		candidates,
+		id,
+		[](const Candidate &c) { return c.handler.id; });
+	return (i != end(candidates))
+		&& StartProcess(i->program, WithUri(i->arguments, uri));
+}
