+#include "tele/tele_app_links_box.h"
+
+#include "core/file_utilities.h"
+#include "lang/lang_keys.h"
+#include "settings/settings_common.h"
+#include "tele/tele_app_links.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/layers/show.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/slide_wrap.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_settings.h"
+#include "styles/style_widgets.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFileInfo>
+
+namespace Tele {
+namespace {
+
+struct Entry {
+	AppLinkChoice choice;
+	QString label;
+};
+
+[[nodiscard]] bool Same(const AppLinkChoice &a, const AppLinkChoice &b) {
+	return (a.mode == b.mode)
+		&& (a.mode != AppLinkMode::App || a.app == b.app);
+}
+
+[[nodiscard]] std::vector<Entry> Entries(
+		const AppLinkService &service,
+		const AppLinkChoice &current) {
+	auto result = std::vector<Entry>();
+	result.push_back({ .label = Lower(u"Browser"_q) });
+	if (current.mode == AppLinkMode::Default
+		|| AppLinkHasDefault(service.scheme)) {
+		const auto name = AppLinkDefaultName(service.scheme);
+		result.push_back({
+			.choice = { .mode = AppLinkMode::Default },
+			.label = Lower(name.isEmpty()
+				? u"Default app"_q
+				: u"Default app (%1)"_q.arg(name)),
+		});
+	}
+	for (const auto &handler : AppLinkHandlers(service)) {
+		result.push_back({
+			.choice = { .mode = AppLinkMode::App, .app = handler.id },
+			.label = Lower(handler.name),
+		});
+	}
+	if (current.mode == AppLinkMode::App
+		&& !ranges::any_of(result, [&](const Entry &entry) {
+			return Same(entry.choice, current);
+		})) {
+		result.push_back({
+			.choice = current,
+			.label = Lower(current.app + u", not found"_q),
+		});
+	}
+	result.push_back({
+		.choice = { .mode = AppLinkMode::Custom },
+		.label = Lower(u"Custom app"_q),
+	});
+	return result;
+}
+
+void ServiceBox(not_null<Ui::GenericBox*> box, AppLinkService service) {
+	const auto current = AppLinkChoiceFor(service.id);
+	const auto entries = Entries(service, current);
+	const auto customIndex = int(entries.size()) - 1;
+	const auto initial = [&] {
+		for (auto i = 0; i != int(entries.size()); ++i) {
+			if (Same(entries[i].choice, current)) {
+				return i;
+			}
+		}
+		return 0;
+	}();
+
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(service.name)));
+	const auto group = std::make_shared<Ui::RadiobuttonGroup>(initial);
+	for (auto i = 0; i != int(entries.size()); ++i) {
+		box->addRow(object_ptr<Ui::Radiobutton>(
+			box,
+			group,
+			i,
+			entries[i].label,
+			st::defaultBoxCheckbox));
+		Ui::AddSkip(box->verticalLayout());
+	}
+
+	const auto custom = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			box,
+			object_ptr<Ui::VerticalLayout>(box)),
+		style::margins());
+	const auto inner = custom->entity();
+	const auto path = box->lifetime().make_state<rpl::variable<QString>>(
+		current.path);
+	const auto choose = [=] {
+#ifdef Q_OS_WIN
+		const auto filter = u"Programs (*.exe);;"_q
+			+ FileDialog::AllFilesFilter();
+#else
+		const auto filter = FileDialog::AllFilesFilter();
+#endif
+		FileDialog::GetOpenPath(
+			box.get(),
+			Lower(u"Choose an app"_q),
+			filter,
+			crl::guard(box, [=](FileDialog::OpenResult &&result) {
+				if (!result.paths.isEmpty()) {
+					*path = QDir::toNativeSeparators(result.paths.front());
+				}
+			}));
+	};
+	Settings::AddButtonWithLabel(
+		inner,
+		rpl::single(Lower(u"App"_q)),
+		path->value() | rpl::map([](const QString &value) {
+			return value.isEmpty()
+				? Lower(u"Choose"_q)
+				: QFileInfo(value).fileName();
+		}),
+		st::settingsButtonNoIcon
+	)->setClickedCallback(choose);
+	Ui::AddSkip(inner);
+	const auto command = inner->add(
+		object_ptr<Ui::InputField>(
+			inner,
+			st::defaultInputField,
+			rpl::single(Lower(u"Command"_q)),
+			current.command.isEmpty()
+				? AppLinkDefaultCommand()
+				: current.command),
+		st::boxRowPadding);
+	Ui::AddSkip(inner);
+	inner->add(
+		object_ptr<Ui::FlatLabel>(
+			inner,
+			Lower(u"{app} is the chosen program, {url} the original link "
+				"and {uri} the app link, like spotify:track:… for "
+				"Spotify. The first word is what runs, quote paths with "
+				"spaces."_q),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	Ui::AddSkip(inner);
+
+	custom->toggle(initial == customIndex, anim::type::instant);
+	group->setChangedCallback([=](int value) {
+		custom->toggle(value == customIndex, anim::type::normal);
+		if (value == customIndex && path->current().isEmpty()) {
+			choose();
+		}
+	});
+
+	const auto save = [=] {
+		const auto index = group->current();
+		auto choice = entries[index].choice;
+		if (index == customIndex) {
+			if (path->current().isEmpty()) {
+				choose();
+				return;
+			}
+			const auto text = command->getLastText().trimmed();
+			choice.path = path->current();
+			choice.command = text.isEmpty()
+				? AppLinkDefaultCommand()
+				: text;
+		}
+		SetAppLinkChoice(service.id, choice);
+		box->closeBox();
+	};
+	command->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, command->lifetime());
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace
+
+void AppLinksBox(not_null<Ui::GenericBox*> box) {
+	const auto show = box->uiShow();
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Open links in apps"_q)));
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(u"Links to these services open in the app you pick instead "
+			"of the browser. Only installed apps are listed, a custom app "
+			"can be any program."_q),
+		st::boxDividerLabel));
+	Ui::AddSkip(box->verticalLayout());
+	const auto list = box->addRow(
+		object_ptr<Ui::VerticalLayout>(box),
+		style::margins());
+	for (const auto &service : AppLinkServices()) {
+		Settings::AddButtonWithLabel(
+			list,
+			rpl::single(Lower(service.name)),
+			AppLinksValue() | rpl::map([=](const QString &) {
+				return Lower(AppLinkChoiceLabel(
+					service,
+					AppLinkChoiceFor(service.id)));
+			}),
+			st::settingsButtonNoIcon
+		)->setClickedCallback([=] {
+			show->showBox(Box(ServiceBox, service));
+		});
+	}
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace Tele
