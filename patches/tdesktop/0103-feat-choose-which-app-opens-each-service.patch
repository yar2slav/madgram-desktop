+[[nodiscard]] QString KnownProgram(const KnownApp &app) {
+	const auto folder = qEnvironmentVariable(app.folder.toUtf8().constData());
+	if (folder.isEmpty()) {
+		return QString();
+	}
+	const auto root = QDir(folder).filePath(app.directory);
+	if (!app.squirrel) {
+		const auto path = QDir(root).filePath(app.executable);
+		return QFileInfo(path).isFile() ? QDir::toNativeSeparators(path) : QString();
+	}
+	auto best = QString();
+	auto bestVersion = QVersionNumber();
+	const auto versions = QDir(root).entryList(
+		{ u"app-*"_q },
+		QDir::Dirs | QDir::NoDotAndDotDot);
+	for (const auto &name : versions) {
+		const auto version = QVersionNumber::fromString(name.mid(4));
+		const auto path = QDir(QDir(root).filePath(name)).filePath(
+			app.executable);
+		if (!version.isNull()
+			&& (best.isEmpty() || version > bestVersion)
+			&& QFileInfo(path).isFile()) {
+			best = path;
+			bestVersion = version;
+		}
+	}
+	return QDir::toNativeSeparators(best);
+}
