+Packing GridWidget::packing() const {
+	auto result = Packing{ .slots = std::vector<int>(count(), -1) };
+	for (auto i = 0; i != count(); ++i) {
+		const auto &cell = _views[i].cell;
+		const auto gift = (cell.kind != CellKind::Empty);
+		if (gift) {
+			++result.total;
+		}
+		if (!rowSelected(i / kColumns) || (gift && cell.excluded)) {
+			continue;
+		}
+		result.slots[i] = result.count++;
+		if (gift) {
+			++result.gifts;
+		}
+	}
+	return result;
+}
