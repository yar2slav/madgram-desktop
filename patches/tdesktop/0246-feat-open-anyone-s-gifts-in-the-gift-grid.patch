+
+namespace Tele::GiftGrid {
+namespace {
+
+constexpr auto kPerPage = 50;
+constexpr auto kPageDelay = crl::time(200);
+
+[[nodiscard]] Cell CellFromSaved(
+		const Data::SavedStarGift &gift,
+		bool keepPinned) {
+	auto result = Cell();
+	if (const auto unique = gift.info.unique.get()) {
+		result = CellFromUnique(*unique);
+		result.pinned = keepPinned && gift.pinned;
+	} else {
+		result.kind = CellKind::Regular;
+		result.giftId = gift.info.id;
+		result.ribbon = AutoRibbon(gift.info);
+	}
+	result.price = false;
+	result.hidden = gift.hidden;
+	return result;
+}
+
+class Loader final : public base::has_weak_ptr {
+public:
+	Loader(
+		Source source,
+		int limit,
+		Fn<void(int, int)> progress,
+		Fn<void(ImportResult)> done);
+
+	void start();
+	void stop();
+
+private:
+	void request();
+	void finish();
+
+	const Source _source;
+	const int _limit = 0;
+	const Fn<void(int, int)> _progress;
+	Fn<void(ImportResult)> _done;
+	MTP::Sender _api;
+	QString _offset;
+	ImportResult _result;
+	int _total = 0;
+
+};
+
+Loader::Loader(
+	Source source,
+	int limit,
+	Fn<void(int, int)> progress,
+	Fn<void(ImportResult)> done)
+: _source(source)
+, _limit(limit)
+, _progress(std::move(progress))
+, _done(std::move(done))
+, _api(&source.peer->session().mtp()) {
+}
+
+void Loader::start() {
+	request();
+}
+
+void Loader::stop() {
+	if (_done) {
+		_result.stopped = true;
+		finish();
+	}
+}
+
+void Loader::request() {
+	using Flag = MTPpayments_GetSavedStarGifts::Flag;
+	const auto &source = _source;
+	_api.request(MTPpayments_GetSavedStarGifts(
+		MTP_flags((source.sortByValue ? Flag::f_sort_by_value : Flag())
+			| (source.skipLimited ? Flag::f_exclude_unupgradable : Flag())
+			| (source.skipUpgradable ? Flag::f_exclude_upgradable : Flag())
+			| (source.skipUnlimited ? Flag::f_exclude_unlimited : Flag())
+			| (source.skipUnique ? Flag::f_exclude_unique : Flag())
+			| (source.skipSaved ? Flag::f_exclude_saved : Flag())
+			| (source.skipUnsaved ? Flag::f_exclude_unsaved : Flag())
+			| (source.collectionId ? Flag::f_collection_id : Flag())),
+		source.peer->input(),
+		MTP_int(source.collectionId),
+		MTP_string(_offset),
+		MTP_int(kPerPage)
+	)).done([=](const MTPpayments_SavedStarGifts &result) {
+		if (!_done) {
+			return;
+		}
+		const auto &data = result.data();
+		const auto owner = &_source.peer->owner();
+		owner->processUsers(data.vusers());
+		owner->processChats(data.vchats());
+		_total = std::max(_total, data.vcount().v);
+		const auto &list = data.vgifts().v;
+		auto left = int(list.size());
+		for (const auto &gift : list) {
+			--left;
+			if (int(_result.cells.size()) >= _limit) {
+				_result.capped = true;
+				break;
+			} else if (const auto parsed = Api::FromTL(_source.peer, gift)) {
+				_result.cells.push_back(
+					CellFromSaved(*parsed, !_source.collectionId));
+			}
+		}
+		const auto next = data.vnext_offset()
+			? qs(*data.vnext_offset())
+			: QString();
+		if (int(_result.cells.size()) >= _limit
+			&& (left > 0 || !next.isEmpty())) {
+			_result.capped = true;
+		}
+		_progress(int(_result.cells.size()), _total);
+		if (_result.capped || next.isEmpty() || list.isEmpty()) {
+			finish();
+			return;
+		}
+		_offset = next;
+		base::call_delayed(kPageDelay, this, [=] {
+			if (_done) {
+				request();
+			}
+		});
+	}).fail([=] {
+		if (_done) {
+			_result.failed = true;
+			finish();
+		}
+	}).send();
+}
+
+void Loader::finish() {
+	if (const auto done = base::take(_done)) {
+		done(base::take(_result));
+	}
+}
+
+void CollectionsBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<PeerData*> peer,
+		std::vector<Data::GiftCollection> collections,
+		Fn<void(Source)> chosen) {
+	box->setTitle(rpl::single(Lower(u"Import from %1"_q).arg(peer->name())));
+	box->setWidth(st::boxWideWidth);
+	const auto content = box->verticalLayout();
+	const auto add = [&](const QString &text, int id) {
+		content->add(object_ptr<Ui::SettingsButton>(
+			content,
+			rpl::single(text),
+			st::settingsButtonNoIcon
+		))->setClickedCallback([=] {
+			box->closeBox();
+			chosen(Source{ .peer = peer, .collectionId = id });
+		});
+	};
+	add(Lower(u"All gifts"_q), 0);
+	for (const auto &collection : collections) {
+		add(
+			Lower(u"%1 \u00B7 %2"_q)
+				.arg(collection.title)
+				.arg(collection.count),
+			collection.id);
+	}
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void ChooseCollection(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer,
+		Fn<void(Source)> chosen) {
+	const auto weak = base::make_weak(controller);
+	const auto all = [=] {
+		chosen(Source{ .peer = peer });
+	};
+	peer->session().api().request(MTPpayments_GetStarGiftCollections(
+		peer->input(),
+		MTP_long(0)
+	)).done([=](const MTPpayments_StarGiftCollections &result) {
+		auto list = std::vector<Data::GiftCollection>();
+		result.match([&](const MTPDpayments_starGiftCollections &data) {
+			for (const auto &collection : data.vcollections().v) {
+				const auto &fields = collection.data();
+				list.push_back({
+					.id = fields.vcollection_id().v,
+					.count = fields.vgifts_count().v,
+					.title = qs(fields.vtitle()),
+				});
+			}
+		}, [](const MTPDpayments_starGiftCollectionsNotModified &) {
+		});
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		} else if (list.empty()) {
+			all();
+			return;
+		}
+		strong->show(Box(CollectionsBox, peer, std::move(list), chosen));
+	}).fail([=] {
+		if (weak.get()) {
+			all();
+		}
+	}).send();
+}
+
+} // namespace
+
+void ImportGifts(
+		std::shared_ptr<ChatHelpers::Show> show,
+		Source source,
+		int limit,
+		Fn<void(ImportResult)> done) {
+	show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		struct State {
+			rpl::variable<QString> status;
+			std::unique_ptr<Loader> loader;
+			bool closing = false;
+		};
+		const auto state = box->lifetime().make_state<State>();
+		state->status = Lower(u"Loading gifts\u2026"_q);
+		box->setTitle(rpl::single(Lower(u"Importing gifts"_q)));
+		box->addRow(
+			object_ptr<Ui::FlatLabel>(
+				box,
+				state->status.value(),
+				st::boxLabel),
+			st::boxRowPadding);
+		box->setCloseByOutsideClick(false);
+		state->loader = std::make_unique<Loader>(
+			source,
+			limit,
+			[=](int loaded, int total) {
+				state->status = (total > loaded)
+					? Lower(u"Loading gifts\u2026 %1 of %2"_q)
+						.arg(loaded)
+						.arg(total)
+					: Lower(u"Loading gifts\u2026 %1"_q).arg(loaded);
+			},
+			[=](ImportResult result) {
+				done(std::move(result));
+				if (!state->closing) {
+					box->closeBox();
+				}
+			});
+		box->boxClosing() | rpl::on_next([=] {
+			state->closing = true;
+			state->loader->stop();
+		}, box->lifetime());
+		box->addButton(rpl::single(Lower(u"Stop"_q)), [=] {
+			box->closeBox();
+		});
+		state->loader->start();
+	}));
+}
+
+void ChooseImportSource(
+		not_null<Window::SessionController*> controller,
+		Fn<void(Source)> chosen) {
+	const auto weak = std::make_shared<base::weak_qptr<Ui::BoxContent>>();
+	auto callback = [=](not_null<Data::Thread*> thread) {
+		const auto peer = thread->peer();
+		if (const auto strong = weak->get()) {
+			strong->closeBox();
+		}
+		ChooseCollection(controller, peer, chosen);
+	};
+	auto filter = [](not_null<Data::Thread*> thread) {
+		const auto peer = thread->peer();
+		return peer->isUser() || peer->isBroadcast();
+	};
+	auto init = [](not_null<PeerListBox*> box) {
+		box->setTitle(rpl::single(Lower(u"Import gifts from"_q)));
+		box->addButton(tr::lng_cancel(), [=] {
+			box->closeBox();
+		});
+	};
+	*weak = controller->show(Box<PeerListBox>(
+		std::make_unique<ChooseRecipientBoxController>(
+			&controller->session(),
+			std::move(callback),
+			std::move(filter)),
+		std::move(init)));
+}
+
+} // namespace Tele::GiftGrid
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool GridMenuAvailable() {
+	return GiftStudioMenu() && !OfflineForLaunch();
+}
+
+void AddGridAction(
+		const Ui::Menu::MenuCallback &addAction,
+		not_null<Window::SessionController*> window,
+		GiftGrid::Source source) {
+	const auto weak = base::make_weak(window);
+	addAction(Lower(u"Open in gift grid"_q), [=] {
+		if (const auto strong = weak.get()) {
+			ShowGiftGridFrom(strong, source);
+		}
+	}, &st::menuIconPalette);
+}
+
+} // namespace
+
+void AddOpenInGiftGrid(
+		const Ui::Menu::MenuCallback &addAction,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		const Info::PeerGifts::Descriptor &descriptor) {
+	if (!GridMenuAvailable()) {
+		return;
+	}
+	const auto &filter = descriptor.filter;
+	AddGridAction(addAction, window, {
+		.peer = peer,
+		.collectionId = descriptor.collectionId,
+		.sortByValue = filter.sortByValue,
+		.skipUnlimited = filter.skipUnlimited,
+		.skipLimited = filter.skipLimited,
+		.skipUpgradable = filter.skipUpgradable,
+		.skipUnique = filter.skipUnique,
+		.skipSaved = filter.skipSaved,
+		.skipUnsaved = filter.skipUnsaved,
+	});
+}
+
+void AddCollectionToGiftGrid(
+		const Ui::Menu::MenuCallback &addAction,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		int collectionId) {
+	if (!GridMenuAvailable() || collectionId <= 0) {
+		return;
+	}
+	AddGridAction(addAction, window, {
+		.peer = peer,
+		.collectionId = collectionId,
+	});
+}
+
