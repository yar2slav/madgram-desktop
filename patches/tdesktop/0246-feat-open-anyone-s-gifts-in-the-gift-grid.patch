+	const auto room = (kMaxRows - used) * kColumns;
+	if (int(cells.size()) > room) {
+		cells.resize(std::max(room, 0));
+	}
+	if (cells.empty()) {
+		return;
+	}
+	_pressed = _pressedRemove = _pressedGutter = _dragTarget = -1;
+	_dragging = false;
+	_views.erase(begin(_views) + used * kColumns, end(_views));
+	_selected.resize(used);
+	for (auto &cell : cells) {
+		_views.push_back({ .cell = std::move(cell) });
+	}
+	while (_views.size() % kColumns) {
