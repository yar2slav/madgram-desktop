diff --git a/Telegram/SourceFiles/tele/tele_selection_shot.cpp b/Telegram/SourceFiles/tele/tele_selection_shot.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..31ef662ff642eb8a9cf73443d70863bae5c1a340
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_selection_shot.cpp
@@ -0,0 +1,66 @@
+#include "tele/tele_selection_shot.h"
+
+#include "base/options.h"
+#include "history/view/history_view_top_bar_widget.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/buttons.h"
+#include "styles/style_info.h"
+#include "styles/style_widgets.h"
+
+namespace Tele {
+namespace {
+
+class SelectionShot final : public Ui::RoundButton {
+public:
+
+	SelectionShot(not_null<QWidget*> parent, Fn<void()> callback)
+	: RoundButton(parent, rpl::single(Tr(u"Shot"_q)), st::defaultActiveButton) {
+		setTextTransform(Ui::RoundButtonTextTransform::NoTransform);
+		setFullWidth(-2 * st::topBarActionSkip);
+		setClickedCallback(std::move(callback));
+		hide();
+	}
+
+};
+
+SelectionShot *Find(not_null<QWidget*> bar) {
+	for (const auto child : bar->children()) {
+		if (const auto button = dynamic_cast<SelectionShot*>(child)) {
+			return button;
+		}
+	}
+	return nullptr;
+}
+
+}
+
+void SetupSelectionShot(
+		not_null<HistoryView::TopBarWidget*> bar,
+		Fn<void()> callback) {
+	new SelectionShot(bar, std::move(callback));
+	base::options::lookup<bool>(kOptionShot).changes(
+	) | rpl::on_next([=] {
+		bar->updateControlsVisibility();
+	}, bar->lifetime());
+}
+
+int SelectionShotWidth(not_null<QWidget*> bar, bool shown) {
+	const auto button = Find(bar);
+	if (!button) {
+		return 0;
+	}
+	button->setVisible(shown && ShotInMenu());
+	return button->isHidden() ? 0 : button->width() + st::topBarActionSkip;
+}
+
+int PositionSelectionShot(not_null<QWidget*> bar, int left, int top) {
+	const auto button = Find(bar);
+	if (!button || button->isHidden()) {
+		return 0;
+	}
+	button->moveToLeft(left, top);
+	return button->width() + st::topBarActionSkip;
+}
+
+}
