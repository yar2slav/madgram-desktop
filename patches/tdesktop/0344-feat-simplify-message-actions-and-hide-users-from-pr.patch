 }
 
 [[nodiscard]] base::flat_set<Key> Parse(const QString &value) {
 	auto result = base::flat_set<Key>();
 	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
 		auto entry = part.trimmed();
+		const auto hidden = entry.startsWith(u"hidden:"_q);
+		if (hidden) {
+			entry = entry.mid(7);
+		}
 		const auto test = entry.startsWith(u"test:"_q);
 		if (test) {
 			entry = entry.mid(5);
 		}
 		auto ok = false;
 		const auto id = entry.toULongLong(&ok);
-		if (ok && id) {
-			result.emplace(MakeKey(UserId(id), test));
+		if (ok && id && !(id & (kTestBit | kHiddenBit))) {
+			result.emplace(MakeKey(UserId(id), test) | (hidden ? kHiddenBit : 0));
+		}
+	}
+	const auto copy = result;
+	for (const auto key : copy) {
+		if (key & kHiddenBit) {
+			result.remove(key & ~kHiddenBit);
 		}
 	}
 	return result;
