 		_painter = &p;
 		_opacity = p.opacity();
 		p.setOpacity(_opacity * kFadeOpacity);
@@ -368,6 +394,29 @@ void AddIgnoreAction(
 		ignored ? &st::menuIconUnmute : &st::menuIconMute);
 }
 
+void AddProfileHideAction(
+		not_null<PeerData*> peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = Ignorable(peer);
+	if (!user) {
+		return;
+	}
+	const auto key = PeerKey(user);
+	const auto hidden = Get().keys.contains(key | kHiddenBit);
+	addAction(hidden
+		? Tr(u"Show messages from this user"_q)
+		: Tr(u"Hide messages from this user"_q), [=] {
+		auto keys = Get().keys;
+		keys.remove(key);
+		if (hidden) {
+			keys.remove(key | kHiddenBit);
+		} else {
+			keys.emplace(key | kHiddenBit);
+		}
+		SetIgnoredList(Serialize(keys));
+	}, hidden ? &st::menuIconUnmute : &st::menuIconMute);
+}
