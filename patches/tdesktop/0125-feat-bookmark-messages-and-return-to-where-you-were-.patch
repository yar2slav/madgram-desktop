+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1EB00C);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxEntries = quint32(65536);
+constexpr auto kMaxName = 128;
+constexpr auto kMaxPreview = 256;
+
+using ThreadKey = std::pair<PeerId, MsgId>;
+
+struct Entry {
+	MsgId topicRootId = 0;
+	QString name;
+	QString preview;
+	TimeId date = 0;
+};
+
+struct Icon {
+	QImage image;
+	QRgb color = 0;
+	int size = 0;
+};
+
+[[nodiscard]] rpl::event_stream<> &Changes() {
+	static auto result = rpl::event_stream<>();
+	return result;
+}
+
+[[nodiscard]] Icon &CachedIcon() {
+	static auto result = Icon();
+	return result;
+}
+
+[[nodiscard]] QString Flatten(QString text) {
+	for (auto &ch : text) {
+		if (ch == QChar('\n')
+			|| ch == QChar::LineSeparator
+			|| ch == QChar::ParagraphSeparator) {
+			ch = QChar(' ');
+		}
+	}
+	return text.simplified();
+}
+
+[[nodiscard]] QString PreviewOf(not_null<const HistoryItem*> item) {
+	return Flatten(item->notificationText().text).left(kMaxPreview);
+}
+
+[[nodiscard]] ThreadKey KeyOf(not_null<Data::Thread*> thread) {
+	const auto topic = thread->asTopic();
+	return { thread->peer()->id, topic ? topic->rootId() : MsgId() };
+}
+
+[[nodiscard]] MsgId TopicRootOf(not_null<HistoryItem*> item) {
+	return item->history()->peer->isForum() ? item->topicRootId() : MsgId();
+}
+
+[[nodiscard]] bool Bookmarkable(not_null<const HistoryItem*> item) {
+	return item->isRegular()
+		&& IsServerMsgId(item->id)
+		&& !item->isScheduled()
+		&& !item->isBusinessShortcut();
+}
+
+class Store final {
+public:
+	explicit Store(not_null<Main::Session*> session);
+	~Store();
+
+	[[nodiscard]] static Store *Find(not_null<Main::Session*> session);
+
+	[[nodiscard]] const Entry *find(FullMsgId id) const;
+	[[nodiscard]] std::vector<Bookmark> list(
+		not_null<Data::Thread*> thread) const;
+	void add(not_null<HistoryItem*> item);
+	void rename(FullMsgId id, const QString &name);
+	void remove(FullMsgId id);
+
+	[[nodiscard]] FullMsgId returnPoint(ThreadKey key) const;
+	void setReturnPoint(ThreadKey key, FullMsgId id);
+	void clearReturnPoint(ThreadKey key);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+	void changed(FullMsgId id);
+	void removed(not_null<const HistoryItem*> item);
+	void refreshViews() const;
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<FullMsgId, Entry> _entries;
+	base::flat_map<ThreadKey, FullMsgId> _returns;
+	bool _cleared = false;
+	rpl::lifetime _lifetime;
+
+};
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+
+	const auto owner = &session->data();
+	owner->itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		removed(item);
+	}, _lifetime);
+
+	owner->sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		_cleared = true;
+	}, _lifetime);
+
+	MessageBookmarksChanges(
+	) | rpl::on_next([=] {
+		refreshViews();
+		Changes().fire({});
+	}, _lifetime);
+
+	ReturnPointChanges(
+	) | rpl::on_next([] {
+		Changes().fire({});
+	}, _lifetime);
+}
+
+Store::~Store() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Store::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>>();
+	return result;
+}
+
+Store *Store::Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+const Entry *Store::find(FullMsgId id) const {
+	const auto i = _entries.find(id);
+	return (i != end(_entries)) ? &i->second : nullptr;
+}
+
+std::vector<Bookmark> Store::list(not_null<Data::Thread*> thread) const {
+	const auto peer = thread->peer()->id;
+	const auto topic = thread->asTopic();
+	const auto root = topic ? topic->rootId() : MsgId();
+	auto result = std::vector<Bookmark>();
+	for (const auto &[id, entry] : _entries) {
+		if (id.peer != peer || (topic && entry.topicRootId != root)) {
+			continue;
+		}
+		result.push_back({
+			.id = id,
+			.topicRootId = entry.topicRootId,
+			.name = entry.name,
+			.preview = entry.preview,
+			.date = entry.date,
+		});
+	}
+	return result;
+}
+
+void Store::add(not_null<HistoryItem*> item) {
+	_entries[item->fullId()] = Entry{
+		.topicRootId = TopicRootOf(item),
+		.preview = PreviewOf(item),
+		.date = base::unixtime::now(),
+	};
+	changed(item->fullId());
+}
+
+void Store::rename(FullMsgId id, const QString &name) {
+	const auto i = _entries.find(id);
+	if (i == end(_entries)) {
+		return;
+	}
+	i->second.name = name.trimmed().left(kMaxName);
+	changed(id);
+}
+
+void Store::remove(FullMsgId id) {
+	if (_entries.remove(id)) {
+		changed(id);
+	}
+}
+
+FullMsgId Store::returnPoint(ThreadKey key) const {
+	const auto i = _returns.find(key);
+	return (i != end(_returns)) ? i->second : FullMsgId();
+}
+
+void Store::setReturnPoint(ThreadKey key, FullMsgId id) {
+	auto &point = _returns[key];
+	if (point != id) {
+		point = id;
+		write();
+		Changes().fire({});
+	}
+}
+
+void Store::clearReturnPoint(ThreadKey key) {
+	if (_returns.remove(key)) {
+		write();
+		Changes().fire({});
+	}
+}
+
+QString Store::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void Store::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(file, u"tele_bookmarks"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxEntries) {
+		return;
+	}
+	auto entries = base::flat_map<FullMsgId, Entry>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto peer = quint64();
+		auto msg = qint64();
+		auto root = qint64();
+		auto name = QString();
+		auto preview = QString();
+		auto date = qint32();
+		file.stream >> peer >> msg >> root >> name >> preview >> date;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (peer && msg > 0) {
+			entries.emplace(
+				FullMsgId(PeerId(PeerIdHelper(peer)), MsgId(msg)),
+				Entry{
+					.topicRootId = MsgId(root),
+					.name = name.left(kMaxName),
+					.preview = preview.left(kMaxPreview),
+					.date = TimeId(date),
+				});
+		}
+	}
+	auto points = quint32();
+	file.stream >> points;
+	if (file.stream.status() != QDataStream::Ok || points > kMaxEntries) {
+		return;
+	}
+	auto returns = base::flat_map<ThreadKey, FullMsgId>();
+	for (auto i = quint32(); i != points; ++i) {
+		auto peer = quint64();
+		auto root = qint64();
+		auto itemPeer = quint64();
+		auto itemMsg = qint64();
+		file.stream >> peer >> root >> itemPeer >> itemMsg;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (peer && itemPeer && itemMsg > 0) {
+			returns.emplace(
+				ThreadKey(PeerId(PeerIdHelper(peer)), MsgId(root)),
+				FullMsgId(PeerId(PeerIdHelper(itemPeer)), MsgId(itemMsg)));
+		}
+	}
+	_entries = std::move(entries);
+	_returns = std::move(returns);
+}
+
+void Store::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 4 + sizeof(quint64);
+	for (const auto &[id, entry] : _entries) {
+		size += sizeof(quint64) * 3 + sizeof(qint32) + sizeof(quint32) * 2;
+		size += (entry.name.size() + entry.preview.size()) * sizeof(ushort);
+	}
+	size += _returns.size() * sizeof(quint64) * 4;
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_entries.size());
+	for (const auto &[id, entry] : _entries) {
+		data.stream
+			<< quint64(id.peer.value)
+			<< qint64(id.msg.bare)
+			<< qint64(entry.topicRootId.bare)
+			<< entry.name
+			<< entry.preview
+			<< qint32(entry.date);
+	}
+	data.stream << quint32(_returns.size());
+	for (const auto &[thread, id] : _returns) {
+		data.stream
+			<< quint64(thread.first.value)
+			<< qint64(thread.second.bare)
+			<< quint64(id.peer.value)
+			<< qint64(id.msg.bare);
+	}
+	auto file = FileWriteDescriptor(u"tele_bookmarks"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+void Store::changed(FullMsgId id) {
+	write();
+	if (const auto item = _session->data().message(id)) {
+		_session->data().requestItemViewRefresh(item);
+	}
+	Changes().fire({});
+}
+
+void Store::removed(not_null<const HistoryItem*> item) {
+	if (_cleared) {
+		return;
+	}
+	const auto id = item->fullId();
+	auto dirty = MessageBookmarks() && _entries.remove(id);
+	if (ReturnPoint()) {
+		for (auto i = begin(_returns); i != end(_returns);) {
+			if (i->second == id) {
+				i = _returns.erase(i);
+				dirty = true;
+			} else {
+				++i;
+			}
+		}
+	}
+	if (dirty) {
+		write();
+		Changes().fire({});
+	}
+}
+
+void Store::refreshViews() const {
+	for (const auto &[id, entry] : _entries) {
+		if (const auto item = _session->data().message(id)) {
+			_session->data().requestItemViewRefresh(item);
+		}
+	}
+}
+
+void RenameBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		FullMsgId id) {
+	const auto store = Store::Find(session);
+	const auto entry = store ? store->find(id) : nullptr;
+	box->setTitle(rpl::single(Lower(u"Rename bookmark"_q)));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Name"_q)),
+		entry ? entry->name : QString()));
+	field->setMaxLength(kMaxName);
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	const auto weak = base::make_weak(session);
+	const auto save = [=] {
+		if (const auto strong = weak.get()) {
+			if (const auto store = Store::Find(strong)) {
+				store->rename(id, field->getLastText());
+			}
+		}
+		box->closeBox();
+	};
+	field->submits() | rpl::on_next(save, field->lifetime());
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+}
