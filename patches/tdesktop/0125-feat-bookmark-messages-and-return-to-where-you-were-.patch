+class Corner final {
+public:
+	Corner(
+		not_null<Ui::RpWidget*> column,
+		not_null<QWidget*> scroll,
+		Fn<bool(QEvent*)> scrollViewportEvent,
+		not_null<const Ui::ChatStyle*> st,
+		not_null<HistoryView::CornerButtonsDelegate*> delegate,
+		Fn<void()> updatePositions);
+	~Corner();
+
+	[[nodiscard]] static Corner *Find(not_null<QWidget*> column);
+	[[nodiscard]] static std::vector<not_null<Corner*>> All();
+
+	void update();
+	[[nodiscard]] QRegion place(QRect below, float64 belowShown);
+	void beforeSend(const Api::SendAction &action);
+
+private:
+	struct ScrollState {
+		int top = 0;
+		int height = 0;
+		int max = 0;
+		QWidget *list = nullptr;
+	};
+	using Found = std::pair<HistoryView::Element*, int>;
+
+	[[nodiscard]] static base::flat_map<
+		not_null<QWidget*>,
+		not_null<Corner*>> &Registry();
+
+	[[nodiscard]] Data::Thread *thread() const;
+	[[nodiscard]] ScrollState scrollState() const;
+	[[nodiscard]] Found viewAt(const ScrollState &state, int top) const;
+	[[nodiscard]] HistoryItem *topVisible(const ScrollState &state) const;
+	[[nodiscard]] bool visible(FullMsgId id, const ScrollState &state) const;
+	void setShown(CornerButton &button, bool shown);
+	void bookmarksClick();
+	void returnClick();
+	void jump(FullMsgId id, bool removeMissing);
+
+	const not_null<Ui::RpWidget*> _column;
+	const not_null<QWidget*> _scroll;
+	const Fn<bool(QEvent*)> _scrollViewportEvent;
+	const not_null<HistoryView::CornerButtonsDelegate*> _delegate;
+	const Fn<void()> _updatePositions;
+	rpl::lifetime _stLifetime;
+	const style::TwoIconButton &_st;
+	CornerButton _returnPoint;
+	CornerButton _bookmarks;
+	FullMsgId _lastJump;
+	ThreadKey _awayKey;
+	bool _away = false;
+	rpl::lifetime _lifetime;
+
+};
+
+Corner::Corner(
+	not_null<Ui::RpWidget*> column,
+	not_null<QWidget*> scroll,
+	Fn<bool(QEvent*)> scrollViewportEvent,
+	not_null<const Ui::ChatStyle*> st,
+	not_null<HistoryView::CornerButtonsDelegate*> delegate,
+	Fn<void()> updatePositions)
+: _column(column)
+, _scroll(scroll)
+, _scrollViewportEvent(std::move(scrollViewportEvent))
+, _delegate(delegate)
+, _updatePositions(std::move(updatePositions))
+, _st(st->value(_stLifetime, st::historyToDown))
+, _returnPoint(column, _st, true)
+, _bookmarks(column, _st, false) {
+	Registry().emplace(column, this);
+
+	_returnPoint.widget->setAccessibleName(
+		Lower(u"Jump to where you were reading"_q));
+	_bookmarks.widget->setAccessibleName(Lower(u"Jump to bookmark"_q));
+	_returnPoint.widget->setClickedCallback([=] { returnClick(); });
+	_bookmarks.widget->setClickedCallback([=] { bookmarksClick(); });
+	for (const auto button : {
+		_returnPoint.widget.data(),
+		_bookmarks.widget.data(),
+	}) {
+		base::install_event_filter(button, [=](not_null<QEvent*> e) {
+			return (e->type() == QEvent::Wheel
+				&& _scrollViewportEvent(e.get()))
+				? base::EventFilterResult::Cancel
+				: base::EventFilterResult::Continue;
+		});
+	}
+
+	Changes().events(
+	) | rpl::on_next([=] {
+		if (!_delegate->cornerButtonsIgnoreVisibility()) {
+			update();
+		}
+	}, _lifetime);
+}
+
+Corner::~Corner() {
+	Registry().remove(_column);
+}
+
+base::flat_map<
+		not_null<QWidget*>,
+		not_null<Corner*>> &Corner::Registry() {
+	static auto result = base::flat_map<
+		not_null<QWidget*>,
+		not_null<Corner*>>();
+	return result;
+}
+
+Corner *Corner::Find(not_null<QWidget*> column) {
+	const auto &registry = Registry();
+	const auto i = registry.find(column);
+	return (i != end(registry)) ? i->second.get() : nullptr;
+}
+
+std::vector<not_null<Corner*>> Corner::All() {
+	auto result = std::vector<not_null<Corner*>>();
+	for (const auto &[column, corner] : Registry()) {
+		result.push_back(corner);
+	}
+	return result;
+}
+
+Data::Thread *Corner::thread() const {
+	using Type = HistoryView::CornerButtonType;
+	if (!_delegate->cornerButtonsHas(Type::Mentions)) {
+		return nullptr;
+	}
+	const auto result = _delegate->cornerButtonsThread();
+	return (result && (result->asHistory() || result->asTopic()))
+		? result
+		: nullptr;
+}
+
+Corner::ScrollState Corner::scrollState() const {
+	if (const auto area = dynamic_cast<Ui::ScrollArea*>(_scroll.get())) {
+		return {
+			.top = area->scrollTop(),
+			.height = area->height(),
+			.max = area->scrollTopMax(),
+			.list = area->widget(),
+		};
+	} else if (const auto elastic = dynamic_cast<Ui::ElasticScroll*>(
+			_scroll.get())) {
+		return {
+			.top = elastic->scrollTop(),
+			.height = elastic->height(),
+			.max = elastic->scrollTopMax(),
+			.list = elastic->widget(),
+		};
+	}
+	return {};
+}
+
+Corner::Found Corner::viewAt(const ScrollState &state, int top) const {
+	if (const auto inner = dynamic_cast<HistoryInner*>(state.list)) {
+		return inner->findViewForPinnedTracking(top);
+	} else if (const auto list = dynamic_cast<HistoryView::ListWidget*>(
+			state.list)) {
+		return list->findViewForPinnedTracking(top);
+	}
+	return { nullptr, 0 };
+}
+
+HistoryItem *Corner::topVisible(const ScrollState &state) const {
+	const auto [view, offset] = viewAt(state, state.top);
+	if (!view) {
+		return nullptr;
+	} else if (offset > 0) {
+		const auto next = state.top - offset + view->height();
+		if (next < state.top + state.height) {
+			const auto below = viewAt(state, next).first;
+			if (below && below != view) {
+				return below->data();
+			}
+		}
+	}
+	return view->data();
+}
+
+bool Corner::visible(FullMsgId id, const ScrollState &state) const {
+	const auto top = viewAt(state, state.top).first;
+	if (!top) {
+		return false;
+	}
+	const auto from = top->data()->fullId();
+	if (from.peer != id.peer || id.msg < from.msg) {
+		return false;
+	}
+	const auto bottom = viewAt(state, state.top + state.height - 1).first;
+	if (!bottom) {
+		return true;
+	}
+	const auto till = bottom->data()->fullId();
+	return (till.peer != id.peer) || (id.msg <= till.msg);
+}
+
+void Corner::setShown(CornerButton &button, bool shown) {
+	if (button.shown != shown) {
+		button.shown = shown;
+		button.animation.start(
+			_updatePositions,
+			shown ? 0. : 1.,
+			shown ? 1. : 0.,
+			st::historyToDownDuration);
+	}
+}
+
+void Corner::update() {
+	const auto thread = this->thread();
+	const auto store = thread ? Store::Find(&thread->session()) : nullptr;
+	const auto may = store && _delegate->cornerButtonsUnreadMayBeShown();
+
+	const auto count = (store && MessageBookmarks())
+		? int(store->list(thread).size())
+		: 0;
+	if (count > 0) {
+		_bookmarks.widget->setCount(count);
+	}
+	setShown(_bookmarks, may && count > 0);
+
+	const auto key = thread ? KeyOf(thread) : ThreadKey();
+	const auto point = (store && ReturnPoint())
+		? store->returnPoint(key)
+		: FullMsgId();
+	if (point && _scroll->isVisible()) {
+		if (_awayKey != key) {
+			_awayKey = key;
+			_away = false;
+		}
+		if (!visible(point, scrollState())) {
+			_away = true;
+		} else if (_away) {
+			store->clearReturnPoint(key);
+			return;
+		}
+	}
+	setShown(_returnPoint, may && point);
+}
+
+QRegion Corner::place(QRect below, float64 belowShown) {
+	const auto skip = st::historyUnreadThingsSkip;
+	auto bottom = below.y()
+		+ below.height()
+		- anim::interpolate(0, below.height() + skip, belowShown);
+	auto result = QRegion();
+	for (const auto button : { &_returnPoint, &_bookmarks }) {
+		const auto widget = button->widget.data();
+		const auto shown = button->animation.value(button->shown ? 1. : 0.);
+		widget->moveToRight(
+			anim::interpolate(
+				-widget->width(),
+				st::historyToDownPosition.x(),
+				shown),
+			bottom - widget->height());
+		bottom -= anim::interpolate(0, widget->height() + skip, shown);
+		const auto hidden = !button->shown && !button->animation.animating();
+		if (hidden != widget->isHidden()) {
+			widget->setVisible(!hidden);
+		}
+		if (!widget->isHidden()) {
+			result += widget->geometry();
+		}
+	}
+	return result;
+}
+
+void Corner::beforeSend(const Api::SendAction &action) {
+	const auto thread = this->thread();
+	if (!thread || action.history != thread->owningHistory()) {
+		return;
+	} else if (const auto topic = thread->asTopic()) {
+		if (action.replyTo.topicRootId != topic->rootId()) {
+			return;
+		}
+	}
+	if ((action.options.scheduled && !IsGhostScheduled(action))
+		|| action.options.shortcutId
+		|| action.replaceMediaOf
+		|| !_scroll->isVisible()
+		|| _delegate->cornerButtonsIgnoreVisibility()) {
+		return;
+	}
+	const auto state = scrollState();
+	if (!state.list) {
+		return;
+	}
+	const auto unloaded = dynamic_cast<HistoryInner*>(state.list)
+		&& !action.history->loadedAtBottom();
+	if (!unloaded
+		&& state.top + st::historyToDownShownAfter >= state.max) {
+		return;
+	}
+	const auto item = topVisible(state);
+	const auto store = Store::Find(&thread->session());
+	if (!item || !item->isRegular() || !store) {
+		return;
+	}
+	_awayKey = KeyOf(thread);
+	_away = false;
+	store->setReturnPoint(_awayKey, item->fullId());
+}
+
+void Corner::bookmarksClick() {
+	const auto thread = this->thread();
+	const auto store = thread ? Store::Find(&thread->session()) : nullptr;
+	if (!store) {
+		return;
+	}
+	const auto list = store->list(thread);
+	if (list.empty()) {
+		return;
+	}
+	const auto state = scrollState();
+	const auto last = ranges::find(list, _lastJump, &Bookmark::id);
+	auto target = list.back().id;
+	if (last != end(list) && state.list && visible(_lastJump, state)) {
+		if (last != begin(list)) {
+			target = (last - 1)->id;
+		}
+	} else if (state.list) {
+		if (const auto view = viewAt(state, state.top).first) {
+			const auto top = view->data()->fullId();
+			for (auto i = list.rbegin(); i != list.rend(); ++i) {
+				if (i->id.peer == top.peer && i->id.msg <= top.msg) {
+					target = i->id;
+					break;
+				}
+			}
+		}
+	}
+	_lastJump = target;
+	jump(target, true);
+}
+
+void Corner::returnClick() {
+	const auto thread = this->thread();
+	const auto store = thread ? Store::Find(&thread->session()) : nullptr;
+	if (!store) {
+		return;
+	}
+	const auto key = KeyOf(thread);
+	const auto point = store->returnPoint(key);
+	if (!point) {
+		return;
+	}
+	store->clearReturnPoint(key);
+	jump(point, false);
+}
+
+void Corner::jump(FullMsgId id, bool removeMissing) {
+	const auto thread = this->thread();
+	if (!thread) {
+		return;
+	}
+	const auto session = &thread->session();
+	if (const auto item = session->data().message(id)) {
+		_delegate->cornerButtonsShowAtPosition(item->position());
+		return;
+	}
+	const auto weak = base::make_weak(thread);
+	session->api().requestMessageData(
+		session->data().peer(id.peer),
+		id.msg,
+		crl::guard(_column.get(), [=] {
+			const auto strong = weak.get();
+			if (!strong || this->thread() != strong) {
+				return;
+			} else if (const auto item = session->data().message(id)) {
+				_delegate->cornerButtonsShowAtPosition(item->position());
+				return;
+			} else if (removeMissing) {
+				if (const auto store = Store::Find(session)) {
+					store->remove(id);
+				}
+			}
+			Ui::Toast::Show(
+				_scroll.get(),
+				tr::lng_message_not_found(tr::now));
+		}));
+}
+
+[[nodiscard]] int IconSize() {
