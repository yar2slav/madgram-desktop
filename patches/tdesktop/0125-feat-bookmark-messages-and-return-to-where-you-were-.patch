+QString BookmarkTitle(
+		not_null<Main::Session*> session,
+		const Bookmark &bookmark) {
+	if (!bookmark.name.isEmpty()) {
+		return bookmark.name;
+	} else if (const auto item = session->data().message(bookmark.id)) {
+		if (const auto preview = PreviewOf(item); !preview.isEmpty()) {
+			return preview;
+		}
+	}
+	return bookmark.preview.isEmpty()
+		? Lower(u"Message"_q)
+		: bookmark.preview;
+}
+
+void JumpToBookmark(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread,
+		FullMsgId id) {
+	const auto session = &controller->session();
+	const auto weak = base::make_weak(thread);
+	const auto open = [=] {
+		if (const auto strong = weak.get()) {
+			controller->showThread(
+				strong,
+				id.msg,
+				Window::SectionShow::Way::Forward);
+		}
+	};
+	if (session->data().message(id)) {
+		open();
+		return;
+	}
+	session->api().requestMessageData(
+		session->data().peer(id.peer),
+		id.msg,
+		crl::guard(controller, [=] {
+			if (session->data().message(id)) {
+				open();
+			} else {
+				RemoveBookmark(session, id);
+				controller->showToast(tr::lng_message_not_found(tr::now));
+			}
+		}));
+}
+
+void AddBookmarkActions(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		HistoryItem *item) {
+	if (!MessageBookmarks() || !item || !Bookmarkable(item)) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	const auto store = Store::Find(session);
+	if (!store) {
+		return;
+	}
+	const auto id = item->fullId();
+	if (!store->find(id)) {
+		menu->addAction(Lower(u"Bookmark"_q), [=] {
+			const auto store = Store::Find(session);
+			if (const auto item = session->data().message(id); item && store) {
+				store->add(item);
+			}
+		}, &st::menuIconSavedMessages);
+		return;
+	}
+	menu->addAction(Lower(u"Rename bookmark"_q), [=] {
+		show->showBox(Box(RenameBox, session, id));
+	}, &st::menuIconTagRename);
+	menu->addAction(Lower(u"Remove bookmark"_q), [=] {
+		RemoveBookmark(session, id);
+	}, &st::menuIconTagRemove);
+}
+
+void AddBookmarksAction(
+		not_null<Window::SessionController*> controller,
+		Data::Thread *thread,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!thread
+		|| (!thread->asHistory() && !thread->asTopic())
+		|| ThreadBookmarks(thread).empty()) {
+		return;
+	}
+	const auto weak = base::make_weak(thread);
+	addAction(Lower(u"Bookmarks"_q), [=] {
+		if (const auto strong = weak.get()) {
+			controller->show(Box(BookmarksBox, controller, strong));
+		}
+	}, &st::menuIconSavedMessages);
+}
+
+bool BookmarkIconShown(not_null<const HistoryItem*> item) {
+	if (!MessageBookmarks()) {
+		return false;
+	}
+	const auto store = Store::Find(&item->history()->session());
+	return store && store->find(item->fullId());
+}
+
+int BookmarkIconWidth() {
+	return IconSize() + style::ConvertScale(1);
+}
+
+int PaintBookmarkIcon(QPainter &p, int right, int top) {
+	const auto size = IconSize();
+	const auto ratio = ShotPixelRatio();
+	const auto color = p.pen().color();
+	auto &icon = CachedIcon();
+	if (icon.image.isNull()
+		|| icon.color != color.rgba()
+		|| icon.size != size * ratio) {
+		icon.color = color.rgba();
+		icon.size = size * ratio;
+		icon.image = st::menuIconSavedMessages.instance(
+			color,
+			std::max(int(style::kScaleMax), style::Scale() * ratio),
+			true
+		).scaled(
+			icon.size,
+			icon.size,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+		icon.image.setDevicePixelRatio(ratio);
+	}
+	right -= BookmarkIconWidth();
+	p.drawImage(
+		right,
+		top + (st::msgDateFont->height - size) / 2,
+		icon.image);
+	return right;
+}
+
+void PaintBookmarkServiceIcon(
+		QPainter &p,
+		const Ui::ChatPaintContext &context,
+		not_null<const HistoryView::Element*> view,
+		QRect geometry) {
+	if (!BookmarkIconShown(view->data())) {
+		return;
+	}
+	const auto size = st::msgServicePadding.top()
+		+ st::msgServiceFont->height
+		+ st::msgServicePadding.bottom();
+	const auto skip = st::msgServiceMargin.top();
+	const auto before = geometry.x() - skip - size;
+	const auto rect = QRect(
+		((before >= 0)
+			? before
+			: std::min(
+				geometry.x() + geometry.width() + skip,
+				view->width() - size)),
+		geometry.y(),
+		size,
+		size);
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(context.st->msgServiceBg());
+		p.drawEllipse(rect);
+	}
+	const auto icon = IconSize();
+	p.setPen(context.st->msgServiceFg());
+	PaintBookmarkIcon(
+		p,
+		rect.x() + (rect.width() - icon) / 2 + BookmarkIconWidth(),
+		rect.y() + (rect.height() - icon) / 2);
+}
+
+void BeforeSendAction(const Api::SendAction &action) {
+	if (!ReturnPoint()) {
+		return;
+	}
+	for (const auto corner : Corner::All()) {
+		corner->beforeSend(action);
+	}
+}
+
+void SetupCornerBookmarks(
+		not_null<Ui::RpWidget*> column,
+		not_null<QWidget*> scroll,
+		Fn<bool(QEvent*)> scrollViewportEvent,
+		not_null<const Ui::ChatStyle*> st,
+		not_null<HistoryView::CornerButtonsDelegate*> delegate,
+		Fn<void()> updatePositions) {
+	column->lifetime().make_state<Corner>(
+		column,
+		scroll,
+		std::move(scrollViewportEvent),
+		st,
+		delegate,
+		std::move(updatePositions));
+}
+
+void UpdateCornerBookmarks(not_null<Ui::RpWidget*> column) {
+	if (const auto corner = Corner::Find(column)) {
+		corner->update();
+	}
+}
+
+QRegion PlaceCornerBookmarks(
+		not_null<Ui::RpWidget*> column,
+		QRect below,
+		float64 belowShown) {
+	const auto corner = Corner::Find(column);
+	return corner ? corner->place(below, belowShown) : QRegion();
+}
+
+} // namespace Tele
