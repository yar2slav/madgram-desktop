+QImage JumpButton::prepareRippleMask() const {
+	return Ui::RippleAnimation::EllipseMask(
+		QSize(_st.rippleAreaSize, _st.rippleAreaSize));
+}
+
+QPoint JumpButton::prepareRippleStartPosition() const {
+	return mapFromGlobal(QCursor::pos()) - _st.rippleAreaPosition;
+}
+
+void JumpButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto over = isOver() || isDown();
+	(over ? _st.iconBelowOver : _st.iconBelow).paint(
+		p,
+		_st.iconPosition,
+		width());
+	paintRipple(p, _st.rippleAreaPosition.x(), _st.rippleAreaPosition.y());
+	const auto &below = _st.iconBelow;
+	const auto center = QPointF(_st.iconPosition)
+		+ QPointF(below.width(), below.height()) / 2.;
+	if (_up) {
+		p.save();
+		p.translate(center);
+		p.rotate(180.);
+		p.translate(-center);
+		(over ? _st.iconAboveOver : _st.iconAbove).paint(
+			p,
+			_st.iconPosition,
+			width());
+		p.restore();
+	} else {
+		const auto &icon = st::menuIconSavedMessages;
+		icon.paint(
+			p,
+			(center - QPointF(icon.width(), icon.height()) / 2.).toPoint(),
+			width(),
+			(over ? st::historyToDownFgOver : st::historyToDownFg)->c);
+	}
+	if (_count > 0) {
+		auto st = Ui::UnreadBadgeStyle();
+		st.align = style::al_center;
+		st.font = st::historyToDownBadgeFont;
+		st.size = st::historyToDownBadgeSize;
+		st.sizeId = Ui::UnreadBadgeSize::HistoryToDown;
+		Ui::PaintUnreadBadge(p, QString::number(_count), width(), 0, st, 4);
+	}
+}
