+namespace Tele {
+namespace {
+
+class Row final : public Ui::RippleButton {
+public:
+	Row(QWidget *parent, QString title, QString date, Fn<void()> remove);
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+	int resizeGetHeight(int newWidth) override;
+
+	const QString _title;
+	const QString _date;
+	object_ptr<Ui::IconButton> _remove;
+
+};
+
+[[nodiscard]] int RowSkip() {
+	return st::lineWidth * 10;
+}
+
+Row::Row(QWidget *parent, QString title, QString date, Fn<void()> remove)
+: RippleButton(parent, st::defaultRippleAnimation)
+, _title(std::move(title))
+, _date(std::move(date))
+, _remove(this, st::stickersRemove) {
+	_remove->setClickedCallback(std::move(remove));
+	_remove->setAccessibleName(Lower(u"Remove bookmark"_q));
+	setAccessibleName(_title);
+}
+
+int Row::resizeGetHeight(int newWidth) {
+	const auto height = RowSkip() * 2
+		+ st::semiboldFont->height
+		+ st::normalFont->height;
+	_remove->moveToRight(
+		st::boxRowPadding.right() / 2,
+		(height - _remove->height()) / 2,
+		newWidth);
+	return height;
+}
+
+void Row::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	if (isOver() || isDown()) {
+		p.fillRect(rect(), st::windowBgOver);
+	}
+	paintRipple(p, 0, 0);
+	const auto left = st::boxRowPadding.left();
+	const auto available = std::max(_remove->x() - left, 0);
+	p.setPen(st::windowFg);
+	p.setFont(st::semiboldFont);
+	p.drawText(
+		left,
+		RowSkip() + st::semiboldFont->ascent,
+		st::semiboldFont->elided(_title, available));
+	p.setPen(st::windowSubTextFg);
+	p.setFont(st::normalFont);
+	p.drawText(
+		left,
+		RowSkip() + st::semiboldFont->height + st::normalFont->ascent,
+		st::normalFont->elided(_date, available));
+}
+
+} // namespace
+
+void BookmarksBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread) {
+	box->setWidth(st::boxWideWidth);
+	box->setMaxHeight(st::boxMaxListHeight);
+	box->setTitle(rpl::single(Lower(u"Bookmarks"_q)));
+	const auto session = &controller->session();
+	const auto weak = base::make_weak(thread);
+	const auto list = box->addRow(
+		object_ptr<Ui::VerticalLayout>(box),
+		style::margins());
+	const auto rebuild = [=] {
+		list->clear();
+		const auto strong = weak.get();
+		const auto bookmarks = strong
+			? ThreadBookmarks(strong)
+			: std::vector<Bookmark>();
+		if (bookmarks.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"No bookmarks"_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+			return;
+		}
+		for (auto i = bookmarks.rbegin(); i != bookmarks.rend(); ++i) {
+			const auto id = i->id;
+			const auto row = list->add(object_ptr<Row>(
+				list,
+				BookmarkTitle(session, *i),
+				langDateTime(base::unixtime::parse(i->date)),
+				[=] {
+					crl::on_main(box, [=] {
+						RemoveBookmark(session, id);
+					});
+				}));
+			row->setClickedCallback([=] {
+				const auto window = controller;
+				const auto target = weak.get();
+				const auto msgId = id;
+				box->closeBox();
+				if (target) {
+					JumpToBookmark(window, target, msgId);
+				}
+			});
+		}
+	};
+	rebuild();
+	BookmarksChanges(
+	) | rpl::on_next([=] {
+		rebuild();
+	}, box->lifetime());
+	box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+}
+
