+
+class HistoryItem;
+
+namespace Tele {
+
+inline constexpr auto kMaxIdsPerRequest = 100;
+
+[[nodiscard]] int MaxSelectedItems();
+[[nodiscard]] std::vector<QVector<MTPint>> SplitIds(
+	const QVector<MTPint> &ids);
+[[nodiscard]] bool ForwardSplitBySize(
+	const std::vector<not_null<HistoryItem*>> &range,
+	const std::vector<not_null<HistoryItem*>> &ordered,
+	int index);
+
+} // namespace Tele
