 namespace Tele {
+namespace {
+
+// a big deletion goes out in parts of 100 that usually fail together
+constexpr auto kSameFailToastSkip = crl::time(3000);
+
+[[nodiscard]] bool RepeatedFailToast(
+		not_null<History*> history,
+		const QString &error) {
+	static auto last = std::tuple<PeerId, QString, crl::time>();
+	const auto now = crl::now();
+	const auto peer = history->peer->id;
+	const auto repeated = (std::get<0>(last) == peer)
+		&& (std::get<1>(last) == error)
+		&& (now - std::get<2>(last) < kSameFailToastSkip);
+	last = { peer, error, now };
+	return repeated;
+}
+
+} // namespace
 
