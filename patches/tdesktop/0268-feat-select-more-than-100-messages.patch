new file mode 100644
index 0000000000000000000000000000000000000000..94fe4011c19accd2702e625bad1be081d9fe0802
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_select_many.cpp
@@ -0,0 +1,52 @@
+#include "tele/tele_select_many.h"
+
+#include "history/history_item.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kDefaultMaxSelected = 100;
+constexpr auto kManyMaxSelected = 10000;
+
+} // namespace
+
+int MaxSelectedItems() {
+	return SelectMany() ? kManyMaxSelected : kDefaultMaxSelected;
+}
+
+std::vector<QVector<MTPint>> SplitIds(const QVector<MTPint> &ids) {
+	auto result = std::vector<QVector<MTPint>>();
+	const auto count = int(ids.size());
+	result.reserve((count + kMaxIdsPerRequest - 1) / kMaxIdsPerRequest);
+	for (auto i = 0; i < count; i += kMaxIdsPerRequest) {
+		result.push_back(ids.mid(i, kMaxIdsPerRequest));
+	}
+	return result;
+}
+
+bool ForwardSplitBySize(
+		const std::vector<not_null<HistoryItem*>> &range,
+		const std::vector<not_null<HistoryItem*>> &ordered,
+		int index) {
+	const auto size = int(range.size());
+	if (size >= kMaxIdsPerRequest) {
+		return true;
+	}
+	const auto group = ordered[index]->groupId();
+	if (!group
+		|| (index > 0 && ordered[index - 1]->groupId() == group)) {
+		return false;
+	}
+	auto album = 0;
+	for (auto i = index; i != int(ordered.size()); ++i) {
+		if (ordered[i]->groupId() != group) {
+			break;
+		}
+		++album;
+	}
+	return (album <= kMaxIdsPerRequest)
+		&& (size + album > kMaxIdsPerRequest);
+}
+
+} // namespace Tele
