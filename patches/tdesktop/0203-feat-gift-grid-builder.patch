+QImage CellDelegate::cachedBadge(const Info::PeerGifts::GiftBadge &badge) {
+	if (!_badgeValid) {
+		_badge = _look.text.isEmpty()
+			? QImage()
+			: Info::PeerGifts::ValidateRotatedBadge({
+				.text = _look.text,
+				.bg1 = _look.bg1,
+				.bg2 = _look.bg2,
+				.fg = _look.fg,
+				.small = true,
+			}, QMargins());
+		_badgeValid = true;
+	}
+	return _badge;
