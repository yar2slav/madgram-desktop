+			}
+			state->parts = parts;
+			state->partsFor = collection;
+			auto &draft = state->draft;
+			FixName(draft.model, parts.models);
+			FixName(draft.backdrop, parts.backdrops);
+			FixName(draft.symbol, parts.symbols);
+			state->refreshList(false);
+			state->refresh();
+		}), crl::guard(box, [=] {
+			if (state->draft.collection == collection) {
+				preview->setStatus(
+					Lower(u"Couldn't load this gift from api.changes.tg."_q));
+			}
+		}));
+	};
+
+	state->applyUnique = [=](Cell cell) {
+		state->draft = std::move(cell);
+		state->syncControls();
+		state->loadParts();
+		state->refreshList(true);
+		state->refresh();
+	};
+
+	const auto choose = [=](int index) {
+		auto &draft = state->draft;
+		const auto &parts = state->parts;
+		switch (state->tab) {
+		case Tab::Collection:
+			if (index >= 0
+				&& index < int(state->collections.size())
+				&& state->collections[index] != draft.collection) {
+				draft.collection = state->collections[index];
+				state->loadParts();
+			}
+			break;
+		case Tab::Model:
+			if (index >= 0 && index < int(parts.models.size())) {
+				draft.model = parts.models[index].name;
+			}
+			break;
+		case Tab::Backdrop:
+			if (index >= 0 && index < int(parts.backdrops.size())) {
+				draft.backdrop = parts.backdrops[index].name;
+			}
+			break;
+		case Tab::Symbol:
+			if (index >= 0 && index < int(parts.symbols.size())) {
+				draft.symbol = parts.symbols[index].name;
+			}
+			break;
+		}
+		state->refreshList(false);
+		state->refresh();
+	};
+	list->chosen() | rpl::on_next(choose, list->lifetime());
+	search->setQueryChangedCallback([=](const QString &query) {
+		state->query = query;
+		state->refreshList(false);
+		scroll->scrollToY(0);
+	});
+	search->setSubmittedCallback([=](Qt::KeyboardModifiers) {
+		if (const auto first = list->firstIndex(); first >= 0) {
+			choose(first);
+		}
+	});
+	search->setCancelledCallback([=] {
+		search->clearQuery();
+	});
+	tabs->sectionActivated() | rpl::on_next([=](int section) {
+		state->tab = Tab(section);
+		search->clearQuery();
+		state->query = QString();
+		state->refreshList(true);
+	}, tabs->lifetime());
+
+	kinds->sectionActivated() | rpl::on_next([=](int section) {
+		if (state->syncing) {
+			return;
+		}
+		auto &draft = state->draft;
+		draft.kind = section ? CellKind::Regular : CellKind::Unique;
+		if (draft.kind == CellKind::Regular) {
+			if (draft.ribbon == Ribbon::Auto) {
+				const auto gift = draft.giftId
+					? library->findGift(draft.giftId)
+					: std::nullopt;
+				draft.ribbon = gift ? AutoRibbon(*gift) : Ribbon::None;
+			}
+			draft.pinned = false;
+		} else if (draft.ribbon == Ribbon::Limited
+			|| draft.ribbon == Ribbon::SoldOut) {
+			draft.ribbon = Ribbon::Auto;
+		}
+		state->syncControls();
+		state->refresh();
+	}, kinds->lifetime());
+
+	ribbon->setChangedCallback([=](Ribbon value) {
+		if (!state->syncing) {
+			state->draft.ribbon = value;
+			state->refresh();
+		}
+	});
+	ribbonField->changes() | rpl::on_next([=] {
+		state->draft.ribbonText = ribbonField->getLastText().trimmed();
+		state->refresh();
+	}, ribbonField->lifetime());
+	numberField->changes() | rpl::on_next([=] {
+		if (state->syncing) {
+			return;
+		}
+		const auto number = ParseNumber(numberField->getLastText());
+		if (number >= 0 && number != state->draft.number) {
+			state->draft.number = number;
+			state->refresh();
+		}
+	}, numberField->lifetime());
+	pinned->checkedChanges() | rpl::on_next([=](bool checked) {
+		if (!state->syncing) {
+			state->draft.pinned = checked;
+			state->refresh();
+		}
+	}, pinned->lifetime());
+	price->checkedChanges() | rpl::on_next([=](bool checked) {
+		if (!state->syncing) {
+			state->draft.price = checked;
+			state->refresh();
+		}
+	}, price->lifetime());
+	hidden->checkedChanges() | rpl::on_next([=](bool checked) {
+		if (!state->syncing) {
+			state->draft.hidden = checked;
+			state->refresh();
+		}
+	}, hidden->lifetime());
+	swatch->setClickedCallback([=] {
+		show->showBox(Box(
+			ColorPickerBox,
+			Lower(u"Ribbon colour"_q),
+			swatch->color(),
+			crl::guard(box, [=](QColor color) {
+				state->draft.ribbonColor = color;
+				state->refresh();
+			})));
+	});
+	reset->setClickedCallback([=] {
+		state->draft.ribbonColor = QColor();
+		state->refresh();
+	});
+
+	box->addButton(tr::lng_settings_save(), [=] {
+		const auto &draft = state->draft;
+		if (draft.kind == CellKind::Regular && !draft.giftId) {
+			show->showToast(Lower(u"Choose a gift from the catalog."_q));
+			return;
+		} else if (draft.kind == CellKind::Unique
+			&& (draft.collection.isEmpty()
+				|| draft.model.isEmpty()
+				|| draft.backdrop.isEmpty()
+				|| draft.symbol.isEmpty())) {
+			show->showToast(Lower(u"The parts are still loading."_q));
+			return;
+		}
+		auto result = draft;
+		if (result.kind == CellKind::Regular) {
+			result.collection = result.model = QString();
+			result.backdrop = result.symbol = QString();
+			result.pinned = false;
+		} else {
+			result.giftId = 0;
+		}
+		done(result);
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+
+	state->syncControls();
+	textWrap->toggle(
+		state->draft.ribbon == Ribbon::Custom,
+		anim::type::instant);
+	state->refresh();
+	library->catalog(crl::guard(box, [=](const std::vector<Data::StarGift> &) {
+		state->refresh();
+	}));
+	library->collections(crl::guard(box, [=](
+			const std::vector<QString> &collections) {
+		state->collections = collections;
+		auto &draft = state->draft;
+		if (draft.collection.isEmpty() && !collections.empty()) {
+			draft.collection = collections.front();
+		}
+		state->loadParts();
+		state->refreshList(true);
+		state->refresh();
+	}), crl::guard(box, [=] {
+		if (state->draft.kind == CellKind::Unique) {
+			preview->setStatus(
+				Lower(u"Couldn't load gifts from api.changes.tg."_q));
+		}
+	}));
+}
+
+void CatalogBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<Library> library,
+		Fn<void(Data::StarGift)> chosen) {
+	box->setTitle(rpl::single(Lower(u"Choose a gift"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto list = box->addRow(
+		object_ptr<CatalogList>(
+			box,
+			library->session(),
+			crl::guard(box, [=](Data::StarGift gift) {
+				chosen(gift);
+				box->closeBox();
+			})),
+		style::margins());
+	library->catalog(crl::guard(list, [=](
+			const std::vector<Data::StarGift> &gifts) {
+		list->setGifts(gifts);
+	}));
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void RollHistoryBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		Fn<void(Cell)> chosen) {
+	box->setTitle(rpl::single(Lower(u"Roll history"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto content = box->verticalLayout();
+	const auto list = FakeUpgrades(session);
+	if (list.empty()) {
+		content->add(
+			object_ptr<Ui::FlatLabel>(
+				content,
+				Lower(u"Fake upgrades show up here."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding);
+	}
+	for (const auto &unique : list) {
+		auto cell = Cell{
+			.kind = CellKind::Unique,
+			.collection = unique->title,
+			.model = unique->model.name,
+			.backdrop = unique->backdrop.name,
+			.symbol = unique->pattern.name,
+			.number = unique->number,
+		};
+		const auto button = content->add(object_ptr<Ui::SettingsButton>(
+			content,
+			rpl::single(Data::UniqueGiftName(*unique)),
+			st::settingsButtonNoIcon));
+		button->setClickedCallback([=] {
+			chosen(cell);
+			box->closeBox();
+		});
+		content->add(
+			object_ptr<Ui::FlatLabel>(
+				content,
+				QStringList{
+					cell.model,
+					cell.backdrop,
+					cell.symbol,
+				}.join(u", "_q),
+				st::boxDividerLabel),
+			st::boxRowPadding);
+	}
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+void RibbonTextBox(
+		not_null<Ui::GenericBox*> box,
+		QString text,
+		Fn<void(QString)> done) {
+	box->setTitle(rpl::single(Lower(u"Ribbon text"_q)));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Empty brings the default back"_q)),
+		text));
+	field->setMaxLength(kMaxRibbon);
+	const auto save = [=] {
+		done(field->getLastText().trimmed());
+		box->closeBox();
+	};
+	field->submits() | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace Tele::GiftGrid
