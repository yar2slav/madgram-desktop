+Info::PeerGifts::GiftDescriptor Descriptor(
+		const Cell &cell,
+		const Resolved &resolved) {
+	Expects(resolved.gift.has_value());
+
+	auto info = *resolved.gift;
+	if (cell.kind == CellKind::Unique) {
+		return Info::PeerGifts::GiftTypeStars{
+			.info = std::move(info),
+			.pinned = cell.pinned,
+			.hidden = cell.hidden,
+			.mine = true,
+		};
+	}
+	info.limitedCount = std::max(info.limitedCount, 1);
+	if (cell.price) {
+		info.starsResellMin = info.stars;
+		info.resellCount = 1;
+	}
+	return Info::PeerGifts::GiftTypeStars{
+		.info = std::move(info),
+		.hidden = cell.hidden,
+		.resale = cell.price,
+	};
+}
