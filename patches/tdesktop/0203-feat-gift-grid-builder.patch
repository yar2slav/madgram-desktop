+void Library::resolve(const Cell &cell, Fn<void(Resolved)> done) {
+	switch (cell.kind) {
+	case CellKind::Empty:
+		done(Resolved());
+		return;
+	case CellKind::Unique:
+		resolveUnique(cell, std::move(done));
+		return;
+	case CellKind::Regular:
+		resolveRegular(cell, std::move(done));
+		return;
+	}
+}
+
+void Library::resolveUnique(const Cell &cell, Fn<void(Resolved)> done) {
+	const auto fail = [=] {
+		done(Resolved{ .failed = true });
+	};
+	parts(cell.collection, [=](const GiftStudio::Parts &parts) {
+		const auto model = FindByName(parts.models, cell.model);
+		const auto backdrop = FindByName(parts.backdrops, cell.backdrop);
+		const auto symbol = FindByName(parts.symbols, cell.symbol);
+		if (!model || !backdrop || !symbol) {
+			fail();
+			return;
+		}
+		struct Pending {
+			QByteArray model;
+			QByteArray symbol;
+			int left = 2;
+			bool failed = false;
+		};
+		const auto pending = std::make_shared<Pending>();
+		const auto modelName = model->name;
+		const auto symbolName = symbol->name;
+		const auto backdropName = backdrop->name;
+		const auto colors = backdrop->colors;
+		const auto modelPermille = model->permille;
+		const auto symbolPermille = symbol->permille;
+		const auto backdropPermille = backdrop->permille;
+		const auto finish = crl::guard(this, [=] {
+			if (--pending->left) {
+				return;
+			} else if (pending->failed) {
+				fail();
+				return;
+			}
+			const auto key = cell.collection + '\n';
+			const auto document = localSticker(
+				u"model\n"_q + key + modelName,
+				pending->model);
+			const auto pattern = localSticker(
+				u"symbol\n"_q + key + symbolName,
+				pending->symbol);
+			auto unique = std::make_shared<Data::UniqueGift>(
+				Data::UniqueGift{
+					.id = base::RandomValue<CollectibleId>(),
+					.title = cell.collection,
+					.nanoTonForResale = 0,
+					.starsForResale = 0,
+					.number = cell.number,
+					.model = Data::UniqueGiftModel{
+						{ modelName, modelPermille },
+						document,
+					},
+					.pattern = Data::UniqueGiftPattern{
+						{ symbolName, symbolPermille },
+						pattern,
+					},
+					.backdrop = Data::UniqueGiftBackdrop{
+						{ backdropName, backdropPermille },
+						colors.center,
+						colors.edge,
+						colors.pattern,
+						colors.text,
+					},
+				});
+			done(Resolved{
+				.colors = colors,
+				.modelJson = pending->model,
+				.symbolJson = pending->symbol,
+				.gift = Data::StarGift{
+					.id = base::RandomValue<uint64>(),
+					.unique = std::move(unique),
+					.document = document,
+					.resellTitle = cell.collection,
+					.limitedCount = 1,
+				},
+			});
+		});
+		GiftStudio::RequestModel(cell.collection, modelName, [=](
+				QByteArray json) {
+			pending->model = std::move(json);
+			finish();
+		}, [=] {
+			pending->failed = true;
+			finish();
+		});
+		GiftStudio::RequestSymbol(cell.collection, symbolName, [=](
+				QByteArray json) {
+			pending->symbol = std::move(json);
+			finish();
+		}, [=] {
+			pending->failed = true;
+			finish();
+		});
+	}, fail);
+}
+
+void Library::resolveRegular(const Cell &cell, Fn<void(Resolved)> done) {
+	const auto id = cell.giftId;
+	catalog([=](const std::vector<Data::StarGift> &) {
+		auto gift = findGift(id);
+		if (!gift) {
+			done(Resolved{ .failed = true });
+			return;
+		}
+		gift->unique = nullptr;
+		gift->auctionSlug = QString();
+		gift->auctionStartDate = 0;
+		gift->requirePremium = false;
+		gift->lockedUntilDate = 0;
+		gift->perUserTotal = 0;
+		gift->perUserRemains = 0;
+		done(Resolved{ .gift = std::move(gift) });
+	});
+}
+
+not_null<DocumentData*> Library::localSticker(
+		const QString &key,
+		const QByteArray &json) {
+	static auto Ids = base::flat_map<QString, DocumentId>();
+	auto &id = Ids[key];
+	if (!id) {
+		id = base::RandomValue<DocumentId>();
+	}
+	const auto document = _session->data().document(
+		id,
+		0,
+		QByteArray(),
+		base::unixtime::now(),
+		QVector<MTPDocumentAttribute>{
+			MTP_documentAttributeSticker(
+				MTP_flags(0),
+				MTP_string(),
+				MTP_inputStickerSetEmpty(),
+				MTPMaskCoords()),
+			MTP_documentAttributeImageSize(
+				MTP_int(kStickerSide),
+				MTP_int(kStickerSide)),
+		},
+		u"application/x-tgsticker"_q,
+		InlineImageLocation(),
+		ImageWithLocation(),
+		ImageWithLocation(),
+		false,
+		0,
+		std::min(int64(json.size()), kReportedSize));
+	auto media = document->createMediaView();
+	media->setBytes(json);
+	_media[key] = std::move(media);
+	return document;
+}
+
+void Library::stickerBytes(
+		not_null<DocumentData*> document,
+		Fn<void(QByteArray)> done) {
+	const auto media = document->createMediaView();
+	const auto read = [=] {
+		auto bytes = media->bytes();
+		if (bytes.isEmpty()) {
+			auto file = QFile(document->filepath());
+			if (file.open(QIODevice::ReadOnly)) {
+				bytes = file.readAll();
+			}
+		}
+		return bytes;
+	};
+	if (media->loaded()) {
+		done(read());
+		return;
+	}
+	_loading.push_back(media);
+	const auto finished = std::make_shared<bool>(false);
+	const auto finish = [=](QByteArray bytes) {
+		if (!*finished) {
+			*finished = true;
+			done(std::move(bytes));
+		}
+	};
+	media->automaticLoad(document->stickerSetOrigin(), nullptr);
+	_session->downloaderTaskFinished(
+	) | rpl::filter([=] {
+		return !*finished && media->loaded();
+	}) | rpl::take(1) | rpl::on_next([=] {
+		finish(read());
+	}, _lifetime);
+	base::call_delayed(kLoadTimeout, this, [=] {
+		finish(media->loaded() ? read() : QByteArray());
+	});
+}
