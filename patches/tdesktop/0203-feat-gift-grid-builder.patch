+std::unique_ptr<Lottie::Instance> MakeLottie(const QByteArray &bytes) {
+	if (bytes.isEmpty()) {
+		return nullptr;
+	}
+	auto result = Lottie::Instance::Create(
+		Lottie::ReadUtf8(Images::UnpackGzip(bytes)),
+		nullptr);
+	if (!result
+		|| result->framesCount() <= 0
+		|| result->frameRate() <= 0.
+		|| result->size().isEmpty()) {
+		return nullptr;
+	}
+	return result;
+}
+
+QImage RenderLottieFrame(const QByteArray &json, QSize size, int frame) {
+	auto instance = MakeLottie(json);
+	if (!instance || size.isEmpty()) {
+		return QImage();
+	}
+	auto result = QImage(size, QImage::Format_ARGB32_Premultiplied);
+	instance->renderToPrepared(
+		result,
+		std::clamp(frame, 0, instance->framesCount() - 1));
+	return result;
+}
