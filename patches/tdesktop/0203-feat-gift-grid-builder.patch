+			break;
+		}
+	});
+
+	state->loadParts = [=] {
+		const auto collection = state->draft.collection;
+		if (collection.isEmpty() || state->partsFor == collection) {
+			return;
+		}
+		library->parts(collection, crl::guard(box, [=](const Parts &parts) {
