+int CatalogList::resizeGetHeight(int newWidth) {
+	const auto rows = (int(_gifts.size()) + kColumns - 1) / kColumns;
+	const auto skip = st::giftBoxGiftSkip.y();
+	return skip * 4 + (rows
+		? (rows * (_single.height() + skip) - skip)
+		: _single.height());
+}
+
+void CatalogList::visibleTopBottomUpdated(int visibleTop, int visibleBottom) {
+	_visibleTop = visibleTop;
+	_visibleBottom = visibleBottom;
+	refreshButtons();
+}
+
+void CatalogList::refreshButtons() {
+	const auto skip = st::giftBoxGiftSkip.y();
+	const auto row = _single.height() + skip;
+	const auto top = skip * 2;
+	const auto rows = (int(_gifts.size()) + kColumns - 1) / kColumns;
+	const auto from = std::clamp(
+		(_visibleTop - top) / row - kPreloadRows,
+		0,
+		rows) * kColumns;
+	const auto till = std::clamp(
+		(_visibleBottom - top) / row + 1 + kPreloadRows,
+		0,
+		rows) * kColumns;
+	const auto count = std::min(till, int(_gifts.size()));
+	auto free = std::vector<int>();
+	for (auto i = 0; i != int(_views.size()); ++i) {
+		auto &view = _views[i];
+		if (view.index < from || view.index >= count) {
+			view.index = -1;
+			view.button->hide();
+			free.push_back(i);
+		}
+	}
+	for (auto index = from; index < count; ++index) {
+		const auto shown = ranges::any_of(_views, [&](const View &view) {
+			return (view.index == index);
+		});
+		if (shown) {
+			continue;
+		}
+		auto slot = 0;
+		if (!free.empty()) {
+			slot = free.back();
+			free.pop_back();
+		} else {
+			slot = int(_views.size());
+			_views.push_back({
+				.button = std::make_unique<Info::PeerGifts::GiftButton>(
+					this,
+					&_delegate),
+			});
+		}
+		auto &view = _views[slot];
+		view.index = index;
+		const auto gift = _gifts[index];
+		view.button->setDescriptor(
+			Info::PeerGifts::GiftTypeStars{ .info = gift },
+			Info::PeerGifts::GiftButtonMode::Full);
+		view.button->setClickedCallback([=] {
+			_chosen(gift);
+		});
+		view.button->setGeometry(cellRect(index), _delegate.buttonExtend());
+		view.button->show();
+	}
+}
+
+void CatalogList::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), st::boxDividerBg);
+	if (_gifts.empty()) {
+		p.setFont(st::normalFont);
+		p.setPen(st::windowSubTextFg);
+		p.drawText(
+			rect(),
+			_loaded
+				? Lower(u"Couldn't load the gift catalog."_q)
+				: Lower(u"Loading\u2026"_q),
+			style::al_center);
+	}
+}
