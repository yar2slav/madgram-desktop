+class GridWidget final : public Ui::RpWidget {
+public:
+	GridWidget(QWidget *parent, std::shared_ptr<Library> library);
+
+	void setCells(std::vector<Cell> cells);
+	[[nodiscard]] std::vector<Cell> cells() const;
+	[[nodiscard]] const Cell &cell(int index) const;
+	[[nodiscard]] int count() const;
+	[[nodiscard]] int rows() const;
+	[[nodiscard]] bool rowEmpty(int row) const;
+	void setCell(int index, Cell cell);
+	void addRow();
+	void removeRow(int row);
+	void collect(Fn<void(std::vector<ExportItem>)> done);
+
+	[[nodiscard]] rpl::producer<int> clicks() const;
+	[[nodiscard]] rpl::producer<std::pair<int, QPoint>> menus() const;
+
+protected:
+	int resizeGetHeight(int newWidth) override;
+	void paintEvent(QPaintEvent *e) override;
+	void mousePressEvent(QMouseEvent *e) override;
+	void mouseMoveEvent(QMouseEvent *e) override;
+	void mouseReleaseEvent(QMouseEvent *e) override;
+	void contextMenuEvent(QContextMenuEvent *e) override;
+	void leaveEventHook(QEvent *e) override;
+	void leaveToChildEvent(QEvent *e, QWidget *child) override;
+
+private:
+	struct View {
+		Cell cell;
+		Cell source;
+		Resolved resolved;
+		bool ready = false;
+		uint64 token = 0;
+		std::unique_ptr<CellDelegate> delegate;
+		std::unique_ptr<Info::PeerGifts::GiftButton> button;
+	};
+
+	[[nodiscard]] QRect cellRect(int position) const;
+	[[nodiscard]] QRect removeRect(int row) const;
+	[[nodiscard]] int positionAt(QPoint point, bool clamp) const;
+	[[nodiscard]] int removeAt(QPoint point) const;
+	[[nodiscard]] int displayPosition(int index) const;
+	[[nodiscard]] int indexOf(not_null<QWidget*> button) const;
+	void refresh(int index);
+	void apply(int index);
+	void createButton(View &view);
+	void layout();
+	void press(int index, QPoint global);
+	void drag(QPoint global);
+	void release(QPoint global);
+	void setOver(int over, int overRemove);
+
+	const std::shared_ptr<Library> _library;
+	std::vector<View> _views;
+	rpl::event_stream<int> _clicks;
+	rpl::event_stream<std::pair<int, QPoint>> _menus;
+	QSize _single;
+	int _over = -1;
+	int _overRemove = -1;
+	int _pressed = -1;
+	int _pressedRemove = -1;
+	QPoint _pressGlobal;
+	QPoint _dragShift;
+	int _dragTarget = -1;
+	bool _dragging = false;
+	uint64 _tokens = 0;
+
+};
+
+GridWidget::GridWidget(QWidget *parent, std::shared_ptr<Library> library)
+: RpWidget(parent)
+, _library(std::move(library))
+, _single(_library->single()) {
+	setMouseTracking(true);
+}
+
+void GridWidget::setCells(std::vector<Cell> cells) {
+	const auto rows = std::clamp(
+		(int(cells.size()) + kColumns - 1) / kColumns,
+		1,
+		kMaxRows);
+	cells.resize(rows * kColumns);
+	_pressed = _pressedRemove = _dragTarget = -1;
+	_dragging = false;
+	_views.clear();
+	_views.reserve(cells.size());
+	for (auto &cell : cells) {
+		_views.push_back({ .cell = std::move(cell) });
+	}
+	for (auto i = 0; i != int(_views.size()); ++i) {
+		refresh(i);
+	}
+	resizeToWidth(width());
+	layout();
+	update();
+}
+
+std::vector<Cell> GridWidget::cells() const {
+	return _views | ranges::views::transform(
+		&View::cell
+	) | ranges::to_vector;
+}
+
+const Cell &GridWidget::cell(int index) const {
+	Expects(index >= 0 && index < int(_views.size()));
+
+	return _views[index].cell;
+}
+
+int GridWidget::count() const {
+	return int(_views.size());
+}
+
+int GridWidget::rows() const {
+	return count() / kColumns;
+}
+
+bool GridWidget::rowEmpty(int row) const {
+	for (auto i = row * kColumns; i != (row + 1) * kColumns; ++i) {
+		if (i < count() && _views[i].cell.kind != CellKind::Empty) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void GridWidget::setCell(int index, Cell cell) {
+	if (index < 0 || index >= count()) {
+		return;
+	}
+	_views[index].cell = std::move(cell);
+	refresh(index);
+}
+
+void GridWidget::addRow() {
+	for (auto i = 0; i != kColumns; ++i) {
+		_views.push_back(View());
+	}
+	resizeToWidth(width());
+	layout();
+	update();
+}
+
+void GridWidget::removeRow(int row) {
+	if (row < 0 || row >= rows()) {
+		return;
+	} else if (rows() == 1) {
+		for (auto i = 0; i != kColumns; ++i) {
+			setCell(i, Cell());
+		}
+		return;
+	}
+	const auto from = begin(_views) + row * kColumns;
+	_views.erase(from, from + kColumns);
+	setOver(-1, -1);
+	resizeToWidth(width());
+	layout();
+	update();
+}
+
+void GridWidget::collect(Fn<void(std::vector<ExportItem>)> done) {
+	struct Pending {
+		std::vector<ExportItem> items;
+		int left = 1;
+	};
+	const auto pending = std::make_shared<Pending>();
+	const auto finish = [=] {
+		if (--pending->left) {
+			return;
+		}
+		auto items = std::move(pending->items);
+		ranges::sort(items, ranges::less(), &ExportItem::index);
+		done(std::move(items));
+	};
+	const auto library = _library;
+	for (auto i = 0; i != count(); ++i) {
+		const auto &view = _views[i];
+		const auto cell = view.cell;
+		if (cell.kind == CellKind::Empty) {
+			continue;
+		}
+		++pending->left;
+		const auto withResolved = [=](Resolved resolved) {
+			if (resolved.failed || !resolved.gift) {
+				finish();
+				return;
+			} else if (cell.kind == CellKind::Unique) {
+				pending->items.push_back({
+					.index = i,
+					.cell = cell,
+					.resolved = resolved,
+					.sticker = resolved.modelJson,
+				});
+				finish();
+				return;
+			}
+			library->stickerBytes(resolved.gift->document, [=](
+					QByteArray bytes) {
+				pending->items.push_back({
+					.index = i,
+					.cell = cell,
+					.resolved = resolved,
+					.sticker = std::move(bytes),
+				});
+				finish();
+			});
+		};
+		if (view.ready && SameSource(view.source, cell)) {
+			withResolved(view.resolved);
+		} else {
+			library->resolve(cell, withResolved);
+		}
+	}
+	finish();
+}
+
+rpl::producer<int> GridWidget::clicks() const {
+	return _clicks.events();
+}
+
+rpl::producer<std::pair<int, QPoint>> GridWidget::menus() const {
+	return _menus.events();
+}
+
+QRect GridWidget::cellRect(int position) const {
+	const auto padding = st::giftBoxPadding;
+	const auto skip = st::giftBoxGiftSkip;
+	const auto available = width() - padding.left() - padding.right();
+	const auto full = kColumns * _single.width() + (kColumns - 1) * skip.x();
+	const auto left = padding.left() + (available - full) / 2;
+	return QRect(
+		left + (position % kColumns) * (_single.width() + skip.x()),
+		padding.bottom()
+			+ (position / kColumns) * (_single.height() + skip.y()),
+		_single.width(),
+		_single.height());
+}
+
+QRect GridWidget::removeRect(int row) const {
+	const auto cell = cellRect(row * kColumns + kColumns - 1);
+	const auto size = style::ConvertScale(22);
+	const auto skip = style::ConvertScale(6);
+	return QRect(
+		cell.x() + cell.width() - size - skip,
+		cell.y() + skip,
+		size,
+		size);
+}
+
+int GridWidget::positionAt(QPoint point, bool clamp) const {
+	if (!count()) {
+		return -1;
+	}
+	const auto first = cellRect(0);
+	const auto skip = st::giftBoxGiftSkip;
+	const auto stepx = _single.width() + skip.x();
+	const auto stepy = _single.height() + skip.y();
+	const auto x = point.x() - first.x() + skip.x() / 2;
+	const auto y = point.y() - first.y() + skip.y() / 2;
+	auto column = (x >= 0) ? (x / stepx) : -1;
+	auto row = (y >= 0) ? (y / stepy) : -1;
+	if (clamp) {
+		column = std::clamp(column, 0, kColumns - 1);
+		row = std::clamp(row, 0, rows() - 1);
+	} else if (column < 0
+		|| column >= kColumns
+		|| row < 0
+		|| row >= rows()) {
+		return -1;
+	}
+	const auto result = row * kColumns + column;
+	return (clamp || cellRect(result).contains(point)) ? result : -1;
+}
+
+int GridWidget::removeAt(QPoint point) const {
+	if (rows() < 2 || _dragging) {
+		return -1;
+	}
+	for (auto row = 0; row != rows(); ++row) {
+		if (rowEmpty(row) && removeRect(row).contains(point)) {
+			return row;
+		}
+	}
+	return -1;
+}
+
+int GridWidget::displayPosition(int index) const {
+	if (!_dragging || _pressed < 0 || _dragTarget < 0) {
+		return index;
+	} else if (index == _pressed) {
+		return _dragTarget;
+	}
+	const auto skipped = (index < _pressed) ? index : (index - 1);
+	return (skipped < _dragTarget) ? skipped : (skipped + 1);
+}
+
+int GridWidget::indexOf(not_null<QWidget*> button) const {
+	for (auto i = 0; i != count(); ++i) {
+		if (_views[i].button.get() == button.get()) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+void GridWidget::refresh(int index) {
+	auto &view = _views[index];
+	if (view.cell.kind == CellKind::Empty) {
+		view.ready = false;
+		view.token = 0;
+		if (view.button) {
+			view.button->hide();
+		}
+		update();
+		return;
+	} else if (view.ready && SameSource(view.cell, view.source)) {
+		apply(index);
+		return;
+	}
+	const auto token = ++_tokens;
+	view.token = token;
+	view.ready = false;
+	if (view.button) {
+		view.button->hide();
+	}
+	update();
+	const auto cell = view.cell;
+	_library->resolve(cell, crl::guard(this, [=](Resolved resolved) {
+		const auto i = ranges::find(_views, token, &View::token);
+		if (i == end(_views)) {
+			return;
+		}
+		i->source = cell;
+		i->resolved = std::move(resolved);
+		i->ready = true;
+		apply(int(i - begin(_views)));
+	}));
+}
+
+void GridWidget::apply(int index) {
+	auto &view = _views[index];
+	if (!view.ready || view.resolved.failed || !view.resolved.gift) {
+		if (view.button) {
+			view.button->hide();
+		}
+		update();
+		return;
+	}
+	if (!view.button) {
+		createButton(view);
+	}
+	view.delegate->setCell(view.cell, view.resolved);
+	view.button->setDescriptor(
+		Descriptor(view.cell, view.resolved),
+		Info::PeerGifts::GiftButtonMode::Minimal);
+	view.button->setGeometry(
+		cellRect(displayPosition(index)),
+		_library->extend());
+	view.button->show();
+	view.button->update();
+	update();
+}
+
+void GridWidget::createButton(View &view) {
+	view.delegate = std::make_unique<CellDelegate>(_library.get());
+	view.button = std::make_unique<Info::PeerGifts::GiftButton>(
+		this,
+		view.delegate.get());
+	const auto raw = view.button.get();
+	raw->mouseEvents() | rpl::on_next([=](QMouseEvent *e) {
+		const auto index = indexOf(raw);
+		if (index < 0) {
+			return;
+		}
+		switch (e->type()) {
+		case QEvent::MouseButtonPress:
+			press(index, e->globalPos());
+			grabMouse();
+			break;
+		case QEvent::MouseButtonRelease:
+			release(e->globalPos());
+			break;
+		default:
+			break;
+		}
+	}, raw->lifetime());
+	raw->contextMenuRequests() | rpl::on_next([=](QPoint global) {
+		if (const auto index = indexOf(raw); index >= 0 && !_dragging) {
+			_menus.fire({ index, global });
+		}
+	}, raw->lifetime());
+}
+
+void GridWidget::layout() {
+	const auto extend = _library->extend();
+	for (auto i = 0; i != count(); ++i) {
+		const auto &view = _views[i];
+		if (view.button && !(_dragging && i == _pressed)) {
+			view.button->setGeometry(
+				cellRect(displayPosition(i)),
+				extend);
+		}
+	}
+}
+
+int GridWidget::resizeGetHeight(int newWidth) {
+	const auto padding = st::giftBoxPadding;
+	const auto skip = st::giftBoxGiftSkip.y();
+	const auto rows = std::max(this->rows(), 1);
+	crl::on_main(this, [=] {
+		layout();
+	});
+	return 2 * padding.bottom() + rows * (_single.height() + skip) - skip;
+}
+
+void GridWidget::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(e->rect(), st::boxDividerBg);
+	for (auto i = 0; i != count(); ++i) {
+		const auto &view = _views[i];
+		if (_dragging && i == _pressed) {
+			continue;
+		}
+		const auto rect = cellRect(displayPosition(i));
+		if (view.cell.kind == CellKind::Empty) {
+			PaintPlaceholder(p, rect, (i == _over), QString());
+		} else if (!view.ready) {
+			PaintPlaceholder(p, rect, false, Lower(u"Loading\u2026"_q));
+		} else if (view.resolved.failed || !view.resolved.gift) {
+			PaintPlaceholder(p, rect, (i == _over), Lower(u"Unavailable"_q));
+		}
+	}
+	if (rows() < 2 || _dragging) {
+		return;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	for (auto row = 0; row != rows(); ++row) {
+		if (!rowEmpty(row)) {
+			continue;
+		}
+		const auto rect = removeRect(row);
+		const auto over = (row == _overRemove);
+		p.setPen(Qt::NoPen);
+		p.setBrush(over ? st::attentionButtonFg : st::windowSubTextFg);
+		p.drawEllipse(rect);
+		auto pen = QPen(st::windowBg->c);
+		pen.setWidthF(style::ConvertScaleExact(1.5));
+		pen.setCapStyle(Qt::RoundCap);
+		p.setPen(pen);
+		const auto inset = rect.width() / 3.;
+		const auto inner = QRectF(rect).marginsRemoved(
+			{ inset, inset, inset, inset });
+		p.drawLine(inner.topLeft(), inner.bottomRight());
+		p.drawLine(inner.topRight(), inner.bottomLeft());
+	}
+}
+
+void GridWidget::setOver(int over, int overRemove) {
+	if (_over == over && _overRemove == overRemove) {
+		return;
+	}
+	_over = over;
+	_overRemove = overRemove;
+	setCursor((over >= 0 || overRemove >= 0)
+		? style::cur_pointer
+		: style::cur_default);
+	update();
+}
+
+void GridWidget::mousePressEvent(QMouseEvent *e) {
+	if (e->button() != Qt::LeftButton) {
+		return;
+	}
+	if (const auto row = removeAt(e->pos()); row >= 0) {
+		_pressedRemove = row;
+		return;
+	}
+	if (const auto position = positionAt(e->pos(), false); position >= 0) {
+		press(position, e->globalPos());
+	}
+}
+
+void GridWidget::mouseMoveEvent(QMouseEvent *e) {
+	if (_pressed >= 0) {
+		drag(e->globalPos());
+		return;
+	}
+	const auto remove = removeAt(e->pos());
+	const auto position = (remove >= 0) ? -1 : positionAt(e->pos(), false);
+	const auto empty = (position >= 0)
+		&& (_views[position].cell.kind == CellKind::Empty
+			|| !_views[position].button
+			|| _views[position].button->isHidden());
+	setOver(empty ? position : -1, remove);
+}
+
+void GridWidget::mouseReleaseEvent(QMouseEvent *e) {
+	if (_pressedRemove >= 0) {
+		const auto row = std::exchange(_pressedRemove, -1);
+		if (removeAt(e->pos()) == row) {
+			removeRow(row);
+		}
+		return;
+	}
+	release(e->globalPos());
+}
+
+void GridWidget::contextMenuEvent(QContextMenuEvent *e) {
+	if (_dragging) {
+		return;
+	}
+	if (const auto position = positionAt(e->pos(), false); position >= 0) {
+		_menus.fire({ position, e->globalPos() });
+	}
+}
+
+void GridWidget::leaveEventHook(QEvent *e) {
+	if (_pressed < 0) {
+		setOver(-1, -1);
+	}
+}
+
+void GridWidget::leaveToChildEvent(QEvent *e, QWidget *child) {
+	if (_pressed < 0) {
+		setOver(-1, -1);
+	}
+}
+
+void GridWidget::press(int index, QPoint global) {
+	_pressed = index;
+	_pressGlobal = global;
+	_dragging = false;
+	_dragTarget = -1;
+}
+
+void GridWidget::drag(QPoint global) {
+	if (_pressed < 0 || _pressed >= count()) {
+		return;
+	}
+	auto &view = _views[_pressed];
+	if (!_dragging) {
+		if ((global - _pressGlobal).manhattanLength()
+				< QApplication::startDragDistance()
+			|| !view.button
+			|| view.button->isHidden()) {
+			return;
+		}
+		_dragging = true;
+		_dragTarget = _pressed;
+		_dragShift = mapFromGlobal(_pressGlobal) - cellRect(_pressed).topLeft();
+		view.button->raise();
+		setOver(-1, -1);
+	}
+	const auto topLeft = mapFromGlobal(global) - _dragShift;
+	const auto center = topLeft + QPoint(
+		_single.width() / 2,
+		_single.height() / 2);
+	const auto target = positionAt(center, true);
+	if (target != _dragTarget) {
+		_dragTarget = target;
+		layout();
+		update();
+	}
+	view.button->setGeometry(
+		QRect(topLeft, _single),
+		_library->extend());
+}
+
+void GridWidget::release(QPoint global) {
+	releaseMouse();
+	const auto pressed = std::exchange(_pressed, -1);
+	if (pressed < 0 || pressed >= count()) {
+		_dragging = false;
+		return;
+	}
+	if (_dragging) {
+		_dragging = false;
+		const auto target = std::exchange(_dragTarget, -1);
+		if (target >= 0 && target < count() && target != pressed) {
+			auto view = std::move(_views[pressed]);
+			_views.erase(begin(_views) + pressed);
+			_views.insert(begin(_views) + target, std::move(view));
+		}
+		layout();
+		update();
+		return;
+	}
+	if (positionAt(mapFromGlobal(global), false) == pressed) {
+		_clicks.fire_copy(pressed);
+	}
+}
+
+void SavedGridsBox(
+		not_null<Ui::GenericBox*> box,
+		Fn<void(SavedGrid)> load) {
+	box->setTitle(rpl::single(Lower(u"Saved grids"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto content = box->verticalLayout();
+	const auto list = content->add(object_ptr<Ui::VerticalLayout>(content));
+	const auto fill = [=] {
+		list->clear();
+		const auto &grids = GiftStudio::Grids();
+		if (grids.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"Nothing saved yet."_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		for (auto i = 0; i != int(grids.size()); ++i) {
+			const auto grid = grids[i];
+			const auto button = list->add(object_ptr<Ui::SettingsButton>(
+				list,
+				rpl::single(grid.name),
+				st::settingsButtonNoIcon));
+			button->setClickedCallback([=] {
+				load(grid);
+				box->closeBox();
+			});
+			const auto cross = Ui::CreateChild<Ui::IconButton>(
+				button,
+				st::boxTitleClose);
+			button->widthValue() | rpl::on_next([=](int width) {
+				cross->moveToRight(
+					0,
+					(button->height() - cross->height()) / 2,
+					width);
+			}, cross->lifetime());
+			cross->setClickedCallback([=] {
+				GiftStudio::RemoveGrid(i);
+			});
+			const auto cells = ParseCells(grid.cells);
+			const auto gifts = ranges::count_if(cells, [](const Cell &cell) {
+				return (cell.kind != CellKind::Empty);
+			});
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"%1 gifts in %2 rows"_q)
+						.arg(gifts)
+						.arg(cells.size() / kColumns),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		list->resizeToWidth(content->width());
+	};
+	fill();
+	GiftStudio::StoreChanges() | rpl::on_next([=] {
+		crl::on_main(list, fill);
+	}, list->lifetime());
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+void ExportBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<ChatHelpers::Show> show,
+		std::shared_ptr<Library> library,
+		int count,
+		Fn<void(Fn<void(std::vector<ExportItem>)>)> collect) {
+	struct State {
+		int scale = kDefaultScale;
+		Background background = Background::Profile;
+		bool frame = false;
+		bool busy = false;
+		std::shared_ptr<std::atomic<bool>> alive
+			= std::make_shared<std::atomic<bool>>(true);
+		rpl::variable<QString> status;
+		Fn<void()> refresh;
+	};
+	const auto state = box->lifetime().make_state<State>();
+	box->lifetime().add([alive = state->alive] {
+		*alive = false;
+	});
+
+	box->setTitle(rpl::single(Lower(u"Export grid"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto content = box->verticalLayout();
+
+	Ui::AddSubsectionTitle(content, rpl::single(Lower(u"Scale"_q)));
+	const auto scales = content->add(
+		object_ptr<Ui::SettingsSlider>(content, st::defaultTabsSlider),
+		st::boxRowPadding);
+	auto labels = std::vector<QString>();
+	for (const auto scale : kScales) {
+		labels.push_back(QString::number(scale) + u"\u00D7"_q);
+	}
+	scales->setSections(labels);
+	scales->setActiveSectionFast(int(ranges::find(kScales, state->scale)
+		- begin(kScales)));
+	scales->sectionActivated() | rpl::on_next([=](int section) {
+		state->scale = kScales[std::clamp(section, 0, int(kScales.size()) - 1)];
+		state->refresh();
+	}, scales->lifetime());
+	Ui::AddSkip(content);
+
+	const auto frame = content->add(
+		object_ptr<Ui::Checkbox>(
+			content,
+			Lower(u"Profile frame"_q),
+			state->frame,
+			st::defaultBoxCheckbox),
+		st::boxRowPadding);
+	content->add(
+		object_ptr<Ui::FlatLabel>(
+			content,
+			Lower(u"Adds the Gifts tab header, like a profile screenshot."_q),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	const auto backgroundWrap = content->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			content,
+			object_ptr<Ui::VerticalLayout>(content)));
+	const auto backgrounds = backgroundWrap->entity();
+	Ui::AddSkip(backgrounds);
+	Ui::AddSubsectionTitle(backgrounds, rpl::single(Lower(u"Background"_q)));
+	const auto group = std::make_shared<Ui::RadioenumGroup<Background>>(
+		state->background);
+	const auto radio = [&](Background value, const QString &text) {
+		backgrounds->add(
+			object_ptr<Ui::Radioenum<Background>>(
+				backgrounds,
+				group,
+				value,
+				Lower(text),
+				st::defaultBoxCheckbox),
+			st::boxRowPadding
+				+ QMargins(0, st::defaultVerticalListSkip, 0, 0));
+	};
+	radio(Background::Profile, u"Profile background"_q);
+	radio(Background::Transparent, u"Transparent"_q);
+	group->setChangedCallback([=](Background value) {
+		state->background = value;
+		state->refresh();
+	});
+	frame->checkedChanges() | rpl::on_next([=](bool checked) {
+		state->frame = checked;
+		backgroundWrap->toggle(!checked, anim::type::normal);
+		state->refresh();
+	}, frame->lifetime());
+
+	Ui::AddSkip(content);
+	const auto size = content->add(
+		object_ptr<Ui::FlatLabel>(content, QString(), st::boxDividerLabel),
+		st::boxRowPadding);
+	content->add(
+		object_ptr<Ui::FlatLabel>(
+			content,
+			state->status.value(),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	Ui::AddSkip(content);
+
+	const auto options = [=] {
+		return ExportOptions{
+			.scale = state->scale,
+			.transparent = !state->frame
+				&& (state->background == Background::Transparent),
+			.frame = state->frame,
+		};
+	};
+	state->refresh = [=] {
+		const auto now = options();
+		const auto still = ExportSize(library.get(), count, now);
+		const auto mp4 = GiftStudio::Mp4Size(still);
+		auto text = Lower(u"PNG and GIF: %1 \u00D7 %2 px, MP4: %3 \u00D7 %4 px."_q)
+			.arg(still.width())
+			.arg(still.height())
+			.arg(mp4.width())
+			.arg(mp4.height());
+		if (now.transparent) {
+			text += ' ' + Lower(u"MP4 can't be transparent, "
+				"so it gets the profile background."_q);
+		}
+		size->setText(text);
+	};
+	state->refresh();
+
+	const auto writeFile = [](const QString &path, const QByteArray &bytes) {
+		auto file = QFile(path);
+		return file.open(QIODevice::WriteOnly)
+			&& (file.write(bytes) == bytes.size());
+	};
+	const auto saveBytes = [=](
+			QByteArray bytes,
+			QString format,
+			QSize dimensions,
+			QString filter,
+			QString extension) {
+		FileDialog::GetWritePath(
+			Core::App().getFileDialogParent(),
+			Lower(u"Save %1 (%2 \u00D7 %3)"_q)
+				.arg(format)
+				.arg(dimensions.width())
+				.arg(dimensions.height()),
+			filter + u";;"_q + FileDialog::AllFilesFilter(),
+			filedialogDefaultName(u"gift grid"_q, extension),
+			crl::guard(box, [=](const QString &path) {
+				if (path.isEmpty()) {
+					return;
+				}
+				show->showToast(writeFile(path, bytes)
+					? Lower(u"Saved."_q)
+					: Lower(u"Couldn't save the file."_q));
+			}));
+	};
+	const auto prepare = [=](
+			bool opaque,
+			Fn<void(std::shared_ptr<const Scene>)> next) {
+		if (state->busy) {
+			show->showToast(Lower(u"Still rendering the previous file."_q));
+			return;
+		}
+		state->busy = true;
+		state->status = Lower(u"Preparing the gifts\u2026"_q);
+		auto now = options();
+		if (opaque) {
+			now.transparent = false;
+		}
+		collect(crl::guard(box, [=](std::vector<ExportItem> items) {
+			if (items.empty()) {
+				state->busy = false;
+				state->status = QString();
+				show->showToast(Lower(u"The grid has no gifts yet."_q));
+				return;
+			}
+			next(PrepareScene(library.get(), items, count, now));
+		}));
+	};
+	const auto still = [=](Fn<void(QImage)> done) {
+		const auto transparent = options().transparent;
+		prepare(false, [=](std::shared_ptr<const Scene> scene) {
+			auto image = RenderStill(scene);
+			state->busy = false;
+			state->status = QString();
+			if (!transparent) {
+				image = std::move(image).convertToFormat(
+					QImage::Format_RGB32);
+			}
+			done(std::move(image));
+		});
+	};
+	const auto animate = [=](bool gif) {
+		const auto format = gif ? u"GIF"_q : u"MP4"_q;
+		if (!gif
+			&& !GiftStudio::VideoFormatAvailable(
+				GiftStudio::VideoFormat::Mp4)) {
+			show->showToast(Lower(u"This build has no H.264 encoder."_q));
+			return;
+		}
+		prepare(!gif, [=](std::shared_ptr<const Scene> scene) {
+			const auto alive = state->alive;
+			const auto dimensions = gif
+				? SceneSize(scene)
+				: SceneMp4Size(scene);
+			state->status = Lower(u"Rendering the %1\u2026"_q).arg(format);
+			const auto progress = [=](int done, int total) {
+				crl::on_main([=] {
+					if (alive->load() && state->busy) {
+						state->status = Lower(u"Rendering the %1: %2%"_q)
+							.arg(format)
+							.arg(done * 100 / std::max(total, 1));
+					}
+				});
+			};
+			const auto check = [=] {
+				return alive->load();
+			};
+			crl::async([=] {
+				auto bytes = gif
+					? EncodeSceneGif(scene, progress, check)
+					: EncodeSceneMp4(scene, progress, check);
+				crl::on_main([=, bytes = std::move(bytes)] {
+					if (!alive->load()) {
+						return;
+					}
+					state->busy = false;
+					state->status = QString();
+					if (bytes.isEmpty()) {
+						show->showToast(
+							Lower(u"Couldn't render the %1."_q).arg(format));
+						return;
+					}
+					saveBytes(
+						bytes,
+						format,
+						dimensions,
+						gif ? u"GIF Image (*.gif)"_q : u"MP4 Video (*.mp4)"_q,
+						gif ? u".gif"_q : u".mp4"_q);
+				});
+			});
+		});
+	};
+
+	const auto action = [&](
+			const QString &text,
+			const style::icon &icon,
+			Fn<void()> callback) {
+		Settings::AddButtonWithIcon(
+			content,
+			rpl::single(Lower(text)),
+			st::settingsButton,
+			{ &icon }
+		)->setClickedCallback(std::move(callback));
+	};
+	action(u"Save PNG"_q, st::menuIconSaveImage, [=] {
+		still([=](QImage image) {
+			auto bytes = QByteArray();
+			auto buffer = QBuffer(&bytes);
+			buffer.open(QIODevice::WriteOnly);
+			image.save(&buffer, "PNG");
+			buffer.close();
+			if (bytes.isEmpty()) {
+				show->showToast(Lower(u"Couldn't render the PNG."_q));
+				return;
+			}
+			saveBytes(
+				bytes,
+				u"PNG"_q,
+				image.size(),
+				u"PNG Image (*.png)"_q,
+				u".png"_q);
+		});
+	});
+	action(u"Copy PNG"_q, st::menuIconCopy, [=] {
+		still([=](QImage image) {
+			QGuiApplication::clipboard()->setImage(image);
+			show->showToast(Lower(u"Copied to the clipboard."_q));
+		});
+	});
+	action(u"Save GIF"_q, st::menuIconGif, [=] {
+		animate(true);
+	});
+	action(u"Save MP4"_q, st::menuIconExport, [=] {
+		animate(false);
+	});
+
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+void GiftGridBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		StudioCombo studio) {
+	struct State {
+		std::shared_ptr<Library> library;
+		QString name;
+		base::unique_qptr<Ui::PopupMenu> menu;
+	};
+	const auto state = box->lifetime().make_state<State>();
+	const auto show = controller->uiShow();
+	state->library = std::make_shared<Library>(&controller->session());
+	const auto library = state->library;
+
+	box->setTitle(rpl::single(Lower(u"Gift grid"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto grid = box->addRow(
+		object_ptr<GridWidget>(box, library),
+		style::margins());
+	grid->setCells(std::vector<Cell>(kColumns));
+	Ui::AddSkip(box->verticalLayout());
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			Lower(u"Click a cell to set any gift, drag gifts to reorder "
+				"them, right-click for more."_q),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	Ui::AddSkip(box->verticalLayout());
+
+	const auto edit = [=](int index) {
+		if (index < 0 || index >= grid->count()) {
+			return;
+		}
+		show->showBox(Box(EditCellBox, EditorArgs{
+			.show = show,
+			.library = library,
+			.cell = grid->cell(index),
+			.studio = studio,
+			.done = crl::guard(grid, [=](Cell cell) {
+				grid->setCell(index, std::move(cell));
+			}),
+		}));
+	};
+	const auto update = [=](int index, Fn<void(Cell&)> change) {
+		if (index < 0 || index >= grid->count()) {
+			return;
+		}
+		auto cell = grid->cell(index);
+		change(cell);
+		grid->setCell(index, std::move(cell));
+	};
+	const auto duplicate = [=](int index) {
+		const auto cell = grid->cell(index);
+		auto target = -1;
+		for (auto i = index + 1; i < grid->count(); ++i) {
+			if (grid->cell(i).kind == CellKind::Empty) {
+				target = i;
+				break;
+			}
+		}
+		if (target < 0) {
+			if (grid->rows() >= kMaxRows) {
+				show->showToast(Lower(u"The grid is full."_q));
+				return;
+			}
+			target = grid->count();
+			grid->addRow();
+		}
+		grid->setCell(target, cell);
+	};
+	grid->clicks() | rpl::on_next(edit, grid->lifetime());
+	grid->menus() | rpl::on_next([=](std::pair<int, QPoint> request) {
+		const auto index = request.first;
+		if (index < 0 || index >= grid->count()) {
+			return;
+		}
+		const auto cell = grid->cell(index);
+		const auto row = index / kColumns;
+		state->menu = base::make_unique_q<Ui::PopupMenu>(
+			grid,
+			st::popupMenuWithIcons);
+		const auto menu = state->menu.get();
+		if (cell.kind == CellKind::Empty) {
+			menu->addAction(Lower(u"Set a gift"_q), [=] {
+				edit(index);
+			}, &st::menuIconAdd);
+		} else {
+			menu->addAction(Lower(u"Edit"_q), [=] {
+				edit(index);
+			}, &st::menuIconEdit);
+			menu->addAction(Lower(u"Duplicate"_q), [=] {
+				duplicate(index);
+			}, &st::menuIconCopy);
+			if (CanPin(cell)) {
+				menu->addAction(
+					cell.pinned ? Lower(u"Unpin"_q) : Lower(u"Pin"_q),
+					[=] { update(index, [](Cell &c) { c.pinned = !c.pinned; }); },
+					cell.pinned ? &st::menuIconUnpin : &st::menuIconPin);
+			}
+			menu->addAction(
+				cell.hidden
+					? Lower(u"Remove the hidden mark"_q)
+					: Lower(u"Mark as hidden"_q),
+				[=] { update(index, [](Cell &c) { c.hidden = !c.hidden; }); },
+				&st::menuIconStealth);
+			menu->addAction(Lower(u"Ribbon text\u2026"_q), [=] {
+				const auto now = grid->cell(index);
+				show->showBox(Box(
+					RibbonTextBox,
+					(now.ribbon == Ribbon::Custom) ? now.ribbonText : QString(),
+					crl::guard(grid, [=](QString text) {
+						update(index, [&](Cell &c) {
+							c.ribbonText = text;
+							c.ribbon = text.isEmpty()
+								? Ribbon::Auto
+								: Ribbon::Custom;
+						});
+					})));
+			}, &st::menuIconChangeColors);
+			menu->addAction(Lower(u"Remove"_q), [=] {
+				grid->setCell(index, Cell());
+			}, &st::menuIconDelete);
+		}
+		if (grid->rows() > 1) {
+			menu->addSeparator();
+			menu->addAction(Lower(u"Remove row"_q), [=] {
+				grid->removeRow(row);
+			}, &st::menuIconRemove);
+		}
+		menu->popup(request.second);
+	}, grid->lifetime());
+
+	box->addTopButton(st::boxTitleMenu, [=] {
+		state->menu = base::make_unique_q<Ui::PopupMenu>(
+			box,
+			st::popupMenuWithIcons);
+		const auto menu = state->menu.get();
+		menu->addAction(Lower(u"Save grid\u2026"_q), [=] {
+			show->showBox(Box(
+				GiftStudio::ChooseNameBox,
+				Lower(u"Save grid"_q),
+				state->name.isEmpty() ? Lower(u"My grid"_q) : state->name,
+				crl::guard(box, [=](QString name) {
+					state->name = name;
+					GiftStudio::SaveGrid({
+						.name = name,
+						.cells = SerializeCells(grid->cells()),
+					});
+					show->showToast(Lower(u"Grid saved."_q));
+				})));
+		}, &st::menuIconFave);
+		menu->addAction(Lower(u"Saved grids"_q), [=] {
+			show->showBox(Box(SavedGridsBox, crl::guard(box, [=](
+					SavedGrid saved) {
+				state->name = saved.name;
+				grid->setCells(ParseCells(saved.cells));
+			})));
+		}, &st::menuIconArchive);
+		menu->addSeparator();
+		menu->addAction(Lower(u"Clear grid"_q), [=] {
+			grid->setCells(std::vector<Cell>(kColumns));
+		}, &st::menuIconClear);
+		menu->popup(QCursor::pos());
+	});
+
+	box->addButton(rpl::single(Lower(u"Export"_q)), [=] {
+		const auto count = grid->count();
+		const auto weak = base::make_weak(grid);
+		show->showBox(Box(
+			ExportBox,
+			show,
+			library,
+			count,
+			[=](Fn<void(std::vector<ExportItem>)> done) {
+				if (const auto strong = weak.get()) {
+					strong->collect(std::move(done));
+				}
+			}));
+	});
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Add row"_q)), [=] {
+		if (grid->rows() >= kMaxRows) {
+			show->showToast(Lower(u"The grid is full."_q));
+			return;
+		}
+		grid->addRow();
+	});
+}
