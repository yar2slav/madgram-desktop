+[[nodiscard]] QString RibbonName(Ribbon ribbon) {
+	switch (ribbon) {
+	case Ribbon::Auto: return u"auto"_q;
+	case Ribbon::None: return u"none"_q;
+	case Ribbon::Limited: return u"limited"_q;
+	case Ribbon::SoldOut: return u"sold_out"_q;
+	case Ribbon::Custom: return u"custom"_q;
+	}
+	return u"auto"_q;
+}
+
+[[nodiscard]] Ribbon ParseRibbon(const QString &name) {
+	return (name == u"none"_q)
+		? Ribbon::None
+		: (name == u"limited"_q)
+		? Ribbon::Limited
+		: (name == u"sold_out"_q)
+		? Ribbon::SoldOut
+		: (name == u"custom"_q)
+		? Ribbon::Custom
+		: Ribbon::Auto;
+}
+
+template <typename List>
+[[nodiscard]] auto FindByName(const List &list, const QString &name)
+-> const typename List::value_type * {
+	for (const auto &item : list) {
+		if (item.name == name) {
+			return &item;
+		}
+	}
+	for (const auto &item : list) {
+		if (!item.name.compare(name, Qt::CaseInsensitive)) {
+			return &item;
+		}
+	}
+	return nullptr;
+}
