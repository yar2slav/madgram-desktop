+
+Preview::Preview(QWidget *parent, std::shared_ptr<Library> library)
+: RpWidget(parent)
+, _library(std::move(library))
+, _delegate(_library.get())
+, _button(std::make_unique<Info::PeerGifts::GiftButton>(this, &_delegate)) {
+	_button->setAttribute(Qt::WA_TransparentForMouseEvents);
+	_button->hide();
+	widthValue() | rpl::on_next([=] {
+		place();
+	}, lifetime());
+}
+
+const Resolved &Preview::resolved() const {
+	return _resolved;
+}
+
+void Preview::setStatus(const QString &status) {
+	++_token;
+	_ready = false;
+	_status = status;
+	_button->hide();
+	update();
+}
+
+void Preview::setCell(const Cell &cell) {
+	_cell = cell;
+	if (_ready && SameSource(cell, _source)) {
+		apply();
+		return;
+	}
+	const auto token = ++_token;
+	_ready = false;
+	_status = Lower(u"Loading\u2026"_q);
+	_button->hide();
+	update();
+	_library->resolve(cell, crl::guard(this, [=](Resolved resolved) {
+		if (_token != token) {
+			return;
+		}
+		_source = cell;
+		_resolved = std::move(resolved);
+		_ready = true;
+		apply();
+	}));
+}
+
+void Preview::apply() {
+	if (_cell.kind == CellKind::Empty) {
+		_status = Lower(u"Pick a gift."_q);
+		_button->hide();
+	} else if (_resolved.failed || !_resolved.gift) {
+		_status = (_cell.kind == CellKind::Regular && !_cell.giftId)
+			? Lower(u"Choose a gift from the catalog."_q)
+			: Lower(u"Couldn't load this gift."_q);
+		_button->hide();
+	} else {
+		_status = QString();
+		_delegate.setCell(_cell, _resolved);
+		_button->setDescriptor(
+			Descriptor(_cell, _resolved),
+			Info::PeerGifts::GiftButtonMode::Minimal);
+		place();
+		_button->show();
+		_button->update();
+	}
+	update();
+}
+
+void Preview::place() {
+	const auto single = _library->single();
+	_button->setGeometry(
+		QRect(
+			(width() - single.width()) / 2,
+			st::giftBoxGiftSkip.y() * 2,
+			single.width(),
+			single.height()),
+		_library->extend());
+}
+
+int Preview::resizeGetHeight(int newWidth) {
+	return _library->single().height() + st::giftBoxGiftSkip.y() * 4;
+}
+
+void Preview::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(rect(), st::boxDividerBg);
+	if (!_status.isEmpty()) {
+		p.setFont(st::normalFont);
+		p.setPen(st::windowSubTextFg);
+		p.drawText(rect(), _status, style::al_center);
+	}
+}
