+constexpr auto kMaxFrames = 1800;
+constexpr auto kGifFpsLimit = 50.;
+constexpr auto kMaxFps = 60.;
+constexpr auto kFallbackFps = 30.;
+
+struct Geometry {
+	QSize size;
+	QPoint origin;
+	int topBar = 0;
+	QSize single;
+	QMargins extend;
+	QPoint skip;
+	float64 factor = 1.;
+	int icons = 100;
+};
+
+[[nodiscard]] Geometry ComputeGeometry(
+		not_null<Library*> library,
+		int count,
+		const ExportOptions &options) {
+	const auto single = library->single();
+	const auto skip = st::giftBoxGiftSkip;
+	const auto padding = st::giftBoxPadding;
+	const auto rows = std::max((count + kColumns - 1) / kColumns, 1);
+	const auto gridWidth = kColumns * single.width()
+		+ (kColumns - 1) * skip.x();
+	const auto gridHeight = rows * single.height() + (rows - 1) * skip.y();
+	auto result = Geometry{
+		.single = single,
+		.extend = library->extend(),
+		.skip = skip,
+		.factor = std::clamp(options.scale, 1, 4) * 100. / style::Scale(),
+		.icons = std::clamp(options.scale, 1, 4) * 100,
+	};
+	if (options.frame) {
+		result.topBar = st::infoTopBar.height;
+		result.origin = QPoint(
+			padding.left(),
+			result.topBar + padding.bottom());
+		result.size = QSize(
+			padding.left() + gridWidth + padding.right(),
+			result.topBar + 2 * padding.bottom() + gridHeight);
+	} else {
+		const auto margin = padding.left();
+		result.origin = QPoint(margin, margin);
+		result.size = QSize(gridWidth + 2 * margin, gridHeight + 2 * margin);
+	}
+	return result;
+}
+
+[[nodiscard]] QSize PixelSize(const Geometry &geometry) {
+	return QSize(
+		std::max(int(base::SafeRound(
+			geometry.size.width() * geometry.factor)), 2),
+		std::max(int(base::SafeRound(
+			geometry.size.height() * geometry.factor)), 2));
+}
+
+[[nodiscard]] QRect InnerRect(const Geometry &geometry, int index) {
+	const auto column = index % kColumns;
+	const auto row = index / kColumns;
+	return QRect(
+		geometry.origin + QPoint(
+			column * (geometry.single.width() + geometry.skip.x()),
+			row * (geometry.single.height() + geometry.skip.y())),
+		geometry.single);
+}
+
+[[nodiscard]] QRect ToPixels(QRect rect, float64 factor) {
+	const auto left = int(base::SafeRound(rect.x() * factor));
+	const auto top = int(base::SafeRound(rect.y() * factor));
+	return QRect(
+		left,
+		top,
+		std::max(int(base::SafeRound(rect.width() * factor)), 1),
+		std::max(int(base::SafeRound(rect.height() * factor)), 1));
+}
+
+[[nodiscard]] QImage ShadowImage(
+		QSize single,
+		QMargins extend,
+		float64 factor) {
+	const auto size = single.grownBy(extend);
+	const auto ratio = style::DevicePixelRatio();
+	auto result = QImage(size * ratio, QImage::Format_ARGB32_Premultiplied);
+	result.setDevicePixelRatio(ratio);
+	result.fill(Qt::transparent);
+	const auto radius = st::giftBoxGiftRadius;
+	const auto rect = QRect(QPoint(), size).marginsRemoved(extend);
+	{
+		auto p = QPainter(&result);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setOpacity(0.3);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowShadowFg);
+		p.drawRoundedRect(
+			QRectF(rect).translated(0, radius / 12.),
+			radius,
+			radius);
+	}
+	result = result.scaled(
+		(size * ratio) / 2,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+	result = Images::Blur(std::move(result), true);
+	return result.scaled(
+		QSize(
+			std::max(int(std::ceil(size.width() * factor)), 1),
+			std::max(int(std::ceil(size.height() * factor)), 1)),
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+}
+
+[[nodiscard]] QImage Tinted(QImage image, QColor color) {
+	if (image.isNull()) {
+		return image;
+	}
+	auto p = QPainter(&image);
+	p.setCompositionMode(QPainter::CompositionMode_SourceIn);
+	p.fillRect(QRect(QPoint(), image.size()), color);
+	p.end();
+	return image;
+}
+
+void PaintIcon(
+		QPainter &p,
+		const style::icon &icon,
+		QColor color,
+		QPoint position,
+		int scale) {
+	auto hq = PainterHighQualityEnabler(p);
+	p.drawImage(
+		QRect(position, icon.size()),
+		icon.instance(color, scale, true));
+}
