+	std::vector<PickerRow> _rows;
+	Fn<void(QPainter&, QRect, int)> _preview;
+	rpl::event_stream<int> _chosen;
+	int _selected = -1;
+	int _over = -1;
+	int _pressed = -1;
+
+};
