+QJsonObject SerializeCell(const Cell &cell) {
+	auto result = QJsonObject();
+	switch (cell.kind) {
+	case CellKind::Empty:
+		return result;
+	case CellKind::Unique:
+		result.insert(u"kind"_q, u"unique"_q);
+		result.insert(u"collection"_q, cell.collection);
+		result.insert(u"model"_q, cell.model);
+		result.insert(u"backdrop"_q, cell.backdrop);
+		result.insert(u"symbol"_q, cell.symbol);
+		result.insert(u"number"_q, cell.number);
+		break;
+	case CellKind::Regular:
+		result.insert(u"kind"_q, u"gift"_q);
+		result.insert(u"gift"_q, QString::number(cell.giftId));
+		result.insert(u"price"_q, cell.price);
+		break;
+	}
+	result.insert(u"ribbon"_q, RibbonName(cell.ribbon));
+	if (!cell.ribbonText.isEmpty()) {
+		result.insert(u"ribbon_text"_q, cell.ribbonText);
+	}
+	if (cell.ribbonColor.isValid()) {
+		result.insert(
+			u"ribbon_color"_q,
+			cell.ribbonColor.name(QColor::HexRgb));
+	}
+	if (cell.pinned) {
+		result.insert(u"pinned"_q, true);
+	}
+	if (cell.hidden) {
+		result.insert(u"hidden"_q, true);
+	}
+	return result;
+}
+
+Cell ParseCell(const QJsonObject &object) {
+	auto result = Cell();
+	const auto text = [&](const QString &key) {
+		return object.value(key).toString().left(kMaxName);
+	};
+	const auto kind = object.value(u"kind"_q).toString();
+	if (kind == u"unique"_q) {
+		result.kind = CellKind::Unique;
+		result.collection = text(u"collection"_q);
+		result.model = text(u"model"_q);
+		result.backdrop = text(u"backdrop"_q);
+		result.symbol = text(u"symbol"_q);
+		result.number = std::clamp(
+			object.value(u"number"_q).toInt(1),
+			0,
+			kMaxNumber);
+		if (result.collection.isEmpty()
+			|| result.model.isEmpty()
+			|| result.backdrop.isEmpty()
+			|| result.symbol.isEmpty()) {
+			return Cell();
+		}
+	} else if (kind == u"gift"_q) {
+		result.kind = CellKind::Regular;
+		result.giftId = object.value(u"gift"_q).toString().toULongLong();
+		result.price = object.value(u"price"_q).toBool(true);
+		if (!result.giftId) {
+			return Cell();
+		}
+	} else {
+		return Cell();
+	}
+	result.ribbon = ParseRibbon(object.value(u"ribbon"_q).toString());
+	result.ribbonText = object.value(
+		u"ribbon_text"_q).toString().left(kMaxRibbon);
+	const auto color = QColor(object.value(u"ribbon_color"_q).toString());
+	if (color.isValid()) {
+		result.ribbonColor = color;
+	}
+	result.pinned = object.value(u"pinned"_q).toBool()
+		&& (result.kind == CellKind::Unique);
+	result.hidden = object.value(u"hidden"_q).toBool();
+	return result;
+}
+
+int ParseNumber(const QString &text) {
+	auto digits = QString();
+	for (const auto &ch : text) {
+		if (ch.isDigit()) {
+			digits.append(ch);
+		}
+	}
+	if (digits.isEmpty()) {
+		return -1;
+	}
+	auto ok = false;
+	const auto value = digits.left(9).toInt(&ok);
+	return ok ? std::clamp(value, 0, kMaxNumber) : -1;
+}
+
+bool CanPin(const Cell &cell) {
+	return (cell.kind == CellKind::Unique);
+}
+
+bool SameSource(const Cell &a, const Cell &b) {
+	return (a.kind == b.kind)
+		&& (a.collection == b.collection)
+		&& (a.model == b.model)
+		&& (a.backdrop == b.backdrop)
+		&& (a.symbol == b.symbol)
+		&& (a.giftId == b.giftId);
+}
+
+RibbonLook ComputeRibbon(const Cell &cell, const Resolved &resolved) {
+	const auto unique = (cell.kind == CellKind::Unique);
+	auto kind = cell.ribbon;
+	if (kind == Ribbon::Auto && !unique) {
+		const auto &gift = resolved.gift;
+		kind = (!gift || !gift->limitedCount)
+			? Ribbon::None
+			: (gift->soldOut || !gift->limitedLeft)
+			? Ribbon::SoldOut
+			: Ribbon::Limited;
+	}
+	auto result = RibbonLook();
+	switch (kind) {
+	case Ribbon::None:
+		return result;
+	case Ribbon::Auto:
+		result.text = '#' + Lang::FormatCountDecimal(cell.number);
+		break;
+	case Ribbon::Limited:
+		result.text = tr::lng_gift_stars_limited(tr::now);
+		break;
+	case Ribbon::SoldOut:
+		result.text = tr::lng_gift_stars_sold_out(tr::now);
+		break;
+	case Ribbon::Custom:
+		result.text = cell.ribbonText.trimmed();
+		break;
+	}
+	if (result.text.isEmpty()) {
+		return RibbonLook();
+	}
+	const auto white = QColor(255, 255, 255);
+	const auto clear = QColor(0, 0, 0, 0);
+	if (cell.ribbonColor.isValid()) {
+		result.bg1 = cell.ribbonColor;
+		result.bg2 = clear;
+		result.fg = white;
+	} else if (unique
+		&& kind != Ribbon::Limited
+		&& kind != Ribbon::SoldOut) {
+		result.bg1 = resolved.colors.edge;
+		result.bg2 = resolved.colors.pattern;
+		result.fg = white;
+	} else {
+		result.bg1 = (kind == Ribbon::SoldOut)
+			? st::attentionButtonFg->c
+			: st::windowActiveTextFg->c;
+		result.bg2 = clear;
+		result.fg = st::windowBg->c;
+	}
+	return result;
+}
