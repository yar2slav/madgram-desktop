+
+void PaintFrame(
+		QPainter &p,
+		const Geometry &geometry,
+		const ExportOptions &options) {
+	const auto width = geometry.size.width();
+	if (!options.frame) {
+		if (!options.transparent) {
+			p.fillRect(QRect(QPoint(), geometry.size), st::boxDividerBg);
+		}
+		return;
+	}
+	const auto &bar = st::infoTopBar;
+	p.fillRect(QRect(0, 0, width, geometry.topBar), bar.bg);
+	p.fillRect(
+		QRect(
+			0,
+			geometry.topBar,
+			width,
+			geometry.size.height() - geometry.topBar),
+		st::boxDividerBg);
+	const auto &back = bar.back;
+	const auto &icon = back.icon;
+	auto position = back.iconPosition;
+	if (position.x() < 0) {
+		position.setX((back.width - icon.width()) / 2);
+	}
+	if (position.y() < 0) {
+		position.setY((back.height - icon.height()) / 2);
+	}
+	PaintIcon(p, icon, st::boxTitleCloseFg->c, position, geometry.icons);
+	const auto &font = bar.title.style.font;
+	p.setFont(font);
+	p.setPen(bar.title.textFg);
+	p.drawText(
+		back.width,
+		bar.titlePosition.y() + font->ascent,
+		font->elided(
+			tr::lng_peer_gifts_title(tr::now),
+			std::max(width - back.width - bar.titlePosition.x(), 1)));
+	p.fillRect(
+		QRect(0, geometry.topBar, width, st::lineWidth),
+		st::shadowFg);
+}
+
+void PaintPattern(
+		QPainter &p,
+		QRect inner,
+		QColor color,
+		const QByteArray &symbol,
+		float64 factor) {
+	if (symbol.isEmpty()) {
+		return;
+	}
+	auto images = base::flat_map<int, QImage>();
+	p.save();
+	p.setClipRect(inner, Qt::IntersectClip);
+	const auto skip = inner.width() / 3;
+	const auto rect = QRect(
+		inner.x() - skip,
+		inner.y(),
+		inner.width() + 2 * skip,
+		inner.height());
+	const auto large = Ui::Emoji::GetSizeLarge()
+		/ float64(style::DevicePixelRatio());
+	for (const auto &point : Ui::PatternBgPointsSmall()) {
+		const auto side = large * point.scale;
+		const auto pixels = std::max(int(base::SafeRound(side * factor)), 1);
+		auto &image = images[pixels];
+		if (image.isNull()) {
+			image = Tinted(
+				RenderLottieFrame(symbol, QSize(pixels, pixels), 0),
+				color);
+			if (image.isNull()) {
+				break;
+			}
+		}
+		const auto position = rect.topLeft() + QPoint(
+			int(point.position.x() * rect.width()),
+			int(point.position.y() * rect.height()));
+		p.setOpacity(point.opacity);
+		p.drawImage(
+			QRectF(
+				position.x() - side / 2.,
+				position.y() - side / 2.,
+				side,
+				side),
+			image);
+	}
+	p.setOpacity(1.);
+	p.restore();
+}
+
+void PaintCellBase(
+		QPainter &p,
+		QRect inner,
+		QMargins extend,
+		const QImage &shadow,
+		const ExportItem &item,
+		float64 factor) {
+	const auto button = inner.marginsAdded(extend);
+	p.drawImage(QRectF(button), shadow);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto radius = st::giftBoxGiftRadius;
+	p.setPen(Qt::NoPen);
+	if (item.cell.kind != CellKind::Unique) {
+		p.setBrush(st::windowBg);
+		p.drawRoundedRect(inner, radius, radius);
+		return;
+	}
+	const auto &colors = item.resolved.colors;
+	auto gradient = QRadialGradient(inner.center(), inner.width() / 2);
+	gradient.setStops({
+		{ 0., colors.center },
+		{ 1., colors.edge },
+	});
+	p.setBrush(gradient);
+	p.drawRoundedRect(inner, radius, radius);
+	PaintPattern(p, inner, colors.pattern, item.resolved.symbolJson, factor);
+}
+
+void PaintRibbon(QPainter &p, QRect inner, const RibbonLook &look) {
+	const auto &font = st::giftBoxGiftBadgeFont;
+	const auto twidth = font->width(look.text);
+	const auto skip = int(std::ceil(twidth / M_SQRT2));
+	const auto size = twidth + font->height * 2;
+	const auto rubber = st::lineWidth;
+	const auto left = inner.x() + inner.width() + rubber - size;
+	const auto top = inner.y() - rubber;
+	p.save();
+	p.setClipRect(
+		inner.marginsAdded({ rubber, rubber, rubber, rubber }),
+		Qt::IntersectClip);
+	p.setClipRect(QRect(left, top, size, size), Qt::IntersectClip);
+	auto hq = PainterHighQualityEnabler(p);
+	p.translate(left + size - skip, top);
+	p.rotate(45.);
+	const auto rect = QRect(-5 * twidth, 0, twidth * 12, font->height);
+	p.setPen(Qt::NoPen);
+	p.setBrush(look.bg1);
+	p.drawRect(rect);
+	if (look.bg2.alpha() > 0) {
+		p.setOpacity(0.5);
+		p.setBrush(look.bg2);
+		p.drawRect(rect);
+		p.setOpacity(1.);
+	}
+	p.setFont(font);
+	p.setPen(look.fg);
+	p.drawText(QPoint(0, font->ascent), look.text);
+	p.restore();
+}
+
+void PaintPrice(
+		QPainter &p,
+		QRect button,
+		QSize single,
+		const ExportItem &item,
+		float64 factor) {
+	auto text = Ui::Text::SingleCustomEmoji(StarData());
+	text.append(' ').append(FormatStars(item.resolved.gift->stars));
+	const auto height = st::defaultTableLabel.style.font->height;
+	const auto ratio = std::max(int(std::ceil(factor)), 1);
+	const auto padding = QMargins(0, st::giftBoxByStarsSkip, 0, 0);
+	auto context = Ui::Text::MarkedContext();
+	context.customEmojiFactory = [=](
+			QStringView data,
+			const Ui::Text::MarkedContext &) {
+		return (data == StarData())
+			? std::make_unique<StarEmoji>(height, ratio, padding)
+			: std::unique_ptr<Ui::Text::CustomEmoji>();
+	};
+	auto price = Ui::Text::String();
+	price.setMarkedText(
+		st::semiboldTextStyle,
+		text,
+		kMarkupTextOptions,
+		context);
+	const auto margins = st::giftBoxButtonPadding;
+	const auto inner = QRect(
+		QPoint(),
+		QSize(price.maxWidth(), st::semiboldFont->height)
+	).marginsAdded(margins);
+	const auto pill = QRect(
+		button.x() + (button.width() - inner.width()) / 2,
+		button.y()
+			+ single.height()
+			- st::giftBoxButtonBottomSmall
+			- inner.height(),
+		inner.width(),
+		inner.height());
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::creditsBg3);
+	p.setOpacity(0.12);
+	const auto radius = pill.height() / 2.;
+	p.drawRoundedRect(pill, radius, radius);
+	p.setOpacity(1.);
+	p.setPen(st::creditsFg);
+	price.draw(p, {
+		.position = pill.topLeft() + QPoint(margins.left(), margins.top()),
+		.availableWidth = price.maxWidth(),
+	});
+}
+
+void PaintHiddenMark(
+		QPainter &p,
+		QPoint position,
+		const QImage &frame,
+		not_null<Library*> library) {
+	const auto &icon = st::giftBoxHiddenMark;
+	const auto size = icon.size();
+	const auto ratio = style::DevicePixelRatio();
+	auto sample = QImage(size * ratio, QImage::Format_ARGB32_Premultiplied);
+	sample.setDevicePixelRatio(ratio);
+	sample.fill(Qt::transparent);
+	{
+		auto q = QPainter(&sample);
+		auto cache = QImage();
+		library->delegate()->hiddenMark()->paint(
+			q,
+			frame,
+			cache,
+			QPoint(),
+			size,
+			size.width());
+	}
+	auto color = sample.pixelColor(2 * ratio, sample.height() / 2);
+	color.setAlpha(255);
+	const auto sticker = st::giftBoxStickerSize;
+	const auto point = position + QPoint(
+		(sticker.width() - size.width()) / 2,
+		(sticker.height() - size.height()) / 2);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(Qt::NoPen);
+	p.setBrush(color);
+	p.drawEllipse(QRect(point, size));
+	p.drawImage(
+		QRect(point, size),
+		icon.instance(st::premiumButtonFg->c));
+}
+
+void PaintCellOverlay(
+		QPainter &p,
+		QRect inner,
+		QMargins extend,
+		QSize single,
+		const ExportItem &item,
+		const QImage &frame,
+		not_null<Library*> library,
+		float64 factor,
+		int icons) {
+	const auto button = inner.marginsAdded(extend);
+	const auto width = button.width();
+	if (item.cell.hidden && !GiftHiddenDim()) {
+		const auto size = st::giftBoxStickerSize;
+		PaintHiddenMark(
+			p,
+			button.topLeft() + QPoint(
+				(width - size.width()) / 2,
+				st::giftBoxSmallStickerTop),
+			frame,
+			library);
+	}
+	const auto look = ComputeRibbon(item.cell, item.resolved);
+	if (!look.text.isEmpty()) {
+		PaintRibbon(p, inner, look);
+	}
+	if (item.cell.kind == CellKind::Unique && item.cell.pinned) {
+		auto hq = PainterHighQualityEnabler(p);
+		const auto &icon = st::giftBoxPinIcon;
+		const auto skip = st::giftBoxUserpicSkip;
+		const auto add = (st::giftBoxUserpicSize - icon.width()) / 2;
+		const auto rect = QRect(
+			inner.topLeft() + QPoint(skip, skip),
+			QSize(icon.width() + 2 * add, icon.height() + 2 * add));
+		p.setPen(Qt::NoPen);
+		p.setBrush(item.resolved.colors.pattern);
+		p.drawEllipse(rect);
+		PaintIcon(
+			p,
+			icon,
+			st::premiumButtonFg->c,
+			rect.topLeft() + QPoint(
+				(rect.width() - icon.width()) / 2,
+				(rect.height() - icon.height()) / 2),
+			icons);
+	}
+	if (item.cell.kind == CellKind::Regular && item.cell.price) {
+		PaintPrice(p, button, single, item, factor);
+	}
+}
+
+[[nodiscard]] QImage StillSticker(const QByteArray &bytes, QSize size) {
+	auto image = QImage::fromData(bytes);
+	if (image.isNull()) {
+		return image;
+	}
+	image = image.convertToFormat(
+		QImage::Format_ARGB32_Premultiplied
+	).scaled(size, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+	auto result = QImage(size, QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	auto p = QPainter(&result);
+	p.drawImage(
+		(size.width() - image.width()) / 2,
+		(size.height() - image.height()) / 2,
+		image);
+	p.end();
+	return result;
+}
+
+class Composer final {
+public:
+	explicit Composer(std::shared_ptr<const Scene> scene);
+
+	[[nodiscard]] bool animated() const;
+	[[nodiscard]] float64 fps() const;
+	[[nodiscard]] int frames(float64 fps) const;
+	[[nodiscard]] QRect area() const;
+	[[nodiscard]] QImage compose(int index, float64 fps);
+
+private:
+	struct Track {
+		std::unique_ptr<Lottie::Instance> instance;
+		QImage frame;
+		int shown = -1;
+	};
+
+	[[nodiscard]] const QImage &trackFrame(Track &track, float64 time);
+
+	const std::shared_ptr<const Scene> _scene;
+	std::vector<Track> _tracks;
+
+};
+
+} // namespace
+
+struct SceneCell {
+	QRect sticker;
+	QByteArray lottie;
+	bool dimmed = false;
+	QPoint position;
+	QImage base;
+	QImage overlay;
+	QImage badge;
+	float64 opacity = 1.;
+};
+
+struct Scene {
+	QImage background;
+	QImage overlay;
+	std::vector<SceneCell> cells;
+};
+
+namespace {
+
+Composer::Composer(std::shared_ptr<const Scene> scene)
+: _scene(std::move(scene)) {
+	_tracks.reserve(_scene->cells.size());
+	for (const auto &cell : _scene->cells) {
+		auto track = Track{ .instance = MakeLottie(cell.lottie) };
+		if (track.instance) {
+			track.frame = QImage(
+				cell.sticker.size(),
+				QImage::Format_ARGB32_Premultiplied);
+		}
+		_tracks.push_back(std::move(track));
+	}
+}
+
+bool Composer::animated() const {
+	return ranges::any_of(_tracks, [](const Track &track) {
+		return track.instance && (track.instance->framesCount() > 1);
+	});
+}
+
+float64 Composer::fps() const {
+	auto result = 0.;
+	for (const auto &track : _tracks) {
+		if (track.instance) {
+			result = std::max(result, track.instance->frameRate());
+		}
+	}
+	return (result > 0.) ? std::min(result, kMaxFps) : kFallbackFps;
+}
+
+int Composer::frames(float64 fps) const {
+	auto result = 1;
+	for (const auto &track : _tracks) {
+		if (const auto instance = track.instance.get()) {
+			result = std::max(result, int(std::ceil(
+				instance->framesCount() * fps / instance->frameRate())));
+		}
+	}
+	return std::min(result, kMaxFrames);
+}
+
+QRect Composer::area() const {
+	auto result = QRect();
+	for (const auto &cell : _scene->cells) {
+		result |= cell.dimmed
+			? cell.sticker.translated(cell.position)
+			: cell.sticker;
+	}
+	return result.intersected(QRect(QPoint(), _scene->background.size()));
+}
+
+const QImage &Composer::trackFrame(Track &track, float64 time) {
+	const auto count = track.instance->framesCount();
+	const auto index = std::clamp(
+		int(time * track.instance->frameRate() + 0.001),
+		0,
+		count - 1);
+	if (track.shown != index) {
+		track.instance->renderToPrepared(track.frame, index);
+		track.shown = index;
+	}
+	return track.frame;
+}
+
+QImage Composer::compose(int index, float64 fps) {
+	auto result = _scene->background.copy();
+	auto p = QPainter(&result);
+	const auto time = index / fps;
+	for (auto i = 0; i != int(_tracks.size()); ++i) {
+		const auto &cell = _scene->cells[i];
+		auto &track = _tracks[i];
+		if (!cell.dimmed && track.instance) {
+			p.drawImage(cell.sticker.topLeft(), trackFrame(track, time));
+		}
+	}
+	p.drawImage(0, 0, _scene->overlay);
+	for (auto i = 0; i != int(_tracks.size()); ++i) {
+		const auto &cell = _scene->cells[i];
+		auto &track = _tracks[i];
+		if (!cell.dimmed) {
+			continue;
+		}
+		auto image = cell.base.copy();
+		auto q = QPainter(&image);
+		if (track.instance) {
+			q.drawImage(cell.sticker.topLeft(), trackFrame(track, time));
+		}
+		q.drawImage(0, 0, cell.overlay);
+		q.end();
+		p.setOpacity(cell.opacity);
+		p.drawImage(cell.position, image);
+		p.setOpacity(1.);
+		p.drawImage(cell.position, cell.badge);
+	}
+	p.end();
+	return result;
+}
+
+[[nodiscard]] Fn<void()> ProgressStep(
+		Fn<void(int, int)> progress,
+		int total) {
+	if (!progress || total <= 0) {
+		return [] {};
+	}
+	const auto done = std::make_shared<int>(0);
+	const auto shown = std::make_shared<int>(-1);
+	return [=] {
+		const auto now = ++*done;
+		const auto percent = now * 100 / total;
+		if (percent != *shown) {
+			*shown = percent;
+			progress(now, total);
+		}
+	};
+}
+
+} // namespace
+
+QSize ExportSize(
+		not_null<Library*> library,
+		int count,
+		const ExportOptions &options) {
+	return PixelSize(ComputeGeometry(library, count, options));
+}
+
+std::shared_ptr<const Scene> PrepareScene(
+		not_null<Library*> library,
+		const std::vector<ExportItem> &items,
+		int count,
+		const ExportOptions &options) {
+	const auto geometry = ComputeGeometry(library, count, options);
+	const auto factor = geometry.factor;
+	const auto pixels = PixelSize(geometry);
+	const auto ratio = style::DevicePixelRatio();
+	const auto stickerSize = st::giftBoxStickerSize;
+	const auto dim = GiftHiddenDim();
+	auto result = std::make_shared<Scene>();
+	const auto layer = [&](QSize size) {
+		auto image = QImage(size, QImage::Format_ARGB32_Premultiplied);
+		image.fill(Qt::transparent);
+		return image;
+	};
+	result->background = layer(pixels);
+	result->overlay = layer(pixels);
+	{
+		auto p = QPainter(&result->background);
+		p.scale(factor, factor);
+		PaintFrame(p, geometry, options);
+	}
+	const auto shadow = ShadowImage(
+		geometry.single,
+		geometry.extend,
+		factor);
+	for (const auto &item : items) {
+		if (item.cell.kind == CellKind::Empty
+			|| !item.resolved.gift
+			|| item.index < 0
+			|| item.index >= count) {
+			continue;
+		}
+		const auto inner = InnerRect(geometry, item.index);
+		const auto button = inner.marginsAdded(geometry.extend);
+		const auto sticker = ToPixels(
+			QRect(
+				button.x() + (button.width() - stickerSize.width()) / 2,
+				inner.y() + (inner.height() - stickerSize.height()) / 2,
+				stickerSize.width(),
+				stickerSize.height()),
+			factor);
+		auto instance = MakeLottie(item.sticker);
+		auto still = QImage();
+		auto frame = QImage();
+		if (instance) {
+			still = QImage(sticker.size(), QImage::Format_ARGB32_Premultiplied);
+			instance->renderToPrepared(still, 0);
+			frame = QImage(
+				stickerSize * ratio,
+				QImage::Format_ARGB32_Premultiplied);
+			instance->renderToPrepared(frame, 0);
+		} else if (!item.sticker.isEmpty()) {
+			still = StillSticker(item.sticker, sticker.size());
+			frame = StillSticker(item.sticker, stickerSize * ratio);
+		}
+		const auto animated = instance && (instance->framesCount() > 1);
+		const auto paintBase = [&](QPainter &p) {
+			PaintCellBase(p, inner, geometry.extend, shadow, item, factor);
+		};
+		const auto paintOverlay = [&](QPainter &p) {
+			PaintCellOverlay(
+				p,
+				inner,
+				geometry.extend,
+				geometry.single,
+				item,
+				frame,
+				library,
+				factor,
+				geometry.icons);
+		};
+		if (!item.cell.hidden || !dim) {
+			auto p = QPainter(&result->background);
+			p.save();
+			p.scale(factor, factor);
+			paintBase(p);
+			p.restore();
+			if (!animated && !still.isNull()) {
+				p.drawImage(sticker.topLeft(), still);
+			}
+			p.end();
+			auto q = QPainter(&result->overlay);
+			q.scale(factor, factor);
+			paintOverlay(q);
+			q.end();
+			if (animated) {
+				result->cells.push_back({
+					.sticker = sticker,
+					.lottie = item.sticker,
+				});
+			}
+			continue;
+		}
+		const auto position = QPoint(
+			int(std::floor(button.x() * factor)),
+			int(std::floor(button.y() * factor)));
+		const auto size = QSize(
+			int(std::ceil((button.x() + button.width()) * factor))
+				- position.x(),
+			int(std::ceil((button.y() + button.height()) * factor))
+				- position.y());
+		const auto paintLocal = [&](QImage &image, auto &&callback) {
+			auto p = QPainter(&image);
+			p.translate(-position);
+			p.scale(factor, factor);
+			callback(p);
+		};
+		auto base = layer(size);
+		paintLocal(base, paintBase);
+		auto overlay = layer(size);
+		paintLocal(overlay, paintOverlay);
+		auto badge = layer(size);
+		paintLocal(badge, [&](QPainter &p) {
+			PaintHiddenGiftBadge(p, inner, geometry.icons);
+		});
+		const auto local = sticker.translated(-position);
+		if (animated) {
+			result->cells.push_back({
+				.sticker = local,
+				.lottie = item.sticker,
+				.dimmed = true,
+				.position = position,
+				.base = std::move(base),
+				.overlay = std::move(overlay),
+				.badge = std::move(badge),
+				.opacity = HiddenGiftOpacity(),
+			});
+			continue;
+		}
+		{
+			auto q = QPainter(&base);
+			if (!still.isNull()) {
+				q.drawImage(local.topLeft(), still);
+			}
+			q.drawImage(0, 0, overlay);
+		}
+		auto p = QPainter(&result->background);
+		p.setOpacity(HiddenGiftOpacity());
+		p.drawImage(position, base);
+		p.setOpacity(1.);
+		p.drawImage(position, badge);
+	}
+	return result;
+}
+
+bool SceneAnimated(const std::shared_ptr<const Scene> &scene) {
+	return !scene->cells.empty();
+}
+
+QSize SceneSize(const std::shared_ptr<const Scene> &scene) {
+	return scene->background.size();
+}
+
+QImage RenderStill(const std::shared_ptr<const Scene> &scene) {
+	return Composer(scene).compose(0, kFallbackFps);
+}
+
+QByteArray EncodeSceneGif(
+		const std::shared_ptr<const Scene> &scene,
+		Fn<void(int, int)> progress,
+		Fn<bool()> alive) {
+	auto composer = Composer(scene);
+	auto fps = composer.fps();
+	if (fps > kGifFpsLimit) {
+		fps /= 2.;
+	}
+	const auto count = composer.animated() ? composer.frames(fps) : 1;
+	const auto base = composer.compose(0, fps);
+	auto area = composer.area();
+	if (area.isEmpty()) {
+		area = QRect(0, 0, 1, 1);
+	}
+	const auto step = ProgressStep(progress, 2 * count);
+	auto gif = GiftStudio::EncodeGifSequence(
+		base,
+		area,
+		count,
+		fps,
+		[&](int index) {
+			step();
+			return composer.compose(index, fps).copy(area);
+		},
+		alive);
+	return GiftStudio::VerifyGif(gif) ? gif.bytes : QByteArray();
+}
+
+QSize SceneMp4Size(const std::shared_ptr<const Scene> &scene) {
+	return GiftStudio::Mp4Size(scene->background.size());
+}
+
+QByteArray EncodeSceneMp4(
+		const std::shared_ptr<const Scene> &scene,
+		Fn<void(int, int)> progress,
+		Fn<bool()> alive) {
+	const auto composer = std::make_shared<Composer>(scene);
+	const auto fps = composer->fps();
+	const auto count = composer->animated()
+		? composer->frames(fps)
+		: int(std::ceil(fps));
+	const auto size = SceneMp4Size(scene);
+	const auto step = ProgressStep(progress, count);
+	return GiftStudio::EncodeVideo({
+		.format = GiftStudio::VideoFormat::Mp4,
+		.size = size,
+		.fps = fps,
+		.frames = count,
+		.frame = [=](int index) {
+			step();
+			auto image = composer->compose(index, fps);
+			return (image.size() == size)
+				? image
+				: image.scaled(
+					size,
+					Qt::IgnoreAspectRatio,
+					Qt::SmoothTransformation);
+		},
+	}, std::move(alive));
+}
+
