+					.name = name,
+					.rarity = permille ? RarityText(*permille) : QString(),
+					.index = index,
+				});
+			}
+		};
+		const auto &draft = state->draft;
+		const auto &parts = state->parts;
+		const auto ready = (state->partsFor == draft.collection);
+		auto selected = -1;
+		switch (state->tab) {
+		case Tab::Collection:
+			for (auto i = 0; i != int(state->collections.size()); ++i) {
+				add(state->collections[i], std::nullopt, i);
+				if (state->collections[i] == draft.collection) {
+					selected = i;
+				}
+			}
+			break;
+		case Tab::Model:
+			if (ready) {
+				for (auto i = 0; i != int(parts.models.size()); ++i) {
+					add(parts.models[i].name, parts.models[i].permille, i);
+				}
+				selected = IndexOf(parts.models, draft.model);
+			}
+			break;
+		case Tab::Backdrop:
+			if (ready) {
+				for (auto i = 0; i != int(parts.backdrops.size()); ++i) {
+					add(
+						parts.backdrops[i].name,
+						parts.backdrops[i].permille,
+						i);
+				}
+				selected = IndexOf(parts.backdrops, draft.backdrop);
+			}
+			break;
+		case Tab::Symbol:
+			if (ready) {
+				for (auto i = 0; i != int(parts.symbols.size()); ++i) {
+					add(parts.symbols[i].name, parts.symbols[i].permille, i);
+				}
+				selected = IndexOf(parts.symbols, draft.symbol);
+			}
+			break;
+		}
+		list->setRows(std::move(rows), selected);
+		if (scrollToSelected) {
