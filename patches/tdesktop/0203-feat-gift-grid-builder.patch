+void AddGiftGrid(SectionBuilder &builder) {
+	const auto id = u"tele-gift-grid"_q;
+	const auto controller = builder.controller();
+	const auto offline = ::Tele::OfflineForLaunch();
+	const auto button = AddButton(builder, {
+		.id = id,
+		.title = rpl::single(::Tele::Lower(u"Gift grid"_q)),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [=] {
+			if (!::Tele::OfflineForLaunch()) {
+				::Tele::ShowGiftGrid(controller, nullptr);
+			}
+		},
+		.keywords = {
+			u"grid"_q,
+			u"profile"_q,
+			u"gifts"_q,
+			u"studio"_q,
+		},
+	});
+	if (button) {
+		SetupLink(button, id);
+		if (offline) {
+			rpl::single(rpl::empty) | rpl::then(
+				style::PaletteChanged()
+			) | rpl::on_next([=] {
+				button->setDisabled(true);
+				button->setColorOverride(st::windowSubTextFg->c);
+			}, button->lifetime());
+		}
