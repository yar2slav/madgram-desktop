+[[nodiscard]] QJsonArray SerializeCells(const std::vector<Cell> &cells) {
+	auto result = QJsonArray();
+	for (const auto &cell : cells) {
+		result.append(SerializeCell(cell));
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<Cell> ParseCells(const QJsonArray &array) {
+	auto result = std::vector<Cell>();
+	for (const auto &value : array) {
+		result.push_back(ParseCell(value.toObject()));
+	}
+	const auto rows = std::clamp(
+		(int(result.size()) + kColumns - 1) / kColumns,
+		1,
+		kMaxRows);
+	result.resize(rows * kColumns);
+	return result;
+}
+
+void PaintPlaceholder(
+		QPainter &p,
+		QRect rect,
+		bool over,
+		const QString &text) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto color = over
+		? st::windowActiveTextFg->c
+		: st::windowSubTextFg->c;
+	const auto radius = st::giftBoxGiftRadius;
+	auto pen = QPen(color);
+	pen.setWidthF(style::ConvertScaleExact(1.5));
+	pen.setDashPattern({ 4., 3. });
+	p.setPen(pen);
+	p.setBrush(over ? st::windowBgOver->c : QColor(0, 0, 0, 0));
+	const auto half = pen.widthF() / 2.;
+	p.drawRoundedRect(
+		QRectF(rect).marginsRemoved({ half, half, half, half }),
+		radius,
+		radius);
+	if (!text.isEmpty()) {
+		p.setFont(st::normalFont);
+		p.setPen(st::windowSubTextFg);
+		p.drawText(rect, text, style::al_center);
+		return;
+	}
+	const auto size = style::ConvertScaleExact(18.);
+	const auto center = QRectF(rect).center();
+	auto plus = QPen(color);
+	plus.setWidthF(style::ConvertScaleExact(2.));
+	plus.setCapStyle(Qt::RoundCap);
+	p.setPen(plus);
+	p.drawLine(
+		center - QPointF(size / 2., 0.),
+		center + QPointF(size / 2., 0.));
+	p.drawLine(
+		center - QPointF(0., size / 2.),
+		center + QPointF(0., size / 2.));
+}
