+QString FormatStars(int64 stars) {
+	const auto onlyK = (stars < 100'000'000);
+	return (stars >= 1'000'000)
+		? Lang::FormatCountToShort(stars, onlyK).string
+		: Lang::FormatCountDecimal(stars);
+}
