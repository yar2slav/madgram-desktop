+template <typename List>
+[[nodiscard]] int IndexOf(const List &list, const QString &name) {
+	for (auto i = 0; i != int(list.size()); ++i) {
+		if (list[i].name == name) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+template <typename List>
+void FixName(QString &name, const List &list) {
+	if (list.empty()) {
+		name = QString();
+		return;
+	}
+	for (const auto &item : list) {
+		if (!item.name.compare(name, Qt::CaseInsensitive)) {
+			name = item.name;
+			return;
+		}
+	}
+	name = list.front().name;
+}
+
+[[nodiscard]] Ribbon AutoRibbon(const Data::StarGift &gift) {
+	return !gift.limitedCount
+		? Ribbon::None
+		: (gift.soldOut || !gift.limitedLeft)
+		? Ribbon::SoldOut
+		: Ribbon::Limited;
+}
+
+[[nodiscard]] QString GiftLabel(const Data::StarGift &gift) {
+	const auto title = gift.resellTitle.isEmpty()
+		? Lower(u"Gift"_q)
+		: gift.resellTitle;
+	return title + u" \u00B7 "_q + Lower(u"%1 stars"_q).arg(
+		FormatStars(gift.stars));
+}
