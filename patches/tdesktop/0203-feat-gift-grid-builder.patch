+Cell CellFromCombo(Cell cell, const GiftStudio::Combo &combo) {
+	cell.kind = CellKind::Unique;
+	cell.collection = combo.collection;
+	cell.model = combo.model;
+	cell.backdrop = combo.backdrop;
+	cell.symbol = combo.symbol;
+	cell.giftId = 0;
+	if (const auto number = ParseNumber(combo.number); number >= 0) {
+		cell.number = number;
+	}
+	if (cell.ribbon == Ribbon::Limited || cell.ribbon == Ribbon::SoldOut) {
+		cell.ribbon = Ribbon::Auto;
+	}
+	return cell;
+}
