+#include "tele/tele_gift_studio_widgets.h"
+
+#include "data/data_star_gift.h"
+#include "lang/lang_keys.h"
+#include "lang/lang_tag.h"
+#include "tele/tele_gift_studio_store.h"
+#include "tele/tele_lowercase.h"
+#include "ui/layers/generic_box.h"
+#include "ui/painter.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/color_editor.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_settings.h"
+#include "styles/style_widgets.h"
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kMaxName = 64;
+
+} // namespace
+
+int RowHeight() {
+	return style::ConvertScale(40);
+}
+
+QString RarityText(int permille) {
+	auto attribute = Data::UniqueGiftAttribute();
+	attribute.rarityValue = permille;
+	return Data::UniqueGiftAttributeText(attribute);
+}
+
+QString NumberText(QString text) {
+	text = text.trimmed();
+	while (text.startsWith('#')) {
+		text = text.mid(1).trimmed();
+	}
+	if (text.isEmpty()) {
+		return QString();
+	}
+	auto ok = false;
+	const auto value = text.toLongLong(&ok);
+	return '#' + ((ok && value >= 0 && text[0].isDigit())
+		? Lang::FormatCountDecimal(value)
+		: text);
+}
+
+void PaintBackdropPreview(QPainter &p, QRect rect, const Colors &colors) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto gradient = QRadialGradient(QRectF(rect).center(), rect.width() / 2.);
+	gradient.setStops({
+		{ 0., colors.center },
+		{ 1., colors.edge },
+	});
+	p.setPen(Qt::NoPen);
+	p.setBrush(gradient);
+	p.drawEllipse(rect);
+}
+
+void PaintImagePreview(
+		QPainter &p,
+		QRect rect,
+		PreviewKind kind,
+		const QString &gift,
+		const QString &name,
+		not_null<Ui::RpWidget*> list,
+		std::optional<QColor> tint) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto image = LookupPreview(kind, gift, name);
+	if (image.isNull()) {
+		RequestPreview(kind, gift, name, crl::guard(list.get(), [=] {
+			list->update();
+		}));
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawEllipse(rect);
+		return;
+	}
+	if (tint) {
+		auto colored = QImage(
+			image.size(),
+			QImage::Format_ARGB32_Premultiplied);
+		colored.fill(Qt::transparent);
+		auto q = QPainter(&colored);
+		q.drawImage(0, 0, image);
+		q.setCompositionMode(QPainter::CompositionMode_SourceIn);
+		q.fillRect(colored.rect(), *tint);
+		q.end();
+		image = std::move(colored);
+	}
+	p.drawImage(rect, image);
+}
+
+PickerList::PickerList(QWidget *parent) : RpWidget(parent) {
+	setMouseTracking(true);
+}
+
+void PickerList::setRows(std::vector<PickerRow> rows, int selected) {
+	_rows = std::move(rows);
+	_selected = selected;
+	_pressed = -1;
+	setOver(-1);
+	resizeToWidth(width());
+	update();
+}
+
+void PickerList::setPreview(Fn<void(QPainter&, QRect, int)> preview) {
+	_preview = std::move(preview);
+}
+
+int PickerList::selectedTop() const {
+	for (auto i = 0; i != int(_rows.size()); ++i) {
+		if (_rows[i].index == _selected) {
+			return i * RowHeight();
+		}
+	}
+	return 0;
+}
+
+int PickerList::firstIndex() const {
+	return _rows.empty() ? -1 : _rows.front().index;
+}
+
+rpl::producer<int> PickerList::chosen() const {
+	return _chosen.events();
+}
+
+int PickerList::resizeGetHeight(int newWidth) {
+	return int(_rows.size()) * RowHeight();
+}
+
+int PickerList::rowAt(QPoint position) const {
+	if (!rect().contains(position)) {
+		return -1;
+	}
+	const auto row = position.y() / RowHeight();
+	return (row < int(_rows.size())) ? row : -1;
+}
+
+void PickerList::setOver(int row) {
+	if (_over == row) {
+		return;
+	}
+	const auto height = RowHeight();
+	if (_over >= 0) {
+		update(0, _over * height, width(), height);
+	}
+	_over = row;
+	if (_over >= 0) {
+		update(0, _over * height, width(), height);
+	}
+	setCursor((_over >= 0) ? style::cur_pointer : style::cur_default);
+}
+
+void PickerList::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto clip = e->rect();
+	const auto height = RowHeight();
+	const auto padding = st::boxRowPadding.left() / 2;
+	const auto preview = style::ConvertScale(28);
+	const auto &font = st::normalFont;
+	const auto from = std::max(clip.y() / height, 0);
+	const auto till = std::min(
+		(clip.y() + clip.height() + height - 1) / height,
+		int(_rows.size()));
+	for (auto i = from; i < till; ++i) {
+		const auto &row = _rows[i];
+		const auto top = i * height;
+		const auto selected = (row.index == _selected);
+		if (selected) {
+			p.fillRect(0, top, width(), height, st::lightButtonBgOver);
+		} else if (i == _over) {
+			p.fillRect(0, top, width(), height, st::windowBgOver);
+		}
+		const auto image = QRect(
+			padding,
+			top + (height - preview) / 2,
+			preview,
+			preview);
+		if (_preview) {
+			_preview(p, image, row.index);
+		}
+		const auto left = image.x() + image.width() + padding;
+		const auto right = width() - padding;
+		const auto rarity = row.rarity.isEmpty() ? 0 : font->width(row.rarity);
+		const auto baseline = top + (height - font->height) / 2 + font->ascent;
+		p.setFont(font->f);
+		p.setPen(selected ? st::lightButtonFg : st::windowFg);
+		const auto available = right
+			- left
+			- (rarity ? (rarity + padding) : 0);
+		p.drawText(left, baseline, font->elided(row.name, available));
+		if (rarity) {
+			p.setPen(st::windowSubTextFg);
+			p.drawText(right - rarity, baseline, row.rarity);
+		}
+	}
+}
+
+void PickerList::mouseMoveEvent(QMouseEvent *e) {
+	setOver(rowAt(e->pos()));
+}
+
+void PickerList::mousePressEvent(QMouseEvent *e) {
+	_pressed = (e->button() == Qt::LeftButton) ? rowAt(e->pos()) : -1;
+}
+
+void PickerList::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = std::exchange(_pressed, -1);
+	if (pressed >= 0 && pressed == rowAt(e->pos())) {
+		_chosen.fire_copy(_rows[pressed].index);
+	}
+}
+
+void PickerList::leaveEventHook(QEvent *e) {
+	setOver(-1);
+}
+
+ColorSwatch::ColorSwatch(QWidget *parent, QString label)
+: AbstractButton(parent)
+, _label(std::move(label)) {
+	setAccessibleName(_label);
+}
+
+void ColorSwatch::setColor(QColor color) {
+	if (_color != color) {
+		_color = color;
+		update();
+	}
+}
+
+QColor ColorSwatch::color() const {
+	return _color;
+}
+
+void ColorSwatch::onStateChanged(State was, StateChangeSource source) {
+	update();
+}
+
+void ColorSwatch::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto radius = height() / 2.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::windowBgOver);
+	p.setOpacity((isOver() || isDown()) ? 1. : 0.6);
+	p.drawRoundedRect(rect(), radius, radius);
+	p.setOpacity(1.);
+	const auto inset = style::ConvertScale(5);
+	const auto side = height() - 2 * inset;
+	auto pen = st::shadowFg->p;
+	pen.setWidthF(style::ConvertScaleExact(1.));
+	p.setPen(pen);
+	p.setBrush(_color);
+	p.drawEllipse(QRect(inset, inset, side, side));
+	const auto &font = st::normalFont;
+	const auto left = inset + side + inset;
+	p.setFont(font->f);
+	p.setPen(st::windowFg);
+	p.drawText(
+		left,
+		(height() - font->height) / 2 + font->ascent,
+		font->elided(
+			_label + u" "_q + _color.name(),
+			std::max(width() - left - inset, 1)));
+}
+
+void ColorPickerBox(
+		not_null<Ui::GenericBox*> box,
+		QString title,
+		QColor current,
+		Fn<void(QColor)> done) {
+	box->setTitle(rpl::single(title));
+	const auto editor = box->addRow(object_ptr<ColorEditor>(
+		box,
+		ColorEditor::Mode::HSL,
+		current));
+	const auto save = [=] {
+		auto color = editor->color();
+		color.setAlpha(255);
+		done(color);
+		box->closeBox();
+	};
+	editor->submitRequests() | rpl::on_next(save, editor->lifetime());
+	box->setFocusCallback([=] {
+		editor->setInnerFocus();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+	box->setWidth(editor->width());
+}
+
+void ChooseNameBox(
+		not_null<Ui::GenericBox*> box,
+		QString title,
+		QString initial,
+		Fn<void(QString)> done) {
+	box->setTitle(rpl::single(title));
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::defaultInputField,
+		rpl::single(Lower(u"Name"_q)),
+		initial));
+	field->setMaxLength(kMaxName);
+	const auto save = [=] {
+		const auto name = field->getLastText().trimmed();
+		if (name.isEmpty()) {
+			field->showError();
+			return;
+		}
+		done(name);
+		box->closeBox();
+	};
+	field->submits() | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void FavoritesBox(
+		not_null<Ui::GenericBox*> box,
+		Fn<void(Combo)> apply) {
+	box->setTitle(rpl::single(Lower(u"Favorites and history"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto content = box->verticalLayout();
+	const auto list = content->add(object_ptr<Ui::VerticalLayout>(content));
+	const auto fill = [=] {
+		list->clear();
+		const auto entry = [&](
+				const QString &title,
+				const Combo &combo,
+				Fn<void()> remove) {
+			const auto button = list->add(object_ptr<Ui::SettingsButton>(
+				list,
+				rpl::single(title),
+				st::settingsButtonNoIcon));
+			button->setClickedCallback([=] {
+				apply(combo);
+				box->closeBox();
+			});
+			if (remove) {
+				const auto cross = Ui::CreateChild<Ui::IconButton>(
+					button,
+					st::boxTitleClose);
+				button->widthValue() | rpl::on_next([=](int width) {
+					cross->moveToRight(
+						0,
+						(button->height() - cross->height()) / 2,
+						width);
+				}, cross->lifetime());
+				cross->setClickedCallback(remove);
+			}
+			auto details = object_ptr<Ui::FlatLabel>(
+				list,
+				ComboLabel(combo),
+				st::boxDividerLabel);
+			list->add(std::move(details), st::boxRowPadding);
+		};
+		Ui::AddSubsectionTitle(list, rpl::single(Lower(u"Favorites"_q)));
+		const auto &favorites = Favorites();
+		if (favorites.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"Nothing saved yet."_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		for (auto i = 0; i != int(favorites.size()); ++i) {
+			entry(favorites[i].name, favorites[i].combo, [=] {
+				RemoveFavorite(i);
+			});
+		}
+		Ui::AddSkip(list);
+		Ui::AddSubsectionTitle(list, rpl::single(Lower(u"History"_q)));
+		const auto &history = History();
+		if (history.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"Exports show up here."_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		for (const auto &combo : history) {
+			entry(combo.collection, combo, nullptr);
+		}
+		list->resizeToWidth(content->width());
+	};
+	fill();
+	StoreChanges() | rpl::on_next([=] {
+		crl::on_main(list, fill);
+	}, list->lifetime());
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Clear history"_q)), [=] {
+		ClearHistory();
+	});
+}
+
+} // namespace Tele::GiftStudio
