diff --git a/Telegram/SourceFiles/tele/tele_smooth_typing.cpp b/Telegram/SourceFiles/tele/tele_smooth_typing.cpp
index e21623249ea3e2741358bd08c75a87a60f6f29c9..33150501b7533e4e916dc65ffe6403988b3fc25b 100644
--- a/Telegram/SourceFiles/tele/tele_smooth_typing.cpp
+++ b/Telegram/SourceFiles/tele/tele_smooth_typing.cpp
@@ -18,8 +18,22 @@
 namespace Tele {
 namespace {
 
-constexpr auto kGlideDuration = crl::time(110);
-constexpr auto kFadeDuration = crl::time(160);
+struct Durations {
+	crl::time glide = 0;
+	crl::time fade = 0;
+};
+
+[[nodiscard]] Durations CurrentDurations() {
+	const auto speed = SmoothTypingSpeed();
+	if (speed == u"fast"_q) {
+		return { .glide = 60, .fade = 100 };
+	} else if (speed == u"slow"_q) {
+		return { .glide = 180, .fade = 260 };
+	} else if (speed == u"slower"_q) {
+		return { .glide = 280, .fade = 400 };
+	}
+	return { .glide = 110, .fade = 160 };
+}
 constexpr auto kMaxFadedCharacters = 2;
 constexpr auto kAttachedProperty = "mad_smooth_caret";
 
@@ -98,7 +112,7 @@ protected:
 		auto p = QPainter(this);
 		const auto now = crl::now();
 		for (const auto &fade : _fades) {
-			const auto progress = std::clamp((now - fade.start) / float64(kFadeDuration), 0., 1.);
+			const auto progress = std::clamp((now - fade.start) / float64(CurrentDurations().fade), 0., 1.);
 			auto color = _background;
 			color.setAlphaF(1. - anim::easeOutCubic(1., progress));
 			p.fillRect(fade.rect, color);
@@ -135,7 +149,7 @@ private:
 			_from = current();
 			_to = target;
 			_glide.stop();
-			_glide.start([=] { update(); }, 0., 1., kGlideDuration, anim::easeOutCubic);
+			_glide.start([=] { update(); }, 0., 1., CurrentDurations().glide, anim::easeOutCubic);
 		} else {
 			_glide.stop();
 			_from = _to = target;
@@ -186,7 +200,7 @@ private:
 	bool fadeStep(crl::time now) {
 		_fades.erase(
 			ranges::remove_if(_fades, [&](const Fade &fade) {
-				return now - fade.start >= kFadeDuration;
+				return now - fade.start >= CurrentDurations().fade;
 			}),
 			end(_fades));
 		update();
