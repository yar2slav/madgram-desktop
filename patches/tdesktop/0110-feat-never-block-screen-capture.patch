diff --git a/Telegram/SourceFiles/tele/tele_screen_capture.cpp b/Telegram/SourceFiles/tele/tele_screen_capture.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e2a0e358e0b606bf9c97b576a0fdb67771913602
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_screen_capture.cpp
@@ -0,0 +1,30 @@
+#include "tele/tele_screen_capture.h"
+
+#include "platform/platform_specific.h"
+#include "tele/tele_options.h"
+
+#include <QtWidgets/QApplication>
+
+namespace Tele {
+namespace {
+
+constexpr auto kRequested = "teleScreenCaptureExcluded";
+
+} // namespace
+
+bool ScreenCaptureExcluded(not_null<QWidget*> window, bool requested) {
+	window->setProperty(kRequested, requested);
+	return requested && !AllowScreenCapture();
+}
+
+void WatchScreenCapture(rpl::lifetime &lifetime) {
+	AllowScreenCaptureChanges() | rpl::on_next([] {
+		for (const auto widget : QApplication::topLevelWidgets()) {
+			Platform::SetWindowScreenshotProtection(
+				widget,
+				widget->property(kRequested).toBool());
+		}
+	}, lifetime);
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_screen_capture.h b/Telegram/SourceFiles/tele/tele_screen_capture.h
new file mode 100644
index 0000000000000000000000000000000000000000..3d193625627d5781f7af6b6d892bec9e9b458768
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_screen_capture.h
@@ -0,0 +1,10 @@
+#pragma once
+
+namespace Tele {
+
+[[nodiscard]] bool ScreenCaptureExcluded(
+	not_null<QWidget*> window,
+	bool requested);
+void WatchScreenCapture(rpl::lifetime &lifetime);
+
+} // namespace Tele
