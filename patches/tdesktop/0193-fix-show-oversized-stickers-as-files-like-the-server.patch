diff --git a/Telegram/SourceFiles/tele/tele_sticker_truth.cpp b/Telegram/SourceFiles/tele/tele_sticker_truth.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..58be572a74c4d1faa2ea46ac781ef0ab7db2805f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_sticker_truth.cpp
@@ -0,0 +1,48 @@
+#include "tele/tele_sticker_truth.h"
+
+#include "lottie/lottie_animation.h"
+#include "lottie/lottie_common.h"
+
+#include <QtCore/QMimeDatabase>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxTgsBytes = 64 * 1024;
+
+[[nodiscard]] QString FileMime(
+		const QByteArray &bytes,
+		const QString &filepath) {
+	const auto database = QMimeDatabase();
+	return (bytes.isEmpty() && !filepath.isEmpty())
+		? database.mimeTypeForFile(
+			filepath,
+			QMimeDatabase::MatchContent).name()
+		: database.mimeTypeForData(bytes).name();
+}
+
+} // namespace
+
+QImage ReadStickerThumbnail(
+		const QByteArray &content,
+		const QString &filepath,
+		QString &filemime) {
+	const auto bytes = Lottie::ReadContent(content, filepath);
+	auto result = (!bytes.isEmpty() && bytes.size() <= kMaxTgsBytes)
+		? Lottie::ReadThumbnail(bytes)
+		: QImage();
+	if (result.isNull()) {
+		filemime = FileMime(bytes, filepath);
+	}
+	return result;
+}
+
+bool LacksStickerAttribute(
+		const QVector<MTPDocumentAttribute> &attributes) {
+	return ranges::none_of(attributes, [](const MTPDocumentAttribute &a) {
+		return (a.type() == mtpc_documentAttributeSticker)
+			|| (a.type() == mtpc_documentAttributeCustomEmoji);
+	});
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_sticker_truth.h b/Telegram/SourceFiles/tele/tele_sticker_truth.h
