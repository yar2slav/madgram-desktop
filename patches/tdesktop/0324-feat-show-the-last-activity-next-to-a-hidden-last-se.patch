diff --git a/Telegram/SourceFiles/tele/tele_observed_activity.cpp b/Telegram/SourceFiles/tele/tele_observed_activity.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f014ce54ae904fd74e200c9f36d7981cf80f4caf
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_observed_activity.cpp
@@ -0,0 +1,299 @@
+#include "tele/tele_observed_activity.h"
+
+#include "base/timer.h"
+#include "base/unixtime.h"
+#include "data/data_changes.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/secret/secret_chats.h"
+#include "tele/tele_badges.h"
+#include "tele/tele_changelog_chat.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QSaveFile>
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E4163);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxEntries = 5000;
+constexpr auto kSaveDelay = 10 * crl::time(1000);
+
+class Store final {
+public:
+	explicit Store(not_null<Main::Session*> session);
+	~Store();
+
+	void note(not_null<UserData*> user, TimeId when);
+	[[nodiscard]] TimeId lookup(not_null<UserData*> user);
+
+private:
+	[[nodiscard]] QString path() const;
+	void ensureLoaded();
+	void read();
+	void write();
+	void trim();
+	void refreshShown();
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<UserId, TimeId> _times;
+	base::Timer _saveTimer;
+	bool _loaded = false;
+	bool _dirty = false;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] base::flat_map<not_null<Main::Session*>, Store*> &Registry() {
+	static auto result = base::flat_map<not_null<Main::Session*>, Store*>();
+	return result;
+}
+
+[[nodiscard]] Store *Find(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry)) ? i->second : nullptr;
+}
+
+[[nodiscard]] bool Tracked(not_null<UserData*> user) {
+	return !user->isSelf()
+		&& !user->isBot()
+		&& !user->isServiceUser()
+		&& !user->isSupport()
+		&& !user->isNotificationsUser()
+		&& !SupportText(user)
+		&& !Secret::IsSecretPeer(user)
+		&& !IsChangelogPeer(user)
+		&& user->lastseen().isHidden();
+}
+
+[[nodiscard]] QString FormatWhen(TimeId when, TimeId now) {
+	const auto full = base::unixtime::parse(when);
+	const auto today = base::unixtime::parse(now).date();
+	const auto locale = QLocale();
+	const auto time = locale.toString(full.time(), QLocale::ShortFormat);
+	if (full.date() == today) {
+		return time;
+	} else if (full.date().addDays(1) == today) {
+		return tr::lng_mediaview_yesterday(tr::now, lt_time, time);
+	}
+	return tr::lng_mediaview_date_time(
+		tr::now,
+		lt_date,
+		locale.toString(full.date(), QLocale::ShortFormat),
+		lt_time,
+		time);
+}
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session)
+, _saveTimer([=] { write(); }) {
+	Registry().emplace(session, this);
+
+	session->data().sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		write();
+	}, _lifetime);
+
+	ObservedActivityValue(
+	) | rpl::skip(1) | rpl::on_next([=](bool) {
+		refreshShown();
+	}, _lifetime);
+}
+
+Store::~Store() {
+	write();
+	Registry().remove(_session);
+}
+
+QString Store::path() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + u"/tele_activity"_q;
+}
+
+void Store::ensureLoaded() {
+	if (!_loaded) {
+		_loaded = true;
+		read();
+	}
+}
+
+void Store::read() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	auto file = QFile(path());
+	if (!key || !file.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	auto stream = QDataStream(&file);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto magic = quint32();
+	auto version = qint32();
+	auto encrypted = QByteArray();
+	stream >> magic >> version >> encrypted;
+	auto data = EncryptedDescriptor();
+	if (stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| !DecryptLocal(data, encrypted, key)) {
+		return;
+	}
+	auto count = qint32();
+	data.stream >> count;
+	if (data.stream.status() != QDataStream::Ok
+		|| count < 0
+		|| count > kMaxEntries) {
+		return;
+	}
+	auto times = base::flat_map<UserId, TimeId>();
+	for (auto i = 0; i != count; ++i) {
+		auto id = quint64();
+		auto when = qint32();
+		data.stream >> id >> when;
+		if (data.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (id && when > 0) {
+			times.emplace(UserId(id), TimeId(when));
+		}
+	}
+	for (const auto &[id, when] : _times) {
+		auto &existing = times[id];
+		existing = std::max(existing, when);
+	}
+	_times = std::move(times);
+}
+
+void Store::write() {
+	_saveTimer.cancel();
+	if (!_dirty) {
+		return;
+	}
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto data = EncryptedDescriptor(uint32(sizeof(qint32)
+		+ _times.size() * (sizeof(quint64) + sizeof(qint32))));
+	data.stream << qint32(_times.size());
+	for (const auto &[id, when] : _times) {
+		data.stream << quint64(id.bare) << qint32(when);
+	}
+	const auto path = this->path();
+	QDir().mkpath(QFileInfo(path).absolutePath());
+	auto file = QSaveFile(path);
+	if (!file.open(QIODevice::WriteOnly)) {
+		return;
+	}
+	auto stream = QDataStream(&file);
+	stream.setVersion(QDataStream::Qt_5_1);
+	stream << kMagic << kVersion << PrepareEncrypted(data, key);
+	if (stream.status() == QDataStream::Ok && file.commit()) {
+		_dirty = false;
+	}
+}
+
+void Store::trim() {
+	while (int(_times.size()) > kMaxEntries) {
+		_times.erase(ranges::min_element(
+			_times,
+			ranges::less(),
+			[](const auto &pair) { return pair.second; }));
+	}
+}
+
+void Store::note(not_null<UserData*> user, TimeId when) {
+	ensureLoaded();
+	const auto id = peerToUser(user->id);
+	const auto i = _times.find(id);
+	if (i != end(_times) && i->second >= when) {
+		return;
+	}
+	_times[id] = when;
+	trim();
+	_dirty = true;
+	if (!_saveTimer.isActive()) {
+		_saveTimer.callOnce(kSaveDelay);
+	}
+	_session->changes().peerUpdated(
+		user,
+		Data::PeerUpdate::Flag::OnlineStatus);
+}
+
+TimeId Store::lookup(not_null<UserData*> user) {
+	ensureLoaded();
+	const auto i = _times.find(peerToUser(user->id));
+	return (i != end(_times)) ? i->second : TimeId();
+}
+
+void Store::refreshShown() {
+	if (ObservedActivity()) {
+		ensureLoaded();
+	}
+	auto users = std::vector<not_null<UserData*>>();
+	for (const auto &[id, when] : _times) {
+		if (const auto user = _session->data().userLoaded(id)) {
+			users.push_back(user);
+		}
+	}
+	for (const auto &user : users) {
+		_session->changes().peerUpdated(
+			user,
+			Data::PeerUpdate::Flag::OnlineStatus);
+	}
+}
+
+} // namespace
+
+void SetupObservedActivity(not_null<Main::Session*> session) {
+	session->lifetime().make_state<Store>(session);
+}
+
+void NoteActivity(not_null<UserData*> user, TimeId when) {
+	if (!ObservedActivity() || when <= 0 || !Tracked(user)) {
+		return;
+	} else if (const auto store = Find(&user->session())) {
+		store->note(user, std::min(when, base::unixtime::now()));
+	}
+}
+
+void NoteReactionActivity(
+		not_null<Data::Session*> owner,
+		PeerId peerId,
+		TimeId when) {
+	if (!ObservedActivity() || when <= 0 || !peerIsUser(peerId)) {
+		return;
+	}
+	const auto user = owner->userLoaded(peerToUser(peerId));
+	if (!user || !Tracked(user)) {
+		return;
+	} else if (const auto store = Find(&owner->session())) {
+		store->note(user, std::min(when, base::unixtime::now()));
+	}
+}
+
+QString WithObservedActivity(
+		not_null<UserData*> user,
+		const QString &status,
+		TimeId now) {
+	if (!ObservedActivity()
+		|| !Tracked(user)
+		|| user->lastseen().isOnline(now)) {
+		return status;
+	}
+	const auto store = Find(&user->session());
+	const auto when = store ? store->lookup(user) : TimeId();
+	return when
+		? (status + u" ("_q + FormatWhen(when, now) + u")"_q)
+		: status;
+}
+
+} // namespace Tele
