+[[nodiscard]] QImage RenderFrame(
+		not_null<DocumentData*> document,
+		const std::shared_ptr<Data::DocumentMedia> &media,
+		int size) {
+	const auto sticker = document->sticker();
+	if (!sticker || !media || !media->loaded()) {
+		return QImage();
+	}
+	const auto key = std::make_pair(uint64(document->id), size);
+	auto &frames = Current().frames;
+	if (const auto i = frames.find(key); i != end(frames)) {
+		return i->second;
+	}
+	const auto bytes = Lottie::ReadContent(
+		media->bytes(),
+		document->filepath());
+	if (bytes.isEmpty()) {
+		return QImage();
+	}
+	auto generator = std::unique_ptr<Ui::FrameGenerator>();
+	switch (sticker->type) {
+	case StickerType::Tgs:
+		generator = std::make_unique<Lottie::FrameGenerator>(bytes);
+		break;
+	case StickerType::Webm:
+		generator = std::make_unique<FFmpeg::FrameGenerator>(bytes);
+		break;
+	case StickerType::Webp:
+		generator = std::make_unique<Ui::ImageFrameGenerator>(bytes);
+		break;
+	}
+	if (!generator) {
+		return QImage();
+	}
+	auto frame = generator->renderNext(
+		QImage(),
+		QSize(size, size),
+		Qt::KeepAspectRatio);
+	return frames.emplace(key, std::move(frame.image)).first->second;
+}
+
+[[nodiscard]] QImage Colorized(const QImage &image, QColor color) {
+	auto result = QImage(image.size(), QImage::Format_ARGB32_Premultiplied);
+	style::colorizeImage(image, color, &result, QRect(), QPoint(), true);
+	return result;
+}
+
+[[nodiscard]] QImage SharpMask(
+		const MonoIcon &part,
+		QSize size,
+		int ratio) {
+	const auto mask = part.*Exposed(IconMaskTag());
+	const auto &color = part.*Exposed(IconColorTag());
+	if (!mask || !color || size.isEmpty()) {
+		return QImage();
+	}
+	auto &masks = Current().masks;
+	const auto key = std::make_tuple(mask, size.width(), size.height());
+	if (const auto i = masks.find(key); i != end(masks)) {
+		return i->second;
+	}
+	const auto plain = MonoIcon(mask, color, QMargins());
+	auto image = plain.instance(
+		QColor(255, 255, 255),
+		style::Scale() * ratio,
+		true);
+	if (image.isNull()) {
+		return QImage();
+	} else if (image.size() != size) {
+		image = image.scaled(
+			size,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+	}
+	image.setDevicePixelRatio(ratio);
+	return masks.emplace(key, std::move(image)).first->second;
+}
+
+void PaintColoredIcon(
+		QPainter &p,
+		const style::icon &icon,
+		int x,
+		int y,
+		int outerw,
+		QColor color,
+		int ratio) {
+	const auto data = icon.*Exposed(IconDataTag());
+	if (!data) {
+		return;
+	}
+	for (const auto &part : data->*Exposed(IconPartsTag())) {
+		const auto padding = part.*Exposed(IconPaddingTag());
+		const auto inner = part.size().shrunkBy(padding);
+		const auto mask = SharpMask(part, inner * ratio, ratio);
+		if (mask.isNull()) {
+			part.paint(p, QPoint(x, y), outerw, color);
+			continue;
+		}
+		const auto left = rtl()
+			? (outerw - x - part.width() + padding.right())
+			: (x + padding.left());
+		p.drawImage(left, y + padding.top(), Colorized(mask, color));
+	}
+}
+
+[[nodiscard]] QImage ColoredIconImage(
+		const style::icon &icon,
+		QColor color,
+		int ratio) {
+	const auto data = icon.*Exposed(IconDataTag());
+	if (!data) {
+		return QImage();
+	}
+	const auto &parts = data->*Exposed(IconPartsTag());
+	if (parts.size() != 1 || !(parts[0].*Exposed(IconPaddingTag())).isNull()) {
+		return icon.instance(color);
+	}
+	const auto mask = SharpMask(parts[0], parts[0].size() * ratio, ratio);
+	return mask.isNull() ? icon.instance(color) : Colorized(mask, color);
+}
