+bool PaintShotReaction(
+		QPainter &p,
+		not_null<Data::Reactions*> reactions,
+		const Data::ReactionId &id,
+		QRect rect) {
+	auto &state = Current();
+	if (!state.emojiScopes || id.custom() || rect.isEmpty()) {
+		return false;
+	}
+	auto document = (DocumentData*)nullptr;
+	auto half = true;
+	if (id.paid()) {
+		document = reactions->lookupPaid()->centerIcon;
+	} else {
+		const auto &list = reactions->list(Data::Reactions::Type::All);
+		const auto i = ranges::find(list, id, &Data::Reaction::id);
+		if (i == end(list)) {
+			return false;
+		}
+		half = (i->centerIcon == nullptr);
+		document = i->centerIcon ? i->centerIcon : i->selectAnimation.get();
+	}
+	if (!document) {
+		return false;
+	}
+	auto &media = state.reactions[document];
+	if (!media) {
+		if (state.reactions.size() > 128) {
+			state.reactions.clear();
+			return false;
+		}
+		media = LoadMedia(document);
+	}
+	const auto ratio = ShotSharpRatio();
+	const auto side = half ? (rect.width() / 2) : rect.width();
+	const auto frame = ratio
+		? RenderFrame(document, media, side * ratio)
+		: QImage();
+	if (frame.isNull()) {
+		return false;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	p.drawImage(
+		QRect(
+			rect.x() + (rect.width() - side) / 2,
+			rect.y() + (rect.height() - side) / 2,
+			side,
+			side),
+		frame);
+	return true;
+}
+
+bool PaintShotLargeEmoji(
+		QPainter &p,
+		const Ui::Text::IsolatedEmoji &emoji,
+		QPoint position,
+		QSize size,
+		int skip) {
+	const auto ratio = ShotSharpRatio();
+	if (!ratio || emoji.empty()) {
+		return false;
+	}
+	auto list = std::vector<EmojiPtr>();
+	for (const auto &item : emoji.items) {
+		if (const auto regular = std::get_if<EmojiPtr>(&item)) {
+			list.push_back(*regular);
+		} else if (!v::is_null(item)) {
+			return false;
+		}
+	}
+	auto &state = Current();
+	if (!state.universal) {
+		const auto &source = Ui::Emoji::SourceImages();
+		if (!source) {
+			return false;
+		}
+		state.universal = std::make_shared<Ui::Emoji::UniversalImages>(
+			source->id());
+	}
+	const auto images = state.universal;
+	if (!images->ensureLoaded()) {
+		return false;
+	}
+	const auto outline = st::largeEmojiOutline * ratio;
+	const auto inner = st::largeEmojiSize * ratio;
+	const auto side = inner + 2 * outline;
+	for (const auto single : list) {
+		auto &frame = state.largeEmoji[std::make_pair(single, ratio)];
+		if (frame.isNull()) {
+			auto tinted = QImage(
+				QSize(inner, inner),
+				QImage::Format_ARGB32_Premultiplied);
+			tinted.fill(Qt::white);
+			{
+				auto q = QPainter(&tinted);
+				q.setCompositionMode(QPainter::CompositionMode_DestinationIn);
+				images->draw(q, single, inner, 0, 0);
+			}
+			frame = QImage(
+				QSize(side, side),
+				QImage::Format_ARGB32_Premultiplied);
+			frame.fill(Qt::transparent);
+			auto q = QPainter(&frame);
+			const auto planar = std::array<QPoint, 4>{ {
+				{ 0, -1 },
+				{ -1, 0 },
+				{ 1, 0 },
+				{ 0, 1 },
+			} };
+			for (const auto &shift : planar) {
+				for (auto i = 0; i != outline; ++i) {
+					q.drawImage(
+						QPoint(outline, outline) + shift * (i + 1),
+						tinted);
+				}
+			}
+			const auto diagonal = std::array<QPoint, 4>{ {
+				{ -1, -1 },
+				{ 1, -1 },
+				{ -1, 1 },
+				{ 1, 1 },
+			} };
+			const auto corrected = int(base::SafeRound(outline / M_SQRT2));
+			for (const auto &shift : diagonal) {
+				for (auto i = 0; i != corrected; ++i) {
+					q.drawImage(
+						QPoint(outline, outline) + shift * (i + 1),
+						tinted);
+				}
+			}
+			images->draw(q, single, inner, outline, outline);
+		}
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	for (const auto single : list) {
+		p.drawImage(
+			QRect(position, size),
+			state.largeEmoji[std::make_pair(single, ratio)]);
+		position.rx() += size.width() + skip;
+	}
+	return true;
+}
+
+bool PaintShotSticker(
+		QPainter &p,
+		not_null<DocumentData*> document,
+		QRect rect,
+		QSize size,
+		QColor colored,
+		bool mirror) {
+	const auto ratio = ShotSharpRatio();
+	if (!ratio || size.isEmpty()) {
+		return false;
+	}
+	const auto media = document->activeMediaView();
+	const auto side = std::max(size.width(), size.height());
+	auto frame = RenderFrame(document, media, side * ratio);
+	if (frame.isNull()) {
+		return false;
+	}
+	if (colored.alpha() > 0) {
+		frame = Colorized(frame, colored);
+	}
+	const auto target = QRect(
+		rect.x() + (rect.width() - side) / 2,
+		rect.y() + (rect.height() - side) / 2,
+		side,
+		side);
+	auto hq = PainterHighQualityEnabler(p);
+	if (mirror) {
+		p.save();
+		const auto middle = QPointF(target.center()) + QPointF(0.5, 0.5);
+		p.translate(middle);
+		p.scale(-1., 1.);
+		p.translate(-middle);
+		p.drawImage(target, frame);
+		p.restore();
+	} else {
+		p.drawImage(target, frame);
+	}
+	return true;
+}
+
+std::unique_ptr<Ui::Text::CustomEmoji> WrapShotEmoji(
+		std::unique_ptr<Ui::Text::CustomEmoji> emoji,
+		not_null<Data::Session*> owner,
+		uint64 documentId,
+		int frameSize) {
+	if (!Current().emojiScopes) {
+		return emoji;
+	}
+	return std::make_unique<ShotEmoji>(
+		std::move(emoji),
+		owner->document(documentId),
+		frameSize / style::DevicePixelRatio());
+}
