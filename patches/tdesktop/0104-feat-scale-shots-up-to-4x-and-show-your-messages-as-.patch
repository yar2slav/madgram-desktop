+	}
+}
+
+bool ShotEmoji::paintSharp(QPainter &p, const Context &context) {
+	const auto ratio = ShotSharpRatio();
+	if (!ratio || _size <= 0) {
+		return false;
+	} else if (!_media) {
+		_media = LoadMedia(_document);
+	}
+	const auto frame = RenderFrame(_document, _media, _size * ratio);
+	if (frame.isNull()) {
+		return false;
+	}
+	auto target = QRect(context.position, QSize(_size, _size));
+	if (context.scaled) {
+		const auto sx = anim::interpolate(
+			target.width() / 2,
+			0,
+			context.scale);
+		const auto sy = (target.height() == target.width())
+			? sx
+			: anim::interpolate(target.height() / 2, 0, context.scale);
+		target = target.marginsRemoved({ sx, sy, sx, sy });
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	if (_document->emojiUsesTextColor()) {
+		p.drawImage(target, Colorized(frame, context.textColor));
+	} else {
+		p.drawImage(target, frame);
+	}
+	return true;
+}
