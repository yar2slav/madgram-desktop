+
+int ShotSharpRatio() {
+	const auto ratio = Current().ratio;
+	return (ratio > style::DevicePixelRatio()) ? ratio : 0;
+}
+
+int ShotPixelRatio() {
+	return std::max(Current().ratio, style::DevicePixelRatio());
+}
+
+ShotSharpScope::ShotSharpScope(
+	int ratio,
+	not_null<const Ui::ChatStyle*> st)
+: _was(Current().ratio) {
+	Current().ratio = ratio;
+	if (_was || !ShotSharpRatio()) {
+		return;
+	}
+	for (const auto &icon : st.get()->*Exposed(OwnedIconsTag())) {
+		SwapIcon(*icon, ratio);
+	}
+	for (const auto icon : GlobalIcons()) {
+		SwapIcon(*icon, ratio);
+	}
+}
+
+ShotSharpScope::~ShotSharpScope() {
+	auto &current = Current();
+	current.ratio = _was;
+	if (!_was) {
+		RestoreIcons();
+		current.masks.clear();
+		current.corners.clear();
+		current.universal = nullptr;
+		current.largeEmoji.clear();
+		current.frames.clear();
+	}
+}
