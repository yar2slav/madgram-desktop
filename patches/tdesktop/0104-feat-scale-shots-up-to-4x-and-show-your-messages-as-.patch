+		const style::color *shadow,
+		int ratio) {
+	const auto r = radius * ratio;
+	const auto s = shadow ? (st::msgShadow * ratio) : 0;
+	auto image = QImage(r * 3, r * 3 + s, QImage::Format_ARGB32_Premultiplied);
+	image.fill(Qt::transparent);
+	{
+		auto p = QPainter(&image);
+		auto hq = PainterHighQualityEnabler(p);
