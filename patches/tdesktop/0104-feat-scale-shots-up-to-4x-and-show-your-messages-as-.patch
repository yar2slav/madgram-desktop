+std::array<QImage, 4> ShotCornersMask(int radius, int ratio) {
+	const auto side = radius * ratio;
+	auto full = QImage(
+		QSize(side, side) * 3,
+		QImage::Format_ARGB32_Premultiplied);
+	full.fill(Qt::transparent);
+	{
+		auto p = QPainter(&full);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(Qt::white);
+		p.drawRoundedRect(0, 0, side * 3, side * 3, side, side);
+	}
+	auto result = std::array<QImage, 4>{
+		full.copy(0, 0, side, side),
+		full.copy(side * 2, 0, side, side),
+		full.copy(0, side * 2, side, side),
+		full.copy(side * 2, side * 2, side, side),
+	};
+	for (auto &image : result) {
+		image.setDevicePixelRatio(ratio);
+	}
+	return result;
+}
+
+const std::array<QImage, 4> &ShotRadiusMask(int radius, int ratio) {
+	auto &cache = Current().corners;
+	const auto key = std::make_pair(radius, ratio);
+	auto i = cache.find(key);
+	if (i == end(cache)) {
+		i = cache.emplace(key, ShotCornersMask(radius, ratio)).first;
+	}
+	return i->second;
+}
+
+const std::array<QImage, 4> &ShotCachedCornersMasks(
+		Ui::CachedCornerRadius radius) {
+	const auto ratio = ShotSharpRatio();
+	return ratio
+		? ShotRadiusMask(Ui::CachedCornerRadiusValue(radius), ratio)
+		: Ui::CachedCornersMasks(radius);
+}
+
+QImage ShotRound(
+		QImage &&image,
+		ImageRoundRadius radius,
+		RectParts corners) {
+	const auto ratio = ShotSharpRatio();
+	if (!ratio
+		|| (radius != ImageRoundRadius::Large
+			&& radius != ImageRoundRadius::Small)) {
+		return Images::Round(std::move(image), radius, corners);
+	} else if (!static_cast<int>(corners)) {
+		return std::move(image);
+	}
+	const auto value = (radius == ImageRoundRadius::Large)
+		? st::roundRadiusLarge
+		: st::roundRadiusSmall;
+	return Images::Round(
+		std::move(image),
+		ShotRadiusMask(value, ratio),
+		corners);
+}
+
+QImage ShotRound(QImage &&image, Images::Options options) {
+	using Option = Images::Option;
+	if (!ShotSharpRatio()
+		|| (options & Option::RoundCircle)
+		|| !(options & (Option::RoundLarge | Option::RoundSmall))) {
+		return Images::Round(std::move(image), options);
+	}
+	const auto corner = [&](Option skip, RectPart part) {
+		return !(options & skip) ? part : RectPart::None;
+	};
+	return ShotRound(
+		std::move(image),
+		((options & Option::RoundLarge)
+			? ImageRoundRadius::Large
+			: ImageRoundRadius::Small),
+		(corner(Option::RoundSkipTopLeft, RectPart::TopLeft)
+			| corner(Option::RoundSkipTopRight, RectPart::TopRight)
+			| corner(Option::RoundSkipBottomLeft, RectPart::BottomLeft)
+			| corner(Option::RoundSkipBottomRight, RectPart::BottomRight)));
+}
+
+QImage ShotPrepare(
+		QImage image,
+		int w,
+		int h,
+		const Images::PrepareArgs &args) {
+	using Option = Images::Option;
+	const auto ratio = ShotSharpRatio();
+	if (!ratio) {
+		return Images::Prepare(std::move(image), w, h, args);
+	}
+	image = Images::Prepare(std::move(image), w, h, {
+		.options = (args.options
+			& ~(Option::RoundCircle | Option::RoundLarge | Option::RoundSmall)),
+	});
+	if (const auto outer = args.outer * ratio
+		; !outer.isEmpty() && outer != QSize(w, h)) {
+		image.setDevicePixelRatio(ratio);
+		auto result = QImage(outer, QImage::Format_ARGB32_Premultiplied);
+		result.setDevicePixelRatio(ratio);
+		const auto transparent = (args.options
+			& Option::TransparentBackground);
+		if (transparent) {
+			result.fill(Qt::transparent);
+		}
+		{
+			auto p = QPainter(&result);
+			if (!transparent
+				&& (w < outer.width() || h < outer.height())) {
+				p.fillRect(QRect(QPoint(), result.size() / ratio), Qt::black);
+			}
+			p.drawImage(
+				(result.width() - image.width()) / (2 * ratio),
+				(result.height() - image.height()) / (2 * ratio),
+				image);
+		}
+		image = std::move(result);
+	}
+	image = ShotRound(std::move(image), args.options);
+	if (args.colored) {
+		image = Images::Colored(std::move(image), *args.colored);
+	}
+	image.setDevicePixelRatio(ratio);
+	return image;
+}
+
+std::unique_ptr<Ui::BubblePattern> ShotBubblePattern(
+		const Ui::BubblePattern &original,
+		not_null<const Ui::ChatStyle*> st,
+		int ratio) {
+	auto result = std::make_unique<Ui::BubblePattern>();
+	result->pixmap = original.pixmap;
+	result->cornersSmall = ShotCornersMask(Ui::BubbleRadiusSmall(), ratio);
+	result->cornersLarge = ShotCornersMask(Ui::BubbleRadiusLarge(), ratio);
+	const auto shadow = st->msgInShadow()->c.alphaF();
+	const auto addShadow = [&](QImage &corner) {
+		auto image = QImage(
+			corner.width(),
+			corner.height() + st::msgShadow * ratio,
+			QImage::Format_ARGB32_Premultiplied);
+		image.fill(Qt::transparent);
+		image.setDevicePixelRatio(ratio);
+		auto p = QPainter(&image);
+		p.setOpacity(shadow);
+		p.drawImage(0, st::msgShadow, corner);
+		p.setOpacity(1.);
+		p.drawImage(0, 0, corner);
+		p.end();
+		corner = std::move(image);
+	};
+	addShadow(result->cornersSmall[2]);
+	addShadow(result->cornersSmall[3]);
+	const auto tail = [&](const style::icon &icon) {
+		const auto size = icon.size() * ratio;
+		auto image = icon.instance(Qt::white, style::Scale() * ratio, true);
+		if (image.size() != size) {
+			image = image.scaled(
+				size,
+				Qt::IgnoreAspectRatio,
+				Qt::SmoothTransformation);
+		}
+		image = std::move(image).convertToFormat(
+			QImage::Format_ARGB32_Premultiplied);
+		image.setDevicePixelRatio(ratio);
+		return image;
+	};
+	result->tailLeft = tail(st::historyBubbleTailOutLeft);
+	result->tailRight = tail(st::historyBubbleTailOutRight);
+	return result;
+}
