+};
+
+struct State {
+	int ratio = 0;
+	int emojiScopes = 0;
+	base::flat_map<std::pair<uint64, int>, QImage> frames;
+	base::flat_map<std::tuple<const IconMask*, int, int>, QImage> masks;
+	base::flat_map<MonoIcon*, SavedIcon> swapped;
+	std::map<std::pair<int, int>, std::array<QImage, 4>> corners;
+	base::flat_map<
+		not_null<DocumentData*>,
