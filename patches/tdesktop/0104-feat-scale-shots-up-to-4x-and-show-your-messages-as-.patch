+template <typename Tag, typename Tag::Type Member>
+struct Expose {
+	friend typename Tag::Type Exposed(Tag) {
+		return Member;
+	}
+};
+
+struct IconDataTag {
+	using Type = IconData *style::internal::Icon::*;
+	friend Type Exposed(IconDataTag);
+};
+struct IconPartsTag {
+	using Type = std::vector<MonoIcon> IconData::*;
+	friend Type Exposed(IconPartsTag);
+};
+struct IconMaskTag {
+	using Type = const IconMask *MonoIcon::*;
+	friend Type Exposed(IconMaskTag);
+};
+struct IconColorTag {
+	using Type = Color MonoIcon::*;
+	friend Type Exposed(IconColorTag);
+};
+struct IconPaddingTag {
+	using Type = QMargins MonoIcon::*;
+	friend Type Exposed(IconPaddingTag);
+};
+struct IconImageTag {
+	using Type = QImage MonoIcon::*;
+	friend Type Exposed(IconImageTag);
+};
+struct IconColorizedTag {
+	using Type = QImage MonoIcon::*;
+	friend Type Exposed(IconColorizedTag);
+};
+struct IconPixmapTag {
+	using Type = QPixmap MonoIcon::*;
+	friend Type Exposed(IconPixmapTag);
+};
+struct ColoredQuotesTag {
+	using Type = std::array<
+		std::unique_ptr<Ui::Text::QuotePaintCache>,
+		Ui::kColorIndexCount * 2> Ui::ChatStyle::*;
+	friend Type Exposed(ColoredQuotesTag);
+};
+struct OwnedIconsTag {
+	using Type = std::vector<not_null<style::icon*>> Ui::ChatStyle::*;
+	friend Type Exposed(OwnedIconsTag);
+};
+
+template struct Expose<IconDataTag, &style::internal::Icon::_data>;
+template struct Expose<IconPartsTag, &IconData::_parts>;
+template struct Expose<IconMaskTag, &MonoIcon::_mask>;
+template struct Expose<IconColorTag, &MonoIcon::_color>;
+template struct Expose<IconPaddingTag, &MonoIcon::_padding>;
+template struct Expose<IconImageTag, &MonoIcon::_maskImage>;
+template struct Expose<IconColorizedTag, &MonoIcon::_colorizedImage>;
+template struct Expose<IconPixmapTag, &MonoIcon::_pixmap>;
+template struct Expose<OwnedIconsTag, &Ui::ChatStyle::_ownedIcons>;
+template struct Expose<ColoredQuotesTag, &Ui::ChatStyle::_coloredQuoteCaches>;
+
+struct SavedIcon {
+	QImage mask;
+	QImage colorized;
