+void SwapIcon(const style::icon &icon, int ratio) {
+	const auto data = icon.*Exposed(IconDataTag());
+	if (!data) {
+		return;
+	}
+	auto &swapped = Current().swapped;
+	for (auto &part : data->*Exposed(IconPartsTag())) {
+		auto &pixmap = part.*Exposed(IconPixmapTag());
+		if (pixmap.isNull() || swapped.contains(&part)) {
+			continue;
+		}
+		const auto logical = pixmap.size() / style::DevicePixelRatio();
+		const auto mask = SharpMask(part, logical * ratio, ratio);
+		if (mask.isNull()) {
+			continue;
+		}
+		const auto &color = part.*Exposed(IconColorTag());
+		auto sharp = QPixmap::fromImage(Colorized(mask, color->c));
+		sharp.setDevicePixelRatio(ratio);
+		auto &image = part.*Exposed(IconImageTag());
+		auto &colorized = part.*Exposed(IconColorizedTag());
+		const auto colored = !colorized.isNull();
+		swapped.emplace(&part, SavedIcon{
+			.mask = colored ? base::take(image) : image,
+			.colorized = base::take(colorized),
+			.pixmap = std::move(pixmap),
+		});
+		if (colored) {
+			image = mask;
+		}
+		pixmap = std::move(sharp);
+	}
+}
+
+void RestoreIcons() {
+	for (auto &[part, saved] : base::take(Current().swapped)) {
+		part->*Exposed(IconImageTag()) = std::move(saved.mask);
+		part->*Exposed(IconColorizedTag()) = std::move(saved.colorized);
+		part->*Exposed(IconPixmapTag()) = std::move(saved.pixmap);
+	}
+}
