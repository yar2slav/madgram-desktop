+		int radius,
+		const style::color &bg,
+		int ratio) {
+	if (!corners.p[0].isNull() && corners.p[0].devicePixelRatio() == ratio) {
+		return;
+	}
+	const auto size = radius * ratio;
+	auto mask = QImage(size * 2, size * 2, QImage::Format_Grayscale8);
+	{
+		auto p = QPainter(&mask);
+		auto hq = PainterHighQualityEnabler(p);
+		p.fillRect(0, 0, size * 2, size * 2, Qt::white);
+		p.setPen(Qt::NoPen);
+		p.setBrush(Qt::black);
+		p.drawEllipse(0, 0, size * 2, size * 2);
+	}
+	const auto circle = style::colorizeImage(mask, bg);
+	const auto fill = [&](int index, int x, int y) {
+		corners.p[index] = Ui::PixmapFromImage(
+			circle.copy(QRect(x, y, size, size)));
+		corners.p[index].setDevicePixelRatio(ratio);
+	};
+	fill(0, 0, 0);
+	fill(1, size, 0);
+	fill(2, size, size);
+	fill(3, 0, size);
+}
