+[[nodiscard]] QColor BottomColor(QImage image) {
+	if (image.format() != QImage::Format_ARGB32_Premultiplied
+		&& image.format() != QImage::Format_RGB32) {
+		image = image.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+	}
+	const auto rows = std::clamp(
+		int(image.devicePixelRatio()),
+		1,
+		image.height());
+	return Average(image.copy(
+		0,
+		image.height() - rows,
+		image.width(),
+		rows));
+}
+
+[[nodiscard]] float64 Lightness(const QColor &color) {
+	const auto linear = [](float64 value) {
+		return (value <= 0.04045)
+			? (value / 12.92)
+			: std::pow((value + 0.055) / 1.055, 2.4);
+	};
+	const auto r = linear(float64(color.redF()));
+	const auto g = linear(float64(color.greenF()));
+	const auto b = linear(float64(color.blueF()));
+	const auto l = std::cbrt(
+		0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+	const auto m = std::cbrt(
+		0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+	const auto s = std::cbrt(
+		0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+	return 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
+}
+
+[[nodiscard]] bool Dark(const QColor &color) {
+	return Lightness(color) < kDarkLightness;
+}
+
+[[nodiscard]] float64 RelativeLuminance(QRgb color) {
+	const auto linear = [](int value) {
+		const auto v = value / 255.;
+		return (v <= 0.04045) ? (v / 12.92) : std::pow((v + 0.055) / 1.055, 2.4);
+	};
+	return 0.2126 * linear(qRed(color))
+		+ 0.7152 * linear(qGreen(color))
+		+ 0.0722 * linear(qBlue(color));
+}
+
+[[nodiscard]] float64 Contrast(QRgb a, QRgb b) {
+	const auto x = RelativeLuminance(a) + 0.05;
+	const auto y = RelativeLuminance(b) + 0.05;
+	return std::max(x, y) / std::min(x, y);
+}
+
+[[nodiscard]] QRgb Readable(QRgb label, QRgb bg, bool dark) {
+	const auto towards = dark ? 255 : 0;
+	auto result = label;
+	for (auto step = 1; step <= 20 && Contrast(result, bg) < kLabelContrast; ++step) {
+		const auto mix = [&](int channel) {
+			return channel + (towards - channel) * step / 20;
+		};
+		result = qRgba(
+			mix(qRed(label)),
+			mix(qGreen(label)),
+			mix(qBlue(label)),
+			qAlpha(label));
+	}
+	return result;
+}
+
+[[nodiscard]] const std::vector<int> &LabelSlots() {
+	static const auto result = [] {
+		const auto colors = {
+			&st::windowSubTextFg,
+			&st::windowSubTextFgOver,
+			&st::dialogsTextFg,
+			&st::dialogsTextFgOver,
+			&st::dialogsDateFg,
+			&st::dialogsDateFgOver,
+			&st::placeholderFg,
+		};
+		auto list = std::vector<int>();
+		list.reserve(colors.size());
+		for (const auto color : colors) {
+			const auto index = style::main_palette::indexOfColor(*color);
+			if (index >= 0) {
+				list.push_back(index);
+			}
+		}
+		return list;
+	}();
+	return result;
+}
+
+[[nodiscard]] QByteArray BaseColors(bool dark) {
+	if (Dark(st::windowBg->c) == dark) {
+		return style::main_palette::save();
+	}
+	static auto cache = std::array<QByteArray, 2>();
+	auto &result = cache[dark ? 1 : 0];
+	if (result.isEmpty()) {
+		using Window::Theme::EmbeddedType;
+		result = Window::Theme::PrepareEmbeddedPalette(
+			dark ? EmbeddedType::Night : EmbeddedType::Default,
+			std::nullopt)->save();
+	}
+	return result;
+}
+
+[[nodiscard]] const std::vector<int> &FillSlots() {
+	static const auto result = [] {
+		const auto colors = {
+			&st::windowBg,
+			&st::windowBgOver,
+			&st::windowBgRipple,
+			&st::windowShadowFgFallback,
+			&st::lightButtonBg,
+			&st::lightButtonBgOver,
+			&st::lightButtonBgRipple,
+			&st::menuBg,
+			&st::menuBgOver,
+			&st::menuBgRipple,
+			&st::boxBg,
+			&st::boxSearchBg,
+			&st::boxDividerBg,
+			&st::contactsBg,
+			&st::contactsBgOver,
+			&st::filterInputActiveBg,
+			&st::filterInputInactiveBg,
+			&st::overviewCheckBorder,
+		};
+		auto list = std::vector<int>();
+		list.reserve(colors.size());
+		for (const auto color : colors) {
+			const auto index = style::main_palette::indexOfColor(*color);
+			if (index >= 0) {
+				list.push_back(index);
+			}
+		}
+		return list;
+	}();
+	return result;
+}
+
+[[nodiscard]] QRgb Shift(QRgb value, QRgb base, const QColor &color) {
+	const auto r = qRed(value) - qRed(base);
+	const auto g = qGreen(value) - qGreen(base);
+	const auto b = qBlue(value) - qBlue(base);
+	const auto fits = [](int channel) {
+		return (channel >= 0) && (channel <= 255);
+	};
+	const auto sign = (fits(color.red() + r)
+		&& fits(color.green() + g)
+		&& fits(color.blue() + b)) ? 1 : -1;
+	return qRgb(
+		std::clamp(color.red() + sign * r, 0, 255),
+		std::clamp(color.green() + sign * g, 0, 255),
+		std::clamp(color.blue() + sign * b, 0, 255));
+}
+
+[[nodiscard]] std::unique_ptr<style::palette> FillPalette(
+		const QColor &color) {
+	auto bytes = BaseColors(Dark(color));
+	const auto &slots = FillSlots();
+	if (bytes.size() != style::palette::kCount * 4 || slots.empty()) {
+		return nullptr;
+	}
+	const auto data = reinterpret_cast<uchar*>(bytes.data());
+	const auto read = [&](int index) {
+		const auto from = data + index * 4;
+		return qRgba(from[0], from[1], from[2], from[3]);
+	};
+	const auto base = read(slots.front());
+	if (qAlpha(base) != 255) {
+		return nullptr;
+	}
+	for (const auto index : slots) {
+		const auto value = read(index);
+		if (qAlpha(value) != 255) {
+			continue;
+		}
+		const auto shifted = Shift(value, base, color);
+		const auto to = data + index * 4;
+		to[0] = uchar(qRed(shifted));
+		to[1] = uchar(qGreen(shifted));
+		to[2] = uchar(qBlue(shifted));
+	}
+	const auto dark = Dark(color);
+	for (const auto index : LabelSlots()) {
+		const auto readable = Readable(read(index), color.rgb(), dark);
+		const auto to = data + index * 4;
+		to[0] = uchar(qRed(readable));
+		to[1] = uchar(qGreen(readable));
+		to[2] = uchar(qBlue(readable));
+	}
+	auto result = std::make_unique<style::palette>();
+	if (!result->load(bytes)) {
+		return nullptr;
+	}
+	result->finalize();
+	return result;
+}
+
+void ReleasePalette(std::shared_ptr<style::palette> palette) {
+	if (style::main_palette::CurrentOverrideIdentity()) {
+		crl::on_main([=] { ReleasePalette(palette); });
+		return;
+	}
+	const auto forget = style::main_palette::Override(
+		style::main_palette::get().get());
+}
+
+[[nodiscard]] base::flat_set<ProfilePhotoBgFill*> &Fills() {
+	static auto result = base::flat_set<ProfilePhotoBgFill*>();
+	return result;
+}
