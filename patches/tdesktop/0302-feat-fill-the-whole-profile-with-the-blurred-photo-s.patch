+ProfilePhotoBgFill::ProfilePhotoBgFill(
+	not_null<Ui::RpWidget*> cover,
+	not_null<ProfilePhotoBg*> bg,
+	rpl::producer<> wrapChanges)
+: _cover(cover)
+, _bg(bg) {
+	Fills().emplace(this);
+	rpl::merge(
+		_bg->changes(),
+		ProfilePhotoBgWholeChanges(),
+		style::PaletteChanged(),
+		std::move(wrapChanges),
+		_cover->sizeValue() | rpl::map([=](QSize size) {
+			return QSize(size.width(), _cover->maximumHeight());
+		}) | rpl::distinct_until_changed() | rpl::to_empty
+	) | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+}
+
+ProfilePhotoBgFill::~ProfilePhotoBgFill() {
+	Fills().remove(this);
+	unregisterPalettes();
+	if (_palette) {
+		ReleasePalette(std::move(_palette));
+	}
+}
+
+std::optional<QColor> ProfilePhotoBgFill::computeColor() const {
+	if (!ProfilePhotoBgWhole()
+		|| !_bg->active()
+		|| !_cover->parentWidget()) {
+		return std::nullopt;
+	}
+	const auto image = _bg->prepare(
+		QSize(_cover->width(), _cover->maximumHeight()));
+	if (image.isNull()) {
+		return std::nullopt;
+	}
+	const auto color = BottomColor(image);
+	const auto factor = 1. - (Dark(color) ? kFillDimDark : kFillDimLight);
+	const auto dim = [&](int channel) {
+		return int(channel * factor + 0.5);
+	};
+	return QColor(dim(color.red()), dim(color.green()), dim(color.blue()));
+}
+
+void ProfilePhotoBgFill::refresh() {
+	if (style::main_palette::CurrentOverrideIdentity()) {
+		crl::on_main(this, [=] { refresh(); });
+		return;
+	}
+	const auto color = computeColor();
+	const auto version = style::PaletteVersion();
+	if (color == _color && (!color || version == _version)) {
+		return;
+	}
+	_version = version;
+	auto palette = color ? FillPalette(*color) : nullptr;
+	auto old = std::exchange(_palette, std::move(palette));
+	_color = _palette ? color : std::nullopt;
+	if (_palette) {
+		registerPalettes();
+	} else {
+		unregisterPalettes();
+	}
+	if (old) {
+		ReleasePalette(std::move(old));
+	}
+	repaint();
+}
+
+void ProfilePhotoBgFill::registerPalettes() {
+	const auto content = _cover->parentWidget();
+	if (_content == content) {
+		return;
+	}
+	unregisterPalettes();
+	_content = content;
+	Ui::SetWidgetPalette(content, [=]() -> const style::palette* {
+		return _palette.get();
+	});
+	Ui::SetWidgetPalette(_cover.get(), []() -> const style::palette* {
+		return nullptr;
+	});
+}
+
+void ProfilePhotoBgFill::unregisterPalettes() {
+	if (const auto content = base::take(_content)) {
+		Ui::RemoveWidgetPalette(content);
+		Ui::RemoveWidgetPalette(_cover.get());
+	}
+}
+
+void ProfilePhotoBgFill::repaint() {
+	_cover->update();
+	const auto content = _cover->parentWidget();
+	if (!content) {
+		return;
+	}
+	content->update();
+	for (auto w = content->parentWidget(); w; w = w->parentWidget()) {
+		if (dynamic_cast<Ui::LayerWidget*>(w)) {
+			const auto radius = st::boxRadius;
+			w->update(0, w->height() - radius, w->width(), radius);
+			return;
+		} else if (w->isWindow()) {
+			return;
+		}
+	}
+}
+
+void ProfilePhotoBgFill::paintSeam(QPainter &p) const {
+	if (!_color) {
+		return;
+	}
+	const auto bottom = _cover->height();
+	const auto height = std::min(style::ConvertScale(kSeam), bottom / 2);
+	if (height <= 0) {
+		return;
+	}
+	auto transparent = *_color;
+	transparent.setAlpha(0);
+	auto gradient = QLinearGradient(0, bottom - height, 0, bottom);
+	gradient.setColorAt(0., transparent);
+	gradient.setColorAt(1., *_color);
+	p.fillRect(
