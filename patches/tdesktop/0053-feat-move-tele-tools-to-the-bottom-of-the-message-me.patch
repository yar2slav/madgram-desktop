From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 18:38:17 +0300
Subject: [PATCH] feat: move tele tools to the bottom of the message menu

---
 .../history/history_inner_widget.cpp          |  9 +++---
 .../SourceFiles/tele/tele_message_menu.cpp    | 29 ++++++++++---------
 2 files changed, 21 insertions(+), 17 deletions(-)

diff --git a/Telegram/SourceFiles/history/history_inner_widget.cpp b/Telegram/SourceFiles/history/history_inner_widget.cpp
index 2792d2b494cdf60a246b32a19e602449ae3de6ce..4feb759eadb792446601c11a8e3cc6d1bd1123b7 100644
--- a/Telegram/SourceFiles/history/history_inner_widget.cpp
+++ b/Telegram/SourceFiles/history/history_inner_widget.cpp
@@ -3938,6 +3938,11 @@ void HistoryInner::showContextMenu(QContextMenuEvent *e, bool showFromTouch) {
 			Menu::RateTranscribeCallbackFactory(rateTranscriptionItem)));
 	}
 
+	Tele::InsertMessageTools(
+		_menu.get(),
+		controller->uiShow(),
+		_dragStateItem);
+
 	if (!pollOptionLink.isEmpty() && leaderOrSelf && !_menu->empty()) {
 		const auto pollItemId = leaderOrSelf->fullId();
 		_menu->stashContent([=](not_null<Ui::PopupMenu*> menu) {
@@ -3969,10 +3974,6 @@ void HistoryInner::showContextMenu(QContextMenuEvent *e, bool showFromTouch) {
 				poll);
 		}
 	}
-	Tele::InsertMessageTools(
-		_menu.get(),
-		controller->uiShow(),
-		_dragStateItem);
 
 	if (_menu->empty()) {
 		_menu = nullptr;
diff --git a/Telegram/SourceFiles/tele/tele_message_menu.cpp b/Telegram/SourceFiles/tele/tele_message_menu.cpp
index 986abc17e3b9eea5ca842c4a3998957faae351e4..15c441d02972581c6450ce1ffffd3ec2483be61b 100644
--- a/Telegram/SourceFiles/tele/tele_message_menu.cpp
+++ b/Telegram/SourceFiles/tele/tele_message_menu.cpp
@@ -10,7 +10,6 @@
 #include "ui/toast/toast.h"
 #include "ui/widgets/menu/menu_action.h"
 #include "ui/widgets/menu/menu_common.h"
-#include "ui/widgets/menu/menu_separator.h"
 #include "ui/widgets/popup_menu.h"
 #include "styles/style_chat_helpers.h"
 #include "styles/style_menu_icons.h"
@@ -74,21 +73,25 @@ void InsertMessageTools(
 	if (!item || menu->empty() || !IsServerMsgId(item->id)) {
 		return;
 	}
+	auto tools = std::vector<base::unique_qptr<Ui::Menu::ItemBase>>();
 	if (ViewAsTl()) {
-		menu->insertAction(0, MakeTlAction(menu, show, item));
+		tools.push_back(MakeTlAction(menu, show, item));
 	}
-	if (!MessageIdMenu()) {
-		return;
+	const auto addSeparator = [&] {
+		if (!menu->actions().back()->isSeparator()) {
+			menu->addSeparator();
+		}
+	};
+	if (!tools.empty()) {
+		addSeparator();
+		for (auto &tool : tools) {
+			menu->addAction(std::move(tool));
+		}
+	}
+	if (MessageIdMenu()) {
+		addSeparator();
+		menu->addAction(MakeIdAction(menu, show, item->id));
 	}
-	menu->insertAction(0, MakeIdAction(menu, show, item->id));
-	const auto parent = menu->menu();
-	const auto separator = new QAction(parent);
-	separator->setSeparator(true);
-	menu->insertAction(1, base::make_unique_q<Ui::Menu::Separator>(
-		parent,
-		menu->st().menu,
-		menu->st().menu.separator,
-		separator));
 }
 
 } // namespace Tele
