+		"Applies to chats you open after switching it.",
+});
+
 base::options::toggle ShowGiftIdsOption({
 	.id = kOptionShowGiftIds,
 	.name = "Show gift IDs",
@@ -743,6 +758,14 @@ rpl::producer<> HideReactionsButtonChanges() {
 	return HideReactionsButtonOption.changes();
 }
 
