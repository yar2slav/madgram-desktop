diff --git a/Telegram/SourceFiles/tele/tele_emoji_panel.cpp b/Telegram/SourceFiles/tele/tele_emoji_panel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bad34c4634cf6264356be5003f2ba632e1c5858d
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_emoji_panel.cpp
@@ -0,0 +1,141 @@
+#include "tele/tele_emoji_panel.h"
+
+#include "base/event_filter.h"
+#include "chat_helpers/tabbed_panel.h"
+#include "chat_helpers/tabbed_selector.h"
+#include "tele/tele_options.h"
+
+#include <QtGui/QKeyEvent>
+#include <QtGui/QMouseEvent>
+#include <QtWidgets/QApplication>
+
+namespace Tele {
+namespace {
+
+struct State {
+	std::vector<QPointer<QWidget>> toggles;
+	QPointer<QObject> filter;
+};
+
+base::flat_map<not_null<ChatHelpers::TabbedPanel*>, State*> Panels;
+
+[[nodiscard]] bool Contains(QWidget *parent, QWidget *widget) {
+	return parent && ((parent == widget) || parent->isAncestorOf(widget));
+}
+
+[[nodiscard]] bool Closable(not_null<ChatHelpers::TabbedPanel*> panel) {
+	return EmojiPanelClick()
+		&& !panel->isHidden()
+		&& !panel->hiding()
+		&& !panel->selector()->preventAutoHide();
+}
+
+[[nodiscard]] bool PressedOutside(
+		not_null<ChatHelpers::TabbedPanel*> panel,
+		not_null<State*> state,
+		not_null<QMouseEvent*> e) {
+	const auto widget = QApplication::widgetAt(e->globalPos());
+	if (!widget
+		|| widget->window() != panel->window()
+		|| Contains(panel, widget)) {
+		return false;
+	}
+	for (const auto &toggle : state->toggles) {
+		if (Contains(toggle.data(), widget)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] bool EscapePressed(
+		not_null<ChatHelpers::TabbedPanel*> panel,
+		not_null<QKeyEvent*> e) {
+	if (e->key() != Qt::Key_Escape || e->modifiers()) {
+		return false;
+	}
+	const auto focused = QApplication::focusWidget();
+	return focused
+		&& !Contains(panel, focused)
+		&& Contains(panel->parentWidget(), focused);
+}
+
+void ToggleFilter(
+		not_null<ChatHelpers::TabbedPanel*> panel,
+		not_null<State*> state,
+		bool shown) {
+	if (!shown) {
+		if (const auto filter = base::take(state->filter)) {
+			filter->deleteLater();
+		}
+		return;
+	} else if (state->filter) {
+		return;
+	}
+	state->filter = base::install_event_filter(panel, qApp, [=](
+			not_null<QEvent*> e) {
+		const auto type = e->type();
+		if ((type != QEvent::MouseButtonPress && type != QEvent::KeyPress)
+			|| !Closable(panel)) {
+			return base::EventFilterResult::Continue;
+		} else if (type == QEvent::MouseButtonPress) {
+			if (PressedOutside(panel, state, static_cast<QMouseEvent*>(
+					e.get()))) {
+				panel->hideAnimated();
+			}
+			return base::EventFilterResult::Continue;
+		} else if (EscapePressed(panel, static_cast<QKeyEvent*>(e.get()))) {
+			panel->hideAnimated();
+			return base::EventFilterResult::Cancel;
+		}
+		return base::EventFilterResult::Continue;
+	}).get();
+}
+
+[[nodiscard]] not_null<State*> Register(
+		not_null<ChatHelpers::TabbedPanel*> panel) {
+	if (const auto i = Panels.find(panel); i != end(Panels)) {
+		return i->second;
+	}
+	const auto state = panel->lifetime().make_state<State>();
+	Panels.emplace(panel, state);
+	panel->lifetime().add([=] {
+		Panels.remove(panel);
+	});
+	panel->shownValue(
+	) | rpl::on_next([=](bool shown) {
+		ToggleFilter(panel, state, shown);
+	}, panel->lifetime());
+	return state;
+}
+
+} // namespace
+
+bool EmojiPanelClickOnly(
+		not_null<ChatHelpers::TabbedPanel*> panel,
+		QObject *toggle) {
+	if (!EmojiPanelClick()) {
+		return false;
+	}
+	const auto state = Register(panel);
+	if (toggle && toggle->isWidgetType()) {
+		const auto widget = static_cast<QWidget*>(toggle);
+		if (!ranges::contains(state->toggles, widget, [](
+				const QPointer<QWidget> &toggle) {
+			return toggle.data();
+		})) {
+			state->toggles.push_back(widget);
+		}
+	}
+	return true;
+}
+
+bool EmojiPanelKeepsOpen(not_null<ChatHelpers::TabbedPanel*> panel) {
+	return EmojiPanelClick() && Panels.contains(panel);
+}
+
+bool AttachMenuOnHover() {
+	return !ChatHelpers::ShowPanelOnClick() && !AttachMenuClick();
+}
+
+} // namespace Tele
