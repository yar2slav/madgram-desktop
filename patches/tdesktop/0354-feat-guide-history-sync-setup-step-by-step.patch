-void Sync::loadLedger() {
-	if (std::exchange(_ledgerLoaded, true)) return;
-	if (Hex(config.value(u"vault"_q).toString(), 32)) {
-		auto seen = QFile(ledger());
-		if (seen.open(QIODevice::ReadWrite) && seen.size() <= 64 * 1024 * 1024) {
-			if (!seen.size()) config.insert(u"cursor"_q, u"0"_q);
-			if (seen.size() % 32) {
-				seen.resize(seen.size() - seen.size() % 32);
-				config.insert(u"cursor"_q, u"0"_q);
-			}
-			while (!seen.atEnd()) {
-				const auto bytes = seen.read(32);
-				if (bytes.size() != 32) { config.insert(u"cursor"_q, u"0"_q); break; }
-				_sent.insert(QString::fromLatin1(bytes.toHex()));
-			}
-		} else config.insert(u"cursor"_q, u"0"_q);
-	}
-}
