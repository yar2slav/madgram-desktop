+bool KeptWithChat(not_null<const HistoryItem*> item) {
+	const auto &all = Get().withChat;
+	if (all.empty() || !IsKeptDeleted(item)) {
+		return false;
+	}
+	const auto history = item->history();
+	const auto i = all.find(not_null<Main::Session*>(&history->session()));
+	if (i == end(all)) {
+		return false;
+	}
+	const auto j = i->second.find(history);
+	return (j != end(i->second)) && j->second.contains(item->id);
+}
