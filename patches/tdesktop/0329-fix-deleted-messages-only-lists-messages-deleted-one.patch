 }
 
+std::vector<not_null<HistoryItem*>> ListedDeletedItems(
+		not_null<History*> history) {
+	auto result = KeptDeletedItems(history);
+	result.erase(ranges::remove_if(result, [](not_null<HistoryItem*> item) {
+		return KeptWithChat(item);
+	}), end(result));
+	return result;
+}
+
+int ListedDeletedCount(not_null<History*> history) {
+	Restore(history);
+	const auto kept = Find(history);
+	if (!kept) {
+		return 0;
+	}
+	return int(ranges::count_if(*kept, [](const auto &pair) {
+		return !KeptWithChat(pair.second);
+	}));
+}
+
 rpl::producer<> KeptDeletedChanges(not_null<History*> history) {
 	return Get().changes.events(
 	) | rpl::filter(
@@ -556,6 +667,32 @@ void ClearKeptDeleted(not_null<History*> history) {
 	history->owner().histories().deleteMessages(ids, false);
 }
 
+void ClearListedDeleted(not_null<History*> history) {
+	auto ids = MessageIdsList();
+	for (const auto &item : ListedDeletedItems(history)) {
+		ids.push_back(item->fullId());
+	}
+	if (!ids.empty()) {
+		history->owner().histories().deleteMessages(ids, false);
+	}
+}
+
+void RefreshKeptWithChat(not_null<History*> history) {
+	const auto kept = Find(history);
+	if (!kept) {
+		return;
+	}
+	auto items = std::vector<not_null<HistoryItem*>>();
+	for (const auto &[id, item] : *kept) {
+		if (KeptWithChat(item)) {
+			items.push_back(item);
+		}
+	}
+	for (const auto &item : items) {
+		history->owner().requestItemViewRefresh(item);
+	}
+}
+
 rpl::producer<KeptDeletedEvent> KeptDeletedAdded() {
 	return Get().added.events();
 }
