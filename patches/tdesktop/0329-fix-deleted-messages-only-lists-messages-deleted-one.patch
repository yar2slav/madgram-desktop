+void ForgetWithChat(
+		not_null<Main::Session*> session,
+		not_null<History*> history,
+		MsgId id) {
+	auto &all = Get().withChat;
+	const auto i = all.find(session);
+	if (i == end(all)) {
+		return;
+	}
+	const auto j = i->second.find(history);
+	if (j == end(i->second)) {
+		return;
+	}
+	j->second.remove(id);
+	if (j->second.empty()) {
+		i->second.erase(j);
+		if (i->second.empty()) {
+			all.erase(i);
+		}
+	}
+}
