+
+void MarkKeptWithChat(
+		not_null<History*> history,
+		const std::vector<MsgId> &ids) {
+	Restore(history);
+	const auto kept = Find(history);
+	if (!kept) {
+		return;
+	}
+	auto marked = std::vector<not_null<HistoryItem*>>();
+	for (const auto &id : ids) {
+		const auto i = kept->find(id);
+		if (i != end(*kept) && !KeptWithChat(i->second)) {
+			marked.push_back(i->second);
+		}
+	}
+	if (marked.empty()) {
+		return;
+	}
+	const auto session = not_null<Main::Session*>(&history->session());
+	auto &set = Get().withChat[session][history];
+	for (const auto &item : marked) {
+		set.emplace(item->id);
+		MarkKeptDeletedWithChat(session, item->fullId());
+		history->owner().requestItemViewRefresh(item);
+	}
+	Get().changes.fire_copy(history);
 }
 
