--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
+++ b/Telegram/SourceFiles/tele/tele_settings_io.cpp
@@ -255,6 +255,7 @@ struct Spec {
 		Toggle(kOptionServerUsernames),
 		Toggle(kOptionNoticesServer),
 		Toggle(kOptionSentToBottom),
+		Toggle(kOptionNoTextSendingAnimation),
 		Toggle(kOptionForwardOneByOne),
 		Toggle(kOptionQueueBehindMedia),
 		Toggle(kOptionSendOlderReplies),
diff --git a/Telegram/SourceFiles/ui/effects/message_sending_text_flight.cpp b/Telegram/SourceFiles/ui/effects/message_sending_text_flight.cpp
index c8f0cd8570152c8e48e44a3f5d8eb2350966ea2b..59b7867453c232b0408d0718a8f741c46c88b288 100644
--- a/Telegram/SourceFiles/ui/effects/message_sending_text_flight.cpp
+++ b/Telegram/SourceFiles/ui/effects/message_sending_text_flight.cpp
@@ -12,6 +12,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "history/view/history_view_element.h"
 #include "history/history.h"
 #include "history/history_item.h"
+#include "tele/tele_options.h"
 #include "ui/chat/chat_style.h"
 #include "ui/chat/chat_style_radius.h"
 #include "ui/effects/animation_value.h"
@@ -538,6 +539,9 @@ std::optional<MessageSendingAnimationFrom> PrepareTextSending(
 		const TextWithTags &sending,
 		MsgId localId,
 		bool scheduled) {
+	if (Tele::NoTextSendingAnimation()) {
+		return std::nullopt;
+	}
 	auto fieldText = scheduled
 		? std::nullopt
 		: GrabSendingFieldText(field, sending);
