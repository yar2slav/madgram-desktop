+int MediaDc(PhotoData *photo, DocumentData *document) {
+	if (!ShowDc()) {
+		return 0;
+	} else if (document) {
+		return document->videoPreloadLocation().dcId();
+	}
+	return photo ? PhotoDc(photo) : 0;
+}
+
+QString AppendDc(QString text, int dc, const QString &separator) {
+	if (!dc) {
+		return text;
+	}
+	const auto label = Lower(u"DC %1"_q.arg(dc));
+	return text.isEmpty() ? label : (text + separator + label);
+}
+
 } // namespace Tele
