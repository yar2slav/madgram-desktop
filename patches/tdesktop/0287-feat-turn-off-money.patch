index 0000000000000000000000000000000000000000..a44c25fbf643ce0bc881203d8a9fbd0acfac8e57
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_no_money.cpp
@@ -0,0 +1,17 @@
+#include "tele/tele_no_money.h"
+
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+
+bool RefuseMoney(not_null<Window::SessionController*> controller) {
+	if (!NoMoney()) {
+		return false;
+	}
+	controller->showToast(Lower(u"Money is turned off in tele settings."_q));
+	return true;
+}
+
+} // namespace Tele
