--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_update_buttons.cpp
@@ -0,0 +1,36 @@
+#include "tele/tele_update_buttons.h"
+
+#include "core/application.h"
+#include "settings/settings_tele.h"
+#include "tele/tele_updater.h"
+#include "ui/basic_click_handlers.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+
+namespace Tele {
+
+bool OpenTeleUpdates() {
+	if (!Core::IsAppLaunched()) {
+		return false;
+	}
+	const auto window = Core::App().activePrimaryWindow();
+	const auto controller = window ? window->sessionController() : nullptr;
+	if (!controller
+		|| CurrentUpdateStatus().state == UpdateState::Disabled) {
+		UrlClickHandler::Open(u"https://gettele.app"_q);
+		return true;
+	}
+	if (!UpdateReady()) {
+		CheckForUpdates();
+	}
+	for (const auto &[path, type] : ::Settings::TeleSettingsPaths()) {
+		if (path == u"tele/updates"_q) {
+			controller->setHighlightControlId(u"tele-check-updates"_q);
+			controller->showSettings(type);
+			break;
+		}
+	}
+	return true;
+}
+
+} // namespace Tele
