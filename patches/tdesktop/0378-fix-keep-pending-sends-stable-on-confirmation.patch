+PendingMessageOrder::PendingMessageOrder(
+	not_null<History*> history,
+	not_null<Data::MessagesSlice*> previous,
+	bool mainHistory)
+: _history(history)
+, _previous(previous)
+, _knownLocalId(MsgId(StartClientMsgId.bare - 1))
+, _confirmations(mainHistory ? UnindexedSentMessageIds(history) : nullptr) {
+	observeLocalIds(false);
+	_history->session().data().itemIdChanged(
+	) | rpl::on_next([=](const Data::Session::IdChange &change) {
+		if (change.newId.peer == _history->peer->id) {
+			const auto unseen = _unseenLocalIds.find(change.oldId);
+			if (unseen != _unseenLocalIds.end()) {
+				_unseenLocalIds.erase(unseen);
+			}
+			RewriteMessageIds(
+				_previous,
+				FullMsgId(change.newId.peer, change.oldId),
+				change.newId);
+		}
+	}, _lifetime);
+	_history->owner().itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		if (item->history() == _history) {
+			const auto unseen = _unseenLocalIds.find(item->id);
+			if (unseen != _unseenLocalIds.end()) {
+				_unseenLocalIds.erase(unseen);
+			}
+		}
+	}, _lifetime);
+}
+
+void PendingMessageOrder::observeLocalIds(bool rememberNew) {
+	const auto known = _knownLocalId;
+	for (const auto item : _history->clientSideMessages()) {
+		if (IsClientMsgId(item->id)) {
+			if (rememberNew && item->id > known) {
+				_unseenLocalIds.emplace(item->id);
+			}
+			accumulate_max(_knownLocalId, item->id);
+		}
+	}
+}
+
+// Keep local messages between old neighbours where confirmed order permits it.
+// A genuinely late send can reverse those neighbours; predecessors win then.
+void PendingMessageOrder::apply(not_null<Data::MessagesSlice*> slice) {
+	const auto &previous = _previous->ids;
+	observeLocalIds(true);
+	if (&previous == &slice->ids || previous == slice->ids) {
+		return;
+	}
+	auto fresh = QVarLengthArray<FullMsgId, 16>();
+	for (const auto id : slice->ids) {
+		const auto unseen = _unseenLocalIds.find(id.msg);
+		if (unseen == _unseenLocalIds.end()) {
+			continue;
+		}
+		_unseenLocalIds.erase(unseen);
+		const auto item = _history->owner().message(id);
+		if (item && item->isSending()) {
+			fresh.push_back(id);
+		}
+	}
+	std::sort(fresh.begin(), fresh.end());
+	const auto parts = std::array{
+		std::span<const FullMsgId>(previous.data(), previous.size()),
+		std::span<const FullMsgId>(fresh.data(), fresh.size()),
+	};
+	const auto pending = ranges::count_if(previous, [](FullMsgId id) {
+		return IsClientMsgId(id.msg);
+	}) + fresh.size();
+	if (!pending) {
+		return;
+	}
+	auto &ids = slice->ids;
+	auto positions = base::flat_map<FullMsgId, int>();
+	positions.reserve(ids.size());
+	for (auto i = 0; i != ids.size(); ++i) {
+		positions.emplace(ids[i], i);
+	}
+	auto following = positions.end();
+	auto bounds = QVarLengthArray<FullMsgId, 16>();
+	bounds.reserve(pending);
+	for (const auto part : parts | ranges::views::reverse) {
+		for (const auto &id : part | ranges::views::reverse) {
+			const auto i = positions.find(id);
+			if (i == positions.end()) {
+				continue;
+			}
+			if (IsClientMsgId(id.msg)) {
+				bounds.push_back((following == positions.end())
+					? FullMsgId()
+					: following->first);
+			}
+			if (following == positions.end() || i->second < following->second) {
+				following = i;
+			}
+		}
+	}
+	auto preceding = positions.end();
+	if (!fresh.empty() && ranges::none_of(previous, [&](FullMsgId id) {
+			return positions.find(id) != positions.end();
+		})) {
+		// The first loaded slice, or a disjoint window, has no old anchors.
+		for (auto i = ids.rbegin(); i != ids.rend(); ++i) {
+			if (!std::binary_search(fresh.begin(), fresh.end(), *i)) {
+				preceding = positions.find(*i);
+				break;
+			}
+		}
+	}
+	for (const auto part : parts) {
+		for (const auto &id : part) {
+			const auto i = positions.find(id);
+			if (i == positions.end()) {
+				continue;
+			}
+			if (IsClientMsgId(id.msg)) {
+				const auto next = positions.find(bounds.back());
+				bounds.pop_back();
+				const auto from = i->second;
+				const auto lower = (preceding == positions.end())
+					? -1
+					: preceding->second;
+				const auto upper = (next == positions.end())
+					? int(ids.size())
+					: next->second;
+				const auto to = (from < lower)
+					? lower
+					: (from > upper && lower < upper)
+					? upper
+					: from;
+				if (from < to) {
+					std::rotate(begin(ids) + from, begin(ids) + from + 1, begin(ids) + to + 1);
+				} else if (from > to) {
+					std::rotate(begin(ids) + to, begin(ids) + from, begin(ids) + from + 1);
+				}
+				for (auto j = std::min(from, to); j <= std::max(from, to); ++j) {
+					positions.find(ids[j])->second = j;
+				}
+			}
+			if (preceding == positions.end() || i->second > preceding->second) {
+				preceding = i;
+			}
+		}
+	}
+}
