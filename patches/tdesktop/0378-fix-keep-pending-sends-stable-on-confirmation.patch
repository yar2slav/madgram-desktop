+auto &ConfirmationRegistry() {
+	static auto result = base::flat_map<
+		History*,
+		std::weak_ptr<base::flat_set<FullMsgId>>>();
+	return result;
+}
+
+struct HistoryConfirmations {
+	explicit HistoryConfirmations(not_null<History*> history) : history(history) {
+	}
+
+	~HistoryConfirmations() {
+		auto &registry = ConfirmationRegistry();
+		const auto i = registry.find(history.get());
+		if (i != registry.end() && i->second.expired()) {
+			registry.erase(i);
+		}
+	}
+
+	const not_null<History*> history;
+	base::flat_set<FullMsgId> ids;
+	rpl::lifetime lifetime;
+};
