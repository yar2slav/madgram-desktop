 	const auto group = item->history()->owner().groups().find(item);
@@ -441,6 +471,198 @@ void SendHeldNow(not_null<Main::Session*> session, FullMsgId id) {
 
 } // namespace
 
+std::shared_ptr<base::flat_set<FullMsgId>> UnindexedSentMessageIds(
+		not_null<History*> history) {
+	auto &weak = ConfirmationRegistry()[history.get()];
+	if (auto existing = weak.lock()) {
+		return existing;
+	}
+	const auto state = std::make_shared<HistoryConfirmations>(history);
+	auto result = std::shared_ptr<base::flat_set<FullMsgId>>(state, &state->ids);
+	weak = result;
+	const auto raw = state.get();
+	history->owner().itemIdChanged(
+	) | rpl::on_next([history, raw](const Data::Session::IdChange &event) {
+		if (event.newId.peer == history->peer->id
+			&& IsClientMsgId(event.oldId)
+			&& IsServerMsgId(event.newId.msg)) {
+			raw->ids.emplace(event.newId);
+		}
+	}, state->lifetime);
+	history->owner().itemRemoved(
+	) | rpl::on_next([raw](not_null<const HistoryItem*> item) {
+		const auto i = raw->ids.find(item->fullId());
+		if (i != raw->ids.end()) {
+			raw->ids.erase(i);
+		}
+	}, state->lifetime);
+	return result;
+}
+
+void RewriteMessageIds(
+		not_null<Data::MessagesSlice*> slice,
+		FullMsgId oldId,
+		FullMsgId newId) {
+	if (slice->nearestToAround == oldId) {
+		slice->nearestToAround = newId;
+	}
+	for (auto &fullId : slice->ids) {
+		if (fullId == oldId) {
+			fullId = newId;
+		}
+	}
+}
