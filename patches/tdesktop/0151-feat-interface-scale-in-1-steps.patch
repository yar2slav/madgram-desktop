Subject: [PATCH] feat: interface scale in 1% steps

---
 .../SourceFiles/settings/sections/settings_main.cpp    |  3 ++-
 Telegram/SourceFiles/settings/settings_tele.cpp        |  6 ++++++
 Telegram/SourceFiles/tele/tele_options.cpp             | 10 ++++++++++
 Telegram/SourceFiles/tele/tele_options.h               |  2 ++
 Telegram/SourceFiles/tele/tele_settings_io.cpp         |  1 +
 5 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/settings/sections/settings_main.cpp b/Telegram/SourceFiles/settings/sections/settings_main.cpp
index 83abcc6b3b9b2b0037fb92461651b2e6b9e1eaeb..7bdbb32993d422f5a6e41868fd11b4c98099eec9 100644
--- a/Telegram/SourceFiles/settings/sections/settings_main.cpp
+++ b/Telegram/SourceFiles/settings/sections/settings_main.cpp
@@ -9,6 +9,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 
 #include "settings/settings_common_session.h"
 #include "tele/tele_account_badges.h"
+#include "tele/tele_options.h"
 
 #include "api/api_cloud_password.h"
 #include "api/api_credits.h"
@@ -1094,7 +1095,7 @@ void SetupInterfaceScale(
 	const auto scaleMin = style::kScaleMin;
 	const auto scaleMax = style::MaxScaleForRatio(ratio);
 	const auto scaleConfig = cConfigScale();
-	const auto step = 5;
+	const auto step = Tele::ScaleOnePercent() ? 1 : 5;
 	Assert(!((scaleMax - scaleMin) % step));
 	auto values = std::vector<int>();
 	for (auto i = scaleMin; i != scaleMax; i += step) {
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index a45635d4258a1836ca9139d1f568b56bda9ad8d2..427ca5e96442cf6ba0741b9f1e864e599cc8d343 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1959,6 +1959,12 @@ void FillInterface(SectionBuilder &builder) {
 		{},
 		::Tele::kOptionHideSimilar);
 	AddGroupDivider(builder);
+	AddGroupTitle(builder, u"Scale"_q);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionScaleOnePercent,
+		{ u"zoom"_q, u"size"_q, u"interface"_q });
+	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Text"_q);
 	AddOptionToggle(builder, ::Tele::kOptionLowercase);
 	AddSkip(builder);
