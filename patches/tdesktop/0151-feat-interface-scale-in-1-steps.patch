@@ -28,6 +28,7 @@ const char kOptionHideCalls[] = "tele-hide-calls";
 const char kOptionCallButton[] = "tele-call-button";
 const char kOptionGroupCallButton[] = "tele-group-call-button";
 const char kOptionLowercase[] = "tele-lowercase";
+const char kOptionScaleOnePercent[] = "tele-scale-1";
 const char kOptionHideSponsored[] = "tele-hide-sponsored";
 const char kOptionHideProxySponsor[] = "tele-hide-proxy-sponsor";
 const char kOptionNoLinkWarning[] = "tele-no-link-warning";
@@ -260,6 +261,11 @@ base::options::toggle LowercaseOption({
 	.restartRequired = true,
 });
 
+base::options::toggle ScaleOnePercentOption({
+	.id = kOptionScaleOnePercent,
+	.name = "Interface scale in 1% steps",
+});
+
 base::options::toggle HideCallsOption({
 	.id = kOptionHideCalls,
 });
@@ -1051,6 +1057,10 @@ bool LowercaseStrings() {
 	return LowercaseOption.value();
 }
 
+bool ScaleOnePercent() {
+	return ScaleOnePercentOption.value();
+}
+
 QString CallButton() {
 	MigrateHideCalls();
 	return CallButtonOption.value();
