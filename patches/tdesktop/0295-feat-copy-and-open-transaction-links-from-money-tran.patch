@@ -17,6 +22,20 @@
 #include <QtGui/QCursor>
 
 namespace Tele {
+namespace {
+
+void CopyTransactionLink(
+		const std::shared_ptr<Main::SessionShow> &show,
+		const QString &url) {
+	TextUtilities::SetClipboardText(TextForMimeData::Simple(url));
+	ShowCopiedToast(show, {
+		.text = { tr::lng_background_link_copied(tr::now) },
+		.iconLottie = u"toast/voip_invite"_q,
+		.iconLottieSize = st::toastLottieIconSize,
+	}, { url });
+}
+
+} // namespace
 
 QString WalletTransactionUrl(const QByteArray &hash) {
 	return hash.isEmpty()
@@ -35,12 +54,7 @@ void AddWalletTransactionCopyLink(
 		std::shared_ptr<Main::SessionShow> show,
 		const QString &url) {
 	menu->addAction(tr::lng_context_copy_link(tr::now), [=] {
-		TextUtilities::SetClipboardText(TextForMimeData::Simple(url));
-		ShowCopiedToast(show, {
-			.text = { tr::lng_background_link_copied(tr::now) },
-			.iconLottie = u"toast/voip_invite"_q,
-			.iconLottieSize = st::toastLottieIconSize,
-		}, { url });
+		CopyTransactionLink(show, url);
 	}, &st::menuIconLink);
 }
 
@@ -74,4 +88,27 @@ void SetupWalletTransactionMenu(
 	}, row->lifetime());
 }
 
+void AddTransferMessageLinkActions(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<const HistoryItem*> item) {
+	const auto transfer = item->Get<HistoryServiceGramTransfer>();
+	if (NoMoney() || !transfer || transfer->transactionId.isEmpty()) {
+		return;
+	}
+	const auto url = WalletTransactionUrl(
+		Wallet::TransactionHashFromServer(transfer->transactionId));
+	if (url.isEmpty()) {
+		return;
+	}
+	menu->addAction(Lower(u"Copy Transaction Link"_q), [=] {
+		CopyTransactionLink(show, url);
+	}, &st::menuIconLink);
+	menu->addAction(
+		Ui::Text::FixAmpersandInAction(
+			tr::lng_channel_earn_history_out_button(tr::now)),
+		[=] { UrlClickHandler::Open(url); },
+		&st::menuIconSearch);
+}
+
 } // namespace Tele
