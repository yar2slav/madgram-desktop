+void AddWalletCopyWords(
+		not_null<Ui::GenericBox*> box,
+		const std::vector<QString> &words) {
+	const auto container = box->verticalLayout();
+	const auto wrap = container->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			container,
+			object_ptr<Ui::VerticalLayout>(container)),
+		style::margins(),
+		style::al_justify);
+	const auto text = QStringList(words.begin(), words.end()).join(
+		QChar(' '));
+	const auto show = box->uiShow();
+	AddLink(wrap->entity(), u"Copy Words"_q)->setClickedCallback([=] {
+		CopySecret(text);
+		show->showToast(tr::lng_text_copied(tr::now));
+	});
+	wrap->toggleOn(WalletCopyWordsValue(), anim::type::instant);
+}
+
