+#include "tele/tele_show_pinned.h"
+
+#include "data/data_changes.h"
+#include "data/data_chat.h"
+#include "data/data_forum_topic.h"
+#include "data/data_peer.h"
+#include "data/data_thread.h"
+#include "history/history.h"
+#include "main/main_session.h"
+#include "main/main_session_settings.h"
+#include "tele/tele_lowercase.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "window/window_peer_menu.h"
+#include "window/window_session_controller.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+enum class PinnedBarState {
+	None,
+	Shown,
+	Hidden,
+};
+
+[[nodiscard]] MsgId TopicRootId(not_null<Data::Thread*> thread) {
+	const auto topic = thread->asTopic();
+	return topic ? topic->rootId() : MsgId(0);
+}
+
+[[nodiscard]] PinnedBarState ResolveState(not_null<Data::Thread*> thread) {
+	const auto peer = thread->peer();
+	if ((!thread->asHistory() && !thread->asTopic())
+		|| peer->canPinMessages()) {
+		return PinnedBarState::None;
+	}
+	const auto topicRootId = TopicRootId(thread);
+	const auto migrated = topicRootId ? nullptr : peer->migrateFrom();
+	const auto top = Data::ResolveTopPinnedId(
+		peer,
+		topicRootId,
+		PeerId(0),
+		migrated);
+	const auto universal = !top
+		? MsgId(0)
+		: (migrated && !peerIsChannel(top.peer))
+		? (top.msg - ServerMaxMsgId)
+		: top.msg;
+	if (!universal) {
+		return PinnedBarState::None;
+	}
+	const auto hiddenId = peer->session().settings().hiddenPinnedMessageId(
+		peer->id,
+		topicRootId);
+	return (universal == hiddenId)
+		? PinnedBarState::Hidden
+		: PinnedBarState::Shown;
+}
+
+void Refresh(not_null<Data::Thread*> thread) {
+	thread->session().changes().entryUpdated(
+		thread,
+		Data::EntryUpdate::Flag::HasPinnedMessages);
+}
+
+} // namespace
+
+void AddPinnedBarAction(
+		not_null<Window::SessionController*> controller,
+		Data::Thread *thread,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto state = thread
+		? ResolveState(thread)
+		: PinnedBarState::None;
+	if (state == PinnedBarState::None) {
+		return;
+	}
+	const auto weak = base::make_weak(thread);
+	if (state == PinnedBarState::Shown) {
+		addAction(Lower(u"Hide pinned messages"_q), [=] {
+			const auto strong = weak.get();
+			if (!strong) {
+				return;
+			}
+			Window::HidePinnedBar(
+				controller,
+				strong->peer(),
+				TopicRootId(strong),
+				PeerId(0),
+				[=] {
+					if (const auto strong = weak.get()) {
+						Refresh(strong);
+					}
+				});
+		}, &st::menuIconUnpin);
+		return;
+	}
+	addAction(Lower(u"Show pinned messages"_q), [=] {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		const auto peer = strong->peer();
+		auto &session = peer->session();
+		session.settings().setHiddenPinnedMessageId(
+			peer->id,
+			TopicRootId(strong),
+			PeerId(0),
+			MsgId(0));
+		session.saveSettingsDelayed();
+		Refresh(strong);
+	}, &st::menuIconPin);
+}
+
+} // namespace Tele
