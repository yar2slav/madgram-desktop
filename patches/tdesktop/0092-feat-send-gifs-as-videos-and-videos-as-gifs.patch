+namespace Tele {
+namespace {
+
+void SendConfirmed(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread,
+		FullMsgId replyTo,
+		std::shared_ptr<Ui::PreparedBundle> bundle,
+		Api::SendOptions options) {
+	if (!bundle) {
+		return;
+	}
+	const auto payment = std::make_shared<SendPaymentHelper>();
+	const auto weak = base::make_weak(thread);
+	const auto withPaymentApproved = crl::guard(controller, [=](
+			int approved) {
+		payment->clear();
+		if (const auto strong = weak.get()) {
+			auto copy = options;
+			copy.starsApproved = approved;
+			SendConfirmed(controller, strong, replyTo, bundle, copy);
+		}
+	});
+	const auto checked = payment->check(
+		controller,
+		thread->peer(),
+		options,
+		bundle->totalCount,
+		withPaymentApproved);
+	if (!checked) {
+		return;
+	}
+	const auto type = bundle->way.sendImagesAsPhotos()
+		? SendMediaType::Photo
+		: SendMediaType::File;
+	auto action = Api::SendAction(thread, options);
+	action.clearDraft = false;
+	action.replyTo = FullReplyTo{
+		.messageId = replyTo,
+		.topicRootId = thread->topicRootId(),
+		.monoforumPeerId = thread->monoforumPeerId(),
+	};
+	auto &api = controller->session().api();
+	for (auto &group : bundle->groups) {
+		const auto album = (group.type != Ui::AlbumType::None)
+			? std::make_shared<SendingAlbum>()
+			: nullptr;
+		api.sendFiles(std::move(group.list), type, album, action);
+	}
+}
+
+} // namespace
+
+[[nodiscard]] Data::Thread *SendThread(
+		not_null<Window::SessionController*> controller,
+		not_null<HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	if (const auto thread = controller->activeChatCurrent().thread()) {
+		if (thread->peer() == peer) {
+			return thread;
+		}
+	}
+	if (const auto topic = item->topic()) {
+		return topic;
+	} else if (const auto sublist = item->savedSublist()) {
+		return sublist;
+	}
+	return item->history();
+}
+
+void ShowSendFilesBox(
+		not_null<Window::SessionController*> controller,
+		not_null<Data::Thread*> thread,
+		Ui::PreparedList &&list,
+		Fn<void()> sent) {
+	const auto weak = base::make_weak(thread);
+	const auto peer = thread->peer();
+	const auto show = controller->uiShow();
+	show->show(Box<SendFilesBox>(SendFilesBoxDescriptor{
+		.show = show,
+		.list = std::move(list),
+		.caption = TextWithTags(),
+		.toPeer = peer,
+		.limits = DefaultLimitsForPeer(peer),
+		.check = DefaultCheckForPeer(show, peer),
+		.sendType = Api::SendType::Normal,
+		.confirmed = crl::guard(controller, [=](
+				std::shared_ptr<Ui::PreparedBundle> bundle,
+				Api::SendOptions options,
+				FullReplyTo currentReplyTo) {
+			if (const auto strong = weak.get()) {
+				SendConfirmed(
+					controller,
+					strong,
+					currentReplyTo.messageId,
+					std::move(bundle),
+					options);
+				if (sent) {
+					sent();
+				}
+			}
+		}),
+		.replyTo = FullReplyTo{
+			.topicRootId = thread->topicRootId(),
+			.monoforumPeerId = thread->monoforumPeerId(),
+		},
+	}));
+}
+
+} // namespace Tele
