+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+using Image = Ui::PreparedFileInformation::Image;
+using Video = Ui::PreparedFileInformation::Video;
+
+[[nodiscard]] Video *LookupVideo(const Ui::PreparedFile &file) {
+	return file.information
+		? std::get_if<Video>(&file.information->media)
+		: nullptr;
+}
+
+[[nodiscard]] bool Transcodable(const Ui::PreparedFile &file) {
+	const auto size = file.path.isEmpty()
+		? int64(file.content.size())
+		: file.size;
+	return (size < Media::Encode::MaxTranscodeSourceSize());
+}
+
+[[nodiscard]] bool IsGifImage(const Ui::PreparedFile &file) {
+	const auto image = file.information
+		? std::get_if<Image>(&file.information->media)
+		: nullptr;
+	return image
+		&& image->animated
+		&& (file.information->filemime == u"image/gif"_q)
+		&& (!file.path.isEmpty() || !file.content.isEmpty())
+		&& Transcodable(file);
+}
+
+void SetSendAsGif(Video &video, bool gif) {
+	video.modifications.gif = gif;
+	video.silentVideo = !gif && !video.hasAudio;
+}
+
+[[nodiscard]] bool ConvertGifToVideo(Ui::PreparedFile &file) {
+	auto prepared = Media::Clip::PrepareForSending(file.path, file.content);
+	const auto video = std::get_if<Video>(&prepared.media);
+	if (!video
+		|| (video->duration <= 0)
+		|| video->thumbnail.isNull()
+		|| !Ui::ValidateThumbDimensions(
+			video->thumbnail.width(),
+			video->thumbnail.height())) {
+		return false;
+	}
+	video->isGifv = false;
+	video->modifications.gif = false;
+	file.information->media = std::move(*video);
+	file.type = Ui::PreparedFile::Type::Video;
+	Storage::UpdateVideoDetails(
+		file,
+		st::sendMediaPreviewSize,
+		PhotoSideLimit());
+	return true;
+}
+
+[[nodiscard]] bool Loadable(not_null<DocumentData*> document) {
+	if (document->size >= Media::Encode::MaxTranscodeSourceSize()) {
+		return false;
+	}
+	const auto inMemory = (document->size <= Storage::kMaxFileInMemory);
+	return inMemory || !document->filepath(true).isEmpty();
+}
+
+[[nodiscard]] DocumentData *ResendDocument(not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	const auto document = media ? media->document() : nullptr;
+	if (!document
+		|| media->ttlSeconds()
+		|| !item->isRegular()
+		|| item->isSponsored()
+		|| item->forbidsSaving()
+		|| (!document->isGifv()
+			&& (!document->isVideoFile() || document->isVideoMessage()))
+		|| !Loadable(document)) {
+		return nullptr;
+	}
+	return document;
+}
+
+[[nodiscard]] Ui::PreparedList PrepareResend(
+		not_null<DocumentData*> document,
+		const QByteArray &bytes,
+		bool toGif) {
+	auto result = Ui::PreparedList();
+	const auto path = bytes.isEmpty() ? document->filepath(true) : QString();
+	if (bytes.isEmpty() && path.isEmpty()) {
+		return result;
+	}
+	auto file = Ui::PreparedFile(path);
+	if (path.isEmpty()) {
+		file.content = QByteArray(bytes.constData(), bytes.size());
+		file.size = file.content.size();
+		file.displayName = document->filename();
+	} else {
+		file.size = QFileInfo(path).size();
+	}
+	Storage::PrepareDetails(file, st::sendMediaPreviewSize, PhotoSideLimit());
+	const auto video = LookupVideo(file);
+	if (!video
+		|| (file.type != Ui::PreparedFile::Type::Video)
+		|| !file.canEditVideo()) {
+		return result;
+	}
+	SetSendAsGif(*video, toGif);
+	result.files.push_back(std::move(file));
+	return result;
+}
+
+void Resend(
+		not_null<Window::SessionController*> controller,
+		not_null<DocumentData*> document,
+		Data::FileOrigin origin,
+		Fn<Data::Thread*()> resolveThread,
+		bool toGif) {
+	const auto media = document->createMediaView();
+	const auto ready = [=] {
+		const auto thread = resolveThread();
+		if (!thread) {
+			return;
+		}
+		auto list = PrepareResend(document, media->bytes(), toGif);
+		if (list.files.empty()) {
+			controller->showToast(Lower(u"Couldn't prepare this file."_q));
+			return;
+		}
+		ShowSendFilesBox(controller, thread, std::move(list));
+	};
+	if (media->loaded(true)) {
+		ready();
+		return;
+	} else if (document->size > Storage::kMaxFileInMemory) {
+		controller->showToast(Lower(u"Download the file first."_q));
+		return;
+	}
+	document->save(origin, QString());
+	if (media->loaded(true)) {
+		ready();
+		return;
+	} else if (!document->loading()) {
+		controller->showToast(Lower(u"Couldn't download this file."_q));
+		return;
+	}
+	controller->showToast(Lower(u"Downloading..."_q));
+	document->session().downloaderTaskFinished(
+	) | rpl::filter([=] {
+		return media->loaded(true) || !document->loading();
+	}) | rpl::take(1) | rpl::on_next([=] {
+		if (media->loaded(true)) {
+			ready();
+		} else {
+			controller->showToast(Lower(u"Couldn't download this file."_q));
+		}
+	}, controller->lifetime());
+}
+
+} // namespace
+
+bool SendsAsGif(const Ui::PreparedFile &file, bool album) {
+	if (const auto video = LookupVideo(file)) {
+		return video->modifications.gif && (!album || video->hasAudio);
+	}
+	return !album && IsGifImage(file);
+}
+
+bool SendsAsSilentVideo(const Ui::PreparedFileInformation &information) {
+	const auto video = std::get_if<Video>(&information.media);
+	return video
+		&& video->silentVideo
+		&& !video->modifications.gif
+		&& !video->hasAudio;
+}
+
+void AddSendAsGifAction(
+		not_null<Ui::PopupMenu*> menu,
+		const Ui::PreparedFile &file,
+		bool available,
+		bool album,
+		Fn<void()> toggle) {
+	if (!available) {
+		return;
+	}
+	const auto video = LookupVideo(file);
+	if (video) {
+		const auto toGif = !video->modifications.gif && video->hasAudio;
+		if (!file.canEditVideo()
+			|| (album && !video->hasAudio)
+			|| (toGif && !Transcodable(file))) {
+			return;
+		}
+	} else if (!IsGifImage(file)) {
+		return;
+	}
+	const auto gif = !video || video->modifications.gif;
+	menu->addAction(
+		Lower(gif ? u"Send as video"_q : u"Send as GIF"_q),
+		std::move(toggle),
+		gif ? &st::menuIconVideoChat : &st::menuIconGif);
+}
+
+void ToggleSendAsGif(
+		Ui::PreparedFile &file,
+		std::shared_ptr<Ui::Show> show) {
+	if (const auto video = LookupVideo(file)) {
+		SetSendAsGif(*video, !video->modifications.gif);
+	} else if (IsGifImage(file) && !ConvertGifToVideo(file)) {
+		show->showToast(Lower(u"Couldn't read this GIF as a video."_q));
+	}
+}
+
+void AddResendAsGifAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionController*> controller,
+		HistoryItem *item) {
+	const auto document = item ? ResendDocument(item) : nullptr;
+	if (!document || OfflineForLaunch()) {
+		return;
+	}
+	const auto toGif = !document->isGifv();
+	const auto thread = SendThread(controller, item);
+	const auto right = toGif
+		? ChatRestriction::SendGifs
+		: ChatRestriction::SendVideos;
+	if (!thread || !Data::CanSend(thread, right)) {
+		return;
+	}
+	const auto itemId = item->fullId();
+	menu->addAction(
+		Lower(toGif ? u"Send as GIF"_q : u"Send as video"_q),
+		[=] {
+			const auto resolveThread = [=]() -> Data::Thread* {
+				const auto item = document->owner().message(itemId);
+				return item ? SendThread(controller, item) : nullptr;
+			};
+			Resend(controller, document, itemId, resolveThread, toGif);
+		},
+		toGif ? &st::menuIconGif : &st::menuIconVideoChat);
+}
+
+void AddPanelGifAsVideoAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<ChatHelpers::Show> show,
+		DocumentData *document,
+		PeerData *peer) {
+	const auto controller = show->resolveWindow();
+	if (!controller
+		|| !document
+		|| !peer
+		|| !document->isGifv()
+		|| !Loadable(document)
+		|| OfflineForLaunch()) {
+		return;
+	}
+	const auto resolveThread = [=]() -> Data::Thread* {
+		const auto active = controller->activeChatCurrent().thread();
+		return (active && active->peer() == peer)
+			? active
+			: static_cast<Data::Thread*>(peer->owner().history(peer));
+	};
+	const auto thread = resolveThread();
+	if (!Data::CanSend(thread, ChatRestriction::SendVideos)) {
+		return;
+	}
+	menu->addAction(
+		Lower(u"Send as video"_q),
+		[=] {
+			Resend(
+				controller,
+				document,
+				document->stickerOrGifOrigin(),
+				resolveThread,
+				false);
+		},
+		&st::menuIconVideoChat);
+}
+
+} // namespace Tele
