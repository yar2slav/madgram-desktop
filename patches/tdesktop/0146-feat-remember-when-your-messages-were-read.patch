diff --git a/Telegram/SourceFiles/tele/tele_read_log.cpp b/Telegram/SourceFiles/tele/tele_read_log.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bbb41a8ebd4b4502cacc90cb7cca618b3e6ff9fe
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_read_log.cpp
@@ -0,0 +1,291 @@
+#include "tele/tele_read_log.h"
+
+#include "api/api_updates.h"
+#include "api/api_who_reacted.h"
+#include "base/timer.h"
+#include "base/unixtime.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "ui/controls/who_reacted_context_action.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E4EAD);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxEntries = 200;
+constexpr auto kMaxChats = 1000;
+constexpr auto kWriteDelay = crl::time(5000);
+
+struct Entry {
+	MsgId till = 0;
+	TimeId date = 0;
+};
+
+class State final {
+public:
+	explicit State(not_null<Main::Session*> session);
+	~State();
+
+	[[nodiscard]] static State &Get(not_null<Main::Session*> session);
+
+	void add(PeerId peer, MsgId was, MsgId till, TimeId date);
+	[[nodiscard]] TimeId find(PeerId peer, MsgId id) const;
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+	void dropOldestChat();
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<PeerId, std::vector<Entry>> _chats;
+	base::Timer _writeTimer;
+	rpl::lifetime _lifetime;
+
+};
+
+State::State(not_null<Main::Session*> session)
+: _session(session)
+, _writeTimer([=] { write(); }) {
+	Registry().emplace(session, this);
+	read();
+
+	session->data().sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		if (_writeTimer.isActive()) {
+			_writeTimer.cancel();
+			write();
+		}
+	}, _lifetime);
+}
+
+State::~State() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>> &State::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<State*>>();
+	return result;
+}
+
+State &State::Get(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry))
+		? *i->second
+		: *session->lifetime().make_state<State>(session);
+}
+
+QString State::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void State::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"tele_readlog"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxChats) {
+		return;
+	}
+	auto chats = base::flat_map<PeerId, std::vector<Entry>>();
+	chats.reserve(count);
+	for (auto i = quint32(); i != count; ++i) {
+		auto peer = quint64();
+		auto size = quint32();
+		file.stream >> peer >> size;
+		if (file.stream.status() != QDataStream::Ok || size > kMaxEntries) {
+			return;
+		}
+		auto list = std::vector<Entry>();
+		list.reserve(size);
+		for (auto j = quint32(); j != size; ++j) {
+			auto till = qint64();
+			auto date = qint32();
+			file.stream >> till >> date;
+			if (file.stream.status() != QDataStream::Ok
+				|| (!list.empty() && MsgId(till) <= list.back().till)) {
+				return;
+			}
+			list.push_back({ MsgId(till), TimeId(date) });
+		}
+		if (peer && !list.empty()) {
+			chats.emplace(PeerId(PeerIdHelper(peer)), std::move(list));
+		}
+	}
+	_chats = std::move(chats);
+}
+
+void State::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &[peer, list] : _chats) {
+		size += sizeof(quint64) + sizeof(quint32);
+		size += list.size() * (sizeof(qint64) + sizeof(qint32));
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_chats.size());
+	for (const auto &[peer, list] : _chats) {
+		data.stream << quint64(peer.value) << quint32(list.size());
+		for (const auto &entry : list) {
+			data.stream << qint64(entry.till.bare) << qint32(entry.date);
+		}
+	}
+	auto file = FileWriteDescriptor(u"tele_readlog"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+void State::dropOldestChat() {
+	auto oldest = end(_chats);
+	for (auto i = begin(_chats); i != end(_chats); ++i) {
+		if (oldest == end(_chats)
+			|| i->second.back().date < oldest->second.back().date) {
+			oldest = i;
+		}
+	}
+	if (oldest != end(_chats)) {
+		_chats.erase(oldest);
+	}
+}
+
+void State::add(PeerId peer, MsgId was, MsgId till, TimeId date) {
+	if (!_chats.contains(peer) && _chats.size() >= kMaxChats) {
+		dropOldestChat();
+	}
+	auto &list = _chats[peer];
+	const auto last = list.empty() ? MsgId() : list.back().till;
+	if (till <= last) {
+		return;
+	}
+	if (was > last) {
+		list.push_back({ was, 0 });
+	}
+	list.push_back({ till, date });
+	if (list.size() > kMaxEntries) {
+		const auto drop = int(list.size()) - kMaxEntries + 1;
+		const auto edge = list[drop - 1].till;
+		list.erase(begin(list), begin(list) + drop);
+		list.insert(begin(list), Entry{ edge, 0 });
+	}
+	_writeTimer.callOnce(kWriteDelay);
+}
+
+TimeId State::find(PeerId peer, MsgId id) const {
+	const auto i = _chats.find(peer);
+	if (i == end(_chats)) {
+		return 0;
+	}
+	const auto &list = i->second;
+	const auto j = ranges::lower_bound(list, id, ranges::less(), &Entry::till);
+	return (j != end(list)) ? j->date : 0;
+}
+
+[[nodiscard]] UserData *LoggedUser(not_null<History*> history) {
+	const auto user = history->peer->asUser();
+	return (!user || user->isSelf() || user->isBot() || user->isServiceUser())
+		? nullptr
+		: user;
+}
+
+[[nodiscard]] Ui::WhoReadParticipant Participant(
+		not_null<PeerData*> peer,
+		TimeId date) {
+	return {
+		.name = peer->name(),
+		.date = Api::FormatReadDate(date, QDateTime::currentDateTime()),
+		.id = peer->id.value,
+	};
+}
+
+} // namespace
+
+void LogOutboxRead(not_null<History*> history, MsgId was, MsgId till) {
+	if (till <= was) {
+		return;
+	}
+	const auto user = LoggedUser(history);
+	const auto session = &history->session();
+	if (!user || session->updates().requestingDifference()) {
+		return;
+	}
+	State::Get(session).add(user->id, was, till, base::unixtime::now());
+}
+
+TimeId LoggedReadDate(not_null<HistoryItem*> item) {
+	const auto history = item->history();
+	const auto user = LoggedUser(history);
+	if (!user
+		|| !item->out()
+		|| !item->isRegular()
+		|| item->unread(history)) {
+		return 0;
+	}
+	return State::Get(&history->session()).find(user->id, item->id);
+}
+
+rpl::producer<Ui::WhoReadContent> LoggedReadContent(
+		not_null<HistoryItem*> item,
+		TimeId date) {
+	return rpl::single(Ui::WhoReadContent{
+		.participants = { Participant(item->history()->peer, date) },
+		.type = Ui::WhoReadType::Seen,
+		.fullReadCount = 1,
+	});
+}
+
+rpl::producer<Ui::WhoReadContent> WithLoggedReadDate(
+		not_null<HistoryItem*> item,
+		rpl::producer<Ui::WhoReadContent> content) {
+	const auto date = LoggedReadDate(item);
+	if (!date) {
+		return content;
+	}
+	const auto peer = item->history()->peer;
+	return std::move(
+		content
+	) | rpl::map([=](Ui::WhoReadContent value) {
+		if (value.state != Ui::WhoReadState::Unknown
+			&& value.participants.empty()) {
+			value.participants.push_back(Participant(peer, date));
+			value.state = Ui::WhoReadState::Empty;
+			value.fullReadCount = 1;
+		}
+		return value;
+	});
+}
+
+} // namespace Tele
