diff --git a/Telegram/SourceFiles/tele/tele_recent_emoji.cpp b/Telegram/SourceFiles/tele/tele_recent_emoji.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4bfa1a7eb55909962a75bb643b8a282510b1a7ef
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_recent_emoji.cpp
@@ -0,0 +1,149 @@
+#include "tele/tele_recent_emoji.h"
+
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "data/data_document.h"
+#include "data/data_session.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "history/history.h"
+#include "main/main_session.h"
+#include "ui/chat/attach/attach_prepare.h"
+#include "ui/emoji_config.h"
+#include "ui/text/text_entity.h"
+
+namespace Tele {
+namespace {
+
+using EmojiKey = std::variant<EmojiPtr, Core::RecentEmojiDocument>;
+
+struct CustomRange {
+	int from = 0;
+	int till = 0;
+	DocumentId id = 0;
+};
+
+base::flat_map<EmojiKey, int> Remembered;
+std::vector<Core::RecentEmojiId> LastCounted;
+bool LastCountedFresh = false;
+bool Counting = false;
+int Skipping = 0;
+
+[[nodiscard]] std::vector<CustomRange> CustomRanges(
+		const TextWithTags &text) {
+	auto result = std::vector<CustomRange>();
+	const auto entities = TextUtilities::ConvertTextTagsToEntities(
+		text.tags);
+	for (const auto &entity : entities) {
+		if (entity.type() != EntityType::CustomEmoji) {
+			continue;
+		}
+		result.push_back({
+			.from = entity.offset(),
+			.till = entity.offset() + entity.length(),
+			.id = Data::ParseCustomEmojiData(entity.data()),
+		});
+	}
+	ranges::sort(result, ranges::less(), &CustomRange::from);
+	return result;
+}
+
+[[nodiscard]] std::vector<Core::RecentEmojiId> Collect(
+		not_null<History*> history,
+		const TextWithTags &text) {
+	const auto session = &history->session();
+	const auto test = session->isTestMode();
+	const auto custom = CustomRanges(text);
+	auto result = std::vector<Core::RecentEmojiId>();
+	auto next = custom.begin();
+	auto position = 0;
+	auto length = 0;
+	const auto size = int(text.text.size());
+	while (position < size) {
+		while (next != custom.end() && next->till <= position) {
+			++next;
+		}
+		if (next != custom.end() && next->from <= position) {
+			const auto document = next->id
+				? session->data().document(next->id).get()
+				: nullptr;
+			if (document
+				&& (!document->isPremiumEmoji() || session->premium())) {
+				result.push_back({ Core::RecentEmojiDocument{
+					.id = next->id,
+					.test = test,
+				} });
+			}
+			position = next->till;
+			continue;
+		}
+		const auto view = QStringView(text.text).mid(position);
+		if (const auto emoji = Ui::Emoji::Find(view, &length)) {
+			result.push_back({ emoji });
+			position += length;
+		} else {
+			++position;
+		}
+	}
+	return result;
+}
+
+void Count(std::vector<Core::RecentEmojiId> &&ids) {
+	if (Skipping || ids.empty()) {
+		return;
+	} else if (LastCountedFresh && ids == LastCounted) {
+		return;
+	} else if (!LastCountedFresh) {
+		LastCountedFresh = true;
+		crl::on_main([] {
+			LastCountedFresh = false;
+			LastCounted.clear();
+		});
+	}
+	auto &settings = Core::App().settings();
+	Counting = true;
+	for (const auto &id : ids) {
+		const auto i = Remembered.find(id.data);
+		if (i != end(Remembered)) {
+			if (!--i->second) {
+				Remembered.erase(i);
+			}
+			continue;
+		}
+		settings.incrementRecentEmoji(id);
+	}
+	Counting = false;
+	LastCounted = std::move(ids);
+}
+
+} // namespace
+
+SentEmojiSkip::SentEmojiSkip() {
+	++Skipping;
+}
+
+SentEmojiSkip::~SentEmojiSkip() {
+	--Skipping;
+}
+
+void RememberRecentEmoji(const Core::RecentEmojiId &id) {
+	if (!Counting) {
+		++Remembered[id.data];
+	}
+}
+
+void CountSentEmoji(not_null<History*> history, const TextWithTags &text) {
+	Count(Collect(history, text));
+}
+
+void CountSentEmoji(
+		not_null<History*> history,
+		const Ui::PreparedList &list) {
+	auto ids = std::vector<Core::RecentEmojiId>();
+	for (const auto &file : list.files) {
+		auto caption = Collect(history, file.caption);
+		ids.insert(end(ids), begin(caption), end(caption));
+	}
+	Count(std::move(ids));
+}
+
+} // namespace Tele
