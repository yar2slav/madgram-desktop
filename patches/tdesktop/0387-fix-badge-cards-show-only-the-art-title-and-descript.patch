@@ -238,22 +229,25 @@ void Card::refreshArt() {
 
 void Card::layoutCard() {
 	const auto inner = Scaled(kCardWidth) - 2 * Scaled(kPadding);
-	_titleHeight = std::min(
-		_title.countHeight(inner),
-		kTitleLines * st::sessionBigName.style.font->height);
-	_descriptionHeight = _description.isEmpty()
-		? 0
-		: std::min(
-			_description.countHeight(inner),
-			kDescriptionLines * st::defaultTextStyle.font->height);
-	_cardHeight = Scaled(18)
-		+ _labelFont->height
+	const auto lines = [&](const Ui::Text::String &text, int line, int max) {
+		return text.isEmpty()
+			? 0
+			: std::clamp(
+				(text.countHeight(inner) + line - 1) / line,
+				1,
+				max);
+	};
+	const auto titleLine = st::sessionBigName.style.font->height;
+	const auto descriptionLine = st::defaultTextStyle.font->height;
+	_titleLines = lines(_title, titleLine, kTitleLines);
+	_descriptionLines = lines(_description, descriptionLine, kDescriptionLines);
+	_cardHeight = Scaled(kTop)
 		+ Scaled(kArt)
-		+ _titleHeight
-		+ (_descriptionHeight ? (Scaled(6) + _descriptionHeight) : 0)
-		+ Scaled(14)
-		+ _footerFont->height
-		+ Scaled(20);
+		+ _titleLines * titleLine
+		+ (_descriptionLines
+			? (Scaled(8) + _descriptionLines * descriptionLine)
+			: 0)
+		+ Scaled(kBottom);
 }
 
 QRect Card::cardGeometry() const {
@@ -312,13 +306,6 @@ void Card::hideAnimated() {
 	}, _shown.value(1.), 0., kHideDuration, anim::linear);
