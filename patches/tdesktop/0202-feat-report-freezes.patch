+#pragma once
+
+#include "core/crash_reports.h"
+
+namespace Tele {
+
+void StartFreezeWatchdog();
+[[nodiscard]] CrashReports::StartResult WithFreezeReport(
+	CrashReports::StartResult result);
+[[nodiscard]] int FreezeReportSeconds(const QByteArray &report);
+void ForgetFreezeReport();
+
