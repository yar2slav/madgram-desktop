new file mode 100644
index 0000000000000000000000000000000000000000..abf9901827dcce889a25e636bf99bd90c74cfe30
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_freeze_watchdog.cpp
@@ -0,0 +1,395 @@
+#include "tele/tele_freeze_watchdog.h"
+
+#include "core/application.h"
+#include "core/launcher.h"
+#include "core/version.h"
+#include "tele/tele_build.h"
+#include "tele/tele_crash.h"
+
+#include <QtCore/QSaveFile>
+#include <QtCore/QTimer>
+#include <QtCore/QUuid>
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#ifdef Q_OS_WIN
+#include <windows.h>
+#include <dbghelp.h>
+#elif !defined Q_OS_MAC && !defined TDESKTOP_DISABLE_CRASH_REPORTS
+#include <client/linux/handler/exception_handler.h>
+#endif
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxMarkerSize = qint64(64 * 1024);
+constexpr char kFreezeNote[] = "Tele-Note: freeze ";
+
+[[nodiscard]] QString MarkerPath() {
+	return cWorkingDir() + u"tdata/freeze"_q;
+}
+
+std::atomic<int> Paused = 0;
+
+#ifndef Q_OS_MAC
+
+using Clock = std::chrono::steady_clock;
+using WallClock = std::chrono::system_clock;
+
+constexpr auto kTick = std::chrono::seconds(1);
+constexpr auto kFreeze = std::chrono::seconds(15);
+constexpr auto kSleepGap = std::chrono::seconds(5);
+constexpr auto kMaxDumps = 3;
+
+struct State {
+	std::atomic<uint64> heartbeat = 0;
+	std::mutex mutex;
+	std::condition_variable wake;
+	bool stopped = false;
+	bool watching = false;
+	QString dumps;
+	QString marker;
+	QByteArray header;
+#ifdef Q_OS_WIN
+	DWORD mainThreadId = 0;
+#endif
+};
+
+[[nodiscard]] QByteArray Header() {
+	const auto version = cAlphaVersion()
+		? u"%1 alpha"_q.arg(cAlphaVersion())
+		: (AppBetaVersion ? u"%1 beta"_q : u"%1"_q).arg(AppVersion);
+	const auto fields = std::vector<std::pair<QString, QString>>{
+		{ u"ApiId"_q, QString::number(ApiId) },
+		{ u"Binary"_q, cExeName() },
+		{
+			u"Launched"_q,
+			QDateTime::currentDateTime().toString(u"dd.MM.yyyy hh:mm:ss"_q),
+		},
+		{ u"Platform"_q, CrashReports::PlatformString() },
+		{ u"Tele"_q, QString::number(BuildNumber()) },
+		{
+			u"UserTag"_q,
+			QString::number(Core::Launcher::Instance().installationTag(), 16),
+		},
+		{ u"Version"_q, version },
+	};
+	auto result = QByteArray();
+	for (const auto &[key, value] : fields) {
+		result.append(key.toUtf8()).append(": ").append(value.toUtf8());
+		result.append('\n');
+	}
+	return result;
+}
+
+[[nodiscard]] qint64 Seconds(Clock::duration duration) {
+	return std::chrono::duration_cast<std::chrono::seconds>(duration).count();
+}
+
+#ifdef Q_OS_WIN
+
+using MiniDumpWriteDumpFn = BOOL(WINAPI*)(
+	HANDLE,
+	DWORD,
+	HANDLE,
+	MINIDUMP_TYPE,
+	PMINIDUMP_EXCEPTION_INFORMATION,
+	PMINIDUMP_USER_STREAM_INFORMATION,
+	PMINIDUMP_CALLBACK_INFORMATION);
+
+[[nodiscard]] QString WriteDump(const State &state) {
+	static const auto write = [] {
+		const auto module = LoadLibraryW(L"dbghelp.dll");
+		return module
+			? reinterpret_cast<MiniDumpWriteDumpFn>(
+				GetProcAddress(module, "MiniDumpWriteDump"))
+			: nullptr;
+	}();
+	static const auto thread = OpenThread(
+		THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION,
+		FALSE,
+		state.mainThreadId);
+	if (!write || !thread) {
+		return QString();
+	}
+	QDir().mkpath(state.dumps);
+	const auto name = QUuid::createUuid().toString(QUuid::WithoutBraces)
+		+ u".dmp"_q;
+	const auto path = QDir::toNativeSeparators(
+		state.dumps + '/' + name).toStdWString();
+	const auto file = CreateFileW(
+		path.c_str(),
+		GENERIC_WRITE,
+		0,
+		nullptr,
+		CREATE_NEW,
+		FILE_ATTRIBUTE_NORMAL,
+		nullptr);
+	if (file == INVALID_HANDLE_VALUE) {
+		return QString();
+	}
+	auto context = CONTEXT();
+	context.ContextFlags = CONTEXT_FULL;
+	auto captured = false;
+	if (SuspendThread(thread) != DWORD(-1)) {
+		captured = (GetThreadContext(thread, &context) != FALSE);
+		ResumeThread(thread);
+	}
+	auto record = EXCEPTION_RECORD();
+	record.ExceptionCode = EXCEPTION_BREAKPOINT;
+#if defined _M_X64
+	record.ExceptionAddress = reinterpret_cast<PVOID>(context.Rip);
+#elif defined _M_ARM64
+	record.ExceptionAddress = reinterpret_cast<PVOID>(context.Pc);
+#elif defined _M_IX86
+	record.ExceptionAddress = reinterpret_cast<PVOID>(context.Eip);
+#endif
+	auto pointers = EXCEPTION_POINTERS{ &record, &context };
+	auto exception = MINIDUMP_EXCEPTION_INFORMATION{
+		state.mainThreadId,
+		&pointers,
+		FALSE,
+	};
+	const auto written = write(
+		GetCurrentProcess(),
+		GetCurrentProcessId(),
+		file,
+		MiniDumpNormal,
+		captured ? &exception : nullptr,
+		nullptr,
+		nullptr);
+	CloseHandle(file);
+	if (!written) {
+		DeleteFileW(path.c_str());
+		return QString();
+	}
+	return name;
+}
+
+#elif !defined TDESKTOP_DISABLE_CRASH_REPORTS
+
+bool DumpWritten(
+		const google_breakpad::MinidumpDescriptor &descriptor,
+		void *context,
+		bool succeeded) {
+	if (succeeded) {
+		*static_cast<QString*>(context) = QFileInfo(
+			QFile::decodeName(descriptor.path())).fileName();
+	}
+	return succeeded;
+}
+
+[[nodiscard]] QString WriteDump(const State &state) {
+	QDir().mkpath(state.dumps);
+	auto result = QString();
+	google_breakpad::ExceptionHandler::WriteMinidump(
+		QFile::encodeName(state.dumps).toStdString(),
+		DumpWritten,
+		&result);
+	return result;
+}
+
+#else
+
+[[nodiscard]] QString WriteDump(const State &state) {
+	return QString();
+}
+
+#endif
+
+void WriteMarker(
+		const State &state,
+		const QString &dump,
+		const QDateTime &started,
+		qint64 seconds) {
+	const auto duration = QByteArray::number(seconds);
+	auto text = state.header;
+	if (!dump.isEmpty()) {
+		text.append("Minidump: ").append(dump.toUtf8()).append('\n');
+	}
+	text.append("Froze: ");
+	text.append(started.toString(u"dd.MM.yyyy hh:mm:ss"_q).toUtf8());
+	text.append('\n');
+	text.append(kFreezeNote).append(duration).append(" s\n\n");
+	text.append("Main thread was not responding for ").append(duration);
+	text.append(" s\n");
+	auto file = QSaveFile(state.marker);
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(text);
+		file.commit();
+	}
+}
+
+void Watch(const std::shared_ptr<State> &state) {
+	auto beat = state->heartbeat.load();
+	auto changed = Clock::now();
+	auto lastMono = changed;
+	auto lastWall = WallClock::now();
+	auto episode = false;
+	auto dumps = 0;
+	auto dump = QString();
+	auto started = QDateTime();
+	auto written = Clock::time_point();
+	while (true) {
+		{
+			auto lock = std::unique_lock(state->mutex);
+			if (state->wake.wait_for(lock, kTick, [&] {
+				return state->stopped;
+			})) {
+				return;
+			}
+		}
+		const auto mono = Clock::now();
+		const auto wall = WallClock::now();
+		const auto monoStep = mono - lastMono;
+		const auto wallStep = std::chrono::duration_cast<Clock::duration>(
+			wall - lastWall);
+		lastMono = mono;
+		lastWall = wall;
+		const auto drift = (wallStep > monoStep)
+			? (wallStep - monoStep)
+			: (monoStep - wallStep);
+		const auto slept = (monoStep > kSleepGap) || (drift > kSleepGap);
+
+		const auto current = state->heartbeat.load();
+		if (current != beat) {
+			beat = current;
+			if (episode) {
+				episode = false;
+				WriteMarker(*state, dump, started, Seconds(mono - changed));
+			}
+			changed = mono;
+			continue;
+		} else if (slept || Paused.load()) {
+			if (!episode) {
+				changed = mono;
+			}
+			continue;
+		}
+		const auto frozen = mono - changed;
+		if (episode) {
+			if (mono - written >= kFreeze) {
+				written = mono;
+				WriteMarker(*state, dump, started, Seconds(frozen));
+			}
+			continue;
+		} else if (frozen < kFreeze || dumps == kMaxDumps) {
+			continue;
+		}
+		++dumps;
+		episode = true;
+		started = QDateTime::currentDateTime().addSecs(-Seconds(frozen));
+		dump = WriteDump(*state);
+		WriteMarker(*state, dump, started, Seconds(frozen));
+		written = lastMono = Clock::now();
+		lastWall = WallClock::now();
+	}
+}
+
+void Stop(const std::shared_ptr<State> &state) {
+	{
+		const auto lock = std::lock_guard(state->mutex);
+		state->stopped = true;
+	}
+	state->wake.notify_all();
+}
+
+#endif
+
+} // namespace
+
+FreezeWatchdogPause::FreezeWatchdogPause() {
+	++Paused;
+}
+
+FreezeWatchdogPause::~FreezeWatchdogPause() {
+	--Paused;
+}
+
+void StartFreezeWatchdog() {
+#ifndef Q_OS_MAC
+	static auto started = false;
+	if (started || !CollectCrashReports()) {
+		return;
+	}
+	started = true;
+
+	const auto state = std::make_shared<State>();
+	state->dumps = cWorkingDir() + u"tdata/dumps"_q;
+	state->marker = MarkerPath();
+	state->header = Header();
+#ifdef Q_OS_WIN
+	state->mainThreadId = GetCurrentThreadId();
+#endif
+
+	const auto app = QCoreApplication::instance();
+	const auto timer = new QTimer(app);
+	timer->setInterval(kTick);
+	timer->callOnTimeout([=] {
+		if (Core::Quitting()) {
+			timer->stop();
+			Stop(state);
+			return;
+		}
+		++state->heartbeat;
+		if (!state->watching) {
+			state->watching = true;
+			std::thread([=] { Watch(state); }).detach();
+		}
+	});
+	QObject::connect(app, &QCoreApplication::aboutToQuit, timer, [=] {
+		timer->stop();
+		Stop(state);
+	});
+	timer->start();
+#endif
+}
+
+CrashReports::StartResult WithFreezeReport(
+		CrashReports::StartResult result) {
+	if (!CollectCrashReports()) {
+		return result;
+	}
+	const auto crash = std::get_if<QByteArray>(&result);
+	if (crash && !crash->isEmpty()) {
+		ForgetFreezeReport();
+		return result;
+	} else if (!crash
+		&& std::get<CrashReports::Status>(result) == CrashReports::CantOpen) {
+		return result;
+	}
+	auto file = QFile(MarkerPath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return result;
+	}
+	auto report = file.read(kMaxMarkerSize);
+	file.close();
+	if (FreezeReportSeconds(report) < 0) {
+		ForgetFreezeReport();
+		return result;
+	}
+	return CrashReports::StartResult(std::move(report));
+}
+
+int FreezeReportSeconds(const QByteArray &report) {
+	const auto prefix = QByteArray(kFreezeNote);
+	for (const auto &line : report.split('\n')) {
+		const auto trimmed = line.trimmed();
+		if (trimmed.startsWith(prefix)) {
+			return trimmed.mid(prefix.size()).split(' ').front().toInt();
+		}
+	}
+	return -1;
+}
+
+void ForgetFreezeReport() {
+	if (CollectCrashReports()) {
+		QFile::remove(MarkerPath());
+	}
+}
+
+} // namespace Tele
