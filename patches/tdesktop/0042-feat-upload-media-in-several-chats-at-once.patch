+++ b/Telegram/SourceFiles/tele/tele_uploads.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+template <typename Queue, typename Requests>
+[[nodiscard]] auto ChooseParallelUpload(
+		Queue &queue,
+		const Requests &requests) -> decltype(&queue.front()) {
+	auto result = decltype(&queue.front())(nullptr);
+	auto resultBytes = int64();
+	auto peers = std::vector<PeerId>();
+	for (auto &entry : queue) {
+		const auto peer = entry.itemId.peer;
+		if (entry.preparing
+			|| (entry.partsSent >= entry.parts->size()
+				&& entry.docPartsSent >= entry.docPartsCount)
+			|| ranges::contains(peers, peer)) {
+			continue;
+		}
+		peers.push_back(peer);
+		auto bytes = int64();
+		for (const auto &[requestId, request] : requests) {
+			if (request.itemId.peer == peer) {
+				bytes += request.bytes.size();
+			}
+		}
+		if (!result || bytes < resultBytes) {
+			result = &entry;
+			resultBytes = bytes;
+		}
+	}
+	return result;
+}
+
+template <typename Queue>
+[[nodiscard]] bool RaiseFinishedUpload(Queue &queue) {
+	if (!ParallelUploads()) {
+		return false;
+	}
+	auto peers = std::vector<PeerId>();
+	for (auto i = begin(queue); i != end(queue); ++i) {
+		const auto peer = i->itemId.peer;
+		if (ranges::contains(peers, peer)) {
+			continue;
+		}
+		peers.push_back(peer);
+		if (i->partsSent >= i->parts->size()
+			&& i->docPartsSent >= i->docPartsCount
+			&& !i->partsWaiting
+			&& !i->docPartsWaiting) {
+			std::rotate(begin(queue), i, std::next(i));
+			return true;
+		}
+	}
+	return false;
+}
+
+} // namespace Tele
