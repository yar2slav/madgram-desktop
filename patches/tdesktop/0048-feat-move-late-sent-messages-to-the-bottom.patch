index 0000000000000000000000000000000000000000..da15effac4bc92d1bc5d9ccb9d1d5715453c8f63
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_send_order.cpp
@@ -0,0 +1,93 @@
+#include "tele/tele_send_order.h"
+
+#include "data/data_groups.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+using Element = HistoryView::Element;
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> CollectMoving(
+		not_null<HistoryItem*> item) {
+	const auto group = item->history()->owner().groups().find(item);
+	if (!group) {
+		return { item };
+	}
+	auto result = std::vector<not_null<HistoryItem*>>();
+	result.reserve(group->items.size());
+	for (const auto &member : group->items) {
+		if (!IsServerMsgId(member->id) || !member->mainView()) {
+			return {};
+		}
+		result.push_back(member);
+	}
+	return result;
+}
+
+[[nodiscard]] Element *FindLastSent(
+		not_null<History*> history,
+		const std::vector<not_null<HistoryItem*>> &moving) {
+	for (auto i = history->blocks.rbegin(); i != history->blocks.rend(); ++i) {
+		const auto &messages = (*i)->messages;
+		for (auto j = messages.rbegin(); j != messages.rend(); ++j) {
+			const auto view = j->get();
+			const auto data = view->data();
+			if (IsServerMsgId(data->id) && !ranges::contains(moving, data)) {
+				return view;
+			}
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] bool Below(not_null<Element*> view, not_null<Element*> than) {
+	const auto block = view->block()->indexInHistory();
+	const auto thanBlock = than->block()->indexInHistory();
+	return (block > thanBlock)
+		|| (block == thanBlock && view->indexInBlock() > than->indexInBlock());
+}
+
+} // namespace
+
+void MoveSentToBottom(not_null<HistoryItem*> item) {
+	if (!SentToBottom() || !item->mainView()) {
+		return;
+	}
+	const auto history = item->history();
+	if (history->isBuildingFrontBlock()) {
+		return;
+	}
+	const auto moving = CollectMoving(item);
+	if (moving.empty()) {
+		return;
+	}
+	auto anchor = FindLastSent(history, moving);
+	if (!anchor) {
+		return;
+	}
+	const auto below = [&](not_null<HistoryItem*> member) {
+		return Below(member->mainView(), anchor);
+	};
+	if (ranges::all_of(moving, below)) {
+		return;
+	}
+	for (const auto member : moving) {
+		member->removeMainView(Data::ViewRemovalReason::Detached);
+		history->addNewInTheMiddle(
+			member,
+			anchor->block()->indexInHistory(),
+			anchor->indexInBlock() + 1);
+		anchor = member->mainView();
+	}
+	if (moving.size() > 1) {
+		history->owner().groups().refreshMessage(moving.back(), true);
+	}
+	history->owner().notifyHistoryChangeDelayed(history);
+}
+
+} // namespace Tele
