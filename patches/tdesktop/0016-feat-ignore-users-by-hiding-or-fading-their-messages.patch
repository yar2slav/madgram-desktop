+
+IgnoredController::IgnoredController(
+	not_null<Window::SessionController*> window)
+: _window(window) {
+}
+
+Main::Session &IgnoredController::session() const {
+	return _window->session();
+}
+
+void IgnoredController::prepare() {
+	delegate()->peerListSetTitle(rpl::single(u"Ignored users"_q));
+	::Tele::IgnoredChanges(
+	) | rpl::on_next([=] {
+		refreshRows();
+	}, lifetime());
+	refreshRows();
+}
+
+void IgnoredController::refreshRows() {
+	const auto users = ::Tele::IgnoredUsers(&session());
+	auto keep = base::flat_set<PeerListRowId>();
+	for (const auto &id : users) {
+		keep.emplace(peerFromUser(id).value);
+	}
+	for (auto i = delegate()->peerListFullRowsCount(); i != 0;) {
+		const auto row = delegate()->peerListRowAt(--i);
+		if (!keep.contains(row->id())) {
+			delegate()->peerListRemoveRow(row);
+		}
+	}
+	for (const auto &id : users) {
+		if (!delegate()->peerListFindRow(peerFromUser(id).value)) {
+			delegate()->peerListAppendRow(
+				createRow(session().data().user(id)));
+		}
+	}
+	setDescriptionText(users.empty()
+		? u"Nobody is ignored. Right-click a userpic in a group "
+			"to ignore someone."_q
+		: QString());
+	delegate()->peerListRefreshRows();
+}
+
+void IgnoredController::rowClicked(not_null<PeerListRow*> row) {
+	const auto peer = row->peer();
+	if (!peer->isMinimalLoaded()) {
+		return;
+	}
+	const auto window = _window;
+	crl::on_main(window, [=] {
+		window->showPeerInfo(peer);
+	});
+}
+
+void IgnoredController::rowRightActionClicked(not_null<PeerListRow*> row) {
+	const auto peer = row->peer();
+	crl::on_main(_window, [=] {
+		::Tele::SetIgnored(peer, false);
+	});
+}
+
+std::unique_ptr<PeerListRow> IgnoredController::createRow(
+		not_null<UserData*> user) const {
+	auto row = std::make_unique<IgnoredRow>(user);
+	row->setActionLink(u"Remove"_q);
+	const auto username = user->username();
+	row->setCustomStatus(username.isEmpty()
+		? u"ID %1"_q.arg(peerToUser(user->id).bare)
+		: u"@%1"_q.arg(username));
+	return row;
+}
+
+IgnorePeerController::IgnorePeerController(
+	not_null<Main::Session*> session)
+: ChatsListBoxController(session)
+, _session(session) {
+}
+
+Main::Session &IgnorePeerController::session() const {
+	return *_session;
+}
+
+void IgnorePeerController::prepareViewHook() {
+	delegate()->peerListSetTitle(rpl::single(u"Ignore user"_q));
+}
+
+void IgnorePeerController::rowClicked(not_null<PeerListRow*> row) {
+	::Tele::SetIgnored(row->peer(), true);
+	if (_done) {
+		_done();
+	}
+}
+
+auto IgnorePeerController::createRow(not_null<History*> history)
+-> std::unique_ptr<Row> {
+	const auto peer = history->peer;
+	if (!peer->isUser()
+		|| peer->isServiceUser()
+		|| peer->isSelf()
+		|| peer->isRepliesChat()
+		|| peer->isVerifyCodes()
+		|| ::Tele::IsIgnored(peer)) {
+		return nullptr;
+	}
+	return std::make_unique<Row>(history);
+}
