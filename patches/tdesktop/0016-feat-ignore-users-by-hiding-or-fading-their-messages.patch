+#include "tele/tele_ignored.h"
+
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/menu/menu_add_action_callback_factory.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_widgets.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kFadeOpacity = 0.35;
+constexpr auto kTestBit = BareId(1) << 63;
+
+using Key = BareId;
+using HistoryView::Context;
+using HistoryView::Element;
+
+struct State {
+	State();
+
+	base::flat_set<Key> keys;
+	std::unordered_set<not_null<Element*>> views;
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] State &Get() {
+	static State state;
+	return state;
+}
+
+[[nodiscard]] Key MakeKey(UserId id, bool test) {
+	return peerFromUser(id).value | (test ? kTestBit : Key());
+}
+
+[[nodiscard]] Key PeerKey(not_null<PeerData*> peer) {
+	return MakeKey(peerToUser(peer->id), peer->session().isTestMode());
+}
+
+[[nodiscard]] UserId KeyUser(Key key) {
+	return peerToUser(PeerId(key & ~kTestBit));
+}
+
+[[nodiscard]] base::flat_set<Key> Parse(const QString &value) {
+	auto result = base::flat_set<Key>();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto entry = part.trimmed();
+		const auto test = entry.startsWith(u"test:"_q);
+		if (test) {
+			entry = entry.mid(5);
+		}
+		auto ok = false;
+		const auto id = entry.toULongLong(&ok);
+		if (ok && id) {
+			result.emplace(MakeKey(UserId(id), test));
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Serialize(const base::flat_set<Key> &keys) {
+	auto list = QStringList();
+	list.reserve(int(keys.size()));
+	for (const auto key : keys) {
+		const auto id = QString::number(KeyUser(key).bare);
+		list.push_back((key & kTestBit) ? (u"test:"_q + id) : id);
+	}
+	return list.join(QChar(','));
+}
+
+void Refresh(const State &state, const base::flat_set<Key> &changed) {
+	if (changed.empty()) {
+		return;
+	}
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	for (const auto &view : state.views) {
+		const auto item = view->data();
+		const auto from = item->from();
+		if (from->isUser() && changed.contains(PeerKey(from))) {
+			items.emplace(item);
+		}
+	}
+	for (const auto &item : items) {
+		item->history()->owner().requestItemViewRefresh(item);
+	}
+}
+
+State::State() {
+	IgnoredListValue(
+	) | rpl::on_next([=](const QString &value) {
+		auto now = Parse(value);
+		auto changed = base::flat_set<Key>();
+		for (const auto key : keys) {
+			if (!now.contains(key)) {
+				changed.emplace(key);
+			}
+		}
+		for (const auto key : now) {
+			if (!keys.contains(key)) {
+				changed.emplace(key);
+			}
+		}
+		keys = std::move(now);
+		Refresh(*this, changed);
+		changes.fire({});
+	}, lifetime);
+
+	HideIgnoredValue(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		Refresh(*this, keys);
+	}, lifetime);
+}
+
+[[nodiscard]] bool Applies(Context context) {
+	return (context == Context::History)
+		|| (context == Context::Replies)
+		|| (context == Context::Pinned)
+		|| (context == Context::Monoforum)
+		|| (context == Context::SavedSublist)
+		|| (context == Context::ChatPreview);
+}
+
+[[nodiscard]] bool IgnoredView(not_null<const Element*> view) {
+	const auto &state = Get();
+	if (state.keys.empty() || !Applies(view->context())) {
+		return false;
+	}
+	const auto item = view->data();
+	if (item->isService() || item->isSponsored()) {
+		return false;
+	}
+	const auto from = item->from();
+	return from->isUser()
+		&& (item->history()->peer != from)
+		&& state.keys.contains(PeerKey(from));
+}
+
+[[nodiscard]] UserData *Ignorable(not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	return (user && !user->isSelf()) ? user : nullptr;
+}
+
+} // namespace
+
+bool IsIgnored(not_null<PeerData*> peer) {
+	return peer->isUser() && Get().keys.contains(PeerKey(peer));
+}
+
+void SetIgnored(not_null<PeerData*> peer, bool ignored) {
+	if (!Ignorable(peer)) {
+		return;
+	}
+	auto keys = Get().keys;
+	const auto key = PeerKey(peer);
+	const auto changed = ignored
+		? keys.emplace(key).second
+		: keys.remove(key);
+	if (changed) {
+		SetIgnoredList(Serialize(keys));
+	}
+}
+
+rpl::producer<> IgnoredChanges() {
+	return Get().changes.events();
+}
+
+std::vector<UserId> IgnoredUsers(not_null<Main::Session*> session) {
+	const auto test = session->isTestMode();
+	auto result = std::vector<UserId>();
+	for (const auto key : Get().keys) {
+		if (((key & kTestBit) != 0) == test) {
+			result.push_back(KeyUser(key));
+		}
+	}
+	return result;
+}
+
+rpl::producer<int> IgnoredCountValue(not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		IgnoredChanges()
+	) | rpl::map([=] {
+		return int(IgnoredUsers(session).size());
+	});
+}
+
+void RegisterView(not_null<HistoryView::Element*> view) {
+	Get().views.emplace(view);
+}
+
+void UnregisterView(not_null<HistoryView::Element*> view) {
+	Get().views.erase(view);
+}
+
+bool IgnoredHidden(not_null<const HistoryView::Element*> view) {
+	return HideIgnored() && IgnoredView(view);
+}
+
+IgnoredFade::IgnoredFade(
+		QPainter &p,
+		not_null<const HistoryView::Element*> view) {
+	if (!HideIgnored() && IgnoredView(view)) {
+		_painter = &p;
+		_opacity = p.opacity();
+		p.setOpacity(_opacity * kFadeOpacity);
+	}
+}
+
+IgnoredFade::~IgnoredFade() {
+	if (_painter) {
+		_painter->setOpacity(_opacity);
+	}
+}
+
+void AddIgnoreAction(
+		not_null<PeerData*> peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	const auto user = Ignorable(peer);
+	if (!user) {
+		return;
+	}
+	const auto ignored = IsIgnored(user);
+	addAction(
+		(ignored
+			? u"Stop ignoring this user"_q
+			: u"Ignore messages from this user"_q),
+		[=] { SetIgnored(user, !ignored); },
+		ignored ? &st::menuIconUnmute : &st::menuIconMute);
+}
+
+base::unique_qptr<Ui::PopupMenu> IgnoreMenu(
+		not_null<QWidget*> parent,
+		not_null<PeerData*> peer) {
+	if (!Ignorable(peer)) {
+		return nullptr;
+	}
+	auto result = base::make_unique_q<Ui::PopupMenu>(
+		parent.get(),
+		st::popupMenuWithIcons);
+	AddIgnoreAction(peer, Ui::Menu::CreateAddActionCallback(result.get()));
+	return result;
+}
+
+} // namespace Tele
