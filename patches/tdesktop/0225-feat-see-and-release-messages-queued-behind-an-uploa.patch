 		not_null<History*> history,
 		const std::vector<FullMsgId> &ids,
 		FullMsgId replyId,
@@ -287,13 +292,15 @@ void MarkFailed(not_null<Main::Session*> session, FullMsgId id) {
 		}
 	}
 	if (!first) {
-		return false;
+		return nullptr;
 	}
 	const auto topicRootId = first->topicRootId();
 	const auto sublistPeerId = first->sublistPeerId();
 	const auto reply = (replyId && SendOlderReplies())
 		? owner.message(replyId)
 		: nullptr;
+	auto media = (HistoryItem*)nullptr;
+	auto held = (HistoryItem*)nullptr;
 	for (const auto &item : history->clientSideMessages()) {
 		if (item->id >= first->id
 			|| !item->isSending()
@@ -302,12 +309,25 @@ void MarkFailed(not_null<Main::Session*> session, FullMsgId id) {
 			|| item->sublistPeerId() != sublistPeerId
 			|| (reply && Older(reply, item))) {
 			continue;
-		} else if (IsHeld(queue, item->fullId())
-			|| IsSendingMedia(queue, item)) {
-			return true;
+		} else if (IsSendingMedia(queue, item)) {
+			if (!media || item->id < media->id) {
+				media = item;
+			}
+		} else if (IsHeld(queue, item->fullId())) {
+			if (!held || item->id < held->id) {
+				held = item;
+			}
 		}
 	}
-	return false;
+	return media ? media : held;
+}
+
+[[nodiscard]] bool Blocked(
+		not_null<History*> history,
+		const std::vector<FullMsgId> &ids,
+		FullMsgId replyId,
+		const Queue *queue) {
+	return Blocker(history, ids, replyId, queue) != nullptr;
 }
 
 [[nodiscard]] bool AnyAlive(const Held &entry) {
@@ -355,6 +375,67 @@ void Check(not_null<Main::Session*> session) {
 	}
 }
 
+[[nodiscard]] Queue *FindQueue(not_null<Main::Session*> session) {
+	auto &sessions = Queues().sessions;
+	const auto i = sessions.find(session);
+	return (i != end(sessions)) ? &i->second : nullptr;
+}
+
+[[nodiscard]] const Held *FindHeld(
+		const Queue *queue,
+		not_null<HistoryItem*> item) {
+	if (!queue) {
+		return nullptr;
+	}
+	const auto id = item->fullId();
+	for (const auto &entry : queue->held) {
+		if (ranges::contains(entry.ids, id)) {
+			return &entry;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] QString MediaName(not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	const auto document = media ? media->document() : nullptr;
+	if (!document) {
+		return Lower(u"a photo"_q);
+	} else if (const auto name = document->filename(); !name.isEmpty()) {
+		return name;
+	} else if (document->isVoiceMessage()) {
+		return Lower(u"a voice message"_q);
+	} else if (document->isVideoMessage()) {
+		return Lower(u"a video message"_q);
+	} else if (document->isVideoFile() || document->isAnimation()) {
+		return Lower(u"a video"_q);
+	}
+	return Lower(u"a file"_q);
+}
+
+void SendHeldNow(not_null<Main::Session*> session, FullMsgId id) {
+	auto &state = Queues();
+	const auto i = state.sessions.find(session);
+	if (i == end(state.sessions)) {
+		return;
+	}
+	auto &held = i->second.held;
+	const auto j = ranges::find_if(held, [&](const Held &entry) {
+		return ranges::contains(entry.ids, id);
+	});
+	if (j == end(held)) {
+		return;
+	}
+	auto taken = std::move(*j);
+	held.erase(j);
+	state.releasing = true;
+	if (AnyAlive(taken)) {
+		taken.send();
+	}
+	state.releasing = false;
+	Schedule(session);
+}
+
 } // namespace
 
 void MoveSentToBottom(not_null<HistoryItem*> item) {
@@ -477,4 +558,63 @@ bool SendHeldOnDoubleEnter(History *history, bool empty) {
 	return true;
 }
 
+bool IsHeldBehindMedia(not_null<HistoryItem*> item) {
+	return FindHeld(FindQueue(&item->history()->session()), item) != nullptr;
+}
+
+QString HeldBehindMediaText(not_null<HistoryItem*> item) {
+	const auto queue = FindQueue(&item->history()->session());
+	const auto entry = FindHeld(queue, item);
+	if (!entry) {
+		return QString();
+	}
+	const auto blocker = Blocker(
+		entry->history,
+		entry->ids,
+		entry->reply,
+		queue);
+	const auto name = !blocker
+		? Lower(u"earlier messages"_q)
+		: IsSendingMedia(queue, blocker)
+		? MediaName(blocker)
+		: Lower(u"an earlier message"_q);
+	return Lower(u"Queued, waiting for %1"_q).arg(name);
+}
+
+void AddSendHeldNowAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
+	if (!item || !IsHeldBehindMedia(item)) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	const auto id = item->fullId();
+	menu->addAction(tr::lng_context_send_now_msg(tr::now), [=] {
+		SendHeldNow(session, id);
+	}, &st::menuIconSend);
+}
+
+rpl::producer<QString> WithHeldLossWarning(
+		not_null<Main::Session*> session,
+		rpl::producer<QString> text) {
+	auto count = 0;
+	if (const auto queue = FindQueue(session)) {
+		const auto &owner = session->data();
+		for (const auto &entry : queue->held) {
+			for (const auto &id : entry.ids) {
+				if (owner.message(id)) {
+					++count;
+				}
+			}
+		}
+	}
+	if (!count) {
+		return text;
+	}
+	const auto warning = (count == 1)
+		? Lower(u"1 queued message will be lost."_q)
+		: Lower(u"%1 queued messages will be lost."_q).arg(count);
+	return std::move(text) | rpl::map([=](const QString &text) {
+		return text + u"\n\n"_q + warning;
+	});
+}
+
 } // namespace Tele
