diff --git a/Telegram/SourceFiles/tele/tele_snippets.cpp b/Telegram/SourceFiles/tele/tele_snippets.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c157ddb747a4b8da464e7f49430fa57afa9e3258
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_snippets.cpp
@@ -0,0 +1,221 @@
+#include "tele/tele_snippets.h"
+
+#include "lang/lang_keys.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/slide_wrap.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+
+#include <QtCore/QTimer>
+#include <QtGui/QTextDocument>
+#include <QtWidgets/QTextEdit>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxShortcut = 32;
+
+struct Snippet {
+	QString shortcut;
+	QString text;
+};
+
+[[nodiscard]] QStringList Lines(const QString &value) {
+	auto result = QStringList();
+	for (const auto &line : value.split('\n')) {
+		const auto trimmed = line.trimmed();
+		if (!trimmed.isEmpty()) {
+			result.push_back(trimmed);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<Snippet> Parse(const QString &line) {
+	const auto separator = line.indexOf('=');
+	if (separator <= 0) {
+		return std::nullopt;
+	}
+	const auto shortcut = line.left(separator).trimmed();
+	auto text = line.mid(separator + 1).trimmed();
+	if (shortcut.isEmpty()
+		|| shortcut.size() > kMaxShortcut
+		|| text.isEmpty()) {
+		return std::nullopt;
+	}
+	for (const auto ch : shortcut) {
+		if (ch.isSpace()) {
+			return std::nullopt;
+		}
+	}
+	text.replace(u"\\n"_q, u"\n"_q);
+	return Snippet{ shortcut, text };
+}
+
+[[nodiscard]] int FirstErrorLine(const QString &value) {
+	auto index = 0;
+	for (const auto &line : value.split('\n')) {
+		++index;
+		const auto trimmed = line.trimmed();
+		if (!trimmed.isEmpty() && !Parse(trimmed)) {
+			return index;
+		}
+	}
+	return 0;
+}
+
+[[nodiscard]] const std::vector<Snippet> &Parsed() {
+	static auto source = QString();
+	static auto parsed = std::vector<Snippet>();
+	const auto current = SnippetsText();
+	if (current != source) {
+		source = current;
+		parsed.clear();
+		for (const auto &line : Lines(current)) {
+			if (const auto snippet = Parse(line)) {
+				parsed.push_back(*snippet);
+			}
+		}
+	}
+	return parsed;
+}
+
+[[nodiscard]] QString Lookup(const QString &shortcut) {
+	for (const auto &snippet : Parsed()) {
+		if (snippet.shortcut == shortcut) {
+			return snippet.text;
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] bool Boundary(QChar ch) {
+	return ch.isSpace() || (ch == QChar::ObjectReplacementCharacter);
+}
+
+void Expand(not_null<Ui::InputField*> field, int space) {
+	const auto document = field->rawTextEdit()->document();
+	if (document->characterAt(space) != QChar(' ')) {
+		return;
+	}
+	auto start = space;
+	while (start > 0 && !Boundary(document->characterAt(start - 1))) {
+		if (space - start >= kMaxShortcut) {
+			return;
+		}
+		--start;
+	}
+	if (start == space) {
+		return;
+	}
+	auto shortcut = QString();
+	shortcut.reserve(space - start);
+	for (auto i = start; i != space; ++i) {
+		shortcut.append(document->characterAt(i));
+	}
+	const auto text = Lookup(shortcut);
+	if (!text.isEmpty()) {
+		field->commitInstantReplacement(start, space, text, QString());
+	}
+}
+
+}
+
+void SetupSnippets(not_null<Ui::InputField*> field) {
+	if (field->property("teleSnippets").toBool()) {
+		return;
+	}
+	field->setProperty("teleSnippets", true);
+	const auto document = field->rawTextEdit()->document();
+	QObject::connect(
+		document,
+		&QTextDocument::contentsChange,
+		field.get(),
+		[=](int position, int removed, int added) {
+			if (removed
+				|| added != 1
+				|| SnippetsText().isEmpty()
+				|| document->characterAt(position) != QChar(' ')) {
+				return;
+			}
+			QTimer::singleShot(0, field.get(), [=] {
+				Expand(field, position);
+			});
+		});
+}
+
+QString NormalizeSnippets(const QString &value) {
+	return Lines(value).join('\n');
+}
+
+rpl::producer<int> SnippetsCountValue() {
+	return SnippetsTextValue() | rpl::map([](const QString &value) {
+		return int(Lines(value).size());
+	});
+}
+
+void SnippetsBox(not_null<Ui::GenericBox*> box) {
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Tr(u"Snippets"_q)));
+
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::newGroupDescription,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(Tr(u"Shortcut = text"_q)),
+		SnippetsText()));
+	const auto error = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			box,
+			object_ptr<Ui::FlatLabel>(
+				box,
+				QString(),
+				st::boxAttentionDividerLabel)));
+	Ui::AddSkip(box->verticalLayout());
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Tr(u"One per line, like ;addr = Red Square 1. Type the shortcut and a space to get the text, write %1 for a new line."_q).arg(u"\\n"_q),
+		st::boxDividerLabel));
+
+	const auto refresh = [=] {
+		const auto line = FirstErrorLine(field->getLastText());
+		error->entity()->setText(line
+			? Tr(u"Line %1 needs to look like shortcut = text."_q).arg(line)
+			: QString());
+		error->toggle(line != 0, anim::type::instant);
+		if (line) {
+			field->showErrorNoFocus();
+		} else {
+			field->hideError();
+		}
+	};
+	field->changes() | rpl::on_next(refresh, field->lifetime());
+	refresh();
+
+	const auto save = [=] {
+		const auto value = field->getLastText();
+		if (FirstErrorLine(value)) {
+			field->showError();
+			return;
+		}
+		const auto normalized = NormalizeSnippets(value);
+		if (normalized != NormalizeSnippets(SnippetsText())) {
+			SetSnippetsText(normalized);
+		}
+		box->closeBox();
+	};
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+}
