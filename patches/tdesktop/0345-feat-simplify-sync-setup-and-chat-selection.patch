-	const auto rescan = box->addRow(object_ptr<Ui::LinkButton>(box, Tr(u"Download history again"_q)));
+	box->addButton(rpl::single(Tr(u"Connect"_q)), [=] { connectCode(field->getLastText()); });
 	rescan->setClickedCallback([=] { if (sync) sync->rescan(); });
 	box->addButton(rpl::single(Tr(u"Close"_q)), [=] { box->closeBox(); });
+	refresh();
