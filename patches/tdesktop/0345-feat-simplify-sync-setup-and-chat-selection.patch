+	};
+	const auto connectCode = [=](const QString &text) {
+		if (!sync) return;
+		if (!sync->configure(text)) {
+			field->showError();
+			sync->status = Tr(u"Couldn't connect. Choose connection.json or a transfer file for this Telegram account."_q);
