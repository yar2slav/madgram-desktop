+void AddChatsSelectionAction(
+		not_null<Ui::RpWidget*> list,
+		not_null<Ui::PopupMenu*> menu,
+		History *history) {
+	const auto state = Find(list);
+	if (!state || !history || !SelectChats()) {
+		return;
+	}
+	const auto selected = ranges::contains(state->chats, not_null(history));
+	TagMenuAction(menu->addAction(selected
+		? Tr(u"Deselect chat"_q) : Tr(u"Select chat"_q), crl::guard(list, [=] {
+		if (const auto current = Find(list); current && SelectChats()) {
+			Toggle(current, history);
+			current->anchor = history;
+			Changed(current);
+		}
+	}), &st::menuIconSelect), u"select_chat"_q, &st::menuIconSelect);
+}
+
