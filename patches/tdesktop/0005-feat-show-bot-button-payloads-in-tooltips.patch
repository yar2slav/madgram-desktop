diff --git a/Telegram/SourceFiles/tele/tele_button_payload.cpp b/Telegram/SourceFiles/tele/tele_button_payload.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3e331eedc1b954094a5a5d3bf596b2855bfb3978
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_button_payload.cpp
@@ -0,0 +1,267 @@
+#include "tele/tele_button_payload.h"
+
+#include "data/data_game.h"
+#include "data/data_media_types.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history_item.h"
+#include "history/history_item_reply_markup.h"
+#include "inline_bots/bot_attach_web_view.h"
+#include "tele/tele_options.h"
+
+#include <QtCore/QDataStream>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxValueLength = 512;
+
+using Button = HistoryMessageMarkupButton;
+using Type = Button::Type;
+
+[[nodiscard]] QString Limited(QString value) {
+	if (value.size() > kMaxValueLength) {
+		value = value.mid(0, kMaxValueLength) + QChar(0x2026);
+	}
+	return value;
+}
+
+[[nodiscard]] QString Quoted(const QString &value) {
+	auto escaped = value;
+	escaped.replace('\\', u"\\\\"_q)
+		.replace('\n', u"\\n"_q)
+		.replace('\r', u"\\r"_q)
+		.replace('\t', u"\\t"_q);
+	return '"' + Limited(escaped) + '"';
+}
+
+[[nodiscard]] bool IsPrintable(const QString &value) {
+	for (const auto ch : value) {
+		const auto code = ch.unicode();
+		if ((code < 0x20 && code != '\n' && code != '\r' && code != '\t')
+			|| code == 0x7F
+			|| code == 0xFFFD) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QString Bytes(const QByteArray &data) {
+	if (data.isEmpty()) {
+		return u"(empty)"_q;
+	}
+	const auto text = QString::fromUtf8(data);
+	if (text.toUtf8() == data && IsPrintable(text)) {
+		return Quoted(text);
+	}
+	return u"hex, %1 bytes: %2"_q.arg(data.size()).arg(
+		Limited(QString::fromLatin1(data.toHex(' '))));
+}
+
+[[nodiscard]] QString Utf8(const QByteArray &data) {
+	return Limited(QString::fromUtf8(data));
+}
+
+[[nodiscard]] QString PeerTypesText(InlineBots::PeerTypes types) {
+	using PeerType = InlineBots::PeerType;
+	auto names = QStringList();
+	const auto add = [&](PeerType type, const QString &name) {
+		if (types & type) {
+			names.push_back(name);
+		}
+	};
+	add(PeerType::SameBot, u"this bot"_q);
+	add(PeerType::Bot, u"bots"_q);
+	add(PeerType::User, u"users"_q);
+	add(PeerType::Group, u"groups"_q);
+	add(PeerType::Broadcast, u"channels"_q);
+	return names.join(u", "_q);
+}
+
+[[nodiscard]] QString RestrictionText(RequestPeerQuery::Restriction value) {
+	using Restriction = RequestPeerQuery::Restriction;
+	switch (value) {
+	case Restriction::Yes: return u"yes"_q;
+	case Restriction::No: return u"no"_q;
+	case Restriction::Any: break;
+	}
+	return QString();
+}
+
+void AppendRequestPeer(QStringList &lines, const Button &button) {
+	if (button.data.size() != sizeof(RequestPeerQuery)) {
+		lines.push_back(u"requests a chat"_q);
+		return;
+	}
+	auto query = RequestPeerQuery();
+	memcpy(&query, button.data.constData(), sizeof(query));
+	using PeerType = RequestPeerQuery::Type;
+	const auto type = (query.type == PeerType::User)
+		? u"user"_q
+		: (query.type == PeerType::Group)
+		? u"group"_q
+		: u"channel"_q;
+	lines.push_back(u"requests: %1, up to %2"_q.arg(type).arg(
+		std::max(query.maxQuantity, 1)));
+	const auto restriction = [&](
+			const QString &name,
+			RequestPeerQuery::Restriction value) {
+		if (const auto text = RestrictionText(value); !text.isEmpty()) {
+			lines.push_back(name + u": "_q + text);
+		}
+	};
+	restriction(u"bot"_q, query.userIsBot);
+	restriction(u"premium"_q, query.userIsPremium);
+	restriction(u"forum"_q, query.groupIsForum);
+	restriction(u"has username"_q, query.hasUsername);
+	if (query.amCreator) {
+		lines.push_back(u"you must be the owner"_q);
+	}
+	if (query.isBotParticipant) {
+		lines.push_back(u"the bot must be a member"_q);
+	}
+}
+
+void AppendCreateBot(QStringList &lines, const Button &button) {
+	auto name = QString();
+	auto username = QString();
+	auto stream = QDataStream(button.data);
+	stream >> name >> username;
+	lines.push_back(u"creates a bot"_q);
+	if (!name.isEmpty()) {
+		lines.push_back(u"suggested name: "_q + Quoted(name));
+	}
+	if (!username.isEmpty()) {
+		lines.push_back(u"suggested username: @"_q + Limited(username));
+	}
+}
+
+void AppendUser(
+		QStringList &lines,
+		not_null<Data::Session*> owner,
+		const QByteArray &data) {
+	const auto id = data.toULongLong();
+	lines.push_back(u"user id: "_q + QString::number(id));
+	if (const auto user = owner->userLoaded(UserId(id))) {
+		lines.push_back(u"user: "_q + Limited(user->name()));
+	}
+}
+
+void AppendGame(
+		QStringList &lines,
+		not_null<Data::Session*> owner,
+		FullMsgId itemId) {
+	const auto item = owner->message(itemId);
+	const auto media = item ? item->media() : nullptr;
+	const auto game = media ? media->game() : nullptr;
+	lines.push_back(game
+		? (u"game: "_q + Limited(game->shortName))
+		: u"game"_q);
+}
+
+} // namespace
+
+QString MarkupButtonTooltip(
+		not_null<Data::Session*> owner,
+		FullMsgId itemId,
+		const HistoryMessageMarkupButton *button,
+		bool fullDisplayed) {
+	if (!button || !ButtonPayloads()) {
+		return QString();
+	}
+	auto lines = QStringList();
+	switch (button->type) {
+	case Type::Default:
+		lines.push_back(u"sends: "_q + Quoted(button->text));
+		break;
+	case Type::Url:
+		lines.push_back(u"url: "_q + Utf8(button->data));
+		break;
+	case Type::Auth:
+		lines.push_back(u"login url: "_q + Utf8(button->data));
+		if (button->buttonId) {
+			lines.push_back(u"button id: "_q
+				+ QString::number(button->buttonId));
+		}
+		if (!button->forwardText.isEmpty()) {
+			lines.push_back(u"forward text: "_q
+				+ Quoted(button->forwardText));
+		}
+		break;
+	case Type::Callback:
+		lines.push_back(u"callback: "_q + Bytes(button->data));
+		break;
+	case Type::CallbackWithPassword:
+		lines.push_back(u"callback: "_q + Bytes(button->data));
+		lines.push_back(u"asks for your password"_q);
+		break;
+	case Type::RequestPhone:
+		lines.push_back(u"requests your phone number"_q);
+		break;
+	case Type::RequestLocation:
+		lines.push_back(u"requests your location"_q);
+		break;
+	case Type::RequestPoll:
+		lines.push_back(button->data.isEmpty()
+			? u"requests a poll"_q
+			: button->data[0]
+			? u"requests a quiz"_q
+			: u"requests a regular poll"_q);
+		break;
+	case Type::RequestPeer:
+		AppendRequestPeer(lines, *button);
+		if (button->buttonId) {
+			lines.push_back(u"button id: "_q
+				+ QString::number(button->buttonId));
+		}
+		break;
+	case Type::SwitchInline:
+	case Type::SwitchInlineSame:
+		lines.push_back((button->type == Type::SwitchInlineSame
+			? u"inline query here: "_q
+			: u"inline query: "_q) + Quoted(QString::fromUtf8(button->data)));
+		if (button->peerTypes) {
+			lines.push_back(u"chats: "_q + PeerTypesText(button->peerTypes));
+		}
+		break;
+	case Type::Game:
+		AppendGame(lines, owner, itemId);
+		break;
+	case Type::Buy:
+		lines.push_back(u"payment"_q);
+		break;
+	case Type::UserProfile:
+		AppendUser(lines, owner, button->data);
+		break;
+	case Type::WebView:
+	case Type::SimpleWebView:
+		lines.push_back(u"web app: "_q + Utf8(button->data));
+		break;
+	case Type::CopyText:
+		lines.push_back(u"copies: "_q + Quoted(QString::fromUtf8(button->data)));
+		break;
+	case Type::Disabled:
+		lines.push_back(u"disabled"_q);
+		break;
+	case Type::CreateBot:
+		AppendCreateBot(lines, *button);
+		if (button->buttonId) {
+			lines.push_back(u"button id: "_q
+				+ QString::number(button->buttonId));
+		}
+		break;
+	case Type::SuggestDecline:
+	case Type::SuggestAccept:
+	case Type::SuggestChange:
+	case Type::kCount:
+		return QString();
+	}
+	if (!fullDisplayed) {
+		lines.push_front(QString());
+		lines.push_front(button->text);
+	}
+	return lines.join('\n');
+}
+
+} // namespace Tele
