Subject: [PATCH] fix: let telegram keep the first line's indent in code blocks

---
 .../iv/markdown/iv_markdown_article_layout_blocks.cpp      | 7 +------
 .../iv/markdown/iv_markdown_article_selection.cpp          | 3 ---
 2 files changed, 1 insertion(+), 9 deletions(-)

diff --git a/Telegram/SourceFiles/iv/markdown/iv_markdown_article_layout_blocks.cpp b/Telegram/SourceFiles/iv/markdown/iv_markdown_article_layout_blocks.cpp
index 036ea11e29f2c7855b8cc6f6065d205304b885af..4d239a7dd99a8e6db12bb5053ffc5e9b217742b8 100644
--- a/Telegram/SourceFiles/iv/markdown/iv_markdown_article_layout_blocks.cpp
+++ b/Telegram/SourceFiles/iv/markdown/iv_markdown_article_layout_blocks.cpp
@@ -1263,9 +1263,6 @@ bool LayoutMediaCaptionGeometry(
 QString CodeBlockDisplayText(const QString &text) {
 	auto result = QString();
 	result.reserve(text.size());
-	if (!text.isEmpty() && Ui::Text::IsTrimmed(text.front())) {
-		result.append(QChar(kCodeTrailingGuard));
-	}
 	EnumerateCodeBlockDisplayChars(text, [&](QChar ch, int width) {
 		if (ch != QChar::Tabulation) {
 			result.append(ch);
@@ -1284,9 +1281,7 @@ QString CodeBlockDisplayText(const QString &text) {
 std::vector<int> CodeBlockDisplayOffsets(const QString &text) {
 	auto result = std::vector<int>();
 	result.reserve(text.size() + 1);
-	auto position = (!text.isEmpty() && Ui::Text::IsTrimmed(text.front()))
-		? 1
-		: 0;
+	auto position = 0;
 	EnumerateCodeBlockDisplayChars(text, [&](QChar, int width) {
 		result.push_back(position);
 		position += width;
