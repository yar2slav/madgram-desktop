+#pragma once
+
+#include "tele/tele_gift_studio_data.h"
+
+namespace Lottie {
+class Instance;
+} // namespace Lottie
+
+namespace Tele::GiftStudio {
+
+enum class LayoutKind {
+	Cover,
+	Tile,
+	Sticker,
+	Card,
+};
+
+enum class BackgroundKind {
+	Backdrop,
+	Custom,
+	Transparent,
+};
+
+struct Background {
+	BackgroundKind kind = BackgroundKind::Backdrop;
+	QColor first = QColor(0x8E, 0x6C, 0xF0);
+	QColor second = QColor(0x3C, 0x2A, 0x8C);
+	bool linear = false;
+	int angle = 90;
+};
+
+struct TextOptions {
+	bool title = true;
+	bool number = true;
+	bool subtitle = true;
+	bool rarity = true;
+	bool tgs = true;
+	QString customSubtitle;
+	float64 scale = 1.;
+};
+
+struct Texts {
+	QString title;
+	QString number;
+	QString subtitle;
+	QString model;
+	QString backdrop;
+	QString symbol;
+	QString rarity;
+};
+
+struct Options {
+	LayoutKind layout = LayoutKind::Cover;
+	QSize canvas;
+	float64 modelScale = 1.;
+	float64 zoom = 1.;
+	bool rounded = false;
+	Background background;
+	float64 patternOpacity = 1.;
+	float64 patternDensity = 1.;
+	TextOptions text;
+};
+
+struct Motion {
+	float64 speed = 1.;
+	int from = 0;
+	int till = -1;
+	bool pingPong = false;
+};
+
+struct LayoutPoint {
+	QPointF center;
+	float64 side = 0.;
+	float64 opacity = 1.;
+};
+
+struct Layout {
+	LayoutKind kind = LayoutKind::Cover;
+	QSizeF size;
+	QSizeF design;
+	float64 unit = 1.;
+	float64 scene = 1.;
+	QPointF origin;
+	QRectF content;
+	QRectF model;
+	QPointF gradientCenter;
+	float64 gradientRadius = 0.;
+	QPointF gradientFrom;
+	QPointF gradientTill;
+	float64 radius = 0.;
+	float64 textWidth = 0.;
+	std::vector<LayoutPoint> points;
+};
+
+struct VectorShape {
+	QPainterPath path;
+	QColor color;
+};
+
+struct Animation {
+	QImage base;
+	QImage overlay;
+	QRect model;
+	QByteArray json;
+	std::vector<int> timeline;
+	float64 fps = 0.;
+};
+
+[[nodiscard]] Layout ComputeLayout(
+	QSizeF size,
+	const Options &options,
+	const Texts &texts = Texts());
+[[nodiscard]] QSize DefaultCanvas(
+	LayoutKind kind,
+	int scale,
+	const Texts &texts = Texts(),
+	const Options &options = Options());
+[[nodiscard]] QString RarityOdds(int modelPermille, int backdropPermille);
+[[nodiscard]] QString RarityChance(int modelPermille, int backdropPermille);
+[[nodiscard]] QColor BackgroundEdge(
+	const Options &options,
+	const Colors &colors);
+void CutCorners(QImage &image, float64 radius);
+void CutRect(QImage &image, QRectF rect, float64 radius);
+[[nodiscard]] std::vector<int> MakeTimeline(
+	int frames,
+	float64 fps,
+	const Motion &motion,
+	float64 outputFps);
+
+class Renderer final {
+public:
+	Renderer();
+	~Renderer();
+
+	void setModel(const QByteArray &json);
+	void setSymbol(const QByteArray &json);
+	void setColors(const Colors &colors);
+	void setTexts(const Texts &texts);
+	void setOptions(const Options &options);
+	void setMotion(const Motion &motion);
+	void clear();
+
+	[[nodiscard]] bool hasModel() const;
+	[[nodiscard]] bool hasSymbol() const;
+	[[nodiscard]] bool hasColors() const;
+	[[nodiscard]] int modelFrames() const;
+	[[nodiscard]] float64 frameRate() const;
+	[[nodiscard]] int framesCount() const;
+	[[nodiscard]] const std::vector<int> &timeline() const;
+	[[nodiscard]] const QByteArray &modelJson() const;
+	[[nodiscard]] const QByteArray &symbolJson() const;
+	[[nodiscard]] const Colors &colors() const;
+	[[nodiscard]] const Texts &texts() const;
+	[[nodiscard]] const Options &options() const;
+	[[nodiscard]] const Motion &motion() const;
+
+	void paint(QPainter &p, QSize size, int frame);
+	[[nodiscard]] QImage render(int frame);
+	[[nodiscard]] QImage renderAt(QSize size, int frame);
+	[[nodiscard]] std::vector<VectorShape> overlayShapes(QSize size);
+	[[nodiscard]] Animation prepareAnimation(
+		QSize size,
+		bool rounded,
+		float64 fps);
+
+private:
+	struct Layers {
+		QImage base;
+		QImage overlay;
+		QRect model;
+		QRectF clip;
+		float64 radius = 0.;
+	};
+
+	[[nodiscard]] Layers renderLayers(QSize size, int ratio, bool rounded);
+	void paintBackground(QPainter &p, const Layout &layout);
+	void paintPattern(QPainter &p, const Layout &layout, int ratio);
+	void paintTexts(QPainter &p, const Layout &layout);
+	void paintCoverTexts(QPainter &p, const Layout &layout);
+	void paintCardTexts(QPainter &p, const Layout &layout);
+	void paintTileBadge(QPainter &p, const Layout &layout);
+	[[nodiscard]] const QImage &modelFrame(int frame, QSize size);
+	[[nodiscard]] int modelIndex(int frame) const;
+	void refreshTimeline();
+
+	std::unique_ptr<Lottie::Instance> _model;
+	std::unique_ptr<Lottie::Instance> _symbol;
+	QByteArray _modelJson;
+	QByteArray _symbolJson;
+	Colors _colors;
+	Texts _texts;
+	Options _options;
+	Motion _motion;
+	std::vector<int> _timeline;
+	bool _hasColors = false;
+	Layers _preview;
+	QSize _previewSize;
+	QImage _frame;
+	int _frameIndex = -1;
+
+};
+
+} // namespace Tele::GiftStudio
