+QString RarityOdds(int modelPermille, int backdropPermille) {
+	if (modelPermille <= 0 || backdropPermille <= 0) {
+		return QString();
+	}
+	const auto odds = int64(base::SafeRound(
+		1000000. / (int64(modelPermille) * backdropPermille)));
+	return Lower(u"1 in %1"_q).arg(Lang::FormatCountDecimal(odds));
+}
+
+QString RarityChance(int modelPermille, int backdropPermille) {
+	if (modelPermille <= 0 || backdropPermille <= 0) {
+		return QString();
+	}
+	const auto percent = modelPermille * backdropPermille / 10000.;
+	const auto decimals = (percent >= 1.)
+		? 2
+		: std::clamp(int(std::ceil(-std::log10(percent))) + 1, 2, 12);
+	auto result = QString::number(percent, 'f', decimals);
+	while (result.endsWith('0')) {
+		result.chop(1);
+	}
+	if (result.endsWith('.')) {
+		result.chop(1);
+	}
+	return result + '%';
+}
