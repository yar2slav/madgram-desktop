diff --git a/Telegram/SourceFiles/tele/tele_gift_studio_owned.cpp b/Telegram/SourceFiles/tele/tele_gift_studio_owned.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..48eb00a1bba5d7519e3120f7c220352db702a710
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_studio_owned.cpp
@@ -0,0 +1,345 @@
+#include "tele/tele_gift_studio_owned.h"
+
+#include "base/weak_ptr.h"
+#include "data/data_session.h"
+#include "data/data_star_gift.h"
+#include "data/data_user.h"
+#include "info/info_memento.h"
+#include "info/peer_gifts/info_peer_gifts_widget.h"
+#include "main/main_session.h"
+#include "mtproto/sender.h"
+#include "tele/tele_gift_search.h"
+#include "window/window_session_controller.h"
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kRefreshTimeout = 5 * 60 * crl::time(1000);
+
+struct Name {
+	QString raw;
+	QString normal;
+	QString loose;
+};
+
+struct Entry {
+	Data::SavedStarGiftId id;
+	QString slug;
+	Name collection;
+	Name model;
+	Name backdrop;
+	Name symbol;
+};
+
+struct Query {
+	Name collection;
+	Name model;
+	Name backdrop;
+	Name symbol;
+};
+
+[[nodiscard]] QString Normal(QString value) {
+	for (auto &ch : value) {
+		switch (ch.unicode()) {
+		case 0x2018:
+		case 0x2019:
+		case 0x201B:
+		case 0x2032:
+		case 0x02BC:
+		case 0x00B4:
+		case 0x0060: ch = QChar('\''); break;
+		default: break;
+		}
+	}
+	return value.normalized(
+		QString::NormalizationForm_KC).toLower().simplified();
+}
+
+[[nodiscard]] QString Loose(const QString &normal) {
+	auto result = QString();
+	result.reserve(normal.size());
+	for (const auto &ch : normal) {
+		if (ch.isLetterOrNumber()) {
+			result.append(ch);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] Name MakeName(const QString &raw) {
+	auto normal = Normal(raw);
+	auto loose = Loose(normal);
+	return {
+		.raw = raw,
+		.normal = std::move(normal),
+		.loose = std::move(loose),
+	};
+}
+
+[[nodiscard]] bool Same(const Name &a, const Name &b) {
+	if (a.normal.isEmpty() || b.normal.isEmpty()) {
+		return false;
+	}
+	return (a.normal == b.normal)
+		|| (!a.loose.isEmpty() && (a.loose == b.loose));
+}
+
+[[nodiscard]] Entry MakeEntry(const Data::SavedStarGift &gift) {
+	const auto &unique = *gift.info.unique;
+	return {
+		.id = gift.manageId,
+		.slug = unique.slug,
+		.collection = MakeName(unique.title),
+		.model = MakeName(unique.model.name),
+		.backdrop = MakeName(unique.backdrop.name),
+		.symbol = MakeName(unique.pattern.name),
+	};
+}
+
+[[nodiscard]] Query MakeQuery(const OwnedQuery &query) {
+	return {
+		.collection = MakeName(query.collection),
+		.model = MakeName(query.model),
+		.backdrop = MakeName(query.backdrop),
+		.symbol = MakeName(query.symbol),
+	};
+}
+
+class Loader final : public base::has_weak_ptr {
+public:
+	explicit Loader(not_null<Main::Session*> session);
+
+	[[nodiscard]] rpl::producer<> watch();
+	void refresh(bool force);
+	[[nodiscard]] OwnedCounts count(const Query &query) const;
+	[[nodiscard]] GiftListPrefill prefill(const Query &query) const;
+
+private:
+	void load();
+	void loaded(SavedUniqueGiftsSlice &&slice);
+	void failed();
+	void applyUpdate(const Data::GiftUpdate &update);
+	[[nodiscard]] QString resolve(
+		const Query &query,
+		Name Entry::*field,
+		const Name &wanted) const;
+
+	const not_null<Main::Session*> _session;
+	MTP::Sender _api;
+	std::vector<Entry> _entries;
+	std::vector<Entry> _pending;
+	base::flat_set<Data::SavedStarGiftId> _ids;
+	QString _offset;
+	mtpRequestId _requestId = 0;
+	crl::time _loadedAt = 0;
+	int _watchers = 0;
+	bool _ready = false;
+	bool _stale = false;
+	rpl::event_stream<> _changes;
+	rpl::lifetime _lifetime;
+
+};
+
+Loader::Loader(not_null<Main::Session*> session)
+: _session(session)
+, _api(&session->mtp()) {
+	session->data().giftUpdates(
+	) | rpl::on_next([=](const Data::GiftUpdate &update) {
+		applyUpdate(update);
+	}, _lifetime);
+}
+
+rpl::producer<> Loader::watch() {
+	return [=](auto consumer) {
+		auto result = rpl::lifetime();
+		++_watchers;
+		result.add([weak = base::make_weak(this)] {
+			if (const auto strong = weak.get()) {
+				--strong->_watchers;
+			}
+		});
+		_changes.events_starting_with(
+			rpl::empty_value()
+		) | rpl::on_next([=] {
+			consumer.put_next({});
+		}, result);
+		refresh(false);
+		return result;
+	};
+}
+
+void Loader::refresh(bool force) {
+	if (_requestId) {
+		return;
+	}
+	const auto fresh = _ready
+		&& !_stale
+		&& (crl::now() - _loadedAt < kRefreshTimeout);
+	if (fresh && !force) {
+		return;
+	}
+	_pending.clear();
+	_ids.clear();
+	_offset = QString();
+	load();
+}
+
+void Loader::load() {
+	_requestId = RequestSavedUniqueGifts(
+		_api,
+		_session->user(),
+		_offset,
+		[=](SavedUniqueGiftsSlice slice) {
+			_requestId = 0;
+			loaded(std::move(slice));
+		},
+		[=] {
+			_requestId = 0;
+			failed();
+		});
+}
+
+void Loader::loaded(SavedUniqueGiftsSlice &&slice) {
+	for (const auto &gift : slice.gifts) {
+		if (gift.manageId && !_ids.emplace(gift.manageId).second) {
+			continue;
+		}
+		_pending.push_back(MakeEntry(gift));
+	}
+	if (!slice.last) {
+		_offset = slice.next;
+		load();
+		return;
+	}
+	_entries = base::take(_pending);
+	_ids.clear();
+	_offset = QString();
+	_loadedAt = crl::now();
+	_ready = true;
+	_stale = false;
+	_changes.fire({});
+}
+
+void Loader::failed() {
+	_pending.clear();
+	_ids.clear();
+	_offset = QString();
+	_stale = true;
+}
+
+void Loader::applyUpdate(const Data::GiftUpdate &update) {
+	using Action = Data::GiftUpdate::Action;
+	if (update.action == Action::Upgraded) {
+		_stale = true;
+		if (_watchers > 0) {
+			refresh(false);
+		}
+		return;
+	} else if (update.action != Action::Convert
+		&& update.action != Action::Transfer
+		&& update.action != Action::Delete) {
+		return;
+	}
+	const auto matches = [&](const Entry &entry) {
+		return update.id
+			? (entry.id == update.id)
+			: (!update.slug.isEmpty() && entry.slug == update.slug);
+	};
+	_pending.erase(ranges::remove_if(_pending, matches), end(_pending));
+	const auto was = _entries.size();
+	_entries.erase(ranges::remove_if(_entries, matches), end(_entries));
+	if (_entries.size() != was) {
+		_changes.fire({});
+	}
+}
+
+OwnedCounts Loader::count(const Query &query) const {
+	auto result = OwnedCounts{ .ready = _ready };
+	for (const auto &entry : _entries) {
+		if (!Same(entry.collection, query.collection)) {
+			continue;
+		}
+		++result.collection;
+		const auto model = Same(entry.model, query.model);
+		const auto backdrop = Same(entry.backdrop, query.backdrop);
+		const auto symbol = Same(entry.symbol, query.symbol);
+		result.model += model ? 1 : 0;
+		result.backdrop += backdrop ? 1 : 0;
+		result.symbol += symbol ? 1 : 0;
+		result.exact += (model && backdrop && symbol) ? 1 : 0;
+	}
+	return result;
+}
+
+QString Loader::resolve(
+		const Query &query,
+		Name Entry::*field,
+		const Name &wanted) const {
+	for (const auto &entry : _entries) {
+		if (Same(entry.collection, query.collection)
+			&& Same(entry.*field, wanted)) {
+			return (entry.*field).raw;
+		}
+	}
+	return QString();
+}
+
+GiftListPrefill Loader::prefill(const Query &query) const {
+	auto result = GiftListPrefill();
+	if (query.collection.normal.isEmpty()) {
+		return result;
+	}
+	const auto title = resolve(query, &Entry::collection, query.collection);
+	result.query = title.isEmpty() ? query.collection.normal : title;
+	result.model = resolve(query, &Entry::model, query.model);
+	result.backdrop = resolve(query, &Entry::backdrop, query.backdrop);
+	result.symbol = resolve(query, &Entry::symbol, query.symbol);
+	return result;
+}
+
+[[nodiscard]] Loader &Get(not_null<Main::Session*> session) {
+	static auto loaders = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Loader>>();
+	const auto i = loaders.find(session);
+	if (i != end(loaders)) {
+		return *i->second;
+	}
+	session->lifetime().add([=] {
+		loaders.remove(session);
+	});
+	return *loaders.emplace(
+		session,
+		std::make_unique<Loader>(session)).first->second;
+}
+
+} // namespace
+
+rpl::producer<OwnedCounts> OwnedGiftCounts(
+		not_null<Main::Session*> session,
+		rpl::producer<OwnedQuery> query) {
+	const auto loader = &Get(session);
+	const auto weak = base::make_weak(loader);
+	return rpl::combine(
+		std::move(query) | rpl::map(MakeQuery),
+		loader->watch()
+	) | rpl::map([=](const Query &query, rpl::empty_value) {
+		const auto strong = weak.get();
+		return strong ? strong->count(query) : OwnedCounts();
+	});
+}
+
+void RefreshOwnedGifts(not_null<Main::Session*> session) {
+	Get(session).refresh(true);
+}
+
+void ShowOwnedGifts(
+		not_null<Window::SessionController*> controller,
+		const OwnedQuery &query) {
+	const auto session = &controller->session();
+	const auto self = session->user();
+	PrefillGiftListSearch(self, Get(session).prefill(MakeQuery(query)));
+	controller->showSection(Info::PeerGifts::Make(self));
+}
+
+} // namespace Tele::GiftStudio
