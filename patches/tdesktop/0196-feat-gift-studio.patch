diff --git a/Telegram/SourceFiles/tele/tele_tgs_rules.cpp b/Telegram/SourceFiles/tele/tele_tgs_rules.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d0a0433f0078434c74abcf5e3840b6d864ecc364
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_tgs_rules.cpp
@@ -0,0 +1,188 @@
+#include "tele/tele_tgs_rules.h"
+
+#include "tele/tele_lowercase.h"
+#include "ui/image/image_prepare.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxDepth = 256;
+
+struct Found {
+	int expressions = 0;
+	int masks = 0;
+	int mattes = 0;
+	int effects = 0;
+	int images = 0;
+	int solids = 0;
+	int texts = 0;
+	int threeD = 0;
+	int autoOrient = 0;
+	int timeRemap = 0;
+	int timeStretch = 0;
+	int stars = 0;
+	int repeaters = 0;
+};
+
+[[nodiscard]] bool Truthy(const QJsonValue &value) {
+	return value.isBool() ? value.toBool() : (value.toDouble() != 0.);
+}
+
+void WalkShapes(const QJsonValue &value, Found &found, int depth) {
+	if (depth > kMaxDepth) {
+		return;
+	} else if (value.isArray()) {
+		for (const auto &item : value.toArray()) {
+			WalkShapes(item, found, depth + 1);
+		}
+		return;
+	} else if (!value.isObject()) {
+		return;
+	}
+	const auto object = value.toObject();
+	const auto type = object.value(u"ty"_q).toString();
+	if (type == u"sr"_q) {
+		++found.stars;
+	} else if (type == u"rp"_q) {
+		++found.repeaters;
+	}
+	if (object.value(u"x"_q).isString()) {
+		++found.expressions;
+	}
+	for (auto i = object.begin(); i != object.end(); ++i) {
+		if (i.value().isObject() || i.value().isArray()) {
+			WalkShapes(i.value(), found, depth + 1);
+		}
+	}
+}
+
+void WalkLayers(const QJsonArray &layers, Found &found) {
+	for (const auto &value : layers) {
+		const auto layer = value.toObject();
+		const auto type = layer.value(u"ty"_q).toInt(-1);
+		if (type == 1) {
+			++found.solids;
+		} else if (type == 2) {
+			++found.images;
+		} else if (type == 5) {
+			++found.texts;
+		}
+		if (Truthy(layer.value(u"ddd"_q))) {
+			++found.threeD;
+		}
+		if (Truthy(layer.value(u"ao"_q))) {
+			++found.autoOrient;
+		}
+		if (Truthy(layer.value(u"hasMask"_q))
+			|| !layer.value(u"masksProperties"_q).toArray().isEmpty()) {
+			++found.masks;
+		}
+		if (Truthy(layer.value(u"tt"_q)) || Truthy(layer.value(u"td"_q))) {
+			++found.mattes;
+		}
+		if (!layer.value(u"ef"_q).toArray().isEmpty()) {
+			++found.effects;
+		}
+		if (layer.contains(u"tm"_q)) {
+			++found.timeRemap;
+		}
+		if (layer.contains(u"sr"_q) && layer.value(u"sr"_q).toDouble() != 1.) {
+			++found.timeStretch;
+		}
+		WalkShapes(layer.value(u"ks"_q), found, 0);
+		WalkShapes(layer.value(u"shapes"_q), found, 0);
+	}
+}
+
+[[nodiscard]] QString Count(int count, const QString &what) {
+	return QString::number(count) + ' ' + what;
+}
+
+} // namespace
+
+TgsReport CheckTgsSticker(const QByteArray &file) {
+	auto result = TgsReport();
+	if (file.size() > kTgsMaxBytes) {
+		result.errors.push_back(Lower(u"it's %1 KB, over 64 KB"_q).arg(
+			QString::number(file.size() / 1024., 'f', 1)));
+	}
+	const auto gzipped = (file.size() > 2)
+		&& (uchar(file[0]) == 0x1F)
+		&& (uchar(file[1]) == 0x8B);
+	if (!gzipped) {
+		result.errors.push_back(Lower(u"it isn't gzip-compressed"_q));
+		return result;
+	}
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(
+		Images::UnpackGzip(file),
+		&error);
+	if (error.error != QJsonParseError::NoError || !document.isObject()) {
+		result.errors.push_back(Lower(u"it isn't valid Lottie JSON"_q));
+		return result;
+	}
+	const auto root = document.object();
+	const auto rate = root.value(u"fr"_q).toDouble();
+	const auto width = root.value(u"w"_q).toDouble();
+	const auto height = root.value(u"h"_q).toDouble();
+	const auto frames = root.value(u"op"_q).toDouble()
+		- root.value(u"ip"_q).toDouble();
+	if (rate != 60. && rate != 30.) {
+		result.errors.push_back(
+			Lower(u"it runs at %1 fps, not 60"_q).arg(rate));
+	}
+	if (width != kTgsSide || height != kTgsSide) {
+		result.errors.push_back(
+			Lower(u"it's %1 \u00D7 %2, not 512 \u00D7 512"_q)
+				.arg(width)
+				.arg(height));
+	}
+	if (frames <= 0. || frames > kTgsMaxFrames) {
+		result.errors.push_back(
+			Lower(u"it's %1 frames long, more than 3 seconds"_q).arg(frames));
+	}
+	if (root.value(u"tgs"_q).toInt() != 1) {
+		result.warnings.push_back(Lower(u"no \"tgs\": 1 key"_q));
+	}
+	auto found = Found();
+	if (Truthy(root.value(u"ddd"_q))) {
+		++found.threeD;
+	}
+	WalkLayers(root.value(u"layers"_q).toArray(), found);
+	for (const auto &value : root.value(u"assets"_q).toArray()) {
+		const auto asset = value.toObject();
+		if (asset.contains(u"p"_q) && !asset.contains(u"layers"_q)) {
+			++found.images;
+		}
+		WalkLayers(asset.value(u"layers"_q).toArray(), found);
+	}
+	const auto warn = [&](int count, const QString &what) {
+		if (count) {
+			result.warnings.push_back(Count(count, Lower(what)));
+		}
+	};
+	warn(found.expressions, u"expressions"_q);
+	warn(found.masks, u"masked layers"_q);
+	warn(found.mattes, u"track mattes"_q);
+	warn(found.effects, u"layer effects"_q);
+	warn(found.images, u"images"_q);
+	warn(found.solids, u"solid layers"_q);
+	warn(found.texts, u"text layers"_q);
+	warn(found.threeD, u"3D layers"_q);
+	warn(found.autoOrient, u"auto-oriented layers"_q);
+	warn(found.timeRemap, u"time remaps"_q);
+	warn(found.timeStretch, u"time stretches"_q);
+	warn(found.stars, u"star shapes"_q);
+	warn(found.repeaters, u"repeaters"_q);
+	return result;
+}
+
+bool PassesTgsServerChecks(const QByteArray &file) {
+	return CheckTgsSticker(file).errors.isEmpty();
+}
+
+} // namespace Tele
