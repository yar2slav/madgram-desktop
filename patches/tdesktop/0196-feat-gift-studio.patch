+[[nodiscard]] QString FilePrefix(const QString &gift, const QString &model) {
+	static const auto kBad = QRegularExpression(
+		u"[\\\\/:*?\"<>|\\x00-\\x1F]"_q);
+	auto result = (gift + ' ' + model).trimmed();
+	result.replace(kBad, u"_"_q);
+	return result.isEmpty() ? u"gift"_q : result;
+}
+
+void PaintBackdropPreview(QPainter &p, QRect rect, const Colors &colors) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto gradient = QRadialGradient(QRectF(rect).center(), rect.width() / 2.);
+	gradient.setStops({
+		{ 0., colors.center },
+		{ 1., colors.edge },
+	});
+	p.setPen(Qt::NoPen);
+	p.setBrush(gradient);
+	p.drawEllipse(rect);
+}
+
+void PaintImagePreview(
+		QPainter &p,
+		QRect rect,
+		PreviewKind kind,
+		const QString &gift,
+		const QString &name,
+		not_null<Ui::RpWidget*> list,
+		std::optional<QColor> tint) {
+	auto hq = PainterHighQualityEnabler(p);
+	auto image = LookupPreview(kind, gift, name);
+	if (image.isNull()) {
+		RequestPreview(kind, gift, name, crl::guard(list.get(), [=] {
+			list->update();
+		}));
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawEllipse(rect);
+		return;
+	}
+	if (tint) {
+		auto colored = QImage(
+			image.size(),
+			QImage::Format_ARGB32_Premultiplied);
+		colored.fill(Qt::transparent);
+		auto q = QPainter(&colored);
+		q.drawImage(0, 0, image);
+		q.setCompositionMode(QPainter::CompositionMode_SourceIn);
+		q.fillRect(colored.rect(), *tint);
+		q.end();
+		image = std::move(colored);
+	}
+	p.drawImage(rect, image);
+}
