+[[nodiscard]] Json ShapeLayer(
+		int index,
+		const QByteArray &name,
+		std::vector<Json> groups,
+		double in,
+		double out) {
+	return JsonObject({
+		{ "ddd", JsonNumber(0.) },
+		{ "ind", JsonNumber(index) },
+		{ "ty", JsonNumber(4.) },
+		{ "nm", JsonString(name) },
+		{ "ks", JsonTransform({}, {}, 1., 1.) },
+		{ "ip", JsonNumber(in) },
+		{ "op", JsonNumber(out) },
+		{ "st", JsonNumber(0.) },
+		{ "sr", JsonNumber(1.) },
+		{ "ao", JsonNumber(0.) },
+		{ "bm", JsonNumber(0.) },
+		{ "shapes", JsonArray(std::move(groups)) },
+	});
