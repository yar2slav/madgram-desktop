+class VectorEngine final : public QPaintEngine {
+public:
+	VectorEngine() : QPaintEngine(QPaintEngine::AllFeatures) {
+	}
+
+	bool begin(QPaintDevice *device) override {
+		return true;
+	}
+	bool end() override {
+		return true;
+	}
+	Type type() const override {
+		return QPaintEngine::User;
+	}
+	void updateState(const QPaintEngineState &state) override;
+	void drawPath(const QPainterPath &path) override;
+	void drawPolygon(
+		const QPointF *points,
+		int count,
+		PolygonDrawMode mode) override;
+	void drawRects(const QRectF *rects, int count) override;
+	void drawTextItem(const QPointF &point, const QTextItem &item) override;
+	void drawPixmap(
+		const QRectF &target,
+		const QPixmap &pixmap,
+		const QRectF &source) override {
+	}
+
+	[[nodiscard]] std::vector<VectorShape> take() {
+		return base::take(_shapes);
+	}
+
+private:
+	void add(QPainterPath path, QColor color);
+	void clip(const QPainterPath &path, Qt::ClipOperation operation);
+
+	std::vector<VectorShape> _shapes;
+	QTransform _transform;
+	QBrush _brush;
+	QPen _pen;
+	qreal _opacity = 1.;
+	QPainterPath _clip;
+	bool _clipped = false;
+	bool _clipEnabled = true;
+
+};
+
+void VectorEngine::updateState(const QPaintEngineState &state) {
+	const auto flags = state.state();
+	if (flags & QPaintEngine::DirtyTransform) {
+		_transform = state.transform();
+	}
+	if (flags & QPaintEngine::DirtyBrush) {
+		_brush = state.brush();
+	}
+	if (flags & QPaintEngine::DirtyPen) {
+		_pen = state.pen();
+	}
+	if (flags & QPaintEngine::DirtyOpacity) {
+		_opacity = state.opacity();
+	}
+	if (flags & QPaintEngine::DirtyClipPath) {
+		clip(state.clipPath(), state.clipOperation());
+	}
+	if (flags & QPaintEngine::DirtyClipRegion) {
+		auto path = QPainterPath();
+		path.addRegion(state.clipRegion());
+		clip(path, state.clipOperation());
+	}
+	if (flags & QPaintEngine::DirtyClipEnabled) {
+		_clipEnabled = state.isClipEnabled();
+	}
+}
+
+void VectorEngine::clip(
+		const QPainterPath &path,
+		Qt::ClipOperation operation) {
+	const auto mapped = _transform.map(path);
+	if (operation == Qt::NoClip) {
+		_clipped = false;
+		_clip = QPainterPath();
+	} else if (operation == Qt::IntersectClip && _clipped) {
+		_clip = _clip.intersected(mapped);
+	} else {
+		_clip = mapped;
+		_clipped = true;
+	}
+	_clipEnabled = true;
+}
+
+void VectorEngine::add(QPainterPath path, QColor color) {
+	color.setAlphaF(color.alphaF() * _opacity);
+	if (!color.alpha() || path.isEmpty()) {
+		return;
+	}
+	if (_clipped && _clipEnabled) {
+		if (!_clip.intersects(path.boundingRect())) {
+			return;
+		} else if (!_clip.contains(path.boundingRect())) {
+			path = path.intersected(_clip);
+		}
+	}
+	_shapes.push_back({ std::move(path), color });
+}
+
+void VectorEngine::drawPath(const QPainterPath &path) {
+	if (_brush.style() != Qt::NoBrush) {
+		add(_transform.map(path), _brush.color());
+	}
+}
+
+void VectorEngine::drawPolygon(
+		const QPointF *points,
+		int count,
+		PolygonDrawMode mode) {
+	if (mode == PolylineMode || count < 3) {
+		return;
+	}
+	auto path = QPainterPath();
+	auto polygon = QPolygonF();
+	polygon.reserve(count);
+	for (auto i = 0; i != count; ++i) {
+		polygon.push_back(points[i]);
+	}
+	path.addPolygon(polygon);
+	path.closeSubpath();
+	drawPath(path);
+}
+
+void VectorEngine::drawRects(const QRectF *rects, int count) {
+	auto path = QPainterPath();
+	for (auto i = 0; i != count; ++i) {
+		path.addRect(rects[i]);
+	}
+	drawPath(path);
+}
+
+void VectorEngine::drawTextItem(const QPointF &point, const QTextItem &item) {
+	auto path = QPainterPath();
+	path.setFillRule(Qt::WindingFill);
+	path.addText(point, item.font(), item.text());
+	add(_transform.map(path), _pen.color());
+}
+
+class VectorDevice final : public QPaintDevice {
+public:
+	explicit VectorDevice(QSize size) : _size(size) {
+	}
+
+	QPaintEngine *paintEngine() const override {
+		return &_engine;
+	}
+	[[nodiscard]] std::vector<VectorShape> take() {
+		return _engine.take();
+	}
+
+protected:
+	int metric(PaintDeviceMetric metric) const override {
+		switch (metric) {
+		case PdmWidth: return _size.width();
+		case PdmHeight: return _size.height();
+		case PdmWidthMM: return _size.width() * 254 / 960;
+		case PdmHeightMM: return _size.height() * 254 / 960;
+		case PdmNumColors: return INT_MAX;
+		case PdmDepth: return 32;
+		case PdmDpiX:
+		case PdmDpiY:
+		case PdmPhysicalDpiX:
+		case PdmPhysicalDpiY: return 96;
+		case PdmDevicePixelRatio: return 1;
+		case PdmDevicePixelRatioScaled:
+			return int(QPaintDevice::devicePixelRatioFScale());
+		}
+		return 0;
+	}
+
+private:
+	QSize _size;
+	mutable VectorEngine _engine;
+
+};
