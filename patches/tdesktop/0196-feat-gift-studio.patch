+#pragma once
+
+#include "tele/tele_gift_studio_render.h"
+
+namespace Tele::GiftStudio {
+
+struct Combo {
+	QString collection;
+	QString model;
+	QString backdrop;
+	QString symbol;
+	QString title;
+	QString number;
+	Options options;
+	Motion motion;
+};
+
+struct Favorite {
+	QString name;
+	Combo combo;
+};
+
+inline constexpr auto kHistoryLimit = 20;
+
+[[nodiscard]] QString ComboCode(const Combo &combo);
+[[nodiscard]] std::optional<Combo> ParseComboCode(const QString &text);
+[[nodiscard]] QString ComboLabel(const Combo &combo);
+
+[[nodiscard]] const std::vector<Favorite> &Favorites();
+[[nodiscard]] const std::vector<Combo> &History();
+void AddFavorite(Favorite favorite);
+void RemoveFavorite(int index);
+void AddHistory(Combo combo);
+void ClearHistory();
+[[nodiscard]] rpl::producer<> StoreChanges();
+[[nodiscard]] bool SectionExpanded(const QString &id);
+void SetSectionExpanded(const QString &id, bool expanded);
+
+} // namespace Tele::GiftStudio
