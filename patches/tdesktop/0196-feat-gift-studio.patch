+#pragma once
+
+#include "tele/tele_gift_studio_render.h"
+#include "tele/tele_tgs_rules.h"
+
+namespace Tele::GiftStudio {
+
+struct Encoded {
+	QByteArray bytes;
+	QSize size;
+	int frames = 0;
+};
+
+struct TgsBudget {
+	int decimals = -1;
+	int maxPoints = -1;
+	bool simpleText = false;
+	bool text = true;
+};
+
+struct Tgs {
+	QByteArray bytes;
+	QString error;
+	TgsBudget budget;
+	TgsReport report;
+	QStringList fixes;
+};
+
+inline constexpr auto kStickerSide = 512;
+inline constexpr auto kStickerFps = 30.;
+inline constexpr auto kStickerDuration = crl::time(3000);
+
+[[nodiscard]] QSize Mp4Size(QSize canvas);
+[[nodiscard]] QSize StickerSize(QSize canvas);
+[[nodiscard]] Encoded EncodeGif(
+	const Animation &animation,
+	Fn<bool()> alive);
+[[nodiscard]] bool VerifyGif(const Encoded &gif);
