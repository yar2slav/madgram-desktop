+void AddMainMenuItems(
+		not_null<Ui::VerticalLayout*> menu,
+		not_null<Window::SessionController*> controller) {
+	const auto studio = GiftStudioMainMenu() && !OfflineForLaunch();
+	if (!GhostInMenu() && !StreamerModeInMenu() && !studio) {
+		return;
+	}
+	menu->add(
+		object_ptr<Ui::PlainShadow>(menu),
+		{ 0, st::mainMenuSkip, 0, st::mainMenuSkip });
+	AddGhostMenuToggle(menu);
+	AddStreamerMenuToggle(menu);
+	if (studio) {
+		Settings::AddButtonWithIcon(
+			menu,
+			rpl::single(Lower(u"Gift studio"_q)),
+			st::mainMenuButton,
+			{ &st::menuIconPalette }
+		)->setClickedCallback([=] {
+			ShowGiftStudio(controller);
+		});
+	}
+}
+
