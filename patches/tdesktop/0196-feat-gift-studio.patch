@@ -0,0 +1,299 @@
+#include "tele/tele_gift_studio_sweep.h"
+
+#include "data/data_star_gift.h"
+#include "tele/tele_lowercase.h"
+#include "ui/painter.h"
+#include "styles/style_basic.h"
+
+#include <QtCore/QDir>
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kSheetTile = 320;
+constexpr auto kSheetPadding = 16;
+constexpr auto kSheetCaptionLines = 2;
+constexpr auto kMaxSheetSide = 16384;
+
+[[nodiscard]] QString RarityText(int permille) {
+	auto attribute = Data::UniqueGiftAttribute();
+	attribute.rarityValue = permille;
+	return Data::UniqueGiftAttributeText(attribute);
+}
+
+[[nodiscard]] QString SafeName(QString name) {
+	static const auto kBad = QRegularExpression(
+		u"[\\\\/:*?\"<>|\\x00-\\x1F]"_q);
+	name.replace(kBad, u"_"_q);
+	name = name.trimmed();
+	while (name.endsWith('.')) {
+		name.chop(1);
+	}
+	return name.isEmpty() ? u"gift"_q : name;
+}
+
+} // namespace
+
+Sweep::Sweep(
+	SweepSource source,
+	SweepKind kind,
+	SweepOutput output,
+	QString target)
+: _source(std::move(source))
+, _kind(kind)
+, _output(output)
+, _target(std::move(target)) {
+	const auto &parts = _source.parts;
+	const auto push = [&](const QString &name, int permille) {
+		_items.push_back({
+			.name = name,
+			.caption = name + u" \u00B7 "_q + RarityText(permille),
+		});
+	};
+	switch (_kind) {
+	case SweepKind::Backdrops:
+		for (const auto &backdrop : parts.backdrops) {
+			push(backdrop.name, backdrop.permille);
+		}
+		break;
+	case SweepKind::Symbols:
+		for (const auto &symbol : parts.symbols) {
+			push(symbol.name, symbol.permille);
+		}
+		break;
+	case SweepKind::Models:
+		for (const auto &model : parts.models) {
+			push(model.name, model.permille);
+		}
+		break;
+	}
+	_renderer.setTexts(_source.texts);
+	_renderer.setMotion(_source.motion);
+	if (_source.backdrop >= 0
+		&& _source.backdrop < int(parts.backdrops.size())) {
+		_renderer.setColors(parts.backdrops[_source.backdrop].colors);
+	}
+	_renderer.setModel(_source.modelJson);
+	_renderer.setSymbol(_source.symbolJson);
+	auto options = _source.options;
+	if (_output == SweepOutput::Sheet) {
+		options.canvas = options.canvas.scaled(
+			kSheetTile,
+			kSheetTile,
+			Qt::KeepAspectRatio);
+	}
+	_renderer.setOptions(options);
+}
+
+Sweep::~Sweep() {
+	cancel();
+}
+
+int Sweep::total() const {
+	return int(_items.size());
+}
+
+void Sweep::start(
+		Fn<void(int done, int total)> progress,
+		Fn<void(bool ok, QString text)> finished) {
+	_progress = std::move(progress);
+	_finished = std::move(finished);
+	if (_items.empty()) {
+		fail(Lower(u"There's nothing to sweep."_q));
+		return;
+	} else if (_output == SweepOutput::Folder && !QDir().mkpath(_target)) {
+		fail(Lower(u"Couldn't create the folder."_q));
+		return;
+	}
+	next();
+}
+
+void Sweep::cancel() {
+	_cancelled = true;
+	_progress = nullptr;
+	_finished = nullptr;
+}
+
+void Sweep::next() {
+	if (_cancelled) {
+		return;
+	} else if (_index >= int(_items.size())) {
+		finish();
+		return;
+	}
+	const auto index = _index;
+	const auto weak = base::make_weak(this);
+	const auto done = [=](QByteArray json) {
+		crl::on_main(weak, [=] {
+			render(index, json);
+		});
+	};
+	const auto failed = [=] {
+		crl::on_main(weak, [=] {
+			render(index, QByteArray());
+		});
+	};
+	const auto &name = _items[index].name;
+	switch (_kind) {
+	case SweepKind::Backdrops:
+		done(QByteArray());
+		break;
+	case SweepKind::Symbols:
+		RequestSymbol(_source.collection, name, done, failed);
+		break;
+	case SweepKind::Models:
+		RequestModel(_source.collection, name, done, failed);
+		break;
+	}
+}
+
+void Sweep::render(int index, QByteArray json) {
+	if (_cancelled || index != _index) {
+		return;
+	}
+	auto &item = _items[index];
+	auto texts = _source.texts;
+	switch (_kind) {
+	case SweepKind::Backdrops: {
+		const auto &backdrop = _source.parts.backdrops[index];
+		_renderer.setColors(backdrop.colors);
+		texts.backdrop = backdrop.name;
+	} break;
+	case SweepKind::Symbols:
+		_renderer.setSymbol(json);
+		texts.symbol = item.name;
+		break;
+	case SweepKind::Models:
+		_renderer.setModel(json);
+		texts.model = item.name;
+		texts.subtitle = item.name;
+		break;
+	}
+	const auto &parts = _source.parts;
+	const auto model = (_kind == SweepKind::Models)
+		? index
+		: _source.model;
+	const auto backdrop = (_kind == SweepKind::Backdrops)
+		? index
+		: _source.backdrop;
+	if (model >= 0
+		&& model < int(parts.models.size())
+		&& backdrop >= 0
+		&& backdrop < int(parts.backdrops.size())) {
+		texts.rarity = RarityOdds(
+			parts.models[model].permille,
+			parts.backdrops[backdrop].permille);
+	}
+	_renderer.setTexts(texts);
+	const auto ok = !json.isEmpty() || (_kind == SweepKind::Backdrops);
+	auto image = ok ? _renderer.render(_source.frame) : QImage();
+	if (!image.isNull()) {
+		if (_output == SweepOutput::Folder) {
+			if (!_source.options.rounded
+				&& _source.options.layout == LayoutKind::Cover
+				&& _source.options.background.kind
+					!= BackgroundKind::Transparent) {
+				image = std::move(image).convertToFormat(
+					QImage::Format_RGB32);
+			}
+			if (image.save(fileName(index), "PNG")) {
+				++_saved;
+			}
+		} else {
+			item.image = std::move(image);
+			++_saved;
+		}
+	}
+	++_index;
+	if (_progress) {
+		_progress(_index, int(_items.size()));
+	}
+	crl::on_main(this, [=] {
+		next();
+	});
+}
+
+QString Sweep::fileName(int index) const {
+	auto base = SafeName(_source.collection + u" - "_q + _items[index].name);
+	auto result = _target + '/' + base + u".png"_q;
+	for (auto i = 2; QFile::exists(result); ++i) {
+		result = _target + '/' + base + u" (%1).png"_q.arg(i);
+	}
+	return result;
+}
+
+QImage Sweep::sheet() const {
+	const auto &font = st::normalFont;
+	auto tile = QSize();
+	for (const auto &item : _items) {
+		if (!item.image.isNull()) {
+			tile = tile.expandedTo(item.image.size());
+		}
+	}
+	if (tile.isEmpty()) {
+		return QImage();
+	}
+	const auto count = int(_items.size());
+	const auto columns = std::max(
+		int(std::ceil(std::sqrt(float64(count)))),
+		1);
+	const auto rows = (count + columns - 1) / columns;
+	const auto caption = font->height * kSheetCaptionLines;
+	const auto cell = QSize(
+		tile.width() + kSheetPadding,
+		tile.height() + caption + kSheetPadding);
+	const auto size = QSize(
+		std::min(columns * cell.width() + kSheetPadding, kMaxSheetSide),
+		std::min(rows * cell.height() + kSheetPadding, kMaxSheetSide));
+	auto result = QImage(size, QImage::Format_ARGB32_Premultiplied);
+	result.fill(QColor(0x1E, 0x1E, 0x1E));
+	auto p = QPainter(&result);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setFont(font->f);
+	for (auto i = 0; i != count; ++i) {
+		const auto &item = _items[i];
+		const auto left = kSheetPadding + (i % columns) * cell.width();
+		const auto top = kSheetPadding + (i / columns) * cell.height();
+		if (!item.image.isNull()) {
+			p.drawImage(
+				left + (tile.width() - item.image.width()) / 2,
+				top + (tile.height() - item.image.height()) / 2,
+				item.image);
+		}
+		p.setPen(QColor(255, 255, 255));
+		p.drawText(
+			QRect(left, top + tile.height(), tile.width(), caption),
+			Qt::AlignHCenter | Qt::AlignTop | Qt::TextWordWrap,
+			item.caption);
+	}
+	return result;
+}
+
+void Sweep::finish() {
+	auto ok = (_saved > 0);
+	auto text = QString();
+	if (_output == SweepOutput::Sheet) {
+		const auto image = sheet();
+		ok = !image.isNull() && image.save(_target, "PNG");
+		text = ok
+			? Lower(u"Saved a sheet of %1 renders."_q).arg(_saved)
+			: Lower(u"Couldn't save the sheet."_q);
+	} else {
+		text = ok
+			? Lower(u"Saved %1 of %2 renders."_q)
+				.arg(_saved)
+				.arg(_items.size())
+			: Lower(u"Couldn't render anything."_q);
+	}
+	if (const auto finished = base::take(_finished)) {
+		finished(ok, text);
+	}
+}
+
+void Sweep::fail(QString text) {
+	if (const auto finished = base::take(_finished)) {
+		finished(false, text);
+	}
+}
+
+} // namespace Tele::GiftStudio
