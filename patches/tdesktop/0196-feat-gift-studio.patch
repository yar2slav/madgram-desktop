diff --git a/Telegram/SourceFiles/tele/tele_gift_studio_data.cpp b/Telegram/SourceFiles/tele/tele_gift_studio_data.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..116633e044226a736c09b29e1d2768206bb05d9e
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_studio_data.cpp
@@ -0,0 +1,410 @@
+#include "tele/tele_gift_studio_data.h"
+
+#include "settings.h"
+#include "tele/tele_launch_flags.h"
+#include "ui/image/image_prepare.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QTimer>
+#include <QtCore/QUrl>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kHost = "https://api.changes.tg/";
+constexpr auto kTimeout = 20 * 1000;
+constexpr auto kMaxSize = qint64(8 * 1024 * 1024);
+constexpr auto kMaxMemory = qint64(48 * 1024 * 1024);
+constexpr auto kMaxPreviewRequests = 6;
+
+struct Pending {
+	std::vector<Fn<void(QByteArray)>> done;
+	std::vector<Fn<void()>> fail;
+};
+
+struct Cache {
+	base::flat_map<QString, QByteArray> bytes;
+	qint64 total = 0;
+	base::flat_map<QString, Pending> pending;
+	base::flat_map<QString, QImage> previews;
+	base::flat_set<QString> failedPreviews;
+	int previewRequests = 0;
+};
+
+[[nodiscard]] Cache &Data() {
+	static auto result = Cache();
+	return result;
+}
+
+[[nodiscard]] QNetworkAccessManager *Manager() {
+	static const auto result = new QNetworkAccessManager(
+		QCoreApplication::instance());
+	return result;
+}
+
+[[nodiscard]] QString Segment(const QString &value) {
+	return QString::fromLatin1(QUrl::toPercentEncoding(value));
+}
+
+[[nodiscard]] QString DiskFolder() {
+	return cWorkingDir() + u"tdata/tele_gift_studio/"_q;
+}
+
+[[nodiscard]] QString DiskPath(const QString &path) {
+	const auto hash = QCryptographicHash::hash(
+		path.toUtf8(),
+		QCryptographicHash::Sha1);
+	return DiskFolder() + QString::fromLatin1(hash.toHex());
+}
+
+[[nodiscard]] QByteArray ReadDisk(const QString &path) {
+	auto file = QFile(DiskPath(path));
+	if (!file.open(QIODevice::ReadOnly) || file.size() > kMaxSize) {
+		return QByteArray();
+	}
+	return file.readAll();
+}
+
+void WriteDisk(const QString &path, const QByteArray &bytes) {
+	QDir().mkpath(DiskFolder());
+	auto file = QFile(DiskPath(path));
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(bytes);
+	}
+}
+
+void Remember(const QString &path, const QByteArray &bytes) {
+	auto &data = Data();
+	if (data.bytes.contains(path)) {
+		return;
+	} else if (data.total + bytes.size() > kMaxMemory) {
+		data.bytes.clear();
+		data.total = 0;
+	}
+	data.total += bytes.size();
+	data.bytes.emplace(path, bytes);
+}
+
+void Fetch(
+		const QString &path,
+		bool disk,
+		Fn<void(QByteArray)> done,
+		Fn<void()> fail) {
+	auto &data = Data();
+	if (const auto i = data.bytes.find(path); i != end(data.bytes)) {
+		done(i->second);
+		return;
+	}
+	if (disk) {
+		auto bytes = ReadDisk(path);
+		if (!bytes.isEmpty()) {
+			Remember(path, bytes);
+			done(std::move(bytes));
+			return;
+		}
+	}
+	if (OfflineForLaunch()) {
+		fail();
+		return;
+	}
+	auto &pending = data.pending[path];
+	pending.done.push_back(std::move(done));
+	pending.fail.push_back(std::move(fail));
+	if (pending.done.size() > 1) {
+		return;
+	}
+	auto request = QNetworkRequest(
+		QUrl::fromEncoded(QByteArray(kHost) + path.toLatin1()));
+	request.setAttribute(
+		QNetworkRequest::RedirectPolicyAttribute,
+		QNetworkRequest::NoLessSafeRedirectPolicy);
+	request.setTransferTimeout(std::chrono::milliseconds(kTimeout));
+	const auto reply = Manager()->get(request);
+	QTimer::singleShot(kTimeout, reply, [=] {
+		reply->abort();
+	});
+	QObject::connect(reply, &QNetworkReply::downloadProgress, reply, [=](
+			qint64 ready,
+			qint64 total) {
+		if (ready > kMaxSize || total > kMaxSize) {
+			reply->abort();
+		}
+	});
+	QObject::connect(reply, &QNetworkReply::finished, reply, [=] {
+		reply->deleteLater();
+		const auto status = reply->attribute(
+			QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		auto bytes = (status == 200 && reply->error() == QNetworkReply::NoError)
+			? reply->readAll()
+			: QByteArray();
+		auto callbacks = Data().pending.take(path).value_or(Pending());
+		if (bytes.isEmpty()) {
+			LOG(("Tele Gift Studio Error: %1 %2").arg(path).arg(status
+				? QString::number(status)
+				: reply->errorString()));
+			for (const auto &callback : callbacks.fail) {
+				callback();
+			}
+			return;
+		}
+		Remember(path, bytes);
+		if (disk) {
+			WriteDisk(path, bytes);
+		}
+		for (const auto &callback : callbacks.done) {
+			callback(bytes);
+		}
+	});
+}
+
+[[nodiscard]] QJsonArray ParseArray(const QByteArray &bytes) {
+	auto error = QJsonParseError();
+	const auto document = QJsonDocument::fromJson(bytes, &error);
+	return (error.error == QJsonParseError::NoError && document.isArray())
+		? document.array()
+		: QJsonArray();
+}
+
+[[nodiscard]] std::vector<Attribute> ParseAttributes(
+		const QByteArray &bytes) {
+	auto result = std::vector<Attribute>();
+	for (const auto &value : ParseArray(bytes)) {
+		const auto object = value.toObject();
+		const auto name = object.value(u"name"_q).toString();
+		if (!name.isEmpty()) {
+			result.push_back({
+				.name = name,
+				.permille = object.value(u"rarityPermille"_q).toInt(),
+			});
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QColor ParseColor(const QJsonValue &value) {
+	const auto rgb = uint32(value.toInt());
+	return QColor((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+}
+
+[[nodiscard]] std::vector<Backdrop> ParseBackdrops(const QByteArray &bytes) {
+	auto result = std::vector<Backdrop>();
+	for (const auto &value : ParseArray(bytes)) {
+		const auto object = value.toObject();
+		const auto name = object.value(u"name"_q).toString();
+		if (!name.isEmpty()) {
+			result.push_back({
+				.name = name,
+				.permille = object.value(u"rarityPermille"_q).toInt(),
+				.colors = {
+					.center = ParseColor(object.value(u"centerColor"_q)),
+					.edge = ParseColor(object.value(u"edgeColor"_q)),
+					.pattern = ParseColor(object.value(u"patternColor"_q)),
+					.text = ParseColor(object.value(u"textColor"_q)),
+				},
+			});
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString AssetPath(
+		const QString &kind,
+		const QString &gift,
+		const QString &name,
+		const QString &extension) {
+	return kind + '/' + Segment(gift) + '/' + Segment(name) + extension;
+}
+
+[[nodiscard]] QString PreviewPath(
+		PreviewKind kind,
+		const QString &gift,
+		const QString &name) {
+	const auto extension = u".png?size=64"_q;
+	switch (kind) {
+	case PreviewKind::Gift:
+		return u"original/"_q + Segment(gift) + extension;
+	case PreviewKind::Model:
+		return AssetPath(u"model"_q, gift, name, extension);
+	case PreviewKind::Symbol:
+		return AssetPath(u"symbol"_q, gift, name, extension);
+	}
+	return QString();
+}
+
+void RequestLottie(
+		const QString &path,
+		Fn<void(QByteArray)> done,
+		Fn<void()> fail) {
+	Fetch(path, true, [=](QByteArray bytes) {
+		done(Images::UnpackGzip(bytes));
+	}, fail);
+}
+
+} // namespace
+
+void RequestGifts(
+		Fn<void(std::vector<QString>)> done,
+		Fn<void()> fail) {
+	Fetch(u"gifts"_q, false, [=](QByteArray bytes) {
+		auto result = std::vector<QString>();
+		for (const auto &value : ParseArray(bytes)) {
+			const auto name = value.toString();
+			if (!name.isEmpty()) {
+				result.push_back(name);
+			}
+		}
+		if (result.empty()) {
+			fail();
+		} else {
+			done(std::move(result));
+		}
+	}, fail);
+}
+
+void RequestIds(
+		Fn<void(base::flat_map<uint64, QString>)> done,
+		Fn<void()> fail) {
+	Fetch(u"ids"_q, false, [=](QByteArray bytes) {
+		auto error = QJsonParseError();
+		const auto document = QJsonDocument::fromJson(bytes, &error);
+		if (error.error != QJsonParseError::NoError
+			|| !document.isObject()) {
+			fail();
+			return;
+		}
+		auto result = base::flat_map<uint64, QString>();
+		const auto object = document.object();
+		for (auto i = object.begin(); i != object.end(); ++i) {
+			auto ok = false;
+			const auto id = i.key().toULongLong(&ok);
+			const auto name = i.value().toString();
+			if (ok && !name.isEmpty()) {
+				result.emplace(id, name);
+			}
+		}
+		done(std::move(result));
+	}, fail);
+}
+
+void RequestParts(
+		const QString &gift,
+		Fn<void(Parts)> done,
+		Fn<void()> fail) {
+	struct Collected {
+		Parts parts;
+		int left = 3;
+		bool failed = false;
+	};
+	const auto collected = std::make_shared<Collected>();
+	const auto check = [=] {
+		if (--collected->left || collected->failed) {
+			return;
+		}
+		auto &parts = collected->parts;
+		if (parts.models.empty()
+			|| parts.backdrops.empty()
+			|| parts.symbols.empty()) {
+			fail();
+		} else {
+			done(std::move(parts));
+		}
+	};
+	const auto failed = [=] {
+		if (!collected->failed) {
+			collected->failed = true;
+			fail();
+		}
+	};
+	const auto segment = Segment(gift);
+	Fetch(u"models/"_q + segment + u"?sorted"_q, false, [=](QByteArray bytes) {
+		collected->parts.models = ParseAttributes(bytes);
+		check();
+	}, failed);
+	Fetch(u"backdrops/"_q + segment + u"?sorted"_q, false, [=](
+			QByteArray bytes) {
+		collected->parts.backdrops = ParseBackdrops(bytes);
+		check();
+	}, failed);
+	Fetch(u"symbols/"_q + segment + u"?sorted"_q, false, [=](
+			QByteArray bytes) {
+		collected->parts.symbols = ParseAttributes(bytes);
+		check();
+	}, failed);
+}
+
+void RequestModel(
+		const QString &gift,
+		const QString &model,
+		Fn<void(QByteArray)> done,
+		Fn<void()> fail) {
+	RequestLottie(
+		AssetPath(u"model"_q, gift, model, u".tgs"_q),
+		std::move(done),
+		std::move(fail));
+}
+
+void RequestSymbol(
+		const QString &gift,
+		const QString &symbol,
+		Fn<void(QByteArray)> done,
+		Fn<void()> fail) {
+	RequestLottie(
+		AssetPath(u"symbol"_q, gift, symbol, u".tgs"_q),
+		std::move(done),
+		std::move(fail));
+}
+
+QImage LookupPreview(
+		PreviewKind kind,
+		const QString &gift,
+		const QString &name) {
+	const auto &previews = Data().previews;
+	const auto i = previews.find(PreviewPath(kind, gift, name));
+	return (i != end(previews)) ? i->second : QImage();
+}
+
+void RequestPreview(
+		PreviewKind kind,
+		const QString &gift,
+		const QString &name,
+		Fn<void()> ready) {
+	auto &data = Data();
+	const auto path = PreviewPath(kind, gift, name);
+	if (data.previews.contains(path)
+		|| data.failedPreviews.contains(path)
+		|| data.pending.contains(path)
+		|| data.previewRequests >= kMaxPreviewRequests) {
+		return;
+	}
+	++data.previewRequests;
+	const auto finish = [=](QImage image) {
+		auto &data = Data();
+		--data.previewRequests;
+		if (image.isNull()) {
+			data.failedPreviews.emplace(path);
+		} else {
+			data.previews.emplace(path, std::move(image));
+		}
+		ready();
+	};
+	Fetch(path, true, [=](QByteArray bytes) {
+		auto image = QImage::fromData(bytes, "PNG");
+		finish(image.isNull()
+			? QImage()
+			: std::move(image).convertToFormat(
+				QImage::Format_ARGB32_Premultiplied));
+	}, [=] {
+		finish(QImage());
+	});
+}
+
+} // namespace Tele::GiftStudio
