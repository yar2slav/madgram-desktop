+[[nodiscard]] Json RectShape(QRectF rect, double radius) {
+	const auto center = rect.center();
+	return JsonObject({
+		{ "ty", JsonString("rc") },
+		{ "d", JsonNumber(1.) },
+		{ "s", JsonStatic(JsonNumbers({ rect.width(), rect.height() })) },
+		{ "p", JsonStatic(JsonNumbers({ center.x(), center.y() })) },
+		{ "r", JsonStatic(JsonNumber(radius)) },
+	});
