+[[nodiscard]] Json GroupTransform() {
+	return JsonObject({
+		{ "ty", JsonString("tr") },
+		{ "p", JsonStatic(JsonNumbers({ 0., 0. })) },
+		{ "a", JsonStatic(JsonNumbers({ 0., 0. })) },
+		{ "s", JsonStatic(JsonNumbers({ 100., 100. })) },
+		{ "r", JsonStatic(JsonNumber(0.)) },
+		{ "o", JsonStatic(JsonNumber(100.)) },
+		{ "sk", JsonStatic(JsonNumber(0.)) },
+		{ "sa", JsonStatic(JsonNumber(0.)) },
+	});
+}
+
+[[nodiscard]] Json ShapeGroup(std::vector<Json> items) {
+	items.push_back(GroupTransform());
+	return JsonObject({
+		{ "ty", JsonString("gr") },
+		{ "it", JsonArray(std::move(items)) },
+	});
+}
