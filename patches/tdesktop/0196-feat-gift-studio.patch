+		const auto symbol = state->renderer.symbolJson();
+		const auto colors = state->renderer.colors();
+		const auto options = state->options;
+		const auto texts = state->renderer.texts();
+		const auto motion = state->motion;
+		return fit
+			? FitTgs(
+				model,
+				symbol,
+				colors,
+				options,
+				texts,
+				motion,
+				kTgsStickerLimit)
+			: BuildTgs(model, symbol, colors, options, texts, motion);
+	};
+	const auto stickerProblem = [](const Tgs &tgs) {
+		return tgs.report.errors.isEmpty()
+			? QString()
+			: Lower(u"It can't be a sticker: %1."_q).arg(
+				tgs.report.errors.join(u", "_q));
+	};
+	const auto showTgsReport = [=](const Tgs &tgs) {
+		const auto &bytes = tgs.bytes;
+		const auto kb = QString::number(bytes.size() / 1024., 'f', 1);
+		auto lines = QStringList();
+		lines.push_back(tgs.report.errors.isEmpty()
+			? Lower(u"TGS: %1 KB, passes Telegram's sticker checks."_q)
+				.arg(kb)
+			: Lower(u"TGS: %1 KB, can't be a sticker: %2."_q)
+				.arg(kb)
+				.arg(tgs.report.errors.join(u", "_q)));
+		if (!tgs.report.warnings.isEmpty()) {
+			lines.push_back(Lower(u"Not allowed in stickers: %1."_q)
+				.arg(tgs.report.warnings.join(u", "_q)));
+		}
+		if (!tgs.fixes.isEmpty()) {
+			lines.push_back(Lower(u"Fixes applied: %1."_q)
+				.arg(tgs.fixes.join(u", "_q)));
+		}
+		auto text = TextWithEntities{ lines.join('\n') };
+		if (bytes.size() > kTgsStickerLimit) {
+			text.append(' ').append(Ui::Text::Link(Lower(u"Fit to 64 KB"_q)));
+		}
+		tgsInfo->setMarkedText(text);
+		tgsWrap->show(anim::type::instant);
+	};
+	tgsInfo->setClickHandlerFilter([=](const auto &...) {
+		if (!ready(true)) {
+			return false;
+		}
+		const auto tgs = buildTgs(true);
+		if (tgs.bytes.isEmpty()) {
+			state->toast(tgs.error);
+			return false;
+		}
+		showTgsReport(tgs);
+		saveBytes(
+			tgs.bytes,
+			u"TGS"_q,
+			u"Telegram Sticker (*.tgs)"_q,
+			u".tgs"_q);
+		return false;
+	});
+	const auto stickerTooLong = [=] {
+		const auto rate = state->renderer.frameRate();
+		const auto frames = state->renderer.framesCount();
+		return (rate > 0.) && (frames * 1000. / rate > kStickerDuration + 1);
+	};
+	const auto runAnimation = [=](
+			QString format,
+			QSize size,
+			bool rounded,
+			float64 fps,
+			Fn<QByteArray(Animation, Fn<bool()>, bool&)> encode,
+			Fn<void(QByteArray)> done) {
+		if (state->busy) {
+			state->toast(Lower(u"Still rendering the previous file."_q));
+			return;
+		}
+		auto animation = state->renderer.prepareAnimation(
+			size,
+			rounded,
+			fps);
+		if (animation.base.isNull()) {
+			return;
+		}
+		state->busy = true;
+		state->toast(Lower(u"Rendering the %1\u2026"_q).arg(format));
+		const auto alive = state->alive;
+		crl::async([=, animation = std::move(animation)] {
+			const auto check = [=] {
+				return alive->load();
+			};
+			auto verified = true;
+			auto bytes = encode(animation, check, verified);
+			crl::on_main([=] {
+				if (!alive->load()) {
+					return;
+				}
+				state->busy = false;
+				if (bytes.isEmpty()) {
+					state->toast(
+						Lower(u"Couldn't render the %1."_q).arg(format));
+				} else if (!verified) {
+					state->toast(Lower(u"The %1 failed the self-check, "
+						"nothing was saved."_q).arg(format));
+				} else {
+					done(bytes);
+				}
+			});
+		});
+	};
+	const auto saveVideo = [=](QString format, QSize size) {
+		const auto extension = '.' + format.toLower();
+		const auto filter = (format == u"MP4"_q)
+			? u"MP4 Video (*.mp4)"_q
+			: (format == u"GIF"_q)
+			? u"GIF Image (*.gif)"_q
+			: u"WebM Video (*.webm)"_q;
+		return [=](QByteArray bytes) {
+			saveBytes(
+				bytes,
+				format + u" (%1 \u00D7 %2)"_q
+					.arg(size.width())
+					.arg(size.height()),
+				filter,
+				extension);
+		};
+	};
+	const auto modelFps = [=] {
+		return state->renderer.frameRate();
+	};
+	const auto gifFps = [=] {
+		const auto rate = modelFps();
+		return (rate > 50.) ? (rate / 2.) : rate;
+	};
+	const auto sweepRun = [=](SweepKind kind, SweepOutput output) {
+		if (!ready(false)) {
+			return;
+		}
+		const auto start = [=](QString target) {
+			if (target.isEmpty()) {
+				return;
+			}
+			auto source = SweepSource{
+				.collection = state->gift,
+				.parts = state->parts,
+				.model = state->model,
+				.backdrop = state->backdrop,
+				.symbol = state->symbol,
+				.modelJson = state->renderer.modelJson(),
+				.symbolJson = state->renderer.symbolJson(),
+				.texts = state->renderer.texts(),
+				.options = state->options,
+				.motion = state->motion,
+				.frame = state->frame,
+			};
+			state->sweep = std::make_unique<Sweep>(
+				std::move(source),
+				kind,
+				output,
+				target);
+			const auto total = state->sweep->total();
+			const auto progress = std::make_shared<
+				base::weak_ptr<Ui::Toast::Instance>>();
+			const auto cancelText = Ui::Text::Link(Lower(u"Cancel"_q));
+			const auto updateToast = [=](int done) {
+				if (const auto strong = progress->get()) {
+					strong->hideAnimated();
+				}
+				auto text = TextWithEntities{ Lower(u"Sweep: %1 of %2. "_q)
+					.arg(done)
+					.arg(total) };
+				text.append(cancelText);
+				*progress = show->showToast({
+					.text = std::move(text),
+					.filter = crl::guard(box, [=](const auto &...) {
+						state->sweep = nullptr;
+						state->toast(Lower(u"Sweep cancelled."_q));
+						return false;
+					}),
+					.duration = crl::time(60 * 1000),
+				});
+			};
+			updateToast(0);
+			state->sweep->start(crl::guard(box, [=](int done, int) {
+				updateToast(done);
+			}), crl::guard(box, [=](bool ok, QString text) {
+				if (const auto strong = progress->get()) {
+					strong->hideAnimated();
+				}
+				state->toast(text);
+				crl::on_main(box, [=] {
+					state->sweep = nullptr;
+				});
+			}));
+		};
+		if (output == SweepOutput::Folder) {
+			FileDialog::GetFolder(
+				Core::App().getFileDialogParent(),
+				Lower(u"Choose a folder"_q),
+				QString(),
+				crl::guard(box, start));
+		} else {
+			FileDialog::GetWritePath(
+				Core::App().getFileDialogParent(),
+				Lower(u"Save sheet"_q),
+				u"PNG Image (*.png);;"_q + FileDialog::AllFilesFilter(),
+				initialPath(u".png"_q),
+				crl::guard(box, start));
+		}
+	};
+	const auto addToSet = [=](bool video) {
+		if (!ready(!video)) {
+			return;
+		} else if (video && stickerTooLong()) {
+			state->toast(Lower(u"Stickers can be up to 3 seconds long: "
+				"raise the speed or shorten the frame range."_q));
+			return;
+		}
+		const auto emoji = QString::fromUtf8("\xF0\x9F\x8E\x81");
+		if (!video) {
+			auto tgs = buildTgs(false);
+			if (!tgs.bytes.isEmpty() && tgs.bytes.size() > kTgsStickerLimit) {
+				tgs = buildTgs(true);
+			}
+			if (tgs.bytes.isEmpty()) {
+				state->toast(tgs.error);
+				return;
+			}
+			showTgsReport(tgs);
+			if (const auto problem = stickerProblem(tgs); !problem.isEmpty()) {
+				state->toast(problem);
+				return;
+			}
+			const auto rate = modelFps();
+			const auto duration = std::min(
+				crl::time(base::SafeRound(
+					state->renderer.framesCount() * 1000. / rate)),
+				kStickerDuration);
+			ShowAddToStickerSet(
+				show,
+				tgs.bytes,
+				StickerKind::Tgs,
+				duration,
+				emoji);
+			state->remember();
+			return;
+		}
+		const auto size = StickerSize(state->options.canvas);
+		const auto duration = std::min(
+			crl::time(base::SafeRound(
+				state->renderer.framesCount() * 1000. / modelFps())),
+			kStickerDuration);
+		runAnimation(
+			u"WebM"_q,
+			size,
+			state->options.rounded,
+			kStickerFps,
+			[](Animation animation, Fn<bool()> alive, bool &verified) {
+				return EncodeWebm(std::move(animation), true, alive);
+			},
+			[=](QByteArray bytes) {
+				ShowAddToStickerSet(
+					show,
+					bytes,
+					StickerKind::Webm,
+					duration,
+					emoji);
+				state->remember();
+			});
+	};
+
+	fillExports({
+		{ u"Save PNG"_q, [=] {
+			if (!ready(false)) {
+				return;
+			}
+			const auto bytes = pngBytes(stillImage());
+			if (bytes.isEmpty()) {
+				state->toast(Lower(u"Couldn't render the PNG."_q));
+				return;
+			}
+			saveBytes(bytes, u"PNG"_q, u"PNG Image (*.png)"_q, u".png"_q);
+		} },
+		{ u"Copy PNG"_q, [=] {
+			if (!ready(false)) {
+				return;
+			}
+			auto image = stillImage();
+			if (image.isNull()) {
+				return;
+			}
+			auto mime = std::make_unique<QMimeData>();
+			mime->setData(u"image/png"_q, pngBytes(image));
+			mime->setImageData(std::move(image));
+			QGuiApplication::clipboard()->setMimeData(mime.release());
+			state->toast(Lower(u"Copied to clipboard."_q));
+			state->remember();
+		} },
+		{ u"Save GIF"_q, [=] {
+			if (!ready(false)) {
+				return;
+			}
+			const auto size = state->options.canvas;
+			runAnimation(
+				u"GIF"_q,
+				size,
+				state->options.rounded,
+				gifFps(),
+				[](Animation animation, Fn<bool()> alive, bool &verified) {
+					const auto gif = EncodeGif(animation, alive);
+					verified = gif.bytes.isEmpty() || VerifyGif(gif);
+					return gif.bytes;
+				},
+				saveVideo(u"GIF"_q, size));
+		} },
+		{ u"Save MP4"_q, [=] {
+			if (!ready(false)) {
+				return;
+			} else if (!VideoFormatAvailable(VideoFormat::Mp4)) {
+				state->toast(Lower(u"This build has no H.264 encoder."_q));
+				return;
+			}
+			const auto size = Mp4Size(state->options.canvas);
+			runAnimation(
+				u"MP4"_q,
+				size,
+				false,
+				modelFps(),
+				[](Animation animation, Fn<bool()> alive, bool &verified) {
+					return EncodeMp4(animation, alive);
+				},
+				saveVideo(u"MP4"_q, size));
+		} },
+		{ u"Save WebM"_q, [=] {
+			if (!ready(false)) {
+				return;
+			} else if (!VideoFormatAvailable(VideoFormat::Webm)) {
+				state->toast(Lower(u"This build has no VP9 encoder."_q));
+				return;
+			}
+			const auto sticker = (state->options.layout
+				== LayoutKind::Sticker);
+			const auto size = sticker
+				? StickerSize(state->options.canvas)
+				: Mp4Size(state->options.canvas);
+			runAnimation(
+				u"WebM"_q,
+				size,
+				state->options.rounded,
+				sticker ? kStickerFps : modelFps(),
+				[=](Animation animation, Fn<bool()> alive, bool &verified) {
+					return EncodeWebm(std::move(animation), sticker, alive);
+				},
+				saveVideo(u"WebM"_q, size));
+		} },
+		{ u"Save TGS"_q, [=] {
+			if (!ready(true)) {
+				return;
+			}
+			const auto tgs = buildTgs(false);
+			if (tgs.bytes.isEmpty()) {
+				state->toast(tgs.error);
+				return;
+			}
+			showTgsReport(tgs);
+			saveBytes(
+				tgs.bytes,
+				u"TGS"_q,
+				u"Telegram Sticker (*.tgs)"_q,
+				u".tgs"_q);
+		} },
+	});
+	const auto moreMenu = box->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	more->setClickedCallback([=] {
+		*moreMenu = base::make_unique_q<Ui::PopupMenu>(
+			more,
+			st::popupMenuWithIcons);
+		const auto menu = moreMenu->get();
+		menu->addAction(Lower(u"Add to sticker set as TGS"_q), [=] {
+			addToSet(false);
+		}, &st::menuIconStickerAdd);
+		menu->addAction(Lower(u"Add to sticker set as WebM"_q), [=] {
+			addToSet(true);
+		}, &st::menuIconStickerAdd);
+		menu->addSeparator();
+		menu->addAction(Lower(u"Sweep\u2026"_q), [=] {
+			if (state->sweep) {
+				state->toast(Lower(u"A sweep is already running."_q));
+				return;
+			}
+			show->showBox(Box(SweepBox, sweepRun));
+		}, &st::menuIconPhoto);
+		menu->addSeparator();
+		menu->addAction(Lower(u"Copy studio code"_q), [=] {
+			if (state->gift.isEmpty()) {
+				return;
+			}
+			QGuiApplication::clipboard()->setText(ComboCode(currentCombo()));
+			state->toast(Lower(u"Studio code copied: paste it into the "
+				"gift link field."_q));
+		}, &st::menuIconCopy);
+		menu->addAction(Lower(u"Save to favorites"_q), [=] {
+			if (state->gift.isEmpty()) {
+				return;
+			}
+			const auto combo = currentCombo();
+			show->showBox(Box(
+				ChooseNameBox,
+				ComboLabel(combo),
+				[=](QString name) {
+					AddFavorite({ .name = name, .combo = combo });
+					state->toast(Lower(u"Saved to favorites."_q));
+				}));
+		}, &st::menuIconFave);
+		menu->addAction(Lower(u"Favorites and history"_q), [=] {
+			show->showBox(Box(FavoritesBox, [=](Combo combo) {
+				applyCombo(combo);
+			}));
+		}, &st::menuIconArchive);
+		menu->setForcedOrigin(Ui::PanelAnimation::Origin::TopRight);
+		menu->popup(more->mapToGlobal(QPoint(
+			more->width(),
+			more->height())));
+	});
+
+	state->relayout = [=] {
+		const auto width = body->width();
+		if (width <= 0) {
+			return;
+		}
+		const auto right = column + padding;
+		panel->resizeToWidth(previewWidth);
+
+		tabs->resizeToWidth(column);
+		tabs->moveToLeft(0, 0);
+		search->resizeToWidth(column);
+		search->moveToLeft(0, tabs->height());
+		const auto controlsTop = tabs->height() + search->height();
+		const auto controls = dice->height();
+		dice->moveToLeft(column - dice->width(), controlsTop);
+		lock->moveToLeft(column - dice->width() - lock->width(), controlsTop);
+		const auto infoRight = column - dice->width() - lock->width();
+		listInfo->resizeToWidth(std::max(infoRight - padding - skip, 1));
+		listInfo->moveToLeft(
+			padding,
+			controlsTop + (controls - InnerHeight(listInfo)) / 2);
+		const auto listTop = controlsTop + controls;
+		const auto fieldsWidth = column - 2 * padding;
+		const auto halfField = (fieldsWidth - skip) / 2;
+		titleField->resizeToWidth(halfField);
+		numberField->resizeToWidth(fieldsWidth - skip - halfField);
+		linkField->resizeToWidth(fieldsWidth - skip - linkButton->width());
+		const auto fields = std::max(
+			titleField->height(),
+			numberField->height());
+		const auto linkHeight = std::max(
+			linkField->height(),
+			linkButton->height());
+		const auto below = skip + fields + skip + linkHeight + skip;
+
+		credit->resizeToNaturalWidth(width - 2 * padding);
+		const auto creditHeight = credit->height() + skip;
+		const auto minimum = listTop + kListedRows * RowHeight() + below;
+		const auto natural = std::max(
+			skip + panel->height(),
+			style::ConvertScale(kPreferredHeight));
+		const auto limit = state->maxHeight
+			? std::max(state->maxHeight - creditHeight, minimum)
+			: natural;
+		const auto height = std::clamp(natural, minimum, limit);
+
+		rightScroll->setGeometry(right, skip, width - right, height - skip);
+		const auto fieldsTop = height - below + skip;
+		titleField->moveToLeft(padding, fieldsTop);
+		numberField->moveToLeft(padding + halfField + skip, fieldsTop);
+		const auto linkTop = fieldsTop + fields + skip;
+		linkField->moveToLeft(
+			padding,
+			linkTop + linkHeight - linkField->height());
+		linkButton->moveToLeft(
+			column - padding - linkButton->width(),
+			linkTop + (linkHeight - linkButton->height()) / 2);
+		scroll->setGeometry(0, listTop, column, height - below - listTop);
+		list->resizeToWidth(column);
+
+		credit->moveToLeft((width - credit->width()) / 2, height);
+		body->resize(width, height + creditHeight);
+		body->update();
+	};
+	body->widthValue() | rpl::on_next([=] {
+		state->relayout();
+	}, body->lifetime());
+	panel->heightValue() | rpl::on_next([=] {
+		state->relayout();
+	}, panel->lifetime());
+	box->getDelegate()->contentHeightMaxValue(
+	) | rpl::on_next([=](int height) {
+		state->maxHeight = height;
+		state->relayout();
+	}, body->lifetime());
+	body->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(body);
+		p.fillRect(
+			column,
+			0,
+			st::lineWidth,
+			credit->y(),
+			st::shadowFg);
+	}, body->lifetime());
+	state->syncControls();
+	state->applyOptions();
+	state->refreshLock();
+
+	box->setFocusCallback([=] {
+		search->setInnerFocus();
+	});
+
+	state->status = Lower(u"Loading\u2026"_q);
+	RequestGifts(crl::guard(box, [=](std::vector<QString> gifts) {
+		state->gifts = std::move(gifts);
+		const auto slug = base::take(state->initialSlug);
+		state->selectGift(state->gifts.front());
+		state->refreshList(true);
+		if (!slug.isEmpty()) {
+			loadLink(slug);
+		}
+	}), crl::guard(box, [=] {
+		state->status = Lower(u"Couldn't load gifts from api.changes.tg."_q);
+		preview->update();
+	}));
+}
+
+} // namespace
+
+void ShowGiftStudio(
+		not_null<Window::SessionController*> controller,
+		const QString &slug) {
+	controller->show(Box(GiftStudioBox, controller, slug));
+}
