 		QChar(' '),
@@ -536,6 +569,57 @@ std::vector<Value> GiftListSearch::State::values(int index) const {
 	return result;
 }
 
+mtpRequestId RequestSavedUniqueGifts(
+		MTP::Sender &api,
+		not_null<PeerData*> peer,
+		const QString &offset,
+		Fn<void(SavedUniqueGiftsSlice)> done,
+		Fn<void()> fail) {
+	using Flag = MTPpayments_GetSavedStarGifts::Flag;
+	return api.request(MTPpayments_GetSavedStarGifts(
+		MTP_flags(Flag::f_exclude_unlimited
+			| Flag::f_exclude_unupgradable
+			| Flag::f_exclude_upgradable),
+		peer->input(),
+		MTP_int(0),
+		MTP_string(offset),
+		MTP_int(kPerPage)
+	)).done([=](const MTPpayments_SavedStarGifts &result) {
+		const auto &data = result.data();
+		const auto owner = &peer->owner();
+		owner->processUsers(data.vusers());
+		owner->processChats(data.vchats());
+
+		const auto &list = data.vgifts().v;
+		auto slice = SavedUniqueGiftsSlice();
+		slice.gifts.reserve(list.size());
+		for (const auto &gift : list) {
+			auto parsed = Api::FromTL(peer, gift);
+			if (parsed && parsed->info.unique) {
+				slice.gifts.push_back(std::move(*parsed));
+			}
+		}
+		slice.next = data.vnext_offset()
+			? qs(*data.vnext_offset())
+			: QString();
+		slice.last = slice.next.isEmpty() || list.isEmpty();
+		done(std::move(slice));
+	}).fail([=] {
+		fail();
+	}).send();
+}
+
+void PrefillGiftListSearch(
+		not_null<PeerData*> peer,
+		GiftListPrefill prefill) {
+	Pending() = PendingPrefill{
+		.session = &peer->session(),
+		.peerId = peer->id,
+		.prefill = std::move(prefill),
+		.time = crl::now(),
+	};
+}
