+[[nodiscard]] Json BackdropLayer(
+		int index,
+		const TgsGeometry &geometry,
+		double in,
+		double out) {
+	const auto &first = geometry.first;
+	const auto &second = geometry.second;
+	const auto stops = JsonNumbers({
+		0.,
+		first.redF(),
+		first.greenF(),
+		first.blueF(),
+		1.,
+		second.redF(),
+		second.greenF(),
+		second.blueF(),
+	});
+	const auto from = geometry.linear
+		? geometry.gradientFrom
+		: geometry.gradientCenter;
+	const auto till = geometry.linear
+		? geometry.gradientTill
+		: (geometry.gradientCenter
+			+ QPointF(geometry.gradientRadius, 0.));
+	const auto gradient = JsonObject({
+		{ "ty", JsonString("gf") },
+		{ "o", JsonStatic(JsonNumber(100.)) },
+		{ "r", JsonNumber(1.) },
+		{ "t", JsonNumber(geometry.linear ? 1. : 2.) },
+		{ "s", JsonStatic(JsonNumbers({ from.x(), from.y() })) },
+		{ "e", JsonStatic(JsonNumbers({ till.x(), till.y() })) },
+		{ "h", JsonStatic(JsonNumber(0.)) },
+		{ "a", JsonStatic(JsonNumber(0.)) },
+		{ "g", JsonObject({
+			{ "p", JsonNumber(2.) },
+			{ "k", JsonStatic(stops) },
+		}) },
+	});
+	return ShapeLayer(
+		index,
+		"backdrop",
+		{ ShapeGroup({
+			RectShape(geometry.content, geometry.radius),
+			gradient,
+		}) },
+		in,
+		out);
+}
