+Layout ComputeLayout(
+		QSizeF size,
+		const Options &options,
+		const Texts &texts) {
+	if (size.isEmpty()) {
+		return Layout();
+	}
+	auto result = Layout();
+	switch (options.layout) {
+	case LayoutKind::Cover:
+		result = ComputeCover(size, options);
+		break;
+	case LayoutKind::Tile: {
+		const auto side = float64(st::giftBoxGiftSmall);
+		const auto sticker = st::giftBoxStickerSize;
+		const auto slot = QRectF(
+			(side - sticker.width()) / 2.,
+			(side - sticker.height()) / 2.,
+			sticker.width(),
+			sticker.height());
+		result = ComputeBoxed(
+			size,
+			options,
+			QSizeF(side, side),
+			st::giftBoxGiftRadius,
+			slot,
+			Ui::PatternBgPointsSmall(),
+			QRectF(-side / 3., 0., side * 5. / 3., side),
+			side / 2.);
+	} break;
+	case LayoutKind::Card: {
+		const auto card = ComputeCard(texts, options);
+		const auto shift = card.width / 12.;
+		result = ComputeBoxed(
+			size,
+			options,
+			QSizeF(card.width, card.height),
+			card.radius,
+			card.sticker,
+			Ui::PatternBgPoints(),
+			QRectF(
+				-shift,
+				-shift,
+				card.width + 2. * shift,
+				card.height + 2. * shift),
+			card.height / 2.);
+	} break;
+	case LayoutKind::Sticker:
+		result = ComputeSticker(size, options);
+		break;
+	}
+	result.kind = options.layout;
+	result.size = size;
+	ApplyGradient(result, options);
+	return result;
+}
+
+QSize DefaultCanvas(
+		LayoutKind kind,
+		int scale,
+		const Texts &texts,
+		const Options &options) {
+	const auto factor = scale * 100. / style::Scale();
+	const auto scaled = [&](QSizeF size) {
+		return QSize(
+			std::max(int(base::SafeRound(size.width() * factor)), 1),
+			std::max(int(base::SafeRound(size.height() * factor)), 1));
+	};
+	switch (kind) {
+	case LayoutKind::Cover: {
+		const auto r = Reference();
+		return scaled(QSizeF(r.width, r.height));
+	}
+	case LayoutKind::Tile:
+		return QSize(kTileCanvas * scale, kTileCanvas * scale);
+	case LayoutKind::Sticker:
+		return QSize(kStickerCanvas * scale, kStickerCanvas * scale);
+	case LayoutKind::Card: {
+		const auto card = ComputeCard(texts, options);
+		return scaled(QSizeF(card.width, card.height));
+	}
+	}
+	return QSize(kStickerCanvas, kStickerCanvas);
+}
