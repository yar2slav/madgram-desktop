+}
+
+const QByteArray &Renderer::symbolJson() const {
+	return _symbolJson;
+}
+
+const Colors &Renderer::colors() const {
+	return _colors;
+}
+
+const Texts &Renderer::texts() const {
+	return _texts;
+}
+
+const Options &Renderer::options() const {
+	return _options;
+}
+
+const Motion &Renderer::motion() const {
+	return _motion;
+}
+
+int Renderer::modelIndex(int frame) const {
+	if (_timeline.empty()) {
+		return 0;
+	}
+	const auto count = int(_timeline.size());
+	return _timeline[((frame % count) + count) % count];
+}
+
+void Renderer::paintBackground(QPainter &p, const Layout &layout) {
+	const auto &background = _options.background;
+	if (layout.kind == LayoutKind::Sticker
+		|| background.kind == BackgroundKind::Transparent) {
+		return;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	const auto custom = (background.kind == BackgroundKind::Custom);
+	const auto first = custom ? background.first : _colors.center;
+	const auto second = custom ? background.second : _colors.edge;
+	p.setPen(Qt::NoPen);
+	if (custom && background.linear) {
+		auto gradient = QLinearGradient(
+			layout.gradientFrom,
+			layout.gradientTill);
+		gradient.setStops({ { 0., first }, { 1., second } });
+		p.setBrush(gradient);
+	} else {
+		auto gradient = QRadialGradient(
+			layout.gradientCenter,
+			layout.gradientRadius);
+		gradient.setStops({ { 0., first }, { 1., second } });
+		p.setBrush(gradient);
+	}
+	p.drawRect(layout.content);
+}
+
+void Renderer::paintPattern(QPainter &p, const Layout &layout, int ratio) {
+	if (!_symbol
+		|| layout.kind == LayoutKind::Sticker
+		|| _options.patternOpacity <= 0.) {
+		return;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	if (layout.kind != LayoutKind::Cover) {
+		auto path = QPainterPath();
+		path.addRoundedRect(layout.content, layout.radius, layout.radius);
+		p.setClipPath(path);
+	}
+	auto images = base::flat_map<int, QImage>();
+	for (const auto &point : layout.points) {
+		const auto pixels = std::max(
+			int(base::SafeRound(point.side * ratio)),
+			1);
+		auto &image = images[pixels];
+		if (image.isNull()) {
+			image = QImage(
+				QSize(pixels, pixels),
+				QImage::Format_ARGB32_Premultiplied);
+			_symbol->renderToPrepared(image, 0);
+			auto q = QPainter(&image);
+			q.setCompositionMode(QPainter::CompositionMode_SourceIn);
+			q.fillRect(QRect(QPoint(), image.size()), _colors.pattern);
+		}
+		const auto half = point.side / 2.;
+		p.setOpacity(point.opacity);
+		p.drawImage(
+			QRectF(
+				point.center.x() - half,
+				point.center.y() - half,
+				point.side,
+				point.side),
+			image);
+	}
+	p.setOpacity(1.);
+	p.setClipping(false);
+}
+
+void Renderer::paintCoverTexts(QPainter &p, const Layout &layout) {
+	const auto r = Reference();
+	const auto &text = _options.text;
+	const auto scale = std::clamp(text.scale, 0.25, 4.);
+	const auto available = std::max(int(layout.textWidth / scale), 1);
+	const auto &title = st::uniqueGiftTitle.style.font;
+	const auto &number = st::uniqueGiftNumber.style.font;
+	const auto &subtitle = st::uniqueGiftSubtitle.style.font;
+	const auto middle = r.width / 2.;
+
+	p.save();
+	p.translate(layout.origin);
+	p.scale(layout.scene, layout.scene);
+	const auto titleSource = text.title ? _texts.title : QString();
+	const auto numberSource = text.number ? _texts.number : QString();
+	const auto numberText = number->elided(numberSource, available / 2);
+	const auto numberWidth = numberText.isEmpty()
+		? 0
+		: number->width(numberText);
+	const auto gap = (numberWidth && !titleSource.isEmpty())
+		? st::normalFont->spacew
+		: 0;
+	const auto titleText = title->elided(
+		titleSource,
+		std::max(available - gap - numberWidth, 1));
+	const auto titleWidth = titleText.isEmpty() ? 0 : title->width(titleText);
+	if (titleWidth || numberWidth) {
+		p.save();
+		p.translate(middle, st::uniqueGiftTitleTop);
+		p.scale(scale, scale);
+		const auto left = -(titleWidth + gap + numberWidth) / 2.;
+		if (titleWidth) {
+			p.setFont(title->f);
+			p.setPen(QColor(255, 255, 255));
+			p.drawText(QPointF(left, title->ascent), titleText);
+		}
+		if (numberWidth) {
+			p.setFont(number->f);
+			p.setPen(_colors.text);
+			p.drawText(
+				QPointF(left + titleWidth + gap, title->ascent),
+				numberText);
+		}
+		p.restore();
+	}
+	const auto subtitleSource = !text.subtitle
+		? QString()
+		: text.customSubtitle.isEmpty()
+		? _texts.subtitle
+		: text.customSubtitle;
+	const auto subtitleText = subtitle->elided(subtitleSource, available);
+	if (!subtitleText.isEmpty()) {
+		p.save();
+		p.translate(middle, r.subtitleTop);
+		p.scale(scale, scale);
+		p.setFont(subtitle->f);
+		p.setPen(_colors.text);
+		p.drawText(
+			QPointF(-subtitle->width(subtitleText) / 2., subtitle->ascent),
+			subtitleText);
+		p.restore();
+	}
+	p.restore();
+}
+
+void Renderer::paintTileBadge(QPainter &p, const Layout &layout) {
+	if (!_options.text.number || _texts.number.isEmpty()) {
+		return;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	p.save();
+	auto path = QPainterPath();
+	path.addRoundedRect(layout.content, layout.radius, layout.radius);
+	p.setClipPath(path);
+	p.translate(layout.content.topLeft());
+	p.scale(layout.unit, layout.unit);
+	PaintRotatedBadge(
+		p,
+		QRectF(QPointF(), layout.design),
+		_texts.number,
+		st::giftBoxGiftBadgeFont,
+		st::chatUniqueGiftBadgePadding,
+		_colors.edge,
+		_colors.pattern,
+		_colors.text);
+	p.restore();
+}
+
+void Renderer::paintCardTexts(QPainter &p, const Layout &layout) {
+	const auto card = ComputeCard(_texts, _options);
+	const auto inner = card.width
+		- st::chatUniqueTextPadding.left()
+		- st::chatUniqueTextPadding.right();
+	auto hq = PainterHighQualityEnabler(p);
+	p.save();
+	auto path = QPainterPath();
+	path.addRoundedRect(layout.content, layout.radius, layout.radius);
+	p.setClipPath(path);
+	p.translate(layout.content.topLeft());
+	p.scale(layout.unit, layout.unit);
+	const auto white = QColor(255, 255, 255);
+	const auto centered = [&](
+			const style::font &font,
+			const QString &text,
+			float64 top,
+			QColor color) {
+		const auto elided = font->elided(text, int(inner));
+		p.setFont(font->f);
+		p.setPen(color);
+		p.drawText(
+			QPointF(
+				(card.width - font->width(elided)) / 2.,
+				top + font->ascent),
+			elided);
+	};
+	if (card.titleTop >= 0.) {
+		centered(
+			st::chatUniqueTitle.font,
+			CardHeadline(_texts, _options),
+			card.titleTop,
+			white);
+	}
+	if (card.textTop >= 0.) {
+		centered(
+			st::chatUniqueTextStyle.font->bold(),
+			CardName(_texts, _options),
+			card.textTop,
+			_colors.text);
+	}
+	auto rows = std::vector<std::pair<QString, QString>>{
+		{ tr::lng_gift_unique_model(tr::now), _texts.model },
+		{ tr::lng_gift_unique_symbol(tr::now), _texts.symbol },
+		{ tr::lng_gift_unique_backdrop(tr::now), _texts.backdrop },
+	};
+	if (!_texts.rarity.isEmpty() && _options.text.rarity) {
+		rows.emplace_back(Lower(u"Rarity"_q), _texts.rarity);
+	}
+	const auto &labelFont = st::chatUniqueTextStyle.font;
+	const auto valueFont = labelFont->bold();
+	auto maxLabel = 0;
+	auto maxValue = 0;
+	for (const auto &[label, value] : rows) {
+		maxLabel = std::max(maxLabel, labelFont->width(label));
+		maxValue = std::max(maxValue, valueFont->width(value));
+	}
+	const auto skip = st::chatUniqueTableSkip;
+	const auto left = float64(st::chatUniqueTextPadding.left());
+	const auto space = inner - skip;
+	const auto valueLeft = (!maxLabel || !maxValue)
+		? left
+		: (left + (float64(maxLabel) * space) / (maxLabel + maxValue) + skip);
+	const auto labelRight = valueLeft - skip;
+	auto top = card.tableTop;
+	for (const auto &[label, value] : rows) {
+		const auto labelText = labelFont->elided(
+			label,
+			std::max(int(labelRight - left), 1));
+		p.setFont(labelFont->f);
+		p.setPen(_colors.text);
+		p.drawText(
+			QPointF(
+				labelRight - labelFont->width(labelText),
+				top + labelFont->ascent),
+			labelText);
+		const auto valueText = valueFont->elided(
+			value,
+			std::max(int(card.width - left - valueLeft), 1));
+		p.setFont(valueFont->f);
+		p.setPen(white);
+		p.drawText(QPointF(valueLeft, top + valueFont->ascent), valueText);
+		top += card.rowHeight;
+	}
+	const auto button = card.button;
+	const auto radius = button.height() / 2.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(anim::with_alpha(_colors.pattern, kButtonAlpha));
+	p.drawRoundedRect(button, radius, radius);
+	const auto label = tr::lng_sticker_premium_view(tr::now);
+	const auto &font = st::semiboldFont;
+	p.setFont(font->f);
+	p.setPen(white);
+	p.drawText(
+		QPointF(
+			button.x() + (button.width() - font->width(label)) / 2.,
+			button.y() + (button.height() - font->height) / 2. + font->ascent),
+		label);
+	PaintRotatedBadge(
+		p,
+		QRectF(0., 0., card.width, card.height),
+		tr::lng_gift_collectible_tag(tr::now),
+		st::msgServiceGiftBoxBadgeFont,
+		st::chatUniqueGiftBadgePadding,
+		_colors.edge,
+		_colors.pattern,
+		_colors.text);
+	p.restore();
+}
+
+void Renderer::paintTexts(QPainter &p, const Layout &layout) {
+	switch (layout.kind) {
+	case LayoutKind::Cover: paintCoverTexts(p, layout); break;
+	case LayoutKind::Tile: paintTileBadge(p, layout); break;
+	case LayoutKind::Card: paintCardTexts(p, layout); break;
+	case LayoutKind::Sticker: break;
+	}
+}
+
+Renderer::Layers Renderer::renderLayers(QSize size, int ratio, bool rounded) {
+	auto options = _options;
+	options.rounded = rounded;
+	const auto layout = ComputeLayout(QSizeF(size), options, _texts);
+	auto result = Layers();
+	result.radius = layout.radius;
+	result.clip = layout.content;
+	result.base = QImage(size * ratio, QImage::Format_ARGB32_Premultiplied);
+	result.base.setDevicePixelRatio(ratio);
+	result.base.fill(Qt::transparent);
+	{
+		auto p = QPainter(&result.base);
+		paintBackground(p, layout);
+		paintPattern(p, layout, ratio);
+	}
+	CutRect(result.base, layout.content, layout.radius);
+	result.overlay = QImage(
+		size * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	result.overlay.setDevicePixelRatio(ratio);
+	result.overlay.fill(Qt::transparent);
+	{
+		auto p = QPainter(&result.overlay);
+		auto hq = PainterHighQualityEnabler(p);
+		paintTexts(p, layout);
+	}
+	CutRect(result.overlay, layout.content, layout.radius);
+	const auto model = layout.model;
+	result.model = QRect(
+		int(base::SafeRound(model.x() * ratio)),
+		int(base::SafeRound(model.y() * ratio)),
+		std::max(int(base::SafeRound(model.width() * ratio)), 1),
+		std::max(int(base::SafeRound(model.height() * ratio)), 1));
+	return result;
+}
+
+const QImage &Renderer::modelFrame(int frame, QSize size) {
+	const auto index = modelIndex(frame);
+	if (_frame.size() != size) {
+		_frame = QImage(size, QImage::Format_ARGB32_Premultiplied);
+		_frameIndex = -1;
+	}
+	if (_frameIndex != index) {
+		_model->renderToPrepared(_frame, index);
+		_frameIndex = index;
+	}
+	return _frame;
+}
+
+void Renderer::paint(QPainter &p, QSize size, int frame) {
+	if (!_hasColors) {
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(QRect(QPoint(), size), st::boxRadius, st::boxRadius);
+		return;
+	}
+	const auto ratio = style::DevicePixelRatio();
+	if (_preview.base.isNull() || _previewSize != size) {
+		_preview = renderLayers(size, ratio, _options.rounded);
+		_previewSize = size;
+	}
+	p.drawImage(0, 0, _preview.base);
+	if (_model) {
+		const auto rect = _preview.model;
+		p.save();
+		const auto clip = _preview.clip;
+		if (_preview.radius > 0. || clip != QRectF(QPointF(), QSizeF(size))) {
+			auto path = QPainterPath();
+			path.addRoundedRect(clip, _preview.radius, _preview.radius);
+			if (_options.layout != LayoutKind::Sticker) {
+				p.setClipPath(path);
+			}
+		}
+		p.drawImage(
+			QRectF(
+				rect.x() / float64(ratio),
+				rect.y() / float64(ratio),
+				rect.width() / float64(ratio),
+				rect.height() / float64(ratio)),
+			modelFrame(frame, rect.size()));
+		p.restore();
+	}
+	p.drawImage(0, 0, _preview.overlay);
+}
+
+QImage Renderer::renderAt(QSize size, int frame) {
+	if (!_hasColors || size.isEmpty()) {
+		return QImage();
+	}
+	auto layers = renderLayers(size, 1, _options.rounded);
+	auto result = std::move(layers.base);
+	{
+		auto p = QPainter(&result);
+		if (_model) {
+			auto storage = QImage(
+				layers.model.size(),
+				QImage::Format_ARGB32_Premultiplied);
+			_model->renderToPrepared(storage, modelIndex(frame));
+			p.drawImage(layers.model.topLeft(), storage);
+		}
+		p.drawImage(0, 0, layers.overlay);
+	}
+	if (_options.layout != LayoutKind::Sticker) {
+		CutRect(result, layers.clip, layers.radius);
+	}
+	return result;
+}
+
+QImage Renderer::render(int frame) {
+	return renderAt(_options.canvas, frame);
+}
+
+std::vector<VectorShape> Renderer::overlayShapes(QSize size) {
+	if (size.isEmpty()) {
+		return {};
+	}
+	const auto layout = ComputeLayout(QSizeF(size), _options, _texts);
+	auto device = VectorDevice(size);
+	{
+		auto p = QPainter(&device);
+		paintTexts(p, layout);
+	}
+	return device.take();
+}
+
+Animation Renderer::prepareAnimation(QSize size, bool rounded, float64 fps) {
+	if (!_hasColors || !_model || size.isEmpty()) {
+		return {};
+	}
+	auto layers = renderLayers(size, 1, rounded);
+	return {
+		.base = std::move(layers.base),
+		.overlay = std::move(layers.overlay),
+		.model = layers.model,
+		.json = _modelJson,
+		.timeline = MakeTimeline(
+			_model->framesCount(),
+			_model->frameRate(),
+			_motion,
+			(fps > 0.) ? fps : _model->frameRate()),
+		.fps = (fps > 0.) ? fps : _model->frameRate(),
+	};
+}
+
+} // namespace Tele::GiftStudio
