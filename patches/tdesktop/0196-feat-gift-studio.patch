+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kMaxFrames = 1200;
+constexpr auto kMaxSide = 4096;
+constexpr auto kMaxRings = 400;
+constexpr auto kMaxTimeline = 4000;
+constexpr auto kRingStart = 0.5;
+constexpr auto kRingStep = 0.17;
+constexpr auto kRingRatio = 0.6;
+constexpr auto kRingSpacing = 0.16;
+constexpr auto kDenseStart = 0.33;
+constexpr auto kSmall = 0.7;
+constexpr auto kLarge = 0.85;
+constexpr auto kFaded = 0.2;
+constexpr auto kOpaque = 0.3;
+constexpr auto kTileSmall = 0.45;
+constexpr auto kTileLarge = 0.55;
+constexpr auto kButtonAlpha = 0.75;
+constexpr auto kTileCanvas = 256;
+constexpr auto kStickerCanvas = 512;
+
+struct Metrics {
+	float64 width = 0.;
+	float64 height = 0.;
+	float64 modelSide = 0.;
+	float64 modelTop = 0.;
+	float64 subtitleTop = 0.;
+	float64 bottom = 0.;
+	float64 symbol = 0.;
+};
+
+[[nodiscard]] float64 SymbolSide() {
+	return Ui::Emoji::GetSizeLarge() / float64(style::DevicePixelRatio());
+}
+
+[[nodiscard]] Metrics Reference() {
+	const auto bottom = float64(st::uniqueGiftBottom);
+	const auto subtitleTop = float64(st::uniqueGiftSubtitleTop);
+	return {
+		.width = float64(st::boxWideWidth),
+		.height = (subtitleTop
+			+ st::uniqueGiftSubtitle.style.font->height
+			+ bottom),
+		.modelSide = float64(st::creditsHistoryEntryStarGiftSize),
+		.modelTop = float64(st::uniqueGiftModelTop),
+		.subtitleTop = subtitleTop,
+		.bottom = bottom,
+		.symbol = SymbolSide(),
+	};
+}
+
+struct CardMetrics {
+	float64 width = 0.;
+	float64 height = 0.;
+	float64 radius = 0.;
+	QRectF sticker;
+	float64 titleTop = -1.;
+	float64 textTop = -1.;
+	float64 tableTop = 0.;
+	int rows = 0;
+	float64 rowHeight = 0.;
+	QRectF button;
+};
+
+[[nodiscard]] QString CardHeadline(const Texts &texts, const Options &o) {
+	if (!o.text.subtitle) {
+		return QString();
+	}
+	return o.text.customSubtitle.isEmpty()
+		? tr::lng_action_gift_self_subtitle(tr::now)
+		: o.text.customSubtitle;
+}
+
+[[nodiscard]] QString CardName(const Texts &texts, const Options &o) {
+	auto parts = QStringList();
+	if (o.text.title && !texts.title.isEmpty()) {
+		parts.push_back(texts.title);
+	}
+	if (o.text.number && !texts.number.isEmpty()) {
+		parts.push_back(texts.number);
+	}
+	return parts.join(' ');
+}
+
+[[nodiscard]] CardMetrics ComputeCard(
+		const Texts &texts,
+		const Options &options) {
+	auto result = CardMetrics();
+	result.width = st::chatUniqueGiftMaxWidth;
+	result.radius = st::msgServiceGiftBoxRadius - st::chatUniqueGiftBorder;
+	const auto sticker = st::chatUniqueStickerPadding;
+	const auto side = float64(st::chatIntroStickerSize);
+	result.sticker = QRectF(
+		(result.width - side) / 2.,
+		sticker.top(),
+		side,
+		side);
+	auto top = sticker.top() + side + sticker.bottom();
+	if (!CardHeadline(texts, options).isEmpty()) {
+		top += st::chatUniqueTitlePadding.top();
+		result.titleTop = top;
+		top += st::chatUniqueTitle.font->height
+			+ st::chatUniqueTitlePadding.bottom();
+	}
+	const auto text = st::chatUniqueTextPadding;
+	if (!CardName(texts, options).isEmpty()) {
+		top += text.top();
+		result.textTop = top;
+		top += st::chatUniqueTextStyle.font->height + text.bottom();
+	}
+	result.rows = (texts.rarity.isEmpty() || !options.text.rarity) ? 3 : 4;
+	result.rowHeight = st::normalFont->height + st::chatUniqueRowSkip;
+	top += text.top();
+	result.tableTop = top;
+	top += result.rows * result.rowHeight
+		- st::chatUniqueRowSkip
+		+ text.bottom();
+	const auto button = st::chatUniqueButtonPadding;
+	const auto label = tr::lng_sticker_premium_view(tr::now);
+	const auto buttonWidth = st::semiboldFont->width(label)
+		+ st::msgServiceGiftBoxButtonHeight
+		+ st::msgServiceGiftBoxButtonPadding.left()
+		+ st::msgServiceGiftBoxButtonPadding.right();
+	top += button.top();
+	result.button = QRectF(
+		(result.width - buttonWidth) / 2.,
+		top,
+		buttonWidth,
+		st::msgServiceGiftBoxButtonHeight);
+	top += st::msgServiceGiftBoxButtonHeight + button.bottom();
+	result.height = top;
+	return result;
+}
+
+[[nodiscard]] std::unique_ptr<Lottie::Instance> MakeInstance(
+		const QByteArray &json) {
+	if (json.isEmpty()) {
+		return nullptr;
+	}
+	auto result = Lottie::Instance::Create(Lottie::ReadUtf8(json), nullptr);
+	if (!result) {
+		return nullptr;
+	}
+	const auto size = result->size();
+	const auto count = result->framesCount();
+	if (size.isEmpty()
+		|| size.width() > kMaxSide
+		|| size.height() > kMaxSide
+		|| count <= 0
+		|| count > kMaxFrames
+		|| result->frameRate() <= 0.) {
+		return nullptr;
+	}
+	return result;
+}
+
+[[nodiscard]] float64 EllipsePerimeter(float64 a, float64 b) {
+	return M_PI * (3. * (a + b) - std::sqrt((3. * a + b) * (a + 3. * b)));
+}
+
+[[nodiscard]] bool InsideEllipse(QPointF point, float64 a, float64 b) {
+	if (a <= 0. || b <= 0.) {
+		return false;
+	}
+	const auto x = point.x() / a;
+	const auto y = point.y() / b;
+	return (x * x + y * y) < 1.;
+}
+
+struct RingArgs {
+	QPointF center;
+	float64 start = 0.;
+	float64 step = 0.;
+	float64 spacing = 0.;
+	float64 ratio = kRingRatio;
+	float64 symbol = 0.;
+	QRectF visible;
+	std::optional<QRectF> exclude;
+};
+
+template <typename Add>
+void GenerateRings(const RingArgs &args, Add &&add) {
+	const auto corners = std::array{
+		args.visible.topLeft() - args.center,
+		args.visible.topRight() - args.center,
+		args.visible.bottomLeft() - args.center,
+		args.visible.bottomRight() - args.center,
+	};
+	if (args.step <= 0. || args.spacing <= 0.) {
+		return;
+	}
+	for (auto ring = 0; ring != kMaxRings; ++ring) {
+		const auto a = args.start + args.step * ring;
+		const auto b = a * args.ratio;
+		const auto enclosed = ranges::all_of(corners, [&](QPointF corner) {
+			return InsideEllipse(corner, a - args.symbol, b - args.symbol);
+		});
+		if (enclosed) {
+			break;
+		}
+		const auto count = std::max(
+			6,
+			int(base::SafeRound(EllipsePerimeter(a, b) / args.spacing)));
+		const auto step = 2. * M_PI / count;
+		const auto shift = (ring % 2) ? (step / 2.) : 0.;
+		for (auto i = 0; i != count; ++i) {
+			const auto angle = shift + i * step;
+			const auto position = args.center
+				+ QPointF(a * std::cos(angle), b * std::sin(angle));
+			if (!args.exclude || !args.exclude->contains(position)) {
+				const auto large = (i % 2) != 0;
+				add(
+					position,
+					large ? kLarge : kSmall,
+					large ? kOpaque : kFaded);
+			}
+		}
+	}
+}
+
+void ApplyGradient(Layout &result, const Options &options) {
+	const auto &background = options.background;
+	const auto content = result.content;
+	if (background.kind != BackgroundKind::Custom || !background.linear) {
+		return;
+	}
+	const auto angle = background.angle * M_PI / 180.;
+	const auto dx = std::cos(angle);
+	const auto dy = std::sin(angle);
+	const auto half = (std::abs(content.width() * dx)
+		+ std::abs(content.height() * dy)) / 2.;
+	const auto center = content.center();
+	result.gradientFrom = center - QPointF(dx, dy) * half;
+	result.gradientTill = center + QPointF(dx, dy) * half;
+}
+
+[[nodiscard]] Layout ComputeCover(QSizeF size, const Options &options) {
+	const auto r = Reference();
+	auto result = Layout();
+	const auto width = size.width();
+	const auto height = size.height();
+	const auto unit = std::min(width, height) / r.height;
+	const auto scene = unit * std::clamp(options.zoom, 0.1, 10.);
+	const auto middle = (r.modelTop + r.height - r.bottom) / 2.;
+	const auto origin = QPointF(
+		width / 2. - scene * r.width / 2.,
+		height / 2. - scene * middle);
+	const auto map = [&](QPointF point) {
+		return origin + point * scene;
+	};
+	const auto modelCenter = QPointF(
+		r.width / 2.,
+		r.modelTop + r.modelSide / 2.);
+	const auto modelSide = r.modelSide
+		* std::clamp(options.modelScale, 0.1, 10.)
+		* scene;
+	const auto center = map(modelCenter);
+
+	result.design = QSizeF(r.width, r.height);
+	result.unit = unit;
+	result.scene = scene;
+	result.origin = origin;
+	result.content = QRectF(QPointF(), size);
+	result.model = QRectF(
+		center.x() - modelSide / 2.,
+		center.y() - modelSide / 2.,
+		modelSide,
+		modelSide);
+	result.gradientCenter = QPointF(width / 2., height / 2.);
+	result.gradientRadius = unit * r.height / 2.;
+	result.radius = options.rounded ? (st::boxRadius * unit) : 0.;
+	result.textWidth = width / scene - 2. * r.bottom;
+
+	const auto visible = QRectF(
+		-origin.x() / scene,
+		-origin.y() / scene,
+		width / scene,
+		height / scene);
+	const auto opacity = options.patternOpacity;
+	const auto add = [&](QPointF position, float64 scale, float64 alpha) {
+		const auto side = r.symbol * scale;
+		const auto rect = QRectF(
+			position.x() - side / 2.,
+			position.y() - side / 2.,
+			side,
+			side);
+		if (rect.intersects(visible)) {
+			result.points.push_back({
+				.center = map(position),
+				.side = side * scene,
+				.opacity = std::min(alpha * opacity, 1.),
+			});
+		}
+	};
+	const auto density = std::clamp(options.patternDensity, 0.25, 4.);
+	if (std::abs(density - 1.) < 0.01) {
+		for (const auto &point : Ui::PatternBgPoints()) {
+			add(
+				QPointF(
+					int(point.position.x() * r.width),
+					int(point.position.y() * r.subtitleTop)),
+				point.scale,
+				point.opacity);
+		}
+		const auto cover = QRectF(0., 0., r.width, r.height);
+		if (!cover.contains(visible)) {
+			GenerateRings({
+				.center = modelCenter,
+				.start = r.width * kRingStart,
+				.step = r.width * kRingStep,
+				.spacing = r.width * kRingSpacing,
+				.symbol = r.symbol,
+				.visible = visible,
+				.exclude = cover,
+			}, add);
+		}
+	} else {
+		GenerateRings({
+			.center = modelCenter,
+			.start = r.width * kDenseStart,
+			.step = r.width * kRingStep / density,
+			.spacing = r.width * kRingSpacing / density,
+			.symbol = r.symbol,
+			.visible = visible,
+		}, add);
+	}
+	return result;
+}
+
+[[nodiscard]] Layout ComputeBoxed(
+		QSizeF size,
+		const Options &options,
+		QSizeF design,
+		float64 radius,
+		QRectF modelSlot,
+		const std::vector<Ui::PatternPoint> &points,
+		QRectF pattern,
+		float64 gradientRadius) {
+	auto result = Layout();
+	const auto unit = std::min(
+		size.width() / design.width(),
+		size.height() / design.height());
+	const auto content = QRectF(
+		(size.width() - design.width() * unit) / 2.,
+		(size.height() - design.height() * unit) / 2.,
+		design.width() * unit,
+		design.height() * unit);
+	const auto zoom = std::clamp(options.zoom, 0.1, 10.);
+	const auto pivot = modelSlot.center();
+	const auto map = [&](QPointF point) {
+		return content.topLeft() + point * unit;
+	};
+	const auto zoomed = [&](QPointF point) {
+		return map(pivot + (point - pivot) * zoom);
+	};
+	const auto modelSide = modelSlot.width()
+		* std::clamp(options.modelScale, 0.1, 10.)
+		* zoom
+		* unit;
+	const auto center = map(pivot);
+
+	result.design = design;
+	result.unit = unit;
+	result.scene = unit;
+	result.origin = content.topLeft();
+	result.content = content;
+	result.radius = radius * unit;
+	result.model = QRectF(
+		center.x() - modelSide / 2.,
+		center.y() - modelSide / 2.,
+		modelSide,
+		modelSide);
+	result.gradientCenter = content.center();
+	result.gradientRadius = gradientRadius * unit;
+	result.textWidth = design.width();
+
+	const auto symbol = SymbolSide();
+	const auto opacity = options.patternOpacity;
+	const auto visible = QRectF(
+		pivot.x() - (pivot.x() / zoom),
+		pivot.y() - (pivot.y() / zoom),
+		design.width() / zoom,
+		design.height() / zoom);
+	const auto add = [&](QPointF position, float64 scale, float64 alpha) {
+		const auto side = symbol * scale;
+		const auto rect = QRectF(
+			position.x() - side / 2.,
+			position.y() - side / 2.,
+			side,
+			side);
+		if (rect.intersects(visible)) {
+			result.points.push_back({
+				.center = zoomed(position),
+				.side = side * zoom * unit,
+				.opacity = std::min(alpha * opacity, 1.),
+			});
+		}
+	};
+	const auto density = std::clamp(options.patternDensity, 0.25, 4.);
+	if (std::abs(density - 1.) < 0.01) {
+		for (const auto &point : points) {
+			add(
+				QPointF(
+					pattern.x() + int(point.position.x() * pattern.width()),
+					pattern.y() + int(point.position.y() * pattern.height())),
+				point.scale,
+				point.opacity);
+		}
+	} else {
+		const auto base = design.width();
+		GenerateRings({
+			.center = pivot,
+			.start = modelSlot.width() * 0.75,
+			.step = base * kRingStep / density,
+			.spacing = base * kRingSpacing / density,
+			.ratio = 0.8,
+			.symbol = symbol,
+			.visible = visible,
+		}, add);
+	}
+	return result;
+}
+
+[[nodiscard]] Layout ComputeSticker(QSizeF size, const Options &options) {
+	auto result = Layout();
+	const auto design = float64(st::creditsHistoryEntryStarGiftSize);
+	const auto unit = std::min(size.width(), size.height()) / design;
+	const auto side = design
+		* unit
+		* std::clamp(options.zoom, 0.1, 10.)
+		* std::clamp(options.modelScale, 0.1, 10.);
+	result.design = QSizeF(design, design);
+	result.unit = unit;
+	result.scene = unit;
+	result.content = QRectF(QPointF(), size);
+	result.model = QRectF(
+		(size.width() - side) / 2.,
+		(size.height() - side) / 2.,
+		side,
+		side);
+	return result;
+}
+
+void PaintRotatedBadge(
+		QPainter &p,
+		QRectF content,
+		const QString &text,
+		const style::font &font,
+		QMargins padding,
+		QColor bg1,
+		QColor bg2,
+		QColor fg) {
+	if (text.isEmpty()) {
+		return;
+	}
+	const auto twidth = font->width(text) + padding.left() + padding.right();
+	const auto skip = std::ceil(twidth / M_SQRT2);
+	const auto size = twidth + font->height * 2.;
+	const auto height = padding.top() + font->height + padding.bottom();
+	p.save();
+	auto clip = QPainterPath();
+	clip.addRect(content);
+	p.setClipPath(clip, Qt::IntersectClip);
+	p.translate(content.x() + content.width() - size, content.y());
+	p.translate(size - skip, padding.top());
+	p.rotate(45.);
+	const auto rect = QRectF(-5. * twidth, 0., twidth * 12., height);
+	p.setPen(Qt::NoPen);
+	p.setBrush(bg1);
+	p.drawRect(rect);
+	if (bg2.alpha() > 0) {
+		p.setOpacity(0.5);
+		p.setBrush(bg2);
+		p.drawRect(rect);
+		p.setOpacity(1.);
+	}
+	p.setFont(font->f);
+	p.setPen(fg);
+	p.drawText(
+		QPointF(padding.left(), padding.top() + font->ascent),
+		text);
+	p.restore();
+}
