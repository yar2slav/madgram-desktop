+void AddGiftStudioAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<ChatHelpers::Show> show,
+		const std::shared_ptr<Data::UniqueGift> &unique) {
+	if (!GiftStudioMenu()
+		|| OfflineForLaunch()
+		|| !unique
+		|| unique->slug.isEmpty()) {
+		return;
+	}
+	const auto slug = unique->slug;
+	menu->addAction(Lower(u"Open in gift studio"_q), [=] {
+		if (const auto window = show->resolveWindow()) {
+			ShowGiftStudio(window, slug);
+		}
+	}, &st::menuIconPalette);
+}
