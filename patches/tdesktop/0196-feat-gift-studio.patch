+void CutRect(QImage &image, QRectF rect, float64 radius) {
+	if (image.isNull()) {
+		return;
+	}
+	const auto full = QRectF(
+		QPointF(),
+		QSizeF(image.size()) / image.devicePixelRatio());
+	if (rect.contains(full) && radius <= 0.) {
+		return;
+	}
+	auto outer = QPainterPath();
+	outer.addRect(full);
+	auto inner = QPainterPath();
+	inner.addRoundedRect(rect, radius, radius);
+	auto p = QPainter(&image);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setCompositionMode(QPainter::CompositionMode_DestinationOut);
+	p.fillPath(outer.subtracted(inner), QColor(0, 0, 0));
+}
+
+void CutCorners(QImage &image, float64 radius) {
+	if (radius <= 0. || image.isNull()) {
+		return;
+	}
+	CutRect(
+		image,
+		QRectF(QPointF(), QSizeF(image.size()) / image.devicePixelRatio()),
+		radius);
+}
