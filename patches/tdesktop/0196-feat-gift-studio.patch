+
+void PickerList::mouseReleaseEvent(QMouseEvent *e) {
+	const auto pressed = std::exchange(_pressed, -1);
+	if (pressed >= 0 && pressed == rowAt(e->pos())) {
+		_chosen.fire_copy(_rows[pressed].index);
+	}
+}
+
+void PickerList::leaveEventHook(QEvent *e) {
+	setOver(-1);
+}
