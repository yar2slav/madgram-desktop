@@ -0,0 +1,373 @@
+#include "tele/tele_gift_studio_store.h"
+
+#include "settings.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QSaveFile>
+#include <QtCore/QUrl>
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kPrefix = "tg://tele_giftstudio?";
+constexpr auto kMarker = "tele_giftstudio?";
+constexpr auto kFavoritesLimit = 200;
+constexpr auto kMaxFile = 1024 * 1024;
+constexpr auto kHideTitle = 1;
+constexpr auto kHideNumber = 2;
+constexpr auto kHideSubtitle = 4;
+constexpr auto kHideRarity = 8;
+constexpr auto kHideTgsText = 16;
+
+struct Store {
+	bool loaded = false;
+	std::vector<Favorite> favorites;
+	std::vector<Combo> history;
+	base::flat_set<QString> expanded;
+	rpl::event_stream<> changes;
+};
+
+[[nodiscard]] Store &Data() {
+	static auto result = Store();
+	return result;
+}
+
+[[nodiscard]] QString FilePath() {
+	return cWorkingDir() + u"tdata/tele_gift_studio.json"_q;
+}
+
+[[nodiscard]] QString LayoutName(LayoutKind kind) {
+	switch (kind) {
+	case LayoutKind::Cover: return u"cover"_q;
+	case LayoutKind::Tile: return u"tile"_q;
+	case LayoutKind::Sticker: return u"sticker"_q;
+	case LayoutKind::Card: return u"card"_q;
+	}
+	return u"cover"_q;
+}
+
+[[nodiscard]] LayoutKind ParseLayout(const QString &name) {
+	return (name == u"tile"_q)
+		? LayoutKind::Tile
+		: (name == u"sticker"_q)
+		? LayoutKind::Sticker
+		: (name == u"card"_q)
+		? LayoutKind::Card
+		: LayoutKind::Cover;
+}
+
+[[nodiscard]] QString Hex(const QColor &color) {
+	return color.name(QColor::HexRgb).mid(1);
+}
+
+[[nodiscard]] int Percent(float64 value) {
+	return int(base::SafeRound(value * 100.));
+}
+
+void Save() {
+	auto &data = Data();
+	auto favorites = QJsonArray();
+	for (const auto &favorite : data.favorites) {
+		favorites.append(QJsonObject{
+			{ u"name"_q, favorite.name },
+			{ u"code"_q, ComboCode(favorite.combo) },
+		});
+	}
+	auto history = QJsonArray();
+	for (const auto &combo : data.history) {
+		history.append(ComboCode(combo));
+	}
+	auto expanded = QJsonArray();
+	for (const auto &id : data.expanded) {
+		expanded.append(id);
+	}
+	const auto bytes = QJsonDocument(QJsonObject{
+		{ u"favorites"_q, favorites },
+		{ u"history"_q, history },
+		{ u"expanded"_q, expanded },
+	}).toJson(QJsonDocument::Compact);
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	auto file = QSaveFile(FilePath());
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(bytes);
+		file.commit();
+	}
+	data.changes.fire({});
+}
+
+void Load() {
+	auto &data = Data();
+	if (data.loaded) {
+		return;
+	}
+	data.loaded = true;
+	auto file = QFile(FilePath());
+	if (!file.open(QIODevice::ReadOnly) || file.size() > kMaxFile) {
+		return;
+	}
+	const auto object = QJsonDocument::fromJson(file.readAll()).object();
+	for (const auto &value : object.value(u"favorites"_q).toArray()) {
+		const auto entry = value.toObject();
+		if (const auto combo = ParseComboCode(
+				entry.value(u"code"_q).toString())) {
+			data.favorites.push_back({
+				.name = entry.value(u"name"_q).toString(),
+				.combo = *combo,
+			});
+		}
+	}
+	for (const auto &value : object.value(u"history"_q).toArray()) {
+		if (const auto combo = ParseComboCode(value.toString())) {
+			data.history.push_back(*combo);
+		}
+	}
+	for (const auto &value : object.value(u"expanded"_q).toArray()) {
+		const auto id = value.toString();
+		if (!id.isEmpty()) {
+			data.expanded.emplace(id);
+		}
+	}
+	if (int(data.history.size()) > kHistoryLimit) {
+		data.history.resize(kHistoryLimit);
+	}
+}
+
+[[nodiscard]] bool SameParts(const Combo &a, const Combo &b) {
+	return (ComboCode(a) == ComboCode(b));
+}
+
+} // namespace
+
+QString ComboCode(const Combo &combo) {
+	auto query = QStringList();
+	const auto add = [&](const QString &key, const QString &value) {
+		query.push_back(key
+			+ '='
+			+ QString::fromLatin1(QUrl::toPercentEncoding(value)));
+	};
+	const auto number = [&](const QString &key, int value, int fallback) {
+		if (value != fallback) {
+			add(key, QString::number(value));
+		}
+	};
+	add(u"c"_q, combo.collection);
+	add(u"m"_q, combo.model);
+	add(u"b"_q, combo.backdrop);
+	add(u"s"_q, combo.symbol);
+	if (!combo.title.isEmpty()) {
+		add(u"t"_q, combo.title);
+	}
+	if (!combo.number.isEmpty()) {
+		add(u"n"_q, combo.number);
+	}
+	const auto &o = combo.options;
+	if (o.layout != LayoutKind::Cover) {
+		add(u"l"_q, LayoutName(o.layout));
+	}
+	if (!o.canvas.isEmpty()) {
+		add(u"w"_q, QString::number(o.canvas.width()));
+		add(u"h"_q, QString::number(o.canvas.height()));
+	}
+	number(u"ms"_q, Percent(o.modelScale), 100);
+	number(u"z"_q, Percent(o.zoom), 100);
+	number(u"r"_q, o.rounded ? 1 : 0, 0);
+	const auto &bg = o.background;
+	if (bg.kind == BackgroundKind::Custom) {
+		add(u"bg"_q, u"custom"_q);
+		add(u"c1"_q, Hex(bg.first));
+		add(u"c2"_q, Hex(bg.second));
+		number(u"lin"_q, bg.linear ? 1 : 0, 0);
+		number(u"a"_q, bg.angle, 90);
+	} else if (bg.kind == BackgroundKind::Transparent) {
+		add(u"bg"_q, u"none"_q);
+	}
+	number(u"po"_q, Percent(o.patternOpacity), 100);
+	number(u"pd"_q, Percent(o.patternDensity), 100);
+	const auto hidden = (o.text.title ? 0 : kHideTitle)
+		| (o.text.number ? 0 : kHideNumber)
+		| (o.text.subtitle ? 0 : kHideSubtitle)
+		| (o.text.rarity ? 0 : kHideRarity)
+		| (o.text.tgs ? 0 : kHideTgsText);
+	number(u"ht"_q, hidden, 0);
+	if (!o.text.customSubtitle.isEmpty()) {
+		add(u"st"_q, o.text.customSubtitle);
+	}
+	number(u"ts"_q, Percent(o.text.scale), 100);
+	const auto &m = combo.motion;
+	number(u"sp"_q, Percent(m.speed), 100);
+	number(u"f0"_q, m.from, 0);
+	number(u"f1"_q, m.till, -1);
+	number(u"pp"_q, m.pingPong ? 1 : 0, 0);
+	return QString::fromLatin1(kPrefix) + query.join('&');
+}
+
+std::optional<Combo> ParseComboCode(const QString &text) {
+	const auto trimmed = text.trimmed();
+	const auto marker = QString::fromLatin1(kMarker);
+	const auto position = trimmed.indexOf(marker);
+	if (position < 0) {
+		return std::nullopt;
+	}
+	auto values = base::flat_map<QString, QString>();
+	const auto query = trimmed.mid(position + marker.size());
+	for (const auto &pair : query.split('&', Qt::SkipEmptyParts)) {
+		const auto equal = pair.indexOf('=');
+		if (equal > 0) {
+			values[pair.left(equal)] = QUrl::fromPercentEncoding(
+				pair.mid(equal + 1).toLatin1());
+		}
+	}
+	const auto value = [&](const QString &key) {
+		const auto i = values.find(key);
+		return (i != end(values)) ? i->second : QString();
+	};
+	const auto integer = [&](const QString &key, int fallback) {
+		auto ok = false;
+		const auto result = value(key).toInt(&ok);
+		return ok ? result : fallback;
+	};
+	const auto percent = [&](const QString &key, float64 min, float64 max) {
+		return std::clamp(integer(key, 100) / 100., min, max);
+	};
+	auto result = Combo{
+		.collection = value(u"c"_q),
+		.model = value(u"m"_q),
+		.backdrop = value(u"b"_q),
+		.symbol = value(u"s"_q),
+		.title = value(u"t"_q),
+		.number = value(u"n"_q),
+	};
+	if (result.collection.isEmpty()) {
+		return std::nullopt;
+	}
+	auto &o = result.options;
+	o.layout = ParseLayout(value(u"l"_q));
+	const auto width = integer(u"w"_q, 0);
+	const auto height = integer(u"h"_q, 0);
+	if (width >= 16 && height >= 16 && width <= 4096 && height <= 4096) {
+		o.canvas = QSize(width, height);
+	}
+	o.modelScale = percent(u"ms"_q, 0.1, 10.);
+	o.zoom = percent(u"z"_q, 0.1, 10.);
+	o.rounded = (integer(u"r"_q, 0) != 0);
+	const auto bg = value(u"bg"_q);
+	if (bg == u"custom"_q) {
+		o.background.kind = BackgroundKind::Custom;
+		const auto first = QColor('#' + value(u"c1"_q));
+		const auto second = QColor('#' + value(u"c2"_q));
+		if (first.isValid()) {
+			o.background.first = first;
+		}
+		if (second.isValid()) {
+			o.background.second = second;
+		}
+		o.background.linear = (integer(u"lin"_q, 0) != 0);
+		o.background.angle = std::clamp(integer(u"a"_q, 90), 0, 360);
+	} else if (bg == u"none"_q) {
+		o.background.kind = BackgroundKind::Transparent;
+	}
+	o.patternOpacity = percent(u"po"_q, 0., 4.);
+	o.patternDensity = percent(u"pd"_q, 0.25, 4.);
+	const auto hidden = integer(u"ht"_q, 0);
+	o.text.title = !(hidden & kHideTitle);
+	o.text.number = !(hidden & kHideNumber);
+	o.text.subtitle = !(hidden & kHideSubtitle);
+	o.text.rarity = !(hidden & kHideRarity);
+	o.text.tgs = !(hidden & kHideTgsText);
+	o.text.customSubtitle = value(u"st"_q);
+	o.text.scale = percent(u"ts"_q, 0.25, 4.);
+	auto &m = result.motion;
+	m.speed = percent(u"sp"_q, 0.05, 20.);
+	m.from = std::max(integer(u"f0"_q, 0), 0);
+	m.till = integer(u"f1"_q, -1);
+	m.pingPong = (integer(u"pp"_q, 0) != 0);
+	return result;
+}
+
+QString ComboLabel(const Combo &combo) {
+	auto result = combo.collection;
+	if (!combo.number.isEmpty()) {
+		result += u" #"_q + combo.number;
+	}
+	return result + u" \u00B7 "_q + QStringList{
+		combo.model,
+		combo.backdrop,
+		combo.symbol,
+	}.join(u", "_q);
+}
+
+const std::vector<Favorite> &Favorites() {
+	Load();
+	return Data().favorites;
+}
+
+const std::vector<Combo> &History() {
+	Load();
+	return Data().history;
+}
+
+void AddFavorite(Favorite favorite) {
+	Load();
+	auto &list = Data().favorites;
+	list.insert(begin(list), std::move(favorite));
+	if (int(list.size()) > kFavoritesLimit) {
+		list.resize(kFavoritesLimit);
+	}
+	Save();
+}
+
+void RemoveFavorite(int index) {
+	Load();
+	auto &list = Data().favorites;
+	if (index >= 0 && index < int(list.size())) {
+		list.erase(begin(list) + index);
+		Save();
+	}
+}
+
+void AddHistory(Combo combo) {
+	Load();
+	auto &list = Data().history;
+	list.erase(ranges::remove_if(list, [&](const Combo &entry) {
+		return SameParts(entry, combo);
+	}), end(list));
+	list.insert(begin(list), std::move(combo));
+	if (int(list.size()) > kHistoryLimit) {
+		list.resize(kHistoryLimit);
+	}
+	Save();
+}
+
+void ClearHistory() {
+	Load();
+	Data().history.clear();
+	Save();
+}
+
+rpl::producer<> StoreChanges() {
+	return Data().changes.events();
+}
+
+bool SectionExpanded(const QString &id) {
+	Load();
+	return Data().expanded.contains(id);
+}
+
+void SetSectionExpanded(const QString &id, bool expanded) {
+	Load();
+	auto &set = Data().expanded;
+	if (expanded == set.contains(id)) {
+		return;
+	} else if (expanded) {
+		set.emplace(id);
+	} else {
+		set.remove(id);
+	}
+	Save();
+}
+
+} // namespace Tele::GiftStudio
