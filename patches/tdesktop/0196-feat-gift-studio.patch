+QColor BackgroundEdge(const Options &options, const Colors &colors) {
+	switch (options.background.kind) {
+	case BackgroundKind::Backdrop: return colors.edge;
+	case BackgroundKind::Custom: return options.background.second;
+	case BackgroundKind::Transparent: return QColor(0, 0, 0, 0);
+	}
+	return colors.edge;
+}
