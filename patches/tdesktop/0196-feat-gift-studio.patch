+void SweepBox(
+		not_null<Ui::GenericBox*> box,
+		Fn<void(SweepKind, SweepOutput)> start) {
+	box->setTitle(rpl::single(Lower(u"Sweep"_q)));
+	const auto kind = std::make_shared<Ui::RadioenumGroup<SweepKind>>(
+		SweepKind::Backdrops);
+	const auto output = std::make_shared<Ui::RadioenumGroup<SweepOutput>>(
+		SweepOutput::Sheet);
+	const auto radio = [&](auto group, auto value, const QString &text) {
+		box->addRow(object_ptr<Ui::Radioenum<decltype(value)>>(
+			box,
+			group,
+			value,
+			Lower(text),
+			st::defaultBoxCheckbox));
+	};
+	Ui::AddSubsectionTitle(
+		box->verticalLayout(),
+		rpl::single(Lower(u"Render"_q)));
+	radio(kind, SweepKind::Backdrops, u"This model with every backdrop"_q);
+	radio(kind, SweepKind::Symbols, u"This model with every symbol"_q);
+	radio(kind, SweepKind::Models, u"Every model with this backdrop"_q);
+	Ui::AddSkip(box->verticalLayout());
+	Ui::AddSubsectionTitle(
+		box->verticalLayout(),
+		rpl::single(Lower(u"Save as"_q)));
+	radio(output, SweepOutput::Sheet, u"One contact sheet PNG"_q);
+	radio(output, SweepOutput::Folder, u"A folder of PNGs"_q);
+	box->addButton(rpl::single(Lower(u"Start"_q)), [=] {
+		const auto chosenKind = kind->current();
+		const auto chosenOutput = output->current();
+		box->closeBox();
+		start(chosenKind, chosenOutput);
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
