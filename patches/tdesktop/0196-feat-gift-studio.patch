+		const auto entry = [&](
+				const QString &title,
+				const Combo &combo,
+				Fn<void()> remove) {
+			const auto button = list->add(object_ptr<Ui::SettingsButton>(
+				list,
+				rpl::single(title),
+				st::settingsButtonNoIcon));
+			button->setClickedCallback([=] {
+				apply(combo);
+				box->closeBox();
+			});
+			if (remove) {
+				const auto cross = Ui::CreateChild<Ui::IconButton>(
+					button,
+					st::boxTitleClose);
+				button->widthValue() | rpl::on_next([=](int width) {
+					cross->moveToRight(
+						0,
+						(button->height() - cross->height()) / 2,
+						width);
+				}, cross->lifetime());
+				cross->setClickedCallback(remove);
+			}
+			auto details = object_ptr<Ui::FlatLabel>(
+				list,
+				ComboLabel(combo),
+				st::boxDividerLabel);
+			list->add(std::move(details), st::boxRowPadding);
+		};
+		Ui::AddSubsectionTitle(list, rpl::single(Lower(u"Favorites"_q)));
+		const auto &favorites = Favorites();
+		if (favorites.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"Nothing saved yet."_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		for (auto i = 0; i != int(favorites.size()); ++i) {
+			entry(favorites[i].name, favorites[i].combo, [=] {
+				RemoveFavorite(i);
+			});
+		}
+		Ui::AddSkip(list);
+		Ui::AddSubsectionTitle(list, rpl::single(Lower(u"History"_q)));
+		const auto &history = History();
+		if (history.empty()) {
+			list->add(
+				object_ptr<Ui::FlatLabel>(
+					list,
+					Lower(u"Exports show up here."_q),
+					st::boxDividerLabel),
+				st::boxRowPadding);
+		}
+		for (const auto &combo : history) {
+			entry(combo.collection, combo, nullptr);
+		}
+		list->resizeToWidth(content->width());
+	};
+	fill();
+	StoreChanges() | rpl::on_next([=] {
+		crl::on_main(list, fill);
+	}, list->lifetime());
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+	box->addLeftButton(rpl::single(Lower(u"Clear history"_q)), [=] {
+		ClearHistory();
+	});
+}
