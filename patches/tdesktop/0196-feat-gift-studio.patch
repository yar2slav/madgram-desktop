+class TgsUpload final : public base::has_weak_ptr {
+public:
+	TgsUpload(
+		not_null<Main::Session*> session,
+		StickerSetIdentifier set,
+		QByteArray bytes,
+		QString emoji);
+	~TgsUpload();
+
+	void start(
+		Fn<void(MTPmessages_StickerSet)> done,
+		Fn<void(QString)> fail,
+		Fn<void(int)> progress);
+	void cancel();
+
+private:
+	void uploadReady(const MTPInputFile &file);
+	void uploadProgressed();
+	void requestAddSticker(const MTPInputDocument &document);
+	void finishWithError(const QString &type);
+
+	const not_null<Main::Session*> _session;
+	const StickerSetIdentifier _set;
+	const QByteArray _bytes;
+	const QString _emoji;
+	MTP::Sender _api;
+	rpl::lifetime _uploadLifetime;
+	FullMsgId _uploadId;
+	DocumentId _documentId = 0;
+	mtpRequestId _requestId = 0;
+	int _lastPercent = -1;
+
+	Fn<void(MTPmessages_StickerSet)> _done;
+	Fn<void(QString)> _fail;
+	Fn<void(int)> _progress;
+
+};
+
+TgsUpload::TgsUpload(
+	not_null<Main::Session*> session,
+	StickerSetIdentifier set,
+	QByteArray bytes,
+	QString emoji)
+: _session(session)
+, _set(std::move(set))
+, _bytes(std::move(bytes))
+, _emoji(std::move(emoji))
+, _api(&session->mtp()) {
+}
+
+TgsUpload::~TgsUpload() {
+	cancel();
+}
+
+void TgsUpload::start(
+		Fn<void(MTPmessages_StickerSet)> done,
+		Fn<void(QString)> fail,
+		Fn<void(int)> progress) {
+	Expects(!_uploadId);
+
+	_done = std::move(done);
+	_fail = std::move(fail);
+	_progress = std::move(progress);
+
+	_documentId = base::RandomValue<DocumentId>();
+	auto ready = PrepareTgsFile(
+		_session->mtp().mainDcId(),
+		_documentId,
+		_bytes);
+	_uploadId = FullMsgId(
+		_session->userPeerId(),
+		_session->data().nextLocalMessageId());
+
+	const auto document = _session->data().document(_documentId);
+	document->uploadingData = std::make_unique<Data::UploadState>(
+		int64(_bytes.size()));
+
+	auto &uploader = _session->uploader();
+	uploader.documentReady(
+	) | rpl::filter([=](const Storage::UploadedMedia &data) {
+		return data.fullId == _uploadId;
+	}) | rpl::on_next([=](const Storage::UploadedMedia &data) {
+		uploadReady(data.info.file);
+	}, _uploadLifetime);
+
+	uploader.documentFailed(
+	) | rpl::filter([=](const FullMsgId &id) {
+		return id == _uploadId;
+	}) | rpl::on_next([=] {
+		finishWithError(QString());
+	}, _uploadLifetime);
+
+	uploader.documentProgress(
+	) | rpl::filter([=](const FullMsgId &id) {
+		return id == _uploadId;
+	}) | rpl::on_next([=] {
+		uploadProgressed();
+	}, _uploadLifetime);
+
+	uploader.upload(_uploadId, ready);
+}
+
+void TgsUpload::cancel() {
+	if (_uploadId) {
+		_session->uploader().cancel(_uploadId);
+		_uploadId = FullMsgId();
+	}
+	if (_requestId) {
+		_api.request(base::take(_requestId)).cancel();
+	}
+	_uploadLifetime.destroy();
+	_done = nullptr;
+	_fail = nullptr;
+	_progress = nullptr;
+}
+
+void TgsUpload::finishWithError(const QString &type) {
+	const auto fail = std::move(_fail);
+	cancel();
+	if (fail) {
+		fail(type);
+	}
+}
+
+void TgsUpload::uploadProgressed() {
+	if (!_progress) {
+		return;
+	}
+	const auto document = _session->data().document(_documentId);
+	if (!document->uploading() || !document->uploadingData) {
+		return;
+	}
+	const auto size = document->uploadingData->size;
+	if (size <= 0) {
+		return;
+	}
+	const auto percent = int(
+		(document->uploadingData->offset * 100) / size);
+	if (percent != _lastPercent) {
+		_lastPercent = percent;
+		_progress(percent);
+	}
+}
+
+void TgsUpload::uploadReady(const MTPInputFile &file) {
+	_uploadLifetime.destroy();
+	_uploadId = FullMsgId();
+
+	auto attributes = QVector<MTPDocumentAttribute>{
+		MTP_documentAttributeSticker(
+			MTP_flags(0),
+			MTP_string(_emoji),
+			MTP_inputStickerSetEmpty(),
+			MTPMaskCoords()),
+		TgsSizeAttribute(),
+		TgsFilenameAttribute(),
+	};
+	const auto media = MTP_inputMediaUploadedDocument(
+		MTP_flags(0),
+		file,
+		MTPInputFile(),
+		MTP_string(TgsMime()),
+		MTP_vector<MTPDocumentAttribute>(std::move(attributes)),
+		MTP_vector<MTPInputDocument>(),
+		MTPInputPhoto(),
+		MTP_int(0),
+		MTP_int(0));
+
+	_requestId = _api.request(MTPmessages_UploadMedia(
+		MTP_flags(0),
+		MTPstring(),
+		MTP_inputPeerSelf(),
+		media
+	)).done(crl::guard(this, [=](const MTPMessageMedia &result) {
+		_requestId = 0;
+		auto input = std::optional<MTPInputDocument>();
+		result.match([&](const MTPDmessageMediaDocument &data) {
+			if (const auto document = data.vdocument()) {
+				document->match([&](const MTPDdocument &fields) {
+					input = MTP_inputDocument(
+						fields.vid(),
+						fields.vaccess_hash(),
+						fields.vfile_reference());
+				}, [](const auto &) {
+				});
+			}
+		}, [](const auto &) {
+		});
+		if (input) {
+			requestAddSticker(*input);
+		} else {
+			finishWithError(QString());
+		}
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		finishWithError(error.type());
+	})).handleFloodErrors().send();
+}
+
+void TgsUpload::requestAddSticker(const MTPInputDocument &document) {
+	_requestId = _api.request(MTPstickers_AddStickerToSet(
+		Data::InputStickerSet(_set),
+		MTP_inputStickerSetItem(
+			MTP_flags(0),
+			document,
+			MTP_string(_emoji),
+			MTPMaskCoords(),
+			MTPstring()))
+	).done(crl::guard(this, [=](const MTPmessages_StickerSet &result) {
+		_requestId = 0;
+		FeedSet(_session, result);
+		const auto done = std::move(_done);
+		cancel();
+		if (done) {
+			done(result);
+		}
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		finishWithError(error.type());
+	})).handleFloodErrors().send();
+}
+
+struct SetsLoader {
+	std::vector<OwnedSet> sets;
+	Fn<void(std::vector<OwnedSet>)> done;
+	Fn<void(QString)> fail;
+};
+
+[[nodiscard]] std::optional<OwnedSet> ParseOwnedSet(
+		const MTPStickerSetCovered &covered) {
+	const auto &set = covered.match([](const auto &data) -> decltype(auto) {
+		return data.vset();
+	});
+	const auto &data = set.data();
+	if (data.is_masks() || data.is_emojis()) {
+		return std::nullopt;
+	}
+	return OwnedSet{
+		.identifier = StickerSetIdentifier{
+			.id = data.vid().v,
+			.accessHash = data.vaccess_hash().v,
+			.shortName = qs(data.vshort_name()),
+		},
+		.title = qs(data.vtitle()),
+		.count = data.vcount().v,
+	};
+}
+
+void RequestOwnedSets(
+		not_null<Main::Session*> session,
+		std::shared_ptr<SetsLoader> loader,
+		uint64 offsetId,
+		int seen) {
+	session->api().request(MTPmessages_GetMyStickers(
+		MTP_long(offsetId),
+		MTP_int(kSetsPerPage)
+	)).done([=](const MTPmessages_MyStickers &result) {
+		const auto &data = result.data();
+		const auto &list = data.vsets().v;
+		auto lastId = uint64(0);
+		for (const auto &covered : list) {
+			covered.match([&](const auto &fields) {
+				lastId = fields.vset().data().vid().v;
+			});
+			if (auto parsed = ParseOwnedSet(covered)) {
+				loader->sets.push_back(std::move(*parsed));
+			}
+		}
+		const auto total = seen + int(list.size());
+		const auto more = !list.isEmpty()
+			&& (lastId != offsetId)
+			&& (total < data.vcount().v);
+		if (more) {
+			RequestOwnedSets(session, loader, lastId, total);
+		} else {
+			const auto done = base::take(loader->done);
+			loader->fail = nullptr;
+			done(base::take(loader->sets));
+		}
+	}).fail([=](const MTP::Error &error) {
+		const auto fail = base::take(loader->fail);
+		loader->done = nullptr;
+		fail(error.type());
+	}).send();
+}
+
+[[nodiscard]] QString KilobytesText(int bytes) {
+	return QString::number((bytes + 1023) / 1024);
+}
+
+[[nodiscard]] QString ErrorText(const QString &type) {
+	const auto reason = [&] {
+		if (type == u"STICKERPACK_STICKERS_TOO_MUCH"_q) {
+			return Lower(u"This set is full"_q);
+		} else if (type == u"STICKER_TGS_NOTGS"_q
+			|| type == u"STICKER_TGS_NODOC"_q) {
+			return Lower(u"Telegram didn't accept this TGS file"_q);
+		} else if (type == u"STICKER_VIDEO_LONG"_q) {
+			return Lower(u"Video stickers can be up to 3 seconds"_q);
+		} else if (type == u"STICKER_VIDEO_BIG"_q
+			|| type == u"STICKER_FILE_INVALID"_q
+			|| type == u"STICKER_VIDEO_NOWEBM"_q) {
+			return Lower(u"Telegram didn't accept this WebM file"_q);
+		} else if (type == u"STICKER_EMOJI_INVALID"_q) {
+			return Lower(u"This emoji can't be used for a sticker"_q);
+		} else if (type == u"STICKERSET_INVALID"_q) {
+			return Lower(u"This sticker set wasn't found"_q);
+		}
+		return Lower(u"Couldn't add the sticker"_q);
+	}();
+	return type.isEmpty()
+		? reason
+		: (reason + u" ("_q + type + u")"_q);
+}
+
+struct BoxState {
+	std::unique_ptr<Api::StickerUpload> webm;
+	std::unique_ptr<TgsUpload> tgs;
+	std::vector<not_null<Ui::SettingsButton*>> buttons;
+	base::weak_ptr<Ui::Toast::Instance> toast;
+	rpl::variable<QString> status;
+	bool uploading = false;
+};
+
+void HideToast(const base::weak_ptr<Ui::Toast::Instance> &toast) {
+	if (const auto strong = toast.get()) {
+		strong->hideAnimated();
+	}
+}
+
+void ShowAddedToast(
+		std::shared_ptr<ChatHelpers::Show> show,
+		const OwnedSet &set) {
+	const auto identifier = set.identifier;
+	const auto url = u"https://t.me/addstickers/"_q
+		+ identifier.shortName;
+	auto text = TextWithEntities{ Lower(u"Sticker added to "_q) };
+	text.append(Ui::Text::Link(set.title, url));
+	const auto toast = std::make_shared<
+		base::weak_ptr<Ui::Toast::Instance>>();
+	*toast = show->showToast({
+		.text = std::move(text),
+		.filter = [=](const ClickHandlerPtr &, Qt::MouseButton button) {
+			if (button != Qt::LeftButton) {
+				return true;
+			}
+			HideToast(*toast);
+			show->show(Box<StickerSetBox>(
+				show,
+				identifier,
+				Data::StickersType::Stickers));
+			return false;
+		},
+		.duration = Ui::Toast::kDefaultDuration * 3,
+	});
+}
+
+void StartUpload(
+		not_null<Ui::GenericBox*> box,
+		not_null<BoxState*> state,
+		std::shared_ptr<ChatHelpers::Show> show,
+		const OwnedSet &set,
+		const QByteArray &bytes,
+		StickerKind kind,
+		crl::time duration,
+		const QString &emoji) {
+	if (state->uploading) {
+		return;
+	}
+	state->uploading = true;
+	for (const auto button : state->buttons) {
+		button->setDisabled(true);
+	}
+	const auto session = &show->session();
+	const auto weak = base::make_weak(box);
+	const auto title = set.title;
+	state->status = Lower(u"Uploading to %1"_q).arg(title);
+	state->toast = show->showToast({
+		.text = { Lower(u"Uploading the sticker to %1"_q).arg(title) },
+		.infinite = true,
+	});
+
+	const auto finish = [=] {
+		state->uploading = false;
+		HideToast(state->toast);
+	};
+	auto done = [=](MTPmessages_StickerSet) {
+		finish();
+		ShowAddedToast(show, set);
+		if (const auto strong = weak.get()) {
+			strong->closeBox();
+		}
+	};
+	auto fail = [=](QString type) {
+		finish();
+		show->showToast(ErrorText(type));
+		state->status = Lower(u"Choose a set"_q);
+		for (const auto button : state->buttons) {
+			button->setDisabled(false);
+		}
+	};
+	auto progress = [=](int percent) {
+		state->status = Lower(u"Uploading to %1, %2%"_q).arg(
+			title,
+			QString::number(percent));
+	};
+	if (kind == StickerKind::Tgs) {
+		state->tgs = std::make_unique<TgsUpload>(
+			session,
+			set.identifier,
+			bytes,
+			emoji);
+		state->tgs->start(
+			std::move(done),
+			std::move(fail),
+			std::move(progress));
+	} else {
+		state->webm = std::make_unique<Api::StickerUpload>(
+			session,
+			set.identifier,
+			bytes,
+			QSize(kStickerSide, kStickerSide),
+			emoji,
+			Data::StickersType::Stickers,
+			std::max(duration, crl::time(1)));
+		state->webm->start(
+			std::move(done),
+			std::move(fail),
+			std::move(progress));
+	}
+}
+
+void ChooseSetBox(
+		not_null<Ui::GenericBox*> box,
+		std::shared_ptr<ChatHelpers::Show> show,
+		std::vector<OwnedSet> sets,
+		QByteArray bytes,
+		StickerKind kind,
+		crl::time duration,
+		QString emoji) {
+	const auto state = box->lifetime().make_state<BoxState>();
+	state->status = Lower(u"Choose a set"_q);
+
+	box->setTitle(rpl::single(Lower(u"Add to sticker set"_q)));
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			state->status.value(),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+
+	const auto container = box->verticalLayout();
+	for (const auto &set : sets) {
+		const auto full = (set.count >= Api::kStickersInOwnedSetMax);
+		const auto label = full
+			? Lower(u"Full"_q)
+			: u"%1/%2"_q
+				.arg(set.count)
+				.arg(Api::kStickersInOwnedSetMax);
+		const auto button = Settings::AddButtonWithLabel(
+			container,
+			rpl::single(set.title),
+			rpl::single(label),
+			st::settingsButtonNoIcon);
+		if (full) {
+			button->setDisabled(true);
+			button->setColorOverride(st::windowSubTextFg->c);
+			continue;
+		}
+		state->buttons.push_back(button);
+		button->setClickedCallback([=] {
+			StartUpload(
+				box,
+				state,
+				show,
+				set,
+				bytes,
+				kind,
+				duration,
+				emoji);
+		});
+	}
+
+	box->boxClosing() | rpl::on_next([=] {
+		if (state->uploading) {
+			state->uploading = false;
+			state->tgs = nullptr;
+			state->webm = nullptr;
+			HideToast(state->toast);
+			show->showToast(Lower(u"Sticker upload cancelled"_q));
+		}
+	}, box->lifetime());
+
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace
+
+void ShowAddToStickerSet(
+		std::shared_ptr<ChatHelpers::Show> show,
+		QByteArray bytes,
+		StickerKind kind,
+		crl::time duration,
+		QString emoji) {
+	const auto tgs = (kind == StickerKind::Tgs);
+	const auto limit = tgs ? kTgsStickerLimit : kWebmStickerLimit;
+	if (bytes.isEmpty()) {
+		show->showToast(Lower(u"There's no sticker to add"_q));
+		return;
+	} else if (bytes.size() > limit) {
+		const auto text = tgs
+			? u"TGS stickers can be up to %1 KB, this one is %2 KB"_q
+			: u"WebM stickers can be up to %1 KB, this one is %2 KB"_q;
+		show->showToast(Lower(text).arg(
+			KilobytesText(limit),
+			KilobytesText(bytes.size())));
+		return;
+	}
+	if (emoji.isEmpty()) {
+		emoji = DefaultEmoji();
+	}
+	const auto session = &show->session();
+	const auto loader = std::make_shared<SetsLoader>();
+	loader->done = [=](std::vector<OwnedSet> sets) {
+		if (sets.empty()) {
+			auto text = TextWithEntities{
+				Lower(u"You have no sticker sets, create one with "_q),
+			};
+			text.append(Ui::Text::Link(
+				u"@Stickers"_q,
+				u"https://t.me/stickers"_q));
+			show->showToast(std::move(text));
+			return;
+		}
+		show->show(Box(
+			ChooseSetBox,
+			show,
+			std::move(sets),
+			bytes,
+			kind,
+			duration,
+			emoji));
+	};
+	loader->fail = [=](QString type) {
+		show->showToast(Lower(u"Couldn't load your sticker sets"_q)
+			+ u" ("_q
+			+ type
+			+ u")"_q);
+	};
+	RequestOwnedSets(session, loader, 0, 0);
+}
