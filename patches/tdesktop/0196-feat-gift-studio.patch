+void PickerList::setOver(int row) {
+	if (_over == row) {
+		return;
+	}
+	const auto height = RowHeight();
+	if (_over >= 0) {
+		update(0, _over * height, width(), height);
+	}
+	_over = row;
+	if (_over >= 0) {
+		update(0, _over * height, width(), height);
+	}
+	setCursor((_over >= 0) ? style::cur_pointer : style::cur_default);
+}
+
+void PickerList::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto clip = e->rect();
+	const auto height = RowHeight();
+	const auto padding = st::boxRowPadding.left() / 2;
+	const auto preview = style::ConvertScale(28);
+	const auto &font = st::normalFont;
+	const auto from = std::max(clip.y() / height, 0);
+	const auto till = std::min(
+		(clip.y() + clip.height() + height - 1) / height,
+		int(_rows.size()));
+	for (auto i = from; i < till; ++i) {
+		const auto &row = _rows[i];
+		const auto top = i * height;
+		const auto selected = (row.index == _selected);
+		if (selected) {
+			p.fillRect(0, top, width(), height, st::lightButtonBgOver);
+		} else if (i == _over) {
+			p.fillRect(0, top, width(), height, st::windowBgOver);
+		}
+		const auto image = QRect(
+			padding,
+			top + (height - preview) / 2,
+			preview,
+			preview);
+		if (_preview) {
+			_preview(p, image, row.index);
+		}
+		const auto left = image.x() + image.width() + padding;
+		const auto right = width() - padding;
+		const auto rarity = row.rarity.isEmpty() ? 0 : font->width(row.rarity);
+		const auto baseline = top + (height - font->height) / 2 + font->ascent;
+		p.setFont(font->f);
+		p.setPen(selected ? st::lightButtonFg : st::windowFg);
+		const auto available = right
+			- left
+			- (rarity ? (rarity + padding) : 0);
+		p.drawText(left, baseline, font->elided(row.name, available));
+		if (rarity) {
+			p.setPen(st::windowSubTextFg);
+			p.drawText(right - rarity, baseline, row.rarity);
+		}
+	}
+}
+
+void PickerList::mouseMoveEvent(QMouseEvent *e) {
+	setOver(rowAt(e->pos()));
+}
+
+void PickerList::mousePressEvent(QMouseEvent *e) {
