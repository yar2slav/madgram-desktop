diff --git a/Telegram/SourceFiles/tele/tele_gift_studio_video.cpp b/Telegram/SourceFiles/tele/tele_gift_studio_video.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d87ae7b3e6139f508b90d907936d0dab332291a0
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_studio_video.cpp
@@ -0,0 +1,528 @@
+#include "tele/tele_gift_studio_video.h"
+
+#include "ffmpeg/ffmpeg_bytes_io_wrap.h"
+#include "ffmpeg/ffmpeg_utility.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QTemporaryFile>
+#include <QtCore/QThread>
+
+namespace Tele::GiftStudio {
+namespace {
+
+using namespace FFmpeg;
+
+constexpr auto kMinFps = 1.;
+constexpr auto kMaxFps = 120.;
+constexpr auto kRateControlFps = 60.;
+constexpr auto kBitsPerPixel = 0.2;
+constexpr auto kMinBitrate = 500'000.;
+constexpr auto kMaxBitrate = 40'000'000.;
+constexpr auto kMacroblock = 16;
+constexpr auto kMaxMacroblocks = int64(36'864);
+constexpr auto kMaxCrf = 63;
+constexpr auto kVp9CpuUsed = 4;
+constexpr auto kVp9KeySeconds = 3.;
+constexpr auto kMaxThreads = 8;
+constexpr auto kStickerCrfs = std::array{ 30, 36, 42, 48, 54, 63 };
+
+struct OutputDeleter {
+	void operator()(AVFormatContext *value) {
+		if (value) {
+			if (value->pb) {
+				avio_closep(&value->pb);
+			}
+			avformat_free_context(value);
+		}
+	}
+};
+using OutputPointer = std::unique_ptr<AVFormatContext, OutputDeleter>;
+
+void Fail(const QString &what) {
+	LOG(("Tele Gift Studio Error: video, %1.").arg(what));
+}
+
+void Fail(const QString &what, AvErrorWrap error) {
+	LOG(("Tele Gift Studio Error: video, %1 (%2).").arg(what, error.text()));
+}
+
+[[nodiscard]] const AVCodec *FindEncoder(VideoFormat format) {
+	if (format == VideoFormat::Webm) {
+		return avcodec_find_encoder_by_name("libvpx-vp9");
+	} else if (const auto codec = avcodec_find_encoder_by_name(
+			"libopenh264")) {
+		return codec;
+	}
+	return avcodec_find_encoder(AV_CODEC_ID_H264);
+}
+
+[[nodiscard]] const char *MuxerName(VideoFormat format) {
+	return (format == VideoFormat::Webm) ? "webm" : "mp4";
+}
+
+[[nodiscard]] AVCodecID CodecId(VideoFormat format) {
+	return (format == VideoFormat::Webm) ? AV_CODEC_ID_VP9 : AV_CODEC_ID_H264;
+}
+
+[[nodiscard]] QString SizeText(QSize size) {
+	return u"%1x%2"_q.arg(size.width()).arg(size.height());
+}
+
+[[nodiscard]] bool Validate(const VideoJob &job) {
+	const auto size = job.size;
+	if (size.isEmpty() || job.frames <= 0 || !job.frame) {
+		Fail(u"empty job"_q);
+		return false;
+	} else if (!(job.fps >= kMinFps && job.fps <= kMaxFps)) {
+		Fail(u"bad fps %1"_q.arg(job.fps));
+		return false;
+	} else if (job.format != VideoFormat::Mp4) {
+		return true;
+	} else if ((size.width() % 2) || (size.height() % 2)) {
+		Fail(u"odd mp4 size %1"_q.arg(SizeText(size)));
+		return false;
+	}
+	const auto columns = (size.width() + kMacroblock - 1) / kMacroblock;
+	const auto rows = (size.height() + kMacroblock - 1) / kMacroblock;
+	if (int64(columns) * rows > kMaxMacroblocks) {
+		Fail(u"mp4 size %1 is too big"_q.arg(SizeText(size)));
+		return false;
+	}
+	return true;
+}
+
+[[nodiscard]] int64 Bitrate(
+		const VideoJob &job,
+		not_null<const AVCodec*> codec) {
+	const auto pixels = float64(job.size.width()) * job.size.height();
+	const auto wanted = (job.bitrate > 0)
+		? float64(job.bitrate)
+		: std::clamp(
+			pixels * job.fps * kBitsPerPixel,
+			kMinBitrate,
+			kMaxBitrate);
+	const auto ratio = (codec->name == std::string_view("libopenh264"))
+		? std::min(kRateControlFps / job.fps, 1.)
+		: 1.;
+	return int64(base::SafeRound(wanted * ratio));
+}
+
+[[nodiscard]] bool SetOption(
+		not_null<AVCodecContext*> context,
+		const char *name,
+		int64 value) {
+	const auto error = AvErrorWrap(av_opt_set_int(
+		context->priv_data,
+		name,
+		value,
+		0));
+	if (error) {
+		Fail(u"option %1"_q.arg(QString::fromUtf8(name)), error);
+		return false;
+	}
+	return true;
+}
+
+[[nodiscard]] bool SetNamedOption(
+		not_null<AVCodecContext*> context,
+		const char *name,
+		const char *value) {
+	const auto error = AvErrorWrap(av_opt_set(
+		context->priv_data,
+		name,
+		value,
+		0));
+	if (error) {
+		Fail(u"option %1"_q.arg(QString::fromUtf8(name)), error);
+		return false;
+	}
+	return true;
+}
+
+[[nodiscard]] int NextStickerCrf(int crf) {
+	for (const auto value : kStickerCrfs) {
+		if (value > crf) {
+			return value;
+		}
+	}
+	return -1;
+}
+
+class Encoder final {
+public:
+	Encoder(const VideoJob &job, not_null<const AVCodec*> codec);
+
+	[[nodiscard]] QByteArray run(const Fn<bool()> &alive);
+
+private:
+	[[nodiscard]] bool open(const QByteArray &path);
+	[[nodiscard]] bool openCodec();
+	[[nodiscard]] bool push(int index);
+	[[nodiscard]] bool send(AVFrame *frame);
+	[[nodiscard]] bool finish();
+
+	const VideoJob &_job;
+	const not_null<const AVCodec*> _codec;
+	const bool _webm = false;
+	QTemporaryFile _temp;
+	OutputPointer _output;
+	CodecPointer _context;
+	AVStream *_stream = nullptr;
+	FramePointer _frame;
+	SwscalePointer _swscale;
+	Packet _packet;
+	QImage _straight;
+
+};
+
+Encoder::Encoder(const VideoJob &job, not_null<const AVCodec*> codec)
+: _job(job)
+, _codec(codec)
+, _webm(job.format == VideoFormat::Webm)
+, _temp(QDir::tempPath()
+	+ u"/tele_gift_studio_XXXXXX."_q
+	+ (_webm ? u"webm"_q : u"mp4"_q)) {
+}
+
+QByteArray Encoder::run(const Fn<bool()> &alive) {
+	if (!_temp.open()) {
+		Fail(u"can't create %1"_q.arg(_temp.fileTemplate()));
+		return {};
+	}
+	const auto path = _temp.fileName();
+	_temp.close();
+	if (!open(path.toUtf8())) {
+		return {};
+	}
+	for (auto i = 0; i != _job.frames; ++i) {
+		if ((alive && !alive()) || !push(i)) {
+			return {};
+		}
+	}
+	if (!finish()) {
+		return {};
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		Fail(u"can't read %1"_q.arg(path));
+		return {};
+	}
+	return file.readAll();
+}
+
+bool Encoder::open(const QByteArray &path) {
+	auto raw = (AVFormatContext*)nullptr;
+	auto error = AvErrorWrap(avformat_alloc_output_context2(
+		&raw,
+		nullptr,
+		MuxerName(_job.format),
+		path.constData()));
+	if (error || !raw) {
+		Fail(u"avformat_alloc_output_context2"_q, error);
+		return false;
+	}
+	_output = OutputPointer(raw);
+	error = AvErrorWrap(avio_open(
+		&_output->pb,
+		path.constData(),
+		AVIO_FLAG_WRITE));
+	if (error) {
+		Fail(u"avio_open"_q, error);
+		return false;
+	}
+	_stream = avformat_new_stream(_output.get(), _codec);
+	if (!_stream) {
+		Fail(u"avformat_new_stream"_q);
+		return false;
+	} else if (!openCodec()) {
+		return false;
+	}
+	error = AvErrorWrap(avcodec_parameters_from_context(
+		_stream->codecpar,
+		_context.get()));
+	if (error) {
+		Fail(u"avcodec_parameters_from_context"_q, error);
+		return false;
+	}
+	_stream->time_base = _context->time_base;
+	_stream->avg_frame_rate = _context->framerate;
+
+	auto options = (AVDictionary*)nullptr;
+	if (!_webm) {
+		av_dict_set(&options, "movflags", "+faststart", 0);
+	}
+	error = AvErrorWrap(avformat_write_header(_output.get(), &options));
+	av_dict_free(&options);
+	if (error) {
+		Fail(u"avformat_write_header"_q, error);
+		return false;
+	}
+
+	_frame = MakeFramePointer();
+	if (!_frame) {
+		Fail(u"av_frame_alloc"_q);
+		return false;
+	}
+	_frame->format = _context->pix_fmt;
+	_frame->width = _job.size.width();
+	_frame->height = _job.size.height();
+	error = AvErrorWrap(av_frame_get_buffer(_frame.get(), 0));
+	if (error) {
+		Fail(u"av_frame_get_buffer"_q, error);
+		return false;
+	}
+	_swscale = MakeSwscalePointer(
+		_job.size,
+		_webm ? AV_PIX_FMT_BGRA : AV_PIX_FMT_BGR0,
+		_job.size,
+		_context->pix_fmt);
+	if (!_swscale) {
+		Fail(u"sws_getCachedContext"_q);
+		return false;
+	}
+	return true;
+}
+
+bool Encoder::openCodec() {
+	_context = CodecPointer(avcodec_alloc_context3(_codec));
+	if (!_context) {
+		Fail(u"avcodec_alloc_context3"_q);
+		return false;
+	}
+	const auto context = _context.get();
+	const auto rate = av_d2q(_job.fps, 100'000);
+	context->width = _job.size.width();
+	context->height = _job.size.height();
+	context->framerate = rate;
+	context->time_base = av_inv_q(rate);
+	context->pix_fmt = _webm ? AV_PIX_FMT_YUVA420P : AV_PIX_FMT_YUV420P;
+	context->max_b_frames = 0;
+	context->color_range = AVCOL_RANGE_MPEG;
+	context->colorspace = AVCOL_SPC_SMPTE170M;
+	context->thread_count = std::clamp(
+		QThread::idealThreadCount(),
+		1,
+		kMaxThreads);
+	context->flags |= AV_CODEC_FLAG_FRAME_DURATION;
+	if (_output->oformat->flags & AVFMT_GLOBALHEADER) {
+		context->flags |= AV_CODEC_FLAG_GLOBAL_HEADER;
+	}
+	if (_webm) {
+		context->bit_rate = 0;
+		context->gop_size = int(base::SafeRound(_job.fps * kVp9KeySeconds));
+		if (!SetOption(context, "crf", std::clamp(_job.crf, 0, kMaxCrf))
+			|| !SetOption(context, "auto-alt-ref", 0)
+			|| !SetNamedOption(context, "deadline", "good")
+			|| !SetOption(context, "cpu-used", kVp9CpuUsed)
+			|| !SetOption(context, "row-mt", 1)) {
+			return false;
+		}
+	} else {
+		context->bit_rate = Bitrate(_job, _codec);
+		context->gop_size = int(base::SafeRound(_job.fps));
+	}
+	const auto error = AvErrorWrap(avcodec_open2(context, _codec, nullptr));
+	if (error) {
+		Fail(u"avcodec_open2 %1 %2"_q.arg(
+			QString::fromUtf8(_codec->name),
+			SizeText(_job.size)), error);
+		return false;
+	}
+	return true;
+}
+
+bool Encoder::push(int index) {
+	auto image = _job.frame(index);
+	if (image.size() != _job.size) {
+		Fail(u"frame %1 is %2 instead of %3"_q.arg(index).arg(
+			SizeText(image.size()),
+			SizeText(_job.size)));
+		return false;
+	} else if (image.format() != QImage::Format_ARGB32_Premultiplied) {
+		image = std::move(image).convertToFormat(
+			QImage::Format_ARGB32_Premultiplied);
+	}
+	if (_webm) {
+		UnPremultiply(_straight, image);
+		if (_straight.isNull()) {
+			Fail(u"frame storage"_q);
+			return false;
+		}
+	}
+	const auto &source = _webm ? _straight : image;
+	const auto error = AvErrorWrap(av_frame_make_writable(_frame.get()));
+	if (error) {
+		Fail(u"av_frame_make_writable"_q, error);
+		return false;
+	}
+	const uint8_t *data[AV_NUM_DATA_POINTERS] = { source.constBits() };
+	int linesize[AV_NUM_DATA_POINTERS] = { int(source.bytesPerLine()) };
+	const auto scaled = sws_scale(
+		_swscale.get(),
+		data,
+		linesize,
+		0,
+		_job.size.height(),
+		_frame->data,
+		_frame->linesize);
+	if (scaled <= 0) {
+		Fail(u"sws_scale"_q, AvErrorWrap(scaled));
+		return false;
+	}
+	_frame->pts = index;
+	_frame->duration = 1;
+	return send(_frame.get());
+}
+
+bool Encoder::send(AVFrame *frame) {
+	const auto context = _context.get();
+	auto error = AvErrorWrap(avcodec_send_frame(context, frame));
+	if (error) {
+		Fail(u"avcodec_send_frame"_q, error);
+		return false;
+	}
+	const auto packet = &_packet.fields();
+	while (true) {
+		error = AvErrorWrap(avcodec_receive_packet(context, packet));
+		if (error.code() == AVERROR(EAGAIN) || error.code() == AVERROR_EOF) {
+			return true;
+		} else if (error) {
+			Fail(u"avcodec_receive_packet"_q, error);
+			return false;
+		}
+		packet->stream_index = _stream->index;
+		av_packet_rescale_ts(packet, context->time_base, _stream->time_base);
+		error = AvErrorWrap(av_interleaved_write_frame(
+			_output.get(),
+			packet));
+		if (error) {
+			Fail(u"av_interleaved_write_frame"_q, error);
+			return false;
+		}
+	}
+}
+
+bool Encoder::finish() {
+	if (!send(nullptr)) {
+		return false;
+	}
+	auto error = AvErrorWrap(av_write_trailer(_output.get()));
+	if (error) {
+		Fail(u"av_write_trailer"_q, error);
+		return false;
+	}
+	error = AvErrorWrap(avio_closep(&_output->pb));
+	if (error) {
+		Fail(u"avio_closep"_q, error);
+		return false;
+	}
+	return true;
+}
+
+[[nodiscard]] bool Verify(const QByteArray &bytes, const VideoJob &job) {
+	auto wrap = ReadBytesWrap{
+		.size = int64(bytes.size()),
+		.data = reinterpret_cast<const uchar*>(bytes.constData()),
+	};
+	const auto format = MakeFormatPointer(
+		static_cast<void*>(&wrap),
+		&ReadBytesWrap::Read,
+		nullptr,
+		&ReadBytesWrap::Seek);
+	if (!format) {
+		Fail(u"self-check can't open the result"_q);
+		return false;
+	} else if (format->nb_streams != 1) {
+		Fail(u"self-check found %1 streams"_q.arg(format->nb_streams));
+		return false;
+	}
+	const auto stream = format->streams[0];
+	const auto parameters = stream->codecpar;
+	const auto size = QSize(parameters->width, parameters->height);
+	if (parameters->codec_type != AVMEDIA_TYPE_VIDEO
+		|| parameters->codec_id != CodecId(job.format)
+		|| size != job.size) {
+		Fail(u"self-check found %1 %2 instead of %3 %4"_q.arg(
+			QString::fromUtf8(avcodec_get_name(parameters->codec_id)),
+			SizeText(size),
+			QString::fromUtf8(avcodec_get_name(CodecId(job.format))),
+			SizeText(job.size)));
+		return false;
+	} else if (job.format == VideoFormat::Webm) {
+		const auto alpha = av_dict_get(
+			stream->metadata,
+			"alpha_mode",
+			nullptr,
+			0);
+		if (!alpha || alpha->value != std::string_view("1")) {
+			Fail(u"self-check found no alpha"_q);
+			return false;
+		}
+	}
+	auto packet = Packet();
+	auto packets = 0;
+	while (true) {
+		const auto raw = &packet.fields();
+		const auto error = AvErrorWrap(av_read_frame(format.get(), raw));
+		if (error.code() == AVERROR_EOF) {
+			break;
+		} else if (error) {
+			Fail(u"self-check av_read_frame"_q, error);
+			return false;
+		}
+		++packets;
+		av_packet_unref(raw);
+	}
+	if (!packets) {
+		Fail(u"self-check found no frames"_q);
+		return false;
+	}
+	return true;
+}
+
+} // namespace
+
+bool VideoFormatAvailable(VideoFormat format) {
+	return FindEncoder(format)
+		&& av_guess_format(MuxerName(format), nullptr, nullptr);
+}
+
+QByteArray EncodeVideo(const VideoJob &job, Fn<bool()> alive) {
+	if (!Validate(job)) {
+		return {};
+	}
+	const auto codec = FindEncoder(job.format);
+	if (!codec) {
+		Fail(u"no %1 encoder"_q.arg(
+			QString::fromUtf8(avcodec_get_name(CodecId(job.format)))));
+		return {};
+	}
+	auto result = Encoder(job, codec).run(alive);
+	if (result.isEmpty() || (alive && !alive()) || !Verify(result, job)) {
+		return {};
+	}
+	return result;
+}
+
+QByteArray EncodeWebmSticker(
+		VideoJob job,
+		int64 maxBytes,
+		Fn<bool()> alive) {
+	job.format = VideoFormat::Webm;
+	auto crf = std::clamp(job.crf, 0, kMaxCrf);
+	for (; crf >= 0; crf = NextStickerCrf(crf)) {
+		if (alive && !alive()) {
+			return {};
+		}
+		job.crf = crf;
+		auto result = EncodeVideo(job, alive);
+		if (result.isEmpty() || result.size() <= maxBytes) {
+			return result;
+		}
+	}
+	Fail(u"sticker doesn't fit %1 bytes"_q.arg(maxBytes));
+	return {};
+}
+
+} // namespace Tele::GiftStudio
