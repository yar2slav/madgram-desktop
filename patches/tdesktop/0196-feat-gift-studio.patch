+std::vector<int> MakeTimeline(
+		int frames,
+		float64 fps,
+		const Motion &motion,
+		float64 outputFps) {
+	if (frames <= 0 || fps <= 0. || outputFps <= 0.) {
+		return {};
+	}
+	const auto from = std::clamp(motion.from, 0, frames - 1);
+	const auto till = (motion.till < 0)
+		? (frames - 1)
+		: std::clamp(motion.till, from, frames - 1);
+	const auto length = till - from + 1;
+	const auto path = (motion.pingPong && length > 1)
+		? (2 * length - 2)
+		: length;
+	const auto step = fps * std::clamp(motion.speed, 0.05, 20.) / outputFps;
+	const auto count = std::clamp(
+		int(base::SafeRound(path / step)),
+		1,
+		kMaxTimeline);
+	auto result = std::vector<int>();
+	result.reserve(count);
+	for (auto i = 0; i != count; ++i) {
+		const auto position = int(i * step) % path;
+		result.push_back((position < length)
+			? (from + position)
+			: (from + path - position));
+	}
+	return result;
+}
