+void SectionHeader::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	if (isOver() || isDown()) {
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(rect(), st::boxRadius, st::boxRadius);
+	}
+	const auto left = st::boxRadius;
+	const auto arrow = style::ConvertScale(4);
+	const auto arrowSpace = 4 * arrow + left;
+	const auto &titleFont = st::semiboldFont;
+	const auto &font = st::normalFont;
+	const auto titleWidth = titleFont->width(_title);
+	p.setFont(titleFont->f);
+	p.setPen(st::windowFg);
+	p.drawText(
+		left,
+		(height() - titleFont->height) / 2 + titleFont->ascent,
+		_title);
+	if (!_summary.isEmpty()) {
+		const auto from = left + titleWidth;
+		const auto available = width() - from - arrowSpace;
+		if (available > 0) {
+			p.setFont(font->f);
+			p.setPen(st::windowSubTextFg);
+			p.drawText(
+				from,
+				(height() - font->height) / 2 + font->ascent,
+				font->elided(u" \u00B7 "_q + _summary, available));
+		}
+	}
+	auto pen = st::windowSubTextFg->p;
+	pen.setWidthF(style::ConvertScaleExact(1.5));
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+	const auto cx = width() - left - 2. * arrow;
+	const auto cy = height() / 2.;
+	auto path = QPainterPath();
+	if (_expanded) {
+		path.moveTo(cx - arrow, cy - arrow / 2.);
+		path.lineTo(cx, cy + arrow / 2.);
+		path.lineTo(cx + arrow, cy - arrow / 2.);
+	} else {
+		path.moveTo(cx - arrow / 2., cy - arrow);
+		path.lineTo(cx + arrow / 2., cy);
+		path.lineTo(cx - arrow / 2., cy + arrow);
+	}
+	p.drawPath(path);
+}
