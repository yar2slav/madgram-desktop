+[[nodiscard]] Json JsonBool(bool value) {
+	auto result = Json();
+	result.raw = value ? "true" : "false";
+	return result;
+}
+
+[[nodiscard]] Json RoundedNumber(double value, int decimals) {
+	const auto factor = std::pow(10., std::max(decimals, 0));
+	return JsonNumber(std::round(value * factor) / factor);
+}
+
+[[nodiscard]] Json PointsArray(
+		const std::vector<QPointF> &points,
+		int decimals) {
+	auto items = std::vector<Json>();
+	items.reserve(points.size());
+	for (const auto &point : points) {
+		items.push_back(JsonArray({
+			RoundedNumber(point.x(), decimals),
+			RoundedNumber(point.y(), decimals),
+		}));
+	}
+	return JsonArray(std::move(items));
+}
+
+void AppendPathShapes(
+		std::vector<Json> &to,
+		const QPainterPath &path,
+		int decimals) {
+	auto vertices = std::vector<QPointF>();
+	auto ins = std::vector<QPointF>();
+	auto outs = std::vector<QPointF>();
+	const auto flush = [&] {
+		const auto close = 0.01;
+		if (vertices.size() > 1) {
+			const auto delta = vertices.back() - vertices.front();
+			if (std::abs(delta.x()) < close && std::abs(delta.y()) < close) {
+				ins.front() = ins.back();
+				vertices.pop_back();
+				ins.pop_back();
+				outs.pop_back();
+			}
+		}
+		if (vertices.size() > 2) {
+			to.push_back(JsonObject({
+				{ "ty", JsonString("sh") },
+				{ "ks", JsonStatic(JsonObject({
+					{ "i", PointsArray(ins, decimals) },
+					{ "o", PointsArray(outs, decimals) },
+					{ "v", PointsArray(vertices, decimals) },
+					{ "c", JsonBool(true) },
+				})) },
+			}));
+		}
+		vertices.clear();
+		ins.clear();
+		outs.clear();
+	};
+	const auto count = path.elementCount();
+	for (auto i = 0; i < count; ++i) {
+		const auto element = path.elementAt(i);
+		const auto point = QPointF(element.x, element.y);
+		if (element.isMoveTo()) {
+			flush();
+			vertices.push_back(point);
+			ins.push_back({});
+			outs.push_back({});
+		} else if (element.isLineTo()) {
+			vertices.push_back(point);
+			ins.push_back({});
+			outs.push_back({});
+		} else if (element.isCurveTo() && i + 2 < count) {
+			const auto second = path.elementAt(i + 1);
+			const auto end = path.elementAt(i + 2);
+			const auto target = QPointF(end.x, end.y);
+			if (vertices.empty()) {
+				vertices.push_back(point);
+				ins.push_back({});
+				outs.push_back({});
+			}
+			outs.back() = point - vertices.back();
+			vertices.push_back(target);
+			ins.push_back(QPointF(second.x, second.y) - target);
+			outs.push_back({});
+			i += 2;
+		}
+	}
+	flush();
+}
+
+[[nodiscard]] Json OverlayLayer(
+		int index,
+		const TgsGeometry &geometry,
+		double in,
+		double out) {
+	auto groups = std::vector<Json>();
+	for (const auto &shape : geometry.overlay) {
+		auto items = std::vector<Json>();
+		AppendPathShapes(items, shape.path, geometry.textDecimals);
+		if (items.empty()) {
+			continue;
+		}
+		items.push_back(FillShape(shape.color));
+		groups.push_back(ShapeGroup(std::move(items)));
+	}
+	std::reverse(begin(groups), end(groups));
+	return ShapeLayer(index, "text", std::move(groups), in, out);
+}
+
+void ScaleTimes(Json &node, double scale, int depth = 0) {
+	if (depth > kMaxDepth) {
+		return;
+	}
+	if (node.type == Json::Type::Object) {
+		if (const auto layers = node.find("layers")) {
+			for (auto &layer : layers->items) {
+				for (const auto key : { "ip", "op", "st" }) {
+					if (const auto value = layer.find(key)) {
+						*value = JsonNumber(value->number(0.) * scale);
+					}
+				}
+			}
+		}
+		if (const auto keys = node.find("k")
+			; keys && keys->type == Json::Type::Array) {
+			for (auto &key : keys->items) {
+				if (key.type == Json::Type::Object) {
+					if (const auto time = key.find("t")) {
+						*time = JsonNumber(time->number(0.) * scale);
+					}
+				}
+			}
+		}
+		for (auto &[name, value] : node.fields) {
+			ScaleTimes(value, scale, depth + 1);
+		}
+	} else if (node.type == Json::Type::Array) {
+		for (auto &item : node.items) {
+			ScaleTimes(item, scale, depth + 1);
+		}
+	}
+}
+
+[[nodiscard]] Json Flipped(const Json &easing) {
+	auto result = easing;
+	const auto flip = [](Json &value) {
+		if (value.type == Json::Type::Scalar) {
+			value = JsonNumber(1. - value.number(0.));
+		} else {
+			for (auto &item : value.items) {
+				item = JsonNumber(1. - item.number(0.));
+			}
+		}
+	};
+	for (const auto key : { "x", "y" }) {
+		if (const auto value = result.find(key)) {
+			flip(*value);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool IsKeyframes(const Json &keys) {
+	return (keys.type == Json::Type::Array)
+		&& !keys.items.empty()
+		&& ranges::all_of(keys.items, [](const Json &key) {
+			return (key.type == Json::Type::Object) && key.find("t");
+		});
+}
+
+void ReverseKeyframes(Json &keys, double pivot) {
+	const auto &old = keys.items;
+	const auto n = int(old.size()) - 1;
+	const auto value = [&](int index) -> std::optional<Json> {
+		if (const auto start = old[index].find("s")) {
+			return *start;
+		} else if (index > 0) {
+			if (const auto end = old[index - 1].find("e")) {
+				return *end;
+			}
+		}
+		return std::nullopt;
+	};
+	auto result = std::vector<Json>();
+	result.reserve(old.size());
+	for (auto j = 0; j <= n; ++j) {
+		const auto m = n - j;
+		auto key = JsonObject({
+			{ "t", JsonNumber(pivot - old[m].find("t")->number(0.)) },
+		});
+		if (m > 0) {
+			const auto &segment = old[m - 1];
+			const auto hold = segment.find("h")
+				&& segment.find("h")->number(0.) != 0.;
+			const auto start = value(hold ? (m - 1) : m);
+			if (start) {
+				key.set("s", *start);
+			}
+			if (hold) {
+				key.set("h", JsonNumber(1.));
+			} else {
+				if (const auto in = segment.find("i")) {
+					key.set("o", Flipped(*in));
+				}
+				if (const auto out = segment.find("o")) {
+					key.set("i", Flipped(*out));
+				}
+				if (const auto ti = segment.find("ti")) {
+					key.set("to", *ti);
+				}
+				if (const auto to = segment.find("to")) {
+					key.set("ti", *to);
+				}
+			}
+		} else if (const auto start = value(0)) {
+			key.set("s", *start);
+		}
+		result.push_back(std::move(key));
+	}
+	keys.items = std::move(result);
+}
+
+void ReverseProperties(Json &node, double pivot, int depth = 0) {
+	if (depth > kMaxDepth) {
+		return;
+	}
+	if (node.type == Json::Type::Object) {
+		if (const auto keys = node.find("k"); keys && IsKeyframes(*keys)) {
+			ReverseKeyframes(*keys, pivot);
+		}
+		for (auto &[name, value] : node.fields) {
+			if (name != "k") {
+				ReverseProperties(value, pivot, depth + 1);
+			}
+		}
+	} else if (node.type == Json::Type::Array) {
+		for (auto &item : node.items) {
+			ReverseProperties(item, pivot, depth + 1);
+		}
+	}
+}
+
+void ReverseLayers(
+		Json &layers,
+		double pivot,
+		std::vector<Json> &assets,
+		int &counter,
+		int depth = 0) {
+	if (depth > kMaxDepth) {
+		return;
+	}
+	for (auto &layer : layers.items) {
+		const auto number = [&](const char *key, double fallback) {
+			const auto found = layer.find(key);
+			return found ? found->number(fallback) : fallback;
+		};
+		const auto start = number("st", 0.);
+		const auto in = number("ip", 0.);
+		const auto out = number("op", 0.);
+		const auto local = pivot - start;
+		layer.set("ip", JsonNumber(pivot - std::ceil(out) + 1.));
+		layer.set("op", JsonNumber(pivot - std::ceil(in) + 1.));
+		layer.set("st", JsonNumber(0.));
+		for (auto &[name, value] : layer.fields) {
+			ReverseProperties(value, pivot);
+		}
+		const auto ref = layer.find("refId");
+		if (!ref || number("ty", -1.) != 0.) {
+			continue;
+		}
+		const auto id = ref->text();
+		const auto i = ranges::find_if(assets, [&](const Json &asset) {
+			const auto found = asset.find("id");
+			return found && found->text() == id;
+		});
+		if (i == end(assets)) {
+			continue;
+		}
+		auto copy = *i;
+		const auto copyId = id + "_r" + QByteArray::number(++counter);
+		copy.set("id", JsonString(copyId));
+		if (const auto inner = copy.find("layers")) {
+			ReverseLayers(*inner, local, assets, counter, depth + 1);
+		}
+		assets.push_back(std::move(copy));
+		*layer.find("refId") = JsonString(copyId);
+	}
+}
+
+void Freeze(Json &node, int depth = 0) {
+	if (depth > kMaxDepth) {
+		return;
+	}
+	if (node.type == Json::Type::Object) {
+		if (const auto keys = node.find("k"); keys && IsKeyframes(*keys)) {
+			auto first = keys->items.front().find("s")
+				? *keys->items.front().find("s")
+				: JsonNumber(0.);
+			if (first.type == Json::Type::Array && first.items.size() == 1) {
+				first = Json(first.items.front());
+			}
+			*keys = std::move(first);
+			node.set("a", JsonNumber(0.));
+		}
+		for (auto &[name, value] : node.fields) {
+			Freeze(value, depth + 1);
+		}
+	} else if (node.type == Json::Type::Array) {
+		for (auto &item : node.items) {
+			Freeze(item, depth + 1);
+		}
+	}
+}
+
+void SpanLayers(Json &node, double out, int depth = 0) {
+	if (depth > kMaxDepth) {
+		return;
+	}
+	if (node.type == Json::Type::Object) {
+		if (const auto layers = node.find("layers")) {
+			for (auto &layer : layers->items) {
+				layer.set("ip", JsonNumber(0.));
+				layer.set("op", JsonNumber(out));
+				layer.set("st", JsonNumber(0.));
+			}
+		}
+		for (auto &[name, value] : node.fields) {
+			SpanLayers(value, out, depth + 1);
+		}
+	} else if (node.type == Json::Type::Array) {
+		for (auto &item : node.items) {
+			SpanLayers(item, out, depth + 1);
+		}
+	}
+}
+
+constexpr auto kMarkTagBits = 32;
+constexpr auto kMarkVersionBits = 4;
+constexpr auto kMarkBits = kMarkTagBits + kMarkVersionBits;
+constexpr auto kMarkCopies = 3;
+constexpr auto kMarkVertices = (kMarkBits * kMarkCopies) / 6;
+
+[[nodiscard]] const std::vector<int> &MarkBits() {
+	static const auto result = [] {
+		const auto hash = QCryptographicHash::hash(
+			QByteArrayLiteral("tele-gift-studio"),
+			QCryptographicHash::Sha256);
+		auto tag = quint32(0);
+		for (auto i = 0; i != 4; ++i) {
+			tag = (tag << 8) | uchar(hash[i]);
+		}
+		const auto version = quint32(1);
+		auto bits = std::vector<int>();
+		bits.reserve(kMarkBits);
+		for (auto i = kMarkTagBits - 1; i >= 0; --i) {
+			bits.push_back(int((tag >> i) & 1));
+		}
+		for (auto i = kMarkVersionBits - 1; i >= 0; --i) {
+			bits.push_back(int((version >> i) & 1));
+		}
+		return bits;
+	}();
+	return result;
+}
+
+[[nodiscard]] Json MarkPath() {
+	const auto &bits = MarkBits();
+	const auto coord = [&](int block, int local) {
+		const auto n = block * kMarkBits + local;
+		return JsonNumber(double(2 * n + bits[n % kMarkBits]));
+	};
+	auto i = std::vector<Json>();
+	auto o = std::vector<Json>();
+	auto v = std::vector<Json>();
+	i.reserve(kMarkVertices);
+	o.reserve(kMarkVertices);
+	v.reserve(kMarkVertices);
+	for (auto p = 0; p != kMarkVertices; ++p) {
+		i.push_back(JsonArray({ coord(0, 2 * p), coord(0, 2 * p + 1) }));
+		o.push_back(JsonArray({ coord(1, 2 * p), coord(1, 2 * p + 1) }));
+		v.push_back(JsonArray({ coord(2, 2 * p), coord(2, 2 * p + 1) }));
+	}
+	return JsonObject({
+		{ "ty", JsonString("sh") },
+		{ "ks", JsonStatic(JsonObject({
+			{ "i", JsonArray(std::move(i)) },
+			{ "o", JsonArray(std::move(o)) },
+			{ "v", JsonArray(std::move(v)) },
+			{ "c", JsonBool(true) },
+		})) },
+	});
+}
+
+[[nodiscard]] Json MarkLayer(int index, double out) {
+	return ShapeLayer(
+		index,
+		"shape",
+		{ ShapeGroup({ MarkPath() }) },
+		0.,
+		out);
+}
+
+[[nodiscard]] QByteArray MergeTgsJson(
+		const QByteArray &modelBytes,
+		const QByteArray &symbolBytes,
+		const QColor &pattern,
+		const TgsGeometry &geometry) {
+	auto model = JsonParser(modelBytes).parse();
+	auto symbol = JsonParser(symbolBytes).parse();
+	if (!model
+		|| !symbol
+		|| model->type != Json::Type::Object
+		|| symbol->type != Json::Type::Object
+		|| geometry.width <= 0.
+		|| geometry.height <= 0.
+		|| geometry.frames <= 0
+		|| geometry.rate <= 0.) {
+		return QByteArray();
+	}
+	const auto value = [](const Json &object, const char *key) {
+		const auto found = object.find(key);
+		return found ? found->number(0.) : 0.;
+	};
+	const auto out = double(geometry.frames);
+	const auto modelSize = QSizeF(value(*model, "w"), value(*model, "h"));
+	const auto symbolSize = QSizeF(value(*symbol, "w"), value(*symbol, "h"));
+	if (value(*model, "op") <= value(*model, "ip")
+		|| modelSize.isEmpty()
+		|| symbolSize.isEmpty()) {
+		return QByteArray();
+	}
+	const auto &timing = geometry.timing;
+	const auto scale = timing.retime ? timing.scale : 1.;
+	const auto base = value(*model, "ip") * scale;
+	if (timing.retime && std::abs(timing.scale - 1.) > 1e-9) {
+		ScaleTimes(*model, timing.scale);
+	}
+	auto modelAssets = TakeArray(*model, "assets");
+	auto modelLayers = TakeArray(*model, "layers");
+	auto symbolAssets = TakeArray(*symbol, "assets");
+	auto symbolLayers = TakeArray(*symbol, "layers");
+	PrefixAssets(modelAssets, "model_");
+	PrefixLayers(modelLayers, "model_");
+	PrefixAssets(symbolAssets, "symbol_");
+	PrefixLayers(symbolLayers, "symbol_");
+	const auto tint = JsonStatic(JsonColor(pattern));
+	TintJson(symbolAssets, tint);
+	TintJson(symbolLayers, tint);
+	Freeze(symbolAssets);
+	Freeze(symbolLayers);
+	SpanLayers(symbolAssets, out);
+	for (auto &layer : symbolLayers.items) {
+		layer.set("ip", JsonNumber(0.));
+		layer.set("op", JsonNumber(out));
+		layer.set("st", JsonNumber(0.));
+	}
+
+	auto assets = std::move(modelAssets.items);
+	for (auto &asset : symbolAssets.items) {
+		assets.push_back(std::move(asset));
+	}
+	const auto composition = [](
+			const QByteArray &id,
+			QSizeF size,
+			Json layers) {
+		return JsonObject({
+			{ "id", JsonString(id) },
+			{ "w", JsonNumber(size.width()) },
+			{ "h", JsonNumber(size.height()) },
+			{ "layers", std::move(layers) },
+		});
+	};
+	auto reversed = std::optional<Json>();
+	if (timing.retime && timing.pingPong) {
+		auto copy = modelLayers;
+		auto counter = 0;
+		ReverseLayers(copy, timing.pivot + base, assets, counter);
+		reversed = std::move(copy);
+	}
+	assets.push_back(composition(
+		"tele_model",
+		modelSize,
+		std::move(modelLayers)));
+	if (reversed) {
+		assets.push_back(composition(
+			"tele_model_back",
+			modelSize,
+			std::move(*reversed)));
+	}
+	assets.push_back(composition(
+		"tele_symbol",
+		symbolSize,
+		std::move(symbolLayers)));
+
+	const auto anchor = [](QSizeF size) {
+		return QPointF(size.width() / 2., size.height() / 2.);
+	};
+	const auto fit = [](QSizeF size) {
+		return std::max(size.width(), size.height());
+	};
+	const auto modelTransform = [&] {
+		return JsonTransform(
+			geometry.modelCenter,
+			anchor(modelSize),
+			geometry.modelSide / fit(modelSize),
+			1.);
+	};
+	auto layers = std::vector<Json>();
+	auto index = 0;
+	if (!geometry.overlay.empty()) {
+		layers.push_back(OverlayLayer(++index, geometry, 0., out));
+	}
+	if (!timing.retime) {
+		layers.push_back(PrecompLayer(
+			++index,
+			"model",
+			"tele_model",
+			modelSize,
+			modelTransform(),
+			0.,
+			out,
+			-base));
+	} else {
+		const auto forward = timing.length;
+		layers.push_back(PrecompLayer(
+			++index,
+			"model",
+			"tele_model",
+			modelSize,
+			modelTransform(),
+			0.,
+			std::min(forward, out),
+			-(timing.from + base)));
+		if (timing.pingPong && forward < out) {
+			layers.push_back(PrecompLayer(
+				++index,
+				"model back",
+				"tele_model_back",
+				modelSize,
+				modelTransform(),
+				forward,
+				out,
+				0.));
+		}
+	}
+	layers.push_back(MarkLayer(++index, out));
+	for (const auto &point : geometry.points) {
+		layers.push_back(PrecompLayer(
+			++index,
+			"symbol",
+			"tele_symbol",
+			symbolSize,
+			JsonTransform(
+				QPointF(point.x, point.y),
+				anchor(symbolSize),
+				point.side / fit(symbolSize),
+				point.opacity),
+			0.,
+			out,
+			0.));
+	}
+	if (geometry.background) {
+		layers.push_back(BackdropLayer(++index, geometry, 0., out));
+	}
+
+	const auto version = model->find("v");
+	const auto root = JsonObject({
+		{ "tgs", JsonNumber(1.) },
+		{ "v", version ? *version : JsonString("5.5.2") },
+		{ "fr", JsonNumber(geometry.rate) },
+		{ "ip", JsonNumber(0.) },
+		{ "op", JsonNumber(out) },
+		{ "w", JsonNumber(geometry.width) },
+		{ "h", JsonNumber(geometry.height) },
+		{ "nm", JsonString("gift") },
+		{ "ddd", JsonNumber(0.) },
+		{ "assets", JsonArray(std::move(assets)) },
+		{ "layers", JsonArray(std::move(layers)) },
+	});
+	auto result = QByteArray();
+	WriteJson(result, root, geometry.decimals);
+	return result;
+}
+
+[[nodiscard]] QByteArray Gzip(const QByteArray &bytes) {
+	auto stream = z_stream();
+	if (deflateInit2(
+			&stream,
+			Z_BEST_COMPRESSION,
+			Z_DEFLATED,
+			16 + MAX_WBITS,
+			8,
+			Z_DEFAULT_STRATEGY) != Z_OK) {
+		return QByteArray();
+	}
+	auto result = QByteArray(
+		int(deflateBound(&stream, uLong(bytes.size()))),
+		Qt::Uninitialized);
+	stream.next_in = reinterpret_cast<Bytef*>(
+		const_cast<char*>(bytes.constData()));
+	stream.avail_in = uInt(bytes.size());
+	stream.next_out = reinterpret_cast<Bytef*>(result.data());
+	stream.avail_out = uInt(result.size());
+	const auto finished = (deflate(&stream, Z_FINISH) == Z_STREAM_END);
+	result.resize(finished ? int(stream.total_out) : 0);
+	deflateEnd(&stream);
+	return result;
+}
+
+[[nodiscard]] int Macroblocks(int value) {
+	return (value + kMacroblock - 1) / kMacroblock;
+}
+
+[[nodiscard]] bool FitsMp4(QSize size) {
+	return int64(Macroblocks(size.width())) * Macroblocks(size.height())
+		<= kMaxMacroblocks;
+}
+
+[[nodiscard]] QSize EvenSize(QSize size) {
+	return QSize(
+		std::max(size.width() & ~1, 2),
+		std::max(size.height() & ~1, 2));
+}
+
+class Composer final {
+public:
+	explicit Composer(const Animation &animation)
+	: _animation(animation)
+	, _instance(Lottie::Instance::Create(
+		Lottie::ReadUtf8(animation.json),
+		nullptr)) {
+		if (_instance) {
+			_storage = QImage(
+				animation.model.size(),
+				QImage::Format_ARGB32_Premultiplied);
+		}
+	}
+
+	[[nodiscard]] bool valid() const {
+		return _instance
+			&& !_animation.timeline.empty()
+			&& !_animation.base.isNull()
+			&& !_animation.model.isEmpty();
+	}
+
+	[[nodiscard]] QImage compose(int index, QRect area) {
+		const auto &timeline = _animation.timeline;
+		_instance->renderToPrepared(
+			_storage,
+			timeline[std::clamp(index, 0, int(timeline.size()) - 1)]);
+		auto result = _animation.base.copy(area);
+		auto p = QPainter(&result);
+		p.drawImage(_animation.model.topLeft() - area.topLeft(), _storage);
+		if (!_animation.overlay.isNull()) {
+			p.drawImage(QPoint(), _animation.overlay, area);
+		}
+		return result;
+	}
+
+private:
+	const Animation &_animation;
+	std::unique_ptr<Lottie::Instance> _instance;
+	QImage _storage;
+
+};
+
+[[nodiscard]] QByteArray EncodeAnimation(
+		const Animation &animation,
+		VideoFormat format,
+		std::optional<int64> limit,
+		Fn<bool()> alive) {
+	if (!VideoFormatAvailable(format)) {
+		return QByteArray();
+	}
+	const auto composer = std::make_shared<Composer>(animation);
+	if (!composer->valid()) {
+		return QByteArray();
+	}
+	const auto full = QRect(QPoint(), animation.base.size());
+	auto job = VideoJob{
+		.format = format,
+		.size = animation.base.size(),
+		.fps = animation.fps,
+		.frames = int(animation.timeline.size()),
+		.frame = [=](int index) {
+			return composer->compose(index, full);
+		},
+	};
+	return limit
+		? EncodeWebmSticker(std::move(job), *limit, alive)
+		: EncodeVideo(job, alive);
+}
+
+[[nodiscard]] bool IdentityMotion(const Motion &motion, int frames) {
+	return (std::abs(motion.speed - 1.) < 0.001)
+		&& (motion.from <= 0)
+		&& (motion.till < 0 || motion.till >= frames - 1)
+		&& !motion.pingPong;
+}
+
+[[nodiscard]] bool CheckTgs(
+		const QByteArray &gzipped,
+		const TgsGeometry &geometry) {
+	const auto json = Images::UnpackGzip(gzipped);
+	const auto instance = Lottie::Instance::Create(
+		Lottie::ReadUtf8(json),
+		nullptr);
+	if (!instance || instance->framesCount() <= 0) {
+		return false;
+	}
+	const auto canvas = QSize(
+		int(base::SafeRound(geometry.width)),
+		int(base::SafeRound(geometry.height)));
+	const auto check = canvas.scaled(
+		kCheckSide,
+		kCheckSide,
+		Qt::KeepAspectRatio);
+	auto frame = QImage(check, QImage::Format_ARGB32_Premultiplied);
+	instance->renderToPrepared(frame, 0);
+	const auto scale = check.width() / geometry.width;
+	const auto alpha = [&](QPointF point) {
+		const auto x = std::clamp(
+			int(point.x() * scale),
+			0,
+			check.width() - 1);
+		const auto y = std::clamp(
+			int(point.y() * scale),
+			0,
+			check.height() - 1);
+		return qAlpha(frame.pixel(x, y));
+	};
+	if (geometry.background
+		&& geometry.overlay.empty()
+		&& alpha(geometry.content.center()) != 0xFF) {
+		return false;
+	}
+	if (geometry.radius * scale >= 2.
+		&& alpha(geometry.content.topLeft()) >= 0x80) {
+		return false;
+	}
+	return true;
+}
+
+} // namespace
+
+QSize Mp4Size(QSize canvas) {
+	auto result = EvenSize(canvas);
+	if (FitsMp4(result)) {
+		return result;
+	}
+	const auto limit = float64(kMaxMacroblocks) * kMacroblock * kMacroblock;
+	auto factor = std::sqrt(
+		limit / (float64(canvas.width()) * canvas.height()));
+	while (factor > 0.) {
+		result = EvenSize(QSize(
+			int(canvas.width() * factor),
+			int(canvas.height() * factor)));
+		if (FitsMp4(result)) {
+			break;
+		}
+		factor -= 0.005;
+	}
+	return result;
+}
+
+QSize StickerSize(QSize canvas) {
+	if (canvas.isEmpty()) {
+		return QSize(kStickerSide, kStickerSide);
+	}
+	return EvenSize(canvas.scaled(
+		kStickerSide,
+		kStickerSide,
+		Qt::KeepAspectRatio));
+}
+
+Encoded EncodeGif(const Animation &animation, Fn<bool()> alive) {
+	auto composer = Composer(animation);
+	if (!composer.valid() || animation.fps <= 0.) {
+		return {};
+	}
+	const auto count = int(animation.timeline.size());
+	const auto area = animation.model.intersected(
+		QRect(QPoint(), animation.base.size()));
+	if (area.isEmpty()) {
+		return {};
+	}
+	auto composed = animation.base;
+	if (!animation.overlay.isNull()) {
+		auto p = QPainter(&composed);
+		p.drawImage(0, 0, animation.overlay);
+	}
+	const auto time = [&](int index) {
+		return int(base::SafeRound(index * 100. / animation.fps));
+	};
+	auto delays = std::vector<int>();
+	delays.reserve(count);
+	for (auto index = 0; index != count; ++index) {
+		delays.push_back(std::max(time(index + 1) - time(index), 2));
+	}
+	const auto frame = [&](int index) {
+		return composer.compose(index, area);
+	};
+	return {
+		.bytes = EncodeGifFrames(composed, area, count, frame, delays, alive),
+		.size = composed.size(),
+		.frames = count,
+	};
+}
+
+bool VerifyGif(const Encoded &gif) {
+	if (gif.bytes.isEmpty() || gif.frames <= 0) {
+		return false;
+	}
+	auto bytes = gif.bytes;
+	auto buffer = QBuffer(&bytes);
+	if (!buffer.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	auto reader = QImageReader(&buffer, "gif");
+	if (!reader.canRead() || reader.size() != gif.size) {
+		return false;
+	}
+	auto frames = 0;
+	while (reader.canRead()) {
+		const auto image = reader.read();
+		if (image.isNull()) {
+			break;
+		} else if (image.size() != gif.size) {
+			return false;
+		}
+		++frames;
+	}
+	return (frames == gif.frames);
+}
+
+QByteArray EncodeMp4(const Animation &animation, Fn<bool()> alive) {
+	return EncodeAnimation(
+		animation,
+		VideoFormat::Mp4,
+		std::nullopt,
+		std::move(alive));
+}
+
+QByteArray EncodeWebm(Animation animation, bool sticker, Fn<bool()> alive) {
+	if (sticker && animation.fps > 0.) {
+		const auto limit = int(
+			kStickerDuration * animation.fps / 1000.);
+		if (int(animation.timeline.size()) > limit) {
+			animation.timeline.resize(std::max(limit, 1));
+		}
+	}
+	return EncodeAnimation(
+		animation,
+		VideoFormat::Webm,
+		sticker ? std::make_optional(int64(kWebmStickerLimit)) : std::nullopt,
+		std::move(alive));
+}
+
+Tgs BuildTgs(
+		const QByteArray &model,
+		const QByteArray &symbol,
+		const Colors &colors,
+		const Options &options,
+		const Texts &texts,
+		const Motion &motion,
+		TgsBudget budget) {
+	const auto canvas = options.canvas;
+	if (canvas.isEmpty()) {
+		return { .error = Lower(u"The canvas is empty."_q) };
+	}
+	const auto instance = Lottie::Instance::Create(
+		Lottie::ReadUtf8(model),
+		nullptr);
+	if (!instance) {
+		return { .error = Lower(u"The model doesn't load."_q) };
+	}
+	auto fixes = QStringList();
+	const auto side = float64(kStickerSide);
+	const auto full = QRectF(0., 0., side, side);
+	const auto fit = canvas.scaled(
+		kStickerSide,
+		kStickerSide,
+		Qt::KeepAspectRatio).expandedTo(QSize(1, 1));
+	const auto offset = QPointF(
+		(side - fit.width()) / 2.,
+		(side - fit.height()) / 2.);
+	if (canvas != QSize(kStickerSide, kStickerSide)) {
+		fixes.push_back(Lower(u"fitted %1 \u00D7 %2 into 512 \u00D7 512"_q)
+			.arg(canvas.width())
+			.arg(canvas.height()));
+	}
+	auto fitted = options;
+	fitted.canvas = fit;
+	const auto layout = ComputeLayout(QSizeF(fit), fitted, texts);
+	const auto &background = options.background;
+	const auto custom = (background.kind == BackgroundKind::Custom);
+	const auto sticker = (options.layout == LayoutKind::Sticker);
+	auto geometry = TgsGeometry{
+		.width = side,
+		.height = side,
+		.modelCenter = layout.model.center() + offset,
+		.modelSide = layout.model.width(),
+		.background = !sticker
+			&& (background.kind != BackgroundKind::Transparent),
+		.linear = custom && background.linear,
+		.first = custom ? background.first : colors.center,
+		.second = custom ? background.second : colors.edge,
+		.gradientCenter = layout.gradientCenter + offset,
+		.gradientRadius = layout.gradientRadius,
+		.gradientFrom = layout.gradientFrom + offset,
+		.gradientTill = layout.gradientTill + offset,
+		.content = sticker
+			? QRectF(offset, QSizeF(fit))
+			: layout.content.translated(offset),
+		.radius = sticker ? 0. : layout.radius,
+		.decimals = budget.decimals,
+		.textDecimals = budget.simpleText ? 0 : 1,
+	};
+	if (!sticker) {
+		auto edge = QPainterPath();
+		edge.addRoundedRect(
+			geometry.content,
+			geometry.radius,
+			geometry.radius);
+		const auto clipped = (geometry.radius > 0.)
+			|| !geometry.content.contains(full);
+		auto dropped = 0;
+		for (const auto &point : layout.points) {
+			const auto center = point.center + offset;
+			const auto half = point.side / 2.;
+			const auto bounds = QRectF(
+				center.x() - half,
+				center.y() - half,
+				point.side,
+				point.side);
+			if (clipped && !edge.contains(bounds)) {
+				++dropped;
+				continue;
+			} else if (budget.maxPoints >= 0
+				&& int(geometry.points.size()) >= budget.maxPoints) {
+				continue;
+			}
+			geometry.points.push_back({
+				.x = center.x(),
+				.y = center.y(),
+				.side = point.side,
+				.opacity = point.opacity,
+			});
+		}
+		if (dropped) {
+			fixes.push_back(Lower(u"left out %1 pattern symbols that "
+				"crossed the edge, TGS has no clipping"_q).arg(dropped));
+		}
+		if (budget.maxPoints >= 0) {
+			fixes.push_back(Lower(u"kept %1 pattern symbols"_q)
+				.arg(geometry.points.size()));
+		}
+	}
+	if (options.text.tgs && budget.text) {
+		auto renderer = Renderer();
+		renderer.setColors(colors);
+		renderer.setTexts(texts);
+		renderer.setOptions(fitted);
+		for (auto &shape : renderer.overlayShapes(fit)) {
+			geometry.overlay.push_back({
+				.path = shape.path.translated(offset),
+				.color = shape.color,
+			});
+		}
+		if (budget.simpleText && !geometry.overlay.empty()) {
+			fixes.push_back(Lower(u"simplified the text outlines"_q));
+		}
+	} else if (options.text.tgs && !budget.text) {
+		fixes.push_back(Lower(u"left out the text"_q));
+	}
+	if (budget.decimals >= 0) {
+		fixes.push_back(Lower(u"rounded numbers to %1 decimals"_q)
+			.arg(budget.decimals));
+	}
+
+	const auto frames = instance->framesCount();
+	const auto rate = instance->frameRate();
+	geometry.rate = rate;
+	auto total = frames;
+	if (!IdentityMotion(motion, frames)) {
+		const auto from = std::clamp(motion.from, 0, frames - 1);
+		const auto till = (motion.till < 0)
+			? (frames - 1)
+			: std::clamp(motion.till, from, frames - 1);
+		const auto speed = std::clamp(motion.speed, 0.05, 20.);
+		const auto scale = 1. / speed;
+		const auto pingPong = motion.pingPong && (till > from);
+		const auto length = pingPong
+			? std::max(base::SafeRound((till - from) * scale), 1.)
+			: std::max(base::SafeRound((till - from + 1) * scale), 1.);
+		geometry.timing = TgsTiming{
+			.scale = scale,
+			.from = from * scale,
+			.length = length,
+			.pivot = till * scale + length,
+			.retime = true,
+			.pingPong = pingPong,
+		};
+		total = int(pingPong ? (2 * length) : length);
+		fixes.push_back(pingPong
+			? Lower(u"baked the speed, range and ping-pong into "
+				"keyframes"_q)
+			: Lower(u"baked the speed and range into keyframes"_q));
+	}
+	if (total > kTgsMaxFrames) {
+		fixes.push_back(Lower(u"cut to 3 seconds (%1 of %2 frames)"_q)
+			.arg(kTgsMaxFrames)
+			.arg(total));
+		total = kTgsMaxFrames;
+	}
+	geometry.frames = total;
+	const auto json = MergeTgsJson(model, symbol, colors.pattern, geometry);
+	if (json.isEmpty()) {
+		return { .error = Lower(u"Couldn't merge the parts."_q) };
+	}
+	auto result = Gzip(json);
+	if (result.isEmpty()) {
+		return { .error = Lower(u"Couldn't compress the TGS."_q) };
+	} else if (!CheckTgs(result, geometry)) {
+		LOG(("Tele Gift Studio Error: merged tgs failed the self-check."));
+		return { .error = Lower(u"The TGS failed the self-check."_q) };
+	}
+	auto report = CheckTgsSticker(result);
+	return {
+		.bytes = std::move(result),
+		.budget = budget,
+		.report = std::move(report),
+		.fixes = std::move(fixes),
+	};
+}
+
+Tgs FitTgs(
+		const QByteArray &model,
+		const QByteArray &symbol,
+		const Colors &colors,
+		const Options &options,
+		const Texts &texts,
+		const Motion &motion,
+		int64 limit) {
+	const auto budgets = std::array{
+		TgsBudget{ .decimals = 3 },
+		TgsBudget{ .decimals = 2 },
+		TgsBudget{ .decimals = 2, .simpleText = true },
+		TgsBudget{ .decimals = 2, .text = false },
+		TgsBudget{ .decimals = 2, .maxPoints = 18, .text = false },
+		TgsBudget{ .decimals = 2, .maxPoints = 8, .text = false },
+		TgsBudget{ .decimals = 2, .maxPoints = 0, .text = false },
+	};
+	auto last = Tgs();
+	for (const auto &budget : budgets) {
+		last = BuildTgs(
+			model,
+			symbol,
+			colors,
+			options,
+			texts,
+			motion,
+			budget);
+		if (!last.bytes.isEmpty() && last.bytes.size() <= limit) {
+			return last;
+		}
+	}
+	return {
+		.error = last.bytes.isEmpty()
+			? last.error
+			: Lower(u"Even the smallest TGS is %1 KB, over the %2 KB "
+				"limit: try WebM (256 KB)."_q)
+				.arg((last.bytes.size() + 1023) / 1024)
+				.arg(limit / 1024),
+	};
+}
+
+} // namespace Tele::GiftStudio
