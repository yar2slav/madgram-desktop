+	const Animation &animation,
+	Fn<bool()> alive);
+[[nodiscard]] QByteArray EncodeWebm(
+	Animation animation,
+	bool sticker,
+	Fn<bool()> alive);
+[[nodiscard]] Tgs BuildTgs(
+	const QByteArray &model,
+	const QByteArray &symbol,
+	const Colors &colors,
+	const Options &options,
+	const Texts &texts,
+	const Motion &motion,
+	TgsBudget budget = TgsBudget());
+[[nodiscard]] Tgs FitTgs(
+	const QByteArray &model,
+	const QByteArray &symbol,
+	const Colors &colors,
+	const Options &options,
+	const Texts &texts,
+	const Motion &motion,
+	int64 limit);
+
