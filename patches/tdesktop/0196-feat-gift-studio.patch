+void AddGiftStudio(SectionBuilder &builder) {
+	const auto id = u"tele-gift-studio"_q;
+	const auto controller = builder.controller();
+	const auto offline = ::Tele::OfflineForLaunch();
+	const auto description = ::Tele::Lower(offline
+		? u"Off for this launch: it downloads the parts from api.changes.tg."_q
+		: u"Downloads the parts from api.changes.tg."_q);
+	const auto button = AddButton(builder, {
+		.id = id,
+		.title = rpl::single(::Tele::Lower(u"Gift studio"_q)),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [=] {
+			if (!::Tele::OfflineForLaunch()) {
+				::Tele::ShowGiftStudio(controller);
+			}
+		},
+		.keywords = {
+			u"studio"_q,
+			u"model"_q,
+			u"backdrop"_q,
+			u"symbol"_q,
+			u"render"_q,
+			description,
+		},
+	});
+	if (button) {
+		SetupLink(button, id);
+		if (offline) {
+			rpl::single(rpl::empty) | rpl::then(
+				style::PaletteChanged()
+			) | rpl::on_next([=] {
+				button->setDisabled(true);
+				button->setColorOverride(st::windowSubTextFg->c);
+			}, button->lifetime());
+		}
+	}
+	AddAbout(builder, id, description);
+}
