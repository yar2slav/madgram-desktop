+[[nodiscard]] QString NumberText(QString text) {
+	text = text.trimmed();
+	while (text.startsWith('#')) {
+		text = text.mid(1).trimmed();
+	}
+	if (text.isEmpty()) {
+		return QString();
+	}
+	auto ok = false;
+	const auto value = text.toLongLong(&ok);
+	return '#' + ((ok && value >= 0 && text[0].isDigit())
+		? Lang::FormatCountDecimal(value)
+		: text);
+}
