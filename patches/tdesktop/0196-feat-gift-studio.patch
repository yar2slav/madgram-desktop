+[[nodiscard]] PendingPrefill &Pending() {
+	static auto result = PendingPrefill();
+	return result;
+}
+
+[[nodiscard]] std::optional<GiftListPrefill> TakePrefill(
+		not_null<PeerData*> peer) {
+	auto &pending = Pending();
+	if (!pending.session) {
+		return std::nullopt;
+	}
+	const auto expired = (crl::now() - pending.time > kPrefillTimeout);
+	const auto matches = (pending.session == &peer->session())
+		&& (pending.peerId == peer->id);
+	if (!expired && !matches) {
+		return std::nullopt;
+	}
+	auto result = base::take(pending).prefill;
+	return expired ? std::nullopt : std::make_optional(std::move(result));
+}
