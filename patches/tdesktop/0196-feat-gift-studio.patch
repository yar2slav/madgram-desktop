@@ -0,0 +1,2160 @@
+#include "tele/tele_gift_studio_export.h"
+
+#include "lottie/details/lottie_instance.h"
+#include "lottie/lottie_common.h"
+#include "tele/tele_gift_studio_sticker.h"
+#include "tele/tele_gift_studio_video.h"
+#include "tele/tele_lowercase.h"
+#include "ui/image/image_prepare.h"
+
+#include <QtCore/QBuffer>
+#include <QtCore/QCryptographicHash>
+#include <QtGui/QPainterPath>
+#include <QtGui/QImageReader>
+
+#include <zlib.h>
+
+namespace Tele::GiftStudio {
+namespace {
+
+constexpr auto kMaxMacroblocks = 36864;
+constexpr auto kMacroblock = 16;
+constexpr auto kCheckSide = 256;
+
+constexpr auto kMaxDepth = 256;
+constexpr auto kColors = 255;
+constexpr auto kTransparent = 255;
+constexpr auto kBins = 32 * 32 * 32;
+constexpr auto kHistogramPixels = 24. * 1024 * 1024;
+
+struct Json {
+	enum class Type : uchar {
+		Scalar,
+		Array,
+		Object,
+	};
+
+	Type type = Type::Scalar;
+	QByteArray raw;
+	std::vector<Json> items;
+	std::vector<std::pair<QByteArray, Json>> fields;
+
+	[[nodiscard]] Json *find(const QByteArray &key) {
+		for (auto &[name, value] : fields) {
+			if (name == key) {
+				return &value;
+			}
+		}
+		return nullptr;
+	}
+	[[nodiscard]] const Json *find(const QByteArray &key) const {
+		return const_cast<Json*>(this)->find(key);
+	}
+	void set(const QByteArray &key, Json value) {
+		if (const auto existing = find(key)) {
+			*existing = std::move(value);
+		} else {
+			fields.emplace_back(key, std::move(value));
+		}
+	}
+	void remove(const QByteArray &key) {
+		fields.erase(ranges::remove(fields, key, [](const auto &pair) {
+			return pair.first;
+		}), end(fields));
+	}
+	[[nodiscard]] QByteArray text() const {
+		return (raw.size() >= 2 && raw.startsWith('"'))
+			? raw.mid(1, raw.size() - 2)
+			: raw;
+	}
+	[[nodiscard]] double number(double fallback) const {
+		auto ok = false;
+		const auto result = raw.toDouble(&ok);
+		return ok ? result : fallback;
+	}
+};
+
+class JsonParser final {
+public:
+	explicit JsonParser(const QByteArray &data) : _data(data) {
+	}
+
+	[[nodiscard]] std::optional<Json> parse() {
+		auto result = Json();
+		if (!value(result, 0)) {
+			return std::nullopt;
+		}
+		skip();
+		return (_index == _data.size())
+			? std::make_optional(std::move(result))
+			: std::nullopt;
+	}
+
+private:
+	[[nodiscard]] bool atEnd() const {
+		return _index >= _data.size();
+	}
+	[[nodiscard]] char current() const {
+		return _data[_index];
+	}
+	void skip() {
+		while (!atEnd()) {
+			const auto ch = current();
+			if (ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t') {
+				break;
+			}
+			++_index;
+		}
+	}
+	[[nodiscard]] bool string(QByteArray &raw) {
+		if (atEnd() || current() != '"') {
+			return false;
+		}
+		const auto start = _index++;
+		while (!atEnd()) {
+			const auto ch = _data[_index++];
+			if (ch == '\\') {
+				++_index;
+			} else if (ch == '"') {
+				raw = _data.mid(start, _index - start);
+				return true;
+			}
+		}
+		return false;
+	}
+	[[nodiscard]] bool scalar(QByteArray &raw) {
+		const auto start = _index;
+		while (!atEnd()) {
+			const auto ch = current();
+			if ((ch >= '0' && ch <= '9')
+				|| (ch >= 'a' && ch <= 'z')
+				|| ch == '-'
+				|| ch == '+'
+				|| ch == '.'
+				|| ch == 'E') {
+				++_index;
+			} else {
+				break;
+			}
+		}
+		raw = _data.mid(start, _index - start);
+		return !raw.isEmpty();
+	}
+	[[nodiscard]] bool separator(char closing, bool &closed) {
+		skip();
+		if (atEnd()) {
+			return false;
+		} else if (current() == ',') {
+			++_index;
+			return true;
+		} else if (current() == closing) {
+			++_index;
+			closed = true;
+			return true;
+		}
+		return false;
+	}
+	[[nodiscard]] bool value(Json &result, int depth) {
+		skip();
+		if (atEnd() || depth > kMaxDepth) {
+			return false;
+		}
+		const auto ch = current();
+		if (ch == '"') {
+			return string(result.raw);
+		} else if (ch != '{' && ch != '[') {
+			return scalar(result.raw);
+		}
+		const auto object = (ch == '{');
+		const auto closing = object ? '}' : ']';
+		result.type = object ? Json::Type::Object : Json::Type::Array;
+		++_index;
+		skip();
+		if (!atEnd() && current() == closing) {
+			++_index;
+			return true;
+		}
+		for (auto closed = false; !closed;) {
+			auto item = Json();
+			if (object) {
+				skip();
+				auto key = QByteArray();
+				if (!string(key)) {
+					return false;
+				}
+				skip();
+				if (atEnd() || current() != ':') {
+					return false;
+				}
+				++_index;
+				if (!value(item, depth + 1)) {
+					return false;
+				}
+				result.fields.emplace_back(
+					key.mid(1, key.size() - 2),
+					std::move(item));
+			} else {
+				if (!value(item, depth + 1)) {
+					return false;
+				}
+				result.items.push_back(std::move(item));
+			}
+			if (!separator(closing, closed)) {
+				return false;
+			}
+		}
+		return true;
+	}
+
+	const QByteArray &_data;
+	int _index = 0;
+
+};
+
+[[nodiscard]] QByteArray RoundNumber(const QByteArray &raw, int decimals) {
+	if (decimals < 0
+		|| raw.isEmpty()
+		|| raw.startsWith('"')
+		|| (raw.indexOf('.') < 0 && raw.indexOf('e') < 0
+			&& raw.indexOf('E') < 0)) {
+		return raw;
+	}
+	auto ok = false;
+	const auto value = raw.toDouble(&ok);
+	if (!ok) {
+		return raw;
+	}
+	auto result = QByteArray::number(value, 'f', decimals);
+	if (result.indexOf('.') >= 0) {
+		while (result.endsWith('0')) {
+			result.chop(1);
+		}
+		if (result.endsWith('.')) {
+			result.chop(1);
+		}
+	}
+	if (result == "-0") {
+		result = "0";
+	}
+	return result;
+}
+
+void WriteJson(QByteArray &out, const Json &value, int decimals = -1) {
+	switch (value.type) {
+	case Json::Type::Scalar:
+		out.append(RoundNumber(value.raw, decimals));
+		return;
+	case Json::Type::Array:
+		out.append('[');
+		for (auto i = 0; i != int(value.items.size()); ++i) {
+			if (i) {
+				out.append(',');
+			}
+			WriteJson(out, value.items[i], decimals);
+		}
+		out.append(']');
+		return;
+	case Json::Type::Object:
+		out.append('{');
+		for (auto i = 0; i != int(value.fields.size()); ++i) {
+			if (i) {
+				out.append(',');
+			}
+			out.append('"').append(value.fields[i].first).append("\":");
+			WriteJson(out, value.fields[i].second, decimals);
+		}
+		out.append('}');
+		return;
+	}
+}
+
+[[nodiscard]] Json JsonString(const QByteArray &text) {
+	auto result = Json();
+	result.raw = '"' + text + '"';
+	return result;
+}
+
+[[nodiscard]] Json JsonNumber(double value) {
+	auto result = Json();
+	result.raw = QByteArray::number(value, 'g', 12);
+	return result;
+}
+
+[[nodiscard]] Json JsonArray(std::vector<Json> items) {
+	auto result = Json();
+	result.type = Json::Type::Array;
+	result.items = std::move(items);
+	return result;
+}
+
+[[nodiscard]] Json JsonNumbers(std::initializer_list<double> values) {
+	auto items = std::vector<Json>();
+	items.reserve(values.size());
+	for (const auto value : values) {
+		items.push_back(JsonNumber(value));
+	}
+	return JsonArray(std::move(items));
+}
+
+[[nodiscard]] Json JsonObject(
+		std::vector<std::pair<QByteArray, Json>> fields) {
+	auto result = Json();
+	result.type = Json::Type::Object;
+	result.fields = std::move(fields);
+	return result;
+}
+
+[[nodiscard]] Json JsonStatic(Json value) {
+	return JsonObject({
+		{ "a", JsonNumber(0) },
+		{ "k", std::move(value) },
+	});
+}
+
+[[nodiscard]] Json TakeArray(Json &object, const QByteArray &key) {
+	const auto found = object.find(key);
+	return (found && found->type == Json::Type::Array)
+		? std::move(*found)
+		: JsonArray({});
+}
+
+void PrefixLayers(Json &layers, const QByteArray &prefix) {
+	for (auto &layer : layers.items) {
+		if (const auto ref = layer.find("refId")) {
+			*ref = JsonString(prefix + ref->text());
+		}
+	}
+}
+
+void PrefixAssets(Json &assets, const QByteArray &prefix) {
+	for (auto &asset : assets.items) {
+		if (const auto id = asset.find("id")) {
+			*id = JsonString(prefix + id->text());
+		}
+		if (const auto layers = asset.find("layers")) {
+			PrefixLayers(*layers, prefix);
+		}
+	}
+}
+
+void TintJson(Json &value, const Json &color, int depth = 0) {
+	if (depth > kMaxDepth) {
+		return;
+	}
+	for (auto &item : value.items) {
+		TintJson(item, color, depth + 1);
+	}
+	for (auto &[key, field] : value.fields) {
+		TintJson(field, color, depth + 1);
+	}
+	const auto type = value.find("ty");
+	if (!type) {
+		return;
+	}
+	const auto kind = type->text();
+	const auto fill = (kind == "fl" || kind == "gf");
+	const auto stroke = (kind == "st" || kind == "gs");
+	if (!fill && !stroke) {
+		return;
+	}
+	if (kind == "gf" || kind == "gs") {
+		*type = JsonString(fill ? "fl" : "st");
+		for (const auto key : { "g", "s", "e", "t", "h", "a" }) {
+			value.remove(key);
+		}
+	}
+	value.set("c", color);
+}
+
+struct Histogram {
+	std::vector<uint64> count = std::vector<uint64>(kBins);
+	std::vector<uint64> red = std::vector<uint64>(kBins);
+	std::vector<uint64> green = std::vector<uint64>(kBins);
+	std::vector<uint64> blue = std::vector<uint64>(kBins);
+};
+
+[[nodiscard]] int Bin(int r, int g, int b) {
+	return ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3);
+}
+
+[[nodiscard]] uint32 Straight(uint32 pixel) {
+	const auto alpha = pixel >> 24;
+	return (alpha == 0xFF || !alpha) ? pixel : qUnpremultiply(pixel);
+}
+
+[[nodiscard]] bool Hidden(const QImage &base, int x, int y) {
+	return (reinterpret_cast<const uint32*>(base.constScanLine(y))[x] >> 24)
+		< 0x80;
+}
+
+void Accumulate(
+		Histogram &histogram,
+		const QImage &base,
+		const QImage &image,
+		QPoint origin,
+		QRect rect,
+		QRect skip,
+		int stride,
+		uint64 weight) {
+	for (auto y = rect.y(); y < rect.y() + rect.height(); y += stride) {
+		const auto line = reinterpret_cast<const uint32*>(
+			image.constScanLine(y - origin.y()));
+		for (auto x = rect.x(); x < rect.x() + rect.width(); x += stride) {
+			if (skip.contains(x, y) || Hidden(base, x, y)) {
+				continue;
+			}
+			const auto pixel = Straight(line[x - origin.x()]);
+			const auto r = int((pixel >> 16) & 0xFF);
+			const auto g = int((pixel >> 8) & 0xFF);
+			const auto b = int(pixel & 0xFF);
+			const auto bin = Bin(r, g, b);
+			histogram.count[bin] += weight;
+			histogram.red[bin] += r * weight;
+			histogram.green[bin] += g * weight;
+			histogram.blue[bin] += b * weight;
+		}
+	}
+}
+
+struct ColorBox {
+	std::vector<int> bins;
+	uint64 weight = 0;
+	std::array<int, 3> low = {};
+	std::array<int, 3> high = {};
+};
+
+[[nodiscard]] int BinChannel(int bin, int channel) {
+	return (bin >> (10 - 5 * channel)) & 0x1F;
+}
+
+void MeasureBox(ColorBox &box, const Histogram &histogram) {
+	box.weight = 0;
+	box.low = { 31, 31, 31 };
+	box.high = { 0, 0, 0 };
+	for (const auto bin : box.bins) {
+		box.weight += histogram.count[bin];
+		for (auto channel = 0; channel != 3; ++channel) {
+			const auto value = BinChannel(bin, channel);
+			box.low[channel] = std::min(box.low[channel], value);
+			box.high[channel] = std::max(box.high[channel], value);
+		}
+	}
+}
+
+[[nodiscard]] std::vector<std::array<uchar, 3>> MedianCut(
+		const Histogram &histogram) {
+	auto all = ColorBox();
+	for (auto bin = 0; bin != kBins; ++bin) {
+		if (histogram.count[bin]) {
+			all.bins.push_back(bin);
+		}
+	}
+	MeasureBox(all, histogram);
+	auto boxes = std::vector<ColorBox>();
+	boxes.push_back(std::move(all));
+	while (int(boxes.size()) < kColors) {
+		auto best = -1;
+		auto bestScore = 0.;
+		for (auto i = 0; i != int(boxes.size()); ++i) {
+			const auto &box = boxes[i];
+			if (box.bins.size() < 2) {
+				continue;
+			}
+			auto range = 0;
+			for (auto channel = 0; channel != 3; ++channel) {
+				range = std::max(range, box.high[channel] - box.low[channel]);
+			}
+			const auto score = double(box.weight) * (range + 1);
+			if (best < 0 || score > bestScore) {
+				best = i;
+				bestScore = score;
+			}
+		}
+		if (best < 0) {
+			break;
+		}
+		auto &box = boxes[best];
+		auto channel = 0;
+		for (auto i = 1; i != 3; ++i) {
+			if (box.high[i] - box.low[i]
+				> box.high[channel] - box.low[channel]) {
+				channel = i;
+			}
+		}
+		ranges::sort(box.bins, ranges::less(), [&](int bin) {
+			return BinChannel(bin, channel);
+		});
+		auto accumulated = uint64(0);
+		auto split = 1;
+		for (; split < int(box.bins.size()) - 1; ++split) {
+			accumulated += histogram.count[box.bins[split - 1]];
+			if (accumulated * 2 >= box.weight) {
+				break;
+			}
+		}
+		auto second = ColorBox();
+		second.bins.assign(box.bins.begin() + split, box.bins.end());
+		box.bins.resize(split);
+		MeasureBox(box, histogram);
+		MeasureBox(second, histogram);
+		boxes.push_back(std::move(second));
+	}
+	auto result = std::vector<std::array<uchar, 3>>();
+	result.reserve(boxes.size());
+	for (const auto &box : boxes) {
+		auto red = uint64(0);
+		auto green = uint64(0);
+		auto blue = uint64(0);
+		for (const auto bin : box.bins) {
+			red += histogram.red[bin];
+			green += histogram.green[bin];
+			blue += histogram.blue[bin];
+		}
+		const auto weight = std::max(box.weight, uint64(1));
+		result.push_back({
+			uchar((red + weight / 2) / weight),
+			uchar((green + weight / 2) / weight),
+			uchar((blue + weight / 2) / weight),
+		});
+	}
+	if (result.empty()) {
+		result.push_back({ 0, 0, 0 });
+	}
+	return result;
+}
+
+class ColorMapper final {
+public:
+	explicit ColorMapper(std::vector<std::array<uchar, 3>> palette)
+	: _palette(std::move(palette))
+	, _lookup(kBins, -1) {
+	}
+
+	[[nodiscard]] uchar map(uint32 premultiplied, int x, int y) {
+		const auto pixel = Straight(premultiplied);
+		static constexpr auto kBayer = std::array<int, 64>{
+			0, 32, 8, 40, 2, 34, 10, 42,
+			48, 16, 56, 24, 50, 18, 58, 26,
+			12, 44, 4, 36, 14, 46, 6, 38,
+			60, 28, 52, 20, 62, 30, 54, 22,
+			3, 35, 11, 43, 1, 33, 9, 41,
+			51, 19, 59, 27, 49, 17, 57, 25,
+			15, 47, 7, 39, 13, 45, 5, 37,
+			63, 31, 55, 23, 61, 29, 53, 21,
+		};
+		const auto shift = kBayer[((y & 7) << 3) | (x & 7)] / 8 - 4;
+		const auto r = std::clamp(int((pixel >> 16) & 0xFF) + shift, 0, 255);
+		const auto g = std::clamp(int((pixel >> 8) & 0xFF) + shift, 0, 255);
+		const auto b = std::clamp(int(pixel & 0xFF) + shift, 0, 255);
+		const auto bin = Bin(r, g, b);
+		auto &cached = _lookup[bin];
+		if (cached < 0) {
+			cached = nearest(bin);
+		}
+		return uchar(cached);
+	}
+
+	[[nodiscard]] const std::vector<std::array<uchar, 3>> &palette() const {
+		return _palette;
+	}
+
+private:
+	[[nodiscard]] int nearest(int bin) const {
+		const auto r = (BinChannel(bin, 0) << 3) | 4;
+		const auto g = (BinChannel(bin, 1) << 3) | 4;
+		const auto b = (BinChannel(bin, 2) << 3) | 4;
+		auto result = 0;
+		auto distance = std::numeric_limits<int>::max();
+		for (auto i = 0; i != int(_palette.size()); ++i) {
+			const auto &color = _palette[i];
+			const auto dr = r - color[0];
+			const auto dg = g - color[1];
+			const auto db = b - color[2];
+			const auto current = 2 * dr * dr + 4 * dg * dg + 3 * db * db;
+			if (current < distance) {
+				distance = current;
+				result = i;
+			}
+		}
+		return result;
+	}
+
+	std::vector<std::array<uchar, 3>> _palette;
+	std::vector<int16> _lookup;
+
+};
+
+void AppendShort(QByteArray &out, int value) {
+	out.append(char(value & 0xFF));
+	out.append(char((value >> 8) & 0xFF));
+}
+
+void AppendLzw(QByteArray &out, const uchar *data, int count) {
+	constexpr auto kMinCodeSize = 8;
+	constexpr auto kMaxBits = 12;
+	constexpr auto kMaxCode = 1 << kMaxBits;
+	constexpr auto kHashSize = 5003;
+	const auto clearCode = 1 << kMinCodeSize;
+	const auto endCode = clearCode + 1;
+
+	auto packed = QByteArray();
+	packed.reserve(count);
+	auto accumulator = uint32(0);
+	auto bits = 0;
+	auto codeSize = kMinCodeSize + 1;
+	auto maxCode = (1 << codeSize) - 1;
+	auto freeCode = clearCode + 2;
+	auto clearFlag = false;
+	auto keys = std::vector<int32>(kHashSize, -1);
+	auto codes = std::vector<int32>(kHashSize, 0);
+	auto hashShift = 0;
+	for (auto size = kHashSize; size < 65536; size *= 2) {
+		++hashShift;
+	}
+	hashShift = 8 - hashShift;
+
+	const auto output = [&](int code) {
+		accumulator |= uint32(code) << bits;
+		bits += codeSize;
+		while (bits >= 8) {
+			packed.append(char(accumulator & 0xFF));
+			accumulator >>= 8;
+			bits -= 8;
+		}
+		if (freeCode > maxCode || clearFlag) {
+			if (clearFlag) {
+				codeSize = kMinCodeSize + 1;
+				maxCode = (1 << codeSize) - 1;
+				clearFlag = false;
+			} else {
+				++codeSize;
+				maxCode = (codeSize == kMaxBits)
+					? kMaxCode
+					: ((1 << codeSize) - 1);
+			}
+		}
+	};
+
+	output(clearCode);
+	if (count > 0) {
+		auto prefix = int(data[0]);
+		for (auto index = 1; index < count; ++index) {
+			const auto symbol = int(data[index]);
+			const auto key = (symbol << kMaxBits) + prefix;
+			auto slot = (symbol << hashShift) ^ prefix;
+			if (keys[slot] == key) {
+				prefix = codes[slot];
+				continue;
+			}
+			auto found = false;
+			if (keys[slot] >= 0) {
+				const auto step = slot ? (kHashSize - slot) : 1;
+				do {
+					slot -= step;
+					if (slot < 0) {
+						slot += kHashSize;
+					}
+					if (keys[slot] == key) {
+						found = true;
+						break;
+					}
+				} while (keys[slot] >= 0);
+			}
+			if (found) {
+				prefix = codes[slot];
+				continue;
+			}
+			output(prefix);
+			prefix = symbol;
+			if (freeCode < kMaxCode) {
+				codes[slot] = freeCode++;
+				keys[slot] = key;
+			} else {
+				ranges::fill(keys, -1);
+				freeCode = clearCode + 2;
+				clearFlag = true;
+				output(clearCode);
+			}
+		}
+		output(prefix);
+	}
+	output(endCode);
+	if (bits > 0) {
+		packed.append(char(accumulator & 0xFF));
+	}
+
+	out.append(char(kMinCodeSize));
+	for (auto offset = 0; offset < packed.size(); offset += 255) {
+		const auto size = std::min(255, int(packed.size()) - offset);
+		out.append(char(size));
+		out.append(packed.constData() + offset, size);
+	}
+	out.append(char(0));
+}
+
+void AppendGifHeader(
+		QByteArray &out,
+		QSize size,
+		const std::vector<std::array<uchar, 3>> &palette) {
+	out.append("GIF89a");
+	AppendShort(out, size.width());
+	AppendShort(out, size.height());
+	out.append(char(0xF7));
+	out.append(char(0));
+	out.append(char(0));
+	for (auto i = 0; i != 256; ++i) {
+		const auto color = (i < int(palette.size()))
+			? palette[i]
+			: std::array<uchar, 3>{ 0, 0, 0 };
+		out.append(char(color[0]));
+		out.append(char(color[1]));
+		out.append(char(color[2]));
+	}
+	out.append(char(0x21));
+	out.append(char(0xFF));
+	out.append(char(0x0B));
+	out.append("NETSCAPE2.0");
+	out.append(char(0x03));
+	out.append(char(0x01));
+	AppendShort(out, 0);
+	out.append(char(0));
+}
+
+void AppendGifFrame(
+		QByteArray &out,
+		QRect rect,
+		const uchar *indices,
+		int delay,
+		bool transparent) {
+	out.append(char(0x21));
+	out.append(char(0xF9));
+	out.append(char(0x04));
+	out.append(char((1 << 2) | (transparent ? 1 : 0)));
+	AppendShort(out, delay);
+	out.append(char(transparent ? kTransparent : 0));
+	out.append(char(0));
+	out.append(char(0x2C));
+	AppendShort(out, rect.x());
+	AppendShort(out, rect.y());
+	AppendShort(out, rect.width());
+	AppendShort(out, rect.height());
+	out.append(char(0));
+	AppendLzw(out, indices, rect.width() * rect.height());
+}
+
+[[nodiscard]] QByteArray EncodeGifFrames(
+		const QImage &base,
+		QRect area,
+		int count,
+		Fn<QImage(int)> frame,
+		const std::vector<int> &delays,
+		Fn<bool()> alive) {
+	const auto size = base.size();
+	if (count <= 0
+		|| int(delays.size()) != count
+		|| size.isEmpty()
+		|| area.isEmpty()
+		|| !QRect(QPoint(), size).contains(area)) {
+		return QByteArray();
+	}
+	const auto pixels = float64(area.width()) * area.height() * count
+		+ float64(size.width()) * size.height();
+	const auto stride = std::max(
+		int(std::sqrt(pixels / kHistogramPixels)),
+		1);
+	auto histogram = Histogram();
+	Accumulate(
+		histogram,
+		base,
+		base,
+		QPoint(),
+		QRect(QPoint(), size),
+		area,
+		stride,
+		uint64(count));
+	for (auto index = 0; index != count; ++index) {
+		const auto image = frame(index);
+		if (image.size() != area.size()
+			|| (alive && !alive())) {
+			return QByteArray();
+		}
+		Accumulate(
+			histogram,
+			base,
+			image,
+			area.topLeft(),
+			area,
+			QRect(),
+			stride,
+			1);
+	}
+	auto mapper = ColorMapper(MedianCut(histogram));
+
+	auto hidden = false;
+	auto canvas = std::vector<uchar>(size.width() * size.height());
+	for (auto y = 0; y != size.height(); ++y) {
+		const auto line = reinterpret_cast<const uint32*>(
+			base.constScanLine(y));
+		for (auto x = 0; x != size.width(); ++x) {
+			const auto transparent = ((line[x] >> 24) < 0x80);
+			hidden |= transparent;
+			canvas[y * size.width() + x] = transparent
+				? uchar(kTransparent)
+				: mapper.map(line[x], x, y);
+		}
+	}
+	auto result = QByteArray();
+	AppendGifHeader(result, size, mapper.palette());
+	auto changed = std::vector<uchar>(area.width() * area.height());
+	for (auto index = 0; index != count; ++index) {
+		const auto image = frame(index);
+		if (image.size() != area.size()) {
+			return QByteArray();
+		}
+		auto left = area.width();
+		auto top = area.height();
+		auto right = -1;
+		auto bottom = -1;
+		for (auto y = 0; y != area.height(); ++y) {
+			const auto line = reinterpret_cast<const uint32*>(
+				image.constScanLine(y));
+			for (auto x = 0; x != area.width(); ++x) {
+				const auto cx = area.x() + x;
+				const auto cy = area.y() + y;
+				const auto value = Hidden(base, cx, cy)
+					? uchar(kTransparent)
+					: mapper.map(line[x], cx, cy);
+				const auto offset = y * area.width() + x;
+				auto &old = canvas[cy * size.width() + cx];
+				if (index && old == value) {
+					changed[offset] = kTransparent;
+				} else {
+					changed[offset] = value;
+					left = std::min(left, x);
+					top = std::min(top, y);
+					right = std::max(right, x);
+					bottom = std::max(bottom, y);
+				}
+				old = value;
+			}
+		}
+		const auto delay = delays[index];
+		if (!index) {
+			AppendGifFrame(
+				result,
+				QRect(QPoint(), size),
+				canvas.data(),
+				delay,
+				hidden);
+		} else if (right < 0) {
+			const auto pixel = uchar(kTransparent);
+			AppendGifFrame(result, QRect(0, 0, 1, 1), &pixel, delay, true);
+		} else {
+			const auto rect = QRect(
+				left,
+				top,
+				right - left + 1,
+				bottom - top + 1);
+			auto cropped = std::vector<uchar>(rect.width() * rect.height());
+			for (auto y = 0; y != rect.height(); ++y) {
+				memcpy(
+					cropped.data() + y * rect.width(),
+					changed.data() + (rect.y() + y) * area.width() + rect.x(),
+					rect.width());
+			}
+			AppendGifFrame(
+				result,
+				rect.translated(area.topLeft()),
+				cropped.data(),
+				delay,
+				true);
+		}
+		if (alive && !alive()) {
+			return QByteArray();
+		}
+	}
+	result.append(char(0x3B));
+	return result;
+}
