+[[nodiscard]] QString NormalizeName(QString text, bool loose) {
+	static constexpr auto kApostrophes = std::array<char16_t, 6>{
+		u'\u2019',
+		u'\u2018',
+		u'\u02BC',
+		u'\u00B4',
+		u'`',
+		u'\u2032',
+	};
+	for (const auto ch : kApostrophes) {
+		text.replace(QChar(ch), QChar('\''));
+	}
+	text = text.normalized(
+		QString::NormalizationForm_KC).toLower().simplified();
+	if (!loose) {
+		return text;
+	}
+	auto result = QString();
+	result.reserve(text.size());
+	for (const auto ch : text) {
+		if (ch.isLetterOrNumber()) {
+			result.append(ch);
+		}
+	}
+	return result;
+}
+
+template <typename List, typename Name>
+[[nodiscard]] int MatchName(
+		const List &list,
+		const QString &target,
+		Name &&name) {
+	if (target.trimmed().isEmpty()) {
+		return -1;
+	}
+	for (const auto loose : { false, true }) {
+		const auto wanted = NormalizeName(target, loose);
+		if (wanted.isEmpty()) {
+			continue;
+		}
+		for (auto i = 0; i != int(list.size()); ++i) {
+			if (NormalizeName(name(list[i]), loose) == wanted) {
+				return i;
+			}
+		}
+	}
+	return -1;
+}
+
+[[nodiscard]] QString ParseSlug(QString text) {
+	text = text.trimmed();
+	static const auto kLink = QRegularExpression(
+		u"^(?:(?:https?://)?(?:www\\.)?(?:t\\.me|telegram\\.me|telegram\\.dog)"
+		"/nft/|tg://nft\\?(?:.*&)?slug=|nft/)([A-Za-z0-9._\\-]+)"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	static const auto kSlug = QRegularExpression(
+		u"^([A-Za-z0-9._]+-\\d+)$"_q);
+	if (const auto match = kLink.match(text); match.hasMatch()) {
+		return match.captured(1);
+	} else if (const auto match = kSlug.match(text); match.hasMatch()) {
+		return match.captured(1);
+	}
+	return QString();
+}
+
+[[nodiscard]] int PickIndex(
+		const std::vector<int> &permilles,
+		bool weighted) {
+	const auto count = int(permilles.size());
+	if (!count) {
+		return -1;
+	} else if (!weighted) {
+		return base::RandomIndex(count);
+	}
+	auto total = uint64(0);
+	for (const auto permille : permilles) {
+		total += uint64(std::max(permille, 1));
+	}
+	auto value = base::RandomValue<uint64>() % total;
+	for (auto i = 0; i != count; ++i) {
+		const auto weight = uint64(std::max(permilles[i], 1));
+		if (value < weight) {
+			return i;
+		}
+		value -= weight;
+	}
+	return count - 1;
+}
