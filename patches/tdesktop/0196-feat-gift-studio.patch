+void GiftListSearch::State::prefill(const GiftListPrefill &data) {
+	const auto names = std::array<const QString*, kChipsCount>{
+		&data.model,
+		&data.backdrop,
+		&data.symbol,
+	};
+	for (auto i = 0; i != kChipsCount; ++i) {
+		if (!names[i]->isEmpty()) {
+			selected[i].emplace(*names[i]);
+		}
+	}
+	refreshChips();
+	load();
+	if (!data.query.isEmpty()) {
+		select->setQuery(data.query);
+		queryChanged(select->getQuery());
+	}
+}
