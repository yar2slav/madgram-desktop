diff --git a/Telegram/SourceFiles/tele/tele_gift_collection_link.cpp b/Telegram/SourceFiles/tele/tele_gift_collection_link.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e75341e2279b50b050290004820e292c3483a107
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_gift_collection_link.cpp
@@ -0,0 +1,80 @@
+#include "tele/tele_gift_collection_link.h"
+
+#include "boxes/share_box.h"
+#include "data/data_peer.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "tele/tele_notices.h"
+#include "ui/text/text_entity.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/widgets/menu/menu_add_action_callback_factory.h"
+#include "ui/widgets/popup_menu.h"
+#include "window/window_session_controller.h"
+#include "styles/style_chat_helpers.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] QString CollectionLink(not_null<PeerData*> peer, int id) {
+	const auto username = peer->username();
+	return username.isEmpty()
+		? QString()
+		: peer->session().createInternalLinkFull(
+			username + u"/c/"_q + QString::number(id));
+}
+
+void CopyCollectionLink(
+		not_null<Window::SessionController*> window,
+		const QString &url) {
+	TextUtilities::SetClipboardText({ url });
+	ShowTeleToast(window, {
+		.text = { tr::lng_channel_public_link_copied(tr::now) },
+		.iconLottie = u"toast/voip_invite"_q,
+		.iconLottieSize = st::toastLottieIconSize,
+	});
+}
+
+} // namespace
+
+void AddCollectionCopyLink(
+		const Ui::Menu::MenuCallback &addAction,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		int id) {
+	const auto url = CollectionLink(peer, id);
+	if (url.isEmpty()) {
+		return;
+	}
+	addAction(tr::lng_context_copy_link(tr::now), [=] {
+		CopyCollectionLink(window, url);
+	}, &st::menuIconLink);
+}
+
+void ShowCollectionLinkMenu(
+		base::unique_qptr<Ui::PopupMenu> &menu,
+		not_null<QWidget*> parent,
+		not_null<Window::SessionController*> window,
+		not_null<PeerData*> peer,
+		const QString &id) {
+	auto ok = false;
+	const auto collectionId = id.toInt(&ok);
+	if (menu || !ok || peer->canManageGifts()) {
+		return;
+	}
+	const auto url = CollectionLink(peer, collectionId);
+	if (url.isEmpty()) {
+		return;
+	}
+	menu = base::make_unique_q<Ui::PopupMenu>(
+		parent,
+		st::popupMenuWithIcons);
+	const auto addAction = Ui::Menu::CreateAddActionCallback(menu);
+	AddCollectionCopyLink(addAction, window, peer, collectionId);
+	addAction(tr::lng_gift_collection_share(tr::now), [=] {
+		FastShareLink(window, url);
+	}, &st::menuIconShare);
+	menu->popup(QCursor::pos());
+}
+
+} // namespace Tele
