--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_spoilers.cpp
@@ -0,0 +1,198 @@
+#include "tele/tele_spoilers.h"
+
+#include "core/application.h"
+#include "data/data_channel.h"
+#include "data/data_forum.h"
+#include "data/data_forum_topic.h"
+#include "data/data_media_types.h"
+#include "data/data_peer.h"
+#include "data/data_photo.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "history/view/history_view_item_preview.h"
+#include "history/view/media/history_view_media.h"
+#include "history/view/media/history_view_media_spoiler.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/text/text.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kCompactThreshold = 256;
+
+using Views = std::unordered_map<
+	const HistoryView::Element*,
+	base::weak_ptr<HistoryView::Element>>;
+
+struct State {
+	State();
+
+	Views views;
+	size_t compactAt = kCompactThreshold;
+	rpl::lifetime lifetime;
+};
+
+template <typename Callback>
+void EnumerateSessions(Callback &&callback) {
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			callback(not_null<Main::Session*>(session));
+		}
+	}
+}
+
+void InvalidatePreview(not_null<Data::Thread*> thread) {
+	if (const auto item = thread->chatListMessage()) {
+		thread->lastItemDialogsView().itemInvalidated(item);
+		thread->updateChatListEntry();
+	}
+}
+
+void InvalidatePreviews(not_null<Main::Session*> session) {
+	const auto owner = &session->data();
+	const auto invalidate = [&](not_null<PeerData*> peer) {
+		const auto history = owner->historyLoaded(peer);
+		if (!history) {
+			return;
+		}
+		InvalidatePreview(history);
+		if (const auto forum = peer->forum()) {
+			forum->enumerateTopics([](not_null<Data::ForumTopic*> topic) {
+				InvalidatePreview(topic);
+			});
+		}
+	};
+	owner->enumerateUsers([&](not_null<UserData*> user) {
+		invalidate(user);
+	});
+	owner->enumerateGroups(invalidate);
+	owner->enumerateBroadcasts([&](not_null<ChannelData*> channel) {
+		invalidate(channel);
+	});
+}
+
+void RefreshAll(State &state) {
+	auto items = base::flat_set<not_null<HistoryItem*>>();
+	for (const auto &[key, weak] : base::take(state.views)) {
+		if (const auto view = weak.get()) {
+			items.emplace(view->data());
+		}
+	}
+	state.compactAt = kCompactThreshold;
+	for (const auto &item : items) {
+		item->history()->owner().requestItemViewRefresh(item);
+	}
+	EnumerateSessions(InvalidatePreviews);
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+State::State() {
+	RevealSpoilersChanges(
+	) | rpl::on_next([] {
+		RefreshAll(Get());
+	}, lifetime);
+}
+
+void Track(not_null<HistoryView::Element*> view) {
+	auto &state = Get();
+	auto &weak = state.views[view.get()];
+	if (weak.get() == view.get()) {
+		return;
+	}
+	weak = base::make_weak(view.get());
+	if (state.views.size() < state.compactAt) {
+		return;
+	}
+	for (auto i = begin(state.views); i != end(state.views);) {
+		if (i->second.get()) {
+			++i;
+		} else {
+			i = state.views.erase(i);
+		}
+	}
+	state.compactAt = std::max(
+		size_t(kCompactThreshold),
+		state.views.size() * 2);
+}
+
+[[nodiscard]] bool RevealsIn(not_null<HistoryView::Element*> view) {
+	return RevealSpoilers()
+		&& (view->delegate()->elementContext()
+			!= HistoryView::Context::ContactPreview);
+}
+
+} // namespace
+
+void RevealTextSpoilers(Ui::Text::String &text) {
+	if (RevealSpoilers() && text.hasSpoilers()) {
+		text.setSpoilerRevealed(true, anim::type::instant);
+	}
+}
+
+void RevealElementSpoilers(
+		not_null<HistoryView::Element*> view,
+		Ui::Text::String &text) {
+	if (!text.hasSpoilers()) {
+		if (view->data()->richPage()) {
+			Track(view);
+		}
+		return;
+	}
+	Track(view);
+	if (RevealsIn(view)) {
+		text.setSpoilerRevealed(true, anim::type::instant);
+	}
+}
+
+void RevealMediaSpoiler(
+		not_null<HistoryView::Media*> media,
+		not_null<HistoryItem*> item,
+		not_null<HistoryView::MediaSpoiler*> spoiler) {
+	const auto view = media->parent();
+	Track(view);
+	if (!RevealsIn(view)
+		|| item->isMediaSensitive()
+		|| item->isTtlCoveredMedia()) {
+		return;
+	} else if (const auto data = item->media(); data && data->ttlSeconds()) {
+		return;
+	} else if (const auto photo = media->getPhoto()
+		; photo && photo->extendedMediaPreview()) {
+		return;
+	}
+	spoiler->revealed = true;
+}
+
+void RevealPreviewSpoilers(
+		not_null<const HistoryItem*> item,
+		Ui::Text::String &text) {
+	Get();
+	if (!item->out()) {
+		const auto peer = item->history()->peer;
+		if (peer->isNotificationsUser() || peer->isVerifyCodes()) {
+			return;
+		}
+	}
+	RevealTextSpoilers(text);
+}
+
+bool RevealPreviewSpoiler(
+		not_null<const Data::Media*> media,
+		const HistoryView::ToPreviewOptions &options) {
+	return options.revealSpoilers && !media->ttlSeconds();
+}
+
+} // namespace Tele
