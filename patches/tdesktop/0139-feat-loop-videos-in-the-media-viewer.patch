+
 void MigrateHideCalls() {
 	if (!HideCallsOption.value()) {
 		return;
@@ -1792,4 +1798,22 @@ rpl::producer<> UncountedAccountsChanges() {
 	return UncountedAccountsOption.changes();
 }
 
+bool ViewerLoop() {
+	return ViewerLoopOption.value();
+}
+
+void SetViewerLoop(bool enabled) {
+	ViewerLoopOption.set(enabled);
+}
+
+rpl::producer<bool> ViewerLoopValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		ViewerLoopOption.changes()
+	) | rpl::map([] {
+		return ViewerLoopOption.value();
+	});
+}
