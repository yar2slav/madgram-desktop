--- a/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
+++ b/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
@@ -5388,6 +5388,19 @@ void OverlayWidget::handleStreamingUpdate(Streaming::Update &&update) {
 		updatePlaybackState();
 		if (base::take(_ttlDeferredClose) == _displayGeneration) {
 			close();
+		} else if (_streamed
+			&& _streamed->controls
+			&& _streamed->withSound
+			&& Tele::ViewerLoop()) {
+			const auto created = _streamedCreated;
+			crl::on_main(_widget, [=] {
+				if (_streamed
+					&& _streamedCreated == created
+					&& _streamed->instance.player().finished()) {
+					_streamingStartPaused = false;
+					restartAtSeekPosition(0);
+				}
+			});
 		}
 	});
 }
@@ -7448,6 +7461,10 @@ void OverlayWidget::handleKeyPress(not_null<QKeyEvent*> e) {
 			activateControls();
 			seekRelativeTime(kSeekTimeMsLong);
 			return;
+		} else if (key == Qt::Key_R && _streamed->controls) {
+			activateControls();
+			Tele::SetViewerLoop(!Tele::ViewerLoop());
+			return;
 		} else if ((key == Qt::Key_Period || key == Qt::Key_Comma)
 			&& _streamed->instance.player().paused()) {
 			activateControls();
