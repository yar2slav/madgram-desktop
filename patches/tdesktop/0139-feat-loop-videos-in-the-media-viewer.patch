diff --git a/Telegram/SourceFiles/tele/tele_viewer_loop.cpp b/Telegram/SourceFiles/tele/tele_viewer_loop.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7a09154ec88e1e22432e18d2ef88d327c758ae46
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_viewer_loop.cpp
@@ -0,0 +1,88 @@
+#include "tele/tele_viewer_loop.h"
+
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/effects/animation_value.h"
+#include "ui/ui_utility.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/tooltip.h"
+#include "styles/style_media_player.h"
+#include "styles/style_media_view.h"
+
+namespace Tele {
+namespace {
+
+class LoopButton final
+	: public Ui::IconButton
+	, public Ui::AbstractTooltipShower {
+public:
+	explicit LoopButton(QWidget *parent);
+
+	QString tooltipText() const override;
+	QPoint tooltipPos() const override;
+	bool tooltipWindowActive() const override;
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+	void onStateChanged(State was, StateChangeSource source) override;
+
+};
+
+LoopButton::LoopButton(QWidget *parent)
+: IconButton(parent, st::mediaviewPipButton) {
+	setClickedCallback([] {
+		SetViewerLoop(!ViewerLoop());
+	});
+	ViewerLoopValue(
+	) | rpl::on_next([=] {
+		update();
+	}, lifetime());
+}
+
+QString LoopButton::tooltipText() const {
+	return Lower(u"Loop"_q);
+}
+
+QPoint LoopButton::tooltipPos() const {
+	return QCursor::pos();
+}
+
+bool LoopButton::tooltipWindowActive() const {
+	return Ui::AppInFocus() && Ui::InFocusChain(window());
+}
+
+void LoopButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	paintRipple(p, st().rippleAreaPosition);
+	const auto color = ViewerLoop()
+		? st::mediaviewTextLinkFg->c
+		: anim::color(
+			st::mediaviewPlaybackIconFg,
+			st::mediaviewPlaybackIconFgOver,
+			iconOverOpacity());
+	st::mediaPlayerRepeatButton.icon.paint(
+		p,
+		st().iconPosition,
+		width(),
+		color);
+}
+
+void LoopButton::onStateChanged(State was, StateChangeSource source) {
+	IconButton::onStateChanged(was, source);
+	const auto over = isOver();
+	if (over != static_cast<bool>(was & StateFlag::Over)) {
+		if (over) {
+			Ui::Tooltip::Show(1000, this);
+		} else {
+			Ui::Tooltip::Hide();
+		}
+	}
+}
+
+} // namespace
+
+not_null<Ui::IconButton*> AddViewerLoopButton(not_null<QWidget*> parent) {
+	return Ui::CreateChild<LoopButton>(parent.get());
+}
+
+} // namespace Tele
