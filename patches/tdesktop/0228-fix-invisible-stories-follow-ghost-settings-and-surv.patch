index 0000000000000000000000000000000000000000..5872112a59a11001eab0bdaeb9dea115781be9e2
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_invisible_stories.cpp
@@ -0,0 +1,362 @@
+#include "tele/tele_invisible_stories.h"
+
+#include "base/unixtime.h"
+#include "core/application.h"
+#include "data/data_message_reaction_id.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_stories.h"
+#include "data/data_story.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/storage_account.h"
+#include "tele/tele_ghost.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "lang/lang_keys.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/layers/show.h"
+#include "ui/toast/toast.h"
+#include "window/window_controller.h"
+#include "window/window_session_controller.h"
+#include "styles/style_media_view.h"
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E5701);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxEntries = 4096;
+constexpr auto kExpiry = TimeId(48 * 3600);
+
+bool RevealConfirmed = false;
+
+struct LocalRead {
+	StoryId till = 0;
+	TimeId date = 0;
+};
+
+class Store final {
+public:
+	explicit Store(not_null<Main::Session*> session);
+	~Store();
+
+	[[nodiscard]] static Store &Get(not_null<Main::Session*> session);
+
+	[[nodiscard]] StoryId till(PeerId peer) const;
+	[[nodiscard]] std::vector<std::pair<PeerId, StoryId>> list() const;
+	void remember(FullStoryId id);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Registry();
+
+	[[nodiscard]] bool active(PeerId peer, const LocalRead &read) const;
+	[[nodiscard]] QString directory() const;
+	bool prune();
+	void read();
+	void write() const;
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<PeerId, LocalRead> _reads;
+	rpl::lifetime _lifetime;
+
+};
+
+Store::Store(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+	if (prune()) {
+		write();
+	}
+	rpl::merge(
+		InvisibleStoriesChanges(),
+		GhostChatsChanges()
+	) | rpl::on_next([=] {
+		if (prune()) {
+			write();
+		}
+	}, _lifetime);
+}
+
+Store::~Store() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>> &Store::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Store*>>();
+	return result;
+}
+
+Store &Store::Get(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry))
+		? *i->second
+		: *session->lifetime().make_state<Store>(session);
+}
+
+bool Store::active(PeerId peer, const LocalRead &read) const {
+	const auto now = base::unixtime::now();
+	return (read.date + kExpiry > now)
+		&& (read.date <= now + kExpiry)
+		&& InvisibleStories(_session->data().peer(peer));
+}
+
+StoryId Store::till(PeerId peer) const {
+	const auto i = _reads.find(peer);
+	return (i != end(_reads) && active(peer, i->second))
+		? i->second.till
+		: StoryId();
+}
+
+std::vector<std::pair<PeerId, StoryId>> Store::list() const {
+	auto result = std::vector<std::pair<PeerId, StoryId>>();
+	result.reserve(_reads.size());
+	for (const auto &[peer, read] : _reads) {
+		if (active(peer, read)) {
+			result.emplace_back(peer, read.till);
+		}
+	}
+	return result;
+}
+
+void Store::remember(FullStoryId id) {
+	if (!id.valid()) {
+		return;
+	}
+	auto &read = _reads[id.peer];
+	if (read.till >= id.story && active(id.peer, read)) {
+		return;
+	}
+	read = { .till = id.story, .date = base::unixtime::now() };
+	if (int(_reads.size()) > kMaxEntries) {
+		_reads.erase(ranges::min_element(
+			_reads,
+			ranges::less(),
+			[](const auto &pair) { return pair.second.date; }));
+	}
+	write();
+}
+
+bool Store::prune() {
+	const auto was = _reads.size();
+	for (auto i = begin(_reads); i != end(_reads);) {
+		if (active(i->first, i->second)) {
+			++i;
+		} else {
+			i = _reads.erase(i);
+		}
+	}
+	return (_reads.size() != was);
+}
+
+QString Store::directory() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void Store::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(
+			file,
+			u"tele_story_reads"_q,
+			directory(),
+			key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version != kVersion
+		|| owner != _session->uniqueId()
+		|| count > quint32(kMaxEntries)) {
+		return;
+	}
+	auto reads = base::flat_map<PeerId, LocalRead>();
+	for (auto i = quint32(); i != count; ++i) {
+		auto peer = quint64();
+		auto till = qint32();
+		auto date = qint32();
+		file.stream >> peer >> till >> date;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		} else if (peer && till > 0) {
+			reads.emplace(
+				PeerId(PeerIdHelper(peer)),
+				LocalRead{ .till = till, .date = date });
+		}
+	}
+	_reads = std::move(reads);
+}
+
+void Store::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	const auto size = sizeof(quint32) * 3
+		+ sizeof(quint64)
+		+ _reads.size() * (sizeof(quint64) + sizeof(qint32) * 2);
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_reads.size());
+	for (const auto &[peer, read] : _reads) {
+		data.stream
+			<< quint64(peer.value)
+			<< qint32(read.till)
+			<< qint32(read.date);
+	}
+	auto file = FileWriteDescriptor(u"tele_story_reads"_q, directory());
+	file.writeEncrypted(data, key);
+}
+
+[[nodiscard]] base::flat_set<FullStoryId> &AllowedLive() {
+	static auto result = base::flat_set<FullStoryId>();
+	return result;
+}
+
+[[nodiscard]] bool HiddenLive(not_null<Data::Story*> story) {
+	return story->call()
+		&& InvisibleStories(story->peer())
+		&& !AllowedLive().contains(story->fullId());
+}
+
+[[nodiscard]] std::shared_ptr<Ui::Show> ConfirmShow(
+		std::shared_ptr<Ui::Show> viewerShow,
+		Window::SessionController *controller) {
+	if (viewerShow) {
+		return viewerShow;
+	} else if (controller) {
+		return controller->uiShow();
+	} else if (const auto window = Core::App().activeWindow()) {
+		return window->uiShow();
+	}
+	return nullptr;
+}
+
+} // namespace
+
+bool LiveStoryAllowed(
+		std::shared_ptr<Ui::Show> viewerShow,
+		Window::SessionController *controller,
+		not_null<Data::Story*> story,
+		Fn<void()> open) {
+	if (!HiddenLive(story)) {
+		return true;
+	}
+	const auto show = ConfirmShow(viewerShow, controller);
+	if (!show) {
+		return false;
+	}
+	const auto id = story->fullId();
+	const auto weak = base::make_weak(&story->session());
+	show->showBox(Ui::MakeConfirmBox({
+		.text = Lower(u"Watching a live story shows you to its author."_q),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			if (const auto session = weak.get()) {
+				if (session->data().stories().lookup(id)) {
+					AllowedLive().emplace(id);
+					open();
+				}
+			}
+		},
+		.confirmText = Lower(u"Watch anyway"_q),
+		.labelStyle = viewerShow ? &st::storiesBoxLabel : nullptr,
+	}));
+	return false;
+}
+
+bool SkipLiveStory(
+		Data::Story *story,
+		std::shared_ptr<Ui::Show> show,
+		Fn<bool()> jump,
+		Fn<void()> close) {
+	if (!story || !HiddenLive(story)) {
+		return false;
+	}
+	const auto text = Lower(
+		u"Live story skipped: watching it shows you to its author."_q);
+	if (jump()) {
+		show->showToast(text);
+	} else {
+		close();
+		Ui::Toast::Show(text);
+	}
+	return true;
+}
+
+StoryId LocalStoryReadTill(
+		not_null<Main::Session*> session,
+		PeerId peer) {
+	return Store::Get(session).till(peer);
+}
+
+std::vector<std::pair<PeerId, StoryId>> LocalStoryReads(
+		not_null<Main::Session*> session) {
+	return Store::Get(session).list();
+}
+
+void RememberStoryRead(not_null<Main::Session*> session, FullStoryId id) {
+	Store::Get(session).remember(id);
+}
+
+bool StoryRevealAllowed(
+		std::shared_ptr<Ui::Show> show,
+		PeerData *peer,
+		Fn<void()> proceed) {
+	if (RevealConfirmed
+		|| !peer
+		|| peer->isSelf()
+		|| !InvisibleStories(peer)) {
+		return true;
+	}
+	show->showBox(Ui::MakeConfirmBox({
+		.text = Lower(u"Reacting or replying shows the author that you "
+			"viewed the story."_q),
+		.confirmed = [=](Fn<void()> close) {
+			RevealConfirmed = true;
+			close();
+			proceed();
+		},
+		.confirmText = tr::lng_continue(),
+		.labelStyle = &st::storiesBoxLabel,
+	}));
+	return false;
+}
+
+void SendStoryReaction(
+		std::shared_ptr<Ui::Show> show,
+		not_null<Data::Story*> story,
+		const Data::ReactionId &id) {
+	const auto fullId = story->fullId();
+	const auto weak = base::make_weak(&story->session());
+	const auto send = [=] {
+		if (const auto session = weak.get()) {
+			session->data().stories().sendReaction(fullId, id);
+		}
+	};
+	if (StoryRevealAllowed(show, story->peer(), send)) {
+		send();
+	}
+}
+
+} // namespace Tele
