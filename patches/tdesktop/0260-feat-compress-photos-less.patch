From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Wed, 7 Oct 2026 18:54:31 +0300
Subject: [PATCH] feat: compress photos less

---
 Telegram/SourceFiles/settings/settings_tele.cpp   |  4 ++++
 Telegram/SourceFiles/storage/localimageloader.cpp |  3 ++-
 Telegram/SourceFiles/tele/tele_options.cpp        | 11 +++++++++++
 Telegram/SourceFiles/tele/tele_options.h          |  2 ++
 Telegram/SourceFiles/tele/tele_send_files.cpp     |  4 ++++
 Telegram/SourceFiles/tele/tele_send_files.h       |  1 +
 Telegram/SourceFiles/tele/tele_settings_io.cpp    |  1 +
 7 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index bbf81a5a6c343f1776b9bc902ddf3fe2d4620265..e43acddc1a6d0556c03b594216d5e1c584cf1843 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -3160,6 +3160,10 @@ void FillSending(SectionBuilder &builder) {
 	AddGroupTitle(builder, u"Uploads"_q);
 	AddOptionToggle(builder, ::Tele::kOptionParallelUploads);
 	AddOptionToggle(builder, ::Tele::kOptionHdPhotos);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionPhotoQuality,
+		{ u"jpeg"_q, u"compression"_q, u"quality"_q });
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionGifVideo,
diff --git a/Telegram/SourceFiles/storage/localimageloader.cpp b/Telegram/SourceFiles/storage/localimageloader.cpp
index c4886e31a7ebf948adb224e1d28afa99a3c77662..64ee199a6d82322bfa5f61ae39b6b2ca5ee57c9e 100644
--- a/Telegram/SourceFiles/storage/localimageloader.cpp
+++ b/Telegram/SourceFiles/storage/localimageloader.cpp
@@ -43,6 +43,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "mainwindow.h"
 #include "main/main_session.h"
 #include "tele/tele_gif_video.h"
+#include "tele/tele_send_files.h"
 #include "tele/tele_sticker_truth.h"
 
 #include <QtCore/QBuffer>
@@ -202,7 +203,7 @@ struct PreparedFileThumbnail {
 	auto result = QByteArray();
 	QBuffer buffer(&result);
 	QImageWriter writer(&buffer, "JPEG");
-	writer.setQuality(87);
+	writer.setQuality(Tele::PhotoJpegQuality(87));
 	writer.setProgressiveScanWrite(true);
 	writer.write(full);
 	buffer.close();
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 7dcf0039b95bc3fb388a2470b8251e9250f6c503..ab8793eef8801768085b0802faa1fcb8cab4dec9 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -162,6 +162,7 @@ const char kOptionConfirmGifs[] = "tele-confirm-gifs";
 const char kOptionConfirmVoice[] = "tele-confirm-voice";
 const char kOptionPunctualScheduled[] = "tele-punctual-scheduled";
 const char kOptionHdPhotos[] = "tele-hd-photos";
+const char kOptionPhotoQuality[] = "tele-photo-quality";
 const char kOptionGifVideo[] = "tele-gif-video";
 const char kOptionSilentVideoAs[] = "tele-silent-video-as";
 const char kOptionAudioVoice[] = "tele-audio-voice";
@@ -1192,6 +1193,12 @@ base::options::toggle HdPhotosOption({
 	.defaultValue = true,
 });
 
+base::options::toggle PhotoQualityOption({
+	.id = kOptionPhotoQuality,
+	.name = "Compress photos less",
+	.description = "JPEG quality 94 instead of 87, for slightly bigger files.",
+});
+
 base::options::toggle GifVideoOption({
 	.id = kOptionGifVideo,
 	.name = "Send GIFs as videos and videos as GIFs",
@@ -2742,6 +2749,10 @@ bool HdPhotos() {
 	return HdPhotosOption.value();
 }
 
+bool PhotoQuality() {
+	return PhotoQualityOption.value();
+}
+
 bool GifVideo() {
 	return GifVideoOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index dc26bb53596c44be863d69d03aa591f2ee500db3..e00f2e39a250422a40957b8ff986d14ef385c43a 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -157,6 +157,7 @@ extern const char kOptionConfirmGifs[];
 extern const char kOptionConfirmVoice[];
 extern const char kOptionPunctualScheduled[];
 extern const char kOptionHdPhotos[];
+extern const char kOptionPhotoQuality[];
 extern const char kOptionGifVideo[];
 extern const char kOptionSilentVideoAs[];
 extern const char kOptionAudioVoice[];
@@ -453,6 +454,7 @@ void ClearMessageMenuLegacy();
 [[nodiscard]] bool ConfirmVoice();
 [[nodiscard]] bool PunctualScheduled();
 [[nodiscard]] bool HdPhotos();
+[[nodiscard]] bool PhotoQuality();
 [[nodiscard]] bool GifVideo();
 [[nodiscard]] QString SilentVideoAs();
 void SetSilentVideoAs(const QString &value);
diff --git a/Telegram/SourceFiles/tele/tele_send_files.cpp b/Telegram/SourceFiles/tele/tele_send_files.cpp
index 094acfc1aaa5bbd3478bd28da3f5932a81a04cda..42daa907674e67d57f78e76f9e51df6fdaa50700 100644
--- a/Telegram/SourceFiles/tele/tele_send_files.cpp
+++ b/Telegram/SourceFiles/tele/tele_send_files.cpp
@@ -138,4 +138,8 @@ Ui::SendFilesWay DefaultSendFilesWay() {
 	return result;
 }
 
+int PhotoJpegQuality(int quality) {
+	return PhotoQuality() ? 94 : quality;
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_send_files.h b/Telegram/SourceFiles/tele/tele_send_files.h
index 1b5fd54d94e221dbd9a3925a5f35a86559e21ec7..c6366027612079870e53acf4a57eb3278fed0d3e 100644
--- a/Telegram/SourceFiles/tele/tele_send_files.h
+++ b/Telegram/SourceFiles/tele/tele_send_files.h
@@ -27,5 +27,6 @@ void ShowSendFilesBox(
 	Fn<void()> sent = nullptr);
 
 [[nodiscard]] Ui::SendFilesWay DefaultSendFilesWay();
+[[nodiscard]] int PhotoJpegQuality(int quality);
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index e26994ee120ed9654ea486370bbd3c16cac0bc04..3d663ed161ab3d5c1896924289a539f50f302c48 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
