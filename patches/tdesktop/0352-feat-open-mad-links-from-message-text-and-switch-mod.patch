 		+ (category.isEmpty() ? QString() : '/' + category)
-		+ Query(control);
+		+ Query(control.startsWith(u"tele-"_s) ? u"mad-"_s + control.mid(5) : control);
 }
 
 QString PublicMadLink(const QString &value) {
@@ -109,6 +151,16 @@ QString PublicMadLink(const QString &value) {
 	auto result = QUrl(url);
 	result.setScheme(u"mad"_s);
 	result.setPath(path.startsWith(u"/tele/"_s) ? path.mid(5) : QString());
+	auto query = QUrlQuery(result);
+	const auto control = query.queryItemValue(u"highlight"_s, QUrl::FullyDecoded);
+	if (control.startsWith(u"tele-"_s)) {
+		query.removeAllQueryItems(u"highlight"_s);
+		query.addQueryItem(u"highlight"_s, u"mad-"_s + control.mid(5));
+		result.setQuery(query);
+	}
+	if (result.fragment().startsWith(u"tele-"_s)) {
+		result.setFragment(u"mad-"_s + result.fragment().mid(5));
+	}
 	const auto candidate = result.toString(QUrl::FullyEncoded);
 	return LocalMadLink(candidate).isEmpty() ? value : candidate;
 }
