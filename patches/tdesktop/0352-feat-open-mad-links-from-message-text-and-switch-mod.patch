+	Require(Tele::MadSettingsLink(u"privacy"_s, u"tele-hide-stories"_s) == u"mad://settings/privacy?highlight=mad-hide-stories"_s, "public mad ids");
+	Require(Tele::LocalMadLink(u"mad://settings/privacy?highlight=mad-hide-stories"_s) == u"tg://settings/tele/privacy?highlight=tele-hide-stories"_s, "map public ids back");
+	Require(Tele::PublicMadLink(u"tg://settings/tele/privacy?highlight=tele-hide-stories"_s) == u"mad://settings/privacy?highlight=mad-hide-stories"_s, "copied mad ids");
+	using Action = Tele::MadModeAction;
+	for (const auto &[url, action] : std::vector<std::pair<QString, Action>>{
+		{ u"mad://ghost/on"_s, Action::GhostOn },
+		{ u"mad://ghost/off"_s, Action::GhostOff },
+		{ u"mad://streamer/on"_s, Action::StreamerOn },
+		{ u" MAD://STREAMER/OFF/ "_s, Action::StreamerOff },
+	}) {
+		Require(Tele::ParseMadModeAction(url) == action, "explicit mode action");
+		Require(Tele::LocalMadLink(url).isEmpty(), "actions never navigate to settings");
+	}
+	for (const auto &url : QStringList{
+		u"mad://ghost"_s, u"mad://ghost/toggle"_s, u"mad://ghost/on?x=1"_s,
+		u"mad://ghost/off#on"_s, u"mad://user@ghost/on"_s, u"mad://ghost:443/on"_s,
+		u"mad://streamer/on/extra"_s, u"mad://ghost/on%0A"_s,
+		u"https://ghost/on"_s, u"mad://ghost/%6Fn"_s,
+	}) {
+		Require(Tele::ParseMadModeAction(url) == Action::None, "reject unsafe mode actions");
+	}
+	using Ranges = std::vector<std::pair<int, int>>;
+	for (const auto &[text, ranges] : std::vector<std::pair<QString, Ranges>>{
+		{ u"mad://settings/server?highlight=mad-server-url"_s, Ranges{ { 0, 46 } } },
+		{ u"open mad://ghost/on."_s, Ranges{ { 5, 14 } } },
+		{ u"(mad://streamer/off) and MAD://SETTINGS"_s, Ranges{ { 1, 18 }, { 25, 14 } } },
+		{ u"«mad://sync»"_s, Ranges{ { 1, 10 } } },
+		{ u"just text"_s, Ranges{} },
+		{ u"mad://"_s, Ranges{} },
+		{ u"nomad://settings"_s, Ranges{} },
+		{ u"https://x.com/mad://settings"_s, Ranges{} },
+	}) {
+		Require(Tele::FindMadLinks(text) == ranges, "find mad links in text");
+	}
 	std::puts("mad links tests passed");
