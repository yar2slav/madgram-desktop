 namespace Tele {
 
+void AddMadLinkEntities(TextWithEntities &text) {
+	const auto links = FindMadLinks(text.text);
+	if (links.empty()) {
+		return;
+	}
+	const auto formatting = [](EntityType type) {
+		return type == EntityType::Bold
+			|| type == EntityType::Italic
+			|| type == EntityType::Underline
+			|| type == EntityType::StrikeOut
+			|| type == EntityType::Spoiler
+			|| type == EntityType::Blockquote;
+	};
+	for (const auto &[offset, length] : links) {
+		const auto overlaps = ranges::any_of(text.entities, [&](
+				const EntityInText &entity) {
+			return !formatting(entity.type())
+				&& entity.offset() < offset + length
+				&& offset < entity.offset() + entity.length();
+		});
+		if (overlaps) {
+			continue;
+		}
+		const auto position = ranges::find_if(text.entities, [&](
+				const EntityInText &entity) {
+			return entity.offset() > offset;
+		});
+		text.entities.insert(
+			position,
+			EntityInText(EntityType::Url, offset, length));
+	}
+}
+
 bool OpenMadLink(const QString &url, const QVariant &context) {
+	const auto action = ParseMadModeAction(url);
+	if (action != MadModeAction::None) {
+		const auto clicked = context.value<ClickHandlerContext>().sessionWindow.get();
+		const auto window = Core::App().activeWindow();
+		const auto controller = clicked ? clicked
+			: window ? window->sessionController() : nullptr;
+		if (Core::App().passcodeLocked() || !controller) {
+			return false;
+		}
+		const auto ghost = action == MadModeAction::GhostOn
+			|| action == MadModeAction::GhostOff;
+		const auto enabled = action == MadModeAction::GhostOn
+			|| action == MadModeAction::StreamerOn;
+		base::options::lookup<bool>(ghost ? kOptionGhost : kOptionStreamerMode).set(enabled);
+		return true;
+	}
 	const auto local = LocalMadLink(url);
 	if (!local.isEmpty()) {
 		return Core::App().openLocalUrl(local, context);
