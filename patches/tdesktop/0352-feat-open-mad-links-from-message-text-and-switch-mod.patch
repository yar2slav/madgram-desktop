diff --git a/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp b/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp
index 1e5abcfead3d4085988b60ba7ef83a54158d34e8..0df75f2889fb750c996a0e5aecfc4403d8f284ce 100644
--- a/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp
+++ b/Telegram/SourceFiles/tele/tele_mad_link_parser.cpp
@@ -33,6 +33,45 @@ QString Query(const QString &control) {
 
 }
 
+MadModeAction ParseMadModeAction(const QString &url) {
+	static const auto pattern = QRegularExpression(
+		QRegularExpression::anchoredPattern(u"mad://(ghost|streamer)/(on|off)/?"_s),
+		QRegularExpression::CaseInsensitiveOption);
+	const auto match = pattern.match(url.trimmed());
+	if (!match.hasMatch()) {
+		return MadModeAction::None;
+	}
+	const auto ghost = match.captured(1).compare(u"ghost"_s, Qt::CaseInsensitive) == 0;
+	const auto enabled = match.captured(2).compare(u"on"_s, Qt::CaseInsensitive) == 0;
+	return ghost
+		? (enabled ? MadModeAction::GhostOn : MadModeAction::GhostOff)
+		: (enabled ? MadModeAction::StreamerOn : MadModeAction::StreamerOff);
+}
+
+std::vector<std::pair<int, int>> FindMadLinks(const QString &text) {
+	auto result = std::vector<std::pair<int, int>>();
+	if (!text.contains(u"mad://"_s, Qt::CaseInsensitive)) {
+		return result;
+	}
+	static const auto pattern = QRegularExpression(
+		u"(?<![\\w/:.])mad://[^\\s<>\"'\u00AB\u00BB]+"_s,
+		QRegularExpression::CaseInsensitiveOption
+			| QRegularExpression::UseUnicodePropertiesOption);
+	auto matches = pattern.globalMatch(text);
+	while (matches.hasNext()) {
+		const auto match = matches.next();
+		auto length = int(match.capturedLength());
+		while (length > 6
+			&& u".,;:!?)]}"_s.contains(text[match.capturedStart() + length - 1])) {
+			--length;
+		}
+		if (length > 6) {
+			result.emplace_back(int(match.capturedStart()), length);
+		}
+	}
+	return result;
+}
+
 bool IsMadLink(const QString &url) {
 	return url.trimmed().startsWith(u"mad:"_s, Qt::CaseInsensitive);
 }
