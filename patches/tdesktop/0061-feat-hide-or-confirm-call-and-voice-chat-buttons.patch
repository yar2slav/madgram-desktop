+[[nodiscard]] QString ButtonChoiceLabel(const QString &value) {
+	return ::Tele::Lower((value == u"hide"_q)
+		? u"Hide"_q
+		: (value == u"confirm"_q)
+		? u"Ask first"_q
+		: u"Show"_q);
+}
+
+void AddButtonChoice(
+		SectionBuilder &builder,
+		const char id[],
+		QString (*get)(),
+		void (*set)(const QString&),
+		rpl::producer<QString> (*value)(),
+		const QString &ask,
+		QStringList keywords) {
+	const auto &option = base::options::lookup<QString>(id);
+	const auto controller = builder.controller();
+	const auto name = ::Tele::Lower(option.name());
+	const auto description = ::Tele::Lower(option.description());
+	keywords.push_front(description);
+	const auto button = builder.addButton({
+		.id = option.id(),
+		.title = rpl::single(name),
+		.st = &st::settingsButtonNoIcon,
+		.label = value() | rpl::map(ButtonChoiceLabel),
+		.onClick = [=] {
+			controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+				const auto values = std::vector<QString>{
+					QString(),
+					u"hide"_q,
+					u"confirm"_q,
+				};
+				const auto options = std::vector<QString>{
+					::Tele::Lower(u"Show"_q),
+					::Tele::Lower(u"Hide"_q),
+					::Tele::Lower(ask),
+				};
+				const auto current = ranges::find(values, get());
+				SingleChoiceBox(box, {
+					.title = rpl::single(name),
+					.options = options,
+					.initialSelection = (current != end(values))
+						? int(current - begin(values))
+						: 0,
+					.callback = [=](int index) {
+						set(values[index]);
+					},
+				});
+			}));
+		},
+		.keywords = std::move(keywords),
+	});
+	if (button) {
+		SetupLink(button, option.id());
+	}
+	AddAbout(builder, description);
+}
+
+void AddCallButtons(SectionBuilder &builder) {
+	AddButtonChoice(
+		builder,
+		::Tele::kOptionCallButton,
+		::Tele::CallButton,
+		::Tele::SetCallButton,
+		::Tele::CallButtonValue,
+		u"Ask before calling"_q,
+		{ u"hide"_q, u"confirm"_q, u"video"_q });
+	AddButtonChoice(
+		builder,
+		::Tele::kOptionGroupCallButton,
+		::Tele::GroupCallButton,
+		::Tele::SetGroupCallButton,
+		::Tele::GroupCallButtonValue,
+		u"Ask before joining"_q,
+		{ u"hide"_q, u"confirm"_q, u"group call"_q, u"live stream"_q });
+}
+
 class IgnoredRow final : public PeerListRowWithLink {
 public:
 	explicit IgnoredRow(not_null<UserData*> user)
@@ -970,7 +1049,7 @@ void FillInterface(SectionBuilder &builder) {
 	AddTitle(builder);
 	AddOptionToggle(builder, ::Tele::kOptionLowercase);
 	AddOptionToggle(builder, ::Tele::kOptionBubbleBadges);
-	AddOptionToggle(builder, ::Tele::kOptionHideCalls);
+	AddCallButtons(builder);
 	AddOptionToggle(builder, ::Tele::kOptionHideAllChats);
 	AddOptionToggle(builder, ::Tele::kOptionStaticUserpicsList);
 	AddOptionToggle(builder, ::Tele::kOptionStaticUserpicsChats);
diff --git a/Telegram/SourceFiles/tele/tele_calls.cpp b/Telegram/SourceFiles/tele/tele_calls.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..28dd39906b5bfc918a83daca92e0d6830ff22933
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_calls.cpp
@@ -0,0 +1,105 @@
+#include "tele/tele_calls.h"
+
+#include "data/data_peer.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/chat/group_call_bar.h"
+#include "ui/chat/group_call_userpics.h"
+#include "ui/layers/show.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] bool IsHide(const QString &value) {
+	return (value == u"hide"_q);
+}
+
+[[nodiscard]] bool IsConfirm(const QString &value) {
+	return (value == u"confirm"_q);
+}
+
+void Confirm(
+		std::shared_ptr<Ui::Show> show,
+		QString text,
+		QString confirmText,
+		Fn<void()> action) {
+	show->showBox(Ui::MakeConfirmBox({
+		.text = std::move(text),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			action();
+		},
+		.confirmText = std::move(confirmText),
+	}));
+}
+
+} // namespace
+
+bool HideCallButton() {
+	return IsHide(CallButton());
+}
+
+bool HideGroupCallButton() {
+	return IsHide(GroupCallButton());
+}
+
+rpl::producer<> CallButtonsChanges() {
+	return rpl::merge(
+		CallButtonValue() | rpl::skip(1) | rpl::to_empty,
+		GroupCallButtonValue() | rpl::skip(1) | rpl::to_empty);
+}
+
+void ConfirmCall(
+		std::shared_ptr<Ui::Show> show,
+		PeerData *peer,
+		Fn<void()> action) {
+	if (!peer || !peer->isUser() || !IsConfirm(CallButton())) {
+		action();
+		return;
+	}
+	Confirm(
+		std::move(show),
+		Lower(u"Call %1?"_q).arg(peer->name()),
+		Lower(u"Call"_q),
+		std::move(action));
+}
+
+void ConfirmGroupCall(
+		std::shared_ptr<Ui::Show> show,
+		not_null<PeerData*> peer,
+		Fn<void()> action) {
+	if (!IsConfirm(GroupCallButton())) {
+		action();
+		return;
+	}
+	const auto join = (peer->groupCall() != nullptr);
+	const auto broadcast = peer->isBroadcast();
+	const auto text = join
+		? (broadcast
+			? u"Join the live stream?"_q
+			: u"Join the voice chat?"_q)
+		: (broadcast
+			? u"Start a live stream?"_q
+			: u"Start a voice chat?"_q);
+	Confirm(
+		std::move(show),
+		Lower(text),
+		Lower(join ? u"Join"_q : u"Start"_q),
+		std::move(action));
+}
+
+rpl::producer<Ui::GroupCallBarContent> GroupCallBarFilter(
+		rpl::producer<Ui::GroupCallBarContent> content) {
+	return rpl::combine(
+		std::move(content),
+		GroupCallButtonValue() | rpl::map(IsHide)
+	) | rpl::map([](Ui::GroupCallBarContent content, bool hide) {
+		if (hide) {
+			content.shown = false;
+		}
+		return content;
+	});
+}
+
+} // namespace Tele
