 		nullptr);
 }
 
+void CopyEmojiIdToClipboard(
+		std::shared_ptr<Main::SessionShow> show,
+		DocumentId id) {
+	QGuiApplication::clipboard()->setText(QString::number(id));
+	show->showToast({
+		.text = { Lower(u"Emoji ID copied to clipboard."_q) },
+		.iconLottie = u"toast/copy"_q,
+		.iconLottieSize = st::toastLottieIconSize,
+	});
+}
+
+[[nodiscard]] QString CopyEmojiIdText() {
+	return Lower(u"Copy emoji ID"_q);
+}
+
+[[nodiscard]] DocumentId CustomEmojiAt(
+		HistoryView::Element *view,
+		QPoint point) {
+	if (!view) {
+		return 0;
+	}
+	auto request = HistoryView::StateRequest();
+	request.flags |= Ui::Text::StateRequest::Flag::LookupSymbol;
+	const auto state = view->textState(point, request);
+	if (state.cursor == HistoryView::CursorState::Text
+		&& state.symbol < 0xFFFF) {
+		const auto text = view->selectedText(
+			TextSelection{ state.symbol, uint16(state.symbol + 1) });
+		for (const auto &entity : text.rich.entities) {
+			if (entity.type() == EntityType::CustomEmoji) {
+				return Data::ParseCustomEmojiData(entity.data());
+			}
+		}
+	}
+	if (!view->isOnlyCustomEmoji()
+		|| view->pointState(point) == HistoryView::PointState::Outside) {
+		return 0;
+	}
+	auto result = DocumentId();
+	for (const auto &line : view->onlyCustomEmoji().lines) {
+		for (const auto &emoji : line) {
+			const auto id = Data::ParseCustomEmojiData(emoji.entityData);
+			if (!id || (result && result != id)) {
+				return 0;
+			}
+			result = id;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeEmojiIdAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		DocumentId id) {
+	const auto parent = menu->menu();
+	const auto action = Ui::Menu::CreateAction(
+		parent,
+		CopyEmojiIdText(),
+		[=] { CopyEmojiIdToClipboard(show, id); });
+	return base::make_unique_q<Ui::Menu::Action>(
+		parent,
+		menu->st().menu,
+		action,
+		&st::menuIconCopy,
+		&st::menuIconCopy);
+}
+
 [[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeTlAction(
 		not_null<Ui::PopupMenu*> menu,
 		std::shared_ptr<Main::SessionShow> show,
@@ -69,14 +142,22 @@ namespace {
 void InsertMessageTools(
 		not_null<Ui::PopupMenu*> menu,
 		std::shared_ptr<Main::SessionShow> show,
-		HistoryItem *item) {
-	if (!item || menu->empty() || !IsServerMsgId(item->id)) {
+		HistoryItem *item,
+		HistoryView::Element *view,
+		QPoint point) {
+	if (!item || menu->empty()) {
 		return;
 	}
+	const auto server = IsServerMsgId(item->id);
 	auto tools = std::vector<base::unique_qptr<Ui::Menu::ItemBase>>();
-	if (ViewAsTl()) {
+	if (server && ViewAsTl()) {
 		tools.push_back(MakeTlAction(menu, show, item));
 	}
+	if (CopyEmojiId()) {
+		if (const auto id = CustomEmojiAt(view, point)) {
+			tools.push_back(MakeEmojiIdAction(menu, show, id));
+		}
+	}
 	const auto addSeparator = [&] {
 		if (!menu->actions().back()->isSeparator()) {
 			menu->addSeparator();
@@ -88,10 +169,24 @@ void InsertMessageTools(
 			menu->addAction(std::move(tool));
 		}
 	}
-	if (MessageIdMenu()) {
+	if (server && MessageIdMenu()) {
 		addSeparator();
 		menu->addAction(MakeIdAction(menu, show, item->id));
 	}
 }
 
+void AddCopyEmojiIdAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		DocumentData *document) {
+	if (!CopyEmojiId() || !document) {
+		return;
+	}
+	const auto id = document->id;
+	menu->addAction(
+		CopyEmojiIdText(),
+		[=] { CopyEmojiIdToClipboard(show, id); },
+		&st::menuIconCopy);
+}
+
 } // namespace Tele
