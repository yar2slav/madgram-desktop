@@ -0,0 +1,465 @@
+#include "tele/tele_hidden_words.h"
+
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "storage/details/storage_file_utilities.h"
+#include "storage/serialize_common.h"
+#include "storage/storage_account.h"
+#include "tele/tele_ignored.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/layers/generic_box.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/menu/menu_add_action_callback.h"
+#include "ui/wrap/slide_wrap.h"
+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "styles/style_menu_icons.h"
+
+#include <QtCore/QRegularExpression>
+
+namespace Tele {
+namespace {
+
+using namespace Storage::details;
+
+constexpr auto kMagic = quint32(0x7E1E3D5A);
+constexpr auto kVersion = qint32(1);
+constexpr auto kMaxChats = 65536;
+constexpr auto kMaxCache = 8192;
+
+struct Rule {
+	QString text;
+	QRegularExpression regex;
+	bool pattern = false;
+};
+
+using Rules = std::vector<Rule>;
+
+struct Cached {
+	uint64 generation = 0;
+	const History *history = nullptr;
+	QString text;
+	bool result = false;
+};
+
+struct State {
+	State();
+
+	Rules rules;
+	uint64 generation = 0;
+	std::unordered_map<const HistoryItem*, Cached> cache;
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] QStringList Lines(const QString &value) {
+	auto result = QStringList();
+	for (const auto &line : value.split(QChar('\n'))) {
+		const auto trimmed = line.trimmed();
+		if (!trimmed.isEmpty() && !result.contains(trimmed)) {
+			result.push_back(trimmed);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QString> RegexPattern(const QString &line) {
+	if (line.size() < 3 || !line.startsWith(QChar('/'))) {
+		return std::nullopt;
+	} else if (line.endsWith(QChar('/'))) {
+		return line.mid(1, line.size() - 2);
+	} else if (line.size() > 3 && line.endsWith(u"/i"_q)) {
+		return line.mid(1, line.size() - 3);
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QRegularExpression MakeRegex(const QString &pattern) {
+	return QRegularExpression(
+		pattern,
+		(QRegularExpression::CaseInsensitiveOption
+			| QRegularExpression::UseUnicodePropertiesOption));
+}
+
+[[nodiscard]] QString LineError(const QString &line) {
+	const auto pattern = RegexPattern(line);
+	if (!pattern) {
+		return QString();
+	}
+	const auto regex = MakeRegex(*pattern);
+	return regex.isValid() ? QString() : regex.errorString();
+}
+
+[[nodiscard]] QString FirstError(const QString &value) {
+	const auto lines = value.split(QChar('\n'));
+	for (auto i = 0; i != int(lines.size()); ++i) {
+		const auto error = LineError(lines[i].trimmed());
+		if (!error.isEmpty()) {
+			return u"Line %1: %2"_q.arg(i + 1).arg(error);
+		}
+	}
+	return QString();
+}
+
+[[nodiscard]] Rules Compile(const QString &value) {
+	auto result = Rules();
+	for (const auto &line : Lines(value)) {
+		if (const auto pattern = RegexPattern(line)) {
+			auto regex = MakeRegex(*pattern);
+			if (regex.isValid()) {
+				regex.optimize();
+				result.push_back({ .regex = std::move(regex), .pattern = true });
+			}
+		} else {
+			result.push_back({ .text = line });
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] bool Matches(const Rules &rules, const QString &text) {
+	for (const auto &rule : rules) {
+		const auto found = rule.pattern
+			? rule.regex.match(text).hasMatch()
+			: text.contains(rule.text, Qt::CaseInsensitive);
+		if (found) {
+			return true;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] State &Get() {
+	static State state;
+	return state;
+}
+
+void Apply(Fn<void()> change) {
+	auto items = std::vector<not_null<HistoryItem*>>();
+	EnumerateViews([&](not_null<HistoryView::Element*> view) {
+		items.push_back(view->data());
+	});
+	ranges::sort(items);
+	items.erase(ranges::unique(items), end(items));
+	auto before = std::vector<bool>();
+	before.reserve(items.size());
+	for (const auto &item : items) {
+		before.push_back(HiddenByWords(item));
+	}
+	change();
+	auto &state = Get();
+	++state.generation;
+	state.cache.clear();
+	for (auto i = 0; i != int(items.size()); ++i) {
+		const auto item = items[i];
+		if (HiddenByWords(item) != before[i]) {
+			item->history()->owner().requestItemViewRefresh(item);
+		}
+	}
+	state.changes.fire({});
+}
+
+State::State()
+: rules(Compile(HiddenWords())) {
+	HiddenWordsValue(
+	) | rpl::skip(1) | rpl::on_next([=](const QString &value) {
+		Apply([&] {
+			rules = Compile(value);
+		});
+	}, lifetime);
+}
+
+class Chats final {
+public:
+	explicit Chats(not_null<Main::Session*> session);
+	~Chats();
+
+	[[nodiscard]] static Chats &For(not_null<Main::Session*> session);
+
+	[[nodiscard]] QString value(PeerId peer) const;
+	[[nodiscard]] const Rules *rules(PeerId peer) const;
+	void set(PeerId peer, const QString &value);
+
+private:
+	[[nodiscard]] static base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Chats*>> &Registry();
+
+	[[nodiscard]] QString folder() const;
+	void read();
+	void write() const;
+
+	const not_null<Main::Session*> _session;
+	base::flat_map<PeerId, QString> _values;
+	base::flat_map<PeerId, Rules> _rules;
+
+};
+
+Chats::Chats(not_null<Main::Session*> session)
+: _session(session) {
+	Registry().emplace(session, this);
+	read();
+}
+
+Chats::~Chats() {
+	Registry().remove(_session);
+}
+
+base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Chats*>> &Chats::Registry() {
+	static auto result = base::flat_map<
+		not_null<Main::Session*>,
+		not_null<Chats*>>();
+	return result;
+}
+
+Chats &Chats::For(not_null<Main::Session*> session) {
+	const auto &registry = Registry();
+	const auto i = registry.find(session);
+	return (i != end(registry))
+		? *i->second
+		: *session->lifetime().make_state<Chats>(session);
+}
+
+QString Chats::value(PeerId peer) const {
+	const auto i = _values.find(peer);
+	return (i != end(_values)) ? i->second : QString();
+}
+
+const Rules *Chats::rules(PeerId peer) const {
+	const auto i = _rules.find(peer);
+	return (i != end(_rules) && !i->second.empty()) ? &i->second : nullptr;
+}
+
+void Chats::set(PeerId peer, const QString &value) {
+	const auto normalized = NormalizeHiddenWords(value);
+	if (normalized == this->value(peer)) {
+		return;
+	} else if (normalized.isEmpty()) {
+		_values.remove(peer);
+		_rules.remove(peer);
+	} else {
+		_values[peer] = normalized;
+		_rules[peer] = Compile(normalized);
+	}
+	write();
+}
+
+QString Chats::folder() const {
+	const auto support = _session->local().supportModePath();
+	return QFileInfo(support).absolutePath() + '/';
+}
+
+void Chats::read() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key
+		|| !ReadEncryptedFile(file, u"tele_hidden_words"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (file.stream.status() != QDataStream::Ok
+		|| magic != kMagic
+		|| version < 1
+		|| version > kVersion
+		|| owner != _session->uniqueId()
+		|| count > kMaxChats) {
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto peer = quint64();
+		auto value = QString();
+		file.stream >> peer >> value;
+		if (file.stream.status() != QDataStream::Ok) {
+			return;
+		}
+		const auto normalized = NormalizeHiddenWords(value);
+		if (peer && !normalized.isEmpty()) {
+			_values[PeerId(peer)] = normalized;
+			_rules[PeerId(peer)] = Compile(normalized);
+		}
+	}
+}
+
+void Chats::write() const {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &[peer, value] : _values) {
+		size += sizeof(quint64) + Serialize::stringSize(value);
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kMagic
+		<< kVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_values.size());
+	for (const auto &[peer, value] : _values) {
+		data.stream << quint64(peer.value) << value;
+	}
+	auto file = FileWriteDescriptor(u"tele_hidden_words"_q, folder());
+	file.writeEncrypted(data, key);
+}
+
+} // namespace
+
+bool HiddenByWords(const HistoryItem *item) {
+	if (!item
+		|| item->out()
+		|| item->isService()
+		|| item->isSponsored()) {
+		return false;
+	}
+	auto &state = Get();
+	const auto history = item->history();
+	const auto local = Chats::For(&history->session()).rules(
+		history->peer->id);
+	if (state.rules.empty() && !local) {
+		return false;
+	}
+	const auto &text = item->originalText().text;
+	if (text.isEmpty() || item->from()->isSelf()) {
+		return false;
+	}
+	const auto i = state.cache.find(item);
+	if (i != end(state.cache)
+		&& i->second.generation == state.generation
+		&& i->second.history == history
+		&& i->second.text == text) {
+		return i->second.result;
+	}
+	const auto result = Matches(state.rules, text)
+		|| (local && Matches(*local, text));
+	if (state.cache.size() >= kMaxCache) {
+		state.cache.clear();
+	}
+	state.cache[item] = Cached{
+		.generation = state.generation,
+		.history = history,
+		.text = text,
+		.result = result,
+	};
+	return result;
+}
+
+rpl::producer<> HiddenWordsChanges() {
+	return Get().changes.events();
+}
+
+rpl::producer<int> HiddenWordsCountValue() {
+	return HiddenWordsValue() | rpl::map([](const QString &value) {
+		return int(Lines(value).size());
+	});
+}
+
+void HiddenWordsBox(not_null<Ui::GenericBox*> box, PeerData *peer) {
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(rpl::single(Lower(u"Hidden words"_q)));
+
+	const auto field = box->addRow(object_ptr<Ui::InputField>(
+		box,
+		st::newGroupDescription,
+		Ui::InputField::Mode::MultiLine,
+		rpl::single(Lower(u"Text or /regex/"_q)),
+		(peer
+			? Chats::For(&peer->session()).value(peer->id)
+			: HiddenWords())));
+	const auto error = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			box,
+			object_ptr<Ui::FlatLabel>(
+				box,
+				QString(),
+				st::boxAttentionDividerLabel)));
+	Ui::AddSkip(box->verticalLayout());
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		Lower(peer
+			? u"One rule per line, added to the global ones."_q
+			: u"One rule per line."_q),
+		st::boxDividerLabel));
+
+	const auto refresh = [=] {
+		const auto invalid = FirstError(field->getLastText());
+		error->entity()->setText(Lower(invalid));
+		error->toggle(!invalid.isEmpty(), anim::type::instant);
+		if (invalid.isEmpty()) {
+			field->hideError();
+		} else {
+			field->showErrorNoFocus();
+		}
+	};
+	field->changes() | rpl::on_next(refresh, field->lifetime());
+	refresh();
+
+	const auto save = [=] {
+		const auto value = field->getLastText();
+		if (!FirstError(value).isEmpty()) {
+			field->showError();
+			return;
+		}
+		const auto normalized = NormalizeHiddenWords(value);
+		if (peer) {
+			const auto session = &peer->session();
+			const auto id = peer->id;
+			Apply([&] {
+				Chats::For(session).set(id, normalized);
+			});
+		} else if (normalized != NormalizeHiddenWords(HiddenWords())) {
+			SetHiddenWords(normalized);
+		}
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		save();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void AddHiddenWordsAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer || peer->isSelf()) {
+		return;
+	}
+	const auto weak = base::make_weak(controller);
+	addAction(Lower(u"Hidden words"_q) + QChar(0x2026), [=] {
+		if (const auto strong = weak.get()) {
+			strong->show(Box(HiddenWordsBox, peer));
+		}
+	}, &st::menuIconCaptionHide);
+}
+
+QString NormalizeHiddenWords(const QString &value) {
+	auto lines = Lines(value);
+	lines.erase(ranges::remove_if(lines, [](const QString &line) {
+		return !LineError(line).isEmpty();
+	}), lines.end());
+	return lines.join(QChar('\n'));
+}
+
+} // namespace Tele
