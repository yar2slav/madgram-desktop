diff --git a/Telegram/SourceFiles/tele/tele_chain_mentions.cpp b/Telegram/SourceFiles/tele/tele_chain_mentions.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..61b8f4e86b78159c42224bccfd069cebf9884285
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_chain_mentions.cpp
@@ -0,0 +1,31 @@
+#include "tele/tele_chain_mentions.h"
+
+#include "data/data_user.h"
+#include "tele/tele_options.h"
+#include "ui/widgets/fields/input_field.h"
+
+#include <QtGui/QTextDocument>
+
+namespace Tele {
+
+bool ChainsMention(not_null<UserData*> user) {
+	return ChainMentions()
+		&& !(user->botInfo && !user->botInfo->inlinePlaceholder.isEmpty());
+}
+
+void ContinueMentionChain(not_null<Ui::InputField*> field) {
+	auto cursor = field->textCursor();
+	if (cursor.hasSelection()) {
+		return;
+	}
+	const auto next = field->document()->characterAt(cursor.position());
+	if (next.isNull() || next.isSpace()) {
+		cursor.insertText(u"@"_q);
+		return;
+	}
+	cursor.insertText(u"@ "_q);
+	cursor.movePosition(QTextCursor::Left);
+	field->setTextCursor(cursor);
+}
+
+} // namespace Tele
