+void DeletedWidget::setupSearch() {
+	_topBar->searchRequest(
+	) | rpl::on_next([=] {
+		_topBar->toggleSearch(true, anim::type::normal);
+	}, _topBar->lifetime());
+	_topBar->searchCancelled(
+	) | rpl::on_next([=] {
+		cancelSearch();
+	}, _topBar->lifetime());
+	_topBar->searchQuery(
+	) | rpl::on_next([=](const QString &query) {
+		const auto now = query.trimmed();
+		if (_query != now) {
+			_query = now;
+			_refreshes.fire({});
+		}
+	}, _topBar->lifetime());
+}
+
+void DeletedWidget::cancelSearch() {
+	_topBar->searchClear();
+	_topBar->toggleSearch(false, anim::type::normal);
+	doSetInnerFocus();
