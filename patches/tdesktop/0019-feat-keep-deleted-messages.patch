diff --git a/Telegram/SourceFiles/tele/tele_deleted.cpp b/Telegram/SourceFiles/tele/tele_deleted.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cbc9e673a7289f74489c13b1c580733ea414c41b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_deleted.cpp
@@ -0,0 +1,378 @@
+#include "tele/tele_deleted.h"
+
+#include "data/data_histories.h"
+#include "data/data_media_types.h"
+#include "data/data_session.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "ui/chat/chat_style.h"
+#include "ui/painter.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "styles/style_chat.h"
+#include "styles/style_menu_icons.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kFadeOpacity = 0.5;
+
+using Items = base::flat_map<MsgId, not_null<HistoryItem*>>;
+
+struct Icon {
+	QImage image;
+	QRgb color = 0;
+	int size = 0;
+};
+
+struct State {
+	State();
+
+	base::flat_map<
+		not_null<Main::Session*>,
+		base::flat_map<not_null<History*>, Items>> sessions;
+	Icon icon;
+	rpl::event_stream<not_null<History*>> changes;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] State &Get() {
+	static State state;
+	return state;
+}
+
+void RefreshAll() {
+	for (const auto &[session, histories] : Get().sessions) {
+		for (const auto &[history, items] : histories) {
+			for (const auto &[id, item] : items) {
+				session->data().requestItemViewRefresh(item);
+			}
+		}
+	}
+}
+
+State::State() {
+	DeletedTrashIconValue(
+	) | rpl::skip(1) | rpl::on_next([] {
+		RefreshAll();
+	}, lifetime);
+}
+
+void Forget(
+		not_null<Main::Session*> session,
+		not_null<const HistoryItem*> item) {
+	auto &sessions = Get().sessions;
+	const auto i = sessions.find(session);
+	if (i == end(sessions)) {
+		return;
+	}
+	const auto history = item->history();
+	const auto j = i->second.find(history);
+	if (j == end(i->second)) {
+		return;
+	}
+	const auto k = j->second.find(item->id);
+	if (k == end(j->second) || k->second.get() != item.get()) {
+		return;
+	}
+	j->second.erase(k);
+	if (j->second.empty()) {
+		i->second.erase(j);
+	}
+	Get().changes.fire_copy(history);
+}
+
+[[nodiscard]] base::flat_map<not_null<History*>, Items> &SessionItems(
+		not_null<Main::Session*> session) {
+	auto &sessions = Get().sessions;
+	if (const auto i = sessions.find(session); i != end(sessions)) {
+		return i->second;
+	}
+	session->data().itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		Forget(session, item);
+	}, session->lifetime());
+	session->data().sessionDataAboutToBeCleared(
+	) | rpl::on_next([=] {
+		Get().sessions.remove(session);
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		Get().sessions.remove(session);
+	});
+	return sessions[session];
+}
+
+[[nodiscard]] const Items *Find(not_null<History*> history) {
+	auto &sessions = Get().sessions;
+	const auto session = not_null<Main::Session*>(&history->session());
+	const auto i = sessions.find(session);
+	if (i == end(sessions)) {
+		return nullptr;
+	}
+	const auto j = i->second.find(history);
+	return (j != end(i->second)) ? &j->second : nullptr;
+}
+
+[[nodiscard]] bool Keepable(not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	return item->isRegular()
+		&& !item->isSending()
+		&& !item->hasFailed()
+		&& !item->isSponsored()
+		&& !item->ttlDestroyAt()
+		&& !(media && media->ttlSeconds());
+}
+
+[[nodiscard]] HistoryItem *FirstLoaded(not_null<History*> history) {
+	for (const auto &block : history->blocks) {
+		for (const auto &view : block->messages) {
+			if (view->data()->isRegular()) {
+				return view->data().get();
+			}
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] HistoryItem *LastLoaded(not_null<History*> history) {
+	for (const auto &block : ranges::views::reverse(history->blocks)) {
+		for (const auto &view : ranges::views::reverse(block->messages)) {
+			if (view->data()->isRegular()) {
+				return view->data().get();
+			}
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] int IconSize() {
+	return st::msgDateFont->height;
+}
+
+} // namespace
+
+void KeepDeleted(std::vector<not_null<HistoryItem*>> &items) {
+	if (!KeepDeletedMessages()) {
+		return;
+	}
+	auto kept = std::vector<not_null<HistoryItem*>>();
+	items.erase(ranges::remove_if(items, [&](not_null<HistoryItem*> item) {
+		if (!Keepable(item)) {
+			return false;
+		}
+		const auto history = item->history();
+		SessionItems(&history->session())[history].emplace(item->id, item);
+		kept.push_back(item);
+		return true;
+	}), end(items));
+	auto histories = base::flat_set<not_null<History*>>();
+	for (const auto &item : kept) {
+		if (item->isPinned()) {
+			item->setIsPinned(false);
+		}
+		item->history()->owner().requestItemViewRefresh(item);
+		histories.emplace(item->history());
+	}
+	for (const auto &history : histories) {
+		Get().changes.fire_copy(history);
+	}
+}
+
+bool IsKeptDeleted(not_null<const HistoryItem*> item) {
+	if (Get().sessions.empty()) {
+		return false;
+	}
+	const auto items = Find(item->history());
+	if (!items) {
+		return false;
+	}
+	const auto i = items->find(item->id);
+	return (i != end(*items)) && (i->second.get() == item.get());
+}
+
+bool DeletedIconShown(not_null<const HistoryItem*> item) {
+	return DeletedTrashIcon() && IsKeptDeleted(item);
+}
+
+int DeletedIconWidth() {
+	return IconSize() + style::ConvertScale(1);
+}
+
+int PaintDeletedIcon(QPainter &p, int right, int top) {
+	const auto size = IconSize();
+	const auto ratio = style::DevicePixelRatio();
+	const auto color = p.pen().color();
+	auto &icon = Get().icon;
+	if (icon.image.isNull()
+		|| icon.color != color.rgba()
+		|| icon.size != size * ratio) {
+		icon.color = color.rgba();
+		icon.size = size * ratio;
+		icon.image = st::menuIconDelete.instance(
+			color,
+			style::kScaleMax,
+			true
+		).scaled(
+			icon.size,
+			icon.size,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+		icon.image.setDevicePixelRatio(ratio);
+	}
+	right -= DeletedIconWidth();
+	p.drawImage(
+		right,
+		top + (st::msgDateFont->height - size) / 2,
+		icon.image);
+	return right;
+}
+
+void PaintDeletedServiceIcon(
+		QPainter &p,
+		const Ui::ChatPaintContext &context,
+		not_null<const HistoryView::Element*> view,
+		QRect geometry) {
+	if (!DeletedIconShown(view->data())) {
+		return;
+	}
+	const auto size = st::msgServicePadding.top()
+		+ st::msgServiceFont->height
+		+ st::msgServicePadding.bottom();
+	const auto skip = st::msgServiceMargin.top();
+	const auto after = geometry.x() + geometry.width() + skip;
+	const auto rect = QRect(
+		((after + size <= view->width())
+			? after
+			: std::max(geometry.x() - skip - size, 0)),
+		geometry.y(),
+		size,
+		size);
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(context.st->msgServiceBg());
+		p.drawEllipse(rect);
+	}
+	const auto icon = IconSize();
+	p.setPen(context.st->msgServiceFg());
+	PaintDeletedIcon(
+		p,
+		rect.x() + (rect.width() - icon) / 2 + DeletedIconWidth(),
+		rect.y() + (rect.height() - icon) / 2);
+}
+
+std::vector<not_null<HistoryItem*>> WithKeptDeleted(
+		not_null<History*> history,
+		std::vector<not_null<HistoryItem*>> items,
+		bool older) {
+	const auto kept = Find(history);
+	if (!kept) {
+		return items;
+	}
+	const auto first = FirstLoaded(history);
+	const auto last = LastLoaded(history);
+	auto from = MsgId(0);
+	auto till = ServerMaxMsgId;
+	if (items.empty()) {
+		if (older && first) {
+			till = first->id;
+		} else if (!older && last) {
+			from = last->id;
+		}
+	} else {
+		auto lo = items.front()->id;
+		auto hi = items.front()->id;
+		for (const auto &item : items) {
+			lo = std::min(lo, item->id);
+			hi = std::max(hi, item->id);
+		}
+		const auto newest = history->lastMessage();
+		const auto bottom = newest && (newest->id <= hi);
+		from = (!older && last) ? last->id : MsgId(lo.bare - 1);
+		till = (older && first)
+			? first->id
+			: bottom
+			? ServerMaxMsgId
+			: MsgId(hi.bare + 1);
+	}
+	auto present = base::flat_set<MsgId>();
+	present.reserve(items.size());
+	for (const auto &item : items) {
+		present.emplace(item->id);
+	}
+	auto add = std::vector<not_null<HistoryItem*>>();
+	for (const auto &[id, item] : *kept) {
+		if (id > from
+			&& id < till
+			&& !item->mainView()
+			&& !present.contains(id)) {
+			add.push_back(item);
+		}
+	}
+	if (add.empty()) {
+		return items;
+	}
+	items.insert(end(items), begin(add), end(add));
+	ranges::stable_sort(items, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return a->id < b->id;
+	});
+	return items;
+}
+
+std::vector<not_null<HistoryItem*>> KeptDeletedItems(
+		not_null<History*> history) {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	if (const auto kept = Find(history)) {
+		result.reserve(kept->size());
+		for (const auto &[id, item] : *kept) {
+			result.push_back(item);
+		}
+	}
+	return result;
+}
+
+int KeptDeletedCount(not_null<History*> history) {
+	const auto kept = Find(history);
+	return kept ? int(kept->size()) : 0;
+}
+
+rpl::producer<> KeptDeletedChanges(not_null<History*> history) {
+	return Get().changes.events(
+	) | rpl::filter(
+		rpl::mappers::_1 == history
+	) | rpl::to_empty;
+}
+
+void ClearKeptDeleted(not_null<History*> history) {
+	const auto kept = Find(history);
+	if (!kept) {
+		return;
+	}
+	auto ids = MessageIdsList();
+	ids.reserve(kept->size());
+	for (const auto &[id, item] : *kept) {
+		ids.push_back(item->fullId());
+	}
+	history->owner().histories().deleteMessages(ids, false);
+}
+
+DeletedFade::DeletedFade(
+		QPainter &p,
+		not_null<const HistoryView::Element*> view) {
+	if (!DeletedTrashIcon() && IsKeptDeleted(view->data())) {
+		_painter = &p;
+		_opacity = p.opacity();
+		p.setOpacity(_opacity * kFadeOpacity);
+	}
+}
+
+DeletedFade::~DeletedFade() {
+	if (_painter) {
+		_painter->setOpacity(_opacity);
+	}
+}
+
