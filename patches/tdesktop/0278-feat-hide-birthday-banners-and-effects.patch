diff --git a/Telegram/SourceFiles/tele/tele_birthdays.cpp b/Telegram/SourceFiles/tele/tele_birthdays.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ab98137111ce37b112f00e92c40a335e4c6279ab
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_birthdays.cpp
@@ -0,0 +1,26 @@
+#include "tele/tele_birthdays.h"
+
+#include "data/data_birthday.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+bool BirthdayToday(Data::Birthday date) {
+	return !HideBirthdays() && Data::IsBirthdayToday(date);
+}
+
+rpl::producer<bool> BirthdayTodayValue(Data::Birthday date) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		HideBirthdaysChanges()
+	) | rpl::map([=]() -> rpl::producer<bool> {
+		if (HideBirthdays()) {
+			return rpl::single(false);
+		}
+		return Data::IsBirthdayTodayValue(date);
+	}) | rpl::flatten_latest(
+	) | rpl::distinct_until_changed();
+}
+
+} // namespace Tele
