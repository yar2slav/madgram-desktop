new file mode 100644
index 0000000000000000000000000000000000000000..56909fc60bceb362b5b31ce508197f1a7a05a385
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_html_playground.cpp
@@ -0,0 +1,318 @@
+#include "tele/tele_html_playground.h"
+
+#include "base/unixtime.h"
+#include "data/data_histories.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "data/notify/data_peer_notify_settings.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+#include "settings.h"
+#include "tele/tele_html_card.h"
+#include "tele/tele_html_playground_section.h"
+#include "tele/tele_html_samples.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/boxes/confirm_box.h"
+#include "window/window_session_controller.h"
+#include "styles/style_layers.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QSaveFile>
+
+namespace Tele::Html {
+namespace {
+
+constexpr auto kMaxUserId = BareId(0xFFFFFFFFFFFFULL);
+constexpr auto kUserId = UserId(kMaxUserId - (kMaxUserId % 1000) + 1);
+constexpr auto kUserpicSize = 320;
+constexpr auto kMaxStored = 500;
+
+base::flat_set<not_null<Main::Session*>> Clearing;
+base::flat_set<not_null<Main::Session*>> SaveScheduled;
+
+[[nodiscard]] QString StorePath() {
+	return cWorkingDir() + u"tdata/tele_html_playground.json"_q;
+}
+
+[[nodiscard]] QString SessionKey(not_null<Main::Session*> session) {
+	return QString::number(session->userId().bare)
+		+ (session->isTestMode() ? u"t"_q : QString());
+}
+
+[[nodiscard]] QJsonObject ReadStore() {
+	auto file = QFile(StorePath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	return QJsonDocument::fromJson(file.readAll()).object();
+}
+
+void WriteStore(const QJsonObject &object) {
+	auto file = QSaveFile(StorePath());
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(QJsonDocument(object).toJson(QJsonDocument::Compact));
+		file.commit();
+	}
+}
+
+[[nodiscard]] std::vector<QString> Stored(not_null<Main::Session*> session) {
+	auto result = std::vector<QString>();
+	const auto list = ReadStore().value(SessionKey(session)).toArray();
+	for (const auto &value : list) {
+		const auto text = value.toString();
+		if (!text.trimmed().isEmpty()) {
+			result.push_back(text);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> Sent(
+		not_null<History*> history) {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &item : history->clientSideMessages()) {
+		if (item->isHistoryEntry() && item->out()) {
+			result.push_back(item);
+		}
+	}
+	ranges::sort(result, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return a->id < b->id;
+	});
+	return result;
+}
+
+void Save(not_null<Main::Session*> session) {
+	const auto history = session->data().historyLoaded(PlaygroundPeerId());
+	auto list = QJsonArray();
+	if (history) {
+		const auto sent = Sent(history);
+		const auto from = std::max(int(sent.size()) - kMaxStored, 0);
+		for (auto i = from; i < int(sent.size()); ++i) {
+			list.push_back(sent[i]->originalText().text);
+		}
+	}
+	auto store = ReadStore();
+	if (list.isEmpty()) {
+		store.remove(SessionKey(session));
+	} else {
+		store.insert(SessionKey(session), list);
+	}
+	WriteStore(store);
+}
+
+void ScheduleSave(not_null<Main::Session*> session) {
+	if (!SaveScheduled.emplace(session).second) {
+		return;
+	}
+	crl::on_main(session.get(), [=] {
+		SaveScheduled.remove(session);
+		if (!Clearing.contains(session) && HtmlBubbles()) {
+			Save(session);
+		}
+	});
+}
+
+[[nodiscard]] not_null<UserData*> EnsureUser(
+		not_null<Main::Session*> session) {
+	using Flag = MTPDuser::Flag;
+	const auto owner = &session->data();
+	const auto user = owner->processUser(MTP_user(
+		MTP_flags(Flag::f_first_name | Flag::f_photo),
+		MTP_long(kUserId.bare),
+		MTPlong(),
+		MTP_string(u"HTML playground"_q),
+		MTPstring(),
+		MTPstring(),
+		MTPstring(),
+		MTP_userProfilePhotoEmpty(),
+		MTPUserStatus(),
+		MTPint(),
+		MTPVector<MTPRestrictionReason>(),
+		MTPstring(),
+		MTPstring(),
+		MTPEmojiStatus(),
+		MTPVector<MTPUsername>(),
+		MTPRecentStory(),
+		MTPPeerColor(),
+		MTPPeerColor(),
+		MTPint(),
+		MTPlong(),
+		MTPlong(),
+		MTPlong()));
+	if (user->notify().settingsUnknown()) {
+		user->notify().resetToDefault();
+	}
+	return user;
+}
+
+[[nodiscard]] not_null<History*> EnsureHistory(not_null<UserData*> user) {
+	const auto history = user->owner().history(user);
+	if (!history->folderKnown()) {
+		history->applyDialogFields(nullptr, 0, 0, 0);
+		history->dialogEntryApplied();
+	}
+	return history;
+}
+
+void Post(
+		not_null<History*> history,
+		const QString &text,
+		bool out) {
+	const auto session = &history->session();
+	const auto owner = &session->data();
+	const auto item = history->makeMessage({
+		.id = owner->nextLocalMessageId(),
+		.flags = MessageFlag::Local
+			| (out ? MessageFlag::Outgoing : MessageFlag()),
+		.from = out ? session->userPeerId() : history->peer->id,
+		.date = base::unixtime::now(),
+	}, TextWithEntities{ text }, MTP_messageMediaEmpty());
+	history->addNewLocalMessage(item);
+}
+
+void Create(not_null<Main::Session*> session) {
+	if (const auto history = session->data().historyLoaded(
+			PlaygroundPeerId())) {
+		if (!history->clientSideMessages().empty()) {
+			return;
+		}
+	}
+	const auto user = EnsureUser(session);
+	const auto history = EnsureHistory(user);
+	for (const auto &sample : PlaygroundSamples()) {
+		Post(history, sample, false);
+	}
+	for (const auto &text : Stored(session)) {
+		Post(history, text, true);
+	}
+	session->data().sendHistoryChangeNotifications();
+}
+
+void Destroy(not_null<Main::Session*> session) {
+	const auto history = session->data().historyLoaded(PlaygroundPeerId());
+	if (!history) {
+		return;
+	}
+	Clearing.emplace(session);
+	session->data().deleteConversationLocally(history->peer);
+	Clearing.remove(session);
+}
+
+} // namespace
+
+PeerId PlaygroundPeerId() {
+	return peerFromUser(kUserId);
+}
+
+bool IsPlaygroundPeer(const PeerData *peer) {
+	return peer && (peer->id == PlaygroundPeerId());
+}
+
+QImage *PlaygroundUserpic() {
+	static auto result = [] {
+		auto image = QImage(
+			QSize(kUserpicSize, kUserpicSize),
+			QImage::Format_ARGB32_Premultiplied);
+		auto p = QPainter(&image);
+		auto gradient = QLinearGradient(0, 0, kUserpicSize, kUserpicSize);
+		gradient.setColorAt(0., QColor(0xff, 0x8a, 0x3d));
+		gradient.setColorAt(1., QColor(0xe0, 0x3e, 0x7a));
+		p.fillRect(image.rect(), gradient);
+		auto font = QFont();
+		font.setPixelSize(kUserpicSize * 3 / 8);
+		font.setBold(true);
+		p.setFont(font);
+		p.setPen(Qt::white);
+		p.setRenderHint(QPainter::TextAntialiasing);
+		p.drawText(image.rect(), Qt::AlignCenter, u"</>"_q);
+		return image;
+	}();
+	return &result;
+}
+
+QString PlaygroundStatus() {
+	return Lower(u"Local HTML cards"_q);
+}
+
+void SetupPlayground(not_null<Main::Session*> session) {
+	session->data().itemRemoved(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return item->out() && IsPlaygroundPeer(item->history()->peer);
+	}) | rpl::on_next([=] {
+		if (!Clearing.contains(session)) {
+			ScheduleSave(session);
+		}
+	}, session->lifetime());
+
+	HtmlBubblesValue(
+	) | rpl::on_next([=](bool enabled) {
+		if (enabled) {
+			crl::on_main(session.get(), [=] {
+				if (HtmlBubbles()) {
+					Create(session);
+				}
+			});
+		} else {
+			ClearCards();
+			Destroy(session);
+		}
+		RefreshViews();
+	}, session->lifetime());
+}
+
+void ShowPlayground(
+		not_null<Window::SessionController*> controller,
+		const Window::SectionShow &params) {
+	const auto session = &controller->session();
+	if (HtmlBubbles()) {
+		Create(session);
+	}
+	const auto history = session->data().historyLoaded(PlaygroundPeerId());
+	if (!history) {
+		return;
+	}
+	controller->showSection(
+		std::make_shared<PlaygroundMemento>(history),
+		params);
+}
+
+void SendToPlayground(not_null<History*> history, const QString &text) {
+	Post(history, text, true);
+	history->owner().sendHistoryChangeNotifications();
+	ScheduleSave(&history->session());
+}
+
+void ConfirmResetPlayground(
+		not_null<Window::SessionController*> controller,
+		not_null<History*> history) {
+	const auto session = &history->session();
+	controller->show(Ui::MakeConfirmBox({
+		.text = Lower(u"Reset the HTML playground? Your cards here "
+			"will be deleted."_q),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			Destroy(session);
+			auto store = ReadStore();
+			store.remove(SessionKey(session));
+			WriteStore(store);
+			if (HtmlBubbles()) {
+				Create(session);
+			}
+		},
+		.confirmText = Lower(u"Reset"_q),
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
+
+void MarkPlaygroundRead(not_null<History*> history) {
+	history->owner().histories().readInbox(history);
+}
+
+} // namespace Tele::Html
