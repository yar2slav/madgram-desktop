+uint64 Scheme::key() const {
+	auto result = uint64(dark ? 1 : 0);
+	const auto mix = [&](const QColor &color) {
+		result = result * 1000003ULL + uint64(color.rgba());
+	};
+	mix(fg);
+	mix(muted);
+	mix(card);
+	mix(border);
+	mix(link);
+	mix(accent);
+	return result;
+}
