+++ b/Telegram/SourceFiles/tele/tele_html_script.cpp
@@ -0,0 +1,698 @@
+#include "tele/tele_html_script.h"
+
+#include <QtCore/QTime>
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+
+namespace Tele::Html {
+namespace {
+
+constexpr auto kMemoryLimit = size_t(32 * 1024 * 1024);
+constexpr auto kStackLimit = size_t(256 * 1024);
+constexpr auto kStartBudget = crl::time(500);
+constexpr auto kCallBudget = crl::time(120);
+constexpr auto kMaxTimers = 32;
+constexpr auto kMaxHtml = 512 * 1024;
+constexpr auto kMaxLog = 300;
+constexpr auto kMaxJobs = 100000;
+constexpr auto kWindow = crl::time(1000);
+constexpr auto kWindowBudget = crl::time(200);
+constexpr auto kMaxOverruns = 5;
+
+enum Native {
+	kLog,
+	kSchedule,
+	kCancel,
+	kFrame,
+	kTransition,
+	kCopy,
+	kUpdate,
+};
+
+const char kPrelude[] = R"js((function (native, maxTimers, maxHtml, kinds) {
+'use strict';
+const timers = new Map();
+const frames = new Map();
+let timerId = 0;
+let frameId = 0;
+const origin = Date.now();
+const now = () => Date.now() - origin;
+const show = v => {
+	if (typeof v === 'string') return v;
+	if (v instanceof Error) return v.name + ': ' + v.message;
+	if (v !== null && typeof v === 'object') {
+		try { const s = JSON.stringify(v); if (s !== undefined) return s; } catch (e) {}
+	}
+	return String(v);
+};
+const logger = level => (...args) => native.log(level, args.map(show).join(' ').slice(0, 2000));
+const addTimer = (fn, ms, args, repeat) => {
+	if (typeof fn !== 'function') throw new TypeError('setTimeout and setInterval take a function');
+	if (timers.size >= maxTimers) throw new RangeError('too many timers, the limit is ' + maxTimers);
+	const id = ++timerId;
+	timers.set(id, { fn, args, repeat });
+	native.schedule(id, Math.max(0, Math.min(Number(ms) || 0, 86400000)), repeat);
+	return id;
+};
+const clearTimer = id => { if (timers.delete(id)) native.cancel(id); };
+const requestFrame = fn => {
+	if (typeof fn !== 'function') throw new TypeError('requestAnimationFrame takes a function');
+	const id = ++frameId;
+	frames.set(id, fn);
+	native.frame();
+	return id;
+};
+const ease = Object.freeze({
+	linear: t => t,
+	inQuad: t => t * t,
+	outQuad: t => t * (2 - t),
+	inOutQuad: t => (t < 0.5) ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2,
+	inCubic: t => t * t * t,
+	outCubic: t => 1 - Math.pow(1 - t, 3),
+	inOutCubic: t => (t < 0.5) ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2,
+	outQuint: t => 1 - Math.pow(1 - t, 5),
+	outExpo: t => (t >= 1) ? 1 : 1 - Math.pow(2, -10 * t),
+	inOutSine: t => (1 - Math.cos(Math.PI * t)) / 2,
+	outBack: t => { const s = 1.70158; const u = t - 1; return 1 + (s + 1) * u * u * u + s * u * u; },
+	inOutBack: t => {
+		const s = 1.70158 * 1.525;
+		return (t < 0.5)
+			? (Math.pow(2 * t, 2) * ((s + 1) * 2 * t - s)) / 2
+			: (Math.pow(2 * t - 2, 2) * ((s + 1) * (2 * t - 2) + s) + 2) / 2;
+	},
+	outElastic: t => (t <= 0 || t >= 1) ? t : Math.pow(2, -10 * t) * Math.sin((t * 10 - 0.75) * (2 * Math.PI) / 3) + 1,
+	outBounce: t => {
+		const k = 7.5625, d = 2.75;
+		if (t < 1 / d) return k * t * t;
+		if (t < 2 / d) { t -= 1.5 / d; return k * t * t + 0.75; }
+		if (t < 2.5 / d) { t -= 2.25 / d; return k * t * t + 0.9375; }
+		t -= 2.625 / d;
+		return k * t * t + 0.984375;
+	},
+	spring: t => (t <= 0 || t >= 1) ? t : 1 - Math.exp(-7 * t) * Math.cos(9.5 * t),
+});
+const animate = (duration, onFrame, easing = ease.inOutCubic) => new Promise(resolve => {
+	const start = now();
+	const total = Math.max(1, Number(duration) || 0);
+	const step = () => {
+		const t = Math.min(1, (now() - start) / total);
+		onFrame(easing(t), t);
+		if (t < 1) requestFrame(step); else resolve();
+	};
+	step();
+});
+const owners = new WeakMap();
+const tween = (target, props, duration = 300, easing = ease.outCubic) => {
+	if (target === null || typeof target !== 'object') throw new TypeError('tween() animates the fields of an object');
+	let keys = owners.get(target);
+	if (!keys) { keys = new Map(); owners.set(target, keys); }
+	const token = {}, from = {}, to = {};
+	for (const key of Object.keys(props)) {
+		from[key] = Number(target[key]) || 0;
+		to[key] = Number(props[key]);
+		keys.set(key, token);
+	}
+	return animate(duration, p => {
+		for (const key in to) if (keys.get(key) === token) target[key] = from[key] + (to[key] - from[key]) * p;
+	}, easing).then(() => {
+		for (const key in to) if (keys.get(key) === token) { target[key] = to[key]; keys.delete(key); }
+	});
+};
+const clamp = (x, lo, hi) => Math.min(hi, Math.max(lo, x));
+const rgba = c => {
+	if (Array.isArray(c)) return [c[0] || 0, c[1] || 0, c[2] || 0, (c.length > 3) ? c[3] : 1];
+	const s = String(c).trim();
+	let m = /^#([0-9a-f]{3,8})$/i.exec(s);
+	if (m) {
+		let h = m[1];
+		if (h.length <= 4) h = h.split('').map(x => x + x).join('');
+		const n = parseInt(h.slice(0, 6), 16);
+		return [(n >> 16) & 255, (n >> 8) & 255, n & 255, (h.length === 8) ? parseInt(h.slice(6), 16) / 255 : 1];
+	}
+	m = /^rgba?\(([^)]*)\)$/i.exec(s);
+	if (m) {
+		const p = m[1].split(',').map(Number);
+		return [p[0] || 0, p[1] || 0, p[2] || 0, (p.length > 3) ? p[3] : 1];
+	}
+	return [0, 0, 0, 1];
+};
+const css = v => 'rgba(' + Math.round(clamp(v[0], 0, 255)) + ',' + Math.round(clamp(v[1], 0, 255)) + ','
+	+ Math.round(clamp(v[2], 0, 255)) + ',' + clamp(v[3], 0, 1).toFixed(3) + ')';
+const mix = (a, b, t) => { const x = rgba(a), y = rgba(b); return css(x.map((q, i) => q + (y[i] - q) * t)); };
+const alpha = (c, a) => { const v = rgba(c); return css([v[0], v[1], v[2], a * v[3]]); };
+const esc = v => String((v === undefined || v === null) ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
+	.replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+const transition = (kind = 'fade') => {
+	if (!kinds.includes(kind)) throw new RangeError('transition() takes one of: ' + kinds.join(', '));
+	native.transition(kind);
+};
+Object.assign(globalThis, {
+	setTimeout: (fn, ms, ...args) => addTimer(fn, ms, args, false),
+	setInterval: (fn, ms, ...args) => addTimer(fn, ms, args, true),
+	clearTimeout: clearTimer,
+	clearInterval: clearTimer,
+	requestAnimationFrame: requestFrame,
+	cancelAnimationFrame: id => { frames.delete(id); },
+	performance: Object.freeze({ now }),
+	animate,
+	tween,
+	ease,
+	sleep: ms => new Promise(resolve => addTimer(resolve, ms, [], false)),
+	lerp: (a, b, t) => a + (b - a) * t,
+	clamp,
+	mix,
+	alpha,
+	esc,
+	transition,
+	copyText: text => native.copy(String(text).slice(0, 10000)),
+	update: () => native.update(),
+	console: Object.freeze({
+		log: logger(0), info: logger(0), debug: logger(0), warn: logger(1), error: logger(2),
+	}),
+});
+delete globalThis.WebAssembly;
+return {
+	fire(id) {
+		const t = timers.get(id);
+		if (!t) return;
+		if (!t.repeat) timers.delete(id);
+		t.fn(...t.args);
+	},
+	frame() {
+		const due = [...frames.values()];
+		frames.clear();
+		let error = null;
+		for (const fn of due) { try { fn(now()); } catch (e) { if (!error) error = e; } }
+		if (error) throw error;
+		return frames.size > 0;
+	},
+	render() {
+		if (typeof render !== 'function') return null;
+		const html = render();
+		if (typeof html !== 'string') throw new TypeError('render() must return a string, not ' + ((html === null) ? 'null' : typeof html));
+		if (html.length > maxHtml) throw new RangeError('render() returned ' + html.length + ' characters, the limit is ' + maxHtml);
+		return html;
+	},
+	action(name, value) {
+		if (typeof onAction === 'function') onAction(name, value);
+	},
+	describe(e) {
+		let s = (e instanceof Error) ? (e.name + ': ' + e.message) : ('Uncaught ' + show(e));
+		const m = (e && typeof e.stack === 'string') ? /card\.js:(\d+)/.exec(e.stack) : null;
+		if (m) s += ' (line ' + m[1] + ')';
+		return s.slice(0, 500);
+	},
+};
+}))js";
+
+const char *Kinds[] = {
+	"fade",
+	"slide-left",
+	"slide-right",
+	"slide-up",
+	"slide-down",
+	"pop",
+	"none",
+};
+
+[[nodiscard]] Script *ScriptOf(JSContext *ctx) {
+	return static_cast<Script*>(JS_GetContextOpaque(ctx));
+}
+
+JSValue NativeCall(
+		JSContext *ctx,
+		JSValueConst thisValue,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	return ScriptOf(ctx)->native(magic, argc, argv);
+}
+
+int Interrupt(JSRuntime *rt, void *opaque) {
+	return static_cast<Script*>(opaque)->interrupt() ? 1 : 0;
+}
+
+} // namespace
+
+std::unique_ptr<Script> Script::Create(QString source, Fn<void()> changed) {
+	return std::make_unique<Script>(std::move(source), std::move(changed));
+}
+
+Script::Script(QString source, Fn<void()> changed)
+: _changed(std::move(changed))
+, _resume([=] { resumeDeferred(); })
+, _rt(JS_NewRuntime()) {
+	if (!_rt) {
+		_failed = true;
+		return;
+	}
+	JS_SetMemoryLimit(_rt, kMemoryLimit);
+	JS_SetMaxStackSize(_rt, kStackLimit);
+	JS_SetInterruptHandler(_rt, Interrupt, this);
+	_ctx = JS_NewContext(_rt);
+	if (!_ctx) {
+		_failed = true;
+		return;
+	}
+	JS_SetContextOpaque(_ctx, this);
+	start(source);
+}
+
+Script::~Script() {
+	_timers.clear();
+	if (_ctx) {
+		JS_FreeValue(_ctx, _hooks);
+		JS_FreeContext(_ctx);
+	}
+	if (_rt) {
+		JS_FreeRuntime(_rt);
+	}
+}
+
+bool Script::interrupt() {
+	if ((_deadline > 0) && (crl::now() > _deadline)) {
+		_interrupted = true;
+	}
+	return _interrupted;
+}
+
+JSValue Script::native(int magic, int argc, JSValueConst *argv) {
+	const auto number = [&](int index) {
+		auto result = 0.;
+		if (index < argc) {
+			JS_ToFloat64(_ctx, &result, argv[index]);
+		}
+		return result;
+	};
+	const auto text = [&](int index) {
+		return (index < argc) ? string(argv[index]) : QString();
+	};
+	switch (magic) {
+	case kLog: {
+		const auto level = int(number(0));
+		addLog(
+			(level == 2) ? Level::Error : (level == 1) ? Level::Warn : Level::Log,
+			text(1));
+	} break;
+	case kSchedule:
+		schedule(
+			int(number(0)),
+			crl::time(number(1)),
+			(argc > 2) && (JS_ToBool(_ctx, argv[2]) > 0));
+		break;
+	case kCancel:
+		cancel(int(number(0)));
+		break;
+	case kFrame:
+		_frames = true;
+		break;
+	case kTransition:
+		_transition = text(0);
+		break;
+	case kCopy:
+		if (_inAction) {
+			QGuiApplication::clipboard()->setText(text(0));
+		} else {
+			addLog(Level::Warn, u"copyText() works only from onAction()"_q);
+		}
+		break;
+	case kUpdate:
+		notify();
+		break;
+	}
+	return JS_UNDEFINED;
+}
+
+QString Script::string(JSValueConst value) {
+	auto size = size_t();
+	const auto data = JS_ToCStringLen(_ctx, &size, value);
+	if (!data) {
+		JS_FreeValue(_ctx, JS_GetException(_ctx));
+		return QString();
+	}
+	auto result = QString::fromUtf8(data, int(size));
+	JS_FreeCString(_ctx, data);
+	return result;
+}
+
+void Script::start(const QString &source) {
+	if (!enter(kStartBudget)) {
+		return;
+	}
+	const auto prelude = JS_Eval(
+		_ctx,
+		kPrelude,
+		sizeof(kPrelude) - 1,
+		"prelude.js",
+		JS_EVAL_TYPE_GLOBAL);
+	if (!check(prelude, u"prelude"_q)) {
+		leave();
+		return;
+	}
+	auto object = JS_NewObject(_ctx);
+	const auto add = [&](const char *name, int magic, int length) {
+		JS_SetPropertyStr(
+			_ctx,
+			object,
+			name,
+			JS_NewCFunctionMagic(
+				_ctx,
+				NativeCall,
+				name,
+				length,
+				JS_CFUNC_generic_magic,
+				magic));
+	};
+	add("log", kLog, 2);
+	add("schedule", kSchedule, 3);
+	add("cancel", kCancel, 1);
+	add("frame", kFrame, 0);
+	add("transition", kTransition, 1);
+	add("copy", kCopy, 1);
+	add("update", kUpdate, 0);
+	auto kinds = JS_NewArray(_ctx);
+	for (auto i = 0; i != int(std::size(Kinds)); ++i) {
+		JS_SetPropertyUint32(_ctx, kinds, i, JS_NewString(_ctx, Kinds[i]));
+	}
+	JSValue args[] = {
+		object,
+		JS_NewInt32(_ctx, kMaxTimers),
+		JS_NewInt32(_ctx, kMaxHtml),
+		kinds,
+	};
+	const auto hooks = JS_Call(_ctx, prelude, JS_UNDEFINED, 4, args);
+	for (auto &arg : args) {
+		JS_FreeValue(_ctx, arg);
+	}
+	JS_FreeValue(_ctx, prelude);
+	if (!check(hooks, u"prelude"_q)) {
+		leave();
+		return;
+	}
+	_hooks = hooks;
+	const auto utf8 = source.toUtf8();
+	const auto result = JS_Eval(
+		_ctx,
+		utf8.constData(),
+		utf8.size(),
+		"card.js",
+		JS_EVAL_TYPE_GLOBAL);
+	if (check(result, u"script"_q)) {
+		JS_FreeValue(_ctx, result);
+		runJobs();
+	}
+	leave();
+}
+
+JSValue Script::hook(const char *name) {
+	return JS_GetPropertyStr(_ctx, _hooks, name);
+}
+
+bool Script::enter(crl::time budget) {
+	if (_failed || !_ctx) {
+		return false;
+	}
+	if (!_depth++) {
+		JS_UpdateStackTop(_rt);
+		_entered = crl::now();
+		_deadline = _entered + budget;
+		_interrupted = false;
+	}
+	return true;
+}
+
+void Script::leave() {
+	if (!--_depth) {
+		_deadline = 0;
+		account(crl::now() - _entered);
+	}
+}
+
+bool Script::overloaded() const {
+	return _overloaded && (crl::now() - _windowStart < kWindow);
+}
+
+void Script::account(crl::time spent) {
+	const auto now = crl::now();
+	if (now - _windowStart >= kWindow) {
+		_windowStart = now;
+		_spent = 0;
+		_overloaded = false;
+	}
+	_spent += spent;
+	if (_spent <= kWindowBudget || _overloaded || _failed) {
+		return;
+	}
+	_overloaded = true;
+	if (++_overruns >= kMaxOverruns) {
+		stop(u"the script kept using too much CPU and was stopped"_q);
+		return;
+	}
+	addLog(Level::Warn, u"the script is using too much CPU, slowing down"_q);
+	_resume.callOnce(std::max(_windowStart + kWindow - now, crl::time(1)));
+}
+
+void Script::setPaused(bool paused) {
+	_paused = paused;
+	if (!paused) {
+		resumeDeferred();
+	}
+}
+
+void Script::resumeDeferred() {
+	if (_paused || overloaded()) {
+		return;
+	}
+	for (const auto id : base::take(_deferred)) {
+		fire(id);
+	}
+}
+
+void Script::warn(const QString &text) {
+	addLog(Level::Warn, text);
+}
+
+void Script::runJobs() {
+	for (auto i = 0; i != kMaxJobs && !_failed; ++i) {
+		auto ctx = (JSContext*)nullptr;
+		const auto result = JS_ExecutePendingJob(_rt, &ctx);
+		if (result <= 0) {
+			if (result < 0) {
+				check(JS_EXCEPTION, u"promise"_q);
+			}
+			break;
+		}
+	}
+}
+
+QString Script::describe(JSValue exception) {
+	auto result = QString();
+	if (JS_IsObject(_hooks)) {
+		auto function = hook("describe");
+		if (JS_IsFunction(_ctx, function)) {
+			const auto saved = _deadline;
+			_deadline = crl::now() + kCallBudget;
+			auto value = JS_Call(_ctx, function, _hooks, 1, &exception);
+			_deadline = saved;
+			if (JS_IsException(value)) {
+				JS_FreeValue(_ctx, JS_GetException(_ctx));
+			} else {
+				result = string(value);
+			}
+			JS_FreeValue(_ctx, value);
+		}
+		JS_FreeValue(_ctx, function);
+	}
+	return result.isEmpty() ? string(exception) : result;
+}
+
+bool Script::check(JSValue value, const QString &where) {
+	if (!JS_IsException(value)) {
+		return true;
+	}
+	const auto exception = JS_GetException(_ctx);
+	if (_interrupted) {
+		JS_FreeValue(_ctx, exception);
+		stop(u"the script ran out of time in %1 and was stopped"_q
+			.arg(where));
+		return false;
+	}
+	const auto text = describe(exception);
+	JS_FreeValue(_ctx, exception);
+	if (text.contains(u"out of memory"_q, Qt::CaseInsensitive)) {
+		stop(u"the script ran out of memory in %1 and was stopped"_q
+			.arg(where));
+		return false;
+	}
+	addLog(Level::Error, where + u": "_q + text);
+	return false;
+}
+
+void Script::stop(const QString &reason) {
+	addLog(Level::Error, reason);
+	_failed = true;
+	_frames = false;
+	_deferred.clear();
+	crl::on_main(this, [=] {
+		_timers.clear();
+	});
+}
+
+void Script::addLog(Level level, QString text) {
+	const auto prefix = (level == Level::Error)
+		? u"error"_q
+		: (level == Level::Warn)
+		? u"warn"_q
+		: u"log"_q;
+	const auto time = QTime::currentTime().toString(u"HH:mm:ss.zzz"_q);
+	_log.push_back(time + ' ' + prefix + u": "_q + text);
+	if (_log.size() > kMaxLog) {
+		_log.erase(begin(_log), begin(_log) + (_log.size() - kMaxLog));
+	}
+	_logUpdates.fire({});
+}
+
+void Script::notify() {
+	if (_notifyScheduled) {
+		return;
+	}
+	_notifyScheduled = true;
+	crl::on_main(this, [=] {
+		_notifyScheduled = false;
+		if (_changed) {
+			_changed();
+		}
+	});
+}
+
+void Script::schedule(int id, crl::time delay, bool repeat) {
+	auto &timer = _timers[id];
+	timer = std::make_unique<base::Timer>([=] {
+		crl::on_main(this, [=] {
+			fire(id);
+		});
+	});
+	if (repeat) {
+		timer->callEach(std::max(delay, crl::time(4)));
+	} else {
+		timer->callOnce(delay);
+	}
+}
+
+void Script::cancel(int id) {
+	_timers.erase(id);
+}
+
+void Script::fire(int id) {
+	if (_failed) {
+		return;
+	} else if (_paused || overloaded()) {
+		if (!ranges::contains(_deferred, id)) {
+			_deferred.push_back(id);
+		}
+		return;
+	}
+	const auto i = _timers.find(id);
+	if (i == end(_timers)) {
+		return;
+	} else if (!i->second->isActive()) {
+		_timers.erase(i);
+	}
+	if (!enter(kCallBudget)) {
+		return;
+	}
+	auto function = hook("fire");
+	auto argument = JS_NewInt32(_ctx, id);
+	const auto result = JS_Call(_ctx, function, _hooks, 1, &argument);
+	JS_FreeValue(_ctx, function);
+	if (check(result, u"timer"_q)) {
+		JS_FreeValue(_ctx, result);
+		runJobs();
+	}
+	leave();
+	notify();
+}
+
+QString Script::render() {
+	if (!enter(kCallBudget)) {
+		return QString();
+	}
+	auto function = hook("render");
+	const auto result = JS_Call(_ctx, function, _hooks, 0, nullptr);
+	JS_FreeValue(_ctx, function);
+	auto html = QString();
+	if (check(result, u"render()"_q)) {
+		if (JS_IsString(result)) {
+			html = string(result);
+		}
+		JS_FreeValue(_ctx, result);
+		runJobs();
+	}
+	leave();
+	return html;
+}
+
+void Script::action(QString name, QString value) {
+	if (!enter(kCallBudget)) {
+		return;
+	}
+	_inAction = true;
+	auto function = hook("action");
+	const auto first = name.toUtf8();
+	const auto second = value.toUtf8();
+	JSValue args[] = {
+		JS_NewStringLen(_ctx, first.constData(), first.size()),
+		JS_NewStringLen(_ctx, second.constData(), second.size()),
+	};
+	const auto result = JS_Call(_ctx, function, _hooks, 2, args);
+	JS_FreeValue(_ctx, args[0]);
+	JS_FreeValue(_ctx, args[1]);
+	JS_FreeValue(_ctx, function);
+	if (check(result, u"onAction()"_q)) {
+		JS_FreeValue(_ctx, result);
+		runJobs();
+	}
+	_inAction = false;
+	leave();
+	notify();
+}
+
+bool Script::animating() const {
+	return _frames && !_failed;
+}
+
+void Script::tick(crl::time now) {
+	if (!_frames || _paused || overloaded() || !enter(kCallBudget)) {
+		return;
+	}
+	_frames = false;
+	auto function = hook("frame");
+	const auto result = JS_Call(_ctx, function, _hooks, 0, nullptr);
+	JS_FreeValue(_ctx, function);
+	if (check(result, u"animation frame"_q)) {
+		if (JS_ToBool(_ctx, result) > 0) {
+			_frames = true;
+		}
+		JS_FreeValue(_ctx, result);
+		runJobs();
+	}
+	leave();
+}
+
+QString Script::takeTransition() {
+	return base::take(_transition);
+}
+
+const std::vector<QString> &Script::log() const {
+	return _log;
+}
+
+rpl::producer<> Script::logUpdates() const {
+	return _logUpdates.events();
+}
+
+bool Script::failed() const {
+	return _failed;
+}
+
+} // namespace Tele::Html
