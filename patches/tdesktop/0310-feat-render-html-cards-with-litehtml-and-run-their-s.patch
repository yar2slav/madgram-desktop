+function onAction(name) {
+  if (name === 'reset') {
+    if (count === 0) return;
+    count = 0;
+    transition('pop');
+  } else {
+    count += (name === 'up') ? 1 : -1;
+  }
+  console.log('count is', count);
+  shown.size = 1.3;
+  tween(shown, { value: count }, 280, ease.outCubic);
+  tween(shown, { size: 1 }, 420, ease.outBack);
+}
+
+function render() {
+  const tone = count > 0 ? 't-green' : count < 0 ? 't-red' : '';
+  return `<div class="counter">
+    <div class="caps">Counter</div>
+    <div class="value ${tone}" style="font-size: ${Math.round(40 * shown.size)}px">${Math.round(shown.value)}</div>
+    <div class="buttons">
+      <button data-action="down">−</button>
+      <button data-action="reset">↺</button>
+      <button class="primary" data-action="up">+</button>
+    </div>
+  </div>`;
+}
+</script>
+</div>)html";
+
+const char kChart[] = R"html(<div class="widget">
+<style>
+.chart { width: 300px; }
+.chart .bars { display: flex; align-items: flex-end; height: 120px; margin-top: 10px; }
+.chart .bar { width: 24px; margin: 0 8px; border-radius: 5px 5px 0 0; background: linear-gradient(180deg, #5aa9ff, #2f6fd6); }
+.chart .bar.best { background: linear-gradient(180deg, #ffb84d, #f07c1e); }
+.chart .bar.picked { background: linear-gradient(180deg, #5fd38a, #23a356); }
+.chart .days { display: flex; margin-top: 4px; }
+.chart .day { width: 40px; text-align: center; }
+.chart .seg { display: inline-block; padding: 2px 10px; margin-left: 4px; border-radius: 10px; font-size: 12px; font-weight: 600; background-color: rgba(127,127,127,0.14); }
+.chart .seg.on { background-color: #3a8ee6; color: #ffffff; }
+.chart .note { height: 18px; margin-top: 6px; }
+</style>
+<div class="chart">
+  <div class="row between"><b>Messages a day</b><span class="small muted">this week</span></div>
+  <div class="bars">
+    <div class="bar" style="height: 40px"></div>
+    <div class="bar" style="height: 72px"></div>
+    <div class="bar" style="height: 55px"></div>
+    <div class="bar best" style="height: 110px"></div>
+    <div class="bar" style="height: 64px"></div>
+    <div class="bar" style="height: 30px"></div>
+    <div class="bar" style="height: 48px"></div>
+  </div>
+  <div class="days small muted"><div class="day">Mo</div><div class="day">Tu</div><div class="day">We</div><div class="day">Th</div><div class="day">Fr</div><div class="day">Sa</div><div class="day">Su</div></div>
+</div>
+<script>
+const DAYS = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
+const DATA = {
+  'this week': [36, 64, 49, 98, 57, 27, 43],
+  'last week': [52, 41, 70, 45, 88, 61, 22],
+};
+let range = 'this week';
+let picked = -1;
+const heights = {};
+DAYS.forEach((_, i) => heights[i] = 0);
+
+function grow() {
+  const max = Math.max(...DATA[range]);
+  const target = {};
+  DATA[range].forEach((v, i) => target[i] = Math.round(v / max * 110));
+  tween(heights, target, 520, ease.outCubic);
+}
+
+function onAction(name, value) {
+  if (name === 'range' && value !== range) {
+    range = value;
+    picked = -1;
+    grow();
+  } else if (name === 'pick') {
+    picked = (picked === Number(value)) ? -1 : Number(value);
+  }
+}
+
+function render() {
+  const values = DATA[range];
+  const best = values.indexOf(Math.max(...values));
+  const seg = Object.keys(DATA).map(k => `<span class="seg ${k === range ? 'on' : ''}" data-action="range" data-value="${k}">${k}</span>`).join('');
+  const bars = DAYS.map((d, i) => {
+    const kind = i === picked ? 'picked' : i === best ? 'best' : '';
+    return `<div class="bar ${kind}" data-action="pick" data-value="${i}" style="height: ${Math.max(2, heights[i]).toFixed(1)}px"></div>`;
+  }).join('');
+  const note = picked >= 0
+    ? `${DAYS[picked]}: <b>${values[picked]}</b> messages`
+    : `Busiest day: <b>${DAYS[best]}</b>`;
+  return `<div class="chart">
+    <div class="row between"><b>Messages a day</b><span>${seg}</span></div>
+    <div class="bars">${bars}</div>
+    <div class="days small muted">${DAYS.map(d => `<div class="day">${d}</div>`).join('')}</div>
+    <div class="note small">${note}</div>
+  </div>`;
+}
+
+grow();
+</script>
+</div>)html";
