+	pixel_t text_width(const char *text, litehtml::uint_ptr hFont) override {
+		const auto handle = reinterpret_cast<FontHandle*>(hFont);
+		return float(handle->base->metrics.horizontalAdvance(Utf8(text)));
+	}
+
+	void draw_text(
+			litehtml::uint_ptr hdc,
+			const char *text,
+			litehtml::uint_ptr hFont,
+			litehtml::web_color color,
+			const litehtml::position &pos) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto handle = reinterpret_cast<FontHandle*>(hFont);
+		const auto string = Utf8(text);
+		withClips(p, [&] {
+			const auto fg = ToColor(color);
+			p->setFont(handle->base->font);
+			p->setPen(fg);
+			const auto baseline = F(pos.y) + handle->base->metrics.ascent();
+			p->drawText(QPointF(F(pos.x), baseline), string);
+			if (handle->decoration) {
+				const auto line = handle->currentDecorationColor
+					? fg
+					: handle->decorationColor;
+				const auto width = handle->base->metrics.horizontalAdvance(string);
+				const auto thickness = std::max(
+					1.,
+					handle->base->metrics.lineWidth());
+				const auto draw = [&](qreal y) {
+					p->fillRect(
+						QRectF(F(pos.x), y, width, thickness),
+						line);
+				};
+				using namespace litehtml;
+				if (handle->decoration & text_decoration_line_underline) {
+					draw(baseline + handle->base->metrics.underlinePos());
+				}
+				if (handle->decoration & text_decoration_line_line_through) {
+					draw(baseline - handle->base->metrics.strikeOutPos());
+				}
+				if (handle->decoration & text_decoration_line_overline) {
+					draw(baseline - handle->base->metrics.overlinePos());
+				}
+			}
+		});
+	}
