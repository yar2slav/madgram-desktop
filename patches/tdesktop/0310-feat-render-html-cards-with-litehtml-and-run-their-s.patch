+QString CheckMarkup(const QString &html) {
+	static const auto voids = base::flat_set<QString>{
+		u"area"_q, u"base"_q, u"br"_q, u"col"_q, u"embed"_q, u"hr"_q,
+		u"img"_q, u"input"_q, u"link"_q, u"meta"_q, u"param"_q,
+		u"source"_q, u"track"_q, u"wbr"_q,
+	};
+	auto depth = 0;
+	auto count = 0;
+	const auto size = int(html.size());
+	for (auto i = 0; i < size; ++i) {
+		if (html[i] != '<' || i + 1 >= size) {
+			continue;
+		} else if (html[i + 1] == '/') {
+			depth = std::max(depth - 1, 0);
+			continue;
+		} else if (!html[i + 1].isLetter()) {
+			continue;
+		}
+		auto j = i + 1;
+		while (j < size && (html[j].isLetterOrNumber() || html[j] == '-')) {
+			++j;
+		}
+		const auto name = html.mid(i + 1, j - i - 1).toLower();
+		const auto end = html.indexOf('>', j);
+		if (end < 0) {
+			break;
+		} else if (++count > kMaxElements) {
+			return u"more than %1 elements"_q.arg(kMaxElements);
+		} else if (html[end - 1] != '/' && !voids.contains(name)) {
+			if (++depth > kMaxDepth) {
+				return u"elements nested deeper than %1"_q.arg(kMaxDepth);
+			}
+		}
+		i = end;
+	}
+	return QString();
+}
+
+QString PrepareStyles(QString css, bool dark) {
+	static const auto media = QRegularExpression(
+		u"@media\\s*\\(\\s*prefers-color-scheme\\s*:\\s*(dark|light)\\s*\\)"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	css = ReplaceLightDark(css, dark);
+	auto result = QString();
+	auto from = 0;
+	auto iterator = media.globalMatch(css);
+	while (iterator.hasNext()) {
+		const auto match = iterator.next();
+		result.append(QStringView(css).mid(
+			from,
+			match.capturedStart() - from));
+		const auto wantsDark = (match.captured(1).toLower() == u"dark"_q);
+		result.append((wantsDark == dark)
+			? u"@media screen"_q
+			: u"@media print"_q);
+		from = match.capturedEnd();
+	}
+	result.append(QStringView(css).mid(from));
+	return result;
+}
+
+QString KitStyle(const Scheme &scheme) {
+	const auto fg = CssColor(scheme.fg);
+	const auto muted = CssColor(scheme.muted);
+	const auto card = CssColor(scheme.card);
+	const auto border = CssColor(scheme.border);
+	const auto link = CssColor(scheme.link);
+	const auto accent = CssColor(scheme.accent);
+	const auto accentHover = CssColor(scheme.accent.darker(115));
+	const auto sep = CssColor(WithAlpha(scheme.fg, 0.1));
+	const auto soft = CssColor(WithAlpha(scheme.fg, 0.08));
+	const auto softer = CssColor(WithAlpha(scheme.fg, 0.14));
+	const auto pressed = CssColor(WithAlpha(scheme.fg, 0.22));
+	const auto green = scheme.dark ? u"#5ccf7d"_q : u"#2fa84f"_q;
+	const auto red = scheme.dark ? u"#ff6b61"_q : u"#e0453a"_q;
+	const auto orange = scheme.dark ? u"#ffae42"_q : u"#e88a12"_q;
+	const auto purple = scheme.dark ? u"#c38cf2"_q : u"#9b51d8"_q;
+	const auto teal = scheme.dark ? u"#4fd1d9"_q : u"#1aa3b0"_q;
+	const auto blue = accent;
+	auto result = QString();
+	result += u":root { --tele-fg: %1; --tele-muted: %2; --tele-card: %3; "
+		"--tele-border: %4; --tele-link: %5; --tele-accent: %6; "
+		"--tele-green: %7; --tele-red: %8; --tele-orange: %9; }\n"_q
+		.arg(fg, muted, card, border, link, accent, green, red, orange);
+	result += u"html, body { margin: 0; padding: 0; }\n"
+		"body { font-family: sans-serif; font-size: 14px; "
+		"line-height: 1.35; color: %1; }\n"_q.arg(fg);
+	result += u"[hidden] { display: none; }\n"
+		"p { margin: 0 0 8px 0; }\n"
+		"h1 { font-size: 20px; margin: 0 0 8px 0; }\n"
+		"h2 { font-size: 17px; margin: 0 0 6px 0; }\n"
+		"h3 { font-size: 15px; margin: 0 0 4px 0; }\n"
+		"h4, h5, h6 { font-size: 14px; margin: 0 0 4px 0; }\n"
+		"ul, ol { margin: 0 0 8px 0; padding-left: 20px; }\n"
+		"hr { border: 0; border-top: 1px solid %1; margin: 8px 0; }\n"
+		"img { max-width: 100%; }\n"
+		"table { border-collapse: collapse; }\n"
+		"td, th { padding: 3px 6px; }\n"
+		"button { box-sizing: border-box; }\n"
+		"th { text-align: left; }\n"_q.arg(sep);
+	result += u"a { color: %1; text-decoration: none; }\n"
+		"a:hover { text-decoration: underline; }\n"
+		"code, pre, kbd { font-family: monospace; font-size: 12.5px; }\n"
+		"code { padding: 0 3px; border-radius: 4px; background-color: %2; }\n"
+		"pre { margin: 0 0 8px 0; padding: 6px 8px; border-radius: 8px; "
+		"background-color: %2; white-space: pre-wrap; }\n"
+		"pre code { padding: 0; background-color: transparent; }\n"
+		"blockquote { margin: 0 0 8px 0; padding: 2px 0 2px 10px; "
+		"border-left: 3px solid %3; }\n"_q.arg(link, soft, accent);
+	result += u".widget { display: block; }\n"
+		".card { background-color: %1; border: 1px solid %2; "
+		"border-radius: 12px; color: %3; }\n"
+		".pad { padding: 12px 14px; }\n"
+		".panel { background-color: %4; border-radius: 9px; "
+		"padding: 8px 10px; }\n"
+		".fg { color: %3; } .muted { color: %5; }\n"
+		".small { font-size: 12px; } .tiny { font-size: 11px; }\n"
+		".caps { font-size: 11px; font-weight: 700; "
+		"text-transform: uppercase; color: %5; }\n"
+		".row { display: flex; align-items: center; }\n"
+		".between { justify-content: space-between; }\n"
+		".grow { flex-grow: 1; } .center { text-align: center; }\n"
+		".right { text-align: right; }\n"
+		".sep { border-top: 1px solid %6; } .nowrap { white-space: nowrap; }\n"_q
+		.arg(card, border, fg, soft, muted, sep);
+	result += u".t-blue { color: %1; } .t-green { color: %2; } "
+		".t-red { color: %3; } .t-orange { color: %4; } "
+		".t-purple { color: %5; } .t-teal { color: %6; }\n"_q
+		.arg(blue, green, red, orange, purple, teal);
+	result += u".badge { display: inline-block; padding: 1px 8px; "
+		"border-radius: 9px; font-size: 11px; font-weight: 700; "
+		"background-color: %1; }\n"
+		".badge.blue { color: %2; } .badge.green { color: %3; } "
+		".badge.red { color: %4; } .badge.orange { color: %5; } "
+		".badge.purple { color: %6; }\n"_q
+		.arg(softer, blue, green, red, orange, purple);
+	result += u".btn, button { display: inline-block; padding: 5px 13px; "
+		"border: 0; border-radius: 9px; font-size: 14px; font-weight: 600; "
+		"text-align: center; text-decoration: none; background-color: %1; "
+		"color: %2; }\n"
+		".btn:hover, button:hover { background-color: %3; "
+		"text-decoration: none; }\n"
+		".btn.primary, button.primary { background-color: %4; "
+		"color: #ffffff; }\n"
+		".btn.primary:hover, button.primary:hover { background-color: %5; }\n"
+		".btn.success { background-color: %6; color: #ffffff; }\n"
+		".btn.danger { color: %7; }\n"_q
+		.arg(soft, fg, pressed, accent, accentHover, green, red);
+	result += u".chip { display: inline-block; padding: 3px 12px; "
+		"border-radius: 14px; border: 1px solid %1; color: %1; "
+		"margin: 2px 4px 2px 0; text-decoration: none; }\n"
+		".chip:hover { background-color: %2; text-decoration: none; }\n"
+		".av { display: inline-block; width: 24px; height: 24px; "
+		"border-radius: 12px; text-align: center; line-height: 24px; "
+		"color: #ffffff; font-size: 10px; font-weight: 700; "
+		"background-color: %3; }\n"
+		".bar { height: 8px; border-radius: 4px; background-color: %4; }\n"
+		".bar > div { height: 8px; border-radius: 4px; "
+		"background-color: %1; }\n"
+		"kbd { padding: 0 6px; border-radius: 5px; border: 1px solid %5; "
+		"border-bottom-width: 2px; }\n"
+		"[data-action] { cursor: pointer; }\n"_q
+		.arg(accent, soft, muted, softer, border);
+	return result;
+}
+
+Document::Document(
+	const QString &styles,
+	const QString &body,
+	const Scheme &scheme,
+	int width)
+: _container(std::make_unique<Container>(scheme)) {
+	if (!CheckMarkup(body).isEmpty()) {
+		return;
+	}
+	const auto root = scheme.dark ? u"lc-dark"_q : u"lc-light"_q;
+	const auto html = u"<html class=\"%1\"><body>"_q.arg(root)
+		+ body
+		+ u"</body></html>"_q;
+	_width = std::max(width, 0);
+	_container->setWidth(_width);
+	try {
+		_document = litehtml::document::createFromString(
+			litehtml::estring(html.toStdString()),
+			_container.get(),
+			std::string(litehtml::master_css)
+				+ PrepareStyles(KitStyle(scheme), scheme.dark).toStdString(),
+			PrepareStyles(styles, scheme.dark).toStdString());
+	} catch (...) {
+		_document = nullptr;
+	}
+}
+
+Document::~Document() {
+	_document = nullptr;
+}
+
+bool Document::valid() const {
+	return _document != nullptr;
+}
+
+void Document::layout(int width) {
+	_width = std::max(width, 1);
+	if (!_document) {
+		return;
+	}
+	_container->setWidth(_width);
+	_document->media_changed();
+	_natural = int(std::ceil(F(_document->render(float(_width)))));
+}
+
+int Document::layoutWidth() const {
+	return _width;
+}
+
+int Document::contentWidth() const {
+	return std::clamp(_natural, 1, std::max(_width, 1));
+}
+
+int Document::height() const {
+	return _document
+		? std::max(int(std::ceil(F(_document->height()))), 1)
+		: 1;
+}
+
+void Document::paint(QPainter &p, QRect clip) const {
+	if (!_document) {
+		return;
+	}
+	_container->clearClips();
+	auto position = litehtml::position(
+		float(clip.x()),
+		float(clip.y()),
+		float(clip.width()),
+		float(clip.height()));
+	p.save();
+	p.setRenderHint(QPainter::TextAntialiasing);
+	_document->draw(
+		reinterpret_cast<litehtml::uint_ptr>(&p),
+		0.f,
+		0.f,
+		&position);
+	p.restore();
+}
+
+Hit Document::hitTest(QPoint point) const {
+	auto result = Hit();
+	if (!_document || !_document->root_render()) {
+		return result;
+	}
+	auto element = _document->root_render()->get_element_by_point(
+		float(point.x()),
+		float(point.y()),
+		float(point.x()),
+		float(point.y()),
+		nullptr);
+	for (; element; element = element->parent()) {
+		const auto tag = Utf8(element->get_tagName()).toLower();
+		if (const auto action = element->get_attr("data-action")) {
+			result.action = Utf8(action);
+			result.value = Utf8(element->get_attr("data-value", ""));
+			result.pointer = true;
+			return result;
+		} else if (tag == u"a"_q) {
+			const auto href = Utf8(element->get_attr("href", "")).trimmed();
+			if (!href.isEmpty() && !href.startsWith('#')) {
+				result.link = href;
+				result.pointer = true;
+				return result;
+			}
+		}
+	}
+	return result;
+}
+
+bool Document::hover(QPoint point) {
+	if (!_document) {
+		return false;
+	}
+	const auto changed = _document->on_mouse_over(
+		float(point.x()),
+		float(point.y()),
+		float(point.x()),
+		float(point.y()),
+		[](const litehtml::position &) {});
+	if (changed) {
+		_document->render(float(_width));
+	}
+	return changed;
+}
+
+bool Document::leave() {
+	if (!_document) {
+		return false;
+	}
+	const auto changed = _document->on_mouse_leave(
+		[](const litehtml::position &) {});
+	if (changed) {
+		_document->render(float(_width));
+	}
+	return changed;
+}
+
+QString Document::plainText() const {
+	if (!_document || !_document->root()) {
+		return QString();
+	}
+	auto text = std::string();
+	_document->root()->get_text(text);
+	return QString::fromStdString(text).simplified();
+}
+
+} // namespace Tele::Html
