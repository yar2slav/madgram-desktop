+	_shownInCard = shown;
+	_card->shown(shown);
+}
+
+void CardMedia::loadDocument() {
+	if (!_document || _card || _documentFailed || _document->cancelled()) {
+		return;
+	} else if (!_documentMedia->loaded() && !_document->loading()) {
+		_document->save(_parent->data()->fullId(), QString());
+	}
+}
+
+void CardMedia::checkDocument() {
+	if (!_document || _card || _documentFailed) {
+		return;
+	} else if (!_documentMedia->loaded()) {
+		return;
+	}
+	auto bytes = _documentMedia->bytes();
+	if (bytes.isEmpty()) {
+		const auto path = _document->filepath(true);
+		if (!path.isEmpty()) {
+			auto file = QFile(path);
+			if (file.size() <= kMaxTgwSize
+				&& file.open(QIODevice::ReadOnly)) {
+				bytes = file.readAll();
+			}
+		}
+	}
+	if (bytes.isEmpty() || bytes.size() > kMaxTgwSize) {
+		_documentFailed = true;
+		return;
+	}
+	_card = ResolveCard(_parent->data(), QString::fromUtf8(bytes));
+	subscribe();
+}
+
+void CardMedia::updated() {
+	_cacheDirty = true;
+	if (!_layout || !_layoutWidth) {
+		history()->owner().requestViewResize(_parent);
+		return;
+	}
+	const auto scheme = layoutScheme();
+	const auto oldHeight = height();
+	const auto oldNatural = _layout ? _layout->contentWidth() : 0;
+	const auto doc = document(scheme, _layoutWidth);
+	const auto margins = padding();
+	const auto newHeight = int(std::ceil(std::min(doc->height(), kMaxCssHeight) * zoom()))
+		+ margins.top()
+		+ margins.bottom()
+		+ infoSkip();
+	if (newHeight != oldHeight || doc->contentWidth() != oldNatural) {
+		history()->owner().requestViewResize(_parent);
+	} else {
+		repaintCard();
+	}
+}
+
+void CardMedia::repaintCard() const {
+	const auto topLeft = _parent->mediaTopLeft();
+	if (topLeft.isNull()) {
+		_parent->repaint();
+	} else {
+		_parent->repaint(QRect(topLeft, currentSize()));
+	}
+}
+
+void CardMedia::startTransition(const QString &kind) {
+	if (_cache.isNull()) {
+		return;
+	}
+	_transition = std::make_unique<Transition>();
+	_transition->kind = kind;
+	_transition->from = _cache;
+	_transition->animation.start([=] {
+		repaintCard();
+		if (_transition && !_transition->animation.animating()) {
+			crl::on_main(this, [=] {
+				if (_transition && !_transition->animation.animating()) {
+					_transition = nullptr;
+				}
+			});
+		}
+	}, 0., 1., kTransitionDuration, anim::easeOutCubic);
+}
+
+void CardMedia::activate(const Hit &hit) {
+	if (!_card) {
+		return;
+	} else if (!hit.action.isEmpty()) {
+		_card->action(hit.action, hit.value);
+	}
+}
+
+bool CardMedia::bubble() const {
+	return _card ? _card->parsed().bubble : true;
+}
+
+QMargins CardMedia::padding() const {
+	return bubble() ? st::msgPadding : QMargins();
+}
+
+int CardMedia::infoSkip() const {
+	const auto item = _parent->data();
+	if (!hideMessageText() && !item->emptyText()) {
+		return 0;
+	} else if (bubble()) {
+		return st::msgDateFont->height;
+	}
+	return st::msgDateImgDelta
+		+ 2 * st::msgDateImgPadding.y()
+		+ st::msgDateFont->height;
+}
+
+float64 CardMedia::zoom() const {
+	return style::Scale() / 100.;
+}
+
+int CardMedia::maxContentWidth() const {
+	const auto margins = padding();
+	const auto full = bubble()
+		? st::msgMaxWidth
+		: int(st::msgMaxWidth * kBareWidthFactor);
+	return std::max(full - margins.left() - margins.right(), 1);
+}
+
+Scheme CardMedia::layoutScheme() const {
+	if (_layoutScheme && _layout) {
+		return _lastScheme;
+	}
+	auto result = Scheme();
+	result.fg = st::windowFg->c;
+	result.muted = st::windowSubTextFg->c;
+	result.card = st::windowBg->c;
+	result.border = st::windowFg->c;
+	result.border.setAlphaF(0.12);
+	result.link = st::windowActiveTextFg->c;
+	result.accent = st::windowActiveTextFg->c;
+	result.dark = (st::windowBg->c.lightness() < 128);
+	return result;
+}
+
+Scheme CardMedia::paintScheme(
+		const HistoryView::PaintContext &context) const {
+	if (!bubble()) {
+		auto result = Scheme();
+		result.fg = st::windowFg->c;
+		result.muted = st::windowSubTextFg->c;
+		result.card = st::windowBg->c;
+		result.border = st::windowFg->c;
+		result.border.setAlphaF(0.12);
+		result.link = st::windowActiveTextFg->c;
+		result.accent = st::windowActiveTextFg->c;
+		result.dark = (st::windowBg->c.lightness() < 128);
+		return result;
+	}
+	const auto stm = &context.st->messageStyle(context.outbg, false);
+	auto result = Scheme();
+	result.fg = stm->historyTextFg->c;
+	result.muted = stm->msgDateFg->c;
+	result.card = stm->msgBg->c;
+	result.border = stm->historyTextFg->c;
+	result.border.setAlphaF(0.14);
+	result.link = stm->textPalette.linkFg->c;
+	result.accent = stm->textPalette.linkFg->c;
+	result.dark = (stm->msgBg->c.lightness() < 128);
+	return result;
+}
+
+Document *CardMedia::document(const Scheme &scheme, int width) const {
+	if (!_card) {
+		return nullptr;
+	}
+	const auto key = scheme.key();
+	if (!_layout
+		|| _layoutGeneration != _card->generation()
+		|| _layoutScheme != key) {
+		_layout = std::make_unique<Document>(
+			_card->parsed().styles,
+			_card->body(),
+			scheme,
+			width);
+		_layoutGeneration = _card->generation();
+		_layoutScheme = key;
+		_lastScheme = scheme;
+		_layoutWidth = 0;
+		_cacheDirty = true;
+		_handlers.clear();
+	}
+	if (_layoutWidth != width) {
+		_layout->layout(width);
+		_layoutWidth = width;
+		_cacheDirty = true;
+	}
+	return _layout.get();
+}
+
+QRect CardMedia::contentRect() const {
+	const auto margins = padding();
+	return QRect(
+		margins.left(),
+		margins.top(),
+		std::max(width() - margins.left() - margins.right(), 1),
+		std::max(
+			height() - margins.top() - margins.bottom() - infoSkip(),
+			1));
+}
+
+QPoint CardMedia::toDocument(QPoint point) const {
+	const auto rect = contentRect();
+	const auto scale = zoom();
+	return QPoint(
+		int(std::floor((point.x() - rect.x()) / scale)),
+		int(std::floor((point.y() - rect.y()) / scale)));
+}
+
+QSize CardMedia::countOptimalSize() {
+	const auto margins = padding();
+	if (!_card) {
+		return QSize(
+			st::msgMinWidth,
+			margins.top() + margins.bottom()
+				+ 2 * st::msgDateFont->height
+				+ infoSkip());
+	}
+	const auto scale = zoom();
+	const auto css = std::max(int(maxContentWidth() / scale), 1);
+	const auto doc = document(layoutScheme(), css);
+	const auto natural = int(std::ceil(doc->contentWidth() * scale));
+	const auto minimal = bubble() ? st::msgMinWidth : st::msgMinWidth / 2;
+	const auto width = std::max(
+		natural + margins.left() + margins.right(),
+		minimal);
+	const auto inner = std::max(width - margins.left() - margins.right(), 1);
+	const auto fitted = document(
+		layoutScheme(),
+		std::max(int(inner / scale), 1));
+	const auto height = int(std::ceil(std::min(fitted->height(), kMaxCssHeight) * scale))
+		+ margins.top()
+		+ margins.bottom()
+		+ infoSkip();
+	return { width, height };
+}
+
+QSize CardMedia::countCurrentSize(int newWidth) {
+	const auto margins = padding();
+	const auto width = std::min(newWidth, std::max(maxWidth(), 1));
+	if (!_card) {
+		return { width, minHeight() };
+	}
+	const auto scale = zoom();
+	const auto inner = std::max(width - margins.left() - margins.right(), 1);
+	const auto doc = document(layoutScheme(), std::max(int(inner / scale), 1));
+	const auto height = int(std::ceil(std::min(doc->height(), kMaxCssHeight) * scale))
+		+ margins.top()
+		+ margins.bottom()
+		+ infoSkip();
+	return { width, height };
+}
+
+void CardMedia::validateCache(const Scheme &scheme) const {
+	const auto rect = contentRect();
+	const auto scale = zoom();
+	const auto css = std::max(int(rect.width() / scale), 1);
+	const auto doc = document(scheme, css);
+	const auto ratio = style::DevicePixelRatio();
+	const auto size = rect.size() * ratio;
+	if (!_cacheDirty && _cache.size() == size) {
+		return;
+	}
+	if (_cache.size() != size) {
+		_cache = QImage(size, QImage::Format_ARGB32_Premultiplied);
+	}
+	_cache.setDevicePixelRatio(ratio);
+	_cache.fill(Qt::transparent);
+	auto q = QPainter(&_cache);
+	q.setRenderHint(QPainter::Antialiasing);
+	q.setRenderHint(QPainter::SmoothPixmapTransform);
+	q.scale(scale, scale);
+	doc->paint(q, QRect(
+		0,
+		0,
+		int(std::ceil(rect.width() / scale)),
+		int(std::ceil(rect.height() / scale))));
+	q.end();
+	_cacheDirty = false;
+	setShown(true);
+	history()->owner().registerHeavyViewPart(_parent);
+}
+
+void CardMedia::paintPlaceholder(
+		Painter &p,
+		const HistoryView::PaintContext &context,
+		QRect rect) const {
+	const auto stm = context.messageStyle();
+	p.setFont(st::msgDateFont);
+	p.setPen(stm->msgDateFg);
+	const auto name = _document
+		? _document->filename()
+		: QString();
+	const auto loading = _document && _document->loading();
+	const auto text = loading
+		? Lower(u"Loading %1…"_q).arg(name)
+		: Lower(u"Card %1"_q).arg(name);
+	p.drawText(
+		rect,
+		st::msgDateFont->elided(text, rect.width()),
+		style::al_left);
+}
+
+void CardMedia::draw(
+		Painter &p,
+		const HistoryView::PaintContext &context) const {
+	if (width() < 1 || height() < 1) {
+		return;
+	}
+	const auto rect = contentRect();
+	if (!_card) {
+		const_cast<CardMedia*>(this)->loadDocument();
+		paintPlaceholder(p, context, rect);
+	} else {
+		const auto scheme = paintScheme(context);
+		validateCache(scheme);
+		const auto progress = (_transition
+			&& _transition->animation.animating())
+			? _transition->animation.value(1.)
+			: 1.;
+		if (progress < 1.) {
+			const auto &kind = _transition->kind;
+			const auto shift = (1. - progress) * st::msgPadding.left() * 2.;
+			auto from = QPointF();
+			auto to = QPointF();
+			if (kind == u"slide-left"_q) {
+				from = QPointF(-progress * shift, 0);
+				to = QPointF(shift, 0);
+			} else if (kind == u"slide-right"_q) {
+				from = QPointF(progress * shift, 0);
+				to = QPointF(-shift, 0);
+			} else if (kind == u"slide-up"_q) {
+				from = QPointF(0, -progress * shift);
+				to = QPointF(0, shift);
+			} else if (kind == u"slide-down"_q) {
+				from = QPointF(0, progress * shift);
+				to = QPointF(0, -shift);
+			}
+			p.save();
+			p.setClipRect(rect.marginsAdded(padding()));
+			p.setOpacity(1. - progress);
+			p.drawImage(QPointF(rect.topLeft()) + from, _transition->from);
+			p.setOpacity(progress);
+			if (kind == u"pop"_q) {
+				const auto scale = 0.94 + 0.06 * progress;
+				const auto center = QPointF(rect.center());
+				p.translate(center);
+				p.scale(scale, scale);
+				p.translate(-center);
+			}
+			p.drawImage(QPointF(rect.topLeft()) + to, _cache);
+			p.restore();
+		} else {
+			p.drawImage(rect.topLeft(), _cache);
+		}
+		if (!bubble() && context.selected()) {
+			p.fillRect(rect, context.st->msgSelectOverlay());
+		}
+	}
+	if (infoSkip() > 0) {
+		const auto corner = resolveCustomInfoRightBottom();
+		_parent->drawInfo(
+			p,
+			context,
+			corner.x(),
+			corner.y(),
+			width(),
+			bubble()
+				? HistoryView::InfoDisplayType::Default
+				: HistoryView::InfoDisplayType::Background);
+	}
+}
+
+QPoint CardMedia::resolveCustomInfoRightBottom() const {
+	if (bubble()) {
+		return QPoint(
+			width() - (st::msgPadding.right() - st::msgDateDelta.x()),
+			height() - (st::msgPadding.bottom() - st::msgDateDelta.y()));
+	}
+	const auto skipx = st::msgDateImgPadding.x();
+	const auto skipy = st::msgDateImgPadding.y();
+	return QPoint(width() - skipx, height() - skipy);
+}
+
+ClickHandlerPtr CardMedia::handlerFor(const Hit &hit) const {
+	const auto key = hit.link.isEmpty()
+		? (u"a:"_q + hit.action + '\n' + hit.value)
+		: (u"l:"_q + hit.link);
+	const auto i = _handlers.find(key);
+	if (i != end(_handlers)) {
+		return i->second;
+	}
+	auto handler = ClickHandlerPtr();
+	if (!hit.link.isEmpty()) {
+		handler = std::make_shared<HiddenUrlClickHandler>(hit.link);
+	} else {
+		const auto weak = base::make_weak(const_cast<CardMedia*>(this));
+		handler = std::make_shared<LambdaClickHandler>([=] {
+			if (const auto strong = weak.get()) {
+				strong->activate(hit);
+			}
+		});
+	}
+	_handlers.emplace(key, handler);
+	return handler;
+}
+
+HistoryView::TextState CardMedia::textState(
+		QPoint point,
+		HistoryView::StateRequest request) const {
+	auto result = HistoryView::TextState(_parent);
+	if (width() < 1) {
+		return result;
+	}
+	if (infoSkip() > 0) {
+		const auto corner = resolveCustomInfoRightBottom();
+		const auto info = _parent->bottomInfoTextState(
+			corner.x(),
+			corner.y(),
+			point,
+			bubble()
+				? HistoryView::InfoDisplayType::Default
+				: HistoryView::InfoDisplayType::Background);
+		if (info.link
+			|| info.cursor != HistoryView::CursorState::None
+			|| info.customTooltip) {
+			return info;
+		}
+	}
+	const auto rect = contentRect();
+	if (!_card || !_layout || !rect.contains(point)) {
+		return result;
+	}
+	const auto local = toDocument(point);
+	_lastPoint = local;
+	if (_layout->hover(local)) {
+		_cacheDirty = true;
+		repaintCard();
+	}
+	const auto hit = _layout->hitTest(local);
+	if (hit.actionable()
+		&& (hit.link.isEmpty() || LinkAllowed(hit.link))) {
+		result.link = handlerFor(hit);
+	}
+	return result;
+}
