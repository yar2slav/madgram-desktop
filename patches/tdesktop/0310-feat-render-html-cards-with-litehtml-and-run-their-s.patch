+	void draw_image(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const std::string &url,
+			const std::string &base_url) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto found = image(Utf8(url.c_str()));
+		if (!found) {
+			return;
+		}
+		withLayer(p, layer, [&] {
+			const auto origin = ToRect(layer.origin_box);
+			if (origin.width() <= 0 || origin.height() <= 0) {
+				return;
+			}
+			using namespace litehtml;
+			if (layer.repeat == background_repeat_no_repeat) {
+				drawImage(p, *found, origin);
+				return;
+			}
+			const auto clip = ToRect(layer.clip_box);
+			const auto repeatX = (layer.repeat != background_repeat_repeat_y);
+			const auto repeatY = (layer.repeat != background_repeat_repeat_x);
+			if (origin.width() < 1. || origin.height() < 1.) {
+				return;
+			}
+			const auto back = [](qreal from, qreal edge, qreal step) {
+				return (from > edge)
+					? (from - std::ceil((from - edge) / step) * step)
+					: from;
+			};
+			const auto startX = repeatX
+				? back(origin.x(), clip.x(), origin.width())
+				: origin.x();
+			const auto startY = repeatY
+				? back(origin.y(), clip.y(), origin.height())
+				: origin.y();
+			auto count = 0;
+			for (auto y = startY
+				; (repeatY ? (y < clip.bottom()) : (y == startY))
+				; y += origin.height()) {
+				for (auto x = startX
+					; (repeatX ? (x < clip.right()) : (x == startX))
+					; x += origin.width()) {
+					drawImage(
+						p,
+						*found,
+						QRectF(x, y, origin.width(), origin.height()));
+					if (++count > 4096) {
+						return;
+					}
+				}
+			}
+		});
+	}
+
+	void draw_solid_fill(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::web_color &color) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		if (!color.alpha) {
+			return;
+		}
+		withClips(p, [&] {
+			const auto box = ToRect(layer.border_box);
+			const auto clip = ToRect(layer.clip_box);
+			if (Square(layer.border_radius)) {
+				p->fillRect(box.intersected(clip), ToColor(color));
+				return;
+			}
+			p->setRenderHint(QPainter::Antialiasing);
+			p->setClipRect(clip, Qt::IntersectClip);
+			p->fillPath(RoundedPath(box, layer.border_radius), ToColor(color));
+		});
+	}
+
+	void draw_linear_gradient(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::background_layer::linear_gradient &gradient)
+			override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		auto brush = QLinearGradient(
+			QPointF(gradient.start.x, gradient.start.y),
+			QPointF(gradient.end.x, gradient.end.y));
+		for (const auto &point : gradient.color_points) {
+			brush.setColorAt(
+				std::clamp(double(point.offset), 0., 1.),
+				ToColor(point.color));
+		}
+		fillLayer(p, layer, QBrush(brush));
+	}
+
+	void draw_radial_gradient(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::background_layer::radial_gradient &gradient)
+			override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto rx = std::max(0.01f, gradient.radius.x);
+		const auto ry = std::max(0.01f, gradient.radius.y);
+		auto brush = QRadialGradient(QPointF(0, 0), rx);
+		for (const auto &point : gradient.color_points) {
+			brush.setColorAt(
+				std::clamp(double(point.offset), 0., 1.),
+				ToColor(point.color));
+		}
+		auto result = QBrush(brush);
+		auto transform = QTransform();
+		transform.translate(gradient.position.x, gradient.position.y);
+		transform.scale(1., ry / rx);
+		result.setTransform(transform);
+		fillLayer(p, layer, result);
+	}
+
+	void draw_conic_gradient(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::background_layer::conic_gradient &gradient)
+			override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		auto brush = QConicalGradient(
+			QPointF(gradient.position.x, gradient.position.y),
+			90. - gradient.angle);
+		for (const auto &point : gradient.color_points) {
+			brush.setColorAt(
+				std::clamp(1. - double(point.offset), 0., 1.),
+				ToColor(point.color));
+		}
+		fillLayer(p, layer, QBrush(brush));
+	}
+
+	void draw_borders(
+			litehtml::uint_ptr hdc,
+			const litehtml::borders &borders,
+			const litehtml::position &draw_pos,
+			bool root) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto rect = ToRect(draw_pos);
+		const auto visible = [](const litehtml::border &border) {
+			return (F(border.width) > 0.f)
+				&& (border.style != litehtml::border_style_none)
+				&& (border.style != litehtml::border_style_hidden)
+				&& border.color.alpha;
+		};
+		const auto l = visible(borders.left);
+		const auto t = visible(borders.top);
+		const auto r = visible(borders.right);
+		const auto b = visible(borders.bottom);
+		if (!l && !t && !r && !b) {
+			return;
+		}
+		withClips(p, [&] {
+			p->setRenderHint(QPainter::Antialiasing);
+			const auto same = l && t && r && b
+				&& borders.left.color == borders.top.color
+				&& borders.left.color == borders.right.color
+				&& borders.left.color == borders.bottom.color;
+			const auto inner = rect.adjusted(
+				F(borders.left.width),
+				F(borders.top.width),
+				-F(borders.right.width),
+				-F(borders.bottom.width));
+			auto ring = RoundedPath(rect, borders.radius);
+			if (inner.width() > 0 && inner.height() > 0) {
+				ring.addPath(RoundedPath(inner, Shrink(borders.radius, borders)));
+			}
+			ring.setFillRule(Qt::OddEvenFill);
+			if (same) {
+				p->fillPath(ring, ToColor(borders.top.color));
+				return;
+			}
+			const auto side = [&](
+					bool shown,
+					const litehtml::border &border,
+					QPolygonF polygon) {
+				if (!shown) {
+					return;
+				}
+				auto path = QPainterPath();
+				path.addPolygon(polygon);
+				path.closeSubpath();
+				p->save();
+				p->setClipPath(path, Qt::IntersectClip);
+				p->fillPath(ring, ToColor(border.color));
+				p->restore();
+			};
+			side(t, borders.top, QPolygonF({
+				rect.topLeft(),
+				rect.topRight(),
+				inner.topRight(),
+				inner.topLeft(),
+			}));
+			side(b, borders.bottom, QPolygonF({
+				rect.bottomLeft(),
+				rect.bottomRight(),
+				inner.bottomRight(),
+				inner.bottomLeft(),
+			}));
+			side(l, borders.left, QPolygonF({
+				rect.topLeft(),
+				inner.topLeft(),
+				inner.bottomLeft(),
+				rect.bottomLeft(),
+			}));
+			side(r, borders.right, QPolygonF({
+				rect.topRight(),
+				inner.topRight(),
+				inner.bottomRight(),
+				rect.bottomRight(),
+			}));
+		});
+	}
