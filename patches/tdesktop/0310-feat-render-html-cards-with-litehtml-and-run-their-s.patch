+	void draw_list_marker(
+			litehtml::uint_ptr hdc,
+			const litehtml::list_marker &marker) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto rect = ToRect(marker.pos);
+		const auto color = ToColor(marker.color);
+		withClips(p, [&] {
+			using namespace litehtml;
+			if (!marker.image.empty()) {
+				drawImageAt(p, Utf8(marker.image.c_str()), rect);
+				return;
+			}
+			p->setRenderHint(QPainter::Antialiasing);
+			switch (marker.marker_type) {
+			case list_style_type_circle:
+				p->setPen(QPen(color, 1.));
+				p->setBrush(Qt::NoBrush);
+				p->drawEllipse(rect.adjusted(0.5, 0.5, -0.5, -0.5));
+				break;
+			case list_style_type_disc:
+				p->setPen(Qt::NoPen);
+				p->setBrush(color);
+				p->drawEllipse(rect);
+				break;
+			case list_style_type_square:
+				p->fillRect(rect, color);
+				break;
+			default:
+				if (marker.font) {
+					const auto handle = reinterpret_cast<FontHandle*>(
+						marker.font);
+					const auto text = QString::number(marker.index) + '.';
+					const auto width = handle->base->metrics.horizontalAdvance(
+						text);
+					p->setFont(handle->base->font);
+					p->setPen(color);
+					p->drawText(
+						QPointF(
+							rect.x() + rect.width() - width,
+							rect.y() + handle->base->metrics.ascent()),
+						text);
+				}
+				break;
+			}
+		});
+	}
