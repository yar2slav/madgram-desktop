+	checkDocument();
+	if (!_card) {
+		_document->session().downloaderTaskFinished(
+		) | rpl::on_next([=] {
+			if (!_card) {
+				checkDocument();
+				if (_card) {
+					history()->owner().requestViewResize(_parent);
+				}
+			}
+		}, _lifetime);
