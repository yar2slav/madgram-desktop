+[[nodiscard]] std::optional<QByteArray> DecodeData(const QString &url) {
+	if (!url.startsWith(u"data:"_q, Qt::CaseInsensitive)) {
+		return std::nullopt;
+	}
+	const auto comma = url.indexOf(',');
+	if (comma < 0) {
+		return std::nullopt;
+	}
+	const auto header = url.mid(5, comma - 5);
+	const auto payload = url.mid(comma + 1).toUtf8();
+	if (payload.size() > kMaxImageBytes * 2) {
+		return std::nullopt;
+	}
+	if (header.endsWith(u";base64"_q, Qt::CaseInsensitive)) {
+		return QByteArray::fromBase64(QByteArray::fromPercentEncoding(payload));
+	}
+	return QByteArray::fromPercentEncoding(payload);
+}
+
+[[nodiscard]] QString AppAsset(const QString &name) {
+	if (name == u"logo"_q) {
+		return u":/gui/art/logo_256_no_margin.png"_q;
+	} else if (name == u"tele"_q) {
+		return u":/gui/art/tele_userpic.jpg"_q;
+	}
+	return QString();
+}
+
+[[nodiscard]] Image LoadImage(const QString &url) {
+	auto result = Image();
+	auto bytes = QByteArray();
+	if (url.startsWith(u"app:"_q, Qt::CaseInsensitive)) {
+		const auto path = AppAsset(url.mid(4).trimmed().toLower());
+		if (!path.isEmpty()) {
+			result.raster = QImage(path);
+		}
+	} else if (const auto data = DecodeData(url)) {
+		bytes = *data;
+		const auto svg = url.mid(5, 16).startsWith(
+			u"image/svg"_q,
+			Qt::CaseInsensitive)
+			|| bytes.trimmed().startsWith("<svg")
+			|| bytes.trimmed().startsWith("<?xml");
+		static const auto external = QRegularExpression(
+			u"<image\\b[^>]*\\bhref\\s*=\\s*[\"'](?!data:)"_q,
+			QRegularExpression::CaseInsensitiveOption);
+		if (svg && QString::fromUtf8(bytes).contains(external)) {
+			return result;
+		} else if (svg) {
+			auto renderer = std::make_unique<QSvgRenderer>(bytes);
+			if (renderer->isValid()) {
+				result.size = renderer->defaultSize();
+				result.svg = std::move(renderer);
+			}
+		} else if (bytes.size() <= kMaxImageBytes) {
+			auto buffer = QBuffer(&bytes);
+			buffer.open(QIODevice::ReadOnly);
+			auto reader = QImageReader(&buffer);
+			const auto size = reader.size();
+			if (size.isValid()
+				&& (int64(size.width()) * size.height() <= kMaxImagePixels)) {
+				if (size.width() > kMaxImageSide
+					|| size.height() > kMaxImageSide) {
+					reader.setScaledSize(size.scaled(
+						kMaxImageSide,
+						kMaxImageSide,
+						Qt::KeepAspectRatio));
+				}
+				result.raster = reader.read();
+			}
+		}
+	}
+	if (!result.raster.isNull()) {
+		if (result.raster.width() > kMaxImageSide
+			|| result.raster.height() > kMaxImageSide) {
+			result.raster = result.raster.scaled(
+				kMaxImageSide,
+				kMaxImageSide,
+				Qt::KeepAspectRatio,
+				Qt::SmoothTransformation);
+		}
+		result.raster = result.raster.convertToFormat(
+			QImage::Format_ARGB32_Premultiplied);
+		result.size = result.raster.size();
+	}
+	return result;
+}
