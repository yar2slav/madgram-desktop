+
+void CardMedia::subscribe() {
+	if (!_card) {
+		return;
+	}
+	_card->transitions(
+	) | rpl::on_next([=](const QString &kind) {
+		startTransition(kind);
+	}, _lifetime);
+	_card->updates(
+	) | rpl::on_next([=] {
+		updated();
+	}, _lifetime);
+}
