+Card::Card(QString source)
+: _source(std::move(source))
+, _parsed(ParseCard(_source))
+, _static(CheckMarkup(_parsed.body).isEmpty()
+	? _parsed.body
+	: u"<p class=\"small muted\">This card is too complex to show.</p>"_q)
+, _body(_static)
+, _frames([=](crl::time now) { return frame(now); }) {
+	for (const auto &script : _parsed.scripts) {
+		_joined += script;
+		_joined += u"\n;\n"_q;
+	}
+}
+
+bool Card::visible() const {
+	return _shown > 0;
+}
+
+void Card::shown(bool shown) {
+	_shown = std::max(_shown + (shown ? 1 : -1), 0);
+	if (_shown > 0) {
+		if (!_script && !_joined.isEmpty()) {
+			ScheduleStart(this);
+		} else if (_script) {
+			_script->setPaused(false);
+			TouchLive(this);
+			checkAnimation();
+		}
+	} else if (_script) {
+		_frames.stop();
+		_script->setPaused(true);
+	}
+}
+
+void Card::start() {
+	if (_script || _joined.isEmpty()) {
+		return;
+	}
+	_script = Script::Create(_joined, [=] {
+		rerender();
+		checkAnimation();
+	});
+	TouchLive(this);
+	rerender();
+	checkAnimation();
+}
+
+void Card::stopScript() {
+	_frames.stop();
+	_script = nullptr;
+	setBody(_static);
+}
+
+void Card::setBody(QString body) {
+	if (body == _body) {
+		return;
+	}
+	_body = std::move(body);
+	++_generation;
+	_updates.fire({});
+}
+
+Card::~Card() {
+	_frames.stop();
+	_script = nullptr;
+}
+
+bool Card::frame(crl::time now) {
+	if (!_script || !_script->animating() || !visible()) {
+		return false;
+	} else if (now - _lastFrame < kFrameInterval) {
+		return true;
+	}
+	_lastFrame = now;
+	_script->tick(now);
+	rerender();
+	return _script && _script->animating();
+}
+
+const QString &Card::source() const {
+	return _source;
+}
+
+const ParsedCard &Card::parsed() const {
+	return _parsed;
+}
+
+const QString &Card::body() const {
+	return _body;
+}
+
+uint64 Card::generation() const {
+	return _generation;
+}
+
+Script *Card::script() const {
+	return _script.get();
+}
+
+void Card::action(const QString &name, const QString &value) {
+	if (_script) {
+		_script->action(name, value);
+	}
+}
+
+rpl::producer<QString> Card::transitions() const {
+	return _transitions.events();
+}
+
+rpl::producer<> Card::updates() const {
+	return _updates.events();
+}
+
+void Card::rerender() {
+	if (!_script) {
+		return;
+	}
+	auto html = _script->render();
+	if (html.trimmed().isEmpty()) {
+		html = _static;
+	} else if (const auto error = CheckMarkup(html); !error.isEmpty()) {
+		_script->warn(u"render() output is too complex (%1)"_q.arg(error));
+		html = _static;
+	}
+	const auto transition = _script->takeTransition();
+	if (html == _body) {
+		return;
+	}
+	if (!transition.isEmpty() && transition != u"none"_q) {
+		_transitions.fire_copy(transition);
+	}
+	_body = std::move(html);
+	++_generation;
+	_updates.fire({});
+}
+
+void Card::checkAnimation() {
+	if (_script && _script->animating() && visible()) {
+		if (!_frames.animating()) {
+			_frames.start();
+		}
+	} else {
+		_frames.stop();
+	}
+}
