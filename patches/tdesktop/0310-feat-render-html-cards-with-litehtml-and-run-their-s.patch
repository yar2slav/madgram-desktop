+#pragma once
+
+namespace litehtml {
+class document;
+} // namespace litehtml
+
+namespace Tele::Html {
+
+struct ParsedCard {
+	QString styles;
+	QString body;
+	std::vector<QString> scripts;
+	bool bubble = false;
+	bool external = false;
+};
+
+[[nodiscard]] ParsedCard ParseCard(const QString &source);
+
+struct Scheme {
+	QColor fg;
+	QColor muted;
+	QColor card;
+	QColor border;
+	QColor link;
+	QColor accent;
+	bool dark = false;
+
+	[[nodiscard]] uint64 key() const;
+};
+
+[[nodiscard]] QString KitStyle(const Scheme &scheme);
+[[nodiscard]] QString PrepareStyles(QString css, bool dark);
+[[nodiscard]] QString CheckMarkup(const QString &html);
+
+struct Hit {
+	QString action;
+	QString value;
+	QString link;
+	bool pointer = false;
+
+	[[nodiscard]] bool actionable() const {
+		return !action.isEmpty() || !link.isEmpty();
+	}
+};
+
+class Container;
+
+class Document final {
+public:
+	Document(
+		const QString &styles,
+		const QString &body,
+		const Scheme &scheme,
+		int width = 0);
+	~Document();
+
+	[[nodiscard]] bool valid() const;
+	void layout(int width);
+	[[nodiscard]] int layoutWidth() const;
+	[[nodiscard]] int contentWidth() const;
+	[[nodiscard]] int height() const;
+
+	void paint(QPainter &p, QRect clip) const;
+	[[nodiscard]] Hit hitTest(QPoint point) const;
+	[[nodiscard]] bool hover(QPoint point);
+	[[nodiscard]] bool leave();
+	[[nodiscard]] QString plainText() const;
+
+private:
+	std::unique_ptr<Container> _container;
+	std::shared_ptr<litehtml::document> _document;
+	int _width = 0;
+	int _natural = 0;
+
+};
+
+} // namespace Tele::Html
