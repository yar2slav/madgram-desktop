+std::vector<not_null<HistoryItem*>> PlaygroundWidget::items() const {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &item : _history->clientSideMessages()) {
+		if (item->isHistoryEntry()) {
+			result.push_back(item);
+		}
+	}
+	ranges::sort(result, [](
+			not_null<HistoryItem*> a,
+			not_null<HistoryItem*> b) {
+		return a->id < b->id;
+	});
+	return result;
+}
+
+Data::MessagesSlice PlaygroundWidget::buildSlice(
+		Data::MessagePosition aroundId) const {
+	auto items = this->items();
+	if (!_query.isEmpty()) {
+		const auto skip = [&](not_null<HistoryItem*> item) {
+			return !item->originalText().text.contains(
+				_query,
+				Qt::CaseInsensitive);
+		};
+		items.erase(ranges::remove_if(items, skip), end(items));
+	}
+	auto result = Data::MessagesSlice();
+	const auto size = int(items.size());
+	result.fullCount = size;
+	result.skippedBefore = result.skippedAfter = 0;
+	if (!size) {
+		return result;
+	}
+	const auto i = ranges::find(
+		items,
+		aroundId.fullId,
+		&HistoryItem::fullId);
+	result.nearestToAround = ((i != end(items)) ? *i : items.back())
+		->fullId();
+	result.ids.reserve(size);
+	for (const auto &item : items) {
+		result.ids.push_back(item->fullId());
+	}
+	return result;
+}
