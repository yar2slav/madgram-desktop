+.todo .done .box { background-color: #2fa84f; border-color: #2fa84f; }
+.todo .done .label { color: #8a8f98; text-decoration: line-through; }
+.todo .bar { margin-top: 8px; }
+</style>
+<div class="card pad todo">
+  <div class="row between"><b>Before the trip</b><span class="badge">0 of 4</span></div>
+  <div class="item"><div class="box"></div><div class="label">Charge the power bank</div></div>
+  <div class="item"><div class="box"></div><div class="label">Download offline maps</div></div>
+  <div class="item"><div class="box"></div><div class="label">Print the tickets</div></div>
+  <div class="item"><div class="box"></div><div class="label">Water the plants</div></div>
+</div>
+<script>
+const items = [
+  { text: 'Charge the power bank', done: false },
+  { text: 'Download offline maps', done: false },
+  { text: 'Print the tickets', done: false },
+  { text: 'Water the plants', done: false },
+];
+const progress = { value: 0 };
+
+function finished() {
+  return items.filter(item => item.done).length;
+}
+
+function onAction(name, value) {
+  if (name === 'toggle') {
+    const item = items[Number(value)];
+    item.done = !item.done;
+    tween(progress, { value: finished() / items.length }, 360, ease.outCubic);
+    if (finished() === items.length) {
+      transition('pop');
+      console.log('all done');
+    }
+  } else if (name === 'clear') {
+    items.forEach(item => item.done = false);
+    tween(progress, { value: 0 }, 300);
+    transition('slide-down');
+  }
+}
+
+function render() {
+  const all = finished() === items.length;
+  const list = items.map((item, i) => `<div class="item ${item.done ? 'done' : ''}" data-action="toggle" data-value="${i}">
+      <div class="box">${item.done ? '✓' : ''}</div><div class="label">${esc(item.text)}</div></div>`).join('');
+  const color = mix('#3a8ee6', '#2fa84f', progress.value);
+  return `<div class="card pad todo">
+    <div class="row between"><b>Before the trip</b><span class="badge ${all ? 'green' : ''}">${finished()} of ${items.length}</span></div>
+    ${list}
+    <div class="bar"><div style="width: ${(progress.value * 100).toFixed(1)}%; background-color: ${color}"></div></div>
+    ${all ? '<p class="small muted" style="margin: 8px 0 0 0">All set. <a href="#" data-action="clear">Start over</a></p>' : ''}
+  </div>`;
+}
+</script>)html";
+
+const char kPoll[] = R"html(<style>
+.vote { width: 290px; }
+.vote .option { padding: 7px 10px; margin-top: 6px; border-radius: 9px; background-color: rgba(127,127,127,0.12); }
+.vote .result { margin-top: 8px; }
+.vote .track { height: 6px; margin-top: 3px; border-radius: 3px; background-color: rgba(127,127,127,0.18); }
+.vote .fill { height: 6px; border-radius: 3px; background-color: #3a8ee6; }
+.vote .mine .fill { background-color: #2fa84f; }
+</style>
+<div class="card pad vote">
+  <div class="caps">Quick vote</div>
+  <p style="margin: 6px 0 0 0"><b>Where do we eat on Friday?</b></p>
+  <div class="option">Ramen place</div>
+  <div class="option">Pizza by the river</div>
+  <div class="option">Cook at home</div>
+</div>
+<script>
+const OPTIONS = ['Ramen place', 'Pizza by the river', 'Cook at home'];
+const votes = [4, 6, 2];
+let mine = -1;
+const shares = { 0: 0, 1: 0, 2: 0 };
+
+function onAction(name, value) {
+  if (name === 'vote') {
+    mine = Number(value);
+    votes[mine] += 1;
+    transition('slide-left');
+    const total = votes.reduce((a, b) => a + b, 0);
+    setTimeout(() => tween(shares, Object.fromEntries(votes.map((v, i) => [i, v / total])), 600, ease.outCubic), 120);
+  } else if (name === 'back') {
+    votes[mine] -= 1;
+    mine = -1;
+    Object.keys(shares).forEach(k => shares[k] = 0);
+    transition('slide-right');
+  }
+}
+
+function render() {
+  const head = `<div class="caps">Quick vote</div><p style="margin: 6px 0 0 0"><b>Where do we eat on Friday?</b></p>`;
+  if (mine < 0) {
+    return `<div class="card pad vote">${head}
+      ${OPTIONS.map((o, i) => `<div class="option" data-action="vote" data-value="${i}">${o}</div>`).join('')}
+    </div>`;
+  }
+  const total = votes.reduce((a, b) => a + b, 0);
+  return `<div class="card pad vote">${head}
+    ${OPTIONS.map((o, i) => `<div class="result ${i === mine ? 'mine' : ''}">
+      <div class="row between small"><span>${o}${i === mine ? ' ✓' : ''}</span><span class="muted">${Math.round(shares[i] * 100)}%</span></div>
+      <div class="track"><div class="fill" style="width: ${(shares[i] * 100).toFixed(1)}%"></div></div></div>`).join('')}
+    <p class="small muted" style="margin: 8px 0 0 0">${total} votes · <a href="#" data-action="back">change my vote</a></p>
+  </div>`;
+}
+</script>)html";
+
+const char kStatic[] = R"html(<style>
+.ticket { width: 300px; overflow: hidden; }
+.ticket .top { padding: 12px 14px; background: linear-gradient(135deg, #3a8ee6, #7b5cf0); color: #ffffff; border-radius: 11px 11px 0 0; }
+.ticket .route { font-size: 22px; font-weight: 700; }
+.ticket table { width: 100%; margin-top: 4px; }
+.ticket td { padding: 4px 0; }
