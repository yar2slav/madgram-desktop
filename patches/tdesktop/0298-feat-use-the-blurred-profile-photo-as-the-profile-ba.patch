+#pragma once
+
+#include "ui/image/image_location.h"
+#include "ui/userpic_view.h"
+
+class PeerData;
+
+namespace Tele {
+
+class ProfilePhotoBg final {
+public:
+	explicit ProfilePhotoBg(not_null<PeerData*> peer);
+
+	[[nodiscard]] bool active() const;
+	[[nodiscard]] QColor edgeColor() const;
+	[[nodiscard]] QImage prepare(QSize size) const;
+	[[nodiscard]] rpl::producer<> changes() const;
+
+private:
+	[[nodiscard]] bool refresh();
+	void waitForLoad();
+
+	const not_null<PeerData*> _peer;
+	Ui::PeerUserpicView _view;
+	InMemoryKey _key;
+	QImage _blurred;
+	QColor _edge;
+	rpl::event_stream<> _changes;
+	rpl::lifetime _loading;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] std::unique_ptr<ProfilePhotoBg> MakeProfilePhotoBg(
+	not_null<PeerData*> peer,
+	bool allowed);
+[[nodiscard]] bool ProfilePhotoBgActive(const ProfilePhotoBg *bg);
+[[nodiscard]] std::optional<QColor> ProfilePhotoBgEdge(
+	const ProfilePhotoBg *bg);
+[[nodiscard]] rpl::producer<> ProfilePhotoBgChanges(
+	const ProfilePhotoBg *bg);
+
+} // namespace Tele
