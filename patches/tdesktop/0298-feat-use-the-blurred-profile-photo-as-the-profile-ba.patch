diff --git a/Telegram/SourceFiles/tele/tele_profile_photo_bg.cpp b/Telegram/SourceFiles/tele/tele_profile_photo_bg.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..89534b96697a42f4fd1f21f566d1458c9704d20b
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_profile_photo_bg.cpp
@@ -0,0 +1,212 @@
+#include "tele/tele_profile_photo_bg.h"
+
+#include "data/data_changes.h"
+#include "data/data_channel.h"
+#include "data/data_peer.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "tele/secret/secret_chats.h"
+#include "tele/tele_options.h"
+#include "ui/image/image_prepare.h"
+#include "ui/painter.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kSide = 96;
+constexpr auto kRadius = 16;
+constexpr auto kTargetLightness = 0.3;
+constexpr auto kMinDarken = 0.2;
+constexpr auto kMaxDarken = 0.7;
+
+[[nodiscard]] not_null<PeerData*> PhotoPeer(not_null<PeerData*> peer) {
+	if (const auto broadcast = peer->monoforumBroadcast()) {
+		return broadcast;
+	} else if (const auto real = Secret::RealUser(peer)) {
+		return real;
+	}
+	return peer;
+}
+
+[[nodiscard]] QColor Average(const QImage &image) {
+	auto r = int64();
+	auto g = int64();
+	auto b = int64();
+	const auto width = image.width();
+	const auto height = image.height();
+	for (auto y = 0; y != height; ++y) {
+		const auto line = reinterpret_cast<const QRgb*>(
+			image.constScanLine(y));
+		for (auto x = 0; x != width; ++x) {
+			r += qRed(line[x]);
+			g += qGreen(line[x]);
+			b += qBlue(line[x]);
+		}
+	}
+	const auto count = std::max(int64(width) * height, int64(1));
+	return QColor(int(r / count), int(g / count), int(b / count));
+}
+
+[[nodiscard]] QImage Blurred(const QImage &photo, QColor &edge) {
+	const auto side = std::min(photo.width(), photo.height());
+	const auto square = (photo.width() == photo.height())
+		? photo
+		: photo.copy(
+			(photo.width() - side) / 2,
+			(photo.height() - side) / 2,
+			side,
+			side);
+	auto result = QImage(
+		QSize(kSide, kSide),
+		QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::black);
+	{
+		auto p = QPainter(&result);
+		p.drawImage(0, 0, square.scaled(
+			QSize(kSide, kSide),
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation));
+	}
+	result = Images::BlurLargeImage(std::move(result), kRadius);
+	result = Images::BlurLargeImage(std::move(result), kRadius);
+	const auto average = Average(result);
+	const auto lightness = 0.299 * average.redF()
+		+ 0.587 * average.greenF()
+		+ 0.114 * average.blueF();
+	const auto darken = (lightness > 0.)
+		? std::clamp(1. - kTargetLightness / lightness, kMinDarken, kMaxDarken)
+		: kMinDarken;
+	{
+		auto p = QPainter(&result);
+		p.fillRect(
+			QRect(0, 0, kSide, kSide),
+			QColor(0, 0, 0, int(darken * 255. + 0.5)));
+	}
+	edge = Average(result);
+	return result;
+}
+
+} // namespace
+
+ProfilePhotoBg::ProfilePhotoBg(not_null<PeerData*> peer)
+: _peer(PhotoPeer(peer)) {
+	[[maybe_unused]] const auto initial = refresh();
+	rpl::merge(
+		ProfilePhotoBackgroundChanges(),
+		_peer->session().changes().peerUpdates(
+			_peer,
+			Data::PeerUpdate::Flag::Photo) | rpl::to_empty
+	) | rpl::on_next([=] {
+		if (refresh()) {
+			_changes.fire({});
+		}
+	}, _lifetime);
+}
+
+bool ProfilePhotoBg::active() const {
+	return !_blurred.isNull();
+}
+
+QColor ProfilePhotoBg::edgeColor() const {
+	return _edge;
+}
+
+rpl::producer<> ProfilePhotoBg::changes() const {
+	return _changes.events();
+}
+
+QImage ProfilePhotoBg::prepare(QSize size) const {
+	const auto ratio = style::DevicePixelRatio();
+	const auto full = size * ratio;
+	if (_blurred.isNull() || full.isEmpty()) {
+		return QImage();
+	}
+	const auto side = _blurred.width();
+	const auto part = (int64(full.width()) >= int64(full.height()))
+		? [&] {
+			const auto height = std::clamp(
+				int(int64(side) * full.height() / full.width()),
+				1,
+				side);
+			return QRect(0, (side - height) / 2, side, height);
+		}()
+		: [&] {
+			const auto width = std::clamp(
+				int(int64(side) * full.width() / full.height()),
+				1,
+				side);
+			return QRect((side - width) / 2, 0, width, side);
+		}();
+	auto result = _blurred.copy(part).scaled(
+		full,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+	result.setDevicePixelRatio(ratio);
+	return result;
+}
+
+bool ProfilePhotoBg::refresh() {
+	const auto image = ProfilePhotoBackground()
+		? _peer->userpicCloudImage(_view)
+		: nullptr;
+	if (!image) {
+		if (!ProfilePhotoBackground()) {
+			_view = {};
+			_loading.destroy();
+		} else if (Ui::PeerUserpicLoading(_view)) {
+			waitForLoad();
+			return false;
+		}
+		if (_blurred.isNull()) {
+			return false;
+		}
+		_blurred = QImage();
+		_key = InMemoryKey();
+		return true;
+	}
+	_loading.destroy();
+	const auto key = _peer->userpicUniqueKey(_view);
+	if (!_blurred.isNull() && key == _key) {
+		return false;
+	}
+	_key = key;
+	_blurred = Blurred(*image, _edge);
+	return true;
+}
+
+void ProfilePhotoBg::waitForLoad() {
+	if (_loading) {
+		return;
+	}
+	_peer->session().downloaderTaskFinished(
+	) | rpl::filter([=] {
+		return !Ui::PeerUserpicLoading(_view);
+	}) | rpl::on_next([=] {
+		_loading.destroy();
+		if (refresh()) {
+			_changes.fire({});
+		}
+	}, _loading);
+}
+
+std::unique_ptr<ProfilePhotoBg> MakeProfilePhotoBg(
+		not_null<PeerData*> peer,
+		bool allowed) {
+	return allowed ? std::make_unique<ProfilePhotoBg>(peer) : nullptr;
+}
+
+bool ProfilePhotoBgActive(const ProfilePhotoBg *bg) {
+	return bg && bg->active();
+}
+
+std::optional<QColor> ProfilePhotoBgEdge(const ProfilePhotoBg *bg) {
+	return ProfilePhotoBgActive(bg)
+		? std::make_optional(bg->edgeColor())
+		: std::nullopt;
+}
+
+rpl::producer<> ProfilePhotoBgChanges(const ProfilePhotoBg *bg) {
+	return bg ? bg->changes() : rpl::never<>();
+}
+
+} // namespace Tele
