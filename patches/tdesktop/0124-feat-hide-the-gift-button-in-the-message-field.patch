From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Tue, 29 Sep 2026 05:44:35 +0300
Subject: [PATCH] feat: hide the gift button in the message field

---
 Telegram/SourceFiles/history/history_widget.cpp    |  9 +++++++++
 .../view/controls/history_view_bottom_controls.cpp |  5 +++++
 .../controls/history_view_compose_controls.cpp     |  5 +++++
 Telegram/SourceFiles/settings/settings_tele.cpp    |  4 ++++
 Telegram/SourceFiles/tele/tele_options.cpp         | 14 ++++++++++++++
 Telegram/SourceFiles/tele/tele_options.h           |  3 +++
 Telegram/SourceFiles/tele/tele_settings_io.cpp     |  1 +
 7 files changed, 41 insertions(+)

diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index 713325515602ae7422633d9527426ca3278e93f0..b55d9df288a29a29c49785ddb96c7be295c48cf3 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -186,6 +186,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "tele/tele_inline_text.h"
 #include "tele/tele_send_order.h"
 #include "tele/tele_username_aliases.h"
+#include "tele/tele_options.h"
 #include "media/audio/media_audio.h"
 #include "media/audio/media_audio_capture.h"
 #include "media/player/media_player_instance.h"
@@ -483,6 +484,12 @@ HistoryWidget::HistoryWidget(
 	_muteUnmute->addClickHandler([=] { toggleMuteUnmute(); });
 	setupGiftToChannelButton();
 	setupDirectMessageButton();
+	Tele::HideGiftButtonChanges() | rpl::on_next([=] {
+		refreshSendGiftToggle();
+		refreshGiftToChannelShown();
+		updateControlsVisibility();
+		updateControlsGeometry();
+	}, lifetime());
 	_reportMessages->addClickHandler([=] { reportSelectedMessages(); });
 	_field->submits(
 	) | rpl::on_next([=](Qt::KeyboardModifiers modifiers) {
@@ -1394,6 +1401,7 @@ void HistoryWidget::refreshGiftToChannelShown() {
 	const auto channel = _peer->asChannel();
 	_giftToChannel->setVisible(channel
 		&& channel->isBroadcast()
+		&& !Tele::HideGiftButton()
 		&& channel->stargiftsAvailable());
 }
 
@@ -4243,6 +4251,7 @@ void HistoryWidget::refreshSendGiftToggle() {
 		| Type::Unique;
 	const auto has = user
 		&& _canSendMessages
+		&& !Tele::HideGiftButton()
 		&& !user->isServiceUser()
 		&& !user->isSelf()
 		&& !user->isBot()
diff --git a/Telegram/SourceFiles/history/view/controls/history_view_bottom_controls.cpp b/Telegram/SourceFiles/history/view/controls/history_view_bottom_controls.cpp
index c34d06a26eab9dea343c040ad0d93dbfa73a1a1e..a56a4d5d45cce63fb44d2f08dd4595b491e41083 100644
--- a/Telegram/SourceFiles/history/view/controls/history_view_bottom_controls.cpp
+++ b/Telegram/SourceFiles/history/view/controls/history_view_bottom_controls.cpp
@@ -26,6 +26,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "history/view/controls/compose_controls_common.h"
 #include "lang/lang_keys.h"
 #include "main/main_session.h"
+#include "tele/tele_options.h"
 #include "ui/painter.h"
 #include "ui/ui_utility.h"
 #include "ui/widgets/buttons.h"
@@ -298,6 +299,9 @@ void BottomControls::setupGiftToChannelButton() {
 	setupOverlayIconButton(_giftToChannel, true, [=] {
 		refreshGiftToChannelShown();
 	});
+	Tele::HideGiftButtonChanges() | rpl::on_next([=] {
+		refreshGiftToChannelShown();
+	}, _giftToChannel->lifetime());
 }
 
 void BottomControls::setupDirectMessageButton() {
@@ -480,6 +484,7 @@ void BottomControls::refreshGiftToChannelShown() {
 	const auto channel = _peer->asChannel();
 	_giftToChannel->setVisible(channel
 		&& channel->isBroadcast()
+		&& !Tele::HideGiftButton()
 		&& channel->stargiftsAvailable());
 }
 
diff --git a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
index ba2850b691c7fd5893285259c6bfcb7873c3b139..61ad64123edd05b7c32caccbd1a7186d43588b10 100644
