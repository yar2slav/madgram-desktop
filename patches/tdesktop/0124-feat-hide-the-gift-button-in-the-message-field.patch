 #include "tele/tele_username_aliases.h"
+#include "tele/tele_options.h"
 #include "support/support_helper.h"
 #include "ui/item_text_options.h"
 #include "ui/text/text_options.h"
@@ -2955,6 +2956,9 @@ void ComposeControls::init() {
 		initEditStarsButton();
 		updateControlsGeometry(_wrap->size());
 	}, _wrap->lifetime());
+	Tele::HideGiftButtonChanges() | rpl::on_next([=] {
+		refreshSendGiftToggle();
+	}, _wrap->lifetime());
 
 	_hidden.changes(
 	) | rpl::on_next([=] {
@@ -5801,6 +5805,7 @@ void ComposeControls::refreshSendGiftToggle() {
 	const auto has = _regularWindow
 		&& user
 		&& !_writeRestriction.current()
+		&& !Tele::HideGiftButton()
 		&& !user->isServiceUser()
 		&& !user->isSelf()
 		&& !user->isBot()
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 29ea26a63e6f3b4f5d3f1781ea2e739b55d1e93d..ebf63ecc076289639bfd361bce3f6ffd4e3aec32 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1955,6 +1955,10 @@ void FillChats(SectionBuilder &builder) {
 		builder,
 		::Tele::kOptionNoRichPastePrompt,
 		{ u"formatted"_q });
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionHideGiftButton,
+		{ u"gift"_q, u"premium"_q });
 	AddOptionToggle(builder, ::Tele::kOptionCalcmula);
 	AddOptionToggle(
 		builder,
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index a7b088e7b3aaaac26482a806b835e9e531213f9c..4a3d3c7acb764ca5a2e56971ad0421311d23dbae 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -83,6 +83,7 @@ const char kOptionSendOlderReplies[] = "tele-send-older-replies";
 const char kOptionDoubleEnterSend[] = "tele-double-enter-send";
 const char kOptionInlineWithoutVia[] = "tele-inline-without-via";
 const char kOptionNoRichPastePrompt[] = "tele-no-rich-paste-prompt";
+const char kOptionHideGiftButton[] = "tele-hide-gift-button";
 const char kOptionPunctualScheduled[] = "tele-punctual-scheduled";
 const char kOptionHdPhotos[] = "tele-hd-photos";
 const char kOptionChatBackgrounds[] = "tele-chat-backgrounds";
@@ -586,6 +587,11 @@ base::options::toggle NoRichPastePromptOption({
 	.name = "No rich message prompt on paste",
 });
 
+base::options::toggle HideGiftButtonOption({
+	.id = kOptionHideGiftButton,
+	.name = "Hide the gift button in the message field",
+});
+
 base::options::toggle PunctualScheduledOption({
 	.id = kOptionPunctualScheduled,
 	.name = "Send scheduled messages on time",
@@ -1313,6 +1319,14 @@ bool NoRichPastePrompt() {
 	return NoRichPastePromptOption.value();
 }
 
+bool HideGiftButton() {
+	return HideGiftButtonOption.value();
+}
+
+rpl::producer<> HideGiftButtonChanges() {
+	return HideGiftButtonOption.changes();
+}
+
 bool PunctualScheduled() {
 	return PunctualScheduledOption.value();
 }
