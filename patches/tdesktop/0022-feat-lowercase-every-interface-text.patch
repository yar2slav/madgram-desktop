diff --git a/Telegram/SourceFiles/tele/tele_lowercase.cpp b/Telegram/SourceFiles/tele/tele_lowercase.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3cf63fa574ab42d48b96550101289ac8858e069d
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_lowercase.cpp
@@ -0,0 +1,72 @@
+#include "tele/tele_lowercase.h"
+
+#include "lang/lang_tag.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+[[nodiscard]] int LangTagLength(const QString &text, int from) {
+	const auto size = int(text.size());
+	return (from + 3 < size
+		&& text[from].unicode() == Lang::kTextCommand
+		&& text[from + 1].unicode() == Lang::kTextCommandLangTag
+		&& text[from + 3].unicode() == Lang::kTextCommand)
+		? 4
+		: 0;
+}
+
+[[nodiscard]] int LinkLength(const QString &text, int from) {
+	const auto view = QStringView(text).mid(from);
+	const auto link = view.startsWith(u"https://"_q)
+		|| view.startsWith(u"http://"_q)
+		|| view.startsWith(u"tg://"_q);
+	if (!link) {
+		return 0;
+	}
+	auto length = 0;
+	for (const auto ch : view) {
+		if (ch.isSpace()
+			|| ch == ')'
+			|| ch == ']'
+			|| ch == '>'
+			|| ch == '"'
+			|| ch == '\'') {
+			break;
+		}
+		++length;
+	}
+	return length;
+}
+
+} // namespace
+
+QString Lower(QString text) {
+	if (!LowercaseStrings()) {
+		return text;
+	}
+	const auto size = int(text.size());
+	auto result = QString();
+	result.reserve(size);
+	auto plain = 0;
+	const auto flush = [&](int till) {
+		if (till > plain) {
+			result.append(QStringView(text).mid(plain, till - plain).toString().toLower());
+		}
+	};
+	for (auto i = 0; i != size;) {
+		const auto keep = std::max(LangTagLength(text, i), LinkLength(text, i));
+		if (!keep) {
+			++i;
+			continue;
+		}
+		flush(i);
+		result.append(QStringView(text).mid(i, keep));
+		i += keep;
+		plain = i;
+	}
+	flush(size);
+	return result;
+}
+
+} // namespace Tele
