 void Uploader::partFailed(const MTP::Error &error, mtpRequestId requestId) {
-	const auto request = finishRequest(requestId);
-	failed(request.itemId);
+	auto request = finishRequest(requestId);
+	const auto itemId = request.itemId;
+	const auto i = ranges::find(_queue, itemId, &Entry::itemId);
+	if (i != end(_queue)) {
+		const auto file = std::weak_ptr(i->file);
+		const auto requeue = [&](Request &&request, crl::time delay) {
+			if (!delay) {
+				_pendingFromRemovedDcIndices.push_back(std::move(request));
+				return;
+			}
+			base::call_delayed(delay, this, [=, request = std::move(request)](
+					) mutable {
+				const auto i = ranges::find(_queue, itemId, &Entry::itemId);
+				if (i != end(_queue) && i->file == file.lock()) {
+					_pendingFromRemovedDcIndices.push_back(std::move(request));
+					maybeSend();
+				}
+			});
+		};
+		if (::Tele::RetryUploadPart(
+				*i,
+				std::move(request),
+				error,
+				_requests,
+				_pendingFromRemovedDcIndices,
+				requeue)) {
+			maybeSend();
+			return;
+		}
+		::Tele::UploadPartFailed(i->file->filename, error);
+	}
+	failed(itemId);
 }
 
