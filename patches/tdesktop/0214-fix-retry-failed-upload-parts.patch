--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_upload_retry.cpp
@@ -0,0 +1,56 @@
+#include "tele/tele_upload_retry.h"
+
+#include "mtproto/mtproto_response.h"
+#include "tele/tele_lowercase.h"
+#include "ui/toast/toast.h"
+
+#include <QtCore/QFile>
+#include <QtCore/QRegularExpression>
+
+namespace Tele {
+
+std::optional<int> MissingUploadPart(const MTP::Error &error) {
+	static const auto expression = QRegularExpression(
+		u"^FILE_PART_(\\d+)_MISSING$"_q);
+	const auto match = expression.match(error.type());
+	if (!match.hasMatch()) {
+		return std::nullopt;
+	}
+	auto ok = false;
+	const auto result = match.captured(1).toInt(&ok);
+	return ok ? std::make_optional(result) : std::nullopt;
+}
+
+crl::time UploadPartRetryDelay(int retry) {
+	return crl::time(1000) << std::clamp(retry - 1, 0, 4);
+}
+
+QByteArray ReadUploadPart(
+		const QByteArray &content,
+		const QString &path,
+		int64 offset,
+		int size) {
+	if (!content.isEmpty()) {
+		return (offset < content.size()) ? content.mid(offset, size) : QByteArray();
+	}
+	auto file = QFile(path);
+	if (path.isEmpty()
+		|| !file.open(QIODevice::ReadOnly)
+		|| !file.seek(offset)) {
+		return QByteArray();
+	}
+	return file.read(size);
+}
+
+void UploadPartFailed(const QString &name, const MTP::Error &error) {
+	LOG(("Uploader: Part of \"%1\" failed with %2 %3."
+		).arg(name
+		).arg(error.code()
+		).arg(error.type()));
+	const auto what = name.isEmpty()
+		? Lower(u"Couldn't upload the file"_q)
+		: (Lower(u"Couldn't upload"_q) + ' ' + name);
+	Ui::Toast::Show(what + u": "_q + error.type());
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_upload_retry.h b/Telegram/SourceFiles/tele/tele_upload_retry.h
new file mode 100644
index 0000000000000000000000000000000000000000..b35e89fa2d9ac4eab3ab315945a16de84c050726
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_upload_retry.h
@@ -0,0 +1,84 @@
+#pragma once
+
+namespace MTP {
+class Error;
+} // namespace MTP
+
+namespace Tele {
+
+inline constexpr auto kUploadPartRetries = 3;
+
+[[nodiscard]] std::optional<int> MissingUploadPart(const MTP::Error &error);
+[[nodiscard]] crl::time UploadPartRetryDelay(int retry);
+[[nodiscard]] QByteArray ReadUploadPart(
+	const QByteArray &content,
+	const QString &path,
+	int64 offset,
+	int size);
+void UploadPartFailed(const QString &name, const MTP::Error &error);
+
+template <
+	typename Entry,
+	typename Request,
+	typename Requests,
+	typename Pending,
+	typename Requeue>
+[[nodiscard]] bool RetryUploadPart(
+		Entry &entry,
+		Request &&request,
+		const MTP::Error &error,
+		const Requests &requests,
+		const Pending &pending,
+		Requeue &&requeue) {
+	if (++request.retries > kUploadPartRetries) {
+		return false;
+	}
+	const auto missing = MissingUploadPart(error);
+	if (!missing) {
+		const auto delay = UploadPartRetryDelay(request.retries);
+		requeue(std::move(request), delay);
+		return true;
+	}
+	const auto part = *missing;
+	const auto same = [&](const auto &other) {
+		return (other.itemId == request.itemId)
+			&& (other.docPart == request.docPart)
+			&& (int(other.part) == part);
+	};
+	const auto flying = ranges::any_of(requests, [&](const auto &pair) {
+		return same(pair.second);
+	}) || ranges::any_of(pending, same);
+	const auto sent = request.docPart
+		? int(entry.docPartsSent)
+		: int(entry.partsSent);
+	if (part != int(request.part) && part >= 0 && part < sent && !flying) {
+		auto bytes = request.docPart
+			? ReadUploadPart(
+				entry.file->content,
+				entry.file->filepath,
+				int64(part) * entry.docPartSize,
+				entry.docPartSize)
+			: entry.parts->at(part);
+		if (bytes.isEmpty()) {
+			return false;
+		}
+		if (request.docPart) {
+			++entry.docPartsWaiting;
+			entry.docSentSize -= bytes.size();
+		} else {
+			++entry.partsWaiting;
+			entry.sentSize -= bytes.size();
+		}
+		auto resent = std::remove_cvref_t<Request>();
+		resent.itemId = request.itemId;
+		resent.bytes = std::move(bytes);
+		resent.part = ushort(part);
+		resent.docPart = request.docPart;
+		resent.bigPart = request.bigPart;
+		requeue(std::move(resent), crl::time(0));
+	}
+	requeue(std::move(request), crl::time(0));
+	return true;
+}
+
+} // namespace Tele
