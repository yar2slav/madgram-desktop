 	Ui::AddSkip(content);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 2cacce9fd80aa5996866375a8d732e509ef83ccf..f109679ecd0219652b65ff7e7ac783fc4ee5a1c8 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -10,6 +10,7 @@ const char kOptionButtonPayloads[] = "tele-button-payloads";
 const char kOptionAutoUpdate[] = "tele-auto-update";
 const char kOptionGroupQuickReplies[] = "tele-group-quick-replies";
 const char kOptionBubbleBadges[] = "tele-bubble-badges";
+const char kOptionHideCalls[] = "tele-hide-calls";
 const char kOptionShowGiftIds[] = "tele-show-gift-ids";
 const char kOptionPeerIdsWithoutSpaces[] = "tele-peer-ids-without-spaces";
 const char kOptionBotApiPeerIds[] = "tele-bot-api-peer-ids";
@@ -66,6 +67,13 @@ base::options::toggle GroupQuickRepliesOption({
 		"keyboards, via-bot labels and message effects are dropped.",
 });
 
+base::options::toggle HideCallsOption({
+	.id = kOptionHideCalls,
+	.name = "Hide call buttons",
+	.description = "No call button in the top bar of private chats "
+		"and in profiles.",
+});
+
 base::options::toggle BubbleBadgesOption({
 	.id = kOptionBubbleBadges,
 	.name = "Badges next to names in messages",
@@ -187,6 +195,14 @@ bool GroupQuickReplies() {
 	return GroupQuickRepliesOption.value();
 }
 
+bool HideCalls() {
+	return HideCallsOption.value();
+}
+
+rpl::producer<> HideCallsChanges() {
+	return HideCallsOption.changes() | rpl::to_empty;
+}
+
 bool BubbleBadges() {
 	return BubbleBadgesOption.value();
 }
