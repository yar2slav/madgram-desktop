 	}();
 	_call->setVisible(historyMode
 		&& callsEnabled
-		&& !_chooseForReportReason);
+		&& !_chooseForReportReason
+		&& !Tele::HideCalls());
 	const auto groupCallsEnabled = [&] {
 		if (const auto peer = _activeChat.key.peer()) {
 			if (!peer->isUser() && peer->canManageGroupCall()) {
