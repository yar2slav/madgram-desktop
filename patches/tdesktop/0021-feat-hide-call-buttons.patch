@@ -668,7 +669,10 @@ void WrapWidget::addProfileCallsButton() {
 
 	const auto peer = key().peer();
 	const auto user = peer ? peer->asUser() : nullptr;
-	if (!user || user->sharedMediaInfo() || user->isInaccessible()) {
+	if (!user
+		|| user->sharedMediaInfo()
+		|| user->isInaccessible()
+		|| Tele::HideCalls()) {
 		return;
 	}
 
