+using SkippedCounts = base::flat_map<FullMsgId, int>;
+
+[[nodiscard]] SkippedCounts CountSkipped(
+		const std::vector<not_null<HistoryItem*>> &items,
+		Fn<bool(not_null<HistoryItem*>)> displayed) {
+	auto result = SkippedCounts();
+	if (!displayed) {
+		return result;
+	}
+	for (auto i = 1; i < int(items.size()); ++i) {
+		const auto from = items[i - 1];
+		const auto till = items[i];
+		if (from->history() != till->history()) {
+			continue;
+		}
+		const auto owner = &till->history()->owner();
+		const auto peer = till->history()->peer->id;
+		const auto last = std::min(
+			uint64(till->id.bare),
+			uint64(from->id.bare) + kMaxSkippedScan);
+		auto count = 0;
+		auto groups = base::flat_set<not_null<const Data::Group*>>();
+		for (auto id = uint64(from->id.bare) + 1; id < last; ++id) {
+			const auto item = owner->message(peer, MsgId(int64(id)));
+			if (!item || !displayed(item)) {
+				continue;
+			} else if (const auto group = owner->groups().find(item)) {
+				if (!groups.emplace(group).second) {
+					continue;
+				}
+			}
+			++count;
+		}
+		if (count > 0) {
+			result.emplace(till->fullId(), count);
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString SkippedText(int count) {
+	return Lower((count == 1)
+		? u"1 message skipped"_q
+		: (QString::number(count) + u" messages skipped"_q));
+}
