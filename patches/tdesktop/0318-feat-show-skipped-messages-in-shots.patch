+void ShotRenderer::paintSkipped(Painter &p, QRect clip) {
+	const auto st = style();
+	const auto till = clip.y() + clip.height();
+	const auto &margin = st::msgServiceMargin;
+	const auto &padding = st::msgServicePadding;
+	const auto &font = st::msgServiceFont;
+	const auto height = padding.top() + font->height + padding.bottom();
+	const auto radius = Ui::HistoryServiceMsgRadius();
+	for (const auto &[top, text] : _skippedPills) {
+		if (top >= till || top + skippedHeight() <= clip.y()) {
+			continue;
+		}
+		const auto width = font->width(text);
+		const auto available = _cropWidth - 2 * margin.left();
+		const auto left = margin.left()
+			+ (available - width - padding.left() - padding.right()) / 2;
+		const auto rect = QRect(
+			left,
+			top + margin.top(),
+			width + padding.left() + padding.right(),
+			height);
+		{
+			auto hq = PainterHighQualityEnabler(p);
+			p.setPen(Qt::NoPen);
+			p.setBrush(st->msgServiceBg());
+			p.drawRoundedRect(rect, radius, radius);
+		}
+		p.setFont(font);
+		p.setPen(st->msgServiceFg());
+		p.drawText(
+			left + padding.left(),
+			top + margin.top() + padding.top() + font->ascent,
+			text);
+	}
+}
